Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:02.00,0:01:02.81,Layzner,,0,0,0,,飞鸟
Dialogue: 0,0:01:03.10,0:01:04.58,Layzner,,0,0,0,,你知道我父亲
Dialogue: 0,0:01:05.05,0:01:06.34,Layzner,,0,0,0,,这里是欧洲大陆
Dialogue: 0,0:01:06.34,0:01:08.39,Layzner,,0,0,0,,怎么能在这里被干掉呢
Dialogue: 0,0:01:08.38,0:01:10.04,Layzner,,0,0,0,,你还活着吗 凯利前辈
Dialogue: 0,0:01:43.67,0:01:45.20,Layzner,,0,0,0,,快脱离
Dialogue: 0,0:01:45.20,0:01:47.20,Layzner,,0,0,0,,让我看看吧
Dialogue: 0,0:01:55.82,0:02:00.69,Layzner,,0,0,0,,因为雷兹纳的保护 我们离开月球了
Dialogue: 0,0:02:00.69,0:02:02.57,Layzner,,0,0,0,,就快到地球了
Dialogue: 0,0:02:03.44,0:02:07.28,Layzner,,0,0,0,,可是 我看到那一幕后
Dialogue: 0,0:02:07.28,0:02:09.31,Layzner,,0,0,0,,却无法高兴起来
Dialogue: 0,0:02:10.51,0:02:11.67,Layzner,,0,0,0,,感觉
Dialogue: 0,0:02:11.67,0:02:14.76,Layzner,,0,0,0,,雷兹纳好像被恶魔附身一样
Dialogue: 0,0:02:15.35,0:02:17.64,Layzner,,0,0,0,,令人毛骨悚然
Dialogue: 0,0:02:18.80,0:02:20.20,Layzner,,0,0,0,,到底 怎么回事
Dialogue: 0,0:02:20.77,0:02:25.77,Layzner,,0,0,0,,第十九话 无法传达的思念
Dialogue: 0,0:02:33.70,0:02:37.17,Layzner,,0,0,0,,资料信息 第二阶段加速结束
Dialogue: 0,0:02:37.37,0:02:39.46,Layzner,,0,0,0,,好 西蒙尼 确认航道
Dialogue: 0,0:02:39.46,0:02:40.46,Layzner,,0,0,0,,OK了
Dialogue: 0,0:02:40.46,0:02:42.46,Layzner,,0,0,0,,好 航道维持正常
Dialogue: 0,0:02:43.01,0:02:45.85,Layzner,,0,0,0,,接下来要脱离重力圈 进行中
Dialogue: 0,0:02:45.99,0:02:48.04,Layzner,,0,0,0,,OK 追击部队呢
Dialogue: 0,0:02:48.04,0:02:51.13,Layzner,,0,0,0,,雷达上没反应 没有东西
Dialogue: 0,0:02:53.12,0:02:54.70,Layzner,,0,0,0,,结束了
Dialogue: 0,0:02:54.70,0:02:58.10,Layzner,,0,0,0,,亚瑟你太棒了 做得好
Dialogue: 0,0:03:01.44,0:03:03.12,Layzner,,0,0,0,,大家 已经好了
Dialogue: 0,0:03:03.29,0:03:05.07,Layzner,,0,0,0,,接下来要去地球了
Dialogue: 0,0:03:05.07,0:03:06.98,Layzner,,0,0,0,,太好了
Dialogue: 0,0:03:06.98,0:03:08.98,Layzner,,0,0,0,,大家 已经可以了
Dialogue: 0,0:03:08.98,0:03:11.02,Layzner,,0,0,0,,没问题吗
Dialogue: 0,0:03:10.19,0:03:11.02,Layzner,,0,0,0,,是的
Dialogue: 0,0:03:15.14,0:03:17.70,Layzner,,0,0,0,,古雷特呢 在睡觉
Dialogue: 0,0:03:18.48,0:03:20.72,Layzner,,0,0,0,,伊丽莎白博士
Dialogue: 0,0:03:20.72,0:03:22.54,Layzner,,0,0,0,,古雷特没事
Dialogue: 0,0:03:22.54,0:03:23.68,Layzner,,0,0,0,,小孩子就交给你了
Dialogue: 0,0:03:23.68,0:03:24.21,Layzner,,0,0,0,,是
Dialogue: 0,0:03:24.21,0:03:27.68,Layzner,,0,0,0,,梅洛 哈迪大家快来
Dialogue: 0,0:03:27.68,0:03:30.64,Layzner,,0,0,0,,真是千钧一发
Dialogue: 0,0:03:30.64,0:03:32.64,Layzner,,0,0,0,,可是亚瑟 你真的是做得太好了
Dialogue: 0,0:03:32.64,0:03:36.63,Layzner,,0,0,0,,大卫 怎么说我也是最年长的
Dialogue: 0,0:03:32.64,0:03:36.63,Layzner,,0,0,0,,重要关头还是少不了我
Dialogue: 0,0:03:36.63,0:03:38.07,Layzner,,0,0,0,,说的也是
Dialogue: 0,0:03:38.07,0:03:39.40,Layzner,,0,0,0,,结果好就行了
Dialogue: 0,0:03:39.40,0:03:41.59,Layzner,,0,0,0,,对 结果好就行了
Dialogue: 0,0:03:50.21,0:03:51.47,Layzner,,0,0,0,,那个
Dialogue: 0,0:03:51.47,0:03:55.21,Layzner,,0,0,0,,不过看到雷兹纳那时的大逆转 真的吓了我一跳
Dialogue: 0,0:03:55.49,0:03:58.74,Layzner,,0,0,0,,被那些无人机包围的时候还想说不行了
Dialogue: 0,0:03:58.74,0:04:01.82,Layzner,,0,0,0,,想不到雷兹纳一下子就有那么大的力量
Dialogue: 0,0:04:02.36,0:04:03.97,Layzner,,0,0,0,,这已经是第三次了
Dialogue: 0,0:04:04.98,0:04:07.78,Layzner,,0,0,0,,雷兹纳一遇危险就无法操纵
Dialogue: 0,0:04:07.97,0:04:11.23,Layzner,,0,0,0,,有一个和雷不同的系统就会突然启动
Dialogue: 0,0:04:16.37,0:04:18.96,Layzner,,0,0,0,,我 什么都没做
Dialogue: 0,0:04:20.94,0:04:23.32,Layzner,,0,0,0,,你是 雷 吗
Dialogue: 0,0:04:23.32,0:04:24.57,Layzner,,0,0,0,,不是
Dialogue: 0,0:04:24.57,0:04:26.62,Layzner,,0,0,0,,不是雷 那你到底是
Dialogue: 0,0:04:27.24,0:04:29.53,Layzner,,0,0,0,,英二
Dialogue: 0,0:04:30.61,0:04:34.16,Layzner,,0,0,0,,雷兹纳是不是有什么特殊装置
Dialogue: 0,0:04:34.16,0:04:34.95,Layzner,,0,0,0,,不
Dialogue: 0,0:04:34.95,0:04:38.79,Layzner,,0,0,0,,可是感觉它好像突然变身了
Dialogue: 0,0:04:38.94,0:04:43.19,Layzner,,0,0,0,,大概是我太认真 使用超过极限的动力
Dialogue: 0,0:04:43.66,0:04:45.96,Layzner,,0,0,0,,总之能平安回来就好了
Dialogue: 0,0:04:47.81,0:04:51.74,Layzner,,0,0,0,,警告 三四号镜头有攻击部队
Dialogue: 0,0:04:51.74,0:04:53.16,Layzner,,0,0,0,,快确认身份 ready
Dialogue: 0,0:05:08.44,0:05:13.39,Layzner,,0,0,0,,北美大陆防空司令部 诺拉德
Dialogue: 0,0:05:15.28,0:05:19.43,Layzner,,0,0,0,,未确认身份的飞行部队推测会来到美国上空
Dialogue: 0,0:05:19.43,0:05:22.17,Layzner,,0,0,0,,侵入角度 39度59分
Dialogue: 0,0:05:22.18,0:05:24.73,Layzner,,0,0,0,,马上确认 准备进入地球
Dialogue: 0,0:05:24.83,0:05:27.11,Layzner,,0,0,0,,推测在航道D区13处
Dialogue: 0,0:05:27.11,0:05:29.11,Layzner,,0,0,0,,D区13处
Dialogue: 0,0:05:29.11,0:05:30.44,Layzner,,0,0,0,,是外星人吗
Dialogue: 0,0:05:30.44,0:05:32.90,Layzner,,0,0,0,,开始捕捉系统装置
Dialogue: 0,0:05:34.89,0:05:36.75,Layzner,,0,0,0,,中子光无效
Dialogue: 0,0:05:36.83,0:05:38.92,Layzner,,0,0,0,,突破17区
Dialogue: 0,0:05:39.25,0:05:41.82,Layzner,,0,0,0,,启动追踪系统装置
Dialogue: 0,0:05:42.30,0:05:44.49,Layzner,,0,0,0,,超激光光无效
Dialogue: 0,0:05:44.49,0:05:46.67,Layzner,,0,0,0,,第16区也被突破了
Dialogue: 0,0:05:47.22,0:05:49.42,Layzner,,0,0,0,,地面上进入作战准备
Dialogue: 0,0:06:01.34,0:06:05.58,Layzner,,0,0,0,,机身被击中 没有损伤
Dialogue: 0,0:06:06.04,0:06:08.26,Layzner,,0,0,0,,由第二镜头侦测到飞行部队有热源反应
Dialogue: 0,0:06:10.26,0:06:12.66,Layzner,,0,0,0,,有飞行部队侵入第二镜头
Dialogue: 0,0:06:18.40,0:06:21.28,Layzner,,0,0,0,,破坏飞行部队 所有镜头安全
Dialogue: 0,0:06:21.28,0:06:24.15,Layzner,,0,0,0,,启动警戒 阻止再次被攻击
Dialogue: 0,0:06:24.15,0:06:25.03,Layzner,,0,0,0,,Ready.
Dialogue: 0,0:06:25.03,0:06:27.00,Layzner,,0,0,0,,所有区域被突破
Dialogue: 0,0:06:27.01,0:06:29.03,Layzner,,0,0,0,,无法阻挡它
Dialogue: 0,0:06:31.02,0:06:32.19,Layzner,,0,0,0,,库雷顿少将
Dialogue: 0,0:06:32.43,0:06:35.01,Layzner,,0,0,0,,D区13处被入侵是真的吗
Dialogue: 0,0:06:35.01,0:06:37.01,Layzner,,0,0,0,,没错
Dialogue: 0,0:06:37.50,0:06:40.06,Layzner,,0,0,0,,BIG SDI网也被突破了吗
Dialogue: 0,0:06:40.65,0:06:43.52,Layzner,,0,0,0,,这一定跟月球的异状有关
Dialogue: 0,0:06:44.27,0:06:45.09,Layzner,,0,0,0,,当然了
Dialogue: 0,0:06:46.08,0:06:46.63,Layzner,,0,0,0,,阁下
Dialogue: 0,0:06:46.99,0:06:48.37,Layzner,,0,0,0,,当然了 舰长
Dialogue: 0,0:06:49.25,0:06:51.16,Layzner,,0,0,0,,调到紧急通信频道
Dialogue: 0,0:06:51.16,0:06:53.35,Layzner,,0,0,0,,联合国宇宙局总部请回答
Dialogue: 0,0:06:53.64,0:06:55.14,Layzner,,0,0,0,,我是伊丽莎白·克蕾布里
Dialogue: 0,0:06:55.54,0:06:57.42,Layzner,,0,0,0,,联合国宇宙局总部请回答
Dialogue: 0,0:07:01.66,0:07:05.09,Layzner,,0,0,0,,（联合国宇宙局总部）
Dialogue: 0,0:07:01.84,0:07:03.63,Layzner,,0,0,0,,联合国宇宙局总部请回答
Dialogue: 0,0:07:03.84,0:07:05.38,Layzner,,0,0,0,,我是伊丽莎白·克蕾布里
Dialogue: 0,0:07:05.50,0:07:06.69,Layzner,,0,0,0,,伊丽莎白博士
Dialogue: 0,0:07:06.69,0:07:10.05,Layzner,,0,0,0,,请总部长基鲁巴特博士跟你谈
Dialogue: 0,0:07:06.69,0:07:10.05,Layzner,,0,0,0,,我们和你联络很久了
Dialogue: 0,0:07:11.88,0:07:15.64,Layzner,,0,0,0,,我知道发生异常的事了
Dialogue: 0,0:07:11.88,0:07:15.64,Layzner,,0,0,0,,我是约翰·基鲁巴特
Dialogue: 0,0:07:16.16,0:07:17.85,Layzner,,0,0,0,,还好你平安
Dialogue: 0,0:07:18.63,0:07:20.76,Layzner,,0,0,0,,火星跟月球上所有的设施
Dialogue: 0,0:07:20.76,0:07:23.93,Layzner,,0,0,0,,都被叫古拉特斯的外星人毁了
Dialogue: 0,0:07:24.24,0:07:25.07,Layzner,,0,0,0,,古拉特斯
Dialogue: 0,0:07:25.60,0:07:27.55,Layzner,,0,0,0,,他们是普鲁托利亚太阳系里的生命体
Dialogue: 0,0:07:28.25,0:07:32.93,Layzner,,0,0,0,,古拉特斯星人为了要镇压地球已经展开行动了
Dialogue: 0,0:07:33.08,0:07:35.45,Layzner,,0,0,0,,请再说得详细一点 伊丽莎白博士
Dialogue: 0,0:07:35.54,0:07:39.49,Layzner,,0,0,0,,好的 但是我们现在坐在古拉特斯的小型航天飞机上
Dialogue: 0,0:07:39.90,0:07:40.96,Layzner,,0,0,0,,外星人的船吗
Dialogue: 0,0:07:41.14,0:07:44.65,Layzner,,0,0,0,,是的 请各国军队不要攻击我们
Dialogue: 0,0:07:44.84,0:07:45.60,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:07:46.72,0:07:49.05,Layzner,,0,0,0,,向各国发紧急要求
Dialogue: 0,0:07:49.07,0:07:49.54,Layzner,,0,0,0,,是
Dialogue: 0,0:07:51.53,0:07:52.97,Layzner,,0,0,0,,伊丽莎白博士
Dialogue: 0,0:07:53.01,0:07:55.07,Layzner,,0,0,0,,现在向各国发出通知了
Dialogue: 0,0:07:55.14,0:07:56.06,Layzner,,0,0,0,,感谢您
Dialogue: 0,0:07:56.57,0:07:58.19,Layzner,,0,0,0,,我想知道详情
Dialogue: 0,0:07:58.38,0:08:01.57,Layzner,,0,0,0,,请您直接听在这里的英二说
Dialogue: 0,0:08:01.81,0:08:03.12,Layzner,,0,0,0,,英二
Dialogue: 0,0:08:03.39,0:08:07.90,Layzner,,0,0,0,,英二是古拉特斯人和地球人的混血 是我们的同伴
Dialogue: 0,0:08:07.92,0:08:10.26,Layzner,,0,0,0,,混血儿 怎么可能
Dialogue: 0,0:08:11.55,0:08:12.92,Layzner,,0,0,0,,不 继续
Dialogue: 0,0:08:13.01,0:08:13.72,Layzner,,0,0,0,,英二
Dialogue: 0,0:08:17.28,0:08:21.21,Layzner,,0,0,0,,我是从古拉特斯来通知地球危机的
Dialogue: 0,0:08:21.48,0:08:26.63,Layzner,,0,0,0,,而想要毁灭地球
Dialogue: 0,0:08:21.48,0:08:26.63,Layzner,,0,0,0,,古拉特斯因为感到地球不断开拓外太空的危机
Dialogue: 0,0:08:26.63,0:08:29.40,Layzner,,0,0,0,,你就是那个古拉特斯人吗
Dialogue: 0,0:08:29.99,0:08:32.11,Layzner,,0,0,0,,我叫阿尔巴特洛·英二·飞鸟
Dialogue: 0,0:08:34.83,0:08:35.94,Layzner,,0,0,0,,飞鸟
Dialogue: 0,0:08:36.12,0:08:39.24,Layzner,,0,0,0,,我妈妈是古拉特斯人 爸爸是地球人
Dialogue: 0,0:08:39.86,0:08:41.82,Layzner,,0,0,0,,名字 名字是什么
Dialogue: 0,0:08:42.01,0:08:44.30,Layzner,,0,0,0,,飞鸟健
Dialogue: 0,0:08:45.55,0:08:47.07,Layzner,,0,0,0,,你认识我爸爸吗
Dialogue: 0,0:08:49.90,0:08:51.14,Layzner,,0,0,0,,我认识
Dialogue: 0,0:08:51.46,0:08:53.98,Layzner,,0,0,0,,我就是把你父亲送上太空的工作人员之一
Dialogue: 0,0:08:53.98,0:08:57.55,Layzner,,0,0,0,,我和你爸爸是还朋友
Dialogue: 0,0:08:58.17,0:09:01.93,Layzner,,0,0,0,,那么 你是阿波罗X计划的约翰·基鲁巴特博士吗
Dialogue: 0,0:09:02.04,0:09:03.93,Layzner,,0,0,0,,对 没错
Dialogue: 0,0:09:04.00,0:09:06.89,Layzner,,0,0,0,,英二 你说你爸爸还活着是吗
Dialogue: 0,0:09:07.28,0:09:09.28,Layzner,,0,0,0,,我想快点见到你
Dialogue: 0,0:09:09.38,0:09:11.31,Layzner,,0,0,0,,我也是 英二
Dialogue: 0,0:09:12.02,0:09:13.85,Layzner,,0,0,0,,资料信息
Dialogue: 0,0:09:13.98,0:09:16.77,Layzner,,0,0,0,,离进入大气层还有3.00分
Dialogue: 0,0:09:16.77,0:09:18.41,Layzner,,0,0,0,,听好了 英二
Dialogue: 0,0:09:18.41,0:09:20.00,Layzner,,0,0,0,,祝你平安降落
Dialogue: 0,0:09:20.00,0:09:20.94,Layzner,,0,0,0,,是
Dialogue: 0,0:09:21.67,0:09:22.94,Layzner,,0,0,0,, 爸爸
Dialogue: 0,0:09:22.94,0:09:24.94,Layzner,,0,0,0,,这里竟然有人认识爸爸
Dialogue: 0,0:09:26.02,0:09:26.75,Layzner,,0,0,0,,英二
Dialogue: 0,0:09:26.94,0:09:28.27,Layzner,,0,0,0,,太好了
Dialogue: 0,0:09:28.27,0:09:29.44,Layzner,,0,0,0,,做得好
Dialogue: 0,0:09:30.00,0:09:30.82,Layzner,,0,0,0,,英二
Dialogue: 0,0:09:32.00,0:09:33.06,Layzner,,0,0,0,,太好了
Dialogue: 0,0:09:34.73,0:09:38.89,Layzner,,0,0,0,,接下来你就会有很多亲戚 很麻烦的
Dialogue: 0,0:09:40.49,0:09:41.92,Layzner,,0,0,0,,那真的很麻烦
Dialogue: 0,0:09:46.17,0:09:48.17,Layzner,,0,0,0,,这时候大家的笑声
Dialogue: 0,0:09:48.38,0:09:51.53,Layzner,,0,0,0,,让痛苦 悲伤 愤怒 仇恨
Dialogue: 0,0:09:51.68,0:09:54.10,Layzner,,0,0,0,,所有讨厌的事
Dialogue: 0,0:09:54.10,0:09:56.74,Layzner,,0,0,0,,都在一瞬间消失了
Dialogue: 0,0:09:57.45,0:10:02.62,Layzner,,0,0,0,,因为认识英二爸爸的人就在地球上
Dialogue: 0,0:10:06.38,0:10:10.47,Layzner,,0,0,0,,资料信息 离进入大气层还有2.00分
Dialogue: 0,0:10:10.47,0:10:14.28,Layzner,,0,0,0,,要突入大气层了
Dialogue: 0,0:10:10.47,0:10:14.28,Layzner,,0,0,0,,大家 找安全的地方坐好
Dialogue: 0,0:10:15.30,0:10:16.55,Layzner,,0,0,0,,好 太好了
Dialogue: 0,0:10:18.07,0:10:20.83,Layzner,,0,0,0,,回家了 回到地球了
Dialogue: 0,0:10:21.53,0:10:23.46,Layzner,,0,0,0,,又回到我们的故乡
Dialogue: 0,0:10:23.63,0:10:25.95,Layzner,,0,0,0,,闪耀着蔚蓝光芒的地球
Dialogue: 0,0:10:26.53,0:10:29.49,Layzner,,0,0,0,,我们终于回来了
Dialogue: 0,0:10:33.74,0:10:35.29,Layzner,,0,0,0,,那个背叛者
Dialogue: 0,0:10:35.29,0:10:37.29,Layzner,,0,0,0,,好像已经突破地球上空了
Dialogue: 0,0:10:37.69,0:10:39.37,Layzner,,0,0,0,,陛下 该怎么办
Dialogue: 0,0:10:39.73,0:10:43.00,Layzner,,0,0,0,,把玖丽亚作为血色凯撒尔的机师
Dialogue: 0,0:10:43.00,0:10:43.79,Layzner,,0,0,0,,是
Dialogue: 0,0:10:44.95,0:10:49.83,Layzner,,0,0,0,,我想看她会选对古拉特斯效忠还是选对英二的亲情
Dialogue: 0,0:10:49.83,0:10:53.13,Layzner,,0,0,0,,原来如此 陛下也真坏啊
Dialogue: 0,0:10:53.13,0:10:55.79,Layzner,,0,0,0,,不过 结果还真令人期待
Dialogue: 0,0:10:56.02,0:11:01.00,Layzner,,0,0,0,,要尽量避免把古拉特斯的武器交给地球人
Dialogue: 0,0:11:01.25,0:11:01.80,Layzner,,0,0,0,,了解
Dialogue: 0,0:12:06.62,0:12:09.18,Layzner,,0,0,0,,大家已经没事了 可以出来了
Dialogue: 0,0:12:09.96,0:12:12.65,Layzner,,0,0,0,,是欧洲大陆
Dialogue: 0,0:12:12.87,0:12:16.06,Layzner,,0,0,0,,你们看 是法国 那是我的故乡
Dialogue: 0,0:12:16.06,0:12:18.71,Layzner,,0,0,0,,太好了 到地球了 地球啊
Dialogue: 0,0:12:19.01,0:12:20.19,Layzner,,0,0,0,,好棒
Dialogue: 0,0:12:20.47,0:12:22.86,Layzner,,0,0,0,,我去叫大家
Dialogue: 0,0:12:22.86,0:12:25.55,Layzner,,0,0,0,,大家 看到海了
Dialogue: 0,0:12:25.55,0:12:26.98,Layzner,,0,0,0,,对啊 是海
Dialogue: 0,0:12:26.98,0:12:29.59,Layzner,,0,0,0,,头一次见到这么棒的景色
Dialogue: 0,0:12:29.59,0:12:32.56,Layzner,,0,0,0,,海的那一边就是我妈妈的故乡英国
Dialogue: 0,0:12:33.29,0:12:34.28,Layzner,,0,0,0,,太好了
Dialogue: 0,0:12:34.28,0:12:35.43,Layzner,,0,0,0,,做的好
Dialogue: 0,0:12:36.68,0:12:38.60,Layzner,,0,0,0,,做的太好了 你这家伙
Dialogue: 0,0:12:41.24,0:12:42.00,Layzner,,0,0,0,,安娜
Dialogue: 0,0:12:44.55,0:12:46.90,Layzner,,0,0,0,,回家了
Dialogue: 0,0:12:46.97,0:12:51.23,Layzner,,0,0,0,,我们回家了
Dialogue: 0,0:13:05.23,0:13:08.66,Layzner,,0,0,0,,警告信息 四号镜头有部队接近
Dialogue: 0,0:13:08.66,0:13:09.69,Layzner,,0,0,0,,什么
Dialogue: 0,0:13:09.69,0:13:11.11,Layzner,,0,0,0,,没事的
Dialogue: 0,0:13:11.12,0:13:13.46,Layzner,,0,0,0,,基鲁巴特博士已经通知了
Dialogue: 0,0:13:13.46,0:13:15.85,Layzner,,0,0,0,,不对 是古拉特斯的追击部队
Dialogue: 0,0:13:16.76,0:13:17.60,Layzner,,0,0,0,,英二
Dialogue: 0,0:13:17.60,0:13:19.60,Layzner,,0,0,0,,罗安 走吧 好
Dialogue: 0,0:13:49.92,0:13:54.57,Layzner,,0,0,0,,从二号镜头处接近
Dialogue: 0,0:13:49.92,0:13:54.57,Layzner,,0,0,0,,由敌人的航天飞机出现SPT九机
Dialogue: 0,0:13:54.57,0:13:57.69,Layzner,,0,0,0,,雷 你真的是雷吗
Dialogue: 0,0:13:57.84,0:14:00.14,Layzner,,0,0,0,,意义不明 请重新输入
Dialogue: 0,0:14:00.80,0:14:03.11,Layzner,,0,0,0,,雷 你里面还有其他的行动名吗
Dialogue: 0,0:14:03.11,0:14:05.11,Layzner,,0,0,0,,记录里没有记载
Dialogue: 0,0:14:05.35,0:14:07.30,Layzner,,0,0,0,,到底是怎么回事
Dialogue: 0,0:14:07.30,0:14:11.38,Layzner,,0,0,0,,警告 敌人接近有效射程
Dialogue: 0,0:14:11.38,0:14:12.21,Layzner,,0,0,0,,出发
Dialogue: 0,0:14:12.21,0:14:12.94,Layzner,,0,0,0,,Ready.
Dialogue: 0,0:14:20.71,0:14:22.85,Layzner,,0,0,0,,怎么能在这里被你干掉
Dialogue: 0,0:14:22.85,0:14:24.85,Layzner,,0,0,0,,你们别想平安的踩在地球上
Dialogue: 0,0:14:24.85,0:14:27.68,Layzner,,0,0,0,,敌人SPT进入一号镜头处
Dialogue: 0,0:14:27.68,0:14:29.07,Layzner,,0,0,0,,有热源反应
Dialogue: 0,0:14:32.98,0:14:33.76,Layzner,,0,0,0,,上了
Dialogue: 0,0:14:44.27,0:14:46.18,Layzner,,0,0,0,,黑色凯撒
Dialogue: 0,0:14:47.88,0:14:50.96,Layzner,,0,0,0,,和凯利前辈同一型的机器人
Dialogue: 0,0:14:50.96,0:14:52.96,Layzner,,0,0,0,,难不成  是凯利前辈
Dialogue: 0,0:14:59.34,0:15:00.92,Layzner,,0,0,0,,凯利前辈
Dialogue: 0,0:15:00.92,0:15:03.43,Layzner,,0,0,0,,那时候他还活着吗
Dialogue: 0,0:15:08.75,0:15:12.01,Layzner,,0,0,0,,如果那之后他获救的话
Dialogue: 0,0:15:17.73,0:15:18.69,Layzner,,0,0,0,,凯利前辈
Dialogue: 0,0:15:18.69,0:15:21.71,Layzner,,0,0,0,,是凯利前辈对吧 好久不见了
Dialogue: 0,0:15:22.23,0:15:25.23,Layzner,,0,0,0,,请回答我 你还活着对吧 凯利前辈
Dialogue: 0,0:15:28.77,0:15:30.85,Layzner,,0,0,0,,凯利前辈 请回答我
Dialogue: 0,0:15:34.80,0:15:36.93,Layzner,,0,0,0,,我不想再对你开枪
Dialogue: 0,0:15:44.00,0:15:47.58,Layzner,,0,0,0,,前辈 请回答
Dialogue: 0,0:15:51.63,0:15:53.15,Layzner,,0,0,0,,英二 你没事吧
Dialogue: 0,0:15:54.40,0:15:57.41,Layzner,,0,0,0,,警告 四号镜头有大量地球部队
Dialogue: 0,0:16:02.00,0:16:06.34,Layzner,,0,0,0,,我是美国空军的艾姆兹少佐
Dialogue: 0,0:16:06.34,0:16:07.74,Layzner,,0,0,0,,伊丽莎白博士请回答
Dialogue: 0,0:16:08.13,0:16:12.78,Layzner,,0,0,0,,我们的小型航天飞机受到敌人的追击
Dialogue: 0,0:16:08.13,0:16:12.78,Layzner,,0,0,0,,我是伊丽莎白 艾姆兹少佐
Dialogue: 0,0:16:12.93,0:16:14.18,Layzner,,0,0,0,,我知道了 交给我
Dialogue: 0,0:16:14.18,0:16:16.60,Layzner,,0,0,0,,第二第三中队去干掉敌人
Dialogue: 0,0:16:16.60,0:16:19.40,Layzner,,0,0,0,,第七中队负责护卫
Dialogue: 0,0:16:18.34,0:16:19.40,Layzner,,0,0,0,,了解
Dialogue: 0,0:16:19.40,0:16:22.31,Layzner,,0,0,0,,博士 后面也有大量的机队出现
Dialogue: 0,0:16:22.90,0:16:24.89,Layzner,,0,0,0,,一定是苏联还是哪里的部队
Dialogue: 0,0:16:28.41,0:16:30.60,Layzner,,0,0,0,,你们三个 援军来了 快回来
Dialogue: 0,0:16:30.60,0:16:31.39,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:16:56.23,0:16:57.97,Layzner,,0,0,0,,好厉害的动作
Dialogue: 0,0:16:57.97,0:16:59.86,Layzner,,0,0,0,,跟凯利前辈一样
Dialogue: 0,0:16:59.97,0:17:02.71,Layzner,,0,0,0,,可是为什么是红色的
Dialogue: 0,0:17:02.71,0:17:03.85,Layzner,,0,0,0,,伊丽莎白博士
Dialogue: 0,0:17:03.85,0:17:06.22,Layzner,,0,0,0,,请你们到爱德华斯空军基地
Dialogue: 0,0:17:06.93,0:17:09.29,Layzner,,0,0,0,,不 请带我们去联合国宇宙局总部
Dialogue: 0,0:17:09.61,0:17:11.96,Layzner,,0,0,0,,现在的情况如你所见 是不可能的
Dialogue: 0,0:17:11.96,0:17:13.96,Layzner,,0,0,0,,要先让你们平安的降落
Dialogue: 0,0:17:13.96,0:17:15.53,Layzner,,0,0,0,,要我同意有一个条件
Dialogue: 0,0:17:15.53,0:17:16.30,Layzner,,0,0,0,,什么
Dialogue: 0,0:17:17.51,0:17:21.56,Layzner,,0,0,0,,我们要求平等的待遇
Dialogue: 0,0:17:17.51,0:17:21.56,Layzner,,0,0,0,,我是联合国的工作人员
Dialogue: 0,0:17:21.56,0:17:23.56,Layzner,,0,0,0,,我知道了 跟我来
Dialogue: 0,0:17:28.82,0:17:31.58,Layzner,,0,0,0,,地球部队增援又接近了
Dialogue: 0,0:17:33.07,0:17:34.07,Layzner,,0,0,0,,我们先撤退吧
Dialogue: 0,0:17:46.43,0:17:49.68,Layzner,,0,0,0,,血色凯撒尔 你在干什么 快回来
Dialogue: 0,0:18:06.06,0:18:09.52,Layzner,,0,0,0,,爱德华斯空军基地
Dialogue: 0,0:18:15.48,0:18:18.94,Layzner,,0,0,0,,太好了 到了
Dialogue: 0,0:18:19.62,0:18:20.82,Layzner,,0,0,0,,这是美国耶
Dialogue: 0,0:18:20.82,0:18:22.82,Layzner,,0,0,0,,英二我们到了
Dialogue: 0,0:18:22.82,0:18:25.49,Layzner,,0,0,0,,英二 都是托你的福
Dialogue: 0,0:18:26.59,0:18:30.02,Layzner,,0,0,0,,（北美大陆放空军司令部 诺拉特）
Dialogue: 0,0:18:27.48,0:18:29.53,Layzner,,0,0,0,,因为刚才的战斗
Dialogue: 0,0:18:29.53,0:18:33.95,Layzner,,0,0,0,,我军90%的战力还有苏军也几乎全被消灭了
Dialogue: 0,0:18:34.53,0:18:36.88,Layzner,,0,0,0,,少将 可疑的航天飞机降落了
Dialogue: 0,0:18:36.88,0:18:38.52,Layzner,,0,0,0,,好 把影像打在屏幕上
Dialogue: 0,0:18:38.52,0:18:39.28,Layzner,,0,0,0,,是
Dialogue: 0,0:18:48.32,0:18:51.38,Layzner,,0,0,0,,还是地球的空气最好
Dialogue: 0,0:19:12.27,0:19:14.02,Layzner,,0,0,0,,外星人在里面吗
Dialogue: 0,0:19:16.19,0:19:19.87,Layzner,,0,0,0,,不只是他 他的同伴也要好好调查
Dialogue: 0,0:19:19.87,0:19:20.83,Layzner,,0,0,0,,是
Dialogue: 0,0:19:20.83,0:19:25.64,Layzner,,0,0,0,,特别是外星人的船跟船上的东西要好好分析调查
Dialogue: 0,0:19:25.64,0:19:27.72,Layzner,,0,0,0,,已经把工作人员捉起来了
Dialogue: 0,0:19:27.80,0:19:29.03,Layzner,,0,0,0,,要快点进行
Dialogue: 0,0:19:29.03,0:19:29.69,Layzner,,0,0,0,,是
Dialogue: 0,0:19:36.05,0:19:38.44,Layzner,,0,0,0,,让你久等了 我是罗艾特
Dialogue: 0,0:19:38.53,0:19:41.92,Layzner,,0,0,0,,恭喜你了 罗艾特 东西终于全部到手了
Dialogue: 0,0:19:41.92,0:19:46.49,Layzner,,0,0,0,,刚才苏联抗议我们独占俘虏
Dialogue: 0,0:19:46.60,0:19:49.47,Layzner,,0,0,0,,现在还在确认他到底是否为外星人
Dialogue: 0,0:19:49.47,0:19:51.82,Layzner,,0,0,0,,现在就先这样吧
Dialogue: 0,0:19:51.82,0:19:54.74,Layzner,,0,0,0,,你还真适合当政治家
Dialogue: 0,0:19:54.74,0:19:57.92,Layzner,,0,0,0,,谢谢您的称赞
Dialogue: 0,0:19:57.92,0:20:03.04,Layzner,,0,0,0,,这样就能继续在国际政治上领先了
Dialogue: 0,0:20:03.04,0:20:06.12,Layzner,,0,0,0,,那王牌现在就在我们手上
Dialogue: 0,0:20:06.12,0:20:08.38,Layzner,,0,0,0,,你说的没错
Dialogue: 0,0:20:12.61,0:20:14.94,Layzner,,0,0,0,,什么 英二的太空船被掳走了
Dialogue: 0,0:20:14.94,0:20:18.41,Layzner,,0,0,0,,是的 因为地球人的烂飞机超过我们想象的多
Dialogue: 0,0:20:18.41,0:20:19.82,Layzner,,0,0,0,,我不要再听这些借口了
Dialogue: 0,0:20:19.82,0:20:20.58,Layzner,,0,0,0,,是
Dialogue: 0,0:20:20.97,0:20:23.08,Layzner,,0,0,0,,那地球人的反应呢
Dialogue: 0,0:20:23.08,0:20:26.89,Layzner,,0,0,0,,是 他们好像已经知道我们的存在了
Dialogue: 0,0:20:27.02,0:20:28.64,Layzner,,0,0,0,,我想也是的
Dialogue: 0,0:20:28.64,0:20:30.08,Layzner,,0,0,0,,快出动 去镇压他们
Dialogue: 0,0:20:30.08,0:20:30.98,Layzner,,0,0,0,,了解
Dialogue: 0,0:20:32.88,0:20:36.11,Layzner,,0,0,0,,陛下 看来不像对火星还有月球时那么顺利了
Dialogue: 0,0:20:36.11,0:20:38.71,Layzner,,0,0,0,,我们只要一个按钮他们就死定了
Dialogue: 0,0:20:39.67,0:20:41.00,Layzner,,0,0,0,,的确
Dialogue: 0,0:20:42.16,0:20:43.77,Layzner,,0,0,0,,接下来
Dialogue: 0,0:20:44.37,0:20:48.00,Layzner,,0,0,0,,（联合国宇宙局总部）
Dialogue: 0,0:20:44.56,0:20:50.72,Layzner,,0,0,0,,现在下落不明 还在调查中 完毕
Dialogue: 0,0:20:44.56,0:20:50.72,Layzner,,0,0,0,,根据美国外交部的来电 还在调查中的航天飞机
Dialogue: 0,0:20:51.43,0:20:55.80,Layzner,,0,0,0,,别装了 想捉飞鸟英二当俘虏吗
Dialogue: 0,0:20:56.20,0:20:59.57,Layzner,,0,0,0,,打电话给白宫 叫他们总统来
Dialogue: 0,0:20:59.57,0:21:01.53,Layzner,,0,0,0,,我直接跟他说
Dialogue: 0,0:21:01.53,0:21:02.60,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:21:04.58,0:21:08.39,Layzner,,0,0,0,,这根本就是把我们当俘虏 让我跟联合国宇宙局总部联络
Dialogue: 0,0:21:08.78,0:21:11.86,Layzner,,0,0,0,,冷静一点 来点镇静剂吧
Dialogue: 0,0:21:13.05,0:21:13.81,Layzner,,0,0,0,,不用
Dialogue: 0,0:21:13.81,0:21:16.11,Layzner,,0,0,0,,现在的你需要的
Dialogue: 0,0:21:16.35,0:21:18.68,Layzner,,0,0,0,,你这无礼的家伙 放开我
Dialogue: 0,0:21:18.68,0:21:21.93,Layzner,,0,0,0,,要把我们关在这玻璃房到什么时候 放我出去
Dialogue: 0,0:21:22.09,0:21:25.96,Layzner,,0,0,0,,没用的 大卫 这是魔术镜子
Dialogue: 0,0:21:25.96,0:21:28.04,Layzner,,0,0,0,,我们被监视着呢
Dialogue: 0,0:21:28.04,0:21:29.19,Layzner,,0,0,0,,真的吗
Dialogue: 0,0:21:31.08,0:21:32.73,Layzner,,0,0,0,,真下做
Dialogue: 0,0:21:36.40,0:21:38.86,Layzner,,0,0,0,,再做一次
Dialogue: 0,0:21:54.44,0:21:57.61,Layzner,,0,0,0,,父亲 我不会这样就灰心的
Dialogue: 0,0:21:57.61,0:22:01.64,Layzner,,0,0,0,,只要他们调查我的血之后
Dialogue: 0,0:22:01.64,0:22:04.09,Layzner,,0,0,0,,就知道我跟地球人流一样的血
Dialogue: 0,0:22:04.09,0:22:07.87,Layzner,,0,0,0,,他们也能了解我的心
Dialogue: 0,0:22:07.87,0:22:11.48,Layzner,,0,0,0,,这样我想说什么他们应该就会知道了
Dialogue: 0,0:22:12.34,0:22:14.82,Layzner,,0,0,0,,他们也会去调查雷兹纳吗
Dialogue: 0,0:22:14.82,0:22:17.42,Layzner,,0,0,0,,不要分解雷兹纳 那很危险
Dialogue: 0,0:22:17.42,0:22:20.91,Layzner,,0,0,0,,有人听到吗 雷兹纳很危险
Dialogue: 0,0:22:26.33,0:22:32.12,Layzner,,0,0,0,,为了相信人要有很多证明对吧
Dialogue: 0,0:22:32.12,0:22:40.81,Layzner,,0,0,0,,这我虽不知道 可是好像人都是因此而招致很大的错误 
Dialogue: 0,0:22:41.82,0:22:51.33,Layzner,,0,0,0,,接下来会发生的可怕事件 就是因此而引起的
Dialogue: 0,0:23:54.15,0:23:56.87,Layzner,,0,0,0,,请不要调查雷兹纳
Dialogue: 0,0:23:56.87,0:23:58.59,Layzner,,0,0,0,,你好像很迷惘
Dialogue: 0,0:23:58.59,0:23:59.32,Layzner,,0,0,0,,我
Dialogue: 0,0:23:59.32,0:24:02.29,Layzner,,0,0,0,,所以我说了不要动雷兹纳的
Dialogue: 0,0:24:02.29,0:24:04.19,Layzner,,0,0,0,,英二 快逃
Dialogue: 0,0:24:03.89,0:24:08.33,Layzner,,0,0,0,,下一集 雷兹纳的愤怒

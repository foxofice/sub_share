Dialogue: 0,0:22:57.29,0:23:02.30,LayznerTopMusic,,0,0,0,,dakishimete, kinou yori
Dialogue: 0,0:22:57.29,0:23:02.30,LayznerMusic,,0,0,0,,抱紧我
Dialogue: 0,0:23:02.30,0:23:07.61,LayznerTopMusic,,0,0,0,,aishitai hito tidak iru
Dialogue: 0,0:23:02.30,0:23:07.75,LayznerMusic,,0,0,0,,比昨天更爱你
Dialogue: 0,0:23:08.18,0:23:16.61,LayznerTopMusic,,0,0,0,,toki ha hitoshizuku nigai namida
Dialogue: 0,0:23:08.18,0:23:16.61,LayznerMusic,,0,0,0,,时间是一滴 苦涩的泪
Dialogue: 0,0:23:16.61,0:23:21.46,LayznerTopMusic,,0,0,0,,kizutsuita pururougu
Dialogue: 0,0:23:16.61,0:23:21.46,LayznerMusic,,0,0,0,,受伤的序曲
Dialogue: 0,0:23:21.58,0:23:27.37,LayznerTopMusic,,0,0,0,,yasashisa e tsuzukuno yo
Dialogue: 0,0:23:21.58,0:23:27.37,LayznerMusic,,0,0,0,,继续着温柔
Dialogue: 0,0:23:27.78,0:23:34.63,LayznerTopMusic,,0,0,0,,mayowanai futari dake no
Dialogue: 0,0:23:27.78,0:23:34.63,LayznerMusic,,0,0,0,,只为这不再迷惘的两人
Dialogue: 0,0:23:35.86,0:23:39.37,LayznerTopMusic,,0,0,0,,LA ROSE ROUGE
Dialogue: 0,0:23:35.86,0:23:39.37,LayznerMusic,,0,0,0,,献上一曲野玫瑰之歌
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:01:01.46,0:01:02.54,Layzner,,0,0,0,,英二
Dialogue: 0,0:01:02.70,0:01:03.76,Layzner,,0,0,0,,怪物啊
Dialogue: 0,0:01:04.06,0:01:05.59,Layzner,,0,0,0,,我要在这里阻止你
Dialogue: 0,0:01:05.67,0:01:06.74,Layzner,,0,0,0,,不要开玩笑了
Dialogue: 0,0:01:55.14,0:01:57.00,Layzner,,0,0,0,,三年前的那一天
Dialogue: 0,0:01:58.03,0:02:00.99,Layzner,,0,0,0,,被压倒性优势的古拉诺斯所蹂躏
Dialogue: 0,0:02:01.58,0:02:04.31,Layzner,,0,0,0,,地球70%的城市被烧毁
Dialogue: 0,0:02:05.23,0:02:07.88,Layzner,,0,0,0,,失去的总人口的三分之一
Dialogue: 0,0:02:09.80,0:02:14.30,Layzner,,0,0,0,,然后 古拉特斯在这破坏之上
Dialogue: 0,0:02:15.18,0:02:19.42,Layzner,,0,0,0,,实行恐怖统治
Dialogue: 0,0:02:20.92,0:02:22.76,Layzner,,0,0,0,,如神般君临了整个地球
Dialogue: 0,0:02:22.76,0:02:27.74,Layzner,,0,0,0,,死鬼队的挑战
Dialogue: 0,0:02:42.16,0:02:42.92,Layzner,,0,0,0,,听着
Dialogue: 0,0:02:43.58,0:02:48.26,Layzner,,0,0,0,,到这里为止速度 力量和招数都还是古斯特罗占上风
Dialogue: 0,0:02:49.90,0:02:50.47,Layzner,,0,0,0,,看
Dialogue: 0,0:02:51.56,0:02:55.39,Layzner,,0,0,0,,在这个时刻DARUJAN的速度比LAYZNER要高出10%以上
Dialogue: 0,0:02:56.31,0:02:57.92,Layzner,,0,0,0,,问题在这之后
Dialogue: 0,0:02:58.39,0:03:00.35,Layzner,,0,0,0,,雷兹纳的V-MAX
Dialogue: 0,0:03:02.52,0:03:05.22,Layzner,,0,0,0,,要算出平均值数据还远远不够
Dialogue: 0,0:03:06.18,0:03:09.82,Layzner,,0,0,0,,但是 这两点的测定值显示为4.2倍
Dialogue: 0,0:03:10.34,0:03:13.67,Layzner,,0,0,0,,让雷兹纳加速的话 三对一都有危险
Dialogue: 0,0:03:14.03,0:03:16.03,Layzner,,0,0,0,,战斗可不是光看数据啊
Dialogue: 0,0:03:16.08,0:03:19.36,Layzner,,0,0,0,,古斯特罗也是一不小心给干掉的
Dialogue: 0,0:03:19.80,0:03:24.15,Layzner,,0,0,0,,由死鬼队制定打倒雷兹纳的必杀作战
Dialogue: 0,0:03:24.18,0:03:26.19,Layzner,,0,0,0,,这是鲁·凯恩大人的命令
Dialogue: 0,0:03:26.23,0:03:27.20,Layzner,,0,0,0,,你们忘了吗
Dialogue: 0,0:03:27.32,0:03:30.87,Layzner,,0,0,0,,正因为是大人的命令才在这里陪你啊
Dialogue: 0,0:03:31.07,0:03:32.77,Layzner,,0,0,0,,那就给我认真点
Dialogue: 0,0:03:33.19,0:03:38.10,Layzner,,0,0,0,,不过是数据比较在行少给我装老大 小鬼头
Dialogue: 0,0:03:48.67,0:03:52.72,Layzner,,0,0,0,,管我叫小鬼的没活过三天的
Dialogue: 0,0:03:52.72,0:03:53.92,Layzner,,0,0,0,,住手 MANJERO
Dialogue: 0,0:03:56.16,0:03:58.36,Layzner,,0,0,0,,Bohn 你小子
Dialogue: 0,0:03:58.68,0:04:00.31,Layzner,,0,0,0,,现在是作战期间
Dialogue: 0,0:04:08.04,0:04:10.77,Layzner,,0,0,0,,留你狗命到作战结束
Dialogue: 0,0:04:27.44,0:04:29.10,Layzner,,0,0,0,,快继续 还没完呢
Dialogue: 0,0:04:29.50,0:04:33.71,Layzner,,0,0,0,,给我抓紧了
Dialogue: 0,0:04:36.39,0:04:37.12,Layzner,,0,0,0,,这里是接线员
Dialogue: 0,0:04:37.31,0:04:37.84,Layzner,,0,0,0,,是我
Dialogue: 0,0:04:37.88,0:04:38.22,Layzner,,0,0,0,,是
Dialogue: 0,0:04:39.32,0:04:40.84,Layzner,,0,0,0,,您叫我吗 阁下
Dialogue: 0,0:04:41.51,0:04:42.19,Layzner,,0,0,0,,你等一会
Dialogue: 0,0:04:42.32,0:04:42.67,Layzner,,0,0,0,,是
Dialogue: 0,0:04:42.99,0:04:48.19,Layzner,,0,0,0,,听说地球上以前为了对应核战争 在地下建立了避难所
Dialogue: 0,0:04:48.30,0:04:50.02,Layzner,,0,0,0,,是的 有核避难所
Dialogue: 0,0:04:50.16,0:04:52.96,Layzner,,0,0,0,,给我列一张各核避难所位置和规模的列表
Dialogue: 0,0:04:53.71,0:04:56.38,Layzner,,0,0,0,,以这里为中心 半径一千公里以内的
Dialogue: 0,0:04:56.79,0:04:57.35,Layzner,,0,0,0,,是
Dialogue: 0,0:04:58.95,0:04:59.92,Layzner,,0,0,0,,接线员
Dialogue: 0,0:04:59.95,0:05:00.26,Layzner,,0,0,0,,是
Dialogue: 0,0:05:00.74,0:05:03.88,Layzner,,0,0,0,,给我准备侦察卫星的高精度分析数据
Dialogue: 0,0:05:04.10,0:05:04.94,Layzner,,0,0,0,,是 马上办
Dialogue: 0,0:05:07.59,0:05:09.36,Layzner,,0,0,0,,鲁·凯恩利用库斯科的圣女
Dialogue: 0,0:05:09.80,0:05:13.16,Layzner,,0,0,0,,妄图消灭游击队的阴谋被阻止了
Dialogue: 0,0:05:13.82,0:05:18.94,Layzner,,0,0,0,,但是我们还未成熟的力量暴露给了敌人
Dialogue: 0,0:05:20.03,0:05:23.91,Layzner,,0,0,0,,我们在完成自己的SPT之前
Dialogue: 0,0:05:24.28,0:05:27.83,Layzner,,0,0,0,,不得不加紧转移基地了
Dialogue: 0,0:05:28.46,0:05:31.96,Layzner,,0,0,0,,这个地下工厂无论如何都要保住
Dialogue: 0,0:05:37.52,0:05:41.29,Layzner,,0,0,0,,要打倒雷兹纳 需要这些追加兵器
Dialogue: 0,0:05:43.38,0:05:44.01,Layzner,,0,0,0,,嗯 可以
Dialogue: 0,0:05:49.02,0:05:50.64,Layzner,,0,0,0,,有什么需要的随便用
Dialogue: 0,0:05:51.16,0:05:52.47,Layzner,,0,0,0,,感谢大人
Dialogue: 0,0:05:53.19,0:05:56.38,Layzner,,0,0,0,,要封住雷兹纳的V-MAX
Dialogue: 0,0:05:56.74,0:05:58.98,Layzner,,0,0,0,,需要在有限空间战斗比较有利吗
Dialogue: 0,0:05:59.58,0:06:00.94,Layzner,,0,0,0,,正是
Dialogue: 0,0:06:01.39,0:06:04.26,Layzner,,0,0,0,,我有主意了 做好出击准备随时待命
Dialogue: 0,0:06:04.58,0:06:05.30,Layzner,,0,0,0,,是
Dialogue: 0,0:06:09.94,0:06:12.11,Layzner,,0,0,0,,小心点 要过来了
Dialogue: 0,0:06:12.38,0:06:14.98,Layzner,,0,0,0,,伊丽莎白小姐 二号仓库这是最后了
Dialogue: 0,0:06:15.98,0:06:16.90,Layzner,,0,0,0,,伊丽莎白
Dialogue: 0,0:06:17.26,0:06:20.22,Layzner,,0,0,0,,博士 作战完成98%了
Dialogue: 0,0:06:20.34,0:06:24.71,Layzner,,0,0,0,,好 我去新工厂那边了 剩下的交给你了
Dialogue: 0,0:06:24.83,0:06:25.38,Layzner,,0,0,0,,好
Dialogue: 0,0:06:29.74,0:06:33.49,Layzner,,0,0,0,,地下三百米深处以下 红外线探测器就无法探知了
Dialogue: 0,0:06:34.24,0:06:35.64,Layzner,,0,0,0,,用磁力探测辅助
Dialogue: 0,0:06:36.08,0:06:38.02,Layzner,,0,0,0,,加上磁力探测β波
Dialogue: 0,0:06:39.63,0:06:41.56,Layzner,,0,0,0,,锁定了12处
Dialogue: 0,0:06:42.43,0:06:43.86,Layzner,,0,0,0,,罗安还没到吗
Dialogue: 0,0:07:09.58,0:07:12.86,Layzner,,0,0,0,,修好了 手艺不错嘛
Dialogue: 0,0:07:19.46,0:07:20.30,Layzner,,0,0,0,,我来晚了
Dialogue: 0,0:07:24.98,0:07:25.86,Layzner,,0,0,0,,快输入
Dialogue: 0,0:07:26.06,0:07:26.37,Layzner,,0,0,0,,是
Dialogue: 0,0:07:27.28,0:07:30.24,Layzner,,0,0,0,,像你这样动作快的人难得会花这么久啊
Dialogue: 0,0:07:30.56,0:07:31.14,Layzner,,0,0,0,,是
Dialogue: 0,0:07:31.60,0:07:35.19,Layzner,,0,0,0,,因为是被旧地球军作为机密
Dialogue: 0,0:07:35.24,0:07:35.82,Layzner,,0,0,0,,阁下
Dialogue: 0,0:07:43.72,0:07:45.34,Layzner,,0,0,0,,死鬼队 立刻出动
Dialogue: 0,0:08:06.88,0:08:08.90,Layzner,,0,0,0,,第一 第二攻击队 跟我来
Dialogue: 0,0:08:09.12,0:08:11.05,Layzner,,0,0,0,,保卫C地区56区域
Dialogue: 0,0:08:31.19,0:08:32.54,Layzner,,0,0,0,,你小子 想死吗
Dialogue: 0,0:08:36.40,0:08:37.38,Layzner,,0,0,0,,你干什么
Dialogue: 0,0:08:37.43,0:08:38.18,Layzner,,0,0,0,,快住手
Dialogue: 0,0:08:42.69,0:08:43.73,Layzner,,0,0,0,,你这混蛋
Dialogue: 0,0:08:50.60,0:08:51.46,Layzner,,0,0,0,,别过来
Dialogue: 0,0:09:16.58,0:09:18.44,Layzner,,0,0,0,,第一攻击队 守住西面
Dialogue: 0,0:09:18.56,0:09:20.87,Layzner,,0,0,0,,第二攻击队 分散到东面和北面
Dialogue: 0,0:09:21.18,0:09:23.06,Layzner,,0,0,0,,你们别出手
Dialogue: 0,0:09:46.95,0:09:48.82,Layzner,,0,0,0,,敌SPT三机侵入 敌SPT三机侵入
Dialogue: 0,0:09:49.00,0:09:50.91,Layzner,,0,0,0,,只差一点了啊
Dialogue: 0,0:09:51.07,0:09:52.60,Layzner,,0,0,0,,博士 让大家抓紧
Dialogue: 0,0:09:55.12,0:09:56.84,Layzner,,0,0,0,,大卫 保卫大家
Dialogue: 0,0:09:57.07,0:09:57.66,Layzner,,0,0,0,,好
Dialogue: 0,0:10:06.18,0:10:07.11,Layzner,,0,0,0,,快点
Dialogue: 0,0:10:28.75,0:10:30.28,Layzner,,0,0,0,,快点 快走
Dialogue: 0,0:10:30.72,0:10:31.76,Layzner,,0,0,0,,英二
Dialogue: 0,0:10:37.48,0:10:40.20,Layzner,,0,0,0,,SPT有三机 就在这里阻止你们
Dialogue: 0,0:10:43.79,0:10:44.59,Layzner,,0,0,0,,英二
Dialogue: 0,0:10:48.82,0:10:49.63,Layzner,,0,0,0,,英二
Dialogue: 0,0:10:58.35,0:10:58.90,Layzner,,0,0,0,,那是
Dialogue: 0,0:11:10.83,0:11:11.72,Layzner,,0,0,0,,浮游机雷
Dialogue: 0,0:11:38.46,0:11:40.19,Layzner,,0,0,0,,滚出来 雷兹纳
Dialogue: 0,0:12:04.14,0:12:08.91,Layzner,,0,0,0,,在这样有限的空间 还被散布了浮游机雷 V-MAX不能用了
Dialogue: 0,0:12:09.28,0:12:12.53,Layzner,,0,0,0,,怎么啦 快加速啊 雷兹纳 还是这么被烧死呢
Dialogue: 0,0:12:57.36,0:13:02.03,Layzner,,0,0,0,,怎么啦 这就完了吗 真没意思啊
Dialogue: 0,0:13:03.24,0:13:07.24,Layzner,,0,0,0,,死鬼队完全掌握住雷兹纳了 向阁下报告
Dialogue: 0,0:13:07.68,0:13:08.24,Layzner,,0,0,0,,了解
Dialogue: 0,0:13:12.00,0:13:16.02,Layzner,,0,0,0,,雷兹纳 自己做盾让同伴逃走吗
Dialogue: 0,0:13:16.59,0:13:20.50,Layzner,,0,0,0,,这种逞英雄的行为正是自掘坟墓啊
Dialogue: 0,0:13:21.43,0:13:22.94,Layzner,,0,0,0,,真是讽刺
Dialogue: 0,0:13:24.07,0:13:26.50,Layzner,,0,0,0,,他要是也有你这般聪明的话
Dialogue: 0,0:13:44.91,0:13:45.85,Layzner,,0,0,0,,什么
Dialogue: 0,0:14:10.60,0:14:12.43,Layzner,,0,0,0,,别乱动啊
Dialogue: 0,0:14:57.82,0:14:59.16,Layzner,,0,0,0,,怎么啦
Dialogue: 0,0:15:13.36,0:15:14.30,Layzner,,0,0,0,,什么人
Dialogue: 0,0:15:14.94,0:15:16.44,Layzner,,0,0,0,,开火 开火
Dialogue: 0,0:15:41.54,0:15:43.51,Layzner,,0,0,0,,怪 怪物啊
Dialogue: 0,0:16:42.87,0:16:45.00,Layzner,,0,0,0,,Getty（人名）给我按住雷兹纳
Dialogue: 0,0:16:45.18,0:16:46.91,Layzner,,0,0,0,,哦啊啊
Dialogue: 0,0:17:01.96,0:17:04.15,Layzner,,0,0,0,,Getty 你干啥呢
Dialogue: 0,0:17:40.58,0:17:43.06,Layzner,,0,0,0,,跳舞吧 跳舞吧 雷兹纳
Dialogue: 0,0:17:49.26,0:17:52.09,Layzner,,0,0,0,,那可是我的猎物啊
Dialogue: 0,0:18:00.67,0:18:02.54,Layzner,,0,0,0,,Getty 给我抓紧了
Dialogue: 0,0:18:02.59,0:18:03.46,Layzner,,0,0,0,,不是我的错啊
Dialogue: 0,0:18:03.51,0:18:06.14,Layzner,,0,0,0,,你除了力气这个长处就是个废物
Dialogue: 0,0:18:06.67,0:18:08.23,Layzner,,0,0,0,,什么 JULI
Dialogue: 0,0:18:17.11,0:18:18.67,Layzner,,0,0,0,,Getty 干什么呢
Dialogue: 0,0:18:19.18,0:18:20.54,Layzner,,0,0,0,,给我按住雷兹纳
Dialogue: 0,0:18:21.44,0:18:23.08,Layzner,,0,0,0,,是 是古斯特罗
Dialogue: 0,0:18:23.43,0:18:25.84,Layzner,,0,0,0,,你傻啊 丫已经挂了啊
Dialogue: 0,0:18:25.98,0:18:28.29,Layzner,,0,0,0,,我 我没胡说 就在那里
Dialogue: 0,0:18:35.02,0:18:37.65,Layzner,,0,0,0,,你 你小子 想杀了我啊
Dialogue: 0,0:18:47.68,0:18:50.33,Layzner,,0,0,0,,Getty 你连我也
Dialogue: 0,0:18:50.50,0:18:53.29,Layzner,,0,0,0,,不 不是的 真的是古斯特罗
Dialogue: 0,0:18:53.48,0:18:55.00,Layzner,,0,0,0,,少耍我了 Getty!
Dialogue: 0,0:18:56.51,0:18:59.00,Layzner,,0,0,0,,你干什么 要自杀吗
Dialogue: 0,0:19:00.78,0:19:02.27,Layzner,,0,0,0,,住手啊
Dialogue: 0,0:19:04.02,0:19:06.40,Layzner,,0,0,0,,不想死的话就快下来
Dialogue: 0,0:19:06.58,0:19:07.66,Layzner,,0,0,0,,什么
Dialogue: 0,0:19:18.04,0:19:21.45,Layzner,,0,0,0,,老子把你们都杀了
Dialogue: 0,0:19:27.59,0:19:29.81,Layzner,,0,0,0,,古斯特罗
Dialogue: 0,0:19:32.15,0:19:34.60,Layzner,,0,0,0,,Getty 回到队形
Dialogue: 0,0:19:54.16,0:19:55.36,Layzner,,0,0,0,,不 不行了
Dialogue: 0,0:20:34.75,0:20:36.02,Layzner,,0,0,0,,到底是怎么回事
Dialogue: 0,0:20:36.14,0:20:38.69,Layzner,,0,0,0,,脚步关节中弹 无法行动
Dialogue: 0,0:21:07.44,0:21:08.33,Layzner,,0,0,0,,Ge..tty...
Dialogue: 0,0:21:45.96,0:21:47.00,Layzner,,0,0,0,,不 不好
Dialogue: 0,0:21:56.71,0:21:58.73,Layzner,,0,0,0,,Manjero 要爆炸了
Dialogue: 0,0:21:59.06,0:22:00.18,Layzner,,0,0,0,,快撤
Dialogue: 0,0:22:09.11,0:22:09.61,Layzner,,0,0,0,,撤退
Dialogue: 0,0:22:35.39,0:22:38.52,Layzner,,0,0,0,,雷兹纳逃走 死鬼队失去一台机体
Dialogue: 0,0:22:40.03,0:22:40.72,Layzner,,0,0,0,,退下
Dialogue: 0,0:22:41.40,0:22:42.18,Layzner,,0,0,0,,属下告退
Dialogue: 0,0:22:45.18,0:22:46.60,Layzner,,0,0,0,,该死的雷兹纳
Dialogue: 0,0:23:55.24,0:23:56.01,Layzner,,0,0,0,,怎么了 GAO
Dialogue: 0,0:23:56.36,0:23:56.82,Layzner,,0,0,0,,什么
Dialogue: 0,0:23:57.03,0:23:57.34,Layzner,,0,0,0,,是真的吗
Dialogue: 0,0:23:57.60,0:23:59.36,Layzner,,0,0,0,,安娜的所在被死鬼队知道了
Dialogue: 0,0:24:04.06,0:24:08.59,Layzner,,0,0,0,,次回 被盯上的安娜
Dialogue: 0,0:23:39.37,0:23:41.37,LayznerMusic,,0,0,0,,

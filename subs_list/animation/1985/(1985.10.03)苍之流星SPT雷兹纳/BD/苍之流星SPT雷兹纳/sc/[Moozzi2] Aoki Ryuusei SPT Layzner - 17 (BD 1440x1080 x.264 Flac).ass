Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:02.29,0:01:03.69,Layzner,,0,0,0,,不...
Dialogue: 0,0:01:03.70,0:01:05.50,Layzner,,0,0,0,,那时候的事
Dialogue: 0,0:01:05.51,0:01:08.68,Layzner,Eiji,0,0,0,,这时候不要说以前的事
Dialogue: 0,0:01:08.69,0:01:09.89,Layzner,,0,0,0,,不 你说的对
Dialogue: 0,0:01:45.53,0:01:49.23,Layzner,,0,0,0,,为什么要离开自己的岗位 你们想死是吗
Dialogue: 0,0:01:50.75,0:01:52.03,Layzner,,0,0,0,,你是哪里来的
Dialogue: 0,0:01:52.03,0:01:53.80,Layzner,,0,0,0,,我是从火星逃出来的
Dialogue: 0,0:02:14.54,0:02:19.35,Layzner,,0,0,0,,第十七话 成群的杀人机器
Dialogue: 0,0:02:21.97,0:02:25.86,Layzner,,0,0,0,,好不容易到达月球 在这里等候我们的
Dialogue: 0,0:02:25.87,0:02:31.60,Layzner,,0,0,0,,只有八个小孩跟一名美军飞行员
Dialogue: 0,0:02:34.83,0:02:36.61,Layzner,,0,0,0,,虽然跟之前的机型都不同
Dialogue: 0,0:02:36.61,0:02:38.57,Layzner,,0,0,0,,但能确定是古拉特斯的机动兵器
Dialogue: 0,0:02:38.57,0:02:40.12,Layzner,,0,0,0,,果然是他们吗
Dialogue: 0,0:02:49.83,0:02:52.79,Layzner,,0,0,0,,英二 敌人来了
Dialogue: 0,0:02:52.79,0:02:57.69,Layzner,,0,0,0,,果然这里也受到他们攻击了
Dialogue: 0,0:02:52.79,0:02:57.69,Layzner,,0,0,0,,新型的机器人接近中
Dialogue: 0,0:02:57.69,0:03:00.30,Layzner,,0,0,0,,这里也有三架在接近我们
Dialogue: 0,0:03:01.45,0:03:03.17,Layzner,,0,0,0,,资料信息
Dialogue: 0,0:03:03.17,0:03:07.72,Layzner,,0,0,0,,TS-SG-50C 型 骷髅炮手 它们的武器有热流弹两门
Dialogue: 0,0:03:07.72,0:03:13.77,Layzner,,0,0,0,,激光炮一门 内藏式激光 还有自动修理系统
Dialogue: 0,0:03:30.98,0:03:34.94,Layzner,,0,0,0,,最大力量198 最高速度82
Dialogue: 0,0:03:56.22,0:03:56.96,Layzner,,0,0,0,,乔伊
Dialogue: 0,0:03:57.75,0:03:59.70,Layzner,,0,0,0,,马卡斯 马卡斯在哪里
Dialogue: 0,0:03:59.70,0:04:00.64,Layzner,,0,0,0,,我在这
Dialogue: 0,0:04:02.53,0:04:06.39,Layzner,,0,0,0,,你们两个带我去驾驶舱
Dialogue: 0,0:04:10.20,0:04:11.27,Layzner,,0,0,0,,古雷特
Dialogue: 0,0:04:15.58,0:04:16.94,Layzner,,0,0,0,,你想干什么
Dialogue: 0,0:04:16.94,0:04:18.41,Layzner,,0,0,0,,当然是作战了
Dialogue: 0,0:04:18.41,0:04:20.07,Layzner,,0,0,0,,乔伊 马卡斯
Dialogue: 0,0:04:20.07,0:04:22.27,Layzner,,0,0,0,,你们两个年纪最大对吧
Dialogue: 0,0:04:22.27,0:04:25.72,Layzner,,0,0,0,,你们当我的眼睛
Dialogue: 0,0:04:25.72,0:04:27.39,Layzner,,0,0,0,,我没有你们不行 走吧
Dialogue: 0,0:04:28.76,0:04:29.68,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:04:31.55,0:04:34.88,Layzner,,0,0,0,,古雷特 战斗交给他们两个就好了
Dialogue: 0,0:04:34.88,0:04:36.73,Layzner,,0,0,0,,他们一定会保护我们的
Dialogue: 0,0:04:36.73,0:04:37.59,Layzner,,0,0,0,,我知道
Dialogue: 0,0:04:37.59,0:04:41.14,Layzner,,0,0,0,,可是为了要活下去 我们也要战斗
Dialogue: 0,0:05:49.80,0:05:53.41,Layzner,,0,0,0,,大卫 它们是无人战斗机器人 瞄准他们的感应器
Dialogue: 0,0:05:53.41,0:05:54.33,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:06:26.30,0:06:30.04,Layzner,,0,0,0,,听好了 要看好敌人是否来了
Dialogue: 0,0:06:30.04,0:06:30.97,Layzner,,0,0,0,,来了吗
Dialogue: 0,0:06:42.55,0:06:44.31,Layzner,,0,0,0,,在哪里 敌人在哪里
Dialogue: 0,0:06:44.31,0:06:45.90,Layzner,,0,0,0,,还 还没看到
Dialogue: 0,0:06:47.84,0:06:49.22,Layzner,,0,0,0,,来了 在前面
Dialogue: 0,0:06:58.85,0:07:00.30,Layzner,,0,0,0,,打到了吗
Dialogue: 0,0:07:00.30,0:07:01.59,Layzner,,0,0,0,,我看不清
Dialogue: 0,0:07:03.00,0:07:04.60,Layzner,,0,0,0,,还不行 它还在动
Dialogue: 0,0:07:05.64,0:07:06.60,Layzner,,0,0,0,,可恶
Dialogue: 0,0:07:12.82,0:07:14.48,Layzner,,0,0,0,,你们两个快过来
Dialogue: 0,0:07:41.40,0:07:43.95,Layzner,,0,0,0,,右边 还是左边 哪一边
Dialogue: 0,0:07:44.79,0:07:45.95,Layzner,,0,0,0,,在哪边
Dialogue: 0,0:07:47.42,0:07:48.52,Layzner,,0,0,0,,下来 古雷特
Dialogue: 0,0:07:52.20,0:07:53.12,Layzner,,0,0,0,,乔伊
Dialogue: 0,0:07:58.45,0:07:59.79,Layzner,,0,0,0,,来我这里
Dialogue: 0,0:08:05.38,0:08:07.35,Layzner,,0,0,0,,在哪里
Dialogue: 0,0:08:19.76,0:08:21.96,Layzner,,0,0,0,,在哪里 敌人在哪里
Dialogue: 0,0:08:22.29,0:08:23.98,Layzner,,0,0,0,,中尉 不要开枪
Dialogue: 0,0:08:24.64,0:08:26.17,Layzner,,0,0,0,,住手 中尉
Dialogue: 0,0:08:27.22,0:08:29.70,Layzner,,0,0,0,,中尉 不要开枪
Dialogue: 0,0:08:34.09,0:08:37.96,Layzner,,0,0,0,,伊丽莎白博士 叫中尉停止攻击
Dialogue: 0,0:08:39.97,0:08:44.18,Layzner,,0,0,0,,告诉我 敌人在哪里
Dialogue: 0,0:08:44.18,0:08:47.30,Layzner,,0,0,0,,住手 古雷特 你射到同伴了 住手
Dialogue: 0,0:08:52.97,0:08:55.24,Layzner,,0,0,0,,同伴 我射到同伴了吗
Dialogue: 0,0:08:55.24,0:08:57.24,Layzner,,0,0,0,,够了 已经够了
Dialogue: 0,0:08:59.94,0:09:01.14,Layzner,,0,0,0,,大卫
Dialogue: 0,0:09:16.16,0:09:18.92,Layzner,,0,0,0,,伊丽莎白博士 趁现在快带孩子们走
Dialogue: 0,0:09:18.92,0:09:20.92,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:09:20.92,0:09:24.00,Layzner,,0,0,0,,快把大家叫过来 要逃离这里了
Dialogue: 0,0:09:25.56,0:09:26.98,Layzner,,0,0,0,,要去哪里
Dialogue: 0,0:09:26.98,0:09:29.16,Layzner,,0,0,0,,去我们坐的航天飞机
Dialogue: 0,0:09:29.16,0:09:32.10,Layzner,,0,0,0,,有太空船 太好了 谢谢你
Dialogue: 0,0:09:35.36,0:09:38.61,Layzner,,0,0,0,,把它丢了吧 你眼睛都变成这样了 拿了也没用
Dialogue: 0,0:09:38.84,0:09:40.61,Layzner,,0,0,0,,我觉得麻烦时再丢掉就好了
Dialogue: 0,0:09:53.55,0:09:57.60,Layzner,,0,0,0,,射那里的话就可以打倒它了
Dialogue: 0,0:09:53.55,0:09:57.60,Layzner,,0,0,0,,罗安 瞄准它的感应器
Dialogue: 0,0:09:57.60,0:10:00.69,Layzner,,0,0,0,,不用你说我也知道瞄那里 可是
Dialogue: 0,0:11:03.38,0:11:04.43,Layzner,,0,0,0,,英二
Dialogue: 0,0:11:36.41,0:11:39.98,Layzner,,0,0,0,,八个人 有八个小孩要来吗
Dialogue: 0,0:11:39.98,0:11:41.98,Layzner,,0,0,0,,是的
Dialogue: 0,0:11:41.98,0:11:44.61,Layzner,,0,0,0,,还有一个美军中尉
Dialogue: 0,0:11:44.61,0:11:47.13,Layzner,,0,0,0,,这航天飞机可以容纳这么多人吗
Dialogue: 0,0:11:47.13,0:11:49.13,Layzner,,0,0,0,,可以的 只要把多余的东西丢了就行
Dialogue: 0,0:11:49.97,0:11:51.73,Layzner,,0,0,0,,什么是多余的东西
Dialogue: 0,0:11:51.73,0:11:53.48,Layzner,,0,0,0,,一定是在说你
Dialogue: 0,0:11:59.11,0:12:00.16,Layzner,,0,0,0,,走吧
Dialogue: 0,0:12:00.16,0:12:01.64,Layzner,,0,0,0,,小心点
Dialogue: 0,0:12:04.94,0:12:06.55,Layzner,,0,0,0,,我想起来了
Dialogue: 0,0:12:08.33,0:12:10.45,Layzner,,0,0,0,,不 我是说那时候的事情
Dialogue: 0,0:12:11.73,0:12:14.08,Layzner,,0,0,0,,这时候不要讲以前的事
Dialogue: 0,0:12:14.08,0:12:16.08,Layzner,,0,0,0,,不 你说的对
Dialogue: 0,0:12:18.88,0:12:19.90,Layzner,,0,0,0,,快过来
Dialogue: 0,0:12:51.40,0:12:52.42,Layzner,,0,0,0,,小心
Dialogue: 0,0:12:54.87,0:12:58.25,Layzner,,0,0,0,,警告 左前方27号处
Dialogue: 0,0:12:58.25,0:13:00.94,Layzner,,0,0,0,,有敌人三架侵入
Dialogue: 0,0:13:13.80,0:13:14.87,Layzner,,0,0,0,,这边
Dialogue: 0,0:13:14.87,0:13:16.07,Layzner,,0,0,0,,英二
Dialogue: 0,0:13:21.64,0:13:22.56,Layzner,,0,0,0,,危险
Dialogue: 0,0:13:22.99,0:13:24.06,Layzner,,0,0,0,,快跟上来
Dialogue: 0,0:13:38.19,0:13:40.54,Layzner,,0,0,0,,大家没事吗 跟得上吧
Dialogue: 0,0:13:40.54,0:13:42.20,Layzner,,0,0,0,,没问题
Dialogue: 0,0:13:47.16,0:13:49.56,Layzner,,0,0,0,,只有他们没问题吗
Dialogue: 0,0:13:49.56,0:13:52.33,Layzner,,0,0,0,,有我们反而会妨碍他们
Dialogue: 0,0:14:05.84,0:14:07.20,Layzner,,0,0,0,,太好了
Dialogue: 0,0:14:07.20,0:14:09.67,Layzner,,0,0,0,,紧急生命系统还有用
Dialogue: 0,0:14:17.39,0:14:20.54,Layzner,,0,0,0,,大家 可以把头盔拿下来了
Dialogue: 0,0:14:26.36,0:14:28.48,Layzner,,0,0,0,,怎么样 外面的情况
Dialogue: 0,0:14:28.48,0:14:29.91,Layzner,,0,0,0,,没什么改变
Dialogue: 0,0:14:30.37,0:14:33.99,Layzner,,0,0,0,,应该被它们压制住了 可以帮我看下外面吗
Dialogue: 0,0:14:44.29,0:14:44.90,Layzner,,0,0,0,,会痛吗
Dialogue: 0,0:14:44.90,0:14:45.57,Layzner,,0,0,0,,不
Dialogue: 0,0:14:53.89,0:14:56.47,Layzner,,0,0,0,,和那时候一点都没有变呢
Dialogue: 0,0:15:03.31,0:15:06.10,Layzner,,0,0,0,,你也一点都没变
Dialogue: 0,0:15:06.10,0:15:07.33,Layzner,,0,0,0,,你又看不到
Dialogue: 0,0:15:07.33,0:15:08.56,Layzner,,0,0,0,,我知道的
Dialogue: 0,0:15:08.56,0:15:12.13,Layzner,,0,0,0,,你的鼻子 嘴唇 眼睛 一切都跟以前一样
Dialogue: 0,0:15:12.41,0:15:15.59,Layzner,,0,0,0,,两边的外眼角各多了一条褶皱 合计多了两条
Dialogue: 0,0:15:15.59,0:15:19.22,Layzner,,0,0,0,,那才好 其实我喜欢年纪较大的
Dialogue: 0,0:15:19.22,0:15:22.16,Layzner,,0,0,0,,你还是像以前一样不会说话
Dialogue: 0,0:15:22.16,0:15:23.64,Layzner,,0,0,0,,听起来好讽刺
Dialogue: 0,0:15:23.64,0:15:24.66,Layzner,,0,0,0,,伊丽莎白
Dialogue: 0,0:15:25.58,0:15:27.65,Layzner,,0,0,0,,如果可以的话
Dialogue: 0,0:15:27.65,0:15:30.34,Layzner,,0,0,0,,我们可以再重来一次吗
Dialogue: 0,0:15:32.11,0:15:35.06,Layzner,,0,0,0,,我想我们两人应该也都又有成长了
Dialogue: 0,0:15:45.74,0:15:46.49,Layzner,,0,0,0,,会痛吗
Dialogue: 0,0:15:46.49,0:15:47.92,Layzner,,0,0,0,,不
Dialogue: 0,0:15:47.92,0:15:50.47,Layzner,,0,0,0,,瞳孔好像没有异状
Dialogue: 0,0:15:51.45,0:15:52.73,Layzner,,0,0,0,,外面的情况如何
Dialogue: 0,0:15:53.47,0:15:55.12,Layzner,,0,0,0,,没有异状
Dialogue: 0,0:15:57.10,0:16:01.02,Layzner,,0,0,0,,如果只是眼内出血的话花点时间就好了
Dialogue: 0,0:16:03.44,0:16:06.92,Layzner,,0,0,0,,有个好像地下道入口的东西
Dialogue: 0,0:16:12.51,0:16:14.76,Layzner,,0,0,0,,大家把头盔戴上
Dialogue: 0,0:16:16.75,0:16:18.31,Layzner,,0,0,0,,乔伊 减少气压
Dialogue: 0,0:16:18.31,0:16:19.55,Layzner,,0,0,0,,好
Dialogue: 0,0:16:42.04,0:16:45.49,Layzner,,0,0,0,,英二 我们在布满缆线的道路上
Dialogue: 0,0:16:45.49,0:16:49.39,Layzner,,0,0,0,,应该可以平安到地面上
Dialogue: 0,0:16:45.49,0:16:49.39,Layzner,,0,0,0,,这里好像连到机场
Dialogue: 0,0:16:49.39,0:16:50.42,Layzner,,0,0,0,,了解
Dialogue: 0,0:16:50.82,0:16:52.65,Layzner,,0,0,0,,这样很好
Dialogue: 0,0:16:52.65,0:16:55.23,Layzner,,0,0,0,,这里我们自己会想办法 可恶
Dialogue: 0,0:17:14.04,0:17:18.28,Layzner,,0,0,0,,你说古拉特斯人 他们是谁 目的呢
Dialogue: 0,0:17:18.28,0:17:22.33,Layzner,,0,0,0,,他们怕地球人侵略宇宙所以来杀我们地球人
Dialogue: 0,0:17:22.33,0:17:26.10,Layzner,,0,0,0,,好可怕的家伙 竟要杀光地球人
Dialogue: 0,0:17:26.10,0:17:31.86,Layzner,,0,0,0,,那是因为他们害怕四处布兵 想要占领宇宙的地球人
Dialogue: 0,0:17:31.86,0:17:35.79,Layzner,,0,0,0,,伊丽莎白 你讨厌我当军人
Dialogue: 0,0:17:35.79,0:17:39.70,Layzner,,0,0,0,,可是 你看 不只是地球 宇宙到处都是战争
Dialogue: 0,0:17:39.70,0:17:41.91,Layzner,,0,0,0,,到哪里都避免不了战争
Dialogue: 0,0:17:41.91,0:17:43.49,Layzner,,0,0,0,,军人有其存在的必要
Dialogue: 0,0:17:43.49,0:17:48.70,Layzner,,0,0,0,,就是有你这种想法扭曲了宇宙开发的意义
Dialogue: 0,0:17:48.70,0:17:51.50,Layzner,,0,0,0,,最后才会招古拉特斯人来
Dialogue: 0,0:17:51.50,0:17:53.03,Layzner,,0,0,0,,哼 你还是这么天真
Dialogue: 0,0:17:56.91,0:18:01.24,Layzner,,0,0,0,,这种话以后都不要再说了
Dialogue: 0,0:17:56.91,0:18:01.24,Layzner,,0,0,0,,够了 你一点都没变 我也是
Dialogue: 0,0:18:09.60,0:18:11.20,Layzner,,0,0,0,,怎么办
Dialogue: 0,0:18:11.20,0:18:12.40,Layzner,,0,0,0,,没有路了
Dialogue: 0,0:18:12.40,0:18:14.75,Layzner,,0,0,0,,找一下有没有岔路
Dialogue: 0,0:18:14.75,0:18:17.00,Layzner,,0,0,0,,有了 这好像能上去
Dialogue: 0,0:18:49.08,0:18:51.10,Layzner,,0,0,0,,这里是哪里 你们知道吗
Dialogue: 0,0:18:51.10,0:18:53.10,Layzner,,0,0,0,,不知道 我没见过
Dialogue: 0,0:18:57.72,0:19:00.18,Layzner,,0,0,0,,那里是机场
Dialogue: 0,0:19:09.08,0:19:10.51,Layzner,,0,0,0,,大家快逃
Dialogue: 0,0:19:26.62,0:19:29.59,Layzner,,0,0,0,,英二 大卫 快过来
Dialogue: 0,0:19:29.59,0:19:32.53,Layzner,,0,0,0,,在哪里 你们在哪里
Dialogue: 0,0:19:32.53,0:19:35.64,Layzner,,0,0,0,,外面 在外面 这里是材料存储室
Dialogue: 0,0:19:35.64,0:19:38.59,Layzner,,0,0,0,,从这里看得到机场
Dialogue: 0,0:19:40.09,0:19:42.90,Layzner,,0,0,0,,一吸引敌人 就拼命跑
Dialogue: 0,0:19:44.06,0:19:45.54,Layzner,,0,0,0,,跑啊
Dialogue: 0,0:20:09.45,0:20:10.73,Layzner,,0,0,0,,马上就到了
Dialogue: 0,0:20:21.34,0:20:24.18,Layzner,,0,0,0,,接着是弗瑞德 兰德 弗洛华
Dialogue: 0,0:20:44.95,0:20:46.94,Layzner,,0,0,0,,英二 快来啊
Dialogue: 0,0:20:46.94,0:20:49.37,Layzner,,0,0,0,,在哪里 敌人在上面是吗
Dialogue: 0,0:21:05.51,0:21:09.00,Layzner,,0,0,0,,找到敌人了吗  找到了对吧
Dialogue: 0,0:21:15.01,0:21:16.42,Layzner,,0,0,0,,这里是吗
Dialogue: 0,0:21:18.75,0:21:21.21,Layzner,,0,0,0,,过来 来这里
Dialogue: 0,0:21:21.21,0:21:22.88,Layzner,,0,0,0,,古雷特
Dialogue: 0,0:22:26.51,0:22:30.07,Layzner,,0,0,0,,走吧 大家 坐那航天飞机回地球吧 好啊
Dialogue: 0,0:22:32.14,0:22:35.84,Layzner,,0,0,0,,大家平安上了太空船
Dialogue: 0,0:22:35.84,0:22:38.86,Layzner,,0,0,0,,我也松了一口气
Dialogue: 0,0:22:38.86,0:22:44.97,Layzner,,0,0,0,,能救到这八个小孩
Dialogue: 0,0:22:38.86,0:22:44.97,Layzner,,0,0,0,,在经历一连串令人难过的事件后
Dialogue: 0,0:22:45.29,0:22:51.95,Layzner,,0,0,0,,也让我们的心中稍微平静 感到开心多了
Dialogue: 0,0:23:53.53,0:23:56.90,Layzner,,0,0,0,,警告信息 现况对我方不利 请逃出
Dialogue: 0,0:23:56.90,0:24:01.28,Layzner,,0,0,0,,如果这样下去 说不定能知道雷兹纳的秘密
Dialogue: 0,0:24:01.28,0:24:03.03,Layzner,,0,0,0,,请逃出
Dialogue: 0,0:24:03.04,0:24:04.10,Layzner,,0,0,0,,让我看看吧
Dialogue: 0,0:24:04.10,0:24:08.41,Layzner,,0,0,0,,下一集 接下来去地球

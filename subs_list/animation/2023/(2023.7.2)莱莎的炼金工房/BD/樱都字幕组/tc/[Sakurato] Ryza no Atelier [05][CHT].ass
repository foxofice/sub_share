Dialogue: 0,0:03:43.82,0:03:48.49,Title,,0,0,0,,{\blur2\fad(350,523)\3c&HA27E4F&\pos(1543.697,922)}#05 最棒的點子
Dialogue: 0,0:23:55.91,0:24:00.91,Next Title,,0,0,0,,{\bord2\blur2\3c&HE7AF6F&\pos(960,474)}#06 來打造祕密藏身所吧
Comment: 0,0:00:01.00,0:00:01.00,staff,Sub,0,0,0,,
Dialogue: 0,0:00:05.41,0:00:07.11,Sub-CN,漏翻,0,0,0,,今天麻煩您了
Dialogue: 0,0:00:07.86,0:00:10.00,Sub-CN,,0,0,0,,我有事想要問
Dialogue: 0,0:00:10.41,0:00:12.51,Sub-CN,,0,0,0,,沒關係 甚麼事
Dialogue: 0,0:00:13.29,0:00:17.82,Sub-CN,,0,0,0,,其實萊莎他們 從浸水坑道回來之後
Dialogue: 0,0:00:18.31,0:00:20.59,Sub-CN,,0,0,0,,就一直很奇怪
Dialogue: 0,0:00:29.76,0:00:34.22,Sub-CN,,0,0,0,,都做了這麼多個 品質總感覺還是不太滿意啊
Dialogue: 0,0:00:35.06,0:00:37.70,Sub-CN,,0,0,0,,我是認真做的啊
Dialogue: 0,0:00:44.39,0:00:46.53,Sub-CN,,0,0,0,,不能沒頭沒腦的亂揮
Dialogue: 0,0:00:48.17,0:00:52.08,Sub-CN,,0,0,0,,得集中一點 每一揮都用心點
Dialogue: 0,0:01:09.36,0:01:11.58,Sub-CN,,0,0,0,,得了解更多的事情
Dialogue: 0,0:01:12.90,0:01:15.21,Sub-CN,,0,0,0,,更多的 更多的
Dialogue: 0,0:01:21.90,0:01:25.80,Sub-CN,,0,0,0,,大家都像這樣太過努力了 我有點擔心
Dialogue: 0,0:01:26.47,0:01:28.80,Sub-CN,,0,0,0,,是之前我給他們打了雞血吧
Dialogue: 0,0:01:29.57,0:01:31.81,Sub-CN,,0,0,0,,可能因此太努力了
Dialogue: 0,0:01:32.18,0:01:33.88,Sub-CN,,0,0,0,,能不能做點甚麼呢
Dialogue: 0,0:01:39.34,0:01:41.62,Sub-CN,,0,0,0,,讓他們不要那麼努力就好了吧
Dialogue: 0,0:01:42.37,0:01:43.90,Sub-CN,,0,0,0,,我有個想法
Dialogue: 0,0:01:48.51,0:01:52.81,Sub-CN,,0,0,0,,呃 莉拉小姐 為甚麼今天要來這裏
Dialogue: 0,0:01:53.78,0:01:54.80,Sub-CN,,0,0,0,,來特訓
Dialogue: 0,0:01:55.80,0:01:56.61,Sub-CN,,0,0,0,,特訓?
Dialogue: 0,0:01:58.21,0:01:58.91,Sub-CN,,0,0,0,,在這裏?
Dialogue: 0,0:01:59.31,0:02:01.81,Sub-CN,,0,0,0,,如果你們這之後還要出島的話
Dialogue: 0,0:02:02.29,0:02:04.43,Sub-CN,,0,0,0,,就需要積累水上經驗
Dialogue: 0,0:02:05.11,0:02:07.92,Sub-CN,,0,0,0,,但是我…對水…
Dialogue: 0,0:02:08.51,0:02:11.92,Sub-CN,,0,0,0,,不要那麼多廢話 我要上了
Dialogue: 0,0:03:55.42,0:03:57.82,Sub-CN,,0,0,0,,這身泳衣真的好可愛
Dialogue: 0,0:03:58.94,0:04:00.08,Sub-CN,,0,0,0,,你很喜歡嗎
Dialogue: 0,0:04:00.49,0:04:01.10,Sub-CN,,0,0,0,,嗯
Dialogue: 0,0:04:01.42,0:04:04.31,Sub-CN,,0,0,0,,好開心 那就沒白準備
Dialogue: 0,0:04:05.22,0:04:07.87,Sub-CN,,0,0,0,,莉拉小姐也超合適呢
Dialogue: 0,0:04:07.87,0:04:08.70,Sub-CN,,0,0,0,,這樣嗎
Dialogue: 0,0:04:09.65,0:04:13.20,Sub-CN,,0,0,0,,換完衣服之後來做準備體操
Dialogue: 0,0:04:20.57,0:04:22.40,Sub-CN,,0,0,0,,不過為甚麼在這裏啊
Dialogue: 0,0:04:22.86,0:04:25.01,Sub-CN,,0,0,0,,如果出現怪物的話
Dialogue: 0,0:04:25.45,0:04:28.97,Sub-CN,,0,0,0,,不用擔心 這裏是安全的
Dialogue: 0,0:04:28.97,0:04:30.24,Sub-CN,,0,0,0,,是這樣嗎
Dialogue: 0,0:04:32.42,0:04:34.64,Sub-CN,,0,0,0,,安佩爾先生在做甚麼啊
Dialogue: 0,0:04:35.54,0:04:38.21,Sub-CN,,0,0,0,,說偶爾也要曬曬陽光就把他帶出來了
Dialogue: 0,0:04:38.89,0:04:39.91,Sub-CN,,0,0,0,,不用管他
Dialogue: 0,0:04:43.10,0:04:45.60,Sub-CN,,0,0,0,,我能練劍的話倒是可以
Dialogue: 0,0:04:46.66,0:04:50.21,Sub-CN,,0,0,0,,我也有很多想讀的書啊
Dialogue: 0,0:04:51.09,0:04:53.19,Sub-CN,,0,0,0,,你們兩個不是還好嘛
Dialogue: 0,0:04:53.19,0:04:54.50,Sub-CN,,0,0,0,,而我完全…
Dialogue: 0,0:04:55.45,0:04:56.66,Sub-CN,,0,0,0,,怎麼了嗎
Dialogue: 0,0:04:57.31,0:05:00.18,Sub-CN,,0,0,0,,其實我…水性不好
Dialogue: 0,0:05:00.76,0:05:02.60,Sub-CN,,0,0,0,,難道萊莎不會游泳嗎
Dialogue: 0,0:05:03.53,0:05:04.09,Sub-CN,,0,0,0,,嗯…
Dialogue: 0,0:05:04.95,0:05:07.11,Sub-CN,,0,0,0,,我們雖然是會游泳的
Dialogue: 0,0:05:07.49,0:05:09.42,Sub-CN,,0,0,0,,但不是很擅長啊
Dialogue: 0,0:05:10.26,0:05:14.01,Sub-CN,,0,0,0,,島上的居民不怎麼玩水呢
Dialogue: 0,0:05:14.84,0:05:16.30,Sub-CN,,0,0,0,,這樣啊
Dialogue: 0,0:05:17.18,0:05:20.19,Sub-CN,,0,0,0,,我完全不知道 只顧自己高興
Dialogue: 0,0:05:21.20,0:05:23.19,Sub-CN,,0,0,0,,沒事 你不要在意
Dialogue: 0,0:05:23.53,0:05:25.81,Sub-CN,,0,0,0,,你是很期待的吧
Dialogue: 0,0:05:31.86,0:05:34.31,Sub-CN,,0,0,0,,那我就努力一下吧
Dialogue: 0,0:05:35.92,0:05:40.08,Sub-CN,,0,0,0,,以此為契機克服一下困難吧
Dialogue: 0,0:05:40.48,0:05:41.48,Sub-CN,,0,0,0,,難得的機會
Dialogue: 0,0:05:42.29,0:05:43.01,Sub-CN,,0,0,0,,萊莎…
Dialogue: 0,0:05:44.34,0:05:46.80,Sub-CN,,0,0,0,,嗯 也讓我幫個忙吧
Dialogue: 0,0:05:50.75,0:05:53.09,Sub-CN,,0,0,0,,之後要實際下水
Dialogue: 0,0:05:53.76,0:05:55.30,Sub-CN,,0,0,0,,萊莎跟科洛蒂婭一組
Dialogue: 0,0:05:55.78,0:05:57.70,Sub-CN,漏翻,0,0,0,,男生們跟着我來
Dialogue: 0,0:05:59.56,0:06:00.79,Sub-CN,,0,0,0,,是
Dialogue: 0,0:06:02.00,0:06:05.30,Sub-CN,,0,0,0,,萊莎 你最少要做到可以潛水的程度
Dialogue: 0,0:06:07.10,0:06:09.21,Sub-CN,,0,0,0,,是 我會努力的
Dialogue: 0,0:06:09.78,0:06:28.03,Sub-CN-UP,\an8,0,0,0,,1 2 3 4…1 2 3 4…
Dialogue: 0,0:06:16.00,0:06:17.24,Sub-CN,,0,0,0,,這是甚麼訓練啊
Dialogue: 0,0:06:17.24,0:06:19.31,Sub-CN,,0,0,0,,就算是水中彈跳
Dialogue: 0,0:06:19.89,0:06:22.30,Sub-CN,,0,0,0,,只要想到這樣就能變強
Dialogue: 0,0:06:23.45,0:06:25.15,Sub-CN,,0,0,0,,我已經想要回去了
Dialogue: 0,0:06:29.19,0:06:31.50,Sub-CN,,0,0,0,,那我們也開始吧
Dialogue: 0,0:06:32.00,0:06:33.31,Sub-CN,,0,0,0,,嗯…嗯……
Dialogue: 0,0:06:41.18,0:06:44.87,Sub-CN,,0,0,0,,還差一點就淹到腰了 怎麼辦啊
Dialogue: 0,0:06:44.87,0:06:46.12,Sub-CN,,0,0,0,,萊莎 手
Dialogue: 0,0:06:52.62,0:06:54.69,Sub-CN,,0,0,0,,好久沒到這麼深的地方了
Dialogue: 0,0:06:55.02,0:06:57.29,Sub-CN,,0,0,0,,說不定可以誒
Dialogue: 0,0:06:57.85,0:07:00.40,Sub-CN,,0,0,0,,可能是因為科洛蒂婭在身邊
Dialogue: 0,0:07:01.12,0:07:02.00,Sub-CN,,0,0,0,,太好了
Dialogue: 0,0:07:02.37,0:07:04.81,Sub-CN,,0,0,0,,那下一步把臉埋下水去試試
Dialogue: 0,0:07:07.99,0:07:09.89,Sub-CN,,0,0,0,,我試試
Dialogue: 0,0:07:18.47,0:07:19.84,Sub-CN,,0,0,0,,塔奧你要加油啊
Dialogue: 0,0:07:19.84,0:07:22.47,Sub-CN,,0,0,0,,不行啊 這麼快
Dialogue: 0,0:07:22.47,0:07:25.08,Sub-CN,,0,0,0,,怎麼了 這才哪到哪
Dialogue: 0,0:07:26.35,0:07:27.63,Sub-CN,,0,0,0,,你看 果然這樣
Dialogue: 0,0:07:27.99,0:07:30.51,Sub-CN,,0,0,0,,沒有休息時間哦 下一個
Dialogue: 0,0:07:32.74,0:07:36.53,Sub-CN,,0,0,0,,數量還變多了
Dialogue: 0,0:07:38.13,0:07:39.87,Sub-CN,,0,0,0,,總算做到了
Dialogue: 0,0:07:39.87,0:07:41.53,Sub-CN,,0,0,0,,太棒了 萊莎
Dialogue: 0,0:07:41.53,0:07:44.41,Sub-CN,,0,0,0,,這樣下去我是不是也能潛水了
Dialogue: 0,0:07:45.05,0:07:46.77,Sub-CN,,0,0,0,,萊莎的話一定能做到的
Dialogue: 0,0:07:48.37,0:07:50.30,Sub-CN,,0,0,0,,好
Dialogue: 0,0:07:59.24,0:08:00.92,Sub-CN,,0,0,0,,可能不太行
Dialogue: 0,0:08:04.06,0:08:08.60,Sub-CN,,0,0,0,,萊莎 我也跟你一起潛水 加油
Dialogue: 0,0:08:09.89,0:08:11.02,Sub-CN,,0,0,0,,科洛蒂婭
Dialogue: 0,0:08:15.22,0:08:17.55,Sub-CN,,0,0,0,,可以喊一二 再一起潛下去嗎
Dialogue: 0,0:08:17.91,0:08:19.08,Sub-CN,,0,0,0,,當然啦
Dialogue: 0,0:08:19.08,0:08:20.50,Sub-CN,,0,0,0,,那麼要開始囉
Dialogue: 0,0:08:21.08,0:08:22.52,Sub-CN,,0,0,0,,一 二…
Dialogue: 0,0:08:42.97,0:08:43.87,Sub-CN,,0,0,0,,怎麼樣?
Dialogue: 0,0:08:44.42,0:08:46.45,Sub-CN,,0,0,0,,水下特別漂亮
Dialogue: 0,0:08:46.45,0:08:48.13,Sub-CN,,0,0,0,,我真的潛下去了誒
Dialogue: 0,0:08:48.78,0:08:51.00,Sub-CN,,0,0,0,,成功了呢 萊莎
Dialogue: 0,0:08:51.00,0:08:52.71,Sub-CN,,0,0,0,,謝謝你 科洛蒂婭
Dialogue: 0,0:08:53.07,0:08:55.50,Sub-CN,,0,0,0,,多虧了你陪我練習
Dialogue: 0,0:08:55.92,0:08:57.64,Sub-CN,,0,0,0,,真的太謝謝你了
Dialogue: 0,0:08:57.64,0:09:00.60,Sub-CN,,0,0,0,,不不 是萊莎你努力的成果哦
Dialogue: 0,0:09:04.05,0:09:05.41,Sub-CN,,0,0,0,,看上去成功了呢
Dialogue: 0,0:09:06.44,0:09:07.60,Sub-CN,,0,0,0,,不要左顧右盼
Dialogue: 0,0:09:08.77,0:09:11.52,Sub-CN,,0,0,0,,水中彈跳 追加100次
Dialogue: 0,0:09:15.34,0:09:16.93,Sub-CN,,0,0,0,,看來你們已經習慣在水裏活動了
Dialogue: 0,0:09:17.71,0:09:19.91,Sub-CN,,0,0,0,,接下來就開始正式特訓
Dialogue: 0,0:09:20.54,0:09:22.78,Sub-CN,,0,0,0,,正式的還沒開始嗎
Dialogue: 0,0:09:22.78,0:09:24.61,Sub-CN,,0,0,0,,我已經沒力氣了
Dialogue: 0,0:09:25.36,0:09:27.60,Sub-CN,,0,0,0,,接下來會給你們佈置試煉內容
Dialogue: 0,0:09:28.47,0:09:30.89,Sub-CN,,0,0,0,,現在開始 找到我扔出去的東西
Dialogue: 0,0:09:31.72,0:09:33.90,Sub-CN,,0,0,0,,上面寫着下一道試煉的提示
Dialogue: 0,0:09:34.76,0:09:36.72,Sub-CN,,0,0,0,,要是不及格的話
Dialogue: 0,0:09:37.95,0:09:39.18,Sub-CN,,0,0,0,,將會受到懲罰
Dialogue: 0,0:09:39.62,0:09:40.49,Sub-CN,,0,0,0,,懲罰?
Dialogue: 0,0:09:40.49,0:09:41.32,Sub-CN,,0,0,0,,誒
Dialogue: 0,0:09:41.32,0:09:42.69,Sub-CN,,0,0,0,,那是甚麼啊
Dialogue: 0,0:09:43.06,0:09:46.10,Sub-CN,,0,0,0,,讓我看看你們的…實力吧
Dialogue: 0,0:09:53.36,0:09:53.99,Sub-CN,,0,0,0,,開始
Dialogue: 0,0:10:09.94,0:10:12.70,Sub-CN,,0,0,0,,不行 完全找不到
Dialogue: 0,0:10:13.08,0:10:15.52,Sub-CN,,0,0,0,,應該是掉在這附近的啊
Dialogue: 0,0:10:16.09,0:10:18.37,Sub-CN,,0,0,0,,我們都不知道她扔出的是甚麼
Dialogue: 0,0:10:18.37,0:10:20.68,Sub-CN,,0,0,0,,想找出來也太難了吧
Dialogue: 0,0:10:21.05,0:10:24.16,Sub-CN,,0,0,0,,再到更深一點的地方看一看?
Dialogue: 0,0:10:24.16,0:10:26.28,Sub-CN,,0,0,0,,不 我看得很清楚
Dialogue: 0,0:10:26.62,0:10:28.52,Sub-CN,,0,0,0,,肯定就在這附近
Dialogue: 0,0:10:28.95,0:10:30.19,Sub-CN,,0,0,0,,這樣啊
Dialogue: 0,0:10:31.60,0:10:34.91,Sub-CN,,0,0,0,,但是 真的是看一眼就能知道的簡單試煉嗎
Dialogue: 0,0:10:39.73,0:10:42.41,Sub-CN,,0,0,0,,唉 那顆石頭是…
Dialogue: 0,0:10:47.83,0:10:49.00,Sub-CN,,0,0,0,,這不是科比利夜石嗎
Dialogue: 0,0:10:49.46,0:10:51.90,Sub-CN,,0,0,0,,但是 它不可能會掉在湖裏…
Dialogue: 0,0:10:53.07,0:10:53.92,Sub-CN,,0,0,0,,難道
Dialogue: 0,0:10:57.21,0:10:58.59,Sub-CN,,0,0,0,,果然如此
Dialogue: 0,0:11:00.68,0:11:02.41,Sub-CN,,0,0,0,,你們倆看 我找到啦
Dialogue: 0,0:11:02.41,0:11:03.29,Sub-CN,,0,0,0,,甚麼
Dialogue: 0,0:11:03.67,0:11:05.10,Sub-CN,,0,0,0,,你怎麼找到的
Dialogue: 0,0:11:05.84,0:11:08.29,Sub-CN,,0,0,0,,稍微活用了一下採集知識
Dialogue: 0,0:11:08.75,0:11:10.40,Sub-CN,,0,0,0,,你們看 中大獎了
Dialogue: 0,0:11:10.81,0:11:11.99,Sub-CN,,0,0,0,,好耶
Dialogue: 0,0:11:11.99,0:11:13.30,Sub-CN,,0,0,0,,你真厲害啊 萊莎
Dialogue: 0,0:11:13.79,0:11:17.52,Sub-CN,,0,0,0,,沒想到鍊金術的知識在這裏也能用上呢
Dialogue: 0,0:11:18.10,0:11:19.01,Sub-CN,,0,0,0,,提示寫了甚麼
Dialogue: 0,0:11:19.53,0:11:21.49,Sub-CN,,0,0,0,,對哦
Dialogue: 0,0:11:22.33,0:11:25.08,Sub-CN,,0,0,0,,這是不是塔奧看得懂的文字啊
Dialogue: 0,0:11:25.08,0:11:25.89,Sub-CN,,0,0,0,,讓我看看
Dialogue: 0,0:11:27.32,0:11:30.29,Sub-CN,,0,0,0,,上面寫着「廣場 木桶」
Dialogue: 0,0:11:30.78,0:11:32.19,Sub-CN,,0,0,0,,廣場 木桶?
Dialogue: 0,0:11:33.16,0:11:35.20,Sub-CN,,0,0,0,,廣場是指旁邊那個嗎?
Dialogue: 0,0:11:35.53,0:11:36.62,Sub-CN,,0,0,0,,好啊
Dialogue: 0,0:11:36.62,0:11:38.10,Sub-CN,,0,0,0,,就靠着這股勢頭衝過去吧
Dialogue: 0,0:11:46.74,0:11:49.09,Sub-CN,,0,0,0,,廣場 應該是指這裏吧
Dialogue: 0,0:11:50.21,0:11:52.19,Sub-CN,,0,0,0,,是那時候的小屋遺跡啊
Dialogue: 0,0:11:57.44,0:11:58.43,Sub-CN,,0,0,0,,說起來
Dialogue: 0,0:11:58.78,0:12:01.09,Sub-CN,,0,0,0,,她為甚麼會說這附近是安全的呢
Dialogue: 0,0:12:03.12,0:12:04.60,Sub-CN,,0,0,0,,是因為有那種花
Dialogue: 0,0:12:06.94,0:12:08.81,Sub-CN,,0,0,0,,它叫做驅魔花
Dialogue: 0,0:12:09.41,0:12:12.52,Sub-CN,,0,0,0,,只要有這種花在 魔物就不會靠近
Dialogue: 0,0:12:14.31,0:12:17.10,Sub-CN,,0,0,0,,不愧是科洛蒂婭 對花真了解呢
Dialogue: 0,0:12:17.74,0:12:19.80,Sub-CN,,0,0,0,,經常旅行的話 就會積累各種知識
Dialogue: 0,0:12:20.29,0:12:22.68,Sub-CN,,0,0,0,,所以這附近才很安全啊
Dialogue: 0,0:12:23.06,0:12:24.90,Sub-CN,,0,0,0,,真是厲害的花啊
Dialogue: 0,0:12:25.91,0:12:27.70,Sub-CN,,0,0,0,,啊 是木桶
Dialogue: 0,0:12:30.69,0:12:31.86,Sub-CN,,0,0,0,,等等
Dialogue: 0,0:12:31.86,0:12:33.91,Sub-CN,,0,0,0,,可能設置了甚麼陷阱
Dialogue: 0,0:12:35.40,0:12:36.70,Sub-CN,,0,0,0,,畢竟是莉拉小姐
Dialogue: 0,0:12:37.19,0:12:40.12,Sub-CN,,0,0,0,,如果隨意觸碰 說不定會爆炸呢
Dialogue: 0,0:12:47.32,0:12:48.33,Sub-CN,,0,0,0,,你看吧
Dialogue: 0,0:12:49.06,0:12:50.22,Sub-CN,,0,0,0,,不愧是蘭托
Dialogue: 0,0:12:51.11,0:12:52.60,Sub-CN,,0,0,0,,這樣應該就沒問題了吧
Dialogue: 0,0:12:59.05,0:13:01.81,Sub-CN,,0,0,0,,真虧你能發現這裏設置了陷阱呢
Dialogue: 0,0:13:02.27,0:13:03.08,Sub-CN,,0,0,0,,安佩爾先生
Dialogue: 0,0:13:03.54,0:13:04.61,Sub-CN,,0,0,0,,嚇死我了
Dialogue: 0,0:13:04.94,0:13:08.64,Sub-CN,,0,0,0,,安佩爾先生躲在裏面這種事 我果然還是想不到的
Dialogue: 0,0:13:09.34,0:13:11.08,Sub-CN,,0,0,0,,為甚麼您會在這裏面呢
Dialogue: 0,0:13:11.61,0:13:14.00,Sub-CN,,0,0,0,,沒甚麼 被莉拉給塞進來了
Dialogue: 0,0:13:17.17,0:13:20.41,Sub-CN,,0,0,0,,那麼 接下來就是第二道試煉了
Dialogue: 0,0:13:21.87,0:13:23.04,Sub-CN,,0,0,0,,從這個廣場
Dialogue: 0,0:13:23.04,0:13:26.89,Sub-CN,,0,0,0,,找到5種可以用來煉金的素材
Dialogue: 0,0:13:27.62,0:13:29.81,Sub-CN,,0,0,0,,只要我覺得合格了
Dialogue: 0,0:13:30.38,0:13:32.40,Sub-CN,,0,0,0,,就會告訴你們下一個試煉的地點
Dialogue: 0,0:13:33.42,0:13:34.40,Sub-CN,,0,0,0,,素材?
Dialogue: 0,0:13:35.00,0:13:37.38,Sub-CN,,0,0,0,,這只能交給萊莎了吧
Dialogue: 0,0:13:38.48,0:13:40.99,Sub-CN,,0,0,0,,大家要是找到了差不多的也告訴我一下哦
Dialogue: 0,0:13:43.26,0:13:46.01,Sub-CN,,0,0,0,,素材 素材…
Dialogue: 0,0:13:47.47,0:13:52.01,Sub-CN,,0,0,0,,是藍詰草和燈籠草 真幸運
Dialogue: 0,0:13:53.99,0:13:55.89,Sub-CN,,0,0,0,,萊莎 這個可以嗎
Dialogue: 0,0:13:56.99,0:13:58.90,Sub-CN,,0,0,0,,萊莎 我這裏也
Dialogue: 0,0:14:01.10,0:14:02.97,Sub-CN,,0,0,0,,兩個都不能用呢
Dialogue: 0,0:14:02.97,0:14:05.29,Sub-CN,,0,0,0,,萊莎 過來一下
Dialogue: 0,0:14:05.96,0:14:07.49,Sub-CN,,0,0,0,,這個怎麼樣
Dialogue: 0,0:14:09.90,0:14:10.70,Sub-CN,,0,0,0,,海膽嗎
Dialogue: 0,0:14:11.51,0:14:12.98,Sub-CN,,0,0,0,,還有卡明果實呢
Dialogue: 0,0:14:13.53,0:14:16.21,Sub-CN,,0,0,0,,怎麼樣 可以作為素材使用嗎
Dialogue: 0,0:14:17.26,0:14:20.01,Sub-CN,,0,0,0,,這兩種都是經常拿來調和用的素材哦
Dialogue: 0,0:14:20.32,0:14:21.49,Sub-CN,,0,0,0,,謝謝你
Dialogue: 0,0:14:21.49,0:14:22.60,Sub-CN,,0,0,0,,太好了
Dialogue: 0,0:14:23.28,0:14:24.42,Sub-CN,,0,0,0,,還差一種
Dialogue: 0,0:14:28.94,0:14:31.71,Sub-CN,,0,0,0,,以前這裏也有人居住過嗎
Dialogue: 0,0:14:32.09,0:14:35.11,Sub-CN,,0,0,0,,或許有像我這樣的遺跡調查者
Dialogue: 0,0:14:35.76,0:14:38.18,Sub-CN,,0,0,0,,把這裏當成過據點吧
Dialogue: 0,0:14:50.60,0:14:53.69,Sub-CN,,0,0,0,,麻麻的 我還是第一次見到這種東西
Dialogue: 0,0:14:57.97,0:14:59.68,Sub-CN,,0,0,0,,這下可以嗎 安佩爾先生
Dialogue: 0,0:15:01.20,0:15:03.57,Sub-CN,,0,0,0,,藍詰草和燈籠草
Dialogue: 0,0:15:03.57,0:15:05.46,Sub-CN,,0,0,0,,還有海膽和卡明果實啊
Dialogue: 0,0:15:07.10,0:15:09.11,Sub-CN,,0,0,0,,這個是閃電礦
Dialogue: 0,0:15:09.67,0:15:11.53,Sub-CN,,0,0,0,,你還找到了這種東西嗎
Dialogue: 0,0:15:12.40,0:15:14.70,Sub-CN,,0,0,0,,這個叫閃電礦啊
Dialogue: 0,0:15:15.16,0:15:17.30,Sub-CN,,0,0,0,,它是一種帶電的石頭
Dialogue: 0,0:15:17.88,0:15:18.89,Sub-CN,,0,0,0,,你要好好記住
Dialogue: 0,0:15:19.46,0:15:20.02,Sub-CN,,0,0,0,,好的
Dialogue: 0,0:15:20.88,0:15:21.81,Sub-CN,,0,0,0,,合格了
Dialogue: 0,0:15:22.12,0:15:23.22,Sub-CN,,0,0,0,,好耶
Dialogue: 0,0:15:25.19,0:15:27.32,Sub-CN,,0,0,0,,我來告訴你們下一個試煉的場地吧
Dialogue: 0,0:15:29.20,0:15:30.00,Sub-CN,,0,0,0,,下一個地點是…
Dialogue: 0,0:15:30.68,0:15:31.45,Sub-CN,,0,0,0,,海邊
Dialogue: 0,0:15:35.59,0:15:37.97,Sub-CN,,0,0,0,,太慢了 我都要等睡着了
Dialogue: 0,0:15:38.71,0:15:41.42,Sub-CN,,0,0,0,,都快要因為耗時太長 給你們判不及格了
Dialogue: 0,0:15:41.82,0:15:43.80,Sub-CN,,0,0,0,,對…對不起
Dialogue: 0,0:15:45.58,0:15:47.19,Sub-CN,,0,0,0,,這就是最後的試煉了
Dialogue: 0,0:15:47.83,0:15:51.20,Sub-CN,,0,0,0,,如果你們能從我手上奪走這顆巨大庫肯果
Dialogue: 0,0:15:51.71,0:15:53.49,Sub-CN,,0,0,0,,今天的試煉就算合格了
Dialogue: 0,0:15:55.13,0:15:56.89,Sub-CN,,0,0,0,,只要這樣就行了嗎
Dialogue: 0,0:15:58.57,0:16:02.72,Sub-CN,,0,0,0,,你別小看她啊 想要追上她得費多大工夫
Dialogue: 0,0:16:03.18,0:16:04.93,Sub-CN,,0,0,0,,好了 放馬過來吧
Dialogue: 0,0:16:06.84,0:16:09.10,Sub-CN,,0,0,0,,誒 這就跑那麼遠的地方去了
Dialogue: 0,0:16:09.53,0:16:11.00,Sub-CN,,0,0,0,,所以我剛剛不是說了
Dialogue: 0,0:16:11.48,0:16:13.70,Sub-CN,,0,0,0,,她要是認真起來 對我們超不妙
Dialogue: 0,0:16:14.04,0:16:17.70,Sub-CN,,0,0,0,,用這個當最終試煉 也太難了
Dialogue: 0,0:16:18.08,0:16:19.50,Sub-CN,,0,0,0,,還在發甚麼呆
Dialogue: 0,0:16:20.03,0:16:21.13,Sub-CN,,0,0,0,,讓你們趕緊放馬過來
Dialogue: 0,0:16:21.80,0:16:23.81,Sub-CN,,0,0,0,,如果真不合格的話
Dialogue: 0,0:16:24.16,0:16:26.60,Sub-CN,,0,0,0,,莉拉小姐的懲罰 想想就很可怕
Dialogue: 0,0:16:26.97,0:16:29.11,Sub-CN,这段不知道有没有断错，校对麻烦看一下,0,0,0,,我絕對不要懲罰
Dialogue: 0,0:16:29.11,0:16:32.20,Sub-CN,这段不知道有没有断错，校对麻烦看一下,0,0,0,,肯定會被要求做比水中彈跳更可怕的事情
Dialogue: 0,0:16:32.20,0:16:34.71,Sub-CN,,0,0,0,,唔 只有硬着頭皮上了
Dialogue: 0,0:16:34.71,0:16:36.71,Sub-CN,,0,0,0,,啊 一起努力合格吧
Dialogue: 0,0:17:01.04,0:17:03.71,Sub-CN,,0,0,0,,怎麼 你們可連邊都沒擦到
Dialogue: 0,0:17:04.26,0:17:07.35,Sub-CN,,0,0,0,,果然有點太難了
Dialogue: 0,0:17:07.35,0:17:11.15,Sub-CN,,0,0,0,,你們兩個 想點辦法啊
Dialogue: 0,0:17:11.15,0:17:13.00,Sub-CN,,0,0,0,,就算你這麼說
Dialogue: 0,0:17:19.88,0:17:23.07,Sub-CN,,0,0,0,,人質在我們手裏 想要讓我們釋放他
Dialogue: 0,0:17:23.07,0:17:26.52,Sub-CN,,0,0,0,,就老老實實把那個巨大庫肯果交出來
Dialogue: 0,0:17:29.08,0:17:30.20,Sub-CN,,0,0,0,,看來還是動了腦筋的
Dialogue: 0,0:17:30.56,0:17:31.50,Sub-CN,,0,0,0,,只不過
Dialogue: 0,0:17:39.75,0:17:41.10,Sub-CN,,0,0,0,,看來是沒起作用
Dialogue: 0,0:17:45.18,0:17:48.15,Sub-CN,,0,0,0,,怎麼辦 完全做不到啊
Dialogue: 0,0:17:48.15,0:17:50.90,Sub-CN,,0,0,0,,感覺這樣就算追上了也搶不過來
Dialogue: 0,0:17:51.24,0:17:52.89,Sub-CN,,0,0,0,,大家必須分工合作
Dialogue: 0,0:17:53.23,0:17:53.98,Sub-CN,,0,0,0,,合作?
Dialogue: 0,0:17:54.39,0:17:56.91,Sub-CN,,0,0,0,,齊心協力追上莉拉小姐
Dialogue: 0,0:17:57.87,0:17:59.10,Sub-CN,,0,0,0,,來做作戰計劃吧
Dialogue: 0,0:18:07.71,0:18:08.51,Sub-CN,,0,0,0,,還沒好嗎
Dialogue: 0,0:18:08.93,0:18:09.98,Sub-CN,,0,0,0,,太陽都要下山了
Dialogue: 0,0:18:10.78,0:18:12.71,Sub-CN,,0,0,0,,好的 這就過來
Dialogue: 0,0:18:13.04,0:18:14.71,Sub-CN,,0,0,0,,好 就這麼辦
Dialogue: 0,0:18:15.05,0:18:17.18,Sub-CN,,0,0,0,,大家一起把莉拉小姐抓住
Dialogue: 0,0:18:23.55,0:18:24.30,Sub-CN,,0,0,0,,怎麼了
Dialogue: 0,0:18:24.78,0:18:26.70,Sub-CN,,0,0,0,,不是有作戰計劃嗎
Dialogue: 0,0:18:27.39,0:18:29.89,Sub-CN,,0,0,0,,是啊 請做好覺悟哦
Dialogue: 0,0:18:30.21,0:18:31.00,Sub-CN,,0,0,0,,莉拉小姐
Dialogue: 0,0:18:31.75,0:18:33.58,Sub-CN,,0,0,0,,行吧 那你們上吧
Dialogue: 0,0:18:34.40,0:18:35.46,Sub-CN,,0,0,0,,吃我一招
Dialogue: 0,0:18:35.46,0:18:36.38,Sub-CN,,0,0,0,,超級海膽彈
Dialogue: 0,0:18:37.67,0:18:39.26,Sub-CN,,0,0,0,,我這裏是超級寒冰
Dialogue: 0,0:18:42.23,0:18:43.10,Sub-CN,,0,0,0,,原來是這個打算嗎
Dialogue: 0,0:18:54.39,0:18:55.52,Sub-CN,,0,0,0,,原來如此
Dialogue: 0,0:18:55.85,0:18:58.50,Sub-CN,,0,0,0,,是想把莉拉逼到海水更深處嗎
Dialogue: 0,0:18:59.11,0:18:59.89,Sub-CN,,0,0,0,,既然如此
Dialogue: 0,0:19:00.74,0:19:01.66,Sub-CN,,0,0,0,,那就從正面突破
Dialogue: 0,0:19:12.78,0:19:13.39,Sub-CN,,0,0,0,,就是現在
Dialogue: 0,0:19:21.95,0:19:22.90,Sub-CN,,0,0,0,,太棒了
Dialogue: 0,0:19:22.90,0:19:24.01,Sub-CN,,0,0,0,,搞定了
Dialogue: 0,0:19:27.76,0:19:29.00,Sub-CN,,0,0,0,,成功了呢
Dialogue: 0,0:19:29.59,0:19:31.19,Sub-CN,,0,0,0,,巨大庫肯果
Dialogue: 0,0:19:31.55,0:19:33.00,Sub-CN,,0,0,0,,我們就收下了
Dialogue: 0,0:19:36.13,0:19:39.04,Sub-CN,,0,0,0,,看來你們終於明白集體行動的方式了
Dialogue: 0,0:19:39.40,0:19:40.00,Sub-CN,,0,0,0,,誒?
Dialogue: 0,0:19:40.98,0:19:43.30,Sub-CN,,0,0,0,,在各自為戰時處理不了的問題
Dialogue: 0,0:19:43.82,0:19:45.58,Sub-CN,,0,0,0,,就必須合力解決
Dialogue: 0,0:19:46.48,0:19:47.32,Sub-CN,,0,0,0,,做得不錯
Dialogue: 0,0:19:47.82,0:19:49.11,Sub-CN,,0,0,0,,試煉合格了
Dialogue: 0,0:19:51.37,0:19:52.50,Sub-CN,,0,0,0,,這是今天的獎勵
Dialogue: 0,0:19:53.17,0:19:54.18,Sub-CN,,0,0,0,,太好啦
Dialogue: 0,0:19:54.18,0:19:56.10,Sub-CN,,0,0,0,,我開動啦
Dialogue: 0,0:19:59.18,0:20:00.01,Sub-CN,,0,0,0,,唔 好難吃
Dialogue: 0,0:20:00.49,0:20:02.09,Sub-CN,,0,0,0,,這甚麼啊
Dialogue: 0,0:20:02.48,0:20:05.30,Sub-CN,,0,0,0,,這東西 原來是這種味道啊
Dialogue: 0,0:20:05.62,0:20:07.26,Sub-CN,,0,0,0,,等等 莉拉小姐
Dialogue: 0,0:20:07.26,0:20:10.14,Sub-CN,,0,0,0,,我們可沒聽過會是這種獎勵
Dialogue: 0,0:20:11.50,0:20:12.92,Sub-CN,,0,0,0,,搞到這東西可不容易
Dialogue: 0,0:20:13.54,0:20:15.11,Sub-CN,,0,0,0,,所以我覺得味道也應該是一絕吧
Dialogue: 0,0:20:19.72,0:20:20.40,Sub-CN,,0,0,0,,這不是挺好吃嗎
Dialogue: 0,0:20:25.50,0:20:27.93,Sub-CN,,0,0,0,,啊 累了累了
Dialogue: 0,0:20:27.93,0:20:29.81,Sub-CN,,0,0,0,,肚子都餓癟了
Dialogue: 0,0:20:30.48,0:20:33.36,Sub-CN,,0,0,0,,只不過 久違地活動了筋骨
Dialogue: 0,0:20:33.36,0:20:34.40,Sub-CN,,0,0,0,,真開心啊
Dialogue: 0,0:20:34.74,0:20:36.40,Sub-CN,,0,0,0,,那倒也是
Dialogue: 0,0:20:36.89,0:20:38.70,Sub-CN,,0,0,0,,莉拉小姐 安佩爾先生
Dialogue: 0,0:20:39.10,0:20:40.90,Sub-CN,,0,0,0,,今天真是非常感謝你們
Dialogue: 0,0:20:41.22,0:20:43.00,Sub-CN,,0,0,0,,總感覺心裏變得清爽了
Dialogue: 0,0:20:43.44,0:20:45.09,Sub-CN,,0,0,0,,要謝就去謝科洛蒂婭吧
Dialogue: 0,0:20:46.77,0:20:48.33,Sub-CN,,0,0,0,,是科洛蒂婭跟我們講
Dialogue: 0,0:20:48.33,0:20:51.12,Sub-CN,,0,0,0,,希望能讓你們有點時間放鬆一下的
Dialogue: 0,0:20:53.34,0:20:54.39,Sub-CN,,0,0,0,,是這樣嗎
Dialogue: 0,0:20:55.55,0:20:59.39,Sub-CN,,0,0,0,,那個 我看大家最近都很緊繃
Dialogue: 0,0:21:00.08,0:21:02.94,Sub-CN,,0,0,0,,所以想讓大家變回到從前那樣
Dialogue: 0,0:21:03.98,0:21:05.42,Sub-CN,,0,0,0,,原來是這樣
Dialogue: 0,0:21:11.48,0:21:13.11,Sub-CN,,0,0,0,,謝謝你 科洛蒂婭
Dialogue: 0,0:21:13.97,0:21:15.62,Sub-CN,,0,0,0,,多虧了你我們恢復活力了
Dialogue: 0,0:21:17.63,0:21:20.80,Sub-CN,,0,0,0,,也沒有做那麼值得道謝的事情啦
Dialogue: 0,0:21:23.90,0:21:25.60,Sub-CN,,0,0,0,,莉拉小姐 安佩爾先生
Dialogue: 0,0:21:26.10,0:21:27.51,Sub-CN,,0,0,0,,十分感謝你們
Dialogue: 0,0:21:28.44,0:21:31.50,Sub-CN,,0,0,0,,不過 偶爾也是需要像這樣放鬆一下的
Dialogue: 0,0:21:33.19,0:21:34.20,Sub-CN,,0,0,0,,是啊
Dialogue: 0,0:21:38.72,0:21:40.81,Sub-CN,,0,0,0,,太好啦 真的
Dialogue: 0,0:21:41.78,0:21:44.00,Sub-CN,,0,0,0,,今天好開心
Dialogue: 0,0:21:45.30,0:21:48.69,Sub-CN,,0,0,0,,總有一天 我也要像今天一樣和大家一起
Dialogue: 0,0:21:53.33,0:21:54.70,Sub-CN,,0,0,0,,話說起來 莉拉小姐
Dialogue: 0,0:21:55.20,0:21:55.81,Sub-CN,,0,0,0,,甚麼
Dialogue: 0,0:21:56.39,0:22:00.89,Sub-CN,,0,0,0,,今天去的那片地區 之後也一直是安全的嗎
Dialogue: 0,0:22:01.51,0:22:02.00,Sub-CN,,0,0,0,,嗯
Dialogue: 0,0:22:02.54,0:22:04.30,Sub-CN,,0,0,0,,是這樣的啊
Dialogue: 0,0:22:05.56,0:22:07.51,Sub-CN,,0,0,0,,我有個好主意
Dialogue: 0,0:22:08.08,0:22:10.21,Sub-CN,,0,0,0,,喔 怎麼了萊莎
Dialogue: 0,0:22:17.57,0:22:19.10,Sub-CN,,0,0,0,,那個 大家聽我說
Dialogue: 0,0:22:20.68,0:22:21.98,Sub-CN,,0,0,0,,我想好了
Dialogue: 0,0:22:22.31,0:22:25.59,Sub-CN,,0,0,0,,一起來打造屬於我們的祕密藏身所吧
Comment: 0,0:00:01.00,0:00:01.00,staff,OP,0,0,0,,

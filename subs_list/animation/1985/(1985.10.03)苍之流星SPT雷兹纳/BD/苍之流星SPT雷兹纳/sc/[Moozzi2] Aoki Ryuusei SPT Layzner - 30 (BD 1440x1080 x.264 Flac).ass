Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerTopMusic,,0,0,0,,dakishimete, kinou yori
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerMusic,,0,0,0,,抱紧我
Dialogue: 0,0:23:01.80,0:23:07.11,LayznerTopMusic,,0,0,0,,aishitai hito tidak iru
Dialogue: 0,0:23:01.80,0:23:07.25,LayznerMusic,,0,0,0,,比昨天更爱你
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerTopMusic,,0,0,0,,toki ha hitoshizuku nigai namida
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerMusic,,0,0,0,,时间是一滴 苦涩的泪
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerTopMusic,,0,0,0,,kizutsuita pururougu
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerMusic,,0,0,0,,受伤的序曲
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerTopMusic,,0,0,0,,yasashisa e tsuzukuno yo
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerMusic,,0,0,0,,继续着温柔
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerTopMusic,,0,0,0,,mayowanai futari dake no
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerMusic,,0,0,0,,只为这不再迷惘的两人
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerTopMusic,,0,0,0,,LA ROSE ROUGE
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerMusic,,0,0,0,,献上一曲野玫瑰之歌
Dialogue: 0,0:01:02.07,0:01:06.22,Layzner,,0,0,0,,听着头骨碎裂的声音去死吧
Dialogue: 0,0:01:08.30,0:01:09.12,Layzner,,0,0,0,,大卫
Dialogue: 0,0:01:09.45,0:01:10.31,Layzner,,0,0,0,,很好很好
Dialogue: 0,0:01:47.57,0:01:48.27,Layzner,,0,0,0,,停下
Dialogue: 0,0:02:01.40,0:02:02.49,Layzner,,0,0,0,,攻击
Dialogue: 0,0:02:30.27,0:02:31.53,Layzner,,0,0,0,,可恶
Dialogue: 0,0:02:37.66,0:02:41.20,Layzner,,0,0,0,,我们可不是光给鲁·凯恩踩在脚下 你明白了吧
Dialogue: 0,0:02:48.10,0:02:53.11,Layzner,,0,0,0,,第三十话 贝布鲁夺回作战
Dialogue: 0,0:03:01.36,0:03:03.03,Layzner,,0,0,0,,真是有意思
Dialogue: 0,0:03:05.41,0:03:06.99,Layzner,,0,0,0,,叫罗安·迪米特里奇来
Dialogue: 0,0:03:07.00,0:03:07.50,Layzner,,0,0,0,,是
Dialogue: 0,0:03:09.25,0:03:10.44,Layzner,,0,0,0,,您叫我吗 阁下
Dialogue: 0,0:03:16.09,0:03:18.04,Layzner,,0,0,0,,你知道这个男人是谁吧
Dialogue: 0,0:03:19.21,0:03:21.72,Layzner,,0,0,0,,是的 他的名字叫大卫·鲁瑟福特
Dialogue: 0,0:03:22.30,0:03:24.01,Layzner,,0,0,0,,似乎是游击队的领导者
Dialogue: 0,0:03:24.97,0:03:27.89,Layzner,,0,0,0,,我不认为此人值得阁下注意
Dialogue: 0,0:03:28.06,0:03:31.35,Layzner,,0,0,0,,我知道 只是我想到个游戏
Dialogue: 0,0:03:32.27,0:03:33.06,Layzner,,0,0,0,,游戏
Dialogue: 0,0:03:34.52,0:03:39.68,Layzner,,0,0,0,,地球的太阳真刺眼 让我想到了不得了的事
Dialogue: 0,0:03:42.11,0:03:42.86,Layzner,,0,0,0,,跟我来
Dialogue: 0,0:03:43.00,0:03:43.70,Layzner,,0,0,0,,是
Dialogue: 0,0:03:57.59,0:04:00.84,Layzner,,0,0,0,,布鲁迪和贝布鲁 这不是三年前大破的两机吗
Dialogue: 0,0:04:01.09,0:04:02.88,Layzner,,0,0,0,,我回收后让人修复好了
Dialogue: 0,0:04:03.68,0:04:04.34,Layzner,,0,0,0,,是吗
Dialogue: 0,0:04:05.30,0:04:06.22,Layzner,,0,0,0,,觉得怀念吗
Dialogue: 0,0:04:06.39,0:04:06.85,Layzner,,0,0,0,,没有
Dialogue: 0,0:04:07.93,0:04:11.93,Layzner,,0,0,0,,那个叫大卫的男人看到这个会有什么反应呢
Dialogue: 0,0:04:12.39,0:04:13.82,Layzner,,0,0,0,,你认为他会心动吗
Dialogue: 0,0:04:14.19,0:04:17.48,Layzner,,0,0,0,,当然了 他是个粗鲁又单纯的男人
Dialogue: 0,0:04:18.02,0:04:20.54,Layzner,,0,0,0,,看到贝布鲁的话会泪流满面冲过来吧
Dialogue: 0,0:04:30.25,0:04:30.90,Layzner,,0,0,0,,贝
Dialogue: 0,0:04:48.28,0:04:53.73,Layzner,,0,0,0,,我这就让你吸够地球人的血 吸个够啊
Dialogue: 0,0:05:32.43,0:05:35.39,Layzner,,0,0,0,,太大意的话有几条命都不够啊
Dialogue: 0,0:05:35.56,0:05:36.23,Layzner,,0,0,0,,是
Dialogue: 0,0:05:36.44,0:05:39.19,Layzner,,0,0,0,,好了 滚回去吧
Dialogue: 0,0:05:40.36,0:05:41.32,Layzner,,0,0,0,,哼 真是的
Dialogue: 0,0:05:42.65,0:05:44.90,Layzner,,0,0,0,,寿命都缩短了啊 真是的
Dialogue: 0,0:05:46.32,0:05:49.82,Layzner,,0,0,0,,我去拿书这段时间你去做什么去了
Dialogue: 0,0:05:49.95,0:05:52.49,Layzner,,0,0,0,,啊 没什么
Dialogue: 0,0:05:52.60,0:05:55.49,Layzner,,0,0,0,,来这种地方干什么
Dialogue: 0,0:05:55.75,0:05:58.25,Layzner,,0,0,0,,你这A级合作者
Dialogue: 0,0:05:59.12,0:06:01.54,Layzner,,0,0,0,,说点啥啊
Dialogue: 0,0:06:03.88,0:06:05.92,Layzner,,0,0,0,,哦 危险啊
Dialogue: 0,0:06:06.51,0:06:10.30,Layzner,,0,0,0,,再让我见到就把你这小胡子剃了
Dialogue: 0,0:06:16.02,0:06:17.30,Layzner,,0,0,0,,没被人跟来吧
Dialogue: 0,0:06:19.56,0:06:21.88,Layzner,,0,0,0,,什么 发现贝布鲁了
Dialogue: 0,0:06:22.27,0:06:25.90,Layzner,,0,0,0,,是 我亲眼看到的啊 而且修复一新
Dialogue: 0,0:06:26.57,0:06:27.84,Layzner,,0,0,0,,是被修理好了吗
Dialogue: 0,0:06:28.15,0:06:31.03,Layzner,,0,0,0,,正好 我们正缺SPT呢
Dialogue: 0,0:06:31.45,0:06:33.10,Layzner,,0,0,0,,去把贝布鲁抢来吧
Dialogue: 0,0:06:40.67,0:06:43.21,Layzner,,0,0,0,,反射旋回能力9.1
Dialogue: 0,0:06:47.76,0:06:50.93,Layzner,,0,0,0,,目标捕捉率86.03%
Dialogue: 0,0:07:12.58,0:07:14.07,Layzner,,0,0,0,,英二 没事吧
Dialogue: 0,0:07:14.24,0:07:15.08,Layzner,,0,0,0,,我没事
Dialogue: 0,0:07:19.50,0:07:20.91,Layzner,,0,0,0,,稍微休息一下吧
Dialogue: 0,0:07:20.96,0:07:22.79,Layzner,,0,0,0,,不了 再继续一会
Dialogue: 0,0:07:24.58,0:07:28.13,Layzner,,0,0,0,,三年前我驾驶贝布鲁跟英二并肩作战
Dialogue: 0,0:07:28.67,0:07:32.72,Layzner,,0,0,0,,然后活了下来 有了贝布鲁战力就会倍增 我想要啊
Dialogue: 0,0:07:33.51,0:07:35.10,Layzner,,0,0,0,,我明白了 大卫
Dialogue: 0,0:07:35.22,0:07:37.51,Layzner,,0,0,0,,亚瑟 你知道运去哪里了吗
Dialogue: 0,0:07:37.68,0:07:39.39,Layzner,,0,0,0,,河对岸的第三居住区
Dialogue: 0,0:07:45.31,0:07:50.28,Layzner,,0,0,0,,第三居住区 是地球市民管理状况最好的地方吧
Dialogue: 0,0:07:50.44,0:07:52.86,Layzner,,0,0,0,,啊 正因为如此警备队数量也少
Dialogue: 0,0:07:57.62,0:07:58.98,Layzner,,0,0,0,,也许是陷阱
Dialogue: 0,0:07:59.20,0:08:00.29,Layzner,,0,0,0,,陷阱
Dialogue: 0,0:08:01.37,0:08:03.62,Layzner,,0,0,0,,不然怎么会故意让人看见
Dialogue: 0,0:08:03.87,0:08:05.58,Layzner,,0,0,0,,不会吧
Dialogue: 0,0:08:05.92,0:08:08.38,Layzner,,0,0,0,,不 九成是陷阱
Dialogue: 0,0:08:09.67,0:08:12.09,Layzner,,0,0,0,,可不是别的啊 是贝布鲁啊 搞不好
Dialogue: 0,0:08:13.22,0:08:15.34,Layzner,,0,0,0,,是罗安那混蛋搞的鬼
Dialogue: 0,0:08:15.64,0:08:18.39,Layzner,,0,0,0,,是啊 可能性很高
Dialogue: 0,0:08:21.56,0:08:23.64,Layzner,,0,0,0,,那么 要怎么办
Dialogue: 0,0:08:24.48,0:08:29.06,Layzner,,0,0,0,,还用说吗 既然对方有这个意思 就陪他们玩玩吧
Dialogue: 0,0:08:29.32,0:08:30.98,Layzner,,0,0,0,,这游戏 我参加了
Dialogue: 0,0:08:31.11,0:08:32.61,Layzner,,0,0,0,,喂 可能是陷阱啊
Dialogue: 0,0:08:33.20,0:08:36.07,Layzner,,0,0,0,,你要是不肯帮忙 我就揭发你
Dialogue: 0,0:08:36.62,0:08:37.66,Layzner,,0,0,0,,不是吧
Dialogue: 0,0:08:37.74,0:08:42.45,Layzner,,0,0,0,,知道你是间谍的话 肯定先是严刑拷打 最后丢掉小命
Dialogue: 0,0:08:46.96,0:08:50.24,Layzner,,0,0,0,,不过 我认为阁下没有必要亲自出马吧
Dialogue: 0,0:08:51.56,0:08:54.38,Layzner,,0,0,0,,地球的那个格斗技 叫什么来着 跌跤吗
Dialogue: 0,0:08:54.72,0:08:55.55,Layzner,,0,0,0,,是摔跤吗
Dialogue: 0,0:08:55.68,0:08:56.64,Layzner,,0,0,0,,正是
Dialogue: 0,0:08:56.72,0:08:59.68,Layzner,,0,0,0,,游戏要在现场看啊
Dialogue: 0,0:09:00.10,0:09:02.85,Layzner,,0,0,0,,王者就是喜欢找这样的乐子
Dialogue: 0,0:09:21.49,0:09:24.42,Layzner,,0,0,0,,可恶 等着我啊 贝布鲁
Dialogue: 0,0:09:41.64,0:09:42.51,Layzner,,0,0,0,,好了 最后一个
Dialogue: 0,0:09:46.89,0:09:48.14,Layzner,,0,0,0,,我侦查完了
Dialogue: 0,0:09:48.60,0:09:49.52,Layzner,,0,0,0,,警戒状况如何
Dialogue: 0,0:09:49.56,0:09:51.86,Layzner,,0,0,0,,跟平常一样 部队没有增加
Dialogue: 0,0:09:51.98,0:09:52.28,Layzner,,0,0,0,,是吗
Dialogue: 0,0:09:52.69,0:09:56.19,Layzner,,0,0,0,,但是不能大意啊 我看到有管理者从喷气直升机上下来了
Dialogue: 0,0:09:56.70,0:09:58.01,Layzner,,0,0,0,,是鲁·凯恩
Dialogue: 0,0:09:58.01,0:10:01.38,Layzner,,0,0,0,,不好了 别干了吧 西蒙妮
Dialogue: 0,0:10:01.58,0:10:05.95,Layzner,,0,0,0,,别出怪声 我们事先知道是陷阱才制定的作战计划啊
Dialogue: 0,0:10:06.08,0:10:09.92,Layzner,,0,0,0,,但是鲁·凯恩亲自来的话 你知道会怎么样吗
Dialogue: 0,0:10:10.00,0:10:12.17,Layzner,,0,0,0,,时间一到大卫就会行动
Dialogue: 0,0:10:12.59,0:10:13.82,Layzner,,0,0,0,,安娜 拜托你了
Dialogue: 0,0:10:16.80,0:10:18.12,Layzner,,0,0,0,,西蒙妮
Dialogue: 0,0:10:19.18,0:10:21.05,Layzner,,0,0,0,,我揭发你是间谍哦
Dialogue: 0,0:10:21.85,0:10:23.05,Layzner,,0,0,0,,走了
Dialogue: 0,0:10:53.75,0:10:55.88,Layzner,,0,0,0,,辛苦了 感觉如何
Dialogue: 0,0:10:57.38,0:11:02.14,Layzner,,0,0,0,,方向感有点差 不过我认为在地球战斗能有这样的动作已经够了
Dialogue: 0,0:11:02.47,0:11:06.35,Layzner,,0,0,0,,这是基鲁巴特博士他们以SPT为蓝本设计的啊
Dialogue: 0,0:11:06.77,0:11:12.52,Layzner,,0,0,0,,不过真是讽刺啊 反对世界军备的我们居然要制造这种武器
Dialogue: 0,0:11:12.85,0:11:18.49,Layzner,,0,0,0,,这是为了摆脱古拉特斯统治的道具 而不是为了杀人或者侵略
Dialogue: 0,0:11:20.65,0:11:26.91,Layzner,,0,0,0,,我相信地球和古拉特斯 终有一天能作为真正的同胞相互理解
Dialogue: 0,0:11:27.87,0:11:28.86,Layzner,,0,0,0,,我也相信
Dialogue: 0,0:11:31.00,0:11:34.50,Layzner,,0,0,0,,帮我叫大卫他们暂时别轻举乱动啊
Dialogue: 0,0:11:39.17,0:11:39.96,Layzner,,0,0,0,,故障了吗
Dialogue: 0,0:11:40.01,0:11:40.76,Layzner,,0,0,0,,不是
Dialogue: 0,0:11:44.01,0:11:45.20,Layzner,,0,0,0,,看到美女就能打着了
Dialogue: 0,0:11:46.64,0:11:47.40,Layzner,,0,0,0,,小心点
Dialogue: 0,0:11:47.85,0:11:49.68,Layzner,,0,0,0,,大卫他们会很高兴的
Dialogue: 0,0:12:01.74,0:12:03.03,Layzner,,0,0,0,,是那里吗
Dialogue: 0,0:12:23.22,0:12:23.93,Layzner,,0,0,0,,站住
Dialogue: 0,0:12:25.47,0:12:28.96,Layzner,,0,0,0,,你背后的是C级市民吧 想去什么地方
Dialogue: 0,0:12:30.56,0:12:32.94,Layzner,,0,0,0,,她是给基地做清洗工作的杂物人员
Dialogue: 0,0:12:33.27,0:12:34.14,Layzner,,0,0,0,,让我看看脸
Dialogue: 0,0:12:35.40,0:12:36.06,Layzner,,0,0,0,,好的
Dialogue: 0,0:12:36.23,0:12:38.06,Layzner,,0,0,0,,好了 抓紧点
Dialogue: 0,0:12:38.31,0:12:40.61,Layzner,,0,0,0,,快点 工作还很多呢
Dialogue: 0,0:12:51.91,0:12:54.54,Layzner,,0,0,0,,东北B地区104区发现炮火
Dialogue: 0,0:12:54.87,0:12:56.78,Layzner,,0,0,0,,让第一第二分队出击
Dialogue: 0,0:12:57.17,0:12:59.74,Layzner,,0,0,0,,南方E地区72区也发现炮火
Dialogue: 0,0:13:00.04,0:13:01.84,Layzner,,0,0,0,,让第三第四分队出击
Dialogue: 0,0:13:08.30,0:13:08.93,Layzner,,0,0,0,,多乌
Dialogue: 0,0:13:10.60,0:13:11.81,Layzner,,0,0,0,,到时候了
Dialogue: 0,0:13:14.73,0:13:16.52,Layzner,,0,0,0,,哦 差点忘了
Dialogue: 0,0:13:23.90,0:13:27.07,Layzner,,0,0,0,,站住 那个C级市民要去哪里
Dialogue: 0,0:13:27.45,0:13:28.11,Layzner,,0,0,0,,怎么办
Dialogue: 0,0:13:28.16,0:13:29.07,Layzner,,0,0,0,,你拿着
Dialogue: 0,0:13:29.62,0:13:30.48,Layzner,,0,0,0,,女人的武器
Dialogue: 0,0:13:30.83,0:13:31.37,Layzner,,0,0,0,,站住
Dialogue: 0,0:13:40.54,0:13:41.71,Layzner,,0,0,0,,怎么 怎么回事
Dialogue: 0,0:13:42.92,0:13:43.68,Layzner,,0,0,0,,亚瑟 快点
Dialogue: 0,0:14:01.19,0:14:02.94,Layzner,,0,0,0,,开始了啊
Dialogue: 0,0:14:09.16,0:14:11.12,Layzner,,0,0,0,,居然飞过来
Dialogue: 0,0:14:11.83,0:14:12.49,Layzner,,0,0,0,,打下来
Dialogue: 0,0:14:25.09,0:14:27.22,Layzner,,0,0,0,,很有意思
Dialogue: 0,0:14:26.55,0:14:27.88,Layzner,,0,0,0,,开火 开火
Dialogue: 0,0:14:32.10,0:14:32.89,Layzner,,0,0,0,,很好很好
Dialogue: 0,0:14:49.36,0:14:50.20,Layzner,,0,0,0,,西蒙尼
Dialogue: 0,0:14:50.32,0:14:52.45,Layzner,,0,0,0,,大卫 快来救我
Dialogue: 0,0:14:52.57,0:14:53.83,Layzner,,0,0,0,,不好意思 贝布鲁优先
Dialogue: 0,0:14:54.33,0:14:56.26,Layzner,,0,0,0,,你这无情无义的家伙
Dialogue: 0,0:15:11.70,0:15:12.84,Layzner,,0,0,0,,呦 贝布鲁
Dialogue: 0,0:15:13.64,0:15:15.01,Layzner,,0,0,0,,是我啊  大卫啊
Dialogue: 0,0:15:15.64,0:15:16.42,Layzner,,0,0,0,,还记得我吗
Dialogue: 0,0:15:29.65,0:15:30.49,Layzner,,0,0,0,,大卫
Dialogue: 0,0:15:35.33,0:15:36.33,Layzner,,0,0,0,,可恶
Dialogue: 0,0:15:39.45,0:15:40.54,Layzner,,0,0,0,,大卫
Dialogue: 0,0:15:46.96,0:15:51.47,Layzner,,0,0,0,,别这么快晕过去 那样我不是没法开开心心折磨你了吗
Dialogue: 0,0:16:20.37,0:16:22.04,Layzner,,0,0,0,,我可是不死之身啊
Dialogue: 0,0:16:30.46,0:16:34.76,Layzner,,0,0,0,,听着头骨碎裂的声音死去吧
Dialogue: 0,0:17:12.92,0:17:15.84,Layzner,,0,0,0,,脑子 我的脑子好痛
Dialogue: 0,0:17:16.09,0:17:17.39,Layzner,,0,0,0,,大卫
Dialogue: 0,0:17:18.47,0:17:20.60,Layzner,,0,0,0,,我没事 快上来
Dialogue: 0,0:17:31.52,0:17:34.44,Layzner,,0,0,0,,我们扇子单独行动
Dialogue: 0,0:17:34.69,0:17:36.95,Layzner,,0,0,0,,去第三居住区抢夺贝布鲁了
Dialogue: 0,0:17:37.16,0:17:37.86,Layzner,,0,0,0,,不好
Dialogue: 0,0:17:41.95,0:17:43.45,Layzner,,0,0,0,,那 那些家伙
Dialogue: 0,0:17:43.95,0:17:46.71,Layzner,,0,0,0,,打开警用频率 追击贝布鲁
Dialogue: 0,0:17:46.87,0:17:48.67,Layzner,,0,0,0,,阁下 怎么处置那些家伙
Dialogue: 0,0:17:51.09,0:17:52.09,Layzner,,0,0,0,,阁下
Dialogue: 0,0:17:52.84,0:17:55.67,Layzner,,0,0,0,,这是贝布鲁上装的定时炸弹的遥控器
Dialogue: 0,0:17:56.01,0:17:57.38,Layzner,,0,0,0,,怎么了 快按
Dialogue: 0,0:18:04.97,0:18:06.93,Layzner,,0,0,0,,这下我也无法阻止了
Dialogue: 0,0:18:07.35,0:18:08.98,Layzner,,0,0,0,,回去吧 罗安
Dialogue: 0,0:18:10.20,0:18:10.98,Layzner,,0,0,0,,是
Dialogue: 0,0:18:12.86,0:18:15.12,Layzner,,0,0,0,,区域2内发现无人机SPT 8机
Dialogue: 0,0:18:15.28,0:18:16.57,Layzner,,0,0,0,,出现了啊
Dialogue: 0,0:18:24.37,0:18:25.45,Layzner,,0,0,0,,可恶
Dialogue: 0,0:18:32.67,0:18:33.54,Layzner,,0,0,0,,大卫
Dialogue: 0,0:18:33.71,0:18:34.34,Layzner,,0,0,0,,英二
Dialogue: 0,0:18:54.15,0:18:55.61,Layzner,,0,0,0,,你好像很在意啊
Dialogue: 0,0:18:56.07,0:18:56.82,Layzner,,0,0,0,,不
Dialogue: 0,0:18:57.53,0:18:59.40,Layzner,,0,0,0,,只是看不到结果有些遗憾
Dialogue: 0,0:19:00.49,0:19:02.62,Layzner,,0,0,0,,结果显而易见
Dialogue: 0,0:19:05.54,0:19:07.62,Layzner,,0,0,0,,谁来帮帮我
Dialogue: 0,0:19:11.67,0:19:12.33,Layzner,,0,0,0,,你这混蛋
Dialogue: 0,0:19:14.50,0:19:17.09,Layzner,,0,0,0,,好痛 干什么 快住手
Dialogue: 0,0:19:17.26,0:19:18.59,Layzner,,0,0,0,,闭嘴 你这混蛋
Dialogue: 0,0:19:18.92,0:19:21.09,Layzner,,0,0,0,,你知道自己带了间谍进来吗
Dialogue: 0,0:19:24.05,0:19:25.01,Layzner,,0,0,0,,走了 罗安
Dialogue: 0,0:19:25.10,0:19:26.43,Layzner,,0,0,0,,可是 这家伙
Dialogue: 0,0:19:26.64,0:19:27.47,Layzner,,0,0,0,,随他去吧
Dialogue: 0,0:19:27.52,0:19:27.85,Layzner,,0,0,0,,是
Dialogue: 0,0:19:29.31,0:19:34.73,Layzner,,0,0,0,,不过 阁下 真没想到贝布鲁上居然安装了定时炸弹 您的计策真是胜人一筹
Dialogue: 0,0:19:34.94,0:19:37.94,Layzner,,0,0,0,,要赢游戏就要有王牌
Dialogue: 0,0:19:40.07,0:19:40.66,Layzner,,0,0,0,,不 不好了
Dialogue: 0,0:19:50.29,0:19:51.66,Layzner,,0,0,0,,贝布鲁上有定时炸弹
Dialogue: 0,0:19:51.87,0:19:53.08,Layzner,,0,0,0,,贝布鲁要爆炸了
Dialogue: 0,0:19:53.67,0:19:56.09,Layzner,,0,0,0,,听到了吗 贝布鲁上有定时炸弹
Dialogue: 0,0:20:00.84,0:20:02.01,Layzner,,0,0,0,,定时炸弹
Dialogue: 0,0:20:03.26,0:20:04.80,Layzner,,0,0,0,,贝布鲁 怎么回事
Dialogue: 0,0:20:05.64,0:20:11.18,Layzner,,0,0,0,,AZ区块里的自爆装置 2.42前启动 距离爆炸还有2.17
Dialogue: 0,0:20:11.39,0:20:12.44,Layzner,,0,0,0,,什么
Dialogue: 0,0:20:12.77,0:20:13.73,Layzner,,0,0,0,,快脱出
Dialogue: 0,0:20:14.02,0:20:18.02,Layzner,,0,0,0,,舱门开关装置 无法操作 驾驶员不可能脱出
Dialogue: 0,0:20:18.11,0:20:18.62,Layzner,,0,0,0,,什么
Dialogue: 0,0:20:20.99,0:20:22.03,Layzner,,0,0,0,,怎么会这样
Dialogue: 0,0:20:22.45,0:20:24.24,Layzner,,0,0,0,,距离爆炸还有2.00
Dialogue: 0,0:20:32.62,0:20:35.38,Layzner,,0,0,0,,大卫 快上升 我马上去追你
Dialogue: 0,0:20:35.54,0:20:36.88,Layzner,,0,0,0,,打不开舱门啊
Dialogue: 0,0:20:37.21,0:20:39.71,Layzner,,0,0,0,,总之先上升 连累地上就糟了
Dialogue: 0,0:20:39.88,0:20:41.80,Layzner,,0,0,0,,距离爆炸还有1.30
Dialogue: 0,0:20:44.05,0:20:45.97,Layzner,,0,0,0,,雷 V-MAX 发动
Dialogue: 0,0:20:46.18,0:20:46.76,Layzner,,0,0,0,,ready
Dialogue: 0,0:20:55.52,0:20:58.23,Layzner,,0,0,0,,格纳库传出异常电波 快去查
Dialogue: 0,0:20:58.77,0:20:59.82,Layzner,,0,0,0,,我现在就去
Dialogue: 0,0:21:06.66,0:21:08.74,Layzner,,0,0,0,,住手 你想自杀吗
Dialogue: 0,0:21:08.87,0:21:10.62,Layzner,,0,0,0,,距离爆炸还有1.00
Dialogue: 0,0:21:10.70,0:21:12.62,Layzner,,0,0,0,,59, 58
Dialogue: 0,0:21:12.83,0:21:16.37,Layzner,,0,0,0,,尽量附身 我从外面破坏舱门
Dialogue: 0,0:21:16.58,0:21:18.50,Layzner,,0,0,0,,55, 54
Dialogue: 0,0:21:29.26,0:21:32.06,Layzner,,0,0,0,,47, 46, 45
Dialogue: 0,0:21:33.77,0:21:34.64,Layzner,,0,0,0,,在这里
Dialogue: 0,0:21:38.19,0:21:38.72,Layzner,,0,0,0,,这是
Dialogue: 0,0:21:48.91,0:21:51.87,Layzner,,0,0,0,,英二 不行了 你也会被波及的
Dialogue: 0,0:21:51.88,0:21:53.87,Layzner,,0,0,0,,别管我们 快逃
Dialogue: 0,0:21:56.08,0:21:57.96,Layzner,,0,0,0,,要死在一起了啊
Dialogue: 0,0:21:54.95,0:22:01.04,Layzner,,0,0,0,,18, 17, 16, 15, 14, 13,
Dialogue: 0,0:22:01.09,0:22:07.09,Layzner,,0,0,0,,12, 11, 10, 09, 08, 07,
Dialogue: 0,0:22:06.09,0:22:08.50,Layzner,,0,0,0,,两位 要死还太早了
Dialogue: 0,0:22:08.88,0:22:13.34,Layzner,,0,0,0,, 04, 03, 02, 01...
Dialogue: 0,0:22:10.68,0:22:11.44,Layzner,,0,0,0,,快脱出
Dialogue: 0,0:23:54.20,0:23:58.62,Layzner,,0,0,0,,地球人啊 你们连一个女人都救不了
Dialogue: 0,0:23:58.91,0:24:01.58,Layzner,,0,0,0,,给我睁大眼睛好好看着
Dialogue: 0,0:24:02.16,0:24:04.08,Layzner,,0,0,0,,古斯特罗 我来对付你
Dialogue: 0,0:24:03.92,0:24:08.42,Layzner,,0,0,0,,次回 编排好的圣战

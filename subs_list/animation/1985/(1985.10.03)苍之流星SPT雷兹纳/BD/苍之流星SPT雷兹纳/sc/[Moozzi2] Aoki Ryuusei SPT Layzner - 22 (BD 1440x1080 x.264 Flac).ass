Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:01.49,0:01:05.65,Layzner,,0,0,0,,我不要坐在把杀人合理化的机器人上
Dialogue: 0,0:01:06.15,0:01:10.39,Layzner,,0,0,0,,弗隆 回到你的记忆回路去 不认同的话就杀了我
Dialogue: 0,0:01:41.77,0:01:43.61,Layzner,,0,0,0,,我叫弗隆
Dialogue: 0,0:01:43.74,0:01:44.42,Layzner,,0,0,0,,弗隆
Dialogue: 0,0:01:46.36,0:01:48.36,Layzner,,0,0,0,,去死吧
Dialogue: 0,0:01:48.42,0:01:50.80,Layzner,,0,0,0,,可恶 不要小看我们地球人
Dialogue: 0,0:01:50.98,0:01:52.39,Layzner,,0,0,0,,杀死他
Dialogue: 0,0:01:53.02,0:01:57.39,Layzner,,0,0,0,,原谅我 提督
Dialogue: 0,0:01:59.36,0:02:02.83,Layzner,,0,0,0,,古雷斯库提督 你有在听吗
Dialogue: 0,0:02:02.83,0:02:07.48,Layzner,,0,0,0,,紧急信息 敌人SPT队极速接近中
Dialogue: 0,0:02:15.39,0:02:20.34,Layzner,,0,0,0,,第二十二话 与弗隆的对决
Dialogue: 0,0:02:29.20,0:02:33.11,Layzner,,0,0,0,,又是那红色的凯萨尔 那上面的是前辈吗
Dialogue: 0,0:02:48.98,0:02:53.92,Layzner,,0,0,0,,状况对我方不利 启动V-MAX 准备进行攻击
Dialogue: 0,0:02:53.95,0:02:55.60,Layzner,,0,0,0,,V-MAX 等一下
Dialogue: 0,0:03:03.13,0:03:04.88,Layzner,,0,0,0,,那是什么 好快的动作
Dialogue: 0,0:03:08.63,0:03:11.35,Layzner,,0,0,0,,住手 没有打斗的必要 快逃
Dialogue: 0,0:03:18.85,0:03:20.07,Layzner,,0,0,0,,突破包围圈
Dialogue: 0,0:03:21.01,0:03:23.04,Layzner,,0,0,0,,没错 没必要战斗 逃吧
Dialogue: 0,0:03:45.04,0:03:48.97,Layzner,,0,0,0,,雷兹纳的动作比平常快了三倍所以跟丢了
Dialogue: 0,0:03:49.26,0:03:51.91,Layzner,,0,0,0,,我知道 向追击部队下达返回命令
Dialogue: 0,0:03:52.10,0:03:53.51,Layzner,,0,0,0,,了解
Dialogue: 0,0:03:54.26,0:04:01.47,Layzner,,0,0,0,,那小鬼会知道这种秘密 难不成是因为雷兹纳的电脑
Dialogue: 0,0:04:02.22,0:04:05.72,Layzner,,0,0,0,,这样的话就能想通了 如果这样就不能让雷兹纳活下去
Dialogue: 0,0:04:16.88,0:04:19.03,Layzner,,0,0,0,,就算是一次又一次的消灭敌人
Dialogue: 0,0:04:19.03,0:04:24.53,Layzner,,0,0,0,,这电脑还是保存着古雷特斯祖先的秘密
Dialogue: 0,0:04:24.53,0:04:27.53,Layzner,,0,0,0,,因此前辈也死了
Dialogue: 0,0:04:29.75,0:04:32.00,Layzner,,0,0,0,,不 那时前辈真的死了吗
Dialogue: 0,0:04:32.81,0:04:36.56,Layzner,,0,0,0,,那红色的凯撒尔跟前辈坐的是同一机型
Dialogue: 0,0:04:36.91,0:04:40.56,Layzner,,0,0,0,,前辈还活着吗 但如果是这样为什么不回答我
Dialogue: 0,0:04:41.28,0:04:44.78,Layzner,,0,0,0,,不明白
Dialogue: 0,0:04:52.97,0:04:56.94,Layzner,,0,0,0,,为了要防备有可能会攻过来的古拉特斯
Dialogue: 0,0:04:56.94,0:05:01.87,Layzner,,0,0,0,,在这艾德华空军基地内充满紧张的气氛
Dialogue: 0,0:05:02.31,0:05:08.81,Layzner,,0,0,0,,但不知为何我却没什么战争开始的紧张感
Dialogue: 0,0:05:09.50,0:05:11.31,Layzner,,0,0,0,,想起来还挺可怕的
Dialogue: 0,0:05:11.31,0:05:16.97,Layzner,,0,0,0,,说不定是之前发生的一连串事件让我变得迟钝
Dialogue: 0,0:05:17.87,0:05:26.81,Layzner,,0,0,0,,这时候的我更担心的是两小时前离开这的英二的安危
Dialogue: 0,0:05:27.43,0:05:30.84,Layzner,,0,0,0,,他们真的以为能赢得了古拉特斯的科技吗
Dialogue: 0,0:05:31.09,0:05:36.46,Layzner,,0,0,0,,所谓愚者无惧嘛 他们还不知对手的实力才会小看他们的
Dialogue: 0,0:05:38.06,0:05:43.59,Layzner,,0,0,0,,好不容易见到妈妈为什么又被带回来了 可恶
Dialogue: 0,0:05:45.96,0:05:49.09,Layzner,,0,0,0,,看来你好像也对战争麻木了呢
Dialogue: 0,0:05:49.09,0:05:49.49,Layzner,,0,0,0,,唉？
Dialogue: 0,0:05:49.96,0:05:54.62,Layzner,,0,0,0,,明明就要开战了 却还在想他的事 被我说中了吗 
Dialogue: 0,0:05:55.53,0:05:59.68,Layzner,,0,0,0,,真令人焦急 只能在这等他回来
Dialogue: 0,0:06:00.62,0:06:02.68,Layzner,,0,0,0,,不吉的天空
Dialogue: 0,0:06:02.68,0:06:06.77,Layzner,,0,0,0,,在这乌云的另一端 他真的没事吗
Dialogue: 0,0:06:06.77,0:06:13.96,Layzner,,0,0,0,,希望他没事 希望他能平安回来 除此外我别无所求
Dialogue: 0,0:06:54.81,0:06:59.24,Layzner,,0,0,0,,好像让他逃了呢 反正你一定没可能打倒那个英二的
Dialogue: 0,0:06:59.68,0:07:04.24,Layzner,,0,0,0,,这血色凯撒尔是中尉的最爱
Dialogue: 0,0:07:04.61,0:07:11.86,Layzner,,0,0,0,,有资格坐上去的只有能帮中尉报仇的人
Dialogue: 0,0:07:04.61,0:07:11.86,Layzner,,0,0,0,,涂成红色表达了中尉的怨念
Dialogue: 0,0:07:12.14,0:07:16.92,Layzner,,0,0,0,,你有这资格吗 跟英二有血缘关系的你
Dialogue: 0,0:07:20.24,0:07:21.92,Layzner,,0,0,0,,说句话啊
Dialogue: 0,0:07:22.98,0:07:30.36,Layzner,,0,0,0,,应由受中尉信赖和宠爱的我来驾驶才对
Dialogue: 0,0:07:22.98,0:07:30.36,Layzner,,0,0,0,,说不出话了吧 本来这血色凯撒尔
Dialogue: 0,0:07:30.36,0:07:32.81,Layzner,,0,0,0,,可是为什么是你这样的女人在坐
Dialogue: 0,0:07:32.98,0:07:34.61,Layzner,,0,0,0,,你说宠爱是什么意思
Dialogue: 0,0:07:34.91,0:07:40.61,Layzner,,0,0,0,,中尉是男人 我是女人 男女之间有什么你应该想得到
Dialogue: 0,0:07:41.00,0:07:41.86,Layzner,,0,0,0,,骗人
Dialogue: 0,0:07:41.86,0:07:46.74,Layzner,,0,0,0,,他跟你之间应该只有长官和部下的关系
Dialogue: 0,0:07:47.17,0:07:48.95,Layzner,,0,0,0,,你怎么明白 
Dialogue: 0,0:07:48.95,0:07:55.55,Layzner,,0,0,0,,我跟中尉可是每天朝夕相处 这种感觉你怎么可能知道
Dialogue: 0,0:07:56.43,0:07:58.51,Layzner,,0,0,0,,我告诉你那晚的事好了
Dialogue: 0,0:07:58.91,0:08:04.47,Layzner,,0,0,0,,与英二决斗前中尉感到很痛苦
Dialogue: 0,0:07:58.91,0:08:04.47,Layzner,,0,0,0,,那天中尉突然来到我的房间  
Dialogue: 0,0:08:04.96,0:08:08.50,Layzner,,0,0,0,,因为断不了对你的思念所以他无法跟英二战斗
Dialogue: 0,0:08:09.26,0:08:14.13,Layzner,,0,0,0,,他也为了要剪断对你的思念 所以他选择了我
Dialogue: 0,0:08:20.20,0:08:21.79,Layzner,,0,0,0,,有什么好笑的
Dialogue: 0,0:08:21.79,0:08:26.39,Layzner,,0,0,0,,不明白的是你 他还活在我心中
Dialogue: 0,0:08:27.02,0:08:33.37,Layzner,,0,0,0,,为了贯彻对他的爱 我跟家人决裂甚至要跟弟弟英二战斗
Dialogue: 0,0:08:34.01,0:08:37.15,Layzner,,0,0,0,,我心里的那个人完全能够理解我的想法
Dialogue: 0,0:08:37.72,0:08:40.98,Layzner,,0,0,0,,你撒的谎只是对他的侮辱
Dialogue: 0,0:08:41.20,0:08:42.20,Layzner,,0,0,0,,你说什么
Dialogue: 0,0:08:52.58,0:08:56.95,Layzner,,0,0,0,,像你这样的女人怎么能待在凯利中尉的身边
Dialogue: 0,0:09:06.70,0:09:11.94,Layzner,,0,0,0,,爸爸 妈妈 我又背叛你们了
Dialogue: 0,0:09:12.82,0:09:17.10,Layzner,,0,0,0,,那时古拉特斯决定攻打地球时
Dialogue: 0,0:09:17.10,0:09:22.29,Layzner,,0,0,0,,爸爸你本来决定瞒着陛下带大家逃出去
Dialogue: 0,0:09:23.79,0:09:27.13,Layzner,,0,0,0,,离开古拉特斯去告知地球将面临的危机
Dialogue: 0,0:09:27.13,0:09:29.13,Layzner,,0,0,0,,您是这么说的对吧
Dialogue: 0,0:09:29.79,0:09:32.63,Layzner,,0,0,0,,可是我做不到
Dialogue: 0,0:09:35.88,0:09:40.38,Layzner,,0,0,0,,比起爸爸的故乡地球我选择了那个人的爱
Dialogue: 0,0:09:47.04,0:09:52.07,Layzner,,0,0,0,,因为我 你们两人放弃去地球而把一切交给英二
Dialogue: 0,0:09:55.38,0:09:58.22,Layzner,,0,0,0,,可是英二却杀了他
Dialogue: 0,0:09:59.07,0:10:03.28,Layzner,,0,0,0,,我必须跟英二战斗 把杀了他的英二
Dialogue: 0,0:10:04.38,0:10:13.56,Layzner,,0,0,0,,爸爸 妈妈 我现在不求你们的原谅 可是我
Dialogue: 0,0:10:15.81,0:10:16.88,Layzner,,0,0,0,,我
Dialogue: 0,0:10:20.28,0:10:25.47,Layzner,,0,0,0,,地球与我们原本预料的不同 两国避开冲突 
Dialogue: 0,0:10:25.47,0:10:28.56,Layzner,,0,0,0,,而想联手抵抗我们
Dialogue: 0,0:10:29.59,0:10:36.44,Layzner,,0,0,0,,先不管我们第三阶段作战是否成功
Dialogue: 0,0:10:37.25,0:10:40.25,Layzner,,0,0,0,,地球人没有我们想象中那么笨
Dialogue: 0,0:10:40.81,0:10:46.59,Layzner,,0,0,0,,为了要一举打倒他们 我决定直接实行最终计划
Dialogue: 0,0:10:48.78,0:10:52.22,Layzner,,0,0,0,,陛下 您说的是最终计划是指之前的
Dialogue: 0,0:10:54.50,0:10:56.55,Layzner,,0,0,0,,请看一下
Dialogue: 0,0:10:56.69,0:11:03.31,Layzner,,0,0,0,,地球的大气层有可以阻挡紫外线等宇宙射线的臭氧层
Dialogue: 0,0:11:03.75,0:11:08.40,Layzner,,0,0,0,,紫外线如各位所知对动植物影响很大
Dialogue: 0,0:11:08.40,0:11:12.34,Layzner,,0,0,0,,强力的照射会对生物造成很大的破坏力
Dialogue: 0,0:11:12.87,0:11:18.03,Layzner,,0,0,0,,破坏臭氧层可以给地球致命的一击
Dialogue: 0,0:11:18.43,0:11:23.81,Layzner,,0,0,0,,我听说这方法之前也有用在奈美因制镇压战中
Dialogue: 0,0:11:24.46,0:11:25.56,Layzner,,0,0,0,,没错
Dialogue: 0,0:11:25.56,0:11:30.18,Layzner,,0,0,0,,可是这次的计划并非破坏所有的臭氧层
Dialogue: 0,0:11:30.78,0:11:34.03,Layzner,,0,0,0,,而是针对几个特定的大城市而已
Dialogue: 0,0:11:34.46,0:11:37.21,Layzner,,0,0,0,,作战的准备都做好了
Dialogue: 0,0:11:37.21,0:11:41.53,Layzner,,0,0,0,,剩下的就只要布好破坏臭氧层的卫星就行了
Dialogue: 0,0:11:41.81,0:11:43.96,Layzner,,0,0,0,,那就快点开始作战
Dialogue: 0,0:11:56.06,0:11:58.80,Layzner,,0,0,0,,就算这样 那个雷兹纳
Dialogue: 0,0:12:13.46,0:12:17.58,Layzner,,0,0,0,,凯利前辈 前辈 凯利前辈
Dialogue: 0,0:12:24.33,0:12:25.15,Layzner,,0,0,0,,是梦吗 
Dialogue: 0,0:12:25.40,0:12:27.96,Layzner,,0,0,0,,你醒了吗
Dialogue: 0,0:12:27.96,0:12:28.65,Layzner,,0,0,0,,有异状吗
Dialogue: 0,0:12:28.65,0:12:29.15,Layzner,,0,0,0,,没有
Dialogue: 0,0:12:29.49,0:12:31.11,Layzner,,0,0,0,,是吗 这样啊
Dialogue: 0,0:12:31.43,0:12:36.33,Layzner,,0,0,0,,你就算没有我的命令遇到危险也会自动消灭敌人是吗
Dialogue: 0,0:12:36.33,0:12:39.39,Layzner,,0,0,0,,是的 那就是我的使命
Dialogue: 0,0:12:39.39,0:12:43.35,Layzner,,0,0,0,,你的使命啊 因为你那使命把凯利前辈杀了
Dialogue: 0,0:12:43.96,0:12:48.61,Layzner,,0,0,0,,你为了保护自己发动V-MAX杀了凯利前辈
Dialogue: 0,0:12:48.61,0:12:52.11,Layzner,,0,0,0,,当然了 那时候的行为是合理的
Dialogue: 0,0:12:52.11,0:12:54.39,Layzner,,0,0,0,,你说什么 你说合理
Dialogue: 0,0:12:54.55,0:13:00.17,Layzner,,0,0,0,,你以为你是谁 古拉特斯诞生的秘密这么重要吗
Dialogue: 0,0:13:00.17,0:13:02.99,Layzner,,0,0,0,,没错 比什么都重要
Dialogue: 0,0:13:02.99,0:13:04.52,Layzner,,0,0,0,,就算夺取人命也一样吗
Dialogue: 0,0:13:04.64,0:13:07.55,Layzner,,0,0,0,,诞生的秘密比任何事都优先 
Dialogue: 0,0:13:12.80,0:13:14.61,Layzner,,0,0,0,,你要做什么
Dialogue: 0,0:13:14.77,0:13:21.67,Layzner,,0,0,0,,我不要坐在把杀人合理化的机器人上
Dialogue: 0,0:13:14.77,0:13:21.67,Layzner,,0,0,0,,你就继续任性的保护你的秘密吧 
Dialogue: 0,0:13:22.20,0:13:27.55,Layzner,,0,0,0,,等一下 你已知道古拉特斯的秘密
Dialogue: 0,0:13:27.83,0:13:34.26,Layzner,,0,0,0,,要杀就杀啊 不杀我的话就快消失在我面前
Dialogue: 0,0:13:27.83,0:13:34.26,Layzner,,0,0,0,,所以怎样呢 知道秘密所以要杀了我吗
Dialogue: 0,0:13:35.70,0:13:39.23,Layzner,,0,0,0,,要射随时都可以 我们就在这做一个了断
Dialogue: 0,0:13:39.42,0:13:41.95,Layzner,,0,0,0,,做一个了断是什么意思
Dialogue: 0,0:13:41.95,0:13:45.89,Layzner,,0,0,0,,就是你存在的理由 古拉特斯诞生并延续下去的秘密
Dialogue: 0,0:13:45.95,0:13:48.55,Layzner,,0,0,0,,是上古时代 毁灭的古拉特斯人为了分析古代繁荣的文明遗迹
Dialogue: 0,0:13:48.55,0:13:54.11,Layzner,,0,0,0,,而从地球带回生命核
Dialogue: 0,0:13:54.11,0:13:55.97,Layzner,,0,0,0,,在古拉特斯再度繁衍
Dialogue: 0,0:13:56.62,0:13:59.51,Layzner,,0,0,0,,这就是现在古拉特斯人的祖先
Dialogue: 0,0:13:59.70,0:14:03.51,Layzner,,0,0,0,,也就是说古拉特斯人跟地球人是同一人种
Dialogue: 0,0:14:03.51,0:14:04.61,Layzner,,0,0,0,,对吧
Dialogue: 0,0:14:04.61,0:14:08.14,Layzner,,0,0,0,,没错 那就是秘密
Dialogue: 0,0:14:08.14,0:14:13.78,Layzner,,0,0,0,,为了要让被带回的地球人忘了地球的环境
Dialogue: 0,0:14:13.78,0:14:17.60,Layzner,,0,0,0,,这之前我听过了 为什么还要留下这秘密呢
Dialogue: 0,0:14:17.60,0:14:20.45,Layzner,,0,0,0,,这是前古拉特斯人的良心所致
Dialogue: 0,0:14:20.45,0:14:24.98,Layzner,,0,0,0,,因为跟异文明结合而带来空前的毁灭
Dialogue: 0,0:14:24.98,0:14:31.45,Layzner,,0,0,0,,所以当将来地球的文明被带到古拉特斯而产生新的文明时
Dialogue: 0,0:14:31.45,0:14:36.48,Layzner,,0,0,0,,双方就可以把它当成是兄弟的证明因而被保留下来
Dialogue: 0,0:14:36.81,0:14:40.32,Layzner,,0,0,0,,可是你并不能证明那件事 不是吗
Dialogue: 0,0:14:40.57,0:14:44.07,Layzner,,0,0,0,,我体内的记忆装置可以证明
Dialogue: 0,0:14:44.07,0:14:46.00,Layzner,,0,0,0,,那东西不能证明什么
Dialogue: 0,0:14:46.07,0:14:49.70,Layzner,,0,0,0,,我是传承这秘密的人 可以证明
Dialogue: 0,0:14:49.70,0:14:52.88,Layzner,,0,0,0,,不对 能证明的人只有我
Dialogue: 0,0:14:53.26,0:14:57.05,Layzner,,0,0,0,,身为地球与古拉特斯混血的我比什么证明都要好 不是吗
Dialogue: 0,0:14:57.69,0:15:01.38,Layzner,,0,0,0,,只要看到拥有双方血液的我的话
Dialogue: 0,0:15:01.57,0:15:06.32,Layzner,,0,0,0,,弗隆 回你的记录回路去 不认同的话就杀了我
Dialogue: 0,0:15:28.04,0:15:32.27,Layzner,,0,0,0,,资讯信息 可动检查完成 没有异状
Dialogue: 0,0:15:32.27,0:15:39.91,Layzner,,0,0,0,,能源残存量 0.42单位 推测可动时间415.3±7.02
Dialogue: 0,0:15:39.91,0:15:43.57,Layzner,,0,0,0,,范围内没有敌人 一切正常
Dialogue: 0,0:15:44.03,0:15:46.29,Layzner,,0,0,0,,雷 这不是雷吗
Dialogue: 0,0:15:56.60,0:15:58.56,Layzner,,0,0,0,,他呢 他怎么了
Dialogue: 0,0:15:58.56,0:15:59.72,Layzner,,0,0,0,,意义不明
Dialogue: 0,0:15:59.91,0:16:00.72,Layzner,,0,0,0,,我是说弗隆
Dialogue: 0,0:16:00.72,0:16:02.06,Layzner,,0,0,0,,意义不明
Dialogue: 0,0:16:02.41,0:16:05.25,Layzner,,0,0,0,,原来如此 弗隆这次真的躲起来了
Dialogue: 0,0:16:05.63,0:16:08.45,Layzner,,0,0,0,,从记忆回路有发信源不明的留言
Dialogue: 0,0:16:09.56,0:16:14.47,Layzner,,0,0,0,,全部拜托阿尔巴特洛·英二·飞鸟 连V-MAX也是
Dialogue: 0,0:16:14.47,0:16:19.78,Layzner,,0,0,0,,所有的一切都拜托阿尔巴特洛·英二·飞鸟 V-MAX也是 完毕
Dialogue: 0,0:16:19.78,0:16:23.97,Layzner,,0,0,0,,连V-MAX也是 雷 你知道什么是V-MAX吗
Dialogue: 0,0:16:24.22,0:16:29.25,Layzner,,0,0,0,,V-MAX 紧急发动系统 会暂时提高平时的能量
Dialogue: 0,0:16:29.41,0:16:35.15,Layzner,,0,0,0,,弗隆把一切都交给我了吗 谢谢你 弗隆 感谢你对我的信赖
Dialogue: 0,0:16:35.93,0:16:37.16,Layzner,,0,0,0,,警告信息
Dialogue: 0,0:16:37.16,0:16:41.72,Layzner,,0,0,0,,未确认部队 由右后面12号方位处入侵第三区域
Dialogue: 0,0:16:41.72,0:16:43.03,Layzner,,0,0,0,,什么 快点进行分析
Dialogue: 0,0:16:43.31,0:16:46.81,Layzner,,0,0,0,,推定为无人人造卫星
Dialogue: 0,0:16:47.03,0:16:48.13,Layzner,,0,0,0,,确定为
Dialogue: 0,0:16:48.13,0:16:51.03,Layzner,,0,0,0,,破坏臭氧层的战略卫星
Dialogue: 0,0:16:51.22,0:16:54.75,Layzner,,0,0,0,,战略卫星 终于要展开攻击了吗
Dialogue: 0,0:16:55.25,0:17:00.18,Layzner,,0,0,0,,资讯信息 古拉特斯历1238年1150时
Dialogue: 0,0:17:00.18,0:17:03.65,Layzner,,0,0,0,,用在奈美因制镇压战中所用的同型卫星
Dialogue: 0,0:17:03.65,0:17:05.00,Layzner,,0,0,0,,奈美因制镇压战时的卫星
Dialogue: 0,0:17:05.50,0:17:13.28,Layzner,,0,0,0,,那不是历史上古拉特斯所遭遇最大的意外吗
Dialogue: 0,0:17:05.50,0:17:13.28,Layzner,,0,0,0,,就是之前历史课学的奈美因制大屠杀的事吗
Dialogue: 0,0:17:13.40,0:17:15.03,Layzner,,0,0,0,,雷 破坏那卫星
Dialogue: 0,0:17:15.03,0:17:15.62,Layzner,,0,0,0,,Ready!
Dialogue: 0,0:17:32.27,0:17:34.17,Layzner,,0,0,0,,卫星构造过于坚固
Dialogue: 0,0:17:34.17,0:17:37.26,Layzner,,0,0,0,,要破坏内部才可完全破坏
Dialogue: 0,0:17:37.68,0:17:40.71,Layzner,,0,0,0,,准备侵入内部
Dialogue: 0,0:17:45.44,0:17:50.18,Layzner,,0,0,0,,警告信息 侦测到卫星的光束武器启动 请戒备
Dialogue: 0,0:18:06.87,0:18:09.18,Layzner,,0,0,0,,不行 到不了中央部位
Dialogue: 0,0:18:13.96,0:18:16.30,Layzner,,0,0,0,,可侵入作战区域 角度0.02 
Dialogue: 0,0:18:16.55,0:18:17.24,Layzner,,0,0,0,,好
Dialogue: 0,0:18:20.58,0:18:21.99,Layzner,,0,0,0,,战斗信息
Dialogue: 0,0:18:21.99,0:18:28.05,Layzner,,0,0,0,,被光束炮集中率在97%以上 无法维持现状 
Dialogue: 0,0:18:28.05,0:18:31.61,Layzner,,0,0,0,,请马上脱离 或是启动V-MAX模式
Dialogue: 0,0:18:33.49,0:18:36.39,Layzner,,0,0,0,,好 我知道了 雷 启动V-MAX 
Dialogue: 0,0:18:36.39,0:18:36.99,Layzner,,0,0,0,,Ready!
Dialogue: 0,0:19:09.61,0:19:16.39,Layzner,,0,0,0,,也就表示我的意志这么容易就被左右
Dialogue: 0,0:19:09.61,0:19:16.39,Layzner,,0,0,0,,这么轻易就使用V-MAX
Dialogue: 0,0:19:17.42,0:19:19.58,Layzner,,0,0,0,,我要对我这种轻率的用法表示歉意
Dialogue: 0,0:19:20.33,0:19:26.85,Layzner,,0,0,0,,警告 有五架SPT编队 由左后方18号处
Dialogue: 0,0:19:26.85,0:19:28.36,Layzner,,0,0,0,,朝第三范围处侵入 快速接近中
Dialogue: 0,0:19:28.36,0:19:30.14,Layzner,,0,0,0,,逃吧 现在不可能战斗
Dialogue: 0,0:19:30.14,0:19:30.89,Layzner,,0,0,0,,Ready!
Dialogue: 0,0:19:32.45,0:19:37.11,Layzner,,0,0,0,,可动能力减少30% 无法恢复
Dialogue: 0,0:19:37.29,0:19:38.83,Layzner,,0,0,0,,你说什么 为什么
Dialogue: 0,0:19:38.95,0:19:41.86,Layzner,,0,0,0,,V-MAX能源的消耗是主要原因
Dialogue: 0,0:19:41.95,0:19:46.61,Layzner,,0,0,0,,离可动时间还要10.0 ± 0.3 的时间
Dialogue: 0,0:19:46.61,0:19:50.14,Layzner,,0,0,0,,不妙啊 这样下去 没有办法可以逃吗
Dialogue: 0,0:19:50.32,0:19:55.00,Layzner,,0,0,0,,可以进入大气层可是时间需要计算
Dialogue: 0,0:19:55.54,0:19:56.79,Layzner,,0,0,0,,马上计算
Dialogue: 0,0:19:56.79,0:19:57.82,Layzner,,0,0,0,,Ready.
Dialogue: 0,0:20:04.07,0:20:07.64,Layzner,,0,0,0,,基乌拉队长 请允许我去打倒英二
Dialogue: 0,0:20:07.64,0:20:12.26,Layzner,,0,0,0,,你要打倒英二 有意思 姐弟间的互相残杀吗
Dialogue: 0,0:20:12.26,0:20:15.70,Layzner,,0,0,0,,好 我批准你去 其他人在旁边看就好了
Dialogue: 0,0:20:15.92,0:20:16.57,Layzner,,0,0,0,,了解
Dialogue: 0,0:20:16.76,0:20:17.57,Layzner,,0,0,0,,了解
Dialogue: 0,0:20:23.85,0:20:26.20,Layzner,,0,0,0,,还没吗 还没算出来吗
Dialogue: 0,0:20:26.20,0:20:30.92,Layzner,,0,0,0,,警告 左后方18号方位处有敌人侵入第一范围
Dialogue: 0,0:20:31.35,0:20:33.01,Layzner,,0,0,0,,又是那架红色的凯撒尔
Dialogue: 0,0:20:33.01,0:20:37.20,Layzner,,0,0,0,,等一下英二 跟我堂堂正正的决斗吧
Dialogue: 0,0:20:37.45,0:20:38.20,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:20:38.20,0:20:41.51,Layzner,,0,0,0,,英二 过了与我决斗吧
Dialogue: 0,0:20:41.51,0:20:43.94,Layzner,,0,0,0,,姐姐 你到底在说什么
Dialogue: 0,0:20:44.10,0:20:49.41,Layzner,,0,0,0,,我一定要打倒你
Dialogue: 0,0:20:44.10,0:20:49.41,Layzner,,0,0,0,,你竟然杀了像我的生命一样的凯利中尉 
Dialogue: 0,0:20:50.01,0:20:53.32,Layzner,,0,0,0,,不是的 姐姐 那不是我的意思
Dialogue: 0,0:20:53.32,0:20:56.99,Layzner,,0,0,0,,我不要听你的借口了 如果你再逃 我就要过去
Dialogue: 0,0:21:00.10,0:21:04.43,Layzner,,0,0,0,,住手 姐姐 现在不是我们自相残杀的时候
Dialogue: 0,0:21:08.94,0:21:13.06,Layzner,,0,0,0,,听我说 这战争是无意义的战争
Dialogue: 0,0:21:16.35,0:21:20.75,Layzner,,0,0,0,,地球人和古拉特斯人本来就是同一人种
Dialogue: 0,0:21:21.54,0:21:24.19,Layzner,,0,0,0,,可恶的家伙在乱说什么啊
Dialogue: 0,0:21:24.72,0:21:29.37,Layzner,,0,0,0,,玖丽亚 没必要听他乱说 快点干掉他
Dialogue: 0,0:21:35.91,0:21:40.50,Layzner,,0,0,0,, 由我这来做一个了断
Dialogue: 0,0:21:35.91,0:21:40.50,Layzner,,0,0,0,,英二 如果你不过来也行 
Dialogue: 0,0:21:40.50,0:21:47.94,Layzner,,0,0,0,,我们俩不就是最好的证明吗
Dialogue: 0,0:21:40.50,0:21:47.94,Layzner,,0,0,0,,等一下姐姐 刚才我说的是真的 
Dialogue: 0,0:21:48.74,0:21:52.94,Layzner,,0,0,0,,现在那种事跟我已没关系了 英二 觉悟吧
Dialogue: 0,0:21:53.41,0:21:56.75,Layzner,,0,0,0,,计算完毕 现在开始突入大气层
Dialogue: 0,0:22:05.34,0:22:07.53,Layzner,,0,0,0,,不好了 快去追那家伙
Dialogue: 0,0:22:09.78,0:22:16.34,Layzner,,0,0,0,,我们知道英二发生这种事也是过了很久以后的事了
Dialogue: 0,0:22:16.99,0:22:23.47,Layzner,,0,0,0,,然后在同时古拉特斯对地球的攻击也正式展开了
Dialogue: 0,0:22:23.90,0:22:24.50,Layzner,,0,0,0,,发射
Dialogue: 0,0:23:54.21,0:23:55.43,Layzner,,0,0,0,,玖丽亚
Dialogue: 0,0:23:55.58,0:23:56.36,Layzner,,0,0,0,,凯利
Dialogue: 0,0:23:56.52,0:23:58.65,Layzner,,0,0,0,,总统先生 还有希望
Dialogue: 0,0:23:59.18,0:23:59.92,Layzner,,0,0,0,,是他们吗
Dialogue: 0,0:24:00.37,0:24:01.52,Layzner,,0,0,0,,我有一个想见的人
Dialogue: 0,0:24:01.52,0:24:02.65,Layzner,,0,0,0,,安娜
Dialogue: 0,0:24:02.65,0:24:03.40,Layzner,,0,0,0,,对不起
Dialogue: 0,0:24:03.91,0:24:08.39,Layzner,,0,0,0,,下一集 寻求奇迹

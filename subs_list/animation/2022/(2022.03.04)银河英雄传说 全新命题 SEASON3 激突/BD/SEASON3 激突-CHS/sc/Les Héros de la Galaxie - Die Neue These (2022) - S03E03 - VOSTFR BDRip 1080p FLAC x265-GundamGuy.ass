Dialogue: 0,0:00:01.55,0:00:04.50,Basic_Sign2,,0,0,0,,{\pos(964,862)}克洛普修特克侯爵领地
Dialogue: 0,0:00:05.57,0:00:07.39,Default,,0,0,0,,什么 米达麦亚他…
Dialogue: 0,0:00:07.85,0:00:08.52,Default,,0,0,0,,是的
Dialogue: 0,0:00:08.92,0:00:12.37,Default,,0,0,0,,听说布朗胥百克公爵下令 把他抓起来了
Dialogue: 0,0:00:13.92,0:00:16.80,Default,,0,0,0,,这下不妙了啊 米达麦亚…
Dialogue: 0,0:00:18.16,0:00:23.63,OPCN,,0,0,0,,你是否感觉 自己身处童话
Dialogue: 0,0:00:24.28,0:00:30.90,OPCN,,0,0,0,,在伸出的手掌之上
Dialogue: 0,0:00:30.90,0:00:37.51,OPCN,,0,0,0,,被拨弄的未来做着恒久的梦
Dialogue: 0,0:00:37.51,0:00:44.08,OPCN,,0,0,0,,知晓吐露的话语背后的真意
Dialogue: 0,0:00:44.64,0:00:54.97,OPCN,,0,0,0,,无秩序的开绽 剥去锈蚀的风景
Dialogue: 0,0:00:56.07,0:00:59.48,OPCN,,0,0,0,,满身灰尘地留在明澈的天空下
Dialogue: 0,0:00:59.48,0:01:02.52,OPCN,,0,0,0,,心跳一下接着一下
Dialogue: 0,0:01:02.52,0:01:09.09,OPCN,,0,0,0,,碎裂散落的祈祷在悄悄眨着眼
Dialogue: 0,0:01:09.09,0:01:12.43,OPCN,,0,0,0,,满身灰尘地留在无云的天空下
Dialogue: 0,0:01:12.43,0:01:15.31,OPCN,,0,0,0,,人生如一瞬的耀眼光芒
Dialogue: 0,0:01:15.31,0:01:22.51,OPCN,,0,0,0,,循规蹈矩也找不出的答案
Dialogue: 0,0:00:18.16,0:00:23.63,OPEN,,0,0,0,,Don’t you see yourself in a kind of fairy tale?
Dialogue: 0,0:00:24.28,0:00:30.90,OPEN,,0,0,0,,差し出された掌の上で
Dialogue: 0,0:00:30.90,0:00:37.51,OPEN,,0,0,0,,踊らされてく未来は　永久の夢をみて
Dialogue: 0,0:00:37.51,0:00:44.08,OPEN,,0,0,0,,吐き出された言葉の裏を知る
Dialogue: 0,0:00:44.64,0:00:54.97,OPEN,,0,0,0,,無秩序な綻びが　錆びついた景色を剥ぐ
Dialogue: 0,0:00:56.07,0:00:59.48,OPEN,,0,0,0,,Left in the dust under the airy sky
Dialogue: 0,0:00:59.48,0:01:02.52,OPEN,,0,0,0,,刻まれていく鼓動
Dialogue: 0,0:01:02.52,0:01:09.09,OPEN,,0,0,0,,砕けて散った祈りは人知れず瞬く
Dialogue: 0,0:01:09.09,0:01:12.43,OPEN,,0,0,0,,Left in the dust under the open sky
Dialogue: 0,0:01:12.43,0:01:15.31,OPEN,,0,0,0,,Life is a flash blinding bright
Dialogue: 0,0:01:15.31,0:01:22.51,OPEN,,0,0,0,,ル一ルをなぞっても見出せない答え
Dialogue: 0,0:01:40.65,0:01:48.00,title,,0,0,0,,银河英雄传说\N全新命题
Dialogue: 0,0:01:49.22,0:01:52.66,Default,,0,0,0,,本应富有教养和羞耻心的帝国贵族子弟
Dialogue: 0,0:01:53.38,0:01:55.58,Default,,0,0,0,,居然犯下如此可耻之行径
Dialogue: 0,0:01:56.46,0:01:59.99,Default,,0,0,0,,实在有辱军规和皇帝陛下之名
Dialogue: 0,0:02:00.78,0:02:02.06,Default,,0,0,0,,帝国军的荣誉
Dialogue: 0,0:02:02.39,0:02:05.12,Default,,0,0,0,,全在于借助武力守护国家
Dialogue: 0,0:02:05.50,0:02:07.78,Default,,0,0,0,,而非沉迷恶毒的淫乐之事
Dialogue: 0,0:02:08.34,0:02:12.31,Default,,0,0,0,,让全军贯彻这一点 不正是总司令官的职责吗
Dialogue: 0,0:02:13.00,0:02:16.68,Default,,0,0,0,,然而您不仅默认他们的暴虐行径
Dialogue: 0,0:02:16.96,0:02:19.43,Default,,0,0,0,,还否定我基于军规的处罚
Dialogue: 0,0:02:20.37,0:02:24.65,Default,,0,0,0,,这岂非是在侮辱自己总司令官的职位吗
Dialogue: 0,0:02:25.97,0:02:29.59,Default,,0,0,0,,放肆 速速将这家伙处死
Dialogue: 0,0:02:30.80,0:02:32.31,Default,,0,0,0,,大人且慢
Dialogue: 0,0:02:33.28,0:02:35.12,Default,,0,0,0,,为何拦我 安森巴哈
Dialogue: 0,0:02:35.44,0:02:39.98,Default,,0,0,0,,这样做 兴许有损您此役的功绩
Dialogue: 0,0:02:41.19,0:02:43.62,Default,,0,0,0,,此事应交由帝都军事法庭处理
Dialogue: 0,0:02:43.92,0:02:46.29,Default,,0,0,0,,由他们公开问罪
Dialogue: 0,0:02:50.22,0:02:50.81,Default,,0,0,0,,舅舅
Dialogue: 0,0:02:50.81,0:02:54.06,Default,,0,0,0,,别烦我 把那家伙关到禁闭室去
Dialogue: 0,0:03:00.46,0:03:04.46,title,,0,0,0,,第二十七集 暴风雨之夜
Dialogue: 0,0:03:15.50,0:03:18.03,Default,,0,0,0,,堂堂战斗技术顾问官
Dialogue: 0,0:03:18.49,0:03:21.18,Default,,0,0,0,,居然只能盯着仓库的墙壁返航
Dialogue: 0,0:03:22.56,0:03:23.47,Default,,0,0,0,,我不是说过吗
Dialogue: 0,0:03:24.00,0:03:26.65,Default,,0,0,0,,跟他们讲道理没用
Dialogue: 0,0:03:28.03,0:03:31.72,Default,,0,0,0,,他们很可能在军事法庭开庭前就谋杀你
Dialogue: 0,0:03:32.96,0:03:34.94,Default,,0,0,0,,我实在无法忍气吞声
Dialogue: 0,0:03:35.91,0:03:39.88,Default,,0,0,0,,算了 洒出去的红酒 回不到瓶子里
Dialogue: 0,0:03:40.22,0:03:41.80,Default,,0,0,0,,想想今后怎么办吧
Dialogue: 0,0:03:42.81,0:03:43.56,Default,,0,0,0,,抱歉
Dialogue: 0,0:03:44.09,0:03:47.81,Default,,0,0,0,,道什么歉 你可不止一次救过我的命
Dialogue: 0,0:03:48.30,0:03:51.28,Default,,0,0,0,,我打算就此还你人情 让自己轻松些
Dialogue: 0,0:03:53.78,0:03:57.48,Default,,0,0,0,,可问题是 这难关要怎么渡过呢
Dialogue: 0,0:03:58.18,0:03:59.92,Default,,0,0,0,,能交给我吗
Dialogue: 0,0:04:02.22,0:04:04.18,Default,,0,0,0,,我想去求助一个人
Dialogue: 0,0:04:04.18,0:04:06.56,Default,,0,0,0,,或者说 我是想把他牵连进来
Dialogue: 0,0:04:06.56,0:04:08.38,Default,,0,0,0,,让他跟我们结成一伙
Dialogue: 0,0:04:08.75,0:04:11.03,Default,,0,0,0,,牵连…你到底要牵连谁
Dialogue: 0,0:04:11.38,0:04:13.78,Default,,0,0,0,,贵族们口中的金发小子
Dialogue: 0,0:04:15.25,0:04:17.04,Default,,0,0,0,,你说莱因哈特·冯·缪杰尔？
Dialogue: 0,0:04:17.42,0:04:18.18,Default,,0,0,0,,没错
Dialogue: 0,0:04:18.55,0:04:19.95,Default,,0,0,0,,到今年年底
Dialogue: 0,0:04:19.95,0:04:22.56,Default,,0,0,0,,他会继承罗严克拉姆的姓氏门第 成为伯爵
Dialogue: 0,0:04:23.10,0:04:26.87,Default,,0,0,0,,有人说他是靠姐姐受宠才发迹
Dialogue: 0,0:04:27.38,0:04:28.86,Default,,0,0,0,,但我不这么想
Dialogue: 0,0:04:29.34,0:04:33.38,Default,,0,0,0,,他跟我们一样上阵立功
Dialogue: 0,0:04:33.38,0:04:35.94,Default,,0,0,0,,20岁不到就当上了上将
Dialogue: 0,0:04:37.05,0:04:39.38,Default,,0,0,0,,可我们跟他素未谋面啊
Dialogue: 0,0:04:39.87,0:04:42.92,Default,,0,0,0,,现在还未成知己 但以后会的
Dialogue: 0,0:04:48.25,0:04:53.24,Default,,0,0,0,,我们已经看够了那帮门阀贵族的腐败
Dialogue: 0,0:04:54.14,0:04:58.39,Default,,0,0,0,,我们是军人 既然早晚要择主而事
Dialogue: 0,0:04:58.95,0:05:03.89,Default,,0,0,0,,不如找个才能跟器量都出众的人 对吧
Dialogue: 0,0:05:04.62,0:05:05.67,Default,,0,0,0,,如果他
Dialogue: 0,0:05:06.00,0:05:10.18,Default,,0,0,0,,能为了我们抗衡横行不法的布朗胥百克公爵一党
Dialogue: 0,0:05:11.17,0:05:13.62,Default,,0,0,0,,那我们也向他宣誓效忠吧
Dialogue: 0,0:05:15.76,0:05:17.98,Default,,0,0,0,,好吧 交给你了
Dialogue: 0,0:05:18.72,0:05:20.87,Default,,0,0,0,,那好 这事交给我吧
Dialogue: 0,0:05:21.25,0:05:22.99,Default,,0,0,0,,听好了 我一定会来救你
Dialogue: 0,0:05:23.25,0:05:24.42,Default,,0,0,0,,你可别冲动啊
Dialogue: 0,0:05:24.75,0:05:26.19,Default,,0,0,0,,嗯 就这么办吧
Dialogue: 0,0:05:26.99,0:05:29.64,Default,,0,0,0,,倒是你 别为我太拼了
Dialogue: 0,0:05:30.98,0:05:32.17,Default,,0,0,0,,我哪会去拼呢
Dialogue: 0,0:05:32.56,0:05:34.59,Default,,0,0,0,,女人和胜利这两样
Dialogue: 0,0:05:34.59,0:05:36.94,Default,,0,0,0,,就算我不开口也会主动找上门来
Dialogue: 0,0:05:38.23,0:05:39.89,Default,,0,0,0,,这时候就别说笑了
Dialogue: 0,0:05:41.06,0:05:41.86,Default,,0,0,0,,交给你了
Dialogue: 0,0:05:43.60,0:05:44.15,Default,,0,0,0,,嗯
Dialogue: 0,0:05:46.15,0:05:48.82,Default,,0,0,0,,讨伐军一回到帝都奥丁
Dialogue: 0,0:05:49.42,0:05:53.74,Default,,0,0,0,,就直接把米达麦亚移送到了军队监狱
Dialogue: 0,0:06:03.31,0:06:06.47,Default,,0,0,0,,你是怕遭人下毒吗
Dialogue: 0,0:06:07.14,0:06:09.48,Default,,0,0,0,,我没那么软弱
Dialogue: 0,0:06:10.14,0:06:12.64,Default,,0,0,0,,那你为什么把饭剩下
Dialogue: 0,0:06:13.04,0:06:16.32,Default,,0,0,0,,没什么 吃胖了会招老婆讨厌的
Dialogue: 0,0:06:18.38,0:06:20.26,Default,,0,0,0,,真是位怪人
Dialogue: 0,0:06:21.17,0:06:24.19,Default,,0,0,0,,如果有人下毒 我会告诉你的
Dialogue: 0,0:06:25.45,0:06:27.05,Default,,0,0,0,,不好意思 谢了
Dialogue: 0,0:06:52.81,0:06:53.98,Default,,0,0,0,,您是哪位
Dialogue: 0,0:06:54.72,0:06:57.23,Default,,0,0,0,,在下奥斯卡·冯·罗严塔尔少将
Dialogue: 0,0:06:57.97,0:07:01.69,Default,,0,0,0,,有急事想拜会莱因哈特·冯·缪杰尔大人
Dialogue: 0,0:07:05.27,0:07:07.05,Default,,0,0,0,,请进
Dialogue: 0,0:07:13.82,0:07:17.77,Default,,0,0,0,,阁下的意思是 为救米达麦亚少将一命
Dialogue: 0,0:07:18.17,0:07:20.68,Default,,0,0,0,,想借助我的力量 是吧
Dialogue: 0,0:07:22.42,0:07:23.43,Default,,0,0,0,,正是
Dialogue: 0,0:07:29.32,0:07:33.42,Default,,0,0,0,,听闻米达麦亚少将是位优秀的军人
Dialogue: 0,0:07:33.94,0:07:37.07,Default,,0,0,0,,但是 你让我为一个素未谋面的人
Dialogue: 0,0:07:37.40,0:07:40.14,Default,,0,0,0,,跟帝国势力最大的贵族挑起争端？
Dialogue: 0,0:07:41.11,0:07:42.75,Default,,0,0,0,,正是 大人
Dialogue: 0,0:07:43.52,0:07:44.44,Default,,0,0,0,,原来如此
Dialogue: 0,0:07:44.85,0:07:47.84,Default,,0,0,0,,那么 回报是？
Dialogue: 0,0:07:48.84,0:07:51.69,Default,,0,0,0,,米达麦亚 以及我罗严塔尔
Dialogue: 0,0:07:52.09,0:07:55.48,Default,,0,0,0,,定将拼上性命 宣誓效忠于您
Dialogue: 0,0:08:01.69,0:08:05.37,Default,,0,0,0,,你为何要为同僚做到如此地步？
Dialogue: 0,0:08:05.87,0:08:07.95,Default,,0,0,0,,是什么让你甘冒如此风险
Dialogue: 0,0:08:09.38,0:08:11.31,Default,,0,0,0,,与此人相处 让人神清气爽
Dialogue: 0,0:08:11.75,0:08:13.87,Default,,0,0,0,,少了一个他那样的人
Dialogue: 0,0:08:14.23,0:08:16.99,Default,,0,0,0,,这世上就减少几分生机
Dialogue: 0,0:08:19.05,0:08:22.12,Default,,0,0,0,,那么 要是我拒绝呢
Dialogue: 0,0:08:24.32,0:08:28.20,Default,,0,0,0,,我不认为您会这样答复我
Dialogue: 0,0:08:28.57,0:08:29.52,Default,,0,0,0,,为何
Dialogue: 0,0:08:29.94,0:08:32.02,Default,,0,0,0,,对我而言 比起你二位
Dialogue: 0,0:08:32.02,0:08:34.13,Default,,0,0,0,,或许布朗胥百克公爵的欢心
Dialogue: 0,0:08:34.42,0:08:36.90,Default,,0,0,0,,来得更有益处呢
Dialogue: 0,0:08:37.88,0:08:40.76,Default,,0,0,0,,我不认为这是您的真心话
Dialogue: 0,0:08:43.28,0:08:47.30,Default,,0,0,0,,你对目前的高登巴姆王朝怎么看？
Dialogue: 0,0:08:54.25,0:08:55.64,Default,,0,0,0,,历经五个世纪
Dialogue: 0,0:08:55.97,0:08:58.87,Default,,0,0,0,,高登巴姆王朝这垂垂老矣的身体
Dialogue: 0,0:08:59.33,0:09:01.47,Default,,0,0,0,,已经逐渐腐烂化脓
Dialogue: 0,0:09:02.24,0:09:05.62,Default,,0,0,0,,这副衰老的身躯 需要动外科手术
Dialogue: 0,0:09:06.35,0:09:08.36,Default,,0,0,0,,事已至此 只要手术能成功
Dialogue: 0,0:09:08.67,0:09:10.57,Default,,0,0,0,,即便病人死去也无可奈何了吧
Dialogue: 0,0:09:11.54,0:09:13.83,Default,,0,0,0,,反正人都免不了一死
Dialogue: 0,0:09:14.28,0:09:15.96,Default,,0,0,0,,就连那位鲁道夫大帝也…
Dialogue: 0,0:09:18.72,0:09:21.48,Default,,0,0,0,,我明白了 罗严塔尔少将
Dialogue: 0,0:09:22.57,0:09:24.10,Default,,0,0,0,,我会倾尽全力
Dialogue: 0,0:09:24.42,0:09:27.72,Default,,0,0,0,,响应你与米达麦亚少将的期待
Dialogue: 0,0:09:29.31,0:09:30.51,Default,,0,0,0,,万分感谢
Dialogue: 0,0:09:31.06,0:09:32.12,Default,,0,0,0,,于我而言
Dialogue: 0,0:09:32.38,0:09:33.89,Default,,0,0,0,,能得到大名鼎鼎的罗严塔尔
Dialogue: 0,0:09:33.89,0:09:37.51,Default,,0,0,0,,以及米达麦亚两位少将的效忠
Dialogue: 0,0:09:37.88,0:09:39.40,Default,,0,0,0,,真是无上的喜悦
Dialogue: 0,0:09:43.43,0:09:46.25,Default,,0,0,0,,布朗胥百克公爵和菲列格尔男爵啊
Dialogue: 0,0:09:47.00,0:09:50.26,Default,,0,0,0,,看来无论如何 我和他们都是不共戴天了
Dialogue: 0,0:09:51.13,0:09:54.88,Default,,0,0,0,,您在担心树敌吗 莱因哈特大人
Dialogue: 0,0:09:55.68,0:09:56.68,Default,,0,0,0,,看起来像吗
Dialogue: 0,0:09:57.00,0:09:57.97,Default,,0,0,0,,不像
Dialogue: 0,0:09:57.97,0:09:59.24,Default,,0,0,0,,那看起来像什么？
Dialogue: 0,0:10:00.43,0:10:02.60,Default,,0,0,0,,获得了可靠的盟友
Dialogue: 0,0:10:02.96,0:10:04.92,Default,,0,0,0,,您正在为此感到高兴
Dialogue: 0,0:10:07.96,0:10:09.52,Default,,0,0,0,,你说得没错 吉尔菲艾斯
Dialogue: 0,0:10:10.12,0:10:12.23,Default,,0,0,0,,我终于抓住了寻觅已久的机会
Dialogue: 0,0:10:13.00,0:10:16.69,Default,,0,0,0,,如果想飞上天空就必须在地上蹬一脚
Dialogue: 0,0:10:17.10,0:10:18.36,Default,,0,0,0,,那现在就是时候了
Dialogue: 0,0:10:19.29,0:10:20.27,Default,,0,0,0,,吉尔菲艾斯
Dialogue: 0,0:10:20.62,0:10:24.11,Default,,0,0,0,,去查查米达麦亚提督被关在什么地方
Dialogue: 0,0:10:26.46,0:10:27.39,Default,,0,0,0,,我会加紧去查
Dialogue: 0,0:10:33.92,0:10:37.44,Default,,0,0,0,,哦？军事法庭不是还早着吗
Dialogue: 0,0:10:38.50,0:10:41.20,Default,,0,0,0,,恕我们无法回答您的问题
Dialogue: 0,0:10:58.17,0:10:59.96,Default,,0,0,0,,你是谁啊
Dialogue: 0,0:11:01.27,0:11:02.73,Default,,0,0,0,,是谁呢
Dialogue: 0,0:11:03.16,0:11:07.59,Default,,0,0,0,,或许是来细品您临终哀嚎的人
Dialogue: 0,0:11:11.16,0:11:13.25,Default,,0,0,0,,说起话来怎么装模作样的
Dialogue: 0,0:11:19.53,0:11:22.35,Default,,0,0,0,,居然没有惨叫 真是了不起
Dialogue: 0,0:11:22.35,0:11:25.37,Default,,0,0,0,,这样我就更期待了
Dialogue: 0,0:11:25.80,0:11:28.68,Default,,0,0,0,,听说您出身平民
Dialogue: 0,0:11:28.68,0:11:30.89,Default,,0,0,0,,放心 我也是平民
Dialogue: 0,0:11:30.89,0:11:34.80,Default,,0,0,0,,然而您年纪轻轻竟然就当上了少将
Dialogue: 0,0:11:35.12,0:11:39.08,Default,,0,0,0,,这样有出息的人什么时候会抛弃自尊心
Dialogue: 0,0:11:39.08,0:11:42.37,Default,,0,0,0,,开始大喊救命呢
Dialogue: 0,0:11:42.60,0:11:46.38,Default,,0,0,0,,那个瞬间实在是甜美非常啊
Dialogue: 0,0:11:46.96,0:11:49.36,Default,,0,0,0,,您能理解吗？
Dialogue: 0,0:11:50.70,0:11:54.90,Default,,0,0,0,,拿着贵族沾满鲜血和欲望的钱 替他们卖命
Dialogue: 0,0:11:55.23,0:11:57.01,Default,,0,0,0,,你的想法恕我无法理解
Dialogue: 0,0:11:59.01,0:12:00.79,Default,,0,0,0,,是吗！
Dialogue: 0,0:12:11.70,0:12:16.62,Default,,0,0,0,,有位贵人让我请您吃些苦头 留条命就行
Dialogue: 0,0:12:16.85,0:12:19.87,Default,,0,0,0,,不知我能否收得住手呢
Dialogue: 0,0:12:20.15,0:12:23.24,Default,,0,0,0,,这战斗风格还真适合卑贱的平民呀
Dialogue: 0,0:12:23.72,0:12:25.33,Default,,0,0,0,,少爷您来了呀
Dialogue: 0,0:12:25.69,0:12:28.53,Default,,0,0,0,,你被招待得相当周到啊
Dialogue: 0,0:12:28.53,0:12:30.75,Default,,0,0,0,,米达麦亚少将先生
Dialogue: 0,0:12:31.63,0:12:35.09,Default,,0,0,0,,您怎么亲自驾临这等地方…
Dialogue: 0,0:12:35.09,0:12:36.35,Default,,0,0,0,,下贱东西 别跟我说话
Dialogue: 0,0:12:36.98,0:12:39.83,Default,,0,0,0,,如何 掂清自己几斤几两没？
Dialogue: 0,0:12:40.12,0:12:44.80,Default,,0,0,0,,一只猪也配说人话 连我都替你害臊
Dialogue: 0,0:12:44.80,0:12:46.75,Default,,0,0,0,,猪 你说我是猪？
Dialogue: 0,0:12:47.31,0:12:51.12,Default,,0,0,0,,亵渎本少爷是多大的罪过
Dialogue: 0,0:12:51.37,0:12:53.06,Default,,0,0,0,,我就让你知道知道
Dialogue: 0,0:12:53.40,0:12:56.23,Default,,0,0,0,,知道没 知道没 知道没
Dialogue: 0,0:13:01.12,0:13:02.90,Default,,0,0,0,,如何 知道了吗
Dialogue: 0,0:13:03.24,0:13:05.38,Default,,0,0,0,,你这不知礼仪的平民出身
Dialogue: 0,0:13:19.12,0:13:20.40,Default,,0,0,0,,这真是不得了
Dialogue: 0,0:13:20.91,0:13:22.97,Default,,0,0,0,,高贵的血液撒了一地啊
Dialogue: 0,0:13:24.09,0:13:26.87,Default,,0,0,0,,宰了你 我要宰了你
Dialogue: 0,0:13:37.44,0:13:38.30,Default,,0,0,0,,你小子是…
Dialogue: 0,0:13:44.25,0:13:48.80,Default,,0,0,0,,菲列格尔男爵 请你放了米达麦亚少将
Dialogue: 0,0:13:50.03,0:13:51.94,Default,,0,0,0,,看来贵族的等级一低
Dialogue: 0,0:13:52.25,0:13:56.24,Default,,0,0,0,,就算不清有多少支枪指着自己了啊
Dialogue: 0,0:13:56.74,0:14:00.71,Default,,0,0,0,,你也跟那个平民一起去死吧
Dialogue: 0,0:14:01.07,0:14:03.60,Default,,0,0,0,,多谢您的宝贵提案 但是…
Dialogue: 0,0:14:14.23,0:14:17.02,Default,,0,0,0,,为什么 为什么你小子会在这儿
Dialogue: 0,0:14:17.60,0:14:19.67,Default,,0,0,0,,金发小子
Dialogue: 0,0:14:28.56,0:14:29.75,Default,,0,0,0,,我不会叫你别开枪
Dialogue: 0,0:14:29.95,0:14:32.66,Default,,0,0,0,,有本事就扣下扳机啊
Dialogue: 0,0:14:33.21,0:14:34.87,Default,,0,0,0,,这样一来我也就有借口
Dialogue: 0,0:14:35.15,0:14:38.96,Default,,0,0,0,,可以射穿你那肥大的心脏了
Dialogue: 0,0:14:39.35,0:14:41.54,Default,,0,0,0,,怎么了 不动弹吗？
Dialogue: 0,0:14:41.90,0:14:44.13,Default,,0,0,0,,我这人出身卑贱
Dialogue: 0,0:14:44.87,0:14:47.91,Default,,0,0,0,,没准会打偏哦 不试试吗
Dialogue: 0,0:14:49.36,0:14:50.74,Default,,0,0,0,,臭小子…
Dialogue: 0,0:14:51.12,0:14:53.38,Default,,0,0,0,,既然你不敢主动…
Dialogue: 0,0:14:55.71,0:14:57.43,Default,,0,0,0,,那就由我来送你上路吧
Dialogue: 0,0:15:00.28,0:15:02.05,Default,,0,0,0,,请到此为止吧
Dialogue: 0,0:15:03.48,0:15:04.89,Default,,0,0,0,,我手无寸铁
Dialogue: 0,0:15:05.49,0:15:10.75,Default,,0,0,0,,只是来替我主人 给菲列格尔男爵捎个口信
Dialogue: 0,0:15:11.15,0:15:12.45,Default,,0,0,0,,可以吗
Dialogue: 0,0:15:14.28,0:15:16.12,Default,,0,0,0,,好吧 说
Dialogue: 0,0:15:16.85,0:15:18.05,Default,,0,0,0,,站住 站住
Dialogue: 0,0:15:21.59,0:15:23.71,Default,,0,0,0,,男爵 请收起枪
Dialogue: 0,0:15:25.22,0:15:26.74,Default,,0,0,0,,你为什么会在这儿？
Dialogue: 0,0:15:27.12,0:15:30.77,Default,,0,0,0,,我来为布朗胥百克公爵捎个口信
Dialogue: 0,0:15:31.52,0:15:32.57,Default,,0,0,0,,舅舅？
Dialogue: 0,0:15:33.13,0:15:34.12,Default,,0,0,0,,他说什么
Dialogue: 0,0:15:34.41,0:15:38.54,Default,,0,0,0,,他说还望您暂且自重
Dialogue: 0,0:15:39.83,0:15:40.85,Default,,0,0,0,,自重？
Dialogue: 0,0:15:42.13,0:15:44.99,Default,,0,0,0,,您能够理解吧
Dialogue: 0,0:15:51.72,0:15:53.96,Default,,0,0,0,,这事还没完呢 臭小子
Dialogue: 0,0:15:54.28,0:15:57.38,Default,,0,0,0,,早晚跟你做个了断 给我记住
Dialogue: 0,0:16:03.80,0:16:05.83,Default,,0,0,0,,让您见笑了
Dialogue: 0,0:16:06.29,0:16:06.98,Default,,0,0,0,,不敢
Dialogue: 0,0:16:07.44,0:16:10.90,Default,,0,0,0,,这件丑事 还望您不要外传
Dialogue: 0,0:16:11.25,0:16:13.29,Default,,0,0,0,,是否算奢求呢
Dialogue: 0,0:16:14.10,0:16:15.14,Default,,0,0,0,,敢问尊驾姓名
Dialogue: 0,0:16:15.90,0:16:18.22,Default,,0,0,0,,在下安森巴哈准将
Dialogue: 0,0:16:18.61,0:16:21.35,Default,,0,0,0,,准将 刚才的口信
Dialogue: 0,0:16:21.68,0:16:23.64,Default,,0,0,0,,真是布朗胥百克公爵让你捎的？
Dialogue: 0,0:16:25.00,0:16:27.61,Default,,0,0,0,,您的意思我不太明白
Dialogue: 0,0:16:27.97,0:16:29.37,Default,,0,0,0,,以尊驾的才智
Dialogue: 0,0:16:29.37,0:16:33.12,Default,,0,0,0,,这口信是为了收场而编造出来的吧
Dialogue: 0,0:16:33.48,0:16:36.39,Default,,0,0,0,,不知您此言有何根据
Dialogue: 0,0:16:36.39,0:16:40.64,Default,,0,0,0,,但无论如何 避免了无益的流血总是幸事
Dialogue: 0,0:16:41.17,0:16:43.09,Default,,0,0,0,,您不觉得吗
Dialogue: 0,0:16:45.35,0:16:47.29,Default,,0,0,0,,我的确应该这么想吧
Dialogue: 0,0:16:47.72,0:16:49.33,Default,,0,0,0,,那么在下告辞了
Dialogue: 0,0:16:59.75,0:17:02.16,Default,,0,0,0,,待在布朗胥百克手下可惜了
Dialogue: 0,0:17:02.86,0:17:03.86,Default,,0,0,0,,所言极是
Dialogue: 0,0:17:04.33,0:17:05.24,Default,,0,0,0,,没事吧
Dialogue: 0,0:17:06.82,0:17:08.13,Default,,0,0,0,,怎么这么晚才来
Dialogue: 0,0:17:08.50,0:17:11.89,Default,,0,0,0,,我等你把菲列格尔男爵踹倒呢
Dialogue: 0,0:17:20.42,0:17:23.15,Default,,0,0,0,,大人 初次见面
Dialogue: 0,0:17:23.75,0:17:26.51,Default,,0,0,0,,在下沃尔夫冈·米达麦亚少将
Dialogue: 0,0:17:26.88,0:17:29.74,Default,,0,0,0,,衷心感谢您救我于水火之中
Dialogue: 0,0:17:30.24,0:17:35.11,Default,,0,0,0,,我随好友罗严塔尔一同 正式宣誓效忠大人
Dialogue: 0,0:17:35.67,0:17:39.65,Default,,0,0,0,,希望您能够信任我二人
Dialogue: 0,0:17:42.42,0:17:45.72,Default,,0,0,0,,于是 莱因哈特得到了继吉尔菲艾斯之后的
Dialogue: 0,0:17:45.72,0:17:47.71,Default,,0,0,0,,宝贵的盟友
Dialogue: 0,0:17:48.73,0:17:52.70,Default,,0,0,0,,莱因哈特为了证明米达麦亚无罪
Dialogue: 0,0:17:52.70,0:17:55.69,Default,,0,0,0,,主张将这一连串事件公开
Dialogue: 0,0:17:55.69,0:17:57.51,Default,,0,0,0,,坚持强硬的态度
Dialogue: 0,0:17:57.90,0:18:00.38,Default,,0,0,0,,将布朗胥百克逼到了绝境
Dialogue: 0,0:18:01.90,0:18:03.91,Default,,0,0,0,,事实一旦公诸于世
Dialogue: 0,0:18:03.91,0:18:06.36,Default,,0,0,0,,年轻贵族们的恶行就会被曝光
Dialogue: 0,0:18:06.36,0:18:08.77,Default,,0,0,0,,布朗胥百克显然没有胜算
Dialogue: 0,0:18:09.73,0:18:14.49,Default,,0,0,0,,为了平息事态 军务尚书艾伦博克元帅出面了
Dialogue: 0,0:18:15.10,0:18:16.48,Default,,0,0,0,,如何？
Dialogue: 0,0:18:16.48,0:18:20.78,Default,,0,0,0,,这事就当没发生过 各自收手吧
Dialogue: 0,0:18:22.04,0:18:23.55,Default,,0,0,0,,岂有此理…
Dialogue: 0,0:18:24.11,0:18:26.76,Default,,0,0,0,,布朗胥百克虽然怒不可遏
Dialogue: 0,0:18:27.13,0:18:31.13,Default,,0,0,0,,但最终不得不接受艾伦博克的提案
Dialogue: 0,0:18:34.63,0:18:37.81,Default,,0,0,0,,这样如何啊 缪杰尔上将
Dialogue: 0,0:18:38.23,0:18:42.79,Default,,0,0,0,,关于米达麦亚少将 虽然发生了种种纠纷
Dialogue: 0,0:18:43.14,0:18:45.56,Default,,0,0,0,,但都当没发生过
Dialogue: 0,0:18:45.56,0:18:47.26,Default,,0,0,0,,少将本人也会被释放
Dialogue: 0,0:18:47.56,0:18:50.49,Default,,0,0,0,,我会派他去最前线
Dialogue: 0,0:18:51.22,0:18:53.59,Default,,0,0,0,,您是要让他战死沙场吗？
Dialogue: 0,0:18:53.92,0:18:55.94,Default,,0,0,0,,我话还没说完呢
Dialogue: 0,0:18:56.25,0:19:00.13,Default,,0,0,0,,我是要他将功赎罪
Dialogue: 0,0:19:00.73,0:19:01.68,Default,,0,0,0,,原来如此
Dialogue: 0,0:19:02.17,0:19:04.28,Default,,0,0,0,,但是 如果没有仗打
Dialogue: 0,0:19:04.28,0:19:06.38,Default,,0,0,0,,他也无处立功啊
Dialogue: 0,0:19:07.03,0:19:08.65,Default,,0,0,0,,有仗打
Dialogue: 0,0:19:09.31,0:19:10.55,Default,,0,0,0,,有仗打？
Dialogue: 0,0:19:10.91,0:19:12.92,Default,,0,0,0,,我不知有这种决定
Dialogue: 0,0:19:13.27,0:19:16.46,Default,,0,0,0,,知道这一决定的人屈指可数
Dialogue: 0,0:19:16.78,0:19:21.18,Default,,0,0,0,,你有幸得知 应该感到荣幸才是
Dialogue: 0,0:19:21.93,0:19:23.13,Default,,0,0,0,,我明白了
Dialogue: 0,0:19:23.13,0:19:25.57,Default,,0,0,0,,那么 米达麦亚少将
Dialogue: 0,0:19:25.57,0:19:28.03,Default,,0,0,0,,将被分配到哪位提督的舰队呢
Dialogue: 0,0:19:29.65,0:19:32.50,Default,,0,0,0,,缪杰尔上将 你的舰队
Dialogue: 0,0:19:33.98,0:19:34.84,Default,,0,0,0,,我的？
Dialogue: 0,0:19:35.75,0:19:37.46,Default,,0,0,0,,我也要出征吗
Dialogue: 0,0:19:37.46,0:19:41.53,Default,,0,0,0,,没错 你有什么不满吗 缪杰尔上将
Dialogue: 0,0:19:41.94,0:19:45.83,Default,,0,0,0,,没有 感谢您为此事费心
Dialogue: 0,0:19:48.49,0:19:51.22,Default,,0,0,0,,就这样 米达麦亚获得释放
Dialogue: 0,0:19:51.72,0:19:54.44,Default,,0,0,0,,暂时被调离战场的莱因哈特
Dialogue: 0,0:19:54.44,0:19:56.69,Default,,0,0,0,,也得到了建立战功的机会
Dialogue: 0,0:19:57.78,0:20:00.88,Default,,0,0,0,,此次「克洛普修特克事件」 就他个人而言
Dialogue: 0,0:20:00.88,0:20:03.72,Default,,0,0,0,,算是有了值得满意的结果
Dialogue: 0,0:20:05.08,0:20:09.06,Default,,0,0,0,,米达麦亚恢复自由后 与罗严塔尔结伴
Dialogue: 0,0:20:09.40,0:20:12.24,Default,,0,0,0,,拜访了莱因哈特 吉尔菲艾斯
Dialogue: 0,0:20:12.24,0:20:13.69,Default,,0,0,0,,庆祝了重逢
Dialogue: 0,0:20:15.06,0:20:16.97,Default,,0,0,0,,仅仅两年后
Dialogue: 0,0:20:16.97,0:20:19.43,Default,,0,0,0,,他们四人又收获了一众同道
Dialogue: 0,0:20:19.99,0:20:24.78,Default,,0,0,0,,与布朗胥百克等门阀贵族一决雌雄 成就霸业
Dialogue: 0,0:20:26.66,0:20:31.02,Default,,0,0,0,,这一切彷佛就在昨天 又像在遥远的过去
Dialogue: 0,0:20:31.46,0:20:34.11,Default,,0,0,0,,嗯 当时我都没有留意
Dialogue: 0,0:20:34.80,0:20:38.50,Default,,0,0,0,,没想到大人他曾经的住所竟这样狭小
Dialogue: 0,0:20:39.13,0:20:39.61,Default,,0,0,0,,是啊
Dialogue: 0,0:20:43.66,0:20:46.53,Default,,0,0,0,,从今往后 必须由我们拼上性命
Dialogue: 0,0:20:46.53,0:20:48.13,Default,,0,0,0,,保护大人了
Dialogue: 0,0:20:48.63,0:20:50.00,Default,,0,0,0,,这也为了吉尔菲艾斯
Dialogue: 0,0:20:52.06,0:20:52.50,Default,,0,0,0,,是啊
Dialogue: 0,0:20:53.97,0:20:55.48,Default,,0,0,0,,母亲您看
Dialogue: 0,0:20:55.86,0:20:57.94,Default,,0,0,0,,是彩虹 彩虹出来了
Dialogue: 0,0:21:07.82,0:21:12.17,Default,,0,0,0,,去年秋天 莱因哈特战胜贵族联合军
Dialogue: 0,0:21:12.17,0:21:15.34,Default,,0,0,0,,让银河帝国的历史 开始发生剧变
Dialogue: 0,0:21:16.42,0:21:19.52,Default,,0,0,0,,莱因哈特麾下的众提督获得晋升
Dialogue: 0,0:21:19.96,0:21:22.28,Default,,0,0,0,,米达麦亚晋升一级上将
Dialogue: 0,0:21:22.74,0:21:25.75,Default,,0,0,0,,罗严塔尔也同样晋升一级上将
Dialogue: 0,0:21:26.30,0:21:30.42,Default,,0,0,0,,总参谋长奥贝斯坦也晋升一级上将
Dialogue: 0,0:21:29.18,0:21:32.43,Basic_Sign2,,0,0,0,,{\pos(992,874)}巴尔·冯·奥贝斯坦 一级上将
Dialogue: 0,0:21:31.26,0:21:32.45,Default,,0,0,0,,此外
Dialogue: 0,0:21:32.43,0:21:34.81,Basic_Sign2,,0,0,0,,{\pos(1248,766)}弗利兹·由谢夫·毕典菲尔特 上将
Dialogue: 0,0:21:32.45,0:21:34.54,Default,,0,0,0,,弗利兹·由谢夫·毕典菲尔特
Dialogue: 0,0:21:34.81,0:21:37.06,Basic_Sign2,,0,0,0,,{\pos(1464,550)}卡尔·古斯达夫·坎普 上将
Dialogue: 0,0:21:34.99,0:21:36.73,Default,,0,0,0,,卡尔·古斯达夫·坎普
Dialogue: 0,0:21:37.06,0:21:39.19,Basic_Sign2,,0,0,0,,{\pos(1028,850)}奥古斯特·沙姆艾尔·瓦列 上将
Dialogue: 0,0:21:37.17,0:21:39.02,Default,,0,0,0,,奥古斯特·沙姆艾尔·瓦列
Dialogue: 0,0:21:39.19,0:21:40.94,Basic_Sign2,,0,0,0,,{\pos(1480,646)}卡内连·鲁兹 上将
Dialogue: 0,0:21:39.47,0:21:40.96,Default,,0,0,0,,卡内连·鲁兹
Dialogue: 0,0:21:40.94,0:21:43.99,Basic_Sign2,,0,0,0,,{\pos(1032,870)}恩斯特·梅克林格 上将
Dialogue: 0,0:21:41.43,0:21:44.13,Default,,0,0,0,,以及恩斯特·梅克林格均晋升上将
Dialogue: 0,0:21:45.11,0:21:49.95,Basic_Sign2,,0,0,0,,{\pos(1000,870)}艾伯特·冯·法伦海特 上将
Dialogue: 0,0:21:44.55,0:21:47.71,Default,,0,0,0,,艾伯特·冯·法伦海特在降服后
Dialogue: 0,0:21:47.71,0:21:49.67,Default,,0,0,0,,也被纳入麾下 晋升上将
Dialogue: 0,0:21:50.65,0:21:52.57,Default,,0,0,0,,身兼帝国军最高司令官
Dialogue: 0,0:21:52.57,0:21:55.80,Default,,0,0,0,,以及帝国宰相职位的莱因哈特
Dialogue: 0,0:21:56.15,0:22:00.82,Default,,0,0,0,,倾力整顿内政 巩固权力根基
Dialogue: 0,0:22:01.67,0:22:05.27,Default,,0,0,0,,为此 他求贤若渴
Dialogue: 0,0:22:05.65,0:22:11.50,Default,,0,0,0,,新年伊始 就接连提拔新的将领来到统帅总部
Dialogue: 0,0:22:12.36,0:22:16.24,Default,,0,0,0,,包括莱因哈特的原长官 老练的指挥官
Dialogue: 0,0:22:16.24,0:22:18.32,Default,,0,0,0,,菲尔姆特 · 连内肯普上将
Dialogue: 0,0:22:16.23,0:22:18.98,Basic_Sign2,,0,0,0,,{\pos(988,870)}菲尔姆特 · 连内肯普 上将
Dialogue: 0,0:22:19.36,0:22:21.78,Default,,0,0,0,,还有以正大光明闻名的官僚
Dialogue: 0,0:22:21.78,0:22:25.86,Default,,0,0,0,,被任命为宪兵总监兼帝都防卫司令官的
Dialogue: 0,0:22:25.86,0:22:27.92,Default,,0,0,0,,乌里希·克斯拉上将
Dialogue: 0,0:22:25.11,0:22:28.74,Basic_Sign2,,0,0,0,,{\pos(1480,694)}乌里希·克斯拉 上将
Dialogue: 0,0:22:28.94,0:22:32.05,Default,,0,0,0,,还有因担任伯伦希尔舰长的经历
Dialogue: 0,0:22:32.05,0:22:36.09,Default,,0,0,0,,才能及诚实的人格得到认可
Dialogue: 0,0:22:36.09,0:22:38.50,Default,,0,0,0,,进而获得提拔的卡尔·罗伯特·舒坦梅兹上将
Dialogue: 0,0:22:34.29,0:22:39.00,Basic_Sign2,,0,0,0,,{\pos(748,874)}卡尔·罗伯特·舒坦梅兹 上将
Dialogue: 0,0:22:39.63,0:22:41.29,Default,,0,0,0,,因防守补给线等行动中的表现
Dialogue: 0,0:22:41.29,0:22:44.15,Default,,0,0,0,,指挥后勤部队的突出能力得到赏识的
Dialogue: 0,0:22:44.45,0:22:46.70,Default,,0,0,0,,恩斯特·冯·艾森纳赫上将
Dialogue: 0,0:22:43.21,0:22:47.51,Basic_Sign2,,0,0,0,,{\pos(1144,878)}恩斯特·冯·艾森纳赫 上将
Dialogue: 0,0:22:47.81,0:22:51.78,Default,,0,0,0,,以及莱因哈特麾下上将中最年轻
Dialogue: 0,0:22:52.05,0:22:56.71,Default,,0,0,0,,同时战斗技术出众却不骄不躁
Dialogue: 0,0:22:56.71,0:22:59.59,Default,,0,0,0,,在同僚中备受推崇的存在
Dialogue: 0,0:22:59.59,0:23:01.74,Default,,0,0,0,,奈特哈尔·缪拉上将
Dialogue: 0,0:22:58.56,0:23:02.27,Basic_Sign2,,0,0,0,,{\pos(1464,814)}奈特哈尔·缪拉 上将
Dialogue: 0,0:23:11.25,0:23:15.31,Default,,0,0,0,,每个人都确信新时代即将到来
Dialogue: 0,0:23:15.99,0:23:19.65,Default,,0,0,0,,而这些各擅胜场的勇将们的目光
Dialogue: 0,0:23:19.97,0:23:23.38,Default,,0,0,0,,都凝聚在一位年轻权臣的身上
Dialogue: 0,0:23:25.52,0:23:29.48,Default,,0,0,0,,莱因哈特·冯·罗严克拉姆 唯其一人
Dialogue: 0,0:23:35.93,0:23:37.23,title,,0,0,0,,暴风雨之夜
Dialogue: 0,0:23:37.23,0:23:43.76,EDCN,,0,0,0,,温柔渐渐融化
Dialogue: 0,0:23:43.76,0:23:49.80,EDCN,,0,0,0,,在杯中盘桓
Dialogue: 0,0:23:49.80,0:23:55.02,EDCN,,0,0,0,,一味旋转却抓不住
Dialogue: 0,0:23:55.42,0:24:02.40,EDCN,,0,0,0,,因为有答案 即将溢出
Dialogue: 0,0:24:02.97,0:24:09.59,EDCN,,0,0,0,,夜空中的寒星啊
Dialogue: 0,0:24:09.59,0:24:16.02,EDCN,,0,0,0,,请将这些苦痛照耀 拥抱
Dialogue: 0,0:24:16.02,0:24:23.81,EDCN,,0,0,0,,这份无边满溢的悲伤
Dialogue: 0,0:24:23.81,0:24:28.99,EDCN,,0,0,0,,也定会改换形貌 亘古闪耀
Dialogue: 0,0:24:29.19,0:24:35.63,EDCN,,0,0,0,,你是我唯一 我终于明白
Dialogue: 0,0:24:35.63,0:24:42.44,EDCN,,0,0,0,,我们正要起步 你却已离开
Dialogue: 0,0:24:42.44,0:24:49.02,EDCN,,0,0,0,,你是我唯一 我终于明白
Dialogue: 0,0:24:49.02,0:24:56.51,EDCN,,0,0,0,,我们正要起步 你却已离开
Dialogue: 0,0:23:37.23,0:23:43.76,EDJP,,0,0,0,,優しさには見えている
Dialogue: 0,0:23:43.76,0:23:49.80,EDJP,,0,0,0,,グラスの中でずっと
Dialogue: 0,0:23:49.80,0:23:55.02,EDJP,,0,0,0,,転がすだけで掴めずに
Dialogue: 0,0:23:55.42,0:24:02.40,EDJP,,0,0,0,,こぼれそうな　答えがあるから
Dialogue: 0,0:24:02.97,0:24:09.59,EDJP,,0,0,0,,夜空の冷たい星よ
Dialogue: 0,0:24:09.59,0:24:16.02,EDJP,,0,0,0,,この痛みたちを照らし抱いて
Dialogue: 0,0:24:16.02,0:24:23.81,EDJP,,0,0,0,,止め処なく溢れる悲しさも
Dialogue: 0,0:24:23.81,0:24:28.99,EDJP,,0,0,0,,形を変え輝いていくだろう
Dialogue: 0,0:24:29.19,0:24:35.63,EDJP,,0,0,0,,You're the only one, I descry
Dialogue: 0,0:24:35.63,0:24:42.44,EDJP,,0,0,0,,We've only just begun to stand by
Dialogue: 0,0:24:42.44,0:24:49.02,EDJP,,0,0,0,,You're the only one, I descry
Dialogue: 0,0:24:49.02,0:24:56.51,EDJP,,0,0,0,,We've only just begun to stand by
Dialogue: 0,0:25:01.02,0:25:12.61,title,,0,0,0,,第二十八集 改革者
Dialogue: 0,0:25:02.61,0:25:05.32,Default,,0,0,0,,{\pos(948,1058)}下集 改革者

Dialogue: 0,0:18:09.20,0:18:11.21,DarkBnd,NTP,0,0,0,,亂暴！
Dialogue: 0,0:18:11.83,0:18:12.75,DarkBnd,NTP,0,0,0,,亂！
Dialogue: 0,0:18:14.23,0:18:16.98,DarkBnd,NTP,0,0,0,,亂暴！
Dialogue: 0,0:18:18.37,0:18:19.37,CureSky,NTP,0,0,0,,別跑！
Dialogue: 0,0:18:20.32,0:18:21.83,DarkBnd,NTP,0,0,0,,亂暴！
Dialogue: 0,0:18:22.39,0:18:24.33,CureSky,NTP,0,0,0,,你這！傢伙！哇！
Dialogue: 0,0:18:24.56,0:18:25.61,CureSky,NTP,0,0,0,,咳... 咳... 咳...
Dialogue: 0,0:18:25.76,0:18:26.72,CureWin,NTP,0,0,0,,Sky！
Dialogue: 0,0:18:26.89,0:18:28.93,CureSky,NTP,0,0,0,,謝... 謝謝你
Dialogue: 0,0:18:29.47,0:18:31.70,DarkBnd,NTP,0,0,0,,拉拉拉... 拉拉拉拉拉
Dialogue: 0,0:18:31.87,0:18:33.78,CurePri,NTP,0,0,0,,太快了 我瞄不準...
Dialogue: 0,0:18:34.50,0:18:35.26,DarkBnd,NTP,0,0,0,,拉拉...
Dialogue: 0,0:18:36.18,0:18:39.26,DarkBnd,NTP,0,0,0,,亂暴！拉
Dialogue: 0,0:18:39.47,0:18:40.28,CureWin,NTP,0,0,0,,休想！
Dialogue: 0,0:18:40.44,0:18:41.31,DarkBnd,NTP,0,0,0,,亂暴！
Dialogue: 0,0:18:41.45,0:18:42.47,CureWin,NTP,0,0,0,,哇！
Dialogue: 0,0:18:43.51,0:18:44.42,DarkBnd,NTP,0,0,0,,亂！
Dialogue: 0,0:18:44.58,0:18:46.21,CureWin,NTP,0,0,0,,這招讓你停下來！
Dialogue: 0,0:18:48.83,0:18:49.77,CureWin,NTP,0,0,0,,英雄氣闊！
Dialogue: 0,0:18:49.93,0:18:52.13,CureWin,NTP,0,0,0,,飛翼衝擊！
Dialogue: 0,0:18:49.93,0:18:52.13,CureWin,NTP,0,0,0,,{\fs50}Wing Attack！
Dialogue: 0,0:18:53.77,0:18:56.86,DarkBnd,NTP,0,0,0,,亂！暴
Dialogue: 0,0:18:57.02,0:18:57.76,CureWin,NTP,0,0,0,,打空檔！
Dialogue: 0,0:18:57.92,0:18:59.58,CureSky,NTP,0,0,0,,喝！
Dialogue: 0,0:18:59.74,0:19:00.14,DarkBnd,NTP,0,0,0,,拉拉！
Dialogue: 0,0:19:00.22,0:19:01.37,CureSky,NTP,0,0,0,,噠！
Dialogue: 0,0:19:01.53,0:19:02.56,DarkBnd,NTP,0,0,0,,亂暴！
Dialogue: 0,0:19:03.01,0:19:05.10,CureSky,NTP,0,0,0,,體型那麼大 身手卻很靈活
Dialogue: 0,0:19:05.39,0:19:06.14,CurePri,NTP,0,0,0,,Sky！
Dialogue: 0,0:19:07.09,0:19:08.13,CurePri,NTP,0,0,0,,給！
Dialogue: 0,0:19:12.35,0:19:15.78,CurePri,NTP,0,0,0,,Sky可以打中的 拜託了
Dialogue: 0,0:19:19.11,0:19:20.16,CureSky,NTP,0,0,0,,是！
Dialogue: 0,0:19:22.38,0:19:23.25,CureSky,NTP,0,0,0,,哼！
Dialogue: 0,0:19:23.42,0:19:24.35,DarkBnd,NTP,0,0,0,,拉拉！
Dialogue: 0,0:19:24.51,0:19:26.67,CureSky,NTP,0,0,0,,這就是特訓的成果！
Dialogue: 0,0:19:28.56,0:19:29.88,DarkBnd,NTP,0,0,0,,拉拉拉...
Dialogue: 0,0:19:30.89,0:19:32.76,DarkBnd,NTP,0,0,0,,亂暴！拉
Dialogue: 0,0:19:32.91,0:19:34.64,CureSky,NTP,0,0,0,,喝！
Dialogue: 0,0:19:34.81,0:19:37.11,DarkBnd,NTP,0,0,0,,亂暴...
Dialogue: 0,0:00:00.15,0:00:00.15,Default,NTP,0,0,0,,
Dialogue: 0,0:19:50.32,0:19:51.35,CureSky,NTP,0,0,0,,天空藍！
Dialogue: 0,0:19:50.32,0:19:51.35,CureSky,NTP,0,0,0,,{\fs50}Sky Blue！
Dialogue: 0,0:19:54.78,0:19:56.10,CurePri,NTP,0,0,0,,稜鏡白！
Dialogue: 0,0:19:54.78,0:19:56.10,CurePri,NTP,0,0,0,,{\fs50}Prism White！

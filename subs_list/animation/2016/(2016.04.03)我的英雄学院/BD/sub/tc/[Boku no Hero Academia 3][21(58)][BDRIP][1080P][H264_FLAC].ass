Dialogue: 0,0:00:01.58,0:00:04.21,Default,,0,0,0,,雄英是孕育了許多英雄的名門高校
Dialogue: 0,0:00:04.29,0:00:06.79,Default,,0,0,0,,進入雄英英雄科就讀的我
Dialogue: 0,0:00:07.25,0:00:09.42,Default,,0,0,0,,正朝著夢想努力邁進
Dialogue: 1,0:00:09.80,0:00:13.55,Default2,,0,0,0,,這一切都是為了成為
Dialogue: 0,0:00:09.80,0:00:13.55,Default,,0,0,0,,勇於面對任何困難
Dialogue: 1,0:00:14.22,0:00:17.35,Default2,,0,0,0,,並帶著笑容拯救人們的
Dialogue: 0,0:00:14.22,0:00:17.35,Default,,0,0,0,,最棒的英雄
Dialogue: 0,0:01:50.98,0:01:52.90,Default,,0,0,0,,（三週前）
Dialogue: 0,0:01:52.98,0:01:53.94,Default,,0,0,0,,（英雄公安委員會本部）
Dialogue: 0,0:01:54.03,0:01:55.16,Default,,0,0,0,,丟球嗎？
Dialogue: 0,0:01:55.36,0:01:57.53,Default,,0,0,0,,怎麼聽起來感覺很像在玩樂？
Dialogue: 0,0:01:58.28,0:01:59.37,Default,,0,0,0,,沒問題嗎？
Dialogue: 0,0:01:59.45,0:02:01.16,Default,,0,0,0,,重點不在於丟球
Dialogue: 0,0:02:01.24,0:02:03.95,Default,,0,0,0,,而是刻意製造一個混亂的場面
Dialogue: 1,0:02:04.20,0:02:08.91,Default2,,0,0,0,,考驗考生能否在緊急情況下
Dialogue: 0,0:02:04.20,0:02:08.91,Default,,0,0,0,,準確快速地動腦及發揮
Dialogue: 0,0:02:09.25,0:02:10.88,Default,,0,0,0,,第二輪也一樣嗎？
Dialogue: 0,0:02:11.46,0:02:13.75,Default,,0,0,0,,這樣就不是在審查個人能力
Dialogue: 1,0:02:14.01,0:02:17.10,Default2,,0,0,0,,而是以團體行動為前提的
Dialogue: 0,0:02:14.01,0:02:17.10,Default,,0,0,0,,小組能力審查了
Dialogue: 0,0:02:17.43,0:02:19.68,Default,,0,0,0,,其實這是警視廳那邊給的建議
Dialogue: 0,0:02:19.93,0:02:23.48,Default,,0,0,0,,他們要我們修改臨時證照的判斷基準
Dialogue: 0,0:02:23.72,0:02:25.64,Default,,0,0,0,,實質上就是下了命令
Dialogue: 0,0:02:26.02,0:02:28.40,Default,,0,0,0,,以考生都具備緊急處置
Dialogue: 0,0:02:28.48,0:02:32.07,Default,,0,0,0,,跟傷病診斷等救助相關的基礎為前提
Dialogue: 0,0:02:32.15,0:02:33.69,Default,,0,0,0,,透過考試
Dialogue: 0,0:02:33.78,0:02:36.91,Default,,0,0,0,,觀察他們對合作跟協調的應對態度
Dialogue: 0,0:02:37.45,0:02:39.16,Default,,0,0,0,,協調啊
Dialogue: 0,0:02:39.57,0:02:41.95,Default,,0,0,0,,這麼做都是必要的
Dialogue: 0,0:02:42.49,0:02:44.20,Default,,0,0,0,,就力量與魅力來看
Dialogue: 0,0:02:44.45,0:02:46.79,Default,,0,0,0,,歐爾麥特都是首屈一指
Dialogue: 0,0:02:47.41,0:02:51.04,Default,,0,0,0,,他跟第二名之間有著非常大的差距
Dialogue: 0,0:02:52.04,0:02:55.84,Default,,0,0,0,,具備那種領袖魅力的人是相當罕見的
Dialogue: 0,0:02:56.51,0:02:58.55,Default,,0,0,0,,與其等待下個歐爾麥特
Dialogue: 1,0:02:58.63,0:03:03.93,Default2,,0,0,0,,還不如讓比過去更重視團結的
Dialogue: 0,0:02:58.63,0:03:03.93,Default,,0,0,0,,集體英雄來填補空缺
Dialogue: 0,0:03:04.64,0:03:05.98,Default,,0,0,0,,這次的提議
Dialogue: 0,0:03:06.06,0:03:08.15,Default,,0,0,0,,就像實現這個目的的方案
Dialogue: 0,0:03:09.06,0:03:12.40,Default,,0,0,0,,英雄臨時證照測驗第二輪
Dialogue: 1,0:03:12.81,0:03:16.31,Default2,,0,0,0,,要救出被捲入
Dialogue: 0,0:03:12.81,0:03:16.31,Default,,0,0,0,,大規模恐攻的民眾，還有…
Dialogue: 0,0:03:16.40,0:03:19.57,Default,,0,0,0,,看考生怎麼應對策劃這起恐攻的惡人
Dialogue: 0,0:03:21.11,0:03:22.57,Default,,0,0,0,,怎麼回事？
Dialogue: 0,0:03:24.45,0:03:26.54,Default,,0,0,0,,救難與抗敵
Dialogue: 0,0:03:27.79,0:03:31.17,Default,,0,0,0,,你們有能力同時妥善處理嗎？
Dialogue: 0,0:03:32.67,0:03:34.26,Default,,0,0,0,,暴力虎鯨
Dialogue: 0,0:03:34.92,0:03:38.22,Default,,0,0,0,,在神野區的惡人聯軍掃蕩作戰中
Dialogue: 0,0:03:38.30,0:03:40.72,Default,,0,0,0,,跟安德瓦還有最佳牛仔褲時尚名人獎
Dialogue: 0,0:03:40.80,0:03:43.01,Default,,0,0,0,,一同被指名的英雄
Dialogue: 0,0:03:43.30,0:03:44.80,Default,,0,0,0,,他很強喔
Dialogue: 0,0:03:48.39,0:03:51.69,Default,,0,0,0,,惡人現身了，並且展開追擊
Dialogue: 0,0:03:51.77,0:03:53.52,Default,,0,0,0,,請在現場的英雄候補生
Dialogue: 0,0:03:53.61,0:03:55.36,Default,,0,0,0,,一邊制伏惡人
Dialogue: 0,0:03:55.44,0:03:57.40,Default,,0,0,0,,一邊繼續進行救援行動
Dialogue: 0,0:03:57.48,0:03:59.77,Default,,0,0,0,,一邊戰鬥一邊進行救援？
Dialogue: 0,0:03:59.90,0:04:02.28,Default,,0,0,0,,真是，有沒有搞錯？
Dialogue: 0,0:04:02.36,0:04:04.49,Default,,0,0,0,,難度會不會太高啦？
Dialogue: 0,0:04:04.57,0:04:07.32,Default,,0,0,0,,這對職業英雄都很困難了
Dialogue: 0,0:04:07.91,0:04:10.20,Default,,0,0,0,,臨時證照考試居然這麼硬
Dialogue: 0,0:04:11.54,0:04:14.84,Default,,0,0,0,,好了，你們要怎麼做？
Dialogue: 0,0:04:15.71,0:04:17.67,Default,,0,0,0,,要戰鬥還是要防守？
Dialogue: 0,0:04:18.42,0:04:20.46,Default,,0,0,0,,要救人還是要逃跑？
Dialogue: 0,0:04:21.38,0:04:23.05,Default,,0,0,0,,怎麼樣？英雄
Dialogue: 0,0:04:27.85,0:04:28.89,Default,,0,0,0,,（山岳區）
Dialogue: 0,0:04:28.97,0:04:30.01,Default,,0,0,0,,惡人現身了
Dialogue: 0,0:04:30.10,0:04:32.19,Default,,0,0,0,,你們看，就在救護站前面
Dialogue: 0,0:04:32.73,0:04:33.69,Default,,0,0,0,,糟了
Dialogue: 0,0:04:33.77,0:04:36.36,Default,,0,0,0,,竟然在離救護站那麼近的地方
Dialogue: 0,0:04:36.44,0:04:37.44,Default,,0,0,0,,太壞心了
Dialogue: 0,0:04:37.82,0:04:40.16,Default,,0,0,0,,雖然還沒救出這裡全部的人
Dialogue: 0,0:04:40.44,0:04:42.78,Default,,0,0,0,,卻也不能放著那邊的惡人不管
Dialogue: 0,0:04:45.53,0:04:46.78,Default,,0,0,0,,第二輪考試
Dialogue: 0,0:04:46.87,0:04:48.83,Default,,0,0,0,,事先給了每位考生積分
Dialogue: 0,0:04:48.91,0:04:51.25,Default,,0,0,0,,採扣分方式來評分
Dialogue: 1,0:04:52.25,0:04:55.13,Default2,,0,0,0,,HUC會針對救援行動正確與否
Dialogue: 0,0:04:52.25,0:04:55.13,Default,,0,0,0,,進行審查
Dialogue: 0,0:04:55.21,0:04:56.63,Default,,0,0,0,,除此之外
Dialogue: 0,0:04:56.71,0:04:59.17,Default,,0,0,0,,也會看考生是否活用自己的個性
Dialogue: 0,0:04:59.25,0:05:01.46,Default,,0,0,0,,將自己擺在合適的職位上
Dialogue: 0,0:05:01.84,0:05:06.09,Default,,0,0,0,,我們出動了100位公安採用人工計分
Dialogue: 1,0:05:06.18,0:05:10.89,Default2,,0,0,0,,每個人手上都有負責考生的資料
Dialogue: 0,0:05:06.18,0:05:10.89,Default,,0,0,0,,來一對一評分
Dialogue: 1,0:05:11.73,0:05:16.61,Default2,,0,0,0,,要是積分剩不到50
Dialogue: 0,0:05:11.73,0:05:16.61,Default,,0,0,0,,當場就會被判定不及格
Dialogue: 0,0:05:17.19,0:05:21.15,Default,,0,0,0,,請各位多加油，做出正確的選擇吧
Dialogue: 0,0:05:23.65,0:05:25.07,Default,,0,0,0,,快帶大家去避難
Dialogue: 0,0:05:25.16,0:05:26.29,Default,,0,0,0,,真堂學長
Dialogue: 0,0:05:26.36,0:05:27.32,Default,,0,0,0,,到裡面去
Dialogue: 0,0:05:27.41,0:05:29.66,Default,,0,0,0,,然後盡可能地跟惡人保持距離
Dialogue: 0,0:05:29.74,0:05:30.62,Default,,0,0,0,,好的
Dialogue: 1,0:05:30.70,0:05:34.29,Default2,,0,0,0,,我要接連使出間隔約一秒的震動
Dialogue: 0,0:05:30.70,0:05:34.29,Default,,0,0,0,,來攻擊惡人
Dialogue: 0,0:05:36.29,0:05:38.00,Default,,0,0,0,,休想越雷池一步
Dialogue: 0,0:05:38.79,0:05:39.96,Default,,0,0,0,,太嫩了
Dialogue: 0,0:05:41.80,0:05:43.59,Default,,0,0,0,,暴力虎鯨竟然…
Dialogue: 0,0:05:43.67,0:05:44.92,Default,,0,0,0,,他是玩真的啊
Dialogue: 0,0:05:45.01,0:05:46.26,Default,,0,0,0,,應該是吧
Dialogue: 0,0:05:46.76,0:05:47.89,Default,,0,0,0,,真堂學長
Dialogue: 0,0:05:49.39,0:05:52.14,Default,,0,0,0,,實力差這麼多，還敢單獨斷後
Dialogue: 0,0:05:52.56,0:05:54.19,Default,,0,0,0,,會不會太瞧不起人了？
Dialogue: 0,0:05:54.56,0:05:55.90,Default,,0,0,0,,暴力虎鯨
Dialogue: 0,0:05:55.98,0:05:57.02,Default,,0,0,0,,個性，虎鯨
Dialogue: 0,0:05:57.10,0:05:59.27,Default,,0,0,0,,能在陸地上使用虎鯨的能力
Dialogue: 0,0:05:59.36,0:06:00.82,Default,,0,0,0,,其中一項能力就是
Dialogue: 0,0:06:00.90,0:06:03.24,Default,,0,0,0,,能用超音波麻痹目標
Dialogue: 0,0:06:12.58,0:06:13.83,Default,,0,0,0,,轟同學
Dialogue: 0,0:06:13.91,0:06:15.70,Default,,0,0,0,,綠谷，要疏散民眾嗎？
Dialogue: 0,0:06:15.79,0:06:16.71,Default,,0,0,0,,我來幫你
Dialogue: 0,0:06:16.79,0:06:17.92,Default,,0,0,0,,轟跑好快
Dialogue: 0,0:06:18.00,0:06:19.63,Default,,0,0,0,,各位，你們剛在哪裡？
Dialogue: 0,0:06:19.71,0:06:21.42,Default,,0,0,0,,就在前面的水邊附近
Dialogue: 1,0:06:21.75,0:06:24.92,Default2,,0,0,0,,因為看大家都往市區跑
Dialogue: 0,0:06:21.75,0:06:24.92,Default,,0,0,0,,就先去人不多的地方
Dialogue: 0,0:06:25.01,0:06:28.22,Default,,0,0,0,,結果這裡出現大量惡人，就來幫忙了
Dialogue: 1,0:06:28.30,0:06:31.60,Default2,,0,0,0,,八百萬跟蛙吹她們
Dialogue: 0,0:06:28.30,0:06:31.60,Default,,0,0,0,,則留在原地繼續救難
Dialogue: 0,0:06:33.72,0:06:35.89,Default,,0,0,0,,這根本雕蟲小技
Dialogue: 0,0:06:36.52,0:06:38.56,Default,,0,0,0,,真不愧是第十名英雄
Dialogue: 0,0:06:40.23,0:06:41.52,Default,,0,0,0,,是風
Dialogue: 0,0:06:41.73,0:06:45.53,Default,,0,0,0,,通通給我飛吧
Dialogue: 0,0:06:48.07,0:06:49.86,Default,,0,0,0,,竟然有惡人來搗亂
Dialogue: 0,0:06:49.95,0:06:53.25,Default,,0,0,0,,真不錯，這樣的安排還挺熱血的嘛
Dialogue: 0,0:06:55.87,0:06:56.96,Default,,0,0,0,,他是那個…
Dialogue: 0,0:06:57.04,0:06:58.54,Default,,0,0,0,,拒絕來雄英就讀的人
Dialogue: 0,0:06:58.62,0:07:00.33,Default,,0,0,0,,很好，戰力聚集起來了
Dialogue: 0,0:07:00.42,0:07:02.42,Default,,0,0,0,,趁現在引導民眾避難
Dialogue: 0,0:07:04.05,0:07:06.39,Default,,0,0,0,,他們優先趕到聚集傷員的救護站
Dialogue: 0,0:07:06.55,0:07:09.68,Default,,0,0,0,,也就是救助的首要地點幫忙
Dialogue: 0,0:07:10.47,0:07:12.31,Default,,0,0,0,,這判斷很明智
Dialogue: 0,0:07:12.39,0:07:14.10,Default,,0,0,0,,夜嵐跟轟的個性
Dialogue: 1,0:07:14.18,0:07:17.06,Default2,,0,0,0,,都擁有出色壓制能力
Dialogue: 0,0:07:14.18,0:07:17.06,Default,,0,0,0,,這裡很適合表現
Dialogue: 0,0:07:17.48,0:07:18.65,Default,,0,0,0,,做得好
Dialogue: 0,0:07:21.48,0:07:23.73,Default,,0,0,0,,沒想到我們竟然同時抵達
Dialogue: 0,0:07:24.02,0:07:26.61,Default,,0,0,0,,老實說我非常討厭你們
Dialogue: 0,0:07:27.90,0:07:29.74,Default,,0,0,0,,那是我要說的吧
Dialogue: 0,0:07:30.07,0:07:32.91,Default,,0,0,0,,那傢伙老是說些讓人分心的鬼話
Dialogue: 1,0:07:32.99,0:07:36.16,Default2,,0,0,0,,我建議你還是去幫忙
Dialogue: 0,0:07:32.99,0:07:36.16,Default,,0,0,0,,疏散救護站的民眾吧
Dialogue: 0,0:07:36.41,0:07:38.37,Default,,0,0,0,,你的個性剛好很適合
Dialogue: 0,0:07:38.46,0:07:40.21,Default,,0,0,0,,這裡就交給我
Dialogue: 0,0:07:44.75,0:07:45.79,Default,,0,0,0,,要來了
Dialogue: 0,0:07:54.05,0:07:55.18,Default,,0,0,0,,他們在攻擊哪裡？
Dialogue: 0,0:07:55.26,0:07:56.85,Default,,0,0,0,,你為什麼要用火啦？
Dialogue: 0,0:07:56.93,0:07:58.81,Default,,0,0,0,,火的熱氣會讓風往上飄耶
Dialogue: 0,0:07:58.89,0:08:01.27,Default,,0,0,0,,因為冰被擋下，我才會用火攻擊
Dialogue: 0,0:08:01.35,0:08:03.85,Default,,0,0,0,,是你硬要在同一時間放出風的吧？
Dialogue: 0,0:08:03.94,0:08:06.69,Default,,0,0,0,,我的火焰也一樣被風吹散了
Dialogue: 1,0:08:07.11,0:08:09.78,Default2,,0,0,0,,你不想被搶走功勞
Dialogue: 0,0:08:07.11,0:08:09.78,Default,,0,0,0,,才故意同時發招吧？
Dialogue: 0,0:08:10.40,0:08:12.15,Default,,0,0,0,,誰會做那種無聊的事？
Dialogue: 0,0:08:12.24,0:08:13.16,Default,,0,0,0,,你就是會
Dialogue: 0,0:08:13.24,0:08:16.62,Default,,0,0,0,,因為你是那個安德瓦的兒子
Dialogue: 0,0:08:18.54,0:08:20.75,Default,,0,0,0,,你從剛才就一直在說什麼？
Dialogue: 0,0:08:20.83,0:08:22.83,Default,,0,0,0,,這跟我老爸沒關係
Dialogue: 0,0:08:23.63,0:08:25.09,Default,,0,0,0,,水泥槍
Dialogue: 0,0:08:25.17,0:08:27.63,Default,,0,0,0,,這會立刻凝固，讓人動彈不得
Dialogue: 0,0:08:27.71,0:08:29.42,Default,,0,0,0,,真是太誇張了
Dialogue: 0,0:08:29.51,0:08:31.39,Default,,0,0,0,,竟然在這種時候吵架
Dialogue: 0,0:08:34.51,0:08:36.64,Default,,0,0,0,,你說沒關係？
Dialogue: 0,0:08:37.31,0:08:39.60,Default,,0,0,0,,但是偏偏就是有關係
Dialogue: 0,0:08:40.48,0:08:43.69,Default,,0,0,0,,所謂的英雄對我來說就是熱血
Dialogue: 0,0:08:43.77,0:08:45.52,Default,,0,0,0,,火熱的心
Dialogue: 0,0:08:45.61,0:08:48.49,Default,,0,0,0,,可以帶給人們希望以及感動
Dialogue: 0,0:08:48.57,0:08:49.95,Default,,0,0,0,,讓人感受到
Dialogue: 0,0:08:51.40,0:08:52.61,Default,,0,0,0,,別擋路
Dialogue: 0,0:08:53.07,0:08:55.07,Default,,0,0,0,,不要堵在那邊妨礙我
Dialogue: 0,0:08:57.16,0:08:59.29,Default,,0,0,0,,當時我真的深受打擊
Dialogue: 0,0:09:00.29,0:09:02.08,Default,,0,0,0,,因為在他的眼神裡
Dialogue: 0,0:09:02.37,0:09:06.08,Default,,0,0,0,,只有種冰冷的憤怒，此外什麼都沒有
Dialogue: 0,0:09:10.00,0:09:12.13,Default,,0,0,0,,之後在推甄入學考試時
Dialogue: 0,0:09:12.22,0:09:13.47,Default,,0,0,0,,一看到你
Dialogue: 0,0:09:13.55,0:09:15.89,Default,,0,0,0,,我就立刻認出來你是誰
Dialogue: 0,0:09:16.51,0:09:18.43,Default,,0,0,0,,不用說，因為…
Dialogue: 0,0:09:18.89,0:09:20.35,Default,,0,0,0,,別擋路
Dialogue: 0,0:09:20.89,0:09:23.60,Default,,0,0,0,,你的眼神跟他一模一樣
Dialogue: 0,0:09:25.77,0:09:27.23,Default,,0,0,0,,一模一樣？
Dialogue: 0,0:09:28.02,0:09:29.40,Default,,0,0,0,,你在開什麼玩笑？
Dialogue: 0,0:09:31.99,0:09:34.74,Default,,0,0,0,,我才不是那個混帳傢伙
Dialogue: 0,0:09:35.95,0:09:38.45,Default,,0,0,0,,夠了，別再理他了
Dialogue: 0,0:09:39.58,0:09:40.58,Default,,0,0,0,,簡單來說
Dialogue: 0,0:09:40.66,0:09:43.50,Default,,0,0,0,,他就是隨處可見的安德瓦的黑粉
Dialogue: 0,0:09:43.83,0:09:46.12,Default,,0,0,0,,還是專心在考試上吧
Dialogue: 0,0:09:47.92,0:09:49.51,Default,,0,0,0,,不要被他激怒
Dialogue: 0,0:09:50.30,0:09:52.72,Default,,0,0,0,,我早就已經放下對老爸的恨了
Dialogue: 0,0:09:54.67,0:09:55.84,Default,,0,0,0,,不對
Dialogue: 0,0:09:56.93,0:09:59.39,Default,,0,0,0,,我對那傢伙的厭惡還沒…
Dialogue: 0,0:10:00.47,0:10:03.52,Default,,0,0,0,,不行，我得專心考試才行
Dialogue: 0,0:10:05.52,0:10:09.27,Default,,0,0,0,,惡人就在眼前，他們到底在搞什麼？
Dialogue: 0,0:10:11.32,0:10:14.20,Default,,0,0,0,,不管怎麼樣我就是沒辦法…
Dialogue: 0,0:10:14.28,0:10:17.03,Default,,0,0,0,,認同你們父子倆這樣差勁的英雄
Dialogue: 0,0:10:17.11,0:10:18.20,Default,,0,0,0,,就是這樣
Dialogue: 0,0:10:18.53,0:10:20.07,Default,,0,0,0,,專心考試
Dialogue: 0,0:10:21.74,0:10:24.16,Default,,0,0,0,,還來？你果然是故意的
Dialogue: 0,0:10:25.79,0:10:27.75,Default,,0,0,0,,風讓火焰轉向了
Dialogue: 0,0:10:33.55,0:10:36.43,Default,,0,0,0,,你們在搞什麼？
Comment: 1,0:10:37.97,0:10:41.02,Default2,,0,0,0,,（轟焦凍，右邊冰凍、左邊燃燒
Comment: 0,0:10:37.97,0:10:41.02,Default,,0,0,0,,擁有這兩種個性）
Comment: 1,0:10:41.60,0:10:44.73,Default2,,0,0,0,,（暴力虎鯨，能在陸地跟水中
Comment: 0,0:10:41.60,0:10:44.73,Default,,0,0,0,,發揮虎鯨擁有的特性）
Dialogue: 0,0:10:47.10,0:10:48.52,Default,,0,0,0,,我這個人
Dialogue: 0,0:10:48.81,0:10:51.27,Default,,0,0,0,,從小時候就天不怕地不怕
Dialogue: 0,0:10:53.65,0:10:55.19,Default,,0,0,0,,好帥，跑得超快
Dialogue: 0,0:10:56.95,0:10:58.70,Default,,0,0,0,,我超愛這些蟲蟲的
Dialogue: 0,0:10:59.03,0:11:01.78,Default,,0,0,0,,也容易迷上一樣東西一頭栽進去
Dialogue: 0,0:11:02.33,0:11:03.83,Default,,0,0,0,,我這種個性的人
Dialogue: 0,0:11:03.91,0:11:07.29,Default,,0,0,0,,在得知英雄這種人的存在之後
Dialogue: 0,0:11:07.37,0:11:08.58,Default,,0,0,0,,瞬間就為之瘋狂
Dialogue: 1,0:11:09.29,0:11:12.34,Default2,,0,0,0,,面對眼前的危機
Dialogue: 0,0:11:09.29,0:11:12.34,Default,,0,0,0,,他們總會盡全力應戰
Dialogue: 0,0:11:12.42,0:11:14.34,Default,,0,0,0,,這種火熱讓我瘋狂
Dialogue: 0,0:11:16.59,0:11:19.01,Default,,0,0,0,,所以我才會討厭那個英雄
Dialogue: 0,0:11:19.68,0:11:21.10,Default,,0,0,0,,討厭那個英雄
Dialogue: 0,0:11:21.18,0:11:24.73,Default,,0,0,0,,彷彿痛恨遠方某個目標的眼神
Dialogue: 0,0:11:25.26,0:11:27.72,Default,,0,0,0,,那是我過去唯一討厭的東西
Dialogue: 0,0:11:30.56,0:11:31.65,Default,,0,0,0,,好啦
Dialogue: 0,0:11:31.73,0:11:33.94,Default,,0,0,0,,推甄入學的筆試到此為止
Dialogue: 0,0:11:34.02,0:11:35.44,Default,,0,0,0,,接著是術科
Dialogue: 0,0:11:35.53,0:11:37.28,Default,,0,0,0,,最後則是面試
Dialogue: 0,0:11:37.61,0:11:40.15,Default,,0,0,0,,術科每六個人一組進行分批審查
Dialogue: 0,0:11:40.24,0:11:42.37,Default,,0,0,0,,叫到號碼的考生請前往考場
Dialogue: 0,0:11:42.45,0:11:44.83,Default,,0,0,0,,考試的內容是跑三公里馬拉松
Dialogue: 0,0:11:44.91,0:11:47.91,Default,,0,0,0,,這不是單純用跑的就能完成的賽道
Dialogue: 0,0:11:48.00,0:11:50.29,Default,,0,0,0,,請活用個性，往終點邁進
Dialogue: 0,0:11:50.87,0:11:53.71,Default,,0,0,0,,全日本水平最高的英雄學校
Dialogue: 0,0:11:55.55,0:11:58.76,Default,,0,0,0,,全日本最火熱的高中生活正等著我
Dialogue: 0,0:12:02.51,0:12:04.05,Default,,0,0,0,,持續發出冰來移動
Dialogue: 0,0:12:04.14,0:12:05.35,Default,,0,0,0,,好快
Dialogue: 0,0:12:06.06,0:12:08.48,Default,,0,0,0,,雖然我很討厭他的眼神
Dialogue: 0,0:12:09.02,0:12:10.77,Default,,0,0,0,,他的實力卻超火熱
Dialogue: 0,0:12:11.31,0:12:13.81,Default,,0,0,0,,那傢伙八成會被錄取吧？
Dialogue: 0,0:12:14.36,0:12:17.11,Default,,0,0,0,,不對，如果能跟他成為朋友
Dialogue: 0,0:12:17.19,0:12:19.07,Default,,0,0,0,,我或許就不會在意那個眼神了
Dialogue: 0,0:12:22.78,0:12:24.03,Default,,0,0,0,,只差一點
Dialogue: 0,0:12:24.12,0:12:26.83,Default,,0,0,0,,41號以些微差距，率先抵達
Dialogue: 0,0:12:30.50,0:12:33.00,Default,,0,0,0,,比往年的平均時間快了三分鐘
Dialogue: 0,0:12:33.08,0:12:35.04,Default,,0,0,0,,太好啦，我贏啦
Dialogue: 0,0:12:35.13,0:12:36.92,Default,,0,0,0,,但是下次就不知道了
Dialogue: 0,0:12:37.00,0:12:38.42,Default,,0,0,0,,你真的很厲害耶
Dialogue: 0,0:12:38.50,0:12:40.71,Default,,0,0,0,,你是不是安德瓦的兒子還是親戚？
Dialogue: 0,0:12:40.80,0:12:41.89,Default,,0,0,0,,超強的耶
Dialogue: 0,0:12:41.97,0:12:42.93,Default,,0,0,0,,閉嘴
Dialogue: 0,0:12:44.47,0:12:47.22,Default,,0,0,0,,這只是考試，只要能過關就好
Dialogue: 0,0:12:47.31,0:12:50.35,Default,,0,0,0,,我根本沒意思跟你比誰輸誰贏
Dialogue: 0,0:12:53.73,0:12:55.15,Default,,0,0,0,,看也不看
Dialogue: 0,0:12:56.23,0:12:57.48,Default,,0,0,0,,別擋路
Dialogue: 0,0:12:58.40,0:13:00.03,Default,,0,0,0,,彷彿痛恨著…
Dialogue: 0,0:13:00.65,0:13:02.15,Default,,0,0,0,,遠方某個目標
Dialogue: 0,0:13:04.66,0:13:07.58,Default,,0,0,0,,你們在搞什麼？
Dialogue: 0,0:13:11.50,0:13:13.71,Default,,0,0,0,,真不像頂尖名校會有的表現
Dialogue: 0,0:13:13.79,0:13:15.17,Default,,0,0,0,,雖然很遺憾
Dialogue: 0,0:13:15.54,0:13:17.21,Default,,0,0,0,,但是那兩個人八成…
Dialogue: 0,0:13:20.17,0:13:22.17,Default,,0,0,0,,使用風的個性
Dialogue: 0,0:13:23.22,0:13:24.39,Default,,0,0,0,,對了
Dialogue: 0,0:13:24.47,0:13:26.01,Default,,0,0,0,,難怪我會耿耿於懷
Dialogue: 0,0:13:26.59,0:13:28.93,Default,,0,0,0,,應該就是他，沒錯
Dialogue: 0,0:13:29.60,0:13:31.94,Default,,0,0,0,,為什麼我沒能立刻想起來呢？
Dialogue: 0,0:13:32.14,0:13:34.27,Default,,0,0,0,,那傢伙明明吵得要命
Dialogue: 0,0:13:36.06,0:13:37.90,Default,,0,0,0,,我真的完全沒在看
Dialogue: 0,0:13:37.98,0:13:39.44,Default,,0,0,0,,周遭的人事物
Dialogue: 0,0:13:40.27,0:13:42.31,Default,,0,0,0,,滿腦子就只想著…
Dialogue: 0,0:13:43.15,0:13:44.94,Default,,0,0,0,,要否定那個傢伙
Dialogue: 0,0:13:46.78,0:13:48.62,Default,,0,0,0,,在那一瞬間我忘了你的存在
Dialogue: 0,0:13:50.12,0:13:52.58,Default,,0,0,0,,這到底是好事還是壞事？
Dialogue: 0,0:13:52.87,0:13:54.62,Default,,0,0,0,,又是否正確？
Dialogue: 0,0:13:55.25,0:13:57.88,Default,,0,0,0,,原來我一直渾渾噩噩地過日子
Dialogue: 0,0:13:58.50,0:14:00.34,Default,,0,0,0,,一路走到今天嗎？
Dialogue: 0,0:14:01.88,0:14:04.34,Default,,0,0,0,,不管是過去，或是血緣
Dialogue: 0,0:14:06.93,0:14:10.02,Default,,0,0,0,,都不是能夠輕易就拋諸腦後的
Dialogue: 0,0:14:11.35,0:14:12.94,Default,,0,0,0,,不管怎麼樣
Dialogue: 0,0:14:13.10,0:14:15.02,Default,,0,0,0,,這陣風太礙事了
Dialogue: 0,0:14:15.18,0:14:16.39,Default,,0,0,0,,糟了
Dialogue: 0,0:14:18.77,0:14:19.86,Default,,0,0,0,,打中啦
Dialogue: 0,0:14:19.94,0:14:22.53,Default,,0,0,0,,這就是我們跟鯨老闆的合作攻擊
Dialogue: 0,0:14:22.61,0:14:25.32,Default,,0,0,0,,看我們把所有考生通通固定住
Dialogue: 0,0:14:25.95,0:14:28.66,Default,,0,0,0,,糟糕，失去控制了
Dialogue: 0,0:14:30.24,0:14:31.99,Default,,0,0,0,,你們是自作自受
Dialogue: 0,0:14:41.17,0:14:44.17,Default,,0,0,0,,因為有點距離，效果也小了點
Dialogue: 0,0:14:44.26,0:14:46.55,Default,,0,0,0,,趁鯨老闆還在發超音波的時候
Dialogue: 0,0:14:46.63,0:14:48.80,Default,,0,0,0,,去解決那些避難的民眾吧
Dialogue: 0,0:14:48.89,0:14:49.81,Default,,0,0,0,,好耶
Dialogue: 0,0:14:49.89,0:14:51.27,Default,,0,0,0,,可惡
Dialogue: 0,0:14:51.68,0:14:53.52,Default,,0,0,0,,該死的
Dialogue: 0,0:14:54.18,0:14:57.06,Default,,0,0,0,,你們在搞什麼？
Dialogue: 0,0:14:57.73,0:14:59.27,Default,,0,0,0,,他說得沒錯
Dialogue: 0,0:15:00.44,0:15:01.90,Default,,0,0,0,,我竟然變成
Dialogue: 0,0:15:01.98,0:15:03.86,Default,,0,0,0,,自己最討厭的那種人
Dialogue: 0,0:15:03.94,0:15:05.65,Default,,0,0,0,,都是我的行為
Dialogue: 0,0:15:05.74,0:15:07.70,Default,,0,0,0,,導致現在這個後果
Dialogue: 0,0:15:08.24,0:15:09.37,Default,,0,0,0,,我得…
Dialogue: 0,0:15:09.45,0:15:11.58,Default,,0,0,0,,盡全力補救才行
Dialogue: 0,0:15:11.70,0:15:13.70,Default,,0,0,0,,糟糕，他們突破重圍
Dialogue: 0,0:15:13.78,0:15:15.32,Default,,0,0,0,,往這邊殺來了
Dialogue: 1,0:15:15.45,0:15:18.29,Default2,,0,0,0,,就目前的距離
Dialogue: 0,0:15:15.45,0:15:18.29,Default,,0,0,0,,不把他們擋在這裡就不妙了
Dialogue: 0,0:15:18.37,0:15:19.54,Default,,0,0,0,,你讓開
Dialogue: 0,0:15:22.46,0:15:23.79,Default,,0,0,0,,真堂學長
Dialogue: 0,0:15:23.88,0:15:25.97,Default,,0,0,0,,你不是因為超音波動彈不得嗎？
Dialogue: 0,0:15:26.21,0:15:29.63,Default,,0,0,0,,是啊，其實神經末梢還是有一點麻痹
Dialogue: 0,0:15:30.01,0:15:31.51,Default,,0,0,0,,音波也是種震動
Dialogue: 1,0:15:31.59,0:15:34.47,Default2,,0,0,0,,我的大腦可是每天
Dialogue: 0,0:15:31.59,0:15:34.47,Default,,0,0,0,,都因為自己個性的反作用力
Dialogue: 0,0:15:34.56,0:15:36.23,Default,,0,0,0,,晃個不停呢
Dialogue: 0,0:15:36.39,0:15:38.98,Default,,0,0,0,,所以對超音波多少有些抵抗力
Dialogue: 1,0:15:39.06,0:15:42.98,Default2,,0,0,0,,倒是，我本來想用這招騙過他
Dialogue: 0,0:15:39.06,0:15:42.98,Default,,0,0,0,,再伺機反擊
Dialogue: 0,0:15:43.06,0:15:45.44,Default,,0,0,0,,都怪那兩個一年級殺出來攪局
Dialogue: 0,0:15:45.53,0:15:46.99,Default,,0,0,0,,露出本性了
Dialogue: 0,0:15:47.07,0:15:48.70,Default,,0,0,0,,我已經擋住他們了
Dialogue: 0,0:15:48.78,0:15:50.41,Default,,0,0,0,,你快讓他們再也動不了
Dialogue: 0,0:15:50.49,0:15:53.45,Default,,0,0,0,,然後再分頭幫忙疏散其他的傷病患
Dialogue: 0,0:15:53.53,0:15:54.53,Default,,0,0,0,,是
Dialogue: 0,0:15:54.83,0:15:57.42,Default,,0,0,0,,好，解決用風的小子
Dialogue: 0,0:15:57.54,0:15:59.50,Default,,0,0,0,,我也該去那邊幫忙了
Dialogue: 0,0:16:01.04,0:16:02.92,Default,,0,0,0,,無謂地針鋒相對
Dialogue: 0,0:16:03.83,0:16:05.46,Default,,0,0,0,,完全合不來
Dialogue: 0,0:16:06.05,0:16:07.39,Default,,0,0,0,,還毫無默契
Dialogue: 0,0:16:08.09,0:16:09.30,Default,,0,0,0,,現在這樣
Dialogue: 0,0:16:09.59,0:16:11.97,Default,,0,0,0,,根本不可能是頂尖英雄的對手
Dialogue: 0,0:16:13.05,0:16:14.39,Default,,0,0,0,,如果你也跟我
Dialogue: 0,0:16:14.68,0:16:16.43,Default,,0,0,0,,有同樣想法的話
Dialogue: 0,0:16:17.06,0:16:19.27,Default,,0,0,0,,火的熱氣會讓風往上飄耶
Dialogue: 0,0:16:20.56,0:16:23.56,Default,,0,0,0,,就從下方把他抬起來
Dialogue: 0,0:16:23.77,0:16:26.27,Default,,0,0,0,,身體麻痹害我使不上力
Dialogue: 0,0:16:26.69,0:16:27.73,Default,,0,0,0,,但是
Dialogue: 0,0:16:27.90,0:16:29.61,Default,,0,0,0,,我非做不可
Dialogue: 1,0:16:36.08,0:16:37.92,Default2,,0,0,0,,-用火焰
Dialogue: 0,0:16:36.08,0:16:37.92,Default,,0,0,0,,-還有風
Dialogue: 0,0:16:37.99,0:16:39.53,Default,,0,0,0,,把他關起來
Dialogue: 0,0:16:44.33,0:16:46.75,Default,,0,0,0,,都動彈不得了還能發招
Dialogue: 0,0:16:47.13,0:16:49.76,Default,,0,0,0,,儘管威力跟精準度下降了不少
Dialogue: 0,0:16:50.05,0:16:52.85,Default,,0,0,0,,但這麼看來，麻痹的效果還不夠
Dialogue: 0,0:16:53.01,0:16:55.72,Default,,0,0,0,,看來他費盡心力在控制個性
Dialogue: 0,0:16:56.39,0:16:57.60,Default,,0,0,0,,另一方面
Dialogue: 0,0:16:57.85,0:16:59.94,Default,,0,0,0,,完全動彈不得的轟
Dialogue: 1,0:17:00.14,0:17:03.73,Default2,,0,0,0,,則是讓火焰加勢
Dialogue: 0,0:17:00.14,0:17:03.73,Default,,0,0,0,,趁此補足夜嵐的威力
Dialogue: 1,0:17:03.81,0:17:07.19,Default2,,0,0,0,,雖然你們之前愚蠢的行為
Dialogue: 0,0:17:03.81,0:17:07.19,Default,,0,0,0,,不可能一筆勾銷
Dialogue: 0,0:17:07.44,0:17:08.69,Default,,0,0,0,,但是…
Dialogue: 0,0:17:09.23,0:17:10.86,Default,,0,0,0,,挺有一手的嘛
Dialogue: 0,0:17:11.36,0:17:13.78,Default,,0,0,0,,正所謂“不打不相識”
Dialogue: 1,0:17:13.86,0:17:17.28,Default2,,0,0,0,,他們察覺到剛才的過錯
Dialogue: 0,0:17:13.86,0:17:17.28,Default,,0,0,0,,並拚了命地挽救
Dialogue: 0,0:17:17.49,0:17:20.62,Default,,0,0,0,,這種掙扎方式我還挺欣賞的
Dialogue: 0,0:17:20.70,0:17:21.99,Default,,0,0,0,,看後面
Dialogue: 0,0:17:22.08,0:17:24.46,Default,,0,0,0,,鯨老闆被困在火焰龍捲風裡面了
Dialogue: 0,0:17:24.54,0:17:25.58,Default,,0,0,0,,這樣不太妙吧
Dialogue: 0,0:17:25.67,0:17:28.59,Default,,0,0,0,,超像虎鯨的鯨老闆非常害怕乾燥
Dialogue: 0,0:17:28.67,0:17:31.21,Default,,0,0,0,,別管風了，大家先幫忙滅火
Dialogue: 0,0:17:32.26,0:17:33.26,Default,,0,0,0,,什麼？
Dialogue: 0,0:17:33.34,0:17:34.22,Default,,0,0,0,,轟
Dialogue: 0,0:17:34.43,0:17:35.85,Default,,0,0,0,,竟然左右同時發動
Dialogue: 0,0:17:36.76,0:17:38.80,Default,,0,0,0,,左右邊同時發動
Dialogue: 0,0:17:39.10,0:17:41.06,Default,,0,0,0,,看樣子練習得還不夠
Dialogue: 0,0:17:41.14,0:17:42.77,Default,,0,0,0,,動作有點遲鈍
Dialogue: 0,0:17:42.89,0:17:44.68,Default,,0,0,0,,反正都動不了了
Dialogue: 0,0:17:44.85,0:17:46.56,Default,,0,0,0,,有點遲鈍也沒差
Dialogue: 0,0:17:46.81,0:17:48.19,Default,,0,0,0,,要不要回去幫忙啊？
Dialogue: 0,0:17:48.27,0:17:49.27,Default,,0,0,0,,不，等等
Dialogue: 0,0:17:49.36,0:17:51.61,Default,,0,0,0,,爆碎風
Dialogue: 0,0:17:52.03,0:17:53.28,Default,,0,0,0,,順利壓制惡人
Dialogue: 0,0:17:53.36,0:17:54.49,Default,,0,0,0,,發射…
Dialogue: 0,0:17:55.99,0:17:57.20,Default,,0,0,0,,借我一下
Dialogue: 0,0:17:59.66,0:18:00.83,Default,,0,0,0,,尾白同學
Dialogue: 0,0:18:00.91,0:18:02.75,Default,,0,0,0,,傷員都已經疏散完畢
Dialogue: 0,0:18:02.83,0:18:05.25,Default,,0,0,0,,很快就會有人過來支援了
Dialogue: 0,0:18:07.21,0:18:09.84,Default,,0,0,0,,拯救在災區待命的HUC
Dialogue: 0,0:18:09.92,0:18:13.51,Default,,0,0,0,,只要再救出三個人就完成任務
Dialogue: 1,0:18:13.59,0:18:17.05,Default2,,0,0,0,,在救到所有人的那一刻
Dialogue: 0,0:18:13.59,0:18:17.05,Default,,0,0,0,,測驗就宣告結束
Dialogue: 0,0:18:17.13,0:18:20.13,Default,,0,0,0,,只差最後一步，加油喔
Dialogue: 0,0:18:22.01,0:18:24.22,Default,,0,0,0,,我就快能睡覺了
Dialogue: 0,0:18:25.85,0:18:27.14,Default,,0,0,0,,尾白，綠谷
Dialogue: 0,0:18:27.23,0:18:28.23,Default,,0,0,0,,我們來幫忙
Dialogue: 0,0:18:28.48,0:18:31.19,Default,,0,0,0,,同步掃射，把他們通通固定住
Dialogue: 0,0:18:33.90,0:18:34.90,Default,,0,0,0,,蛙吹…
Dialogue: 0,0:18:34.99,0:18:36.99,Default,,0,0,0,,梅雨，妳什麼時候在那裡的？
Dialogue: 0,0:18:37.07,0:18:38.61,Default,,0,0,0,,磨練青蛙的特性之後
Dialogue: 0,0:18:38.70,0:18:41.08,Default,,0,0,0,,這招總算能用在實戰上了
Dialogue: 0,0:18:41.20,0:18:43.70,Default,,0,0,0,,保護色，這是我的新招式
Dialogue: 0,0:18:43.79,0:18:44.79,Default,,0,0,0,,蛙吹
Dialogue: 0,0:18:44.87,0:18:47.08,Default,,0,0,0,,救助跟搜索行動都完成了嗎？
Dialogue: 0,0:18:47.16,0:18:48.33,Default,,0,0,0,,都差不多了
Dialogue: 0,0:18:49.00,0:18:50.09,Default,,0,0,0,,危險
Dialogue: 0,0:18:53.84,0:18:55.26,Default,,0,0,0,,士傑高中
Dialogue: 0,0:18:56.01,0:18:58.18,Default,,0,0,0,,我不是派稻佐過來了嗎？
Dialogue: 0,0:18:58.26,0:19:00.72,Default,,0,0,0,,沒想到居然還剩這麼多人
Dialogue: 0,0:19:01.18,0:19:03.64,Default,,0,0,0,,實在有辱士傑的名聲
Dialogue: 0,0:19:04.77,0:19:05.86,Default,,0,0,0,,好強啊
Dialogue: 0,0:19:06.60,0:19:07.98,Default,,0,0,0,,我們也追上去吧
Dialogue: 0,0:19:15.19,0:19:18.53,Default,,0,0,0,,火焰跟風交織的熱風牢籠啊
Dialogue: 0,0:19:18.61,0:19:20.03,Default,,0,0,0,,這點子真不錯
Dialogue: 0,0:19:20.41,0:19:22.79,Default,,0,0,0,,換作是普通惡人的話應該早就放棄
Dialogue: 0,0:19:22.87,0:19:24.91,Default,,0,0,0,,哭著跟你們求饒了吧？
Dialogue: 0,0:19:25.12,0:19:28.71,Default,,0,0,0,,不過，如果惡人沒有這麼做的話呢？
Dialogue: 1,0:19:28.79,0:19:33.00,Default2,,0,0,0,,在出招的同時
Dialogue: 0,0:19:28.79,0:19:33.00,Default,,0,0,0,,應該要想好下一步該怎麼走
Dialogue: 0,0:19:43.18,0:19:45.85,Default,,0,0,0,,所以，下一步呢？
Dialogue: 0,0:19:47.27,0:19:48.73,Default,,0,0,0,,沒招了
Dialogue: 0,0:19:52.44,0:19:54.48,Default,,0,0,0,,給我離他們兩個遠一點
Dialogue: 0,0:19:56.53,0:19:57.87,Default,,0,0,0,,綠谷
Dialogue: 0,0:19:59.70,0:20:02.87,Default,,0,0,0,,你這個人，為什麼每次都…
Dialogue: 0,0:20:06.58,0:20:08.87,Default,,0,0,0,,好的，就在剛剛那個瞬間
Dialogue: 0,0:20:09.12,0:20:11.41,Default,,0,0,0,,所有配置在場內的HUC
Dialogue: 0,0:20:11.50,0:20:14.09,Default,,0,0,0,,都被順利救出危險區域了
Dialogue: 0,0:20:14.63,0:20:15.46,Default,,0,0,0,,剛剛嗎？
Dialogue: 0,0:20:15.59,0:20:16.76,Default,,0,0,0,,是我們救的嗎？
Dialogue: 0,0:20:17.25,0:20:19.38,Default,,0,0,0,,雖然這麼做很獨斷獨行
Dialogue: 1,0:20:19.63,0:20:23.84,Default2,,0,0,0,,從此刻起
Dialogue: 0,0:20:19.63,0:20:23.84,Default,,0,0,0,,臨時證照測驗在此劃下句點了
Dialogue: 0,0:20:24.68,0:20:25.97,Default,,0,0,0,,結束了嗎？
Dialogue: 1,0:20:26.43,0:20:30.31,Default2,,0,0,0,,統計完分數之後
Dialogue: 0,0:20:26.43,0:20:30.31,Default,,0,0,0,,我們會當場發表考生及格與否
Dialogue: 0,0:20:30.60,0:20:32.73,Default,,0,0,0,,受傷的考生請到醫務室
Dialogue: 0,0:20:32.81,0:20:34.65,Default,,0,0,0,,其餘考生請換好衣物
Dialogue: 0,0:20:34.73,0:20:37.27,Default,,0,0,0,,暫時在場內待命
Dialogue: 0,0:20:37.73,0:20:39.52,Default,,0,0,0,,鯨老闆，非常抱歉
Dialogue: 0,0:20:39.61,0:20:41.49,Default,,0,0,0,,我們表現得不是很好
Dialogue: 1,0:20:41.78,0:20:45.33,Default2,,0,0,0,,看樣子，拘束用防護衣
Dialogue: 0,0:20:41.78,0:20:45.33,Default,,0,0,0,,讓您很不好行動呢
Dialogue: 0,0:20:45.83,0:20:49.12,Default,,0,0,0,,不，就算沒穿著防護衣
Dialogue: 0,0:20:49.50,0:20:52.63,Default,,0,0,0,,那招火焰龍捲風實在非常出色
Dialogue: 0,0:20:53.04,0:20:53.96,Default,,0,0,0,,而且
Dialogue: 1,0:20:54.04,0:20:57.17,Default2,,0,0,0,,在我因為乾燥受到傷害時
Dialogue: 0,0:20:54.04,0:20:57.17,Default,,0,0,0,,綠谷更發動了奇襲
Dialogue: 0,0:20:57.71,0:20:59.80,Default,,0,0,0,,要是測驗時間再長一點
Dialogue: 0,0:21:00.26,0:21:01.55,Default,,0,0,0,,說不定我就…
Dialogue: 0,0:21:07.47,0:21:08.39,Default,,0,0,0,,各位
Dialogue: 0,0:21:08.47,0:21:10.72,Default,,0,0,0,,熬過漫長的考試辛苦了
Dialogue: 0,0:21:10.89,0:21:13.27,Default,,0,0,0,,接下來就要公布結果了
Dialogue: 1,0:21:13.39,0:21:17.23,Default2,,0,0,0,,在那之前請讓我簡單說明一下
Dialogue: 0,0:21:13.39,0:21:17.23,Default,,0,0,0,,這次的計分方式
Dialogue: 1,0:21:17.31,0:21:21.15,Default2,,0,0,0,,由我們英雄公安委員會
Dialogue: 0,0:21:17.31,0:21:21.15,Default,,0,0,0,,跟HUC的專家們
Dialogue: 0,0:21:21.24,0:21:23.33,Default,,0,0,0,,採用雙重扣分的方式
Dialogue: 0,0:21:23.40,0:21:25.53,Default,,0,0,0,,來檢視各位考生的行動
Dialogue: 0,0:21:25.82,0:21:26.90,Default,,0,0,0,,換句話說
Dialogue: 0,0:21:27.03,0:21:29.58,Default,,0,0,0,,就是審查各位在危急的情況下
Dialogue: 0,0:21:29.66,0:21:32.75,Default,,0,0,0,,能做出多麼正確無誤的行動
Dialogue: 0,0:21:33.12,0:21:34.08,Default,,0,0,0,,總之呢
Dialogue: 1,0:21:34.16,0:21:38.29,Default2,,0,0,0,,接下來我們會將合格考生名單
Dialogue: 0,0:21:34.16,0:21:38.29,Default,,0,0,0,,公布在這個大屏幕上面
Dialogue: 1,0:21:38.38,0:21:42.18,Default2,,0,0,0,,請各位依據我剛才說的
Dialogue: 0,0:21:38.38,0:21:42.18,Default,,0,0,0,,自行確認看看吧
Dialogue: 0,0:21:44.26,0:21:45.14,Default,,0,0,0,,（緊張不已）
Dialogue: 0,0:21:45.22,0:21:48.06,Default,,0,0,0,,綠…
Comment: 0,0:23:35.25,0:23:36.25,Default,,0,0,0,,下集預告
Comment: 0,0:23:36.33,0:23:38.58,Default,,0,0,0,,在臨時證照測驗結束後的當天晚上
Comment: 0,0:23:38.67,0:23:41.38,Default,,0,0,0,,小勝突然把我叫了出去
Comment: 0,0:23:41.46,0:23:43.63,Default,,0,0,0,,他到底想跟我說什麼呢？
Comment: 0,0:23:43.76,0:23:46.35,Default,,0,0,0,,下一集，跟你的個性有關
Comment: 0,0:23:46.47,0:23:47.72,Default,,0,0,0,,更向前邁進吧
Comment: 0,0:23:47.80,0:23:49.18,Default,,0,0,0,,超越巔峰

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:01.74,0:01:04.16,Layzner,Simone,0,0,0,,军人的脑子真是用石头做的
Dialogue: 0,0:01:04.20,0:01:06.21,Layzner,Roanne,0,0,0,,快回答
Dialogue: 0,0:01:05.25,0:01:06.21,Layzner,David,0,0,0,,英二
Dialogue: 0,0:01:06.50,0:01:08.63,Layzner,Eiji,0,0,0,,命运不也让我们连在一起了吗
Dialogue: 0,0:01:08.63,0:01:10.25,Layzner,Carks,0,0,0,,大家 地球就拜托了
Dialogue: 0,0:01:43.08,0:01:45.29,Layzner,Elizabeth,0,0,0,,不 我们也一起去
Dialogue: 0,0:01:46.41,0:01:48.67,Layzner,Elizabeth,0,0,0,,亚瑟和西蒙尼也一起去
Dialogue: 0,0:01:48.73,0:01:50.17,Layzner,Eiji,0,0,0,,走吧 少佐
Dialogue: 0,0:01:52.71,0:01:54.88,Layzner,Anna,0,0,0,,再见了 红色的星球
Dialogue: 0,0:01:55.63,0:02:06.14,Layzner,Anna,0,0,0,,为了让大家知道地球迫在眉梢的危机 我们下定了决心
Dialogue: 0,0:01:55.63,0:02:06.14,Layzner,Anna,0,0,0,,为了活下去 为了回到地球 还有
Dialogue: 0,0:02:06.18,0:02:11.17,Layzner,Title,0,0,0,,第十三话 空虚的宇宙
Dialogue: 0,0:02:24.28,0:02:25.49,Layzner,Roanne,0,0,0,,全部好了
Dialogue: 0,0:02:26.04,0:02:27.62,Layzner,Eiji,0,0,0,,没问题
Dialogue: 0,0:02:28.29,0:02:30.21,Layzner,Eiji,0,0,0,,已经启动前往地球的轨道进程了
Dialogue: 0,0:02:30.58,0:02:33.21,Layzner,Eiji,0,0,0,,亚瑟 大卫 可以从SPT里出来了
Dialogue: 0,0:02:33.21,0:02:34.50,Layzner,David,0,0,0,,好 我知道了
Dialogue: 0,0:02:35.21,0:02:37.84,Layzner,Carks,0,0,0,,要快点联络上友军
Dialogue: 0,0:02:38.13,0:02:39.50,Layzner,Carks,0,0,0,,快找出他们的位置
Dialogue: 0,0:02:39.50,0:02:40.80,Layzner,Eiji,0,0,0,,我试试
Dialogue: 0,0:02:41.47,0:02:42.35,Layzner,Roanne,0,0,0,,少佐
Dialogue: 0,0:02:42.35,0:02:46.12,Layzner,Roanne,0,0,0,,真的能跟USA宇宙军舰队在这轨道上碰头吗
Dialogue: 0,0:02:46.50,0:02:47.72,Layzner,Carks,0,0,0,,应该可以的
Dialogue: 0,0:02:48.18,0:02:50.00,Layzner,Roanne,0,0,0,,可是雷达上什么都没有
Dialogue: 0,0:02:50.00,0:02:52.81,Layzner,Roanne,0,0,0,,对方有没有可能因为某种原因改变轨道呢
Dialogue: 0,0:02:52.81,0:02:54.31,Layzner,Carks,0,0,0,,不要乱作推测
Dialogue: 0,0:02:55.31,0:02:58.00,Layzner,Carks,0,0,0,,友军轨道在R9104
Dialogue: 0,0:02:58.00,0:03:00.36,Layzner,Carks,0,0,0,,确认好了 就快点跟他们联络
Dialogue: 0,0:03:00.68,0:03:01.99,Layzner,Eiji,0,0,0,,我试试
Dialogue: 0,0:03:02.87,0:03:06.29,Layzner,Arthur,0,0,0,,奇怪 这太空船也有人工重力啊
Dialogue: 0,0:03:06.79,0:03:08.83,Layzner,David,0,0,0,,喂 英二 情况如何
Dialogue: 0,0:03:08.83,0:03:10.50,Layzner,Elizabeth,0,0,0,,有什么我们可以帮得上忙的吗
Dialogue: 0,0:03:10.50,0:03:12.01,Layzner,Eiji,0,0,0,,没 我一个人就行了
Dialogue: 0,0:03:12.01,0:03:14.33,Layzner,Roanne,0,0,0,,其他交给电脑就好了对吧
Dialogue: 0,0:03:14.92,0:03:16.72,Layzner,Carks,0,0,0,,罗安 有你在就够了
Dialogue: 0,0:03:16.72,0:03:18.09,Layzner,Carks,0,0,0,,这里交给你了
Dialogue: 0,0:03:18.09,0:03:19.76,Layzner,Carks,0,0,0,,有回应就通知我
Dialogue: 0,0:03:19.76,0:03:20.84,Layzner,Carks,0,0,0,,来吧
Dialogue: 0,0:03:21.34,0:03:22.49,Layzner,Elizabeth,0,0,0,,你要对他干什么
Dialogue: 0,0:03:22.49,0:03:24.60,Layzner,Carks,0,0,0,,我只是要问他敌人的情报
Dialogue: 0,0:03:32.44,0:03:36.42,Layzner,Carks,0,0,0,,我不知道你们怎么想的 但他是敌人 不要忘了
Dialogue: 0,0:03:37.08,0:03:38.46,Layzner,Carks,0,0,0,,知道了吗
Dialogue: 0,0:03:48.66,0:03:50.95,Layzner,Off,0,0,0,,成功脱离第四行星的重力圈
Dialogue: 0,0:03:50.95,0:03:53.08,Layzner,Off,0,0,0,,修正轨道往第三行星
Dialogue: 0,0:03:54.29,0:03:56.92,Layzner,Off2,0,0,0,,已确认在追踪中航天飞机的位置
Dialogue: 0,0:03:56.92,0:03:58.00,Layzner,Gale,0,0,0,,能赶上他们吗
Dialogue: 0,0:03:58.50,0:04:02.51,Layzner,Off2,0,0,0,,等一下 有舰队极速接近该航天飞机
Dialogue: 0,0:04:02.67,0:04:03.57,Layzner,Gale,0,0,0,,有几艘
Dialogue: 0,0:04:03.57,0:04:04.55,Layzner,Off2,0,0,0,,三艘
Dialogue: 0,0:04:05.89,0:04:09.41,Layzner,Gale,0,0,0,,是古雷斯库说的地球舰队吗
Dialogue: 0,0:04:09.41,0:04:10.27,Layzner,Gale,0,0,0,,距离呢
Dialogue: 0,0:04:10.27,0:04:12.14,Layzner,Off2,0,0,0,,2.02 方位不变
Dialogue: 0,0:04:12.48,0:04:16.10,Layzner,,0,0,0,,这样下去 在碰到航天飞机前会先跟该舰队遭遇
Dialogue: 0,0:04:16.10,0:04:17.15,Layzner,Gale,0,0,0,,时间呢
Dialogue: 0,0:04:17.15,0:04:19.73,Layzner,Off,0,0,0,,32 误差0.30
Dialogue: 0,0:04:19.73,0:04:20.65,Layzner,Gale,0,0,0,,好
Dialogue: 0,0:04:20.65,0:04:23.03,Layzner,Gale,0,0,0,,一遇到对方我们就先攻击
Dialogue: 0,0:04:23.70,0:04:24.91,Layzner,Gale,0,0,0,,准备第一波攻击
Dialogue: 0,0:04:27.99,0:04:30.83,Layzner,Carks,0,0,0,,前往地球的舰队的规模
Dialogue: 0,0:04:30.83,0:04:32.91,Layzner,Carks,0,0,0,,还有他们拥有多少机动兵器
Dialogue: 0,0:04:32.91,0:04:35.54,Layzner,Eiji,0,0,0,,我是来告知地球的危机
Dialogue: 0,0:04:35.54,0:04:38.17,Layzner,Eiji,0,0,0,,不是来告诉你古拉特斯星的战力
Dialogue: 0,0:04:38.79,0:04:40.46,Layzner,Carks,0,0,0,,你只要回答我的问题
Dialogue: 0,0:04:40.46,0:04:41.92,Layzner,Elizabeth,0,0,0,,他不是间谍
Dialogue: 0,0:04:41.92,0:04:44.17,Layzner,Carks,0,0,0,,我没有在问你
Dialogue: 0,0:04:46.34,0:04:48.35,Layzner,Roanne,0,0,0,,知道USA宇宙军的位置了
Dialogue: 0,0:04:49.18,0:04:50.35,Layzner,Roanne,0,0,0,,出现在雷达上了
Dialogue: 0,0:04:50.35,0:04:50.93,Layzner,Carks,0,0,0,,好
Dialogue: 0,0:04:50.93,0:04:53.27,Layzner,Roanne,0,0,0,,如少佐所说 在同一个轨道上
Dialogue: 0,0:04:55.27,0:04:56.46,Layzner,Carks,0,0,0,,这样就行了吗
Dialogue: 0,0:04:56.46,0:04:57.94,Layzner,Roanne,0,0,0,,我想这样就能说话了
Dialogue: 0,0:04:59.36,0:05:03.94,Layzner,Carks,0,0,0,,我是USA宇宙部队的运输舰阿斯洛托法克二号的舰长
Dialogue: 0,0:05:03.94,0:05:05.74,Layzner,Carks,0,0,0,,卡克斯·丹尼少佐
Dialogue: 0,0:05:06.11,0:05:08.41,Layzner,Carks,0,0,0,,我的识别编号是2010493
Dialogue: 0,0:05:08.41,0:05:09.49,Layzner,Carks,0,0,0,,请回答
Dialogue: 0,0:05:09.49,0:05:12.33,Layzner,Carks,0,0,0,,我是USA宇宙军的丹尼少佐
Dialogue: 0,0:05:12.33,0:05:13.50,Layzner,Carks,0,0,0,,请回答
Dialogue: 0,0:05:15.04,0:05:17.76,Layzner,Off1,0,0,0,,听得很清楚 这里是庞迪克 请说
Dialogue: 0,0:05:18.29,0:05:20.15,Layzner,Carks,0,0,0,,我想直接跟舰长说话
Dialogue: 0,0:05:20.15,0:05:21.38,Layzner,Carks,0,0,0,,有要紧的事情
Dialogue: 0,0:05:21.38,0:05:22.42,Layzner,,0,0,0,,麻烦你
Dialogue: 0,0:05:22.71,0:05:23.80,Layzner,Off1,0,0,0,,知道了
Dialogue: 0,0:05:23.80,0:05:25.34,Layzner,Off1,0,0,0,,我帮你转梅洛大佐
Dialogue: 0,0:05:25.34,0:05:26.63,Layzner,Off1,0,0,0,,请等一下
Dialogue: 0,0:05:27.45,0:05:29.18,Layzner,Arthur,0,0,0,,我们会得救吧
Dialogue: 0,0:05:29.93,0:05:30.97,Layzner,Willow,0,0,0,,我是梅洛
Dialogue: 0,0:05:30.97,0:05:34.19,Layzner,Carks,0,0,0,,大佐 请快回收我们并改变航道
Dialogue: 0,0:05:35.10,0:05:39.41,Layzner,Willow,0,0,0,,你去好久了 你去火星怎么了
Dialogue: 0,0:05:39.41,0:05:41.19,Layzner,Carks,0,0,0,,那里很危险
Dialogue: 0,0:05:41.19,0:05:44.28,Layzner,Willow,0,0,0,,我不懂你在说什么 到底怎么了
Dialogue: 0,0:05:44.28,0:05:48.11,Layzner,Carks,0,0,0,,我军和苏联军的基地都被毁了
Dialogue: 0,0:05:48.11,0:05:50.03,Layzner,Carks,0,0,0,,我亲眼看到的
Dialogue: 0,0:05:50.03,0:05:51.91,Layzner,Willow,0,0,0,,你说都毁了 怎么可能
Dialogue: 0,0:05:51.91,0:05:55.08,Layzner,Carks,0,0,0,,因为外星人的介入两基地都被毁了
Dialogue: 0,0:05:56.20,0:05:57.54,Layzner,Willow,0,0,0,,你刚才说什么
Dialogue: 0,0:05:58.12,0:06:02.13,Layzner,Carks,0,0,0,,我知道很难相信 但真的有外星人
Dialogue: 0,0:06:02.75,0:06:04.13,Layzner,Willow,0,0,0,,怎么可能
Dialogue: 0,0:06:04.71,0:06:07.25,Layzner,Carks,0,0,0,,敌人的机动兵器非常可怕
Dialogue: 0,0:06:07.25,0:06:10.14,Layzner,Carks,0,0,0,,大佐 如果你们去火星的话很鲁莽的
Dialogue: 0,0:06:10.14,0:06:13.60,Layzner,Willow,0,0,0,,不过我们不可能改变航路的
Dialogue: 0,0:06:10.14,0:06:13.60,Layzner,Willow,0,0,0,,少佐 难得你们联络上我们
Dialogue: 0,0:06:15.19,0:06:20.03,Layzner,Willow,0,0,0,,我们的任务 是去调查失去联络的火星基地
Dialogue: 0,0:06:20.03,0:06:22.23,Layzner,Willow,0,0,0,,跟你们运输部队不同
Dialogue: 0,0:06:22.23,0:06:26.19,Layzner,Carks,0,0,0,,大佐 相信我 外星人真的要来攻击我们了
Dialogue: 0,0:06:26.19,0:06:30.45,Layzner,Carks,0,0,0,,现在我跟地球的平民坐外星人的太空船逃了出来
Dialogue: 0,0:06:31.41,0:06:33.37,Layzner,Willow,0,0,0,,通信就到此为止了
Dialogue: 0,0:06:33.66,0:06:39.26,Layzner,Willow,0,0,0,,我想你是不是被苏联军施以暴力呢
Dialogue: 0,0:06:39.26,0:06:41.10,Layzner,Carks,0,0,0,,你的意思是我是间谍吗 大佐
Dialogue: 0,0:06:41.88,0:06:46.17,Layzner,Willow,0,0,0,,很可惜 我们没时间确认
Dialogue: 0,0:06:46.17,0:06:47.05,Layzner,Carks,0,0,0,,你不相信我是吗
Dialogue: 0,0:06:48.01,0:06:49.84,Layzner,Willow,0,0,0,,我会跟总部报告的
Dialogue: 0,0:06:49.84,0:06:51.01,Layzner,Carks,0,0,0,,大佐 拜托你
Dialogue: 0,0:06:51.01,0:06:54.65,Layzner,Nero,0,0,0,,除了司令部的命令外我们是不能改变航道的
Dialogue: 0,0:06:54.65,0:06:55.60,Layzner,Nero,0,0,0,,就这样
Dialogue: 0,0:06:56.01,0:06:56.81,Layzner,Carks,0,0,0,,大佐
Dialogue: 0,0:06:56.81,0:06:57.69,Layzner,Carks,0,0,0,,大佐
Dialogue: 0,0:06:59.80,0:07:00.98,Layzner,Roanne,0,0,0,,他挂掉了
Dialogue: 0,0:07:03.02,0:07:04.06,Layzner,Elizabeth,0,0,0,,为什么会这样
Dialogue: 0,0:07:04.15,0:07:08.15,Layzner,Elizabeth,0,0,0,,跟你联络的是美军对吧
Dialogue: 0,0:07:08.61,0:07:09.90,Layzner,Elizabeth,0,0,0,,为什么他们不相信你呢
Dialogue: 0,0:07:12.16,0:07:13.86,Layzner,Arthur,0,0,0,,我们会怎么样
Dialogue: 0,0:07:14.02,0:07:16.62,Layzner,Roanne,0,0,0,,还没有敌人舰队的踪迹
Dialogue: 0,0:07:16.62,0:07:19.87,Layzner,Roanne,0,0,0,,这样下去我们会跟美军错过的
Dialogue: 0,0:07:34.01,0:07:37.89,Layzner,Off1,0,0,0,,坐标243处确定有三艘敌人的巡洋战舰
Dialogue: 0,0:07:37.89,0:07:43.06,Layzner,Off1,0,0,0,,照原定轨道在08.20误差0.05会遭遇到
Dialogue: 0,0:07:43.06,0:07:44.73,Layzner,Gale,0,0,0,,好 准备攻击
Dialogue: 0,0:07:45.27,0:07:46.82,Layzner,Gale,0,0,0,,准备我的黑色凯萨
Dialogue: 0,0:07:47.52,0:07:48.99,Layzner,Gale,0,0,0,,我也要出击
Dialogue: 0,0:07:48.99,0:07:49.36,Layzner,Off,0,0,0,,是
Dialogue: 0,0:07:54.36,0:07:55.49,Layzner,Carks,0,0,0,,你要干嘛
Dialogue: 0,0:07:55.87,0:07:58.24,Layzner,Eiji,0,0,0,,说不定可以发出信号
Dialogue: 0,0:07:58.50,0:08:01.00,Layzner,Eiji,0,0,0,,帮我调成可以闪红灯
Dialogue: 0,0:08:01.37,0:08:02.83,Layzner,Eiji,0,0,0,,约在4700处
Dialogue: 0,0:08:02.83,0:08:03.67,Layzner,Roanne,0,0,0,,我知道了
Dialogue: 0,0:08:07.63,0:08:10.59,Layzner,Off,0,0,0,,大佐 不明部队接近中
Dialogue: 0,0:08:10.59,0:08:11.63,Layzner,Carks,0,0,0,,把声音调大
Dialogue: 0,0:08:11.63,0:08:15.39,Layzner,Off,0,0,0,,身份不明 要改变航道吗
Dialogue: 0,0:08:15.39,0:08:17.51,Layzner,Willow,0,0,0,,我也不知道怎么回事 先看着办吧
Dialogue: 0,0:08:17.51,0:08:19.14,Layzner,David,0,0,0,,是刚才的大佐的声音
Dialogue: 0,0:08:19.14,0:08:19.93,Layzner,Carks,0,0,0,,大佐
Dialogue: 0,0:08:19.93,0:08:20.85,Layzner,Carks,0,0,0,,梅洛大佐
Dialogue: 0,0:08:20.85,0:08:21.89,Layzner,Carks,0,0,0,,请回答
Dialogue: 0,0:08:21.89,0:08:22.77,Layzner,Willow,0,0,0,,那是什么
Dialogue: 0,0:08:22.77,0:08:23.89,Layzner,Off,0,0,0,,是新兵器吗
Dialogue: 0,0:08:23.89,0:08:25.48,Layzner,Off2,0,0,0,,有五架
Dialogue: 0,0:08:25.48,0:08:27.44,Layzner,Off3,0,0,0,,大佐 刚才回报不是有说吗
Dialogue: 0,0:08:27.44,0:08:30.24,Layzner,Willow,0,0,0,,笨蛋 你是说那是外星人的机动兵器吗
Dialogue: 0,0:08:30.24,0:08:31.40,Layzner,Off2,0,0,0,,接近中
Dialogue: 0,0:08:31.40,0:08:33.40,Layzner,Willow,0,0,0,,为了以防万一进入战斗位置
Dialogue: 0,0:08:35.95,0:08:38.70,Layzner,Carks,0,0,0,,大佐 不要战斗 快逃啊
Dialogue: 0,0:08:41.11,0:08:43.71,Layzner,Anna,0,0,0,,救人啊 去救他们啊
Dialogue: 0,0:08:43.71,0:08:44.58,Layzner,Roanne,0,0,0,,没用的
Dialogue: 0,0:08:45.45,0:08:48.42,Layzner,Roanne,0,0,0,,我们的太空船没回航的燃料了
Dialogue: 0,0:08:50.35,0:08:53.88,Layzner,Willow,0,0,0,,引擎被摧毁了 快射
Dialogue: 0,0:08:53.88,0:08:55.80,Layzner,Off,0,0,0,,大佐 快逃吧
Dialogue: 0,0:09:01.58,0:09:03.39,Layzner,Roanne,0,0,0,,从雷达上消失了
Dialogue: 0,0:09:04.08,0:09:05.31,Layzner,Roanne,0,0,0,,三艘都
Dialogue: 0,0:09:05.31,0:09:07.52,Layzner,Arthur,0,0,0,,大家都被消灭了
Dialogue: 0,0:09:09.56,0:09:11.57,Layzner,David,0,0,0,,不快一点的话接下来就换我们了
Dialogue: 0,0:09:11.57,0:09:12.65,Layzner,Eiji,0,0,0,,请让开
Dialogue: 0,0:09:17.02,0:09:18.00,Layzner,Elizabeth,0,0,0,,他们真笨
Dialogue: 0,0:09:18.93,0:09:23.59,Layzner,Elizabeth,0,0,0,,如果他们相信我们的话就不会增加无谓的牺牲者了
Dialogue: 0,0:09:24.37,0:09:25.91,Layzner,Simone,0,0,0,,他们跟我们不一样
Dialogue: 0,0:09:27.23,0:09:29.88,Layzner,Simone,0,0,0,,军人的脑子真是石头做的
Dialogue: 0,0:09:31.35,0:09:34.36,Layzner,Carks,0,0,0,,刚才的战斗的信息我军应该也接收到了
Dialogue: 0,0:09:34.36,0:09:35.56,Layzner,Carks,0,0,0,,不用担心
Dialogue: 0,0:09:36.29,0:09:38.80,Layzner,Carks,0,0,0,,马上就会跟来调查的部队碰头了
Dialogue: 0,0:09:39.80,0:09:40.97,Layzner,Arthur,0,0,0,,如果没有的话呢
Dialogue: 0,0:09:41.26,0:09:42.99,Layzner,Carks,0,0,0,,乖乖听我的就对了
Dialogue: 0,0:09:55.70,0:09:56.99,Layzner,Callea,0,0,0,,作战完毕
Dialogue: 0,0:09:56.99,0:09:58.60,Layzner,Gale,0,0,0,,去追航天飞机
Dialogue: 0,0:09:57.80,0:09:58.60,Layzner,Callea,0,0,0,,了解
Dialogue: 0,0:09:59.01,0:10:00.03,Layzner,Roanne,0,0,0,,不行
Dialogue: 0,0:10:00.62,0:10:02.58,Layzner,Roanne,0,0,0,,都没有地球的船
Dialogue: 0,0:10:02.58,0:10:03.74,Layzner,Eiji,0,0,0,,不要灰心
Dialogue: 0,0:10:04.18,0:10:05.62,Layzner,David,0,0,0,,我们这边单独呼叫看看
Dialogue: 0,0:10:05.62,0:10:06.87,Layzner,David,0,0,0,,说不定有人会收到
Dialogue: 0,0:10:06.87,0:10:07.87,Layzner,Roanne,0,0,0,,没用的
Dialogue: 0,0:10:07.87,0:10:10.08,Layzner,Roanne,0,0,0,,雷达上什么都没有
Dialogue: 0,0:10:10.35,0:10:12.97,Layzner,Elizabeth,0,0,0,,没事的
Dialogue: 0,0:10:12.97,0:10:14.78,Layzner,Elizabeth,0,0,0,,都活到现在了
Dialogue: 0,0:10:17.34,0:10:18.51,Layzner,Carks,0,0,0,,USA宇宙部队
Dialogue: 0,0:10:18.51,0:10:19.50,Layzner,Carks,0,0,0,,请回答
Dialogue: 0,0:10:19.50,0:10:20.80,Layzner,Carks,0,0,0,,USA宇宙部队
Dialogue: 0,0:10:20.80,0:10:22.89,Layzner,Arthur,0,0,0,,没用的
Dialogue: 0,0:10:22.89,0:10:24.14,Layzner,Arthur,0,0,0,,我好累哦
Dialogue: 0,0:10:24.14,0:10:25.14,Layzner,Carks,0,0,0,,给我闭嘴
Dialogue: 0,0:10:27.54,0:10:30.10,Layzner,Carks,0,0,0,,USA宇宙部队请回答
Dialogue: 0,0:10:30.10,0:10:31.44,Layzner,Carks,0,0,0,,USA宇宙部队
Dialogue: 0,0:10:32.89,0:10:35.04,Layzner,Arthur,0,0,0,,为什么只有我们要遭受这种待遇
Dialogue: 0,0:10:35.68,0:10:38.53,Layzner,Carks,0,0,0,,USA宇宙部队 请回答
Dialogue: 0,0:10:44.09,0:10:45.30,Layzner,Roanne,0,0,0,,雷达上有东西
Dialogue: 0,0:10:45.30,0:10:45.79,Layzner,Carks,0,0,0,,什么
Dialogue: 0,0:10:46.18,0:10:48.18,Layzner,Roanne,0,0,0,,好像不是敌人
Dialogue: 0,0:10:48.18,0:10:51.54,Layzner,Carks,0,0,0,,这里是USA宇宙部队的丹尼少佐
Dialogue: 0,0:10:51.54,0:10:52.58,Layzner,Carks,0,0,0,,回答
Dialogue: 0,0:10:52.58,0:10:56.00,Layzner,Carks,0,0,0,,我们目前的位置在24382614
Dialogue: 0,0:10:56.00,0:10:56.98,Layzner,Carks,0,0,0,,请求救援
Dialogue: 0,0:10:56.98,0:10:58.26,Layzner,Carks,0,0,0,,请回答
Dialogue: 0,0:10:58.26,0:10:59.47,Layzner,Carks,0,0,0,,请求救援
Dialogue: 0,0:11:00.43,0:11:02.05,Layzner,Roanne,0,0,0,,为什么不回答我们
Dialogue: 0,0:11:02.05,0:11:05.72,Layzner,Eiji,0,0,0,,雷达显示的推测位置明明就非常近的
Dialogue: 0,0:11:05.99,0:11:08.58,Layzner,David,0,0,0,,英二 通信频道没搞错吗
Dialogue: 0,0:11:08.58,0:11:09.48,Layzner,Eiji,0,0,0,,没错
Dialogue: 0,0:11:10.33,0:11:11.85,Layzner,Arthur,0,0,0,,是苏联军舰吗
Dialogue: 0,0:11:12.77,0:11:14.61,Layzner,Arthur,0,0,0,,对了 一定是苏联军
Dialogue: 0,0:11:14.61,0:11:16.63,Layzner,Arthur,0,0,0,,所以才没回我们
Dialogue: 0,0:11:16.63,0:11:18.65,Layzner,David,0,0,0,,的确这样的话是说的通
Dialogue: 0,0:11:18.65,0:11:21.99,Layzner,Roanne,0,0,0,,不知道苏联军的通信频道吗
Dialogue: 0,0:11:23.28,0:11:24.99,Layzner,David,0,0,0,,试试各种频道
Dialogue: 0,0:11:25.55,0:11:28.37,Layzner,Carks,0,0,0,,苏联军也是来救援的
Dialogue: 0,0:11:28.67,0:11:30.78,Layzner,Carks,0,0,0,,因此才会到这里
Dialogue: 0,0:11:31.25,0:11:32.92,Layzner,Simone,0,0,0,,那就请继续联络
Dialogue: 0,0:11:32.92,0:11:35.17,Layzner,Simone,0,0,0,,请继续联络他们请求救援
Dialogue: 0,0:11:36.09,0:11:36.96,Layzner,Roanne,0,0,0,,少佐
Dialogue: 0,0:11:38.17,0:11:40.20,Layzner,Elizabeth,0,0,0,,这时候已经没有选择了
Dialogue: 0,0:11:40.20,0:11:41.59,Layzner,Elizabeth,0,0,0,,换我来吧
Dialogue: 0,0:11:41.59,0:11:43.39,Layzner,Carks,0,0,0,,不 我来
Dialogue: 0,0:11:43.74,0:11:46.65,Layzner,Carks,0,0,0,,这样下去苏联军会被干掉的
Dialogue: 0,0:11:46.65,0:11:49.73,Layzner,Carks,0,0,0,,这里是USA宇宙部队丹尼少佐
Dialogue: 0,0:11:50.14,0:11:54.01,Layzner,Carks,0,0,0,,根据国际宇宙救助法请求救援
Dialogue: 0,0:11:54.01,0:11:57.86,Layzner,Carks,0,0,0,,接下来要不要听我的话由贵舰自行决定
Dialogue: 0,0:11:58.73,0:12:02.53,Layzner,Carks,0,0,0,,再往火星去的话对你们来说是非常危险的
Dialogue: 0,0:12:03.03,0:12:04.86,Layzner,Carks,0,0,0,,火星因为外星人的介入
Dialogue: 0,0:12:04.86,0:12:08.54,Layzner,Carks,0,0,0,,不只是我军 连你们的基地也被毁了
Dialogue: 0,0:12:09.12,0:12:12.27,Layzner,Carks,0,0,0,,我们是坐外星人的太空船逃出来的
Dialogue: 0,0:12:12.27,0:12:17.13,Layzner,Carks,0,0,0,,刚才不听我警告的友军部队已被外星人消灭
Dialogue: 0,0:12:17.71,0:12:19.85,Layzner,Carks,0,0,0,,真的有外星人
Dialogue: 0,0:12:19.85,0:12:23.97,Layzner,Carks,0,0,0,,现在我坐的船上有一名古拉特斯星人的俘虏
Dialogue: 0,0:12:24.59,0:12:26.24,Layzner,Carks,0,0,0,,我们要求救援
Dialogue: 0,0:12:26.24,0:12:27.68,Layzner,Carks,0,0,0,,请回答
Dialogue: 0,0:12:38.73,0:12:39.94,Layzner,Carks,0,0,0,,请回答
Dialogue: 0,0:12:39.94,0:12:41.70,Layzner,Carks,0,0,0,,你们一定有听到的 请回答
Dialogue: 0,0:12:42.24,0:12:43.61,Layzner,Roanne,0,0,0,,又是一样的结果
Dialogue: 0,0:12:44.20,0:12:46.07,Layzner,David,0,0,0,,军人都一样
Dialogue: 0,0:12:46.07,0:12:48.74,Layzner,Arthur,0,0,0,,国际宇宙救助法是做什么的
Dialogue: 0,0:12:48.74,0:12:52.02,Layzner,Arthur,0,0,0,,那不是以美苏为中心所订的国际法吗
Dialogue: 0,0:12:52.02,0:12:53.91,Layzner,Carks,0,0,0,,给我安静一点
Dialogue: 0,0:12:54.31,0:12:58.79,Layzner,Carks,0,0,0,,再警告一次 请回头 快点改变航道
Dialogue: 0,0:12:59.38,0:13:03.21,Layzner,Carks,0,0,0,,外星人为了要征服地球 先镇压了火星
Dialogue: 0,0:13:03.21,0:13:05.63,Layzner,Carks,0,0,0,,详情等你们救了我们 我会详细说明的
Dialogue: 0,0:13:06.01,0:13:08.55,Layzner,Carks,0,0,0,,期待你们贵舰舰长英明的决定
Dialogue: 0,0:13:09.08,0:13:12.60,Layzner,Off,0,0,0,,如那太空船报告中所说有不明舰队接近中
Dialogue: 0,0:13:13.14,0:13:13.84,Layzner,Man,0,0,0,,大佐
Dialogue: 0,0:13:15.56,0:13:16.56,Layzner,Com,0,0,0,,我也不知道怎么办才好
Dialogue: 0,0:13:17.51,0:13:18.21,Layzner,Com,0,0,0,,好
Dialogue: 0,0:13:18.56,0:13:21.98,Layzner,Carks,0,0,0,,请回头 要不至少救救地球的平民
Dialogue: 0,0:13:22.69,0:13:25.57,Layzner,Off,0,0,0,,这里是苏联太空部队第二舰队
Dialogue: 0,0:13:25.57,0:13:27.61,Layzner,Off,0,0,0,,我们接受你们的请求
Dialogue: 0,0:13:28.74,0:13:30.70,Layzner,Off,0,0,0,,接下来告诉你们停船的方法
Dialogue: 0,0:13:30.70,0:13:31.58,Layzner,Carks,0,0,0,,麻烦你
Dialogue: 0,0:13:31.58,0:13:38.71,Layzner,Off,0,0,0,,贵舰维持原来速度把航道改到3446-3548处
Dialogue: 0,0:13:38.92,0:13:41.88,Layzner,Off,0,0,0,,接下来再等候我们的引导通知
Dialogue: 0,0:13:41.88,0:13:42.55,Layzner,Roanne,0,0,0,,太好了
Dialogue: 0,0:13:43.17,0:13:44.67,Layzner,David,0,0,0,,得救了
Dialogue: 0,0:13:44.90,0:13:46.38,Layzner,Simone,0,0,0,,得救了 安娜
Dialogue: 0,0:13:46.42,0:13:48.05,Layzner,Arthur,0,0,0,,太好了 可以回地球了
Dialogue: 0,0:13:48.05,0:13:50.18,Layzner,Arthur,0,0,0,,太好了 我们能回地球了
Dialogue: 0,0:13:50.18,0:13:52.83,Layzner,,0,0,0,,我们能回地球了
Dialogue: 0,0:13:52.95,0:13:53.64,Layzner,David,0,0,0,,少佐
Dialogue: 0,0:13:54.51,0:13:56.17,Layzner,David,0,0,0,,要把英二交给他们吗
Dialogue: 0,0:13:59.40,0:14:01.23,Layzner,Carks,0,0,0,,没错
Dialogue: 0,0:14:01.98,0:14:03.72,Layzner,Carks,0,0,0,,军队就是这样
Dialogue: 0,0:14:03.72,0:14:06.20,Layzner,David,0,0,0,,要让他变成苏联军的俘虏是吗
Dialogue: 0,0:14:06.95,0:14:07.68,Layzner,Carks,0,0,0,,是的
Dialogue: 0,0:14:07.82,0:14:10.66,Layzner,Simone,0,0,0,,为什么 他做了什么
Dialogue: 0,0:14:10.66,0:14:12.41,Layzner,Arthur,0,0,0,,把他当俘虏太过分了
Dialogue: 0,0:14:12.41,0:14:14.66,Layzner,Eiji,0,0,0,,大家 不用担心我
Dialogue: 0,0:14:17.33,0:14:21.13,Layzner,Eiji,0,0,0,,我会来 就是为了通知地球迫近的危机
Dialogue: 0,0:14:21.21,0:14:24.27,Layzner,Eiji,0,0,0,,只要能成功的话当哪边的俘虏都行
Dialogue: 0,0:14:57.50,0:14:59.16,Layzner,Chefrengrev,0,0,0,,我是舰长基夫连科
Dialogue: 0,0:14:59.16,0:15:00.71,Layzner,Carks,0,0,0,,我是卡克斯·丹尼少佐
Dialogue: 0,0:15:01.44,0:15:03.50,Layzner,Carks,0,0,0,,感谢舰长英明的决定
Dialogue: 0,0:15:03.88,0:15:05.63,Layzner,Chef,0,0,0,,不 这是应该的
Dialogue: 0,0:15:06.23,0:15:09.25,Layzner,Chef,0,0,0,,对了 你说外星人是
Dialogue: 0,0:15:09.25,0:15:10.26,Layzner,Carks,0,0,0,,就是他
Dialogue: 0,0:15:10.55,0:15:12.14,Layzner,Chef,0,0,0,,不会吧
Dialogue: 0,0:15:18.79,0:15:20.64,Layzner,David,0,0,0,,等一下 要把英二怎么样
Dialogue: 0,0:15:20.64,0:15:21.60,Layzner,Simone,0,0,0,,你们想干嘛
Dialogue: 0,0:15:21.60,0:15:22.35,Layzner,Arthur,0,0,0,,少佐
Dialogue: 0,0:15:22.35,0:15:23.35,Layzner,Roanne,0,0,0,,不要去 英二
Dialogue: 0,0:15:23.35,0:15:24.94,Layzner,Elizabeth,0,0,0,,请叫丹尼少佐来
Dialogue: 0,0:15:24.94,0:15:26.65,Layzner,Soldier,0,0,0,,他现在在跟舰长说话
Dialogue: 0,0:15:26.65,0:15:27.23,Layzner,David,0,0,0,,英二
Dialogue: 0,0:15:27.23,0:15:28.03,Layzner,Anna,0,0,0,,不要
Dialogue: 0,0:15:28.03,0:15:28.82,Layzner,Roanne,0,0,0,,英二
Dialogue: 0,0:15:38.45,0:15:39.75,Layzner,David,0,0,0,,英二
Dialogue: 0,0:15:40.12,0:15:42.00,Layzner,Chef,0,0,0,,你说的我大概了解了
Dialogue: 0,0:15:42.50,0:15:44.92,Layzner,Chef,0,0,0,,如果是真的话就不好了
Dialogue: 0,0:15:44.92,0:15:46.54,Layzner,Chef,0,0,0,,谢谢你告诉我
Dialogue: 0,0:15:46.75,0:15:48.88,Layzner,Carks,0,0,0,,这是地球的危机
Dialogue: 0,0:15:48.88,0:15:52.22,Layzner,Carks,0,0,0,,请快把这事通知地球并尽快想出对策
Dialogue: 0,0:15:56.93,0:15:58.51,Layzner,Off,0,0,0,,喂
Dialogue: 0,0:15:58.51,0:15:59.47,Layzner,Off,0,0,0,,什么
Dialogue: 0,0:15:59.47,0:16:01.89,Layzner,Off,0,0,0,,不明国籍的机动部队接近中
Dialogue: 0,0:16:01.89,0:16:02.85,Layzner,Carks,0,0,0,,是他们
Dialogue: 0,0:16:04.46,0:16:05.74,Layzner,Chef,0,0,0,,知道了什么吗
Dialogue: 0,0:16:05.74,0:16:07.44,Layzner,Off,0,0,0,,对方身份不明
Dialogue: 0,0:16:07.44,0:16:08.57,Layzner,Off,0,0,0,,距离600
Dialogue: 0,0:16:08.57,0:16:09.98,Layzner,Off,0,0,0,,再两分钟后遭遇
Dialogue: 0,0:16:09.98,0:16:11.90,Layzner,Carks,0,0,0,,没错 是他们
Dialogue: 0,0:16:11.90,0:16:12.57,Layzner,Off1,0,0,0,,大佐
Dialogue: 0,0:16:13.36,0:16:15.43,Layzner,Chef,0,0,0,,全员进入战斗状态
Dialogue: 0,0:16:15.20,0:16:15.43,Layzner,,0,0,0,,是
Dialogue: 0,0:16:15.87,0:16:17.28,Layzner,Carks,0,0,0,,请回避战斗
Dialogue: 0,0:16:17.28,0:16:19.70,Layzner,Carks,0,0,0,,然后快一点叫那少年
Dialogue: 0,0:16:19.70,0:16:23.33,Layzner,Chef,0,0,0,,怎能让你看不起我军的战力
Dialogue: 0,0:16:24.00,0:16:27.59,Layzner,Chef,0,0,0,,那少年由我们来处理
Dialogue: 0,0:16:27.59,0:16:32.72,Layzner,Carks,0,0,0,,大佐 这是全地球的问题 不是一国利益的问题
Dialogue: 0,0:16:32.72,0:16:35.70,Layzner,Chef,0,0,0,,叫人来把少佐安排到安全处
Dialogue: 0,0:16:37.60,0:16:39.01,Layzner,Soldier,0,0,0,,请往这边走
Dialogue: 0,0:16:39.31,0:16:41.52,Layzner,Carks,0,0,0,,大佐 请再想一想
Dialogue: 0,0:16:41.52,0:16:43.10,Layzner,Chef,0,0,0,,我不接受俘虏的意见
Dialogue: 0,0:16:43.31,0:16:44.02,Layzner,Carks,0,0,0,,俘虏
Dialogue: 0,0:16:46.15,0:16:46.81,Layzner,Carks,0,0,0,,大佐
Dialogue: 0,0:16:46.81,0:16:48.19,Layzner,Carks,0,0,0,,你打不过他们的
Dialogue: 0,0:16:48.19,0:16:49.44,Layzner,Carks,0,0,0,,快回地球
Dialogue: 0,0:16:49.44,0:16:52.74,Layzner,Chef,0,0,0,,第三阵型 派攻击部队出击
Dialogue: 0,0:17:27.98,0:17:31.02,Layzner,Gale,0,0,0,,接下来两架SPT一对 各自去攻击敌舰
Dialogue: 0,0:17:31.02,0:17:33.19,Layzner,Gale,0,0,0,,阿修和德尔洛去摧毁右边的战舰
Dialogue: 0,0:17:33.19,0:17:34.99,Layzner,Gale,0,0,0,,卡露拉跟肯因负责左边的战舰
Dialogue: 0,0:17:34.99,0:17:36.32,Layzner,All,0,0,0,,了解
Dialogue: 0,0:17:36.32,0:17:37.28,Layzner,Gale,0,0,0,,好 出发
Dialogue: 0,0:17:47.62,0:17:48.94,Layzner,Roanne,0,0,0,,他们追来了
Dialogue: 0,0:17:49.13,0:17:51.00,Layzner,Arthur,0,0,0,,没 没问题吧
Dialogue: 0,0:17:51.00,0:17:51.88,Layzner,Simone,0,0,0,,英二呢
Dialogue: 0,0:17:54.09,0:17:55.55,Layzner,Roanne,0,0,0,,不知道
Dialogue: 0,0:17:55.55,0:17:56.97,Layzner,Roanne,0,0,0,,他在哪里
Dialogue: 0,0:17:58.93,0:18:00.64,Layzner,Elizabeth,0,0,0,,大卫 你要去哪
Dialogue: 0,0:18:00.64,0:18:01.97,Layzner,David,0,0,0,,我去找英二
Dialogue: 0,0:18:01.97,0:18:02.81,Layzner,Elizabeth,0,0,0,,等一下
Dialogue: 0,0:18:02.81,0:18:04.52,Layzner,David,0,0,0,,可是 这样下去
Dialogue: 0,0:18:04.52,0:18:05.73,Layzner,Simone,0,0,0,,要去的话大家一起去
Dialogue: 0,0:18:07.56,0:18:08.44,Layzner,Roanne,0,0,0,,走吧
Dialogue: 0,0:18:12.39,0:18:13.43,Layzner,Arthur,0,0,0,,等我
Dialogue: 0,0:18:33.54,0:18:34.77,Layzner,Eiji,0,0,0,,放我出去
Dialogue: 0,0:18:34.77,0:18:35.97,Layzner,Eiji,0,0,0,,把我放出去
Dialogue: 0,0:18:35.97,0:18:37.57,Layzner,Eiji,0,0,0,,这样下去大家会被干掉的
Dialogue: 0,0:18:37.88,0:18:40.50,Layzner,Eiji,0,0,0,,我就没办法去通知地球了
Dialogue: 0,0:18:40.80,0:18:41.80,Layzner,David,0,0,0,,英二
Dialogue: 0,0:18:41.80,0:18:43.01,Layzner,David,0,0,0,,你在哪里
Dialogue: 0,0:18:43.01,0:18:45.01,Layzner,Roanne,0,0,0,,回答我们
Dialogue: 0,0:18:44.22,0:18:45.01,Layzner,David,0,0,0,,英二
Dialogue: 0,0:19:06.57,0:19:07.54,Layzner,Eiji,0,0,0,,少佐
Dialogue: 0,0:19:08.12,0:19:10.29,Layzner,Carks,0,0,0,,现在就放你出去 闪开
Dialogue: 0,0:19:13.88,0:19:14.51,Layzner,Carks,0,0,0,,快离开这里
Dialogue: 0,0:19:15.17,0:19:16.00,Layzner,Carks,0,0,0,,去通知地球吧
Dialogue: 0,0:19:17.05,0:19:18.01,Layzner,Eiji,0,0,0,,少佐
Dialogue: 0,0:19:18.67,0:19:24.22,Layzner,Carks,0,0,0,,我不是在说笑 如果你也是地球人的话我一定相信你
Dialogue: 0,0:19:26.10,0:19:29.85,Layzner,,0,0,0,,老实说到现在我还是不能相信
Dialogue: 0,0:19:29.85,0:19:32.44,Layzner,Carks,0,0,0,,你跟那些孩子们的关系
Dialogue: 0,0:19:36.44,0:19:37.23,Layzner,Carks,0,0,0,,快点
Dialogue: 0,0:19:37.23,0:19:38.07,Layzner,Eiji,0,0,0,,少佐
Dialogue: 0,0:19:40.11,0:19:42.66,Layzner,Eiji,0,0,0,,命运也让我们连在一起了不是吗
Dialogue: 0,0:19:55.79,0:19:59.17,Layzner,Gale,0,0,0,,英二 不要抵抗 快丢下武器出来吧
Dialogue: 0,0:19:59.17,0:20:00.97,Layzner,Gale,0,0,0,,说不定现在还来得及
Dialogue: 0,0:20:11.98,0:20:16.06,Layzner,Roanne,0,0,0,,他没来这的话就表示他被关在哪了
Dialogue: 0,0:20:16.06,0:20:17.52,Layzner,Elizabeth,0,0,0,,我去找他
Dialogue: 0,0:20:17.52,0:20:18.69,Layzner,Elizabeth,0,0,0,,你们待在这里
Dialogue: 0,0:20:18.82,0:20:19.86,Layzner,David,0,0,0,,我也去
Dialogue: 0,0:20:21.94,0:20:22.61,Layzner,Elizabeth,0,0,0,,少佐
Dialogue: 0,0:20:22.61,0:20:23.32,Layzner,David,0,0,0,,英二
Dialogue: 0,0:20:23.32,0:20:25.49,Layzner,Carks,0,0,0,,大家快去闸门那里 快上航天飞机
Dialogue: 0,0:20:25.66,0:20:26.49,Layzner,Roanne,0,0,0,,英二
Dialogue: 0,0:20:26.49,0:20:28.37,Layzner,Carks,0,0,0,,这战舰不行了 大家快一点
Dialogue: 0,0:20:33.00,0:20:34.17,Layzner,Elizabeth,0,0,0,,少佐
Dialogue: 0,0:20:34.17,0:20:35.96,Layzner,Carks,0,0,0,,伊丽莎白博士 快点
Dialogue: 0,0:20:39.63,0:20:41.80,Layzner,Carks,0,0,0,,快点 闸门打开就跑
Dialogue: 0,0:20:50.39,0:20:51.31,Layzner,Carks,0,0,0,,哪一个
Dialogue: 0,0:20:51.31,0:20:53.68,Layzner,Carks,0,0,0,,哪一个是打开闸门的按钮
Dialogue: 0,0:20:56.08,0:20:56.90,Layzner,Elizabeth,0,0,0,,少佐
Dialogue: 0,0:20:58.06,0:21:00.32,Layzner,Carks,0,0,0,,快一点 我现在要打开闸门了
Dialogue: 0,0:21:01.98,0:21:03.65,Layzner,Arthur,0,0,0,,要怎么下去
Dialogue: 0,0:21:03.65,0:21:04.78,Layzner,Roanne,0,0,0,,跳下去啊
Dialogue: 0,0:21:12.25,0:21:13.12,Layzner,Roanne,0,0,0,,快一点
Dialogue: 0,0:21:17.75,0:21:18.83,Layzner,David,0,0,0,,快点
Dialogue: 0,0:21:19.21,0:21:20.93,Layzner,Arthur,0,0,0,,你在干嘛 太过分了
Dialogue: 0,0:21:26.22,0:21:26.88,Layzner,Carks,0,0,0,,成功了
Dialogue: 0,0:21:30.43,0:21:31.42,Layzner,Carks,0,0,0,,快点
Dialogue: 0,0:21:32.35,0:21:34.52,Layzner,Soldier,0,0,0,,是谁打开的 快把闸门关上
Dialogue: 0,0:21:34.52,0:21:35.31,Layzner,Soldier2,0,0,0,,是俘虏
Dialogue: 0,0:21:35.31,0:21:36.81,Layzner,Soldier,0,0,0,,发现俘虏了
Dialogue: 0,0:21:43.03,0:21:43.44,Layzner,Roanne,0,0,0,,少佐
Dialogue: 0,0:21:43.44,0:21:44.53,Layzner,David,0,0,0,,少佐
Dialogue: 0,0:21:44.53,0:21:45.36,Layzner,Carks,0,0,0,,去吧
Dialogue: 0,0:21:45.36,0:21:46.95,Layzner,Carks,0,0,0,,别理我快去
Dialogue: 0,0:21:46.95,0:21:48.95,Layzner,Carks,0,0,0,,大家 地球拜托你们了
Dialogue: 0,0:21:52.83,0:21:53.74,Layzner,Elizabeth,0,0,0,,少佐
Dialogue: 0,0:21:54.91,0:21:56.66,Layzner,Elizabeth,0,0,0,,少佐
Dialogue: 0,0:21:56.66,0:21:57.71,Layzner,Eiji,0,0,0,,走吧
Dialogue: 0,0:22:11.64,0:22:12.97,Layzner,Gale,0,0,0,,全员回航
Dialogue: 0,0:22:12.97,0:22:13.60,Layzner,All,0,0,0,,了解
Dialogue: 0,0:22:24.98,0:22:28.15,Layzner,Rei,0,0,0,,残存能源0.06单位
Dialogue: 0,0:22:28.15,0:22:30.28,Layzner,Eiji,0,0,0,,先使用布鲁迪和贝布鲁的能源
Dialogue: 0,0:22:30.28,0:22:31.03,Layzner,Rei,0,0,0,,Ready.
Dialogue: 0,0:22:31.03,0:22:32.28,Layzner,Eiji,0,0,0,,动力全开
Dialogue: 0,0:22:34.78,0:22:40.19,Layzner,Anna,0,0,0,,虽然我们从将爆炸的苏联舰中逃出
Dialogue: 0,0:22:40.19,0:22:46.17,Layzner,Anna,0,0,0,,但却没有想到丹尼少佐会牺牲自己让我们逃出来
Dialogue: 0,0:22:46.80,0:22:49.97,Layzner,Anna,0,0,0,,我们除了祈祷什么都做不了
Dialogue: 0,0:23:54.12,0:23:55.12,Layzner,David,0,0,0,,英二
Dialogue: 0,0:23:55.99,0:23:58.24,Layzner,David,0,0,0,,为什么你要投降
Dialogue: 0,0:23:58.24,0:23:58.91,Layzner,Elizabeth,0,0,0,,大卫
Dialogue: 0,0:23:58.91,0:24:02.12,Layzner,David,0,0,0,,我们马上就要到地球了
Dialogue: 0,0:24:02.12,0:24:03.94,Layzner,David,0,0,0,,你不战斗的话 我来
Dialogue: 0,0:24:03.96,0:24:08.50,Layzner,David,0,0,0,,下一集 被外星人捉了

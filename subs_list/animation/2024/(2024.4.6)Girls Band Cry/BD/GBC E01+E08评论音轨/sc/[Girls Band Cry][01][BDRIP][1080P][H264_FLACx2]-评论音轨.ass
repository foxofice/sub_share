Dialogue: 0,0:03:40.59,0:03:44.84,Title,,0,0,0,,{\an3\pos(1787,924)\fad(0,800)\blur10\c&HFFFFFF&\1a&H12&}东京嘿咻
Dialogue: 0,0:23:36.07,0:23:40.08,Title,,0,0,0,,{\an1\pos(270,922)\fad(0,0)\blur10\c&HFFFFFF&\1a&H12&}下集 三只夜行生物
Dialogue: 0,0:00:01.50,0:00:04.45,mmk,,0,0,0,,さ、第一话开始了
Dialogue: 0,0:00:04.50,0:00:08.70,mmk,,0,0,0,,这里是动画《GIRLS BAND CRY》第一话评论音轨
Dialogue: 0,0:00:08.70,0:00:11.62,Nina,,0,0,0,,请多多指教
Dialogue: 0,0:00:09.91,0:00:11.62,mmk,,0,0,0,,请多多指教
Dialogue: 0,0:00:11.62,0:00:14.37,mmk,,0,0,0,,这条评论音轨
Dialogue: 0,0:00:14.37,0:00:20.33,mmk,,0,0,0,,是只有购买了《GIRLS BAND CRY》BD & DVD第一卷的人
Dialogue: 0,0:00:20.33,0:00:21.95,mmk,,0,0,0,,才可以听到的评论音轨
Dialogue: 0,0:00:21.95,0:00:27.25,Nina,,0,0,0,,既然是限定评论 那么在这里说一些悄悄话也...
Dialogue: 0,0:00:27.25,0:00:30.75,mmk,,0,0,0,,毕竟只有买的人才能听到呢
Dialogue: 0,0:00:30.75,0:00:33.41,Nina,,0,0,0,,让我们来说些悄悄话吧
Dialogue: 0,0:00:33.41,0:00:37.66,mmk,,0,0,0,,好 总而言之 我是担任河原木桃香的夕莉
Dialogue: 0,0:00:37.66,0:00:39.45,Nina,,0,0,0,,我是担任井芹仁菜的理名
Dialogue: 0,0:00:39.45,0:00:45.25,mmk,,0,0,0,,第一话将由我们两人担任评论音轨 请多多指教
Dialogue: 0,0:00:46.12,0:00:50.50,mmk,,0,0,0,,聊着聊着动画已经放过去不少了呢
Dialogue: 0,0:00:50.50,0:00:53.66,Nina,,0,0,0,,这个人很好地坐过站了呢
Dialogue: 0,0:00:54.70,0:00:56.50,mmk,,0,0,0,,这一幕很辛苦呢
Dialogue: 0,0:00:56.91,0:00:57.79,Nina,,0,0,0,,已经在苦恼了
Dialogue: 0,0:00:57.79,0:00:59.79,mmk,,0,0,0,,但是 是东京站对吧
Dialogue: 0,0:00:59.79,0:01:02.33,Nina,,0,0,0,,是的呢 我还没去过东京站呢
Dialogue: 0,0:01:02.83,0:01:05.79,mmk,,0,0,0,,毕竟虽然理名酱也是从广岛上京而来
Dialogue: 0,0:01:05.79,0:01:09.95,mmk,,0,0,0,,一个人坐新干线到东京站很了不得吧？
Dialogue: 0,0:01:09.95,0:01:10.95,Nina,,0,0,0,,我的话肯定不行
Dialogue: 0,0:01:10.95,0:01:12.75,mmk,,0,0,0,,肯定会变成这样吧
Dialogue: 0,0:01:12.75,0:01:16.54,Nina,,0,0,0,,我至今为止还没一个人坐过新干线呢
Dialogue: 0,0:01:16.54,0:01:19.33,mmk,,0,0,0,,我也不怎么坐新干线
Dialogue: 0,0:01:19.33,0:01:21.33,mmk,,0,0,0,,一个人坐有点害怕吧
Dialogue: 0,0:01:21.91,0:01:23.25,mmk,,0,0,0,,坐电车倒是没问题
Dialogue: 0,0:01:23.25,0:01:24.45,Nina,,0,0,0,,确实
Dialogue: 0,0:01:25.04,0:01:26.37,Nina,,0,0,0,,换成新干线就有点
Dialogue: 0,0:01:26.37,0:01:27.95,Nina,,0,0,0,,来了 真漂亮啊
Dialogue: 0,0:01:28.41,0:01:29.50,mmk,,0,0,0,,怎么说来着
Dialogue: 0,0:01:30.16,0:01:31.70,mmk,,0,0,0,,哇塞
Dialogue: 0,0:01:30.16,0:01:31.70,Nina,,0,0,0,,哇塞
Dialogue: 0,0:01:32.70,0:01:34.29,Nina,,0,0,0,,真漂亮啊
Dialogue: 0,0:01:34.29,0:01:36.91,mmk,,0,0,0,,我还没见过 真想去看啊
Dialogue: 0,0:01:36.91,0:01:38.83,Nina,,0,0,0,,我也没见过 想去
Dialogue: 0,0:01:39.50,0:01:41.95,Nina,,0,0,0,,那里是横須賀啊
Dialogue: 0,0:01:42.16,0:01:44.33,Nina,,0,0,0,,仁菜——
Dialogue: 0,0:01:44.58,0:01:46.66,mmk,,0,0,0,,有点挤 有点难受呢
Dialogue: 0,0:01:46.66,0:01:47.25,mmk,,0,0,0,,抱歉
Dialogue: 0,0:01:48.54,0:01:50.83,Nina,,0,0,0,,表情超级悲伤
Dialogue: 0,0:01:53.04,0:01:55.16,Nina,,0,0,0,,这样的开场真好啊
Dialogue: 0,0:01:55.16,0:01:57.00,mmk,,0,0,0,,真好啊 BGM
Dialogue: 0,0:01:57.50,0:01:58.45,Nina,,0,0,0,,是雪呢
Dialogue: 0,0:01:59.25,0:02:03.04,Nina,,0,0,0,,也就是二月或者是三月呢
Dialogue: 0,0:02:03.04,0:02:04.16,mmk,,0,0,0,,糟了糟了
Dialogue: 0,0:02:04.16,0:02:05.95,mmk,,0,0,0,,啊啊
Dialogue: 0,0:02:05.95,0:02:07.16,Nina,,0,0,0,,表情表情w
Dialogue: 0,0:02:10.12,0:02:12.62,mmk,,0,0,0,,然后就是OP
Dialogue: 0,0:02:10.12,0:02:12.62,Nina,,0,0,0,,然后就是OP
Dialogue: 0,0:02:13.20,0:02:13.83,mmk,,0,0,0,,真好啊
Dialogue: 0,0:02:14.91,0:02:19.91,Nina,,0,0,0,,OP混入了2D画面 该怎么说呢 感觉很新鲜
Dialogue: 0,0:02:19.91,0:02:21.75,Nina,,0,0,0,,反而很新鲜
Dialogue: 0,0:02:22.20,0:02:23.08,mmk,,0,0,0,,真好啊
Dialogue: 0,0:02:22.54,0:02:23.54,Nina,,0,0,0,,很有趣
Dialogue: 0,0:02:23.54,0:02:25.20,mmk,,0,0,0,,真好啊
Dialogue: 0,0:02:26.04,0:02:27.83,mmk,,0,0,0,,第一话姑且算是开始了
Dialogue: 0,0:02:27.83,0:02:28.54,Nina,,0,0,0,,嗯
Dialogue: 0,0:02:28.87,0:02:29.70,mmk,,0,0,0,,感觉怎样？
Dialogue: 0,0:02:30.00,0:02:32.79,mmk,,0,0,0,,最开始的 只有理名酱登场的画面
Dialogue: 0,0:02:32.79,0:02:34.87,Nina,,0,0,0,,我超级紧张啊
Dialogue: 0,0:02:34.87,0:02:35.83,mmk,,0,0,0,,很紧张？
Dialogue: 0,0:02:35.83,0:02:38.29,Nina,,0,0,0,,嗯 怎么说呢
Dialogue: 0,0:02:38.29,0:02:43.29,Nina,,0,0,0,,没看过完整版也不知道画面到最后会变成什么样子
Dialogue: 0,0:02:43.29,0:02:45.12,Nina,,0,0,0,,放送后才第一次看
Dialogue: 0,0:02:46.41,0:02:49.62,mmk,,0,0,0,,很紧张呢
Dialogue: 0,0:02:49.83,0:02:51.08,Nina,,0,0,0,,这里超级棒
Dialogue: 0,0:02:50.54,0:02:51.08,mmk,,0,0,0,,我懂的
Dialogue: 0,0:02:52.33,0:02:53.70,Nina,,0,0,0,,这里 超级好
Dialogue: 0,0:02:57.62,0:02:59.62,Nina,,0,0,0,,呀 我也想做这个
Dialogue: 0,0:03:00.37,0:03:02.62,mmk,,0,0,0,,真帅啊
Dialogue: 0,0:03:02.79,0:03:04.00,mmk,,0,0,0,,果然还是得Live
Dialogue: 0,0:03:04.62,0:03:06.25,mmk,,0,0,0,,好想Live啊
Dialogue: 0,0:03:06.62,0:03:11.62,Nina,,0,0,0,,喜欢这个有时会出来的这个哔哩哔哩（闪电）的特效
Dialogue: 0,0:03:12.45,0:03:14.62,Nina,,0,0,0,,我也想能哔哩哔哩
Dialogue: 0,0:03:15.41,0:03:17.08,Nina,,0,0,0,,啊是闪电
Dialogue: 0,0:03:17.58,0:03:19.12,mmk,,0,0,0,,是Rupa
Dialogue: 0,0:03:20.87,0:03:22.58,Nina,,0,0,0,,呀 真的是太好了 想开这样的Live
Dialogue: 0,0:03:22.58,0:03:24.75,mmk,,0,0,0,,嗯 但这个场子很大呢
Dialogue: 0,0:03:28.54,0:03:29.83,mmk,,0,0,0,,冒刺了w
Dialogue: 0,0:03:30.91,0:03:31.95,mmk,,0,0,0,,笑一下
Dialogue: 0,0:03:34.12,0:03:35.62,Nina,,0,0,0,,竖小指了
Dialogue: 0,0:03:35.62,0:03:36.91,mmk,,0,0,0,,化为星星了
Dialogue: 0,0:03:39.08,0:03:40.70,Nina,,0,0,0,,真是好OP
Dialogue: 0,0:03:41.25,0:03:43.54,mmk,,0,0,0,,东京哇咻
Dialogue: 0,0:03:41.25,0:03:43.54,Nina,,0,0,0,,东京哇咻
Dialogue: 0,0:03:43.79,0:03:47.50,Nina,,0,0,0,,明明是川崎为舞台标题确是东京哇咻呢
Dialogue: 0,0:03:47.75,0:03:48.91,mmk,,0,0,0,,啊已经晚上了呢
Dialogue: 0,0:03:49.50,0:03:52.58,Nina,,0,0,0,,已经写着停止营业了哦小仁菜
Dialogue: 0,0:03:52.58,0:03:56.87,mmk,,0,0,0,,但是终于 说起来到底是怎么到这里的
Dialogue: 0,0:03:56.87,0:03:59.33,Nina,,0,0,0,,没有地图能到这真厉害啊
Dialogue: 0,0:03:59.33,0:04:00.95,mmk,,0,0,0,,怎么办呢 我的话说不定会去找警察叔叔
Dialogue: 0,0:04:00.95,0:04:03.45,Nina,,0,0,0,,帮帮我——
Dialogue: 0,0:04:05.04,0:04:08.16,Nina,,0,0,0,,会很不安呢
Dialogue: 0,0:04:11.45,0:04:13.75,Nina,,0,0,0,,哇 出现了 很悲伤的一幕
Dialogue: 0,0:04:15.12,0:04:17.75,Nina,,0,0,0,,这种我绝对受不了
Dialogue: 0,0:04:18.12,0:04:21.04,Nina,,0,0,0,,东京人都会这么冷漠吗
Dialogue: 0,0:04:22.66,0:04:26.33,mmk,,0,0,0,,温泉?温泉?
Dialogue: 0,0:04:28.00,0:04:29.20,Nina,,0,0,0,,跑得好快w
Dialogue: 0,0:04:30.58,0:04:32.45,mmk,,0,0,0,,好可怜
Dialogue: 0,0:04:32.45,0:04:36.87,Nina,,0,0,0,,不过能抱着行李箱跑很厉害呢 就这么理所当然地
Dialogue: 0,0:04:36.87,0:04:38.66,mmk,,0,0,0,,好厉害 到了真好
Dialogue: 0,0:04:38.66,0:04:42.04,Nina,,0,0,0,,203室 207的话就是仁菜了
Dialogue: 0,0:04:46.04,0:04:47.70,Nina,,0,0,0,,呀 一般来讲那里能打开来吗
Dialogue: 0,0:04:48.75,0:04:50.12,mmk,,0,0,0,,这是剧本需要
Dialogue: 0,0:04:50.12,0:04:52.33,mmk,,0,0,0,,啊是软软的小脸蛋
Dialogue: 0,0:04:53.25,0:04:55.58,Nina,,0,0,0,,好可爱
Dialogue: 0,0:04:56.00,0:04:57.45,Nina,,0,0,0,,是邻居呢
Dialogue: 0,0:04:58.00,0:04:59.54,Nina,,0,0,0,,能看到球棒呢
Dialogue: 0,0:05:01.12,0:05:03.20,Nina,,0,0,0,,会有警备心
Dialogue: 0,0:05:04.41,0:05:07.29,mmk,,0,0,0,,到这里大概几点了呢 应该挺晚了
Dialogue: 0,0:05:07.50,0:05:11.58,Nina,,0,0,0,,这位父亲都已经穿上睡衣了
Dialogue: 0,0:05:17.62,0:05:18.20,Nina,,0,0,0,,妈妈
Dialogue: 0,0:05:18.50,0:05:19.37,mmk,,0,0,0,,Baby
Dialogue: 0,0:05:21.41,0:05:22.16,Nina,,0,0,0,,真温柔
Dialogue: 0,0:05:23.58,0:05:24.62,mmk,,0,0,0,,确实呢
Dialogue: 0,0:05:25.41,0:05:26.62,mmk,,0,0,0,,我也完全不知道呢
Dialogue: 0,0:05:26.62,0:05:28.16,mmk,,0,0,0,,别人的电话号码什么的
Dialogue: 0,0:05:28.16,0:05:28.83,Nina,,0,0,0,,我也不知道
Dialogue: 0,0:05:29.00,0:05:31.62,Nina,,0,0,0,,大概只能记住家人的
Dialogue: 0,0:05:33.08,0:05:34.04,Nina,,0,0,0,,这个表情是怎么了
Dialogue: 0,0:05:35.83,0:05:36.83,Nina,,0,0,0,,拒绝了呢
Dialogue: 0,0:05:42.08,0:05:43.25,mmk,,0,0,0,,会去哪里呢
Dialogue: 0,0:05:44.83,0:05:47.12,mmk,,0,0,0,,店还开着 也就是说
Dialogue: 0,0:05:47.12,0:05:47.91,Nina,,0,0,0,,是呢
Dialogue: 0,0:05:49.08,0:05:50.80,mmk,,0,0,0,,是母亲和姐姐吧
Dialogue: 0,0:05:50.35,0:05:53.00,Nina,,0,0,0,,(注:巴赫《D小调托卡塔与赋格》)\N凉音姐的铃声
Dialogue: 0,0:05:53.91,0:05:54.37,mmk,,0,0,0,,糟糕
Dialogue: 0,0:05:53.91,0:05:54.37,Nina,,0,0,0,,糟糕
Dialogue: 0,0:05:55.12,0:05:57.00,Nina,,0,0,0,,周围都暗下来了
Dialogue: 0,0:06:02.75,0:06:04.75,Nina,,0,0,0,,冒刺了冒刺了仁菜
Dialogue: 0,0:06:04.75,0:06:07.91,mmk,,0,0,0,,这个演出最开始大家都挺惊讶的
Dialogue: 0,0:06:07.91,0:06:08.75,mmk,,0,0,0,,好像
Dialogue: 0,0:06:07.91,0:06:11.00,Nina,,0,0,0,,好像有什么要出来一样
Dialogue: 0,0:06:17.33,0:06:18.29,mmk,,0,0,0,,是熊本腔呢
Dialogue: 0,0:06:20.08,0:06:25.04,mmk,,0,0,0,,说起熊本腔 配音的时候音调什么的经常搞不清楚呢
Dialogue: 0,0:06:23.75,0:06:24.45,Nina,,0,0,0,,确实
Dialogue: 0,0:06:25.04,0:06:26.00,Nina,,0,0,0,,确实很难啊
Dialogue: 0,0:06:26.16,0:06:26.83,mmk,,0,0,0,,很难啊
Dialogue: 0,0:06:27.45,0:06:30.04,Nina,,0,0,0,,这首歌不会是...
Dialogue: 0,0:06:34.70,0:06:36.00,Nina,,0,0,0,,桃罐头
Dialogue: 0,0:06:35.16,0:06:36.37,mmk,,0,0,0,,大概在这一块演出
Dialogue: 0,0:06:37.12,0:06:38.70,Nina,,0,0,0,,大概在这一块演出
Dialogue: 0,0:06:39.58,0:06:40.50,mmk,,0,0,0,,十点钟吗
Dialogue: 0,0:06:41.37,0:06:43.12,Nina,,0,0,0,,还在演呢
Dialogue: 0,0:06:43.12,0:06:45.75,mmk,,0,0,0,,我们也来这里圣地巡礼了呢…
Dialogue: 0,0:06:47.04,0:06:49.66,mmk,,0,0,0,,这里也去了
Dialogue: 0,0:06:50.62,0:06:52.20,Nina,,0,0,0,,加油 加油
Dialogue: 0,0:06:53.66,0:06:57.95,mmk,,0,0,0,,啊 来了 来了 糟糕
Dialogue: 0,0:06:57.95,0:07:01.95,Nina,,0,0,0,,呀 这束蓝色的光
Dialogue: 0,0:07:01.95,0:07:03.41,mmk,,0,0,0,,是我在唱
Dialogue: 0,0:07:03.41,0:07:05.66,Nina,,0,0,0,,夕莉在唱哟
Dialogue: 0,0:07:08.00,0:07:09.70,Nina,,0,0,0,,啊啊受不了了
Dialogue: 0,0:07:16.00,0:07:17.29,Nina,,0,0,0,,这段演出太厉害了
Dialogue: 0,0:07:18.45,0:07:21.29,mmk,,0,0,0,,这个唱着好难的呀
Dialogue: 0,0:07:21.29,0:07:23.20,Nina,,0,0,0,,这个也说过呢
Dialogue: 0,0:07:23.75,0:07:24.87,Nina,,0,0,0,,耳环真好
Dialogue: 0,0:07:24.87,0:07:27.08,Nina,,0,0,0,,很
Dialogue: 0,0:07:27.08,0:07:27.70,mmk,,0,0,0,,可爱呢
Dialogue: 0,0:07:27.70,0:07:28.58,Nina,,0,0,0,,对吧
Dialogue: 0,0:07:29.95,0:07:32.66,Nina,,0,0,0,,是憧憬的摸摸卡桑
Dialogue: 0,0:07:34.37,0:07:36.25,Nina,,0,0,0,,唱得真好
Dialogue: 0,0:07:37.83,0:07:38.83,mmk,,0,0,0,,噔噔呤
Dialogue: 0,0:07:40.33,0:07:41.12,mmk,,0,0,0,,糟了糟了
Dialogue: 0,0:07:41.12,0:07:41.83,Nina,,0,0,0,,登场
Dialogue: 0,0:07:47.41,0:07:48.62,Nina,,0,0,0,,好生疏啊
Dialogue: 0,0:07:48.91,0:07:51.25,mmk,,0,0,0,,自己在讲话感觉好害羞
Dialogue: 0,0:07:59.37,0:08:00.91,mmk,,0,0,0,,第一次见面呢
Dialogue: 0,0:07:59.79,0:08:00.54,Nina,,0,0,0,,加油
Dialogue: 0,0:08:02.12,0:08:06.29,mmk,,0,0,0,,这里还是有些冷淡呢 以冷淡为重点配的
Dialogue: 0,0:08:07.58,0:08:12.12,Nina,,0,0,0,,确实 非常地没有兴趣啊
Dialogue: 0,0:08:12.12,0:08:13.37,mmk,,0,0,0,,有点可怜
Dialogue: 0,0:08:17.29,0:08:19.00,Nina,,0,0,0,,仁菜真纯粹啊
Dialogue: 0,0:08:21.37,0:08:24.37,Nina,,0,0,0,,太突然了对吧 "那能买张CD吗?"
Dialogue: 0,0:08:25.33,0:08:27.08,mmk,,0,0,0,,啊这里可爱 喜欢
Dialogue: 0,0:08:30.25,0:08:33.29,mmk,,0,0,0,,啊啊 配笑声好难的啊
Dialogue: 0,0:08:42.79,0:08:47.79,Nina,,0,0,0,,相遇的场景超级棒啊 这里苦战了超级久呢夕莉酱
Dialogue: 0,0:08:48.25,0:08:51.95,mmk,,0,0,0,,真的超级难 但是刚刚的已经能很好地做好了
Dialogue: 0,0:08:53.20,0:08:55.41,Nina,,0,0,0,,哦 来了
Dialogue: 0,0:08:58.45,0:08:59.37,mmk,,0,0,0,,糟了
Dialogue: 0,0:08:59.37,0:09:00.41,Nina,,0,0,0,,糟了糟了
Dialogue: 0,0:09:01.62,0:09:03.04,mmk,,0,0,0,,很不友善的人来了
Dialogue: 0,0:09:04.08,0:09:04.70,mmk,,0,0,0,,好可怕
Dialogue: 0,0:09:04.70,0:09:05.54,Nina,,0,0,0,,好可怕
Dialogue: 0,0:09:08.75,0:09:12.95,mmk,,0,0,0,,我的话就会"啊 抱歉 仁菜 走了哦"
Dialogue: 0,0:09:13.58,0:09:15.08,Nina,,0,0,0,,摸摸卡太强大了
Dialogue: 0,0:09:15.08,0:09:15.83,mmk,,0,0,0,,糟了
Dialogue: 0,0:09:17.12,0:09:18.75,mmk,,0,0,0,,很有问题的一幕
Dialogue: 0,0:09:18.75,0:09:21.04,Nina,,0,0,0,,这里中指很清晰呢
Dialogue: 0,0:09:21.62,0:09:22.54,mmk,,0,0,0,,快跑快跑!
Dialogue: 0,0:09:26.16,0:09:28.41,Nina,,0,0,0,,第一话就这样
Dialogue: 0,0:09:28.41,0:09:30.04,mmk,,0,0,0,,身上的东西都挺沉呢
Dialogue: 0,0:09:32.04,0:09:33.83,mmk,,0,0,0,,"你和我毫无关系"
Dialogue: 0,0:09:38.33,0:09:40.45,Nina,,0,0,0,,会这么生气嘛?
Dialogue: 0,0:09:43.83,0:09:45.58,mmk,,0,0,0,,很好地逃开了呢
Dialogue: 0,0:09:46.62,0:09:50.20,mmk,,0,0,0,,配这段逃跑的时候也挺难的
Dialogue: 0,0:09:54.66,0:09:56.20,Nina,,0,0,0,,这里也苦战了很久呢
Dialogue: 0,0:09:56.25,0:09:58.08,Nina,,0,0,0,,"是‘谢谢’的意思"
Dialogue: 0,0:09:58.58,0:10:00.91,mmk,,0,0,0,,是纯粹的小仁菜呢
Dialogue: 0,0:10:04.91,0:10:10.16,Nina,,0,0,0,,我这里的"井芹仁菜"一直配不好 感觉配了大概五十次
Dialogue: 0,0:10:10.95,0:10:13.83,Nina,,0,0,0,,现在也说不好
Dialogue: 0,0:10:18.70,0:10:20.41,mmk,,0,0,0,,这里是吉野家初次登场吧
Dialogue: 0,0:10:20.41,0:10:21.66,Nina,,0,0,0,,是的呢
Dialogue: 0,0:10:21.66,0:10:24.95,Nina,,0,0,0,,有两个很可爱的吉野家店员
Dialogue: 0,0:10:26.41,0:10:28.45,Nina,,0,0,0,,一直都是两个人在打理么
Dialogue: 0,0:10:28.79,0:10:29.70,mmk,,0,0,0,,很辛苦呢
Dialogue: 0,0:10:30.16,0:10:32.37,mmk,,0,0,0,,这里能看到Rupa桑
Dialogue: 0,0:10:36.70,0:10:38.04,Nina,,0,0,0,,被骗了w
Dialogue: 0,0:10:38.70,0:10:40.87,mmk,,0,0,0,,但是确实分不清呢
Dialogue: 0,0:10:40.87,0:10:42.41,Nina,,0,0,0,,我也分不清
Dialogue: 0,0:10:48.95,0:10:50.95,mmk,,0,0,0,,"这样才见到了摸摸卡桑"
Dialogue: 0,0:10:54.29,0:10:55.66,mmk,,0,0,0,,不愧是粉丝
Dialogue: 0,0:10:57.29,0:11:00.25,Nina,,0,0,0,,摸摸卡桑一定很高兴吧
Dialogue: 0,0:11:02.04,0:11:02.58,mmk,,0,0,0,,来了!
Dialogue: 0,0:11:03.25,0:11:04.50,Nina,,0,0,0,,好好吃的样子
Dialogue: 0,0:11:03.70,0:11:04.50,mmk,,0,0,0,,竟然在这里第一次牛丼
Dialogue: 0,0:11:04.50,0:11:06.04,mmk,,0,0,0,,竟然在这里第一次牛丼
Dialogue: 0,0:11:05.62,0:11:06.04,Nina,,0,0,0,,这里! 这里! 可爱!
Dialogue: 0,0:11:06.04,0:11:07.41,Nina,,0,0,0,,这里! 这里! 可爱!
Dialogue: 0,0:11:14.25,0:11:20.79,Nina,,0,0,0,,没有吃过牛丼的女高中生很稀有啊
Dialogue: 0,0:11:17.20,0:11:20.79,mmk,,0,0,0,,不过完全没有自己第一次是是什么时候吃牛丼的记忆呢
Dialogue: 0,0:11:20.79,0:11:21.79,Nina,,0,0,0,,我也没有
Dialogue: 0,0:11:22.58,0:11:24.95,Nina,,0,0,0,,可能是小学生的时候吧
Dialogue: 0,0:11:24.95,0:11:25.83,mmk,,0,0,0,,嗯 差不多吧
Dialogue: 0,0:11:26.08,0:11:27.91,mmk,,0,0,0,,确实很好吃呢
Dialogue: 0,0:11:30.00,0:11:32.79,Nina,,0,0,0,,这里也苦战了好久呢 吃着东西
Dialogue: 0,0:11:32.79,0:11:34.87,mmk,,0,0,0,,确实 配吃着东西说话很难呢
Dialogue: 0,0:11:34.87,0:11:37.29,Nina,,0,0,0,,吃得很干净呢
Dialogue: 0,0:11:42.75,0:11:44.41,Nina,,0,0,0,,总有办法 是什么办法啊!
Dialogue: 0,0:11:44.75,0:11:45.79,mmk,,0,0,0,,也进不去家
Dialogue: 0,0:11:46.66,0:11:47.50,Nina,,0,0,0,,要怎么办呢?
Dialogue: 0,0:11:47.83,0:11:48.70,Nina,,0,0,0,,露宿?
Dialogue: 0,0:11:49.33,0:11:53.16,Nina,,0,0,0,,好帅啊! 太帅了！
Dialogue: 0,0:11:53.16,0:11:56.45,mmk,,0,0,0,,摸摸卡桑是憧憬的存在呢
Dialogue: 0,0:11:56.87,0:11:59.29,mmk,,0,0,0,,这样第一次见面就
Dialogue: 0,0:11:59.29,0:12:00.58,mmk,,0,0,0,,"去家里可以吗？"
Dialogue: 0,0:12:02.12,0:12:04.66,Nina,,0,0,0,,啊 是很有问题的这一幕
Dialogue: 0,0:12:04.66,0:12:06.00,mmk,,0,0,0,,太糟糕了
Dialogue: 0,0:12:08.33,0:12:09.66,mmk,,0,0,0,,太糟糕了
Dialogue: 0,0:12:10.37,0:12:11.95,Nina,,0,0,0,,当时成了话题了呢
Dialogue: 0,0:12:11.95,0:12:14.00,mmk,,0,0,0,,毕竟说了是谢谢的意思
Dialogue: 0,0:12:14.62,0:12:16.33,Nina,,0,0,0,,竟然相信了
Dialogue: 0,0:12:21.37,0:12:24.25,Nina,,0,0,0,,这个还挺致命呢空调坏了什么的
Dialogue: 0,0:12:24.75,0:12:26.50,Nina,,0,0,0,,门装的太差了
Dialogue: 0,0:12:33.54,0:12:34.62,Nina,,0,0,0,,在紧张呢
Dialogue: 0,0:12:36.20,0:12:38.08,Nina,,0,0,0,,会好好地摆鞋子的好孩子
Dialogue: 0,0:12:38.08,0:12:38.91,mmk,,0,0,0,,家教很好
Dialogue: 0,0:12:38.91,0:12:40.50,Nina,,0,0,0,,这里门也很不好开
Dialogue: 0,0:12:41.62,0:12:42.62,mmk,,0,0,0,,真的没关系么
Dialogue: 0,0:12:44.00,0:12:45.51,Nina,,0,0,0,,找到开关了呢
Dialogue: 0,0:12:46.75,0:12:48.41,mmk,,0,0,0,,猫猫！
Dialogue: 0,0:12:48.41,0:12:51.16,Nina,,0,0,0,,是夕莉酱最喜欢的猫猫呢
Dialogue: 0,0:12:51.54,0:12:53.87,Nina,,0,0,0,,这里的"怕猫吗"w
Dialogue: 0,0:12:52.37,0:12:53.87,mmk,,0,0,0,,啊啊啊
Dialogue: 0,0:12:54.87,0:12:56.37,mmk,,0,0,0,,是这样的呢 米娜桑
Dialogue: 0,0:12:56.37,0:12:59.79,mmk,,0,0,0,,这里的"怕猫吗"也是苦战了非常久
Dialogue: 0,0:13:00.50,0:13:06.58,mmk,,0,0,0,,不管怎么配得到的的回复都是"嗯~ 再自然些"
Dialogue: 0,0:13:06.58,0:13:08.62,Nina,,0,0,0,,"再有点自然搭话过来的感觉"之类的
Dialogue: 0,0:13:08.62,0:13:10.50,mmk,,0,0,0,,变成了打包回家的作业
Dialogue: 0,0:13:11.20,0:13:12.58,mmk,,0,0,0,,下周再来录吧
Dialogue: 0,0:13:11.83,0:13:14.12,Nina,,0,0,0,,打包"怕猫么"的台词w
Dialogue: 0,0:13:14.12,0:13:15.12,mmk,,0,0,0,,太糟糕了
Dialogue: 0,0:13:15.87,0:13:16.83,Nina,,0,0,0,,打包w
Dialogue: 0,0:13:17.16,0:13:19.37,Nina,,0,0,0,,这里吉他看着很大是
Dialogue: 0,0:13:19.66,0:13:21.58,Nina,,0,0,0,,是显得仁菜体格很小呢
Dialogue: 0,0:13:21.95,0:13:24.54,mmk,,0,0,0,,不过理名酱(仁菜cv)拿起吉他也会显得吉他很大呢
Dialogue: 0,0:13:25.58,0:13:29.70,Nina,,0,0,0,,我也是和仁菜差不多的身高(注:仁菜cv身高157cm)
Dialogue: 0,0:13:30.00,0:13:33.75,Nina,,0,0,0,,抱起吉他吉它就会被人说吉他很大呢
Dialogue: 0,0:13:33.75,0:13:35.25,mmk,,0,0,0,,毕竟身高差不多高呢
Dialogue: 0,0:13:39.87,0:13:41.37,mmk,,0,0,0,,17岁？现在的理名酱
Dialogue: 0,0:13:41.91,0:13:43.79,Nina,,0,0,0,,是呢 今年就要17岁了
Dialogue: 0,0:13:47.04,0:13:48.50,Nina,,0,0,0,,这里 "微妙的" 的台词
Dialogue: 0,0:13:51.16,0:13:52.79,Nina,,0,0,0,,是夕莉酱的苦战点
Dialogue: 0,0:14:02.91,0:14:03.54,mmk,,0,0,0,,为什么?
Dialogue: 0,0:14:05.91,0:14:07.50,mmk,,0,0,0,,这里太悲伤了
Dialogue: 0,0:14:12.66,0:14:15.75,Nina,,0,0,0,,对于明天就回老家来讲行李也太多了吧
Dialogue: 0,0:14:17.16,0:14:18.00,Nina,,0,0,0,,书什么的
Dialogue: 0,0:14:18.00,0:14:20.54,mmk,,0,0,0,,杯子什么的
Dialogue: 0,0:14:22.62,0:14:24.04,Nina,,0,0,0,,呀 仁菜
Dialogue: 0,0:14:27.50,0:14:30.33,mmk,,0,0,0,,等下 吉他被放在了很危险的地方啊
Dialogue: 0,0:14:30.33,0:14:31.58,mmk,,0,0,0,,这会倒的
Dialogue: 0,0:14:31.58,0:14:33.75,Nina,,0,0,0,,仁菜把杯子放在那里没问题么？
Dialogue: 0,0:14:34.41,0:14:36.91,mmk,,0,0,0,,全部都很危险啊
Dialogue: 0,0:14:47.16,0:14:49.33,Nina,,0,0,0,,第一话仁菜就要开始了呢
Dialogue: 0,0:14:50.12,0:14:52.00,mmk,,0,0,0,,才刚刚遇到呢
Dialogue: 0,0:14:53.66,0:14:55.91,Nina,,0,0,0,,仁菜你太介入过头了哟
Dialogue: 0,0:14:57.58,0:15:01.25,Nina,,0,0,0,,但是没有这样的话刺刺就不会诞生吧 是的呢
Dialogue: 0,0:15:01.25,0:15:02.08,mmk,,0,0,0,,是的呢
Dialogue: 0,0:15:02.58,0:15:05.00,mmk,,0,0,0,,嘛第一话以后仁菜的这种
Dialogue: 0,0:15:05.00,0:15:06.20,Nina,,0,0,0,,暴走的状态
Dialogue: 0,0:15:05.00,0:15:07.70,mmk,,0,0,0,,气呼呼的
Dialogue: 0,0:15:09.20,0:15:14.37,mmk,,0,0,0,,对呢 摸摸卡桑不想讲话的时候就会一直弹琴呢
Dialogue: 0,0:15:20.70,0:15:21.58,mmk,,0,0,0,,"真是的"
Dialogue: 0,0:15:29.00,0:15:30.90,mmk,,0,0,0,,"晚上好"
Dialogue: 0,0:15:27.12,0:15:27.83,Nina,,0,0,0,,这里
Dialogue: 0,0:15:27.83,0:15:29.37,mmk,,0,0,0,,可爱
Dialogue: 0,0:15:35.83,0:15:36.37,mmk,,0,0,0,,嘴巴
Dialogue: 0,0:15:36.37,0:15:39.66,Nina,,0,0,0,,像鸟一样
Dialogue: 0,0:15:45.16,0:15:46.41,Nina,,0,0,0,,kksk
Dialogue: 0,0:16:01.83,0:16:04.66,Nina,,0,0,0,,这里角色PV也出现了
Dialogue: 0,0:16:05.41,0:16:09.58,Nina,,0,0,0,,软糯糯的孩子 很懂呢
Dialogue: 0,0:16:16.00,0:16:17.95,mmk,,0,0,0,,猫在担心w
Dialogue: 0,0:16:24.95,0:16:27.41,Nina,,0,0,0,,猫猫好可爱 在担心仁菜
Dialogue: 0,0:16:34.79,0:16:35.33,mmk,,0,0,0,,糟了
Dialogue: 0,0:16:35.33,0:16:37.29,Nina,,0,0,0,,糟了糟了 要冒刺了
Dialogue: 0,0:16:37.95,0:16:39.95,mmk,,0,0,0,,噔噔 噔
Dialogue: 0,0:16:41.37,0:16:43.45,Nina,,0,0,0,,这个不安的BGM
Dialogue: 0,0:16:44.25,0:16:46.33,mmk,,0,0,0,,啊啊
Dialogue: 0,0:16:45.37,0:16:46.33,Nina,,0,0,0,,啊啊糟了糟了
Dialogue: 0,0:16:48.66,0:16:51.70,mmk,,0,0,0,,仁菜 快想起来啊 是憧憬的摸摸卡桑哦
Dialogue: 0,0:16:52.45,0:16:54.62,Nina,,0,0,0,,才相遇几小时就到了这种地步
Dialogue: 0,0:16:57.29,0:16:59.41,Nina,,0,0,0,,手机忘了呢
Dialogue: 0,0:17:05.25,0:17:06.33,Nina,,0,0,0,,好帅
Dialogue: 0,0:17:07.95,0:17:08.87,mmk,,0,0,0,,跑得好快
Dialogue: 0,0:17:09.83,0:17:12.70,mmk,,0,0,0,,仁菜 逃跑很快的样子
Dialogue: 0,0:17:21.75,0:17:25.16,Nina,,0,0,0,,摸摸卡桑也太有好姐姐的感觉了
Dialogue: 0,0:17:24.25,0:17:25.16,mmk,,0,0,0,,二十岁?
Dialogue: 0,0:17:25.95,0:17:28.08,mmk,,0,0,0,,让人不觉得是二十岁
Dialogue: 0,0:17:28.45,0:17:29.41,mmk,,0,0,0,,很成熟
Dialogue: 0,0:17:31.91,0:17:33.29,Nina,,0,0,0,,仁菜~
Dialogue: 0,0:17:44.41,0:17:45.70,Nina,,0,0,0,,还要问吗！
Dialogue: 0,0:17:51.58,0:17:53.58,Nina,,0,0,0,,吵架分手呢
Dialogue: 0,0:18:00.04,0:18:03.79,mmk,,0,0,0,,仁菜 一直很悲伤的表情好可怜
Dialogue: 0,0:18:17.16,0:18:21.75,mmk,,0,0,0,,这里埋着头笑很难配呢
Dialogue: 0,0:18:29.16,0:18:34.87,Nina,,0,0,0,,这里在公园的小角落打闹很动人呢
Dialogue: 0,0:18:32.45,0:18:34.87,mmk,,0,0,0,,很动人呢
Dialogue: 0,0:18:38.08,0:18:42.87,mmk,,0,0,0,,糟了 看得太入迷什么都没聊
Dialogue: 0,0:18:45.41,0:18:46.75,mmk,,0,0,0,,卡拉OK呢
Dialogue: 0,0:18:47.45,0:18:52.50,mmk,,0,0,0,,我们也经常一起去呢
Dialogue: 0,0:19:02.79,0:19:05.62,Nina,,0,0,0,,呜呜是仁菜的主题曲呢
Dialogue: 0,0:19:05.95,0:19:07.50,mmk,,0,0,0,,啊 唱不出口呢
Dialogue: 0,0:19:25.80,0:19:26.80,mmk,,0,0,0,,猫猫
Dialogue: 0,0:19:16.70,0:19:18.87,mmk,,0,0,0,,啊 摸摸卡...
Dialogue: 0,0:19:21.41,0:19:22.95,Nina,,0,0,0,,在睡觉呢
Dialogue: 0,0:19:31.29,0:19:32.83,Nina,,0,0,0,,猫猫很悠闲呢
Dialogue: 0,0:19:33.21,0:19:36.22,mmk,,0,0,0,,え 摸摸卡是一个人回旭川么
Dialogue: 0,0:19:36.04,0:19:36.83,Nina,,0,0,0,,不是么
Dialogue: 0,0:19:37.04,0:19:37.87,mmk,,0,0,0,,猫猫呢？
Dialogue: 0,0:19:38.25,0:19:40.04,mmk,,0,0,0,,寄养给那个人吗
Dialogue: 0,0:19:40.79,0:19:41.95,Nina,,0,0,0,,是叫华男(注:男同室友)来着么
Dialogue: 0,0:19:42.12,0:19:43.12,mmk,,0,0,0,,华男
Dialogue: 0,0:19:43.16,0:19:45.41,Nina,,0,0,0,,是寄养给华男么
Dialogue: 0,0:19:49.86,0:19:50.49,mmk,,0,0,0,,え？
Dialogue: 0,0:19:51.03,0:19:52.53,Nina,,0,0,0,,明明仁菜不会弹
Dialogue: 0,0:19:53.24,0:19:54.07,Nina,,0,0,0,,不会弹的说
Dialogue: 0,0:19:55.32,0:19:57.20,mmk,,0,0,0,,吉他 送吉他...
Dialogue: 0,0:20:04.24,0:20:05.32,mmk,,0,0,0,,好寂寞呢
Dialogue: 0,0:20:10.36,0:20:11.03,Nina,,0,0,0,,啊啊
Dialogue: 0,0:20:11.03,0:20:13.74,mmk,,0,0,0,,啊啊啊啊
Dialogue: 0,0:20:11.03,0:20:13.74,Nina,,0,0,0,,啊啊啊啊
Dialogue: 0,0:20:14.86,0:20:16.24,mmk,,0,0,0,,啊啊 那个打开了的话...
Dialogue: 0,0:20:17.24,0:20:18.03,mmk,,0,0,0,,写着什么呢？
Dialogue: 0,0:20:19.03,0:20:21.03,mmk,,0,0,0,,竖起中指吧！
Dialogue: 0,0:20:23.28,0:20:24.82,Nina,,0,0,0,,这个BGM真好啊
Dialogue: 0,0:20:23.57,0:20:24.82,mmk,,0,0,0,,冲呀！ 冲呀！
Dialogue: 0,0:20:24.82,0:20:25.32,mmk,,0,0,0,,冲呀！ 冲呀！
Dialogue: 0,0:20:25.53,0:20:29.49,Nina,,0,0,0,,这里在雨天不带琴包抱着琴跑w
Dialogue: 0,0:20:29.49,0:20:30.53,mmk,,0,0,0,,这个还挺...
Dialogue: 0,0:20:30.53,0:20:32.03,Nina,,0,0,0,,成为话题了呢
Dialogue: 0,0:20:33.45,0:20:36.57,Nina,,0,0,0,,"看着都受不了" "吉他好可怜"
Dialogue: 0,0:20:36.99,0:20:37.61,Nina,,0,0,0,,高潮的场景
Dialogue: 0,0:20:37.61,0:20:39.32,mmk,,0,0,0,,糟了糟了
Dialogue: 0,0:20:41.32,0:20:45.70,mmk,,0,0,0,,这里好像被吐槽"明明旁边有屋顶给我在屋顶下跑啊"
Dialogue: 0,0:20:46.70,0:20:47.70,Nina,,0,0,0,,确实
Dialogue: 0,0:20:51.65,0:20:55.61,mmk,,0,0,0,,找不到呢
Dialogue: 0,0:20:56.86,0:20:58.28,mmk,,0,0,0,,糟了 完了
Dialogue: 0,0:20:59.07,0:21:01.03,Nina,,0,0,0,,糟了 要完了
Dialogue: 0,0:21:05.36,0:21:07.03,Nina,,0,0,0,,真好啊 这个结尾
Dialogue: 0,0:21:07.82,0:21:11.90,mmk,,0,0,0,,呀 感觉一直是"啊啊"地叫着 就评论完了呢
Dialogue: 0,0:21:12.40,0:21:15.82,Nina,,0,0,0,,糟了什么都没能聊成 还说要说点悄悄话来着的
Dialogue: 0,0:21:15.82,0:21:17.28,mmk,,0,0,0,,什么都没说成
Dialogue: 0,0:21:18.90,0:21:21.32,Nina,,0,0,0,,只说了"这里重录过"什么的话
Dialogue: 0,0:21:25.90,0:21:27.32,Nina,,0,0,0,,在听呢在听呢 摸摸卡桑
Dialogue: 0,0:21:27.74,0:21:30.82,mmk,,0,0,0,,刚刚吵过架的两个人
Dialogue: 0,0:21:33.40,0:21:37.15,mmk,,0,0,0,,竖起中指吧！┗|｀O′|┛
Dialogue: 0,0:21:33.40,0:21:37.15,Nina,,0,0,0,,竖起中指吧！┗|｀O′|┛
Dialogue: 0,0:21:41.57,0:21:43.03,Nina,,0,0,0,,在下雨呢
Dialogue: 0,0:21:42.74,0:21:43.03,mmk,,0,0,0,,来了 来了
Dialogue: 0,0:21:43.03,0:21:43.82,mmk,,0,0,0,,来了 来了
Dialogue: 0,0:21:43.99,0:21:46.15,mmk,,0,0,0,,啊啊来了
Dialogue: 0,0:21:46.74,0:21:47.95,Nina,,0,0,0,,摸摸卡夯
Dialogue: 0,0:21:56.49,0:22:00.07,mmk,,0,0,0,,就这样第一话就要结束了！
Dialogue: 0,0:22:00.78,0:22:03.24,Nina,,0,0,0,,呀 真是非常好的一话呢
Dialogue: 0,0:22:03.24,0:22:04.86,mmk,,0,0,0,,真是段好故事呢
Dialogue: 0,0:22:05.03,0:22:07.40,Nina,,0,0,0,,这首歌也非常的好...
Dialogue: 0,0:22:07.86,0:22:11.78,Nina,,0,0,0,,这里最开始吵架的两个人w
Dialogue: 0,0:22:10.86,0:22:11.78,mmk,,0,0,0,,一起
Dialogue: 0,0:22:11.78,0:22:15.24,Nina,,0,0,0,,也来一起演奏了
Dialogue: 0,0:22:12.65,0:22:14.15,mmk,,0,0,0,,看起来很高兴的样子
Dialogue: 0,0:22:15.90,0:22:17.40,mmk,,0,0,0,,技术很好啊
Dialogue: 0,0:22:17.61,0:22:20.86,Nina,,0,0,0,,很厉害啊 能这样即兴合上
Dialogue: 0,0:22:20.86,0:22:22.70,mmk,,0,0,0,,这段鼓也很好
Dialogue: 0,0:22:23.40,0:22:26.53,Nina,,0,0,0,,第一话该怎么说呢节奏感很好
Dialogue: 0,0:22:26.95,0:22:30.20,Nina,,0,0,0,,应该是非常好看懂的一话
Dialogue: 0,0:22:30.20,0:22:34.49,mmk,,0,0,0,,真好啊 这样第二话会怎么发展呢
Dialogue: 0,0:22:34.49,0:22:36.11,mmk,,0,0,0,,和摸摸卡相遇后
Dialogue: 0,0:22:37.15,0:22:39.74,mmk,,0,0,0,,摸摸卡会这样就不回旭川了么？
Dialogue: 0,0:22:40.03,0:22:41.36,Nina,,0,0,0,,会是这样么？
Dialogue: 0,0:22:41.49,0:22:43.57,Nina,,0,0,0,,仁菜就这样留住了吗？
Dialogue: 0,0:22:44.82,0:22:46.82,mmk,,0,0,0,,非常好的眼神
Dialogue: 0,0:22:48.36,0:22:49.74,Nina,,0,0,0,,表情超级棒
Dialogue: 0,0:22:49.40,0:22:49.74,mmk,,0,0,0,,"这首歌很棒吧？"的表情
Dialogue: 0,0:22:49.74,0:22:51.15,mmk,,0,0,0,,"这首歌很棒吧？"的表情
Dialogue: 0,0:22:50.36,0:22:51.15,Nina,,0,0,0,,kksk
Dialogue: 0,0:22:51.74,0:22:55.49,Nina,,0,0,0,,这里 雨停下来的场景很棒吧
Dialogue: 0,0:22:55.90,0:22:57.04,mmk,,0,0,0,,真棒啊
Dialogue: 0,0:22:59.66,0:23:02.36,Nina,,0,0,0,,这里仁菜是在想着什么而歌唱的呢
Dialogue: 0,0:23:03.20,0:23:05.07,mmk,,0,0,0,,呀 摸摸卡表情真不错啊
Dialogue: 0,0:23:05.20,0:23:06.05,Nina,,0,0,0,,是啊
Dialogue: 0,0:23:07.28,0:23:08.49,mmk,,0,0,0,,仁菜~~
Dialogue: 0,0:23:09.20,0:23:11.95,Nina,,0,0,0,,呀 歌实在是太好了
Dialogue: 0,0:23:09.74,0:23:11.95,mmk,,0,0,0,,"是我的主题曲"
Dialogue: 0,0:23:15.90,0:23:18.15,mmk,,0,0,0,,就这样的感觉第一话就要结束了么？
Dialogue: 0,0:23:18.15,0:23:20.40,Nina,,0,0,0,,马上就要结束了呢
Dialogue: 0,0:23:20.57,0:23:23.90,mmk,,0,0,0,,怎么样呢 我们的评论音轨
Dialogue: 0,0:23:23.90,0:23:25.49,mmk,,0,0,0,,我们是聊得很开心
Dialogue: 0,0:23:25.99,0:23:27.03,mmk,,0,0,0,,那就在这里？
Dialogue: 0,0:23:27.03,0:23:28.61,Nina,,0,0,0,,好 那么
Dialogue: 0,0:23:27.95,0:23:28.61,mmk,,0,0,0,,那么
Dialogue: 0,0:23:28.95,0:23:31.40,mmk,,0,0,0,,感谢收看！
Dialogue: 0,0:23:28.95,0:23:31.40,Nina,,0,0,0,,感谢收看！
Dialogue: 0,0:23:31.40,0:23:32.74,Nina,,0,0,0,,辛苦刺刺！
Dialogue: 0,0:23:32.20,0:23:32.74,mmk,,0,0,0,,辛苦刺刺！
Dialogue: 0,0:23:32.74,0:23:33.32,mmk,,0,0,0,,辛苦刺刺！

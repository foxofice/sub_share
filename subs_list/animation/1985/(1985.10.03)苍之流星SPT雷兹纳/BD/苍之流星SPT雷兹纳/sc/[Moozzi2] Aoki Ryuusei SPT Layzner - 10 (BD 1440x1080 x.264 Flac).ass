Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:02.80,0:01:04.38,Layzner,Roanne,0,0,0,,不 是因为博士太漂亮了
Dialogue: 0,0:01:04.50,0:01:06.01,Layzner,Simone,0,0,0,,安娜喜欢他是吗
Dialogue: 0,0:01:08.87,0:01:09.50,Layzner,Eiji,0,0,0,,大卫
Dialogue: 0,0:01:41.62,0:01:42.74,Layzner,Roanne,0,0,0,,给我命中 给我命中
Dialogue: 0,0:01:47.10,0:01:47.74,Layzner,Egyle,0,0,0,,什么
Dialogue: 0,0:01:49.98,0:01:52.84,Layzner,Anna,0,0,0,,这样憎恨他的大卫
Dialogue: 0,0:01:52.85,0:01:55.26,Layzner,Anna,0,0,0,,和这样冷静的罗安
Dialogue: 0,0:01:55.27,0:01:57.38,Layzner,Anna,0,0,0,,把他从危机中救了出来
Dialogue: 0,0:01:57.78,0:01:58.84,Layzner,David,0,0,0,,成功了
Dialogue: 0,0:01:59.82,0:02:00.73,Layzner,Roanne,0,0,0,,我们成功了
Dialogue: 0,0:02:04.07,0:02:07.64,Layzner,Anna,0,0,0,,现在 他们的心在彼此交流
Dialogue: 0,0:02:07.65,0:02:12.82,Layzner,Anna,0,0,0,,为了活下去而向前跨出了一步 我感觉得到
Dialogue: 0,0:02:12.82,0:02:17.85,Layzner,Title,0,0,0,,第十话 叫他…英二！？
Dialogue: 0,0:02:31.48,0:02:33.00,Layzner,Elizabeth,0,0,0,,太好了 大家都没事
Dialogue: 0,0:02:39.18,0:02:42.16,Layzner,Arthur,0,0,0,,你们随便就出动太乱来了
Dialogue: 0,0:02:42.94,0:02:44.37,Layzner,Roanne,0,0,0,,我也吓了一跳
Dialogue: 0,0:02:45.70,0:02:48.20,Layzner,Roanne,0,0,0,,可是等我回过神来已经坐在机动兵器上了
Dialogue: 0,0:02:48.67,0:02:50.17,Layzner,David,0,0,0,,我也是
Dialogue: 0,0:02:50.18,0:02:54.15,Layzner,David,0,0,0,,不过身为男人在那种情况下有这种反应也是应该的
Dialogue: 0,0:02:59.44,0:03:02.83,Layzner,David,0,0,0,,话说回来为什么在敌人面前把武器丢掉
Dialogue: 0,0:03:05.86,0:03:06.83,Layzner,Roanne,0,0,0,,故障了吧
Dialogue: 0,0:03:07.80,0:03:09.77,Layzner,Eiji,0,0,0,,不 不是故障
Dialogue: 0,0:03:10.13,0:03:12.65,Layzner,David,0,0,0,,你说什么 如果不是故障的话 为什么
Dialogue: 0,0:03:13.98,0:03:14.86,Layzner,Eiji,0,0,0,,我
Dialogue: 0,0:03:15.89,0:03:19.15,Layzner,Anna,0,0,0,,他没有再多说什么
Dialogue: 0,0:03:19.86,0:03:25.92,Layzner,Anna,0,0,0,,我感觉到了 沉默道出了他的烦恼
Dialogue: 0,0:03:34.88,0:03:35.90,Layzner,Eiji,0,0,0,,你要干什么
Dialogue: 0,0:03:38.23,0:03:42.20,Layzner,Elizabeth,0,0,0,,我在做报告书 你来告诉我们地球的危机
Dialogue: 0,0:03:43.20,0:03:43.80,Layzner,Elizabeth,0,0,0,,那么
Dialogue: 0,0:03:46.72,0:03:49.59,Layzner,Elizabeth,0,0,0,,按那个按键就开始录音了 也会顺便录像
Dialogue: 0,0:03:50.17,0:03:51.02,Layzner,Elizabeth,0,0,0,,看着监视器
Dialogue: 0,0:03:52.53,0:03:55.68,Layzner,Elizabeth,0,0,0,,如果把这事好好地记录在报告书上
Dialogue: 0,0:03:55.69,0:03:57.87,Layzner,Elizabeth,0,0,0,,有一天说不定能帮上忙
Dialogue: 0,0:03:58.44,0:03:59.15,Layzner,Eiji,0,0,0,,我知道了
Dialogue: 0,0:04:03.94,0:04:06.93,Layzner,Roanne,0,0,0,,他为了叫我们坐上机器人
Dialogue: 0,0:04:08.88,0:04:10.50,Layzner,Roanne,0,0,0,,才故意把武器丢掉的吗
Dialogue: 0,0:04:12.10,0:04:15.30,Layzner,Simone,0,0,0,,他不像是会做这种事的人
Dialogue: 0,0:04:16.14,0:04:18.47,Layzner,Roanne,0,0,0,,话是没错
Dialogue: 0,0:04:18.48,0:04:22.40,Layzner,David,0,0,0,,不管怎么说 有一天我们总是要做的
Dialogue: 0,0:04:22.84,0:04:24.83,Layzner,David,0,0,0,,那种事就别管了
Dialogue: 0,0:04:26.71,0:04:28.51,Layzner,David,0,0,0,,话说回来 罗安
Dialogue: 0,0:04:28.52,0:04:30.48,Layzner,David,0,0,0,,你的行动还蛮好的
Dialogue: 0,0:04:31.34,0:04:33.91,Layzner,David,0,0,0,,我本来以为你只是个眼睛仔而已
Dialogue: 0,0:04:34.08,0:04:35.85,Layzner,Roanne,0,0,0,,别看我这样
Dialogue: 0,0:04:35.85,0:04:37.61,Layzner,Roanne,0,0,0,,我可是网球部部长
Dialogue: 0,0:04:38.31,0:04:39.81,Layzner,Roanne,0,0,0,,我的运动神经很好的
Dialogue: 0,0:04:40.60,0:04:43.15,Layzner,Arthur,0,0,0,,你们真的今后也要战斗吗
Dialogue: 0,0:04:43.49,0:04:44.81,Layzner,David,0,0,0,,为了要活下去啊
Dialogue: 0,0:04:45.34,0:04:49.96,Layzner,David,0,0,0,,比起某人只会在那闲晃 想些有的没的就被杀了 我实在看不惯
Dialogue: 0,0:04:50.52,0:04:54.08,Layzner,Arthur,0,0,0,,我才不是闲晃想些有的没的
Dialogue: 0,0:04:54.09,0:04:58.17,Layzner,Arthur,0,0,0,,只是我觉得我技术还不够成熟 如果乱来就不好了
Dialogue: 0,0:04:59.01,0:05:01.57,Layzner,David,0,0,0,,这就是在想些有的没的了
Dialogue: 0,0:05:01.58,0:05:05.02,Layzner,David,0,0,0,,身为男人有时就算乱来也要做
Dialogue: 0,0:05:05.03,0:05:06.83,Layzner,Simone,0,0,0,,说的真好听
Dialogue: 0,0:05:06.84,0:05:09.10,Layzner,Simone,0,0,0,,今天只是你们运气好而已
Dialogue: 0,0:05:09.10,0:05:11.21,Layzner,Simone,0,0,0,,如果敌人攻过来 你认为真的能赢吗
Dialogue: 0,0:05:11.59,0:05:14.88,Layzner,Arthur,0,0,0,,对嘛 正式战斗的话你才不可能赢呢
Dialogue: 0,0:05:15.28,0:05:16.16,Layzner,Arthur,0,0,0,,怎 怎么了
Dialogue: 0,0:05:16.60,0:05:19.31,Layzner,David,0,0,0,,正式战斗也随便打就好了嘛
Dialogue: 0,0:05:19.31,0:05:21.36,Layzner,David,0,0,0,,罗安 麻烦把头盔给我 走吧
Dialogue: 0,0:05:24.66,0:05:25.09,Layzner,Roanne,0,0,0,,给
Dialogue: 0,0:05:34.18,0:05:35.69,Layzner,Simone,0,0,0,,真是单纯的笨蛋
Dialogue: 0,0:05:35.69,0:05:39.09,Layzner,Arthur,0,0,0,,没错 我也这么觉得
Dialogue: 0,0:05:39.61,0:05:42.11,Layzner,Arthur,0,0,0,,竟然认为有勇无谋就叫男人
Dialogue: 0,0:05:42.88,0:05:44.90,Layzner,Simone,0,0,0,,你也真没用
Dialogue: 0,0:05:44.90,0:05:48.23,Layzner,Simone,0,0,0,,如果你是男人 不想输给大卫的话就让他看看你的骨气
Dialogue: 0,0:05:48.24,0:05:49.39,Layzner,Arthur,0,0,0,,咦
Dialogue: 0,0:05:49.40,0:05:50.56,Layzner,Simone,0,0,0,,咦什么
Dialogue: 0,0:05:50.97,0:05:53.61,Layzner,Simone,0,0,0,,你也去模拟战如何
Dialogue: 0,0:05:54.56,0:05:57.52,Layzner,Arthur,0,0,0,,对 对哦
Dialogue: 0,0:06:04.40,0:06:07.43,Layzner,Simone,0,0,0,,没一个像样的男人 对吧
Dialogue: 0,0:06:18.89,0:06:19.92,Layzner,Gail,0,0,0,,是吗
Dialogue: 0,0:06:20.44,0:06:24.45,Layzner,Gail,0,0,0,,英二训练地球人驾驶SPT了啊
Dialogue: 0,0:06:25.11,0:06:26.35,Layzner,Egyle,0,0,0,,对不起
Dialogue: 0,0:06:27.05,0:06:28.87,Layzner,Egyle,0,0,0,,我的作战计划太天真了
Dialogue: 0,0:06:36.26,0:06:37.42,Layzner,Gail,0,0,0,,被教训了啊
Dialogue: 0,0:06:37.43,0:06:38.70,Layzner,Egyle,0,0,0,,啊
Dialogue: 0,0:06:38.71,0:06:42.51,Layzner,Gail,0,0,0,,少尉 地球人的技术很不错吧
Dialogue: 0,0:06:43.04,0:06:45.68,Layzner,Egyle,0,0,0,,是我大意 我无话可说
Dialogue: 0,0:06:45.69,0:06:47.84,Layzner,Egyle,0,0,0,,现在我觉得十分惭愧
Dialogue: 0,0:06:49.29,0:06:52.02,Layzner,Egyle,0,0,0,,中尉 请再给我一次机会
Dialogue: 0,0:06:52.03,0:06:54.70,Layzner,Egyle,0,0,0,,我一定要发挥中尉您指导的实力
Dialogue: 0,0:07:01.00,0:07:02.09,Layzner,PilotA,0,0,0,,喂 听说了吗
Dialogue: 0,0:07:03.33,0:07:04.04,Layzner,PilotB,0,0,0,,什么
Dialogue: 0,0:07:04.05,0:07:06.55,Layzner,A,0,0,0,,卡露拉少尉好像还蛮爱面子
Dialogue: 0,0:07:06.84,0:07:07.92,Layzner,B,0,0,0,,是之前的事吗
Dialogue: 0,0:07:07.93,0:07:10.10,Layzner,A,0,0,0,,对 她好像在吃醋
Dialogue: 0,0:07:10.57,0:07:13.61,Layzner,A,0,0,0,,因为中尉的恋人是那个叛徒的姐姐
Dialogue: 0,0:07:17.18,0:07:19.32,Layzner,Arthur,0,0,0,,哇 被打中了 不行啦
Dialogue: 0,0:07:19.62,0:07:21.01,Layzner,Arthur,0,0,0,,救命啊
Dialogue: 0,0:07:22.73,0:07:25.01,Layzner,Arthur,0,0,0,,不行 太难啦
Dialogue: 0,0:07:28.26,0:07:29.58,Layzner,Com,0,0,0,,瞄准敌人
Dialogue: 0,0:07:32.56,0:07:37.58,Layzner,Com,0,0,0,,命中敌人 摧毁敌人 发射时机0.0050秒
Dialogue: 0,0:07:37.69,0:07:38.42,Layzner,Roanne,0,0,0,,知道了
Dialogue: 0,0:07:43.43,0:07:47.87,Layzner,Com,0,0,0,,命中关节部 误差0.02 部位差0.002
Dialogue: 0,0:07:48.94,0:07:49.53,Layzner,Roanne,0,0,0,,有问题
Dialogue: 0,0:07:49.54,0:07:50.09,Layzner,Com,0,0,0,,Ready.
Dialogue: 0,0:07:50.38,0:07:53.26,Layzner,Roanne,0,0,0,,他的准心都瞄准哪
Dialogue: 0,0:07:54.20,0:07:55.50,Layzner,Com,0,0,0,,关节部
Dialogue: 0,0:07:56.46,0:07:57.68,Layzner,Roanne,0,0,0,,他不打致命伤部位
Dialogue: 0,0:07:57.69,0:08:02.87,Layzner,Com,0,0,0,,他最常打的位置 关节部跟辅助喷射器
Dialogue: 0,0:08:06.94,0:08:08.15,Layzner,David,0,0,0,,又是脚啊
Dialogue: 0,0:08:15.52,0:08:16.83,Layzner,David,0,0,0,,你也发现了啊
Dialogue: 0,0:08:17.73,0:08:19.39,Layzner,Roanne,0,0,0,,谁都会发现的
Dialogue: 0,0:08:19.39,0:08:23.24,Layzner,Roanne,0,0,0,,那个影像是他到目前战斗的情况
Dialogue: 0,0:08:23.25,0:08:26.62,Layzner,Roanne,0,0,0,,我刚查过了 都有一个共同点
Dialogue: 0,0:08:27.11,0:08:30.91,Layzner,David,0,0,0,,他都没打敌人的致命伤 竟还能活到现在
Dialogue: 0,0:08:30.92,0:08:31.39,Layzner,Roanne,0,0,0,,是啊
Dialogue: 0,0:08:32.15,0:08:35.69,Layzner,Roanne,0,0,0,,不过这么一来就知道他那时丢掉武器的原因了
Dialogue: 0,0:08:40.15,0:08:43.15,Layzner,Arthur,0,0,0,,伤脑筋 果然我还是不行
Dialogue: 0,0:08:43.44,0:08:47.54,Layzner,David,0,0,0,,怎么了 你去练习了啊 是西蒙尼叫你去的吧
Dialogue: 0,0:08:47.54,0:08:49.33,Layzner,Arthur,0,0,0,,才不是
Dialogue: 0,0:08:49.51,0:08:51.77,Layzner,David,0,0,0,,她对你有意思吧
Dialogue: 0,0:08:51.78,0:08:52.83,Layzner,Arthur,0,0,0,,不会吧
Dialogue: 0,0:08:53.12,0:08:55.65,Layzner,David,0,0,0,,就是对你有意思才会鞭策你啊
Dialogue: 0,0:08:55.66,0:09:00.24,Layzner,Arthur,0,0,0,,你又随便乱说了 男生跟女生这种事
Dialogue: 0,0:09:00.51,0:09:04.57,Layzner,Arthur,0,0,0,,不可能说你叫我去做我就做吧
Dialogue: 0,0:09:05.27,0:09:08.83,Layzner,Arthur,0,0,0,,不过为了今后我还是把操纵练熟一点吧
Dialogue: 0,0:09:09.22,0:09:09.87,Layzner,Arthur,0,0,0,,就这么办
Dialogue: 0,0:09:11.27,0:09:12.85,Layzner,David,0,0,0,,他认真了
Dialogue: 0,0:09:12.86,0:09:14.15,Layzner,Roanne,0,0,0,,有什么不好
Dialogue: 0,0:09:14.16,0:09:17.54,Layzner,Roanne,0,0,0,,他一直都很悲观 让他有个希望也好
Dialogue: 0,0:09:17.55,0:09:18.52,Layzner,David,0,0,0,,说的也是
Dialogue: 0,0:09:18.91,0:09:19.76,Layzner,Arthur,0,0,0,,你们刚才在说什么吗
Dialogue: 0,0:09:20.05,0:09:21.21,Layzner,David,0,0,0,,没有啊
Dialogue: 0,0:09:21.41,0:09:21.93,Layzner,Arthur,0,0,0,,是哦
Dialogue: 0,0:09:34.86,0:09:38.38,Layzner,Simone,0,0,0,,是炖牛肉 太棒了
Dialogue: 0,0:09:38.39,0:09:40.34,Layzner,Simone,0,0,0,,安娜来一下 看我发现了什么
Dialogue: 0,0:09:41.17,0:09:41.74,Layzner,Anna,0,0,0,,怎么了
Dialogue: 0,0:09:42.91,0:09:43.85,Layzner,Simone,0,0,0,,你看
Dialogue: 0,0:09:44.35,0:09:46.32,Layzner,Simone,0,0,0,,这箱子里什么都有
Dialogue: 0,0:09:47.63,0:09:53.61,Layzner,Eiji,0,0,0,,古拉特斯对地球人在太空发展军事感到威胁性而准备攻击
Dialogue: 0,0:09:54.56,0:10:02.91,Layzner,Eiji,0,0,0,,现在古拉特斯准备地球在太空的威胁扩大前让地球人内讧并征服地球
Dialogue: 0,0:10:02.91,0:10:06.21,Layzner,Elizabeth,0,0,0,,让地球人内讧
Dialogue: 0,0:10:06.21,0:10:11.48,Layzner,Elizabeth,0,0,0,,一直以来为地球人所忽略的事却让远方的外星人感到威胁
Dialogue: 0,0:10:11.48,0:10:12.75,Layzner,Elizabeth,0,0,0,,太可怕了
Dialogue: 0,0:10:14.14,0:10:16.07,Layzner,Simone,0,0,0,,呐 你喜欢谁
Dialogue: 0,0:10:18.31,0:10:20.04,Layzner,Simone,0,0,0,,我是指在这的男生
Dialogue: 0,0:10:20.24,0:10:22.29,Layzner,Anna,0,0,0,,突然被你这么问
Dialogue: 0,0:10:22.30,0:10:24.15,Layzner,Simone,0,0,0,,你应该有想过吧
Dialogue: 0,0:10:24.86,0:10:26.24,Layzner,Anna,0,0,0,,可是 我
Dialogue: 0,0:10:27.22,0:10:28.79,Layzner,Anna,0,0,0,,那西蒙尼你呢
Dialogue: 0,0:10:28.96,0:10:31.10,Layzner,Simone,0,0,0,,我 我不行
Dialogue: 0,0:10:31.78,0:10:33.60,Layzner,Simone,0,0,0,,全部不是我喜欢的类型
Dialogue: 0,0:10:33.60,0:10:38.83,Layzner,Simone,0,0,0,,亚瑟不可靠 大卫爱耍帅 罗安比我小
Dialogue: 0,0:10:38.83,0:10:39.76,Layzner,Anna,0,0,0,,那那个人呢
Dialogue: 0,0:10:41.93,0:10:42.50,Layzner,Simone,0,0,0,,你说他
Dialogue: 0,0:10:43.45,0:10:43.95,Layzner,Anna,0,0,0,,嗯
Dialogue: 0,0:10:44.50,0:10:47.01,Layzner,Simone,0,0,0,,安娜你喜欢他是吗
Dialogue: 0,0:10:55.28,0:10:57.92,Layzner,Simone,0,0,0,,觉得一直穿这样好烦啊
Dialogue: 0,0:11:01.60,0:11:03.18,Layzner,Simone,0,0,0,,安娜
Dialogue: 0,0:11:03.18,0:11:04.34,Layzner,Simone,0,0,0,,你也脱嘛
Dialogue: 0,0:11:04.68,0:11:05.90,Layzner,Anna,0,0,0,,但是
Dialogue: 0,0:11:09.68,0:11:12.30,Layzner,Roanne,0,0,0,,把这里面的背包改变一下的话
Dialogue: 0,0:11:12.30,0:11:16.35,Layzner,Roanne,0,0,0,,他说这样就可以改变陆空宇的适性
Dialogue: 0,0:11:16.62,0:11:18.58,Layzner,David,0,0,0,,你还真行
Dialogue: 0,0:11:44.49,0:11:46.08,Layzner,Simone,0,0,0,,这样可爱吗
Dialogue: 0,0:11:47.62,0:11:51.19,Layzner,Simone,0,0,0,,你也脱嘛
Dialogue: 0,0:11:51.85,0:11:52.30,Layzner,Simone,0,0,0,,可以自由活动哦
Dialogue: 0,0:12:17.89,0:12:20.23,Layzner,David,0,0,0,,太空食物都吃腻了
Dialogue: 0,0:12:20.23,0:12:22.02,Layzner,David,0,0,0,,有时也要吃吃人做的
Dialogue: 0,0:12:25.75,0:12:26.98,Layzner,David,0,0,0,,这味道是什么
Dialogue: 0,0:12:28.09,0:12:28.99,Layzner,Arthur,0,0,0,,是奶油
Dialogue: 0,0:12:28.99,0:12:29.76,Layzner,David,0,0,0,,什么
Dialogue: 0,0:12:32.53,0:12:33.82,Layzner,David,0,0,0,,好香的味道
Dialogue: 0,0:12:36.88,0:12:37.89,Layzner,Arthur,0,0,0,,是真的耶
Dialogue: 0,0:12:39.00,0:12:41.30,Layzner,Arthur,0,0,0,,好久没吃到热的食物了
Dialogue: 0,0:12:41.30,0:12:41.95,Layzner,David,0,0,0,,对啊
Dialogue: 0,0:12:41.95,0:12:43.16,Layzner,Simone,0,0,0,,不能偷吃哦
Dialogue: 0,0:12:43.90,0:12:45.22,Layzner,David,0,0,0,,吃下有什么问题啊
Dialogue: 0,0:12:46.26,0:12:51.25,Layzner,Simone,0,0,0,,这东西是用罐头跟冷冻食物等很多东西辛苦做成的
Dialogue: 0,0:12:51.98,0:12:54.19,Layzner,Simone,0,0,0,,要穿正式的服装才行
Dialogue: 0,0:12:54.19,0:12:57.83,Layzner,Simone,0,0,0,,像你们那身野蛮的太空服 我们火星餐厅不欢迎
Dialogue: 0,0:12:58.52,0:13:02.90,Layzner,Arthur,0,0,0,,西蒙尼 你应该很清楚我们的处境
Dialogue: 0,0:13:02.90,0:13:05.73,Layzner,Arthur,0,0,0,,敌人不知道什么时候会来 可是你却
Dialogue: 0,0:13:05.73,0:13:07.76,Layzner,Simone,0,0,0,,不要说那种无聊的话
Dialogue: 0,0:13:07.76,0:13:12.43,Layzner,Simone,0,0,0,,中世纪的贵族 即使在战争中还是会盛装参加餐会
Dialogue: 0,0:13:12.73,0:13:16.82,Layzner,Arthur,0,0,0,,那是中世纪的贵族 跟现在的我们处境又不同
Dialogue: 0,0:13:16.83,0:13:19.41,Layzner,Simone,0,0,0,,你真的什么都不懂
Dialogue: 0,0:13:20.24,0:13:25.50,Layzner,Anna,0,0,0,,亚瑟 西蒙尼是因为不知道明天会怎么样才说现在要快乐的享受
Dialogue: 0,0:13:25.50,0:13:28.94,Layzner,David,0,0,0,,原来如此 好 我赞成
Dialogue: 0,0:13:28.94,0:13:29.98,Layzner,Roanne,0,0,0,,嗯 很合理
Dialogue: 0,0:13:31.24,0:13:34.99,Layzner,Arthur,0,0,0,,对啊 我也觉得这身装扮不好
Dialogue: 0,0:13:42.33,0:13:46.50,Layzner,Anna,0,0,0,,请去那边换衣服 这里有吃的 打翻就不好了
Dialogue: 0,0:13:47.62,0:13:51.10,Layzner,Elizabeth,0,0,0,,今天就到这吧 差不多该吃饭了
Dialogue: 0,0:13:51.11,0:13:51.58,Layzner,Eiji,0,0,0,,好
Dialogue: 0,0:13:58.36,0:14:00.03,Layzner,Elizabeth,0,0,0,,你们在干嘛
Dialogue: 0,0:14:00.45,0:14:02.52,Layzner,Simone,0,0,0,,欢迎来到火星餐厅
Dialogue: 0,0:14:03.67,0:14:04.14,Layzner,Elizabeth,0,0,0,,？
Dialogue: 0,0:14:06.19,0:14:09.96,Layzner,Roanne,0,0,0,,博士 本餐厅禁止正式服装以外的装扮
Dialogue: 0,0:14:10.88,0:14:11.70,Layzner,Roanne,0,0,0,,那么我失礼了
Dialogue: 0,0:14:13.21,0:14:14.34,Layzner,Roanne,0,0,0,,对不起
Dialogue: 0,0:14:16.53,0:14:17.38,Layzner,Roanne,0,0,0,,好痛
Dialogue: 0,0:14:17.91,0:14:19.82,Layzner,Elizabeth,0,0,0,,笨蛋 你在干嘛
Dialogue: 0,0:14:19.83,0:14:22.98,Layzner,Roanne,0,0,0,,不 因为博士你太漂亮了 抱歉
Dialogue: 0,0:14:27.56,0:14:29.39,Layzner,David,0,0,0,,对啊 你也脱嘛
Dialogue: 0,0:14:29.40,0:14:30.17,Layzner,David,0,0,0,,来吧
Dialogue: 0,0:14:31.09,0:14:34.12,Layzner,Simone,0,0,0,,对啊 快把那臭死人的太空服脱了吧
Dialogue: 0,0:14:34.88,0:14:35.89,Layzner,David,0,0,0,,大家快来帮忙
Dialogue: 0,0:14:36.43,0:14:37.91,Layzner,Simone,0,0,0,,亚瑟你也去帮忙啊
Dialogue: 0,0:14:38.06,0:14:38.73,Layzner,Eiji,0,0,0,,住 住手
Dialogue: 0,0:14:38.85,0:14:39.60,Layzner,Arthur,0,0,0,,好
Dialogue: 0,0:14:40.41,0:14:40.96,Layzner,Roanne,0,0,0,,看我的
Dialogue: 0,0:14:43.46,0:14:44.06,Layzner,Eiji,0,0,0,,住手 等一下
Dialogue: 0,0:14:45.50,0:14:47.33,Layzner,David,0,0,0,,好了 英二 不要反抗
Dialogue: 0,0:14:49.03,0:14:50.94,Layzner,Roanne,0,0,0,,亚瑟 快把他的鞋子脱了
Dialogue: 0,0:14:50.94,0:14:52.99,Layzner,Arthur,0,0,0,,不要这么不干脆 英二
Dialogue: 0,0:14:54.82,0:14:59.31,Layzner,Anna,0,0,0,,大家不知何时开始叫他英二了
Dialogue: 0,0:15:04.93,0:15:10.91,Layzner,Anna,0,0,0,,好久没这样了 忘了何时敌人会来的紧张感
Dialogue: 0,0:15:10.92,0:15:13.11,Layzner,Anna,0,0,0,,在轻松的话题中用餐
Dialogue: 0,0:15:14.10,0:15:17.18,Layzner,Anna,0,0,0,,博士也很轻松
Dialogue: 0,0:15:17.18,0:15:19.16,Layzner,Anna,0,0,0,,露出了一点胸部
Dialogue: 0,0:15:20.10,0:15:23.58,Layzner,Anna,0,0,0,,还有我看到了
Dialogue: 0,0:15:23.58,0:15:25.53,Layzner,Anna,0,0,0,,头一次看到他的笑容
Dialogue: 0,0:15:26.52,0:15:27.92,Layzner,Arthur,0,0,0,,还能再来一碗吗 西蒙尼
Dialogue: 0,0:15:28.57,0:15:31.14,Layzner,Simone,0,0,0,,好啊 还有很多 自己来别客气
Dialogue: 0,0:15:31.28,0:15:34.15,Layzner,David,0,0,0,,不行 他会吃光的
Dialogue: 0,0:15:35.76,0:15:37.40,Layzner,David,0,0,0,,西蒙尼 你帮他弄吧
Dialogue: 0,0:15:37.91,0:15:39.58,Layzner,Arthur,0,0,0,,西蒙尼 麻烦你了
Dialogue: 0,0:16:16.74,0:16:19.30,Layzner,Egyle,0,0,0,,开始攻击 请放出干扰电波
Dialogue: 0,0:16:19.30,0:16:20.48,Layzner,Gail(?),0,0,0,,我知道了 拜托了
Dialogue: 0,0:16:25.78,0:16:26.48,Layzner,Eiji,0,0,0,,你们
Dialogue: 0,0:16:27.10,0:16:29.71,Layzner,David,0,0,0,,阻止我们也没用 让我们一起去吧
Dialogue: 0,0:16:29.96,0:16:32.99,Layzner,Eiji,0,0,0,,我知道了 但战斗中要听我指挥
Dialogue: 0,0:16:33.17,0:16:34.01,Layzner,David,0,0,0,,好
Dialogue: 0,0:16:34.01,0:16:34.56,Layzner,Roanne,0,0,0,,当然
Dialogue: 0,0:16:35.72,0:16:36.94,Layzner,Elizabeth,0,0,0,,他们
Dialogue: 0,0:16:38.57,0:16:40.73,Layzner,Arthur,0,0,0,,没事的 这里有我在
Dialogue: 0,0:16:40.95,0:16:41.73,Layzner,Elizabeth,0,0,0,,说的也是
Dialogue: 0,0:16:42.43,0:16:45.17,Layzner,Elizabeth,0,0,0,,那你保护他们两个去通信室
Dialogue: 0,0:16:45.17,0:16:46.55,Layzner,Elizabeth,0,0,0,,我去航天飞机
Dialogue: 0,0:16:47.19,0:16:48.21,Layzner,Arthur,0,0,0,,是
Dialogue: 0,0:16:48.21,0:16:49.20,Layzner,Simone,0,0,0,,我们先走了
Dialogue: 0,0:16:54.21,0:16:55.14,Layzner,Eiji,0,0,0,,报告状况
Dialogue: 0,0:16:55.14,0:16:58.03,Layzner,Rey,0,0,0,,有三架SPT从上空快速入侵
Dialogue: 0,0:16:58.03,0:17:01.09,Layzner,Eiji,0,0,0,,只有这样而已吗 之前明明还有地面用机器人的
Dialogue: 0,0:17:01.67,0:17:03.59,Layzner,David,0,0,0,,我准备好可以出发了
Dialogue: 0,0:17:03.59,0:17:04.75,Layzner,David,0,0,0,,我先出发了
Dialogue: 0,0:17:04.75,0:17:05.48,Layzner,Eiji,0,0,0,,等一下 大卫
Dialogue: 0,0:17:13.15,0:17:15.90,Layzner,Eiji,0,0,0,,罗安 你别过来 原地保护航天飞机
Dialogue: 0,0:17:15.90,0:17:16.82,Layzner,Roanne,0,0,0,,我知道了
Dialogue: 0,0:17:17.09,0:17:19.26,Layzner,Eiji,0,0,0,,大卫 停下 快回来
Dialogue: 0,0:17:19.26,0:17:19.90,Layzner,Eiji,0,0,0,,怎么了
Dialogue: 0,0:17:20.13,0:17:21.50,Layzner,Rey,0,0,0,,有干扰电波
Dialogue: 0,0:17:21.68,0:17:22.63,Layzner,Eiji,0,0,0,,什么
Dialogue: 0,0:17:22.63,0:17:24.36,Layzner,Eiji,0,0,0,,大卫 你听到了吗 大卫
Dialogue: 0,0:17:25.60,0:17:27.82,Layzner,Eiji,0,0,0,,这是特别针对技术不成熟的他们两人的作战吗
Dialogue: 0,0:17:28.48,0:17:31.74,Layzner,Eiji,0,0,0,,是以对付他们为主的作战方式 这样下去的话
Dialogue: 0,0:17:32.87,0:17:33.50,Layzner,Eiji,0,0,0,,大卫
Dialogue: 0,0:17:33.89,0:17:36.61,Layzner,David,0,0,0,,这是什么 怎么了 坏了吗
Dialogue: 0,0:17:37.10,0:17:38.93,Layzner,David,0,0,0,,英二 听得到吗 英二
Dialogue: 0,0:17:38.98,0:17:41.40,Layzner,Com,0,0,0,,因为电波干扰 无法使用无线电
Dialogue: 0,0:17:41.85,0:17:44.54,Layzner,David,0,0,0,,冷静 要冷静
Dialogue: 0,0:17:44.54,0:17:45.04,Layzner,David,0,0,0,,找到了
Dialogue: 0,0:17:50.33,0:17:52.90,Layzner,Egyle,0,0,0,,来了 这次一定干掉你
Dialogue: 0,0:17:57.81,0:17:58.82,Layzner,David,0,0,0,,让我来
Dialogue: 0,0:18:04.90,0:18:07.06,Layzner,David,0,0,0,,想逃是吗 不让你逃
Dialogue: 0,0:18:08.64,0:18:09.54,Layzner,Eiji,0,0,0,,住手 不要去
Dialogue: 0,0:18:28.03,0:18:29.87,Layzner,Simone,0,0,0,,真讨厌 这么安静
Dialogue: 0,0:18:33.24,0:18:34.36,Layzner,Elizabeth,0,0,0,,听得到吗 罗安
Dialogue: 0,0:18:39.77,0:18:42.76,Layzner,,0,0,0,,{\pos(321,408)}Buldy
Dialogue: 0,0:18:44.54,0:18:46.16,Layzner,Roanne,0,0,0,,什么都看不到
Dialogue: 0,0:18:49.12,0:18:52.08,Layzner,,0,0,0,,{\pos(324,403)}Dtol
Dialogue: 0,0:18:53.42,0:18:54.54,Layzner,Roanne,0,0,0,,有三机
Dialogue: 0,0:19:06.55,0:19:08.30,Layzner,Roanne,0,0,0,,越想说不要慌就越慌
Dialogue: 0,0:19:21.16,0:19:23.74,Layzner,Elizabeth,0,0,0,,罗安 航天飞机没事 快启动逃走
Dialogue: 0,0:19:24.04,0:19:25.42,Layzner,Roanne,0,0,0,,往哪逃啊
Dialogue: 0,0:19:29.80,0:19:32.91,Layzner,Simone,0,0,0,,这样下去罗安会被干掉的
Dialogue: 0,0:19:33.47,0:19:34.40,Layzner,Simone,0,0,0,,不想办法不行
Dialogue: 0,0:19:35.70,0:19:36.59,Layzner,Arthur,0,0,0,,我也
Dialogue: 0,0:19:38.97,0:19:39.80,Layzner,Simone,0,0,0,,亚瑟
Dialogue: 0,0:19:42.44,0:19:44.07,Layzner,Elizabeth,0,0,0,,没有炮吗 要按哪里
Dialogue: 0,0:19:44.07,0:19:45.78,Layzner,Com,0,0,0,,请按右边的按键
Dialogue: 0,0:19:55.83,0:19:57.36,Layzner,Elizabeth,0,0,0,,那一个键才能发射
Dialogue: 0,0:19:57.50,0:19:59.24,Layzner,Com,0,0,0,,请按黄色键
Dialogue: 0,0:19:59.81,0:20:01.91,Layzner,Arthur,0,0,0,,博士 我也来帮忙
Dialogue: 0,0:20:07.32,0:20:08.50,Layzner,Roanne,0,0,0,,可恶
Dialogue: 0,0:20:22.25,0:20:25.62,Layzner,,0,0,0,,{\pos(324,410)}Baybull
Dialogue: 0,0:20:28.73,0:20:31.13,Layzner,David,0,0,0,,你想逃到哪 来跟我打啊
Dialogue: 0,0:20:34.77,0:20:36.55,Layzner,Eiji,0,0,0,,剩下的两架跑去哪了
Dialogue: 0,0:20:40.01,0:20:42.17,Layzner,David,0,0,0,,没事嘛 他们根本也不打过来
Dialogue: 0,0:20:46.57,0:20:47.81,Layzner,Rey,0,0,0,,上方有敌人
Dialogue: 0,0:20:47.81,0:20:48.37,Layzner,Eiji,0,0,0,,上方是吗
Dialogue: 0,0:20:50.00,0:20:50.96,Layzner,Rey,0,0,0,,下方有敌人
Dialogue: 0,0:20:51.29,0:20:52.35,Layzner,Eiji,0,0,0,,不好了 下面也有是吗
Dialogue: 0,0:21:06.75,0:21:07.71,Layzner,Eiji,0,0,0,,大卫
Dialogue: 0,0:21:08.57,0:21:09.20,Layzner,Eiji,0,0,0,,走开
Dialogue: 0,0:21:37.89,0:21:39.62,Layzner,Com,0,0,0,,情报信息
Dialogue: 0,0:21:39.63,0:21:43.14,Layzner,Com,0,0,0,,母舰有特别电波进入 干扰电波解除
Dialogue: 0,0:21:43.31,0:21:44.15,Layzner,Egyle,0,0,0,,什么
Dialogue: 0,0:21:44.15,0:21:46.99,Layzner,Gail,0,0,0,,少尉 终止作战 马上回来
Dialogue: 0,0:21:47.17,0:21:50.44,Layzner,Egyle,0,0,0,,为什么 中尉 还差一点我就成功了
Dialogue: 0,0:21:50.44,0:21:52.05,Layzner,Gail,0,0,0,,这是命令 快回来
Dialogue: 0,0:21:52.41,0:21:55.81,Layzner,Egyle,0,0,0,,中尉 果然你对英二还是有特别的感情
Dialogue: 0,0:21:55.81,0:21:56.92,Layzner,Gail,0,0,0,,不
Dialogue: 0,0:21:56.92,0:21:57.87,Layzner,Gail,0,0,0,,不是这样的
Dialogue: 0,0:21:59.12,0:22:03.16,Layzner,Gail,0,0,0,,好像是地球的太空船往这来了 这里没人保护
Dialogue: 0,0:22:03.46,0:22:04.47,Layzner,Gail,0,0,0,,马上回来
Dialogue: 0,0:22:06.77,0:22:08.89,Layzner,Gail,0,0,0,,听到了没 少尉 卡露拉少尉
Dialogue: 0,0:22:09.28,0:22:10.80,Layzner,Egyle,0,0,0,,了解 马上回去
Dialogue: 0,0:22:21.24,0:22:23.23,Layzner,Roanne,0,0,0,,走了 他们走了
Dialogue: 0,0:22:23.73,0:22:24.37,Layzner,Roanne,0,0,0,,为什么
Dialogue: 0,0:22:27.68,0:22:30.33,Layzner,Eiji,0,0,0,,为什么他们回去了
Dialogue: 0,0:22:32.34,0:22:35.89,Layzner,Elizabeth,0,0,0,,亚瑟 你来得正是时候 托你的福得救了
Dialogue: 0,0:22:35.89,0:22:36.98,Layzner,Arthur,0,0,0,,不
Dialogue: 0,0:22:37.35,0:22:38.58,Layzner,Eiji,0,0,0,,罗安 你没事吗
Dialogue: 0,0:22:39.83,0:22:40.45,Layzner,Roanne,0,0,0,,我没事
Dialogue: 0,0:22:43.52,0:22:45.67,Layzner,Anna,0,0,0,,这时候的我们
Dialogue: 0,0:22:45.67,0:22:50.37,Layzner,Anna,0,0,0,,根本就不知道 有地球的太空船接近了
Dialogue: 0,0:23:55.27,0:23:56.41,Layzner,Trailer,0,0,0,,地球的船
Dialogue: 0,0:23:56.41,0:23:57.73,Layzner,Trailer,0,0,0,,是军舰吗
Dialogue: 0,0:23:57.73,0:23:58.95,Layzner,Trailer,0,0,0,,太好了
Dialogue: 0,0:23:58.95,0:24:00.57,Layzner,Trailer,0,0,0,,到底发生什么事
Dialogue: 0,0:24:00.57,0:24:02.27,Layzner,Trailer,0,0,0,,外星人的机动部队接近中
Dialogue: 0,0:24:02.27,0:24:03.49,Layzner,Trailer,0,0,0,,吃我一招
Dialogue: 0,0:24:03.49,0:24:04.89,Layzner,Trailer,0,0,0,,不要让他逃了
Dialogue: 0,0:24:04.89,0:24:07.97,Layzner,,0,0,0,,下一集 地球的船来了

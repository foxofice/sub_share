Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:01.35,0:01:03.81,Layzner,Egyle,0,0,0,,地球的船 是军舰吗
Dialogue: 0,0:01:03.85,0:01:04.89,Layzner,Arthur,0,0,0,,成功了
Dialogue: 0,0:01:04.97,0:01:07.48,Layzner,Carks,0,0,0,,到底发生什么了
Dialogue: 0,0:01:08.10,0:01:10.24,Layzner,David,0,0,0,,住手 他是我们的人
Dialogue: 0,0:01:41.87,0:01:43.60,Layzner,David,0,0,0,,大家来帮帮我
Dialogue: 0,0:01:43.62,0:01:47.23,Layzner,Simone,0,0,0,,亚瑟你们也去帮忙
Dialogue: 0,0:01:47.24,0:01:52.46,Layzner,Anna,0,0,0,,阻隔在那个人与大家中间的坚冰终于融化了
Dialogue: 0,0:01:52.47,0:01:54.05,Layzner,David,0,0,0,,好了英二 不要反抗
Dialogue: 0,0:01:55.38,0:01:57.57,Layzner,Roanne,0,0,0,,亚瑟 把英二的鞋脱掉
Dialogue: 0,0:01:57.58,0:01:59.53,Layzner,Arthur,0,0,0,,不要再挣扎了 英二
Dialogue: 0,0:02:01.11,0:02:05.96,Layzner,Anna,0,0,0,,但是古拉特斯的威胁并没有因此消失
Dialogue: 0,0:02:06.41,0:02:14.30,Layzner,Anna,0,0,0,,大卫 罗安 还有亚瑟都被卷入这场战争中了
Dialogue: 0,0:02:16.05,0:02:20.85,Layzner,,0,0,0,,第十一话 地球的船来了
Dialogue: 0,0:02:35.28,0:02:36.21,Layzner,Eiji,0,0,0,,没事吧
Dialogue: 0,0:02:39.04,0:02:40.87,Layzner,David,0,0,0,,做得不错嘛
Dialogue: 0,0:02:41.50,0:02:42.55,Layzner,Elizabeth,0,0,0,,大家都没事吗
Dialogue: 0,0:02:42.63,0:02:45.41,Layzner,Arthur,0,0,0,,再差一点就要被干掉了 真是让人捏了一把汗
Dialogue: 0,0:02:45.64,0:02:48.57,Layzner,David,0,0,0,,本来还想好好教训一下的 却被他逃了
Dialogue: 0,0:02:48.57,0:02:52.93,Layzner,Elizabeth,0,0,0,,大卫 你对操纵还不熟 不要乱来 知道了吗
Dialogue: 0,0:02:52.93,0:02:54.14,Layzner,David,0,0,0,,我知道了啦
Dialogue: 0,0:02:54.85,0:02:57.20,Layzner,Arthur,0,0,0,,罗安 你在干嘛
Dialogue: 0,0:02:58.84,0:03:00.51,Layzner,Roanne,0,0,0,,手终于不抖了
Dialogue: 0,0:03:00.58,0:03:04.44,Layzner,Arthur,0,0,0,,什么啊 原来你吓成这样 可是你操纵的很好啊
Dialogue: 0,0:03:05.47,0:03:06.66,Layzner,David,0,0,0,,去里面休息吧
Dialogue: 0,0:03:06.66,0:03:09.06,Layzner,Arthur,0,0,0,,等 等
Dialogue: 0,0:03:11.24,0:03:14.39,Layzner,Arthur,0,0,0,,别生气 我不小心说溜嘴而已
Dialogue: 0,0:03:15.66,0:03:19.41,Layzner,Elizabeth,0,0,0,,话说回来 为什么敌人会终止攻击呢
Dialogue: 0,0:03:19.83,0:03:20.75,Layzner,Eiji,0,0,0,,我不知道
Dialogue: 0,0:03:22.65,0:03:27.70,Layzner,Elizabeth,0,0,0,,说不定哪一天敌人进攻再进攻的时候也许只有祈祷的份了
Dialogue: 0,0:03:28.27,0:03:30.03,Layzner,Anna,0,0,0,,伊丽莎白博士
Dialogue: 0,0:03:43.90,0:03:45.38,Layzner,Elizabeth,0,0,0,,真的接通通信了吗
Dialogue: 0,0:03:45.51,0:03:48.82,Layzner,Simone,0,0,0,,对 有从美军基地来的通信
Dialogue: 0,0:03:49.02,0:03:49.94,Layzner,David,0,0,0,,从哪里发出来的
Dialogue: 0,0:03:49.94,0:03:53.62,Layzner,Simone,0,0,0,,不知道 杂音太大了 可是我真的有听到
Dialogue: 0,0:03:53.68,0:03:55.66,Layzner,Arthur,0,0,0,,得救了 他们来救我们了
Dialogue: 0,0:03:55.89,0:03:58.06,Layzner,Elizabeth,0,0,0,,有可能会被敌人先收到
Dialogue: 0,0:03:58.06,0:04:00.05,Layzner,,0,0,0,,要赶快捕捉这通信电波
Dialogue: 0,0:04:00.05,0:04:01.46,Layzner,Arthur,0,0,0,,我来
Dialogue: 0,0:04:02.22,0:04:05.19,Layzner,Roanne,0,0,0,,这么说妨碍电波已经解除了吗
Dialogue: 0,0:04:06.02,0:04:07.92,Layzner,Eiji,0,0,0,,古拉特斯的母舰移动了
Dialogue: 0,0:04:08.54,0:04:09.66,Layzner,Elizabeth,0,0,0,,母舰移动了
Dialogue: 0,0:04:10.14,0:04:13.20,Layzner,Eiji,0,0,0,,已经开始对地球的攻击了也说不定
Dialogue: 0,0:04:13.20,0:04:15.98,Layzner,Arthur,0,0,0,,这里是无人观测基地 请回答
Dialogue: 0,0:04:15.98,0:04:18.81,Layzner,Arthur,0,0,0,,这里是无人观测基地 请回答
Dialogue: 0,0:04:18.81,0:04:20.80,Layzner,Arthur,0,0,0,,这里是无人观测基地
Dialogue: 0,0:04:24.08,0:04:26.23,Layzner,Man A,0,0,0,,队长 这是接近中的飞行物体
Dialogue: 0,0:04:26.90,0:04:30.14,Layzner,Gail,0,0,0,,好像是地球的船 用电脑分析一下
Dialogue: 0,0:04:30.14,0:04:30.84,Layzner,Man A,0,0,0,,是
Dialogue: 0,0:04:30.84,0:04:32.84,Layzner,Egyle,0,0,0,,凯利中尉
Dialogue: 0,0:04:33.83,0:04:36.76,Layzner,Gail,0,0,0,,卡露拉少尉 主雷达捕捉到了地球的船
Dialogue: 0,0:04:36.76,0:04:39.16,Layzner,Egyle,0,0,0,,地球的船 是军舰吗
Dialogue: 0,0:04:39.58,0:04:40.77,Layzner,Gail,0,0,0,,有可能
Dialogue: 0,0:04:40.77,0:04:43.94,Layzner,Man A,0,0,0,,那船很明显是朝火星来的
Dialogue: 0,0:04:44.21,0:04:47.10,Layzner,Gail,0,0,0,,听到了吗 马上接近那艘船
Dialogue: 0,0:04:47.10,0:04:49.66,Layzner,Eygle,0,0,0,,了解 请告诉我方位
Dialogue: 0,0:04:49.82,0:04:51.48,Layzner,Gail,0,0,0,,在12号位置
Dialogue: 0,0:04:51.68,0:04:55.56,Layzner,Gail,0,0,0,,推测需要时间15秒02误差0.01秒
Dialogue: 0,0:04:55.56,0:04:57.24,Layzner,Gail,0,0,0,,不过这是以我这的雷达为准
Dialogue: 0,0:04:57.24,0:04:59.37,Layzner,Eygle,0,0,0,,了解 全机向该船前进
Dialogue: 0,0:04:59.37,0:05:00.17,Layzner,Pilots,0,0,0,,了解
Dialogue: 0,0:05:08.31,0:05:11.47,Layzner,Gail,0,0,0,,他们的目的 我一定会给他们预期以上的结果的
Dialogue: 0,0:05:25.96,0:05:27.57,Layzner,Man,0,0,0,,请回答 火星基地 请回答
Dialogue: 0,0:05:27.57,0:05:28.63,Layzner,Arthur,0,0,0,,成功了
Dialogue: 0,0:05:31.99,0:05:36.39,Layzner,Man,0,0,0,,这里是美国太空舰队定期运输船阿斯洛托法克二号 请回答
Dialogue: 0,0:05:36.39,0:05:37.38,Layzner,Roanne,0,0,0,,太好了
Dialogue: 0,0:05:37.94,0:05:42.27,Layzner,Man,0,0,0,,这里是美国太空舰队定期运输船阿斯洛托法克二号 请回答
Dialogue: 0,0:05:42.27,0:05:44.92,Layzner,Arthur,0,0,0,,美军的船来了
Dialogue: 0,0:05:44.92,0:05:46.18,Layzner,Man,0,0,0,,请回答
Dialogue: 0,0:05:46.18,0:05:47.68,Layzner,Arthur,0,0,0,,我们能回家了
Dialogue: 0,0:05:47.68,0:05:49.55,Layzner,Man,0,0,0,,有人吗 请回答
Dialogue: 0,0:05:49.65,0:05:50.64,Layzner,Elizabeth,0,0,0,,安静一点
Dialogue: 0,0:05:51.57,0:05:54.24,Layzner,Elizabeth,0,0,0,,这里是火星基地 阿斯洛托法克二号 听到了吗
Dialogue: 0,0:05:54.56,0:05:58.75,Layzner,Elizabeth,0,0,0,,这里是火星基地 我是联合国的伊丽莎白博士
Dialogue: 0,0:05:59.97,0:06:00.79,Layzner,Man B,0,0,0,,联络上了吗
Dialogue: 0,0:06:00.79,0:06:01.49,Layzner,Man C,0,0,0,,是
Dialogue: 0,0:06:01.50,0:06:02.49,Layzner,Man D,0,0,0,,好像是个女的
Dialogue: 0,0:06:02.49,0:06:07.15,Layzner,Roger,0,0,0,,我是罗吉亚大尉 伊丽莎白博士 你是火星的女神吗
Dialogue: 0,0:06:07.38,0:06:11.34,Layzner,Roger,0,0,0,,好性感的声音 你应该是金发碧眼对吧
Dialogue: 0,0:06:11.34,0:06:12.09,Layzner,Elizabeth,0,0,0,,罗吉亚大卫
Dialogue: 0,0:06:12.09,0:06:13.13,Layzner,Roger,0,0,0,,真想马上飞到你身边
Dialogue: 0,0:06:15.05,0:06:19.22,Layzner,Elizabeth,0,0,0,,不要再开玩笑 有很多死者的灵魂在听你说话
Dialogue: 0,0:06:19.22,0:06:20.76,Layzner,Roger,0,0,0,,很多死者
Dialogue: 0,0:06:22.41,0:06:23.32,Layzner,Carks,0,0,0,,换我来
Dialogue: 0,0:06:24.14,0:06:27.24,Layzner,Carks,0,0,0,,我是队长丹尼少佐 我想问一下
Dialogue: 0,0:06:27.55,0:06:31.70,Layzner,Carks,0,0,0,,我们的基地跟苏联基地都没反应 到底发生了什么
Dialogue: 0,0:06:31.70,0:06:35.94,Layzner,Elizabeth,0,0,0,,美苏基地因为彼此的核弹在一瞬间毁灭了
Dialogue: 0,0:06:36.12,0:06:38.03,Layzner,Carks,0,0,0,,你说什么 怎么可能
Dialogue: 0,0:06:38.21,0:06:40.42,Layzner,Elizabeth,0,0,0,,是真的 两个基地都毁了
Dialogue: 0,0:06:40.42,0:06:41.95,Layzner,Roger,0,0,0,,一定是苏联的错
Dialogue: 0,0:06:41.95,0:06:43.28,Layzner,Man B,0,0,0,,又来挑衅了
Dialogue: 0,0:06:43.28,0:06:46.24,Layzner,Elizabeth,0,0,0,,不是这样的 起因是因为外星人的介入
Dialogue: 0,0:06:47.75,0:06:49.20,Layzner,Carks,0,0,0,,什么介入
Dialogue: 0,0:06:49.44,0:06:53.58,Layzner,Elizabeth,0,0,0,,是别的星球来的生命体 也就是外星人的介入
Dialogue: 0,0:06:53.58,0:06:54.48,Layzner,Carks,0,0,0,,外星人
Dialogue: 0,0:06:54.53,0:06:55.35,Layzner,Roger,0,0,0,,说什么傻话
Dialogue: 0,0:07:03.64,0:07:06.29,Layzner,Elizabeth,0,0,0,,虽然很难令人相信 但这是事实
Dialogue: 0,0:07:08.26,0:07:10.80,Layzner,Eiji,0,0,0,,伊丽莎白博士 马上请他们戒备
Dialogue: 0,0:07:11.67,0:07:15.74,Layzner,Eiji,0,0,0,,他们会停止对我们的攻击 说不定是捕捉到地球的船了
Dialogue: 0,0:07:16.64,0:07:21.31,Layzner,Elizabeth,0,0,0,,丹尼少佐 外星人可能已经捕捉到你们的船了 请马上戒备
Dialogue: 0,0:07:21.31,0:07:22.75,Layzner,Carks,0,0,0,,不用了
Dialogue: 0,0:07:22.75,0:07:25.88,Layzner,Carks,0,0,0,,我们虽然是运输舰 但还是军舰 我们有武装的
Dialogue: 0,0:07:26.44,0:07:27.43,Layzner,Arthur,0,0,0,,没问题
Dialogue: 0,0:07:27.57,0:07:28.89,Layzner,Carks,0,0,0,,请继续报告
Dialogue: 0,0:07:28.89,0:07:31.52,Layzner,Elizabeth,0,0,0,,现在我们也被外星人盯上了
Dialogue: 0,0:07:31.52,0:07:35.92,Layzner,Elizabeth,0,0,0,,存活下来的只有我和参加太空体验计划的少年五人
Dialogue: 0,0:07:35.92,0:07:38.36,Layzner,Elizabeth,0,0,0,,不 包括英二共六人
Dialogue: 0,0:07:38.67,0:07:40.14,Layzner,Carks,0,0,0,,英二 他是谁
Dialogue: 0,0:07:40.44,0:07:42.04,Layzner,Elizabeth,0,0,0,,他是地球人跟外星人的混血儿
Dialogue: 0,0:07:44.17,0:07:45.53,Layzner,Carks,0,0,0,,混血
Dialogue: 0,0:07:45.53,0:07:48.06,Layzner,Elizabeth,0,0,0,,现在没时间解释 之后慢慢说明
Dialogue: 0,0:07:48.24,0:07:51.21,Layzner,Elizabeth,0,0,0,,丹尼少佐 请马上来救我们
Dialogue: 0,0:07:51.21,0:07:52.75,Layzner,Carks,0,0,0,,我知道了 等一下
Dialogue: 0,0:07:55.83,0:07:58.13,Layzner,Arthur,0,0,0,,成功了 可以回地球了
Dialogue: 0,0:07:58.13,0:08:02.24,Layzner,Arthur,0,0,0,,每天都看这个 我都看烦了
Dialogue: 0,0:07:58.13,0:08:02.24,Layzner,Arthur,0,0,0,,可以不用一直看这边红色的天空了
Dialogue: 0,0:08:01.56,0:08:02.24,Layzner,David,0,0,0,,英二呢
Dialogue: 0,0:08:02.24,0:08:03.50,Layzner,Anna,0,0,0,,出去了
Dialogue: 0,0:08:03.50,0:08:04.67,Layzner,David,0,0,0,,出去了
Dialogue: 0,0:08:05.82,0:08:06.69,Layzner,David,0,0,0,,那家伙
Dialogue: 0,0:08:06.72,0:08:08.51,Layzner,Arthur,0,0,0,,这样终于能回家了
Dialogue: 0,0:08:10.55,0:08:12.51,Layzner,Eiji,0,0,0,,告诉我地球的船的位置跟情况
Dialogue: 0,0:08:12.51,0:08:16.04,Layzner,Rey,0,0,0,,Ready. 在05号位置 好像要进入大气层
Dialogue: 0,0:08:16.04,0:08:19.22,Layzner,Rey,0,0,0,,预测接触时间最少也要六秒
Dialogue: 0,0:08:19.22,0:08:19.92,Layzner,Eiji,0,0,0,,好
Dialogue: 0,0:08:30.31,0:08:31.42,Layzner,Com,0,0,0,,目标捕捉
Dialogue: 0,0:08:31.42,0:08:33.72,Layzner,Com,0,0,0,,在02号位置 准备进入第三区域
Dialogue: 0,0:08:33.94,0:08:37.37,Layzner,Roger?,0,0,0,,他说外星人的混血 她脑子是不是有问题
Dialogue: 0,0:08:37.37,0:08:39.93,Layzner,A,0,0,0,,那叫宇宙精神综合征
Dialogue: 0,0:08:39.93,0:08:42.85,Layzner,Carks,0,0,0,,总之 有发生异状是没错的
Dialogue: 0,0:08:42.85,0:08:45.68,Layzner,Carks,0,0,0,,因为该异状让我军跟其他基地都失去消息
Dialogue: 0,0:08:46.80,0:08:49.24,Layzner,Carks,0,0,0,,我搭航天飞机去确认一下
Dialogue: 0,0:08:49.48,0:08:52.38,Layzner,B,0,0,0,,队长 马上进入N62轨道了
Dialogue: 0,0:08:52.38,0:08:54.66,Layzner,Carks,0,0,0,,我知道了 我搭航天飞机去
Dialogue: 0,0:08:55.09,0:08:56.05,Layzner,Carks,0,0,0,,你们的位置呢
Dialogue: 0,0:08:56.63,0:08:58.96,Layzner,Elizabeth,0,0,0,,离美军基地很近的无人观测基地
Dialogue: 0,0:08:58.96,0:09:02.16,Layzner,Carks,0,0,0,,了解 那等会见 请保持通讯
Dialogue: 0,0:09:02.16,0:09:03.09,Layzner,Elizabeth,0,0,0,,知道了
Dialogue: 0,0:09:03.38,0:09:07.71,Layzner,Arthur,0,0,0,,太好了 可以安心了 大家回地球吧
Dialogue: 0,0:09:08.56,0:09:10.51,Layzner,Arthur,0,0,0,,奇怪 大卫他们呢
Dialogue: 0,0:09:10.51,0:09:13.71,Layzner,Simone,0,0,0,,你到现在才发现啊 你好迟钝
Dialogue: 0,0:09:13.71,0:09:16.77,Layzner,Anna,0,0,0,,他们一定是要去保护地球的军舰
Dialogue: 0,0:09:16.77,0:09:20.85,Layzner,Arthur,0,0,0,,可是他们去的话 一定会被当成敌人的
Dialogue: 0,0:09:21.65,0:09:23.02,Layzner,Roger,0,0,0,,这里是阿斯洛托法克二号
Dialogue: 0,0:09:23.02,0:09:23.72,Layzner,Elizabeth,0,0,0,,是
Dialogue: 0,0:09:23.90,0:09:25.93,Layzner,Roger,0,0,0,,现在丹尼少佐搭太空船去救你门了
Dialogue: 0,0:09:25.93,0:09:29.50,Layzner,Elizabeth,0,0,0,,我知道了 你们可以跟地球或月球联络对吧
Dialogue: 0,0:09:29.57,0:09:30.49,Layzner,Roger,0,0,0,,当然
Dialogue: 0,0:09:30.76,0:09:34.45,Layzner,Elizabeth,0,0,0,,请马上帮我跟他们联络 外星人准备要攻打地球了
Dialogue: 0,0:09:35.57,0:09:37.10,Layzner,Roger,0,0,0,,攻击地球
Dialogue: 0,0:09:38.14,0:09:40.24,Layzner,Roger,0,0,0,,她好像被男友甩了
Dialogue: 0,0:09:40.24,0:09:43.53,Layzner,B,0,0,0,,老跟小孩在一起会变得欲求不满的
Dialogue: 0,0:09:43.53,0:09:45.68,Layzner,Elizabeth,0,0,0,,请马上把这危机传出去
Dialogue: 0,0:09:46.04,0:09:47.60,Layzner,Carks,0,0,0,,罗吉亚 航天飞机待命中
Dialogue: 0,0:09:47.73,0:09:49.30,Layzner,Roger,0,0,0,,了解 马上打开舱门
Dialogue: 0,0:09:49.31,0:09:50.59,Layzner,C,0,0,0,,舱门锁解除
Dialogue: 0,0:10:00.26,0:10:03.01,Layzner,Carks,0,0,0,,那是什么 罗吉亚 看一下雷达
Dialogue: 0,0:10:03.06,0:10:03.79,Layzner,Roger,0,0,0,,怎么了
Dialogue: 0,0:10:03.79,0:10:06.99,Layzner,Carks,0,0,0,,二点钟方向 不 是你的一点四十分钟方向
Dialogue: 0,0:10:07.19,0:10:07.95,Layzner,B,0,0,0,,是那个吗
Dialogue: 0,0:10:08.17,0:10:09.16,Layzner,Roger,0,0,0,,把它放大
Dialogue: 0,0:10:10.14,0:10:10.83,Layzner,B,0,0,0,,那是什么
Dialogue: 0,0:10:10.84,0:10:12.31,Layzner,Roger,0,0,0,,不能再放大吗
Dialogue: 0,0:10:12.32,0:10:13.76,Layzner,C,0,0,0,,那是什么东西啊
Dialogue: 0,0:10:13.99,0:10:15.10,Layzner,Roger,0,0,0,,是机器人吗
Dialogue: 0,0:10:19.73,0:10:22.81,Layzner,Eiji,0,0,0,,博士 有SPT接近地球的船
Dialogue: 0,0:10:22.93,0:10:24.07,Layzner,Eiji,0,0,0,,请警告他们
Dialogue: 0,0:10:25.05,0:10:28.96,Layzner,Elizabeth,0,0,0,,罗吉亚大尉 外星人的机动部队接近中 请马上进行防卫
Dialogue: 0,0:10:28.96,0:10:31.54,Layzner,Roger,0,0,0,,我们已经确认目标了 交给我们吧
Dialogue: 0,0:10:33.04,0:10:37.59,Layzner,Arthur,0,0,0,,没问题 没问题的 他们是职业军人嘛
Dialogue: 0,0:10:37.73,0:10:41.42,Layzner,Simone,0,0,0,,可是火星的军事基地还不是打不赢他们
Dialogue: 0,0:10:41.43,0:10:45.07,Layzner,Arthur,0,0,0,,那是 那是他们太大意了
Dialogue: 0,0:10:47.31,0:10:51.53,Layzner,Egyle,0,0,0,,阿修 达尔二架SPT就这样先跟着那小航天飞机 在新的命令前待命
Dialogue: 0,0:10:51.53,0:10:52.23,Layzner,All,0,0,0,,了解
Dialogue: 0,0:10:52.75,0:10:57.62,Layzner,Egyle,0,0,0,,其他人散开 在alpha shift展开包围 从各角度用雷达侦测取得资料
Dialogue: 0,0:10:57.62,0:10:58.46,Layzner,All,0,0,0,,了解
Dialogue: 0,0:10:58.75,0:11:01.73,Layzner,Roger,0,0,0,,丹尼少佐 敌人好像要散开再包围我们
Dialogue: 0,0:11:04.17,0:11:07.42,Layzner,Carks,0,0,0,,准备攻击 不要让他们过来
Dialogue: 0,0:11:18.06,0:11:19.37,Layzner,Carks,0,0,0,,好快
Dialogue: 0,0:11:23.19,0:11:24.21,Layzner,Carks,0,0,0,,来了吗
Dialogue: 0,0:11:25.93,0:11:27.04,Layzner,Carks,0,0,0,,可恶
Dialogue: 0,0:11:29.68,0:11:31.32,Layzner,Carks,0,0,0,,他们到底想干什么
Dialogue: 0,0:11:36.41,0:11:37.59,Layzner,Ash,0,0,0,,好迟钝的家伙
Dialogue: 0,0:11:37.59,0:11:39.59,Layzner,Derro,0,0,0,,到底猴子就是猴子
Dialogue: 0,0:11:39.81,0:11:41.36,Layzner,Com,0,0,0,,有SPT快速接近中
Dialogue: 0,0:11:41.36,0:11:42.06,Layzner,Derro,0,0,0,,什么
Dialogue: 0,0:11:43.14,0:11:45.63,Layzner,Carks,0,0,0,,怎么了 又来了吗
Dialogue: 0,0:12:02.69,0:12:04.41,Layzner,Derro,0,0,0,,那是 雷兹纳
Dialogue: 0,0:12:21.85,0:12:22.55,Layzner,Derro,0,0,0,,什么
Dialogue: 0,0:12:22.55,0:12:24.55,Layzner,Com,0,0,0,,背后受到攻击
Dialogue: 0,0:12:28.95,0:12:30.67,Layzner,Carks,0,0,0,,又来了吗
Dialogue: 0,0:12:31.00,0:12:33.52,Layzner,Eiji,0,0,0,,快一点 先去保护航天飞机
Dialogue: 0,0:12:38.11,0:12:40.12,Layzner,Derro,0,0,0,,阿修 先回去跟本队汇合
Dialogue: 0,0:12:40.14,0:12:40.86,Layzner,Ash,0,0,0,,我知道了
Dialogue: 0,0:12:49.11,0:12:53.22,Layzner,Carks,0,0,0,,这里是丹尼 敌人有五架 但不知为何其中三架和其他两架打起来了
Dialogue: 0,0:12:53.22,0:12:54.55,Layzner,Roger,0,0,0,,少佐 你没事吗
Dialogue: 0,0:12:54.55,0:12:57.32,Layzner,Carks,0,0,0,,我没事 总之进入备战状态
Dialogue: 0,0:12:57.32,0:12:59.65,Layzner,Roger,0,0,0,,了解 以备战状态待机
Dialogue: 0,0:13:05.51,0:13:07.44,Layzner,B,0,0,0,,第一炮塔 第一号舰炮准备
Dialogue: 0,0:13:07.61,0:13:10.49,Layzner,C,0,0,0,,第二号舰炮准备 导弹发射准备完成
Dialogue: 0,0:13:10.84,0:13:12.65,Layzner,Roger,0,0,0,,还没 敌人还没动
Dialogue: 0,0:13:12.65,0:13:14.63,Layzner,A,0,0,0,,我们这里早就准备好了
Dialogue: 0,0:13:16.31,0:13:17.53,Layzner,Roger,0,0,0,,他们在干什么
Dialogue: 0,0:13:20.55,0:13:25.76,Layzner,Com,0,0,0,,目标是中型运输机 引擎是HYPERGOLIC LRD
Dialogue: 0,0:13:25.76,0:13:29.82,Layzner,Com,0,0,0,,武器有六门激光炮 还配备有导弹
Dialogue: 0,0:13:29.94,0:13:30.68,Layzner,Dal,0,0,0,,卡露拉少尉
Dialogue: 0,0:13:30.68,0:13:31.72,Layzner,Egyle,0,0,0,,什么事
Dialogue: 0,0:13:31.72,0:13:35.87,Layzner,Dal,0,0,0,,这样看来好像没有可以跟我们匹敌的武器 请交给我吧
Dialogue: 0,0:13:35.87,0:13:40.27,Layzner,Egyle,0,0,0,,达尔军曹 我们要遵从雷达的指示 继续保护alpha shift
Dialogue: 0,0:13:40.45,0:13:41.16,Layzner,Dal,0,0,0,,了解
Dialogue: 0,0:13:42.66,0:13:47.24,Layzner,Dal,0,0,0,,切 你只会听凯利队长的命令 对那些猴子也太谨慎了吧
Dialogue: 0,0:13:51.16,0:13:53.61,Layzner,Roger,0,0,0,,敌人开始行动了 要小心
Dialogue: 0,0:14:00.57,0:14:04.08,Layzner,Roger,0,0,0,,不要慌 敌人进入R12到R14地区 准备射击
Dialogue: 0,0:14:04.31,0:14:05.01,Layzner,???,0,0,0,,了解
Dialogue: 0,0:14:05.19,0:14:06.06,Layzner,Roger,0,0,0,,攻击开始
Dialogue: 0,0:14:06.06,0:14:08.56,Layzner,Egyle,0,0,0,,是谁违反命令 快离开
Dialogue: 0,0:14:08.97,0:14:11.51,Layzner,Dal,0,0,0,,没什么 我只是直接用雷达接收情报而已
Dialogue: 0,0:14:13.21,0:14:14.33,Layzner,Com,0,0,0,,导弹接近
Dialogue: 0,0:14:23.99,0:14:25.57,Layzner,Dal,0,0,0,,太慢了
Dialogue: 0,0:14:31.49,0:14:32.45,Layzner,B,0,0,0,,混账
Dialogue: 0,0:14:32.45,0:14:33.80,Layzner,C,0,0,0,,可恶
Dialogue: 0,0:14:35.61,0:14:37.21,Layzner,B,0,0,0,,尝尝这个
Dialogue: 0,0:14:41.41,0:14:44.82,Layzner,Dal,0,0,0,,这是早期的激光嘛 威力只有我们的六分之一嘛
Dialogue: 0,0:14:45.59,0:14:47.84,Layzner,B,0,0,0,,激光也没用 而且他的速度好快
Dialogue: 0,0:14:48.13,0:14:49.74,Layzner,C,0,0,0,,导弹也被他打掉了
Dialogue: 0,0:14:49.92,0:14:52.38,Layzner,Roger,0,0,0,,直接攻击就行了 交给我
Dialogue: 0,0:14:54.81,0:14:55.68,Layzner,Roger,0,0,0,,看着吧你
Dialogue: 0,0:14:57.04,0:15:00.02,Layzner,Egyle,0,0,0,,达尔军曹 雷达也捕捉到足够的资料了 快回来
Dialogue: 0,0:15:00.76,0:15:03.03,Layzner,Dal,0,0,0,,这些玩具 看我来干掉你
Dialogue: 0,0:15:03.39,0:15:04.76,Layzner,Dal,0,0,0,,机关部在哪里
Dialogue: 0,0:15:12.57,0:15:13.40,Layzner,Dal,0,0,0,,在这啊
Dialogue: 0,0:15:13.62,0:15:15.00,Layzner,Com,0,0,0,,SPT接近
Dialogue: 0,0:15:15.29,0:15:16.84,Layzner,Dal,0,0,0,,阿修吗 快回来
Dialogue: 0,0:15:18.20,0:15:19.20,Layzner,Roger,0,0,0,,射击
Dialogue: 0,0:15:21.88,0:15:23.69,Layzner,Dal,0,0,0,,怎么会被这种东西打败呢
Dialogue: 0,0:15:24.87,0:15:25.57,Layzner,Dal,0,0,0,,怎么了
Dialogue: 0,0:15:29.73,0:15:31.68,Layzner,???,0,0,0,,成功了
Dialogue: 0,0:15:31.68,0:15:34.25,Layzner,C,0,0,0,,直接攻击的话就有效了 好
Dialogue: 0,0:15:37.67,0:15:38.67,Layzner,Egyle,0,0,0,,达尔军曹
Dialogue: 0,0:15:39.65,0:15:41.03,Layzner,Egyle,0,0,0,,全机 准备攻击
Dialogue: 0,0:15:41.71,0:15:43.57,Layzner,A,0,0,0,,卡露拉少尉 是之前那三架SPT
Dialogue: 0,0:15:43.83,0:15:44.56,Layzner,Egyle,0,0,0,,雷兹纳
Dialogue: 0,0:15:44.56,0:15:45.78,Layzner,Gail,0,0,0,,全机停止攻击
Dialogue: 0,0:15:47.02,0:15:50.05,Layzner,Egyle,0,0,0,,请等一下凯利中尉 请让我下达攻击命令
Dialogue: 0,0:15:50.49,0:15:53.98,Layzner,Gail,0,0,0,,我们被击落一机 破损一机 不容许你乱来了
Dialogue: 0,0:15:54.19,0:15:54.99,Layzner,Egyle,0,0,0,,凯利中尉
Dialogue: 0,0:15:54.99,0:15:59.31,Layzner,Gail,0,0,0,, 快回来 先进行全资料分析 这是命令
Dialogue: 0,0:16:01.94,0:16:04.10,Layzner,Egyle,0,0,0,,了解 马上就回去
Dialogue: 0,0:16:06.31,0:16:07.53,Layzner,Egyle,0,0,0,,全机撤退
Dialogue: 0,0:16:13.58,0:16:14.92,Layzner,David,0,0,0,,罗安 追上去
Dialogue: 0,0:16:14.97,0:16:15.78,Layzner,Roanne,0,0,0,,知道了
Dialogue: 0,0:16:19.52,0:16:20.90,Layzner,Eiji,0,0,0,,停下 不要太深入
Dialogue: 0,0:16:20.90,0:16:22.24,Layzner,Rey,0,0,0,,导弹接近
Dialogue: 0,0:16:25.24,0:16:28.57,Layzner,Eiji,0,0,0,,快住手 停止攻击 我是你们这边的
Dialogue: 0,0:16:31.50,0:16:32.70,Layzner,Eiji,0,0,0,,我不是敌人
Dialogue: 0,0:16:34.71,0:16:37.16,Layzner,David,0,0,0,,快住手 他是我方的
Dialogue: 0,0:16:37.41,0:16:38.54,Layzner,Roanne,0,0,0,,快住手
Dialogue: 0,0:16:40.30,0:16:43.50,Layzner,Eiji,0,0,0,,没办法 大卫 罗安 撤退吧
Dialogue: 0,0:16:48.06,0:16:49.44,Layzner,Eiji,0,0,0,,航天飞机应该降落了
Dialogue: 0,0:16:49.61,0:16:51.76,Layzner,Roger,0,0,0,,停 再射下去只是浪费子弹而已
Dialogue: 0,0:16:53.87,0:16:55.64,Layzner,Roger,0,0,0,,丹尼少佐 没事吗
Dialogue: 0,0:16:56.02,0:16:58.00,Layzner,Carks,0,0,0,,太惨了 这里太惨了
Dialogue: 0,0:16:59.17,0:17:02.15,Layzner,Carks,0,0,0,,我们的基地只剩一个大坑
Dialogue: 0,0:17:04.08,0:17:07.48,Layzner,Carks,0,0,0,,什么都没有 一样都没有
Dialogue: 0,0:17:08.09,0:17:11.47,Layzner,Roger,0,0,0,,那么 他说的都是真的咯
Dialogue: 0,0:17:11.62,0:17:13.01,Layzner,Carks,0,0,0,,没错
Dialogue: 0,0:17:19.06,0:17:19.97,Layzner,Roger,0,0,0,,外星人
Dialogue: 0,0:17:31.41,0:17:33.20,Layzner,Arthur,0,0,0,,欢迎你来 丹尼少佐
Dialogue: 0,0:17:33.28,0:17:34.99,Layzner,Elizabeth,0,0,0,,我是伊丽莎白 这边请
Dialogue: 0,0:17:36.38,0:17:40.23,Layzner,Carks,0,0,0,,我刚看到基地的遗迹了 真让人难以置信
Dialogue: 0,0:17:40.37,0:17:43.00,Layzner,Elizabeth,0,0,0,,你看到的都是真的
Dialogue: 0,0:17:43.00,0:17:45.90,Layzner,Carks,0,0,0,,除了现在看到的这些人之外其他人都死了是吗
Dialogue: 0,0:17:46.20,0:17:49.09,Layzner,Elizabeth,0,0,0,,还有两个小孩跟英二
Dialogue: 0,0:17:49.30,0:17:51.29,Layzner,Carks,0,0,0,,你刚说他是外星人是吧
Dialogue: 0,0:17:51.29,0:17:53.96,Layzner,Arthur,0,0,0,,他为了保护我们而一直在战斗
Dialogue: 0,0:17:56.61,0:18:02.71,Layzner,Elizabeth,0,0,0,,他是我方的 英二为了告诉我们地球的危机而从他的星球逃出来
Dialogue: 0,0:18:09.28,0:18:14.38,Layzner,Arthur,0,0,0,,我们在这撑好久了 接下来可以好好睡一觉了吧
Dialogue: 0,0:18:15.25,0:18:18.93,Layzner,Elizabeth,0,0,0,,到目前为止因为干扰电波让我们无法联络上月球
Dialogue: 0,0:18:19.24,0:18:21.56,Layzner,Elizabeth,0,0,0,,是否可以请您跟地球联络呢
Dialogue: 0,0:18:30.01,0:18:31.69,Layzner,Carks,0,0,0,,你叫什么名字
Dialogue: 0,0:18:31.69,0:18:34.20,Layzner,Eiji,0,0,0,,英二 阿尔巴特洛·英二·飞鸟
Dialogue: 0,0:18:34.40,0:18:37.52,Layzner,Carks,0,0,0,,OK 英二 我要把你当俘虏监禁起来
Dialogue: 0,0:18:37.95,0:18:39.04,Layzner,Elizabeth,0,0,0,,丹尼少佐
Dialogue: 0,0:18:39.87,0:18:44.94,Layzner,Carks,0,0,0,,我们美军的调查队已从月球出发来这的途中
Dialogue: 0,0:18:45.01,0:18:47.75,Layzner,Arthur,0,0,0,,那就是有援军来咯
Dialogue: 0,0:18:47.75,0:18:48.65,Layzner,Carks,0,0,0,,对
Dialogue: 0,0:18:49.75,0:18:52.15,Layzner,Carks,0,0,0,,谁来用这胶带把他的手绑起来
Dialogue: 0,0:18:57.37,0:18:58.58,Layzner,Carks,0,0,0,,嘿 你
Dialogue: 0,0:18:58.60,0:19:00.03,Layzner,Roanne,0,0,0,,我叫罗安
Dialogue: 0,0:19:00.03,0:19:00.94,Layzner,Carks,0,0,0,,把他绑起来
Dialogue: 0,0:19:02.04,0:19:05.45,Layzner,Elizabeth,0,0,0,,英二是个有勇气并来告诉我们地球危机的少年
Dialogue: 0,0:19:05.45,0:19:08.51,Layzner,Elizabeth,0,0,0,,还有我们能得救也是因为他
Dialogue: 0,0:19:08.74,0:19:11.14,Layzner,Carks,0,0,0,,笨蛋 他是敌人派来的卧底
Dialogue: 0,0:19:11.14,0:19:12.25,Layzner,Elizabeth,0,0,0,,他不是敌人
Dialogue: 0,0:19:13.07,0:19:18.52,Layzner,Carks,0,0,0,,还真像联合国的作风 但这样只会救了敌人而已
Dialogue: 0,0:19:18.52,0:19:20.11,Layzner,Elizabeth,0,0,0,,我不允许你绑他
Dialogue: 0,0:19:20.11,0:19:22.42,Layzner,Carks,0,0,0,,谁听你的 把手伸出来
Dialogue: 0,0:19:23.09,0:19:27.97,Layzner,Carks,0,0,0,,我不是开玩笑 反抗的话我会射死你的 不想死就伸手
Dialogue: 0,0:19:28.90,0:19:31.63,Layzner,Eiji,0,0,0,,像你这样的人地球有很多吗
Dialogue: 0,0:19:31.63,0:19:32.37,Layzner,Carks,0,0,0,,什么
Dialogue: 0,0:19:32.42,0:19:36.11,Layzner,Eiji,0,0,0,,什么都要用武力解决 真是野蛮的人
Dialogue: 0,0:19:39.24,0:19:43.65,Layzner,Carks,0,0,0,,你的同伴也杀了地球人 你没有资格说我野蛮
Dialogue: 0,0:19:45.40,0:19:46.24,Layzner,Carks,0,0,0,,站起来
Dialogue: 0,0:19:47.65,0:19:49.31,Layzner,David,0,0,0,,够了 少佐
Dialogue: 0,0:19:49.53,0:19:52.78,Layzner,Carks,0,0,0,,你 给我让开 我要杀人了
Dialogue: 0,0:19:53.35,0:19:54.61,Layzner,Roanne,0,0,0,,我不会让你杀的
Dialogue: 0,0:19:54.71,0:19:56.63,Layzner,Carks,0,0,0,,你们是被洗脑了吗
Dialogue: 0,0:19:57.00,0:19:59.36,Layzner,Simone,0,0,0,,我们有自己的判断力
Dialogue: 0,0:20:01.80,0:20:06.25,Layzner,Carks,0,0,0,,你们是被吓怕了是吗 给我乖乖的走开
Dialogue: 0,0:20:06.25,0:20:08.96,Layzner,David,0,0,0,,不行 英二是我们的同伴
Dialogue: 0,0:20:11.37,0:20:14.04,Layzner,David,0,0,0,,喂 亚瑟 你站在哪一边
Dialogue: 0,0:20:21.97,0:20:23.30,Layzner,Carks,0,0,0,,真疯狂
Dialogue: 0,0:20:23.83,0:20:25.52,Layzner,Elizabeth,0,0,0,,把枪收起来吧 少佐
Dialogue: 0,0:20:27.05,0:20:29.07,Layzner,Carks,0,0,0,,好吧 暂时算了
Dialogue: 0,0:20:29.94,0:20:32.38,Layzner,Carks,0,0,0,,大家先上航天飞机再搭船回去
Dialogue: 0,0:20:32.38,0:20:33.65,Layzner,Eiji,0,0,0,,现在搭船太危险了
Dialogue: 0,0:20:34.19,0:20:38.73,Layzner,Carks,0,0,0,,外星人已被我们的导弹击退 不用担心
Dialogue: 0,0:20:38.90,0:20:39.98,Layzner,Eiji,0,0,0,,不是这样
Dialogue: 0,0:20:39.98,0:20:44.06,Layzner,Carks,0,0,0,,刚才明明就打下一架敌机 情报说剩下的都撤退了
Dialogue: 0,0:20:44.06,0:20:49.66,Layzner,Eiji,0,0,0,,他们会撤退是要整合大批武力再度攻击 接下来的攻击恐怕
Dialogue: 0,0:20:49.66,0:20:50.66,Layzner,Carks,0,0,0,,不要小看地球人
Dialogue: 0,0:20:50.66,0:20:52.05,Layzner,Eiji,0,0,0,,这是我冷静的判断
Dialogue: 0,0:20:52.05,0:20:54.04,Layzner,Arthur,0,0,0,,可是援军也来了对吧
Dialogue: 0,0:20:54.04,0:20:57.63,Layzner,Carks,0,0,0,,没错 不要浪费时间了 伊丽莎白博士
Dialogue: 0,0:20:58.13,0:20:59.20,Layzner,Elizabeth,0,0,0,,我知道了
Dialogue: 0,0:20:59.60,0:21:02.59,Layzner,Elizabeth,0,0,0,,大家 终于有机会回地球了
Dialogue: 0,0:21:02.59,0:21:05.17,Layzner,Eiji,0,0,0,,博士 现在上传真的很危险
Dialogue: 0,0:21:05.55,0:21:08.71,Layzner,Eiji,0,0,0,,他们一定会展开攻击的 不要上船
Dialogue: 0,0:21:09.84,0:21:13.43,Layzner,Arthur,0,0,0,,大家怎么了 这是回地球的机会啊
Dialogue: 0,0:21:13.43,0:21:15.71,Layzner,Arthur,0,0,0,,大家应该早就有要冒险的觉悟了吧
Dialogue: 0,0:21:15.72,0:21:17.97,Layzner,Carks,0,0,0,,有我们军人在
Dialogue: 0,0:21:17.97,0:21:20.35,Layzner,Arthur,0,0,0,,走吧 一起回去吧
Dialogue: 0,0:21:20.41,0:21:21.81,Layzner,Carks,0,0,0,,伊丽莎白博士
Dialogue: 0,0:21:21.89,0:21:24.85,Layzner,Elizabeth,0,0,0,,丹尼少佐 我
Dialogue: 0,0:21:24.85,0:21:26.61,Layzner,David,0,0,0,,我要跟英二留下来
Dialogue: 0,0:21:26.73,0:21:27.89,Layzner,Arthur,0,0,0,,大卫
Dialogue: 0,0:21:28.66,0:21:30.95,Layzner,Roanne,0,0,0,,我现在就死还太早了
Dialogue: 0,0:21:30.95,0:21:33.37,Layzner,Simone,0,0,0,,我也不要上船
Dialogue: 0,0:21:33.37,0:21:35.12,Layzner,Anna,0,0,0,,我也要留下来
Dialogue: 0,0:21:35.12,0:21:37.96,Layzner,Carks,0,0,0,,好 那就不妥协了 我在航天飞机上等你们五分钟
Dialogue: 0,0:21:40.33,0:21:43.53,Layzner,Arthur,0,0,0,,回去吧 援军马上就来了
Dialogue: 0,0:21:44.87,0:21:46.92,Layzner,Arthur,0,0,0,,好不好 西蒙尼
Dialogue: 0,0:21:46.92,0:21:50.96,Layzner,Simone,0,0,0,,不用客气了 亚瑟 再见 你保重
Dialogue: 0,0:21:52.55,0:21:54.13,Layzner,Arthur,0,0,0,,可恶
Dialogue: 0,0:21:54.27,0:21:59.36,Layzner,Arthur,0,0,0,,我 我也相信英二
Dialogue: 0,0:21:59.52,0:22:02.19,Layzner,Arthur,0,0,0,,可是 可是
Dialogue: 0,0:22:11.22,0:22:14.74,Layzner,Arthur,0,0,0,,他要走了 这样好吗
Dialogue: 0,0:22:17.67,0:22:20.34,Layzner,Carks,0,0,0,,这些小鬼们到底怎么回事
Dialogue: 0,0:22:29.01,0:22:35.17,Layzner,Anna,0,0,0,,大家都选了英二 在生死之间做了重大的选择
Dialogue: 0,0:22:35.96,0:22:41.55,Layzner,Anna,0,0,0,,不 是大家把英二当同伴 相信同伴
Dialogue: 0,0:22:42.32,0:22:48.40,Layzner,Anna,0,0,0,,我 此时的我感觉想大叫 想大哭
Dialogue: 0,0:23:56.28,0:24:00.61,Layzner,Carks,0,0,0,,有时因为时间跟地点必须有舍命的觉悟
Dialogue: 0,0:24:01.11,0:24:03.10,Layzner,Elizabeth,0,0,0,,我们要走 就表示英二也要一起去
Dialogue: 0,0:24:03.55,0:24:04.60,Layzner,Eiji,0,0,0,,走吧 少佐
Dialogue: 1,0:24:04.61,0:24:09.11,Layzner,,0,0,0,,下一集 再见 红色之星

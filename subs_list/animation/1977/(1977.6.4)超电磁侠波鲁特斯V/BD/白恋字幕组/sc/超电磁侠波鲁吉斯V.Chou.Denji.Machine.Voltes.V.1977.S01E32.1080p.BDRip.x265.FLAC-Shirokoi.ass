Dialogue: 0,0:01:10.00,0:01:16.72,*Default,NTP,0,0,0,,{\fad(200,200)}姜戈的追踪
Dialogue: 0,0:01:53.77,0:01:56.26,*Default,NTP,0,0,0,,这不是惠美吗 真没想到
Dialogue: 0,0:01:57.71,0:02:00.78,*Default,NTP,0,0,0,,我也是女孩子 偶尔摘些花有何不可
Dialogue: 0,0:02:01.27,0:02:03.50,*Default,NTP,0,0,0,,正想着送给他做礼物呢…
Dialogue: 0,0:02:04.60,0:02:08.97,*Default,NTP,0,0,0,,啊呀 真稀奇 惠美心里原来有个「他」！
Dialogue: 0,0:02:09.61,0:02:13.00,*Default,NTP,0,0,0,,别大惊小怪的 我可正值春心萌动的年纪
Dialogue: 0,0:02:14.14,0:02:15.36,*Default,NTP,0,0,0,,那个「他」…
Dialogue: 0,0:02:16.83,0:02:17.52,*Default,NTP,0,0,0,,指的是我吗？
Dialogue: 0,0:02:17.77,0:02:18.60,*Default,NTP,0,0,0,,蠢蛋
Dialogue: 0,0:02:24.10,0:02:25.21,*Default,NTP,0,0,0,,讨厌
Dialogue: 0,0:02:28.54,0:02:31.97,*Default,NTP,0,0,0,,惠美 你真坚强啊
Dialogue: 0,0:02:32.28,0:02:34.97,*Default,NTP,0,0,0,,对刚刚过世的父亲只字未提
Dialogue: 0,0:02:34.97,0:02:36.53,*Default,NTP,0,0,0,,还是一副快乐的样子
Dialogue: 0,0:02:36.69,0:02:38.34,*Default,NTP,0,0,0,,再见！
Dialogue: 0,0:02:43.46,0:02:45.91,*Default,NTP,0,0,0,,来 我们也走吧 艾夫尔
Dialogue: 0,0:02:47.49,0:02:50.51,*Default,NTP,0,0,0,,当我死后你也别哭哦 驾！
Dialogue: 0,0:03:26.59,0:03:28.02,*Default,NTP,0,0,0,,他们相继离我们而去
Dialogue: 0,0:03:29.67,0:03:33.02,*Default,NTP,0,0,0,,光代博士…滨口博士…
Dialogue: 0,0:03:35.85,0:03:39.24,*Default,NTP,0,0,0,,是吗…原来如此
Dialogue: 0,0:03:40.70,0:03:43.85,*Default,NTP,0,0,0,,为什么 爸爸 为什么
Dialogue: 0,0:03:49.11,0:03:53.02,*Default,NTP,0,0,0,,惠美 不要哭 忍住 不要哭啊
Dialogue: 0,0:03:53.57,0:03:57.08,*Default,NTP,0,0,0,,有朝一日定能为你爸爸报仇
Dialogue: 0,0:04:05.28,0:04:07.96,*Default,NTP,0,0,0,,混蛋！
Dialogue: 0,0:04:15.61,0:04:18.19,*Default,NTP,0,0,0,,{\pos(723.025,795)\fad(300,0)}波波罗尼西亚
Dialogue: 0,0:04:35.21,0:04:37.08,*Default,NTP,0,0,0,,样本一号 引擎出力下降
Dialogue: 0,0:04:37.08,0:04:38.87,*Default,NTP,0,0,0,,合体出现异常
Dialogue: 0,0:04:39.06,0:04:40.62,*Default,NTP,0,0,0,,样本三号 发生振动
Dialogue: 0,0:04:41.97,0:04:43.75,*Default,NTP,0,0,0,,姜戈将军 测试进展如何
Dialogue: 0,0:04:43.95,0:04:46.35,*Default,NTP,0,0,0,,不 还差得远呢 贝尔根
Dialogue: 0,0:04:46.56,0:04:50.60,*Default,NTP,0,0,0,,要将这铠兽士投入实战仍需大量测试
Dialogue: 0,0:04:51.02,0:04:56.61,*Default,NTP,0,0,0,,毕竟还是测试机 要投入实战有大量改良余地
Dialogue: 0,0:04:56.81,0:04:59.75,*Default,NTP,0,0,0,,特别是高速状态下运动性的下降
Dialogue: 0,0:04:59.84,0:05:02.18,*Default,NTP,0,0,0,,以及合体系统的缺陷需要关注
Dialogue: 0,0:05:02.35,0:05:05.43,*Default,NTP,0,0,0,,果然需要在实战环境下测试
Dialogue: 0,0:05:05.47,0:05:08.25,*Default,NTP,0,0,0,,那样就能清楚地暴露出缺陷
Dialogue: 0,0:05:08.64,0:05:12.17,*Default,NTP,0,0,0,,总有一天会将我的生命交给这个铠兽士后出击的
Dialogue: 0,0:05:12.44,0:05:14.08,*Default,NTP,0,0,0,,现在先继续测试
Dialogue: 0,0:05:14.37,0:05:16.97,*Default,NTP,0,0,0,,尽可能收集更多的数据
Dialogue: 0,0:05:26.21,0:05:27.24,*Default,NTP,0,0,0,,那是什么？
Dialogue: 0,0:05:33.32,0:05:35.39,*Default,NTP,0,0,0,,快…快用无线电联络
Dialogue: 0,0:05:51.20,0:05:53.86,*Default,NTP,0,0,0,,信号位置是波波罗尼西亚的小岛
Dialogue: 0,0:05:54.18,0:05:57.86,*Default,NTP,0,0,0,,有渔船联络说看到有新铠兽士在进行训练
Dialogue: 0,0:05:58.25,0:06:00.48,*Default,NTP,0,0,0,,横竖都是冲着巨鹰堡来的
Dialogue: 0,0:06:00.58,0:06:02.11,*Default,NTP,0,0,0,,进入战斗状态 干掉它
Dialogue: 0,0:06:02.24,0:06:02.64,*Default,NTP,0,0,0,,是
Dialogue: 0,0:06:06.47,0:06:10.93,*Default,NTP,0,0,0,,{\pos(723.025,795)}波波罗尼西亚
Dialogue: 0,0:06:17.25,0:06:19.22,*Default,NTP,0,0,0,,接下来将进入波波罗尼西海域
Dialogue: 0,0:06:19.48,0:06:21.42,*Default,NTP,0,0,0,,深度400 无异常
Dialogue: 0,0:06:21.81,0:06:24.22,*Default,NTP,0,0,0,,好 发射侦查浮标
Dialogue: 0,0:06:24.71,0:06:25.55,*Default,NTP,0,0,0,,发射侦查浮标
Dialogue: 0,0:06:43.40,0:06:44.72,*Default,NTP,0,0,0,,看 是他们
Dialogue: 0,0:06:45.02,0:06:46.25,*Default,NTP,0,0,0,,在合体的兽士呀
Dialogue: 0,0:06:46.87,0:06:49.65,*Default,NTP,0,0,0,,怎能叫他们模仿我们
Dialogue: 0,0:06:49.78,0:06:52.64,*Default,NTP,0,0,0,,好 连环导弹准备发射
Dialogue: 0,0:06:56.83,0:06:58.21,*Default,NTP,0,0,0,,导弹发射！
Dialogue: 0,0:07:28.64,0:07:29.88,*Default,NTP,0,0,0,,是波鲁特斯V！
Dialogue: 0,0:07:30.20,0:07:32.04,*Default,NTP,0,0,0,,撤退 撤退啊！
Dialogue: 0,0:07:33.89,0:07:34.98,*Default,NTP,0,0,0,,不许走
Dialogue: 0,0:07:51.01,0:07:52.07,*Default,NTP,0,0,0,,看 是姜戈
Dialogue: 0,0:07:52.52,0:07:54.09,*Default,NTP,0,0,0,,那家伙是指挥官么…
Dialogue: 0,0:07:54.62,0:07:56.93,*Default,NTP,0,0,0,,磨磨蹭蹭的话 姜戈就要跑了
Dialogue: 0,0:07:57.11,0:07:58.38,*Default,NTP,0,0,0,,着陆后再去追他
Dialogue: 0,0:07:58.81,0:08:01.76,*Default,NTP,0,0,0,,分离吧！VOLT OUT
Dialogue: 0,0:08:12.32,0:08:16.12,*Default,NTP,0,0,0,,日吉你在这里留守 其他人跟我来
Dialogue: 0,0:08:16.56,0:08:17.87,*Default,NTP,0,0,0,,别忘了还是交战中
Dialogue: 0,0:08:43.23,0:08:44.11,*Default,NTP,0,0,0,,这边
Dialogue: 0,0:09:45.54,0:09:48.64,*Default,NTP,0,0,0,,死吧！
Dialogue: 0,0:09:54.20,0:09:54.86,*Default,NTP,0,0,0,,一平
Dialogue: 0,0:09:58.18,0:10:02.18,*Default,NTP,0,0,0,,看好了 惠美 这家伙是杀你爸爸的凶手之一
Dialogue: 0,0:10:06.61,0:10:09.35,*Default,NTP,0,0,0,,老夫已经输了 痛快地杀了我吧
Dialogue: 0,0:10:09.54,0:10:13.32,*Default,NTP,0,0,0,,不愧是敌人的将军 有骨气
Dialogue: 0,0:10:14.05,0:10:16.23,*Default,NTP,0,0,0,,那我就如你所愿干掉你！
Dialogue: 0,0:10:16.41,0:10:18.26,*Default,NTP,0,0,0,,住手 一平 别这样
Dialogue: 0,0:10:18.57,0:10:19.22,*Default,NTP,0,0,0,,多嘴
Dialogue: 0,0:10:19.52,0:10:21.87,*Default,NTP,0,0,0,,你妈妈和滨口博士
Dialogue: 0,0:10:22.07,0:10:24.26,*Default,NTP,0,0,0,,都是被这家伙杀的 你难道忘了吗
Dialogue: 0,0:10:24.27,0:10:28.29,*Default,NTP,0,0,0,,住手 一平 姜戈是我们的俘虏 不得杀他
Dialogue: 0,0:10:28.36,0:10:28.92,*Default,NTP,0,0,0,,不行！
Dialogue: 0,0:10:29.32,0:10:33.29,*Default,NTP,0,0,0,,这家伙不能做平常俘虏对待 可恶
Dialogue: 0,0:10:42.32,0:10:43.18,*Default,NTP,0,0,0,,健一
Dialogue: 0,0:10:44.47,0:10:48.10,*Default,NTP,0,0,0,,不许你杀他 把他当俘虏带回巨鹰堡
Dialogue: 0,0:10:51.99,0:10:53.03,*Default,NTP,0,0,0,,敌人反击了
Dialogue: 0,0:11:08.12,0:11:08.91,*Default,NTP,0,0,0,,糟了
Dialogue: 0,0:11:25.33,0:11:26.23,*Default,NTP,0,0,0,,掩护交给你们了
Dialogue: 0,0:11:26.33,0:11:27.00,*Default,NTP,0,0,0,,大次郎
Dialogue: 0,0:11:39.49,0:11:42.79,*Default,NTP,0,0,0,,这么小的枪怎打得下我们的飞碟！
Dialogue: 0,0:11:55.82,0:11:57.44,*Default,NTP,0,0,0,,无影手里剑！
Dialogue: 0,0:11:59.64,0:12:01.25,*Default,NTP,0,0,0,,重装飞拳！
Dialogue: 0,0:12:33.92,0:12:35.35,*Default,NTP,0,0,0,,敌人撤退了
Dialogue: 0,0:12:36.52,0:12:37.41,*Default,NTP,0,0,0,,不要慌
Dialogue: 0,0:12:37.63,0:12:41.01,*Default,NTP,0,0,0,,他们想破坏我们的机体 把我们困在岛上
Dialogue: 0,0:12:41.09,0:12:42.22,*Default,NTP,0,0,0,,快点着陆
Dialogue: 0,0:12:42.31,0:12:44.72,*Default,NTP,0,0,0,,然后大家一起修理我和一平的机体
Dialogue: 0,0:12:47.87,0:12:50.30,*Default,NTP,0,0,0,,糟了 一平和姜戈不见了！
Dialogue: 0,0:12:50.46,0:12:53.18,*Default,NTP,0,0,0,,我去追 你们三个继续修理
Dialogue: 0,0:12:53.70,0:12:54.34,*Default,NTP,0,0,0,,明白
Dialogue: 0,0:12:58.86,0:12:59.68,*Default,NTP,0,0,0,,我们已遵照您的命令
Dialogue: 0,0:12:59.79,0:13:02.64,*Default,NTP,0,0,0,,对波鲁特斯的机体造成了损伤
Dialogue: 0,0:13:03.07,0:13:07.31,*Default,NTP,0,0,0,,受损的一号和二号机只能停在岛上 不能合体
Dialogue: 0,0:13:07.58,0:13:09.41,*Default,NTP,0,0,0,,好 这就够了
Dialogue: 0,0:13:09.73,0:13:12.96,*Default,NTP,0,0,0,,现在姜戈被挟为人质 我们也不能妄动
Dialogue: 0,0:13:13.32,0:13:13.88,*Default,NTP,0,0,0,,是
Dialogue: 0,0:13:14.35,0:13:17.43,*Default,NTP,0,0,0,,接下来就等铠兽士出击一口气去救出姜戈
Dialogue: 0,0:13:18.36,0:13:22.03,*Default,NTP,0,0,0,,若他们不能合体 我们的成功也是迟早的事
Dialogue: 0,0:13:46.12,0:13:47.83,*Default,NTP,0,0,0,,你真慢呐
Dialogue: 0,0:13:48.04,0:13:51.36,*Default,NTP,0,0,0,,在这种小岛上逃走 马上就会知道了
Dialogue: 0,0:13:53.76,0:13:56.28,*Default,NTP,0,0,0,,来 我们都怎么爽怎么做吧
Dialogue: 0,0:13:56.62,0:13:59.78,*Default,NTP,0,0,0,,继续刚才的事…怎么样？
Dialogue: 0,0:14:01.44,0:14:02.64,*Default,NTP,0,0,0,,别卖关子
Dialogue: 0,0:14:02.92,0:14:06.24,*Default,NTP,0,0,0,,被你们抓住后我的老命便失去了价值
Dialogue: 0,0:14:06.76,0:14:08.17,*Default,NTP,0,0,0,,要杀就快点！
Dialogue: 0,0:14:09.37,0:14:13.65,*Default,NTP,0,0,0,,是么 那我就没什么可顾忌了 去死吧
Dialogue: 0,0:14:14.38,0:14:15.42,*Default,NTP,0,0,0,,一平 住手！
Dialogue: 0,0:14:16.35,0:14:17.16,*Default,NTP,0,0,0,,健一
Dialogue: 0,0:14:17.50,0:14:18.92,*Default,NTP,0,0,0,,要怎么说你才明白？
Dialogue: 0,0:14:19.25,0:14:20.58,*Default,NTP,0,0,0,,给我住手 一平
Dialogue: 0,0:14:22.32,0:14:25.78,*Default,NTP,0,0,0,,你到底帮哪边的 健一 我才没你这么天真
Dialogue: 0,0:14:26.63,0:14:30.10,*Default,NTP,0,0,0,,不在这里解决了姜戈 我就出不了这口气
Dialogue: 0,0:14:31.25,0:14:34.69,*Default,NTP,0,0,0,,敌人就是敌人 无需手下留情
Dialogue: 0,0:14:34.75,0:14:35.62,*Default,NTP,0,0,0,,一平
Dialogue: 0,0:14:53.42,0:14:54.67,*Default,NTP,0,0,0,,住手
Dialogue: 0,0:14:59.59,0:15:00.54,*Default,NTP,0,0,0,,健一！
Dialogue: 0,0:15:05.09,0:15:05.80,*Default,NTP,0,0,0,,健一…
Dialogue: 0,0:15:07.87,0:15:08.72,*Default,NTP,0,0,0,,一平…
Dialogue: 0,0:15:10.35,0:15:12.65,*Default,NTP,0,0,0,,你这家伙…你这家伙真是…
Dialogue: 0,0:15:12.77,0:15:14.28,*Default,NTP,0,0,0,,请理解我 一平
Dialogue: 0,0:15:14.64,0:15:18.30,*Default,NTP,0,0,0,,那帮家伙做过什么事我很清楚
Dialogue: 0,0:15:18.41,0:15:22.98,*Default,NTP,0,0,0,,但是 正因为这样我们才不能和敌人一般见识
Dialogue: 0,0:15:23.52,0:15:25.68,*Default,NTP,0,0,0,,这也是波鲁特斯队尊严的体现！
Dialogue: 0,0:15:27.55,0:15:30.45,*Default,NTP,0,0,0,,即使…即使知道他们是敌人
Dialogue: 0,0:15:30.74,0:15:34.26,*Default,NTP,0,0,0,,他们也和我们一样 是流淌着热血的活人
Dialogue: 0,0:15:35.75,0:15:37.72,*Default,NTP,0,0,0,,别把我和地球人相提并论！
Dialogue: 0,0:15:37.89,0:15:39.81,*Default,NTP,0,0,0,,没什么地球人和波阿赞星人之分！
Dialogue: 0,0:15:40.12,0:15:42.50,*Default,NTP,0,0,0,,我的父亲刚健太郎原来也是波阿赞的人
Dialogue: 0,0:15:42.52,0:15:43.46,*Default,NTP,0,0,0,,什么？
Dialogue: 0,0:15:43.57,0:15:48.14,*Default,NTP,0,0,0,,所以 我的身体流淌着两个星球的血液
Dialogue: 0,0:15:48.51,0:15:51.36,*Default,NTP,0,0,0,,难道那刚健太郎是…
Dialogue: 0,0:15:52.57,0:15:53.81,*Default,NTP,0,0,0,,败给你了 健一
Dialogue: 0,0:15:54.20,0:15:55.78,*Default,NTP,0,0,0,,我不能做敌人那样残暴的事
Dialogue: 0,0:15:57.66,0:15:58.32,*Default,NTP,0,0,0,,一平
Dialogue: 0,0:16:01.19,0:16:02.24,*Default,NTP,0,0,0,,姜戈将军！
Dialogue: 0,0:16:08.95,0:16:10.11,*Default,NTP,0,0,0,,可恶…
Dialogue: 0,0:16:22.68,0:16:23.44,*Default,NTP,0,0,0,,可恶
Dialogue: 0,0:16:25.44,0:16:27.30,*Default,NTP,0,0,0,,健一 振作点 走这边
Dialogue: 0,0:16:48.80,0:16:50.63,*Default,NTP,0,0,0,,姜戈 你没事就好
Dialogue: 0,0:16:51.06,0:16:55.00,*Default,NTP,0,0,0,,不过没想到你这种人竟被敌人抓走
Dialogue: 0,0:16:55.26,0:16:58.22,*Default,NTP,0,0,0,,请您原谅 这是属下大大的失职
Dialogue: 0,0:16:58.44,0:17:02.62,*Default,NTP,0,0,0,,够了 等会儿再说 快派铠兽士出击
Dialogue: 0,0:17:03.00,0:17:03.51,*Default,NTP,0,0,0,,是
Dialogue: 0,0:17:03.82,0:17:04.60,*Default,NTP,0,0,0,,是
Dialogue: 0,0:17:14.99,0:17:17.10,*Default,NTP,0,0,0,,大次郎 惠美！
Dialogue: 0,0:17:19.47,0:17:20.88,*Default,NTP,0,0,0,,大哥
Dialogue: 0,0:17:20.98,0:17:21.78,*Default,NTP,0,0,0,,健一
Dialogue: 0,0:17:21.78,0:17:22.78,*Default,NTP,0,0,0,,哥哥
Dialogue: 0,0:17:23.04,0:17:24.67,*Default,NTP,0,0,0,,到底是怎么了
Dialogue: 0,0:17:25.56,0:17:27.55,*Default,NTP,0,0,0,,让姜戈给跑了
Dialogue: 0,0:17:28.07,0:17:29.69,*Default,NTP,0,0,0,,健一 你没事吧
Dialogue: 0,0:17:30.34,0:17:31.64,*Default,NTP,0,0,0,,这点伤算什么
Dialogue: 0,0:17:40.50,0:17:42.45,*Default,NTP,0,0,0,,日吉 一二号机能飞吗
Dialogue: 0,0:17:42.69,0:17:44.69,*Default,NTP,0,0,0,,没问题 已经都修好了
Dialogue: 0,0:17:45.05,0:17:46.39,*Default,NTP,0,0,0,,好 出击！
Dialogue: 0,0:17:46.51,0:17:47.09,*Default,NTP,0,0,0,,哦
Dialogue: 0,0:17:47.75,0:17:50.75,*Default,NTP,0,0,0,,{\pos(723.025,780)}兽士 扎尼翁
Dialogue: 0,0:18:09.26,0:18:10.30,*Default,NTP,0,0,0,,LET'S
Dialogue: 0,0:18:10.65,0:18:13.04,*Default,NTP,0,0,0,,VOLT IN！
Dialogue: 0,0:19:23.58,0:19:28.09,*Default,NTP,0,0,0,,波鲁特斯V
Dialogue: 0,0:20:08.42,0:20:10.70,*Default,NTP,0,0,0,,健一！振作点 健一
Dialogue: 0,0:20:22.70,0:20:24.68,*Default,NTP,0,0,0,,健一 振作点啊
Dialogue: 0,0:20:24.68,0:20:25.62,*Default,NTP,0,0,0,,健一！
Dialogue: 0,0:20:26.68,0:20:27.65,*Default,NTP,0,0,0,,混蛋
Dialogue: 0,0:20:31.32,0:20:33.50,*Default,NTP,0,0,0,,波鲁特斯火箭筒！
Dialogue: 0,0:21:05.71,0:21:10.08,*Default,NTP,0,0,0,,超电磁光弹！
Dialogue: 0,0:21:44.68,0:21:47.98,*Default,NTP,0,0,0,,对不起 博士 让姜戈跑了
Dialogue: 0,0:21:48.50,0:21:52.22,*Default,NTP,0,0,0,,别在意 机会以后有是
Dialogue: 0,0:21:52.71,0:21:54.93,*Default,NTP,0,0,0,,比起这个 先回基地处理伤口要紧
Dialogue: 0,0:21:57.02,0:21:57.51,*Default,NTP,0,0,0,,是
Dialogue: 0,0:22:04.60,0:22:08.17,*Default,NTP,0,0,0,,真的吗 那家伙说的是真的吗
Dialogue: 0,0:22:08.81,0:22:13.80,*Default,NTP,0,0,0,,造出波鲁特斯的刚健太郎竟然是波阿赞星人…
Dialogue: 0,0:22:14.36,0:22:18.90,*Default,NTP,0,0,0,,难道他们真的有波阿赞星人的血脉吗？
Dialogue: 0,0:23:44.73,0:23:48.82,*Default,NTP,0,0,0,,姜戈将军针对健一他们的新的作战是什么？
Dialogue: 0,0:23:49.67,0:23:53.43,*Default,NTP,0,0,0,,向波鲁特斯袭来的恐怖细菌到底会带来什么？
Dialogue: 0,0:23:54.50,0:23:57.06,*Default,NTP,0,0,0,,波阿赞星的血脉唤来新的战斗！
Dialogue: 0,0:23:57.36,0:23:58.88,*Default,NTP,0,0,0,,下集 波鲁特斯V
Dialogue: 0,0:23:59.27,0:24:01.64,*Default,NTP,0,0,0,,魔之细菌攻击 敬请期待
Dialogue: 0,0:18:24.41,0:18:27.43,IN_JP,NTP,0,0,0,,たとえ　あらしがふこうとも
Dialogue: 0,0:18:27.88,0:18:31.06,IN_JP,NTP,0,0,0,,たとえ　大波あれるとも
Dialogue: 0,0:18:31.30,0:18:34.66,IN_JP,NTP,0,0,0,,こぎだそう　たたかいの海へ
Dialogue: 0,0:18:34.80,0:18:38.10,IN_JP,NTP,0,0,0,,とびこもう　たたかいのうずへ
Dialogue: 0,0:18:38.52,0:18:42.09,IN_JP,NTP,0,0,0,,みつめあう　ひとみとひとみ
Dialogue: 0,0:18:42.20,0:18:50.02,IN_JP,NTP,0,0,0,,ぬくもりをしんじあう　五人のなかま
Dialogue: 0,0:18:50.21,0:18:57.16,IN_JP,NTP,0,0,0,,ボルテスVに　すべてをかけて
Dialogue: 0,0:18:57.51,0:19:03.96,IN_JP,NTP,0,0,0,,やるぞ　力のつきるまで
Dialogue: 0,0:19:04.19,0:19:12.07,IN_JP,NTP,0,0,0,,地球の夜明けは　もうちかい
Dialogue: 0,0:19:19.69,0:19:22.82,IN_JP,NTP,0,0,0,,たとえ　いかづちふろうとも
Dialogue: 0,0:18:24.41,0:18:27.43,IN_CN,NTP,0,0,0,,即使风暴席卷而来
Dialogue: 0,0:18:27.88,0:18:31.06,IN_CN,NTP,0,0,0,,即使巨浪铺天盖地
Dialogue: 0,0:18:31.30,0:18:34.66,IN_CN,NTP,0,0,0,,我们一同划向那战斗之海
Dialogue: 0,0:18:34.80,0:18:38.10,IN_CN,NTP,0,0,0,,毅然纵身跳入那激战之涡
Dialogue: 0,0:18:38.52,0:18:42.09,IN_CN,NTP,0,0,0,,互相凝视 眼对着眼
Dialogue: 0,0:18:42.20,0:18:50.02,IN_CN,NTP,0,0,0,,相信彼此的情谊 五位好伙伴
Dialogue: 0,0:18:50.21,0:18:57.16,IN_CN,NTP,0,0,0,,驾着波鲁特斯V 拼尽全力去战斗
Dialogue: 0,0:18:57.51,0:19:03.96,IN_CN,NTP,0,0,0,,奋斗吧 哪怕精疲力也竭
Dialogue: 0,0:19:04.19,0:19:12.07,IN_CN,NTP,0,0,0,,地球的黎明 已经在眼前
Dialogue: 0,0:19:19.69,0:19:22.82,IN_CN,NTP,0,0,0,,即使闪电击中
Dialogue: 0,0:00:12.03,0:00:15.37,OP_CN,NTP,0,0,0,,即使风暴席卷而来
Dialogue: 0,0:00:15.64,0:00:19.06,OP_CN,NTP,0,0,0,,即使巨浪铺天盖地
Dialogue: 0,0:00:19.29,0:00:22.37,OP_CN,NTP,0,0,0,,我们一同划向那战斗之海
Dialogue: 0,0:00:22.62,0:00:25.96,OP_CN,NTP,0,0,0,,毅然纵身跳入那激战之涡
Dialogue: 0,0:00:26.21,0:00:29.67,OP_CN,NTP,0,0,0,,互相凝视 眼对着眼
Dialogue: 0,0:00:29.93,0:00:33.30,OP_CN,NTP,0,0,0,,相信彼此的情谊
Dialogue: 0,0:00:33.56,0:00:37.69,OP_CN,NTP,0,0,0,,五位好伙伴
Dialogue: 0,0:00:37.93,0:00:40.93,OP_CN,NTP,0,0,0,,驾着波鲁特斯V
Dialogue: 0,0:00:41.18,0:00:44.90,OP_CN,NTP,0,0,0,,拼尽全力去战斗
Dialogue: 0,0:00:45.17,0:00:51.57,OP_CN,NTP,0,0,0,,奋斗吧 哪怕精疲力也竭
Dialogue: 0,0:00:51.83,0:00:55.07,OP_CN,NTP,0,0,0,,地球的黎明
Dialogue: 0,0:00:55.32,0:00:59.45,OP_CN,NTP,0,0,0,,已经在眼前
Dialogue: 0,0:22:36.33,0:22:41.75,ED_CN,NTP,0,0,0,,同父母 走失的
Dialogue: 0,0:22:41.75,0:22:44.96,ED_CN,NTP,0,0,0,,小小的雏鸟
Dialogue: 0,0:22:44.96,0:22:49.72,ED_CN,NTP,0,0,0,,总有一天 会回到
Dialogue: 0,0:22:50.26,0:22:53.60,ED_CN,NTP,0,0,0,,温暖的怀抱
Dialogue: 0,0:22:53.60,0:22:58.35,ED_CN,NTP,0,0,0,,归来的 那一天
Dialogue: 0,0:22:59.02,0:23:02.06,ED_CN,NTP,0,0,0,,应该在眼前
Dialogue: 0,0:23:02.06,0:23:07.53,ED_CN,NTP,0,0,0,,但为何 我仍不能见到
Dialogue: 0,0:23:07.53,0:23:11.07,ED_CN,NTP,0,0,0,,父亲的身影
Dialogue: 0,0:23:11.07,0:23:15.16,ED_CN,NTP,0,0,0,,怎能哭泣呢
Dialogue: 0,0:23:15.16,0:23:19.41,ED_CN,NTP,0,0,0,,我已经是 男子汉啦
Dialogue: 0,0:23:19.41,0:23:23.79,ED_CN,NTP,0,0,0,,我相信 我相信
Dialogue: 0,0:23:23.79,0:23:28.30,ED_CN,NTP,0,0,0,,在那一天 我终会
Dialogue: 0,0:23:28.30,0:23:32.93,ED_CN,NTP,0,0,0,,用双臂 将我的父亲
Dialogue: 0,0:23:32.93,0:23:37.60,ED_CN,NTP,0,0,0,,紧紧地抱拥

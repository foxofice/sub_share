Dialogue: 0,0:00:09.70,0:00:11.53,Default,,0,0,0,,出門採買晚餐的食材
Dialogue: 0,0:00:16.20,0:00:18.58,Default,,0,0,0,,{\fn方正喵呜_GBK\bord0\1c&000000&\1a&55&\pos(1093.87,795.87)}請帶我回家
Dialogue: 0,0:02:14.99,0:02:19.99,Title,,0,0,0,,{\pos(960,421.6)}能幹貓有許多牽掛
Dialogue: 0,0:02:40.18,0:02:43.39,Default,,0,0,0,,諭吉 你在這裡做什麼
Dialogue: 0,0:02:46.69,0:02:47.85,Default,,0,0,0,,你問優芽
Dialogue: 0,0:02:47.85,0:02:50.86,Default,,0,0,0,,優芽…在做什麼…
Dialogue: 0,0:02:50.86,0:02:52.32,Default,,0,0,0,,對了
Dialogue: 0,0:02:52.32,0:02:55.07,Default,,0,0,0,,我在找帶回家的人
Dialogue: 0,0:02:57.11,0:02:58.49,Default,,0,0,0,,帶這隻貓貓回家
Dialogue: 0,0:03:03.20,0:03:04.91,Default,,0,0,0,,牠被丟在這個箱子裡
Dialogue: 0,0:03:04.91,0:03:07.08,Default,,0,0,0,,優芽本來想養牠
Dialogue: 0,0:03:07.08,0:03:09.79,Default,,0,0,0,,可是我家公寓不能養寵物
Dialogue: 0,0:03:09.79,0:03:11.50,Default,,0,0,0,,就算請外婆收留
Dialogue: 0,0:03:11.50,0:03:15.17,Default,,0,0,0,,但外婆眼睛不好所以不方便
Dialogue: 0,0:03:15.17,0:03:19.72,Default,,0,0,0,,所以在牠被別人收留前 優芽想陪牠…
Dialogue: 0,0:03:24.77,0:03:26.23,Default,,0,0,0,,不要 優芽不要回家
Dialogue: 0,0:03:26.23,0:03:27.64,Default,,0,0,0,,優芽不冷
Dialogue: 0,0:03:27.64,0:03:29.06,Default,,0,0,0,,優芽不回家 不回家
Dialogue: 0,0:03:29.06,0:03:31.52,Default,,0,0,0,,優芽絕對不回家
Dialogue: 0,0:03:59.13,0:04:01.72,Default,,0,0,0,,優芽 要住在這裡
Dialogue: 0,0:04:06.98,0:04:09.14,Default,,0,0,0,,小貓怎麼了
Dialogue: 0,0:04:10.06,0:04:11.31,Default,,0,0,0,,是肚子餓了嗎
Dialogue: 0,0:04:11.56,0:04:13.36,Default,,0,0,0,,諭吉 你有奶嗎
Dialogue: 0,0:04:14.98,0:04:16.49,Default,,0,0,0,,吾乃公貓
Dialogue: 0,0:04:17.44,0:04:20.61,Default,,0,0,0,,總共2318日圓
Dialogue: 0,0:04:22.99,0:04:25.20,Default,,0,0,0,,{\fad(300,0)\fn方正准圆_GBK\pos(1042.67,354)}貓用牛奶
Dialogue: 0,0:04:22.99,0:04:25.20,Default,,0,0,0,,{\pos(1618.67,584.67)\fad(300,0)\fn方正准圆_GBK}奶瓶
Dialogue: 0,0:04:23.20,0:04:25.16,Default,,0,0,0,,他有小孩了嗎
Dialogue: 0,0:04:26.29,0:04:28.62,Default,,0,0,0,,喝了喝了 好可愛
Dialogue: 0,0:04:29.46,0:04:33.54,Default,,0,0,0,,優芽…優芽還是好想養…
Dialogue: 0,0:04:34.00,0:04:36.88,Default,,0,0,0,,這樣優芽每天都能為牠喝貓奶
Dialogue: 0,0:04:36.88,0:04:38.42,Default,,0,0,0,,睡在同一床棉被裡
Dialogue: 0,0:04:38.42,0:04:40.55,Default,,0,0,0,,每天陪牠玩
Dialogue: 0,0:04:40.55,0:04:43.80,Default,,0,0,0,,總有一天牠會長得跟諭吉一樣大
Dialogue: 0,0:04:43.80,0:04:47.14,Default,,0,0,0,,就能一起去聽UMYU-Sea的演唱會
Dialogue: 0,0:04:53.23,0:04:54.36,Default,,0,0,0,,下雨了
Dialogue: 0,0:04:54.36,0:04:55.86,Default,,0,0,0,,小貓會淋濕的
Dialogue: 0,0:04:55.86,0:04:58.40,Default,,0,0,0,,快躲到優芽的外套裡
Dialogue: 0,0:05:01.36,0:05:03.53,Default,,0,0,0,,你要去哪裡
Dialogue: 0,0:05:09.91,0:05:13.79,Default,,0,0,0,,{\fn方正喵呜_GBK\bord0\1c&000000&\1a&55&\pos(1219.2,910.53)}請帶我回家
Dialogue: 0,0:05:10.41,0:05:13.88,Default,,0,0,0,,真是可愛的小貓
Dialogue: 0,0:05:14.54,0:05:17.25,Default,,0,0,0,,上面寫著"請帶我回家"
Dialogue: 0,0:05:17.25,0:05:20.38,Default,,0,0,0,,你們在找能領養小貓的飼主嗎
Dialogue: 0,0:05:20.38,0:05:22.59,Default,,0,0,0,,老奶奶願意養牠嗎
Dialogue: 0,0:05:22.59,0:05:24.18,Default,,0,0,0,,這個嘛…
Dialogue: 0,0:05:24.18,0:05:28.27,Default,,0,0,0,,我們家可以養一隻寵物
Dialogue: 0,0:05:28.27,0:05:31.27,Default,,0,0,0,,但我年紀也大了…
Dialogue: 0,0:05:33.35,0:05:35.98,Default,,0,0,0,,我幫妳問問朋友吧
Dialogue: 0,0:05:36.86,0:05:38.82,注释,,0,0,0,,{\an8}迅速…
Dialogue: 0,0:05:42.36,0:05:47.12,Default,,0,0,0,,正吉的孫子一家人正打算養貓呢
Dialogue: 0,0:05:48.99,0:05:52.16,Default,,0,0,0,,在他們來接小貓前 就先寄養在我家吧
Dialogue: 0,0:05:52.58,0:05:55.92,Default,,0,0,0,,小貓再見 保重喔
Dialogue: 0,0:06:09.68,0:06:10.93,Default,,0,0,0,,諭吉
Dialogue: 0,0:06:12.93,0:06:16.06,Default,,0,0,0,,小貓會不會忘記優芽啊
Dialogue: 0,0:06:32.04,0:06:34.16,Default,,0,0,0,,喝了喝了 好可愛
Dialogue: 0,0:06:34.96,0:06:38.34,Default,,0,0,0,,優芽…優芽還是好想養…
Dialogue: 0,0:06:38.34,0:06:41.96,Default,,0,0,0,,在他們來接小貓前 就先寄養在我家吧
Dialogue: 0,0:06:41.96,0:06:45.59,Default,,0,0,0,,小貓再見 保重喔
Dialogue: 0,0:07:04.49,0:07:06.15,Default,,0,0,0,,優芽
Dialogue: 0,0:07:07.61,0:07:09.32,Default,,0,0,0,,終於找到妳了
Dialogue: 0,0:07:09.32,0:07:10.95,Default,,0,0,0,,妳到哪去了
Dialogue: 0,0:07:10.95,0:07:11.74,Default,,0,0,0,,媽媽
Dialogue: 0,0:07:11.99,0:07:15.46,Default,,0,0,0,,真是的 怎麼可以一聲不響地不見呢
Dialogue: 0,0:07:16.12,0:07:18.63,Default,,0,0,0,,剛才的小貓呢
Dialogue: 0,0:07:19.25,0:07:22.09,Default,,0,0,0,,諭吉的朋友的朋友啊
Dialogue: 0,0:07:22.50,0:07:24.71,Default,,0,0,0,,巨大貓 誘拐女童
Dialogue: 0,0:07:24.71,0:07:27.55,Default,,0,0,0,,諭吉 優芽給你添麻煩了
Dialogue: 0,0:07:28.68,0:07:31.93,Default,,0,0,0,,也謝謝你幫小貓找家
Dialogue: 0,0:07:31.93,0:07:33.81,Default,,0,0,0,,諭吉謝謝你
Dialogue: 0,0:07:33.81,0:07:36.69,Default,,0,0,0,,改天再一起去住公園喔
Dialogue: 0,0:07:44.32,0:07:50.16,Default,,0,0,0,,{\an4\blur3\fn@方正准圆_GBK\frz270\fs60\pos(1813.43,119.43)}心想「搞不好能養到\N像諭吉一樣巨大」\N突然就想養養看的隔壁阿婆
Dialogue: 0,0:07:56.45,0:08:00.75,注释,,0,0,0,,{\an7}以附近女性為目標\N可疑人士出沒\N請目擊者提供情報
Dialogue: 0,0:07:57.83,0:08:00.17,Default,,0,0,0,,上面寫有可疑人士出沒
Dialogue: 0,0:08:01.08,0:08:03.67,Default,,0,0,0,,我第一次看到這種公告
Dialogue: 0,0:08:03.67,0:08:05.21,Default,,0,0,0,,真可怕
Dialogue: 0,0:08:05.21,0:08:09.05,Default,,0,0,0,,最近幸來回家時間很晚吧
Dialogue: 0,0:08:09.05,0:08:10.76,Default,,0,0,0,,沒問題吧
Dialogue: 0,0:08:11.30,0:08:14.51,Default,,0,0,0,,可是諭吉又不能去車站等她…
Dialogue: 0,0:08:15.39,0:08:18.18,Default,,0,0,0,,希望能找點抓到犯人
Dialogue: 0,0:08:24.61,0:08:26.94,Default,,0,0,0,,滿員電車要進站了
Dialogue: 0,0:08:28.99,0:08:30.45,Default,,0,0,0,,歡迎光臨
Dialogue: 0,0:08:31.36,0:08:34.24,Default,,0,0,0,,最近這個貓布偶裝好常來
Dialogue: 0,0:08:36.70,0:08:39.41,Default,,0,0,0,,安全警報器和防狼噴霧器
Dialogue: 0,0:08:40.87,0:08:44.79,Default,,0,0,0,,聽說有個以女性為目標的可疑人士出沒
Dialogue: 0,0:08:44.79,0:08:47.51,Default,,0,0,0,,店長在朝會時還叮囑過
Dialogue: 0,0:08:48.47,0:08:50.63,Default,,0,0,0,,謝謝光臨
Dialogue: 0,0:08:52.26,0:08:54.85,Default,,0,0,0,,貓布偶裝裡的人是女的
Dialogue: 0,0:08:56.06,0:08:58.48,Default,,0,0,0,,我還以為是個大叔
Dialogue: 0,0:09:24.75,0:09:28.71,注释,,0,0,0,,{\fad(300,0)\an7}可疑人士出沒
Dialogue: 0,0:09:43.06,0:09:44.40,Default,,0,0,0,,你幹什麼
Dialogue: 0,0:09:45.31,0:09:47.02,Default,,0,0,0,,妳聽我說
Dialogue: 0,0:09:47.57,0:09:48.82,Default,,0,0,0,,你…
Dialogue: 0,0:09:53.61,0:09:55.62,Default,,0,0,0,,來人啊
Dialogue: 0,0:09:55.62,0:09:58.24,Default,,0,0,0,,理央 別叫這麼大聲
Dialogue: 0,0:09:58.24,0:10:01.12,Default,,0,0,0,,就算分手了 有話也要好好商量吧
Dialogue: 0,0:10:01.12,0:10:02.75,Default,,0,0,0,,有熊
Dialogue: 0,0:10:02.91,0:10:04.71,Default,,0,0,0,,貓客人
Dialogue: 0,0:10:04.71,0:10:06.29,Default,,0,0,0,,妳是笨蛋嗎
Dialogue: 0,0:10:06.29,0:10:09.25,Default,,0,0,0,,哪有這麼巨大的貓
Dialogue: 0,0:10:09.25,0:10:11.63,Default,,0,0,0,,我才不想被你說笨
Dialogue: 0,0:10:11.63,0:10:13.72,Default,,0,0,0,,我就是討厭你這點
Dialogue: 0,0:10:13.72,0:10:14.63,Default,,0,0,0,,吵死了
Dialogue: 0,0:10:14.63,0:10:16.80,Default,,0,0,0,,別囉嗦 我叫妳快點過來 笨蛋
Dialogue: 0,0:10:18.51,0:10:20.22,Default,,0,0,0,,你幹嘛啊
Dialogue: 0,0:10:20.22,0:10:22.73,Default,,0,0,0,,臭熊 少惹我喔
Dialogue: 0,0:10:51.55,0:10:54.17,Default,,0,0,0,,你幹什麼
Dialogue: 0,0:10:55.63,0:10:57.84,Default,,0,0,0,,來人啊
Dialogue: 0,0:10:57.84,0:11:00.10,Default,,0,0,0,,理央 別叫這麼大聲
Dialogue: 0,0:11:01.72,0:11:03.18,Default,,0,0,0,,你幹嘛啊
Dialogue: 0,0:11:03.18,0:11:06.35,Default,,0,0,0,,臭熊 少惹我喔
Dialogue: 0,0:11:15.32,0:11:16.70,Default,,0,0,0,,好痛…
Dialogue: 0,0:11:17.45,0:11:18.91,Default,,0,0,0,,臭女人 妳幹什麼
Dialogue: 0,0:11:18.91,0:11:19.91,Default,,0,0,0,,小心我殺了妳喔
Dialogue: 0,0:11:19.91,0:11:22.08,Default,,0,0,0,,好的 我已經錄音了
Dialogue: 0,0:11:22.83,0:11:24.00,Default,,0,0,0,,怎麼樣
Dialogue: 0,0:11:24.00,0:11:28.33,Default,,0,0,0,,你要離開 然後發誓不再到這附近閒晃
Dialogue: 0,0:11:29.79,0:11:31.13,Default,,0,0,0,,還是…
Dialogue: 0,0:11:31.13,0:11:33.96,Default,,0,0,0,,跟我一起去警察局
Dialogue: 0,0:11:38.09,0:11:40.09,Default,,0,0,0,,誰還要再來啊
Dialogue: 0,0:11:54.98,0:11:57.20,Default,,0,0,0,,還好那個人很弱
Dialogue: 0,0:11:57.95,0:11:59.61,Default,,0,0,0,,嚇死我了
Dialogue: 0,0:11:59.61,0:12:03.49,Default,,0,0,0,,我還想說怎麼那麼吵 沒想到諭吉也在場
Dialogue: 0,0:12:03.49,0:12:06.12,Default,,0,0,0,,你們都沒受傷吧
Dialogue: 0,0:12:06.12,0:12:08.62,Default,,0,0,0,,放走那個人好嗎
Dialogue: 0,0:12:08.62,0:12:09.83,Default,,0,0,0,,要不要去追回來
Dialogue: 0,0:12:09.83,0:12:12.79,Default,,0,0,0,,那個 謝謝妳解圍
Dialogue: 0,0:12:13.80,0:12:15.46,Default,,0,0,0,,那傢伙真的很難纏
Dialogue: 0,0:12:15.96,0:12:18.01,Default,,0,0,0,,咦 我好像在哪見過妳…
Dialogue: 0,0:12:18.01,0:12:21.26,Default,,0,0,0,,是的 我是超市的收銀員 敝姓仁科
Dialogue: 0,0:12:21.26,0:12:23.26,Default,,0,0,0,,大姊姊好強喔
Dialogue: 0,0:12:23.26,0:12:24.68,Default,,0,0,0,,你是什麼人啊
Dialogue: 0,0:12:25.47,0:12:29.06,Default,,0,0,0,,沒有啦 早就生疏了 身手都不行了
Dialogue: 0,0:12:29.60,0:12:33.40,Default,,0,0,0,,{\fad(300,0)\fn@方正大黑_GBK\bord2\blur2\3c&FFFFFF&\1c&000000&\frz270\pos(26.67,460.67)}僵硬中
Dialogue: 0,0:12:29.81,0:12:32.98,Default,,0,0,0,,兩位該不會認識吧

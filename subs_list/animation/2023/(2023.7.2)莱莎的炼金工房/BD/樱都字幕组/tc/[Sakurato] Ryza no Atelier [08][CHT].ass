Dialogue: 0,0:02:18.74,0:02:23.41,Title,,0,0,0,,{\blur2\fad(350,523)\3c&HA27E4F&\pos(1470,922)}#08 鍊金術就是爆炸!
Dialogue: 0,0:23:56.03,0:24:01.04,Next Title,,0,0,0,,{\bord2\blur2\3c&HE7AF6F&\pos(960,474)}#09 最後的課題
Comment: 0,0:00:01.00,0:00:01.00,staff,Sub,0,0,0,,
Dialogue: 0,0:00:08.96,0:00:12.16,Sub-CN,,0,0,0,,給我看好了啊 我到底是不是光是嘴上說說的
Dialogue: 0,0:00:13.05,0:00:15.11,Sub-CN,,0,0,0,,現在就讓你知道
Dialogue: 0,0:00:15.76,0:00:20.81,Sub-CN,,0,0,0,,得向村子裏的人展示鍊金術的強大之處
Dialogue: 0,0:00:22.03,0:00:24.32,Sub-CN,,0,0,0,,但是怎麼才能傳達給大家呢
Dialogue: 0,0:00:24.71,0:00:25.79,Sub-CN,,0,0,0,,打擾一下
Dialogue: 0,0:00:26.38,0:00:27.18,Sub-CN,,0,0,0,,科洛蒂婭
Dialogue: 0,0:00:27.66,0:00:30.88,Sub-CN,,0,0,0,,萊莎 呂貝爾特先生他們在叫我們哦
Dialogue: 0,0:00:31.71,0:00:33.53,Sub-CN,,0,0,0,,好像有新的課題
Dialogue: 0,0:00:34.91,0:00:35.98,Sub-CN,,0,0,0,,我現在就去
Dialogue: 0,0:00:37.20,0:00:39.50,Sub-CN,,0,0,0,,一會再思考也可以吧
Dialogue: 0,0:00:40.64,0:00:43.00,Sub-CN,,0,0,0,,好 要努力了
Dialogue: 0,0:02:16.48,0:02:17.90,Sub-CN,,0,0,0,,讓您久等啦
Dialogue: 0,0:02:18.21,0:02:20.80,Sub-CN,,0,0,0,,不 我這邊才是 忽然找你們出來真不好意思
Dialogue: 0,0:02:21.16,0:02:23.50,Sub-CN,,0,0,0,,來了啊 小惡黨們
Dialogue: 0,0:02:24.19,0:02:26.49,Sub-CN,,0,0,0,,雖然很突然但竟然讓別人等着
Dialogue: 0,0:02:26.49,0:02:28.33,Sub-CN,,0,0,0,,真是變得了不起了啊
Dialogue: 0,0:02:28.81,0:02:31.10,Sub-CN,,0,0,0,,莫里茨先生和阿佳特姐姐也在啊
Dialogue: 0,0:02:31.43,0:02:32.54,Sub-CN,,0,0,0,,為甚麼你們也會在這裏啊
Dialogue: 0,0:02:33.16,0:02:37.60,Sub-CN,,0,0,0,,這姑且也算是村子的委託
Dialogue: 0,0:02:37.94,0:02:39.00,Sub-CN,,0,0,0,,村子的委託?
Dialogue: 0,0:02:39.42,0:02:41.76,Sub-CN,,0,0,0,,是關於這裏的廢棄物的
Dialogue: 0,0:02:42.07,0:02:45.10,Sub-CN,,0,0,0,,之前明明是片空地 這也太過分了
Dialogue: 0,0:02:45.47,0:02:49.19,Sub-CN,,0,0,0,,扔在這裏的是瓦礫或者房子的一部分嗎
Dialogue: 0,0:02:50.65,0:02:53.42,Sub-CN,,0,0,0,,村子裏從遺跡重建起來的房子也不少呢
Dialogue: 0,0:02:53.87,0:02:57.61,Sub-CN,,0,0,0,,大點的地震之後就會逐漸有房子壞掉呢
Dialogue: 0,0:02:58.14,0:03:01.29,Sub-CN,,0,0,0,,開始似乎是附近的人隨便扔的
Dialogue: 0,0:03:01.64,0:03:05.80,Sub-CN,,0,0,0,,但不知道從甚麼時候開始 大家都把這裏當做垃圾場了
Dialogue: 0,0:03:06.20,0:03:10.76,Sub-CN,,0,0,0,,妨礙到了出行 收到了這樣的抱怨
Dialogue: 0,0:03:10.76,0:03:14.88,Sub-CN,,0,0,0,,為了守護村裏的生活 我就挺身而出了
Dialogue: 0,0:03:15.26,0:03:16.20,Sub-CN,,0,0,0,,就是這樣
Dialogue: 0,0:03:16.59,0:03:18.18,Sub-CN,,0,0,0,,原來是這樣啊
Dialogue: 0,0:03:19.50,0:03:21.22,Sub-CN,,0,0,0,,課題難道指的是
Dialogue: 0,0:03:21.22,0:03:25.90,Sub-CN,,0,0,0,,是的 想用你的鍊金術來收拾這裏
Dialogue: 0,0:03:26.36,0:03:30.80,Sub-CN,,0,0,0,,10天後 外面的商人要進來這裏
Dialogue: 0,0:03:31.15,0:03:35.20,Sub-CN,,0,0,0,,到那之前想收拾一下這讓人看不下去的樣子
Dialogue: 0,0:03:35.98,0:03:40.63,Sub-CN,,0,0,0,,甚麼啊 比起村民的生活 你這不是更關心外部的評價嘛
Dialogue: 0,0:03:41.23,0:03:42.53,Sub-CN,,0,0,0,,你說甚麼了嗎
Dialogue: 0,0:03:42.89,0:03:44.36,Sub-CN,,0,0,0,,不 甚麼都沒有說
Dialogue: 0,0:03:44.71,0:03:50.53,Sub-CN,,0,0,0,,總之 就用你的那個甚麼 在一週之內給收拾掉了吧
Dialogue: 0,0:03:51.10,0:03:54.17,Sub-CN,,0,0,0,,才不是那個甚麼 是鍊金術
Dialogue: 0,0:03:54.55,0:03:56.54,Sub-CN,,0,0,0,,叫甚麼都無所謂
Dialogue: 0,0:03:56.99,0:03:59.75,Sub-CN,,0,0,0,,所以你能做到嗎 還是做不到呢
Dialogue: 0,0:04:08.04,0:04:10.89,Sub-CN,,0,0,0,,我知道了 就交給我吧
Dialogue: 0,0:04:12.80,0:04:16.71,Sub-CN,,0,0,0,,交給這群傢伙真的沒問題嗎
Dialogue: 0,0:04:17.27,0:04:22.52,Sub-CN,,0,0,0,,沒問題 我家地下室的漏水問題也是她用鍊金術解決的
Dialogue: 0,0:04:23.33,0:04:25.22,Sub-CN,,0,0,0,,就交給她們吧
Dialogue: 0,0:04:26.09,0:04:28.40,Sub-CN,,0,0,0,,既然你都說到這個地步了的話
Dialogue: 0,0:04:28.44,0:04:31.70,Sub-CN,,0,0,0,,你們千萬不要辜負我的期待啊
Dialogue: 0,0:04:32.24,0:04:33.22,Sub-CN,,0,0,0,,我會努力的
Dialogue: 0,0:04:35.32,0:04:38.17,Sub-CN,,0,0,0,,修理漏水之後是要打掃垃圾啊
Dialogue: 0,0:04:38.61,0:04:41.09,Sub-CN,,0,0,0,,終於被當成便利屋了啊
Dialogue: 0,0:04:41.43,0:04:43.71,Sub-CN,,0,0,0,,總感覺對不起
Dialogue: 0,0:04:43.71,0:04:47.96,Sub-CN,,0,0,0,,還好還好 為了能被呂貝爾特先生認可的話 這種程度的工作
Dialogue: 0,0:04:47.96,0:04:53.18,Sub-CN,,0,0,0,,喂 這裏很危險啦 冒險遊戲去別的地方玩
Dialogue: 0,0:04:53.18,0:04:55.12,Sub-CN,,0,0,0,,哇 是阿佳特姐姐
Dialogue: 0,0:04:55.12,0:04:56.80,Sub-CN,,0,0,0,,撤退 快撤啊
Dialogue: 0,0:04:58.63,0:05:02.90,Sub-CN,,0,0,0,,比起商人來訪 更麻煩的是小孩們會像那樣把這裏當做遊樂場啊
Dialogue: 0,0:05:03.39,0:05:05.18,Sub-CN,,0,0,0,,所以想盡快收拾掉
Dialogue: 0,0:05:06.52,0:05:08.03,Sub-CN,,0,0,0,,怎麼了
Dialogue: 0,0:05:08.58,0:05:12.29,Sub-CN,,0,0,0,,沒有 就算明白不是在說我 也忍不住…
Dialogue: 0,0:05:12.92,0:05:15.84,Sub-CN,,0,0,0,,前不久還經常被罵呢
Dialogue: 0,0:05:15.84,0:05:18.62,Sub-CN,,0,0,0,,蘭托和塔奧也一樣吧
Dialogue: 0,0:05:18.62,0:05:21.41,Sub-CN,,0,0,0,,我只是被你們強行拖着而已
Dialogue: 0,0:05:22.99,0:05:24.67,Sub-CN,,0,0,0,,畫面感十足呢
Dialogue: 0,0:05:25.01,0:05:27.10,Sub-CN,,0,0,0,,連科洛蒂婭也這麼說
Dialogue: 0,0:05:28.95,0:05:32.29,Sub-CN,,0,0,0,,但是萊莎 你真的能做到嗎
Dialogue: 0,0:05:32.66,0:05:36.55,Sub-CN,,0,0,0,,連阿佳特姐姐也懷疑我的鍊金術嗎
Dialogue: 0,0:05:36.55,0:05:42.31,Sub-CN,,0,0,0,,甚麼懷疑不懷疑的 我根本沒見過那個鍊金術啊
Dialogue: 0,0:05:42.31,0:05:43.77,Sub-CN,,0,0,0,,啊 對哦
Dialogue: 0,0:05:43.77,0:05:47.86,Sub-CN,,0,0,0,,好 我就藉今次的事件來讓大家見識一下
Dialogue: 0,0:05:47.86,0:05:49.70,Sub-CN,,0,0,0,,我的鍊金術
Dialogue: 0,0:05:51.57,0:05:54.92,Sub-CN,,0,0,0,,這樣啊 加油啊
Dialogue: 0,0:05:55.86,0:05:59.62,Sub-CN,,0,0,0,,不過萊莎 阿佳特姐姐的擔心很對啊
Dialogue: 0,0:06:00.15,0:06:03.16,Sub-CN,,0,0,0,,你想過要怎麼辦吧
Dialogue: 0,0:06:03.16,0:06:07.67,Sub-CN,,0,0,0,,就是 這可不是一週就能搬運完的量哦
Dialogue: 0,0:06:09.31,0:06:14.29,Sub-CN,,0,0,0,,可別小看我鍊金術師萊莎琳·斯托德啊
Dialogue: 0,0:06:14.29,0:06:16.08,Sub-CN,,0,0,0,,你有甚麼想法嗎
Dialogue: 0,0:06:16.08,0:06:17.14,Sub-CN,,0,0,0,,那是自然
Dialogue: 0,0:06:18.99,0:06:24.18,Sub-CN,,0,0,0,,太重搬不走的話 全部粉碎就好了啊
Dialogue: 0,0:06:24.98,0:06:29.67,Sub-CN,,0,0,0,,有我的炸彈 這點石材根本不夠炸的
Dialogue: 0,0:06:31.02,0:06:36.52,Sub-CN,,0,0,0,,明明周圍還有房子 你就打算放炸彈嗎
Dialogue: 0,0:06:38.60,0:06:41.64,Sub-CN,,0,0,0,,放能炸碎石材的炸彈的話
Dialogue: 0,0:06:41.64,0:06:44.47,Sub-CN,,0,0,0,,碎片會亂飛造成大型慘劇的哦
Dialogue: 0,0:06:45.05,0:06:46.34,Sub-CN,,0,0,0,,原來如此
Dialogue: 0,0:06:47.38,0:06:48.34,Sub-CN,,0,0,0,,萊莎?
Dialogue: 0,0:06:51.35,0:06:52.19,Sub-CN,,0,0,0,,怎麼辦啊
Dialogue: 0,0:06:56.77,0:07:02.79,Sub-CN,,0,0,0,,大家說的沒錯 不能在那個地方使用炎燒吧
Dialogue: 0,0:07:02.79,0:07:06.47,Sub-CN,,0,0,0,,安佩爾先生說的思考要怎麼使用鍊金術
Dialogue: 0,0:07:06.47,0:07:09.94,Sub-CN,,0,0,0,,到底會造成怎麼樣的後果就是指的這個啊
Dialogue: 0,0:07:10.38,0:07:11.80,Sub-CN,,0,0,0,,你說我怎麼了
Dialogue: 0,0:07:12.77,0:07:13.79,Sub-CN,,0,0,0,,安佩爾先生
Dialogue: 0,0:07:14.61,0:07:16.00,Sub-CN,,0,0,0,,其實…
Dialogue: 0,0:07:17.90,0:07:20.01,Sub-CN,,0,0,0,,沒事 是我自己的事情
Dialogue: 0,0:07:20.37,0:07:23.50,Sub-CN,,0,0,0,,這回是我接到的村裏的委託
Dialogue: 0,0:07:23.50,0:07:25.08,Sub-CN,,0,0,0,,我得一個人想辦法解決
Dialogue: 0,0:07:25.59,0:07:29.71,Sub-CN,,0,0,0,,萊莎 這段時間太忙給忘掉了
Dialogue: 0,0:07:30.13,0:07:30.98,Sub-CN,,0,0,0,,把這個給你
Dialogue: 0,0:07:32.28,0:07:35.09,Sub-CN,,0,0,0,,記錄了比較難的鍊金術配方的書籍
Dialogue: 0,0:07:35.52,0:07:37.21,Sub-CN,,0,0,0,,如果你還有更高的目標的話
Dialogue: 0,0:07:37.21,0:07:38.09,Sub-CN,,0,0,0,,讀讀這個吧
Dialogue: 0,0:07:38.82,0:07:42.26,Sub-CN,,0,0,0,,謝謝你 安佩爾先生 我也許能找到突破口
Dialogue: 0,0:07:42.84,0:07:43.49,Sub-CN,,0,0,0,,這樣啊
Dialogue: 0,0:07:52.43,0:07:54.11,Sub-CN,,0,0,0,,你又要出門嗎
Dialogue: 0,0:07:54.65,0:07:56.69,Sub-CN,,0,0,0,,我只是回來取忘拿的東西
Dialogue: 0,0:07:57.16,0:07:57.70,Sub-CN,,0,0,0,,再見
Dialogue: 0,0:08:01.05,0:08:02.48,Sub-CN,,0,0,0,,好誒
Dialogue: 0,0:08:07.13,0:08:08.23,Sub-CN,,0,0,0,,是這樣嗎
Dialogue: 0,0:08:08.81,0:08:10.98,Sub-CN,,0,0,0,,是的 非常感謝您
Dialogue: 0,0:08:12.41,0:08:15.03,Sub-CN,,0,0,0,,萊莎那傢伙 目不轉睛地看着書呢
Dialogue: 0,0:08:15.03,0:08:17.72,Sub-CN,,0,0,0,,要是她能因此想到甚麼辦法就好了
Dialogue: 0,0:08:17.72,0:08:18.70,Sub-CN,,0,0,0,,真是的
Dialogue: 0,0:08:19.16,0:08:21.28,Sub-CN,,0,0,0,,才半天不到就喊我們來幫她
Dialogue: 0,0:08:21.66,0:08:23.02,Sub-CN,,0,0,0,,你們都太寵她了
Dialogue: 0,0:08:23.60,0:08:25.82,Sub-CN,,0,0,0,,畢竟萊莎是為了我才接下任務的
Dialogue: 0,0:08:25.82,0:08:27.98,Sub-CN,,0,0,0,,我也想盡可能地幫幫她
Dialogue: 0,0:08:28.50,0:08:31.41,Sub-CN,,0,0,0,,雖說我給了她那本書
Dialogue: 0,0:08:31.41,0:08:34.28,Sub-CN,,0,0,0,,能否實踐上面的內容還是要靠她自己
Dialogue: 0,0:08:33.46,0:08:34.28,Sub-CN-UP,\an8,0,0,0,,就是這個!
Dialogue: 0,0:08:37.69,0:08:38.81,Sub-CN,,0,0,0,,我可以使用這個名為風精的
Dialogue: 0,0:08:38.81,0:08:40.78,Sub-CN,,0,0,0,,可以喚起強風的道具
Dialogue: 0,0:08:40.78,0:08:42.30,Sub-CN,,0,0,0,,對炎燒進行改良
Dialogue: 0,0:08:42.82,0:08:44.99,Sub-CN,,0,0,0,,先試着調合一下吧
Dialogue: 0,0:08:45.60,0:08:46.40,Sub-CN,,0,0,0,,好嘞
Dialogue: 0,0:08:47.44,0:08:49.30,Sub-CN,,0,0,0,,要忙起來了哦
Dialogue: 0,0:08:54.65,0:08:55.81,Sub-CN,,0,0,0,,很好
Dialogue: 0,0:08:57.93,0:08:58.99,Sub-CN,,0,0,0,,早上好
Dialogue: 0,0:08:59.48,0:09:00.99,Sub-CN,,0,0,0,,你今天也先過來了啊
Dialogue: 0,0:09:01.57,0:09:03.88,Sub-CN,,0,0,0,,你每天都很努力呢 萊莎
Dialogue: 0,0:09:06.70,0:09:07.44,Sub-CN,,0,0,0,,還好啦
Dialogue: 0,0:09:08.00,0:09:11.11,Sub-CN,,0,0,0,,你又做了這麼多炸彈嗎
Dialogue: 0,0:09:11.61,0:09:14.68,Sub-CN,,0,0,0,,這數量基本可以把這個廣場附近都炸飛了
Dialogue: 0,0:09:15.13,0:09:17.49,Sub-CN,,0,0,0,,這真的沒有問題嗎
Dialogue: 0,0:09:17.98,0:09:20.85,Sub-CN,,0,0,0,,只要不直接接觸火就沒問題啦
Dialogue: 0,0:09:20.85,0:09:22.36,Sub-CN,,0,0,0,,話說 塔奧
Dialogue: 0,0:09:22.36,0:09:24.57,Sub-CN,,0,0,0,,你可以教我記筆記的方法嗎?
Dialogue: 0,0:09:24.57,0:09:26.28,Sub-CN,,0,0,0,,我來寫的話就…
Dialogue: 0,0:09:28.11,0:09:30.75,Sub-CN,,0,0,0,,因為你一直想到哪寫到哪啊
Dialogue: 0,0:09:31.12,0:09:33.40,Sub-CN,,0,0,0,,要先在腦子裏整理一遍才行
Dialogue: 0,0:09:33.78,0:09:36.52,Sub-CN,,0,0,0,,那麼 我就先去練習揮劍了
Dialogue: 0,0:09:36.52,0:09:38.54,Sub-CN,,0,0,0,,我也去練習射箭了
Dialogue: 0,0:09:38.54,0:09:40.91,Sub-CN,,0,0,0,,萊莎 我帶便當來了
Dialogue: 0,0:09:40.91,0:09:42.48,Sub-CN,,0,0,0,,中午大家一起吃吧
Dialogue: 0,0:09:48.24,0:09:50.58,Sub-CN,,0,0,0,,要從甚麼比例開始測試呢
Dialogue: 0,0:09:51.19,0:09:53.70,Sub-CN,,0,0,0,,安佩爾先生 這個是命令型嗎?
Dialogue: 0,0:09:54.09,0:09:56.69,Sub-CN,,0,0,0,,沒錯 不要和感嘆句弄混哦
Dialogue: 0,0:10:04.68,0:10:06.39,Sub-CN,,0,0,0,,你逐漸可以射中標靶了
Dialogue: 0,0:10:07.22,0:10:09.50,Sub-CN,,0,0,0,,接下來就是等你能靠感覺掌握箭的軌跡了
Dialogue: 0,0:10:09.91,0:10:11.18,Sub-CN,,0,0,0,,拚命地射吧
Dialogue: 0,0:10:11.61,0:10:12.39,Sub-CN,,0,0,0,,好的
Dialogue: 0,0:10:16.73,0:10:18.88,Sub-CN,,0,0,0,,劍揮得越來越穩定了
Dialogue: 0,0:10:19.90,0:10:20.78,Sub-CN,,0,0,0,,看招!
Dialogue: 0,0:10:24.22,0:10:26.39,Sub-CN,,0,0,0,,蘭托 不要馬上鬆懈
Dialogue: 0,0:10:26.82,0:10:28.61,Sub-CN,,0,0,0,,鍛鍊時的習慣會出現在實戰中的
Dialogue: 0,0:10:29.06,0:10:29.98,Sub-CN,,0,0,0,,是
Dialogue: 0,0:10:35.17,0:10:36.41,Sub-CN,,0,0,0,,怎麼樣了? 萊莎
Dialogue: 0,0:10:36.94,0:10:38.61,Sub-CN,,0,0,0,,調合進行得順利嗎
Dialogue: 0,0:10:40.98,0:10:42.22,Sub-CN,,0,0,0,,很順利哦
Dialogue: 0,0:10:42.22,0:10:44.25,Sub-CN,,0,0,0,,我已經抓到合成的訣竅了
Dialogue: 0,0:10:44.25,0:10:46.57,Sub-CN,,0,0,0,,接下來就剩威力和效果的測試了
Dialogue: 0,0:10:47.20,0:10:49.27,Sub-CN,,0,0,0,,那些 全都要測試啊
Dialogue: 0,0:10:49.27,0:10:50.92,Sub-CN,,0,0,0,,這只是一小部分哦
Dialogue: 0,0:10:51.31,0:10:52.63,Sub-CN,,0,0,0,,因為是實驗啊
Dialogue: 0,0:10:52.63,0:10:54.95,Sub-CN,,0,0,0,,當然要做出一大堆來測試啊
Dialogue: 0,0:10:54.95,0:10:56.24,Sub-CN,,0,0,0,,說得好
Dialogue: 0,0:10:56.24,0:10:58.87,Sub-CN,,0,0,0,,真是的 所謂的鍊金術師
Dialogue: 0,0:10:58.87,0:11:00.20,Sub-CN,,0,0,0,,都是這樣的
Dialogue: 0,0:11:10.54,0:11:11.75,Sub-CN,,0,0,0,,還差一點
Dialogue: 0,0:11:12.10,0:11:14.53,Sub-CN,,0,0,0,,素材…調合…
Dialogue: 0,0:11:42.61,0:11:44.20,Sub-CN,,0,0,0,,太好了!
Dialogue: 0,0:11:45.16,0:11:46.47,Sub-CN,,0,0,0,,大成功哦
Dialogue: 0,0:11:49.82,0:11:52.29,Sub-CN,,0,0,0,,整體是這個大小啊
Dialogue: 0,0:11:53.30,0:11:55.19,Sub-CN,,0,0,0,,這樣的話兩顆應該正好吧
Dialogue: 0,0:11:55.77,0:11:56.60,Sub-CN,,0,0,0,,萊莎
Dialogue: 0,0:11:57.49,0:11:58.81,Sub-CN,,0,0,0,,阿佳特姐姐
Dialogue: 0,0:11:59.64,0:12:01.63,Sub-CN,,0,0,0,,距離期限已經沒有幾天了
Dialogue: 0,0:12:01.63,0:12:05.50,Sub-CN,,0,0,0,,你的那個鍊金術 有在進展嗎?
Dialogue: 0,0:12:06.14,0:12:08.51,Sub-CN,,0,0,0,,應該還行吧
Dialogue: 0,0:12:09.12,0:12:10.86,Sub-CN,,0,0,0,,真是含糊的說法啊
Dialogue: 0,0:12:11.36,0:12:13.57,Sub-CN,,0,0,0,,要是不行的話 我會跟你一起去道歉…
Dialogue: 0,0:12:13.57,0:12:14.72,Sub-CN,,0,0,0,,沒關係的
Dialogue: 0,0:12:15.21,0:12:16.39,Sub-CN,,0,0,0,,萊莎的話
Dialogue: 0,0:12:16.39,0:12:18.09,Sub-CN,,0,0,0,,帕特先生
Dialogue: 0,0:12:18.48,0:12:19.89,Sub-CN,,0,0,0,,我聽說了哦
Dialogue: 0,0:12:19.89,0:12:23.17,Sub-CN,,0,0,0,,你似乎要用鍊金術幫我們清理那邊啊
Dialogue: 0,0:12:24.02,0:12:25.79,Sub-CN,,0,0,0,,給你 這是慰問品
Dialogue: 0,0:12:27.99,0:12:29.51,Sub-CN,,0,0,0,,非常感謝
Dialogue: 0,0:12:30.14,0:12:34.11,Sub-CN,,0,0,0,,帕特先生 您知道萊莎會用鍊金術嗎?
Dialogue: 0,0:12:34.67,0:12:37.32,Sub-CN,,0,0,0,,是啊 之前她幫了我不少忙
Dialogue: 0,0:12:37.71,0:12:41.05,Sub-CN,,0,0,0,,不只是我 還有芭芭拉和巴希莉亞
Dialogue: 0,0:12:41.05,0:12:42.97,Sub-CN,,0,0,0,,約娜也接受了她的幫助
Dialogue: 0,0:12:42.97,0:12:44.21,Sub-CN,,0,0,0,,那麼多人嗎
Dialogue: 0,0:12:44.21,0:12:45.38,Sub-CN,,0,0,0,,多謝款待
Dialogue: 0,0:12:45.92,0:12:48.03,Sub-CN,,0,0,0,,我也會讓阿佳特姐姐看到的
Dialogue: 0,0:12:48.75,0:12:50.58,Sub-CN,,0,0,0,,鍊金術的厲害之處
Dialogue: 0,0:12:51.14,0:12:52.40,Sub-CN,,0,0,0,,你們就好好期待吧
Dialogue: 0,0:12:52.98,0:12:53.91,Sub-CN,,0,0,0,,再見
Dialogue: 0,0:12:55.19,0:12:58.33,Sub-CN,,0,0,0,,愛給人添麻煩的小鬼闖出了自己的世界
Dialogue: 0,0:12:58.33,0:13:00.80,Sub-CN,,0,0,0,,作為姐姐是不是有些寂寞呢?
Dialogue: 0,0:13:01.37,0:13:02.65,Sub-CN,,0,0,0,,我也不清楚
Dialogue: 0,0:13:02.65,0:13:04.65,Sub-CN,,0,0,0,,不過在這件事之後
Dialogue: 0,0:13:05.08,0:13:07.00,Sub-CN,,0,0,0,,也許她真的不需要我的照顧了
Dialogue: 0,0:13:21.53,0:13:23.88,Sub-CN,,0,0,0,,請不到進到這個繩子的範圍內
Dialogue: 0,0:13:23.88,0:13:24.88,Sub-CN,,0,0,0,,很危險的
Dialogue: 0,0:13:25.28,0:13:28.78,Sub-CN,,0,0,0,,請…請家長們拉好小孩子的手
Dialogue: 0,0:13:52.60,0:13:53.68,Sub-CN,,0,0,0,,讓兩位久等了
Dialogue: 0,0:13:54.33,0:13:55.06,Sub-CN,,0,0,0,,接下來就要開始了
Dialogue: 0,0:13:57.76,0:14:01.20,Sub-CN,,0,0,0,,那麼 請兩位也到繩子的外面暫避吧
Dialogue: 0,0:14:01.78,0:14:03.40,Sub-CN,,0,0,0,,蘭托 塔奧
Dialogue: 0,0:14:04.02,0:14:04.69,Sub-CN,,0,0,0,,準備好了
Dialogue: 0,0:14:05.19,0:14:06.15,Sub-CN,,0,0,0,,我也是
Dialogue: 0,0:14:10.02,0:14:12.18,Sub-CN,,0,0,0,,科洛蒂婭也以防萬一 出去避一避吧
Dialogue: 0,0:14:13.97,0:14:15.82,Sub-CN,,0,0,0,,萊莎 加油哦
Dialogue: 0,0:14:20.00,0:14:21.70,Sub-CN,,0,0,0,,莫問手藝 只看結果
Dialogue: 0,0:14:28.02,0:14:32.76,Sub-CN,,0,0,0,,上吧!
Dialogue: 0,0:14:53.38,0:14:54.83,Sub-CN,,0,0,0,,剛…剛才是怎麼回事?
Dialogue: 0,0:14:54.83,0:14:55.70,Sub-CN,,0,0,0,,發生甚麼事了?
Dialogue: 0,0:14:56.06,0:14:58.12,Sub-CN,,0,0,0,,明明產生了那麼大的爆炸
Dialogue: 0,0:14:58.12,0:15:00.30,Sub-CN,,0,0,0,,碎片卻完全沒有飛出來誒
Dialogue: 0,0:15:05.00,0:15:05.82,Sub-CN,,0,0,0,,很好
Dialogue: 0,0:15:07.67,0:15:09.84,Sub-CN,,0,0,0,,萊莎 恭喜你!
Dialogue: 0,0:15:10.34,0:15:12.34,Sub-CN,,0,0,0,,做得好啊
Dialogue: 0,0:15:12.34,0:15:13.90,Sub-CN,,0,0,0,,大成功呢
Dialogue: 0,0:15:19.32,0:15:21.73,Sub-CN,,0,0,0,,好厲害 這就是鍊金術嗎
Dialogue: 0,0:15:22.80,0:15:24.98,Sub-CN,,0,0,0,,石塊都變成粉末了
Dialogue: 0,0:15:26.92,0:15:27.90,Sub-CN,,0,0,0,,怎麼樣啊
Dialogue: 0,0:15:28.32,0:15:30.36,Sub-CN,,0,0,0,,礙事的垃圾都變成灰塵了
Dialogue: 0,0:15:30.36,0:15:32.13,Sub-CN,,0,0,0,,而且週邊也沒有遭到破壞
Dialogue: 0,0:15:32.13,0:15:33.91,Sub-CN,,0,0,0,,事後清掃也變得簡單了哦
Dialogue: 0,0:15:35.57,0:15:36.60,Sub-CN,,0,0,0,,確實
Dialogue: 0,0:15:37.15,0:15:39.58,Sub-CN,,0,0,0,,太精彩了 萊莎琳·斯托特
Dialogue: 0,0:15:40.07,0:15:42.27,Sub-CN,,0,0,0,,第二個課題也合格了
Dialogue: 0,0:15:42.82,0:15:43.59,Sub-CN,,0,0,0,,好誒
Dialogue: 0,0:15:45.15,0:15:46.12,Sub-CN,,0,0,0,,第二個…?
Dialogue: 0,0:15:46.85,0:15:48.53,Sub-CN,,0,0,0,,還是…沒有結束嗎
Dialogue: 0,0:15:48.96,0:15:50.15,Sub-CN,,0,0,0,,所謂的家長
Dialogue: 0,0:15:50.15,0:15:52.99,Sub-CN,,0,0,0,,就是不會輕易認可孩子的啊
Dialogue: 0,0:15:58.57,0:16:01.78,Sub-CN,,0,0,0,,不過能被大家那樣稱讚 感覺也不錯呢
Dialogue: 0,0:16:03.12,0:16:03.85,Sub-CN,,0,0,0,,確實呢
Dialogue: 0,0:16:04.48,0:16:06.09,Sub-CN,,0,0,0,,能順利解決真是太好了
Dialogue: 0,0:16:06.85,0:16:08.38,Sub-CN,,0,0,0,,已經試驗了這麼多次
Dialogue: 0,0:16:08.38,0:16:10.49,Sub-CN,,0,0,0,,早就知道一定沒問題了 不是嗎
Dialogue: 0,0:16:10.98,0:16:14.30,Sub-CN,,0,0,0,,你們就放寬心交給我就行啦
Dialogue: 0,0:16:15.01,0:16:17.82,Sub-CN,,0,0,0,,因為那花裏胡哨的煙花 還在沾沾自喜嗎
Dialogue: 0,0:16:18.65,0:16:20.90,Sub-CN,,0,0,0,,看來是相當得意忘形啊
Dialogue: 0,0:16:20.90,0:16:21.90,Sub-CN,,0,0,0,,博斯
Dialogue: 0,0:16:22.32,0:16:24.28,Sub-CN,,0,0,0,,說誰得意忘形呢
Dialogue: 0,0:16:24.62,0:16:25.20,Sub-CN,,0,0,0,,哼
Dialogue: 0,0:16:28.26,0:16:29.69,Sub-CN,,0,0,0,,那又如何呢
Dialogue: 0,0:16:30.25,0:16:33.51,Sub-CN,,0,0,0,,事實上鍊金術也在村裏派上了用場
Dialogue: 0,0:16:35.01,0:16:37.22,Sub-CN,,0,0,0,,反倒是博斯你們 看得開心嗎
Dialogue: 0,0:16:37.70,0:16:39.00,Sub-CN,,0,0,0,,我那華麗的「煙花」
Comment: 0,0:16:40.90,0:16:41.50,Sub-CN,,0,0,0,,嘁
Dialogue: 0,0:16:44.42,0:16:46.90,Sub-CN,,0,0,0,,博斯那傢伙無言以對了呢
Dialogue: 0,0:16:47.22,0:16:49.10,Sub-CN,,0,0,0,,嘿嘿 活該
Dialogue: 0,0:16:49.10,0:16:50.07,Sub-CN,,0,0,0,,蘭托
Dialogue: 0,0:16:50.47,0:16:52.70,Sub-CN,,0,0,0,,鍊金術也在村裏派上了用場…
Dialogue: 0,0:16:53.41,0:16:56.69,Sub-CN,,0,0,0,,父親是為了讓村裏人認識到這點
Dialogue: 0,0:16:56.69,0:16:57.50,Sub-CN,,0,0,0,,才設置的課題嗎…
Dialogue: 0,0:16:58.45,0:16:59.81,Sub-CN,,0,0,0,,怎麼了嗎 科洛蒂婭
Dialogue: 0,0:17:00.39,0:17:02.07,Sub-CN,,0,0,0,,沒有 別在意
Dialogue: 0,0:17:05.66,0:17:07.83,Sub-CN,,0,0,0,,真是累到了
Dialogue: 0,0:17:09.85,0:17:10.64,Sub-CN,,0,0,0,,萊莎
Dialogue: 0,0:17:11.33,0:17:12.59,Sub-CN,,0,0,0,,阿佳特姐姐
Dialogue: 0,0:17:12.93,0:17:16.01,Sub-CN,,0,0,0,,剛剛我的鍊金術 你看到了嗎
Dialogue: 0,0:17:16.01,0:17:18.09,Sub-CN,,0,0,0,,嗯 真是厲害呢
Dialogue: 0,0:17:18.74,0:17:20.61,Sub-CN,,0,0,0,,小菜一碟啦
Dialogue: 0,0:17:22.59,0:17:24.18,Sub-CN,,0,0,0,,我從羅密那裏聽說了
Dialogue: 0,0:17:24.67,0:17:27.88,Sub-CN,,0,0,0,,那個鍊金術還能用來修復甚麼的
Dialogue: 0,0:17:28.49,0:17:33.40,Sub-CN,,0,0,0,,是的 只要是我理解範圍內的物件
Dialogue: 0,0:17:34.07,0:17:37.46,Sub-CN,,0,0,0,,這樣啊 那…看看能修好這個麼
Dialogue: 0,0:17:39.81,0:17:41.28,Sub-CN,,0,0,0,,真好看
Dialogue: 0,0:17:41.28,0:17:42.41,Sub-CN,,0,0,0,,是甚麼裝飾嗎
Dialogue: 0,0:17:42.93,0:17:44.61,Sub-CN,,0,0,0,,嗯 差不多是這樣
Dialogue: 0,0:17:45.44,0:17:47.80,Sub-CN,,0,0,0,,它對我來說很重要 能修好嗎
Dialogue: 0,0:17:48.25,0:17:53.08,Sub-CN,,0,0,0,,嗯…構造看起來應該也不是很複雜
Dialogue: 0,0:17:54.32,0:17:55.88,Sub-CN,,0,0,0,,感覺應該能修好
Dialogue: 0,0:17:55.88,0:17:56.71,Sub-CN,,0,0,0,,幫大忙了
Dialogue: 0,0:17:57.18,0:17:59.18,Sub-CN,,0,0,0,,連村裏的鐵匠鋪都沒修好
Dialogue: 0,0:17:59.18,0:18:01.00,Sub-CN,,0,0,0,,好長一陣子我都放棄了
Dialogue: 0,0:18:01.78,0:18:03.13,Sub-CN,,0,0,0,,能拜託你嗎
Dialogue: 0,0:18:03.88,0:18:05.13,Sub-CN,,0,0,0,,交給我吧
Dialogue: 0,0:18:07.29,0:18:08.85,Sub-CN,,0,0,0,,簡直變了個人一樣
Dialogue: 0,0:18:09.27,0:18:09.85,Sub-CN,,0,0,0,,噢?
Dialogue: 0,0:18:10.37,0:18:11.90,Sub-CN,,0,0,0,,總之拜託啦
Dialogue: 0,0:18:16.60,0:18:18.90,Sub-CN,,0,0,0,,被阿佳特姐姐依靠了呢
Dialogue: 0,0:18:20.88,0:18:24.31,Sub-CN,,0,0,0,,好啦 再努力一下吧
Dialogue: 0,0:18:26.15,0:18:31.21,Sub-CN,,0,0,0,,沒錯 那場景真可以稱其為煉金之大祕術
Dialogue: 0,0:18:31.52,0:18:32.47,Sub-CN,,0,0,0,,誒…
Dialogue: 0,0:18:32.47,0:18:34.64,Sub-CN,,0,0,0,,我當時要是去看一看就好了
Dialogue: 0,0:18:34.64,0:18:37.50,Sub-CN,,0,0,0,,沒能親眼看見真是太遺憾了
Dialogue: 0,0:18:37.50,0:18:39.56,Sub-CN,,0,0,0,,但是對於你這樣的情況
Dialogue: 0,0:18:39.56,0:18:41.81,Sub-CN,,0,0,0,,請一定試試這款恩惠的藥膏
Dialogue: 0,0:18:41.81,0:18:43.51,Sub-CN,,0,0,0,,那邊吵吵嚷嚷甚麼呢
Dialogue: 0,0:18:44.13,0:18:45.68,Sub-CN,,0,0,0,,肯定是昨天的事情
Dialogue: 0,0:18:45.68,0:18:48.80,Sub-CN,,0,0,0,,萊莎他們搞出來的 叫鍊金術的東西
Dialogue: 0,0:18:49.31,0:18:50.51,Sub-CN,,0,0,0,,不知道是不是也能輕鬆搞定
Dialogue: 0,0:18:50.51,0:18:52.70,Sub-CN,,0,0,0,,我們打不到漁的問題
Dialogue: 0,0:18:53.05,0:18:55.44,Sub-CN,,0,0,0,,鍊金術原來這麼厲害嗎
Dialogue: 0,0:18:55.44,0:18:57.10,Sub-CN,,0,0,0,,嗯吶 簡直萬能
Dialogue: 0,0:19:01.26,0:19:02.57,Sub-CN,,0,0,0,,一幫小學雞
Dialogue: 0,0:19:06.05,0:19:09.38,Sub-CN,,0,0,0,,薩穆爾 怎麼一大早又喝上了
Dialogue: 0,0:19:10.02,0:19:11.98,Sub-CN,,0,0,0,,切 是米奧啊
Dialogue: 0,0:19:12.56,0:19:16.19,Sub-CN,,0,0,0,,一大早儘是遇到這些煩心事
Dialogue: 0,0:19:17.26,0:19:21.49,Sub-CN,,0,0,0,,蘭托在村裏受到好評就這麼讓你不爽嗎
Dialogue: 0,0:19:23.12,0:19:27.22,Sub-CN,,0,0,0,,那你看起來也不是很開心啊
Dialogue: 0,0:19:36.36,0:19:38.21,Sub-CN,,0,0,0,,阿佳特姐姐
Dialogue: 0,0:19:38.21,0:19:40.21,Sub-CN,,0,0,0,,裝飾品的修復完成了
Dialogue: 0,0:19:40.85,0:19:42.47,Sub-CN,,0,0,0,,昨天拜託的今天就好了嗎
Dialogue: 0,0:19:42.47,0:19:43.66,Sub-CN,,0,0,0,,真快啊
Dialogue: 0,0:19:43.66,0:19:44.92,Sub-CN,,0,0,0,,還好啦
Dialogue: 0,0:19:44.92,0:19:46.49,Sub-CN,,0,0,0,,雖然這麼快但我可沒敷衍喲
Dialogue: 0,0:19:47.01,0:19:48.45,Sub-CN,,0,0,0,,來 看看吧
Dialogue: 0,0:19:48.98,0:19:49.60,Sub-CN,,0,0,0,,好
Dialogue: 0,0:19:54.22,0:19:57.48,Sub-CN,,0,0,0,,真厲害啊 完全復原了
Dialogue: 0,0:19:58.23,0:19:59.78,Sub-CN,,0,0,0,,謝謝你 萊莎
Dialogue: 0,0:20:01.07,0:20:03.79,Sub-CN,,0,0,0,,鍊金術很不錯吧
Dialogue: 0,0:20:04.24,0:20:05.98,Sub-CN,,0,0,0,,話說就是那個
Dialogue: 0,0:20:06.86,0:20:08.18,Sub-CN,,0,0,0,,這是誰送的禮物嗎
Dialogue: 0,0:20:08.90,0:20:10.94,Sub-CN,,0,0,0,,才不是那樣呢
Dialogue: 0,0:20:10.94,0:20:13.73,Sub-CN,,0,0,0,,雖然也確實是禮物
Dialogue: 0,0:20:13.73,0:20:17.89,Sub-CN,,0,0,0,,甚麼嘛 奉行實用至上主義的阿佳特姐姐
Dialogue: 0,0:20:17.89,0:20:19.39,Sub-CN,,0,0,0,,突然拿出這麼好看的飾品
Dialogue: 0,0:20:19.39,0:20:21.44,Sub-CN,,0,0,0,,我還以為一定是…
Dialogue: 0,0:20:22.77,0:20:25.42,Sub-CN,,0,0,0,,這個呀 是這麼用的
Dialogue: 0,0:20:29.74,0:20:31.29,Sub-CN,,0,0,0,,所以這是甚麼
Dialogue: 0,0:20:31.71,0:20:34.10,Sub-CN,,0,0,0,,准騎士的證明
Dialogue: 0,0:20:34.47,0:20:36.17,Sub-CN,,0,0,0,,准騎士?
Dialogue: 0,0:20:36.17,0:20:38.67,Sub-CN,,0,0,0,,就是還沒被正式任命的騎士
Dialogue: 0,0:20:39.38,0:20:41.20,Sub-CN,,0,0,0,,這是在王都被賜予的
Dialogue: 0,0:20:41.72,0:20:43.99,Sub-CN,,0,0,0,,阿佳特姐姐
Dialogue: 0,0:20:44.42,0:20:46.85,Sub-CN,,0,0,0,,你原來去過阿斯拉阿姆伯特王都嗎
Dialogue: 0,0:20:46.85,0:20:48.78,Sub-CN,,0,0,0,,不對 原來你是騎士呀
Dialogue: 0,0:20:48.78,0:20:50.10,Sub-CN,,0,0,0,,是准騎士
Dialogue: 0,0:20:50.50,0:20:54.40,Sub-CN,,0,0,0,,不過一開始我確實是為了成為騎士而離島的
Dialogue: 0,0:20:54.75,0:20:56.48,Sub-CN,,0,0,0,,阿佳特姐姐也離開過島啊
Dialogue: 0,0:20:57.36,0:20:58.90,Sub-CN,,0,0,0,,那你從騎士考試中落榜了嗎
Dialogue: 0,0:20:59.53,0:21:01.73,Sub-CN,,0,0,0,,沒有 我是合格了的
Dialogue: 0,0:21:01.73,0:21:02.91,Sub-CN,,0,0,0,,好厲害
Dialogue: 0,0:21:03.93,0:21:06.69,Sub-CN,,0,0,0,,誒 那為甚麼現在島上當守護者呢
Dialogue: 0,0:21:07.70,0:21:09.95,Sub-CN,,0,0,0,,因為我在合格後才發現
Dialogue: 0,0:21:09.95,0:21:13.64,Sub-CN,,0,0,0,,周遭總是談論着血統 身份 發跡 派系
Dialogue: 0,0:21:13.64,0:21:16.30,Sub-CN,,0,0,0,,之類煩人的話題
Dialogue: 0,0:21:17.57,0:21:18.82,Sub-CN,,0,0,0,,在聽着這些話題時 不知不覺中
Dialogue: 0,0:21:18.82,0:21:21.30,Sub-CN,,0,0,0,,我對王都 對城堡都漸漸失去了興趣
Dialogue: 0,0:21:21.93,0:21:23.91,Sub-CN,,0,0,0,,而島上的生活反而愈加令人懷念
Dialogue: 0,0:21:23.91,0:21:25.26,Sub-CN,,0,0,0,,最後還是回來了
Dialogue: 0,0:21:27.55,0:21:31.51,Sub-CN,,0,0,0,,唔 我倒是覺得比起這小島 待在王都更好
Dialogue: 0,0:21:31.97,0:21:33.60,Sub-CN,,0,0,0,,這裏大家都很死板
Dialogue: 0,0:21:33.95,0:21:35.27,Sub-CN,,0,0,0,,莫里茨先生也是作威作福
Dialogue: 0,0:21:36.49,0:21:39.61,Sub-CN,,0,0,0,,通過鍊金術 接觸到了各式各樣的人之後
Dialogue: 0,0:21:40.24,0:21:42.44,Sub-CN,,0,0,0,,你還是跟當搗蛋鬼時候的想法一樣嗎
Dialogue: 0,0:21:43.98,0:21:47.71,Sub-CN,,0,0,0,,確實大家也不像之前想的那麼…
Dialogue: 0,0:21:48.81,0:21:50.11,Sub-CN,,0,0,0,,莫里茨先生也是 別看他那樣
Dialogue: 0,0:21:50.11,0:21:52.74,Sub-CN,,0,0,0,,也是位工作認真的大人喲
Dialogue: 0,0:21:52.74,0:21:53.68,Sub-CN,,0,0,0,,誒
Dialogue: 0,0:21:55.42,0:21:57.41,Sub-CN,,0,0,0,,憑着自己好惡評價他人
Dialogue: 0,0:21:58.16,0:22:00.10,Sub-CN,,0,0,0,,你還是不夠成熟呢
Dialogue: 0,0:22:02.12,0:22:04.29,Sub-CN,,0,0,0,,反正我還是個孩子
Dialogue: 0,0:22:04.63,0:22:06.63,Sub-CN,,0,0,0,,也是 無論是這座島還是島上的人
Dialogue: 0,0:22:06.63,0:22:09.33,Sub-CN,,0,0,0,,今後用你那鍊金術
Dialogue: 0,0:22:10.06,0:22:12.23,Sub-CN,,0,0,0,,多多接觸 多多學習就好
Dialogue: 0,0:22:13.78,0:22:14.41,Sub-CN,,0,0,0,,嗯!
Dialogue: 0,0:22:15.82,0:22:18.86,Sub-CN,,0,0,0,,所以說 在王都真的沒發生點甚麼嗎
Dialogue: 0,0:22:18.86,0:22:20.23,Sub-CN,,0,0,0,,沒有沒有
Dialogue: 0,0:22:20.23,0:22:22.62,Sub-CN,,0,0,0,,基本都是些貴族或者王族啦

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerTopMusic,,0,0,0,,dakishimete, kinou yori
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerMusic,,0,0,0,,抱紧我
Dialogue: 0,0:23:01.80,0:23:07.11,LayznerTopMusic,,0,0,0,,aishitai hito tidak iru
Dialogue: 0,0:23:01.80,0:23:07.25,LayznerMusic,,0,0,0,,比昨天更爱你
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerTopMusic,,0,0,0,,toki ha hitoshizuku nigai namida
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerMusic,,0,0,0,,时间是一滴 苦涩的泪
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerTopMusic,,0,0,0,,kizutsuita pururougu
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerMusic,,0,0,0,,受伤的序曲
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerTopMusic,,0,0,0,,yasashisa e tsuzukuno yo
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerMusic,,0,0,0,,继续着温柔
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerTopMusic,,0,0,0,,mayowanai futari dake no
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerMusic,,0,0,0,,只为这不再迷惘的两人
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerTopMusic,,0,0,0,,LA ROSE ROUGE
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerMusic,,0,0,0,,献上一曲野玫瑰之歌
Dialogue: 0,0:01:43.95,0:01:55.15,Layzner,,0,0,0,,1999年10月 这里是纽约 曾经是地球上最繁荣最自由的都市
Dialogue: 0,0:01:56.90,0:02:00.55,Layzner,,0,0,0,,现在却是众所讳言的被黑暗和恐怖支配着的
Dialogue: 0,0:02:01.05,0:02:03.55,Layzner,,0,0,0,,古拉特斯的领地
Dialogue: 0,0:02:52.18,0:02:57.19,Layzner,,0,0,0,,时光流逝
Dialogue: 0,0:02:58.73,0:03:03.66,Layzner,,0,0,0,,我们静静的等待着自由到来的那一天
Dialogue: 0,0:03:05.33,0:03:09.91,Layzner,,0,0,0,,我叫安娜·史蒂芬妮 十七岁
Dialogue: 0,0:03:32.14,0:03:33.56,Layzner,,0,0,0,,这家伙
Dialogue: 0,0:03:36.08,0:03:37.41,Layzner,,0,0,0,,停下来
Dialogue: 0,0:03:38.39,0:03:40.00,Layzner,,0,0,0,,什么啊 安娜 给
Dialogue: 0,0:03:40.00,0:03:43.08,Layzner,,0,0,0,,破书看了也打不过他们
Dialogue: 0,0:03:43.30,0:03:44.62,Layzner,,0,0,0,,你别管 看就是了
Dialogue: 0,0:03:44.74,0:03:47.50,Layzner,,0,0,0,,什么笔强于剑 全是胡扯
Dialogue: 0,0:03:49.04,0:03:51.49,Layzner,,0,0,0,,马修 等一下
Dialogue: 0,0:03:53.56,0:03:56.23,Layzner,,0,0,0,,这样的情况不只这孩子一个 我想
Dialogue: 0,0:03:56.83,0:03:59.44,Layzner,,0,0,0,,也许他们只是在欺骗我们
Dialogue: 0,0:03:59.87,0:04:08.73,Layzner,,0,0,0,,但我还是投入到现在的工作中 希望把更多的书籍和记录留给后代
Dialogue: 0,0:04:09.85,0:04:10.94,Layzner,,0,0,0,,这是因为我害怕啊
Dialogue: 0,0:04:11.13,0:04:11.85,Layzner,,0,0,0,,害怕
Dialogue: 0,0:04:11.85,0:04:14.62,Layzner,,0,0,0,,一旦停止思考
Dialogue: 0,0:04:14.70,0:04:19.41,Layzner,,0,0,0,,最终自己也会在不知不觉中被那些家伙们洗脑 最怕这个啊
Dialogue: 0,0:04:19.41,0:04:21.16,Layzner,,0,0,0,,是啊 我也是
Dialogue: 0,0:04:21.98,0:04:25.80,Layzner,,0,0,0,,正因为如此 我们要尽可能多地增加战友
Dialogue: 0,0:04:25.93,0:04:28.70,Layzner,,0,0,0,,走和武装斗争不同的道路
Dialogue: 0,0:04:28.95,0:04:33.18,Layzner,,0,0,0,,即使很不起眼 即使一时看不到效果 我们也必须继续战斗下去
Dialogue: 0,0:04:35.91,0:04:37.39,Layzner,,0,0,0,,来了 他们
Dialogue: 0,0:04:37.39,0:04:39.45,Layzner,,0,0,0,,快点
Dialogue: 0,0:04:52.81,0:04:54.00,Layzner,,0,0,0,,快点 快点
Dialogue: 0,0:05:19.56,0:05:21.51,Layzner,,0,0,0,,狗狗 安静点
Dialogue: 0,0:05:29.01,0:05:30.25,Layzner,,0,0,0,,停止工作
Dialogue: 0,0:05:43.83,0:05:44.74,Layzner,,0,0,0,,你多大了
Dialogue: 0,0:05:45.23,0:05:46.61,Layzner,,0,0,0,,17岁
Dialogue: 0,0:06:04.75,0:06:07.40,Layzner,,0,0,0,,住手 不要
Dialogue: 0,0:06:18.62,0:06:19.44,Layzner,,0,0,0,,听好了 不想死的话就给我好好记住
Dialogue: 0,0:06:19.55,0:06:25.61,Layzner,,0,0,0,,我们许可以外的所有书籍 磁带 录像带 胶卷和绘画
Dialogue: 0,0:06:25.71,0:06:29.60,Layzner,,0,0,0,,一律禁止接触
Dialogue: 0,0:06:37.76,0:06:39.65,Layzner,,0,0,0,,工作有点热心过头啊
Dialogue: 0,0:06:42.91,0:06:43.65,Layzner,,0,0,0,,停下
Dialogue: 0,0:07:12.96,0:07:14.35,Layzner,,0,0,0,,查查这下面
Dialogue: 0,0:07:14.40,0:07:14.81,Layzner,,0,0,0,,是
Dialogue: 0,0:07:22.57,0:07:23.32,Layzner,,0,0,0,,找到了
Dialogue: 0,0:07:25.78,0:07:28.12,Layzner,,0,0,0,,别碰 别用你的脏手碰它
Dialogue: 0,0:07:29.27,0:07:30.71,Layzner,,0,0,0,,放开我
Dialogue: 0,0:07:31.91,0:07:33.98,Layzner,,0,0,0,,放开我 住手
Dialogue: 0,0:07:34.43,0:07:35.13,Layzner,,0,0,0,,住手
Dialogue: 0,0:07:35.13,0:07:41.23,Layzner,,0,0,0,,第二次世界大战期间 欧洲市民面对纳粹的侵略 誓死抵抗
Dialogue: 0,0:07:41.79,0:07:46.13,Layzner,,0,0,0,,为维护自由和和平进行了英勇不屈的
Dialogue: 0,0:07:57.28,0:07:58.91,Layzner,,0,0,0,,马修 快逃
Dialogue: 0,0:08:01.64,0:08:03.33,Layzner,,0,0,0,,站住 我要开枪了
Dialogue: 0,0:08:26.65,0:08:28.09,Layzner,,0,0,0,,是抵抗军
Dialogue: 0,0:08:29.28,0:08:31.42,Layzner,,0,0,0,,安娜 快逃
Dialogue: 0,0:08:32.53,0:08:33.23,Layzner,,0,0,0,,大卫
Dialogue: 0,0:08:48.50,0:08:49.34,Layzner,,0,0,0,,快逃
Dialogue: 0,0:09:04.09,0:09:07.83,Layzner,,0,0,0,,你们这些家伙 明天公开枪决
Dialogue: 0,0:09:09.54,0:09:11.72,Layzner,,0,0,0,,放开他们 要是不放的话
Dialogue: 0,0:09:11.72,0:09:12.38,Layzner,,0,0,0,,马修
Dialogue: 0,0:09:14.10,0:09:16.34,Layzner,,0,0,0,,松手 放开我
Dialogue: 0,0:09:35.43,0:09:35.99,Layzner,,0,0,0,,多乌
Dialogue: 0,0:09:36.40,0:09:37.12,Layzner,,0,0,0,,多乌
Dialogue: 0,0:09:39.19,0:09:40.43,Layzner,,0,0,0,,多乌
Dialogue: 0,0:09:40.82,0:09:43.80,Layzner,,0,0,0,,混蛋 要开枪就开枪 我不怕
Dialogue: 0,0:09:44.04,0:09:47.94,Layzner,,0,0,0,,即使是孩子 地球人的反抗行为也不可原谅 开枪
Dialogue: 0,0:09:48.85,0:09:50.00,Layzner,,0,0,0,,怎么搞的你
Dialogue: 0,0:09:54.26,0:09:55.78,Layzner,,0,0,0,,是不是想一起死啊
Dialogue: 0,0:09:59.02,0:09:59.85,Layzner,,0,0,0,,英二
Dialogue: 0,0:09:59.91,0:10:02.49,Layzner,,0,0,0,,英二 他说是英二
Dialogue: 0,0:10:02.81,0:10:03.59,Layzner,,0,0,0,,那个
Dialogue: 0,0:10:11.52,0:10:14.87,Layzner,,0,0,0,,有意思 我来试试看是不是本人
Dialogue: 0,0:10:25.16,0:10:32.23,Layzner,,0,0,0,,去把刚刚喊你名字的那个女孩子揍一顿 这钱就赏你
Dialogue: 0,0:10:50.07,0:10:51.04,Layzner,,0,0,0,,英二
Dialogue: 0,0:10:55.99,0:10:57.16,Layzner,,0,0,0,,大卫
Dialogue: 0,0:11:12.59,0:11:15.96,Layzner,,0,0,0,,舔我的靴子 我就给你
Dialogue: 0,0:11:23.57,0:11:24.47,Layzner,,0,0,0,,不要
Dialogue: 0,0:11:24.97,0:11:26.16,Layzner,,0,0,0,,不要
Dialogue: 0,0:11:28.83,0:11:30.59,Layzner,,0,0,0,,不要
Dialogue: 0,0:11:29.40,0:11:30.59,Layzner,,0,0,0,,不要 英二
Dialogue: 0,0:11:32.06,0:11:39.15,Layzner,,0,0,0,,要是你有一半古拉特斯血统的话 就不会做这种事 垃圾地球人 滚开
Dialogue: 0,0:11:43.91,0:11:44.49,Layzner,,0,0,0,,那个小鬼呢
Dialogue: 0,0:11:46.48,0:11:48.89,Layzner,,0,0,0,,算了 返回
Dialogue: 0,0:11:59.59,0:12:01.87,Layzner,,0,0,0,,没错 他是英二
Dialogue: 0,0:12:01.96,0:12:03.21,Layzner,,0,0,0,,你认错人了 安娜
Dialogue: 0,0:12:03.64,0:12:06.66,Layzner,,0,0,0,,他是什么样的人我最清楚
Dialogue: 0,0:12:28.57,0:12:29.08,Layzner,,0,0,0,,出来
Dialogue: 0,0:12:39.89,0:12:41.19,Layzner,,0,0,0,,你就是刚才的
Dialogue: 0,0:12:45.77,0:12:48.79,Layzner,,0,0,0,,出去 这儿不是你这种人来的地方
Dialogue: 0,0:12:59.91,0:13:01.06,Layzner,,0,0,0,,叫你出去
Dialogue: 0,0:13:34.29,0:13:37.06,Layzner,,0,0,0,,你这混蛋 传言原来是真的
Dialogue: 0,0:13:37.37,0:13:40.56,Layzner,,0,0,0,,罗安 解释一下 我不相信
Dialogue: 0,0:13:41.03,0:13:43.52,Layzner,,0,0,0,,明天你们将接受公开枪决
Dialogue: 0,0:13:44.05,0:13:45.32,Layzner,,0,0,0,,是你开枪的
Dialogue: 0,0:13:45.88,0:13:49.10,Layzner,,0,0,0,,我很吃惊 没想到两个人一起到这来了
Dialogue: 0,0:13:49.10,0:13:51.63,Layzner,,0,0,0,,出去 我不想看到你
Dialogue: 0,0:13:51.84,0:13:54.53,Layzner,,0,0,0,,正如你们所见 我是个叛徒
Dialogue: 0,0:13:55.13,0:13:57.74,Layzner,,0,0,0,,事到如今 不管你们说什么我都不会回答的
Dialogue: 0,0:13:57.74,0:14:00.84,Layzner,,0,0,0,,为什么 为什么你要投降到古拉特斯一遍
Dialogue: 0,0:14:00.84,0:14:02.20,Layzner,,0,0,0,,别跟这种家伙说话
Dialogue: 0,0:14:02.56,0:14:06.98,Layzner,,0,0,0,,你们应该抛弃无聊的地球人的自豪感 尽快成为古拉特斯人
Dialogue: 0,0:14:09.39,0:14:11.05,Layzner,,0,0,0,,对了 你们也有获救的方法
Dialogue: 0,0:14:07.64,0:14:09.94,Layzner,,0,0,0,,混蛋 你就为了来说这个
Dialogue: 0,0:14:12.02,0:14:16.77,Layzner,,0,0,0,,应该没什么好想的吧 所有方面古拉特斯人要胜过我们
Dialogue: 0,0:14:16.97,0:14:20.90,Layzner,,0,0,0,,你们要是进入到他们当中 应该会很明白的
Dialogue: 0,0:14:20.90,0:14:22.03,Layzner,,0,0,0,,出去
Dialogue: 0,0:14:25.68,0:14:26.69,Layzner,,0,0,0,,大卫
Dialogue: 0,0:14:27.55,0:14:29.61,Layzner,,0,0,0,,这也是古拉特斯的科技实力
Dialogue: 0,0:14:29.94,0:14:32.45,Layzner,,0,0,0,,明白吧 这就是力量的差别
Dialogue: 0,0:14:32.63,0:14:34.95,Layzner,,0,0,0,,罗安 你
Dialogue: 0,0:14:35.08,0:14:40.52,Layzner,,0,0,0,,虽然不算多 时间还是有的 改变主意了就告诉我
Dialogue: 0,0:14:47.24,0:14:48.43,Layzner,,0,0,0,,谢谢
Dialogue: 0,0:14:50.74,0:14:55.95,Layzner,,0,0,0,,地球人只有笨蛋和肮脏的叛徒两种啊
Dialogue: 0,0:15:00.78,0:15:04.01,Layzner,,0,0,0,,只有三年 三年啊 人变得这么快
Dialogue: 0,0:15:04.89,0:15:08.47,Layzner,,0,0,0,,人就这么脆弱吗
Dialogue: 0,0:15:09.48,0:15:12.13,Layzner,,0,0,0,,罗安 英二
Dialogue: 0,0:15:21.91,0:15:26.53,Layzner,,0,0,0,,我相信会有人替我们继续战斗的
Dialogue: 0,0:15:31.55,0:15:32.88,Layzner,,0,0,0,,安娜
Dialogue: 0,0:15:35.39,0:15:37.03,Layzner,,0,0,0,,可恶
Dialogue: 0,0:15:37.51,0:15:40.71,Layzner,,0,0,0,,不管发生什么事 你都要坚强的活下去啊 马修
Dialogue: 0,0:15:42.67,0:15:43.96,Layzner,,0,0,0,,安娜
Dialogue: 0,0:15:48.81,0:15:51.13,Layzner,,0,0,0,,求求你 救救他们
Dialogue: 0,0:15:51.73,0:15:52.82,Layzner,,0,0,0,,求你了
Dialogue: 0,0:16:06.24,0:16:08.70,Layzner,,0,0,0,,安娜
Dialogue: 0,0:16:28.47,0:16:30.09,Layzner,,0,0,0,,住手
Dialogue: 0,0:16:44.97,0:16:46.52,Layzner,,0,0,0,,对着人开枪啊
Dialogue: 0,0:16:49.56,0:16:51.30,Layzner,,0,0,0,,安娜
Dialogue: 0,0:16:53.91,0:17:00.57,Layzner,,0,0,0,,公开处决是为了警告其他人 草草了事就起不到效果了
Dialogue: 0,0:17:04.70,0:17:11.36,Layzner,,0,0,0,,住手 让他停下来啊
Dialogue: 0,0:17:13.02,0:17:15.18,Layzner,,0,0,0,,有谁帮忙吗 你们就这样看着自己人死掉吗
Dialogue: 0,0:17:16.99,0:17:18.98,Layzner,,0,0,0,,去救他们啊
Dialogue: 0,0:17:23.69,0:17:25.40,Layzner,,0,0,0,,你们这样也是人吗
Dialogue: 0,0:17:25.72,0:17:28.11,Layzner,,0,0,0,,灵魂都被古拉特斯人拿走了吗
Dialogue: 0,0:17:29.38,0:17:30.62,Layzner,,0,0,0,,混蛋
Dialogue: 0,0:17:40.36,0:17:41.71,Layzner,,0,0,0,,安娜
Dialogue: 0,0:17:41.96,0:17:44.47,Layzner,,0,0,0,,一个小毛孩能做得了什么
Dialogue: 0,0:17:47.38,0:17:48.39,Layzner,,0,0,0,,马修
Dialogue: 0,0:17:55.77,0:17:57.74,Layzner,,0,0,0,,马修 快回去
Dialogue: 0,0:17:57.84,0:17:59.53,Layzner,,0,0,0,,不然你也会被杀死的
Dialogue: 0,0:18:22.90,0:18:24.93,Layzner,,0,0,0,,打死他 快打死他
Dialogue: 0,0:19:22.62,0:19:23.66,Layzner,,0,0,0,,雷 雷兹纳
Dialogue: 0,0:19:30.18,0:19:31.10,Layzner,,0,0,0,,雷兹纳
Dialogue: 0,0:19:31.10,0:19:31.92,Layzner,,0,0,0,,是英二
Dialogue: 0,0:19:32.17,0:19:34.99,Layzner,,0,0,0,,是英二 我们看到的还真是英二啊
Dialogue: 0,0:20:46.44,0:20:47.47,Layzner,,0,0,0,,英二
Dialogue: 0,0:20:51.74,0:20:53.12,Layzner,,0,0,0,,抓好了
Dialogue: 0,0:21:24.99,0:21:28.44,Layzner,,0,0,0,,臭小子 去哪了这三年
Dialogue: 0,0:21:29.27,0:21:32.31,Layzner,,0,0,0,,我想你们啊 不是 我是来看你们的
Dialogue: 0,0:21:33.31,0:21:34.86,Layzner,,0,0,0,,我是两天前到这个城市的
Dialogue: 0,0:21:34.96,0:21:37.63,Layzner,,0,0,0,,那你是知道我们在这个城市的
Dialogue: 0,0:21:37.79,0:21:38.25,Layzner,,0,0,0,,是的
Dialogue: 0,0:21:40.82,0:21:42.48,Layzner,,0,0,0,,你这家伙
Dialogue: 0,0:21:51.50,0:21:52.06,Layzner,,0,0,0,,安娜
Dialogue: 0,0:21:54.67,0:21:55.61,Layzner,,0,0,0,,英二
Dialogue: 0,0:21:59.58,0:22:02.56,Layzner,,0,0,0,,昨天那次对不起了
Dialogue: 0,0:22:02.78,0:22:05.11,Layzner,,0,0,0,,不要紧的 那件事已经不要紧了
Dialogue: 0,0:22:06.13,0:22:07.14,Layzner,,0,0,0,,我很高兴
Dialogue: 0,0:22:35.42,0:22:37.49,Layzner,,0,0,0,,安娜
Dialogue: 0,0:23:54.51,0:23:55.34,Layzner,,0,0,0,,动手
Dialogue: 0,0:23:57.56,0:24:00.01,Layzner,,0,0,0,,我是从地狱回来的男人
Dialogue: 0,0:24:03.64,0:24:08.14,Layzner,,0,0,0,,下一集 华丽的鲁·凯恩

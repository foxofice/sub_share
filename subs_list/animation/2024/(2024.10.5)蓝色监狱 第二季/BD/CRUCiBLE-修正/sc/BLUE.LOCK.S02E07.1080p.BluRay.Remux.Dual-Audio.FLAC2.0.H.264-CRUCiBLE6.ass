Dialogue: 0,0:00:06.85,0:00:08.57,Default,,0,0,0,,发射罗
Dialogue: 0,0:00:10.37,0:00:11.28,Default,,0,0,0,,好快
Dialogue: 0,0:00:11.92,0:00:13.51,Default,,0,0,0,,双触球假动作
Dialogue: 0,0:00:13.52,0:00:14.51,Default,,0,0,0,,来了
Dialogue: 0,0:00:18.50,0:00:19.58,Default,,0,0,0,,要上罗
Dialogue: 0,0:00:20.01,0:00:21.54,Default,,0,0,0,,空中突进转身
Dialogue: 0,0:00:24.42,0:00:25.77,Default,,0,0,0,,过人成功
Dialogue: 0,0:00:25.77,0:00:27.42,Default,,0,0,0,,蜂乐 太完美了
Dialogue: 0,0:00:28.00,0:00:29.35,Default,,0,0,0,,可行
Dialogue: 0,0:00:29.35,0:00:31.15,Default,,0,0,0,,我们的足球
Dialogue: 0,0:00:31.15,0:00:32.84,Default,,0,0,0,,面对这些家伙也管用
Dialogue: 0,0:00:39.81,0:00:41.03,Default,,0,0,0,,真的假的
Dialogue: 0,0:00:42.22,0:00:43.60,Default,,0,0,0,,他怎么会在这里
Dialogue: 0,0:00:53.15,0:00:55.23,Default,,0,0,0,,超级防御
Dialogue: 0,0:00:55.24,0:00:57.53,Default,,0,0,0,,奧利佛・愛空
Dialogue: 0,0:00:58.27,0:00:59.11,Default,,0,0,0,,(蓝色监狱11杰 洁世一)
Dialogue: 0,0:00:59.11,0:01:00.91,Default,,0,0,0,,(蓝色监狱11杰 洁世一)\N刚才那球大概是…
Dialogue: 0,0:01:01.63,0:01:03.18,Default,,0,0,0,,他站在底线
Dialogue: 0,0:01:03.19,0:01:04.64,Default,,0,0,0,,观察传球出处
Dialogue: 0,0:01:04.64,0:01:07.09,Default,,0,0,0,,与整体位置后所发动的守备
Dialogue: 0,0:01:07.77,0:01:09.91,Default,,0,0,0,,就在那瞬间 掌握全况
Dialogue: 0,0:01:09.91,0:01:13.34,Default,,0,0,0,,毫不犹豫的冲向最危险的射门点
Dialogue: 0,0:01:14.26,0:01:16.56,Default,,0,0,0,,我想在球门前使用的反射动作
Dialogue: 0,0:01:17.05,0:01:20.02,Default,,0,0,0,,那家伙早就在守备上运用自如了
Dialogue: 0,0:01:20.71,0:01:24.56,Default,,0,0,0,,视野 头脑 体能
Dialogue: 0,0:01:25.29,0:01:27.80,Default,,0,0,0,,跟至今战斗过的DF
Dialogue: 0,0:01:27.81,0:01:29.65,Default,,0,0,0,,守备能力等级完全不同
Dialogue: 0,0:01:31.22,0:01:33.22,Default,,0,0,0,,这就是真正的DF
Dialogue: 0,0:01:33.23,0:01:34.19,Default,,0,0,0,,(U-20日本代表隊 CB)\N(奧利佛・愛空)
Dialogue: 0,0:01:34.19,0:01:36.99,Default,,0,0,0,,他就是 奧利佛・愛空
Dialogue: 0,0:01:37.60,0:01:38.87,Default,,0,0,0,,要开界外球了
Dialogue: 0,0:01:40.46,0:01:42.20,Default,,0,0,0,,若不击溃这家伙
Dialogue: 0,0:01:42.81,0:01:44.75,Default,,0,0,0,,就赢不了这场比赛
Dialogue: 0,0:01:54.85,0:01:56.17,Default,,0,0,0,,《蓝色监狱 VS. U-20 日本代表队》
Dialogue: 0,0:03:15.11,0:03:16.27,Default,,0,0,0,,《蓝色监狱 VS. U-20 日本代表队》
Dialogue: 0,0:03:18.02,0:03:20.94,Default,,0,0,0,,(第31话 糸师冴)
Dialogue: 0,0:03:26.24,0:03:28.12,Default,,0,0,0,,不管传多少次球
Dialogue: 0,0:03:28.12,0:03:30.12,Default,,0,0,0,,只要被爱空看守
Dialogue: 0,0:03:30.13,0:03:32.49,Default,,0,0,0,,就很难从正中央突破
Dialogue: 0,0:03:33.22,0:03:34.83,Default,,0,0,0,,那就从背后进攻
Dialogue: 0,0:03:34.84,0:03:36.30,Default,,0,0,0,,攻击第二选项
Dialogue: 0,0:03:36.30,0:03:38.53,Default,,0,0,0,,从右边路穿过去吧 乙夜
Dialogue: 0,0:03:38.70,0:03:39.35,Default,,0,0,0,,(蓝色11杰 乙夜影汰)
Dialogue: 0,0:03:39.35,0:03:42.32,Default,,0,0,0,,(蓝色11杰 乙夜影汰)\N你好 隐密突破
Dialogue: 0,0:03:42.85,0:03:44.86,Default,,0,0,0,,闻到了 闻到了
Dialogue: 0,0:03:45.47,0:03:48.66,Default,,0,0,0,,我看得到你的动作
Dialogue: 0,0:03:48.66,0:03:50.49,Default,,0,0,0,,(U-20日本代表 LSB 蛇来弥陀)
Dialogue: 0,0:03:51.97,0:03:54.60,Default,,0,0,0,,你是谁啊 刺青和尚
Dialogue: 0,0:03:55.08,0:03:56.74,Default,,0,0,0,,"阴" "阳"
Dialogue: 0,0:03:56.75,0:03:59.59,Default,,0,0,0,,球场上存在着"表"与"里"
Dialogue: 0,0:04:02.30,0:04:05.52,Default,,0,0,0,,持有球 站在表面的选手
Dialogue: 0,0:04:05.53,0:04:09.35,Default,,0,0,0,,以及在背后暗中活动\N企图一击必杀的影子
Dialogue: 0,0:04:09.97,0:04:12.52,Default,,0,0,0,,他跟上了我的不带球跑动
Dialogue: 0,0:04:13.13,0:04:15.34,Default,,0,0,0,,忍者 真遗憾
Dialogue: 0,0:04:15.35,0:04:17.23,Default,,0,0,0,,我跟你是同类
Dialogue: 0,0:04:19.44,0:04:21.53,Default,,0,0,0,,闻到了 闻到了
Dialogue: 0,0:04:22.17,0:04:23.33,Default,,0,0,0,,这家伙…
Dialogue: 0,0:04:24.55,0:04:28.25,Default,,0,0,0,,抢先绕到我想穿越的"里"之领域
Dialogue: 0,0:04:28.47,0:04:31.23,Default,,0,0,0,,练到更蹑手蹑脚的程度再来吧
Dialogue: 0,0:04:31.23,0:04:33.19,Default,,0,0,0,,下级忍者
Dialogue: 0,0:04:33.20,0:04:34.30,Default,,0,0,0,,烦死了
Dialogue: 0,0:04:35.05,0:04:37.80,Default,,0,0,0,,乙夜 居然甩不掉他
Dialogue: 0,0:04:38.46,0:04:40.13,Default,,0,0,0,,这样我就不能传球了
Dialogue: 0,0:04:40.53,0:04:42.28,Default,,0,0,0,,洁 转换想法
Dialogue: 0,0:04:42.28,0:04:43.27,Default,,0,0,0,,好
Dialogue: 0,0:04:43.69,0:04:45.05,Default,,0,0,0,,下一个选项
Dialogue: 0,0:04:45.53,0:04:46.92,Default,,0,0,0,,去另一侧吧
Dialogue: 0,0:04:46.92,0:04:48.93,Default,,0,0,0,,以1对1解决他们
Dialogue: 0,0:04:49.43,0:04:50.42,Default,,0,0,0,,雪宫
Dialogue: 0,0:04:50.80,0:04:52.52,Default,,0,0,0,,(蓝色监狱11杰 雪宫剑优)\N终于来了
Dialogue: 0,0:04:54.17,0:04:56.40,Default,,0,0,0,,那副眼镜 好帅喔
Dialogue: 0,0:04:56.40,0:04:57.85,Default,,0,0,0,,(U-20日本代表RSB 音留彻平)
Dialogue: 0,0:04:58.20,0:04:59.82,Default,,0,0,0,,谢谢夸奖 小不点
Dialogue: 0,0:05:05.24,0:05:06.66,Default,,0,0,0,,瞬间纵一闪
Dialogue: 0,0:05:07.75,0:05:09.00,Default,,0,0,0,,这边?
Dialogue: 0,0:05:09.01,0:05:10.62,Default,,0,0,0,,比资料上说得还要快
Dialogue: 0,0:05:10.94,0:05:13.00,Default,,0,0,0,,我应该已经甩掉这家伙了啊
Dialogue: 0,0:05:14.42,0:05:16.08,Default,,0,0,0,,是速度型的DF吗
Dialogue: 0,0:05:17.74,0:05:18.54,Default,,0,0,0,,这边?
Dialogue: 0,0:05:19.68,0:05:22.91,Default,,0,0,0,,虽然我不是体能点满的肉食型
Dialogue: 0,0:05:22.91,0:05:25.68,Default,,0,0,0,,但是个速度不输人的草食DF喔
Dialogue: 0,0:05:26.02,0:05:29.47,Default,,0,0,0,,真是一只相当要强的草食动物
Dialogue: 0,0:05:29.86,0:05:30.86,Default,,0,0,0,,真的假的
Dialogue: 0,0:05:30.87,0:05:32.39,Default,,0,0,0,,1对1无敌的雪宫居然…
Dialogue: 0,0:05:33.09,0:05:34.09,Default,,0,0,0,,这边?
Dialogue: 0,0:05:34.77,0:05:36.40,Default,,0,0,0,,居然也无法突破
Dialogue: 0,0:05:36.40,0:05:37.80,Default,,0,0,0,,电光石火
Dialogue: 0,0:05:37.80,0:05:39.54,Default,,0,0,0,,那个SB是怎么回事
Dialogue: 0,0:05:39.54,0:05:40.63,Default,,0,0,0,,漏失球
Dialogue: 0,0:05:40.64,0:05:41.94,Default,,0,0,0,,好
Dialogue: 0,0:05:41.94,0:05:42.87,Default,,0,0,0,,(蓝色监狱11杰 凪诚士郎)
Dialogue: 0,0:05:42.87,0:05:45.20,Default,,0,0,0,,(蓝色监狱11杰 凪诚士郎)\N感觉不是很好突破
Dialogue: 0,0:05:45.54,0:05:47.63,Default,,0,0,0,,先停球再正面…
Dialogue: 0,0:05:47.63,0:05:48.99,Default,,0,0,0,,灭杀
Dialogue: 0,0:05:49.32,0:05:51.05,Default,,0,0,0,,超级停球专家
Dialogue: 0,0:05:51.06,0:05:53.47,Default,,0,0,0,,我不会给你任何自由的空间
Dialogue: 0,0:05:53.47,0:05:55.06,Default,,0,0,0,,(U-20日本代表CB 仁王和真)
Dialogue: 0,0:05:55.46,0:05:57.08,Default,,0,0,0,,施压得好快
Dialogue: 0,0:05:57.08,0:05:58.75,Default,,0,0,0,,还有这惊人的魄力
Dialogue: 0,0:05:59.19,0:06:01.25,Default,,0,0,0,,让我无法转向球门踢球
Dialogue: 0,0:06:01.96,0:06:05.30,Default,,0,0,0,,不给凪有停球空间的贴近防守
Dialogue: 0,0:06:05.30,0:06:06.67,Default,,0,0,0,,那家伙…
Dialogue: 0,0:06:06.68,0:06:08.30,Default,,0,0,0,,是力量型防守球员
Dialogue: 0,0:06:09.26,0:06:11.37,Default,,0,0,0,,叫我杜宾犬
Dialogue: 0,0:06:11.38,0:06:13.15,Default,,0,0,0,,你是看门狗吗
Dialogue: 0,0:06:13.55,0:06:16.56,Default,,0,0,0,,是啊 主人要来罗
Dialogue: 0,0:06:19.78,0:06:22.15,Default,,0,0,0,,乖孩子 仁王
Dialogue: 0,0:06:24.52,0:06:26.13,Default,,0,0,0,,爱空在这时冒出来
Dialogue: 0,0:06:26.13,0:06:28.22,Default,,0,0,0,,好强 滴水不漏的连续防守
Dialogue: 0,0:06:28.23,0:06:29.91,Default,,0,0,0,,这就是U-20日本代表的
Dialogue: 0,0:06:30.75,0:06:32.37,Default,,0,0,0,,铁壁四重奏
Dialogue: 0,0:06:33.39,0:06:35.97,Default,,0,0,0,,你们停下来罗 蓝色监狱
Dialogue: 0,0:06:38.78,0:06:40.05,Default,,0,0,0,,被摆了一道
Dialogue: 0,0:06:40.05,0:06:42.38,Default,,0,0,0,,一技纵向长传 瞬间攻守反转
Dialogue: 0,0:06:42.82,0:06:44.17,Default,,0,0,0,,前方是…
Dialogue: 0,0:06:45.32,0:06:46.84,Default,,0,0,0,,糸师冴
Dialogue: 0,0:06:48.75,0:06:51.36,Default,,0,0,0,,好了 迷倒众生吧 小天才
Dialogue: 0,0:06:52.16,0:06:54.02,Default,,0,0,0,,登场的时间到了
Dialogue: 0,0:06:54.78,0:06:56.55,Default,,0,0,0,,(U-20日本代表 OMF 糸师冴)
Dialogue: 0,0:06:56.55,0:06:58.91,Default,,0,0,0,,好的 此时球权交给了糸师冴
Dialogue: 0,0:06:58.92,0:07:01.36,Default,,0,0,0,,他会展现什么球技给大家看呢
Dialogue: 0,0:07:01.58,0:07:02.58,Default,,0,0,0,,等好久了
Dialogue: 0,0:07:02.59,0:07:04.19,Default,,0,0,0,,甩掉所有选手吧
Dialogue: 0,0:07:05.91,0:07:06.96,Default,,0,0,0,,盯防 盯防啊
Dialogue: 0,0:07:06.96,0:07:07.65,Default,,0,0,0,,快施压
Dialogue: 0,0:07:07.66,0:07:08.57,Default,,0,0,0,,搞什么啊
Dialogue: 0,0:07:09.10,0:07:10.36,Default,,0,0,0,,别想得逞
Dialogue: 0,0:07:10.37,0:07:11.31,Default,,0,0,0,,(蓝色监狱11杰 千切豹马)
Dialogue: 0,0:07:11.31,0:07:13.66,Default,,0,0,0,,(蓝色监狱11杰 千切豹马)\N我们早就想好反击避险对策了
Dialogue: 0,0:07:14.26,0:07:16.55,Default,,0,0,0,,蜂乐往前冲时
Dialogue: 0,0:07:16.56,0:07:19.86,Default,,0,0,0,,我就反过来后退 协助守备的系统
Dialogue: 0,0:07:19.87,0:07:22.10,Default,,0,0,0,,我要以自己的速度阻止你
Dialogue: 0,0:07:23.78,0:07:24.92,Default,,0,0,0,,这么快就往前传了
Dialogue: 0,0:07:25.48,0:07:27.03,Default,,0,0,0,,判断速度好快
Dialogue: 0,0:07:27.03,0:07:31.59,Default,,0,0,0,,这是50公尺以上的\N低弹道中速长传
Dialogue: 0,0:07:32.27,0:07:33.94,Default,,0,0,0,,是超困难的踢法耶
Dialogue: 0,0:07:33.94,0:07:35.52,Default,,0,0,0,,(U-20日本代表LWG 超健人)
Dialogue: 0,0:07:35.91,0:07:37.85,Default,,0,0,0,,真…了不起
Dialogue: 0,0:07:39.82,0:07:42.18,Default,,0,0,0,,(蓝色监狱11杰 蚁生十兵卫)\N我 来当你的对手
Dialogue: 0,0:07:42.19,0:07:43.52,Default,,0,0,0,,肌肉人体模特儿
Dialogue: 0,0:07:43.76,0:07:44.75,Default,,0,0,0,,不要
Dialogue: 0,0:07:45.20,0:07:46.49,Default,,0,0,0,,狐
Dialogue: 0,0:07:46.50,0:07:47.87,Default,,0,0,0,,很好
Dialogue: 0,0:07:48.00,0:07:50.36,Default,,0,0,0,,(U-20日本代表RWG 狐里辉)\N不浪费时间 顺畅地往前冲
Dialogue: 0,0:07:51.14,0:07:52.65,Default,,0,0,0,,(蓝色监狱11洁 乌旅人)\N如我所料
Dialogue: 0,0:07:52.66,0:07:54.38,Default,,0,0,0,,放马过来 小矮子
Dialogue: 0,0:07:54.68,0:07:55.95,Default,,0,0,0,,如你所料?
Dialogue: 0,0:07:55.96,0:07:58.12,Default,,0,0,0,,我们也是喔
Dialogue: 0,0:08:00.17,0:08:01.60,Default,,0,0,0,,不妙
Dialogue: 0,0:08:01.61,0:08:03.57,Default,,0,0,0,,球门前 中距离射门范围内
Dialogue: 0,0:08:03.57,0:08:05.50,Default,,0,0,0,,糸师冴无人防守
Dialogue: 0,0:08:05.50,0:08:07.29,Default,,0,0,0,,这是从糸师冴起头
Dialogue: 0,0:08:07.29,0:08:09.80,Default,,0,0,0,,以糸师冴结束的攻击型态
Dialogue: 0,0:08:10.26,0:08:12.64,Default,,0,0,0,,这波坚守快攻反击
Dialogue: 0,0:08:12.64,0:08:14.10,Default,,0,0,0,,就是他们的目的
Dialogue: 0,0:08:14.60,0:08:15.41,Default,,0,0,0,,二子
Dialogue: 0,0:08:15.41,0:08:16.40,Default,,0,0,0,,我正赶过去
Dialogue: 0,0:08:17.52,0:08:18.51,Default,,0,0,0,,别让他射门
Dialogue: 0,0:08:18.51,0:08:19.83,Default,,0,0,0,,争取一秒的时间
Dialogue: 0,0:08:19.84,0:08:20.94,Default,,0,0,0,,然后
Dialogue: 0,0:08:20.94,0:08:22.52,Default,,0,0,0,,千切就能赶回来了
Dialogue: 0,0:08:23.16,0:08:24.69,Default,,0,0,0,,二子 NICE
Dialogue: 0,0:08:24.70,0:08:26.95,Default,,0,0,0,,包夹 糸师冴 击溃他
Dialogue: 0,0:08:32.88,0:08:34.77,Default,,0,0,0,,从我们之间的缝隙
Dialogue: 0,0:08:34.77,0:08:36.62,Default,,0,0,0,,踢出绝妙抛物线传球
Dialogue: 0,0:08:37.30,0:08:39.16,Default,,0,0,0,,他到底看到多远之后的未来
Dialogue: 0,0:08:39.66,0:08:40.51,Default,,0,0,0,,很好
Dialogue: 0,0:08:40.52,0:08:41.46,Default,,0,0,0,,(U-20日本代表CF 闪堂秋人)
Dialogue: 0,0:08:41.48,0:08:42.28,Default,,0,0,0,,我牙丸
Dialogue: 0,0:08:42.28,0:08:43.77,Default,,0,0,0,,(蓝色监狱11杰 我牙丸吟)\N糟糕 要来了
Dialogue: 0,0:08:46.76,0:08:48.70,Default,,0,0,0,,跳吧 神经传达
Dialogue: 0,0:08:48.70,0:08:50.21,Default,,0,0,0,,我的超反应能力
Dialogue: 0,0:08:51.13,0:08:53.58,Default,,0,0,0,,我牙丸拳
Dialogue: 0,0:08:53.59,0:08:54.29,Default,,0,0,0,,什么
Dialogue: 0,0:08:54.30,0:08:55.48,Default,,0,0,0,,干得好 我牙丸
Dialogue: 0,0:08:56.84,0:08:58.11,Default,,0,0,0,,还在场内
Dialogue: 0,0:08:58.12,0:08:59.53,Default,,0,0,0,,糸师冴过去了
Dialogue: 0,0:08:59.68,0:09:01.35,Default,,0,0,0,,他已经冲过去了
Dialogue: 0,0:09:01.36,0:09:02.35,Default,,0,0,0,,又要再来一次了
Dialogue: 0,0:09:02.35,0:09:03.40,Default,,0,0,0,,提防传中
Dialogue: 0,0:09:06.38,0:09:08.12,Default,,0,0,0,,没有射门角度
Dialogue: 0,0:09:08.67,0:09:09.66,Default,,0,0,0,,撑过去
Dialogue: 0,0:09:14.18,0:09:15.49,Default,,0,0,0,,射门…
Dialogue: 0,0:09:30.75,0:09:32.34,Default,,0,0,0,,好厉害…
Dialogue: 0,0:09:34.53,0:09:35.66,Default,,0,0,0,,从那个位置…
Dialogue: 0,0:09:35.66,0:09:37.35,Default,,0,0,0,,直线抽球射门
Dialogue: 0,0:09:38.61,0:09:41.00,Default,,0,0,0,,应该是说 他目前的所有表现
Dialogue: 0,0:09:41.01,0:09:43.27,Default,,0,0,0,,到底包含了多少高超的踢球技术
Dialogue: 0,0:09:45.59,0:09:47.15,Default,,0,0,0,,太厉害了…
Dialogue: 0,0:09:48.27,0:09:50.34,Default,,0,0,0,,U-20日本代表
Dialogue: 0,0:09:50.34,0:09:53.03,Default,,0,0,0,,糸师冴的射门 先驰得点
Dialogue: 0,0:09:53.03,0:09:55.70,Default,,0,0,0,,在场的所有观众 都起身欢呼
Dialogue: 0,0:09:55.71,0:10:02.93,Default,,0,0,0,,冴…冴…
Dialogue: 0,0:10:02.94,0:10:03.93,Default,,0,0,0,,这…
Dialogue: 0,0:10:03.93,0:10:06.21,Default,,0,0,0,,算是四面楚歌呗…
Dialogue: 0,0:10:06.22,0:10:07.42,Default,,0,0,0,,可恶
Dialogue: 0,0:10:09.53,0:10:11.46,Default,,0,0,0,,原来如此
Dialogue: 0,0:10:12.86,0:10:14.63,Default,,0,0,0,,这场比赛的主角
Dialogue: 0,0:10:15.43,0:10:17.05,Default,,0,0,0,,是糸师冴
Dialogue: 0,0:10:17.06,0:10:24.11,Default,,0,0,0,,冴…冴…
Dialogue: 0,0:10:24.11,0:10:26.27,Default,,0,0,0,,而我们蓝色监狱
Dialogue: 0,0:10:27.15,0:10:29.24,Default,,0,0,0,,仅是为了衬托糸师冴的…
Dialogue: 0,0:10:29.25,0:10:30.61,Default,,0,0,0,,反派角色
Dialogue: 0,0:10:35.13,0:10:39.87,Default,,0,0,0,,根本就没有人…在看我们…
Dialogue: 0,0:10:39.88,0:10:43.55,Default,,0,0,0,,糸师冴…
Dialogue: 0,0:10:43.55,0:10:45.00,Default,,0,0,0,,洁 别被吞噬了
Dialogue: 0,0:10:47.23,0:10:50.33,Default,,0,0,0,,你…只要看着我就行了
Dialogue: 0,0:10:51.87,0:10:53.79,Default,,0,0,0,,90分钟后
Dialogue: 0,0:10:53.80,0:10:57.05,Default,,0,0,0,,我会把这片欢呼声 变成哀嚎声
Dialogue: 0,0:10:58.15,0:10:59.15,Default,,0,0,0,,凛
Dialogue: 0,0:11:02.37,0:11:05.20,Default,,0,0,0,,糸师冴果然是个天才
Dialogue: 0,0:11:05.20,0:11:07.25,Default,,0,0,0,,这是天才的冲击性登场
Dialogue: 0,0:11:07.25,0:11:09.92,Default,,0,0,0,,这就是糸师冴的实力
Dialogue: 0,0:11:09.92,0:11:11.16,Default,,0,0,0,,我们今天
Dialogue: 0,0:11:11.16,0:11:14.28,Default,,0,0,0,,或许正在目击 英雄的诞生
Dialogue: 0,0:11:14.29,0:11:15.16,Default,,0,0,0,,英雄的诞生
Dialogue: 0,0:11:15.50,0:11:17.16,Default,,0,0,0,,好厉害的射门
Dialogue: 0,0:11:17.17,0:11:19.15,Default,,0,0,0,,超级进球耶 冴
Dialogue: 0,0:11:19.15,0:11:20.62,Default,,0,0,0,,别碰我 没用的东西
Dialogue: 0,0:11:22.44,0:11:23.49,Default,,0,0,0,,三次…
Dialogue: 0,0:11:24.92,0:11:27.80,Default,,0,0,0,,这是我可以直接射门的次数
Dialogue: 0,0:11:28.52,0:11:31.86,Default,,0,0,0,,我故意扼杀机会\N花费心力舍弃自己的时间
Dialogue: 0,0:11:31.86,0:11:34.21,Default,,0,0,0,,传球给你们
Dialogue: 0,0:11:35.33,0:11:39.38,Default,,0,0,0,,可是那个垃圾\N在连猴子都能进球的大好机会踢偏
Dialogue: 0,0:11:39.39,0:11:41.15,Default,,0,0,0,,所以我才会烦躁到射门
Dialogue: 0,0:11:42.10,0:11:44.69,Default,,0,0,0,,猴子…垃圾…
Dialogue: 0,0:11:45.43,0:11:46.86,Default,,0,0,0,,好啦好啦
Dialogue: 0,0:11:46.87,0:11:49.49,Default,,0,0,0,,对面的守门员也挺厉害的嘛
Dialogue: 0,0:11:50.73,0:11:54.36,Default,,0,0,0,,攻击球员除了进球之外\N还有什么价值
Dialogue: 0,0:11:54.36,0:11:57.93,Default,,0,0,0,,得分能力比我这个MF\N还要弱的家伙
Dialogue: 0,0:11:57.93,0:12:00.54,Default,,0,0,0,,我可不承认他是攻击球员
Dialogue: 0,0:12:00.54,0:12:03.04,Default,,0,0,0,,太严格了吧 小天才
Dialogue: 0,0:12:03.05,0:12:06.41,Default,,0,0,0,,这样算来日本有几个攻击球员
Dialogue: 0,0:12:06.92,0:12:09.46,Default,,0,0,0,,这场比赛就是为了确认这点
Dialogue: 0,0:12:10.31,0:12:13.08,Default,,0,0,0,,没有下次了 不如猴子的家伙
Dialogue: 0,0:12:15.75,0:12:19.38,Default,,0,0,0,,闪堂 别在意 比赛才刚开始
Dialogue: 0,0:12:20.49,0:12:22.05,Default,,0,0,0,,别错过机会
Dialogue: 0,0:12:22.61,0:12:24.01,Default,,0,0,0,,好 爱空
Dialogue: 0,0:12:24.57,0:12:28.02,Default,,0,0,0,,U-20是我的球队
Dialogue: 0,0:12:32.07,0:12:35.17,Default,,0,0,0,,可恶 我都挡下那球了
Dialogue: 0,0:12:35.17,0:12:36.82,Default,,0,0,0,,刚才那招超时尚的
Dialogue: 0,0:12:36.83,0:12:38.60,Default,,0,0,0,,Mr.超反应
Dialogue: 0,0:12:38.61,0:12:40.68,Default,,0,0,0,,我 都看在眼里
Dialogue: 0,0:12:41.08,0:12:44.20,Default,,0,0,0,,话说回来\N他居然能从那个位置进球
Dialogue: 0,0:12:44.77,0:12:47.66,Default,,0,0,0,,从超守备发动的坚守快攻
Dialogue: 0,0:12:47.66,0:12:49.18,Default,,0,0,0,,因为糸师冴的关系
Dialogue: 0,0:12:49.19,0:12:52.36,Default,,0,0,0,,他们被强化成一支\N截然不同的球队了
Dialogue: 0,0:12:52.36,0:12:53.29,Default,,0,0,0,,是啊
Dialogue: 0,0:12:54.75,0:12:58.30,Default,,0,0,0,,敌人靠四名DF 先巩固防守
Dialogue: 0,0:12:58.88,0:13:03.28,Default,,0,0,0,,若我们缺乏决定性的攻击\N并且球被抢走的话
Dialogue: 0,0:13:03.28,0:13:05.20,Default,,0,0,0,,就会以糸师冴为起点
Dialogue: 0,0:13:05.21,0:13:06.98,Default,,0,0,0,,一口气展开快攻
Dialogue: 0,0:13:09.11,0:13:12.14,Default,,0,0,0,,这就是U-20日本代表的战法
Dialogue: 0,0:13:13.93,0:13:15.40,Default,,0,0,0,,要怎么击溃他们呢…
Dialogue: 0,0:13:17.16,0:13:22.00,Default,,0,0,0,,我们在最终集训练习的战法\N完全不管用
Dialogue: 0,0:13:22.65,0:13:25.24,Default,,0,0,0,,(蓝色监狱 职员 帝襟杏里)\N绘心先生 这样没问题吗
Dialogue: 0,0:13:25.24,0:13:27.58,Default,,0,0,0,,差不多就是这样吧
Dialogue: 0,0:13:28.45,0:13:29.99,Default,,0,0,0,,太不负责任了吧
Dialogue: 0,0:13:30.26,0:13:33.16,Default,,0,0,0,,"练习"毕竟是"练习"嘛 杏里
Dialogue: 0,0:13:33.17,0:13:34.19,Default,,0,0,0,,(蓝色监狱总指挥 绘心甚八)
Dialogue: 0,0:13:34.20,0:13:36.67,Default,,0,0,0,,(蓝色监狱总指挥 绘心甚八)\N"练习"能培育出的东西
Dialogue: 0,0:13:36.69,0:13:39.35,Default,,0,0,0,,顶多只是在无压力下\N所发挥的"技术"
Dialogue: 0,0:13:40.23,0:13:41.93,Default,,0,0,0,,(练习中)\N不管在哪个领域都一样
Dialogue: 0,0:13:41.93,0:13:44.43,Default,,0,0,0,,"练习"时发挥了惊人的表现
Dialogue: 0,0:13:45.30,0:13:46.42,Default,,0,0,0,,可是在"正式上场"时
Dialogue: 0,0:13:46.43,0:13:47.76,Default,,0,0,0,,(正式上场)\N却表现的差强人意
Dialogue: 0,0:13:49.64,0:13:51.71,Default,,0,0,0,,我有类似的经验
Dialogue: 0,0:13:51.72,0:13:54.36,Default,,0,0,0,,例如在钢琴发表会上弹错…
Dialogue: 0,0:13:54.37,0:13:55.49,Default,,0,0,0,,没错
Dialogue: 0,0:13:56.32,0:13:59.58,Default,,0,0,0,,"练习"和"正式上场"的决定性差异
Dialogue: 0,0:13:59.58,0:14:01.07,Default,,0,0,0,,在于是否有"压力"
Dialogue: 0,0:14:02.69,0:14:04.62,Default,,0,0,0,,舞台环境
Dialogue: 0,0:14:04.62,0:14:06.32,Default,,0,0,0,,比赛对手
Dialogue: 0,0:14:06.32,0:14:08.66,Default,,0,0,0,,以及自己的状态
Dialogue: 0,0:14:09.28,0:14:11.20,Default,,0,0,0,,精神变化
Dialogue: 0,0:14:11.21,0:14:13.17,Default,,0,0,0,,肌肉僵硬
Dialogue: 0,0:14:13.17,0:14:14.75,Default,,0,0,0,,思考停滞
Dialogue: 0,0:14:15.49,0:14:20.74,Default,,0,0,0,,"正式上场"可是充斥着\N令人陷入负面螺旋的要素
Dialogue: 0,0:14:20.75,0:14:23.76,Default,,0,0,0,,不可能跟"练习"时一样
Dialogue: 0,0:14:24.68,0:14:28.26,Default,,0,0,0,,若想打破这种压力的方法只有一个
Dialogue: 0,0:14:29.32,0:14:30.39,Default,,0,0,0,,那就是"即兴"
Dialogue: 0,0:14:31.83,0:14:34.18,Default,,0,0,0,,你不打算给任何指示吗
Dialogue: 0,0:14:34.19,0:14:35.80,Default,,0,0,0,,继续旁观下去的话…
Dialogue: 0,0:14:35.81,0:14:37.76,Default,,0,0,0,,闭嘴 相信他们吧
Dialogue: 0,0:14:37.76,0:14:39.98,Default,,0,0,0,,我们的自私鬼们
Dialogue: 0,0:14:41.08,0:14:43.03,Default,,0,0,0,,在"正式上场"时可是很强的
Dialogue: 0,0:14:47.20,0:14:50.03,Default,,0,0,0,,瓦解DF阵容的要素还不够
Dialogue: 0,0:14:50.58,0:14:54.26,Default,,0,0,0,,对我来说\N他们就是如此未知的强敌
Dialogue: 0,0:14:54.26,0:14:55.12,Default,,0,0,0,,不过…
Dialogue: 0,0:14:55.79,0:14:58.79,Default,,0,0,0,,你只要看着我就行了
Dialogue: 0,0:14:59.59,0:15:01.38,Default,,0,0,0,,我该做的事情很明确
Dialogue: 0,0:15:01.88,0:15:04.07,Default,,0,0,0,,消除无谓的思考
Dialogue: 0,0:15:04.07,0:15:06.59,Default,,0,0,0,,将我目前的所有能力
Dialogue: 0,0:15:07.77,0:15:10.30,Default,,0,0,0,,集中在与凛之间的球技
Dialogue: 0,0:15:12.71,0:15:13.41,Default,,0,0,0,,(U-20日本代表 DMF 若月树)
Dialogue: 0,0:15:13.42,0:15:16.77,Default,,0,0,0,,不管在中盘\N交换传球多少次都没用
Dialogue: 0,0:15:17.51,0:15:21.31,Default,,0,0,0,,你很迷惘 因为球传不出去吧
Dialogue: 0,0:15:21.90,0:15:24.07,Default,,0,0,0,,胡说八道 没睡饱脸
Dialogue: 0,0:15:27.53,0:15:29.80,Default,,0,0,0,,比刚才更细腻的传球
Dialogue: 0,0:15:29.80,0:15:32.41,Default,,0,0,0,,要改变…进攻方式吗
Dialogue: 0,0:15:33.28,0:15:35.77,Default,,0,0,0,,不采取三角形了吗
Dialogue: 0,0:15:35.77,0:15:37.58,Default,,0,0,0,,别管其他的事
Dialogue: 0,0:15:37.58,0:15:39.87,Default,,0,0,0,,在凛的想像中…
Dialogue: 0,0:15:39.87,0:15:41.00,Default,,0,0,0,,大闹一番吧
Dialogue: 0,0:15:41.28,0:15:42.84,Default,,0,0,0,,传球节奏变快了
Dialogue: 0,0:15:45.11,0:15:47.10,Default,,0,0,0,,猜不透这两个人
Dialogue: 0,0:15:47.52,0:15:51.08,Default,,0,0,0,,11号在10号身旁不断移动
Dialogue: 0,0:15:51.09,0:15:54.51,Default,,0,0,0,,使得10号的选项增加\N令人无法掌握
Dialogue: 0,0:15:56.21,0:15:57.06,Default,,0,0,0,,糟糕
Dialogue: 0,0:15:57.06,0:15:58.52,Default,,0,0,0,,在这里脚后跟传球
Dialogue: 0,0:15:59.30,0:16:00.81,Default,,0,0,0,,我们被钓走了
Dialogue: 0,0:16:01.93,0:16:02.92,Default,,0,0,0,,来了
Dialogue: 0,0:16:03.71,0:16:05.82,Default,,0,0,0,,真是令人嫉妒的合作啊
Dialogue: 0,0:16:06.49,0:16:08.57,Default,,0,0,0,,这样一来那两人
Dialogue: 0,0:16:08.57,0:16:11.24,Default,,0,0,0,,就能以自由之身冲向最前线
Dialogue: 0,0:16:12.74,0:16:14.99,Default,,0,0,0,,凪后方有两名CB
Dialogue: 0,0:16:15.00,0:16:17.03,Default,,0,0,0,,三对二 制造出人数有利局面了
Dialogue: 0,0:16:17.03,0:16:18.25,Default,,0,0,0,,得分机会
Dialogue: 0,0:16:18.87,0:16:20.12,Default,,0,0,0,,从这里开始…
Dialogue: 0,0:16:21.26,0:16:24.47,Default,,0,0,0,,我要遵循我的"自私"
Dialogue: 0,0:16:24.73,0:16:26.97,Default,,0,0,0,,这里又分头行动?
Dialogue: 0,0:16:26.97,0:16:28.92,Default,,0,0,0,,真是一对莫名其妙的搭档
Dialogue: 0,0:16:29.19,0:16:30.94,Default,,0,0,0,,爱空 我们两人一起挡下
Dialogue: 0,0:16:32.64,0:16:35.05,Default,,0,0,0,,小毛贼 动作不错嘛
Dialogue: 0,0:16:36.11,0:16:37.56,Default,,0,0,0,,趁现在 这边
Dialogue: 0,0:16:37.90,0:16:40.31,Default,,0,0,0,,不对 是那边吧
Dialogue: 0,0:16:41.09,0:16:42.15,Default,,0,0,0,,复仇者
Dialogue: 0,0:16:46.65,0:16:47.81,Default,,0,0,0,,甩掉了
Dialogue: 0,0:16:47.81,0:16:49.07,Default,,0,0,0,,不错的"即兴"
Dialogue: 0,0:16:49.50,0:16:51.21,Default,,0,0,0,,糸师凛
Dialogue: 0,0:16:51.21,0:16:54.57,Default,,0,0,0,,你的觉醒正是迈向胜利的前奏
Dialogue: 0,0:16:57.94,0:17:00.55,Default,,0,0,0,,来吧 如果要射门的话\N就是这个时机
Dialogue: 0,0:17:02.59,0:17:04.18,Default,,0,0,0,,进一步盘球切入?
Dialogue: 0,0:17:04.19,0:17:05.75,Default,,0,0,0,,跑到无角度的射门点?
Dialogue: 0,0:17:06.62,0:17:07.96,Default,,0,0,0,,而且还是使用左脚
Dialogue: 0,0:17:08.79,0:17:10.22,Default,,0,0,0,,那家伙…
Dialogue: 0,0:17:10.22,0:17:12.59,Default,,0,0,0,,该不会是故意\N要踢出跟糸师冴一样的射门?
Dialogue: 0,0:17:19.25,0:17:20.99,Default,,0,0,0,,NICE 抢第二波
Dialogue: 0,0:17:23.32,0:17:24.66,Default,,0,0,0,,(蓝色监狱11杰 雪宫剑优)
Dialogue: 0,0:17:24.97,0:17:25.97,Default,,0,0,0,,来了
Dialogue: 0,0:17:27.01,0:17:29.32,Default,,0,0,0,,-别想\N-又是你
Dialogue: 0,0:17:29.73,0:17:32.15,Default,,0,0,0,,这个情况 是练习过的模式
Dialogue: 0,0:17:32.95,0:17:36.26,Default,,0,0,0,,雪宫发动攻势\N进入敌队DF视线范围内
Dialogue: 0,0:17:36.26,0:17:38.33,Default,,0,0,0,,我就做出成为传球选项
Dialogue: 0,0:17:38.34,0:17:39.91,Default,,0,0,0,,让对手瞬间产生犹豫的…
Dialogue: 0,0:17:40.46,0:17:41.54,Default,,0,0,0,,妨碍行动
Dialogue: 0,0:17:41.91,0:17:43.83,Default,,0,0,0,,糟糕 是哪边
Dialogue: 0,0:17:45.45,0:17:46.96,Default,,0,0,0,,反应慢了一步
Dialogue: 0,0:17:47.37,0:17:50.17,Default,,0,0,0,,NICE 洁 感激不尽
Dialogue: 0,0:17:53.92,0:17:54.92,Default,,0,0,0,,漂亮的射门
Dialogue: 0,0:17:54.92,0:17:56.84,Default,,0,0,0,,什…这样也不行
Dialogue: 0,0:17:56.86,0:17:58.90,Default,,0,0,0,,飞过去了 蛇来 快清开
Dialogue: 0,0:17:58.90,0:17:59.89,Default,,0,0,0,,我知道
Dialogue: 0,0:17:59.89,0:18:00.97,Default,,0,0,0,,你好
Dialogue: 0,0:18:01.35,0:18:03.85,Default,,0,0,0,,你的眼光从我身上移开了 笨蛋
Dialogue: 0,0:18:04.36,0:18:07.35,Default,,0,0,0,,面对球门前的漏失球\N有乙夜的超反应动作
Dialogue: 0,0:18:07.35,0:18:08.65,Default,,0,0,0,,这也跟练习一样
Dialogue: 0,0:18:09.31,0:18:12.90,Default,,0,0,0,,凛那自私的临场反应\N创造出目前的赛况
Dialogue: 0,0:18:14.04,0:18:15.93,Default,,0,0,0,,如今对手的阵型已被瓦解
Dialogue: 0,0:18:15.93,0:18:18.15,Default,,0,0,0,,我们的努力终于要开花结果了
Dialogue: 0,0:18:18.16,0:18:19.59,Default,,0,0,0,,"练习"奏效了
Dialogue: 0,0:18:23.49,0:18:25.76,Default,,0,0,0,,真的假的 大叔好碍事
Dialogue: 0,0:18:26.13,0:18:28.09,Default,,0,0,0,,好坚固 不过还没完
Dialogue: 0,0:18:28.09,0:18:28.92,Default,,0,0,0,,凪
Dialogue: 0,0:18:31.32,0:18:32.32,Default,,0,0,0,,大好机会
Dialogue: 0,0:18:32.75,0:18:33.91,Default,,0,0,0,,我不会让你射门的
Dialogue: 0,0:18:33.91,0:18:34.80,Default,,0,0,0,,没错
Dialogue: 0,0:18:35.32,0:18:37.18,Default,,0,0,0,,以…射门动作
Dialogue: 0,0:18:39.05,0:18:40.64,Default,,0,0,0,,做瞬间吸收
Dialogue: 0,0:18:42.51,0:18:43.68,Default,,0,0,0,,脚尖顶球?
Dialogue: 0,0:18:47.06,0:18:49.44,Default,,0,0,0,,然后是跳跃旋转?
Dialogue: 0,0:18:53.62,0:18:55.19,Default,,0,0,0,,幸会 日本
Dialogue: 0,0:18:56.30,0:18:57.29,Default,,0,0,0,,我是…
Dialogue: 0,0:18:59.42,0:19:00.95,Default,,0,0,0,,凪诚士郎
Dialogue: 0,0:19:19.08,0:19:22.35,Default,,0,0,0,,自我介绍…失败了吗
Dialogue: 0,0:19:29.74,0:19:31.02,Default,,0,0,0,,好耶…痛
Dialogue: 0,0:19:42.95,0:19:44.20,Default,,0,0,0,,不会吧…
Dialogue: 0,0:19:44.60,0:19:45.67,Default,,0,0,0,,有一套
Dialogue: 0,0:19:47.10,0:19:48.61,Default,,0,0,0,,原来如此
Dialogue: 0,0:19:48.61,0:19:51.42,Default,,0,0,0,,每位球员都只想着进球
Dialogue: 0,0:19:52.53,0:19:55.14,Default,,0,0,0,,这就是…蓝色监狱
Dialogue: 0,0:19:57.99,0:20:01.55,Default,,0,0,0,,只要条件齐全 的确就破坏力十足


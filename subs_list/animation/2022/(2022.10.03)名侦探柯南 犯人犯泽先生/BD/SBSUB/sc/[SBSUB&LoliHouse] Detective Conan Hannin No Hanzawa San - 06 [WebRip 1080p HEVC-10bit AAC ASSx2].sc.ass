Dialogue: 0,0:01:34.32,0:01:36.58,DefaultSingle-S,,0,0,0,,{\c&H6033D4&\3c&HFBFBFB&\shad0\bord12\fs50\b1\pos(1706,1064)\fad(480,0)}米花町
Dialogue: 0,0:01:44.33,0:01:44.71,Note,,0,0,0,,{\c&H000000&\3c&HCFFFFFF&\bord5\shad0\fs60}没有
Dialogue: 0,0:01:44.71,0:01:47.34,Note,,0,0,0,,{\c&H000000&\3c&HCFFFFFF&\bord5\shad0\fs60}没有钱。
Dialogue: 0,0:01:54.76,0:01:57.47,Note,,0,0,0,,停业  多谢光顾
Dialogue: 0,0:01:57.47,0:02:02.64,Note,,0,0,0,,报案处
Dialogue: 0,0:03:45.62,0:03:46.16,Note,,0,0,0,,{\c&H63616F&\bord3\fs50\shad5\4c&HFFFFFF&}招聘{\c&H59E5F6&}小镇
Dialogue: 0,0:06:27.83,0:06:28.24,Note,,0,0,0,,
Dialogue: 0,0:01:32.25,0:01:36.57,DefaultSingle-S,,0,0,0,,		一身漆黑的家伙暗中活跃的漆黑城市  米花町
Dialogue: 0,0:01:36.87,0:01:40.76,DefaultSingle-S,,0,0,0,,		一个黑影怀着杀意来到了这里
Dialogue: 0,0:01:52.40,0:01:54.76,DefaultSingle-S,,0,0,0,,		可恶  看多少次都是零
Dialogue: 0,0:01:55.06,0:01:57.66,DefaultSingle-S,,0,0,0,,		那之后我去那家店  也是人去店空
Dialogue: 0,0:01:58.03,0:02:00.43,DefaultSingle-S,,0,0,0,,		我去米花警察署排队报案
Dialogue: 0,0:02:00.54,0:02:02.64,DefaultSingle-S,,0,0,0,,		结果警察都查杀人案去了  没空受理
Dialogue: 0,0:02:02.99,0:02:04.38,DefaultSingle-S,,0,0,0,,		现在的全部财产
Dialogue: 0,0:02:04.38,0:02:08.10,DefaultSingle-S,,0,0,0,,		就只有来东京前老妈给我的3万日元
Dialogue: 0,0:02:08.41,0:02:10.98,DefaultSingle-S,,0,0,0,,		我本想留着这笔钱
Dialogue: 0,0:02:10.98,0:02:14.11,DefaultSingle-S,,0,0,0,,		作为杀死那个男人之后回家的路费
Dialogue: 0,0:02:14.52,0:02:16.67,DefaultSingle-S,,0,0,0,,		干脆直接回老家算了
Dialogue: 0,0:02:16.77,0:02:18.57,DefaultSingle-S,,0,0,0,,		不  我在说什么丧气话
Dialogue: 0,0:02:18.76,0:02:19.87,DefaultSingle-S,,0,0,0,,		总之要工作
Dialogue: 0,0:02:19.87,0:02:22.23,DefaultSingle-S,,0,0,0,,		距离下一个交房租的日子还有三个星期
Dialogue: 0,0:02:22.23,0:02:23.74,DefaultSingle-S,,0,0,0,,		无论如何都要避免拖欠房租
Dialogue: 0,0:02:24.09,0:02:26.54,DefaultSingle-S,,0,0,0,,		总之去便利店看看招聘咨询吧
Dialogue: 0,0:02:31.08,0:02:32.13,DefaultSingle-S,,0,0,0,,		犯泽先生
Dialogue: 0,0:02:32.13,0:02:33.91,DefaultSingle-S,,0,0,0,,		我们在给翔太开失恋派对哦
Dialogue: 0,0:02:33.91,0:02:35.78,DefaultSingle-S,,0,0,0,,		你也来安慰安慰他呗
Dialogue: 0,0:02:36.11,0:02:37.76,DefaultSingle-S,,0,0,0,,		求安慰
Dialogue: 0,0:02:37.89,0:02:40.01,DefaultSingle-S,,0,0,0,,		这群派对狂倒是无忧无虑
Dialogue: 0,0:02:40.70,0:02:44.58,DefaultSingle-S,,0,0,0,,		有钱开这种派对  还不如借给我呢
Dialogue: 0,0:02:44.58,0:02:46.01,DefaultSingle-S,,0,0,0,,		对了  犯泽先生
Dialogue: 0,0:02:46.24,0:02:48.42,DefaultSingle-S,,0,0,0,,		上次派对的参加费3000日元
Dialogue: 0,0:02:48.91,0:02:51.75,DefaultSingle-S,,0,0,0,,		从3万里扣掉3千  太痛了
Dialogue: 0,0:02:51.75,0:02:54.15,DefaultSingle-S,,0,0,0,,		还有友香的生日派对费  1500日元
Dialogue: 0,0:02:54.18,0:02:57.78,DefaultSingle-S,,0,0,0,,		抱  抱歉  我能过阵子再给吗
Dialogue: 0,0:02:57.78,0:02:59.54,DefaultSingle-S,,0,0,0,,		我不是被偷了钱包吗
Dialogue: 0,0:02:59.68,0:03:01.53,DefaultSingle-S,,0,0,0,,		下个月一定给
Dialogue: 0,0:03:01.77,0:03:05.07,DefaultSingle-S,,0,0,0,,		犯泽先生  你拿什么保证你能活到下个月
Dialogue: 0,0:03:05.26,0:03:06.68,DefaultSingle-S,,0,0,0,,		这里可是米花町
Dialogue: 0,0:03:06.68,0:03:08.02,DefaultSingle-S,,0,0,0,,		不能借你钱
Dialogue: 0,0:03:08.13,0:03:09.85,DefaultSingle-S,,0,0,0,,		我们只有现在
Dialogue: 0,0:03:09.85,0:03:11.67,DefaultSingle-S,,0,0,0,,		我们是拼上性命在开派对
Dialogue: 0,0:03:11.76,0:03:13.25,DefaultSingle-S,,0,0,0,,		好  好帅
Dialogue: 0,0:03:13.39,0:03:14.35,DefaultSingle-S,,0,0,0,,		我收下了
Dialogue: 0,0:03:14.35,0:03:15.64,DefaultSingle-S,,0,0,0,,		我们是拼上性命在AA制
Dialogue: 0,0:03:15.64,0:03:16.34,DefaultSingle-S,,0,0,0,,		给你找零
Dialogue: 0,0:03:17.48,0:03:19.58,DefaultSingle-S,,0,0,0,,		余额25500日元
Dialogue: 0,0:03:19.70,0:03:21.73,DefaultSingle-S,,0,0,0,,		米花町的派对狂真无情
Dialogue: 0,0:03:21.96,0:03:24.07,DefaultSingle-S,,0,0,0,,		犯泽先生  听说你遇到扒手了？
Dialogue: 0,0:03:24.07,0:03:24.89,DefaultSingle-S,,0,0,0,,		管理人
Dialogue: 0,0:03:25.21,0:03:27.32,DefaultSingle-S,,0,0,0,,		交下个月的房租应该很艰难吧
Dialogue: 0,0:03:27.79,0:03:29.28,DefaultSingle-S,,0,0,0,,		嗯  是啊
Dialogue: 0,0:03:29.51,0:03:32.18,DefaultSingle-S,,0,0,0,,		要是无法按时交房租  就请立刻搬出去
Dialogue: 0,0:03:32.55,0:03:34.12,DefaultSingle-S,,0,0,0,,		我可是拼上性命在当管理人
Dialogue: 0,0:03:34.12,0:03:35.74,DefaultSingle-S,,0,0,0,,		合同上就是这么写的
Dialogue: 0,0:03:37.20,0:03:39.44,DefaultSingle-S,,0,0,0,,		要是在这米花町失去了住处
Dialogue: 0,0:03:40.36,0:03:41.78,DefaultSingle-S,,0,0,0,,		一定会成为猎物
Dialogue: 0,0:03:41.97,0:03:44.99,DefaultSingle-S,,0,0,0,,		不拼死找工作就要死了
Dialogue: 0,0:03:46.24,0:03:47.74,DefaultSingle-S,,0,0,0,,		餐饮  制造  收银
Dialogue: 0,0:03:47.74,0:03:50.20,DefaultSingle-S,,0,0,0,,		什么都好  给我个工作啊
Dialogue: 0,0:03:50.46,0:03:51.22,DefaultSingle-S,,0,0,0,,		不过等等
Dialogue: 0,0:03:51.35,0:03:54.04,DefaultSingle-S,,0,0,0,,		就算马上工作  也要一个月后才能拿到工资
Dialogue: 0,0:03:54.04,0:03:54.75,DefaultSingle-S,,0,0,0,,		来不及啊
Dialogue: 0,0:03:54.95,0:03:56.72,DefaultSingle-S,,0,0,0,,		短期  高薪  日结
Dialogue: 0,0:03:56.72,0:03:57.30,DefaultSingle-S,,0,0,0,,		就是这个
Dialogue: 0,0:03:57.70,0:04:01.82,DefaultSingle-S,,0,0,0,,		运送某样东西的简单工作  日薪11000日元
Dialogue: 0,0:04:01.82,0:04:04.41,DefaultSingle-S,,0,0,0,,		欢迎严守秘密的人  不问问题的人
Dialogue: 0,0:04:04.41,0:04:07.61,DefaultSingle-S,,0,0,0,,		失联后家属不会闹腾的人
Dialogue: 0,0:04:07.61,0:04:11.12,DefaultSingle-S,,0,0,0,,		在地下组装某样东西的工作  日薪20000日元
Dialogue: 0,0:04:11.12,0:04:14.81,DefaultSingle-S,,0,0,0,,		心理承受能力强的人  懂火药的人  口风紧的人
Dialogue: 0,0:04:14.81,0:04:18.32,DefaultSingle-S,,0,0,0,,		不会告诉警察的人  不知什么是正义的人优先
Dialogue: 0,0:04:18.61,0:04:19.98,DefaultSingle-S,,0,0,0,,		不是一般的可疑
Dialogue: 0,0:04:20.21,0:04:23.60,DefaultSingle-S,,0,0,0,,		乔装成某个人  在市内转悠一整天的工作
Dialogue: 0,0:04:23.60,0:04:25.70,DefaultSingle-S,,0,0,0,,		肯定是用来制造不在场证明的
Dialogue: 0,0:04:25.70,0:04:26.55,DefaultSingle-S,,0,0,0,,		请问
Dialogue: 0,0:04:27.00,0:04:30.76,DefaultSingle-S,,0,0,0,,		你在找工作吗
Dialogue: 0,0:04:34.62,0:04:37.85,DefaultSingle-S,,0,0,0,,		要不要去我家做一天兼职呢
Dialogue: 0,0:04:38.28,0:04:39.17,DefaultSingle-S,,0,0,0,,		这个人是…
Dialogue: 0,0:04:39.17,0:04:41.37,DefaultSingle-S,,0,0,0,,		之前说了危险的话的老爷爷
Dialogue: 0,0:04:41.46,0:04:43.87,DefaultSingle-S,,0,0,0,,		「爆炸」就是春季的季语啊
Dialogue: 0,0:04:44.84,0:04:47.47,DefaultSingle-S,,0,0,0,,		他肯定染指了犯罪
Dialogue: 0,0:04:47.57,0:04:50.05,DefaultSingle-S,,0,0,0,,		别担心  是个很简单的工作
Dialogue: 0,0:04:50.05,0:04:52.91,DefaultSingle-S,,0,0,0,,		就是协助我做实验
Dialogue: 0,0:04:52.91,0:04:54.81,DefaultSingle-S,,0,0,0,,		日薪3万怎么样
Dialogue: 0,0:04:54.98,0:04:56.44,DefaultSingle-S,,0,0,0,,		可疑度爆棚啊
Dialogue: 0,0:04:56.79,0:04:59.29,DefaultSingle-S,,0,0,0,,		什么样的实验啊  会不会有危险啊
Dialogue: 0,0:05:00.42,0:05:01.52,DefaultSingle-S,,0,0,0,,		日薪4万
Dialogue: 0,0:05:01.52,0:05:02.57,DefaultSingle-S,,0,0,0,,		为什么涨了
Dialogue: 0,0:05:02.70,0:05:06.16,DefaultSingle-S,,0,0,0,,		但是日薪4万的话  就能一口气解决房租问题了
Dialogue: 0,0:05:06.25,0:05:08.16,DefaultSingle-S,,0,0,0,,		请告诉我工作内容
Dialogue: 0,0:05:08.27,0:05:09.59,DefaultSingle-S,,0,0,0,,		我知道了  5万
Dialogue: 0,0:05:09.59,0:05:10.87,DefaultSingle-S,,0,0,0,,		好可怕
Dialogue: 0,0:05:11.23,0:05:13.21,DefaultSingle-S,,0,0,0,,		你做还是不做
Dialogue: 0,0:05:13.57,0:05:15.85,DefaultSingle-S,,0,0,0,,		为了在这个城市生存下去
Dialogue: 0,0:05:16.41,0:05:17.78,DefaultSingle-S,,0,0,0,,		我什么都做
Dialogue: 0,0:05:17.92,0:05:19.56,DefaultSingle-S,,0,0,0,,		我做  我缺钱
Dialogue: 0,0:05:19.56,0:05:21.31,DefaultSingle-S,,0,0,0,,		好  上车吧
Dialogue: 0,0:05:22.44,0:05:23.92,DefaultSingle-S,,0,0,0,,		这根麻醉针
Dialogue: 0,0:05:24.77,0:05:27.02,DefaultSingle-S,,0,0,0,,		如果总是对同一个人使用
Dialogue: 0,0:05:27.02,0:05:30.41,DefaultSingle-S,,0,0,0,,		就会让人产生耐受性  导致无法起效
Dialogue: 0,0:05:31.71,0:05:35.41,DefaultSingle-S,,0,0,0,,		二十多年来  我一点点提升麻醉药的浓度
Dialogue: 0,0:05:35.52,0:05:37.65,DefaultSingle-S,,0,0,0,,		现在它的威力已经能让大象睡着了
Dialogue: 0,0:05:37.90,0:05:38.90,DefaultSingle-S,,0,0,0,,		但是
Dialogue: 0,0:05:39.42,0:05:44.63,DefaultSingle-S,,0,0,0,,		这针偶尔会不小心刺中别人
Dialogue: 0,0:05:44.86,0:05:49.91,DefaultSingle-S,,0,0,0,,		幸亏目前还只是刺中对麻醉有耐受性的人
Dialogue: 0,0:05:49.91,0:05:53.95,DefaultSingle-S,,0,0,0,,		没有耐受性的人被刺中会怎么样呢
Dialogue: 0,0:05:55.29,0:05:58.33,DefaultSingle-S,,0,0,0,,		没事的  只是有点刺痛而已
Dialogue: 0,0:05:58.55,0:06:01.46,DefaultSingle-S,,0,0,0,,		之后就会睡过去了
Dialogue: 0,0:06:16.27,0:06:17.99,DefaultSingle-S,,0,0,0,,		喂
Dialogue: 0,0:06:18.43,0:06:20.74,DefaultSingle-S,,0,0,0,,		喂
Dialogue: 0,0:06:22.02,0:06:23.10,DefaultSingle-S,,0,0,0,,		犯泽先生
Dialogue: 0,0:06:23.58,0:06:24.85,DefaultSingle-S,,0,0,0,,		犯泽先生
Dialogue: 0,0:06:25.70,0:06:26.94,DefaultSingle-S,,0,0,0,,		犯泽先生
Dialogue: 0,0:06:28.48,0:06:29.43,DefaultSingle-S,,0,0,0,,		你醒了？
Dialogue: 0,0:06:29.43,0:06:30.53,DefaultSingle-S,,0,0,0,,		太好了
Dialogue: 0,0:06:30.53,0:06:31.36,DefaultSingle-S,,0,0,0,,		梦？
Dialogue: 0,0:06:31.98,0:06:34.52,DefaultSingle-S,,0,0,0,,		你睡了整整三个星期
Dialogue: 0,0:06:34.52,0:06:35.63,DefaultSingle-S,,0,0,0,,		三个星期？
Dialogue: 0,0:06:35.78,0:06:37.79,DefaultSingle-S,,0,0,0,,		今天是交房租的日子
Dialogue: 0,0:06:38.06,0:06:39.49,DefaultSingle-S,,0,0,0,,		合同上就是这样写的
Dialogue: 0,0:06:39.57,0:06:42.56,DefaultSingle-S,,0,0,0,,		下  下个月我一定付
Dialogue: 0,0:06:43.37,0:06:46.92,DefaultSingle-S,,0,0,0,,		下次也拜托你了  阿笠
Dialogue: 0,0:06:48.26,0:06:51.22,DefaultSingle-S,,0,0,0,,		勉强撑过了这个月
Dialogue: 0,0:06:51.30,0:06:53.72,DefaultSingle-S,,0,0,0,,		拼上性命工作  就是这么回事啊
Dialogue: 0,0:06:55.10,0:06:57.56,DefaultSingle-S,,0,0,0,,		看来再浓一点也没问题啊
Dialogue: 0,0:08:31.69,0:08:33.99,DefaultSingle-S,,0,0,0,,		播完6集  终于来到转折点
Dialogue: 0,0:08:33.99,0:08:37.71,DefaultSingle-S,,0,0,0,,		我们气势不减  下集将有多个新角色登场
Dialogue: 0,0:08:37.91,0:08:39.41,DefaultSingle-S,,0,0,0,,		粉丝很熟悉的那个人
Dialogue: 0,0:08:39.41,0:08:41.41,DefaultSingle-S,,0,0,0,,		还有一时想不起名字的人
Dialogue: 0,0:08:41.41,0:08:45.17,DefaultSingle-S,,0,0,0,,		极度刻意的杀人案和敷衍了事的名推理大爆发
Dialogue: 0,0:08:45.29,0:08:48.96,DefaultSingle-S,,0,0,0,,		虽然吹了这么大的牛皮  但是下集预告已经无梗可玩了
Dialogue: 0,0:08:48.96,0:08:51.38,DefaultSingle-S,,0,0,0,,		想到了有趣的梗请在官方账号下留言
Dialogue: 0,0:08:51.38,0:08:53.97,DefaultSingle-S,,0,0,0,,		看上去是随口说说  但实际上很不容易的
Dialogue: 0,0:08:53.97,0:08:55.97,DefaultSingle-S,,0,0,0,,		下集「劳动者的镇魂歌」
Dialogue: 0,0:08:55.97,0:08:58.55,DefaultSingle-S,,0,0,0,,		我能一口气说完台词撑到最后一集吗
Dialogue: 0,0:08:58.55,0:09:00.14,DefaultSingle-S,,0,0,0,,		让大家听到
Dialogue: 0,0:01:39.37,0:01:42.37,DefaultSingle-S,,0,0,0,,

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:06.34,0:01:10.19,Layzner,Eiji,0,0,0,,住手大卫 那不是古拉特斯军 可能是地球人
Dialogue: 0,0:01:44.29,0:01:48.04,Layzner,Anna,0,0,0,,雷兹纳 变成蓝色的火焰燃烧起来
Dialogue: 0,0:01:48.04,0:01:52.07,Layzner,Anna,0,0,0,,那看起来好像是隐藏的力量
Dialogue: 0,0:01:52.07,0:01:54.10,Layzner,Anna,0,0,0,,爆发开来
Dialogue: 0,0:01:55.14,0:02:00.90,Layzner,Anna,0,0,0,,然后 对那个人来说却是个令人悲伤的结果
Dialogue: 0,0:02:00.90,0:02:03.58,Layzner,Gail,0,0,0,,干得漂亮 英二
Dialogue: 0,0:02:03.95,0:02:04.77,Layzner,Eiji,0,0,0,,凯利前辈
Dialogue: 0,0:02:06.85,0:02:10.31,Layzner,Eiji,0,0,0,,凯利前辈
Dialogue: 0,0:02:14.26,0:02:19.26,Layzner,Eiji,0,0,0,,第十六话 月球！请回答
Dialogue: 0,0:02:26.20,0:02:28.39,Layzner,Roanne,0,0,0,,好怪哦
Dialogue: 0,0:02:28.39,0:02:30.85,Layzner,Elizabeth,0,0,0,,美军基地那没有回应吗
Dialogue: 0,0:02:30.85,0:02:36.87,Layzner,Roanne,0,0,0,,用宇宙救助法所规定的紧急频道呼叫了
Dialogue: 0,0:02:30.85,0:02:36.87,Layzner,Roanne,0,0,0,,对 虽然我已照你的方法
Dialogue: 0,0:02:36.87,0:02:39.43,Layzner,Elizabeth,0,0,0,,继续 不能灰心
Dialogue: 0,0:02:39.43,0:02:44.41,Layzner,Elizabeth,0,0,0,,这样下去的话 我们要降落的话会先被某一边击落的
Dialogue: 0,0:02:44.41,0:02:48.67,Layzner,Roanne,0,0,0,,我知道 这航天飞机要是地球的东西就没问题对吧
Dialogue: 0,0:02:49.81,0:02:52.60,Layzner,Elizabeth,0,0,0,,亚瑟 再休息一下就跟罗安换班
Dialogue: 0,0:02:52.60,0:02:54.00,Layzner,Arthur,0,0,0,,是
Dialogue: 0,0:02:54.00,0:02:55.73,Layzner,David,0,0,0,,他一直把自己封闭起来
Dialogue: 0,0:02:59.17,0:03:02.63,Layzner,Simone,0,0,0,,由当时情况来判断 那个人的确是死了
Dialogue: 0,0:03:02.63,0:03:05.00,Layzner,Arthur,0,0,0,,对他的打击一定很大
Dialogue: 0,0:03:05.00,0:03:07.37,Layzner,David,0,0,0,,吃完这个 我就去看看他
Dialogue: 0,0:03:08.76,0:03:12.02,Layzner,Anna,0,0,0,,就算英二不想
Dialogue: 0,0:03:12.02,0:03:16.11,Layzner,Anna,0,0,0,,但他的确是杀了他的前辈
Dialogue: 0,0:03:17.34,0:03:22.44,Layzner,Anna,0,0,0,,英二也因此一起把自己封闭在雷兹纳里
Dialogue: 0,0:03:22.98,0:03:25.08,Layzner,Anna,0,0,0,,我该怎么办
Dialogue: 0,0:03:25.08,0:03:28.96,Layzner,Anna,0,0,0,,要怎么安慰他
Dialogue: 0,0:03:28.96,0:03:30.58,Layzner,Anna,0,0,0,,我
Dialogue: 0,0:03:34.85,0:03:39.07,Layzner,Eiji,0,0,0,,前辈 那时你真的躲不开吗
Dialogue: 0,0:03:39.07,0:03:42.05,Layzner,Eiji,0,0,0,,还是
Dialogue: 0,0:03:42.05,0:03:44.26,Layzner,Eiji,0,0,0,,这真的是宿命吗
Dialogue: 0,0:03:46.12,0:03:48.47,Layzner,Eiji,0,0,0,,我真的不想对你开枪  可是为什么
Dialogue: 0,0:03:52.89,0:03:55.58,Layzner,Eiji,0,0,0,,啊 和古斯特罗打的时候也是这样
Dialogue: 0,0:03:55.58,0:03:56.45,Layzner,Eiji,0,0,0,,让我看一下战斗记录
Dialogue: 0,0:03:56.45,0:03:58.15,Layzner,Rey,0,0,0,,Ready
Dialogue: 0,0:04:06.87,0:04:10.55,Layzner,Eiji,0,0,0,,这波动是我被击中前产生的 并没有什么意义
Dialogue: 0,0:04:20.73,0:04:23.35,Layzner,Eiji,0,0,0,,快要到了
Dialogue: 0,0:04:23.35,0:04:24.26,Layzner,Eiji,0,0,0,,就是这里
Dialogue: 0,0:04:31.77,0:04:33.18,Layzner,Eiji,0,0,0,,怎么了
Dialogue: 0,0:04:41.71,0:04:45.83,Layzner,Eiji,0,0,0,,为什么 为什么只有这时候影像没有了
Dialogue: 0,0:04:45.83,0:04:48.53,Layzner,Eiji,0,0,0,,为什么只有这时有异常的能源显示
Dialogue: 0,0:04:52.50,0:04:54.11,Layzner,Eiji,0,0,0,,雷 回答我
Dialogue: 0,0:04:54.11,0:04:58.52,Layzner,Eiji,0,0,0,,为什么最后射主炮时有异常的能源显示 为什么
Dialogue: 0,0:04:58.52,0:04:59.98,Layzner,Rey,0,0,0,,无法解释
Dialogue: 0,0:04:59.98,0:05:01.05,Layzner,Eiji,0,0,0,,骗人
Dialogue: 0,0:05:01.05,0:05:02.62,Layzner,Rey,0,0,0,,能源正常
Dialogue: 0,0:05:02.62,0:05:04.88,Layzner,Rey,0,0,0,,能源残量如显示
Dialogue: 0,0:05:04.88,0:05:06.05,Layzner,Eiji,0,0,0,,给我老实说
Dialogue: 0,0:05:06.05,0:05:08.69,Layzner,Rey,0,0,0,,能源正常 不能理解你问题的意思
Dialogue: 0,0:05:08.69,0:05:11.38,Layzner,Eiji,0,0,0,,拜托 给我老实说
Dialogue: 0,0:05:11.38,0:05:13.33,Layzner,Rey,0,0,0,,不明白你问题的意思
Dialogue: 0,0:05:13.33,0:05:14.14,Layzner,Eiji,0,0,0,,可恶
Dialogue: 0,0:05:17.61,0:05:19.43,Layzner,Eiji,0,0,0,,一定有什么
Dialogue: 0,0:05:19.44,0:05:22.97,Layzner,Eiji,0,0,0,,雷兹纳里一定有什么我不知道的秘密
Dialogue: 0,0:05:22.97,0:05:25.93,Layzner,David,0,0,0,,英二 要不要出来喝个汤
Dialogue: 0,0:05:25.93,0:05:26.59,Layzner,Eiji,0,0,0,,大卫
Dialogue: 0,0:05:26.59,0:05:30.03,Layzner,David,0,0,0,,我知道你现在想一个人呆着
Dialogue: 0,0:05:30.03,0:05:33.08,Layzner,David,0,0,0,,可是跟大家一起比较能平静下来
Dialogue: 0,0:05:33.08,0:05:35.87,Layzner,Eiji,0,0,0,,谢谢 等我平静下再出去
Dialogue: 0,0:05:35.87,0:05:39.12,Layzner,David,0,0,0,,那就好 我只是有点担心你 那等会见
Dialogue: 0,0:05:43.96,0:05:46.45,Layzner,Eiji,0,0,0,,让我看打倒古斯特罗时的战斗记录
Dialogue: 0,0:05:46.45,0:05:46.95,Layzner,Rey,0,0,0,,Ready
Dialogue: 0,0:05:49.95,0:05:53.52,Layzner,Zool,0,0,0,,是吗 凯利也死了
Dialogue: 0,0:05:53.52,0:05:57.23,Layzner,Egyle,0,0,0,,我一定会帮他报仇 请让我替他报仇
Dialogue: 0,0:05:57.23,0:05:59.62,Layzner,Egyle,0,0,0,,请允许我
Dialogue: 0,0:05:58.86,0:05:59.62,Layzner,Zool,0,0,0,,不行
Dialogue: 0,0:05:59.62,0:06:01.28,Layzner,Egyle,0,0,0,,祖鲁副官
Dialogue: 0,0:06:01.28,0:06:05.70,Layzner,Zool,0,0,0,,改变航道 回来这里与我们汇合 马上
Dialogue: 0,0:06:05.70,0:06:07.05,Layzner,Egyle,0,0,0,,你说要改变航道
Dialogue: 0,0:06:07.05,0:06:11.26,Layzner,Zool,0,0,0,,我们已派别动队实行新计划
Dialogue: 0,0:06:11.26,0:06:16.07,Layzner,Zool,0,0,0,,现在一切顺利 你这一去会打乱计划
Dialogue: 0,0:06:16.07,0:06:18.60,Layzner,Zool,0,0,0,,绝对不准你去月球
Dialogue: 0,0:06:18.60,0:06:22.28,Layzner,Egyle,0,0,0,,那么至少让我找回凯利中尉的尸体
Dialogue: 0,0:06:22.28,0:06:25.15,Layzner,Zool,0,0,0,,那只是浪费时间 知道了吗
Dialogue: 0,0:06:26.17,0:06:30.53,Layzner,Egyle,0,0,0,,拜托您 请叫古雷斯库陛下至少让我做完这件事
Dialogue: 0,0:06:30.53,0:06:34.58,Layzner,Zool,0,0,0,,在宇宙死的人 就让宇宙做他的墓场
Dialogue: 0,0:06:37.27,0:06:39.00,Layzner,Egyle,0,0,0,,可 可是
Dialogue: 0,0:06:39.00,0:06:41.46,Layzner,Zool,0,0,0,,就这样 快点行动
Dialogue: 0,0:06:41.46,0:06:43.27,Layzner,Egyle,0,0,0,,请等一下 副官
Dialogue: 0,0:06:53.74,0:06:57.93,Layzner,Officer,0,0,0,,要修正航道了 请待命
Dialogue: 0,0:06:57.93,0:07:01.08,Layzner,Officer,0,0,0,,要修正航道了 请待命
Dialogue: 0,0:07:05.50,0:07:08.81,Layzner,Arthur,0,0,0,,不行 苏联军也没有回应
Dialogue: 0,0:07:08.81,0:07:10.63,Layzner,Com,0,0,0,,还有五分钟着陆
Dialogue: 0,0:07:13.30,0:07:17.48,Layzner,Elizabeth,0,0,0,,这样也没办法了 只好由我们单方联络了
Dialogue: 0,0:07:17.91,0:07:18.56,Layzner,Elizabeth,0,0,0,,把路线打开
Dialogue: 0,0:07:18.56,0:07:19.62,Layzner,Arthur,0,0,0,,好
Dialogue: 0,0:07:19.62,0:07:23.36,Layzner,Elizabeth,0,0,0,,通知月球基地和苏联军基地
Dialogue: 0,0:07:23.36,0:07:26.79,Layzner,Elizabeth,0,0,0,,我是隶属联合国宇宙局的伊丽莎白·克蕾布里
Dialogue: 0,0:07:26.79,0:07:30.47,Layzner,Elizabeth,0,0,0,,我们将要降落在联合国的月球基地
Dialogue: 0,0:07:30.47,0:07:33.43,Layzner,Elizabeth,0,0,0,,虽然是坐没有看过的舰艇来的 但这是紧急事件
Dialogue: 0,0:07:33.43,0:07:36.95,Layzner,Elizabeth,0,0,0,,上面有地球人 请不要攻击我们
Dialogue: 0,0:07:36.95,0:07:40.93,Layzner,Elizabeth,0,0,0,,请不要攻击我们
Dialogue: 0,0:07:40.93,0:07:43.65,Layzner,Arthur,0,0,0,,有传到吗
Dialogue: 0,0:07:46.08,0:07:49.43,Layzner,Com,0,0,0,,还有四分钟着陆
Dialogue: 0,0:07:50.54,0:07:54.79,Layzner,Anna,0,0,0,,每一个人都沉浸在一片不安的氛围中
Dialogue: 0,0:07:54.79,0:07:59.77,Layzner,Anna,0,0,0,,一种想告诉大家的事情却无法说出口的心情中
Dialogue: 0,0:07:59.77,0:08:04.29,Layzner,Anna,0,0,0,,让人感到十分的讨厌 我们
Dialogue: 0,0:08:04.29,0:08:05.72,Layzner,Arthur,0,0,0,,没问题吧
Dialogue: 0,0:08:05.72,0:08:08.27,Layzner,Elizabeth,0,0,0,,已经无法更改航道了
Dialogue: 0,0:08:08.27,0:08:11.31,Layzner,Elizabeth,0,0,0,,这下只有强行降落在联合国月球基地了
Dialogue: 0,0:08:11.31,0:08:14.61,Layzner,Roanne,0,0,0,,为什么联合国基地不回答我们
Dialogue: 0,0:08:14.61,0:08:17.30,Layzner,Elizabeth,0,0,0,,现在多想也没用了
Dialogue: 0,0:08:17.30,0:08:20.95,Layzner,Elizabeth,0,0,0,,我们只好相信他们有收到我们的通信了
Dialogue: 0,0:08:20.95,0:08:23.52,Layzner,Arthur,0,0,0,,如果他们没收到的话
Dialogue: 0,0:08:24.58,0:08:26.66,Layzner,Simone,0,0,0,,往好的方面想嘛
Dialogue: 0,0:08:26.66,0:08:31.18,Layzner,Simone,0,0,0,,是有三万地球人住的月球 对吧
Dialogue: 0,0:08:26.66,0:08:31.18,Layzner,Simone,0,0,0,,这里不是火星是月球耶
Dialogue: 0,0:08:31.18,0:08:36.82,Layzner,Elizabeth,0,0,0,,如西蒙尼所说 我们要相信他们一定有收到
Dialogue: 0,0:08:36.82,0:08:40.07,Layzner,Roanne,0,0,0,,对啊 与其怀疑不如相信比较好
Dialogue: 0,0:08:40.07,0:08:42.85,Layzner,Simone,0,0,0,,没错 降落的话
Dialogue: 0,0:08:42.85,0:08:45.52,Layzner,Simone,0,0,0,,好想马上就去吃好吃的
Dialogue: 0,0:08:45.52,0:08:50.60,Layzner,Elizabeth,0,0,0,,那我们去那里好吗 就是训练场附近的牛排屋
Dialogue: 0,0:08:50.60,0:08:53.25,Layzner,Arthur,0,0,0,,那之前先让我洗个热水澡
Dialogue: 0,0:08:53.25,0:08:55.09,Layzner,Roanne,0,0,0,,你还真爱干净
Dialogue: 0,0:08:55.09,0:08:58.07,Layzner,Arthur,0,0,0,,对啊 大概没人比我更爱干净
Dialogue: 0,0:08:58.07,0:09:00.47,Layzner,Arthur,0,0,0,,不过你还真忍得住
Dialogue: 0,0:09:00.47,0:09:02.77,Layzner,Arthur,0,0,0,,我们好几天没洗澡了
Dialogue: 0,0:09:02.77,0:09:07.98,Layzner,Arthur,0,0,0,,我的内裤就一直湿湿的
Dialogue: 0,0:09:07.98,0:09:10.71,Layzner,Simone,0,0,0,,亚瑟 在你面前的是淑女哦
Dialogue: 0,0:09:13.92,0:09:16.70,Layzner,Roanne,0,0,0,,真不知道他家的打人是怎么教他的
Dialogue: 0,0:09:22.54,0:09:24.25,Layzner,Eiji,0,0,0,,果然那时候也是
Dialogue: 0,0:09:32.00,0:09:35.22,Layzner,Eiji,0,0,0,,果然好怪 怎么想都好奇怪
Dialogue: 0,0:09:35.22,0:09:39.87,Layzner,Eiji,0,0,0,,就算雷说的是真的 可是这雷兹纳一定有什么秘密
Dialogue: 0,0:09:40.79,0:09:43.42,Layzner,Arthur,0,0,0,,英二 大卫 准备降落了
Dialogue: 0,0:09:43.42,0:09:44.54,Layzner,Eiji,0,0,0,,我知道了
Dialogue: 0,0:09:44.54,0:09:46.53,Layzner,David,0,0,0,,我在贝布鲁上
Dialogue: 0,0:09:46.53,0:09:47.54,Layzner,Arthur,0,0,0,,了解
Dialogue: 0,0:09:48.09,0:09:49.10,Layzner,Roanne,0,0,0,,我跟你换
Dialogue: 0,0:09:49.10,0:09:49.83,Layzner,Elizabeth,0,0,0,,拜托你了
Dialogue: 0,0:09:51.18,0:09:52.08,Layzner,Roanne,0,0,0,,快到了对吧
Dialogue: 0,0:09:53.25,0:09:55.09,Layzner,Com,0,0,0,,两分钟后降落
Dialogue: 0,0:10:01.95,0:10:02.70,Layzner,Elizabeth,0,0,0,,坐那里吧
Dialogue: 0,0:10:02.70,0:10:04.49,Layzner,Eiji,0,0,0,,不 我去跟亚瑟换
Dialogue: 0,0:10:05.88,0:10:10.19,Layzner,Elizabeth,0,0,0,,英二 人生难免有难以预料的事
Dialogue: 0,0:10:10.19,0:10:12.40,Layzner,Elizabeth,0,0,0,,有时结果说不定还很残酷
Dialogue: 0,0:10:14.44,0:10:15.36,Layzner,Eiji,0,0,0,,我来跟你换
Dialogue: 0,0:10:15.36,0:10:17.93,Layzner,Arthur,0,0,0,,是啊 由你来我就更安心了 那拜托你了
Dialogue: 0,0:10:17.93,0:10:21.08,Layzner,,0,0,0,,大卫在贝布鲁上
Dialogue: 0,0:10:21.08,0:10:22.99,Layzner,Roanne,0,0,0,,看到你这样子我就安心了
Dialogue: 0,0:10:22.99,0:10:23.76,Layzner,Eiji,0,0,0,,唉
Dialogue: 0,0:10:23.76,0:10:26.00,Layzner,Roanne,0,0,0,,没什么
Dialogue: 0,0:10:26.00,0:10:29.71,Layzner,,0,0,0,,只是有你坐在旁边我才安心
Dialogue: 0,0:10:29.73,0:10:32.02,Layzner,Eiji,0,0,0,,谢谢你 罗安
Dialogue: 0,0:10:32.02,0:10:35.13,Layzner,Com,0,0,0,,准备着陆 请确认主灯
Dialogue: 0,0:10:35.13,0:10:35.97,Layzner,Eiji,0,0,0,,确认
Dialogue: 0,0:10:35.97,0:10:38.52,Layzner,Roanne,0,0,0,,切换主控制系统 请确认
Dialogue: 0,0:10:38.52,0:10:39.34,Layzner,Eiji,0,0,0,,了解
Dialogue: 0,0:10:40.63,0:10:42.65,Layzner,Com,0,0,0,,启动窗外视窗模式
Dialogue: 0,0:10:42.65,0:10:44.72,Layzner,Eiji,0,0,0,,确认 没有异状
Dialogue: 0,0:10:44.72,0:10:50.96,Layzner,Com,0,0,0,,离着陆时间还有34秒... 33... 32... 31..
Dialogue: 0,0:10:50.96,0:10:56.02,Layzner,Com,0,0,0,,... 30... 29... 28... 27... 26...
Dialogue: 0,0:10:56.02,0:11:01.00,Layzner,Com,0,0,0,,... 25... 24... 23... 22... 21...
Dialogue: 0,0:11:01.00,0:11:06.04,Layzner,Com,0,0,0,,... 20... 19... 18... 17... 16...
Dialogue: 0,0:11:06.04,0:11:10.87,Layzner,Com,0,0,0,,... 15... 14... 13... 12... 11...
Dialogue: 0,0:11:10.87,0:11:15.75,Layzner,Com,0,0,0,,... 10... 09... 08... 07... 06...
Dialogue: 0,0:11:15.75,0:11:21.55,Layzner,Com,0,0,0,,... 05... 04... 03... 02... 01...
Dialogue: 0,0:11:24.61,0:11:27.60,Layzner,,0,0,0,,联合国宇宙局 月球基地
Dialogue: 0,0:11:31.16,0:11:32.87,Layzner,Roanne,0,0,0,,怎么有这种事
Dialogue: 0,0:11:32.87,0:11:35.65,Layzner,Roanne,0,0,0,,伊丽莎白博士 请来一下
Dialogue: 0,0:11:37.59,0:11:41.08,Layzner,,0,0,0,,这里 也被古拉特斯军摧毁了
Dialogue: 0,0:11:41.08,0:11:45.76,Layzner,Roanne,0,0,0,,这里是月球啊 这里有军队 和火星不一样的
Dialogue: 0,0:11:47.47,0:11:49.93,Layzner,Arthur,0,0,0,,大卫 你看
Dialogue: 0,0:11:49.93,0:11:51.00,Layzner,David,0,0,0,,可恶
Dialogue: 0,0:11:51.48,0:11:54.17,Layzner,Roanne,0,0,0,,说不定苏联军和美军也被
Dialogue: 0,0:11:54.17,0:11:58.46,Layzner,Arthur,0,0,0,,那我们就这样去地球吧 那样比较好
Dialogue: 0,0:11:59.32,0:12:04.02,Layzner,Elizabeth,0,0,0,,跟我们一样还存活的地球人搞不好躲在哪里避难呢
Dialogue: 0,0:12:04.70,0:12:06.18,Layzner,Arthur,0,0,0,,你的意思是要下去是吗
Dialogue: 0,0:12:06.18,0:12:09.81,Layzner,Elizabeth,0,0,0,,在这里我们无法知道外面的状态
Dialogue: 0,0:12:09.81,0:12:12.41,Layzner,David,0,0,0,,我用贝布鲁去看看外面的情况
Dialogue: 0,0:12:12.41,0:12:13.56,Layzner,Eiji,0,0,0,,我也去
Dialogue: 0,0:12:13.56,0:12:14.94,Layzner,Roanne,0,0,0,,我也一起去
Dialogue: 0,0:12:14.94,0:12:18.85,Layzner,Eiji,0,0,0,,你留下来 要留一架SPT才行
Dialogue: 0,0:12:18.85,0:12:21.66,Layzner,David,0,0,0,,伊丽莎白博士 我跟英二去看看
Dialogue: 0,0:12:21.66,0:12:22.42,Layzner,Elizabeth,0,0,0,,没问题吗
Dialogue: 0,0:12:22.42,0:12:25.39,Layzner,David,0,0,0,,怎么说我可在这生活过半年呢 交给我吧
Dialogue: 0,0:12:25.39,0:12:30.85,Layzner,Elizabeth,0,0,0,,说的也是 那拜托你了 我们留在这用航天飞机做后援
Dialogue: 0,0:12:31.39,0:12:32.94,Layzner,David,0,0,0,,知道了 走吧 英二
Dialogue: 0,0:12:32.94,0:12:33.79,Layzner,Eiji,0,0,0,,好
Dialogue: 0,0:12:50.79,0:12:56.04,Layzner,David,0,0,0,,这里有70%的设施都在地下 住人的地方也是在那里
Dialogue: 0,0:12:56.04,0:12:57.04,Layzner,Eiji,0,0,0,,交给你了
Dialogue: 0,0:12:57.04,0:12:58.30,Layzner,Eiji,0,0,0,,跟我来
Dialogue: 0,0:14:11.03,0:14:13.43,Layzner,David,0,0,0,,这是怎么回事
Dialogue: 0,0:14:13.43,0:14:15.00,Layzner,Eiji,0,0,0,,跟火星的样子又完全不一样
Dialogue: 0,0:14:15.00,0:14:18.44,Layzner,David,0,0,0,,先别说这个 大家都去哪了
Dialogue: 0,0:14:18.44,0:14:21.23,Layzner,David,0,0,0,,前面有以前我们住的宿舍
Dialogue: 0,0:14:37.12,0:14:38.87,Layzner,David,0,0,0,,就在这前面的
Dialogue: 0,0:14:38.87,0:14:41.64,Layzner,Eiji,0,0,0,,那你说的宿舍就
Dialogue: 0,0:14:41.64,0:14:43.17,Layzner,David,0,0,0,,可恶
Dialogue: 0,0:14:47.41,0:14:52.68,Layzner,Arthur,0,0,0,,为什么我们看到的景色都是这种样子呢
Dialogue: 0,0:14:53.53,0:14:55.06,Layzner,,0,0,0,,等一下嘛
Dialogue: 0,0:14:57.56,0:15:00.35,Layzner,Roanne,0,0,0,,想洗澡都只是个梦而已
Dialogue: 0,0:15:00.35,0:15:03.11,Layzner,Arthur,0,0,0,,你还想着这种无聊的事情啊 笨蛋
Dialogue: 0,0:15:03.11,0:15:06.57,Layzner,Elizabeth,0,0,0,,进去吧 要等大卫的联络
Dialogue: 0,0:15:08.98,0:15:12.28,Layzner,Anna,0,0,0,,我们以前住的宿舍也变成这样了
Dialogue: 0,0:15:12.53,0:15:14.94,Layzner,Simone,0,0,0,,真令人感到绝望
Dialogue: 0,0:15:14.94,0:15:16.75,Layzner,Arthur,0,0,0,,可恶
Dialogue: 0,0:15:50.61,0:15:55.61,Layzner,Rey,0,0,0,,资料信息 攻击武器识别 巴尔干炮一门
Dialogue: 0,0:15:55.61,0:15:57.54,Layzner,,0,0,0,,还有自动型火箭炮
Dialogue: 0,0:15:59.47,0:16:00.59,Layzner,David,0,0,0,,这些家伙
Dialogue: 0,0:16:00.59,0:16:04.86,Layzner,Eiji,0,0,0,,住手 大卫 这不是古拉特斯军 可能是地球人
Dialogue: 0,0:16:07.41,0:16:08.29,Layzner,David,0,0,0,,地球人
Dialogue: 0,0:16:08.29,0:16:09.25,Layzner,Eiji,0,0,0,,没错
Dialogue: 0,0:16:13.80,0:16:17.06,Layzner,Clayton,0,0,0,,听好了 我们不攻击的话就要被敌人干掉了
Dialogue: 0,0:16:17.06,0:16:19.81,Layzner,Clayton,0,0,0,,他们来了 不要慌
Dialogue: 0,0:16:23.19,0:16:25.44,Layzner,David,0,0,0,,不要开枪 我们不会攻击你们的
Dialogue: 0,0:16:25.44,0:16:26.11,Layzner,Clayton,0,0,0,,开枪
Dialogue: 0,0:16:30.25,0:16:32.49,Layzner,David,0,0,0,,我是地球人 停止攻击
Dialogue: 0,0:16:32.49,0:16:33.90,Layzner,Clayton,0,0,0,,我们不会上当
Dialogue: 0,0:16:48.07,0:16:51.05,Layzner,Clayton,0,0,0,,怎么了 快回自己的岗位
Dialogue: 0,0:16:51.05,0:16:51.85,Layzner,,0,0,0,,快回来
Dialogue: 0,0:16:55.99,0:16:59.01,Layzner,,0,0,0,,你们在干嘛 快回来
Dialogue: 0,0:17:17.24,0:17:19.41,Layzner,David,0,0,0,,不要开枪 我要下去了
Dialogue: 0,0:17:22.37,0:17:24.54,Layzner,Arthur,0,0,0,,大卫他们好慢啊
Dialogue: 0,0:17:26.02,0:17:27.68,Layzner,David,0,0,0,,是我 大卫
Dialogue: 0,0:17:27.68,0:17:29.84,Layzner,Roanne,0,0,0,,你们在哪
Dialogue: 0,0:17:29.84,0:17:32.91,Layzner,David,0,0,0,,我离开主播广场 现在在往北边的广场的路上
Dialogue: 0,0:17:32.91,0:17:33.68,Layzner,Elizabeth,0,0,0,,然后呢
Dialogue: 0,0:17:34.47,0:17:39.60,Layzner,David,0,0,0,,剩下还有几人 但能确认的只有一个人
Dialogue: 0,0:17:34.47,0:17:39.60,Layzner,David,0,0,0,,找到一名美军的飞行员
Dialogue: 0,0:17:39.60,0:17:40.54,Layzner,Elizabeth,0,0,0,,为什么
Dialogue: 0,0:17:40.54,0:17:42.45,Layzner,David,0,0,0,,他们都不问清楚就攻击我
Dialogue: 0,0:17:42.45,0:17:44.32,Layzner,Elizabeth,0,0,0,,没搞错是美军的士兵对吧
Dialogue: 0,0:17:44.32,0:17:49.07,Layzner,David,0,0,0,,我虽然接近他但却无法和他沟通
Dialogue: 0,0:17:44.32,0:17:49.07,Layzner,David,0,0,0,,看来他好像受伤了
Dialogue: 0,0:17:49.07,0:17:52.11,Layzner,David,0,0,0,,我想确认这基地的通信频道
Dialogue: 0,0:17:52.11,0:17:56.04,Layzner,Elizabeth,0,0,0,,调到 F208,  426.7 赫兹就可以了
Dialogue: 0,0:17:56.04,0:17:59.91,Layzner,Elizabeth,0,0,0,,我也去 从这走去还不到一公里
Dialogue: 0,0:17:59.91,0:18:02.20,Layzner,Elizabeth,0,0,0,,听好了 别看丢了
Dialogue: 0,0:18:02.20,0:18:03.12,Layzner,David,0,0,0,,我知道了
Dialogue: 0,0:18:04.26,0:18:05.58,Layzner,Simone,0,0,0,,我也去
Dialogue: 0,0:18:06.46,0:18:09.24,Layzner,Elizabeth,0,0,0,,现在还不知道情形 听好了
Dialogue: 0,0:18:09.24,0:18:11.55,Layzner,Elizabeth,0,0,0,,知道详细情形就会叫大家 就这样
Dialogue: 0,0:18:11.55,0:18:12.69,Layzner,Arthur,0,0,0,,我们会在这等你的联络
Dialogue: 0,0:18:14.02,0:18:15.22,Layzner,Elizabeth,0,0,0,,你们也是
Dialogue: 0,0:18:30.52,0:18:33.23,Layzner,Clayton,0,0,0,,为什么擅自离开岗位 你们想死吗
Dialogue: 0,0:18:41.91,0:18:44.45,Layzner,Clayton,0,0,0,,快把枪捡起来 继续战斗
Dialogue: 0,0:18:46.43,0:18:47.15,Layzner,Joy,0,0,0,,不要啦
Dialogue: 0,0:18:47.15,0:18:48.92,Layzner,Clayton,0,0,0,,把枪给我
Dialogue: 0,0:18:52.79,0:18:55.47,Layzner,Clayton,0,0,0,,帮我看一下
Dialogue: 0,0:18:55.47,0:18:59.34,Layzner,David,0,0,0,,不要开枪 我已确认你的美军身份了
Dialogue: 0,0:18:59.34,0:19:01.07,Layzner,,0,0,0,,我也是美国人
Dialogue: 0,0:19:01.07,0:19:05.33,Layzner,David,0,0,0,,我叫大卫·鲁瑟福特 现在坐在这东西上是有原因的
Dialogue: 0,0:19:05.33,0:19:07.79,Layzner,David,0,0,0,,我现在要下来了 不要开枪
Dialogue: 0,0:19:08.95,0:19:10.34,Layzner,Joy,0,0,0,,他下来了
Dialogue: 0,0:19:10.34,0:19:11.24,Layzner,Clayton,0,0,0,,只有一个人吗
Dialogue: 0,0:19:11.24,0:19:12.70,Layzner,Joy,0,0,0,,嗯
Dialogue: 0,0:19:12.70,0:19:14.76,Layzner,Joy,0,0,0,,他把手举起来了
Dialogue: 0,0:19:14.76,0:19:16.01,Layzner,Clayton,0,0,0,,他手上有武器吗
Dialogue: 0,0:19:16.01,0:19:18.13,Layzner,Joy,0,0,0,,没
Dialogue: 0,0:19:18.88,0:19:20.07,Layzner,Clayton,0,0,0,,你从哪来的
Dialogue: 0,0:19:20.07,0:19:23.34,Layzner,David,0,0,0,,从火星 我是从火星逃出来的
Dialogue: 0,0:19:23.34,0:19:25.76,Layzner,Clayton,0,0,0,,从火星 真的吗
Dialogue: 0,0:19:26.58,0:19:29.08,Layzner,David,0,0,0,,我们是体验学校的学生
Dialogue: 0,0:19:41.27,0:19:42.76,Layzner,,0,0,0,,都是小孩子
Dialogue: 0,0:19:42.76,0:19:45.00,Layzner,Clayton,0,0,0,,坐在另一架机器人上的也是学生吗
Dialogue: 0,0:19:45.00,0:19:45.87,Layzner,David,0,0,0,,不是
Dialogue: 0,0:19:45.87,0:19:46.65,Layzner,Clayton,0,0,0,,不是
Dialogue: 0,0:19:46.65,0:19:49.31,Layzner,David,0,0,0,,不过他也是同伴 请把枪收起来
Dialogue: 0,0:19:49.31,0:19:51.60,Layzner,,0,0,0,,然后我再告诉你详情
Dialogue: 0,0:19:59.94,0:20:03.73,Layzner,Clayton,0,0,0,,听你说了这么多
Dialogue: 0,0:20:03.73,0:20:06.46,Layzner,Clayton,0,0,0,,可对外星人的感觉还是
Dialogue: 0,0:20:06.46,0:20:10.04,Layzner,David,0,0,0,,但想不到月球也变这样了 那其他人呢
Dialogue: 0,0:20:10.04,0:20:13.03,Layzner,Clayton,0,0,0,,我是因为解体而变这样的
Dialogue: 0,0:20:13.03,0:20:15.91,Layzner,Clayton,0,0,0,,其他的部队到哪里了我也不知道
Dialogue: 0,0:20:15.91,0:20:17.35,Layzner,David,0,0,0,,那这些小孩子呢
Dialogue: 0,0:20:17.35,0:20:20.40,Layzner,Clayton,0,0,0,,好像是从学校里出来避难的
Dialogue: 0,0:20:20.40,0:20:23.01,Layzner,Clayton,0,0,0,,连名字都不知道
Dialogue: 0,0:20:23.01,0:20:28.53,Layzner,Clayton,0,0,0,,你们的事只花两三分钟解释就要我相信很难
Dialogue: 0,0:20:28.53,0:20:32.48,Layzner,Eiji,0,0,0,,我知道 可是他说的是真的
Dialogue: 0,0:20:32.48,0:20:36.39,Layzner,?,0,0,0,,骗人 就算是混血 但外星人一定不可能长这样
Dialogue: 0,0:20:36.39,0:20:39.81,Layzner,?,0,0,0,,我也这么觉得 长的和我们一样嘛
Dialogue: 0,0:20:39.81,0:20:42.36,Layzner,?,0,0,0,,跟电影里的外星人不一样
Dialogue: 0,0:20:46.25,0:20:47.17,Layzner,Elizabeth,0,0,0,,你是
Dialogue: 0,0:20:47.17,0:20:48.12,Layzner,Clayton,0,0,0,,是谁
Dialogue: 0,0:20:49.21,0:20:50.79,Layzner,David,0,0,0,,她是
Dialogue: 0,0:20:51.28,0:20:53.81,Layzner,Elizabeth,0,0,0,,古雷特 是你吗
Dialogue: 0,0:20:55.52,0:20:56.38,Layzner,Clayton,0,0,0,,是
Dialogue: 0,0:20:58.60,0:21:01.73,Layzner,Clayton,0,0,0,,真的是你 但你怎么会在这
Dialogue: 0,0:21:01.73,0:21:03.64,Layzner,Elizabeth,0,0,0,,这真是一言难尽
Dialogue: 0,0:21:03.64,0:21:06.35,Layzner,Clayton,0,0,0,,那之后我打了好多次电话给你了
Dialogue: 0,0:21:06.94,0:21:08.70,Layzner,Elizabeth,0,0,0,,那事先别说了
Dialogue: 0,0:21:08.70,0:21:10.46,Layzner,Clayton,0,0,0,,你好自私
Dialogue: 0,0:21:10.46,0:21:12.76,Layzner,Elizabeth,0,0,0,,还比不上你 古雷特
Dialogue: 0,0:21:42.30,0:21:43.83,Layzner,Kids,0,0,0,,来了 他们来了
Dialogue: 0,0:21:44.75,0:21:46.16,Layzner,David,0,0,0,,怎么了
Dialogue: 0,0:21:47.13,0:21:48.81,Layzner,Clayton,0,0,0,,安静 大家安静一点
Dialogue: 0,0:21:48.81,0:21:50.07,Layzner,Eiji,0,0,0,,好像有什么响声
Dialogue: 0,0:21:50.07,0:21:51.04,Layzner,David,0,0,0,,什么
Dialogue: 0,0:21:51.62,0:21:52.78,Layzner,Elizabeth,0,0,0,,那是什么
Dialogue: 0,0:21:52.78,0:21:54.52,Layzner,Clayton,0,0,0,,你也拿把枪吧
Dialogue: 0,0:21:54.52,0:21:56.38,Layzner,Elizabeth,0,0,0,,你说话的口气还是没变
Dialogue: 0,0:21:56.38,0:21:59.76,Layzner,Clayton,0,0,0,,那是为了要活着离开这里啊  你在干什么
Dialogue: 0,0:21:59.76,0:22:02.30,Layzner,Elizabeth,0,0,0,,古雷特 你连小孩子都
Dialogue: 0,0:22:02.30,0:22:06.13,Layzner,Clayton,0,0,0,,小孩子又怎样 小孩子他们也很了解
Dialogue: 0,0:22:08.89,0:22:10.19,Layzner,Elizabeth,0,0,0,,请你说明
Dialogue: 0,0:22:10.19,0:22:11.41,Layzner,Elizabeth,0,0,0,,先对付眼前敌人
Dialogue: 0,0:22:21.38,0:22:25.17,Layzner,Com,0,0,0,,警告 未确认物接近
Dialogue: 0,0:22:25.17,0:22:28.73,Layzner,Com,0,0,0,,资料不足 无法确认
Dialogue: 0,0:22:28.73,0:22:30.76,Layzner,Com,0,0,0,,请重新部署
Dialogue: 0,0:22:32.16,0:22:34.12,Layzner,Arthur,0,0,0,,一定是敌人来了
Dialogue: 0,0:22:36.91,0:22:38.90,Layzner,Anna,0,0,0,,真令人无法相信
Dialogue: 0,0:22:39.55,0:22:43.40,Layzner,Anna,0,0,0,,还差一点就到地球的月球上
Dialogue: 0,0:22:44.34,0:22:50.08,Layzner,Anna,0,0,0,,我们看到了比在火星上更可怕的恶魔
Dialogue: 0,0:23:55.13,0:23:57.02,Layzner,,0,0,0,,不 那时候的事
Dialogue: 0,0:23:58.02,0:24:00.39,Layzner,,0,0,0,,这时候不要说以前的事
Dialogue: 0,0:24:01.47,0:24:02.52,Layzner,,0,0,0,,不 你说得对
Dialogue: 0,0:24:03.97,0:24:07.09,Layzner,,0,0,0,,下一集 成群的杀人机器

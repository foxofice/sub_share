Dialogue: 0,0:00:26.04,0:00:29.58,Default,,0,0,0,,创立庆典终于要开始了
Dialogue: 0,0:00:36.34,0:00:38.99,OPJP,,0,0,0,,Let's walk! Let's walk!
Dialogue: 0,0:00:39.55,0:00:40.94,OPJP,,0,0,0,,Let's walk the road
Dialogue: 0,0:00:40.94,0:00:42.54,OPJP,,0,0,0,,立ち止まらず
Dialogue: 0,0:00:42.71,0:00:45.28,OPJP,,0,0,0,,Let's walk! Let's walk!
Dialogue: 0,0:00:45.80,0:00:47.25,OPJP,,0,0,0,,Let's walk the road
Dialogue: 0,0:00:47.25,0:00:49.06,OPJP,,0,0,0,,歩きだすよ
Dialogue: 0,0:01:02.64,0:01:08.38,OPJP,,0,0,0,,今はもう前に進んでゆくだけさ
Dialogue: 0,0:01:08.38,0:01:12.63,OPJP,,0,0,0,,絶対振り向いたりしないんだから
Dialogue: 0,0:01:15.22,0:01:18.11,OPJP,,0,0,0,,離れていてもずっと
Dialogue: 0,0:01:18.39,0:01:22.22,OPJP,,0,0,0,,いつだって浮かぶ君のスマイル
Dialogue: 0,0:01:22.49,0:01:26.41,OPJP,,0,0,0,,すぐそばにいる様
Dialogue: 0,0:01:27.33,0:01:30.19,OPJP,,0,0,0,,Everyone has a mission
Dialogue: 0,0:01:30.24,0:01:32.88,OPJP,,0,0,0,,この命を
Dialogue: 0,0:01:33.04,0:01:36.41,OPJP,,0,0,0,,全うするために
Dialogue: 0,0:01:36.51,0:01:39.66,OPJP,,0,0,0,,生まれてきたんだ
Dialogue: 0,0:01:39.96,0:01:42.81,OPJP,,0,0,0,,Everyone has a mission
Dialogue: 0,0:01:42.96,0:01:49.39,OPJP,,0,0,0,,この命が続いてゆく限り
Dialogue: 0,0:01:49.39,0:01:50.57,OPJP,,0,0,0,,Time to go!
Dialogue: 0,0:01:50.78,0:01:53.23,OPJP,,0,0,0,,I got to go, way to go!
Dialogue: 0,0:01:55.14,0:01:57.10,OPJP,,0,0,0,,Way to go!
Dialogue: 0,0:00:36.34,0:00:38.99,OPCN,,0,0,0,,走吧！走吧！
Dialogue: 0,0:00:39.55,0:00:40.94,OPCN,,0,0,0,,顺着这条路走下去
Dialogue: 0,0:00:40.94,0:00:42.54,OPCN,,0,0,0,,不要停下
Dialogue: 0,0:00:42.71,0:00:45.28,OPCN,,0,0,0,,走吧！走吧！
Dialogue: 0,0:00:45.80,0:00:47.25,OPCN,,0,0,0,,顺着这条路走下去
Dialogue: 0,0:00:47.25,0:00:49.06,OPCN,,0,0,0,,出发吧
Dialogue: 0,0:01:02.64,0:01:08.38,OPCN,,0,0,0,,现在除了前进没有别的选择
Dialogue: 0,0:01:08.38,0:01:12.63,OPCN,,0,0,0,,绝对不会再掉头返回了
Dialogue: 0,0:01:15.22,0:01:18.11,OPCN,,0,0,0,,即使彼此相隔得再遥远
Dialogue: 0,0:01:18.39,0:01:22.22,OPCN,,0,0,0,,也永远能回想起你的微笑
Dialogue: 0,0:01:22.49,0:01:26.41,OPCN,,0,0,0,,就好像你未曾离开一样
Dialogue: 0,0:01:27.33,0:01:30.19,OPCN,,0,0,0,,人人都有使命
Dialogue: 0,0:01:30.24,0:01:32.88,OPCN,,0,0,0,,为了让人生
Dialogue: 0,0:01:33.04,0:01:36.41,OPCN,,0,0,0,,变得充实起来
Dialogue: 0,0:01:36.51,0:01:39.66,OPCN,,0,0,0,,一路走到这里
Dialogue: 0,0:01:39.96,0:01:42.81,OPCN,,0,0,0,,人人都有使命
Dialogue: 0,0:01:42.96,0:01:49.39,OPCN,,0,0,0,,只要人生还没结束
Dialogue: 0,0:01:49.39,0:01:50.57,OPCN,,0,0,0,,该走了！
Dialogue: 0,0:01:50.78,0:01:53.23,OPCN,,0,0,0,,我该走了 上路吧！
Dialogue: 0,0:01:55.14,0:01:57.10,OPCN,,0,0,0,,上路吧！
Dialogue: 0,0:02:00.02,0:02:05.02,Default,,0,0,0,,第12集 龙马和基姆尔城镇
Dialogue: 0,0:02:09.42,0:02:11.58,Default,,0,0,0,,朝雾先生 米亚小姐
Dialogue: 0,0:02:11.58,0:02:13.04,Default,,0,0,0,,你们早
Dialogue: 0,0:02:13.96,0:02:15.21,Default,,0,0,0,,龙马
Dialogue: 0,0:02:15.21,0:02:16.58,Default,,0,0,0,,早安呀
Dialogue: 0,0:02:17.00,0:02:18.46,Default,,0,0,0,,准备得怎么样
Dialogue: 0,0:02:18.46,0:02:20.13,Default,,0,0,0,,都准备好了
Dialogue: 0,0:02:20.13,0:02:23.79,Default,,0,0,0,,这样就能让许多人享用料理了
Dialogue: 0,0:02:24.04,0:02:26.42,Default,,0,0,0,,好 我晚点再过来
Dialogue: 0,0:02:26.75,0:02:28.04,Default,,0,0,0,,我等你
Dialogue: 0,0:02:28.04,0:02:30.42,Default,,0,0,0,,你也要加油喔
Dialogue: 0,0:02:30.42,0:02:31.67,Default,,0,0,0,,好
Dialogue: 0,0:02:45.29,0:02:46.54,Default,,0,0,0,,这首曲子…
Dialogue: 0,0:02:50.29,0:02:51.33,Default,,0,0,0,,好美的曲子
Dialogue: 0,0:02:51.33,0:02:52.83,Default,,0,0,0,,好好听
Dialogue: 0,0:02:54.17,0:02:56.88,Default,,0,0,0,,各位 你们刚刚听到的
Dialogue: 0,0:02:56.88,0:02:58.88,Default,,0,0,0,,是我们山姆瑞德剧团
Dialogue: 0,0:02:58.88,0:03:02.54,Default,,0,0,0,,要在今晚的舞台上演奏的曲子
Dialogue: 0,0:03:02.54,0:03:04.54,Default,,0,0,0,,那首曲子在这个
Dialogue: 0,0:03:04.54,0:03:07.33,Default,,0,0,0,,叫做音乐盒的魔法道具
Dialogue: 0,0:03:09.54,0:03:12.63,Default,,0,0,0,,随时随地都可以听到
Dialogue: 0,0:03:14.83,0:03:17.42,Default,,0,0,0,,赛尔吉先生 早安
Dialogue: 0,0:03:17.42,0:03:21.50,Default,,0,0,0,,龙马先生 音乐盒好像很受欢迎呢
Dialogue: 0,0:03:22.42,0:03:24.58,Default,,0,0,0,,因为有山姆瑞德剧团的各位
Dialogue: 0,0:03:24.58,0:03:27.00,Default,,0,0,0,,帮忙做宣传
Dialogue: 0,0:03:27.00,0:03:31.13,Default,,0,0,0,,凯雷邦的迪诺姆工坊\N正在努力量产中
Dialogue: 0,0:03:31.13,0:03:34.54,Default,,0,0,0,,我们预计今后慢慢扩大销售范围
Dialogue: 0,0:03:38.88,0:03:40.71,Default,,0,0,0,,对那家人来说
Dialogue: 0,0:03:40.71,0:03:43.29,Default,,0,0,0,,这个东西一定能勾起\N今天的美好回忆
Dialogue: 0,0:03:44.08,0:03:45.46,Default,,0,0,0,,对啊
Dialogue: 0,0:03:47.71,0:03:50.17,Default,,0,0,0,,总觉得超开心的
Dialogue: 0,0:03:50.50,0:03:50.83,Default,,0,0,0,,咦
Dialogue: 0,0:03:51.42,0:03:52.79,Default,,0,0,0,,已经大排长龙
Dialogue: 0,0:03:53.17,0:03:54.84,Default,,0,0,0,,下一位客人请过来
Dialogue: 0,0:03:53.81,0:03:55.92,UP,,0,0,0,,这是炒蔬菜 让您久等了
Dialogue: 0,0:03:55.80,0:03:58.88,Default,,0,0,0,,请给我赛米沙面包和叫麦茶的饮料
Dialogue: 0,0:03:57.33,0:03:58.87,UP,,0,0,0,,谢谢惠顾
Dialogue: 0,0:03:59.02,0:04:00.32,Default,,0,0,0,,好的
Dialogue: 0,0:03:59.57,0:04:01.17,UP,,0,0,0,,下一位客人请过来
Dialogue: 0,0:04:03.17,0:04:04.92,Default,,0,0,0,,来 卡尔姆先生
Dialogue: 0,0:04:04.92,0:04:06.50,Default,,0,0,0,,谢谢
Dialogue: 0,0:04:07.04,0:04:08.29,Default,,0,0,0,,让您久等了
Dialogue: 0,0:04:10.25,0:04:11.38,Default,,0,0,0,,多尔切先生
Dialogue: 0,0:04:13.75,0:04:14.54,Default,,0,0,0,,什么事
Dialogue: 0,0:04:16.71,0:04:19.88,Default,,0,0,0,,能不能麻烦你整理队伍呢
Dialogue: 0,0:04:19.88,0:04:22.63,Default,,0,0,0,,知道了 生意真兴隆呢
Dialogue: 0,0:04:23.29,0:04:24.25,Default,,0,0,0,,是啊
Dialogue: 0,0:04:24.25,0:04:26.88,Default,,0,0,0,,少见的地方料理也很受欢迎
Dialogue: 0,0:04:26.88,0:04:28.33,Default,,0,0,0,,那真是太好了
Dialogue: 0,0:04:28.33,0:04:30.04,Default,,0,0,0,,这里就交给我吧
Dialogue: 0,0:04:30.04,0:04:31.29,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:04:31.71,0:04:32.96,Default,,0,0,0,,店长
Dialogue: 0,0:04:32.96,0:04:36.21,Default,,0,0,0,,麻烦您去请谢尔玛小姐补炒蔬菜
Dialogue: 0,0:04:36.96,0:04:39.50,Default,,0,0,0,,还有麦茶也快要没了
Dialogue: 0,0:04:39.50,0:04:40.58,Default,,0,0,0,,麻烦您了
Dialogue: 0,0:04:40.58,0:04:41.71,Default,,0,0,0,,我知道了
Dialogue: 0,0:04:47.96,0:04:48.92,Default,,0,0,0,,交给你们啰
Dialogue: 0,0:04:50.00,0:04:51.17,Default,,0,0,0,,借过一下
Dialogue: 0,0:04:51.71,0:04:52.33,Default,,0,0,0,,抱歉
Dialogue: 0,0:04:53.54,0:04:55.21,Default,,0,0,0,,好忙啊
Dialogue: 0,0:04:58.29,0:05:01.75,Default,,0,0,0,,谢尔玛小姐 麻烦你补炒蔬菜
Dialogue: 0,0:05:02.46,0:05:04.13,Default,,0,0,0,,我想说应该快没了
Dialogue: 0,0:05:04.13,0:05:06.04,Default,,0,0,0,,现在正在做
Dialogue: 0,0:05:06.04,0:05:07.63,Default,,0,0,0,,谢谢你
Dialogue: 0,0:05:08.42,0:05:10.21,Default,,0,0,0,,还有菲娜小姐
Dialogue: 0,0:05:10.21,0:05:12.92,Default,,0,0,0,,能不能麻烦你帮忙补麦茶
Dialogue: 0,0:05:12.92,0:05:14.00,Default,,0,0,0,,好的
Dialogue: 0,0:05:15.17,0:05:18.13,Default,,0,0,0,,店长 这个东西好厉害
Dialogue: 0,0:05:18.13,0:05:20.04,Default,,0,0,0,,蔬菜一瞬间就切好了
Dialogue: 0,0:05:20.88,0:05:23.25,Default,,0,0,0,,用史莱姆变成的烹饪器具
Dialogue: 0,0:05:23.25,0:05:25.04,Default,,0,0,0,,能派上用场真是太好了
Dialogue: 0,0:05:25.83,0:05:27.00,Default,,0,0,0,,接下来…
Dialogue: 0,0:05:28.75,0:05:29.88,Default,,0,0,0,,各位
Dialogue: 0,0:05:32.33,0:05:33.88,Default,,0,0,0,,这些也麻烦你们了
Dialogue: 0,0:05:40.63,0:05:42.75,Default,,0,0,0,,龙马 你们好像很忙嘛
Dialogue: 0,0:05:43.83,0:05:45.42,Default,,0,0,0,,沃刚先生
Dialogue: 0,0:05:45.42,0:05:47.63,Default,,0,0,0,,你们也有认真在工作吧
Dialogue: 0,0:05:48.21,0:05:49.92,Default,,0,0,0,,那当然啦
Dialogue: 0,0:05:49.92,0:05:51.38,Default,,0,0,0,,我们可是被雇来的
Dialogue: 0,0:05:52.25,0:05:53.71,Default,,0,0,0,,会努力工作的
Dialogue: 0,0:05:54.29,0:05:56.38,Default,,0,0,0,,他们真的帮了很多忙
Dialogue: 0,0:05:56.38,0:05:58.92,Default,,0,0,0,,从准备期间就一直在帮忙
Dialogue: 0,0:06:01.29,0:06:04.13,Default,,0,0,0,,不对 他们一直都在工作
Dialogue: 0,0:06:04.13,0:06:07.08,Default,,0,0,0,,大家完全没有享受到庆典
Dialogue: 0,0:06:08.13,0:06:09.29,Default,,0,0,0,,沃刚先生
Dialogue: 0,0:06:09.29,0:06:12.71,Default,,0,0,0,,你可以带贝克他们逛逛庆典吗
Dialogue: 0,0:06:12.71,0:06:14.50,Default,,0,0,0,,可以是可以
Dialogue: 0,0:06:14.50,0:06:16.21,Default,,0,0,0,,你在说什么啊
Dialogue: 0,0:06:16.21,0:06:17.67,Default,,0,0,0,,现在这么忙
Dialogue: 0,0:06:17.67,0:06:20.17,Default,,0,0,0,,我们怎么能自己跑去玩啊
Dialogue: 0,0:06:20.46,0:06:22.54,Default,,0,0,0,,工作就由我们来接手
Dialogue: 0,0:06:23.46,0:06:24.54,Default,,0,0,0,,卡尔菈小姐
Dialogue: 0,0:06:24.54,0:06:26.38,Default,,0,0,0,,柯金先生你们也来了
Dialogue: 0,0:06:26.38,0:06:28.38,Default,,0,0,0,,我们收到卡尔姆的联络
Dialogue: 0,0:06:28.38,0:06:29.83,Default,,0,0,0,,所以回来帮忙了
Dialogue: 0,0:06:32.94,0:06:34.31,Default,,0,0,0,,- 好吃\N- 好好吃
Dialogue: 0,0:06:35.88,0:06:37.46,Default,,0,0,0,,雷纳夫的二号店
Dialogue: 0,0:06:37.46,0:06:40.42,Default,,0,0,0,,我交给新雇用的员工们
Dialogue: 0,0:06:41.29,0:06:43.46,Default,,0,0,0,,他们已经完全熟悉工作
Dialogue: 0,0:06:43.46,0:06:44.67,Default,,0,0,0,,所以不用担心
Dialogue: 0,0:06:45.38,0:06:46.63,Default,,0,0,0,,这样啊
Dialogue: 0,0:06:46.63,0:06:48.96,Default,,0,0,0,,你们能过来 真是帮大忙了
Dialogue: 0,0:06:48.96,0:06:52.67,Default,,0,0,0,,这样大家就能轮班休息了
Dialogue: 0,0:06:58.42,0:07:01.08,Default,,0,0,0,,既然这样 请店长也去休息
Dialogue: 0,0:07:02.00,0:07:03.38,Default,,0,0,0,,可是我…
Dialogue: 0,0:07:03.38,0:07:07.08,Default,,0,0,0,,店长也是第一次参加创立庆典
Dialogue: 0,0:07:07.08,0:07:08.50,Default,,0,0,0,,请您去好好玩一下
Dialogue: 0,0:07:09.00,0:07:11.63,Default,,0,0,0,,好 谢谢你
Dialogue: 0,0:07:11.63,0:07:14.46,Default,,0,0,0,,但是我还有一些事情要做
Dialogue: 0,0:07:23.63,0:07:25.21,Default,,0,0,0,,真是太棒了
Dialogue: 0,0:07:26.08,0:07:27.38,Default,,0,0,0,,普雷南斯先生
Dialogue: 0,0:07:27.92,0:07:29.50,Default,,0,0,0,,你不要紧吗
Dialogue: 0,0:07:29.50,0:07:31.08,Default,,0,0,0,,这里因为施了结界和冰魔法
Dialogue: 0,0:07:31.08,0:07:32.96,Default,,0,0,0,,所以非常寒冷
Dialogue: 0,0:07:33.58,0:07:36.38,Default,,0,0,0,,在完美的雕刻作品面前
Dialogue: 0,0:07:36.38,0:07:39.54,Default,,0,0,0,,这点寒冷根本不算什么
Dialogue: 0,0:07:39.54,0:07:40.96,Default,,0,0,0,,咦…
Dialogue: 0,0:07:42.33,0:07:43.96,Default,,0,0,0,,我感谢到不知道说什么好
Dialogue: 0,0:07:45.42,0:07:49.46,Default,,0,0,0,,就让我为您表演\N不输给这个雕刻的演出吧
Dialogue: 0,0:07:50.00,0:07:53.33,Default,,0,0,0,,好 我很期待
Dialogue: 0,0:07:56.67,0:07:59.63,Default,,0,0,0,,店长 您已经做完了吧
Dialogue: 0,0:07:59.63,0:08:00.25,Default,,0,0,0,,对
Dialogue: 0,0:08:01.17,0:08:03.21,Default,,0,0,0,,那么 这次请您去休息…
Dialogue: 0,0:08:03.21,0:08:04.33,Default,,0,0,0,,龙马先生
Dialogue: 0,0:08:05.08,0:08:06.50,Default,,0,0,0,,我们又见面了
Dialogue: 0,0:08:07.29,0:08:08.67,Default,,0,0,0,,赛尔吉先生
Dialogue: 0,0:08:08.67,0:08:10.88,Default,,0,0,0,,毕欧罗先生也跟你在一起吗
Dialogue: 0,0:08:10.88,0:08:13.13,Default,,0,0,0,,我有话要跟你说 现在方便吗
Dialogue: 0,0:08:13.71,0:08:15.54,Default,,0,0,0,,好啊 我有空
Dialogue: 0,0:08:21.29,0:08:23.58,Default,,0,0,0,,这个麦茶 好像很受欢迎
Dialogue: 0,0:08:24.25,0:08:26.42,Default,,0,0,0,,评价很棒唷
Dialogue: 0,0:08:26.42,0:08:29.42,Default,,0,0,0,,是啊 多亏客人喜欢 卖得很好
Dialogue: 0,0:08:33.25,0:08:35.13,Default,,0,0,0,,味道真棒
Dialogue: 0,0:08:35.13,0:08:39.21,Default,,0,0,0,,跟红茶和花草茶不同的香气\N令人欲罢不能
Dialogue: 0,0:08:39.75,0:08:43.00,Default,,0,0,0,,看你这么喜欢 真令人开心
Dialogue: 0,0:08:43.00,0:08:45.21,Default,,0,0,0,,这些麦子你是从哪里进货的
Dialogue: 0,0:08:45.21,0:08:48.46,Default,,0,0,0,,是我们员工家乡的村子送来的
Dialogue: 0,0:08:48.46,0:08:50.63,Default,,0,0,0,,听说是卖不出去剩下的
Dialogue: 0,0:08:52.25,0:08:53.21,Default,,0,0,0,,- 龙马\N- 龙马先生
Dialogue: 0,0:08:55.38,0:08:56.75,Default,,0,0,0,,什么
Dialogue: 0,0:08:59.04,0:09:01.25,Default,,0,0,0,,想要我们村子种的麦子
Dialogue: 0,0:09:01.25,0:09:02.33,Default,,0,0,0,,对
Dialogue: 0,0:09:02.33,0:09:03.83,Default,,0,0,0,,他们说想加工成麦茶
Dialogue: 0,0:09:03.83,0:09:07.08,Default,,0,0,0,,正式开始销售
Dialogue: 0,0:09:07.08,0:09:08.63,Default,,0,0,0,,真的吗
Dialogue: 0,0:09:08.63,0:09:09.63,Default,,0,0,0,,对
Dialogue: 0,0:09:09.63,0:09:12.58,Default,,0,0,0,,今天麦茶卖得非常好
Dialogue: 0,0:09:12.58,0:09:15.54,Default,,0,0,0,,如果有赛尔吉先生\N和毕欧罗先生的协助
Dialogue: 0,0:09:15.54,0:09:18.79,Default,,0,0,0,,我认为这项生意一定做得成
Dialogue: 0,0:09:19.75,0:09:20.96,Default,,0,0,0,,我好高兴
Dialogue: 0,0:09:20.96,0:09:23.04,Default,,0,0,0,,村里的居民一定也会很欢喜
Dialogue: 0,0:09:23.04,0:09:25.46,Default,,0,0,0,,店长 谢谢您
Dialogue: 0,0:09:25.46,0:09:27.58,Default,,0,0,0,,我什么也没做
Dialogue: 0,0:09:27.58,0:09:28.92,Default,,0,0,0,,详细的内容
Dialogue: 0,0:09:28.92,0:09:31.08,Default,,0,0,0,,我再请他们找你们谈吧
Dialogue: 0,0:09:31.50,0:09:33.96,Default,,0,0,0,,好 麻烦您了
Dialogue: 0,0:09:34.92,0:09:36.21,Default,,0,0,0,,如果能有收益
Dialogue: 0,0:09:36.21,0:09:40.29,Default,,0,0,0,,村里的人也许就不需要出来赚钱了
Dialogue: 0,0:09:40.29,0:09:42.04,Default,,0,0,0,,但愿可以顺利谈成
Dialogue: 0,0:09:42.42,0:09:43.50,Default,,0,0,0,,店长
Dialogue: 0,0:09:44.04,0:09:46.33,Default,,0,0,0,,这次请您一定要休息
Dialogue: 0,0:09:47.21,0:09:49.54,Default,,0,0,0,,好 我会的
Dialogue: 0,0:09:50.63,0:09:53.17,Default,,0,0,0,,卡尔菈小姐说得对
Dialogue: 0,0:09:53.17,0:09:56.00,Default,,0,0,0,,龙马也应该好好享受庆典
Dialogue: 0,0:09:56.00,0:09:56.92,Default,,0,0,0,,好
Dialogue: 0,0:09:57.42,0:09:59.50,Default,,0,0,0,,明明叫贝克他们去玩
Dialogue: 0,0:09:59.50,0:10:02.21,Default,,0,0,0,,结果自己却一直在工作\N这样可不行
Dialogue: 0,0:10:03.21,0:10:04.42,Default,,0,0,0,,久等了
Dialogue: 0,0:10:07.42,0:10:09.17,Default,,0,0,0,,请慢用
Dialogue: 0,0:10:09.17,0:10:11.63,Default,,0,0,0,,这是天妇罗饭团和味噌汤
Dialogue: 0,0:10:12.04,0:10:13.25,Default,,0,0,0,,我开动了
Dialogue: 0,0:10:23.46,0:10:25.04,Default,,0,0,0,,这个味道真棒
Dialogue: 0,0:10:25.04,0:10:28.00,Default,,0,0,0,,后来我又多下了一点功夫
Dialogue: 0,0:10:28.00,0:10:30.50,Default,,0,0,0,,客人也非常喜欢
Dialogue: 0,0:10:33.83,0:10:35.29,Default,,0,0,0,,好好喝
Dialogue: 0,0:10:35.29,0:10:38.63,Default,,0,0,0,,我也会跟店里的员工们宣传的
Dialogue: 0,0:10:50.25,0:10:52.92,Default,,0,0,0,,妈妈
Dialogue: 0,0:10:54.71,0:10:56.83,Default,,0,0,0,,果然是走失儿童
Dialogue: 0,0:10:57.33,0:10:58.38,Default,,0,0,0,,那我要拍啰
Dialogue: 0,0:10:58.38,0:10:59.79,Default,,0,0,0,,来 笑一个
Dialogue: 0,0:10:59.79,0:11:01.83,Default,,0,0,0,,龙马先生看起来好大 真开心
Dialogue: 0,0:11:02.67,0:11:04.33,Default,,0,0,0,,终于见到龙马先生了
Dialogue: 0,0:11:04.33,0:11:05.46,Default,,0,0,0,,我会再寄信给你的
Dialogue: 0,0:11:05.46,0:11:07.02,Default,,0,0,0,,这么快就结束了吗
Dialogue: 0,0:11:13.54,0:11:14.88,Default,,0,0,0,,你妈妈呢
Dialogue: 0,0:11:17.96,0:11:19.25,Default,,0,0,0,,你家在那里
Dialogue: 0,0:11:21.58,0:11:23.58,Default,,0,0,0,,是走失儿童呢
Dialogue: 0,0:11:23.58,0:11:26.00,Default,,0,0,0,,我没有在这个城镇看过他
Dialogue: 0,0:11:26.00,0:11:27.33,Default,,0,0,0,,这样啊
Dialogue: 0,0:11:27.33,0:11:30.92,Default,,0,0,0,,应该是从别的城镇来这里\N参加庆典的吧
Dialogue: 0,0:11:30.92,0:11:33.58,Default,,0,0,0,,带他去警备队那里吧
Dialogue: 0,0:11:33.58,0:11:36.21,Default,,0,0,0,,他妈妈一定也在找他
Dialogue: 0,0:11:38.67,0:11:39.42,Default,,0,0,0,,喵
Dialogue: 0,0:11:40.88,0:11:43.50,Default,,0,0,0,,龙马 他好像很喜欢你
Dialogue: 0,0:11:43.50,0:11:45.00,Default,,0,0,0,,咦
Dialogue: 0,0:11:49.54,0:11:51.75,Default,,0,0,0,,我们去找你妈妈吧
Dialogue: 0,0:11:51.75,0:11:52.71,Default,,0,0,0,,好
Dialogue: 0,0:11:53.25,0:11:55.21,Default,,0,0,0,,那我们走了
Dialogue: 0,0:11:56.00,0:11:57.58,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:11:58.58,0:12:00.54,Default,,0,0,0,,我叫龙马·竹林
Dialogue: 0,0:12:00.54,0:12:01.92,Default,,0,0,0,,你叫什么名字
Dialogue: 0,0:12:02.17,0:12:03.46,Default,,0,0,0,,提欧
Dialogue: 0,0:12:03.46,0:12:04.75,Default,,0,0,0,,你叫提欧啊
Dialogue: 0,0:12:04.75,0:12:06.92,Default,,0,0,0,,你是跟妈妈一起来的吗
Dialogue: 0,0:12:06.92,0:12:08.08,Default,,0,0,0,,嗯
Dialogue: 0,0:12:08.08,0:12:10.17,Default,,0,0,0,,你是第一次参加庆典吗
Dialogue: 0,0:12:10.17,0:12:11.33,Default,,0,0,0,,没错
Dialogue: 0,0:12:11.71,0:12:13.92,Default,,0,0,0,,我也是第一次参加
Dialogue: 0,0:12:13.92,0:12:14.92,Default,,0,0,0,,真的吗
Dialogue: 0,0:12:16.29,0:12:18.88,Default,,0,0,0,,因为我之前住在别的地方
Dialogue: 0,0:12:18.88,0:12:20.04,Default,,0,0,0,,哪里
Dialogue: 0,0:12:22.04,0:12:24.21,Default,,0,0,0,,是一个很远的地方
Dialogue: 0,0:12:25.58,0:12:27.25,Default,,0,0,0,,很远的地方…
Dialogue: 0,0:12:27.25,0:12:29.17,Default,,0,0,0,,没错 就是地球
Dialogue: 0,0:12:30.00,0:12:32.67,Default,,0,0,0,,在日本的黑心企业上班的我
Dialogue: 0,0:12:34.08,0:12:35.42,Default,,0,0,0,,死了
Dialogue: 0,0:12:35.42,0:12:37.88,Default,,0,0,0,,被众神捡回去
Dialogue: 0,0:12:37.88,0:12:39.92,Default,,0,0,0,,转生到这个世界
Dialogue: 0,0:12:42.54,0:12:46.46,Default,,0,0,0,,遇见艾莉亚和兰哈特先生他们
Dialogue: 0,0:12:46.46,0:12:47.75,Default,,0,0,0,,踏上旅程
Dialogue: 0,0:12:50.33,0:12:52.04,Default,,0,0,0,,来到基姆尔这里
Dialogue: 0,0:12:53.42,0:12:56.58,Default,,0,0,0,,然后开了Bamboo Forest
Dialogue: 0,0:13:00.54,0:13:02.96,Default,,0,0,0,,仔细一想 我走了真远呢
Dialogue: 0,0:13:06.75,0:13:08.42,Default,,0,0,0,,没什么
Dialogue: 0,0:13:08.42,0:13:10.33,Default,,0,0,0,,哎呀 是走失儿童吗
Dialogue: 0,0:13:12.42,0:13:14.63,Default,,0,0,0,,古丽希艾拉女士
Dialogue: 0,0:13:14.63,0:13:17.29,Default,,0,0,0,,我现在要带他去警备队的驻在所
Dialogue: 0,0:13:17.88,0:13:19.75,Default,,0,0,0,,那真是辛苦你了
Dialogue: 0,0:13:36.58,0:13:40.54,Default,,0,0,0,,你也完全变成这个城镇的人了呢
Dialogue: 0,0:13:40.54,0:13:41.67,Default,,0,0,0,,是这样吗
Dialogue: 0,0:13:42.00,0:13:43.08,Default,,0,0,0,,怎么样
Dialogue: 0,0:13:43.08,0:13:45.33,Default,,0,0,0,,跟住在森林的时候相比
Dialogue: 0,0:13:45.33,0:13:46.96,Default,,0,0,0,,这里的生活好吗
Dialogue: 0,0:13:49.25,0:13:51.67,Default,,0,0,0,,我不知道哪边比较好
Dialogue: 0,0:13:51.67,0:13:54.13,Default,,0,0,0,,森林有森林的优点
Dialogue: 0,0:13:54.13,0:13:55.25,Default,,0,0,0,,不过…
Dialogue: 0,0:13:57.13,0:13:59.25,Default,,0,0,0,,看你那个表情 应该是还不错
Dialogue: 0,0:14:00.13,0:14:02.75,Default,,0,0,0,,对 我是这么想的
Dialogue: 0,0:14:02.75,0:14:04.88,Default,,0,0,0,,现在的生活也不错
Dialogue: 0,0:14:05.79,0:14:07.33,Default,,0,0,0,,提欧 太好了
Dialogue: 0,0:14:07.33,0:14:09.00,Default,,0,0,0,,妈妈
Dialogue: 0,0:14:10.33,0:14:13.00,Default,,0,0,0,,真的很谢谢你
Dialogue: 0,0:14:13.00,0:14:14.17,Default,,0,0,0,,不会
Dialogue: 0,0:14:14.17,0:14:16.42,Default,,0,0,0,,那么提欧 再见
Dialogue: 0,0:14:16.42,0:14:17.83,Default,,0,0,0,,再见
Dialogue: 0,0:14:23.75,0:14:26.46,Default,,0,0,0,,这里的生活也不错
Dialogue: 0,0:14:30.54,0:14:32.46,Default,,0,0,0,,让人们感到痛苦的野兽
Dialogue: 0,0:14:32.46,0:14:34.63,Default,,0,0,0,,臣服于我们的面前
Dialogue: 0,0:14:34.63,0:14:36.88,Default,,0,0,0,,今后大家将和我们一起
Dialogue: 0,0:14:36.88,0:14:39.00,Default,,0,0,0,,在新的道路上活下去
Dialogue: 0,0:14:39.58,0:14:41.75,Default,,0,0,0,,好了 为这一天感到喜悦
Dialogue: 0,0:14:41.75,0:14:43.08,Default,,0,0,0,,与我们共同庆祝吧
Dialogue: 0,0:15:26.21,0:15:29.04,Default,,0,0,0,,店长 这个料理叫什么呢
Dialogue: 0,0:15:30.21,0:15:31.63,Default,,0,0,0,,这叫炒面
Dialogue: 0,0:15:31.63,0:15:33.83,Default,,0,0,0,,调味方式有很多种
Dialogue: 0,0:15:33.83,0:15:36.88,Default,,0,0,0,,但我今天只用盐巴简单调味一下
Dialogue: 0,0:15:37.21,0:15:38.92,Default,,0,0,0,,看起来好好吃
Dialogue: 0,0:15:38.92,0:15:41.25,Default,,0,0,0,,下次午餐的时候我做做看
Dialogue: 0,0:15:41.25,0:15:42.71,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:15:43.46,0:15:45.54,Default,,0,0,0,,这样子庆功宴要端出的料理
Dialogue: 0,0:15:45.54,0:15:47.08,Default,,0,0,0,,大致上都完成了
Dialogue: 0,0:15:49.42,0:15:50.46,Default,,0,0,0,,店长
Dialogue: 0,0:15:52.17,0:15:55.13,Default,,0,0,0,,山姆瑞德剧团的成员们\N还没有出现
Dialogue: 0,0:15:55.67,0:15:58.71,Default,,0,0,0,,难道是舞台还没收拾好吗
Dialogue: 0,0:15:58.71,0:16:00.04,Default,,0,0,0,,我去看看
Dialogue: 0,0:16:06.29,0:16:08.17,Default,,0,0,0,,他们在做什么呢
Dialogue: 0,0:16:11.75,0:16:12.83,Default,,0,0,0,,龙马
Dialogue: 0,0:16:14.33,0:16:15.54,Default,,0,0,0,,辛苦你们了
Dialogue: 0,0:16:16.21,0:16:17.71,Default,,0,0,0,,有什么事吗
Dialogue: 0,0:16:18.33,0:16:19.88,Default,,0,0,0,,庆功宴要开始了
Dialogue: 0,0:16:19.88,0:16:21.38,Default,,0,0,0,,所以我来叫你们
Dialogue: 0,0:16:21.92,0:16:23.88,Default,,0,0,0,,你们在做什么呢
Dialogue: 0,0:16:25.71,0:16:27.50,Default,,0,0,0,,这是神像吗
Dialogue: 0,0:16:28.08,0:16:29.75,Default,,0,0,0,,是不是很少见
Dialogue: 0,0:16:29.75,0:16:32.00,Default,,0,0,0,,这是玛诺艾罗亚大人的神像喔
Dialogue: 0,0:16:32.67,0:16:34.58,Default,,0,0,0,,玛诺艾罗亚大人…
Dialogue: 0,0:16:36.13,0:16:38.75,Default,,0,0,0,,是神话中出现过的名字
Dialogue: 0,0:16:38.75,0:16:40.42,Default,,0,0,0,,虽然没见过本尊
Dialogue: 0,0:16:40.42,0:16:41.75,Default,,0,0,0,,但她跟凯因他们一样
Dialogue: 0,0:16:41.75,0:16:43.58,Default,,0,0,0,,都是伟大的神明
Dialogue: 0,0:16:44.75,0:16:47.21,Default,,0,0,0,,我记得她是风之神对吧
Dialogue: 0,0:16:47.21,0:16:48.33,Default,,0,0,0,,没错
Dialogue: 0,0:16:48.33,0:16:50.75,Default,,0,0,0,,她是以在这个世界循环的风为化身
Dialogue: 0,0:16:50.75,0:16:53.96,Default,,0,0,0,,守护人们的伟大神明
Dialogue: 0,0:16:53.96,0:16:57.29,Default,,0,0,0,,同时她也是旅行与演艺之神
Dialogue: 0,0:16:58.29,0:17:00.33,Default,,0,0,0,,所以许多巡回表演者
Dialogue: 0,0:17:00.33,0:17:02.63,Default,,0,0,0,,都很崇拜玛诺艾罗亚大人
Dialogue: 0,0:17:03.00,0:17:06.00,Default,,0,0,0,,我们正好在装饰它
Dialogue: 0,0:17:06.00,0:17:07.29,Default,,0,0,0,,装饰
Dialogue: 0,0:17:07.29,0:17:08.13,Default,,0,0,0,,没错
Dialogue: 0,0:17:08.13,0:17:10.21,Default,,0,0,0,,如果遇到能带来美好回忆的事
Dialogue: 0,0:17:10.21,0:17:14.33,Default,,0,0,0,,我们都会在那个城镇买一条布
Dialogue: 0,0:17:14.33,0:17:17.75,Default,,0,0,0,,因为在旅行的时候\N不能让行李增加
Dialogue: 0,0:17:17.75,0:17:19.25,Default,,0,0,0,,把它缠在神像上
Dialogue: 0,0:17:19.25,0:17:21.79,Default,,0,0,0,,是为了感谢神明
Dialogue: 0,0:17:21.79,0:17:23.63,Default,,0,0,0,,让我们遇到美好的事情
Dialogue: 0,0:17:23.63,0:17:27.50,Default,,0,0,0,,简单来说 就是巡回表演者的习俗
Dialogue: 0,0:17:27.50,0:17:30.00,Default,,0,0,0,,虽然不知道是从什么时候开始的
Dialogue: 0,0:17:30.58,0:17:33.54,Default,,0,0,0,,旅行的…回忆
Dialogue: 0,0:17:39.04,0:17:42.75,Default,,0,0,0,,各位 差不多要举杯了
Dialogue: 0,0:17:45.54,0:17:48.04,Default,,0,0,0,,店长 麻烦您致词
Dialogue: 0,0:17:48.50,0:17:49.33,Default,,0,0,0,,好
Dialogue: 0,0:17:52.54,0:17:54.17,Default,,0,0,0,,各位
Dialogue: 0,0:17:54.17,0:17:56.38,Default,,0,0,0,,创立庆典 大家都辛苦了
Dialogue: 0,0:17:57.13,0:17:57.88,Default,,0,0,0,,干杯
Dialogue: 0,0:17:58.33,0:17:59.75,Default,,0,0,0,,干杯
Dialogue: 0,0:18:09.17,0:18:12.58,Default,,0,0,0,,创立庆典超好玩的
Dialogue: 0,0:18:12.58,0:18:14.38,Default,,0,0,0,,大家用在这里工作赚来的钱
Dialogue: 0,0:18:14.38,0:18:15.96,Default,,0,0,0,,买了很多东西
Dialogue: 0,0:18:16.38,0:18:17.88,Default,,0,0,0,,谢谢你
Dialogue: 0,0:18:17.88,0:18:19.38,Default,,0,0,0,,都是托你的福
Dialogue: 0,0:18:19.79,0:18:20.92,Default,,0,0,0,,哪里
Dialogue: 0,0:18:20.92,0:18:23.25,Default,,0,0,0,,你有好好享受庆典吗
Dialogue: 0,0:18:24.96,0:18:25.83,Default,,0,0,0,,有
Dialogue: 0,0:18:25.83,0:18:29.50,Default,,0,0,0,,我送走失儿童回去后\N有到处去逛逛
Dialogue: 0,0:18:30.04,0:18:31.50,Default,,0,0,0,,真是太好了
Dialogue: 0,0:18:31.50,0:18:32.54,Default,,0,0,0,,卡尔菈小姐
Dialogue: 0,0:18:33.46,0:18:35.25,Default,,0,0,0,,你们从雷纳夫过来
Dialogue: 0,0:18:35.25,0:18:37.29,Default,,0,0,0,,真的帮了大忙
Dialogue: 0,0:18:37.29,0:18:38.67,Default,,0,0,0,,谢谢你
Dialogue: 0,0:18:39.29,0:18:41.58,Default,,0,0,0,,我也是第一次参加创立庆典
Dialogue: 0,0:18:41.58,0:18:43.79,Default,,0,0,0,,觉得这个体验很新鲜
Dialogue: 0,0:18:45.79,0:18:48.58,Default,,0,0,0,,虽然离开的时间没有很长
Dialogue: 0,0:18:49.96,0:18:52.54,Default,,0,0,0,,但总觉得有点怀念
Dialogue: 0,0:18:53.46,0:18:54.50,Default,,0,0,0,,龙马
Dialogue: 0,0:18:55.46,0:18:56.96,Default,,0,0,0,,迈雅小姐
Dialogue: 0,0:18:56.96,0:18:58.00,Default,,0,0,0,,因为是压轴了
Dialogue: 0,0:18:58.00,0:18:59.79,Default,,0,0,0,,你要不要跟我们一起表演呢
Dialogue: 0,0:19:00.63,0:19:01.46,Default,,0,0,0,,咦
Dialogue: 0,0:19:02.08,0:19:03.88,Default,,0,0,0,,龙马 表演吧
Dialogue: 0,0:19:03.88,0:19:06.00,Default,,0,0,0,,请你一定要去露一手
Dialogue: 0,0:19:06.00,0:19:08.06,Default,,0,0,0,,店长去吧
Dialogue: 0,0:19:08.06,0:19:09.29,Default,,0,0,0,,加油
Dialogue: 0,0:19:09.96,0:19:11.63,Default,,0,0,0,,好吧
Dialogue: 0,0:19:11.63,0:19:13.88,Default,,0,0,0,,店长 请您加油
Dialogue: 0,0:19:13.88,0:19:16.58,Default,,0,0,0,,好 我会尽情表演的
Dialogue: 0,0:19:53.17,0:19:54.71,Default,,0,0,0,,我一定…
Dialogue: 0,0:20:07.33,0:20:10.54,Default,,0,0,0,,忘不了今天发生的事吧
Dialogue: 0,0:20:15.50,0:20:16.75,Default,,0,0,0,,赛尔吉先生
Dialogue: 0,0:20:17.17,0:20:18.04,Default,,0,0,0,,龙马先生
Dialogue: 0,0:20:18.75,0:20:21.33,Default,,0,0,0,,剑舞和演奏都很精彩呢
Dialogue: 0,0:20:21.83,0:20:23.67,Default,,0,0,0,,谢谢夸奖
Dialogue: 0,0:20:23.67,0:20:26.46,Default,,0,0,0,,那个 我想拜托你一件事
Dialogue: 0,0:20:31.67,0:20:35.75,Default,,0,0,0,,创立庆典是令人非常难忘的一天
Dialogue: 0,0:20:36.75,0:20:40.21,Default,,0,0,0,,我拜托赛尔吉先生
Dialogue: 0,0:20:40.21,0:20:42.25,Default,,0,0,0,,特别帮我把这一天的回忆
Dialogue: 0,0:20:42.25,0:20:43.79,Default,,0,0,0,,做成两个音乐盒
Dialogue: 0,0:20:48.58,0:20:50.71,Default,,0,0,0,,其中一个送给艾莉亚
Dialogue: 0,0:20:56.38,0:20:58.17,Default,,0,0,0,,好美的曲子
Dialogue: 0,0:20:58.58,0:21:02.21,Default,,0,0,0,,来到基姆尔真是太好了
Dialogue: 0,0:21:02.21,0:21:06.13,Default,,0,0,0,,我找到了自己的归属
Dialogue: 0,0:21:06.54,0:21:09.71,Default,,0,0,0,,从今以后 我也会为了这些人
Dialogue: 0,0:21:09.71,0:21:12.58,Default,,0,0,0,,努力完成自己能做的事情
Dialogue: 0,0:21:16.67,0:21:18.71,Default,,0,0,0,,龙马先生
Dialogue: 0,0:21:18.71,0:21:22.25,Default,,0,0,0,,我也会努力完成自己能做的事情
Dialogue: 0,0:21:22.25,0:21:24.46,Default,,0,0,0,,让自己更加成长
Dialogue: 0,0:21:24.46,0:21:26.88,Default,,0,0,0,,直到见到你的那一天
Dialogue: 0,0:21:29.33,0:21:31.83,Default,,0,0,0,,艾莉亚 该走啰
Dialogue: 0,0:21:31.83,0:21:33.00,Default,,0,0,0,,好
Dialogue: 0,0:21:37.29,0:21:38.42,Default,,0,0,0,,早安
Dialogue: 0,0:21:38.42,0:21:39.96,Default,,0,0,0,,早安
Dialogue: 0,0:21:39.96,0:21:41.38,Default,,0,0,0,,今天天气真好
Dialogue: 0,0:21:41.38,0:21:41.79,Default,,0,0,0,,对啊
Dialogue: 0,0:21:51.21,0:21:53.54,Default,,0,0,0,,今天一天也好好加油吧
Dialogue: 0,0:21:57.63,0:21:59.54,Default,,0,0,0,,早安
Dialogue: 0,0:21:59.54,0:22:02.38,Default,,0,0,0,,店长 早安
Dialogue: 0,0:22:20.20,0:22:23.49,EDJP,,0,0,0,,センサーライト音沙汰なくて
Dialogue: 0,0:22:23.72,0:22:29.72,EDJP,,0,0,0,,この部屋にわたしがいないみたいだ
Dialogue: 0,0:22:30.21,0:22:32.75,EDJP,,0,0,0,,＃にフィグジャムをつけたら
Dialogue: 0,0:22:32.75,0:22:34.90,EDJP,,0,0,0,,バスタブに泡をたてて
Dialogue: 0,0:22:34.90,0:22:41.96,EDJP,,0,0,0,,よみがえるの 明日のため…Undead!!
Dialogue: 0,0:22:49.87,0:22:52.35,EDJP,,0,0,0,,なくはないの あなたとなら
Dialogue: 0,0:22:52.35,0:22:55.04,EDJP,,0,0,0,,巡り巡る 機械と水
Dialogue: 0,0:22:55.04,0:22:58.72,EDJP,,0,0,0,,ドラム式の宇宙をそっと 見つめて
Dialogue: 0,0:22:59.20,0:23:04.03,EDJP,,0,0,0,,口説きたいな Ah死ぬまで
Dialogue: 0,0:23:04.03,0:23:09.12,EDJP,,0,0,0,,弧を描いた solarの果て
Dialogue: 0,0:23:09.12,0:23:11.91,EDJP,,0,0,0,,愛は少しくたびれて
Dialogue: 0,0:23:11.91,0:23:14.42,EDJP,,0,0,0,,遠ざかりつつあるわ
Dialogue: 0,0:23:14.42,0:23:17.19,EDJP,,0,0,0,,n時発の小惑星で行くの
Dialogue: 0,0:23:17.19,0:23:21.19,EDJP,,0,0,0,,あなた 夢抱いて
Dialogue: 0,0:23:21.35,0:23:28.92,EDJP,,0,0,0,,抱いて 抱いて 抱いて
Dialogue: 0,0:23:28.92,0:23:33.75,EDJP,,0,0,0,,抱いて 抱いて
Dialogue: 0,0:22:20.20,0:22:23.49,EDCN,,0,0,0,,探测光线 未发出声音
Dialogue: 0,0:22:23.72,0:22:29.72,EDCN,,0,0,0,,似乎我并不在这间房内
Dialogue: 0,0:22:30.21,0:22:32.75,EDCN,,0,0,0,,在#后面输入FigJam
Dialogue: 0,0:22:32.75,0:22:34.90,EDCN,,0,0,0,,浴缸里充满了泡沫
Dialogue: 0,0:22:34.90,0:22:41.96,EDCN,,0,0,0,,为了明天再一次醒来……Undead!!
Dialogue: 0,0:22:49.87,0:22:52.35,EDCN,,0,0,0,,若与你同在 便完美无缺
Dialogue: 0,0:22:52.35,0:22:55.04,EDCN,,0,0,0,,循环着循环着 机器和水
Dialogue: 0,0:22:55.04,0:22:58.72,EDCN,,0,0,0,,悄悄地凝望 滚筒式的宇宙
Dialogue: 0,0:22:59.20,0:23:04.03,EDCN,,0,0,0,,我想要述怀 Ah 到死之前
Dialogue: 0,0:23:04.03,0:23:09.12,EDCN,,0,0,0,,划一道弧线 至太阳系尽头
Dialogue: 0,0:23:09.12,0:23:11.91,EDCN,,0,0,0,,爱也是略显疲态
Dialogue: 0,0:23:11.91,0:23:14.42,EDCN,,0,0,0,,越来越远了啊
Dialogue: 0,0:23:14.42,0:23:17.19,EDCN,,0,0,0,,坐上n时发的小行星出发了
Dialogue: 0,0:23:17.19,0:23:21.19,EDCN,,0,0,0,,而你 怀着梦
Dialogue: 0,0:23:21.35,0:23:28.92,EDCN,,0,0,0,,怀着梦 怀着梦 怀着梦
Dialogue: 0,0:23:28.92,0:23:33.75,EDCN,,0,0,0,,怀着梦 怀着梦

Dialogue: 0,0:23:55.96,0:24:00.96,Screen,,0,0,0,,{\fn方正准雅宋_GBK\fscx95\fsp5\blur3\bord0.5\fs70\b1\3c&H000000&\3a&H6E&\pos(960,754.67)}那位執事 偽裝
Dialogue: 0,0:00:19.73,0:00:23.20,Default,,0,0,0,,我校受傳統與紀律保護
Dialogue: 0,0:00:23.34,0:00:25.86,Default,,0,0,0,,是一所聲名顯赫的公學
Dialogue: 0,0:00:26.99,0:00:31.40,Default,,0,0,0,,既已入學 就必須遵守校規
Dialogue: 0,0:00:32.43,0:00:34.24,Default,,0,0,0,,夏爾·凡多姆海伍
Dialogue: 0,0:00:35.24,0:00:37.10,Default,,0,0,0,,你是否願意發誓
Dialogue: 0,0:00:37.63,0:00:41.05,Default,,0,0,0,,遵守我校規定 恪守傳統與紀律
Dialogue: 0,0:00:41.38,0:00:41.99,Default,,0,0,0,,是
Dialogue: 0,0:02:41.35,0:02:43.27,Default,,0,0,0,,不好 要遲到了
Dialogue: 0,0:02:48.28,0:02:49.73,Default,,0,0,0,,等 等一下
Dialogue: 0,0:02:54.30,0:02:55.24,Default,,0,0,0,,趕上了
Dialogue: 0,0:03:03.16,0:03:04.32,Default,,0,0,0,,威士頓公學
Dialogue: 0,0:03:05.04,0:03:10.06,Default,,0,0,0,,坐落於泰晤士河畔的英國頂尖名門公學
Dialogue: 0,0:03:11.01,0:03:12.51,Default,,0,0,0,,在廣闊的校園內
Dialogue: 0,0:03:12.65,0:03:15.01,Default,,0,0,0,,建有錯綜複雜的高大教學樓
Dialogue: 0,0:03:15.34,0:03:17.15,Default,,0,0,0,,哥特式的禮拜堂
Dialogue: 0,0:03:17.51,0:03:20.10,Default,,0,0,0,,以及歷史悠久的四座學生宿舍樓
Dialogue: 0,0:03:20.65,0:03:24.85,Default,,0,0,0,,學生僅限男生 受到重視傳統的嚴苛紀律約束
Dialogue: 0,0:03:25.30,0:03:27.21,Default,,0,0,0,,過著寄宿生活
Dialogue: 0,0:03:27.48,0:03:30.16,Default,,0,0,0,,在自成一派的教學體系中接受高檔教育
Dialogue: 0,0:03:30.56,0:03:32.95,Default,,0,0,0,,成長為真正的英國紳士
Dialogue: 0,0:03:33.71,0:03:36.20,Default,,0,0,0,,即使學費堪稱天價
Dialogue: 0,0:03:36.35,0:03:41.45,Default,,0,0,0,,貴族們依然爭相將孩子送來鍍金
Dialogue: 0,0:03:44.14,0:03:46.27,Default,,0,0,0,,萬事開頭難
Dialogue: 0,0:03:46.80,0:03:48.25,Default,,0,0,0,,我得萬分謹慎才行
Dialogue: 0,0:03:50.77,0:03:51.59,Default,,0,0,0,,不是吧
Dialogue: 0,0:03:51.86,0:03:52.80,Default,,0,0,0,,快看
Dialogue: 0,0:03:53.25,0:03:54.22,Default,,0,0,0,,難以置信
Dialogue: 0,0:03:54.22,0:03:55.63,Default,,0,0,0,,他居然踩了草坪
Dialogue: 0,0:03:56.20,0:03:58.43,Default,,0,0,0,,不是P4竟敢踩草坪 不可理喻
Dialogue: 0,0:03:58.68,0:04:00.12,Default,,0,0,0,,得Y是沒跑了
Dialogue: 0,0:04:00.31,0:04:01.38,Default,,0,0,0,,唉
Dialogue: 0,0:04:01.91,0:04:02.83,Default,,0,0,0,,你們在說什…
Dialogue: 0,0:04:02.83,0:04:03.60,Default,,0,0,0,,快看
Dialogue: 0,0:04:04.13,0:04:05.31,Default,,0,0,0,,他們來了
Dialogue: 0,0:04:06.75,0:04:08.40,Default,,0,0,0,,是「Prefect 4」
Dialogue: 0,0:04:13.73,0:04:15.06,Default,,0,0,0,,他要遭殃了
Dialogue: 0,0:04:15.48,0:04:16.44,Default,,0,0,0,,活該
Dialogue: 0,0:04:17.65,0:04:18.68,Default,,0,0,0,,要被打了
Dialogue: 0,0:04:22.02,0:04:23.54,Default,,0,0,0,,你的領帶歪了
Dialogue: 0,0:04:27.45,0:04:29.14,Default,,0,0,0,,你叫什麼名字
Dialogue: 0,0:04:29.31,0:04:30.63,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:04:30.87,0:04:32.11,Default,,0,0,0,,沒聽過啊
Dialogue: 0,0:04:32.72,0:04:37.57,Default,,0,0,0,,聽校長說 今天藍館會來一名新生
Dialogue: 0,0:04:37.68,0:04:38.44,Default,,0,0,0,,就是你嗎
Dialogue: 0,0:04:38.50,0:04:39.09,Default,,0,0,0,,是的
Dialogue: 0,0:04:39.48,0:04:42.56,Default,,0,0,0,,威士頓校規第48條
Dialogue: 0,0:04:42.82,0:04:47.39,Default,,0,0,0,,「有權橫穿草坪的 僅限監督生及獲其准許者」
Dialogue: 0,0:04:42.82,0:04:47.39,zhu-2,,0,0,0,,{\pos(1072,985)}Prefect
Dialogue: 0,0:04:47.66,0:04:49.94,Default,,0,0,0,,入學前就該記住校規
Dialogue: 0,0:04:50.68,0:04:51.64,Default,,0,0,0,,非常抱歉…
Dialogue: 0,0:04:51.64,0:04:53.15,Default,,0,0,0,,快進教學樓吧
Dialogue: 0,0:04:54.17,0:04:55.98,Default,,0,0,0,,外面太曬了
Dialogue: 0,0:04:58.64,0:05:01.83,Default,,0,0,0,,下次可要注意哦 凡多姆海伍
Dialogue: 0,0:05:05.88,0:05:09.96,Default,,0,0,0,,你太幸運了 踩了草坪居然沒受罰
Dialogue: 0,0:05:10.31,0:05:10.91,Default,,0,0,0,,給
Dialogue: 0,0:05:11.39,0:05:12.74,Default,,0,0,0,,我叫馬克米蘭
Dialogue: 0,0:05:12.86,0:05:15.16,Default,,0,0,0,,和你一樣 是藍館的一年級生
Dialogue: 0,0:05:16.28,0:05:17.92,Default,,0,0,0,,嗯 謝謝你
Dialogue: 0,0:05:18.32,0:05:19.16,Default,,0,0,0,,話說回來
Dialogue: 0,0:05:19.25,0:05:23.40,Default,,0,0,0,,他們剛才說的P4和Y都是什麼啊
Dialogue: 0,0:05:23.64,0:05:25.33,Default,,0,0,0,,Y是懲罰單位
Dialogue: 0,0:05:25.55,0:05:29.04,Default,,0,0,0,,每得一個Y 就要抄寫一百遍拉丁語詩歌
Dialogue: 0,0:05:29.28,0:05:30.10,Default,,0,0,0,,P4呢
Dialogue: 0,0:05:30.46,0:05:34.31,Default,,0,0,0,,就是剛才那四個人 他們穿著不同顏色的背心吧
Dialogue: 0,0:05:34.91,0:05:39.44,Default,,0,0,0,,只有Prefect能自行選擇背心的款式
Dialogue: 0,0:05:39.52,0:05:40.74,Default,,0,0,0,,Prefect？
Dialogue: 0,0:05:40.74,0:05:43.08,Default,,0,0,0,,就是監督生 也就是宿舍長
Dialogue: 0,0:05:44.42,0:05:45.85,Default,,0,0,0,,穿紅色背心那位
Dialogue: 0,0:05:45.85,0:05:48.42,Default,,0,0,0,,是身份極其高貴的學生入住的
Dialogue: 0,0:05:48.60,0:05:50.99,Default,,0,0,0,,「深紅狐館」的監督生
Dialogue: 0,0:05:50.99,0:05:52.44,Default,,0,0,0,,艾德嘉·雷德蒙
Dialogue: 0,0:05:53.70,0:05:55.06,Default,,0,0,0,,穿藍色背心那位
Dialogue: 0,0:05:55.06,0:05:57.12,Default,,0,0,0,,是成績優秀的學生入住的
Dialogue: 0,0:05:57.25,0:05:59.34,Default,,0,0,0,,「紺碧梟館」的監督生
Dialogue: 0,0:05:59.54,0:06:01.04,Default,,0,0,0,,勞倫斯·布魯亞
Dialogue: 0,0:06:02.44,0:06:03.97,Default,,0,0,0,,穿綠色背心那位
Dialogue: 0,0:06:03.97,0:06:06.52,Default,,0,0,0,,是擅長武術和運動的學生入住的
Dialogue: 0,0:06:06.66,0:06:08.75,Default,,0,0,0,,「翡翠獅館」的監督生
Dialogue: 0,0:06:08.83,0:06:10.20,Default,,0,0,0,,赫曼·格林希爾
Dialogue: 0,0:06:11.96,0:06:13.61,Default,,0,0,0,,穿紫色背心那位
Dialogue: 0,0:06:13.61,0:06:15.75,Default,,0,0,0,,是有一技之長的學生入住的
Dialogue: 0,0:06:15.75,0:06:17.89,Default,,0,0,0,,「紫黑狼館」的監督生
Dialogue: 0,0:06:18.06,0:06:19.63,Default,,0,0,0,,格雷戈利·威爾利特
Dialogue: 0,0:06:20.69,0:06:24.46,Default,,0,0,0,,威士頓的四座傳統宿舍的四位監督生
Dialogue: 0,0:06:24.46,0:06:26.59,Default,,0,0,0,,簡稱P4
Dialogue: 0,0:06:28.65,0:06:32.13,Default,,0,0,0,,好崇拜他們啊 我以後也想成為監督生
Dialogue: 0,0:06:32.58,0:06:33.63,Default,,0,0,0,,開玩笑
Dialogue: 0,0:06:34.72,0:06:35.61,Default,,0,0,0,,但是
Dialogue: 0,0:06:35.73,0:06:39.10,Default,,0,0,0,,居然不能橫穿草坪 這規定也太低效了
Dialogue: 0,0:06:40.01,0:06:41.30,Default,,0,0,0,,畢竟這是傳統
Dialogue: 0,0:06:42.85,0:06:44.96,Default,,0,0,0,,不好 上課要遲到了
Dialogue: 0,0:06:44.96,0:06:46.97,Default,,0,0,0,,快走吧 我可不想拿Y
Dialogue: 0,0:06:49.40,0:06:53.59,Default,,0,0,0,,說起來 沒想到柯雷特學長居然突然休學了
Dialogue: 0,0:06:53.85,0:06:57.36,Default,,0,0,0,,你在這個尷尬的時間點入學 一定很不容易吧
Dialogue: 0,0:06:57.41,0:06:59.06,Default,,0,0,0,,我一直在等待空缺
Dialogue: 0,0:06:59.42,0:07:01.54,Default,,0,0,0,,做點準備並不算什麼
Dialogue: 0,0:07:01.87,0:07:03.50,Default,,0,0,0,,全體集合
Dialogue: 0,0:07:04.19,0:07:08.70,Default,,0,0,0,,最後一個集合的人會被學長差遣做事
Dialogue: 0,0:07:08.70,0:07:09.45,Default,,0,0,0,,什麼？
Dialogue: 0,0:07:12.22,0:07:14.45,Default,,0,0,0,,最後一個是…新生啊
Dialogue: 0,0:07:14.55,0:07:15.39,Default,,0,0,0,,是的
Dialogue: 0,0:07:16.12,0:07:20.20,Default,,0,0,0,,那麼 你去給監督生擦鞋 結束後就回宿舍
Dialogue: 0,0:07:20.51,0:07:22.50,Default,,0,0,0,,我們給你開歡迎會
Dialogue: 0,0:07:28.88,0:07:31.74,Default,,0,0,0,,歡迎入住 凡多姆海伍
Dialogue: 0,0:07:35.83,0:07:38.06,Default,,0,0,0,,你就好好享受吧
Dialogue: 0,0:07:38.60,0:07:39.96,Default,,0,0,0,,拋
Dialogue: 0,0:07:43.41,0:07:46.74,Default,,0,0,0,,我們宿舍傳統的歡迎會如何呀
Dialogue: 0,0:07:46.84,0:07:49.39,Default,,0,0,0,,今後你就是紺碧梟館的一員了
Dialogue: 0,0:07:49.39,0:07:52.20,Default,,0,0,0,,請更加發奮學習
Dialogue: 0,0:07:52.49,0:07:54.56,Default,,0,0,0,,接下來再拋高一點
Dialogue: 0,0:07:53.69,0:07:54.45,Default,,0,0,0,,{\pos(1578.67,1060)}不要…
Dialogue: 0,0:07:54.56,0:07:57.35,Default,,0,0,0,,你們在鬧什麼 我要給你們Y了
Dialogue: 0,0:07:57.35,0:07:58.60,Default,,0,0,0,,不好 舍監來了
Dialogue: 0,0:07:59.34,0:08:00.56,Default,,0,0,0,,克雷頓
Dialogue: 0,0:08:00.56,0:08:03.34,Default,,0,0,0,,你身為高年級生 為什麼也跟著一起鬧
Dialogue: 0,0:08:03.71,0:08:06.66,Default,,0,0,0,,這是我們宿舍的傳統…
Dialogue: 0,0:08:08.71,0:08:12.16,Default,,0,0,0,,真是的 遵守傳統也要注意分寸
Dialogue: 0,0:08:13.20,0:08:15.97,Default,,0,0,0,,你就是新入學的凡多姆海伍吧
Dialogue: 0,0:08:17.20,0:08:20.15,Default,,0,0,0,,歡迎來到紺碧梟館
Dialogue: 0,0:08:22.76,0:08:25.04,Default,,0,0,0,,我是舍監 米卡艾利斯
Dialogue: 0,0:08:32.49,0:08:35.39,Default,,0,0,0,,您好 米卡艾利斯老師
Dialogue: 0,0:08:35.72,0:08:37.93,Default,,0,0,0,,剛入學就遇到這種事 真是為難你了
Dialogue: 0,0:08:37.93,0:08:39.25,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:08:39.61,0:08:41.01,Default,,0,0,0,,沒受傷吧
Dialogue: 0,0:08:41.60,0:08:43.75,Default,,0,0,0,,謝謝老師關心
Dialogue: 0,0:08:44.06,0:08:48.22,Default,,0,0,0,,要是您再早些來制止就更好了
Dialogue: 0,0:08:48.74,0:08:50.65,Default,,0,0,0,,這也算是一項儀式
Dialogue: 0,0:08:50.79,0:08:54.12,Default,,0,0,0,,若是嚴令禁止 未免有些不近人情
Dialogue: 0,0:08:55.04,0:08:58.38,Default,,0,0,0,,畢竟我只是一介舍監
Dialogue: 0,0:08:55.04,0:08:58.38,zhu-2,,0,0,0,,{\pos(1060,982.67)}惡魔
Dialogue: 0,0:09:00.90,0:09:02.56,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:09:02.92,0:09:06.26,Default,,0,0,0,,我奉命帶話 請你去一趟校長室
Dialogue: 0,0:09:22.45,0:09:24.36,Default,,0,0,0,,入學第一天已近尾聲
Dialogue: 0,0:09:24.72,0:09:27.23,Default,,0,0,0,,感覺如何啊 凡多姆海伍
Dialogue: 0,0:09:27.75,0:09:31.49,Default,,0,0,0,,要是無法融入藍館 就來紅館吧
Dialogue: 0,0:09:32.04,0:09:35.02,Default,,0,0,0,,以你這樣高貴的身份 我們隨時歡迎你
Dialogue: 0,0:09:35.55,0:09:39.75,Default,,0,0,0,,有權為學生分配宿舍的 只有校長一人
Dialogue: 0,0:09:39.88,0:09:41.54,Default,,0,0,0,,不得有例外
Dialogue: 0,0:09:42.38,0:09:44.66,Default,,0,0,0,,我是覺得哪個宿舍都一樣
Dialogue: 0,0:09:45.14,0:09:48.11,Default,,0,0,0,,我校受傳統與紀律保護
Dialogue: 0,0:09:48.24,0:09:50.60,Default,,0,0,0,,是一所聲名顯赫的公學
Dialogue: 0,0:09:50.96,0:09:55.46,Default,,0,0,0,,既已入學 就必須遵守校規
Dialogue: 0,0:09:57.37,0:10:00.90,Default,,0,0,0,,原本應當由校長在此訓話
Dialogue: 0,0:10:01.18,0:10:03.61,Default,,0,0,0,,但校長事務繁忙 就由我代行
Dialogue: 0,0:10:05.02,0:10:08.46,Default,,0,0,0,,我是副校長 約翰·阿格雷斯
Dialogue: 0,0:10:09.20,0:10:12.45,Default,,0,0,0,,一切校內事務均由校長決定
Dialogue: 0,0:10:12.67,0:10:16.22,Default,,0,0,0,,校長對校內事務之定奪不可撼動
Dialogue: 0,0:10:16.44,0:10:20.78,Default,,0,0,0,,校長任命我等監督生 在校內行使自治
Dialogue: 0,0:10:21.43,0:10:24.54,Default,,0,0,0,,麻煩事都丟給我們處理 真是個苦差事
Dialogue: 0,0:10:25.76,0:10:28.94,Default,,0,0,0,,這是我校創立時便定下的傳統
Dialogue: 0,0:10:29.68,0:10:30.66,Default,,0,0,0,,而且
Dialogue: 0,0:10:31.60,0:10:33.11,Default,,0,0,0,,傳統不容置喙
Dialogue: 0,0:10:35.81,0:10:37.52,Default,,0,0,0,,夏爾·凡多姆海伍
Dialogue: 0,0:10:38.03,0:10:39.98,Default,,0,0,0,,你是否願意發誓
Dialogue: 0,0:10:40.20,0:10:43.43,Default,,0,0,0,,遵守我校規定 恪守傳統與紀律
Dialogue: 0,0:10:44.71,0:10:45.29,Default,,0,0,0,,是
Dialogue: 0,0:10:46.81,0:10:48.92,Default,,0,0,0,,那麼 請在此處簽名
Dialogue: 0,0:10:51.50,0:10:52.88,Default,,0,0,0,,阿格雷斯老師
Dialogue: 0,0:10:52.88,0:10:54.52,Default,,0,0,0,,對不起 對不起 對不起
Dialogue: 0,0:10:54.65,0:10:56.26,Default,,0,0,0,,對不起 對不起 對不起
Dialogue: 0,0:10:58.44,0:10:59.76,Default,,0,0,0,,請在此處簽名
Dialogue: 0,0:11:01.83,0:11:04.59,Default,,0,0,0,,感謝加入威士頓公學 凡多姆海伍
Dialogue: 0,0:11:05.77,0:11:07.52,Default,,0,0,0,,歡迎你的到來
Dialogue: 0,0:11:16.48,0:11:19.01,Default,,0,0,0,,祝你在校內過得愉快
Dialogue: 0,0:11:20.48,0:11:24.98,Default,,0,0,0,,請問 我什麼時候能去問候校長呢
Dialogue: 0,0:11:26.05,0:11:30.04,Default,,0,0,0,,校長事務繁忙 不接受普通學生面見
Dialogue: 0,0:11:30.54,0:11:32.55,Default,,0,0,0,,能面見校長的
Dialogue: 0,0:11:33.83,0:11:35.92,Default,,0,0,0,,只有我們監督生
Dialogue: 0,0:11:42.23,0:11:44.99,Default,,0,0,0,,普通學生見不到校長？
Dialogue: 0,0:11:46.14,0:11:50.94,Default,,0,0,0,,看來 校長就是這所學校的絕對君主啊
Dialogue: 0,0:11:54.86,0:11:59.24,Default,,0,0,0,,威士頓的學生大多為13到18歲
Dialogue: 0,0:11:59.45,0:12:03.41,Default,,0,0,0,,他們在宿舍過著集體生活 專注於學習
Dialogue: 0,0:12:04.23,0:12:08.29,Default,,0,0,0,,學生的生活起居 均由鐘聲管理
Dialogue: 0,0:12:29.64,0:12:30.81,Default,,0,0,0,,直屬學弟？
Dialogue: 0,0:12:31.33,0:12:35.53,Default,,0,0,0,,嗯 就是宿舍裡的徒弟或小弟
Dialogue: 0,0:12:36.07,0:12:38.84,Default,,0,0,0,,早餐結束後 就是直屬學弟的工作時間
Dialogue: 0,0:12:39.25,0:12:41.07,Default,,0,0,0,,這是威士頓特有的傳統
Dialogue: 0,0:12:41.07,0:12:44.71,Default,,0,0,0,,每位學生都會照顧特定的一位學長
Dialogue: 0,0:12:45.10,0:12:45.99,Default,,0,0,0,,怎麼照顧啊
Dialogue: 0,0:12:46.30,0:12:47.70,Default,,0,0,0,,為他打掃房間
Dialogue: 0,0:12:47.94,0:12:49.54,Default,,0,0,0,,熨燙校服
Dialogue: 0,0:12:49.83,0:12:52.13,Default,,0,0,0,,晚上為他準備暖壺之類的
Dialogue: 0,0:12:52.75,0:12:54.98,Default,,0,0,0,,就是在模仿執事啊
Dialogue: 0,0:12:55.43,0:12:57.33,Default,,0,0,0,,又是一個麻煩的傳統
Dialogue: 0,0:12:59.45,0:13:01.70,Default,,0,0,0,,監督生也有直屬學弟嗎
Dialogue: 0,0:13:01.84,0:13:02.95,Default,,0,0,0,,當然有
Dialogue: 0,0:13:02.95,0:13:06.19,Default,,0,0,0,,藍館監督生布魯亞學長的直屬學弟
Dialogue: 0,0:13:06.19,0:13:07.56,Default,,0,0,0,,是克雷頓學長
Dialogue: 0,0:13:07.82,0:13:08.85,Default,,0,0,0,,克雷頓…
Dialogue: 0,0:13:09.70,0:13:10.74,Default,,0,0,0,,就是他啊
Dialogue: 0,0:13:11.72,0:13:16.33,Default,,0,0,0,,和執事不同 學長也會關照直屬學弟
Dialogue: 0,0:13:16.50,0:13:20.49,Default,,0,0,0,,最貼切的說法應該是 僅限校內的兄弟關係
Dialogue: 0,0:13:21.09,0:13:22.38,Default,,0,0,0,,兄弟啊
Dialogue: 0,0:13:22.47,0:13:26.51,Default,,0,0,0,,還有啊 監督生的直屬學弟有些特殊
Dialogue: 0,0:13:26.61,0:13:29.07,Default,,0,0,0,,他們能和P4一樣把舍花插在胸前
Dialogue: 0,0:13:29.07,0:13:31.46,Default,,0,0,0,,獲得許可後還能橫穿草坪
Dialogue: 0,0:13:31.82,0:13:37.03,Default,,0,0,0,,據說還能和P4一起參加校長主辦的「深夜茶會」呢
Dialogue: 0,0:13:37.93,0:13:39.57,Default,,0,0,0,,深夜茶會…
Dialogue: 0,0:13:39.79,0:13:42.72,Default,,0,0,0,,參加這個就能和校長接觸
Dialogue: 0,0:13:43.05,0:13:47.06,Default,,0,0,0,,不過只有P4及其直屬學弟才能參加
Dialogue: 0,0:13:47.06,0:13:48.43,Default,,0,0,0,,有點難辦啊
Dialogue: 0,0:13:48.96,0:13:51.51,Default,,0,0,0,,我以後也好想參加啊
Dialogue: 0,0:13:51.51,0:13:52.49,Default,,0,0,0,,開玩笑
Dialogue: 0,0:13:53.89,0:13:54.86,Default,,0,0,0,,沒辦法
Dialogue: 0,0:13:55.22,0:14:00.09,Default,,0,0,0,,先直接打探一下不回家的學生的事吧
Dialogue: 0,0:14:00.96,0:14:03.03,Default,,0,0,0,,抱歉 我換個話題
Dialogue: 0,0:14:03.63,0:14:06.70,Default,,0,0,0,,你認識克萊門斯公爵的兒子 德利克·亞登嗎
Dialogue: 0,0:14:07.04,0:14:10.65,Default,,0,0,0,,他好像是紫黑狼館的學生
Dialogue: 0,0:14:15.28,0:14:16.05,Default,,0,0,0,,怎麼了
Dialogue: 0,0:14:16.36,0:14:17.59,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:14:18.04,0:14:21.43,Default,,0,0,0,,和其他宿舍的學生關係太好 會被排擠的
Dialogue: 0,0:14:21.43,0:14:24.85,Default,,0,0,0,,啊？怎麼跟女生拉小圈子一樣
Dialogue: 0,0:14:25.06,0:14:28.30,Default,,0,0,0,,畢竟經常要和其他宿舍競爭
Dialogue: 0,0:14:29.18,0:14:29.88,Default,,0,0,0,,不過
Dialogue: 0,0:14:30.09,0:14:35.59,Default,,0,0,0,,那個人好像是特別獲准從紅館轉到了紫館
Dialogue: 0,0:14:36.23,0:14:36.98,Default,,0,0,0,,轉過去的？
Dialogue: 0,0:14:37.45,0:14:41.46,Default,,0,0,0,,具體的我不清楚 但聽說是校長的命令
Dialogue: 0,0:14:41.70,0:14:42.82,Default,,0,0,0,,校長的命令？
Dialogue: 0,0:14:43.08,0:14:47.28,Default,,0,0,0,,總 總之 最好別去管其他宿舍的事
Dialogue: 0,0:14:47.59,0:14:49.76,Default,,0,0,0,,尤其是紫黑狼館
Dialogue: 0,0:14:50.69,0:14:51.82,Default,,0,0,0,,這是為什麼…
Dialogue: 0,0:14:51.82,0:14:53.67,Default,,0,0,0,,馬克米蘭 直屬學弟的時間到了
Dialogue: 0,0:14:53.67,0:14:54.33,Default,,0,0,0,,來了
Dialogue: 0,0:14:54.58,0:14:55.79,Default,,0,0,0,,我的直屬學長來了
Dialogue: 0,0:14:56.41,0:14:58.39,Default,,0,0,0,,回頭見啦 凡多姆海伍
Dialogue: 0,0:15:01.36,0:15:03.32,Default,,0,0,0,,那是什麼姿勢啊
Dialogue: 0,0:15:05.15,0:15:09.07,Default,,0,0,0,,話說回來 德利克居然轉過宿舍？
Dialogue: 0,0:15:09.50,0:15:11.57,Default,,0,0,0,,這中間肯定有內情
Dialogue: 0,0:15:11.57,0:15:12.77,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:15:13.40,0:15:14.63,Default,,0,0,0,,克雷頓學長
Dialogue: 0,0:15:15.11,0:15:18.65,Default,,0,0,0,,在你的直屬學長確定之前 你負責打掃餐廳
Dialogue: 0,0:15:19.93,0:15:21.24,Default,,0,0,0,,餐廳？
Dialogue: 0,0:15:22.50,0:15:25.06,Default,,0,0,0,,這裡全都要我打掃嗎
Dialogue: 0,0:15:25.16,0:15:26.15,Default,,0,0,0,,沒錯
Dialogue: 0,0:15:26.37,0:15:27.61,Default,,0,0,0,,不許偷懶
Dialogue: 0,0:15:33.96,0:15:35.04,Default,,0,0,0,,塞巴斯蒂安
Dialogue: 0,0:15:41.13,0:15:42.03,Default,,0,0,0,,我在
Dialogue: 0,0:15:45.26,0:15:47.55,Default,,0,0,0,,聽說德利克轉過宿舍
Dialogue: 0,0:15:47.75,0:15:52.56,Default,,0,0,0,,按照名冊中的信息 他確實屬於紫黑狼館
Dialogue: 0,0:15:52.56,0:15:54.22,Default,,0,0,0,,他現在應該在宿舍裡
Dialogue: 0,0:15:54.33,0:15:57.44,Default,,0,0,0,,我去看看 你把這裡打掃乾淨
Dialogue: 0,0:15:57.57,0:15:58.78,Default,,0,0,0,,遵命
Dialogue: 0,0:16:00.25,0:16:01.39,Default,,0,0,0,,好了
Dialogue: 0,0:16:02.93,0:16:04.20,Default,,0,0,0,,開始工作吧
Dialogue: 0,0:16:13.73,0:16:15.83,Default,,0,0,0,,外觀真是不得了
Dialogue: 0,0:16:16.81,0:16:19.50,Default,,0,0,0,,不愧是怪人宿舍
Dialogue: 0,0:16:27.00,0:16:28.38,Default,,0,0,0,,是外人
Dialogue: 0,0:16:28.52,0:16:29.66,Default,,0,0,0,,外人…
Dialogue: 0,0:16:29.89,0:16:31.35,Default,,0,0,0,,那徽章是藍館的…
Dialogue: 0,0:16:31.35,0:16:33.06,Default,,0,0,0,,什 什麼時候來的
Dialogue: 0,0:16:33.06,0:16:34.40,Default,,0,0,0,,喂喂
Dialogue: 0,0:16:34.40,0:16:38.10,Default,,0,0,0,,書呆子宿舍的人來紫館幹什麼
Dialogue: 0,0:16:38.42,0:16:42.56,Default,,0,0,0,,只會念書的傢伙可沒資格來這裡
Dialogue: 0,0:16:42.68,0:16:43.51,Default,,0,0,0,,滾出去
Dialogue: 0,0:16:43.51,0:16:45.33,Default,,0,0,0,,對 滾出去
Dialogue: 0,0:16:45.56,0:16:47.53,Default,,0,0,0,,其他宿舍的滾出去
Dialogue: 0,0:16:47.53,0:16:48.54,Default,,0,0,0,,滾出去
Dialogue: 0,0:16:48.54,0:16:49.20,Default,,0,0,0,,痛
Dialogue: 0,0:16:49.65,0:16:51.61,Default,,0,0,0,,滾出紫館
Dialogue: 0,0:16:52.53,0:16:57.20,Default,,0,0,0,,下次勸你帶本厚字典來保護腦袋 書呆子
Dialogue: 0,0:16:58.00,0:16:59.60,Default,,0,0,0,,怎麼回事啊
Dialogue: 0,0:17:00.24,0:17:01.52,Default,,0,0,0,,在鬧什麼
Dialogue: 0,0:17:03.33,0:17:05.03,Default,,0,0,0,,威爾利特學長
Dialogue: 0,0:17:05.20,0:17:07.44,Default,,0,0,0,,來了個書呆子宿舍的人
Dialogue: 0,0:17:11.53,0:17:12.64,Default,,0,0,0,,那個新生？
Dialogue: 0,0:17:18.51,0:17:20.32,Default,,0,0,0,,真是糟透了
Dialogue: 0,0:17:21.47,0:17:26.10,Default,,0,0,0,,不同宿舍間的敵對心 比預想的還要強啊
Dialogue: 0,0:17:26.95,0:17:30.86,Default,,0,0,0,,別說校長了 就連德利克都很難見到
Dialogue: 0,0:17:31.80,0:17:34.77,Default,,0,0,0,,這所學校裡 爵位和金錢都沒用
Dialogue: 0,0:17:35.51,0:17:39.50,Default,,0,0,0,,身為普通學生 就連收集情報都很困難
Dialogue: 0,0:17:40.17,0:17:44.31,Default,,0,0,0,,這麼一來 接近事件核心的方法就只有一個
Dialogue: 0,0:17:45.52,0:17:48.58,Default,,0,0,0,,必須拉攏P4
Dialogue: 0,0:17:50.00,0:17:51.88,Default,,0,0,0,,但是 要怎麼做
Dialogue: 0,0:17:53.16,0:17:54.40,Default,,0,0,0,,好厲害
Dialogue: 0,0:17:54.40,0:17:55.80,Default,,0,0,0,,就憑一個人…
Dialogue: 0,0:17:55.94,0:17:56.61,Default,,0,0,0,,真的假的
Dialogue: 0,0:17:56.61,0:17:57.90,Default,,0,0,0,,怎麼做到的
Dialogue: 0,0:18:01.47,0:18:02.51,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:18:02.51,0:18:03.23,Default,,0,0,0,,在
Dialogue: 0,0:18:03.56,0:18:05.53,Default,,0,0,0,,不好 偷懶被發現了？
Dialogue: 0,0:18:05.70,0:18:08.41,Default,,0,0,0,,我這人不會輕易誇獎他人
Dialogue: 0,0:18:08.76,0:18:09.62,Default,,0,0,0,,但是
Dialogue: 0,0:18:10.21,0:18:12.82,Default,,0,0,0,,今天我要誇獎你
Dialogue: 0,0:18:17.87,0:18:22.54,Default,,0,0,0,,我們那老土…不 歷史悠久的餐廳竟煥然一新
Dialogue: 0,0:18:22.81,0:18:24.63,Default,,0,0,0,,你真能幹 凡多姆海伍
Dialogue: 0,0:18:24.63,0:18:26.58,Default,,0,0,0,,過獎了
Dialogue: 0,0:18:26.58,0:18:28.92,Default,,0,0,0,,那傢伙做過頭了
Dialogue: 0,0:18:29.81,0:18:31.09,Default,,0,0,0,,米卡艾利斯老師
Dialogue: 0,0:18:31.53,0:18:32.63,Default,,0,0,0,,怎麼了
Dialogue: 0,0:18:33.08,0:18:35.17,Default,,0,0,0,,您看這餐廳
Dialogue: 0,0:18:35.29,0:18:37.26,Default,,0,0,0,,是凡多姆海伍打理的
Dialogue: 0,0:18:37.26,0:18:38.85,Default,,0,0,0,,可這真是了不得
Dialogue: 0,0:18:39.29,0:18:42.05,Default,,0,0,0,,辛苦你了 凡多姆海伍
Dialogue: 0,0:18:42.63,0:18:44.52,Default,,0,0,0,,就知道多此一舉…
Dialogue: 0,0:18:45.16,0:18:46.49,Default,,0,0,0,,不辛苦
Dialogue: 0,0:18:46.89,0:18:48.02,Default,,0,0,0,,等等
Dialogue: 0,0:18:49.25,0:18:51.86,Default,,0,0,0,,他好像是布魯亞的直屬學弟
Dialogue: 0,0:18:52.40,0:18:54.30,Default,,0,0,0,,說不定能利用一下
Dialogue: 0,0:18:49.22,0:18:53.16,zhu,,0,0,0,,他還沒有直屬學長 我就隨便給他分配了個工作
Dialogue: 0,0:18:53.16,0:18:55.24,zhu,,0,0,0,,沒想到竟能在短時間內做得如此完美
Dialogue: 0,0:18:55.62,0:18:58.20,Default,,0,0,0,,要接近P4 首先就要…
Dialogue: 0,0:18:59.08,0:19:00.44,Default,,0,0,0,,從他入手
Dialogue: 0,0:19:01.27,0:19:03.40,Default,,0,0,0,,很高興學長能滿意
Dialogue: 0,0:19:03.73,0:19:07.17,Default,,0,0,0,,不瞞你說 我其實非常擅長做家務
Dialogue: 0,0:19:08.63,0:19:13.83,Default,,0,0,0,,有事請儘管吩咐我哦 克雷頓學長
Dialogue: 0,0:19:23.54,0:19:25.34,Default,,0,0,0,,親愛的小弟弟
Dialogue: 0,0:19:25.79,0:19:28.84,Default,,0,0,0,,坎帕尼亞號的事 真是讓你受苦了
Dialogue: 0,0:19:29.81,0:19:33.99,Default,,0,0,0,,希望你的身體已經痊癒 正在享受復活節了
Dialogue: 0,0:19:35.59,0:19:37.05,Default,,0,0,0,,而我呢
Dialogue: 0,0:19:37.05,0:19:39.63,Default,,0,0,0,,難得迎來復活節假期
Dialogue: 0,0:19:39.72,0:19:43.78,Default,,0,0,0,,我卻因一件憂心之事 而無法由衷慶祝節日
Dialogue: 0,0:19:44.78,0:19:46.73,Default,,0,0,0,,這件憂心之事
Dialogue: 0,0:19:47.03,0:19:52.10,Default,,0,0,0,,就是我堂兄弟克萊門斯公爵的兒子 德利克
Dialogue: 0,0:19:52.88,0:19:56.13,Default,,0,0,0,,德利克是威士頓公學的五年級學生
Dialogue: 0,0:19:56.31,0:20:00.45,Default,,0,0,0,,但不知為何 他自去年暑假起就一直沒有回家
Dialogue: 0,0:20:01.00,0:20:03.62,Default,,0,0,0,,從前他每天都給家裡寫信
Dialogue: 0,0:20:03.73,0:20:05.18,Default,,0,0,0,,現在信件也中斷了
Dialogue: 0,0:20:09.11,0:20:13.52,Default,,0,0,0,,他母親擔心地去宿舍找他 他卻拒絕回家
Dialogue: 0,0:20:14.49,0:20:18.48,Default,,0,0,0,,若只有他一人如此 那或許只是單純進入叛逆期了
Dialogue: 0,0:20:18.68,0:20:23.89,Default,,0,0,0,,但似乎還有好幾名學生 也和他一樣沒有回家
Dialogue: 0,0:20:24.83,0:20:27.87,Default,,0,0,0,,他們究竟是怎麼了呢
Dialogue: 0,0:20:31.10,0:20:36.74,Default,,0,0,0,,獨生子成了這樣 克萊門斯公爵終日無精打采
Dialogue: 0,0:20:37.43,0:20:39.08,Default,,0,0,0,,我十分擔心他
Dialogue: 0,0:20:40.97,0:20:45.21,Default,,0,0,0,,衷心希望我珍視的人們
Dialogue: 0,0:20:45.47,0:20:49.52,Default,,0,0,0,,能早日安穩地度過復活節
Dialogue: 0,0:20:50.83,0:20:51.84,Default,,0,0,0,,維多利亞
Dialogue: 0,0:20:54.00,0:20:54.85,Default,,0,0,0,,也就是說
Dialogue: 0,0:20:55.42,0:21:01.16,Default,,0,0,0,,她是命令您調查威士頓的學生不回家的原因吧
Dialogue: 0,0:21:01.71,0:21:07.03,Default,,0,0,0,,公學不接受任何政府干涉 是獨立機構
Dialogue: 0,0:21:07.03,0:21:08.12,Default,,0,0,0,,所以她不好出手
Dialogue: 0,0:21:08.94,0:21:09.92,Default,,0,0,0,,更重要的是
Dialogue: 0,0:21:10.32,0:21:14.01,Default,,0,0,0,,她應該是不想把事情鬧大 讓家事被外界知曉
Dialogue: 0,0:21:14.48,0:21:16.84,Default,,0,0,0,,都這時候了還顧及面子
Dialogue: 0,0:21:17.36,0:21:20.22,Default,,0,0,0,,唉 所以我受不了人類
Dialogue: 0,0:21:20.59,0:21:23.08,Default,,0,0,0,,我想派個人去學校裡臥底
Dialogue: 0,0:21:23.08,0:21:26.79,Default,,0,0,0,,但只有貴族子弟才能進入威士頓
Dialogue: 0,0:21:27.19,0:21:31.32,Default,,0,0,0,,有爵位的人本就少 而且互相之間基本都認識
Dialogue: 0,0:21:31.77,0:21:34.06,Default,,0,0,0,,臥底的話 喬裝會很危險
Dialogue: 0,0:21:35.16,0:21:36.64,Default,,0,0,0,,那您親自去辦？
Dialogue: 0,0:21:39.18,0:21:40.37,Default,,0,0,0,,這也沒辦法
Dialogue: 0,0:21:40.72,0:21:43.41,Default,,0,0,0,,賣女王一個人情也不是壞事
Dialogue: 0,0:21:43.91,0:21:47.49,Default,,0,0,0,,問題是威士頓有沒有空缺
Dialogue: 0,0:21:47.94,0:21:49.01,Default,,0,0,0,,很簡單
Dialogue: 0,0:21:49.21,0:21:51.64,Default,,0,0,0,,若是沒有空缺 製造一個便是
Dialogue: 0,0:21:55.26,0:21:58.00,Default,,0,0,0,,在校內的調查就由我來
Dialogue: 0,0:21:58.64,0:22:01.90,Default,,0,0,0,,你在暗中協助我
Dialogue: 0,0:22:02.65,0:22:04.10,Default,,0,0,0,,方法隨便你
Dialogue: 0,0:22:20.80,0:22:22.87,Default,,0,0,0,,Yes my lord
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

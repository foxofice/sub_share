Dialogue: 0,0:00:01.54,0:00:04.21,Default,,0,0,0,,雄英是孕育了許多英雄的名門高校
Dialogue: 0,0:00:04.29,0:00:06.79,Default,,0,0,0,,進入雄英英雄科就讀的我
Dialogue: 0,0:00:07.34,0:00:09.51,Default,,0,0,0,,正朝著夢想努力邁進
Dialogue: 1,0:00:09.67,0:00:13.51,Default2,,0,0,0,,這一切都是為了成為
Dialogue: 0,0:00:09.67,0:00:13.51,Default,,0,0,0,,勇於面對任何困難
Dialogue: 1,0:00:14.01,0:00:17.39,Default2,,0,0,0,,並帶著笑容拯救人們的
Dialogue: 0,0:00:14.01,0:00:17.39,Default,,0,0,0,,最棒的英雄
Dialogue: 0,0:01:51.27,0:01:52.77,Default,,0,0,0,,爆碎風
Dialogue: 0,0:01:52.86,0:01:54.11,Default,,0,0,0,,反擊的時刻來臨了
Dialogue: 0,0:01:54.19,0:01:56.23,Default,,0,0,0,,扭轉頹勢吧，英雄們
Dialogue: 0,0:01:56.32,0:01:57.57,Default,,0,0,0,,什麼？
Dialogue: 0,0:01:59.41,0:02:01.62,Default,,0,0,0,,那傢伙到底在哪裡？
Dialogue: 0,0:02:01.95,0:02:03.12,Default,,0,0,0,,死柄木
Dialogue: 0,0:02:03.20,0:02:04.66,Default,,0,0,0,,我真的…
Dialogue: 0,0:02:04.75,0:02:06.71,Default,,0,0,0,,很討厭你
Dialogue: 0,0:02:09.08,0:02:11.21,Default,,0,0,0,,腦無，竟然憑空出現了
Dialogue: 0,0:02:11.46,0:02:13.00,Default,,0,0,0,,那液體是什麼？
Dialogue: 0,0:02:13.21,0:02:15.21,Default,,0,0,0,,黑色液體越來越多了
Dialogue: 0,0:02:15.84,0:02:17.43,Default,,0,0,0,,這什麼？
Dialogue: 0,0:02:18.47,0:02:19.93,Default,,0,0,0,,爆豪少年
Dialogue: 0,0:02:21.85,0:02:23.94,Default,,0,0,0,,不
Dialogue: 0,0:02:24.02,0:02:25.48,Default,,0,0,0,,安德瓦，我們需要支援
Dialogue: 0,0:02:26.18,0:02:27.35,Default,,0,0,0,,什麼？
Dialogue: 0,0:02:31.73,0:02:33.52,Default,,0,0,0,,俊典，看來這是…
Dialogue: 0,0:02:33.61,0:02:36.03,Default,,0,0,0,,他應該沒有空間傳送能力才對
Dialogue: 0,0:02:36.11,0:02:37.65,Default,,0,0,0,,反應速度也太快了
Dialogue: 0,0:02:37.74,0:02:40.24,Default,,0,0,0,,這情況該不會是…
Dialogue: 0,0:02:41.03,0:02:42.82,Default,,0,0,0,,已經沒事了
Dialogue: 0,0:02:43.74,0:02:45.28,Default,,0,0,0,,我會在你身邊
Dialogue: 0,0:02:45.83,0:02:48.04,Default,,0,0,0,,老師
Dialogue: 0,0:02:50.71,0:02:53.55,Default,,0,0,0,,糟糕，所有人都會被帶走的
Dialogue: 0,0:02:53.63,0:02:55.47,Default,,0,0,0,,可惡啊
Dialogue: 0,0:02:55.55,0:02:57.84,Default,,0,0,0,,要帶就把我也一起帶走
Dialogue: 0,0:02:57.92,0:02:59.92,Default,,0,0,0,,死柄木
Dialogue: 0,0:03:06.64,0:03:08.48,Default,,0,0,0,,各位，非常抱歉
Dialogue: 0,0:03:08.56,0:03:10.44,Default,,0,0,0,,這不是你的疏失
Dialogue: 0,0:03:10.52,0:03:12.77,Default,,0,0,0,,就算我們想干預也沒辦法
Dialogue: 1,0:03:13.52,0:03:16.48,Default2,,0,0,0,,看來那不是黑霧那種
Dialogue: 0,0:03:13.52,0:03:16.48,Default,,0,0,0,,在空間開路的類型
Dialogue: 0,0:03:16.57,0:03:18.82,Default,,0,0,0,,是只傳送目標對象的能力
Dialogue: 0,0:03:20.70,0:03:21.91,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:03:21.99,0:03:23.37,Default,,0,0,0,,奧克拉荷馬
Dialogue: 0,0:03:23.45,0:03:25.99,Default,,0,0,0,,爆碎風
Dialogue: 0,0:03:28.91,0:03:30.83,Default,,0,0,0,,他破壞的方式還真豪邁
Dialogue: 0,0:03:30.92,0:03:32.38,Default,,0,0,0,,畢竟情況特殊
Dialogue: 0,0:03:32.46,0:03:34.25,Default,,0,0,0,,專心對付惡人
Dialogue: 0,0:03:36.63,0:03:38.22,Default,,0,0,0,,可惡的怪物
Dialogue: 0,0:03:39.67,0:03:41.38,Default,,0,0,0,,這些傢伙
Dialogue: 0,0:03:41.47,0:03:43.51,Default,,0,0,0,,是從工廠那邊跑來的嗎？
Dialogue: 0,0:03:43.60,0:03:45.85,Default,,0,0,0,,聯絡不上牛仔褲時尚名人獎
Dialogue: 0,0:03:45.93,0:03:48.27,Default,,0,0,0,,腦無工廠那邊可能行動失敗了
Dialogue: 0,0:03:48.35,0:03:50.23,Default,,0,0,0,,拖拖拉拉煩死人了
Dialogue: 0,0:03:50.31,0:03:51.52,Default,,0,0,0,,安德瓦
Dialogue: 0,0:03:55.40,0:03:56.61,Default,,0,0,0,,你沒事吧？
Dialogue: 0,0:03:56.69,0:03:58.90,Default,,0,0,0,,你是怎麼看的才會問我這種問題？
Dialogue: 0,0:03:58.99,0:04:01.83,Default,,0,0,0,,第一名英雄也開始有老花眼了嗎？
Dialogue: 0,0:04:02.32,0:04:04.74,Default,,0,0,0,,想去那邊就快點過去啊
Dialogue: 0,0:04:06.83,0:04:08.46,Default,,0,0,0,,這裡麻煩你了
Comment: 1,0:04:17.38,0:04:19.09,Default2,,0,0,0,,（職業英雄，山峰淑女
Comment: 0,0:04:17.38,0:04:19.09,Default,,0,0,0,,個性，巨大化）
Comment: 0,0:04:19.34,0:04:21.05,Default,,0,0,0,,（職業英雄，暴力虎鯨）
Comment: 1,0:04:21.22,0:04:23.10,Default2,,0,0,0,,（職業英雄，老虎
Comment: 0,0:04:21.22,0:04:23.10,Default,,0,0,0,,個性，柔軟）
Dialogue: 0,0:04:28.60,0:04:30.35,Default,,0,0,0,,不愧是第四名英雄
Dialogue: 0,0:04:30.43,0:04:32.22,Default,,0,0,0,,最佳牛仔褲時尚名人獎
Dialogue: 0,0:04:32.64,0:04:36.31,Default,,0,0,0,,我本來以為所有人都被我解決了呢
Dialogue: 0,0:04:38.23,0:04:39.90,Default,,0,0,0,,你操控所有人的衣服
Dialogue: 0,0:04:39.99,0:04:41.70,Default,,0,0,0,,一瞬間把他們拉到旁邊
Dialogue: 0,0:04:41.78,0:04:43.28,Default,,0,0,0,,這樣的判斷力
Dialogue: 0,0:04:43.36,0:04:44.61,Default,,0,0,0,,以及技術
Dialogue: 0,0:04:45.07,0:04:47.03,Default,,0,0,0,,你的反射神經真好
Dialogue: 0,0:04:49.54,0:04:50.83,Default,,0,0,0,,這傢伙…
Dialogue: 0,0:04:50.91,0:04:52.45,Default,,0,0,0,,惡人聯軍恐怕
Dialogue: 0,0:04:52.54,0:04:53.42,Default,,0,0,0,,不
Dialogue: 0,0:04:53.50,0:04:55.38,Default,,0,0,0,,我敢肯定他們有智囊在
Dialogue: 1,0:04:55.46,0:04:58.09,Default2,,0,0,0,,而且那傢伙的實力
Dialogue: 0,0:04:55.46,0:04:58.09,Default,,0,0,0,,足以跟歐爾麥特匹敵
Dialogue: 0,0:04:58.17,0:05:00.34,Default,,0,0,0,,還十分狡猾，行事謹慎
Dialogue: 0,0:05:00.71,0:05:03.00,Default,,0,0,0,,如果不能確保自身安全無虞
Dialogue: 0,0:05:03.09,0:05:05.13,Default,,0,0,0,,就絕對不會現身
Dialogue: 0,0:05:05.30,0:05:08.43,Default,,0,0,0,,這次行動希望盡可能迅速逮捕死柄木
Dialogue: 0,0:05:08.51,0:05:10.72,Default,,0,0,0,,當然也要抓住那傢伙
Dialogue: 0,0:05:12.43,0:05:14.68,Default,,0,0,0,,跟我聽說的根本不一樣
Dialogue: 0,0:05:15.90,0:05:17.48,Default,,0,0,0,,那又怎麼樣？
Dialogue: 0,0:05:18.77,0:05:19.94,Default,,0,0,0,,一流的英雄
Dialogue: 0,0:05:20.03,0:05:23.20,Default,,0,0,0,,不會把這種事當作失敗的藉口
Dialogue: 0,0:05:30.24,0:05:33.24,Default,,0,0,0,,原來如此，你之所以這麼強
Dialogue: 0,0:05:33.33,0:05:36.33,Default,,0,0,0,,是靠著大量的練習跟實務經驗得來的
Dialogue: 0,0:05:37.71,0:05:40.05,Default,,0,0,0,,不需要你的能力
Dialogue: 0,0:05:40.84,0:05:42.18,Default,,0,0,0,,因為你的個性
Dialogue: 0,0:05:42.26,0:05:44.68,Default,,0,0,0,,跟弔完全不合
Dialogue: 0,0:05:45.84,0:05:47.34,Default,,0,0,0,,那傢伙是誰？
Dialogue: 0,0:05:47.76,0:05:49.30,Default,,0,0,0,,發生什麼事了？
Dialogue: 0,0:05:49.76,0:05:52.72,Default,,0,0,0,,所有人在一瞬間全都被打倒了
Dialogue: 0,0:05:52.97,0:05:56.18,Default,,0,0,0,,明明知道得快逃才行
Dialogue: 0,0:05:56.39,0:05:57.52,Default,,0,0,0,,太過害怕
Dialogue: 0,0:05:57.60,0:05:58.81,Default,,0,0,0,,身體根本…
Dialogue: 0,0:05:59.31,0:06:00.48,Default,,0,0,0,,身體根本…
Dialogue: 0,0:06:00.82,0:06:02.32,Default,,0,0,0,,動彈不得
Dialogue: 0,0:06:02.94,0:06:05.23,Default,,0,0,0,,那個人到底是…
Dialogue: 0,0:06:05.49,0:06:06.78,Default,,0,0,0,,什麼來歷？
Dialogue: 0,0:06:09.32,0:06:10.49,Default,,0,0,0,,臭死了
Dialogue: 0,0:06:11.66,0:06:13.12,Default,,0,0,0,,這什麼鬼？
Dialogue: 1,0:06:14.50,0:06:16.09,Default2,,0,0,0,,-小勝
Dialogue: 0,0:06:14.50,0:06:16.09,Default,,0,0,0,,-爆豪
Dialogue: 0,0:06:16.46,0:06:18.80,Default,,0,0,0,,真抱歉，爆豪同學
Comment: 0,0:06:25.38,0:06:27.09,Default,,0,0,0,,（惡人，編織者）
Dialogue: 0,0:06:27.18,0:06:28.60,Default,,0,0,0,,這是怎麼回事？
Dialogue: 0,0:06:28.68,0:06:30.14,Default,,0,0,0,,總覺得有股臭味
Dialogue: 0,0:06:30.22,0:06:31.30,Default,,0,0,0,,這味道好香
Dialogue: 0,0:06:32.14,0:06:33.31,Default,,0,0,0,,老師
Dialogue: 0,0:06:33.68,0:06:36.60,Default,,0,0,0,,看樣子你又失敗了，弔
Dialogue: 0,0:06:38.77,0:06:41.77,Default,,0,0,0,,但是你絕對不可以因此氣餒
Dialogue: 0,0:06:42.02,0:06:43.81,Default,,0,0,0,,只要重振旗鼓就好
Dialogue: 0,0:06:44.15,0:06:46.36,Default,,0,0,0,,我都幫你把同伴帶來了
Dialogue: 0,0:06:46.65,0:06:48.07,Default,,0,0,0,,這個孩子也是
Dialogue: 0,0:06:48.57,0:06:51.03,Default,,0,0,0,,因為你認為他是重要的棋子
Dialogue: 0,0:06:51.12,0:06:52.62,Default,,0,0,0,,我才帶他過來的
Dialogue: 0,0:06:55.29,0:06:57.42,Default,,0,0,0,,你想重來幾次都可以
Dialogue: 0,0:06:58.12,0:07:00.75,Default,,0,0,0,,而我就是為此而存在的
Dialogue: 0,0:07:01.04,0:07:02.04,Default,,0,0,0,,這一切…
Dialogue: 0,0:07:02.59,0:07:04.43,Default,,0,0,0,,全部都是為了你
Dialogue: 0,0:07:11.18,0:07:12.52,Default,,0,0,0,,快回想起來
Dialogue: 0,0:07:12.64,0:07:14.52,Default,,0,0,0,,我是為什麼來到這裡
Dialogue: 0,0:07:14.60,0:07:15.81,Default,,0,0,0,,那個時候
Dialogue: 0,0:07:15.89,0:07:18.64,Default,,0,0,0,,我就是因為身體動不了才救不了他
Dialogue: 0,0:07:19.98,0:07:22.11,Default,,0,0,0,,怎麼能因為恐懼動彈不得
Dialogue: 0,0:07:22.52,0:07:24.69,Default,,0,0,0,,小勝明明就在我的眼前
Dialogue: 0,0:07:26.57,0:07:28.86,Default,,0,0,0,,那個人應該還沒有注意到我們這裡
Dialogue: 0,0:07:28.95,0:07:31.37,Default,,0,0,0,,不然就不會悠悠哉哉講那一大段話
Dialogue: 0,0:07:31.91,0:07:34.83,Default,,0,0,0,,從這裡到小勝那邊大約六、七公尺吧
Dialogue: 1,0:07:35.24,0:07:38.33,Default2,,0,0,0,,如果使出全覆蓋
Dialogue: 0,0:07:35.24,0:07:38.33,Default,,0,0,0,,不用一秒就能到他身邊
Dialogue: 1,0:07:38.41,0:07:41.41,Default2,,0,0,0,,之後有辦法全身而退嗎？
Dialogue: 0,0:07:38.41,0:07:41.41,Default,,0,0,0,,逃到哪去？
Dialogue: 0,0:07:41.50,0:07:42.92,Default,,0,0,0,,大家都會有危險
Dialogue: 0,0:07:43.00,0:07:44.33,Default,,0,0,0,,該用什麼計畫
Dialogue: 0,0:07:44.42,0:07:45.59,Default,,0,0,0,,才能夠…
Dialogue: 0,0:07:45.67,0:07:47.26,Default,,0,0,0,,跟大家…
Dialogue: 0,0:07:48.13,0:07:50.51,Default,,0,0,0,,不管怎麼樣我都得動起來
Dialogue: 0,0:07:51.93,0:07:54.10,Default,,0,0,0,,現在不讓身體動起來
Dialogue: 0,0:07:54.22,0:07:55.35,Default,,0,0,0,,就什麼都…
Dialogue: 0,0:08:01.90,0:08:02.94,Default,,0,0,0,,我要…
Dialogue: 0,0:08:03.61,0:08:04.90,Default,,0,0,0,,我要…
Dialogue: 0,0:08:05.82,0:08:07.32,Default,,0,0,0,,保護大家
Dialogue: 0,0:08:07.73,0:08:09.44,Default,,0,0,0,,思考對策
Dialogue: 0,0:08:09.65,0:08:11.15,Default,,0,0,0,,思考對策
Dialogue: 0,0:08:11.49,0:08:12.91,Default,,0,0,0,,怎麼才能…
Dialogue: 0,0:08:13.20,0:08:14.70,Default,,0,0,0,,逃離這裡
Dialogue: 0,0:08:16.37,0:08:19.25,Default,,0,0,0,,果然追來啦
Dialogue: 0,0:08:26.67,0:08:29.30,Default,,0,0,0,,我要你把一切通通還回來
Dialogue: 0,0:08:29.38,0:08:30.80,Default,,0,0,0,,All For One
Dialogue: 0,0:08:31.05,0:08:33.47,Default,,0,0,0,,你又要來殺我了嗎？
Dialogue: 0,0:08:33.55,0:08:35.14,Default,,0,0,0,,歐爾麥特
Comment: 1,0:08:38.85,0:08:41.90,Default2,,0,0,0,,（歐爾麥特，用代代傳承下來的
Comment: 0,0:08:38.85,0:08:41.90,Default,,0,0,0,,超強力量粉碎惡人）
Comment: 1,0:08:42.85,0:08:45.69,Default2,,0,0,0,,（All For One，能奪取他人的個性
Comment: 0,0:08:42.85,0:08:45.69,Default,,0,0,0,,也能將個性賦予給他人）
Dialogue: 0,0:08:48.90,0:08:51.44,Default,,0,0,0,,我要你把一切通通還回來
Dialogue: 0,0:08:51.53,0:08:53.07,Default,,0,0,0,,All For One
Dialogue: 0,0:08:53.15,0:08:55.32,Default,,0,0,0,,你又要來殺我了嗎？
Dialogue: 0,0:08:55.41,0:08:57.33,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:09:05.46,0:09:07.13,Default,,0,0,0,,連歐爾麥特都來了
Dialogue: 0,0:09:09.46,0:09:11.96,Default,,0,0,0,,怎麼過了這麼久才抵達？
Dialogue: 0,0:09:12.67,0:09:14.84,Default,,0,0,0,,酒吧距離這裡大概五公里多
Dialogue: 0,0:09:14.93,0:09:16.35,Default,,0,0,0,,從我送出腦無之後
Dialogue: 0,0:09:16.43,0:09:19.93,Default,,0,0,0,,你花了足足30秒才抵達這裡
Dialogue: 0,0:09:20.72,0:09:23.43,Default,,0,0,0,,你退步了呢，歐爾麥特
Dialogue: 0,0:09:23.52,0:09:25.69,Default,,0,0,0,,我才想說你呢
Dialogue: 1,0:09:25.94,0:09:28.82,Default2,,0,0,0,,說說看你那副像工業區的面具
Dialogue: 0,0:09:25.94,0:09:28.82,Default,,0,0,0,,是怎麼回事？
Dialogue: 0,0:09:29.11,0:09:31.65,Default,,0,0,0,,你才是拚了命地在逞強吧？
Dialogue: 0,0:09:32.40,0:09:34.94,Default,,0,0,0,,他竟然能空手震開歐爾麥特
Dialogue: 0,0:09:35.24,0:09:37.74,Default,,0,0,0,,那傢伙就是惡人的老大
Dialogue: 0,0:09:38.37,0:09:41.46,Default,,0,0,0,,我絕對不會再重蹈六年前的覆轍
Dialogue: 0,0:09:41.70,0:09:42.99,Default,,0,0,0,,All For One
Dialogue: 0,0:09:43.50,0:09:46.00,Default,,0,0,0,,我會把爆豪少年平安帶回來
Dialogue: 0,0:09:46.33,0:09:47.42,Default,,0,0,0,,而且這一次
Dialogue: 0,0:09:47.50,0:09:50.80,Default,,0,0,0,,一定要把你這傢伙送去監獄吃牢飯
Dialogue: 1,0:09:51.30,0:09:54.60,Default2,,0,0,0,,當然要連你操控的惡人聯軍
Dialogue: 0,0:09:51.30,0:09:54.60,Default,,0,0,0,,一起送進去
Dialogue: 0,0:09:55.13,0:09:57.30,Default,,0,0,0,,聽起來你要做的事真不少
Dialogue: 0,0:09:57.39,0:09:59.77,Default,,0,0,0,,我們都很辛苦呢
Dialogue: 0,0:10:08.90,0:10:12.65,Default,,0,0,0,,推出空氣加上筋骨發條化
Dialogue: 0,0:10:12.73,0:10:14.57,Default,,0,0,0,,爆發力乘以四
Dialogue: 0,0:10:14.65,0:10:16.94,Default,,0,0,0,,臂力增強乘以三
Dialogue: 0,0:10:17.32,0:10:19.86,Default,,0,0,0,,這種組合挺有意思的
Dialogue: 0,0:10:19.95,0:10:22.91,Default,,0,0,0,,再多加一些增強系的能力好了
Dialogue: 0,0:10:25.87,0:10:27.33,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:10:28.29,0:10:30.42,Default,,0,0,0,,不用擔心他
Dialogue: 0,0:10:30.50,0:10:32.67,Default,,0,0,0,,這點程度的攻擊死不了的
Dialogue: 0,0:10:32.75,0:10:34.88,Default,,0,0,0,,好了，弔，快逃吧
Dialogue: 0,0:10:34.96,0:10:36.55,Default,,0,0,0,,帶著那孩子一起
Dialogue: 0,0:10:39.43,0:10:41.64,Default,,0,0,0,,黑霧，快讓大家離開吧
Dialogue: 0,0:10:41.72,0:10:43.39,Default,,0,0,0,,等等，你幹嘛？
Dialogue: 0,0:10:43.47,0:10:45.35,Default,,0,0,0,,黑霧已經被人打暈了耶
Dialogue: 0,0:10:45.43,0:10:46.77,Default,,0,0,0,,我是不太清楚狀況
Dialogue: 0,0:10:46.85,0:10:49.39,Default,,0,0,0,,但是既然你也會傳送人，你來就好啦
Dialogue: 0,0:10:49.48,0:10:52.52,Default,,0,0,0,,磁姐，這個能力我才剛學會
Dialogue: 0,0:10:52.61,0:10:55.15,Default,,0,0,0,,所以不僅傳送距離很短
Dialogue: 0,0:10:55.24,0:10:57.28,Default,,0,0,0,,跟他的座標移動也不一樣
Dialogue: 0,0:10:57.36,0:10:59.36,Default,,0,0,0,,我只能把目標送來我這邊
Dialogue: 0,0:10:59.45,0:11:02.45,Default,,0,0,0,,或是從我這邊把目標送出去
Dialogue: 0,0:11:02.53,0:11:03.99,Default,,0,0,0,,順帶一提
Dialogue: 0,0:11:04.08,0:11:05.67,Default,,0,0,0,,我傳送的目標是人
Dialogue: 0,0:11:05.75,0:11:08.75,Default,,0,0,0,,還得是非常熟的人，不然就無效
Dialogue: 0,0:11:09.67,0:11:12.88,Default,,0,0,0,,所以才會需要黑霧把人送走
Dialogue: 0,0:11:14.80,0:11:16.89,Default,,0,0,0,,強制發動個性
Dialogue: 0,0:11:16.97,0:11:18.47,Default,,0,0,0,,好了，去吧
Dialogue: 0,0:11:18.55,0:11:19.76,Default,,0,0,0,,那老師…
Dialogue: 0,0:11:26.89,0:11:28.98,Default,,0,0,0,,弔，要時常保持思考
Dialogue: 0,0:11:29.31,0:11:32.15,Default,,0,0,0,,因為你未來還有很大的成長空間
Dialogue: 0,0:11:32.40,0:11:33.78,Default,,0,0,0,,休想逃走
Dialogue: 0,0:11:37.03,0:11:38.37,Default,,0,0,0,,老師
Dialogue: 0,0:11:38.44,0:11:39.78,Default,,0,0,0,,走吧，死柄木
Dialogue: 0,0:11:39.86,0:11:41.28,Default,,0,0,0,,我們快趁那個管子面具
Dialogue: 0,0:11:41.36,0:11:43.53,Default,,0,0,0,,拖住歐爾麥特的時候走吧
Dialogue: 0,0:11:43.62,0:11:44.79,Default,,0,0,0,,連棋子一起帶走
Dialogue: 0,0:11:47.50,0:11:49.88,Default,,0,0,0,,實在有夠麻煩的
Dialogue: 0,0:11:51.25,0:11:52.75,Default,,0,0,0,,爆豪少年
Dialogue: 0,0:11:54.50,0:11:55.79,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:11:56.21,0:11:57.80,Default,,0,0,0,,因為All For One妨礙
Dialogue: 0,0:11:57.88,0:11:59.76,Default,,0,0,0,,所以沒辦法救出小勝
Dialogue: 1,0:12:00.34,0:12:04.09,Default2,,0,0,0,,惡人聯軍更想趁這個機會
Dialogue: 0,0:12:00.34,0:12:04.09,Default,,0,0,0,,帶著小勝一起逃走
Dialogue: 1,0:12:05.14,0:12:08.39,Default2,,0,0,0,,小勝也被惡人團團包圍
Dialogue: 0,0:12:05.14,0:12:08.39,Default,,0,0,0,,根本沒辦法脫身
Dialogue: 0,0:12:10.23,0:12:12.23,Default,,0,0,0,,惡人也覺得不妙了
Dialogue: 0,0:12:12.31,0:12:13.77,Default,,0,0,0,,跟之前不一樣
Dialogue: 0,0:12:13.86,0:12:15.90,Default,,0,0,0,,他們現在打算把我強行帶走
Dialogue: 0,0:12:15.98,0:12:17.11,Default,,0,0,0,,六對一
Dialogue: 0,0:12:19.28,0:12:22.16,Default,,0,0,0,,不管怎麼樣絕不能被臭面具男碰到
Dialogue: 0,0:12:22.24,0:12:23.70,Default,,0,0,0,,我這就過去
Dialogue: 0,0:12:24.70,0:12:26.66,Default,,0,0,0,,休想得逞
Dialogue: 0,0:12:26.74,0:12:29.12,Default,,0,0,0,,我就是為此才會在這裡
Dialogue: 0,0:12:29.20,0:12:31.75,Default,,0,0,0,,該死
Dialogue: 0,0:12:33.37,0:12:35.21,Default,,0,0,0,,歐爾麥特跟小勝
Dialogue: 0,0:12:35.29,0:12:37.00,Default,,0,0,0,,明明都身陷危機了
Dialogue: 0,0:12:37.50,0:12:38.59,Default,,0,0,0,,但是…
Dialogue: 1,0:12:39.05,0:12:41.72,Default2,,0,0,0,,尚未取得英雄資格的人
Dialogue: 0,0:12:39.05,0:12:41.72,Default,,0,0,0,,沒有獲得監護者指示
Dialogue: 0,0:12:41.80,0:12:43.47,Default,,0,0,0,,就用個性傷人
Dialogue: 0,0:12:44.22,0:12:46.39,Default,,0,0,0,,是嚴重的違規行為汪
Dialogue: 0,0:12:47.22,0:12:48.56,Default,,0,0,0,,我也一樣不甘心
Dialogue: 0,0:12:48.64,0:12:49.60,Default,,0,0,0,,但是
Dialogue: 0,0:12:49.68,0:12:52.18,Default,,0,0,0,,這件事萬萬不可以感情用事
Dialogue: 0,0:12:52.85,0:12:54.89,Default,,0,0,0,,還是要破壞規矩的話
Dialogue: 1,0:12:54.98,0:12:58.36,Default2,,0,0,0,,那你們的行為
Dialogue: 0,0:12:54.98,0:12:58.36,Default,,0,0,0,,也跟惡人沒有什麼兩樣喔
Dialogue: 0,0:12:58.78,0:13:00.95,Default,,0,0,0,,為什麼要做這種事的人偏偏是你們？
Dialogue: 1,0:13:01.74,0:13:04.83,Default2,,0,0,0,,為什麼你們兩個
Dialogue: 0,0:13:01.74,0:13:04.83,Default,,0,0,0,,偏偏要重蹈我的覆轍呢？
Dialogue: 0,0:13:06.03,0:13:07.32,Default,,0,0,0,,但是我們…
Dialogue: 0,0:13:08.03,0:13:10.91,Default,,0,0,0,,我們卻不被允許參與戰鬥
Dialogue: 0,0:13:12.71,0:13:13.84,Default,,0,0,0,,最起碼…
Dialogue: 0,0:13:13.92,0:13:14.75,Default,,0,0,0,,要乘隙
Dialogue: 0,0:13:15.25,0:13:16.25,Default,,0,0,0,,得找出空隙
Dialogue: 0,0:13:16.33,0:13:17.54,Default,,0,0,0,,一瞬間也好
Dialogue: 0,0:13:17.75,0:13:20.17,Default,,0,0,0,,有沒有什麼能夠救出小勝的路？
Dialogue: 0,0:13:20.59,0:13:22.34,Default,,0,0,0,,只要能救出小勝
Dialogue: 0,0:13:22.42,0:13:24.80,Default,,0,0,0,,歐爾麥特就能發揮全力
Dialogue: 0,0:13:25.43,0:13:26.77,Default,,0,0,0,,在哪裡？
Dialogue: 0,0:13:27.10,0:13:29.14,Default,,0,0,0,,到底哪條路有隙可乘？
Dialogue: 0,0:13:29.26,0:13:30.47,Default,,0,0,0,,在哪裡？
Dialogue: 0,0:13:30.89,0:13:31.89,Default,,0,0,0,,不對
Dialogue: 0,0:13:32.35,0:13:33.43,Default,,0,0,0,,行不通
Dialogue: 0,0:13:34.10,0:13:36.14,Default,,0,0,0,,一定有哪條路可行
Dialogue: 0,0:13:39.90,0:13:41.03,Default,,0,0,0,,空隙
Dialogue: 0,0:13:41.44,0:13:43.03,Default,,0,0,0,,飯田同學，各位
Dialogue: 0,0:13:43.11,0:13:45.03,Default,,0,0,0,,綠谷同學，千萬不可以
Dialogue: 0,0:13:45.11,0:13:47.24,Default,,0,0,0,,不是的，我想到辦法了
Dialogue: 0,0:13:47.37,0:13:49.75,Default,,0,0,0,,一個不算是戰鬥行為的辦法
Dialogue: 0,0:13:49.83,0:13:51.50,Default,,0,0,0,,既能讓我們逃離這裡
Dialogue: 0,0:13:51.62,0:13:54.87,Default,,0,0,0,,而且是不用戰鬥就能救出小勝的辦法
Dialogue: 0,0:13:57.00,0:13:58.29,Default,,0,0,0,,你快說來聽聽
Dialogue: 0,0:13:58.63,0:13:59.92,Default,,0,0,0,,但是這個辦法
Dialogue: 0,0:14:00.00,0:14:02.04,Default,,0,0,0,,也要小勝配合才可能成功
Dialogue: 0,0:14:02.38,0:14:05.05,Default,,0,0,0,,不准過來，笨久
Dialogue: 0,0:14:05.13,0:14:07.22,Default,,0,0,0,,如果你們去救他的話
Dialogue: 0,0:14:07.30,0:14:08.80,Default,,0,0,0,,這對爆豪同學來說
Dialogue: 0,0:14:08.89,0:14:11.14,Default,,0,0,0,,一定是難以忍受的恥辱吧？
Dialogue: 0,0:14:12.01,0:14:13.35,Default,,0,0,0,,如果是由我執行的話
Dialogue: 0,0:14:13.85,0:14:15.69,Default,,0,0,0,,計畫肯定會失敗
Dialogue: 0,0:14:15.94,0:14:17.40,Default,,0,0,0,,所以切島同學
Dialogue: 0,0:14:17.94,0:14:20.82,Default,,0,0,0,,你將是提高計畫成功率的關鍵
Dialogue: 0,0:14:22.32,0:14:24.53,Default,,0,0,0,,告訴我們詳細計畫吧，綠谷
Dialogue: 0,0:14:25.65,0:14:27.40,Default,,0,0,0,,計畫是這樣的
Dialogue: 0,0:14:31.91,0:14:34.62,Default,,0,0,0,,你不敢使出全力，是嗎？
Dialogue: 0,0:14:35.12,0:14:38.42,Default,,0,0,0,,為了不讓那個少年被捲進來嗎？
Dialogue: 0,0:14:39.71,0:14:42.05,Default,,0,0,0,,真是的，英雄這種生物
Dialogue: 0,0:14:42.42,0:14:44.55,Default,,0,0,0,,還真是非常不好當呢
Dialogue: 0,0:14:45.67,0:14:47.17,Default,,0,0,0,,爆豪少年
Dialogue: 1,0:14:49.22,0:14:52.64,Default2,,0,0,0,,都是因為我在這裡
Dialogue: 0,0:14:49.22,0:14:52.64,Default,,0,0,0,,歐爾麥特才會綁手綁腳的
Dialogue: 0,0:14:52.81,0:14:54.23,Default,,0,0,0,,可惡
Dialogue: 0,0:14:55.22,0:14:56.97,Default,,0,0,0,,你所謂的計畫居然是…
Dialogue: 1,0:14:57.06,0:15:00.06,Default2,,0,0,0,,我想小勝應該也很清楚
Dialogue: 0,0:14:57.06,0:15:00.06,Default,,0,0,0,,歐爾麥特現在的處境
Dialogue: 0,0:15:00.48,0:15:01.77,Default,,0,0,0,,我想也是
Dialogue: 1,0:15:02.06,0:15:05.36,Default2,,0,0,0,,小勝在提防對手
Dialogue: 0,0:15:02.06,0:15:05.36,Default,,0,0,0,,所以邊保持距離邊戰鬥
Dialogue: 0,0:15:05.65,0:15:06.69,Default,,0,0,0,,我們就抓準
Dialogue: 1,0:15:06.78,0:15:09.83,Default2,,0,0,0,,惡人拉開一定距離的
Dialogue: 0,0:15:06.78,0:15:09.83,Default,,0,0,0,,那個瞬間展開行動
Dialogue: 0,0:15:10.41,0:15:11.66,Default,,0,0,0,,飯田同學
Dialogue: 0,0:15:11.87,0:15:13.41,Default,,0,0,0,,這的確是個賭注
Dialogue: 0,0:15:13.58,0:15:14.92,Default,,0,0,0,,但考慮到現況
Dialogue: 0,0:15:14.99,0:15:16.91,Default,,0,0,0,,這方法對我們的風險不高
Dialogue: 0,0:15:17.00,0:15:18.21,Default,,0,0,0,,一旦計畫成功
Dialogue: 0,0:15:18.29,0:15:20.29,Default,,0,0,0,,一切就會立刻好轉
Dialogue: 0,0:15:24.21,0:15:25.42,Default,,0,0,0,,動手吧
Dialogue: 0,0:15:27.01,0:15:28.60,Default,,0,0,0,,計畫是這樣的
Dialogue: 1,0:15:29.30,0:15:31.89,Default2,,0,0,0,,先用我的個性
Dialogue: 0,0:15:29.30,0:15:31.89,Default,,0,0,0,,加上飯田同學的往復式
Dialogue: 0,0:15:31.97,0:15:33.76,Default,,0,0,0,,盡量提高推進力
Dialogue: 0,0:15:35.52,0:15:37.69,Default,,0,0,0,,再靠切島同學的硬化
Dialogue: 0,0:15:39.81,0:15:41.48,Default,,0,0,0,,破牆而出
Dialogue: 1,0:15:42.23,0:15:46.48,Default2,,0,0,0,,破牆後那瞬間
Dialogue: 0,0:15:42.23,0:15:46.48,Default,,0,0,0,,請轟同學立刻用冰做出一條路
Dialogue: 0,0:15:47.32,0:15:49.41,Default,,0,0,0,,那條路得讓我們跳得越高越好
Dialogue: 0,0:15:50.32,0:15:52.66,Default,,0,0,0,,惡人並沒有察覺我們在場
Dialogue: 0,0:15:53.24,0:15:56.12,Default,,0,0,0,,過去惡人總是乘隙把我們耍得團團轉
Dialogue: 0,0:15:56.20,0:15:59.16,Default,,0,0,0,,現在不一樣，雙方的立場反過來了
Dialogue: 0,0:16:00.37,0:16:01.50,Default,,0,0,0,,然後
Dialogue: 1,0:16:01.58,0:16:04.58,Default2,,0,0,0,,我們要從惡人觸及不到的高度
Dialogue: 0,0:16:01.58,0:16:04.58,Default,,0,0,0,,穿越戰場
Dialogue: 0,0:16:05.34,0:16:08.30,Default,,0,0,0,,惡人的老大正在設法拖住歐爾麥特
Dialogue: 0,0:16:08.67,0:16:11.55,Default,,0,0,0,,也就是說，反過來也是一樣
Dialogue: 0,0:16:12.93,0:16:15.31,Default,,0,0,0,,接著，就輪到切島同學
Dialogue: 0,0:16:15.89,0:16:17.31,Default,,0,0,0,,靠我是不行的
Dialogue: 1,0:16:17.56,0:16:20.44,Default2,,0,0,0,,轟同學、飯田同學
Dialogue: 0,0:16:17.56,0:16:20.44,Default,,0,0,0,,跟八百萬同學也不行
Dialogue: 0,0:16:20.89,0:16:22.85,Default,,0,0,0,,必須由從開學到現在
Dialogue: 0,0:16:22.94,0:16:25.48,Default,,0,0,0,,跟小勝建立了對等關係的朋友
Dialogue: 0,0:16:25.57,0:16:27.57,Default,,0,0,0,,由你來呼喚他才行
Dialogue: 0,0:16:27.65,0:16:29.11,Default,,0,0,0,,過來
Dialogue: 0,0:16:29.44,0:16:30.82,Default,,0,0,0,,一定可以
Dialogue: 0,0:16:43.62,0:16:45.29,Default,,0,0,0,,你們傻了嗎？
Dialogue: 0,0:16:45.88,0:16:47.17,Default,,0,0,0,,什麼？
Dialogue: 0,0:16:47.55,0:16:48.68,Default,,0,0,0,,爆豪同學
Dialogue: 0,0:16:48.75,0:16:50.50,Default,,0,0,0,,請你配合我的指示使出爆風
Dialogue: 0,0:16:50.59,0:16:52.34,Default,,0,0,0,,為什麼要我配合你啊？
Dialogue: 0,0:16:52.43,0:16:54.52,Default,,0,0,0,,這種時候就不要再爭了啦
Dialogue: 0,0:16:54.59,0:16:57.26,Default,,0,0,0,,果然如我們所料，他們都注意那邊
Dialogue: 0,0:16:57.35,0:16:58.39,Default,,0,0,0,,趁現在快逃走
Dialogue: 0,0:16:58.47,0:16:59.39,Default,,0,0,0,,好的
Dialogue: 0,0:17:00.31,0:17:01.69,Default,,0,0,0,,不管到哪裡
Dialogue: 0,0:17:01.77,0:17:03.31,Default,,0,0,0,,都會跟過來
Dialogue: 0,0:17:03.52,0:17:04.81,Default,,0,0,0,,那群孩子
Dialogue: 0,0:17:04.90,0:17:06.15,Default,,0,0,0,,真的是…
Dialogue: 0,0:17:06.23,0:17:08.11,Default,,0,0,0,,休想逃跑，誰能遠距離攻擊？
Dialogue: 0,0:17:08.23,0:17:09.40,Default,,0,0,0,,荼毘跟黑霧
Dialogue: 0,0:17:09.48,0:17:10.69,Default,,0,0,0,,但是他們都趴了
Dialogue: 0,0:17:10.78,0:17:11.91,Default,,0,0,0,,你們快貼緊我
Dialogue: 0,0:17:11.99,0:17:13.99,Default,,0,0,0,,磁姐，個性磁力
Dialogue: 1,0:17:14.16,0:17:17.96,Default2,,0,0,0,,能在自身周圍
Dialogue: 0,0:17:14.16,0:17:17.96,Default,,0,0,0,,半徑四、五公尺內的人身上附加磁力
Dialogue: 0,0:17:18.33,0:17:21.12,Default,,0,0,0,,可以調整力量到全身或是特定部位
Dialogue: 0,0:17:21.20,0:17:24.00,Default,,0,0,0,,男人是S極，女人則是N極
Dialogue: 0,0:17:24.08,0:17:25.96,Default,,0,0,0,,但是沒辦法附加到自己身上唷
Dialogue: 0,0:17:26.04,0:17:27.29,Default,,0,0,0,,要上了
Dialogue: 0,0:17:28.88,0:17:30.38,Default,,0,0,0,,反彈破局
Dialogue: 0,0:17:30.46,0:17:31.67,Default,,0,0,0,,夜逃砲
Dialogue: 0,0:17:31.76,0:17:33.89,Default,,0,0,0,,泰坦峭壁
Dialogue: 0,0:17:35.72,0:17:37.18,Default,,0,0,0,,山峰淑女
Dialogue: 0,0:17:37.51,0:17:39.64,Default,,0,0,0,,救人要緊
Dialogue: 0,0:17:39.97,0:17:41.97,Default,,0,0,0,,快走啊，笨小鬼
Dialogue: 0,0:17:43.56,0:17:45.73,Default,,0,0,0,,應該還來得及，再來一次
Dialogue: 0,0:17:52.32,0:17:53.78,Default,,0,0,0,,經典老爺車
Dialogue: 0,0:17:53.86,0:17:54.90,Default,,0,0,0,,您來得太慢了
Dialogue: 0,0:17:54.99,0:17:56.62,Default,,0,0,0,,是你速度太快了，好嗎？
Dialogue: 0,0:17:56.74,0:17:58.33,Default,,0,0,0,,我真的要說
Dialogue: 0,0:17:58.45,0:18:01.04,Default,,0,0,0,,綠谷那小子真的是越來越像你了
Dialogue: 0,0:18:01.12,0:18:02.58,Default,,0,0,0,,而且像的都是缺點
Dialogue: 0,0:18:04.29,0:18:06.13,Default,,0,0,0,,有了保須事件的教訓
Dialogue: 0,0:18:06.58,0:18:08.25,Default,,0,0,0,,沒想到他們竟然還是跑來了
Dialogue: 0,0:18:08.33,0:18:09.67,Default,,0,0,0,,少年們
Dialogue: 0,0:18:12.46,0:18:15.00,Default,,0,0,0,,志村的朋友啊
Dialogue: 1,0:18:16.76,0:18:19.97,Default2,,0,0,0,,說來慚愧
Dialogue: 0,0:18:16.76,0:18:19.97,Default,,0,0,0,,我不得不承認，這麼一來
Dialogue: 0,0:18:20.30,0:18:22.64,Default,,0,0,0,,我就能心無罣礙全力打倒你
Dialogue: 0,0:18:23.14,0:18:24.48,Default,,0,0,0,,All For One
Dialogue: 0,0:18:25.23,0:18:26.94,Default,,0,0,0,,這裡也只剩下兩個人了
Dialogue: 0,0:18:27.14,0:18:28.31,Default,,0,0,0,,結束戰鬥吧
Dialogue: 0,0:18:28.40,0:18:31.03,Default,,0,0,0,,小弔，人家不想就這樣結束
Dialogue: 0,0:18:31.11,0:18:32.44,Default,,0,0,0,,被擺了一道呢
Dialogue: 0,0:18:32.53,0:18:35.41,Default,,0,0,0,,居然下了一步完全逆轉情勢的棋
Dialogue: 0,0:18:37.78,0:18:39.45,Default,,0,0,0,,強制發動
Dialogue: 0,0:18:39.53,0:18:40.86,Default,,0,0,0,,磁力
Dialogue: 0,0:18:42.12,0:18:43.75,Default,,0,0,0,,化為塵埃吧
Dialogue: 0,0:18:49.67,0:18:52.42,Default,,0,0,0,,討厭，怎麼突然往人家這邊靠過來
Dialogue: 0,0:18:55.17,0:18:56.26,Default,,0,0,0,,等等
Dialogue: 0,0:18:56.67,0:18:58.46,Default,,0,0,0,,不行，老師
Dialogue: 0,0:18:58.76,0:18:59.76,Default,,0,0,0,,休想逃跑
Dialogue: 0,0:19:01.85,0:19:04.31,Default,,0,0,0,,您現在的身體狀況…
Dialogue: 0,0:19:05.43,0:19:06.81,Default,,0,0,0,,根本不能…
Dialogue: 0,0:19:07.94,0:19:11.15,Default,,0,0,0,,看樣子沒有任何人願意拯救你呢
Dialogue: 0,0:19:11.81,0:19:13.10,Default,,0,0,0,,很難受吧？
Dialogue: 0,0:19:13.19,0:19:15.19,Default,,0,0,0,,志村轉弧小弟弟
Dialogue: 0,0:19:16.69,0:19:18.11,Default,,0,0,0,,已經沒事了
Dialogue: 0,0:19:18.45,0:19:19.95,Default,,0,0,0,,我會在你身邊
Dialogue: 0,0:19:21.91,0:19:22.91,Default,,0,0,0,,我…
Dialogue: 0,0:19:23.58,0:19:24.62,Default,,0,0,0,,還沒…
Dialogue: 0,0:19:27.71,0:19:29.00,Default,,0,0,0,,弔
Dialogue: 0,0:19:29.33,0:19:32.46,Default,,0,0,0,,你就繼續戰鬥下去吧
Dialogue: 0,0:19:33.63,0:19:35.05,Default,,0,0,0,,傳送
Dialogue: 0,0:19:35.13,0:19:37.22,Default,,0,0,0,,加上衝擊反轉
Dialogue: 0,0:19:41.89,0:19:43.93,Default,,0,0,0,,非常對不起
Dialogue: 0,0:19:45.51,0:19:48.85,Default,,0,0,0,,我是為了救弔才會來這裡一趟
Dialogue: 0,0:19:48.93,0:19:50.43,Default,,0,0,0,,如果你想打的話
Dialogue: 0,0:19:50.52,0:19:52.15,Default,,0,0,0,,我也會奉陪到底
Dialogue: 0,0:19:52.98,0:19:56.23,Default,,0,0,0,,因為我非常憎恨你，歐爾麥特
Dialogue: 0,0:19:56.61,0:19:57.99,Default,,0,0,0,,過去你揮舞拳頭
Dialogue: 0,0:19:58.07,0:20:00.45,Default,,0,0,0,,把我的同伴一個一個擊倒
Dialogue: 0,0:20:00.53,0:20:03.87,Default,,0,0,0,,你也因此被歌頌為和平的象徵
Dialogue: 1,0:20:05.24,0:20:09.04,Default2,,0,0,0,,站在我們的犧牲之上
Dialogue: 0,0:20:05.24,0:20:09.04,Default,,0,0,0,,看到的景色
Dialogue: 0,0:20:10.25,0:20:13.17,Default,,0,0,0,,想必非常美妙迷人吧？
Dialogue: 0,0:20:14.38,0:20:16.51,Default,,0,0,0,,底特律
Dialogue: 0,0:20:17.51,0:20:20.60,Default,,0,0,0,,爆碎風
Dialogue: 0,0:20:30.06,0:20:32.40,Default,,0,0,0,,強制抵銷攻擊
Dialogue: 0,0:20:33.52,0:20:36.77,Default,,0,0,0,,我不會讓你心無罣礙地戰鬥喔
Dialogue: 0,0:20:37.19,0:20:39.44,Default,,0,0,0,,畢竟英雄要守護的事物
Dialogue: 0,0:20:39.53,0:20:41.28,Default,,0,0,0,,可多著呢
Dialogue: 0,0:20:42.45,0:20:43.91,Default,,0,0,0,,給我閉嘴
Dialogue: 0,0:20:45.41,0:20:48.66,Default,,0,0,0,,你這傢伙就是像這樣恣意玩弄別人
Dialogue: 0,0:20:49.16,0:20:51.37,Default,,0,0,0,,破壞、搶奪
Dialogue: 0,0:20:51.50,0:20:53.54,Default,,0,0,0,,乘隙而入加以支配
Dialogue: 0,0:20:54.54,0:20:57.17,Default,,0,0,0,,並且無理取鬧地嘲笑
Dialogue: 0,0:20:57.80,0:21:00.55,Default,,0,0,0,,每天辛勤努力過生活的人們
Dialogue: 0,0:21:02.30,0:21:04.47,Default,,0,0,0,,我就是最沒有辦法…
Dialogue: 0,0:21:04.55,0:21:06.39,Default,,0,0,0,,糟糕，得用傳送
Dialogue: 0,0:21:06.47,0:21:08.97,Default,,0,0,0,,原諒你這一點
Dialogue: 0,0:21:18.23,0:21:19.44,Default,,0,0,0,,俊典
Dialogue: 0,0:21:22.74,0:21:25.24,Default,,0,0,0,,已經到活動極限了
Dialogue: 0,0:21:26.41,0:21:27.95,Default,,0,0,0,,你怎麼啦？
Dialogue: 0,0:21:29.33,0:21:32.71,Default,,0,0,0,,情緒未免太激動了吧，歐爾麥特
Dialogue: 0,0:21:33.50,0:21:37.13,Default,,0,0,0,,我記得以前好像也聽過類似的臺詞呢
Dialogue: 0,0:21:39.67,0:21:43.84,Default,,0,0,0,,從One For All的前一代繼承者…
Dialogue: 0,0:21:45.13,0:21:47.72,Default,,0,0,0,,志村菜奈那裡聽到
Comment: 0,0:23:20.52,0:23:21.48,Default,,0,0,0,,下集預告
Comment: 1,0:23:21.56,0:23:25.36,Default2,,0,0,0,,歐爾麥特一直隱藏的秘密
Comment: 0,0:23:21.56,0:23:25.36,Default,,0,0,0,,被攤在陽光下了
Comment: 0,0:23:25.65,0:23:27.07,Default,,0,0,0,,儘管如此
Comment: 0,0:23:27.15,0:23:29.40,Default,,0,0,0,,他依然持續對抗巨大的邪惡
Comment: 0,0:23:29.53,0:23:31.57,Default,,0,0,0,,下一集，One For All
Comment: 0,0:23:31.66,0:23:32.95,Default,,0,0,0,,更向前邁進吧
Comment: 0,0:23:33.03,0:23:34.49,Default,,0,0,0,,超越巔峰

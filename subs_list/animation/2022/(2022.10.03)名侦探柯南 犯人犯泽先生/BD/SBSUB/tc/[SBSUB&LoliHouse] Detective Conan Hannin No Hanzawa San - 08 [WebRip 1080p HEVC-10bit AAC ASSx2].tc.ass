Dialogue: 0,0:08:55.60,0:09:01.02,Default,,0,0,0,,{\fn方正行楷_GBK\b1\bord0\shad0\fad(0,0)\pos(960,128)}穿搭之夜
Dialogue: 0,0:01:33.51,0:01:35.95,DefaultSingle-T,,0,0,0,,		你看  華生
Dialogue: 0,0:01:36.48,0:01:38.20,DefaultSingle-T,,0,0,0,,		這就是鑰匙
Dialogue: 0,0:01:38.20,0:01:39.66,DefaultSingle-T,,0,0,0,,		好孩子
Dialogue: 0,0:01:40.48,0:01:43.12,DefaultSingle-T,,0,0,0,,		快把這鑰匙銜給我
Dialogue: 0,0:01:47.64,0:01:52.43,DefaultSingle-T,,0,0,0,,		好痛
Dialogue: 0,0:02:00.06,0:02:01.60,DefaultSingle-T,,0,0,0,,		不順利啊
Dialogue: 0,0:02:01.60,0:02:04.42,DefaultSingle-T,,0,0,0,,		我還覺得能用它製造密室呢
Dialogue: 0,0:02:04.60,0:02:07.04,DefaultSingle-T,,0,0,0,,		不知道什麼時候會遇到那個男人
Dialogue: 0,0:02:07.36,0:02:10.10,DefaultSingle-T,,0,0,0,,		我必須做好準備  以便隨時都能殺他
Dialogue: 0,0:02:10.49,0:02:13.81,DefaultSingle-T,,0,0,0,,		不知是不是因為在英國一直和我在一起
Dialogue: 0,0:02:13.96,0:02:16.15,DefaultSingle-T,,0,0,0,,		華生好像變得喜歡血了
Dialogue: 0,0:02:16.41,0:02:17.08,DefaultSingle-T,,0,0,0,,		對了
Dialogue: 0,0:02:17.16,0:02:19.34,DefaultSingle-T,,0,0,0,,		只要利用血  說不定就能讓它聽話
Dialogue: 0,0:02:19.80,0:02:22.28,DefaultSingle-T,,0,0,0,,		你看  血淋淋的鑰匙
Dialogue: 0,0:02:22.28,0:02:23.97,DefaultSingle-T,,0,0,0,,		好痛
Dialogue: 0,0:02:23.97,0:02:27.79,DefaultSingle-T,,0,0,0,,		不行了  華生太嗜血了
Dialogue: 0,0:02:29.85,0:02:30.33,DefaultSingle-T,,0,0,0,,		好
Dialogue: 0,0:02:30.85,0:02:33.27,DefaultSingle-T,,0,0,0,,		真是的  餌料也是不小的開銷
Dialogue: 0,0:02:33.27,0:02:34.92,DefaultSingle-T,,0,0,0,,		之後找白馬要吧
Dialogue: 0,0:02:35.14,0:02:37.22,DefaultSingle-T,,0,0,0,,		我父親可是警視總監
Dialogue: 0,0:02:42.01,0:02:42.59,DefaultSingle-T,,0,0,0,,		狗
Dialogue: 0,0:02:43.58,0:02:46.50,DefaultSingle-T,,0,0,0,,		狗很聰明  只要訓練好  說不定什麼都能做
Dialogue: 0,0:02:47.09,0:02:48.81,DefaultSingle-T,,0,0,0,,		比如從裡面把門鎖上
Dialogue: 0,0:02:49.14,0:02:50.54,DefaultSingle-T,,0,0,0,,		銷毀證據
Dialogue: 0,0:02:50.82,0:02:53.06,DefaultSingle-T,,0,0,0,,		給它披塊布  在裡面安上燈泡
Dialogue: 0,0:02:53.06,0:02:54.92,DefaultSingle-T,,0,0,0,,		還能變得像怪物一樣
Dialogue: 0,0:02:55.17,0:02:56.90,DefaultSingle-T,,0,0,0,,		有無限的可能性
Dialogue: 0,0:03:20.68,0:03:23.02,DefaultSingle-T,,0,0,0,,		歡迎光臨  您想要什麼樣的寵物呢
Dialogue: 0,0:03:23.46,0:03:24.36,DefaultSingle-T,,0,0,0,,		狗
Dialogue: 0,0:03:24.58,0:03:27.25,DefaultSingle-T,,0,0,0,,		要聰明的  聽主人的話
Dialogue: 0,0:03:27.41,0:03:29.68,DefaultSingle-T,,0,0,0,,		體格壯碩  強有力的鬥犬
Dialogue: 0,0:03:29.84,0:03:30.61,DefaultSingle-T,,0,0,0,,		鬥犬？
Dialogue: 0,0:03:30.74,0:03:34.39,DefaultSingle-T,,0,0,0,,		對  加以訓練就能作為殺死獵物的凶器
Dialogue: 0,0:03:36.88,0:03:38.51,DefaultSingle-T,,0,0,0,,		德國牧羊犬怎麼樣呢
Dialogue: 0,0:03:38.51,0:03:39.15,DefaultSingle-T,,0,0,0,,		德牧？
Dialogue: 0,0:03:39.53,0:03:41.61,DefaultSingle-T,,0,0,0,,		聰明又忠誠
Dialogue: 0,0:03:42.71,0:03:45.07,DefaultSingle-T,,0,0,0,,		很容易聯想到警犬啊
Dialogue: 0,0:03:45.16,0:03:46.99,DefaultSingle-T,,0,0,0,,		那土佐鬥犬呢
Dialogue: 0,0:03:46.99,0:03:47.79,DefaultSingle-T,,0,0,0,,		土佐鬥犬？
Dialogue: 0,0:03:48.00,0:03:50.58,DefaultSingle-T,,0,0,0,,		是有名的鬥犬  很強的
Dialogue: 0,0:03:50.58,0:03:51.41,DefaultSingle-T,,0,0,0,,		不錯
Dialogue: 0,0:03:51.78,0:03:52.39,DefaultSingle-T,,0,0,0,,		就它了
Dialogue: 0,0:03:52.53,0:03:55.89,DefaultSingle-T,,0,0,0,,		和我締結主從關係  一起殺人
Dialogue: 0,0:03:55.89,0:03:58.92,DefaultSingle-T,,0,0,0,,		能幹又忠誠的殺人夥伴
Dialogue: 0,0:04:05.13,0:04:07.48,DefaultSingle-T,,0,0,0,,		如果想好好訓練或者教一些技能
Dialogue: 0,0:04:07.48,0:04:09.11,DefaultSingle-T,,0,0,0,,		推薦從小開始養
Dialogue: 0,0:04:09.11,0:04:09.80,DefaultSingle-T,,0,0,0,,		這樣啊
Dialogue: 0,0:04:10.03,0:04:11.12,DefaultSingle-T,,0,0,0,,		30萬
Dialogue: 0,0:04:11.34,0:04:12.64,DefaultSingle-T,,0,0,0,,		買不起
Dialogue: 0,0:04:12.71,0:04:16.72,DefaultSingle-T,,0,0,0,,		我現在沒有這麼多錢
Dialogue: 0,0:04:17.21,0:04:18.74,DefaultSingle-T,,0,0,0,,		不用狗了
Dialogue: 0,0:04:18.74,0:04:21.15,DefaultSingle-T,,0,0,0,,		低成本的方法要多少有多少
Dialogue: 0,0:04:21.38,0:04:25.07,DefaultSingle-T,,0,0,0,,		菜刀  釣線  繩子  炸彈…
Dialogue: 0,0:04:28.76,0:04:31.06,DefaultSingle-T,,0,0,0,,		你最近有點鬆懈啊
Dialogue: 0,0:04:31.15,0:04:33.48,DefaultSingle-T,,0,0,0,,		收銀也經常出錯  這可不行啊
Dialogue: 0,0:04:33.48,0:04:34.33,DefaultSingle-T,,0,0,0,,		對不起
Dialogue: 0,0:04:36.47,0:04:37.67,DefaultSingle-T,,0,0,0,,		犯澤先生  收銀
Dialogue: 0,0:04:37.67,0:04:38.26,DefaultSingle-T,,0,0,0,,		是
Dialogue: 0,0:04:54.17,0:04:56.21,DefaultSingle-T,,0,0,0,,		怎麼樣  您想好了嗎
Dialogue: 0,0:05:00.62,0:05:02.37,DefaultSingle-T,,0,0,0,,		土佐犬能變得很強哦
Dialogue: 0,0:05:02.37,0:05:05.63,DefaultSingle-T,,0,0,0,,		不  我只是來買老鷹餌料的
Dialogue: 0,0:05:06.90,0:05:07.86,DefaultSingle-T,,0,0,0,,		歡迎光臨
Dialogue: 0,0:05:08.09,0:05:10.58,DefaultSingle-T,,0,0,0,,		好可愛啊
Dialogue: 0,0:05:10.70,0:05:13.17,DefaultSingle-T,,0,0,0,,		看得我都想養了
Dialogue: 0,0:05:13.30,0:05:14.27,DefaultSingle-T,,0,0,0,,		那個人是…
Dialogue: 0,0:05:14.27,0:05:16.12,DefaultSingle-T,,0,0,0,,		瘋狂科學家老爺爺
Dialogue: 0,0:05:16.30,0:05:18.29,DefaultSingle-T,,0,0,0,,		難道是來買實驗動物的？
Dialogue: 0,0:05:18.47,0:05:19.51,DefaultSingle-T,,0,0,0,,		也行啊
Dialogue: 0,0:05:19.51,0:05:22.16,DefaultSingle-T,,0,0,0,,		帶著狗散步說不定就能瘦下來了
Dialogue: 0,0:05:23.52,0:05:25.09,DefaultSingle-T,,0,0,0,,		小哀說得對
Dialogue: 0,0:05:25.24,0:05:28.91,DefaultSingle-T,,0,0,0,,		你也努力努力把你這大肚腩減下去吧
Dialogue: 0,0:05:29.17,0:05:31.92,DefaultSingle-T,,0,0,0,,		你又沒老婆會照顧你的健康
Dialogue: 0,0:05:33.16,0:05:34.99,DefaultSingle-T,,0,0,0,,		小哀說得對
Dialogue: 0,0:05:35.08,0:05:37.32,DefaultSingle-T,,0,0,0,,		養哪隻呢
Dialogue: 0,0:05:37.52,0:05:39.35,DefaultSingle-T,,0,0,0,,		還是要選…
Dialogue: 0,0:05:39.69,0:05:41.63,DefaultSingle-T,,0,0,0,,		最可愛的…
Dialogue: 0,0:05:41.72,0:05:43.88,DefaultSingle-T,,0,0,0,,		毛茸茸的…
Dialogue: 0,0:05:43.97,0:05:46.21,DefaultSingle-T,,0,0,0,,		博…美…
Dialogue: 0,0:05:46.21,0:05:49.21,DefaultSingle-T,,0,0,0,,		等一下
Dialogue: 0,0:05:51.41,0:05:52.11,DefaultSingle-T,,0,0,0,,		你是說
Dialogue: 0,0:05:52.26,0:05:57.41,DefaultSingle-T,,0,0,0,,		你想從可能染指重大犯罪的老人手中保護小狗嗎
Dialogue: 0,0:05:57.53,0:06:01.46,DefaultSingle-T,,0,0,0,,		我當然會幫你  畢竟你在幫我照顧華生
Dialogue: 0,0:06:01.74,0:06:04.28,DefaultSingle-T,,0,0,0,,		今年之內把錢還給我就行
Dialogue: 0,0:06:04.28,0:06:05.26,DefaultSingle-T,,0,0,0,,		要是沒還…
Dialogue: 0,0:06:05.63,0:06:07.68,DefaultSingle-T,,0,0,0,,		我父親可是警視總監
Dialogue: 0,0:06:16.58,0:06:18.51,DefaultSingle-T,,0,0,0,,		你看好了  博美太郎
Dialogue: 0,0:06:18.89,0:06:20.13,DefaultSingle-T,,0,0,0,,		這就是鑰匙
Dialogue: 0,0:06:20.18,0:06:21.73,DefaultSingle-T,,0,0,0,,		把這個叼給我
Dialogue: 0,0:06:46.62,0:06:50.43,DefaultSingle-T,,0,0,0,,		這小傢伙
Dialogue: 0,0:06:58.54,0:07:00.16,DefaultSingle-T,,0,0,0,,		我瘦了沒
Dialogue: 0,0:08:34.72,0:08:36.40,DefaultSingle-T,,0,0,0,,		下集的主題是時尚啊
Dialogue: 0,0:08:38.75,0:08:41.43,DefaultSingle-T,,0,0,0,,		登場角色是穿著黑色系衣服的長髮男人
Dialogue: 0,0:08:44.31,0:08:46.27,DefaultSingle-T,,0,0,0,,		還有當地很有名的三重面孔男人
Dialogue: 0,0:08:46.27,0:08:47.30,DefaultSingle-T,,0,0,0,,		那標題是？
Dialogue: 0,0:08:49.32,0:08:50.92,DefaultSingle-T,,0,0,0,,		這標題還真有趣
Dialogue: 0,0:08:51.37,0:08:53.97,DefaultSingle-T,,0,0,0,,		是誰說這次預告在偷懶了
Dialogue: 0,0:08:53.97,0:08:55.92,DefaultSingle-T,,0,0,0,,		這不是偷懶  是在給粉絲送福利
Dialogue: 0,0:08:55.92,0:08:57.38,DefaultSingle-T,,0,0,0,,		下集也要看哦
Dialogue: 0,0:01:39.37,0:01:42.37,DefaultSingle-T,,0,0,0,,

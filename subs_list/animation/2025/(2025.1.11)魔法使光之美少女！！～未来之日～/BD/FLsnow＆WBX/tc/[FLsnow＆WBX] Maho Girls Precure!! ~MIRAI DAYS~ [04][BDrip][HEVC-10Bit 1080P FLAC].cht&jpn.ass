Dialogue: 0,0:00:05.47,0:00:06.70,Ha_Chan_JP,,0,0,0,,キュアップ・ラパパ！
Dialogue: 0,0:00:05.47,0:00:06.70,Curerpp_FL,,0,0,0,,CURE UP·RAPAPA !
Dialogue: 0,0:00:07.42,0:00:09.38,Ha_Chan_JP,,0,0,0,,石よ 浮け！
Dialogue: 0,0:00:07.42,0:00:09.38,Ha_Chan_CN,,0,0,0,,石頭啊 浮起來！
Dialogue: 0,0:00:12.62,0:00:13.50,Ha_Chan_JP,,0,0,0,,ほら！
Dialogue: 0,0:00:12.62,0:00:13.50,Ha_Chan_CN,,0,0,0,,喂！
Dialogue: 0,0:00:13.72,0:00:15.01,Miracle_JP,,0,0,0,,はい はい...
Dialogue: 0,0:00:13.72,0:00:15.01,Miracle_CN,,0,0,0,,好好...
Dialogue: 0,0:00:15.20,0:00:16.32,Miracle_JP,,0,0,0,,キュアップ・ラパパ！
Dialogue: 0,0:00:15.20,0:00:16.32,Curerpp_MR,,0,0,0,,CURE UP·RAPAPA !
Dialogue: 0,0:00:16.38,0:00:17.51,Miracle_JP,,0,0,0,,石よ 浮け
Dialogue: 0,0:00:16.38,0:00:17.51,Miracle_CN,,0,0,0,,石頭啊 浮起來
Dialogue: 0,0:00:21.56,0:00:25.24,Ha_Chan_JP,,0,0,0,,遅い もっとひーちゃんが 浮かせてるみたくして
Dialogue: 0,0:00:21.56,0:00:25.24,Ha_Chan_CN,,0,0,0,,太慢了 要弄得像小菲讓浮起來的
Dialogue: 0,0:00:26.18,0:00:28.59,Magical_JP,,0,0,0,,魔法使いごっこも 大変ね
Dialogue: 0,0:00:26.18,0:00:28.59,Magical_CN,,0,0,0,,魔法師遊戲 也不容易啊
Dialogue: 0,0:00:28.79,0:00:30.72,Miracle_JP,,0,0,0,,リコも頼むよ
Dialogue: 0,0:00:28.79,0:00:30.72,Miracle_CN,,0,0,0,,李可也來幫幫忙嘛
Dialogue: 0,0:00:30.96,0:00:35.81,Magical_JP,,0,0,0,,あなたが言ったんでしょ ひーちゃんの代わりに魔法を使ってあげるって
Dialogue: 0,0:00:30.96,0:00:35.81,Magical_CN,,0,0,0,,是你自己說的吧 要代替小菲來幫她施魔法
Dialogue: 0,0:00:36.43,0:00:38.26,Miracle_JP,,0,0,0,,そうだけどさ
Dialogue: 0,0:00:36.43,0:00:38.26,Miracle_CN,,0,0,0,,話是這麼說
Dialogue: 0,0:00:38.71,0:00:40.48,Miracle_JP,,0,0,0,,さっきから何見てるの？
Dialogue: 0,0:00:38.71,0:00:40.48,Miracle_CN,,0,0,0,,從剛才起 你都在看什麼？
Dialogue: 0,0:00:40.68,0:00:42.22,Magical_JP,,0,0,0,,ネットで見つけた写真
Dialogue: 0,0:00:40.68,0:00:42.22,Magical_CN,,0,0,0,,在網路上搜到的照片
Dialogue: 0,0:00:43.66,0:00:46.16,Miracle_JP,,0,0,0,,エプロン姿ね
Dialogue: 0,0:00:43.66,0:00:46.16,Miracle_CN,,0,0,0,,穿著圍裙的呢
Dialogue: 0,0:00:46.16,0:00:48.16,Miracle_CN,,0,0,0,,
Dialogue: 0,0:02:26.86,0:02:30.30,Miracle_JP,,0,0,0,,私の見たイメージでは 本棚の前にいた
Dialogue: 0,0:02:26.86,0:02:30.30,Miracle_CN,,0,0,0,,我所見到的幻象 是在書架前面
Dialogue: 0,0:02:31.13,0:02:33.04,Magical_JP,,0,0,0,,エプロンに本棚か
Dialogue: 0,0:02:31.13,0:02:33.04,Magical_CN,,0,0,0,,圍裙加書架啊
Dialogue: 0,0:02:33.47,0:02:35.23,Mofurun_JP,,0,0,0,,本屋さんの人モフ？
Dialogue: 0,0:02:33.47,0:02:35.23,Mofurun_CN,,0,0,0,,是書店員工嗎？
Dialogue: 0,0:02:35.55,0:02:37.41,Magical_JP,,0,0,0,,あっ その線あるかも
Dialogue: 0,0:02:35.55,0:02:37.41,Magical_CN,,0,0,0,,啊 有這種可能
Dialogue: 0,0:02:37.86,0:02:40.98,Magical_JP,,0,0,0,,本屋さんを回って行けば この人に辿り着く
Dialogue: 0,0:02:37.86,0:02:40.98,Magical_CN,,0,0,0,,搜遍書店的話 就能找到他吧
Dialogue: 0,0:02:41.40,0:02:42.36,Ha_Chan_JP,,0,0,0,,見せて！
Dialogue: 0,0:02:41.40,0:02:42.36,Ha_Chan_CN,,0,0,0,,給我看看！
Dialogue: 0,0:02:42.50,0:02:44.78,Magical_JP,,0,0,0,,勝手に取らないでって言ったでしょ！
Dialogue: 0,0:02:42.50,0:02:44.78,Magical_CN,,0,0,0,,都說了 不能擅自拿走啊！
Dialogue: 0,0:02:45.46,0:02:50.22,Magical_JP,,0,0,0,,子供のスマホの扱いには注意が必要って ネットにあったわ！
Dialogue: 0,0:02:45.46,0:02:50.22,Magical_CN,,0,0,0,,我在網路上看過 要嚴控小孩子使用智慧機！
Dialogue: 0,0:02:51.08,0:02:53.01,Ha_Chan_JP,,0,0,0,,なんで子供はダメなの？
Dialogue: 0,0:02:51.08,0:02:53.01,Ha_Chan_CN,,0,0,0,,為什麼小孩子不行？
Comment: 0,0:02:53.28,0:02:58.25,Magical_JP,,0,0,0,,↓ check 在网上看到网络？
Dialogue: 0,0:02:53.28,0:02:58.25,Magical_JP,,0,0,0,,ゲームにネットとか 色んな誘惑があるからって ネットに出てた
Dialogue: 0,0:02:53.28,0:02:58.25,Magical_CN,,0,0,0,,我在網路上看到 遊戲啊網路啊之類的 有很多誘人上癮的東西
Dialogue: 0,0:02:58.88,0:03:01.86,Ha_Chan_JP,,0,0,0,,ネットネットって リコの方がネットじゃん
Dialogue: 0,0:02:58.88,0:03:01.86,Ha_Chan_CN,,0,0,0,,開口閉口都是網路 李可才是有網癮了吧
Dialogue: 0,0:03:02.45,0:03:05.65,Magical_JP,,0,0,0,,ああ言えばこう言う 反抗期かしら
Dialogue: 0,0:03:02.45,0:03:05.65,Magical_CN,,0,0,0,,唉 這種情況 是不是叛逆期啊
Dialogue: 0,0:03:06.08,0:03:07.80,Magical_JP,,0,0,0,,だから返しなさいって
Dialogue: 0,0:03:06.08,0:03:07.80,Magical_CN,,0,0,0,,你先還給我
Dialogue: 0,0:03:11.13,0:03:12.62,Ha_Chan_JP,,0,0,0,,ねえ この人...
Dialogue: 0,0:03:11.13,0:03:12.62,Ha_Chan_CN,,0,0,0,,我問你 這個人...
Dialogue: 0,0:03:13.08,0:03:14.25,Mofurun_JP,,0,0,0,,はーちゃんモフ
Dialogue: 0,0:03:13.08,0:03:14.25,Mofurun_CN,,0,0,0,,是小哈
Dialogue: 0,0:03:14.56,0:03:17.44,Miracle_JP,,0,0,0,,昔の写真をリコに送ってあげたんだ
Dialogue: 0,0:03:14.56,0:03:17.44,Miracle_CN,,0,0,0,,我把以前的照片 發給李可了
Dialogue: 0,0:03:20.82,0:03:24.25,Mofurun_JP,,0,0,0,,やっぱり はーちゃんとひーちゃん そっくりモフ
Dialogue: 0,0:03:20.82,0:03:24.25,Mofurun_CN,,0,0,0,,小哈真的跟小菲一模一樣
Dialogue: 0,0:03:24.29,0:03:25.92,Ha_Chan_JP,,0,0,0,,全然似てないし！
Dialogue: 0,0:03:24.29,0:03:25.92,Ha_Chan_CN,,0,0,0,,一點都不像！
Dialogue: 0,0:03:26.26,0:03:28.10,Miracle_JP,,0,0,0,,やっぱり反抗期かな
Dialogue: 0,0:03:26.26,0:03:28.10,Miracle_CN,,0,0,0,,果然是叛逆期吧
Dialogue: 0,0:03:28.10,0:03:28.70,Default_JP,,0,0,0,,（アラーム）
Dialogue: 0,0:03:28.10,0:03:28.70,Default_CN,,0,0,0,,（提示音）
Dialogue: 0,0:03:28.78,0:03:29.40,Mofurun_JP,,0,0,0,,モフ！
Dialogue: 0,0:03:28.78,0:03:29.40,Mofurun_CN,,0,0,0,,mofu！
Dialogue: 0,0:03:30.27,0:03:32.36,Mofurun_JP,,0,0,0,,魔法ガールを呼んでるモフ
Dialogue: 0,0:03:30.27,0:03:32.36,Mofurun_CN,,0,0,0,,大家在呼喚魔法少女
Dialogue: 0,0:03:32.35,0:03:34.36,Default_CN,,0,0,30,,{\an8}#幫幫我 魔法師
Dialogue: 0,0:03:32.76,0:03:34.36,Miracle_JP,,0,0,0,,魔法ガール 出動だね
Dialogue: 0,0:03:32.76,0:03:34.36,Miracle_CN,,0,0,0,,該魔法少女出動了
Dialogue: 0,0:03:34.80,0:03:38.35,Magical_JP,,0,0,0,,本屋さんは？アイルって人 探さないと
Dialogue: 0,0:03:34.80,0:03:38.35,Magical_CN,,0,0,0,,書店呢？我們還得找那個叫埃路的人
Dialogue: 0,0:03:38.70,0:03:39.22,Miracle_JP,,0,0,0,,うん...
Dialogue: 0,0:03:38.70,0:03:39.22,Miracle_CN,,0,0,0,,嗯...
Dialogue: 0,0:03:39.47,0:03:41.39,Ha_Chan_JP,,0,0,0,,魔法使いごっこは？
Dialogue: 0,0:03:39.47,0:03:41.39,Ha_Chan_CN,,0,0,0,,魔法師遊戲呢？
Dialogue: 0,0:03:41.50,0:03:46.33,Miracle_JP,,0,0,0,,うん でも やっぱりごめん 行かないと 困ってる人がいるからさ
Dialogue: 0,0:03:41.50,0:03:46.33,Miracle_CN,,0,0,0,,我知道 但是抱歉 我還是要去的 因為有人遇到了麻煩
Dialogue: 0,0:03:46.92,0:03:47.53,Magical_JP,,0,0,0,,ん？
Dialogue: 0,0:03:46.92,0:03:47.53,Magical_CN,,0,0,0,,嗯？
Dialogue: 0,0:03:50.64,0:03:52.04,Mofurun_JP,,0,0,0,,どうしたモフ？
Dialogue: 0,0:03:50.64,0:03:52.04,Mofurun_CN,,0,0,0,,怎麼了？
Dialogue: 0,0:03:52.41,0:03:54.24,Magical_JP,,0,0,0,,ううん なんでも
Dialogue: 0,0:03:52.41,0:03:54.24,Magical_CN,,0,0,0,,不 沒什麼
Dialogue: 0,0:03:57.42,0:03:59.42,Default_CN,,0,0,0,,
Dialogue: 0,0:03:59.92,0:04:04.84,Default_CN,,0,0,300,,{\fad(500,0)}翡翠的秘密
Dialogue: 0,0:04:04.45,0:04:06.45,Default_CN,,0,0,0,,
Dialogue: 0,0:04:09.28,0:04:11.56,Miracle_JP,,0,0,0,,依頼によっては危ないんだよ
Dialogue: 0,0:04:09.28,0:04:11.56,Miracle_CN,,0,0,0,,視委託的情況 也會有危險的
Dialogue: 0,0:04:12.12,0:04:15.89,Miracle_JP,,0,0,0,,火事の現場だったり 強盗犯追っかけたりでさぁ
Dialogue: 0,0:04:12.12,0:04:15.89,Miracle_CN,,0,0,0,,比如火災現場 和追捕強盜
Dialogue: 0,0:04:16.11,0:04:17.65,Ha_Chan_JP,,0,0,0,,いやだ 行くもん！
Dialogue: 0,0:04:16.11,0:04:17.65,Ha_Chan_CN,,0,0,0,,不要 我要去！
Dialogue: 0,0:04:18.29,0:04:20.93,Magical_JP,,0,0,0,,いいわ 私が引率するから
Dialogue: 0,0:04:18.29,0:04:20.93,Magical_CN,,0,0,0,,好吧 我來帶隊
Dialogue: 0,0:04:21.25,0:04:23.69,Miracle_JP,,0,0,0,,引率か さすが先生
Dialogue: 0,0:04:21.25,0:04:23.69,Miracle_CN,,0,0,0,,帶隊啊 不愧是老師
Dialogue: 0,0:04:24.30,0:04:28.25,Magical_JP,,0,0,0,,早く依頼を解決して あの人を探さないと
Dialogue: 0,0:04:24.30,0:04:28.25,Magical_CN,,0,0,0,,趕快解決委託 必須要去找那個人的
Dialogue: 0,0:04:28.56,0:04:31.61,Miracle_JP,,0,0,0,,で 今日の助けて魔法使いはなんなの？
Dialogue: 0,0:04:28.56,0:04:31.61,Miracle_CN,,0,0,0,,那麼 今天的求助委託 是什麼內容？
Dialogue: 0,0:04:32.20,0:04:37.44,Mofurun_JP,,0,0,0,,飼ってる猫を探して欲しいって 10歳の女の子のお願いモフ
Dialogue: 0,0:04:32.20,0:04:37.44,Mofurun_CN,,0,0,0,,是一位10歲女孩的請求 希望尋找她飼養的貓
Dialogue: 0,0:04:38.64,0:04:44.17,Default_CN,,0,0,30,,{\an8}{\fs50}Damper 神奇的名字... （喜歡的食物和喜歡的地方與劇情相關）
Dialogue: 0,0:04:38.64,0:04:44.17,Mofurun_JP,,0,0,0,,ダンパちゃん 4さい 大人しい 性格の女の子だそうモフ
Dialogue: 0,0:04:38.64,0:04:44.17,Mofurun_CN,,0,0,0,,上面說... 名字叫丹帕 4歲 是性格靜怡的女孩子
Dialogue: 0,0:04:44.80,0:04:47.37,Magical_JP,,0,0,0,,情報も文章もしっかりしてる
Dialogue: 0,0:04:44.80,0:04:47.37,Magical_CN,,0,0,0,,情報和資料都寫得很詳細
Dialogue: 0,0:04:47.96,0:04:50.14,Ha_Chan_JP,,0,0,0,,ひーちゃんと違うって言うんでしょ
Dialogue: 0,0:04:47.96,0:04:50.14,Ha_Chan_CN,,0,0,0,,你想說 跟小菲不一樣 是吧
Dialogue: 0,0:04:50.36,0:04:52.13,Magical_JP,,0,0,0,,そんなこと言ってないし
Dialogue: 0,0:04:50.36,0:04:52.13,Magical_CN,,0,0,0,,我又沒這麼說
Dialogue: 0,0:04:52.53,0:04:54.36,Ha_Chan_JP,,0,0,0,,言わなくても思ってるよ！
Dialogue: 0,0:04:52.53,0:04:54.36,Ha_Chan_CN,,0,0,0,,是沒說 但你就是這個意思！
Dialogue: 0,0:04:55.78,0:04:57.42,Mofurun_JP,,0,0,0,,やっぱりパンケーキモフ
Dialogue: 0,0:04:55.78,0:04:57.42,Mofurun_CN,,0,0,0,,果然是烤餅器啊
Dialogue: 0,0:04:55.78,0:04:57.42,Mofurun_CN,,0,0,0,,{\fs50\pos(1025,920)}烤鬆餅
Dialogue: 0,0:04:57.74,0:04:59.61,Miracle_JP,,0,0,0,,それを言うなら反抗期
Dialogue: 0,0:04:57.74,0:04:59.61,Miracle_CN,,0,0,0,,那叫叛逆期
Dialogue: 0,0:05:00.33,0:05:03.42,Magical_JP,,0,0,0,,でもどうなのかしら スマホで依頼とか
Dialogue: 0,0:05:00.33,0:05:03.42,Magical_CN,,0,0,0,,有一說一 該怎麼處理 這位用手機委託的小朋友
Dialogue: 0,0:05:03.79,0:05:07.98,Magical_JP,,0,0,0,,親御さんがしっかり管理しないと 誰とつながるか分からないし
Dialogue: 0,0:05:03.79,0:05:07.98,Magical_CN,,0,0,0,,父母不嚴格管理的話 都不知道會連結到什麼人
Dialogue: 0,0:05:08.08,0:05:10.08,Mofurun_JP,,0,0,0,,リコ先生になってるモフ
Dialogue: 0,0:05:08.08,0:05:10.08,Mofurun_CN,,0,0,0,,進入李可老師狀態了
Dialogue: 0,0:05:10.36,0:05:15.73,Miracle_JP,,0,0,0,,うん 一石を投じるのは後にして まずはダンパちゃんを探そうか
Dialogue: 0,0:05:10.36,0:05:15.73,Miracle_CN,,0,0,0,,嗯 等會再來探討這問題 先找到丹帕吧
Dialogue: 0,0:05:10.36,0:05:15.73,Miracle_CN,,0,0,0,,{\fs50\pos(990,920)}這投石起的漣漪
Dialogue: 0,0:05:16.21,0:05:16.83,MagiMiraJP,,0,0,0,,おっ...
Dialogue: 0,0:05:16.21,0:05:16.83,MagiMiraCN,,0,0,0,,哦...
Dialogue: 0,0:05:16.88,0:05:18.02,Ha_Chan_JP,,0,0,0,,ひーちゃん見つける！
Dialogue: 0,0:05:16.88,0:05:18.02,Ha_Chan_CN,,0,0,0,,小菲去找！
Dialogue: 0,0:05:18.97,0:05:21.57,Ha_Chan_JP,,0,0,0,,ひーちゃん この子より凄いんだから
Dialogue: 0,0:05:18.97,0:05:21.57,Ha_Chan_CN,,0,0,0,,因為小菲比這個女孩子更厲害！
Dialogue: 0,0:05:24.18,0:05:25.43,Ha_Chan_JP,,0,0,0,,キュアップ・ラパパ！
Dialogue: 0,0:05:24.18,0:05:25.43,Curerpp_FL,,0,0,0,,CURE UP·RAPAPA !
Dialogue: 0,0:05:26.34,0:05:27.86,Ha_Chan_JP,,0,0,0,,猫よ 話して！
Dialogue: 0,0:05:26.34,0:05:27.86,Ha_Chan_CN,,0,0,0,,貓啊 說話！
Dialogue: 0,0:05:29.97,0:05:31.34,Ha_Chan_JP,,0,0,0,,猫とお話し
Dialogue: 0,0:05:29.97,0:05:31.34,Ha_Chan_CN,,0,0,0,,我要跟貓說話
Dialogue: 0,0:05:32.56,0:05:33.65,Miracle_JP,,0,0,0,,はい はい
Dialogue: 0,0:05:32.56,0:05:33.65,Miracle_CN,,0,0,0,,好好
Dialogue: 0,0:05:33.82,0:05:35.06,Miracle_JP,,0,0,0,,キュアップ・ラパパ！
Dialogue: 0,0:05:33.82,0:05:35.06,Curerpp_MR,,0,0,0,,CURE UP·RAPAPA !
Dialogue: 0,0:05:35.28,0:05:37.10,Miracle_JP,,0,0,0,,猫よ お話しなさい
Dialogue: 0,0:05:35.28,0:05:37.10,Miracle_CN,,0,0,0,,貓啊 說話吧
Dialogue: 0,0:05:38.01,0:05:39.72,Ha_Chan_JP,,0,0,0,,モフルン 猫の写真
Dialogue: 0,0:05:38.01,0:05:39.72,Ha_Chan_CN,,0,0,0,,莫夫倫 貓的照片
Dialogue: 0,0:05:40.17,0:05:40.93,Mofurun_JP,,0,0,0,,モフ
Dialogue: 0,0:05:40.17,0:05:40.93,Mofurun_CN,,0,0,0,,mofu
Dialogue: 0,0:05:41.45,0:05:42.94,Default_JP,,0,0,0,,うん 知ってる
Dialogue: 0,0:05:41.45,0:05:42.94,Default_CN,,0,0,0,,喵 我知道
Dialogue: 0,0:05:43.39,0:05:44.05,Ha_Chan_JP,,0,0,0,,ほんとう？
Dialogue: 0,0:05:43.39,0:05:44.05,Ha_Chan_CN,,0,0,0,,真的？
Dialogue: 0,0:05:44.56,0:05:47.08,Default_JP,,0,0,0,,でも この数日は見てないにゃ
Dialogue: 0,0:05:44.56,0:05:47.08,Default_CN,,0,0,0,,不過 有幾天沒見到了呢
Dialogue: 0,0:05:48.06,0:05:50.45,Miracle_JP,,0,0,0,,どっか 行きそうなところないかな？
Dialogue: 0,0:05:48.06,0:05:50.45,Miracle_CN,,0,0,0,,你知道她會去的地方嗎？
Dialogue: 0,0:05:51.05,0:05:54.81,Default_JP,,0,0,0,,さあ 会って挨拶するぐらいの間柄だし
Dialogue: 0,0:05:51.05,0:05:54.81,Default_CN,,0,0,0,,不知道 我們也就是混個臉熟 打個招呼的關係
Dialogue: 0,0:06:04.70,0:06:06.22,Magical_JP,,0,0,0,,いないわね
Dialogue: 0,0:06:04.70,0:06:06.22,Magical_CN,,0,0,0,,沒有呢
Dialogue: 0,0:06:06.93,0:06:08.18,Ha_Chan_JP,,0,0,0,,キュアップ・ラパパ！
Dialogue: 0,0:06:06.93,0:06:08.18,Curerpp_FL,,0,0,0,,CURE UP·RAPAPA !
Dialogue: 0,0:06:08.37,0:06:10.22,Ha_Chan_JP,,0,0,0,,赤いこれ お話しして
Dialogue: 0,0:06:08.37,0:06:10.22,Ha_Chan_CN,,0,0,0,,紅色的 說話吧！
Dialogue: 0,0:06:10.81,0:06:12.78,Magical_JP,,0,0,0,,ポストを喋らせるのは無理
Dialogue: 0,0:06:10.81,0:06:12.78,Magical_CN,,0,0,0,,讓郵筒說話 是不可能的
Dialogue: 0,0:06:13.29,0:06:14.99,Magical_JP,,0,0,0,,生き物じゃないから
Dialogue: 0,0:06:13.29,0:06:14.99,Magical_CN,,0,0,0,,畢竟不是生物
Dialogue: 0,0:06:15.71,0:06:18.18,Miracle_JP,,0,0,0,,あっ...あっ うん...
Dialogue: 0,0:06:15.71,0:06:18.18,Miracle_CN,,0,0,0,,啊...嗯...
Dialogue: 0,0:06:19.21,0:06:21.20,Miracle_JP,,0,0,0,,違ったな この格好
Dialogue: 0,0:06:19.21,0:06:21.20,Miracle_CN,,0,0,0,,不該穿這一身的
Dialogue: 0,0:06:21.90,0:06:25.55,Miracle_JP,,0,0,0,,まさか こんな地味な捜索をしてるとは思わなかった
Dialogue: 0,0:06:21.90,0:06:25.55,Miracle_CN,,0,0,0,,我沒想到 是這麼傳統的搜索方式
Dialogue: 0,0:06:26.22,0:06:27.49,Mofurun_JP,,0,0,0,,目立ってるモフ
Dialogue: 0,0:06:26.22,0:06:27.49,Mofurun_CN,,0,0,0,,很惹眼吧
Dialogue: 0,0:06:27.72,0:06:29.88,Magical_JP,,0,0,0,,魔法ガールって バレてるんじゃない？
Dialogue: 0,0:06:27.72,0:06:29.88,Magical_CN,,0,0,0,,魔法少女的事 不會暴露吧？
Dialogue: 0,0:06:30.21,0:06:34.86,Miracle_JP,,0,0,0,,大丈夫 人前で魔法使わなければ バレない バレない
Dialogue: 0,0:06:30.21,0:06:34.86,Miracle_CN,,0,0,0,,沒事的 只要不當面使用魔法 不會暴露的 不會的
Dialogue: 0,0:06:35.05,0:06:35.40,Magical_JP,,0,0,0,,うん...
Dialogue: 0,0:06:35.05,0:06:35.40,Magical_CN,,0,0,0,,嗯...
Dialogue: 0,0:06:35.46,0:06:37.60,Miracle_JP,,0,0,0,,コスプレ好きな大学生って事で
Dialogue: 0,0:06:35.46,0:06:37.60,Miracle_CN,,0,0,0,,只會覺得我是一個喜歡Cosplay的大學生
Dialogue: 0,0:06:37.75,0:06:38.38,Ha_Chan_JP,,0,0,0,,そう？
Dialogue: 0,0:06:37.75,0:06:38.38,Ha_Chan_CN,,0,0,0,,是嗎？
Dialogue: 0,0:06:38.57,0:06:40.33,Ha_Chan_JP,,0,0,0,,あの人 すっごく見てるよ
Dialogue: 0,0:06:38.57,0:06:40.33,Ha_Chan_CN,,0,0,0,,那個人一直盯著看哦
Dialogue: 0,0:06:40.54,0:06:41.41,MagiMiraJP,,0,0,0,,おっ...
Dialogue: 0,0:06:40.54,0:06:41.41,MagiMiraCN,,0,0,0,,嗯...
Dialogue: 0,0:06:48.49,0:06:49.74,Miracle_JP,,0,0,0,,かな まゆみ！？
Dialogue: 0,0:06:48.49,0:06:49.74,Miracle_CN,,0,0,0,,加奈 真弓？！
Dialogue: 0,0:06:49.85,0:06:50.94,Magical_JP,,0,0,0,,本当だわ
Dialogue: 0,0:06:49.85,0:06:50.94,Magical_CN,,0,0,0,,真的欸
Dialogue: 0,0:06:53.40,0:06:54.65,Default_JP,,0,0,0,,みらいとリコだ
Dialogue: 0,0:06:53.40,0:06:54.65,Default_CN,,0,0,0,,是未來和李可
Dialogue: 0,0:06:54.84,0:06:55.46,Default_JP,,0,0,0,,えっ？
Dialogue: 0,0:06:54.84,0:06:55.46,Default_CN,,0,0,0,,欸？
Dialogue: 0,0:06:55.73,0:06:56.50,Miracle_JP,,0,0,0,,ヤバっ！
Dialogue: 0,0:06:55.73,0:06:56.50,Miracle_CN,,0,0,0,,完蛋！
Dialogue: 0,0:06:59.52,0:07:01.98,Default_JP,,0,0,0,,あれ？今いたの！
Dialogue: 0,0:06:59.52,0:07:01.98,Default_CN,,0,0,0,,咦？剛剛還在的！
Dialogue: 0,0:07:02.59,0:07:04.70,Default_JP,,0,0,0,,ホントに？どこ？
Dialogue: 0,0:07:02.59,0:07:04.70,Default_CN,,0,0,0,,真的嗎？在哪裡？
Dialogue: 0,0:07:04.79,0:07:08.90,Default_JP,,0,0,0,,本当にいたんだよ！魔法使いの格好をしたみらいとリコ！
Dialogue: 0,0:07:04.79,0:07:08.90,Default_CN,,0,0,0,,真的在那裡！打扮成魔法師的未來和李可！
Dialogue: 0,0:07:08.90,0:07:11.14,Default_JP,,0,0,0,,あと はーちゃんにそっくりな子も！
Dialogue: 0,0:07:08.90,0:07:11.14,Default_CN,,0,0,0,,還有一個很像小哈的女孩子！
Dialogue: 0,0:07:13.47,0:07:15.77,Default_JP,,0,0,0,,この感じ 懐かしいかも
Dialogue: 0,0:07:13.47,0:07:15.77,Default_CN,,0,0,0,,這感覺 有些懷念啊
Dialogue: 0,0:07:16.72,0:07:19.54,Magical_JP,,0,0,0,,まゆみとかな ずっと会ってないのに
Dialogue: 0,0:07:16.72,0:07:19.54,Magical_CN,,0,0,0,,都還沒去見過真弓和加奈呢
Dialogue: 0,0:07:19.65,0:07:21.94,Miracle_JP,,0,0,0,,この格好じゃ会えないって
Dialogue: 0,0:07:19.65,0:07:21.94,Miracle_CN,,0,0,0,,打扮成這樣 怎麼可能去見啊
Dialogue: 0,0:07:22.19,0:07:25.11,Magical_JP,,0,0,0,,制服着て活動するから こうなるんでしょ
Dialogue: 0,0:07:22.19,0:07:25.11,Magical_CN,,0,0,0,,誰讓你要穿制服活動的 活該
Dialogue: 0,0:07:26.22,0:07:29.55,Mofurun_JP,,0,0,0,,ケンカはやめるモフ ひーちゃんが見てるモフ！
Dialogue: 0,0:07:26.22,0:07:29.55,Mofurun_CN,,0,0,0,,不能吵架 小菲在看著呢！
Dialogue: 0,0:07:29.94,0:07:31.98,Mofurun_JP,,0,0,0,,子供の前でやめるモフ
Dialogue: 0,0:07:29.94,0:07:31.98,Mofurun_CN,,0,0,0,,別當著孩子的面
Dialogue: 0,0:07:32.37,0:07:33.78,Ha_Chan_JP,,0,0,0,,って 子供じゃないし！
Dialogue: 0,0:07:32.37,0:07:33.78,Ha_Chan_CN,,0,0,0,,我才不是小孩子！
Dialogue: 0,0:07:34.26,0:07:34.99,Mofurun_JP,,0,0,0,,モフ？
Dialogue: 0,0:07:34.26,0:07:34.99,Mofurun_CN,,0,0,0,,mofu？
Dialogue: 0,0:07:35.21,0:07:36.42,Ha_Chan_JP,,0,0,0,,もう お姉ちゃんだもん
Dialogue: 0,0:07:35.21,0:07:36.42,Ha_Chan_CN,,0,0,0,,我已經是姐姐了
Dialogue: 0,0:07:37.01,0:07:40.46,Miracle_JP,,0,0,0,,ちょっと待った とにかく今は ダンパちゃんを探そう
Dialogue: 0,0:07:37.01,0:07:40.46,Miracle_CN,,0,0,0,,別吵了 現在先要找到丹帕
Dialogue: 0,0:07:40.76,0:07:43.84,Miracle_JP,,0,0,0,,飼い主さん ダンパちゃんいなくて寂しがってるよ
Dialogue: 0,0:07:40.76,0:07:43.84,Miracle_CN,,0,0,0,,因為丹帕不在了 飼主肯定很難過
Dialogue: 0,0:07:44.05,0:07:47.56,Magical_JP,,0,0,0,,そうね でも この調子で見つかるとは
Dialogue: 0,0:07:44.05,0:07:47.56,Magical_CN,,0,0,0,,是啊 但就現在這個狀態 能找到嗎
Dialogue: 0,0:07:48.26,0:07:49.11,Miracle_JP,,0,0,0,,大丈夫
Dialogue: 0,0:07:48.26,0:07:49.11,Miracle_CN,,0,0,0,,放心吧
Dialogue: 0,0:07:50.13,0:07:56.08,Miracle_JP,,0,0,0,,数々の難事件 大事件を解決してきた 魔法ガールみらいに任せて！
Dialogue: 0,0:07:50.13,0:07:56.08,Miracle_CN,,0,0,0,,交給解決了種種疑難事件 重大事件的魔法少女·未來吧！
Dialogue: 0,0:07:58.79,0:08:01.12,Default_CN,,0,0,30,,{\an8}貓貓飯
Dialogue: 0,0:08:08.84,0:08:09.92,Default_CN,,0,0,30,,{\an8}格力高 明治... 打錢！
Dialogue: 0,0:08:10.04,0:08:10.96,Ha_Chan_JP,,0,0,0,,これも！
Dialogue: 0,0:08:10.04,0:08:10.96,Ha_Chan_CN,,0,0,0,,還有這些！
Dialogue: 0,0:08:12.08,0:08:13.34,Miracle_JP,,0,0,0,,ありがとう！
Dialogue: 0,0:08:12.08,0:08:13.34,Miracle_CN,,0,0,0,,謝謝！
Dialogue: 0,0:08:13.74,0:08:18.38,Magical_JP,,0,0,0,,ありがとうじゃないでしょ なんで私が買いに行かされてるの
Dialogue: 0,0:08:13.74,0:08:18.38,Magical_CN,,0,0,0,,我才是真的會謝 為什麼讓我去跑腿
Dialogue: 0,0:08:18.80,0:08:20.70,Miracle_JP,,0,0,0,,この格好 目立つから
Dialogue: 0,0:08:18.80,0:08:20.70,Miracle_CN,,0,0,0,,我這身太惹眼了嘛
Dialogue: 0,0:08:20.96,0:08:24.67,Magical_JP,,0,0,0,,はあ？なにが「魔法ガールみらいに任せて！」よ！
Dialogue: 0,0:08:20.96,0:08:24.67,Magical_CN,,0,0,0,,蛤？那你說什麼“就交給魔法少女·未來吧！”
Dialogue: 0,0:08:25.06,0:08:29.24,Mofurun_JP,,0,0,0,,ケンカはやめるモフ！ひーちゃんが見てるモフ！
Dialogue: 0,0:08:25.06,0:08:29.24,Mofurun_CN,,0,0,0,,不能吵架！小菲在看著呢！
Dialogue: 0,0:08:29.48,0:08:30.96,Ha_Chan_JP,,0,0,0,,美味しいな！
Dialogue: 0,0:08:29.48,0:08:30.96,Ha_Chan_CN,,0,0,0,,好吃！
Dialogue: 0,0:08:32.82,0:08:34.40,Mofurun_JP,,0,0,0,,見てなかったモフ...
Dialogue: 0,0:08:32.82,0:08:34.40,Mofurun_CN,,0,0,0,,沒在看...
Dialogue: 0,0:08:35.38,0:08:37.79,Magical_JP,,0,0,0,,ひーちゃんのおやつまで買わされるし
Dialogue: 0,0:08:35.38,0:08:37.79,Magical_CN,,0,0,0,,連小菲的零食都買了
Dialogue: 0,0:08:37.92,0:08:41.72,Miracle_JP,,0,0,0,,まあまあ でも リコのおかげで事件解決だよ
Dialogue: 0,0:08:37.92,0:08:41.72,Miracle_CN,,0,0,0,,消消氣吧 多虧了李可 問題解決了
Dialogue: 0,0:08:42.09,0:08:48.72,Miracle_JP,,0,0,0,,ダンパちゃんが大好きなおやつで おびき寄せれば ダンパちゃんのお気に入りの この公園でね
Dialogue: 0,0:08:42.09,0:08:48.72,Miracle_CN,,0,0,0,,只要在丹帕最喜歡的這座公園 用最喜歡的食物 來誘惑她
Dialogue: 0,0:08:49.13,0:08:52.47,Default_CN,,0,0,30,,{\an8}請勿餵貓
Dialogue: 0,0:08:53.04,0:08:54.57,Miracle_JP,,0,0,0,,なにか他の手は？
Dialogue: 0,0:08:53.04,0:08:54.57,Miracle_CN,,0,0,0,,還有什麼其他方法嗎？
Dialogue: 0,0:08:54.86,0:08:55.92,Magical_JP,,0,0,0,,こらこら！
Dialogue: 0,0:08:54.86,0:08:55.92,Magical_CN,,0,0,0,,喂喂！
Dialogue: 0,0:08:58.28,0:08:59.42,Miracle_JP,,0,0,0,,キュアップ・ラパパ！
Dialogue: 0,0:08:58.28,0:08:59.42,Curerpp_MR,,0,0,0,,CURE UP·RAPAPA !
Dialogue: 0,0:08:59.63,0:09:01.30,Miracle_JP,,0,0,0,,猫よ 止まりなさい！
Dialogue: 0,0:08:59.63,0:09:01.30,Miracle_CN,,0,0,0,,貓啊 等一等！
Dialogue: 0,0:09:04.38,0:09:06.06,Miracle_JP,,0,0,0,,ふーん 惜しい！
Dialogue: 0,0:09:04.38,0:09:06.06,Miracle_CN,,0,0,0,,很像了！
Dialogue: 0,0:09:07.78,0:09:10.44,Magical_JP,,0,0,0,,結局 ああして探すしかないのね
Dialogue: 0,0:09:07.78,0:09:10.44,Magical_CN,,0,0,0,,到頭來 只能地毯式搜索了
Dialogue: 0,0:09:11.64,0:09:13.95,Ha_Chan_JP,,0,0,0,,なんでひーちゃん魔法使えないの？
Dialogue: 0,0:09:11.64,0:09:13.95,Ha_Chan_CN,,0,0,0,,為什麼小菲不能用魔法？
Dialogue: 0,0:09:14.17,0:09:14.81,Magical_JP,,0,0,0,,ん...
Dialogue: 0,0:09:14.17,0:09:14.81,Magical_CN,,0,0,0,,嗯...
Dialogue: 0,0:09:15.44,0:09:17.18,Ha_Chan_JP,,0,0,0,,はーちゃん 使えるんでしょ
Dialogue: 0,0:09:15.44,0:09:17.18,Ha_Chan_CN,,0,0,0,,小哈能用的吧
Dialogue: 0,0:09:17.31,0:09:18.29,Magical_JP,,0,0,0,,まぁ...
Dialogue: 0,0:09:17.31,0:09:18.29,Magical_CN,,0,0,0,,是的...
Dialogue: 0,0:09:18.57,0:09:20.33,Ha_Chan_JP,,0,0,0,,はーちゃん どこにいるの？
Dialogue: 0,0:09:18.57,0:09:20.33,Ha_Chan_CN,,0,0,0,,小哈人在哪裡？
Dialogue: 0,0:09:20.61,0:09:21.71,Magical_JP,,0,0,0,,分からないの
Dialogue: 0,0:09:20.61,0:09:21.71,Magical_CN,,0,0,0,,不知道
Dialogue: 0,0:09:22.34,0:09:26.56,Mofurun_JP,,0,0,0,,きっと モフルンや みんなのことを 見守ってくれてるモフ
Dialogue: 0,0:09:22.34,0:09:26.56,Mofurun_CN,,0,0,0,,她肯定在默默守護著莫夫倫和大家
Dialogue: 0,0:09:27.31,0:09:28.87,Ha_Chan_JP,,0,0,0,,見てるだけで 来ないの
Dialogue: 0,0:09:27.31,0:09:28.87,Ha_Chan_CN,,0,0,0,,光是看著 不露面嗎
Dialogue: 0,0:09:30.24,0:09:31.95,Ha_Chan_JP,,0,0,0,,ひーちゃん そっくりなんでしょ
Dialogue: 0,0:09:30.24,0:09:31.95,Ha_Chan_CN,,0,0,0,,她不是和小菲很像嗎
Dialogue: 0,0:09:32.24,0:09:34.41,Ha_Chan_JP,,0,0,0,,ひーちゃん どんどん 大きくなってんだよ
Dialogue: 0,0:09:32.24,0:09:34.41,Ha_Chan_CN,,0,0,0,,小菲可是越來越大了
Dialogue: 0,0:09:37.01,0:09:38.75,Ha_Chan_JP,,0,0,0,,はーちゃんなら 分かるでしょ
Dialogue: 0,0:09:37.01,0:09:38.75,Ha_Chan_CN,,0,0,0,,小哈應該知道吧
Dialogue: 0,0:09:40.57,0:09:43.02,Ha_Chan_JP,,0,0,0,,どうしてか 教えてくれてもいいじゃん！
Dialogue: 0,0:09:40.57,0:09:43.02,Ha_Chan_CN,,0,0,0,,來告訴我該怎麼辦 不就行了嗎！
Dialogue: 0,0:09:48.53,0:09:49.89,Magical_JP,,0,0,0,,やっぱり誰かいる！
Dialogue: 0,0:09:48.53,0:09:49.89,Magical_CN,,0,0,0,,果然有人！
Dialogue: 0,0:09:50.41,0:09:52.46,Magical_JP,,0,0,0,,モフルン ひーちゃん お願い
Dialogue: 0,0:09:50.41,0:09:52.46,Magical_CN,,0,0,0,,莫夫倫 你照顧一下小菲
Dialogue: 0,0:09:52.85,0:09:53.52,Ha_Chan_JP,,0,0,0,,リコ？
Dialogue: 0,0:09:52.85,0:09:53.52,Ha_Chan_CN,,0,0,0,,李可？
Dialogue: 0,0:09:54.22,0:09:55.58,Magical_JP,,0,0,0,,この話は後で
Dialogue: 0,0:09:54.22,0:09:55.58,Magical_CN,,0,0,0,,等會再跟你談這件事
Dialogue: 0,0:09:56.50,0:09:57.78,Ha_Chan_JP,,0,0,0,,待ってよ！
Dialogue: 0,0:09:56.50,0:09:57.78,Ha_Chan_CN,,0,0,0,,等等啊！
Dialogue: 0,0:10:03.41,0:10:04.91,Magical_JP,,0,0,0,,いるのは分かってるわ
Dialogue: 0,0:10:03.41,0:10:04.91,Magical_CN,,0,0,0,,我知道你在
Dialogue: 0,0:10:05.82,0:10:07.50,Magical_JP,,0,0,0,,キュアップ・ラパパ！
Dialogue: 0,0:10:05.82,0:10:07.50,Curerpp_LK,,0,0,0,,CURE UP·RAPAPA !
Dialogue: 0,0:10:07.98,0:10:09.94,Magical_JP,,0,0,0,,風よ 吹きなさい！
Dialogue: 0,0:10:07.98,0:10:09.94,Magical_CN,,0,0,0,,風啊 刮起來吧！
Dialogue: 0,0:10:11.76,0:10:13.17,Default_JP,,0,0,0,,見つかったか
Dialogue: 0,0:10:11.76,0:10:13.17,Default_CN,,0,0,0,,被發現了啊
Dialogue: 0,0:10:13.61,0:10:15.79,Magical_JP,,0,0,0,,お父様 どうして？
Dialogue: 0,0:10:13.61,0:10:15.79,Magical_CN,,0,0,0,,爸爸 為什麼？
Dialogue: 0,0:10:16.05,0:10:18.51,Default_JP,,0,0,0,,警護だよ ひすいくんのね
Dialogue: 0,0:10:16.05,0:10:18.51,Default_CN,,0,0,0,,監護啊 對於小菲的
Dialogue: 0,0:10:19.40,0:10:22.13,Default_JP,,0,0,0,,アイルと名乗る者がひすいくんを狙っている
Dialogue: 0,0:10:19.40,0:10:22.13,Default_CN,,0,0,0,,自稱埃路的人 盯著小菲
Dialogue: 0,0:10:22.97,0:10:25.33,Default_JP,,0,0,0,,魔法界としても放っておけない
Dialogue: 0,0:10:22.97,0:10:25.33,Default_CN,,0,0,0,,魔法界那邊不能置之不理
Dialogue: 0,0:10:25.74,0:10:28.38,Magical_JP,,0,0,0,,校長先生に頼まれたってわけね
Dialogue: 0,0:10:25.74,0:10:28.38,Magical_CN,,0,0,0,,是校長委託你的吧
Dialogue: 0,0:10:29.07,0:10:30.92,Default_JP,,0,0,0,,自分から志願した
Dialogue: 0,0:10:29.07,0:10:30.92,Default_CN,,0,0,0,,是我自己志願的
Dialogue: 0,0:10:31.34,0:10:35.04,Default_JP,,0,0,0,,ひすいくんもだが リコの事が心配だったし
Dialogue: 0,0:10:31.34,0:10:35.04,Default_CN,,0,0,0,,不止是小菲 我也擔心李可你
Dialogue: 0,0:10:35.78,0:10:37.12,Magical_JP,,0,0,0,,ずっと見てたの？
Dialogue: 0,0:10:35.78,0:10:37.12,Magical_CN,,0,0,0,,你一直看著嗎？
Dialogue: 0,0:10:37.44,0:10:38.90,Default_JP,,0,0,0,,猫探し ご苦労
Dialogue: 0,0:10:37.44,0:10:38.90,Default_CN,,0,0,0,,搜尋貓咪 辛苦了
Dialogue: 0,0:10:39.60,0:10:41.01,Magical_JP,,0,0,0,,信用してよ
Dialogue: 0,0:10:39.60,0:10:41.01,Magical_CN,,0,0,0,,多信任我一些吧
Dialogue: 0,0:10:41.50,0:10:44.20,Magical_JP,,0,0,0,,過保護すぎるし もう子供じゃないし
Dialogue: 0,0:10:41.50,0:10:44.20,Magical_CN,,0,0,0,,保護過度了 我都不是小孩了
Dialogue: 0,0:10:44.80,0:10:49.53,Default_JP,,0,0,0,,たとえ成人しようとも 伝説の魔法使いであろうとも
Dialogue: 0,0:10:44.80,0:10:49.53,Default_CN,,0,0,0,,即使你成年了 即使你是傳說中的魔法師
Dialogue: 0,0:10:50.17,0:10:52.34,Default_JP,,0,0,0,,親から見れば子供だよ
Dialogue: 0,0:10:50.17,0:10:52.34,Default_CN,,0,0,0,,在父母眼裡 你還是一個小孩啊
Dialogue: 0,0:10:52.43,0:10:53.26,Magical_JP,,0,0,0,,あっ...
Dialogue: 0,0:10:52.43,0:10:53.26,Magical_CN,,0,0,0,,啊...
Dialogue: 0,0:10:54.48,0:10:55.23,Default_JP,,0,0,0,,うん
Dialogue: 0,0:10:54.48,0:10:55.23,Default_CN,,0,0,0,,嗯
Dialogue: 0,0:10:58.16,0:11:00.20,Magical_JP,,0,0,0,,とにかく警護は必要ないわ
Dialogue: 0,0:10:58.16,0:11:00.20,Magical_CN,,0,0,0,,總之 不用再監護了
Dialogue: 0,0:11:00.81,0:11:02.17,Default_JP,,0,0,0,,しかしだな...
Dialogue: 0,0:11:00.81,0:11:02.17,Default_CN,,0,0,0,,但是啊...
Dialogue: 0,0:11:03.34,0:11:05.45,Default_JP,,0,0,0,,「どの口が言うか」か
Dialogue: 0,0:11:03.34,0:11:05.45,Default_CN,,0,0,0,,“你怎麼說得出這種話”是吧
Dialogue: 0,0:11:06.04,0:11:12.02,Magical_JP,,0,0,0,,ひーちゃんは 色々戸惑ってるから みらいとモフルンとで そっと見守ってあげたいの
Dialogue: 0,0:11:06.04,0:11:12.02,Magical_CN,,0,0,0,,小菲她很迷茫 我跟未來還有莫夫倫會默默保護她的
Dialogue: 0,0:11:12.94,0:11:14.28,Ha_Chan_JP,,0,0,0,,勝手に決めないで！
Dialogue: 0,0:11:12.94,0:11:14.28,Ha_Chan_CN,,0,0,0,,不要擅自做決定！
Dialogue: 0,0:11:15.39,0:11:16.57,Magical_JP,,0,0,0,,ひーちゃん
Dialogue: 0,0:11:15.39,0:11:16.57,Magical_CN,,0,0,0,,小菲
Dialogue: 0,0:11:17.07,0:11:20.57,Ha_Chan_JP,,0,0,0,,守ってとか お願いしてないし 子供じゃないし！
Dialogue: 0,0:11:17.07,0:11:20.57,Ha_Chan_CN,,0,0,0,,我又沒請你們保護 我又不是小孩！
Dialogue: 0,0:11:21.02,0:11:21.90,Magical_JP,,0,0,0,,あのね...
Dialogue: 0,0:11:21.02,0:11:21.90,Magical_CN,,0,0,0,,我的意思是...
Dialogue: 0,0:11:21.95,0:11:24.96,Ha_Chan_JP,,0,0,0,,リコも 今嫌がってたじゃん 子供って言われて
Dialogue: 0,0:11:21.95,0:11:24.96,Ha_Chan_CN,,0,0,0,,李可也很討厭吧 剛才被當做小孩
Dialogue: 0,0:11:25.54,0:11:26.80,Magical_JP,,0,0,0,,それは...
Dialogue: 0,0:11:25.54,0:11:26.80,Magical_CN,,0,0,0,,我那是...
Dialogue: 0,0:11:31.20,0:11:32.84,Mofurun_JP,,0,0,0,,ひーちゃん いたモフ
Dialogue: 0,0:11:31.20,0:11:32.84,Mofurun_CN,,0,0,0,,小菲 在那裡
Dialogue: 0,0:11:33.52,0:11:35.11,Ha_Chan_JP,,0,0,0,,猫 探しに行く
Dialogue: 0,0:11:33.52,0:11:35.11,Ha_Chan_CN,,0,0,0,,我去找貓咪
Dialogue: 0,0:11:36.66,0:11:38.03,Magical_JP,,0,0,0,,待ちなさい！
Dialogue: 0,0:11:36.66,0:11:38.03,Magical_CN,,0,0,0,,不要走！
Dialogue: 0,0:11:38.35,0:11:39.18,Ha_Chan_JP,,0,0,0,,離して！
Dialogue: 0,0:11:38.35,0:11:39.18,Ha_Chan_CN,,0,0,0,,放開！
Dialogue: 0,0:11:41.14,0:11:43.12,Ha_Chan_JP,,0,0,0,,リコなんか 大っ嫌い！
Dialogue: 0,0:11:41.14,0:11:43.12,Ha_Chan_CN,,0,0,0,,我最討厭李可了！
Dialogue: 0,0:11:43.12,0:11:45.12,Ha_Chan_CN,,0,0,0,,
Dialogue: 0,0:11:58.04,0:11:58.90,Ha_Chan_JP,,0,0,0,,あっ！
Dialogue: 0,0:11:58.04,0:11:58.90,Ha_Chan_CN,,0,0,0,,啊！
Dialogue: 0,0:12:00.89,0:12:02.91,DarkMHS_JP,,0,0,0,,そんなに走ると 危ないよ
Dialogue: 0,0:12:00.89,0:12:02.91,DarkMHS_CN,,0,0,0,,你這麼跑 很危險的
Dialogue: 0,0:12:03.49,0:12:04.22,Ha_Chan_JP,,0,0,0,,あっ...
Dialogue: 0,0:12:03.49,0:12:04.22,Ha_Chan_CN,,0,0,0,,啊...
Dialogue: 0,0:12:06.99,0:12:10.35,DarkMHS_JP,,0,0,0,,成長に心が追いついていないんだろうね
Dialogue: 0,0:12:06.99,0:12:10.35,DarkMHS_CN,,0,0,0,,是心理沒跟上成長吧
Dialogue: 0,0:12:11.40,0:12:14.52,DarkMHS_JP,,0,0,0,,安心して その悩みもすぐに終わる
Dialogue: 0,0:12:11.40,0:12:14.52,DarkMHS_CN,,0,0,0,,放心吧 這煩惱很快就會結束的
Dialogue: 0,0:12:23.68,0:12:25.86,DarkMHS_JP,,0,0,0,,やあ 朝日奈みらいさん
Dialogue: 0,0:12:23.68,0:12:25.86,DarkMHS_CN,,0,0,0,,你好呀 朝日奈未來小姐
Dialogue: 0,0:12:26.36,0:12:27.33,Mofurun_JP,,0,0,0,,着るモフ
Dialogue: 0,0:12:26.36,0:12:27.33,Mofurun_CN,,0,0,0,,穿起來
Dialogue: 0,0:12:27.93,0:12:29.57,Miracle_JP,,0,0,0,,ひーちゃん 逃げて
Dialogue: 0,0:12:27.93,0:12:29.57,Miracle_CN,,0,0,0,,小菲 快逃
Dialogue: 0,0:12:30.16,0:12:30.91,Miracle_JP,,0,0,0,,行くの！
Dialogue: 0,0:12:30.16,0:12:30.91,Miracle_CN,,0,0,0,,快走！
Dialogue: 0,0:12:34.44,0:12:37.94,DarkMHS_JP,,0,0,0,,魔法はバレたらマズいのに よく使うよね
Dialogue: 0,0:12:34.44,0:12:37.94,DarkMHS_CN,,0,0,0,,魔法暴露的話 會很麻煩吧 虧你還敢用
Dialogue: 0,0:12:38.53,0:12:41.85,Miracle_JP,,0,0,0,,バレても構わない ひーちゃんを守るためなら
Dialogue: 0,0:12:38.53,0:12:41.85,Miracle_CN,,0,0,0,,只要是為了保護小菲 暴露了也無所謂
Dialogue: 0,0:12:48.43,0:12:49.18,Mofurun_JP,,0,0,0,,リコ
Dialogue: 0,0:12:48.43,0:12:49.18,Mofurun_CN,,0,0,0,,李可
Dialogue: 0,0:12:49.53,0:12:51.07,Magical_JP,,0,0,0,,ひーちゃんがいないの
Dialogue: 0,0:12:49.53,0:12:51.07,Magical_CN,,0,0,0,,小菲跑掉了
Dialogue: 0,0:12:51.29,0:12:52.45,Miracle_JP,,0,0,0,,それなら大丈夫
Dialogue: 0,0:12:51.29,0:12:52.45,Miracle_CN,,0,0,0,,我見到她了 不同擔心
Dialogue: 0,0:12:54.14,0:12:55.08,Default_JP,,0,0,0,,あっ！
Dialogue: 0,0:12:54.14,0:12:55.08,Default_CN,,0,0,0,,啊！
Dialogue: 0,0:12:56.48,0:12:57.85,Default_JP,,0,0,0,,みらいとリコだ
Dialogue: 0,0:12:56.48,0:12:57.85,Default_CN,,0,0,0,,是未來和李可
Dialogue: 0,0:13:00.75,0:13:03.57,DarkMHS_JP,,0,0,0,,招待しよう ボクのフィールドに
Dialogue: 0,0:13:00.75,0:13:03.57,DarkMHS_CN,,0,0,0,,招待你們 進入我的領域吧
Dialogue: 0,0:13:13.73,0:13:14.37,Default_JP,,0,0,0,,あれ...
Dialogue: 0,0:13:13.73,0:13:14.37,Default_CN,,0,0,0,,咦...
Dialogue: 0,0:13:14.45,0:13:15.46,Default_JP,,0,0,0,,いないじゃん
Dialogue: 0,0:13:14.45,0:13:15.46,Default_CN,,0,0,0,,沒人啊
Dialogue: 0,0:13:16.04,0:13:18.85,Default_JP,,0,0,0,,嘘でしょ 絶対いたの
Dialogue: 0,0:13:16.04,0:13:18.85,Default_CN,,0,0,0,,不是吧 絕對在的
Dialogue: 0,0:13:19.30,0:13:22.22,Default_JP,,0,0,0,,本当に 本当にいたの
Dialogue: 0,0:13:19.30,0:13:22.22,Default_CN,,0,0,0,,真的 真的在的
Dialogue: 0,0:13:22.28,0:13:24.27,Default_JP,,0,0,0,,本当に懐かしいわ
Dialogue: 0,0:13:22.28,0:13:24.27,Default_CN,,0,0,0,,真的好懷念啊
Dialogue: 0,0:13:26.99,0:13:29.68,DarkMHS_JP,,0,0,0,,キミ達は確信に迫りつつある
Dialogue: 0,0:13:26.99,0:13:29.68,DarkMHS_CN,,0,0,0,,你們在逼近真相
Dialogue: 0,0:13:30.66,0:13:34.37,DarkMHS_JP,,0,0,0,,そして 今日 新たな章に入ることになる
Dialogue: 0,0:13:30.66,0:13:34.37,DarkMHS_CN,,0,0,0,,而今天也會進入新一章
Dialogue: 0,0:13:41.10,0:13:41.81,MagiMiraJP,,0,0,0,,あっ...
Dialogue: 0,0:13:41.10,0:13:41.81,MagiMiraCN,,0,0,0,,啊...
Dialogue: 0,0:13:47.90,0:00:00.00,Default_CN,,0,0,0,,

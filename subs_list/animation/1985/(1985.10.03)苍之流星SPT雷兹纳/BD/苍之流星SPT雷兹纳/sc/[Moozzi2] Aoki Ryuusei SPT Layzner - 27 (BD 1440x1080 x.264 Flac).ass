Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerTopMusic,,0,0,0,,dakishimete, kinou yori
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerMusic,,0,0,0,,抱紧我
Dialogue: 0,0:23:01.80,0:23:07.11,LayznerTopMusic,,0,0,0,,aishitai hito tidak iru
Dialogue: 0,0:23:01.80,0:23:07.25,LayznerMusic,,0,0,0,,比昨天更爱你
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerTopMusic,,0,0,0,,toki ha hitoshizuku nigai namida
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerMusic,,0,0,0,,时间是一滴 苦涩的泪
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerTopMusic,,0,0,0,,kizutsuita pururougu
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerMusic,,0,0,0,,受伤的序曲
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerTopMusic,,0,0,0,,yasashisa e tsuzukuno yo
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerMusic,,0,0,0,,继续着温柔
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerTopMusic,,0,0,0,,mayowanai futari dake no
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerMusic,,0,0,0,,只为这不再迷惘的两人
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerTopMusic,,0,0,0,,LA ROSE ROUGE
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerMusic,,0,0,0,,献上一曲野玫瑰之歌
Dialogue: 0,0:08:28.61,0:08:31.11,注释,,0,0,0,,MF-DJ-9IU 德鲁基斯
Dialogue: 0,0:08:39.12,0:08:42.16,注释,,0,0,0,,MF-GL-73U 盖斯沙兰
Dialogue: 0,0:08:54.88,0:08:57.03,注释,,0,0,0,,MF-DF-61U 丹多夫
Dialogue: 0,0:09:11.73,0:09:14.59,注释,,0,0,0,,SPT-2K-53U 扎卡尔（按设定书编号应该为ZK而非2K）
Dialogue: 0,0:09:23.50,0:09:26.13,注释,,0,0,0,,MF-ED-52U 艾鲁达尔
Dialogue: 0,0:01:03.91,0:01:06.75,Layzner,,0,0,0,,我是从地狱复生的男人
Dialogue: 0,0:01:08.29,0:01:10.38,Layzner,,0,0,0,,哼 真是有意思
Dialogue: 0,0:01:56.77,0:01:58.83,Layzner,,0,0,0,,三年前的那天
Dialogue: 0,0:02:00.14,0:02:03.05,Layzner,,0,0,0,,在古拉特斯占绝对优势的兵力蹂躏之下
Dialogue: 0,0:02:03.89,0:02:06.67,Layzner,,0,0,0,,地球上百分之七十的城市被摧毁
Dialogue: 0,0:02:07.31,0:02:10.19,Layzner,,0,0,0,,总人口的三分之一丧生
Dialogue: 0,0:02:11.92,0:02:16.36,Layzner,,0,0,0,,而且古拉特斯人通过破坏
Dialogue: 0,0:02:16.89,0:02:20.64,Layzner,,0,0,0,,来制造恐怖 支配人类
Dialogue: 0,0:02:21.36,0:02:23.64,Layzner,,0,0,0,,如同神一般
Dialogue: 0,0:02:23.74,0:02:28.64,Layzner,,0,0,0,,华丽的鲁·凯恩
Dialogue: 0,0:03:00.28,0:03:08.87,Layzner,,0,0,0,,我既然来到这里 就是要让那些反抗古拉特斯的家伙 血淋淋的死在我脚下
Dialogue: 0,0:03:39.53,0:03:41.95,Layzner,,0,0,0,,说过多少遍了
Dialogue: 0,0:03:42.15,0:03:44.99,Layzner,,0,0,0,,别干这种袭击鲁·凯恩的蠢事
Dialogue: 0,0:03:44.99,0:03:49.08,Layzner,,0,0,0,,什么叫蠢事 又不是想靠你的力量
Dialogue: 0,0:03:49.08,0:03:51.00,Layzner,,0,0,0,,干掉古雷斯库的儿子
Dialogue: 0,0:03:51.00,0:03:54.08,Layzner,,0,0,0,,对古雷特斯军的精神打击不可估量
Dialogue: 0,0:03:54.08,0:04:01.55,Layzner,,0,0,0,,我说的是如果失去组织和战友 局面根本无法挽回
Dialogue: 0,0:03:54.08,0:04:01.55,Layzner,,0,0,0,,真是天真  你也太小看鲁·凯恩的力量了
Dialogue: 0,0:04:01.80,0:04:07.76,Layzner,,0,0,0,,大卫 你以为我们靠枪和炸弹就来对抗古雷斯库的儿子吗
Dialogue: 0,0:04:07.76,0:04:09.77,Layzner,,0,0,0,,喂 给他看看
Dialogue: 0,0:04:13.54,0:04:15.48,Layzner,,0,0,0,,厉害啊
Dialogue: 0,0:04:19.65,0:04:24.32,Layzner,,0,0,0,,这是从治安军那得到的 怎么样 这下没意见了吧
Dialogue: 0,0:04:24.32,0:04:27.07,Layzner,,0,0,0,,实在是不想给你泼冷水
Dialogue: 0,0:04:27.07,0:04:29.16,Layzner,,0,0,0,,你还有意见
Dialogue: 0,0:04:29.16,0:04:31.29,Layzner,,0,0,0,,根据我们查到的情报
Dialogue: 0,0:04:31.29,0:04:35.42,Layzner,,0,0,0,,古雷斯库的儿子是个SPT战术天才
Dialogue: 0,0:04:35.42,0:04:37.04,Layzner,,0,0,0,,别胡说
Dialogue: 0,0:04:37.21,0:04:41.51,Layzner,,0,0,0,,这个情报从谁那听的 我找他问个明白
Dialogue: 0,0:04:41.51,0:04:42.21,Layzner,,0,0,0,,是我
Dialogue: 0,0:04:44.55,0:04:46.39,Layzner,,0,0,0,,你是谁
Dialogue: 0,0:04:46.39,0:04:47.64,Layzner,,0,0,0,,我是
Dialogue: 0,0:04:48.76,0:04:50.26,Layzner,,0,0,0,,阿尔巴特洛·纳鲁·飞鸟英二
Dialogue: 0,0:04:50.26,0:04:51.11,Layzner,,0,0,0,,英二
Dialogue: 0,0:04:52.36,0:04:53.73,Layzner,,0,0,0,,不会是 那家伙
Dialogue: 0,0:04:53.73,0:04:57.10,Layzner,,0,0,0,,你有古拉特斯和地球人的血统
Dialogue: 0,0:04:57.10,0:04:59.52,Layzner,,0,0,0,,是的 就是我
Dialogue: 0,0:04:59.52,0:05:01.53,Layzner,,0,0,0,,英二吗
Dialogue: 0,0:05:01.82,0:05:05.45,Layzner,,0,0,0,,我不会乱说的 袭击鲁·凯恩的计划还是停止吧
Dialogue: 0,0:05:05.45,0:05:10.28,Layzner,,0,0,0,,喂 那个叫英二的 你知道我在想什么吗
Dialogue: 0,0:05:11.29,0:05:17.96,Layzner,,0,0,0,,我在想要是你没有地球人的血统 我现在就捅死你
Dialogue: 0,0:05:18.17,0:05:21.00,Layzner,,0,0,0,,停止袭击鲁·凯恩的计划
Dialogue: 0,0:05:21.00,0:05:23.76,Layzner,,0,0,0,,我要是不答应 你想怎么样
Dialogue: 0,0:05:23.76,0:05:24.80,Layzner,,0,0,0,,什么
Dialogue: 0,0:05:32.26,0:05:38.52,Layzner,,0,0,0,,别多管闲事 我要让你好好看看我们组织的力量
Dialogue: 0,0:06:21.61,0:06:25.07,Layzner,,0,0,0,,混账 这简直就是自寻死路
Dialogue: 0,0:06:25.07,0:06:27.49,Layzner,,0,0,0,,好了 别碍事
Dialogue: 0,0:06:28.11,0:06:29.31,Layzner,,0,0,0,,来了
Dialogue: 0,0:06:34.91,0:06:38.58,Layzner,,0,0,0,,一副了不起的样子 完全不把我们地球人当回事
Dialogue: 0,0:06:43.25,0:06:46.96,Layzner,,0,0,0,,那种家伙 就是一条狗
Dialogue: 0,0:06:47.34,0:06:48.17,Layzner,,0,0,0,,罗安
Dialogue: 0,0:07:09.49,0:07:11.03,Layzner,,0,0,0,,冲啊
Dialogue: 0,0:07:38.81,0:07:43.00,Layzner,,0,0,0,,喂 跟你说的完全不一样啊
Dialogue: 0,0:07:48.28,0:07:51.78,Layzner,,0,0,0,,谁说天真 谁说是蠢事
Dialogue: 0,0:07:51.78,0:07:56.95,Layzner,,0,0,0,,看 我们干掉了鲁·凯恩 我们亲手干掉了他
Dialogue: 0,0:07:59.95,0:08:06.79,Layzner,,0,0,0,,要看就看 英二 你也看到我们的力量了吧 作战成功
Dialogue: 0,0:08:12.22,0:08:14.84,Layzner,,0,0,0,,敌人 敌军袭击
Dialogue: 0,0:08:50.69,0:08:52.63,Layzner,,0,0,0,,混蛋 我打飞你
Dialogue: 0,0:09:26.58,0:09:29.21,Layzner,,0,0,0,,该死的古拉特斯
Dialogue: 0,0:09:38.68,0:09:40.64,Layzner,,0,0,0,,你
Dialogue: 0,0:09:40.64,0:09:46.08,Layzner,,0,0,0,,你以为我会掉进你们这种地球人的陷阱里吗
Dialogue: 0,0:09:46.08,0:09:48.02,Layzner,,0,0,0,,要恨就恨你们自己的失策吧
Dialogue: 0,0:09:59.57,0:10:00.21,Layzner,,0,0,0,,动手
Dialogue: 0,0:10:03.58,0:10:05.70,Layzner,,0,0,0,,他就是鲁·凯尔吗
Dialogue: 0,0:10:05.70,0:10:09.00,Layzner,,0,0,0,,他是一个自信却不自大的人
Dialogue: 0,0:10:09.25,0:10:13.42,Layzner,,0,0,0,,那家伙一来 古拉特斯在地球上的力量就会变得更强
Dialogue: 0,0:10:19.01,0:10:21.68,Layzner,,0,0,0,,地球人 挺好
Dialogue: 0,0:10:23.26,0:10:27.98,Layzner,,0,0,0,,看到了吧 反抗我们是何等愚蠢的行为
Dialogue: 0,0:10:28.32,0:10:30.42,Layzner,,0,0,0,,不要想着对抗我们
Dialogue: 0,0:10:30.98,0:10:36.05,Layzner,,0,0,0,,你们地球人的幸福就在于接受我们的统治
Dialogue: 0,0:10:36.05,0:10:40.70,Layzner,,0,0,0,,统治者和被统治者 是宇宙中的一般原理
Dialogue: 0,0:10:40.86,0:10:47.87,Layzner,,0,0,0,,更好的统治和彻底的服从 才是实现理想世界的唯一真理
Dialogue: 0,0:10:48.33,0:10:54.63,Layzner,,0,0,0,,为了确立真正的和平 我遵循这一原理 来到了地球
Dialogue: 0,0:10:54.88,0:10:57.92,Layzner,,0,0,0,,从现在开始抛弃所有地球式的东西
Dialogue: 0,0:10:58.34,0:11:00.13,Layzner,,0,0,0,,信奉古拉特斯
Dialogue: 0,0:11:00.43,0:11:02.05,Layzner,,0,0,0,,信奉我们吧
Dialogue: 0,0:11:15.64,0:11:17.03,Layzner,,0,0,0,,不是
Dialogue: 0,0:11:18.28,0:11:21.24,Layzner,,0,0,0,,地球是属于我们的
Dialogue: 0,0:11:21.49,0:11:25.83,Layzner,,0,0,0,,地球上诞生的人才能保护地球
Dialogue: 0,0:11:25.83,0:11:31.12,Layzner,,0,0,0,,古拉特斯人马上从地球上消失 这才是地球人的唯一愿望
Dialogue: 0,0:11:32.21,0:11:35.04,Layzner,,0,0,0,,这个行星不是古拉特斯人的
Dialogue: 0,0:11:35.37,0:11:38.96,Layzner,,0,0,0,,只要古拉特斯人不在 这个行星马上就会恢复和平
Dialogue: 0,0:11:39.22,0:11:41.68,Layzner,,0,0,0,,你是谁
Dialogue: 0,0:11:41.80,0:11:43.89,Layzner,,0,0,0,,阿尔巴特罗·纳鲁·飞鸟英二
Dialogue: 0,0:11:43.97,0:11:45.35,Layzner,,0,0,0,,飞鸟英二
Dialogue: 0,0:11:46.22,0:11:48.43,Layzner,,0,0,0,,古拉特斯的叛徒
Dialogue: 0,0:11:49.56,0:11:52.19,Layzner,,0,0,0,,我就想一定能看到你的
Dialogue: 0,0:11:52.94,0:11:55.54,Layzner,,0,0,0,,英二 英二
Dialogue: 0,0:11:55.56,0:12:01.49,Layzner,,0,0,0,,不巧 我没兴趣听一个血统不纯的家伙的胡话
Dialogue: 0,0:12:01.65,0:12:05.70,Layzner,,0,0,0,,鲁·凯恩 我们可不是老实到可以任你胡作非为的
Dialogue: 0,0:12:05.87,0:12:07.08,Layzner,,0,0,0,,听好了
Dialogue: 0,0:12:07.58,0:12:10.75,Layzner,,0,0,0,,我是从地狱里复活的男人
Dialogue: 0,0:12:11.00,0:12:16.00,Layzner,,0,0,0,,我一定会把你和古雷斯库提督从地球上赶走
Dialogue: 0,0:12:16.00,0:12:17.31,Layzner,,0,0,0,,英二
Dialogue: 0,0:12:20.21,0:12:22.17,Layzner,,0,0,0,,回来 快回来
Dialogue: 0,0:12:40.78,0:12:43.15,Layzner,,0,0,0,,哼 真是有意思
Dialogue: 0,0:12:57.63,0:13:00.30,Layzner,,0,0,0,,听说你很嚣张的嘛
Dialogue: 0,0:13:00.30,0:13:02.26,Layzner,,0,0,0,,您已经听说了吗
Dialogue: 0,0:13:02.46,0:13:06.18,Layzner,,0,0,0,,知道我为什么召你来吗
Dialogue: 0,0:13:06.34,0:13:08.47,Layzner,,0,0,0,,这我明白 父亲大人
Dialogue: 0,0:13:08.72,0:13:13.35,Layzner,,0,0,0,,没有意义的杀戮和破坏只会造成民心离反
Dialogue: 0,0:13:13.35,0:13:15.35,Layzner,,0,0,0,,父亲你也改变了呢
Dialogue: 0,0:13:15.60,0:13:20.77,Layzner,,0,0,0,,是不是因为在地球上过了三年 患上了地球病之类的
Dialogue: 0,0:13:20.90,0:13:22.23,Layzner,,0,0,0,,地球病
Dialogue: 0,0:13:22.40,0:13:26.14,Layzner,,0,0,0,,宗主国的人这样传言的
Dialogue: 0,0:13:26.14,0:13:31.91,Layzner,,0,0,0,,父亲大人身为战略政策的领导者 承担着地球文化古拉特斯化的重任
Dialogue: 0,0:13:32.54,0:13:35.78,Layzner,,0,0,0,,为此设立了文化改造队
Dialogue: 0,0:13:35.78,0:13:40.59,Layzner,,0,0,0,,从这个堪称地球文化象征的大城市 开始了文化改造行动
Dialogue: 0,0:13:40.92,0:13:46.45,Layzner,,0,0,0,,然而 您并没有彻底完成 只是将两个据点封锁起来而已
Dialogue: 0,0:13:47.08,0:13:51.20,Layzner,,0,0,0,,是说纽约图书馆和大都会美术馆吗
Dialogue: 0,0:13:52.04,0:13:56.83,Layzner,,0,0,0,,政策不彻会被地球人轻视
Dialogue: 0,0:14:05.42,0:14:06.54,Layzner,,0,0,0,,父亲大人
Dialogue: 0,0:14:10.95,0:14:12.20,Layzner,,0,0,0,,父亲大人
Dialogue: 0,0:14:13.20,0:14:14.57,Layzner,,0,0,0,,父亲大人
Dialogue: 0,0:14:16.72,0:14:20.29,注释,,0,0,0,,纽约州立图书馆
Dialogue: 0,0:14:26.42,0:14:28.30,Layzner,,0,0,0,,别过来 你们是什么人
Dialogue: 0,0:14:29.39,0:14:30.93,Layzner,,0,0,0,,开门
Dialogue: 0,0:14:31.10,0:14:36.23,Layzner,,0,0,0,,回去 这没有古雷斯库大人的许可不得进入
Dialogue: 0,0:14:36.60,0:14:38.27,Layzner,,0,0,0,,我已经许可了
Dialogue: 0,0:14:38.52,0:14:40.31,Layzner,,0,0,0,,你是谁
Dialogue: 0,0:14:40.44,0:14:44.11,Layzner,,0,0,0,,古雷斯库大人的公子 新任总司令官大人
Dialogue: 0,0:14:44.11,0:14:46.57,Layzner,,0,0,0,,失礼了
Dialogue: 0,0:14:46.65,0:14:47.65,Layzner,,0,0,0,,打开门
Dialogue: 0,0:14:47.65,0:14:52.95,Layzner,,0,0,0,,可是 这里没有古雷斯库大人的特别许可 是不能
Dialogue: 0,0:14:52.95,0:14:56.15,Layzner,,0,0,0,,我已经许可了 打开
Dialogue: 0,0:15:20.52,0:15:21.73,Layzner,,0,0,0,,动手
Dialogue: 0,0:15:29.99,0:15:30.95,Layzner,,0,0,0,,燃烧吧
Dialogue: 0,0:15:31.82,0:15:33.03,Layzner,,0,0,0,,燃烧吧
Dialogue: 0,0:15:33.16,0:15:36.08,Layzner,,0,0,0,,地球上的东西全部都变成灰烬吧
Dialogue: 0,0:15:45.00,0:15:46.80,Layzner,,0,0,0,,把鲁·凯恩叫来
Dialogue: 0,0:15:54.26,0:15:55.89,Layzner,,0,0,0,,您是要教育我吗
Dialogue: 0,0:15:56.01,0:16:00.14,Layzner,,0,0,0,,这种奇妙的安宁还有威严
Dialogue: 0,0:16:00.64,0:16:04.02,Layzner,,0,0,0,,让我的内心充满了某种东西
Dialogue: 0,0:16:04.48,0:16:08.32,Layzner,,0,0,0,,你看着这些东西 什么也感受不到吗
Dialogue: 0,0:16:08.32,0:16:13.20,Layzner,,0,0,0,,父亲大人 您为什么会被这些无聊的垃圾迷住
Dialogue: 0,0:16:17.12,0:16:20.50,Layzner,,0,0,0,,父亲大人 您还是快醒醒吧
Dialogue: 0,0:16:20.50,0:16:24.08,Layzner,,0,0,0,,宇宙中根本没有能超过古拉特斯文化的东西
Dialogue: 0,0:16:24.50,0:16:28.46,Layzner,,0,0,0,,你还年轻 不明白的事情还有很多
Dialogue: 0,0:16:28.46,0:16:30.09,Layzner,,0,0,0,,我没想去明白
Dialogue: 0,0:16:30.67,0:16:36.01,Layzner,,0,0,0,,父亲大人 我只不过是忠实的执行父亲大人的政策
Dialogue: 0,0:16:37.93,0:16:41.14,Layzner,,0,0,0,,哦 原来这样啊
Dialogue: 0,0:16:41.68,0:16:46.48,Layzner,,0,0,0,,父亲大人 您知道自己沉迷于地球的空气中不能自拔
Dialogue: 0,0:16:46.69,0:16:49.07,Layzner,,0,0,0,,所以才把我召来的吧
Dialogue: 0,0:16:49.40,0:16:50.61,Layzner,,0,0,0,,父亲大人
Dialogue: 0,0:16:54.70,0:16:56.53,Layzner,,0,0,0,,基乌拉参见大人
Dialogue: 0,0:16:56.53,0:16:57.45,Layzner,,0,0,0,,进来
Dialogue: 0,0:17:01.43,0:17:06.75,Layzner,,0,0,0,,司令官 这是刚才向您说起的地球人罗安·迪米特里奇
Dialogue: 0,0:17:07.42,0:17:10.46,Layzner,,0,0,0,,你就是那个有用的地球人
Dialogue: 0,0:17:11.01,0:17:18.59,Layzner,,0,0,0,,深感光荣 现在对我来说 古拉特斯是和母亲一样的星球 有什么我能做到的您尽管吩咐
Dialogue: 0,0:17:20.93,0:17:23.93,Layzner,,0,0,0,,希望能为您效力 司令官大人
Dialogue: 0,0:17:24.23,0:17:26.32,Layzner,,0,0,0,,蠢人还是很多
Dialogue: 0,0:17:26.32,0:17:30.07,Layzner,,0,0,0,,我要让他们知道地球文化是毫无意义的
Dialogue: 0,0:17:30.07,0:17:33.28,Layzner,,0,0,0,,古拉特斯文化才是崇高的
Dialogue: 0,0:17:33.49,0:17:34.45,Layzner,,0,0,0,,是
Dialogue: 0,0:17:34.45,0:17:38.91,Layzner,,0,0,0,,所以 我想收拾掉中央美术馆
Dialogue: 0,0:17:39.37,0:17:45.29,Layzner,,0,0,0,,非常好 那种收集垃圾的地方 最好马上消灭掉
Dialogue: 0,0:17:45.54,0:17:47.50,Layzner,,0,0,0,,你来点火
Dialogue: 0,0:17:47.79,0:17:48.88,Layzner,,0,0,0,,点火
Dialogue: 0,0:17:48.88,0:17:55.47,Layzner,,0,0,0,,由你来点火 让他们知道地球人信仰的东西是何等的没有价值
Dialogue: 0,0:17:55.47,0:17:57.88,Layzner,,0,0,0,,非常乐意接受点火的任务
Dialogue: 0,0:18:05.27,0:18:08.94,Layzner,,0,0,0,,动手了 听说文化改造队要对大都会美术馆下手了
Dialogue: 0,0:18:09.06,0:18:09.98,Layzner,,0,0,0,,真的吗
Dialogue: 0,0:18:09.98,0:18:13.86,Layzner,,0,0,0,,真的 百分之百没错的消息
Dialogue: 0,0:18:19.53,0:18:22.91,注释,,0,0,0,,大都会美术馆
Dialogue: 0,0:18:24.37,0:18:26.68,Layzner,,0,0,0,,快点 别磨蹭
Dialogue: 0,0:18:27.16,0:18:30.04,Layzner,,0,0,0,,一个个都给我搬出来
Dialogue: 0,0:18:33.25,0:18:35.14,Layzner,,0,0,0,,看吧 地球人
Dialogue: 0,0:18:35.14,0:18:41.57,Layzner,,0,0,0,,这些垃圾放到阳光下 所有的颜色都失去了意义
Dialogue: 0,0:18:41.57,0:18:47.53,Layzner,,0,0,0,,这就是你们信仰的原型
Dialogue: 0,0:18:47.53,0:18:51.36,Layzner,,0,0,0,,睁开眼看吧 地球人 这些不过是个垃圾堆
Dialogue: 0,0:18:51.56,0:18:52.77,Layzner,,0,0,0,,罗安·迪米特里奇
Dialogue: 0,0:18:52.77,0:18:53.57,Layzner,,0,0,0,,是
Dialogue: 0,0:18:53.77,0:19:01.20,Layzner,,0,0,0,,点火 你亲自来点火 告诉你的同族这些东西有什么价值
Dialogue: 0,0:19:01.20,0:19:01.87,Layzner,,0,0,0,,是
Dialogue: 0,0:19:20.59,0:19:25.68,Layzner,,0,0,0,,好 剩下的一个不漏全丢进去
Dialogue: 0,0:19:31.31,0:19:38.44,Layzner,,0,0,0,,好好看着 地球人的劣等文化 全部都要这样化为灰烬 彻底消失
Dialogue: 0,0:19:43.37,0:19:45.99,Layzner,,0,0,0,,大家请帮帮我
Dialogue: 0,0:19:46.54,0:19:49.09,Layzner,,0,0,0,,请将地球人的宝物搬走
Dialogue: 0,0:19:52.17,0:19:55.81,Layzner,,0,0,0,,这里面都是我们地球人的骄傲
Dialogue: 0,0:19:55.81,0:19:59.36,Layzner,,0,0,0,,大家一人搬一点 把美术作品搬出来
Dialogue: 0,0:19:59.36,0:20:02.72,Layzner,,0,0,0,,不要让地球的伟大财富烧没了
Dialogue: 0,0:20:02.93,0:20:06.68,Layzner,,0,0,0,,大家帮忙啊 请拿出勇气来
Dialogue: 0,0:20:06.68,0:20:11.52,Layzner,,0,0,0,,保护地球人的骄傲 需要你们的勇气
Dialogue: 0,0:20:11.64,0:20:12.65,Layzner,,0,0,0,,勇气
Dialogue: 0,0:20:13.02,0:20:14.52,Layzner,,0,0,0,,我的勇气
Dialogue: 0,0:20:14.52,0:20:19.15,Layzner,,0,0,0,,只要一会 请大家借一点勇气给我
Dialogue: 0,0:20:31.87,0:20:33.33,Layzner,,0,0,0,,司令官
Dialogue: 0,0:20:37.29,0:20:38.42,Layzner,,0,0,0,,我帮你
Dialogue: 0,0:20:39.05,0:20:40.30,Layzner,,0,0,0,,我也来
Dialogue: 0,0:20:42.59,0:20:45.30,Layzner,,0,0,0,,基乌拉 他们在干什么
Dialogue: 0,0:20:45.51,0:20:48.06,Layzner,,0,0,0,,好像在一起帮忙运垃圾啊
Dialogue: 0,0:20:48.06,0:20:48.93,Layzner,,0,0,0,,笨蛋
Dialogue: 0,0:20:49.97,0:20:52.11,Layzner,,0,0,0,,你太骄纵他们了
Dialogue: 0,0:20:52.81,0:20:55.05,Layzner,,0,0,0,,快点 请快一点
Dialogue: 0,0:21:19.92,0:21:20.38,Layzner,,0,0,0,,动手
Dialogue: 0,0:21:44.07,0:21:45.31,Layzner,,0,0,0,,这是什么
Dialogue: 0,0:22:05.92,0:22:06.93,Layzner,,0,0,0,,安娜 上车
Dialogue: 0,0:22:08.47,0:22:09.47,Layzner,,0,0,0,,别让他们逃了
Dialogue: 0,0:22:14.85,0:22:15.73,Layzner,,0,0,0,,鲁·凯恩
Dialogue: 0,0:22:16.19,0:22:21.71,Layzner,,0,0,0,,好好记着地球人可以只为自豪而战
Dialogue: 0,0:22:23.48,0:22:26.20,Layzner,,0,0,0,,今天就和你打个招呼了 再会吧
Dialogue: 0,0:22:31.58,0:22:38.08,Layzner,,0,0,0,,和古拉特斯的新司令官 鲁·凯恩的战斗就这样开始了
Dialogue: 0,0:22:39.40,0:22:43.38,Layzner,,0,0,0,,有意思 这个星球充满刺激
Dialogue: 0,0:22:44.76,0:22:46.13,Layzner,,0,0,0,,正合我意
Dialogue: 0,0:23:54.44,0:23:59.98,Layzner,,0,0,0,,出现了一个被压迫的民众传成救世主和再生神灵的女人
Dialogue: 0,0:24:00.00,0:24:01.24,Layzner,,0,0,0,,别再弄这种难看的把戏了
Dialogue: 0,0:24:01.29,0:24:02.37,Layzner,,0,0,0,,那家伙是
Dialogue: 0,0:24:02.37,0:24:03.08,Layzner,,0,0,0,,那是
Dialogue: 0,0:24:04.06,0:24:08.87,Layzner,,0,0,0,,库斯科的圣女

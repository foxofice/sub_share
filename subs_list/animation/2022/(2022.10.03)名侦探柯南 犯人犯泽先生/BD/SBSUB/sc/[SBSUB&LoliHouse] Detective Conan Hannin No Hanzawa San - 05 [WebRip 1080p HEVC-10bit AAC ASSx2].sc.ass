Dialogue: 0,0:06:23.95,0:06:27.49,Note,,0,0,0,,我是主角
Dialogue: 0,0:06:35.17,0:06:36.83,Note,,0,0,0,,{\pos(656,594)\c&H87746A&\3c&HFAE7D6&\shad0}余额
Dialogue: 0,0:06:27.83,0:06:28.24,Note,,0,0,0,,
Dialogue: 0,0:01:32.55,0:01:33.48,DefaultSingle-S,,0,0,0,,		犯人…
Dialogue: 0,0:01:34.46,0:01:36.11,DefaultSingle-S,,0,0,0,,		就是你  犯泽
Dialogue: 0,0:01:39.10,0:01:40.12,DefaultSingle-S,,0,0,0,,		是梦吗
Dialogue: 0,0:01:41.02,0:01:42.91,DefaultSingle-S,,0,0,0,,		犯泽先生  你没事吧
Dialogue: 0,0:01:43.66,0:01:44.87,DefaultSingle-S,,0,0,0,,		被杀了吗
Dialogue: 0,0:01:44.87,0:01:46.04,DefaultSingle-S,,0,0,0,,		我  我没事
Dialogue: 0,0:01:46.21,0:01:47.29,DefaultSingle-S,,0,0,0,,		什么啊
Dialogue: 0,0:01:47.62,0:01:49.75,DefaultSingle-S,,0,0,0,,		别发出引人误会的声音啊
Dialogue: 0,0:01:53.00,0:01:54.84,DefaultSingle-S,,0,0,0,,		在尴尬的时间醒来了
Dialogue: 0,0:01:55.26,0:01:56.17,DefaultSingle-S,,0,0,0,,		睡不着
Dialogue: 0,0:01:56.42,0:01:58.43,DefaultSingle-S,,0,0,0,,		去便利店买点酒吧
Dialogue: 0,0:01:59.43,0:02:00.31,DefaultSingle-S,,0,0,0,,		关门了
Dialogue: 0,0:02:00.68,0:02:02.14,DefaultSingle-S,,0,0,0,,		早7点到晚11点？
Dialogue: 0,0:02:02.35,0:02:03.60,DefaultSingle-S,,0,0,0,,		怎么跟乡下便利店一样
Dialogue: 0,0:02:03.60,0:02:06.43,DefaultSingle-S,,0,0,0,,		不  这年头乡下便利店都是24小时营业了啊
Dialogue: 0,0:02:07.48,0:02:10.36,DefaultSingle-S,,0,0,0,,		对了  一个人都没有啊
Dialogue: 0,0:02:12.27,0:02:14.07,DefaultSingle-S,,0,0,0,,		回  回去吧
Dialogue: 0,0:02:15.86,0:02:16.99,DefaultSingle-S,,0,0,0,,		情况怎样
Dialogue: 0,0:02:17.07,0:02:19.45,DefaultSingle-S,,0,0,0,,		嗯  非常顺利
Dialogue: 0,0:02:20.82,0:02:21.70,DefaultSingle-S,,0,0,0,,		有人在看我们？
Dialogue: 0,0:02:21.70,0:02:22.91,DefaultSingle-S,,0,0,0,,		错觉吧
Dialogue: 0,0:02:22.91,0:02:26.87,DefaultSingle-S,,0,0,0,,		这个点还在米花町转悠  就等于是找死
Dialogue: 0,0:02:28.58,0:02:29.75,DefaultSingle-S,,0,0,0,,		回去吧  不买酒了
Dialogue: 0,0:02:29.75,0:02:31.33,DefaultSingle-S,,0,0,0,,		深夜的米花町太危险了
Dialogue: 0,0:02:31.33,0:02:32.92,DefaultSingle-S,,0,0,0,,		咦  要走哪条路来着  迷路了？
Dialogue: 0,0:02:32.92,0:02:33.88,DefaultSingle-S,,0,0,0,,		那家店开着门
Dialogue: 0,0:02:36.59,0:02:38.08,DefaultSingle-S,,0,0,0,,		欢迎
Dialogue: 0,0:02:39.13,0:02:41.09,DefaultSingle-S,,0,0,0,,		慢慢看哦
Dialogue: 0,0:02:41.30,0:02:41.76,DefaultSingle-S,,0,0,0,,		好的
Dialogue: 0,0:02:44.89,0:02:46.93,DefaultSingle-S,,0,0,0,,		请问  这是什么店啊
Dialogue: 0,0:02:47.02,0:02:48.60,DefaultSingle-S,,0,0,0,,		防身用具店
Dialogue: 0,0:02:48.60,0:02:49.31,DefaultSingle-S,,0,0,0,,		防身？
Dialogue: 0,0:02:49.60,0:02:51.60,DefaultSingle-S,,0,0,0,,		你难道手无寸铁？
Dialogue: 0,0:02:51.77,0:02:55.65,DefaultSingle-S,,0,0,0,,		这可不行  好歹也要带个电击枪或者菜刀
Dialogue: 0,0:02:55.65,0:02:57.44,DefaultSingle-S,,0,0,0,,		菜刀是可以随身携带的吗
Dialogue: 0,0:02:57.44,0:02:58.99,DefaultSingle-S,,0,0,0,,		生命是无可替代的
Dialogue: 0,0:03:01.20,0:03:04.37,DefaultSingle-S,,0,0,0,,		也对  好想要个防身武器啊
Dialogue: 0,0:03:04.37,0:03:04.95,DefaultSingle-S,,0,0,0,,		那就…
Dialogue: 0,0:03:05.28,0:03:06.41,DefaultSingle-S,,0,0,0,,		请给我这把菜刀
Dialogue: 0,0:03:06.58,0:03:06.95,DefaultSingle-S,,0,0,0,,		好的
Dialogue: 0,0:03:07.29,0:03:08.58,DefaultSingle-S,,0,0,0,,		8万日元
Dialogue: 0,0:03:08.58,0:03:09.12,DefaultSingle-S,,0,0,0,,		好贵
Dialogue: 0,0:03:09.12,0:03:09.71,DefaultSingle-S,,0,0,0,,		那就2万
Dialogue: 0,0:03:09.71,0:03:10.42,DefaultSingle-S,,0,0,0,,		好便宜…
Dialogue: 0,0:03:10.42,0:03:11.42,DefaultSingle-S,,0,0,0,,		不  并不便宜
Dialogue: 0,0:03:11.42,0:03:12.54,DefaultSingle-S,,0,0,0,,		2万也很贵
Dialogue: 0,0:03:12.54,0:03:13.75,DefaultSingle-S,,0,0,0,,		她是不是在坑我啊
Dialogue: 0,0:03:15.34,0:03:19.26,DefaultSingle-S,,0,0,0,,		我在这里开店这么多年  看过好多个了
Dialogue: 0,0:03:19.55,0:03:21.69,DefaultSingle-S,,0,0,0,,		因为抠门而死的年轻人
Dialogue: 0,0:03:22.01,0:03:25.18,DefaultSingle-S,,0,0,0,,		明明生命才是最贵重的
Dialogue: 0,0:03:26.39,0:03:26.85,DefaultSingle-S,,0,0,0,,		给
Dialogue: 0,0:03:27.10,0:03:30.56,DefaultSingle-S,,0,0,0,,		多谢惠顾
Dialogue: 0,0:03:31.19,0:03:32.94,DefaultSingle-S,,0,0,0,,		是一次很棒的购物…吧
Dialogue: 0,0:03:33.06,0:03:34.56,DefaultSingle-S,,0,0,0,,		毕竟性命更重要
Dialogue: 0,0:03:34.69,0:03:36.82,DefaultSingle-S,,0,0,0,,		嗯嗯  没事  我没被坑
Dialogue: 0,0:03:37.02,0:03:40.65,DefaultSingle-S,,0,0,0,,		这个人只是因为过于体贴  所以看上去一脸奸笑
Dialogue: 0,0:03:40.65,0:03:43.11,DefaultSingle-S,,0,0,0,,		多谢惠顾
Dialogue: 0,0:03:44.55,0:03:46.93,DefaultSingle-S,,0,0,0,,		你想喝酒就跑出来了？
Dialogue: 0,0:03:46.93,0:03:49.33,DefaultSingle-S,,0,0,0,,		那我给你介绍一家不错的店
Dialogue: 0,0:03:49.51,0:03:52.89,DefaultSingle-S,,0,0,0,,		听好了  这座城市可怕的不光是杀人案
Dialogue: 0,0:03:52.89,0:03:54.81,DefaultSingle-S,,0,0,0,,		这里骗子和扒手也很多的
Dialogue: 0,0:03:54.81,0:03:56.15,DefaultSingle-S,,0,0,0,,		请多加小心
Dialogue: 0,0:03:58.19,0:04:00.44,DefaultSingle-S,,0,0,0,,		一共18万日元
Dialogue: 0,0:04:00.44,0:04:02.19,DefaultSingle-S,,0,0,0,,		这不是宰客酒吧吗
Dialogue: 0,0:04:02.19,0:04:04.69,DefaultSingle-S,,0,0,0,,		对  对不起  我没有钱
Dialogue: 0,0:04:04.82,0:04:05.61,DefaultSingle-S,,0,0,0,,		好可怕
Dialogue: 0,0:04:05.61,0:04:08.78,DefaultSingle-S,,0,0,0,,		那就现在去ATM机取钱吧
Dialogue: 0,0:04:09.41,0:04:11.83,DefaultSingle-S,,0,0,0,,		我同时打好几份工才攒了这笔钱
Dialogue: 0,0:04:12.08,0:04:15.12,DefaultSingle-S,,0,0,0,,		这是我来东京之后直到生活安定下来的生活费
Dialogue: 0,0:04:15.20,0:04:17.11,DefaultSingle-S,,0,0,0,,		怎么能交给这种人
Dialogue: 0,0:04:17.67,0:04:18.86,DefaultSingle-S,,0,0,0,,		咦  钱包不见了
Dialogue: 0,0:04:19.46,0:04:22.49,DefaultSingle-S,,0,0,0,,		骗子和扒手也很多的  请多加小心
Dialogue: 0,0:04:22.59,0:04:24.32,DefaultSingle-S,,0,0,0,,		那个老太婆
Dialogue: 0,0:04:24.55,0:04:27.68,DefaultSingle-S,,0,0,0,,		总之先把你死死护着的背包拿来吧
Dialogue: 0,0:04:27.68,0:04:29.93,DefaultSingle-S,,0,0,0,,		为什么我会遇到这种倒霉事
Dialogue: 0,0:04:31.35,0:04:32.26,DefaultSingle-S,,0,0,0,,		这啥啊
Dialogue: 0,0:04:32.60,0:04:33.39,DefaultSingle-S,,0,0,0,,		这是…
Dialogue: 0,0:04:33.50,0:04:34.87,DefaultSingle-S,,0,0,0,,		3万日元啊
Dialogue: 0,0:04:34.87,0:04:37.04,DefaultSingle-S,,0,0,0,,		不够啊  我就先收下了
Dialogue: 0,0:04:40.25,0:04:42.72,DefaultSingle-S,,0,0,0,,		你去吧  多保重啊
Dialogue: 0,0:04:42.80,0:04:44.51,DefaultSingle-S,,0,0,0,,		钱不多  算是饯别礼吧
Dialogue: 0,0:04:44.51,0:04:46.14,DefaultSingle-S,,0,0,0,,		拿着有困难的时候用吧
Dialogue: 0,0:04:47.76,0:04:49.43,DefaultSingle-S,,0,0,0,,		不  这笔钱…
Dialogue: 0,0:04:50.26,0:04:54.10,DefaultSingle-S,,0,0,0,,		我要等到复仇成功时  用来当回家的路费
Dialogue: 0,0:04:54.60,0:04:56.60,DefaultSingle-S,,0,0,0,,		我太小看米花町了
Dialogue: 0,0:04:56.85,0:05:00.90,DefaultSingle-S,,0,0,0,,		我一心只想杀那个男人  所以强忍着没有杀其他人
Dialogue: 0,0:05:01.15,0:05:01.82,DefaultSingle-S,,0,0,0,,		太天真
Dialogue: 0,0:05:02.40,0:05:06.24,DefaultSingle-S,,0,0,0,,		为了在这座城市生存下去  有时也必须动手
Dialogue: 0,0:05:09.28,0:05:11.37,DefaultSingle-S,,0,0,0,,		毛利先生  你喝太多了啦
Dialogue: 0,0:05:11.37,0:05:13.00,DefaultSingle-S,,0,0,0,,		拿酒来
Dialogue: 0,0:05:13.00,0:05:15.37,DefaultSingle-S,,0,0,0,,		先生  请结账
Dialogue: 0,0:05:15.96,0:05:17.00,DefaultSingle-S,,0,0,0,,		30万？
Dialogue: 0,0:05:17.12,0:05:17.92,DefaultSingle-S,,0,0,0,,		开什么玩笑
Dialogue: 0,0:05:17.92,0:05:20.04,DefaultSingle-S,,0,0,0,,		你们几个  给他醒醒酒
Dialogue: 0,0:05:20.04,0:05:20.75,DefaultSingle-S,,0,0,0,,		好嘞
Dialogue: 0,0:05:25.09,0:05:26.93,DefaultSingle-S,,0,0,0,,		爸爸  回家了
Dialogue: 0,0:05:27.80,0:05:29.18,DefaultSingle-S,,0,0,0,,		你谁啊
Dialogue: 0,0:05:29.35,0:05:31.47,DefaultSingle-S,,0,0,0,,		真是的  又酔成这样
Dialogue: 0,0:05:31.47,0:05:32.89,DefaultSingle-S,,0,0,0,,		我要向妈妈告状了哦
Dialogue: 0,0:05:32.89,0:05:33.98,DefaultSingle-S,,0,0,0,,		跟她又没关系
Dialogue: 0,0:05:34.18,0:05:35.23,DefaultSingle-S,,0,0,0,,		等一下
Dialogue: 0,0:05:35.23,0:05:38.73,DefaultSingle-S,,0,0,0,,		我们可是做生意的  你们得付了钱才能走
Dialogue: 0,0:05:38.86,0:05:41.77,DefaultSingle-S,,0,0,0,,		还是说  小妹妹你愿意用身体来赚钱吗
Dialogue: 0,0:05:49.49,0:05:51.41,DefaultSingle-S,,0,0,0,,		你  你是什么人
Dialogue: 0,0:05:52.37,0:05:54.00,DefaultSingle-S,,0,0,0,,		真是可惜
Dialogue: 0,0:05:54.12,0:05:56.41,DefaultSingle-S,,0,0,0,,		我可是有这玩意的
Dialogue: 0,0:05:56.41,0:05:57.42,DefaultSingle-S,,0,0,0,,		去死吧
Dialogue: 0,0:06:00.25,0:06:02.21,DefaultSingle-S,,0,0,0,,		别做这种事了啦
Dialogue: 0,0:06:02.96,0:06:06.51,DefaultSingle-S,,0,0,0,,		能别把我变成杀人犯吗
Dialogue: 0,0:06:10.30,0:06:12.43,DefaultSingle-S,,0,0,0,,		爸爸  你醒醒啦
Dialogue: 0,0:06:13.18,0:06:14.06,DefaultSingle-S,,0,0,0,,		你也是
Dialogue: 0,0:06:14.06,0:06:16.14,DefaultSingle-S,,0,0,0,,		不要做这种事哦
Dialogue: 0,0:06:16.73,0:06:18.27,DefaultSingle-S,,0,0,0,,		我已经受够了
Dialogue: 0,0:06:21.73,0:06:24.28,DefaultSingle-S,,0,0,0,,		咦  犯泽先生  欢迎回来
Dialogue: 0,0:06:24.44,0:06:26.61,DefaultSingle-S,,0,0,0,,		今天是理香的生日派对
Dialogue: 0,0:06:26.61,0:06:27.78,DefaultSingle-S,,0,0,0,,		喝起来
Dialogue: 0,0:06:28.40,0:06:29.95,DefaultSingle-S,,0,0,0,,		犯泽先生  你怎么了
Dialogue: 0,0:06:30.16,0:06:30.99,DefaultSingle-S,,0,0,0,,		钱包丢了？
Dialogue: 0,0:06:30.99,0:06:32.37,DefaultSingle-S,,0,0,0,,		没事吧  银行卡呢
Dialogue: 0,0:06:32.45,0:06:33.24,DefaultSingle-S,,0,0,0,,		看了余额吗
Dialogue: 0,0:06:34.45,0:06:35.16,DefaultSingle-S,,0,0,0,,		余额？
Dialogue: 0,0:06:37.08,0:06:37.71,DefaultSingle-S,,0,0,0,,		零
Dialogue: 0,0:06:37.71,0:06:41.58,DefaultSingle-S,,0,0,0,,		最近有种叫盗刷的手段  能读取银行卡密码
Dialogue: 0,0:06:41.75,0:06:43.50,DefaultSingle-S,,0,0,0,,		在这座城市很常见
Dialogue: 0,0:06:43.50,0:06:44.05,DefaultSingle-S,,0,0,0,,		零…
Dialogue: 0,0:06:44.05,0:06:46.17,DefaultSingle-S,,0,0,0,,		都是那个老太婆干的  饶不了她  杀了她
Dialogue: 0,0:06:46.17,0:06:47.42,DefaultSingle-S,,0,0,0,,		我要把她找出来…
Dialogue: 0,0:06:47.92,0:06:48.67,DefaultSingle-S,,0,0,0,,		等等
Dialogue: 0,0:06:48.97,0:06:51.09,DefaultSingle-S,,0,0,0,,		下个月的房租  今天的饭钱…
Dialogue: 0,0:06:51.84,0:06:56.52,DefaultSingle-S,,0,0,0,,		得找工作了
Dialogue: 0,0:08:31.57,0:08:32.15,DefaultSingle-S,,0,0,0,,		大家好
Dialogue: 0,0:08:32.15,0:08:34.20,DefaultSingle-S,,0,0,0,,		我是余额为零  交不起房租
Dialogue: 0,0:08:34.20,0:08:36.41,DefaultSingle-S,,0,0,0,,		即将被赶出去的犯泽
Dialogue: 0,0:08:36.62,0:08:38.95,DefaultSingle-S,,0,0,0,,		事已至此  我就出门找兼职了
Dialogue: 0,0:08:39.04,0:08:42.62,DefaultSingle-S,,0,0,0,,		但找到的是连黑衣组织都要大吃一惊的超黑心工作
Dialogue: 0,0:08:43.12,0:08:46.67,DefaultSingle-S,,0,0,0,,		介绍给我这个工作的是一个穿着白衣可疑男子
Dialogue: 0,0:08:46.67,0:08:49.21,DefaultSingle-S,,0,0,0,,		他外表完全就是个老头子
Dialogue: 0,0:08:49.21,0:08:52.01,DefaultSingle-S,,0,0,0,,		但年龄居然只有五十多岁
Dialogue: 0,0:08:52.05,0:08:53.84,DefaultSingle-S,,0,0,0,,		官方搞的什么设定啊
Dialogue: 0,0:08:53.92,0:08:56.34,DefaultSingle-S,,0,0,0,,		下集「离开的倒计时」
Dialogue: 0,0:08:56.39,0:09:00.35,DefaultSingle-S,,0,0,0,,		老妈说过  一根麻醉针也能要人命
Dialogue: 0,0:01:36.37,0:01:39.37,DefaultSingle-S,,0,0,0,,

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:01.31,0:01:04.28,Layzner,Gail,0,0,0,,我知道你一定不会原谅手上沾满你弟弟鲜血的我
Dialogue: 0,0:01:04.28,0:01:05.60,Layzner,Gail,0,0,0,,再见了 英二
Dialogue: 0,0:01:05.61,0:01:07.14,Layzner,Eiji,0,0,0,,再见了 凯利前辈
Dialogue: 0,0:01:42.90,0:01:46.93,Layzner,David,0,0,0,,要杀就在这里杀了我们
Dialogue: 0,0:01:42.90,0:01:46.93,Layzner,David,0,0,0,,怎么能让你们把我们丢到宇宙空间里
Dialogue: 0,0:01:47.34,0:01:48.63,Layzner,Egyle,0,0,0,,快给我进去
Dialogue: 0,0:01:48.85,0:01:50.26,Layzner,David,0,0,0,,要开枪就在这开枪
Dialogue: 0,0:01:50.26,0:01:50.81,Layzner,Eiji,0,0,0,,大卫
Dialogue: 0,0:01:51.63,0:01:56.78,Layzner,Anna,0,0,0,,被外星人捉走 我们的命运就好像风中残烛一样
Dialogue: 0,0:01:58.14,0:02:02.51,Layzner,Anna,0,0,0,,可是上天还是没有放弃我们
Dialogue: 0,0:02:04.04,0:02:08.61,Layzner,Anna,0,0,0,,我们之中有人特别受上天疼爱
Dialogue: 0,0:02:08.61,0:02:11.78,Layzner,Anna,0,0,0,,我是这么觉得的
Dialogue: 0,0:02:11.78,0:02:12.58,Layzner,Eiji,0,0,0,,把枪丢掉
Dialogue: 0,0:02:12.60,0:02:17.59,Layzner,Eiji,0,0,0,,第十五话 变成苍之流星
Dialogue: 0,0:02:31.17,0:02:34.00,Layzner,Soldier,0,0,0,,救到卡露拉少尉了 现在要回航了
Dialogue: 0,0:02:34.00,0:02:38.68,Layzner,Gail,0,0,0,,英二 你以为靠你自己真的能活下去吗
Dialogue: 0,0:02:39.90,0:02:42.41,Layzner,Gail,0,0,0,,太可惜了 那太难了
Dialogue: 0,0:02:52.07,0:02:53.96,Layzner,Officer,0,0,0,,卡露拉少尉回收了
Dialogue: 0,0:02:56.97,0:02:58.43,Layzner,Gail,0,0,0,,好 本舰的损坏状况呢
Dialogue: 0,0:02:58.69,0:03:01.66,Layzner,Officer,0,0,0,,戒备中 现在在维修中 马上就好了
Dialogue: 0,0:03:01.66,0:03:03.32,Layzner,Off2,0,0,0,,报告 修理好了
Dialogue: 0,0:03:03.32,0:03:05.56,Layzner,Gail,0,0,0,,好 马上追击
Dialogue: 0,0:03:19.87,0:03:21.25,Layzner,Egyle,0,0,0,,凯利中尉
Dialogue: 0,0:03:21.25,0:03:22.71,Layzner,Gail,0,0,0,,没受伤吗
Dialogue: 0,0:03:25.55,0:03:26.67,Layzner,Gail,0,0,0,,是吗
Dialogue: 0,0:03:31.91,0:03:33.52,Layzner,Solider,0,0,0,,少尉 请住手
Dialogue: 0,0:03:37.93,0:03:39.83,Layzner,Egyle,0,0,0,,我自己闯的祸我自己负责
Dialogue: 0,0:03:40.28,0:03:42.06,Layzner,Gail,0,0,0,,我不会让你死的
Dialogue: 0,0:03:42.06,0:03:48.06,Layzner,Egyle,0,0,0,,请中尉您杀了我
Dialogue: 0,0:03:42.06,0:03:48.06,Layzner,Egyle,0,0,0,,我 如果我做的事你无法原谅的话
Dialogue: 0,0:03:49.79,0:03:51.22,Layzner,Gail,0,0,0,,我知道了
Dialogue: 0,0:04:02.46,0:04:04.69,Layzner,Gail,0,0,0,,本舰的负责人是我
Dialogue: 0,0:04:06.46,0:04:10.41,Layzner,Gail,0,0,0,,所以在本舰发生的任何事由我负责
Dialogue: 0,0:04:10.95,0:04:11.84,Layzner,Egyle,0,0,0,,中尉
Dialogue: 0,0:04:16.87,0:04:18.83,Layzner,Gail,0,0,0,,追击航天飞机的事就拜托你了
Dialogue: 0,0:04:19.30,0:04:21.57,Layzner,Gail,0,0,0,,为了准备等一下的战斗我要先休息一下
Dialogue: 0,0:04:37.35,0:04:40.15,Layzner,Gail,0,0,0,,我一定要亲手打倒英二
Dialogue: 0,0:05:09.76,0:05:13.51,Layzner,Egyle,0,0,0,,凯利中尉 只要是为了你 我
Dialogue: 0,0:05:25.07,0:05:27.20,Layzner,David,0,0,0,,看样子好像得救了
Dialogue: 0,0:05:27.20,0:05:29.30,Layzner,Arthur,0,0,0,,一定是上天在保佑我们
Dialogue: 0,0:05:29.30,0:05:31.02,Layzner,Elizabeth,0,0,0,,亚瑟 肚子好了吗
Dialogue: 0,0:05:31.51,0:05:36.49,Layzner,Arthur,0,0,0,,那个啊 我每次一紧张就会肚子痛
Dialogue: 0,0:05:36.49,0:05:38.08,Layzner,,0,0,0,,我很敏感对吧
Dialogue: 0,0:05:38.09,0:05:40.36,Layzner,Simone,0,0,0,,你有自知之明真是太好了
Dialogue: 0,0:05:40.36,0:05:43.52,Layzner,Arthur,0,0,0,,你太失礼了 我从十三岁开始
Dialogue: 0,0:05:45.27,0:05:48.27,Layzner,David,0,0,0,,亚瑟 你还真是老实
Dialogue: 0,0:05:49.40,0:05:54.07,Layzner,Arthur,0,0,0,,可是我妈妈说十三岁还算正常 对吧 博士
Dialogue: 0,0:05:54.07,0:05:55.30,Layzner,Elizabeth,0,0,0,,这个嘛
Dialogue: 0,0:05:59.00,0:06:01.91,Layzner,Roanne,0,0,0,,安静一点 电脑正在计算
Dialogue: 0,0:06:02.30,0:06:03.70,Layzner,David,0,0,0,,计算什么
Dialogue: 0,0:06:05.00,0:06:06.08,Layzner,Eiji,0,0,0,,算出来了
Dialogue: 0,0:06:06.08,0:06:11.62,Layzner,Com,0,0,0,,目标距离 有97.62%会被追击舰捕捉
Dialogue: 0,0:06:12.46,0:06:13.23,Layzner,Simone,0,0,0,,什么意思
Dialogue: 0,0:06:13.94,0:06:18.21,Layzner,Roanne,0,0,0,,就是说我们在到达最短距离前就会被追击队捉到
Dialogue: 0,0:06:18.94,0:06:21.90,Layzner,Arthur,0,0,0,,怎么会这样 这么说我们逃不掉了
Dialogue: 0,0:06:21.90,0:06:25.17,Layzner,Eiji,0,0,0,,那船装有Inter-Planet Drive系统的引擎
Dialogue: 0,0:06:26.52,0:06:31.12,Layzner,,0,0,0,,所以我们不要再吵了 快想办法逃吧
Dialogue: 0,0:06:26.52,0:06:31.12,Layzner,,0,0,0,,现在你们也看到电脑计算的结果了
Dialogue: 0,0:06:31.63,0:06:32.81,Layzner,David,0,0,0,,如果被捉到的话
Dialogue: 0,0:06:34.01,0:06:35.87,Layzner,Eiji,0,0,0,,这次我们一定会被
Dialogue: 0,0:06:36.28,0:06:38.95,Layzner,Arthur,0,0,0,,你的意思是我们会被干掉是吗
Dialogue: 0,0:06:38.95,0:06:41.28,Layzner,,0,0,0,,好痛 我的肚子又 好痛
Dialogue: 0,0:06:50.86,0:06:55.38,Layzner,Elizabeth,0,0,0,,月球基地请回答
Dialogue: 0,0:06:50.86,0:06:55.38,Layzner,Elizabeth,0,0,0,,我是隶属于联合国宇宙局的伊丽莎白·克蕾布里
Dialogue: 0,0:06:55.38,0:06:59.16,Layzner,Elizabeth,0,0,0,,美国和苏联军的舰队都因为外星人而全灭
Dialogue: 0,0:06:59.16,0:07:02.18,Layzner,Elizabeth,0,0,0,,现在我们也正在被外星人追击中
Dialogue: 0,0:07:02.18,0:07:03.85,Layzner,,0,0,0,,请求紧急救援
Dialogue: 0,0:07:08.27,0:07:09.68,Layzner,Arthur,0,0,0,,为什么没有回应
Dialogue: 0,0:07:09.92,0:07:12.18,Layzner,Arthur,0,0,0,,从这传电波又不需要几十分钟
Dialogue: 0,0:07:12.79,0:07:15.47,Layzner,Arthur,0,0,0,,早知道那时候应该再多破坏一下的
Dialogue: 0,0:07:15.60,0:07:17.80,Layzner,David,0,0,0,,我们那时候哪有那么多时间啊
Dialogue: 0,0:07:17.80,0:07:19.40,Layzner,Arthur,0,0,0,,可是如果再破坏一下的话
Dialogue: 0,0:07:19.40,0:07:22.85,Layzner,Roanne,0,0,0,,这样的话我们那时候就被杀了
Dialogue: 0,0:07:37.77,0:07:41.74,Layzner,Simone,0,0,0,,如果回地球的话好想洗个热水澡
Dialogue: 0,0:07:42.36,0:07:44.88,Layzner,Simone,0,0,0,,用玫瑰香味的香波洗头
Dialogue: 0,0:07:46.93,0:07:52.68,Layzner,Simone,0,0,0,,再穿上最喜欢的丝绸礼服 然后再去约会
Dialogue: 0,0:07:52.94,0:07:54.02,Layzner,Arthur,0,0,0,,跟谁
Dialogue: 0,0:07:54.74,0:07:57.48,Layzner,Simone,0,0,0,,这个嘛 跟谁好呢
Dialogue: 0,0:07:59.46,0:08:03.49,Layzner,David,0,0,0,,我怎么样 如果回去的话 请跟我交往
Dialogue: 0,0:08:03.49,0:08:05.02,Layzner,Arthur,0,0,0,,我也是
Dialogue: 0,0:08:06.07,0:08:07.22,Layzner,Simone,0,0,0,,我要先跟爸爸交往
Dialogue: 0,0:08:07.60,0:08:09.62,Layzner,Arthur,0,0,0,,那爸爸之后换我
Dialogue: 0,0:08:09.62,0:08:11.19,Layzner,Simone,0,0,0,,这个嘛
Dialogue: 0,0:08:11.19,0:08:14.58,Layzner,Arthur,0,0,0,,好 大卫 来猜拳嘛
Dialogue: 0,0:08:15.36,0:08:19.85,Layzner,Arthur,0,0,0,,干嘛 别装了  你不也想跟她约会吗
Dialogue: 0,0:08:19.85,0:08:21.07,Layzner,Arthur,0,0,0,,你这家伙
Dialogue: 0,0:08:21.07,0:08:23.77,Layzner,Arthur,0,0,0,,光明正大地像个绅士般来猜拳吧
Dialogue: 0,0:08:23.77,0:08:27.22,Layzner,David,0,0,0,,好 这有趣 亚瑟 来猜拳吧
Dialogue: 0,0:08:27.53,0:08:30.36,Layzner,D&A,0,0,0,,石头剪子布
Dialogue: 0,0:08:30.54,0:08:34.78,Layzner,Simone,0,0,0,,两个人都加油 我答应你们跟赢的人先约会
Dialogue: 0,0:08:34.78,0:08:37.30,Layzner,Anna,0,0,0,,设法要突破这沉重的恐怖感 大家的心中
Dialogue: 0,0:08:37.30,0:08:42.90,Layzner,,0,0,0,,我可以感觉到大家的悲痛
Dialogue: 0,0:08:42.90,0:08:45.84,Layzner,Arthur,0,0,0,,赢了 我能先和西蒙尼约会了
Dialogue: 0,0:08:46.69,0:08:48.44,Layzner,Eiji,0,0,0,,伊丽莎白博士
Dialogue: 0,0:08:50.23,0:08:51.32,Layzner,Elizabeth,0,0,0,,怎么了
Dialogue: 0,0:09:01.38,0:09:03.58,Layzner,Eiji,0,0,0,,那星球
Dialogue: 0,0:09:04.58,0:09:06.82,Layzner,,0,0,0,,那就是地球对吧
Dialogue: 0,0:09:06.82,0:09:10.13,Layzner,Elizabeth,0,0,0,,对啊 那就是我们的故乡
Dialogue: 0,0:09:10.13,0:09:12.09,Layzner,,0,0,0,,那就是我们的目标星球
Dialogue: 0,0:09:14.60,0:09:16.24,Layzner,Simone,0,0,0,,真的是地球
Dialogue: 0,0:09:16.54,0:09:18.47,Layzner,Arthur,0,0,0,,是我们的星球
Dialogue: 0,0:09:17.35,0:09:18.47,Layzner,David,0,0,0,,终于回来了
Dialogue: 0,0:09:29.67,0:09:35.08,Layzner,Anna,0,0,0,,温柔地闪耀着蔚蓝色光芒的星球 地球
Dialogue: 0,0:09:29.67,0:09:35.08,Layzner,Anna,0,0,0,,在宇宙这一片黑暗的海中
Dialogue: 0,0:09:35.54,0:09:39.83,Layzner,Anna,0,0,0,,好像让我们心中涌起了愉快的心情
Dialogue: 0,0:09:39.83,0:09:42.83,Layzner,,0,0,0,,重新的发现地球
Dialogue: 0,0:09:45.30,0:09:46.79,Layzner,David,0,0,0,,英二
Dialogue: 0,0:10:03.50,0:10:07.38,Layzner,Gail,0,0,0,,你一定不会原谅手中沾满你弟弟的血的我吧
Dialogue: 0,0:10:09.12,0:10:10.86,Layzner,,0,0,0,,再见了 玖丽亚
Dialogue: 0,0:10:15.94,0:10:18.65,Layzner,Arthur,0,0,0,,这样下去会被追上的 快想点办法
Dialogue: 0,0:10:18.67,0:10:20.65,Layzner,Eiji,0,0,0,,速度没办法再快了
Dialogue: 0,0:10:20.65,0:10:21.71,Layzner,David,0,0,0,,可恶
Dialogue: 0,0:10:21.92,0:10:22.70,Layzner,Elizabeth,0,0,0,,大卫
Dialogue: 0,0:10:23.83,0:10:24.85,Layzner,David,0,0,0,,只有战斗一途了
Dialogue: 0,0:10:26.07,0:10:27.47,Layzner,Eiji,0,0,0,,请跟我换一下
Dialogue: 0,0:10:27.47,0:10:29.04,Layzner,Roanne,0,0,0,,亚瑟 拜托你了
Dialogue: 0,0:10:32.30,0:10:34.13,Layzner,Egyle,0,0,0,,捕捉到目标了
Dialogue: 0,0:10:34.75,0:10:37.46,Layzner,Gail,0,0,0,,保持速度 跟太空船平行
Dialogue: 0,0:10:37.46,0:10:38.17,Layzner,Off,0,0,0,,了解
Dialogue: 0,0:10:38.56,0:10:39.35,Layzner,Gail,0,0,0,,好
Dialogue: 0,0:10:39.35,0:10:42.51,Layzner,Egyle,0,0,0,,凯利中尉 请让我一起去
Dialogue: 0,0:10:46.14,0:10:49.90,Layzner,Gail,0,0,0,,男人的死法有两种
Dialogue: 0,0:10:49.90,0:10:53.65,Layzner,Gail,0,0,0,,我想让有勇气真正的男儿光荣地死去
Dialogue: 0,0:10:49.90,0:10:53.65,Layzner,Gail,0,0,0,,一是位名誉而死 一是白白的牺牲
Dialogue: 0,0:10:53.91,0:10:55.18,Layzner,Egyle,0,0,0,,光荣的死
Dialogue: 0,0:10:55.59,0:10:59.04,Layzner,Gail,0,0,0,,他也是古拉特斯人 记住这一点
Dialogue: 0,0:11:00.62,0:11:01.45,Layzner,Egyle,0,0,0,,中尉
Dialogue: 0,0:11:04.99,0:11:07.42,Layzner,Eiji,0,0,0,,大卫 罗安 听到了吗
Dialogue: 0,0:11:07.42,0:11:08.53,Layzner,David,0,0,0,,干嘛
Dialogue: 0,0:11:08.53,0:11:12.51,Layzner,Eiji,0,0,0,,敌人只想引我出来 所以我想请你们保护航天飞机
Dialogue: 0,0:11:12.51,0:11:15.07,Layzner,David,0,0,0,,英二 这时候不要再逞强了
Dialogue: 0,0:11:15.07,0:11:16.35,Layzner,Roanne,0,0,0,,你一个人是办不到的
Dialogue: 0,0:11:16.35,0:11:20.34,Layzner,Eiji,0,0,0,,听好了 我答应要保护大家的
Dialogue: 0,0:11:20.34,0:11:24.56,Layzner,Eiji,0,0,0,,如果我被打倒的话请你们跟地球的人们转达
Dialogue: 0,0:11:24.56,0:11:28.52,Layzner,Eiji,0,0,0,,为了让那个蔚蓝的星球一直闪耀
Dialogue: 0,0:11:28.52,0:11:31.39,Layzner,,0,0,0,,我想请你们帮帮忙
Dialogue: 0,0:11:48.76,0:11:51.47,Layzner,Off,0,0,0,,卡露拉少尉
Dialogue: 0,0:11:51.47,0:11:55.92,Layzner,,0,0,0,,行进中的轨道有地球的舰队
Dialogue: 0,0:12:12.73,0:12:15.66,Layzner,Gail,0,0,0,,什么 你说地球的舰队接近中
Dialogue: 0,0:12:15.66,0:12:17.87,Layzner,Off,0,0,0,,我传送影像给您看
Dialogue: 0,0:12:17.87,0:12:20.71,Layzner,Gail,0,0,0,,卡露拉 你先去跟地球的舰队作战
Dialogue: 0,0:12:20.71,0:12:23.08,Layzner,,0,0,0,,用你那边的主炮击沉大型母舰
Dialogue: 0,0:12:23.08,0:12:24.53,Layzner,Egyle,0,0,0,,了解
Dialogue: 0,0:12:33.88,0:12:36.08,Layzner,Arthur,0,0,0,,是地球军
Dialogue: 0,0:12:36.08,0:12:38.14,Layzner,,0,0,0,,来了
Dialogue: 0,0:12:38.14,0:12:40.31,Layzner,Elizavbeth,0,0,0,,地球舰队 请回答
Dialogue: 0,0:12:41.17,0:12:46.09,Layzner,,0,0,0,,我是联合国的伊丽莎白·克蕾布里 请回答
Dialogue: 0,0:12:46.09,0:12:50.66,Layzner,Off,0,0,0,,我是奥赛号的舰长撒扎兰多
Dialogue: 0,0:12:46.09,0:12:50.66,Layzner,Off,0,0,0,,伊丽莎白·克蕾布里 我们听得很清楚
Dialogue: 0,0:12:50.66,0:12:51.83,Layzner,Arthur,0,0,0,,太好了
Dialogue: 0,0:12:51.83,0:12:55.91,Layzner,Southerland,0,0,0,,刚才没回应你们 是为了防止敌人偷听
Dialogue: 0,0:12:56.54,0:13:01.19,Layzner,Elizabeth,0,0,0,,我们坐的外星人航天飞机正在被大型的追击队追击
Dialogue: 0,0:13:01.55,0:13:05.18,Layzner,Southerland,0,0,0,,我已知道你说的外星人也就是敌人的存在
Dialogue: 0,0:13:05.18,0:13:07.43,Layzner,,0,0,0,,我们马上就会展开攻击
Dialogue: 0,0:13:07.43,0:13:09.78,Layzner,Southerland,0,0,0,,我们也会保护你们
Dialogue: 0,0:13:09.78,0:13:13.61,Layzner,Southerland,0,0,0,,接下来你们就这样前往月球基地 祝你们好运
Dialogue: 0,0:13:13.61,0:13:14.86,Layzner,Elizabeth,0,0,0,,谢谢你 舰长
Dialogue: 0,0:13:14.86,0:13:17.80,Layzner,Arthur,0,0,0,,没问题了 这下真的得救了
Dialogue: 0,0:13:21.51,0:13:26.48,Layzner,,0,0,0,,一定会毫不留情的攻过来的
Dialogue: 0,0:13:21.51,0:13:26.48,Layzner,,0,0,0,,凯利前辈 这次对地球的军队
Dialogue: 0,0:13:57.79,0:14:01.29,Layzner,Gail,0,0,0,,地球的人们 让你们看看我们古拉特斯真正的力量
Dialogue: 0,0:14:36.44,0:14:38.07,Layzner,,0,0,0,,剩下的小角色就交给你们了
Dialogue: 0,0:14:59.22,0:15:01.10,Layzner,Eiji,0,0,0,,根本打不赢他们
Dialogue: 0,0:15:11.99,0:15:14.05,Layzner,Off,0,0,0,,地球军军舰进入射程范围
Dialogue: 0,0:15:14.05,0:15:14.99,Layzner,Egyle,0,0,0,,锁定他们
Dialogue: 0,0:15:14.99,0:15:16.99,Layzner,Com,0,0,0,,目标锁定完成
Dialogue: 0,0:15:16.99,0:15:18.00,Layzner,Egyle,0,0,0,,射击
Dialogue: 0,0:15:32.34,0:15:34.60,Layzner,Gail,0,0,0,,好鲜艳啊 做得好 卡露拉
Dialogue: 0,0:15:56.70,0:16:01.16,Layzner,Eiji,0,0,0,,这才是 古拉特斯真正的力量
Dialogue: 0,0:16:09.87,0:16:11.61,Layzner,Anna,0,0,0,,不要 不要
Dialogue: 0,0:16:11.61,0:16:14.03,Layzner,Simone,0,0,0,,全灭
Dialogue: 0,0:16:14.03,0:16:15.59,Layzner,Elizabeth,0,0,0,,真令人不敢相信
Dialogue: 0,0:16:43.04,0:16:45.95,Layzner,Gail,0,0,0,,给我出来 英二 碍事的家伙都没了
Dialogue: 0,0:16:54.47,0:16:57.86,Layzner,Eiji,0,0,0,,伊丽莎白博士 你们尽可能躲开 大家就拜托你了
Dialogue: 0,0:16:57.86,0:16:58.85,Layzner,Elizabeth,0,0,0,,英二
Dialogue: 0,0:17:02.00,0:17:03.79,Layzner,Gail,0,0,0,,看来你已有觉悟了
Dialogue: 0,0:17:03.79,0:17:04.73,Layzner,Eiji,0,0,0,,凯利前辈
Dialogue: 0,0:17:04.73,0:17:07.06,Layzner,Gail,0,0,0,,英二 没有人会来妨碍我们了
Dialogue: 0,0:17:12.95,0:17:14.18,Layzner,Gail,0,0,0,,永别了 英二
Dialogue: 0,0:17:14.18,0:17:16.39,Layzner,Eiji,0,0,0,,再见了 凯利前辈
Dialogue: 0,0:17:28.40,0:17:29.16,Layzner,Eiji,0,0,0,,他在哪里
Dialogue: 0,0:17:29.16,0:17:33.26,Layzner,Gail,0,0,0,,太天真了 就连你背负着的地球的这重担一起来吧
Dialogue: 0,0:17:41.69,0:17:45.52,Layzner,Rey,0,0,0,,右边踝部中弹 损坏率0.02
Dialogue: 0,0:17:45.52,0:17:46.74,Layzner,Eiji,0,0,0,,切换回路
Dialogue: 0,0:17:46.74,0:17:48.90,Layzner,Rey,0,0,0,,在31号处 有热源反应
Dialogue: 0,0:17:57.32,0:17:58.47,Layzner,Gail,0,0,0,,你们不要出手
Dialogue: 0,0:18:04.63,0:18:09.38,Layzner,Rey,0,0,0,,左边上腕部中弹 损坏率0.25
Dialogue: 0,0:18:09.38,0:18:10.79,Layzner,,0,0,0,,锁定目标
Dialogue: 0,0:18:12.19,0:18:13.11,Layzner,Eiji,0,0,0,,不能开枪
Dialogue: 0,0:18:16.09,0:18:19.27,Layzner,Rey,0,0,0,,腰部中弹 损坏率0.30
Dialogue: 0,0:18:19.27,0:18:21.49,Layzner,David,0,0,0,,英二 往右边闪
Dialogue: 0,0:18:21.49,0:18:23.22,Layzner,Eiji,0,0,0,,大卫 罗安 走开
Dialogue: 0,0:18:27.39,0:18:30.31,Layzner,David,0,0,0,,英二 都要死了还逞强吗 命只有一条
Dialogue: 0,0:18:30.31,0:18:34.53,Layzner,Roanne,0,0,0,,对啊 虽然我也很害怕但我们不能看同伴送死
Dialogue: 0,0:18:39.16,0:18:40.67,Layzner,Eiji,0,0,0,,大卫 罗安
Dialogue: 0,0:18:47.22,0:18:50.33,Layzner,Rey,0,0,0,,警告 马上撤退
Dialogue: 0,0:18:54.24,0:18:56.06,Layzner,Rey,0,0,0,,踝部中弹 损害严重
Dialogue: 0,0:18:56.08,0:18:59.75,Layzner,Rey,0,0,0,,无法逃离敌人范围 快逃出本机
Dialogue: 0,0:18:59.75,0:19:01.55,Layzner,Eiji,0,0,0,,还没完
Dialogue: 0,0:19:05.35,0:19:07.24,Layzner,Rey,0,0,0,,快逃出
Dialogue: 0,0:19:07.24,0:19:09.89,Layzner,Eiji,0,0,0,,怎么了 雷 怎么了
Dialogue: 0,0:19:11.69,0:19:14.57,Layzner,,0,0,0,,你在干什么 雷 怎么了 雷
Dialogue: 0,0:19:15.26,0:19:18.53,Layzner,Gail,0,0,0,,中途逃脱一点都不像你 英二
Dialogue: 0,0:19:20.26,0:19:21.47,Layzner,,0,0,0,,原谅我
Dialogue: 0,0:20:32.95,0:20:34.33,Layzner,Egyle,0,0,0,,凯利中尉
Dialogue: 0,0:21:00.70,0:21:03.26,Layzner,Gail,0,0,0,,你做的太漂亮了 英二
Dialogue: 0,0:21:06.24,0:21:07.95,Layzner,Eiji,0,0,0,,凯利前辈
Dialogue: 0,0:21:10.68,0:21:12.30,Layzner,,0,0,0,,怎么了
Dialogue: 0,0:21:12.30,0:21:15.54,Layzner,Rey,0,0,0,,SPT无法行动
Dialogue: 0,0:21:20.03,0:21:21.32,Layzner,Eiji,0,0,0,,凯利前辈
Dialogue: 0,0:21:28.32,0:21:32.46,Layzner,Gail,0,0,0,,这是多么美丽的光芒
Dialogue: 0,0:21:33.25,0:21:38.62,Layzner,Gail,0,0,0,,那就是你拼死也要保护的 地球吗
Dialogue: 0,0:21:39.80,0:21:42.31,Layzner,,0,0,0,,那就是 你的
Dialogue: 0,0:21:50.26,0:21:54.09,Layzner,,0,0,0,,地球吗 玖丽亚
Dialogue: 0,0:21:58.76,0:22:01.31,Layzner,Egyle,0,0,0,,尽全力去救回中尉
Dialogue: 0,0:22:04.50,0:22:06.28,Layzner,Eiji,0,0,0,,凯利前辈
Dialogue: 0,0:22:08.53,0:22:13.24,Layzner,Egyle,0,0,0,,不要管别的 派SPT去救中尉
Dialogue: 0,0:22:13.24,0:22:16.46,Layzner,Eiji,0,0,0,,凯利前辈
Dialogue: 0,0:22:20.34,0:22:25.47,Layzner,Anna,0,0,0,,在一闪一闪的星星之中 我们头一次听到那个人
Dialogue: 0,0:22:26.24,0:22:28.54,Layzner,Anna,0,0,0,,英二的哭声
Dialogue: 0,0:22:30.17,0:22:35.54,Layzner,Anna,0,0,0,,好像野兽一般 好像小孩一样
Dialogue: 0,0:22:35.77,0:22:40.48,Layzner,Anna,0,0,0,,不 那是非常温柔的人 非常纯洁的灵魂发出的悲鸣
Dialogue: 0,0:22:40.48,0:22:44.32,Layzner,,0,0,0,,也深深的震撼了我们的心
Dialogue: 0,0:23:56.95,0:23:58.09,Layzner,Eiji,0,0,0,,住手 大卫
Dialogue: 0,0:23:58.09,0:24:00.44,Layzner,Eiji,0,0,0,,那不是古拉特斯军 说不定是地球人
Dialogue: 0,0:24:01.02,0:24:01.85,Layzner,,0,0,0,,地球人
Dialogue: 0,0:24:03.87,0:24:08.36,Layzner,,0,0,0,,下一集 月球 请回答

Dialogue: 0,0:00:29.13,0:00:32.38,DefaultSingle-T,,0,0,0,,	善後得如何了
Dialogue: 0,0:00:34.22,0:00:36.89,DefaultSingle-T,,0,0,0,,	已經完成了 請放心
Dialogue: 0,0:00:38.47,0:00:40.64,DefaultSingle-T,,0,0,0,,	毫無疏漏啊
Dialogue: 0,0:00:40.89,0:00:42.77,DefaultSingle-T,,0,0,0,,	不愧是你 波本
Dialogue: 0,0:00:43.64,0:00:45.81,DefaultSingle-T,,0,0,0,,	咦 不合你胃口嗎
Dialogue: 0,0:00:46.31,0:00:48.94,DefaultSingle-T,,0,0,0,,	不是 很美味
Dialogue: 0,0:00:49.23,0:00:49.94,DefaultSingle-T,,0,0,0,,	是嗎
Dialogue: 0,0:00:50.73,0:00:54.36,DefaultSingle-T,,0,0,0,,	我看你吃得不怎麼開心
Dialogue: 0,0:00:54.86,0:00:56.28,DefaultSingle-T,,0,0,0,,	這真是不好意思
Dialogue: 0,0:00:56.70,0:01:01.41,DefaultSingle-T,,0,0,0,,	一邊談生意一邊愉快用餐並非易事
Dialogue: 0,0:01:02.12,0:01:04.41,DefaultSingle-T,,0,0,0,,	我還做不到這一點
Dialogue: 0,0:01:09.63,0:01:11.34,DefaultSingle-T,,0,0,0,,	為您送上甜點
Dialogue: 0,0:01:15.93,0:01:18.55,DefaultSingle-T,,0,0,0,,	最後用君度酒提香
Dialogue: 0,0:01:25.94,0:01:26.94,DefaultSingle-T,,0,0,0,,	酒焰
Dialogue: 0,0:01:27.69,0:01:30.23,DefaultSingle-T,,0,0,0,,	用火焰燃盡洋酒中的酒精
Dialogue: 0,0:01:30.65,0:01:33.44,DefaultSingle-T,,0,0,0,,	從而為食材提香
Dialogue: 0,0:01:33.86,0:01:35.57,DefaultSingle-T,,0,0,0,,	不留痕跡
Dialogue: 0,0:01:35.95,0:01:40.70,DefaultSingle-T,,0,0,0,,	但所有沾染過的食材全都會留下芳醇的酒香
Dialogue: 0,0:01:42.58,0:01:43.87,DefaultSingle-T,,0,0,0,,	你是在暗喻嗎
Dialogue: 0,0:01:44.87,0:01:47.67,DefaultSingle-T,,0,0,0,,	這就像我們一樣
Dialogue: 0,0:01:55.51,0:01:58.47,DefaultSingle-T,,0,0,0,,	怎麼了 表情那麼可怕
Dialogue: 0,0:02:00.05,0:02:02.35,DefaultSingle-T,,0,0,0,,	在想下一個任務嗎
Dialogue: 0,0:02:02.97,0:02:04.64,DefaultSingle-T,,0,0,0,,	我像是在想那種事嗎
Dialogue: 0,0:02:05.27,0:02:07.94,DefaultSingle-T,,0,0,0,,	我可一點都不擔心 波本
Dialogue: 0,0:02:09.02,0:02:11.27,DefaultSingle-T,,0,0,0,,	在你那無可挑剔的實力面前 那種任務…
Dialogue: 0,0:02:13.32,0:02:15.69,DefaultSingle-T,,0,0,0,,	就是小菜一碟
Dialogue: 0,0:03:49.70,0:03:50.58,DefaultSingle-T,,0,0,0,,	聽我說
Dialogue: 0,0:03:50.66,0:03:53.50,DefaultSingle-T,,0,0,0,,	妃律師的不敗記錄更新了
Dialogue: 0,0:03:54.88,0:03:56.34,DefaultSingle-T,,0,0,0,,	恭喜你們
Dialogue: 0,0:03:56.63,0:03:58.00,DefaultSingle-T,,0,0,0,,	謝謝
Dialogue: 0,0:03:58.55,0:04:04.09,DefaultSingle-T,,0,0,0,,	所以律師決定叫上她的律師朋友慶祝一下
Dialogue: 0,0:04:04.76,0:04:08.14,DefaultSingle-T,,0,0,0,,	可以預約外帶的菜品嗎
Dialogue: 0,0:04:08.97,0:04:10.27,DefaultSingle-T,,0,0,0,,	是前菜吧
Dialogue: 0,0:04:12.69,0:04:13.64,DefaultSingle-T,,0,0,0,,	我很樂意
Dialogue: 0,0:04:14.06,0:04:15.31,DefaultSingle-T,,0,0,0,,	太好了
Dialogue: 0,0:04:15.48,0:04:17.52,DefaultSingle-T,,0,0,0,,	現在法律界的人都在說
Dialogue: 0,0:04:17.52,0:04:19.73,DefaultSingle-T,,0,0,0,,	白羅的火腿三明治很吉利
Dialogue: 0,0:04:19.86,0:04:23.99,DefaultSingle-T,,0,0,0,,	強勢對抗 鋤奸扶弱
Dialogue: 0,0:04:29.33,0:04:30.29,DefaultSingle-T,,0,0,0,,	我接個電話
Dialogue: 0,0:04:31.20,0:04:34.44,DefaultSingle-T,,0,0,0,,	派對在這週六 16點開始
Dialogue: 0,0:04:34.44,0:04:35.88,DefaultSingle-T,,0,0,0,,	不好意思 梓小姐
Dialogue: 0,0:04:36.33,0:04:37.67,DefaultSingle-T,,0,0,0,,	我突然有急事
Dialogue: 0,0:04:38.50,0:04:40.42,DefaultSingle-T,,0,0,0,,	請讓我早退吧
Dialogue: 0,0:04:40.88,0:04:42.22,DefaultSingle-T,,0,0,0,,	又來啊
Dialogue: 0,0:04:42.51,0:04:45.64,DefaultSingle-T,,0,0,0,,	真是的 什麼事這麼急呢
Dialogue: 0,0:04:45.93,0:04:46.72,DefaultSingle-T,,0,0,0,,	開玩笑
Dialogue: 0,0:04:47.55,0:04:50.14,DefaultSingle-T,,0,0,0,,	反正今天很閒 沒關係的
Dialogue: 0,0:04:51.10,0:04:52.02,DefaultSingle-T,,0,0,0,,	咦
Dialogue: 0,0:04:52.02,0:04:54.60,DefaultSingle-T,,0,0,0,,	安室先生已經走掉了
Dialogue: 0,0:05:00.44,0:05:02.69,DefaultSingle-T,,0,0,0,,	站住 你逃不掉的
Dialogue: 0,0:05:09.66,0:05:12.70,DefaultSingle-T,,0,0,0,,	你給我…站住
Dialogue: 0,0:05:21.67,0:05:23.51,DefaultSingle-T,,0,0,0,,	甩掉風見了嗎
Dialogue: 0,0:05:24.17,0:05:24.84,DefaultSingle-T,,0,0,0,,	真是的
Dialogue: 0,0:05:25.76,0:05:27.34,DefaultSingle-T,,0,0,0,,	等會得說說他了
Dialogue: 0,0:05:37.10,0:05:39.98,DefaultSingle-T,,0,0,0,,	怎麼可能徒手往頭盔上打
Dialogue: 0,0:05:41.94,0:05:43.23,DefaultSingle-T,,0,0,0,,	是假動作
Dialogue: 0,0:05:47.03,0:05:47.91,DefaultSingle-T,,0,0,0,,	降谷先生
Dialogue: 0,0:05:51.87,0:05:55.25,DefaultSingle-T,,0,0,0,,	你最近表現不佳啊 風見
Dialogue: 0,0:05:55.41,0:05:56.33,DefaultSingle-T,,0,0,0,,	對不起
Dialogue: 0,0:05:56.79,0:05:59.92,DefaultSingle-T,,0,0,0,,	原因就是你那和赤井一樣的黑眼圈
Dialogue: 0,0:06:01.17,0:06:03.21,DefaultSingle-T,,0,0,0,,	你沒睡覺吧
Dialogue: 0,0:06:04.26,0:06:04.84,DefaultSingle-T,,0,0,0,,	不是
Dialogue: 0,0:06:04.84,0:06:05.97,DefaultSingle-T,,0,0,0,,	別撒謊
Dialogue: 0,0:06:06.01,0:06:06.67,DefaultSingle-T,,0,0,0,,	是
Dialogue: 0,0:06:06.84,0:06:09.43,DefaultSingle-T,,0,0,0,,	因為…有很多報告書要寫
Dialogue: 0,0:06:12.47,0:06:14.68,DefaultSingle-T,,0,0,0,,	我說過吧 要好好吃飯
Dialogue: 0,0:06:15.35,0:06:16.85,DefaultSingle-T,,0,0,0,,	你又沒吃飯嗎
Dialogue: 0,0:06:17.60,0:06:20.31,DefaultSingle-T,,0,0,0,,	今 今早吃了一點巧克力
Dialogue: 0,0:06:20.40,0:06:22.19,DefaultSingle-T,,0,0,0,,	那不叫吃飯
Dialogue: 0,0:06:22.65,0:06:25.28,DefaultSingle-T,,0,0,0,,	犯罪者可不會專挑你狀態好的時候作案
Dialogue: 0,0:06:25.69,0:06:26.90,DefaultSingle-T,,0,0,0,,	調整好自己的身體
Dialogue: 0,0:06:26.99,0:06:29.41,DefaultSingle-T,,0,0,0,,	時刻做好最壞的準備
Dialogue: 0,0:06:29.57,0:06:31.74,DefaultSingle-T,,0,0,0,,	這不就是我們最基本的工作嗎
Dialogue: 0,0:06:33.62,0:06:34.62,DefaultSingle-T,,0,0,0,,	對不起
Dialogue: 0,0:06:37.08,0:06:40.37,DefaultSingle-T,,0,0,0,,	沒辦法 回去的時候繞個路吧
Dialogue: 0,0:06:41.42,0:06:42.17,DefaultSingle-T,,0,0,0,,	要去哪裡
Dialogue: 0,0:06:42.54,0:06:44.13,DefaultSingle-T,,0,0,0,,	我知道一家不錯的店
Dialogue: 0,0:06:44.34,0:06:46.21,DefaultSingle-T,,0,0,0,,	那 那我來開車
Dialogue: 0,0:06:48.42,0:06:49.84,DefaultSingle-T,,0,0,0,,	知道地址嗎
Dialogue: 0,0:06:50.09,0:06:51.39,DefaultSingle-T,,0,0,0,,	不知道
Dialogue: 0,0:06:51.64,0:06:53.43,DefaultSingle-T,,0,0,0,,	離這裡有點遠
Dialogue: 0,0:06:53.64,0:06:56.60,DefaultSingle-T,,0,0,0,,	那就請在旁邊指路
Dialogue: 0,0:06:56.68,0:06:58.10,DefaultSingle-T,,0,0,0,,	好麻煩啊
Dialogue: 0,0:06:58.23,0:06:59.64,DefaultSingle-T,,0,0,0,,	別這麼說嘛
Dialogue: 0,0:07:00.06,0:07:01.27,DefaultSingle-T,,0,0,0,,	你讓開吧
Dialogue: 0,0:07:01.56,0:07:05.15,DefaultSingle-T,,0,0,0,,	你現在迷迷糊糊的 別傷了我的車
Dialogue: 0,0:07:05.15,0:07:07.65,DefaultSingle-T,,0,0,0,,	怎麼能讓你親自開車呢
Dialogue: 0,0:07:07.82,0:07:08.61,DefaultSingle-T,,0,0,0,,	我來開
Dialogue: 0,0:07:09.24,0:07:10.61,DefaultSingle-T,,0,0,0,,	降谷先生…
Dialogue: 0,0:07:10.61,0:07:12.62,DefaultSingle-T,,0,0,0,,	你別開車 一邊坐著去
Dialogue: 0,0:07:12.91,0:07:15.08,DefaultSingle-T,,0,0,0,,	趁我還有耐心勸你
Dialogue: 0,0:07:22.50,0:07:23.83,DefaultSingle-T,,0,0,0,,	我不困
Dialogue: 0,0:07:24.71,0:07:26.13,DefaultSingle-T,,0,0,0,,	我不困
Dialogue: 0,0:07:26.50,0:07:28.46,DefaultSingle-T,,0,0,0,,	我不困 我不困
Dialogue: 0,0:07:28.71,0:07:30.80,DefaultSingle-T,,0,0,0,,	我不困 我不困
Dialogue: 0,0:07:38.77,0:07:42.14,DefaultSingle-T,,0,0,0,,	上司開車 部下竟在一旁睡著了
Dialogue: 0,0:07:42.77,0:07:44.27,DefaultSingle-T,,0,0,0,,	膽子真不小
Dialogue: 0,0:07:44.90,0:07:48.03,DefaultSingle-T,,0,0,0,,	睡覺也是警察的工作嗎
Dialogue: 0,0:07:54.32,0:07:56.03,DefaultSingle-T,,0,0,0,,	人人都會失敗
Dialogue: 0,0:07:56.58,0:07:59.87,DefaultSingle-T,,0,0,0,,	重要的是吃一塹長一智
Dialogue: 0,0:08:00.33,0:08:03.25,DefaultSingle-T,,0,0,0,,	降谷先生 你也失敗過嗎
Dialogue: 0,0:08:03.58,0:08:05.67,DefaultSingle-T,,0,0,0,,	是啊 比如說…
Dialogue: 0,0:08:06.71,0:08:08.00,DefaultSingle-T,,0,0,0,,	比如說…
Dialogue: 0,0:08:08.84,0:08:10.59,DefaultSingle-T,,0,0,0,,	不用了
Dialogue: 0,0:08:39.74,0:08:41.95,DefaultSingle-T,,0,0,0,,	好 試試看吧
Dialogue: 0,0:08:42.71,0:08:45.67,DefaultSingle-T,,0,0,0,,	用日本的食材和日本的酒
Dialogue: 0,0:08:48.46,0:08:49.30,DefaultSingle-T,,0,0,0,,	做酒焰菜
Dialogue: 0,0:09:11.28,0:09:12.44,DefaultSingle-T,,0,0,0,,	我開動了
Dialogue: 0,0:09:42.64,0:09:44.14,DefaultSingle-T,,0,0,0,,	用日本酒做酒焰菜
Dialogue: 0,0:09:44.60,0:09:46.14,DefaultSingle-T,,0,0,0,,	是個很棒的組合
Dialogue: 0,0:09:46.81,0:09:47.90,DefaultSingle-T,,0,0,0,,	不過…
Dialogue: 0,0:09:50.19,0:09:51.61,DefaultSingle-T,,0,0,0,,	做多了
Dialogue: 0,0:09:56.28,0:09:57.66,DefaultSingle-T,,0,0,0,,	給風見吧
Dialogue: 0,0:10:03.58,0:10:05.00,DefaultSingle-T,,0,0,0,,	這就是早飯嗎
Dialogue: 0,0:10:07.00,0:10:07.87,DefaultSingle-T,,0,0,0,,	降谷先生
Dialogue: 0,0:10:08.46,0:10:10.50,DefaultSingle-T,,0,0,0,,	要好好吃飯
Dialogue: 0,0:10:13.09,0:10:14.51,DefaultSingle-T,,0,0,0,,	非常感謝
Dialogue: 0,0:10:16.63,0:10:17.47,DefaultSingle-T,,0,0,0,,	又不見了
Dialogue: 0,0:10:48.04,0:10:49.50,DefaultSingle-T,,0,0,0,,	496
Dialogue: 0,0:10:49.92,0:10:51.25,DefaultSingle-T,,0,0,0,,	497
Dialogue: 0,0:10:51.92,0:10:53.50,DefaultSingle-T,,0,0,0,,	498
Dialogue: 0,0:10:54.00,0:10:55.67,DefaultSingle-T,,0,0,0,,	499
Dialogue: 0,0:10:56.38,0:10:59.09,DefaultSingle-T,,0,0,0,,	500
Dialogue: 0,0:11:16.03,0:11:17.69,DefaultSingle-T,,0,0,0,,	為什麼對他見死不救
Dialogue: 0,0:11:19.65,0:11:21.28,DefaultSingle-T,,0,0,0,,	你明明有那般實力
Dialogue: 0,0:11:28.37,0:11:29.41,DefaultSingle-T,,0,0,0,,	為什麼
Dialogue: 0,0:11:47.89,0:11:49.52,DefaultSingle-T,,0,0,0,,	你也是孤零零的嗎
Dialogue: 0,0:11:59.49,0:12:01.95,DefaultSingle-T,,0,0,0,,	別跟過來哦 會淋溼的
Dialogue: 0,0:12:05.91,0:12:06.66,DefaultSingle-T,,0,0,0,,	風見
Dialogue: 0,0:12:06.99,0:12:09.91,DefaultSingle-T,,0,0,0,,	堤無津河周邊有沒有走失犬隻的報案
Dialogue: 0,0:12:10.54,0:12:12.21,DefaultSingle-T,,0,0,0,,	嗯 白色的小型犬
Dialogue: 0,0:12:12.37,0:12:14.67,DefaultSingle-T,,0,0,0,,	對 派人帶走照顧一下
Dialogue: 0,0:12:15.46,0:12:15.88,DefaultSingle-T,,0,0,0,,	對
Dialogue: 0,0:13:29.37,0:13:30.58,DefaultSingle-T,,0,0,0,,	TIME.3

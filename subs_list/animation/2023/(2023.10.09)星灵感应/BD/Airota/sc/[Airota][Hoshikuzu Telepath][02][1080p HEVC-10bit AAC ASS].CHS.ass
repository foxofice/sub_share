Dialogue: 0,0:23:31.80,0:23:35.98,Title,,0,0,0,,{\fsp10\pos(965,655)\fad(1145,0)\3c&HFCFDFE&}炸药专家
Comment: 0,0:24:16.71,0:24:18.47,Default,,0,0,0,,MAIN
Dialogue: 0,0:00:05.28,0:00:07.06,Default,,0,0,0,,我叫小之星海果
Dialogue: 0,0:00:07.38,0:00:09.39,Default,,0,0,0,,现在读高一 15岁
Dialogue: 0,0:00:11.56,0:00:12.64,Default,,0,0,0,,我不擅长…
Dialogue: 0,0:00:13.26,0:00:15.63,Default,,0,0,0,,我不擅长和别人交流
Dialogue: 0,0:00:16.45,0:00:19.13,Default,,0,0,0,,不过 外星人明内同学
Dialogue: 0,0:00:19.22,0:00:21.58,Default,,0,0,0,,用她的特殊能力「额头感应」
Dialogue: 0,0:00:21.62,0:00:24.01,Default,,0,0,0,,读出了我的感受
Dialogue: 0,0:00:24.60,0:00:29.80,Default,,0,0,0,,并且 我和她居然都是以宇宙为目标
Dialogue: 0,0:00:30.58,0:00:32.94,Default,,0,0,0,,我们的相遇实在是太震撼了
Dialogue: 0,0:00:33.49,0:00:37.01,Default,,0,0,0,,让我的心都飞向了宇宙
Dialogue: 0,0:00:42.90,0:00:45.01,Default,,0,0,0,,要和明内同学一起去宇宙的话
Dialogue: 0,0:00:45.01,0:00:47.42,Default,,0,0,0,,现在就要开始着手制作火箭
Dialogue: 0,0:00:48.37,0:00:50.12,Default,,0,0,0,,搜索
Dialogue: 0,0:00:53.05,0:00:55.03,Default,,0,0,0,,只能查到面向小朋友的
Dialogue: 0,0:00:55.30,0:00:56.62,Default,,0,0,0,,但我想要的不是这种
Dialogue: 0,0:00:58.63,0:00:59.76,Default,,0,0,0,,搜索
Dialogue: 0,0:01:00.49,0:01:02.00,Default,,0,0,0,,这也太成人了吧
Dialogue: 0,0:01:02.00,0:01:03.85,Default,,0,0,0,,要的不是这种
Dialogue: 0,0:01:03.90,0:01:06.10,Default,,0,0,0,,换个词 换个词
Dialogue: 0,0:01:10.54,0:01:15.51,Default,,0,0,0,,火箭一般高40-70米
Dialogue: 0,0:01:15.69,0:01:18.21,Default,,0,0,0,,重200-700吨
Dialogue: 0,0:01:18.64,0:01:21.24,Default,,0,0,0,,并且要造火箭的话
Dialogue: 0,0:01:21.32,0:01:25.22,Default,,0,0,0,,需要又深又广的知识和技术
Dialogue: 0,0:01:21.48,0:01:24.98,Tips,,0,0,0,,注：背景是密歇尔斯基方程 (Meshchersky Equation)
Dialogue: 0,0:01:29.78,0:01:34.62,Default,,0,0,0,,在高一的春天 我稍微成熟了一点
Dialogue: 0,0:03:09.76,0:03:11.38,Default,,0,0,0,,我还以为火箭
Dialogue: 0,0:03:11.98,0:03:17.35,Default,,0,0,0,,是用某种神奇的力量咻的一下就飞起来了呢
Dialogue: 0,0:03:17.74,0:03:18.70,Default,,0,0,0,,总之
Dialogue: 0,0:03:18.70,0:03:20.98,Default,,0,0,0,,既然和明内同学约定好了
Dialogue: 0,0:03:21.00,0:03:23.10,Default,,0,0,0,,就要拼尽全力去做
Dialogue: 0,0:03:23.13,0:03:23.95,Default,,0,0,0,,好
Dialogue: 0,0:03:24.00,0:03:25.05,Default,,0,0,0,,海果
Dialogue: 0,0:03:26.22,0:03:27.66,Default,,0,0,0,,Bonavuu
Dialogue: 0,0:03:33.95,0:03:35.94,Default,,0,0,0,,今天也很有精神
Dialogue: 0,0:03:37.94,0:03:39.47,Default,,0,0,0,,我说Bonavuu的时候
Dialogue: 0,0:03:40.12,0:03:41.66,Default,,0,0,0,,要回答Mativuu才对吧
Dialogue: 0,0:03:41.65,0:03:42.62,Default,,0,0,0,,对 对不起
Dialogue: 0,0:03:42.95,0:03:44.22,Default,,0,0,0,,对了
Dialogue: 0,0:03:44.40,0:03:46.69,Default,,0,0,0,,下次我们再练习一下发音吧
Dialogue: 0,0:03:46.89,0:03:48.99,Default,,0,0,0,,让我们的宇宙语达到母语水平
Dialogue: 0,0:03:50.16,0:03:51.16,Default,,0,0,0,,真神奇
Dialogue: 0,0:03:51.41,0:03:53.39,Default,,0,0,0,,和明内同学在一起的时候
Dialogue: 0,0:03:53.43,0:03:55.83,Default,,0,0,0,,就没有那么不安了
Dialogue: 0,0:03:56.16,0:03:57.38,Default,,0,0,0,,啊 幽
Dialogue: 0,0:03:57.50,0:03:58.65,Default,,0,0,0,,Bonavuu
Dialogue: 0,0:03:58.65,0:04:00.35,Default,,0,0,0,,啊 Mativuu
Dialogue: 0,0:04:02.05,0:04:04.09,Default,,0,0,0,,这句话真的好怪哦
Dialogue: 0,0:04:04.09,0:04:05.22,Default,,0,0,0,,有吗
Dialogue: 0,0:04:05.22,0:04:06.90,Default,,0,0,0,,这在宇宙里可是很平常的哦
Dialogue: 0,0:04:07.06,0:04:09.50,Default,,0,0,0,,你说的都对 外星人小幽
Dialogue: 0,0:04:10.28,0:04:11.88,Default,,0,0,0,,你不相信我吗
Dialogue: 0,0:04:11.88,0:04:12.86,Default,,0,0,0,,幽
Dialogue: 0,0:04:12.86,0:04:14.20,Default,,0,0,0,,Bonavuu
Dialogue: 0,0:04:14.20,0:04:15.65,Default,,0,0,0,,Mativuu
Dialogue: 0,0:04:16.12,0:04:18.19,Default,,0,0,0,,什么时候传开的
Dialogue: 0,0:04:18.74,0:04:20.48,Default,,0,0,0,,真的好神奇
Dialogue: 0,0:04:20.87,0:04:22.84,Default,,0,0,0,,明内同学好厉害啊
Dialogue: 0,0:04:23.48,0:04:26.95,Default,,0,0,0,,虽然是外星人 却能和大家打成一片
Dialogue: 0,0:04:27.68,0:04:29.13,Default,,0,0,0,,幽 海果
Dialogue: 0,0:04:31.37,0:04:32.68,Default,,0,0,0,,遥乃
Dialogue: 0,0:04:33.28,0:04:34.54,Default,,0,0,0,,早上好
Dialogue: 0,0:04:34.78,0:04:36.03,Default,,0,0,0,,Bonavuu
Dialogue: 0,0:04:36.06,0:04:37.30,Default,,0,0,0,,Mativuu
Dialogue: 0,0:04:37.95,0:04:40.64,Default,,0,0,0,,她是我同班同学宝木遥乃
Dialogue: 0,0:04:40.95,0:04:44.05,Default,,0,0,0,,是一位开朗外向的副班长
Dialogue: 0,0:04:45.32,0:04:47.25,Default,,0,0,0,,海果 Bonavuu
Dialogue: 0,0:04:50.47,0:04:52.96,Default,,0,0,0,,愿意主动向我这种人搭话
Dialogue: 0,0:04:52.96,0:04:55.47,Default,,0,0,0,,是一位非常温柔的地球人
Dialogue: 0,0:04:56.42,0:04:58.07,Default,,0,0,0,,但我却…
Dialogue: 0,0:04:58.89,0:05:01.59,Default,,0,0,0,,从她向我搭话以来
Dialogue: 0,0:05:01.89,0:05:04.56,Default,,0,0,0,,我都从来没有回应过她
Dialogue: 0,0:05:05.12,0:05:06.48,Default,,0,0,0,,啊 幽
Dialogue: 0,0:05:06.48,0:05:08.66,Default,,0,0,0,,昨天的现代文作业 你交了吗
Dialogue: 0,0:05:08.66,0:05:09.82,Default,,0,0,0,,我忘了
Dialogue: 0,0:05:09.85,0:05:12.28,Default,,0,0,0,,笑原老师可操心你了
Dialogue: 0,0:05:12.73,0:05:14.52,Default,,0,0,0,,我在做什么呢
Dialogue: 0,0:05:12.73,0:05:14.52,Upper,,0,0,0,,是不是这张
Dialogue: 0,0:05:14.52,0:05:17.50,Upper,,0,0,0,,这张是上周的数学作业
Dialogue: 0,0:05:14.72,0:05:16.27,Default,,0,0,0,,不能就这样下去
Dialogue: 0,0:05:16.56,0:05:18.53,Default,,0,0,0,,以我目前的能力
Dialogue: 0,0:05:19.24,0:05:24.16,Default,,0,0,0,,别说我了 想把明内同学带上宇宙都做不到
Dialogue: 0,0:05:25.21,0:05:26.31,Default,,0,0,0,,对了
Dialogue: 0,0:05:26.31,0:05:28.69,Default,,0,0,0,,我有件事想问问你们两位
Dialogue: 0,0:05:28.76,0:05:29.84,Default,,0,0,0,,什么事 什么事
Dialogue: 0,0:05:29.86,0:05:31.92,Default,,0,0,0,,昨天放学的时候
Dialogue: 0,0:05:32.04,0:05:35.23,Default,,0,0,0,,你们两位是不是进了海角上的灯塔？
Dialogue: 0,0:05:39.64,0:05:41.61,Default,,0,0,0,,要上课了
Dialogue: 0,0:05:41.85,0:05:44.37,Default,,0,0,0,,这事之后再聊吧
Dialogue: 0,0:05:44.43,0:05:45.32,Default,,0,0,0,,好
Dialogue: 0,0:05:48.38,0:05:52.40,Default,,0,0,0,,翌年 陈郡里一位叫袁傪的监察御史
Dialogue: 0,0:05:48.38,0:05:52.40,Tips,,0,0,0,,注︰出自《山月记》-中岛敦
Dialogue: 0,0:05:52.55,0:05:54.02,Default,,0,0,0,,怎 怎么办啊
Dialogue: 0,0:05:55.20,0:05:58.34,Default,,0,0,0,,明内同学把灯塔当作她的秘密基地
Dialogue: 0,0:05:58.99,0:06:00.51,Default,,0,0,0,,要是被人知道之后
Dialogue: 0,0:06:00.51,0:06:05.64,Tips,,0,0,0,,注：NETA自电影黑衣人(Men In Black)
Dialogue: 0,0:06:00.92,0:06:02.93,Default,,0,0,0,,就会有可怕的人去调查
Dialogue: 0,0:06:03.00,0:06:05.64,Default,,0,0,0,,明内同学是外星人的事实就会暴露
Dialogue: 0,0:06:05.87,0:06:09.14,Default,,0,0,0,,然后就会被逮捕关起来
Dialogue: 0,0:06:09.76,0:06:12.10,Default,,0,0,0,,救救我 海果
Dialogue: 0,0:06:12.20,0:06:15.40,Default,,0,0,0,,明内同学会被解剖的！
Dialogue: 0,0:06:15.71,0:06:19.61,Default,,0,0,0,,明内同学的秘密 绝对不能让任何人知道
Dialogue: 0,0:06:19.61,0:06:20.72,Default,,0,0,0,,下一位 小之星
Dialogue: 0,0:06:22.16,0:06:23.04,Default,,0,0,0,,小之星？
Dialogue: 0,0:06:23.63,0:06:25.58,Default,,0,0,0,,海果 老师在叫你
Dialogue: 0,0:06:26.92,0:06:30.15,Default,,0,0,0,,难道说没在听老师讲课吗
Dialogue: 0,0:06:30.30,0:06:32.24,Default,,0,0,0,,胆子不小嘛
Dialogue: 0,0:06:33.28,0:06:35.34,Default,,0,0,0,,从第十三行开始读
Dialogue: 0,0:06:39.80,0:06:40.80,Default,,0,0,0,,某个夜晚
Dialogue: 0,0:06:43.45,0:06:46.53,Default,,0,0,0,,小之星 朗读得很仔细 非常好
Dialogue: 0,0:06:47.10,0:06:48.59,Default,,0,0,0,,下次可以更自信点
Dialogue: 0,0:06:50.71,0:06:51.52,Default,,0,0,0,,下一位 志木
Dialogue: 0,0:06:51.86,0:06:52.36,Default,,0,0,0,,是的
Dialogue: 0,0:06:52.85,0:06:56.55,Upper,,0,0,0,,老虎在将要扑到袁惨之时
Dialogue: 0,0:06:56.55,0:07:00.65,Upper,,0,0,0,,却突然回身一转 隐没在原来的草丛中
Dialogue: 0,0:07:00.65,0:07:07.45,Upper,,0,0,0,,草丛中传来反复说着「刚才好险啊」的人声
Dialogue: 0,0:06:54.69,0:06:57.27,Default,,0,0,0,,海果 做得漂亮
Dialogue: 0,0:07:02.26,0:07:06.76,Default,,0,0,0,,我又…没能和宝木同学道谢
Dialogue: 0,0:07:08.88,0:07:09.59,Default,,0,0,0,,敬礼
Dialogue: 0,0:07:17.68,0:07:18.48,Default,,0,0,0,,对了
Dialogue: 0,0:07:18.73,0:07:22.13,Default,,0,0,0,,要跟明内同学讲不能把灯塔的事说出来
Dialogue: 0,0:07:22.94,0:07:24.36,Default,,0,0,0,,怎么了 海果
Dialogue: 0,0:07:26.35,0:07:28.39,Default,,0,0,0,,那个…那个
Dialogue: 0,0:07:30.65,0:07:32.89,Default,,0,0,0,,什么什么 新的游戏
Dialogue: 0,0:07:32.89,0:07:34.52,Default,,0,0,0,,我不会输的
Dialogue: 0,0:07:34.52,0:07:36.27,Default,,0,0,0,,不是那样的
Dialogue: 0,0:07:37.38,0:07:39.91,Default,,0,0,0,,你们两个关系真好啊
Dialogue: 0,0:07:39.96,0:07:42.14,Default,,0,0,0,,是的 昨天还在我的基地
Dialogue: 0,0:07:43.07,0:07:43.84,Default,,0,0,0,,基地？
Dialogue: 0,0:07:45.02,0:07:46.46,Default,,0,0,0,,什么什么
Dialogue: 0,0:07:54.30,0:07:55.73,Default,,0,0,2,,OK OK
Dialogue: 0,0:07:56.37,0:07:58.93,Default,,0,0,0,,我现在住在灯塔里
Dialogue: 0,0:07:58.92,0:08:01.25,Default,,0,0,0,,明内同学
Dialogue: 0,0:08:01.35,0:08:02.06,Default,,0,0,0,,住…
Dialogue: 0,0:08:02.70,0:08:03.87,Default,,0,0,0,,住在？
Dialogue: 0,0:08:04.17,0:08:07.14,Default,,0,0,0,,就是偶尔会亮起来比较麻烦
Dialogue: 0,0:08:07.60,0:08:08.72,Default,,0,0,0,,亮起来？
Dialogue: 0,0:08:09.54,0:08:11.60,Default,,0,0,0,,明内同学要被抓起来了
Dialogue: 0,0:08:11.60,0:08:13.25,Default,,0,0,0,,我必须要帮她
Dialogue: 0,0:08:13.75,0:08:16.22,Default,,0,0,0,,不 不 不是的
Dialogue: 0,0:08:17.48,0:08:20.16,Default,,0,0,0,,不是这样的
Dialogue: 0,0:08:20.31,0:08:26.44,Default,,0,0,0,,我 我们在回家路上正好发现了灯塔
Dialogue: 0,0:08:26.65,0:08:30.26,Default,,0,0,0,,我 我说要进去看看
Dialogue: 0,0:08:30.26,0:08:32.58,Default,,0,0,0,,硬 硬拉着明内同学…
Dialogue: 0,0:08:32.58,0:08:36.30,Default,,0,0,0,,所 所以不是明内同学的错
Dialogue: 0,0:08:36.39,0:08:37.85,Default,,0,0,0,,所以 所以…
Dialogue: 0,0:08:38.05,0:08:38.96,Default,,0,0,0,,海果？
Dialogue: 0,0:08:39.29,0:08:41.20,Default,,0,0,0,,明 明内同学
Dialogue: 0,0:08:41.20,0:08:43.76,Default,,0,0,0,,没事的 所以…
Dialogue: 0,0:08:44.17,0:08:46.70,Default,,0,0,0,,抱歉 问了个奇怪的问题
Dialogue: 0,0:08:46.84,0:08:48.97,Default,,0,0,0,,吓到你们了吧
Dialogue: 0,0:08:49.23,0:08:53.44,Default,,0,0,0,,我还以为二位一定是灯塔的狂热粉丝呢
Dialogue: 0,0:08:54.50,0:08:57.84,Default,,0,0,0,,那个灯塔已经废弃了很长时间
Dialogue: 0,0:08:57.94,0:09:00.32,Default,,0,0,0,,完全没有人会去看
Dialogue: 0,0:09:00.92,0:09:03.82,Default,,0,0,0,,不过 是我从以前就很喜欢的地方
Dialogue: 0,0:09:04.14,0:09:06.71,Default,,0,0,0,,要是二位也是的话 我会很高兴的
Dialogue: 0,0:09:07.16,0:09:08.38,Default,,0,0,0,,这样啊
Dialogue: 0,0:09:08.39,0:09:09.61,Default,,0,0,0,,喜欢的地方
Dialogue: 0,0:09:09.92,0:09:13.10,Default,,0,0,0,,既然这样 下次我会向宇宙的大家宣传的
Dialogue: 0,0:09:09.61,0:09:13.62,Tips,,0,0,0,,{\an9\fad(0,500)}注：制作组把plej的l（{\fnUF Steleto}L{\r}）中的点漏了\Nbona（{\fnUF Steleto}BONA{\r}）写成了boda（{\fnUF Steleto}BODA{\r}）
Dialogue: 0,0:09:13.16,0:09:15.89,Default,,0,0,0,,目标 地球第一的观光点
Dialogue: 0,0:09:16.08,0:09:17.35,Default,,0,0,0,,明明是自己家？
Dialogue: 0,0:09:18.61,0:09:19.81,Default,,0,0,0,,谢谢
Dialogue: 0,0:09:20.22,0:09:22.11,Default,,0,0,0,,毕竟幽是外星人嘛
Dialogue: 0,0:09:23.32,0:09:26.10,Default,,0,0,0,,你相信我是外星人吗
Dialogue: 0,0:09:26.18,0:09:27.38,Default,,0,0,0,,当然
Dialogue: 0,0:09:27.66,0:09:31.46,Default,,0,0,0,,我一直想和外星人说说话
Dialogue: 0,0:09:31.46,0:09:34.73,Default,,0,0,0,,因为和外星人交流是人类的浪漫啊
Dialogue: 0,0:09:35.76,0:09:38.99,Default,,0,0,0,,地球人和外星人大家手拉着手
Dialogue: 0,0:09:38.99,0:09:41.27,Default,,0,0,0,,一起共建和平的宇宙
Dialogue: 0,0:09:41.70,0:09:45.27,Default,,0,0,0,,啊 这才是所有生物梦想的终点
Dialogue: 0,0:09:45.57,0:09:47.55,Default,,0,0,0,,永恒闪耀的希望之光
Dialogue: 0,0:09:47.99,0:09:49.79,Default,,0,0,0,,二位不这么认为吗
Dialogue: 0,0:09:50.96,0:09:52.34,Default,,0,0,0,,我懂我懂
Dialogue: 0,0:09:53.52,0:09:55.01,Default,,0,0,0,,遥乃
Dialogue: 0,0:09:55.01,0:09:57.16,Default,,0,0,0,,幽 海果
Dialogue: 0,0:09:59.79,0:10:02.66,Default,,0,0,0,,宝 宝木同学 我
Dialogue: 0,0:10:02.99,0:10:05.43,Default,,0,0,0,,刚才误会了
Dialogue: 0,0:10:05.58,0:10:06.71,Default,,0,0,0,,没事的
Dialogue: 0,0:10:06.92,0:10:10.80,Default,,0,0,0,,能和海果说上话 我很高兴
Dialogue: 0,0:10:11.12,0:10:12.88,Default,,0,0,0,,谢…谢谢
Dialogue: 0,0:10:13.00,0:10:15.59,Default,,0,0,0,,那 那个 还有…
Dialogue: 0,0:10:15.99,0:10:25.21,Default,,0,0,0,,谢谢你一直找我搭话 还帮助我
Dialogue: 0,0:10:25.40,0:10:28.57,Default,,0,0,0,,没有没有 以后也请多多指教
Dialogue: 0,0:10:31.16,0:10:33.86,Default,,0,0,0,,上课的时候我就这么想了…
Dialogue: 0,0:10:34.86,0:10:37.84,Default,,0,0,0,,海果的声音 真的很动听
Dialogue: 0,0:10:38.35,0:10:45.57,Default,,0,0,0,,就像是被静静地关在小贝壳里的白浪的告白一样
Dialogue: 0,0:10:48.36,0:10:50.30,Default,,0,0,0,,神啊
Dialogue: 0,0:10:50.33,0:10:54.38,Default,,0,0,0,,感谢您让我在今天能有如此美妙幸福的相遇
Dialogue: 0,0:10:54.67,0:10:59.79,Default,,0,0,0,,愿我们的将来有着像银河一般绚烂的光芒
Dialogue: 0,0:11:00.73,0:11:02.88,Default,,0,0,0,,遥乃你很懂嘛
Dialogue: 0,0:11:04.65,0:11:07.06,Default,,0,0,0,,遥乃的话也没关系吧
Dialogue: 0,0:11:07.11,0:11:09.37,Default,,0,0,0,,把我们的约定告诉她
Dialogue: 0,0:11:09.37,0:11:10.54,Default,,0,0,0,,那 那个
Dialogue: 0,0:11:11.12,0:11:12.16,Default,,0,0,0,,约定？
Dialogue: 0,0:11:12.41,0:11:14.82,Default,,0,0,0,,我们其实啊
Dialogue: 0,0:11:15.02,0:11:18.48,Default,,0,0,0,,正以前往宇宙为目标 准备制造火箭呢
Dialogue: 0,0:11:20.00,0:11:22.17,Default,,0,0,0,,说出来了
Dialogue: 0,0:11:22.17,0:11:23.30,Default,,0,0,0,,哎呀呀
Dialogue: 0,0:11:24.60,0:11:28.89,Default,,0,0,0,,怎么办怎么办怎么办怎么办怎么办
Dialogue: 0,0:11:29.08,0:11:30.58,Default,,0,0,0,,没事的
Dialogue: 0,0:11:31.83,0:11:34.08,Default,,0,0,0,,同伴肯定是越多越好
Dialogue: 0,0:11:34.48,0:11:36.67,Default,,0,0,0,,所以遥乃也一起来吧
Dialogue: 0,0:11:38.85,0:11:40.00,Default,,0,0,0,,听起来很有趣
Dialogue: 0,0:11:40.20,0:11:41.86,Default,,0,0,0,,如果可以的话 请务必带上我
Dialogue: 0,0:11:45.55,0:11:47.81,Default,,0,0,0,,以后遥乃也是同伴了
Dialogue: 0,0:11:48.18,0:11:52.43,Default,,0,0,0,,海果也请多指教 以后我们要多多聊天
Dialogue: 0,0:11:52.94,0:11:54.82,Default,,0,0,0,,这样又向梦想更进一步了
Dialogue: 0,0:11:55.00,0:11:57.29,Default,,0,0,0,,大家一起做出最棒的火箭吧
Dialogue: 0,0:11:59.48,0:12:00.11,Default,,0,0,0,,嗯
Dialogue: 0,0:12:00.67,0:12:02.83,Default,,0,0,0,,明内同学真厉害
Dialogue: 0,0:12:03.20,0:12:04.78,Default,,0,0,0,,只要跟明内同学在一起
Dialogue: 0,0:12:04.88,0:12:08.63,Default,,0,0,0,,我感觉自己能克服一切困难
Dialogue: 0,0:12:09.20,0:12:10.59,Default,,0,0,0,,果然 不可思议
Dialogue: 0,0:12:11.83,0:12:15.18,Default,,0,0,0,,机会难得 我有一个请求
Dialogue: 0,0:12:16.38,0:12:19.32,Default,,0,0,0,,你们经常做的额头感应
Dialogue: 0,0:12:19.32,0:12:20.86,Default,,0,0,0,,我也想做做看
Dialogue: 0,0:12:21.13,0:12:21.89,Default,,0,0,0,,经常做！？
Dialogue: 0,0:12:22.04,0:12:23.19,Default,,0,0,0,,交给我吧
Dialogue: 0,0:12:23.22,0:12:26.57,Default,,0,0,0,,被 被看到了…
Dialogue: 0,0:12:37.32,0:12:40.94,Default,,0,0,0,,一开始就造大火箭太难了
Dialogue: 0,0:12:41.11,0:12:44.19,Default,,0,0,0,,我是想先从不太复杂的开始着手
Dialogue: 0,0:12:44.96,0:12:46.37,Default,,0,0,0,,这个绝对不行
Dialogue: 0,0:12:46.90,0:12:47.93,Default,,0,0,0,,这个也不行
Dialogue: 0,0:12:48.48,0:12:49.84,Default,,0,0,0,,这个似乎能做出来
Dialogue: 0,0:12:50.19,0:12:51.85,Default,,0,0,0,,面向孩童的
Dialogue: 0,0:12:51.86,0:12:53.06,Default,,0,0,0,,还有什么
Dialogue: 0,0:12:54.01,0:12:55.86,Default,,0,0,0,,找到了 就是这个
Dialogue: 0,0:12:55.97,0:12:58.47,Default,,0,0,0,,我看看 材料需要…
Dialogue: 0,0:13:02.34,0:13:03.42,Default,,0,0,0,,原来如此
Dialogue: 0,0:13:03.42,0:13:04.51,Default,,0,0,0,,那真方便呢
Dialogue: 0,0:13:04.53,0:13:05.59,Default,,0,0,0,,就是的
Dialogue: 0,0:13:04.75,0:13:06.50,Upper,,0,0,0,,…能去就一起去
Dialogue: 0,0:13:06.55,0:13:07.65,Upper,,0,0,0,,是的呢
Dialogue: 0,0:13:13.43,0:13:13.80,Default,,0,0,0,,明…
Dialogue: 0,0:13:13.80,0:13:16.64,Default,,0,0,0,,明内同学 你在做什么？
Dialogue: 0,0:13:16.82,0:13:19.48,Default,,0,0,0,,宇宙能量 补充中…
Dialogue: 0,0:13:20.25,0:13:21.83,Default,,0,0,0,,靠晒太阳吗
Dialogue: 0,0:13:21.83,0:13:23.34,Default,,0,0,0,,要一起吗
Dialogue: 0,0:13:23.39,0:13:24.43,Default,,0,0,0,,好呀
Dialogue: 0,0:13:29.90,0:13:31.09,Default,,0,0,0,,海果
Dialogue: 0,0:13:32.01,0:13:33.67,Default,,0,0,0,,这 这次要…
Dialogue: 0,0:13:33.88,0:13:35.88,Default,,0,0,0,,我说你 明内幽
Dialogue: 0,0:13:36.03,0:13:37.93,Default,,0,0,0,,只剩你还没交作业
Dialogue: 0,0:13:39.56,0:13:41.89,Default,,0,0,0,,跟我来一趟办公室
Dialogue: 0,0:13:44.76,0:13:46.66,Default,,0,0,0,,找不到时机…
Dialogue: 0,0:13:46.82,0:13:49.78,Default,,0,0,0,,不行不行 我要主动搭话
Dialogue: 0,0:13:49.83,0:13:51.68,Default,,0,0,0,,加油 海果
Dialogue: 0,0:13:54.15,0:13:56.54,Default,,0,0,0,,不在教室了？她已经回家了吗
Dialogue: 0,0:13:59.20,0:14:00.83,Default,,0,0,0,,你怎么了？海果
Dialogue: 0,0:14:00.93,0:14:02.07,Default,,0,0,0,,海果
Dialogue: 0,0:14:04.34,0:14:06.22,Default,,0,0,0,,那…那个
Dialogue: 0,0:14:07.14,0:14:09.20,Default,,0,0,0,,水火箭
Dialogue: 0,0:14:09.50,0:14:14.26,Default,,0,0,0,,嗯 因为一上来就造真火箭 也许太难了
Dialogue: 0,0:14:14.43,0:14:17.78,Default,,0,0,0,,网上也有制作的教程
Dialogue: 0,0:14:17.97,0:14:20.72,Default,,0,0,0,,我就想 大家可以一起把它造出来
Dialogue: 0,0:14:20.98,0:14:22.36,Default,,0,0,0,,让我看看 让我看看
Dialogue: 0,0:14:22.54,0:14:26.14,Default,,0,0,0,,我小学时造过来着 真怀念
Dialogue: 0,0:14:27.08,0:14:30.03,Default,,0,0,0,,地球的饮品还能做成火箭吗
Dialogue: 0,0:14:31.11,0:14:33.82,Default,,0,0,0,,温暖的红茶 原来是这样的构造？
Dialogue: 0,0:14:33.93,0:14:35.85,Default,,0,0,0,,有一点点不一样吧
Dialogue: 0,0:14:35.85,0:14:36.93,Default,,0,0,0,,不止一点点吧
Dialogue: 0,0:14:37.54,0:14:40.09,Default,,0,0,0,,诶！？通过水跟空气吗
Dialogue: 0,0:14:40.29,0:14:44.02,Default,,0,0,0,,是的 依靠瓶内的空气压飞起来
Dialogue: 0,0:14:44.17,0:14:47.27,Default,,0,0,0,,不同尺寸 飞行距离也会不一样吧
Dialogue: 0,0:14:48.44,0:14:53.33,Default,,0,0,0,,大瓶子可以装载更多的空气 飞得更远
Dialogue: 0,0:14:53.33,0:14:56.23,Default,,0,0,0,,好 好 大的 我想造大的
Dialogue: 0,0:14:56.56,0:14:59.09,Default,,0,0,0,,我早料到了 所以准备了它
Dialogue: 0,0:14:59.09,0:15:00.36,Default,,0,0,0,,不愧是海果
Dialogue: 0,0:15:00.36,0:15:01.63,Default,,0,0,0,,太帅了 海果！
Dialogue: 0,0:15:01.85,0:15:05.51,Default,,0,0,0,,但 但是 我们家只有这个大瓶子
Dialogue: 0,0:15:05.62,0:15:08.48,Default,,0,0,0,,是吗 这样的话数量不够呢
Dialogue: 0,0:15:08.62,0:15:10.96,Default,,0,0,0,,那样的话 交给我吧
Dialogue: 0,0:15:11.17,0:15:13.15,Default,,0,0,0,,像这样的 我轻轻松松就能喝完它
Dialogue: 0,0:15:18.16,0:15:20.11,Default,,0,0,0,,还…还有什么问题？
Dialogue: 0,0:15:21.71,0:15:23.65,Default,,0,0,0,,似乎还差两个
Dialogue: 0,0:15:23.65,0:15:24.64,Default,,0,0,0,,还要两个吗
Dialogue: 0,0:15:27.00,0:15:28.53,Default,,0,0,0,,我 我也…
Dialogue: 0,0:15:28.94,0:15:30.26,Default,,0,0,0,,虽然我不喜欢喝碳酸饮料
Dialogue: 0,0:15:30.26,0:15:31.15,Default,,0,0,0,,我会努力的！
Dialogue: 0,0:15:31.44,0:15:33.54,Default,,0,0,0,,你们两个 都等等
Dialogue: 0,0:15:35.96,0:15:37.33,Default,,0,0,0,,小美 小灯
Dialogue: 0,0:15:38.44,0:15:39.62,Default,,0,0,0,,喝饮料吗
Dialogue: 0,0:15:39.70,0:15:40.79,Default,,0,0,0,,我要 我要
Dialogue: 0,0:15:40.79,0:15:41.81,Default,,0,0,0,,谢谢你
Dialogue: 0,0:15:41.96,0:15:43.62,Default,,0,0,0,,遥乃 我也要
Dialogue: 0,0:15:44.17,0:15:45.10,Default,,0,0,0,,好的
Dialogue: 0,0:15:45.79,0:15:47.74,Default,,0,0,0,,不嫌弃的话 社团活动中的大家也喝吧
Dialogue: 0,0:15:47.97,0:15:50.15,Default,,0,0,0,,-啊 谢谢 -谢谢
Dialogue: 0,0:15:54.28,0:15:56.60,Default,,0,0,0,,一开始就应该这样做
Dialogue: 0,0:15:58.99,0:16:01.07,Default,,0,0,0,,那么 全力开始做吧
Dialogue: 0,0:16:03.70,0:16:07.70,Default,,0,0,0,,先用美工刀裁切瓶子
Dialogue: 0,0:16:08.85,0:16:10.15,Default,,0,0,0,,海果切得真好
Dialogue: 0,0:16:10.25,0:16:11.83,Default,,0,0,0,,切口很平整
Dialogue: 0,0:16:11.92,0:16:14.29,Default,,0,0,0,,海果的手真巧
Dialogue: 0,0:16:14.60,0:16:17.09,Default,,0,0,0,,好 好 我也想做做看
Dialogue: 0,0:16:21.34,0:16:22.67,Default,,0,0,0,,对不住 海果
Dialogue: 0,0:16:23.69,0:16:26.60,Default,,0,0,0,,海果的脸蛋 红上加红了
Dialogue: 0,0:16:27.20,0:16:29.18,Default,,0,0,0,,配件…做好之后
Dialogue: 0,0:16:29.18,0:16:33.56,Default,,0,0,0,,接下来 像这样 把它组合起来
Dialogue: 0,0:16:33.70,0:16:36.71,Default,,0,0,0,,我带了许多的彩色胶带
Dialogue: 0,0:16:38.08,0:16:38.68,Default,,0,0,0,,很好
Dialogue: 0,0:16:41.68,0:16:44.55,Default,,0,0,0,,明内同学她未曾有过地集中
Dialogue: 0,0:16:44.67,0:16:46.94,Default,,0,0,0,,火箭做得越来越惹人注目
Dialogue: 0,0:16:48.27,0:16:49.57,Default,,0,0,0,,做好了
Dialogue: 0,0:16:49.57,0:16:50.76,Default,,0,0,0,,完成
Dialogue: 0,0:16:51.19,0:16:51.86,Default,,0,0,0,,我说 我说
Dialogue: 0,0:16:51.86,0:16:53.94,Default,,0,0,0,,我们去哪发射火箭呢
Dialogue: 0,0:16:54.00,0:16:58.09,Default,,0,0,0,,那个 操场上有人在社团活动
Dialogue: 0,0:16:59.47,0:17:02.24,Default,,0,0,0,,灯塔 去灯塔发射 怎么样？
Dialogue: 0,0:17:03.00,0:17:04.71,Default,,0,0,0,,好主意 遥乃！
Comment: 0,0:17:05.05,0:17:07.45,Default,,0,0,0,,(灯塔,toudai) (怎样,doudai)
Dialogue: 0,0:17:05.05,0:17:07.45,Default,,0,0,0,,灯塔 怎样
Dialogue: 0,0:17:05.05,0:17:07.45,Default,,0,0,0,,{\fs49\pos(887,982)}toudai
Dialogue: 0,0:17:05.05,0:17:07.45,Default,,0,0,0,,{\fs49\pos(1032,982)}doudai
Dialogue: 0,0:17:07.64,0:17:09.71,Default,,0,0,0,,这也是一个好主意？
Dialogue: 0,0:17:12.92,0:17:15.22,Default,,0,0,0,,火箭 火箭
Dialogue: 0,0:17:15.53,0:17:17.70,Default,,0,0,0,,遥乃也一起
Dialogue: 0,0:17:17.87,0:17:19.92,Default,,0,0,0,,一起去灯塔
Dialogue: 0,0:17:20.87,0:17:22.69,Default,,0,0,0,,能顺利飞起来吗
Dialogue: 0,0:17:22.98,0:17:24.65,Default,,0,0,0,,飞起来 飞起来
Dialogue: 0,0:17:24.65,0:17:27.28,Default,,0,0,0,,飞向宇宙 Go Go Go
Dialogue: 0,0:17:27.28,0:17:30.24,Default,,0,0,0,,外星的大家 都喜欢唱歌吗
Dialogue: 0,0:17:32.02,0:17:35.44,Default,,0,0,0,,这种旋律从身体里流淌而出的感觉
Dialogue: 0,0:17:35.61,0:17:37.60,Default,,0,0,0,,一定是宇宙共通的
Dialogue: 0,0:17:38.03,0:17:42.04,Default,,0,0,0,,虽然自己星球上的歌有些模糊了
Dialogue: 0,0:17:42.30,0:17:43.36,Default,,0,0,0,,对了 海果
Dialogue: 0,0:17:43.36,0:17:44.86,Default,,0,0,0,,也教教我地球上的歌吧
Dialogue: 0,0:17:45.73,0:17:48.70,Default,,0,0,0,,不错呢！海果的声线唱出来的歌
Dialogue: 0,0:17:49.28,0:17:54.51,Default,,0,0,0,,一定是像 明媚早晨中铃兰花轻轻地呼出的吐息一样
Dialogue: 0,0:17:57.36,0:17:59.98,Default,,0,0,0,,把火箭安装在这发射台上
Dialogue: 0,0:18:00.44,0:18:03.28,Default,,0,0,0,,然后握住这个把手就能飞起来了
Dialogue: 0,0:18:04.72,0:18:06.38,Default,,0,0,0,,这个大约能飞多远？
Dialogue: 0,0:18:07.77,0:18:09.34,Default,,0,0,0,,这个还挺能飞的
Dialogue: 0,0:18:09.34,0:18:11.54,Default,,0,0,0,,大约能飞100米左右
Dialogue: 0,0:18:11.63,0:18:12.90,Default,,0,0,0,,100米
Dialogue: 0,0:18:13.48,0:18:16.16,Default,,0,0,0,,这是能去到哪个行星的距离？
Dialogue: 0,0:18:16.62,0:18:18.27,Default,,0,0,0,,要靠这个上宇宙吗？！
Dialogue: 0,0:18:18.50,0:18:22.89,Default,,0,0,0,,水火箭的话估计不太能飞上宇宙呢
Dialogue: 0,0:18:23.94,0:18:25.54,Default,,0,0,0,,她是失望了吗
Dialogue: 0,0:18:26.34,0:18:27.54,Default,,0,0,0,,这样啊
Dialogue: 0,0:18:27.97,0:18:32.05,Default,,0,0,0,,我还记不起来要回去的行星和在地球的使命
Dialogue: 0,0:18:32.44,0:18:35.27,Default,,0,0,0,,我还担心要是真能上宇宙的话该怎么办
Dialogue: 0,0:18:35.42,0:18:37.94,Default,,0,0,0,,说实话 我好像稍微放心了
Dialogue: 0,0:18:38.93,0:18:39.68,Default,,0,0,0,,而且
Dialogue: 0,0:18:39.89,0:18:41.80,Default,,0,0,0,,我还想要了解更多关于地球的事
Dialogue: 0,0:18:41.93,0:18:44.19,Default,,0,0,0,,当然还有海果跟遥乃
Dialogue: 0,0:18:45.72,0:18:48.81,Default,,0,0,0,,海果的话我觉得已经了解非常多了
Dialogue: 0,0:18:49.66,0:18:51.90,Default,,0,0,0,,出现了 现场额头感应
Dialogue: 0,0:18:52.13,0:18:52.96,Default,,0,0,0,,不过
Dialogue: 0,0:18:53.16,0:18:56.07,Default,,0,0,0,,因为不能回到宇宙而感到放心
Dialogue: 0,0:18:56.41,0:18:58.12,Default,,0,0,0,,会不会有点奇怪
Dialogue: 0,0:18:58.28,0:19:00.95,Default,,0,0,0,,我觉得这很好呀
Dialogue: 0,0:19:04.88,0:19:05.83,Default,,0,0,0,,是吗
Dialogue: 0,0:19:06.44,0:19:09.19,Default,,0,0,0,,我去给火箭加点水
Dialogue: 0,0:19:09.49,0:19:11.00,Default,,0,0,0,,谢…谢谢
Dialogue: 0,0:19:12.43,0:19:16.34,Default,,0,0,0,,幽 好像很喜欢这里
Dialogue: 0,0:19:17.09,0:19:18.67,Default,,0,0,0,,海果
Dialogue: 0,0:19:18.79,0:19:22.29,Default,,0,0,0,,要是能去到宇宙见到其他外星人的话
Dialogue: 0,0:19:22.35,0:19:23.15,Default,,0,0,0,,你会做什么？
Dialogue: 0,0:19:24.50,0:19:29.43,Default,,0,0,0,,我想要逃离这个压抑难受的地球
Dialogue: 0,0:19:29.69,0:19:32.65,Default,,0,0,0,,成为外星人的伙伴
Dialogue: 0,0:19:33.01,0:19:34.08,Default,,0,0,0,,我呢
Dialogue: 0,0:19:34.66,0:19:42.26,Default,,0,0,0,,如果能让他们和幽一样 多了解这颗星球的美和出色的人就好了
Dialogue: 0,0:19:45.21,0:19:47.74,Default,,0,0,0,,宝木那纯洁无邪的话语
Dialogue: 0,0:19:48.16,0:19:53.04,Default,,0,0,0,,对于一心只想逃离这颗星球的我来说
Dialogue: 0,0:19:53.52,0:19:56.44,Default,,0,0,0,,真的是非常新颖 具有冲击力
Dialogue: 0,0:19:56.90,0:19:59.54,Default,,0,0,0,,仿佛要将我的心灼烧殆尽般闪耀
Dialogue: 0,0:20:01.28,0:20:04.27,Default,,0,0,0,,不知为何胸口感到一丝刺痛
Dialogue: 0,0:20:05.80,0:20:09.40,Default,,0,0,0,,今天也一定会成为美好的回忆的
Dialogue: 0,0:20:10.65,0:20:12.18,Default,,0,0,0,,我回来了
Dialogue: 0,0:00:01.00,0:00:01.00,Default,,0,0,0,,好
Dialogue: 0,0:20:17.85,0:20:19.93,Default,,0,0,0,,好 准备完毕
Dialogue: 0,0:20:20.05,0:20:22.53,Default,,0,0,0,,你们一起来握住开关吧
Dialogue: 0,0:20:24.20,0:20:27.04,Default,,0,0,0,,对准时机 大家一起按下发射开关
Dialogue: 0,0:20:27.36,0:20:28.06,Default,,0,0,0,,怎么样
Dialogue: 0,0:20:28.32,0:20:30.54,Default,,0,0,0,,好呀 我赞成
Dialogue: 0,0:20:30.74,0:20:32.00,Default,,0,0,0,,来吧
Dialogue: 0,0:20:32.20,0:20:34.59,Default,,0,0,0,,这是通往我们梦想的第二步
Dialogue: 0,0:20:34.70,0:20:36.80,Default,,0,0,0,,各位 做好觉悟了吗
Dialogue: 0,0:20:36.90,0:20:39.30,Default,,0,0,0,,{\an3}要开始了 三！
Dialogue: 0,0:20:36.92,0:20:39.37,Default,,0,0,0,,梦想…我们的
Dialogue: 0,0:20:39.67,0:20:40.84,Default,,0,0,0,,二！
Dialogue: 0,0:20:41.06,0:20:42.42,Default,,0,0,0,,一！
Dialogue: 0,0:20:58.35,0:21:00.86,Default,,0,0,0,,太棒了 好漂亮
Dialogue: 0,0:21:00.86,0:21:02.43,Default,,0,0,0,,大成功
Dialogue: 0,0:21:02.68,0:21:03.56,Default,,0,0,0,,当我回过神时
Dialogue: 0,0:21:03.98,0:21:10.10,Default,,0,0,0,,我胸口的刺痛 已经溶解在我周围扩散开的闪光中
Dialogue: 0,0:21:10.10,0:21:11.46,Default,,0,0,0,,消失不见了
Dialogue: 0,0:21:12.05,0:21:14.41,Default,,0,0,0,,宝木同学口中所说的美妙
Dialogue: 0,0:21:14.41,0:21:17.28,Default,,0,0,0,,会不会就是指这种心情
Dialogue: 0,0:21:18.00,0:21:18.96,Default,,0,0,0,,再来一次
Dialogue: 0,0:21:19.11,0:21:20.64,Default,,0,0,0,,再发射一次吧
Dialogue: 0,0:21:21.31,0:21:23.16,Default,,0,0,0,,那个 非常遗憾
Dialogue: 0,0:21:23.29,0:21:24.81,Default,,0,0,0,,火箭已经在那边了
Dialogue: 0,0:21:24.81,0:21:26.20,Default,,0,0,0,,完了
Dialogue: 0,0:21:27.05,0:21:29.50,Default,,0,0,0,,我还挺喜欢那个设计的
Dialogue: 0,0:21:29.71,0:21:32.00,Default,,0,0,0,,我们得去回收才行
Dialogue: 0,0:21:32.46,0:21:33.49,Default,,0,0,0,,我有张网来着
Dialogue: 0,0:21:34.11,0:21:36.36,Default,,0,0,0,,刚才飞了有100米吗
Dialogue: 0,0:21:37.06,0:21:39.02,Default,,0,0,0,,下次想测量一下呢
Dialogue: 0,0:21:44.58,0:21:45.73,Default,,0,0,0,,闪闪发光
Dialogue: 0,0:23:27.56,0:23:28.51,Default,,0,0,0,,久等了


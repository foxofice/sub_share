Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:01:01.00,0:01:03.00,Layzner,David,0,0,0,,能走的话就快走啊
Dialogue: 0,0:01:04.00,0:01:06.00,Layzner,Eiji,0,0,0,,我也是人类啊
Dialogue: 0,0:01:07.00,0:01:09.00,Layzner,Anna,0,0,0,,够了 快住手
Dialogue: 0,0:02:12.00,0:02:16.00,Layzner,,0,0,0,,第七话 血是红色的
Dialogue: 0,0:01:43.58,0:01:51.09,Layzner,,0,0,0,,公元1996年在火星联合国基地因为受到古拉特斯星人的攻击而被毁灭
Dialogue: 0,0:01:53.09,0:01:57.53,Layzner,,0,0,0,,存活下来的我们前往美国基地寻求救援
Dialogue: 0,0:01:59.26,0:02:06.91,Layzner,,0,0,0,,古拉特斯让美苏开战 并让地球人毁灭的计划 已经开始了
Dialogue: 0,0:02:08.10,0:02:10.80,Layzner,,0,0,0,,然后那个人为了保护我们
Dialogue: 0,0:02:38.93,0:02:43.16,Layzner,,0,0,0,,是他 是那家伙 他回来了 太好了
Dialogue: 0,0:02:47.27,0:02:48.96,Layzner,,0,0,0,,喂 那家伙好像一点伤都没有
Dialogue: 0,0:02:49.39,0:02:51.12,Layzner,,0,0,0,,老实说我以为他被杀了
Dialogue: 0,0:02:51.98,0:02:55.21,Layzner,,0,0,0,,竟然能打败那两个杀手级的真是人太厉害了
Dialogue: 0,0:02:55.90,0:02:56.71,Layzner,,0,0,0,,他运气真好
Dialogue: 0,0:02:56.78,0:02:58.45,Layzner,,0,0,0,,你们怎么能这么说
Dialogue: 0,0:02:58.69,0:02:59.67,Layzner,,0,0,0,,我只是说实话而已
Dialogue: 0,0:02:59.99,0:03:00.77,Layzner,,0,0,0,,还敢说
Dialogue: 0,0:03:01.53,0:03:03.89,Layzner,,0,0,0,,大家都变得很兴奋
Dialogue: 0,0:03:04.83,0:03:07.93,Layzner,,0,0,0,,他果然没有丢下我们
Dialogue: 0,0:03:08.62,0:03:13.44,Layzner,,0,0,0,,曾陷入绝望的我们又一次燃起生存下去的勇气
Dialogue: 0,0:03:17.88,0:03:18.94,Layzner,,0,0,0,,其它人呢
Dialogue: 0,0:03:21.01,0:03:22.86,Layzner,,0,0,0,,都被你的伙伴杀光了
Dialogue: 0,0:03:26.64,0:03:29.54,Layzner,,0,0,0,,因为你的关系害我们好多人都被杀了
Dialogue: 0,0:03:30.39,0:03:32.39,Layzner,,0,0,0,,梅 鲍勃 弗兰斯 比尔 尼克拉耶夫也是
Dialogue: 0,0:03:32.81,0:03:34.88,Layzner,,0,0,0,,大家都被杀了你知道吗
Dialogue: 0,0:03:37.40,0:03:41.43,Layzner,,0,0,0,,大家别被骗 他不是救世主 而是杀手的伙伴
Dialogue: 0,0:03:41.82,0:03:42.37,Layzner,,0,0,0,,大卫
Dialogue: 0,0:03:43.49,0:03:46.10,Layzner,,0,0,0,,这家伙是毒瘤 恶魔的使者
Dialogue: 0,0:03:46.49,0:03:49.62,Layzner,,0,0,0,,不要再说了 一切已经是过去式了
Dialogue: 0,0:03:49.62,0:03:52.06,Layzner,,0,0,0,,过去式 伊丽莎白博士
Dialogue: 0,0:03:52.83,0:03:55.98,Layzner,,0,0,0,,我无法忍受 看着同伴被杀害默不作声的人
Dialogue: 0,0:03:56.88,0:04:00.19,Layzner,,0,0,0,,就算你责备他 就能让死人复生吗
Dialogue: 0,0:04:01.63,0:04:06.70,Layzner,,0,0,0,,我身为你们的负责人 已经不想再失去任何人了
Dialogue: 0,0:04:07.56,0:04:11.14,Layzner,,0,0,0,,只要你们能平安的回到地球
Dialogue: 0,0:04:11.14,0:04:14.62,Layzner,,0,0,0,,为了这件事不想再失去任何的可能性了
Dialogue: 0,0:04:15.31,0:04:16.88,Layzner,,0,0,0,,今后请不要再随便发言和行动
Dialogue: 0,0:04:18.07,0:04:18.96,Layzner,,0,0,0,,大家都一样
Dialogue: 0,0:04:24.86,0:04:27.22,Layzner,,0,0,0,,知道了吗 大卫
Dialogue: 0,0:04:29.99,0:04:31.39,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:04:40.80,0:04:47.93,Layzner,,0,0,0,,这群地球人在叫做火星的太阳系第四惑星有两大国家的基地
Dialogue: 0,0:04:47.93,0:04:51.72,Layzner,,0,0,0,,这是在地球上军备竞赛的延伸
Dialogue: 0,0:04:52.60,0:04:55.48,Layzner,,0,0,0,,我们古拉特斯偷偷地操纵这些基地
Dialogue: 0,0:04:55.48,0:04:57.48,Layzner,,0,0,0,,向地球人的这两基地同时发射了同样的导弹
Dialogue: 0,0:04:59.82,0:05:05.13,Layzner,,0,0,0,,地球人彼此以为遭到对方的攻击而对对方报复
Dialogue: 0,0:05:14.91,0:05:19.63,Layzner,,0,0,0,,如各位所见 第四惑星的模拟战非常成功
Dialogue: 0,0:05:19.63,0:05:21.69,Layzner,,0,0,0,,两大军事基地都被摧毁了
Dialogue: 0,0:05:24.05,0:05:26.43,Layzner,,0,0,0,,各位 我们的最终目的
Dialogue: 0,0:05:26.43,0:05:30.76,Layzner,,0,0,0,,是把第三惑星的地球纳入我们古拉特斯的统治
Dialogue: 0,0:05:30.76,0:05:36.64,Layzner,,0,0,0,,地球现在有这两大军事强国在维持平衡
Dialogue: 0,0:05:36.64,0:05:39.27,Layzner,,0,0,0,,如能对这两国煽风点火
Dialogue: 0,0:05:39.27,0:05:44.71,Layzner,,0,0,0,,那么他们的世界就会产生地球人所谓的第三次世界大战
Dialogue: 0,0:05:47.24,0:05:52.37,Layzner,,0,0,0,,各位 地球人已经不是一两百年前的猴子了
Dialogue: 0,0:05:52.37,0:05:57.89,Layzner,,0,0,0,,他们虽然幼稚但却不可小看他们所拥有的科技
Dialogue: 0,0:05:59.25,0:06:03.61,Layzner,,0,0,0,,不过他们的科技主要还是用在发展军事上
Dialogue: 0,0:06:04.30,0:06:11.91,Layzner,,0,0,0,,我们已经得知他们已经拥有可以拥有毁灭全人类的武器
Dialogue: 0,0:06:12.68,0:06:16.52,Layzner,,0,0,0,,我们要用人类自己做出来的如恶魔般的力量
Dialogue: 0,0:06:16.52,0:06:21.06,Layzner,,0,0,0,,让他们用在彼此身上并让他们毁灭
Dialogue: 0,0:06:21.06,0:06:24.73,Layzner,,0,0,0,,这么一来 人类最多剩下三分之一
Dialogue: 0,0:06:24.73,0:06:26.73,Layzner,,0,0,0,,并让他们的科技倒退一个世纪
Dialogue: 0,0:06:27.61,0:06:33.56,Layzner,,0,0,0,,这么一来我们古拉特斯就能在地球上建立我们的王国了
Dialogue: 0,0:06:35.37,0:06:40.15,Layzner,,0,0,0,,再过两小时 本舰就要开始行动了 完毕
Dialogue: 0,0:06:41.42,0:06:43.50,Layzner,,0,0,0,,各自回各自的岗位 做最后的准备
Dialogue: 0,0:06:43.50,0:06:44.50,Layzner,,0,0,0,,是
Dialogue: 0,0:06:46.30,0:06:49.93,Layzner,,0,0,0,,阁下 古斯特罗大尉已经回来了
Dialogue: 0,0:06:49.93,0:06:51.30,Layzner,,0,0,0,,那他的任务呢
Dialogue: 0,0:06:51.30,0:06:53.97,Layzner,,0,0,0,,失败了 他损失两名部下
Dialogue: 0,0:06:53.97,0:06:55.58,Layzner,,0,0,0,,竟然会失败
Dialogue: 0,0:06:56.31,0:07:00.77,Layzner,,0,0,0,,拥有丰富经验的他竟会输给一个小鬼
Dialogue: 0,0:07:00.77,0:07:02.92,Layzner,,0,0,0,,帮我叫凯利中尉过来 是
Dialogue: 0,0:07:13.45,0:07:16.33,Layzner,,0,0,0,,我们还坐得进这艘船吗
Dialogue: 0,0:07:16.33,0:07:17.37,Layzner,,0,0,0,,全部的人都坐得下
Dialogue: 0,0:07:17.37,0:07:20.64,Layzner,,0,0,0,,那可以到地球还是月球吗
Dialogue: 0,0:07:21.83,0:07:24.27,Layzner,,0,0,0,,我来算一下 请告诉我相关资料
Dialogue: 0,0:07:25.46,0:07:27.23,Layzner,,0,0,0,,大家上来吧 是
Dialogue: 0,0:07:28.38,0:07:29.91,Layzner,,0,0,0,,大卫 你也是
Dialogue: 0,0:07:31.34,0:07:32.89,Layzner,,0,0,0,,可不可以不要挤我
Dialogue: 0,0:07:32.89,0:07:34.50,Layzner,,0,0,0,,太挤了没办法
Dialogue: 0,0:07:35.70,0:07:36.49,Layzner,,0,0,0,,大卫
Dialogue: 0,0:07:51.60,0:07:52.42,Layzner,,0,0,0,,这边来
Dialogue: 0,0:07:57.87,0:08:01.96,Layzner,,0,0,0,,现在雷达还没显示有什么问题 来计算一下吧
Dialogue: 0,0:08:01.96,0:08:05.00,Layzner,,0,0,0,,真令人意外 一点都没有外星人的感觉
Dialogue: 0,0:08:05.00,0:08:06.17,Layzner,,0,0,0,,你太失礼了
Dialogue: 0,0:08:06.17,0:08:07.65,Layzner,,0,0,0,,等下 西蒙
Dialogue: 0,0:08:15.76,0:08:17.97,Layzner,,0,0,0,,不能降落到月球
Dialogue: 0,0:08:17.97,0:08:21.18,Layzner,,0,0,0,,残存的能源还剩5.02单位
Dialogue: 0,0:08:21.18,0:08:25.48,Layzner,,0,0,0,,要进入引力圈所需的能源 4.90单位
Dialogue: 0,0:08:25.48,0:08:28.90,Layzner,,0,0,0,,能源的消耗率是97.6%
Dialogue: 0,0:08:28.90,0:08:32.03,Layzner,,0,0,0,,要接近月球的能源不足
Dialogue: 0,0:08:32.03,0:08:34.74,Layzner,,0,0,0,,所以无法降落 只能到月球表面
Dialogue: 0,0:08:34.74,0:08:36.09,Layzner,,0,0,0,,怎么会这样
Dialogue: 0,0:08:37.58,0:08:39.70,Layzner,,0,0,0,,你们不是搭这个东西 横越宇宙到这的吗
Dialogue: 0,0:08:39.70,0:08:42.37,Layzner,,0,0,0,,古拉特斯会到这是靠大型的母舰
Dialogue: 0,0:08:42.37,0:08:44.60,Layzner,,0,0,0,,要不然是无法忍受超次元航行的
Dialogue: 0,0:08:45.62,0:08:47.31,Layzner,,0,0,0,,超次元航行
Dialogue: 0,0:08:47.67,0:08:50.59,Layzner,,0,0,0,,就是扭曲空间航行 地球现在也正在研究
Dialogue: 0,0:08:50.59,0:08:52.11,Layzner,,0,0,0,,那个我知道
Dialogue: 0,0:08:53.13,0:08:55.80,Layzner,,0,0,0,,如果用SPT让重力减轻的话怎么样
Dialogue: 0,0:08:58.76,0:09:00.26,Layzner,,0,0,0,,可能可以强行着陆
Dialogue: 0,0:09:00.26,0:09:03.37,Layzner,,0,0,0,,但乘客的存活率连百分之一都不到
Dialogue: 0,0:09:04.44,0:09:06.46,Layzner,,0,0,0,,没有其它方法了吗
Dialogue: 0,0:09:08.02,0:09:10.07,Layzner,,0,0,0,,放弃再次接近月球用的两艘宇宙飞船
Dialogue: 0,0:09:10.07,0:09:11.94,Layzner,,0,0,0,,可能可以用SPT着陆
Dialogue: 0,0:09:11.94,0:09:15.47,Layzner,,0,0,0,,乘客的存活率可达99%以上
Dialogue: 0,0:09:15.95,0:09:17.31,Layzner,,0,0,0,,可是SPT只有三艘
Dialogue: 0,0:09:18.30,0:09:20.52,Layzner,,0,0,0,,也就是说无法全员逃出了
Dialogue: 0,0:09:21.74,0:09:23.52,Layzner,,0,0,0,,那就不行了
Dialogue: 0,0:09:28.42,0:09:31.03,Layzner,,0,0,0,,敌人的攻击呢 只是时间问题
Dialogue: 0,0:09:32.60,0:09:34.32,Layzner,,0,0,0,,要快到安全的地方避难
Dialogue: 0,0:09:36.51,0:09:38.14,Layzner,,0,0,0,,去苏联基地吧
Dialogue: 0,0:09:38.14,0:09:40.81,Layzner,,0,0,0,,这星球上的基地可能都被毁了
Dialogue: 0,0:09:40.81,0:09:43.16,Layzner,,0,0,0,,还没确认过吧
Dialogue: 0,0:09:44.20,0:09:45.73,Layzner,,0,0,0,,虽说美国基地已经被毁了
Dialogue: 0,0:09:45.73,0:09:48.25,Layzner,,0,0,0,,但因此就说苏联基地也一样的话太草率了
Dialogue: 0,0:09:49.02,0:09:51.13,Layzner,,0,0,0,,我想看看他们是否还活着
Dialogue: 0,0:09:51.90,0:09:55.30,Layzner,,0,0,0,,我知道了 就这样出发吧
Dialogue: 0,0:09:55.90,0:10:00.45,Layzner,,0,0,0,,在一片好像要爆发的气氛中
Dialogue: 0,0:10:00.45,0:10:05.89,Layzner,,0,0,0,,我们前往苏联基地
Dialogue: 0,0:10:05.89,0:10:10.79,Layzner,,0,0,0,,凯利中尉 古雷斯科阁下要给你一个换回名誉的机会
Dialogue: 0,0:10:10.79,0:10:12.25,Layzner,,0,0,0,,谢谢您 阁下
Dialogue: 0,0:10:12.25,0:10:17.30,Layzner,,0,0,0,,第四惑星的作战计划 凯利 就交给你了
Dialogue: 0,0:10:17.30,0:10:19.30,Layzner,,0,0,0,,那就是说英二他
Dialogue: 0,0:10:20.68,0:10:23.14,Layzner,,0,0,0,,把英二跟地球人干掉
Dialogue: 0,0:10:23.14,0:10:26.56,Layzner,,0,0,0,,把第四惑星恢复成以前没有有机生物的模样
Dialogue: 0,0:10:26.56,0:10:27.25,Layzner,,0,0,0,,是
Dialogue: 0,0:10:27.52,0:10:31.52,Layzner,,0,0,0,,话说回来你们私下的交情会对我们带来困扰
Dialogue: 0,0:10:31.59,0:10:35.32,Layzner,,0,0,0,,我不允许再一次的失败了
Dialogue: 0,0:10:35.32,0:10:36.59,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:10:37.15,0:10:41.66,Layzner,,0,0,0,,英二现在是第九级的罪犯 不要管什么交情
Dialogue: 0,0:10:41.66,0:10:43.78,Layzner,,0,0,0,,就连你跟他姐姐的婚约也很有问题
Dialogue: 0,0:10:43.78,0:10:45.56,Layzner,,0,0,0,,您怎么这么说
Dialogue: 0,0:10:46.08,0:10:48.41,Layzner,,0,0,0,,今天是为了要处决反叛者
Dialogue: 0,0:10:48.41,0:10:50.83,Layzner,,0,0,0,,啊 堵上性命我也会赢的
Dialogue: 0,0:10:50.83,0:10:54.82,Layzner,,0,0,0,,古雷斯科阁下 请再给我一次机会讨伐他们
Dialogue: 0,0:10:55.67,0:10:58.09,Layzner,,0,0,0,,讨伐计划我已交给凯利中尉了
Dialogue: 0,0:10:58.09,0:11:00.34,Layzner,,0,0,0,,交给凯利 你开玩笑吗阁下
Dialogue: 0,0:11:01.55,0:11:03.85,Layzner,,0,0,0,,放开我 英二要由我亲手来干掉他
Dialogue: 0,0:11:03.85,0:11:05.10,Layzner,,0,0,0,,你不要再丢人现眼了
Dialogue: 0,0:11:05.10,0:11:09.87,Layzner,,0,0,0,,只是一个小孩就让你一直损失SPT及部下的生命
Dialogue: 0,0:11:10.02,0:11:13.79,Layzner,,0,0,0,,那是因为英二还有地球那些猴子用了卑鄙的技俩才会这样
Dialogue: 0,0:11:14.94,0:11:18.69,Layzner,,0,0,0,,英二应该没有用卑鄙技俩的作战技术
Dialogue: 0,0:11:18.69,0:11:22.70,Layzner,,0,0,0,,可是 为什么英二会知道我们的作战计划
Dialogue: 0,0:11:22.70,0:11:24.91,Layzner,,0,0,0,,你想说我们里面有告密者是吗
Dialogue: 0,0:11:24.91,0:11:27.87,Layzner,,0,0,0,,虽然我没有证据 但我是这么想的
Dialogue: 0,0:11:27.87,0:11:31.87,Layzner,,0,0,0,,古斯特罗士官 请不要再说那种推卸责任的话
Dialogue: 0,0:11:31.87,0:11:34.29,Layzner,,0,0,0,,给我闭嘴 跟背叛者的姐姐订婚
Dialogue: 0,0:11:34.29,0:11:39.40,Layzner,,0,0,0,,没用的你才是对我们古拉特斯来说也是背叛者
Dialogue: 0,0:11:40.67,0:11:43.76,Layzner,,0,0,0,,那么故意去接近并骚扰反叛者的姐姐
Dialogue: 0,0:11:43.76,0:11:47.80,Layzner,,0,0,0,,而该由我来教训的人又如何
Dialogue: 0,0:11:48.97,0:11:52.31,Layzner,,0,0,0,,这家伙 住手 古斯特罗 住手
Dialogue: 0,0:11:52.31,0:11:56.63,Layzner,,0,0,0,,叫你住手 凯利 马上进行任务 是
Dialogue: 0,0:12:03.95,0:12:07.58,Layzner,,0,0,0,,凯利 英二是我的猎物
Dialogue: 0,0:12:07.58,0:12:09.60,Layzner,,0,0,0,,猎物
Dialogue: 0,0:12:10.58,0:12:13.58,Layzner,,0,0,0,,不管别人怎么说 我都要亲手干掉他
Dialogue: 0,0:12:13.58,0:12:15.55,Layzner,,0,0,0,,别搞错了
Dialogue: 0,0:12:16.21,0:12:18.38,Layzner,,0,0,0,,英二不是背叛者也不是怪物
Dialogue: 0,0:12:18.38,0:12:21.59,Layzner,,0,0,0,,我要亲手抓捕他并送他接受法律的制裁
Dialogue: 0,0:12:21.59,0:12:24.57,Layzner,,0,0,0,,笨蛋 他是背叛我们的杀人犯
Dialogue: 0,0:12:24.89,0:12:27.01,Layzner,,0,0,0,,阿尔巴特罗•纳尔•飞鸟英二是古拉特斯人
Dialogue: 0,0:12:27.01,0:12:30.39,Layzner,,0,0,0,,电脑也明白地显示出 他是不会杀人的
Dialogue: 0,0:12:30.39,0:12:33.48,Layzner,,0,0,0,,那你说是谁杀了我的部下的
Dialogue: 0,0:12:33.48,0:12:35.58,Layzner,,0,0,0,,有一天上了法庭就知道了
Dialogue: 0,0:12:44.24,0:12:44.74,Layzner,,0,0,0,,可恶的凯利
Dialogue: 0,0:12:44.74,0:12:47.74,Layzner,,0,0,0,,如果真相大白 杀了部下的我就死定了
Dialogue: 0,0:12:40.00,0:12:40.00,Layzner,,0,0,0,,我一定要抢先杀了英二才行
Dialogue: 0,0:13:03.72,0:13:07.37,Layzner,,0,0,0,,一度燃起的希望 现在又被浇熄了
Dialogue: 0,0:13:08.22,0:13:13.98,Layzner,,0,0,0,,大家都可以不去谈 谁跟谁可以逃出去这问题
Dialogue: 0,0:13:13.98,0:13:16.50,Layzner,,0,0,0,,不 是不能谈
Dialogue: 0,0:13:17.65,0:13:24.97,Layzner,,0,0,0,,还有 只有我一个人是会担心压抑自己的大卫的人吗
Dialogue: 0,0:13:27.99,0:13:28.80,Layzner,,0,0,0,,是那里吗
Dialogue: 0,0:13:32.33,0:13:34.20,Layzner,,0,0,0,,果然他们也
Dialogue: 0,0:13:43.34,0:13:44.51,Layzner,,0,0,0,,什么反应也没有
Dialogue: 0,0:13:45.34,0:13:48.50,Layzner,,0,0,0,,人类花了好久的努力才建立起来的火星
Dialogue: 0,0:13:49.76,0:13:55.50,Layzner,,0,0,0,,和在眼前这两国的基地 还有联合国的基地
Dialogue: 0,0:13:56.60,0:13:58.21,Layzner,,0,0,0,,全都化为灰烬了
Dialogue: 0,0:13:59.35,0:14:00.88,Layzner,,0,0,0,,大家都死了
Dialogue: 0,0:14:01.48,0:14:06.88,Layzner,,0,0,0,,那全都是发生在我们降落在这星球后没多久的事
Dialogue: 0,0:14:07.82,0:14:09.18,Layzner,,0,0,0,,才一下子而已
Dialogue: 0,0:14:11.16,0:14:15.31,Layzner,,0,0,0,,要去哪里 伊丽莎白博士
Dialogue: 0,0:14:17.71,0:14:20.08,Layzner,,0,0,0,,好像浪费了一些能源跟时间了呢
Dialogue: 0,0:14:20.08,0:14:22.48,Layzner,,0,0,0,,其它没有什么安全的地方吗
Dialogue: 0,0:14:23.25,0:14:24.96,Layzner,,0,0,0,,安全的地方
Dialogue: 0,0:14:24.96,0:14:29.01,Layzner,,0,0,0,,没有那种地方了 那种地方已经没了
Dialogue: 0,0:14:29.01,0:14:31.93,Layzner,,0,0,0,,我们都绝望了
Dialogue: 0,0:14:31.93,0:14:34.81,Layzner,,0,0,0,,古拉特斯马上就要来了 大家都会被杀了
Dialogue: 0,0:14:34.81,0:14:37.25,Layzner,,0,0,0,,一个一个地死在激光之下 都会变成灰
Dialogue: 0,0:14:37.98,0:14:40.42,Layzner,,0,0,0,,我们会像之前那些人一样被杀光的
Dialogue: 0,0:14:42.82,0:14:45.38,Layzner,,0,0,0,,大卫 你说的对 那家伙
Dialogue: 0,0:14:58.70,0:15:01.20,Layzner,,0,0,0,,我想要空气和水
Dialogue: 0,0:15:01.20,0:15:03.23,Layzner,,0,0,0,,只剩下一个地方了
Dialogue: 0,0:15:04.04,0:15:04.67,Layzner,,0,0,0,,哪里
Dialogue: 0,0:15:05.46,0:15:06.99,Layzner,,0,0,0,,无人观测基地
Dialogue: 0,0:15:07.17,0:15:08.26,Layzner,,0,0,0,,那里是吗
Dialogue: 0,0:15:08.84,0:15:10.70,Layzner,,0,0,0,,这火星上没别的基地了
Dialogue: 0,0:15:12.47,0:15:15.68,Layzner,,0,0,0,,那里应该多少有点水跟空气对吧
Dialogue: 0,0:15:17.77,0:15:20.10,Layzner,,0,0,0,,只有水跟空气而已
Dialogue: 0,0:15:20.98,0:15:21.60,Layzner,,0,0,0,,去吧
Dialogue: 0,0:15:22.65,0:15:25.11,Layzner,,0,0,0,,要出发了 大家请保持安全的姿势
Dialogue: 0,0:15:30.61,0:15:35.91,Layzner,,0,0,0,,雷达启动 启动主电脑 导入环境程序
Dialogue: 0,0:15:35.91,0:15:38.33,Layzner,,0,0,0,,准备人工记录装置 编号02号
Dialogue: 0,0:15:38.33,0:15:41.33,Layzner,,0,0,0,,方位程序完成 全部准备好了
Dialogue: 0,0:15:41.71,0:15:42.33,Layzner,,0,0,0,,出发
Dialogue: 0,0:15:46.09,0:15:47.67,Layzner,,0,0,0,,凯利队 出发吧
Dialogue: 0,0:15:47.67,0:15:51.72,Layzner,,0,0,0,,输入喷射用程序 实战专用装置启动
Dialogue: 0,0:15:52.38,0:15:54.64,Layzner,,0,0,0,,射程速度保持相同速度 角度调整完成
Dialogue: 0,0:15:55.30,0:15:57.18,Layzner,,0,0,0,,保持相同速度 待机准备完毕
Dialogue: 0,0:16:06.36,0:16:08.73,Layzner,,0,0,0,,敌人只有一个 我们出动三架即可
Dialogue: 0,0:16:08.73,0:16:12.28,Layzner,,0,0,0,,了解 马上进行准备 一到达就开始攻击
Dialogue: 0,0:16:23.00,0:16:23.96,Layzner,,0,0,0,,古斯特罗
Dialogue: 0,0:16:52.03,0:16:53.99,Layzner,,0,0,0,,不知道是不是太紧张了 总觉得喉咙好干
Dialogue: 0,0:16:56.41,0:16:58.49,Layzner,,0,0,0,,我要水 就是这个
Dialogue: 0,0:16:58.91,0:17:01.45,Layzner,,0,0,0,,然后 呀 好冰哦
Dialogue: 0,0:17:02.79,0:17:05.62,Layzner,,0,0,0,,这样不行啦 要珍惜水资源
Dialogue: 0,0:17:06.12,0:17:07.92,Layzner,,0,0,0,,对哦 你去拿杯子来
Dialogue: 0,0:17:07.92,0:17:09.38,Layzner,,0,0,0,,为什么要我去拿
Dialogue: 0,0:17:09.71,0:17:10.80,Layzner,,0,0,0,,你也想喝水不是吗
Dialogue: 0,0:17:10.80,0:17:13.26,Layzner,,0,0,0,,你太狡猾了 想一个人把水喝光
Dialogue: 0,0:17:14.80,0:17:15.38,Layzner,,0,0,0,,因为
Dialogue: 0,0:17:15.38,0:17:17.84,Layzner,,0,0,0,,这里就是我们的葬身之处吧
Dialogue: 0,0:17:18.51,0:17:22.22,Layzner,,0,0,0,,搞了半天 还是回到这么黑暗的地方
Dialogue: 0,0:17:23.39,0:17:24.56,Layzner,,0,0,0,,只是为了找个埋葬我们的骨头的地方
Dialogue: 0,0:17:24.56,0:17:25.14,Layzner,,0,0,0,,西蒙尼
Dialogue: 0,0:17:26.14,0:17:27.69,Layzner,,0,0,0,,这里的确是有水跟空气没错
Dialogue: 0,0:17:27.69,0:17:30.77,Layzner,,0,0,0,,可是在这里我们哪都不能去
Dialogue: 0,0:17:31.90,0:17:34.32,Layzner,,0,0,0,,一辈子都得待在这宇宙中
Dialogue: 0,0:17:34.32,0:17:35.70,Layzner,,0,0,0,,你说的不对
Dialogue: 0,0:17:36.36,0:17:41.37,Layzner,,0,0,0,,现在从月球基地那 应该有来观测火星异状的船了
Dialogue: 0,0:17:41.37,0:17:43.41,Layzner,,0,0,0,,那船什么时候到
Dialogue: 0,0:17:44.50,0:17:45.00,Layzner,,0,0,0,,这个嘛
Dialogue: 0,0:17:45.00,0:17:48.08,Layzner,,0,0,0,,如果跟我们一样的话 应该要花七天十四个小时
Dialogue: 0,0:17:49.00,0:17:49.67,Layzner,,0,0,0,,要七天
Dialogue: 0,0:17:51.42,0:17:54.38,Layzner,,0,0,0,,只要有水跟空气的话一星期没问题 没问题
Dialogue: 0,0:17:55.01,0:17:57.88,Layzner,,0,0,0,,我无法等那么久
Dialogue: 0,0:17:59.14,0:18:03.02,Layzner,,0,0,0,,在那之前说不定会有其它的定期搜查船会来
Dialogue: 0,0:18:03.02,0:18:04.47,Layzner,,0,0,0,,那是什么时候
Dialogue: 0,0:18:04.81,0:18:06.69,Layzner,,0,0,0,,什么时候
Dialogue: 0,0:18:06.69,0:18:07.88,Layzner,,0,0,0,,这很重要啊
Dialogue: 0,0:18:10.52,0:18:12.13,Layzner,,0,0,0,,是定期搜查船对吧
Dialogue: 0,0:18:14.48,0:18:15.99,Layzner,,0,0,0,,没人知道吗
Dialogue: 0,0:18:15.99,0:18:18.28,Layzner,,0,0,0,,没人会知道的
Dialogue: 0,0:18:28.40,0:18:29.92,Layzner,,0,0,0,,就在我们等待的时候
Dialogue: 0,0:18:29.92,0:18:32.63,Layzner,,0,0,0,,古拉特斯的地球战作战计划 说不定已经开始了
Dialogue: 0,0:18:37.30,0:18:40.89,Layzner,,0,0,0,,够了 去吧
Dialogue: 0,0:18:42.64,0:18:44.64,Layzner,,0,0,0,,你的父母 吸着地球的空气
Dialogue: 0,0:18:44.89,0:18:48.48,Layzner,,0,0,0,,曾说过就算失去生命 也会保护地球人跟地球对吧
Dialogue: 0,0:18:50.85,0:18:51.90,Layzner,,0,0,0,,没错吧
Dialogue: 0,0:18:52.94,0:18:56.28,Layzner,,0,0,0,,这样的话就快去啊 快去完成你的使命
Dialogue: 0,0:18:57.82,0:19:00.45,Layzner,,0,0,0,,不管是谁都好 随便高兴带两个人快给我出去
Dialogue: 0,0:19:08.54,0:19:10.04,Layzner,,0,0,0,,能走的话就快走
Dialogue: 0,0:19:15.34,0:19:17.05,Layzner,,0,0,0,,大卫 不要用暴力
Dialogue: 0,0:19:17.71,0:19:21.26,Layzner,,0,0,0,,救命恩人 把我们带到这的飞行员
Dialogue: 0,0:19:21.26,0:19:23.64,Layzner,,0,0,0,,一个人拯救地球的英雄
Dialogue: 0,0:19:23.64,0:19:25.93,Layzner,,0,0,0,,这样就要我们感谢他是吗
Dialogue: 0,0:19:25.93,0:19:27.02,Layzner,,0,0,0,,大卫
Dialogue: 0,0:19:27.02,0:19:30.19,Layzner,,0,0,0,,可是 一直被他这样救下去的话
Dialogue: 0,0:19:30.19,0:19:32.52,Layzner,,0,0,0,,我会觉得 好像被压得喘不过气来
Dialogue: 0,0:19:33.06,0:19:37.57,Layzner,,0,0,0,,我这样打他 也是我一种报答他的方式
Dialogue: 0,0:19:37.98,0:19:39.74,Layzner,,0,0,0,,我没有要求你接受我
Dialogue: 0,0:19:41.32,0:19:43.87,Layzner,,0,0,0,,对啊 你没有强迫我们接受你
Dialogue: 0,0:19:43.87,0:19:45.87,Layzner,,0,0,0,,你只是来自古拉特斯的一个小英雄而已
Dialogue: 0,0:19:46.83,0:19:49.83,Layzner,,0,0,0,,你这种小鬼 还说自己的使命是救地球
Dialogue: 0,0:19:49.83,0:19:51.29,Layzner,,0,0,0,,别笑死人了
Dialogue: 0,0:19:53.29,0:19:57.05,Layzner,,0,0,0,,上次问我古拉特斯人会不会打架是你对吧
Dialogue: 0,0:19:57.05,0:19:59.01,Layzner,,0,0,0,,就算是古拉特斯人 被打也会痛的
Dialogue: 0,0:19:59.01,0:19:59.67,Layzner,,0,0,0,,你这家伙
Dialogue: 0,0:19:59.67,0:20:00.92,Layzner,,0,0,0,,也会生气的
Dialogue: 0,0:20:02.43,0:20:03.14,Layzner,,0,0,0,,我
Dialogue: 0,0:20:03.14,0:20:05.64,Layzner,,0,0,0,,也是人啊
Dialogue: 0,0:20:14.23,0:20:17.07,Layzner,,0,0,0,,很不错嘛 可是地球是我们的
Dialogue: 0,0:20:17.07,0:20:19.65,Layzner,,0,0,0,,不会让你们外星人为所欲为的
Dialogue: 0,0:20:24.70,0:20:25.99,Layzner,,0,0,0,,那就是你们地球人所谓的骄傲
Dialogue: 0,0:20:25.99,0:20:29.74,Layzner,,0,0,0,,无法控制自己 用核武器毁了彼此
Dialogue: 0,0:20:29.74,0:20:32.87,Layzner,,0,0,0,,这星球的军事基地 再次显示出你们的野蛮
Dialogue: 0,0:20:33.29,0:20:36.84,Layzner,,0,0,0,,那么把地球卷入战争的古拉特斯就不野蛮吗
Dialogue: 0,0:20:36.84,0:20:38.63,Layzner,,0,0,0,,还说什么漂亮话
Dialogue: 0,0:20:51.48,0:20:55.52,Layzner,,0,0,0,,地球是我从小埋藏在心底 是我梦里的故乡
Dialogue: 0,0:20:56.23,0:20:59.69,Layzner,,0,0,0,,地球是我们的星球 是我们的故乡
Dialogue: 0,0:21:00.61,0:21:02.53,Layzner,,0,0,0,,地球不属于任何人
Dialogue: 0,0:21:07.82,0:21:10.66,Layzner,,0,0,0,,地球是活在这世上所有人的地方
Dialogue: 0,0:21:10.66,0:21:12.37,Layzner,,0,0,0,,你说啥呐
Dialogue: 0,0:21:12.37,0:21:14.71,Layzner,,0,0,0,,小时候 爸爸就这么告诉我
Dialogue: 0,0:21:14.71,0:21:17.46,Layzner,,0,0,0,,闪耀的光芒是生命之光
Dialogue: 0,0:21:17.46,0:21:22.01,Layzner,,0,0,0,,绿色的地球是充满柔情的宇宙的宝石
Dialogue: 0,0:21:22.01,0:21:26.20,Layzner,,0,0,0,,一个男人话还这么多
Dialogue: 0,0:21:31.63,0:21:33.31,Layzner,,0,0,0,,我相信地球 是爸爸所说的星球
Dialogue: 0,0:21:33.77,0:21:37.85,Layzner,,0,0,0,,如果你是地球人的话就想想该把拳头对准谁
Dialogue: 0,0:21:38.69,0:21:41.19,Layzner,,0,0,0,,我的拳头 就是要瞄准你
Dialogue: 0,0:21:42.23,0:21:43.57,Layzner,,0,0,0,,给我站起来
Dialogue: 0,0:21:46.86,0:21:49.24,Layzner,,0,0,0,,他的血 是红的
Dialogue: 0,0:21:55.46,0:21:57.46,Layzner,,0,0,0,,怎么了 头一次看到血是吗
Dialogue: 0,0:22:00.34,0:22:04.13,Layzner,,0,0,0,,我还真不知道 古拉特斯星人的血也是红的
Dialogue: 0,0:22:05.42,0:22:08.30,Layzner,,0,0,0,,而且还用地球的柔道 真是笑死人了
Dialogue: 0,0:22:08.30,0:22:09.18,Layzner,,0,0,0,,住手
Dialogue: 0,0:22:11.68,0:22:13.68,Layzner,,0,0,0,,够了 住手
Dialogue: 0,0:22:29.70,0:22:30.66,Layzner,,0,0,0,,目标捕捉
Dialogue: 0,0:22:32.62,0:22:35.95,Layzner,,0,0,0,,以目前的编队方式前进吧 了解
Dialogue: 0,0:22:37.25,0:22:39.08,Layzner,,0,0,0,,等一下 你想逃吗
Dialogue: 0,0:22:41.46,0:22:45.92,Layzner,,0,0,0,,大家都很清楚地知道 他根本没有要逃
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:23:54.45,0:23:56.03,Layzner,,0,0,0,,杀了凯利之后也送你下地狱好了
Dialogue: 0,0:23:56.03,0:23:58.95,Layzner,,0,0,0,,想到要杀人就受不了了
Dialogue: 0,0:23:58.95,0:24:00.87,Layzner,,0,0,0,,推测驾驶员的存活率百分之零点二
Dialogue: 0,0:24:00.87,0:24:04.25,Layzner,,0,0,0,,可恶的家伙 我会把你们完全粉碎的
Dialogue: 0,0:24:04.25,0:24:07.09,Layzner,,0,0,0,,下一集 回应他的呐喊

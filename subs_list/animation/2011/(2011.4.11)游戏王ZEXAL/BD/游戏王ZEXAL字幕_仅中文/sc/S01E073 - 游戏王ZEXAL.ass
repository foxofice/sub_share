Dialogue: 0,0:00:01.34,0:00:03.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(游马)海马濑人 海马！
Dialogue: 0,0:00:03.87,0:00:05.35,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(哈鲁特)哥哥的目光{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:05.35,0:00:06.71,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}正试图回应游马。
Dialogue: 0,0:00:07.13,0:00:09.14,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(海马)前方等待着什么尚未可知。
Dialogue: 0,0:00:09.48,0:00:12.16,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}但我会将其开辟我的道路。
Dialogue: 0,0:00:12.53,0:00:13.59,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的决斗！
Dialogue: 0,0:00:14.17,0:00:15.52,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}来吧 海马！
Dialogue: 0,0:00:18.75,0:00:21.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}唤醒沉睡的狮子这件事你会后悔的。
Dialogue: 0,0:00:22.25,0:00:23.43,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}求之不得！
Dialogue: 0,0:00:24.08,0:00:24.95,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的回合
Dialogue: 0,0:00:26.53,0:00:27.09,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}抽卡！
Dialogue: 0,0:00:27.91,0:00:30.97,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我发动魔法卡逆境之宝札。
Dialogue: 0,0:00:31.39,0:00:33.62,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的场上没有怪兽
Dialogue: 0,0:00:33.62,0:00:34.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}对方场上{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:34.90,0:00:37.04,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}有特殊召唤的怪兽时
Dialogue: 0,0:00:37.90,0:00:40.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}抽两张卡。
Dialogue: 0,0:00:43.08,0:00:44.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后 我发动魔法卡
Dialogue: 0,0:00:44.82,0:00:46.06,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}加速之光。
Dialogue: 0,0:00:47.87,0:00:49.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}当我场上没有怪兽时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:50.54,0:00:53.16,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}作为放弃这个回合通常召唤的代价{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:53.60,0:00:55.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}可以从卡组特殊召唤
Dialogue: 0,0:00:55.57,0:00:58.25,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}1只等级4的光属性战士族怪兽{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:58.25,0:00:59.06,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}。
Dialogue: 0,0:01:00.15,0:01:02.36,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我特殊召唤 恶魔破坏者！
Dialogue: 0,0:01:08.60,0:01:11.14,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}（星光体）恶魔破坏者——游马 小心点。
Dialogue: 0,0:01:11.34,0:01:11.75,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哦。
Dialogue: 0,0:01:12.33,0:01:14.81,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}恶魔破坏者特殊召唤成功时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:01:15.25,0:01:16.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}可以从手牌特殊召唤
Dialogue: 0,0:01:16.74,0:01:18.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}另一只恶魔破坏者。
Dialogue: 0,0:01:22.23,0:01:22.48,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我用
Dialogue: 0,0:01:22.48,0:01:24.97,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}2只等级4的恶魔破坏者叠放。
Dialogue: 0,0:01:27.07,0:01:28.25,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}用2只怪兽
Dialogue: 0,0:01:28.25,0:01:30.28,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}构建叠放网络。
Dialogue: 0,0:01:30.82,0:01:32.03,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}超量召唤。
Dialogue: 0,0:01:35.37,0:01:38.01,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现身吧 辉光子帕拉迪奥斯！
Dialogue: 0,0:01:39.24,0:01:40.11,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}来了啊。
Dialogue: 0,0:01:40.52,0:01:41.39,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}要攻过来了！
Dialogue: 0,0:01:42.14,0:01:44.38,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}辉光子帕拉迪奥斯的效果发动！
Dialogue: 0,0:01:45.17,0:01:48.08,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}1回合1次使用1个超量单位{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:01:48.64,0:01:49.77,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}直到战斗结束{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:01:50.10,0:01:52.78,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将对方场上的1只怪兽超量
Dialogue: 0,0:01:52.78,0:01:53.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击力变为0{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:01:54.33,0:01:56.93,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}并且 除帕拉迪奥斯以外的卡牌效果
Dialogue: 0,0:01:56.93,0:01:57.70,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}全部无效。
Dialogue: 0,0:02:00.17,0:02:02.07,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}希望的效果消失了也就是说。
Dialogue: 0,0:02:02.53,0:02:05.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}没错 就算是 No.怪兽也能破坏。
Dialogue: 0,0:02:06.03,0:02:07.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}上吧 帕拉迪奥斯
Dialogue: 0,0:02:07.33,0:02:08.98,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}光子 俯冲！
Dialogue: 0,0:02:18.00,0:02:19.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我就这样 回合结束。
Dialogue: 0,0:02:27.07,0:02:28.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}不愧是 海斗。
Dialogue: 0,0:02:28.67,0:02:31.41,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}是啊 不过不这样就没意思了。
Dialogue: 0,0:02:32.36,0:02:34.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}要一口气爆发的话 这堵墙正好！
Dialogue: 0,0:02:35.20,0:02:38.29,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}可不是你那种能轻易越过的软墙。
Dialogue: 0,0:02:38.93,0:02:41.56,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那我就算硬撑也要越过去给你看。
Dialogue: 0,0:04:12.82,0:04:14.73,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的回合 抽卡！
Dialogue: 0,0:04:15.63,0:04:18.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我从手牌发动魔法卡
Dialogue: 0,0:04:18.10,0:04:19.72,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}魔封印的宝札！
Dialogue: 0,0:04:20.56,0:04:22.39,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这个回合 作为封印
Dialogue: 0,0:04:22.39,0:04:23.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}魔法卡发动的代价{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:04:24.47,0:04:26.27,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}抽２张卡！
Dialogue: 0,0:04:27.50,0:04:28.25,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}《好 来了！》
Dialogue: 0,0:04:28.87,0:04:31.28,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我召唤嘎嘎嘎凯撒！
Dialogue: 0,0:04:36.93,0:04:38.05,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后 我的场上
Dialogue: 0,0:04:38.05,0:04:39.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}有嘎嘎嘎怪兽的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:04:40.29,0:04:42.56,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}可以特殊召唤嘎嘎嘎库拉克！
Dialogue: 0,0:04:46.83,0:04:49.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}接着 我发动嘎嘎嘎凯撒的效果！
Dialogue: 0,0:04:50.16,0:04:52.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}１回合１次 从自己的墓地
Dialogue: 0,0:04:52.10,0:04:53.54,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将１只怪兽除外{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:04:54.05,0:04:54.98,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}自己场上的
Dialogue: 0,0:04:54.98,0:04:56.37,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}所有怪兽的等级{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:04:56.78,0:04:58.77,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}变成被除外的怪兽的等级！
Dialogue: 0,0:04:59.54,0:05:01.98,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我将墓地的刚巴拉骑士除外！
Dialogue: 0,0:05:02.67,0:05:04.27,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}刚巴拉骑士的等级是4！
Dialogue: 0,0:05:04.64,0:05:06.40,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}因此 我我我魔术师和
Dialogue: 0,0:05:06.40,0:05:08.64,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我我我少女的等级变成4！
Dialogue: 0,0:05:09.59,0:05:11.89,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(铁男)等级4的怪兽有2只！
Dialogue: 0,0:05:12.40,0:05:13.47,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(德之助)机会来了！
Dialogue: 0,0:05:13.84,0:05:15.13,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(凯西)上啊！
Dialogue: 0,0:05:15.47,0:05:17.23,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(小鸟)冲啊～！游马！
Dialogue: 0,0:05:17.82,0:05:20.14,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我用等级4的我我我魔术师和
Dialogue: 0,0:05:20.14,0:05:22.19,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我我我少女进行叠放！
Dialogue: 0,0:05:23.01,0:05:24.20,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}用2只怪兽
Dialogue: 0,0:05:24.20,0:05:26.25,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}构建叠放网络！
Dialogue: 0,0:05:27.01,0:05:28.31,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}超量召唤！
Dialogue: 0,0:05:29.45,0:05:30.28,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现身吧！
Dialogue: 0,0:05:30.28,0:05:33.62,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}英雄冠军 圣剑士！
Dialogue: 0,0:05:37.51,0:05:39.66,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(五十六)哦！那不是我做的
Dialogue: 0,0:05:39.66,0:05:40.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}怪兽吗！
Dialogue: 0,0:05:41.16,0:05:42.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}狠狠揍它！游马！
Dialogue: 0,0:05:43.36,0:05:44.68,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(德之助)五十六！
Dialogue: 0,0:05:44.68,0:05:45.93,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你到底是哪边的。
Dialogue: 0,0:05:46.63,0:05:49.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我用『艾克斯卡利巴』攻击『帕拉迪奥斯』！
Dialogue: 0,0:05:50.07,0:05:52.09,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(等{\fnNoto Sans CJK SC}々{\fnZCOOL KuaiLe}力)可是两只的攻击力……。
Dialogue: 0,0:05:52.20,0:05:53.70,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}都是2000，一样啊！
Dialogue: 0,0:05:54.06,0:05:56.69,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}发动『艾克斯卡利巴』的怪兽效果！
Dialogue: 0,0:05:57.32,0:05:59.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}把所有超量素材用掉，
Dialogue: 0,0:05:59.63,0:06:02.36,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}到战斗结束为止攻击力变成两倍。
Dialogue: 0,0:06:04.14,0:06:05.42,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击力4000！
Dialogue: 0,0:06:05.89,0:06:08.14,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}上吧！『艾克斯卡利巴』！
Dialogue: 0,0:06:08.80,0:06:12.04,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}一刀两断必杀神剑！
Dialogue: 0,0:06:18.50,0:06:19.30,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}快斗！
Dialogue: 0,0:06:19.56,0:06:20.50,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(心园先生7)快斗大人！
Dialogue: 0,0:06:26.09,0:06:27.76,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}『帕拉迪奥斯』被破坏时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:06:28.78,0:06:30.46,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}抽1张卡！
Dialogue: 0,0:06:31.00,0:06:32.76,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我就这样，回合结束。
Dialogue: 0,0:06:35.59,0:06:36.25,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}快斗……
Dialogue: 0,0:06:37.27,0:06:38.24,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}好厉害啊！
Dialogue: 0,0:06:38.85,0:06:39.29,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}是的。
Dialogue: 0,0:06:39.45,0:06:40.92,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}真是场严酷的决斗。
Dialogue: 0,0:06:41.34,0:06:44.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}喉咙咕噜咕噜……才不是是火辣辣地疼啊。
Dialogue: 0,0:06:45.30,0:06:46.88,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}不过看起来很开心。
Dialogue: 0,0:06:47.53,0:06:47.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哎？
Dialogue: 0,0:06:48.87,0:06:52.06,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}在我看来 游马和快斗{\fnNoto Sans CJK SC}➡{\fnZCOOL KuaiLe}都显得很开心。
Dialogue: 0,0:06:54.51,0:06:55.00,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}嗯！
Dialogue: 0,0:06:58.77,0:07:00.16,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哥哥他 在笑。
Dialogue: 0,0:07:01.00,0:07:01.42,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(Dr.菲卡)哎？
Dialogue: 0,0:07:02.16,0:07:04.06,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}打从心底里开心地笑着。
Dialogue: 0,0:07:05.86,0:07:08.06,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}《一马 你的儿子
Dialogue: 0,0:07:08.06,0:07:10.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}会拯救快斗吗》
Dialogue: 0,0:07:13.94,0:07:16.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}上吧！ 我的回合 抽卡！
Dialogue: 0,0:07:17.97,0:07:20.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我发动装备魔法 银河零式！
Dialogue: 0,0:07:21.55,0:07:22.43,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将我墓地里的
Dialogue: 0,0:07:22.43,0:07:24.46,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}银河眼的效果无效化{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:07:25.74,0:07:28.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}以攻击表示复活并装备这张卡！
Dialogue: 0,0:07:29.52,0:07:31.34,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}复活吧！ 银河眼！
Dialogue: 0,0:07:34.62,0:07:36.39,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}唔！ 银河眼！
Dialogue: 0,0:07:36.88,0:07:38.70,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哈！ 这才像样嘛！
Dialogue: 0,0:07:39.40,0:07:41.71,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}装备魔法由于银河·零的效果{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:07:42.03,0:07:42.96,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}在战斗期间
Dialogue: 0,0:07:42.96,0:07:45.49,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击力下降800点！
Dialogue: 0,0:07:47.88,0:07:49.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}即便如此 银河眼的
Dialogue: 0,0:07:49.86,0:07:51.30,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击力还是更高吗！
Dialogue: 0,0:07:51.47,0:07:53.04,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}快斗！ 上！
Dialogue: 0,0:07:53.84,0:07:56.68,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}银河眼！ 攻击「暗叛逆XYZ龙」！
Dialogue: 0,0:07:57.48,0:08:00.07,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}破灭的光子流！
Dialogue: 0,0:08:06.60,0:08:07.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马！
Dialogue: 0,0:08:13.12,0:08:15.24,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后 银河眼的攻击力
Dialogue: 0,0:08:15.24,0:08:15.95,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}恢复原状。
Dialogue: 0,0:08:17.02,0:08:19.52,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我盖放一张卡 回合结束。
Dialogue: 0,0:08:20.68,0:08:22.27,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}唔… 可恶！
Dialogue: 0,0:08:23.99,0:08:27.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}还没完 我还能继续打快斗！
Dialogue: 0,0:08:27.90,0:08:29.50,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哼 正合我意。
Dialogue: 0,0:08:34.33,0:08:35.93,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的回合 抽卡！
Dialogue: 0,0:08:36.77,0:08:39.37,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我发动魔法卡「我我我抽卡」！
Dialogue: 0,0:08:41.75,0:08:42.41,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将我墓地里的
Dialogue: 0,0:08:42.41,0:08:44.22,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将墓地里的3只嘎嘎嘎怪兽除外……
Dialogue: 0,0:08:49.88,0:08:52.36,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}抽2张卡。
Dialogue: 0,0:08:53.62,0:08:54.71,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}再发动装备魔法
Dialogue: 0,0:08:54.71,0:08:56.65,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}异热同心复活。
Dialogue: 0,0:08:57.57,0:08:58.34,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}从我墓地里
Dialogue: 0,0:08:58.34,0:09:00.08,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}选择1只超量怪兽{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:09:00.65,0:09:03.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}把这张卡装备给它特殊召唤！
Dialogue: 0,0:09:04.20,0:09:06.37,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}来吧，让我看看你的全部。
Dialogue: 0,0:09:06.93,0:09:08.88,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我会把那一切统统击碎。
Dialogue: 0,0:09:09.23,0:09:10.77,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那就是我的台词！
Dialogue: 0,0:09:11.33,0:09:13.12,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我选择希望皇霍普。
Dialogue: 0,0:09:13.60,0:09:16.06,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现身吧，希望皇霍普！
Dialogue: 0,0:09:21.85,0:09:24.75,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}但是，还达不到银河眼的高度。
Dialogue: 0,0:09:25.88,0:09:27.19,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我就让它达到给你看！
Dialogue: 0,0:09:27.65,0:09:30.08,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}沸腾起来吧，我自己！
Dialogue: 0,0:09:30.92,0:09:32.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}混沌超量变身！
Dialogue: 0,0:09:33.37,0:09:35.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将混沌化为光的使者
Dialogue: 0,0:09:35.67,0:09:39.05,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现身吧，CNo.39。
Dialogue: 0,0:09:39.91,0:09:42.00,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}希望皇霍普雷！
Dialogue: 0,0:09:52.23,0:09:52.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}《希望皇
Dialogue: 0,0:09:53.72,0:09:54.35,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}希望…》
Dialogue: 0,0:09:56.73,0:09:58.68,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}星光界 你说过。
Dialogue: 0,0:09:59.23,0:10:01.45,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}已经没必要被过去束缚了。
Dialogue: 0,0:10:02.45,0:10:02.89,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}啊啊。
Dialogue: 0,0:10:04.35,0:10:06.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的决斗 曾是誓言之决斗。
Dialogue: 0,0:10:07.65,0:10:08.25,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}誓言？
Dialogue: 0,0:10:09.48,0:10:11.71,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}一边发誓绝对要救出隼人
Dialogue: 0,0:10:11.71,0:10:13.28,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}一边进行着决斗。
Dialogue: 0,0:10:14.40,0:10:15.07,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哥哥…。
Dialogue: 0,0:10:16.01,0:10:17.70,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}但是 从今往后…。
Dialogue: 0,0:10:20.03,0:10:20.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}愿望
Dialogue: 0,0:10:21.52,0:10:22.19,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}希望…。
Dialogue: 0,0:10:23.80,0:10:25.89,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我要进行 为了我自己的决斗。
Dialogue: 0,0:10:26.66,0:10:29.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}是啊 快斗未来是属于我们的。
Dialogue: 0,0:10:30.90,0:10:32.35,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}由我们来决定。
Dialogue: 0,0:10:43.84,0:10:44.71,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}快斗。
Dialogue: 0,0:10:45.93,0:10:48.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哥哥 我也一样。
Dialogue: 0,0:10:50.00,0:10:51.53,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}来吧 游马！
Dialogue: 0,0:10:52.14,0:10:53.53,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}上吧 快斗！
Dialogue: 0,0:10:53.53,0:10:56.30,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}希望皇霍普的效果 发动。
Dialogue: 0,0:10:57.04,0:10:58.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}使用一个超量素材{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:59.26,0:11:01.43,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这个回合 霍普的攻击力
Dialogue: 0,0:11:01.43,0:11:03.29,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}提升500点。
Dialogue: 0,0:11:03.90,0:11:05.28,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}超量充能！
Dialogue: 0,0:11:11.69,0:11:14.47,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}并且 将对方一只怪兽的攻击力
Dialogue: 0,0:11:14.47,0:11:16.35,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}降低1000点。
Dialogue: 0,0:11:18.27,0:11:19.83,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}去吧 霍普！
Dialogue: 0,0:11:19.83,0:11:21.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击银河眼。
Dialogue: 0,0:11:22.50,0:11:25.21,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}霍普剑·混沌斩！
Dialogue: 0,0:11:31.03,0:11:33.49,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我发动 装备魔法 银河·零的
Dialogue: 0,0:11:33.49,0:11:34.72,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}另一个效果！
Dialogue: 0,0:11:36.62,0:11:38.65,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}通过将这张卡送去墓地
Dialogue: 0,0:11:38.65,0:11:41.16,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}让银河眼的破坏无效。
Dialogue: 0,0:11:44.79,0:11:47.22,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}但是 战斗伤害你还是要承受。
Dialogue: 0,0:11:47.66,0:11:48.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这样一来…。
Dialogue: 0,0:11:54.65,0:11:55.93,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}为 为什么？
Dialogue: 0,0:11:56.57,0:11:58.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}送去墓地的银河·零的
Dialogue: 0,0:11:58.67,0:11:59.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}还有更厉害的效果。
Dialogue: 0,0:12:00.40,0:12:02.73,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这张卡离开场地时
Dialogue: 0,0:12:02.73,0:12:05.24,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}装备怪兽的攻击力变成0。
Dialogue: 0,0:12:08.26,0:12:10.12,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马，这是零之锁的效果。
Dialogue: 0,0:12:15.43,0:12:17.29,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这样啊。糟了！
Dialogue: 0,0:12:17.88,0:12:20.98,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}零之锁……是你的永续魔法。
Dialogue: 0,0:12:21.94,0:12:24.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}场上的攻击力为0的怪兽
Dialogue: 0,0:12:24.32,0:12:25.24,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}不能攻击。
Dialogue: 0,0:12:25.51,0:12:28.64,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}因此，霍普雷的攻击无效。
Dialogue: 0,0:12:29.43,0:12:30.31,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}也就是说……
Dialogue: 0,0:12:30.48,0:12:31.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}没错。
Dialogue: 0,0:12:31.83,0:12:34.46,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的永续魔法战斗重力效果
Dialogue: 0,0:12:34.46,0:12:35.29,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将埋葬你。
Dialogue: 0,0:12:36.86,0:12:38.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}控制怪兽的玩家
Dialogue: 0,0:12:38.86,0:12:40.26,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}没有进行战斗时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:12:40.82,0:12:41.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那个玩家
Dialogue: 0,0:12:41.63,0:12:43.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}受到1000点伤害。
Dialogue: 0,0:12:44.39,0:12:45.16,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}糟了！
Dialogue: 0,0:12:45.30,0:12:45.79,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马！
Dialogue: 0,0:12:46.18,0:12:46.59,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哦！
Dialogue: 0,0:12:46.59,0:12:49.65,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}发动永续陷阱 次元之门！
Dialogue: 0,0:12:50.31,0:12:51.79,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将我们场上的
Dialogue: 0,0:12:51.79,0:12:53.34,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}1只怪兽除外。
Dialogue: 0,0:12:58.58,0:13:00.72,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}对于没有控制怪兽的我
Dialogue: 0,0:13:00.72,0:13:03.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}战斗伤害的效果伤害不存在。
Dialogue: 0,0:13:06.27,0:13:08.13,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这两个人都挺带劲的嘛。
Dialogue: 0,0:13:09.64,0:13:10.40,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}凯特……
Dialogue: 0,0:13:11.23,0:13:13.99,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}凯特大人 别输给托马那种家伙！
Dialogue: 0,0:13:14.57,0:13:16.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}好厉害！ 这场决斗到底是什么情况……
Dialogue: 0,0:13:17.03,0:13:19.05,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}两人正不断向前迈进。
Dialogue: 0,0:13:20.05,0:13:22.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}朝着前方的希望……
Dialogue: 0,0:13:23.43,0:13:26.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我盖放1张卡 回合结束。
Dialogue: 0,0:13:28.72,0:13:29.31,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马。
Dialogue: 0,0:13:29.51,0:13:29.98,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}啊？
Dialogue: 0,0:13:31.97,0:13:33.42,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你变强了啊。
Dialogue: 0,0:13:34.15,0:13:35.62,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}怎 怎么了？
Dialogue: 0,0:13:36.60,0:13:39.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你那股不服输的精神真的很了不起。
Dialogue: 0,0:13:39.91,0:13:41.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你已经一个人也……
Dialogue: 0,0:13:42.47,0:13:43.47,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你在说什么啊！
Dialogue: 0,0:13:44.21,0:13:46.56,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我们两个人合为一体才是真正的羁绊。
Dialogue: 0,0:13:49.39,0:13:52.13,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}一直一起向前进吧。
Dialogue: 0,0:13:54.23,0:13:56.00,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马，要赢啊。
Dialogue: 0,0:13:56.92,0:13:57.42,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哦！
Dialogue: 0,0:13:58.51,0:14:00.09,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}（快斗）游马，星光体。
Dialogue: 0,0:14:01.89,0:14:03.99,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这场决斗，就让我们拿下吧。
Dialogue: 0,0:14:06.79,0:14:07.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的回合！
Dialogue: 0,0:14:10.10,0:14:10.64,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}抽卡！
Dialogue: 0,0:14:11.31,0:14:13.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我召唤银河巫师。
Dialogue: 0,0:14:22.10,0:14:23.77,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后银河巫师
Dialogue: 0,0:14:23.77,0:14:24.92,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}等级提升4级{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:25.25,0:14:27.80,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}可以当作2只超量素材来使用。
Dialogue: 0,0:14:30.76,0:14:31.95,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}来了吗。
Dialogue: 0,0:14:32.58,0:14:34.23,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}等级8的银河眼和{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:34.69,0:14:36.80,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}化作2只素材的银河巫师
Dialogue: 0,0:14:36.80,0:14:37.48,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}叠放！
Dialogue: 0,0:14:40.71,0:14:41.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}用3只怪兽
Dialogue: 0,0:14:41.91,0:14:43.97,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}构建叠放网络。
Dialogue: 0,0:14:44.50,0:14:45.65,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}超量召唤！
Dialogue: 0,0:14:48.10,0:14:49.48,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}汹涌的银河啊！
Dialogue: 0,0:14:50.00,0:14:54.20,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现在化作怒涛之光现身吧！
Dialogue: 0,0:15:06.58,0:15:08.98,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}降临吧 我的灵魂！
Dialogue: 0,0:15:09.68,0:15:12.26,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}新银河眼光子龙！
Dialogue: 0,0:15:16.88,0:15:18.88,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}但是 银河巫师
Dialogue: 0,0:15:18.88,0:15:20.37,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}的效果召唤出来的{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:15:20.60,0:15:22.44,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}新银河眼的攻击力
Dialogue: 0,0:15:22.44,0:15:23.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}下降2000点。
Dialogue: 0,0:15:25.36,0:15:26.89,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}但是 这样足够了！
Dialogue: 0,0:15:26.89,0:15:29.09,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你的生命值 还剩300。
Dialogue: 0,0:15:32.17,0:15:34.62,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}用新银河眼 直接攻击！
Dialogue: 0,0:15:35.03,0:15:37.60,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}终极光子流！
Dialogue: 0,0:15:42.82,0:15:44.45,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这样一来就是哥哥赢了！
Dialogue: 0,0:15:44.81,0:15:45.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(小鸟)游马！
Dialogue: 0,0:15:45.75,0:15:48.46,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}永续陷阱 次元之门
Dialogue: 0,0:15:48.46,0:15:49.94,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}新的效果 发动！
Dialogue: 0,0:15:50.50,0:15:52.37,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}被直接攻击的时候
Dialogue: 0,0:15:52.37,0:15:54.08,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}把这张卡送去墓地{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:15:54.83,0:15:57.00,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将除外的怪兽的效果
Dialogue: 0,0:15:57.00,0:15:58.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}无效并特殊召唤！
Dialogue: 0,0:15:59.36,0:16:01.54,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}复活吧！ 希望皇！
Dialogue: 0,0:16:09.22,0:16:11.07,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}希望皇和新银河眼的
Dialogue: 0,0:16:11.07,0:16:11.85,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击力相同！
Dialogue: 0,0:16:12.36,0:16:13.66,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}因此同归于尽！
Dialogue: 0,0:16:23.32,0:16:24.48,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}上啊 游马！
Dialogue: 0,0:16:25.11,0:16:28.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}好嘞！ 看我狠狠燃一把！
Dialogue: 0,0:16:29.15,0:16:32.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}速攻魔法 超量双重回击 发动！
Dialogue: 0,0:16:33.18,0:16:35.23,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}1只怪兽超量被破坏{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:16:35.67,0:16:37.96,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}从场上怪兽消失的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:16:38.67,0:16:40.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}被破坏的1只怪兽超量与{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:16:41.24,0:16:43.77,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那只怪兽攻击力以下的1只怪兽{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:16:44.19,0:16:46.30,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}可以从墓地特殊召唤！
Dialogue: 0,0:16:46.69,0:16:47.22,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}什么!?
Dialogue: 0,0:16:48.56,0:16:49.62,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}2体 降临！
Dialogue: 0,0:16:50.28,0:16:51.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现身吧！
Dialogue: 0,0:16:52.19,0:16:53.61,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}希望皇霍普！
Dialogue: 0,0:16:54.42,0:16:55.77,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}希望皇 出击！
Dialogue: 0,0:17:09.54,0:17:10.69,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}太好了 游马！
Dialogue: 0,0:17:10.86,0:17:12.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马 好帅！
Dialogue: 0,0:17:12.82,0:17:13.89,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这下就定胜负了！
Dialogue: 0,0:17:14.32,0:17:14.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}快斗……
Dialogue: 0,0:17:15.64,0:17:18.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}好厉害！ 希望皇和希望皇·出击并排了！
Dialogue: 0,0:17:22.19,0:17:23.41,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这样一来就等下一回合了。
Dialogue: 0,0:17:23.93,0:17:25.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}啊啊 是我们的胜利！
Dialogue: 0,0:17:30.15,0:17:30.84,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}什么！？
Dialogue: 0,0:17:51.80,0:17:52.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那是！
Dialogue: 0,0:17:53.13,0:17:54.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}怎么会 不可能！
Dialogue: 0,0:17:55.72,0:17:57.51,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}超量·双重·翻倍！
Dialogue: 0,0:18:00.56,0:18:02.46,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你也和我用一样的卡！
Dialogue: 0,0:18:03.42,0:18:07.04,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}成功了 快斗大人！ 笨蛋殿下！
Dialogue: 0,0:18:07.17,0:18:09.61,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}比起热血沸腾 快斗沸腾才
Dialogue: 0,0:18:09.61,0:18:10.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}更加技高一筹呢！
Dialogue: 0,0:18:11.25,0:18:11.98,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}快斗……
Dialogue: 0,0:18:13.43,0:18:15.00,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马 星光体…… 呵。
Dialogue: 0,0:18:17.93,0:18:20.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}用银河眼和neo银河眼这2只
Dialogue: 0,0:18:20.90,0:18:22.79,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击希望皇·出击和希望皇！
Dialogue: 0,0:18:23.72,0:18:26.40,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}破灭的光子流！
Dialogue: 0,0:18:28.96,0:18:32.48,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}上吧，究极光子流！
Dialogue: 0,0:19:19.35,0:19:22.88,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}好痛……我输了。
Dialogue: 0,0:19:29.76,0:19:30.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}快斗……
Dialogue: 0,0:19:39.23,0:19:39.93,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}快斗……
Dialogue: 0,0:19:41.65,0:19:43.84,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}下次我一定要赢过你！
Dialogue: 0,0:19:44.76,0:19:46.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}多少次我都奉陪。
Dialogue: 0,0:19:47.18,0:19:47.95,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}多少次都行。
Dialogue: 0,0:19:52.65,0:19:54.23,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}啊，来吧！
Dialogue: 0,0:19:54.74,0:19:56.70,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}只要不放弃，一直飞奔下去{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:19:57.14,0:20:00.20,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}总有一天，说不定就能追上你呢。
Dialogue: 0,0:20:10.32,0:20:11.46,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(小鸟)游马！
Dialogue: 0,0:20:12.95,0:20:14.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(大家)游马！
Dialogue: 0,0:20:16.02,0:20:16.83,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}小鸟……
Dialogue: 0,0:20:20.48,0:20:21.14,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马？
Dialogue: 0,0:20:21.72,0:20:23.39,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马，游马！
Dialogue: 0,0:20:23.68,0:20:24.52,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}喂，游马！
Dialogue: 0,0:20:25.15,0:20:26.01,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(凯西)游马！
Dialogue: 0,0:20:26.56,0:20:27.24,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(德之助)游马！
Dialogue: 0,0:20:27.47,0:20:28.45,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(等{\fnNoto Sans CJK SC}々{\fnZCOOL KuaiLe}力)游马君！
Dialogue: 0,0:20:39.23,0:20:41.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哥哥 游马 谢谢你。
Dialogue: 0,0:20:48.22,0:20:49.76,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}干得漂亮啊。
Dialogue: 0,0:20:50.92,0:20:52.42,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马 再见了。
Dialogue: 0,0:21:00.57,0:21:02.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(鲨鱼)游马 星光体。
Dialogue: 0,0:21:06.71,0:21:09.40,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}游马 游马你也真是的 真是的…。
Dialogue: 0,0:21:09.90,0:21:11.19,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}熟睡中。
Dialogue: 0,0:21:14.83,0:21:15.94,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}说到底…。
Dialogue: 0,0:21:16.15,0:21:17.30,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}真像游马的风格。
Dialogue: 0,0:21:17.52,0:21:20.62,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我来代替给你膝枕！
Dialogue: 0,0:21:21.09,0:21:22.99,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}呐 星光体 游马他…。
Dialogue: 0,0:21:24.05,0:21:26.49,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我什么都做不了。
Dialogue: 0,0:21:27.41,0:21:29.34,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}超燃啊！
Dialogue: 0,0:21:31.92,0:21:32.77,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}没办法。
Dialogue: 0,0:21:33.28,0:21:35.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}暂时就让他这样吧。
Dialogue: 0,0:21:35.90,0:21:37.98,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}《观察结果 其21。
Dialogue: 0,0:21:39.24,0:21:42.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}令人心情舒畅的败北看来也是有的》
Dialogue: 0,0:23:26.27,0:23:28.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(多鲁贝)九十九游马 星光体。
Dialogue: 0,0:23:29.60,0:23:31.17,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这出乎我的意料。
Dialogue: 0,0:23:34.80,0:23:37.70,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}下次必须由我们出场了。
Dialogue: 0,0:23:41.62,0:23:44.75,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:45.45,0:23:48.88,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}

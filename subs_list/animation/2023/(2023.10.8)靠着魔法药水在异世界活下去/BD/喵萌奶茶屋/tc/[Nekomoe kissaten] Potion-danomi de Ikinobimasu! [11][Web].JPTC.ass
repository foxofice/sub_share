Dialogue: 0,0:23:35.40,0:23:39.86,Staff,,0,0,0,,{\fad(500,900)\blur2\3c&H2A1C1D&}本字幕由喵萌奶茶屋製作  僅供交流試看之用  請勿用於商業用途{\fscy60}\N\N{\fscy100}翻譯：雨後飄雪　後期：MIR
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,Dialogue
Dialogue: 0,0:00:01.04,0:00:03.20,Dial_JP,,0,0,0,,お姉ちゃん　起きて
Dialogue: 0,0:00:03.70,0:00:06.08,Dial_JP,,0,0,0,,カオルお姉ちゃんってば
Dialogue: 0,0:00:06.51,0:00:07.95,Dial_JP,,0,0,0,,レイエットちゃん
Dialogue: 0,0:00:07.95,0:00:09.74,Dial_JP,,0,0,0,,もうちょっと寝させて
Dialogue: 0,0:00:10.41,0:00:10.89,Dial_JP,,0,0,0,,さあ
Dialogue: 0,0:00:11.17,0:00:12.92,Dial_JP,,0,0,0,,今日もお弁当作りますよ
Dialogue: 0,0:00:13.31,0:00:16.60,Dial_JP,,0,0,0,,予約分50個　一般販売分50個
Dialogue: 0,0:00:17.54,0:00:18.56,Dial_JP,,0,0,0,,そうだった
Dialogue: 0,0:00:23.70,0:00:25.09,Dial_JP,,0,0,0,,急げ急げ
Dialogue: 0,0:00:25.28,0:00:27.06,Dial_JP,,0,0,0,,ベル　これ大匙2杯入れて
Dialogue: 0,0:00:27.06,0:00:27.51,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:00:27.51,0:00:28.78,Dial_JP,,0,0,0,,フランはこれ切っといて
Dialogue: 0,0:00:28.78,0:00:29.76,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:00:31.05,0:00:32.96,Dial_JP,,0,0,0,,この中から5種類詰めてね
Dialogue: 0,0:00:33.25,0:00:34.99,Dial_JP,,0,0,0,,バリエーションがあったほうがいいから
Dialogue: 0,0:00:35.29,0:00:36.27,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:00:43.13,0:00:44.23,Dial_JP,,0,0,0,,しんどっ
Dialogue: 0,0:00:44.54,0:00:48.00,Dial_JP,,0,0,0,,いっそポーション作成能力で一気に作ってしまえば…
Dialogue: 0,0:00:48.82,0:00:49.20,Dial_JP,,0,0,0,,よっ
Dialogue: 0,0:00:51.53,0:00:53.37,Dial_JP,,0,0,0,,いやいや　それは違う
Dialogue: 0,0:00:53.81,0:00:56.08,Dial_JP,,0,0,0,,私の矜持が許さん
Dialogue: 0,0:02:31.21,0:02:32.30,Dial_JP,,0,0,0,,いらっしゃいませ
Dialogue: 0,0:02:32.86,0:02:34.51,Dial_JP,,0,0,0,,いらっちゃいまちぇ
Dialogue: 0,0:02:34.51,0:02:35.89,Dial_JP,,0,0,0,,キューン
Dialogue: 0,0:02:36.88,0:02:39.61,Dial_JP,,0,0,0,,もう　義務感でやってるよね　それ
Dialogue: 0,0:02:49.08,0:02:50.39,Dial_JP,,900,0,0,,ありがとうございます
Dialogue: 0,0:02:49.08,0:02:49.64,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:02:49.43,0:02:50.60,Dial_JP,,0,900,0,,またお越しくださいね
Dialogue: 0,0:02:50.60,0:02:51.13,Dial_JP,,0,0,0,,いってらっしゃい
Dialogue: 0,0:02:51.13,0:02:52.11,Dial_JP,,0,0,0,,お仕事　頑張ってください
Dialogue: 0,0:02:52.11,0:02:53.24,Dial_JP,,0,0,0,,いっぱい食べてください
Dialogue: 0,0:03:04.93,0:03:08.17,Dial_JP,,0,0,0,,フラン弁は力任せでギュウギュウに詰め込まれているから
Dialogue: 0,0:03:08.17,0:03:09.63,Dial_JP,,0,0,0,,腹持ちがいいんだよな
Dialogue: 0,0:03:09.91,0:03:12.13,Dial_JP,,0,0,0,,私は断然ベル弁
Dialogue: 0,0:03:12.13,0:03:14.88,Dial_JP,,0,0,0,,揚げ物とかが入ってないから　ヘルシーなのよ
Dialogue: 0,0:03:15.29,0:03:16.50,Dial_JP,,0,0,0,,やっぱレイ弁だよ
Dialogue: 0,0:03:16.94,0:03:18.69,Dial_JP,,0,0,0,,レイ弁は可愛いだろう
Dialogue: 0,0:03:18.69,0:03:21.76,Dial_JP,,0,0,0,,娘が頑張って作ってくれたって感じがして
Dialogue: 0,0:03:21.96,0:03:24.56,Dial_JP,,0,0,0,,ってお前　娘や奥さんどころか
Dialogue: 0,0:03:24.56,0:03:25.91,Dial_JP,,0,0,0,,恋人もいねえじゃねえか
Dialogue: 0,0:03:25.91,0:03:27.03,Dial_JP,,0,0,0,,だからだよ
Dialogue: 0,0:03:27.41,0:03:29.03,Dial_JP,,0,0,0,,で　カオル弁は
Dialogue: 0,0:03:30.09,0:03:31.88,Dial_JP,,0,0,0,,カオル弁は　その…
Dialogue: 0,0:03:32.19,0:03:33.54,Dial_JP,,0,0,0,,なんていうか
Dialogue: 0,0:03:34.20,0:03:35.35,Dial_JP,,0,0,0,,普通
Dialogue: 0,0:03:37.79,0:03:40.66,Dial_JP,,0,0,0,,いや　おいしいわよ　もちろんおいしいから
Dialogue: 0,0:03:41.07,0:03:42.79,Dial_JP,,0,0,0,,俺　カオル弁にするわ
Dialogue: 0,0:03:43.51,0:03:46.20,Dial_JP,,0,0,0,,俺もたまにはカオル弁にしよっと
Dialogue: 0,0:03:46.20,0:03:48.83,Dial_JP,,0,0,0,,私もそろそろ薬草採りに行かないと
Dialogue: 0,0:03:49.33,0:03:50.51,Dial_JP,,0,0,0,,行ってきます
Dialogue: 0,0:03:51.53,0:03:56.59,Dial_JP,,0,0,0,,おかずもごはんもレシピ考えたのも私なのに
Dialogue: 0,0:04:01.42,0:04:03.20,Dial_JP,,0,0,0,,ポーション屋と言いつつ…
Dialogue: 0,0:04:04.08,0:04:07.81,Dial_JP,,0,0,0,,お弁当　化粧品　シャンプーにリンス
Dialogue: 0,0:04:08.31,0:04:10.56,Dial_JP,,0,0,0,,ガラス製品から陶磁器類やら
Dialogue: 0,0:04:11.03,0:04:13.17,Dial_JP,,0,0,0,,もはやなんでも屋状態だね
Dialogue: 0,0:04:13.60,0:04:15.44,Dial_JP,,0,0,0,,いっそのことコンビニにするか
Dialogue: 0,0:04:16.46,0:04:20.47,Dial_JP,,0,0,0,,ロランドに頼んで　お弁当のデリバリーサービスもありだな
Dialogue: 0,0:04:20.47,0:04:22.47,Dial_JP,,0,0,0,,ウーマーイーツです
Dialogue: 0,0:04:24.48,0:04:27.80,Dial_JP,,0,0,0,,またカオルがよからぬことを考えてる気がする
Dialogue: 0,0:04:29.75,0:04:30.41,Dial_JP,,0,0,0,,あら
Dialogue: 0,0:04:31.09,0:04:31.99,Dial_JP,,0,0,0,,カオルちゃん
Dialogue: 0,0:04:32.31,0:04:34.53,Dial_JP,,0,0,0,,熱冷ましとせき止めポーションって
Dialogue: 0,0:04:34.53,0:04:36.11,Dial_JP,,0,0,0,,在庫まだありますか
Dialogue: 0,0:04:36.49,0:04:37.15,Dial_JP,,0,0,0,,はい？
Dialogue: 0,0:04:37.73,0:04:38.78,Dial_JP,,0,0,0,,変だな
Dialogue: 0,0:04:39.00,0:04:41.21,Dial_JP,,0,0,0,,昨日棚に補充したばかりなのに
Dialogue: 0,0:04:41.67,0:04:43.69,Dial_JP,,0,0,0,,風邪でも流行ってるのかな
Dialogue: 0,0:04:45.32,0:04:46.81,Dial_JP,,0,0,0,,お掃除終わったよ
Dialogue: 0,0:04:47.46,0:04:48.57,Dial_JP,,0,0,0,,ご苦労
Dialogue: 0,0:04:48.96,0:04:51.25,Dial_JP,,0,0,0,,よし　お客さんも途切れたし
Dialogue: 0,0:04:53.34,0:04:55.22,Dial_JP,,0,0,0,,軍に納入に行ってきますね
Dialogue: 0,0:04:55.72,0:04:57.06,Dial_JP,,0,0,0,,行こう　レイエットちゃん
Dialogue: 0,0:04:57.40,0:04:58.45,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:04:59.01,0:05:00.17,Dial_JP,,0,0,0,,いってらっしゃい
Dialogue: 0,0:05:03.74,0:05:04.88,Dial_JP,,0,0,0,,護衛してきます
Dialogue: 0,0:05:05.76,0:05:07.48,Dial_JP,,0,0,0,,って　俺だけ店番
Dialogue: 0,0:05:10.07,0:05:11.75,Dial_JP,,0,0,0,,いつもありがとうね
Dialogue: 0,0:05:12.02,0:05:13.96,Dial_JP,,0,0,0,,礼を言うのはこっちだよ
Dialogue: 0,0:05:14.29,0:05:15.32,Dial_JP,,0,0,0,,こっちだよ
Dialogue: 0,0:05:16.77,0:05:18.29,Dial_JP,,0,0,0,,それにしても
Dialogue: 0,0:05:19.56,0:05:23.46,Dial_JP,,0,0,0,,いいんだよ　少しくらいロランドとイチャイチャしてても
Dialogue: 0,0:05:26.50,0:05:27.33,Dial_JP,,0,0,0,,そうだ
Dialogue: 0,0:05:27.67,0:05:29.99,Dial_JP,,0,0,0,,ねえみんな　風邪とか引いてない
Dialogue: 0,0:05:30.41,0:05:31.05,Dial_JP,,0,0,0,,風邪
Dialogue: 0,0:05:31.55,0:05:32.53,Dial_JP,,0,0,0,,全然
Dialogue: 0,0:05:32.72,0:05:34.40,Dial_JP,,0,0,0,,むしろ元気いっぱいだよ
Dialogue: 0,0:05:34.64,0:05:35.01,Dial_JP,,0,0,0,,なあ
Dialogue: 0,0:05:35.42,0:05:36.05,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:05:37.07,0:05:40.51,Dial_JP,,0,0,0,,エミール兄ちゃんが食べ物いっぱい届けてくれるからさ
Dialogue: 0,0:05:40.86,0:05:43.53,Dial_JP,,0,0,0,,ベル姉ちゃんがおさげに結ってくれたの
Dialogue: 0,0:05:43.96,0:05:47.54,Dial_JP,,0,0,0,,一人前になるためにって勉強も教えてくれるんだよ
Dialogue: 0,0:05:50.08,0:05:52.31,Dial_JP,,0,0,0,,ハンターとしての仕事の合間に
Dialogue: 0,0:05:52.31,0:05:53.84,Dial_JP,,0,0,0,,そんなことしてたんだ
Dialogue: 0,0:06:02.28,0:06:03.26,Dial_JP,,0,0,0,,毎度あり
Dialogue: 0,0:06:03.81,0:06:05.04,Dial_JP,,0,0,0,,またね
Dialogue: 0,0:06:05.70,0:06:08.37,Dial_JP,,0,0,0,,相手の失礼には失礼の十倍返し
Dialogue: 0,0:06:08.68,0:06:11.72,Dial_JP,,0,0,0,,相手の失礼には失礼の十倍返し
Dialogue: 0,0:06:11.94,0:06:14.45,Dial_JP2,,0,0,0,,「あのね　ここだけの話だけど」
Dialogue: 0,0:06:14.45,0:06:18.49,Dial_JP2,,0,0,0,,って誰かの秘密をペラペラしゃべる人を信用するな
Dialogue: 0,0:06:17.70,0:06:20.43,Dial_JP,,0,0,0,,いや　ほんと心強いよ
Dialogue: 0,0:06:21.99,0:06:24.65,Dial_JP,,0,0,0,,大隊長殿　薬屋の姉妹が来ました
Dialogue: 0,0:06:25.33,0:06:26.00,Dial_JP,,0,0,0,,通せ
Dialogue: 0,0:06:29.24,0:06:30.74,Dial_JP,,0,0,0,,お取り込み中でしたか
Dialogue: 0,0:06:31.07,0:06:32.53,Dial_JP,,0,0,0,,終わるまで待ちましょうか
Dialogue: 0,0:06:32.89,0:06:34.83,Dial_JP,,0,0,0,,いや　もう済んだところだ
Dialogue: 0,0:06:35.50,0:06:36.66,Dial_JP,,0,0,0,,紹介しておこう
Dialogue: 0,0:06:37.70,0:06:39.88,Dial_JP,,0,0,0,,中隊長のラルスリックだ
Dialogue: 0,0:06:40.41,0:06:42.28,Dial_JP,,0,0,0,,こっちは例の薬屋の姉妹
Dialogue: 0,0:06:42.88,0:06:43.62,Dial_JP,,0,0,0,,どうも
Dialogue: 0,0:06:44.25,0:06:45.53,Dial_JP,,0,0,0,,こちらに置きますね
Dialogue: 0,0:06:46.21,0:06:47.36,Dial_JP,,0,0,0,,聞いたぞ
Dialogue: 0,0:06:47.69,0:06:50.35,Dial_JP,,0,0,0,,ちょっかいを出してきた貴族を遣り込めたとか
Dialogue: 0,0:06:50.64,0:06:54.12,Dial_JP,,0,0,0,,まあ　纏わり付く羽虫を払った程度ですけど
Dialogue: 0,0:06:54.49,0:06:55.35,Dial_JP,,0,0,0,,それより
Dialogue: 0,0:06:56.32,0:06:56.87,Dial_JP,,0,0,0,,どうした
Dialogue: 0,0:06:57.41,0:06:58.51,Dial_JP,,0,0,0,,治療薬
Dialogue: 0,0:06:58.74,0:07:02.11,Dial_JP,,0,0,0,,近衛軍と王都警備兵には回っていなかったそうですね
Dialogue: 0,0:07:03.56,0:07:05.07,Dial_JP,,0,0,0,,どうしてあいつらに関係が
Dialogue: 0,0:07:05.73,0:07:06.29,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:07:06.85,0:07:09.26,Dial_JP,,0,0,0,,一体何を言っているのだ
Dialogue: 0,0:07:10.45,0:07:12.50,Dial_JP,,0,0,0,,まったく悪気はなかった
Dialogue: 0,0:07:13.22,0:07:16.51,Dial_JP,,0,0,0,,ってことは　私の無知が原因か
Dialogue: 0,0:07:17.48,0:07:18.67,Dial_JP,,0,0,0,,反省
Dialogue: 0,0:07:21.95,0:07:23.07,Dial_JP,,0,0,0,,この書類
Dialogue: 0,0:07:25.87,0:07:27.51,Dial_JP,,0,0,0,,横流しですか
Dialogue: 0,0:07:29.89,0:07:32.09,Dial_JP,,0,0,0,,国の予算でうちの薬を買って
Dialogue: 0,0:07:32.09,0:07:34.47,Dial_JP,,0,0,0,,それを安く売って儲けていたなんて
Dialogue: 0,0:07:34.47,0:07:37.31,Dial_JP,,0,0,0,,しかもそんな横領行為を隠しもしないで
Dialogue: 0,0:07:37.31,0:07:39.18,Dial_JP,,0,0,0,,私の目の前で堂々と
Dialogue: 0,0:07:39.18,0:07:40.52,Dial_JP,,0,0,0,,ふざけてるんですか
Dialogue: 0,0:07:41.99,0:07:44.07,Dial_JP,,0,0,0,,お取り引きはこれまでということで
Dialogue: 0,0:07:44.07,0:07:46.15,Dial_JP,,0,0,0,,待て　待て待て待て
Dialogue: 0,0:07:46.59,0:07:48.78,Dial_JP,,0,0,0,,急に何を怒っているの
Dialogue: 0,0:07:49.46,0:07:51.07,Dial_JP,,0,0,0,,この書類はなんですか
Dialogue: 0,0:07:51.83,0:07:55.04,Dial_JP,,0,0,0,,上級軍人病治療薬　小金貨2枚
Dialogue: 0,0:07:55.21,0:07:57.77,Dial_JP,,0,0,0,,コショウ10グラム小金貨3枚って
Dialogue: 0,0:07:59.86,0:08:01.04,Dial_JP,,0,0,0,,読めるのか
Dialogue: 0,0:08:01.29,0:08:04.05,Dial_JP,,0,0,0,,この国の言葉くらい　読み書きできますよ
Dialogue: 0,0:08:04.56,0:08:04.93,Dial_JP,,0,0,0,,いや
Dialogue: 0,0:08:05.09,0:08:06.44,Dial_JP,,0,0,0,,私が聞いているのは
Dialogue: 0,0:08:06.93,0:08:11.30,Dial_JP,,0,0,0,,軍需物資を横領している一味の連絡場所と思しき場所で押収した
Dialogue: 0,0:08:11.62,0:08:14.86,Dial_JP,,0,0,0,,この暗号で書かれた文書が読めるのかという意味だ
Dialogue: 0,0:08:21.64,0:08:22.57,Dial_JP,,0,0,0,,もしや
Dialogue: 0,0:08:23.02,0:08:26.65,Dial_JP,,0,0,0,,「この世界のあらゆる言語の会話と読み書きの能力」
Dialogue: 0,0:08:26.97,0:08:29.53,Dial_JP,,0,0,0,,暗号も含まれてたのか
Dialogue: 0,0:08:30.10,0:08:31.88,Dial_JP,,0,0,0,,今のはなかったことに
Dialogue: 0,0:08:31.88,0:08:33.07,Dial_JP,,0,0,0,,できるか
Dialogue: 0,0:08:33.07,0:08:34.54,Dial_JP,,0,0,0,,ですよね
Dialogue: 0,0:08:34.76,0:08:36.05,Dial_JP,,0,0,0,,どういうことだ
Dialogue: 0,0:08:36.05,0:08:38.86,Dial_JP,,0,0,0,,なぜお前に横流し一味の暗号が読める
Dialogue: 0,0:08:39.18,0:08:39.96,Dial_JP,,0,0,0,,まずい
Dialogue: 0,0:08:40.59,0:08:42.76,Dial_JP,,0,0,0,,いや　疑っているわけではない
Dialogue: 0,0:08:43.15,0:08:44.49,Dial_JP,,0,0,0,,一味と通じているなら
Dialogue: 0,0:08:44.49,0:08:45.91,Dial_JP,,0,0,0,,よほどのバカではない限り
Dialogue: 0,0:08:45.91,0:08:47.87,Dial_JP,,0,0,0,,わざわざ読んでみせる意味がない
Dialogue: 0,0:08:48.31,0:08:49.35,Dial_JP,,0,0,0,,お前がバカではない…
Dialogue: 0,0:08:49.60,0:08:51.74,Dial_JP,,0,0,0,,それほどバカではないことは分かっている
Dialogue: 0,0:08:51.74,0:08:53.63,Dial_JP,,0,0,0,,なんでそこ言い直したんですか
Dialogue: 0,0:08:55.01,0:08:55.61,Dial_JP,,0,0,0,,まあ
Dialogue: 0,0:08:55.85,0:08:58.93,Dial_JP,,0,0,0,,子供騙しのごく簡単な暗号ですから
Dialogue: 0,0:08:58.93,0:09:00.31,Dial_JP,,0,0,0,,一目で分かりますよ
Dialogue: 0,0:09:00.47,0:09:01.26,Dial_JP,,0,0,0,,誰にでも
Dialogue: 0,0:09:01.59,0:09:02.15,Dial_JP,,0,0,0,,えと
Dialogue: 0,0:09:02.38,0:09:05.24,Dial_JP2,,0,0,0,,文章を縦読みして最初に当たる数字が4ですよね
Dialogue: 0,0:09:05.49,0:09:08.23,Dial_JP2,,0,0,0,,だからすべての文字を4つ後ろの文字に変換します
Dialogue: 0,0:09:08.23,0:09:11.05,Dial_JP2,,0,0,0,,で　縦読みで当たる2つ目の数字が3なので
Dialogue: 0,0:09:11.05,0:09:13.84,Dial_JP2,,0,0,0,,3文字ずつ飛ばして文字を拾い　並べます
Dialogue: 0,0:09:04.65,0:09:05.81,Dial_JP,,0,0,0,,おい　メモをとれ
Dialogue: 0,0:09:06.56,0:09:06.91,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:09:14.84,0:09:16.45,Dial_JP,,0,0,0,,というわけですよ
Dialogue: 0,0:09:17.32,0:09:17.75,Dial_JP,,0,0,0,,で
Dialogue: 0,0:09:18.06,0:09:22.19,Dial_JP,,0,0,0,,そのとんでもなく手間がかかる変換作業を一瞬のうちに終えたわけか
Dialogue: 0,0:09:22.44,0:09:23.58,Dial_JP,,0,0,0,,頭の中だけで
Dialogue: 0,0:09:25.09,0:09:26.58,Dial_JP,,0,0,0,,この程度のことに
Dialogue: 0,0:09:26.58,0:09:28.96,Dial_JP,,0,0,0,,わざわざメモをとる必要があるんですか
Dialogue: 0,0:09:29.98,0:09:32.22,Dial_JP,,0,0,0,,とんでもない厨二病ゼリフだ
Dialogue: 0,0:09:34.90,0:09:36.72,Dial_JP,,0,0,0,,先日のことといい
Dialogue: 0,0:09:37.43,0:09:39.23,Dial_JP,,0,0,0,,とても人間技とは思えん
Dialogue: 0,0:09:39.57,0:09:41.21,Dial_JP,,0,0,0,,ヤバい　ヤバいよ
Dialogue: 0,0:09:41.53,0:09:45.83,Dial_JP,,0,0,0,,この流れはいつもの女神だ　御使いだって騒ぎになるパターンだよ
Dialogue: 0,0:09:46.16,0:09:46.95,Dial_JP,,0,0,0,,お前
Dialogue: 0,0:09:46.95,0:09:47.71,Dial_JP,,0,0,0,,ほら来た
Dialogue: 0,0:09:49.39,0:09:50.72,Dial_JP,,0,0,0,,軍に入らないか
Dialogue: 0,0:09:53.34,0:09:55.77,Dial_JP,,0,0,0,,今なら情報将校として　少尉…
Dialogue: 0,0:09:55.77,0:09:58.08,Dial_JP,,0,0,0,,いや　中尉として採用してやるぞ
Dialogue: 0,0:09:59.19,0:10:00.07,Dial_JP,,0,0,0,,中尉
Dialogue: 0,0:10:00.44,0:10:02.62,Dial_JP,,0,0,0,,いきなり幹部とは好待遇
Dialogue: 0,0:10:03.00,0:10:05.16,Dial_JP,,0,0,0,,って　入るか
Dialogue: 0,0:10:05.71,0:10:07.35,Dial_JP,,0,0,0,,悪い話ではないだろう
Dialogue: 0,0:10:07.61,0:10:09.56,Dial_JP,,0,0,0,,薬作れなくなりますよ
Dialogue: 0,0:10:09.85,0:10:10.75,Dial_JP,,0,0,0,,問題ない
Dialogue: 0,0:10:10.75,0:10:12.14,Dial_JP,,0,0,0,,副業として認めよう
Dialogue: 0,0:10:12.14,0:10:13.93,Dial_JP,,0,0,0,,いや　困ります
Dialogue: 0,0:10:17.06,0:10:19.54,Dial_JP,,0,0,0,,なんとか勧誘を振り切ってきた
Dialogue: 0,0:10:20.26,0:10:23.10,Dial_JP,,0,0,0,,しばらくはバレないように気をつけないと
Dialogue: 0,0:10:23.50,0:10:26.70,Dial_JP,,0,0,0,,ポーションもこれまで以上に慎重に作るべきだな
Dialogue: 0,0:10:28.54,0:10:29.89,Dial_JP,,0,0,0,,いらっしゃいませ
Dialogue: 0,0:10:30.25,0:10:31.88,Dial_JP,,0,0,0,,いらっちゃいまちぇ
Dialogue: 0,0:10:32.06,0:10:35.67,Dial_JP,,0,0,0,,うん　もう少しで伝統芸能に指定されるよ　それ
Dialogue: 0,0:10:36.71,0:10:39.55,Dial_JP,,0,0,0,,あれ　先ほどの中隊長さん
Dialogue: 0,0:10:40.57,0:10:42.82,Dial_JP,,0,0,0,,実は内密の頼みでな
Dialogue: 0,0:10:43.43,0:10:45.48,Dial_JP,,0,0,0,,我が屋敷に来てはもらえぬか
Dialogue: 0,0:10:47.38,0:10:48.99,Dial_JP,,0,0,0,,内密の頼み
Dialogue: 0,0:10:50.23,0:10:51.43,Dial_JP,,0,0,0,,怪しい
Dialogue: 0,0:10:52.24,0:10:52.87,Dial_JP,,0,0,0,,でも…
Dialogue: 0,0:10:53.51,0:10:56.30,Dial_JP,,0,0,0,,出張料金　小金貨1枚です
Dialogue: 0,0:10:56.96,0:10:58.38,Dial_JP,,0,0,0,,なんか面白そう
Dialogue: 0,0:11:00.16,0:11:02.06,Dial_JP,,0,0,0,,もしやこの中隊長さんが
Dialogue: 0,0:11:02.45,0:11:04.06,Dial_JP,,0,0,0,,横流しの一味で
Dialogue: 0,0:11:04.06,0:11:06.80,Dial_JP,,0,0,0,,暗号が読める私を始末しに来たんじゃ
Dialogue: 0,0:11:06.80,0:11:08.06,Dial_JP,,0,0,0,,と思ったけど
Dialogue: 0,0:11:08.06,0:11:10.29,Dial_JP,,0,0,0,,そういう雰囲気でもなさそうだね
Dialogue: 0,0:11:11.06,0:11:13.27,Dial_JP,,0,0,0,,まあ　万一何かあったとしても
Dialogue: 0,0:11:14.32,0:11:16.50,Dial_JP,,0,0,0,,いつでも飛び出してくるはずだし
Dialogue: 0,0:11:16.92,0:11:19.58,Dial_JP,,0,0,0,,って　フランの護衛って何時から何時
Dialogue: 0,0:11:20.14,0:11:21.11,Dial_JP,,0,0,0,,年中無休？
Dialogue: 0,0:11:21.47,0:11:23.58,Dial_JP,,0,0,0,,どこのブラック企業だよ
Dialogue: 0,0:11:24.26,0:11:25.10,Dial_JP,,0,0,0,,到着した
Dialogue: 0,0:11:31.60,0:11:33.77,Dial_JP,,0,0,0,,お帰りなさいませ　旦那様
Dialogue: 0,0:11:35.05,0:11:38.63,Dial_JP,,0,0,0,,あの　中隊長さんってご当主様なんですか
Dialogue: 0,0:11:39.68,0:11:40.89,Dial_JP,,0,0,0,,ああ　そうだ
Dialogue: 0,0:11:41.73,0:11:44.26,Dial_JP,,0,0,0,,私はセーヴォス・フォン・ラルスリック
Dialogue: 0,0:11:44.75,0:11:46.35,Dial_JP,,0,0,0,,ラルスリック子爵だ
Dialogue: 0,0:11:48.29,0:11:51.80,Dial_JP,,0,0,0,,爵位を継いだ現役の貴族家当主様
Dialogue: 0,0:11:52.88,0:11:53.81,Dial_JP,,0,0,0,,でも
Dialogue: 0,0:11:55.03,0:11:57.11,Dial_JP,,0,0,0,,調度品はかなり古いよね
Dialogue: 0,0:11:57.61,0:12:00.62,Dial_JP,,0,0,0,,あまり裕福というわけではないのかな
Dialogue: 0,0:12:01.33,0:12:02.79,Dial_JP,,0,0,0,,お茶をお持ちしました
Dialogue: 0,0:12:03.60,0:12:04.17,Dial_JP,,0,0,0,,どうぞ
Dialogue: 0,0:12:05.46,0:12:06.91,Dial_JP,,0,0,0,,いただきます
Dialogue: 0,0:12:09.19,0:12:10.47,Dial_JP,,0,0,0,,おいしい
Dialogue: 0,0:12:10.98,0:12:12.55,Dial_JP,,0,0,0,,おかわりもございますので
Dialogue: 0,0:12:12.89,0:12:14.15,Dial_JP,,0,0,0,,ありがとうございます
Dialogue: 0,0:12:14.83,0:12:15.31,Dial_JP,,0,0,0,,では
Dialogue: 0,0:12:18.78,0:12:21.26,Dial_JP,,0,0,0,,実は頼みたいことというのは…
Dialogue: 0,0:12:22.37,0:12:23.11,Dial_JP,,0,0,0,,来たね
Dialogue: 0,0:12:24.52,0:12:26.59,Dial_JP,,0,0,0,,宝の在処を探してほしい
Dialogue: 0,0:12:30.67,0:12:32.57,Dial_JP,,0,0,0,,宝探し？
Dialogue: 0,0:12:36.12,0:12:37.78,Dial_JP,,0,0,0,,宝探しって…
Dialogue: 0,0:12:38.15,0:12:41.04,Dial_JP,,0,0,0,,どんな深刻な頼み事かと思いきや
Dialogue: 0,0:12:41.79,0:12:45.91,Dial_JP,,0,0,0,,我がラルスリック家にとっては極めて深刻なことなのだ
Dialogue: 0,0:12:46.91,0:12:50.79,Dial_JP,,0,0,0,,ここ数年ラルスリック家領地は不作が続いている
Dialogue: 0,0:12:51.41,0:12:53.19,Dial_JP,,0,0,0,,なんとか遣り繰りしてきたが
Dialogue: 0,0:12:53.55,0:12:57.55,Dial_JP,,0,0,0,,現実として金庫も備蓄倉庫もほぼ空っぽの状態だ
Dialogue: 0,0:12:58.09,0:12:59.71,Dial_JP,,0,0,0,,もし何かあれば
Dialogue: 0,0:13:01.25,0:13:03.05,Dial_JP,,0,0,0,,致命傷になりかねない
Dialogue: 0,0:13:03.67,0:13:05.71,Dial_JP,,0,0,0,,やっぱり自転車操業なんだ
Dialogue: 0,0:13:06.27,0:13:09.77,Dial_JP,,0,0,0,,普通であればどこかの大貴族から借金をして
Dialogue: 0,0:13:10.08,0:13:13.31,Dial_JP,,0,0,0,,子爵家の名を貶めることを受け入れるしかないだろう
Dialogue: 0,0:13:13.61,0:13:14.97,Dial_JP,,0,0,0,,「普通であれば」？
Dialogue: 0,0:13:15.75,0:13:18.31,Dial_JP,,0,0,0,,実は我が家には隠し財産がある
Dialogue: 0,0:13:18.76,0:13:20.82,Dial_JP,,0,0,0,,いや　あるはずなのだ
Dialogue: 0,0:13:22.08,0:13:23.57,Dial_JP,,0,0,0,,何代も前の時代
Dialogue: 0,0:13:23.88,0:13:26.33,Dial_JP,,0,0,0,,無人の大型船が領地に漂着した
Dialogue: 0,0:13:27.05,0:13:31.33,Dial_JP,,0,0,0,,その船には手付かずの大量の金貨や宝石が積まれていたという
Dialogue: 0,0:13:31.82,0:13:34.56,Dial_JP,,0,0,0,,当時　今と同じく不作が続き
Dialogue: 0,0:13:34.56,0:13:36.69,Dial_JP,,0,0,0,,危機を迎えていた我が先祖は
Dialogue: 0,0:13:36.69,0:13:40.46,Dial_JP,,0,0,0,,それを換金し　一部を使って危機を乗り越えた
Dialogue: 0,0:13:41.23,0:13:43.04,Dial_JP,,0,0,0,,残りの金貨の在処は
Dialogue: 0,0:13:43.04,0:13:45.63,Dial_JP,,0,0,0,,代々当主に口伝でもって伝えられた
Dialogue: 0,0:13:46.21,0:13:50.73,Dial_JP,,0,0,0,,ところが　3代前の当主が事故で亡くなってしまったのだ
Dialogue: 0,0:13:51.24,0:13:53.73,Dial_JP,,0,0,0,,残っているのはこの文書のみ
Dialogue: 0,0:13:54.28,0:13:56.17,Dial_JP,,0,0,0,,頼む　解読してくれ
Dialogue: 0,0:13:56.86,0:13:57.84,Dial_JP,,0,0,0,,なるほど
Dialogue: 0,0:13:58.21,0:14:00.58,Dial_JP,,0,0,0,,暗号で隠し場所が書いてあるわけか
Dialogue: 0,0:14:01.04,0:14:01.46,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:14:01.69,0:14:04.24,Dial_JP,,0,0,0,,万が一のためのバックアップは必要だよね
Dialogue: 0,0:14:04.90,0:14:06.70,Dial_JP,,0,0,0,,それをあの課長め
Dialogue: 0,0:14:06.70,0:14:09.19,Dial_JP,,0,0,0,,3か月もバックアップを取り忘れて
Dialogue: 0,0:14:10.06,0:14:11.13,Dial_JP,,0,0,0,,ぐぬぬ
Dialogue: 0,0:14:11.13,0:14:12.75,Dial_JP,,0,0,0,,誰がその尻拭いを
Dialogue: 0,0:14:13.27,0:14:14.50,Dial_JP,,0,0,0,,どうかしたか
Dialogue: 0,0:14:15.90,0:14:17.11,Dial_JP,,0,0,0,,いえ　ちょっと
Dialogue: 0,0:14:17.77,0:14:19.57,Dial_JP,,0,0,0,,では解読してみますね
Dialogue: 0,0:14:20.06,0:14:22.20,Dial_JP,,0,0,0,,ラルスリック領の危機に際して
Dialogue: 0,0:14:22.43,0:14:25.42,Dial_JP,,0,0,0,,万策尽き　他に手段なき場合にのみ
Dialogue: 0,0:14:25.42,0:14:27.30,Dial_JP,,0,0,0,,伝えし財貨を用いるべし
Dialogue: 0,0:14:27.54,0:14:29.27,Dial_JP,,0,0,0,,コーレクス・フォン・ラルスリック
Dialogue: 0,0:14:29.67,0:14:31.30,Dial_JP,,0,0,0,,って分かるか
Dialogue: 0,0:14:35.66,0:14:37.67,Dial_JP,,0,0,0,,分かりませんわよ　オホホホホ
Dialogue: 0,0:14:37.91,0:14:39.12,Dial_JP,,0,0,0,,って　気持ち悪いわ
Dialogue: 0,0:14:40.73,0:14:42.21,Dial_JP,,0,0,0,,では失礼します
Dialogue: 0,0:14:44.87,0:14:47.82,Dial_JP,,0,0,0,,こんなの暗号でもなんでもないじゃありませんか
Dialogue: 0,0:14:47.82,0:14:50.54,Dial_JP,,0,0,0,,これでどうやって宝の在処を探せと
Dialogue: 0,0:14:51.68,0:14:55.10,Dial_JP,,0,0,0,,文章から書いた者の意図を読み取れるのではないのか
Dialogue: 0,0:14:55.59,0:14:58.03,Dial_JP,,0,0,0,,私は超能力者とは違います
Dialogue: 0,0:14:58.33,0:15:01.87,Dial_JP,,0,0,0,,書いた人の残留思念とか読み取ったりできるわけじゃありません
Dialogue: 0,0:15:02.33,0:15:03.01,Dial_JP,,0,0,0,,だから
Dialogue: 0,0:15:03.35,0:15:06.04,Dial_JP,,0,0,0,,「ぶぶ漬けでもどうどす」と言われたら
Dialogue: 0,0:15:06.25,0:15:09.38,Dial_JP,,0,0,0,,「お茶漬けでもお食べになりませんか」とは聞こえても
Dialogue: 0,0:15:09.38,0:15:13.31,Dial_JP,,0,0,0,,「さっさと帰れや長居しやがって」とは聞こえませんよ
Dialogue: 0,0:15:15.07,0:15:16.62,Dial_JP,,0,0,0,,分からぬか
Dialogue: 0,0:15:18.27,0:15:21.82,Dial_JP,,0,0,0,,要は財貨の隠し場所が分かればいいんですよね
Dialogue: 0,0:15:21.98,0:15:23.21,Dial_JP,,0,0,0,,その通りだ
Dialogue: 0,0:15:23.54,0:15:25.87,Dial_JP,,0,0,0,,しかし　祖父も父も私も
Dialogue: 0,0:15:26.11,0:15:29.33,Dial_JP,,0,0,0,,探しに探したが手がかりさえ見つけられなかった
Dialogue: 0,0:15:29.86,0:15:32.26,Dial_JP,,0,0,0,,国境近くの領地邸は危険だからと
Dialogue: 0,0:15:32.54,0:15:36.38,Dial_JP,,0,0,0,,この王都邸に運び込まれたことだけは間違いないのだが
Dialogue: 0,0:15:39.08,0:15:44.26,Dial_JP,,0,0,0,,超高性能で超小型の金探知機型容器に入った回復ポーション　出ろ
Dialogue: 0,0:15:46.34,0:15:48.94,Dial_JP,,0,0,0,,金探知機
Dialogue: 0,0:15:50.55,0:15:51.48,Dial_JP,,0,0,0,,それは
Dialogue: 0,0:15:51.78,0:15:55.73,Dial_JP,,0,0,0,,近くにある金を探知して　その場所を指し示す機械です
Dialogue: 0,0:15:57.51,0:16:01.35,Dial_JP,,0,0,0,,ちゃんと精錬された高純度の金でないと反応しませんよ
Dialogue: 0,0:16:01.67,0:16:03.52,Dial_JP,,0,0,0,,探知可能距離も短いから
Dialogue: 0,0:16:03.52,0:16:05.86,Dial_JP,,0,0,0,,鉱脈探しとかには使えなくて
Dialogue: 0,0:16:06.06,0:16:06.95,Dial_JP,,0,0,0,,ん？
Dialogue: 0,0:16:07.79,0:16:09.24,Dial_JP,,0,0,0,,とりあえずやってみますね
Dialogue: 0,0:16:09.63,0:16:12.43,Dial_JP,,0,0,0,,えーと　このボタンを押して　と
Dialogue: 0,0:16:15.28,0:16:16.24,Dial_JP,,0,0,0,,こちらです
Dialogue: 0,0:16:18.88,0:16:21.90,Dial_JP,,0,0,0,,中隊長さんのお財布に反応しちゃった
Dialogue: 0,0:16:22.20,0:16:23.38,Dial_JP,,0,0,0,,設定変更
Dialogue: 0,0:16:23.38,0:16:26.33,Dial_JP,,0,0,0,,捜索対象は金の量300グラム以上
Dialogue: 0,0:16:30.23,0:16:31.36,Dial_JP,,0,0,0,,上の部屋です
Dialogue: 0,0:16:32.67,0:16:33.58,Dial_JP,,0,0,0,,レイエットちゃん
Dialogue: 0,0:16:33.58,0:16:34.76,Dial_JP,,0,0,0,,いい子で待ってて
Dialogue: 0,0:16:34.98,0:16:36.03,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:16:40.43,0:16:41.10,Dial_JP,,0,0,0,,こっちです
Dialogue: 0,0:16:44.03,0:16:44.71,Dial_JP,,0,0,0,,ここです
Dialogue: 0,0:16:45.70,0:16:47.06,Dial_JP,,0,0,0,,宝物庫？
Dialogue: 0,0:16:53.60,0:16:54.67,Dial_JP,,0,0,0,,えと…
Dialogue: 0,0:16:55.31,0:16:58.73,Dial_JP,,0,0,0,,高値で売れそうなものはあらかた売ってしまったよ
Dialogue: 0,0:16:58.99,0:17:00.43,Dial_JP,,0,0,0,,みたいですね
Dialogue: 0,0:17:01.55,0:17:03.81,Dial_JP,,0,0,0,,一応開けてもらってもいいですか
Dialogue: 0,0:17:04.47,0:17:05.03,Dial_JP,,0,0,0,,ああ
Dialogue: 0,0:17:09.21,0:17:12.08,Dial_JP,,0,0,0,,これが当家の最後の資金だ
Dialogue: 0,0:17:12.95,0:17:14.99,Dial_JP,,0,0,0,,ちょっと待ってくださいね
Dialogue: 0,0:17:15.35,0:17:18.36,Dial_JP,,0,0,0,,えっと…この金庫を対象外にして
Dialogue: 0,0:17:22.58,0:17:25.98,Dial_JP,,0,0,0,,はい　探知圏内対象なしですね
Dialogue: 0,0:17:26.50,0:17:27.88,Dial_JP,,0,0,0,,ありがとうございました
Dialogue: 0,0:17:33.29,0:17:34.56,Dial_JP,,0,0,0,,残念だけど
Dialogue: 0,0:17:34.56,0:17:37.63,Dial_JP,,0,0,0,,この屋敷には金塊や金貨の山はなさそう
Dialogue: 0,0:17:39.65,0:17:40.85,Dial_JP,,0,0,0,,って　ちょっと待った
Dialogue: 0,0:17:41.18,0:17:44.94,Dial_JP,,0,0,0,,さっき私　金の量を300グラム以上に設定したよね
Dialogue: 0,0:17:45.52,0:17:47.49,Dial_JP,,0,0,0,,金貨1枚　10グラムもない
Dialogue: 0,0:17:47.83,0:17:52.52,Dial_JP,,0,0,0,,ってことは　そこにあるのはせいぜい150グラム程度
Dialogue: 0,0:17:52.89,0:17:54.85,Dial_JP,,0,0,0,,探知機が反応するはずがない
Dialogue: 0,0:17:55.21,0:17:56.22,Dial_JP,,0,0,0,,ってことは
Dialogue: 0,0:17:56.82,0:17:58.61,Dial_JP,,0,0,0,,探知対象500グラム
Dialogue: 0,0:18:03.03,0:18:04.07,Dial_JP,,0,0,0,,そうか
Dialogue: 0,0:18:05.89,0:18:06.51,Dial_JP,,0,0,0,,どうした
Dialogue: 0,0:18:11.49,0:18:13.06,Dial_JP,,0,0,0,,隠し場所が分かりました
Dialogue: 0,0:18:13.35,0:18:14.31,Dial_JP,,0,0,0,,ズバリ　ここ
Dialogue: 0,0:18:14.84,0:18:16.87,Dial_JP,,0,0,0,,金庫が置かれた壁の中です
Dialogue: 0,0:18:17.03,0:18:18.68,Dial_JP,,0,0,0,,まさかそんなところに…
Dialogue: 0,0:18:19.25,0:18:21.74,Dial_JP,,0,0,0,,と思えるからこそ　ありえるのか
Dialogue: 0,0:18:22.15,0:18:23.91,Dial_JP,,0,0,0,,さあ　壁を剥がしましょう
Dialogue: 0,0:18:24.92,0:18:25.26,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:18:36.17,0:18:36.81,Dial_JP,,0,0,0,,おや
Dialogue: 0,0:18:40.73,0:18:42.64,Dial_JP,,0,0,0,,では　私はこのくらいで
Dialogue: 0,0:18:42.73,0:18:44.65,Dial_JP,,0,0,0,,ちょっと待て
Dialogue: 0,0:18:46.58,0:18:49.47,Dial_JP,,0,0,0,,いっそこの穴に私を入れて塞いでくれ
Dialogue: 0,0:18:49.71,0:18:50.90,Dial_JP,,0,0,0,,すみません
Dialogue: 0,0:18:51.43,0:18:52.85,Dial_JP,,0,0,0,,カオルお姉ちゃん
Dialogue: 0,0:18:53.18,0:18:54.66,Dial_JP,,0,0,0,,お薬ちょうだい
Dialogue: 0,0:18:55.97,0:18:57.47,Dial_JP,,0,0,0,,喉が痛いの
Dialogue: 0,0:18:57.98,0:18:59.48,Dial_JP,,0,0,0,,風邪引いちゃったかな
Dialogue: 0,0:18:59.81,0:19:00.81,Dial_JP,,0,0,0,,あ～んして見せて
Dialogue: 0,0:19:01.30,0:19:02.35,Dial_JP,,0,0,0,,違うの
Dialogue: 0,0:19:03.66,0:19:04.32,Dial_JP,,0,0,0,,ここ
Dialogue: 0,0:19:04.80,0:19:06.07,Dial_JP,,0,0,0,,虫に刺されたの
Dialogue: 0,0:19:06.46,0:19:09.17,Dial_JP,,0,0,0,,うん　掻いたら痛くなってきちゃった
Dialogue: 0,0:19:10.99,0:19:13.05,Dial_JP,,0,0,0,,はい　虫刺されに効くよ
Dialogue: 0,0:19:15.65,0:19:16.73,Dial_JP,,0,0,0,,ありがとう
Dialogue: 0,0:19:16.95,0:19:18.15,Dial_JP,,0,0,0,,驚いた
Dialogue: 0,0:19:18.43,0:19:21.75,Dial_JP,,0,0,0,,喉が痛いって言うから　悪い病気かと思っちゃった
Dialogue: 0,0:19:22.08,0:19:24.44,Dial_JP,,0,0,0,,内側じゃなく　外側のことだったんだね
Dialogue: 0,0:19:26.30,0:19:28.44,Dial_JP,,0,0,0,,内側じゃなく　外側…
Dialogue: 0,0:19:32.83,0:19:33.75,Dial_JP,,0,0,0,,中隊長さん
Dialogue: 0,0:19:34.02,0:19:36.39,Dial_JP,,0,0,0,,何か傷ついても構わない硬いものを
Dialogue: 0,0:19:41.95,0:19:42.62,Dial_JP,,0,0,0,,おい
Dialogue: 0,0:19:43.05,0:19:44.15,Dial_JP,,0,0,0,,何をしてる
Dialogue: 0,0:19:50.88,0:19:52.37,Dial_JP,,0,0,0,,中じゃなく外側
Dialogue: 0,0:19:52.97,0:19:55.47,Dial_JP,,0,0,0,,金庫そのものがお宝だったんですね
Dialogue: 0,0:19:57.95,0:19:59.90,Dial_JP,,0,0,0,,父上　ご先祖様
Dialogue: 0,0:19:59.90,0:20:02.46,Dial_JP,,0,0,0,,そして女神セレスティーヌよ
Dialogue: 0,0:20:02.82,0:20:04.70,Dial_JP,,0,0,0,,我がラルスリック領の民は
Dialogue: 0,0:20:04.70,0:20:06.62,Dial_JP,,0,0,0,,此度の危機をも乗り越えて
Dialogue: 0,0:20:06.62,0:20:09.71,Dial_JP,,0,0,0,,雄々しく未来へ向かって進みますぞ
Dialogue: 0,0:20:09.71,0:20:13.48,Dial_JP,,0,0,0,,でも　そんなにしょっちゅう不作だなんだと危機に陥ってたら
Dialogue: 0,0:20:13.48,0:20:15.59,Dial_JP,,0,0,0,,そのうちこの財宝も使い果たして
Dialogue: 0,0:20:15.59,0:20:17.17,Dial_JP,,0,0,0,,いつか滅びるんじゃありません
Dialogue: 0,0:20:17.39,0:20:18.02,Dial_JP,,0,0,0,,何
Dialogue: 0,0:20:18.74,0:20:20.99,Dial_JP,,0,0,0,,一時的にお金で凌いだところで
Dialogue: 0,0:20:21.21,0:20:23.75,Dial_JP,,0,0,0,,それって対症療法にしかなりませんよね
Dialogue: 0,0:20:23.99,0:20:25.58,Dial_JP,,0,0,0,,根本を改善しないと
Dialogue: 0,0:20:27.18,0:20:28.75,Dial_JP,,0,0,0,,しかし　そうは言っても
Dialogue: 0,0:20:28.75,0:20:30.25,Dial_JP,,0,0,0,,どうすればよいというのだ
Dialogue: 0,0:20:30.75,0:20:33.72,Dial_JP,,0,0,0,,今までの不作の原因をきちんと分析するんです
Dialogue: 0,0:20:34.12,0:20:35.90,Dial_JP,,0,0,0,,それでもし冷夏が原因なら
Dialogue: 0,0:20:36.14,0:20:39.42,Dial_JP,,0,0,0,,北方から寒さに強い品種の種籾を入手して
Dialogue: 0,0:20:39.42,0:20:41.51,Dial_JP,,0,0,0,,試験栽培する費用に充てるとか
Dialogue: 0,0:20:41.89,0:20:43.27,Dial_JP,,0,0,0,,旱魃が原因なら
Dialogue: 0,0:20:43.27,0:20:46.16,Dial_JP,,0,0,0,,深い井戸を掘るとか　川から水路を引くとか
Dialogue: 0,0:20:48.00,0:20:50.14,Dial_JP,,0,0,0,,リスク分散で　麦だけでなく
Dialogue: 0,0:20:50.14,0:20:52.83,Dial_JP,,0,0,0,,トウモロコシや芋を栽培するのも手ですよね
Dialogue: 0,0:20:53.22,0:20:57.08,Dial_JP,,0,0,0,,芋は換金用の作物としてはあまり魅力がないかもしれませんが
Dialogue: 0,0:20:57.32,0:20:59.53,Dial_JP,,0,0,0,,いざという時は儲けより人命
Dialogue: 0,0:20:59.53,0:21:00.10,Dial_JP,,0,0,0,,でしょう
Dialogue: 0,0:21:00.31,0:21:01.53,Dial_JP,,0,0,0,,なるほど
Dialogue: 0,0:21:02.01,0:21:04.19,Dial_JP,,0,0,0,,有益な形で使ってくださいね
Dialogue: 0,0:21:04.68,0:21:07.91,Dial_JP,,0,0,0,,まあ　小金貨1枚分の仕事は十分かな
Dialogue: 0,0:21:09.12,0:21:10.83,Dial_JP,,0,0,0,,本日は世話になった
Dialogue: 0,0:21:11.24,0:21:14.55,Dial_JP,,0,0,0,,この通り　食事を用意したので食べていってくれ
Dialogue: 0,0:21:16.38,0:21:17.55,Dial_JP,,0,0,0,,えーっと…
Dialogue: 0,0:21:18.08,0:21:19.11,Dial_JP,,0,0,0,,紹介しよう
Dialogue: 0,0:21:19.39,0:21:22.30,Dial_JP,,0,0,0,,妻と　息子のオーギュスタンとクロヴィスだ
Dialogue: 0,0:21:22.77,0:21:24.37,Dial_JP,,0,0,0,,なぜオールキャスト
Dialogue: 0,0:21:25.39,0:21:26.04,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:21:26.87,0:21:28.04,Dial_JP,,0,0,0,,もしかして
Dialogue: 0,0:21:28.95,0:21:29.98,Dial_JP,,0,0,0,,惚れられた
Dialogue: 0,0:21:30.54,0:21:32.21,Dial_JP,,0,0,0,,見える　見えるよ
Dialogue: 0,0:21:32.21,0:21:35.32,Dial_JP,,0,0,0,,子爵家に嫁いだ私の未来予想図が
Dialogue: 0,0:21:36.20,0:21:37.84,Dial_JP,,0,0,0,,決して裕福ではないが
Dialogue: 0,0:21:38.07,0:21:40.26,Dial_JP,,0,0,0,,治水や農業改革に勤しんで
Dialogue: 0,0:21:40.72,0:21:43.92,Dial_JP,,0,0,0,,できた嫁だと中隊長さんたちにも大事にされて
Dialogue: 0,0:21:44.28,0:21:47.33,Dial_JP,,0,0,0,,子供を産んで　領民たちにも愛されて
Dialogue: 0,0:21:47.80,0:21:50.08,Dial_JP,,0,0,0,,うん　わりといいかもしれない
Dialogue: 0,0:21:50.40,0:21:52.83,Dial_JP,,0,0,0,,カオルさん　お願いがあるのですが
Dialogue: 0,0:21:52.83,0:21:53.96,Dial_JP,,900,0,0,,来た
Dialogue: 0,0:21:53.60,0:21:55.10,Dial_JP,,0,600,0,,いや　待ってくれ　兄さん
Dialogue: 0,0:21:55.29,0:21:56.13,Dial_JP,,0,0,0,,俺が先だ
Dialogue: 0,0:21:56.32,0:21:57.56,Dial_JP,,0,0,0,,いや　私が先だ
Dialogue: 0,0:21:57.56,0:21:58.84,Dial_JP,,0,0,0,,いいや　俺だ
Dialogue: 0,0:21:59.18,0:22:01.39,Dial_JP2,,0,900,0,,兄は弟に譲ったらどうなんだ
Dialogue: 0,0:21:59.47,0:22:03.09,Dial_JP,,0,0,0,,これはあれを言うしか　あの憧れのセリフ
Dialogue: 0,0:22:03.97,0:22:09.41,Dial_JP,,0,0,0,,お願い　私のために争わないで
Dialogue: 0,0:22:11.42,0:22:12.08,Dial_JP2,,0,500,0,,もういい
Dialogue: 0,0:22:12.08,0:22:12.63,Dial_JP,,0,0,0,,お願い
Dialogue: 0,0:22:12.63,0:22:13.37,Dial_JP,,0,0,0,,カオルさん
Dialogue: 0,0:22:13.86,0:22:16.40,Dial_JP,,0,0,0,,軍人病治療薬　分けてください
Dialogue: 0,0:22:17.41,0:22:19.06,Dial_JP,,0,0,0,,うん　知ってた
Dialogue: 0,0:22:20.46,0:22:22.74,Dial_JP,,0,0,0,,コンチキショーめ
Dialogue: 0,0:22:31.58,0:22:34.52,Dial_JP,,0,0,0,,やれやれ　今日もいろいろあったなあ
Dialogue: 0,0:22:35.22,0:22:38.33,Dial_JP,,0,0,0,,なんか　楽ちんとは程遠い生活だけど
Dialogue: 0,0:22:38.93,0:22:41.67,Dial_JP,,0,0,0,,ありがとうございました
Dialogue: 0,0:22:41.92,0:22:43.99,Dial_JP,,0,0,0,,まっ　これも悪くないかな
Dialogue: 0,0:22:45.96,0:22:48.29,Dial_JP,,0,0,0,,明日もお弁当作りがあるし
Dialogue: 0,0:22:48.29,0:22:49.53,Dial_JP,,0,0,0,,早く寝ないと
Dialogue: 0,0:22:49.97,0:22:51.94,Dial_JP,,0,0,0,,カオル　カオル
Dialogue: 0,0:22:54.50,0:22:55.16,Dial_JP,,0,0,0,,ガム
Dialogue: 0,0:22:55.75,0:22:56.28,Dial_JP,,0,0,0,,どうかし…
Dialogue: 0,0:22:56.28,0:22:58.66,Dial_JP,,0,0,0,,大変だ　マルとモルが
Dialogue: 0,0:23:09.40,0:23:10.53,Dial_JP,,0,0,0,,すごい熱
Dialogue: 0,0:23:10.88,0:23:12.15,Dial_JP,,0,0,0,,普通の風邪じゃない
Dialogue: 0,0:23:12.48,0:23:14.86,Dial_JP,,0,0,0,,昼間は元気だったのに　急に…
Dialogue: 0,0:23:16.99,0:23:17.54,Dial_JP,,0,0,0,,ガム
Dialogue: 0,0:23:20.22,0:23:20.91,Dial_JP,,0,0,0,,まさか
Dialogue: 0,0:23:28.17,0:23:30.65,Dial_JP,,0,0,0,,ママ　喉が痛いよ
Dialogue: 0,0:23:36.13,0:23:37.40,Dial_JP,,0,0,0,,伝染病？
Dialogue: 1,0:00:01.04,0:00:03.20,Dial_CH,,0,0,0,,姐姐 起床了
Dialogue: 1,0:00:03.70,0:00:06.08,Dial_CH,,0,0,0,,卡奧露姐姐
Dialogue: 1,0:00:06.51,0:00:07.95,Dial_CH,,0,0,0,,蕾耶特醬
Dialogue: 1,0:00:07.95,0:00:09.74,Dial_CH,,0,0,0,,讓我再睡會兒
Dialogue: 1,0:00:10.41,0:00:10.89,Dial_CH,,0,0,0,,起床
Dialogue: 1,0:00:11.17,0:00:12.92,Dial_CH,,0,0,0,,做便當
Dialogue: 1,0:00:13.31,0:00:16.60,Dial_CH,,0,0,0,,預約的50份和常規的50份
Dialogue: 1,0:00:17.54,0:00:18.56,Dial_CH,,0,0,0,,差點忘了
Dialogue: 1,0:00:23.70,0:00:25.09,Dial_CH,,0,0,0,,趕快趕快
Dialogue: 1,0:00:25.28,0:00:27.06,Dial_CH,,0,0,0,,貝露 放兩大勺這個
Dialogue: 1,0:00:27.06,0:00:27.51,Dial_CH,,0,0,0,,好
Dialogue: 1,0:00:27.51,0:00:28.78,Dial_CH,,0,0,0,,芙蘭把這個切好
Dialogue: 1,0:00:28.78,0:00:29.76,Dial_CH,,0,0,0,,好
Dialogue: 1,0:00:31.05,0:00:32.96,Dial_CH,,0,0,0,,從這裡面挑5種裝進去
Dialogue: 1,0:00:33.25,0:00:34.99,Dial_CH,,0,0,0,,花樣多點比較好
Dialogue: 1,0:00:35.29,0:00:36.27,Dial_CH,,0,0,0,,好
Dialogue: 1,0:00:43.13,0:00:44.23,Dial_CH,,0,0,0,,累死了
Dialogue: 1,0:00:44.54,0:00:48.00,Dial_CH,,0,0,0,,要不乾脆用外掛直接生成算了
Dialogue: 1,0:00:48.82,0:00:49.20,Dial_CH,,0,0,0,,變
Dialogue: 1,0:00:51.53,0:00:53.37,Dial_CH,,0,0,0,,不不 那樣不行
Dialogue: 1,0:00:53.81,0:00:56.08,Dial_CH,,0,0,0,,有悖於我的原則
Dialogue: 1,0:02:31.21,0:02:32.30,Dial_CH,,0,0,0,,歡迎光臨
Dialogue: 1,0:02:32.86,0:02:34.51,Dial_CH,,0,0,0,,歡銀光臨
Dialogue: 1,0:02:34.51,0:02:35.89,Dial_CH,,0,0,0,,心動
Dialogue: 1,0:02:36.88,0:02:39.61,Dial_CH,,0,0,0,,把賣萌當成義務了這是
Dialogue: 1,0:02:49.08,0:02:50.39,Dial_CH,,900,0,0,,謝謝
Dialogue: 1,0:02:49.08,0:02:49.64,Dial_CH,,0,0,0,,好
Dialogue: 1,0:02:49.43,0:02:50.60,Dial_CH,,0,900,0,,歡迎下次光臨
Dialogue: 1,0:02:50.60,0:02:51.13,Dial_CH,,0,0,0,,慢走
Dialogue: 1,0:02:51.13,0:02:52.11,Dial_CH,,0,0,0,,加油工作
Dialogue: 1,0:02:52.11,0:02:53.24,Dial_CH,,0,0,0,,多吃點哦
Dialogue: 1,0:03:04.93,0:03:08.17,Dial_CH,,0,0,0,,芙蘭便用力塞得滿滿的
Dialogue: 1,0:03:08.17,0:03:09.63,Dial_CH,,0,0,0,,超管飽
Dialogue: 1,0:03:09.91,0:03:12.13,Dial_CH,,0,0,0,,我必吃貝露便
Dialogue: 1,0:03:12.13,0:03:14.88,Dial_CH,,0,0,0,,非油炸 更健康
Dialogue: 1,0:03:15.29,0:03:16.50,Dial_CH,,0,0,0,,還是蕾便最好
Dialogue: 1,0:03:16.94,0:03:18.69,Dial_CH,,0,0,0,,看蕾便多可愛
Dialogue: 1,0:03:18.69,0:03:21.76,Dial_CH,,0,0,0,,感覺就像是女兒努力為我做的一樣
Dialogue: 1,0:03:21.96,0:03:24.56,Dial_CH,,0,0,0,,不是 別說女兒老婆了
Dialogue: 1,0:03:24.56,0:03:25.91,Dial_CH,,0,0,0,,你連個女朋友都沒吧
Dialogue: 1,0:03:25.91,0:03:27.03,Dial_CH,,0,0,0,,就是因為沒有啊
Dialogue: 1,0:03:27.41,0:03:29.03,Dial_CH,,0,0,0,,所以 卡奧露便呢
Dialogue: 1,0:03:30.09,0:03:31.88,Dial_CH,,0,0,0,,卡奧露便啊…
Dialogue: 1,0:03:32.19,0:03:33.54,Dial_CH,,0,0,0,,怎麼說呢
Dialogue: 1,0:03:34.20,0:03:35.35,Dial_CH,,0,0,0,,普通
Dialogue: 1,0:03:37.79,0:03:40.66,Dial_CH,,0,0,0,,不是 味道那當然是好吃的
Dialogue: 1,0:03:41.07,0:03:42.79,Dial_CH,,0,0,0,,我還是買卡奧露便吧
Dialogue: 1,0:03:43.51,0:03:46.20,Dial_CH,,0,0,0,,我也吃一次卡奧露便吧
Dialogue: 1,0:03:46.20,0:03:48.83,Dial_CH,,0,0,0,,我該去摘藥草了
Dialogue: 1,0:03:49.33,0:03:50.51,Dial_CH,,0,0,0,,出門了
Dialogue: 1,0:03:51.53,0:03:56.59,Dial_CH,,0,0,0,,所有食譜都是我一手設計的啊
Dialogue: 1,0:04:01.42,0:04:03.20,Dial_CH,,0,0,0,,說是賣藥…
Dialogue: 1,0:04:04.08,0:04:07.81,Dial_CH,,0,0,0,,便當 化妝品 洗髮水 護髮素
Dialogue: 1,0:04:08.31,0:04:10.56,Dial_CH,,0,0,0,,玻璃製品 陶瓷器
Dialogue: 1,0:04:11.03,0:04:13.17,Dial_CH,,0,0,0,,成雜貨店了
Dialogue: 1,0:04:13.60,0:04:15.44,Dial_CH,,0,0,0,,要不開個超商得了
Dialogue: 1,0:04:16.46,0:04:20.47,Dial_CH,,0,0,0,,讓羅蘭德送外送 這個可以有
Dialogue: 1,0:04:20.47,0:04:22.47,Dial_CH,,0,0,0,,優馬外送
Dialogue: 1,0:04:24.48,0:04:27.80,Dial_CH,,0,0,0,,感覺她又在憋甚麼壞主意
Dialogue: 1,0:04:29.75,0:04:30.41,Dial_CH,,0,0,0,,咦
Dialogue: 1,0:04:31.09,0:04:31.99,Dial_CH,,0,0,0,,卡奧露醬
Dialogue: 1,0:04:32.31,0:04:34.53,Dial_CH,,0,0,0,,退燒藥和止咳藥
Dialogue: 1,0:04:34.53,0:04:36.11,Dial_CH,,0,0,0,,還有庫存嗎
Dialogue: 1,0:04:36.49,0:04:37.15,Dial_CH,,0,0,0,,嗯？
Dialogue: 1,0:04:37.73,0:04:38.78,Dial_CH,,0,0,0,,怪了
Dialogue: 1,0:04:39.00,0:04:41.21,Dial_CH,,0,0,0,,昨天剛補的貨
Dialogue: 1,0:04:41.67,0:04:43.69,Dial_CH,,0,0,0,,流感高發期嗎
Dialogue: 1,0:04:45.32,0:04:46.81,Dial_CH,,0,0,0,,打掃完了
Dialogue: 1,0:04:47.46,0:04:48.57,Dial_CH,,0,0,0,,辛苦啦
Dialogue: 1,0:04:48.96,0:04:51.25,Dial_CH,,0,0,0,,好了 現在也沒客人了
Dialogue: 1,0:04:53.34,0:04:55.22,Dial_CH,,0,0,0,,我去軍隊交貨
Dialogue: 1,0:04:55.72,0:04:57.06,Dial_CH,,0,0,0,,走吧 蕾耶特醬
Dialogue: 1,0:04:57.40,0:04:58.45,Dial_CH,,0,0,0,,好
Dialogue: 1,0:04:59.01,0:05:00.17,Dial_CH,,0,0,0,,一路順風
Dialogue: 1,0:05:03.74,0:05:04.88,Dial_CH,,0,0,0,,我去護送
Dialogue: 1,0:05:05.76,0:05:07.48,Dial_CH,,0,0,0,,不是 就我一人看店嗎
Dialogue: 1,0:05:10.07,0:05:11.75,Dial_CH,,0,0,0,,謝謝你們總來幫我
Dialogue: 1,0:05:12.02,0:05:13.96,Dial_CH,,0,0,0,,要說謝謝的是我們啊
Dialogue: 1,0:05:14.29,0:05:15.32,Dial_CH,,0,0,0,,我們啊
Dialogue: 1,0:05:16.77,0:05:18.29,Dial_CH,,0,0,0,,不過話說回來
Dialogue: 1,0:05:19.56,0:05:23.46,Dial_CH,,0,0,0,,你就不能去陪陪羅蘭德嗎
Dialogue: 1,0:05:26.50,0:05:27.33,Dial_CH,,0,0,0,,對了
Dialogue: 1,0:05:27.67,0:05:29.99,Dial_CH,,0,0,0,,你們有人感冒了嗎
Dialogue: 1,0:05:30.41,0:05:31.05,Dial_CH,,0,0,0,,感冒嗎
Dialogue: 1,0:05:31.55,0:05:32.53,Dial_CH,,0,0,0,,沒有啊
Dialogue: 1,0:05:32.72,0:05:34.40,Dial_CH,,0,0,0,,我們精神頭可好了
Dialogue: 1,0:05:34.64,0:05:35.01,Dial_CH,,0,0,0,,對吧
Dialogue: 1,0:05:35.42,0:05:36.05,Dial_CH,,0,0,0,,嗯
Dialogue: 1,0:05:37.07,0:05:40.51,Dial_CH,,0,0,0,,埃米爾哥哥總是給我們送很多吃的
Dialogue: 1,0:05:40.86,0:05:43.53,Dial_CH,,0,0,0,,貝露姐姐幫我紮了辮子
Dialogue: 1,0:05:43.96,0:05:47.54,Dial_CH,,0,0,0,,還教我們學習 幫助我們出人頭地
Dialogue: 1,0:05:50.08,0:05:52.31,Dial_CH,,0,0,0,,獵人的業餘時間
Dialogue: 1,0:05:52.31,0:05:53.84,Dial_CH,,0,0,0,,在做這些啊
Dialogue: 1,0:06:02.28,0:06:03.26,Dial_CH,,0,0,0,,謝謝惠顧
Dialogue: 1,0:06:03.81,0:06:05.04,Dial_CH,,0,0,0,,再見
Dialogue: 1,0:06:05.70,0:06:08.37,Dial_CH,,0,0,0,,對方傲慢無禮 我們十倍奉還
Dialogue: 1,0:06:08.68,0:06:11.72,Dial_CH,,0,0,0,,對方傲慢無禮 我們十倍奉還
Dialogue: 1,0:06:11.94,0:06:14.45,Dial_CH2,,0,0,0,,「嘿 我偷偷告訴你啊」
Dialogue: 1,0:06:14.45,0:06:18.49,Dial_CH2,,0,0,0,,然後開始洩露別人的秘密 這種人不能信
Dialogue: 1,0:06:17.70,0:06:20.43,Dial_CH,,0,0,0,,真是靠譜過頭了
Dialogue: 1,0:06:21.99,0:06:24.65,Dial_CH,,0,0,0,,大隊長 藥房姐妹來了
Dialogue: 1,0:06:25.33,0:06:26.00,Dial_CH,,0,0,0,,讓她們進來
Dialogue: 1,0:06:29.24,0:06:30.74,Dial_CH,,0,0,0,,在談事嗎
Dialogue: 1,0:06:31.07,0:06:32.53,Dial_CH,,0,0,0,,那我們等會兒吧
Dialogue: 1,0:06:32.89,0:06:34.83,Dial_CH,,0,0,0,,沒事 已經完事了
Dialogue: 1,0:06:35.50,0:06:36.66,Dial_CH,,0,0,0,,跟你介紹一下
Dialogue: 1,0:06:37.70,0:06:39.88,Dial_CH,,0,0,0,,這位是中隊長 拉魯斯立克
Dialogue: 1,0:06:40.41,0:06:42.28,Dial_CH,,0,0,0,,這兩位是藥房姐妹
Dialogue: 1,0:06:42.88,0:06:43.62,Dial_CH,,0,0,0,,你好
Dialogue: 1,0:06:44.25,0:06:45.53,Dial_CH,,0,0,0,,我放這裡了
Dialogue: 1,0:06:46.21,0:06:47.36,Dial_CH,,0,0,0,,我聽說了
Dialogue: 1,0:06:47.69,0:06:50.35,Dial_CH,,0,0,0,,把來找茬的貴族給懟回去了
Dialogue: 1,0:06:50.64,0:06:54.12,Dial_CH,,0,0,0,,拍死了一隻小蟲子而已
Dialogue: 1,0:06:54.49,0:06:55.35,Dial_CH,,0,0,0,,我倒是要問你
Dialogue: 1,0:06:56.32,0:06:56.87,Dial_CH,,0,0,0,,怎麼了
Dialogue: 1,0:06:57.41,0:06:58.51,Dial_CH,,0,0,0,,治療藥啊
Dialogue: 1,0:06:58.74,0:07:02.11,Dial_CH,,0,0,0,,你沒給近衛軍和王都警衛兵是吧
Dialogue: 1,0:07:03.56,0:07:05.07,Dial_CH,,0,0,0,,跟他們有甚麼關係
Dialogue: 1,0:07:05.73,0:07:06.29,Dial_CH,,0,0,0,,咦
Dialogue: 1,0:07:06.85,0:07:09.26,Dial_CH,,0,0,0,,你在說甚麼
Dialogue: 1,0:07:10.45,0:07:12.50,Dial_CH,,0,0,0,,完全沒有惡意
Dialogue: 1,0:07:13.22,0:07:16.51,Dial_CH,,0,0,0,,合著純粹是我自己考慮不周
Dialogue: 1,0:07:17.48,0:07:18.67,Dial_CH,,0,0,0,,該反省下了
Dialogue: 1,0:07:21.95,0:07:23.07,Dial_CH,,0,0,0,,這份文件
Dialogue: 1,0:07:25.87,0:07:27.51,Dial_CH,,0,0,0,,你們在倒賣啊
Dialogue: 1,0:07:29.89,0:07:32.09,Dial_CH,,0,0,0,,用國家的錢買藥
Dialogue: 1,0:07:32.09,0:07:34.47,Dial_CH,,0,0,0,,再低價倒賣賺黑錢
Dialogue: 1,0:07:34.47,0:07:37.31,Dial_CH,,0,0,0,,而且藏都不帶藏的
Dialogue: 1,0:07:37.31,0:07:39.18,Dial_CH,,0,0,0,,就在我眼皮子底下搞
Dialogue: 1,0:07:39.18,0:07:40.52,Dial_CH,,0,0,0,,你們想幹什麼啊
Dialogue: 1,0:07:41.99,0:07:44.07,Dial_CH,,0,0,0,,咱們的生意到此為止
Dialogue: 1,0:07:44.07,0:07:46.15,Dial_CH,,0,0,0,,等等等等
Dialogue: 1,0:07:46.59,0:07:48.78,Dial_CH,,0,0,0,,你好好的發甚麼火啊
Dialogue: 1,0:07:49.46,0:07:51.07,Dial_CH,,0,0,0,,這份文件你怎麼解釋
Dialogue: 1,0:07:51.83,0:07:55.04,Dial_CH,,0,0,0,,上級軍人病治療藥 2枚小金幣
Dialogue: 1,0:07:55.21,0:07:57.77,Dial_CH,,0,0,0,,胡椒10克 3枚小金幣
Dialogue: 1,0:07:59.86,0:08:01.04,Dial_CH,,0,0,0,,你看得懂嗎
Dialogue: 1,0:08:01.29,0:08:04.05,Dial_CH,,0,0,0,,讀寫這個國家的語言我還是會的
Dialogue: 1,0:08:04.56,0:08:04.93,Dial_CH,,0,0,0,,不是
Dialogue: 1,0:08:05.09,0:08:06.44,Dial_CH,,0,0,0,,我問的是
Dialogue: 1,0:08:06.93,0:08:11.30,Dial_CH,,0,0,0,,在倒賣軍用物資團伙窩點找到的
Dialogue: 1,0:08:11.62,0:08:14.86,Dial_CH,,0,0,0,,這份用暗號寫的文件 你能讀懂嗎
Dialogue: 1,0:08:21.64,0:08:22.57,Dial_CH,,0,0,0,,難道
Dialogue: 1,0:08:23.02,0:08:26.65,Dial_CH,,0,0,0,,「這個世界所有語言的聽說讀寫能力」
Dialogue: 1,0:08:26.97,0:08:29.53,Dial_CH,,0,0,0,,暗號也算啊
Dialogue: 1,0:08:30.10,0:08:31.88,Dial_CH,,0,0,0,,就當無事發生
Dialogue: 1,0:08:31.88,0:08:33.07,Dial_CH,,0,0,0,,事大了
Dialogue: 1,0:08:33.07,0:08:34.54,Dial_CH,,0,0,0,,也是
Dialogue: 1,0:08:34.76,0:08:36.05,Dial_CH,,0,0,0,,怎麼回事
Dialogue: 1,0:08:36.05,0:08:38.86,Dial_CH,,0,0,0,,為甚麼你能看懂倒賣團伙寫的暗號
Dialogue: 1,0:08:39.18,0:08:39.96,Dial_CH,,0,0,0,,糟糕
Dialogue: 1,0:08:40.59,0:08:42.76,Dial_CH,,0,0,0,,倒也不是在懷疑你
Dialogue: 1,0:08:43.15,0:08:44.49,Dial_CH,,0,0,0,,如果和他們是一夥的
Dialogue: 1,0:08:44.49,0:08:45.91,Dial_CH,,0,0,0,,除非是蠢到無可救藥
Dialogue: 1,0:08:45.91,0:08:47.87,Dial_CH,,0,0,0,,否則不會特地念給我們聽
Dialogue: 1,0:08:48.31,0:08:49.35,Dial_CH,,0,0,0,,你並不蠢…
Dialogue: 1,0:08:49.60,0:08:51.74,Dial_CH,,0,0,0,,你並沒有那麼蠢
Dialogue: 1,0:08:51.74,0:08:53.63,Dial_CH,,0,0,0,,為甚麼要在那裡改口
Dialogue: 1,0:08:55.01,0:08:55.61,Dial_CH,,0,0,0,,哎呀
Dialogue: 1,0:08:55.85,0:08:58.93,Dial_CH,,0,0,0,,這不就是個騙小孩的簡單把戲
Dialogue: 1,0:08:58.93,0:09:00.31,Dial_CH,,0,0,0,,一眼就看懂了
Dialogue: 1,0:09:00.47,0:09:01.26,Dial_CH,,0,0,0,,任誰都行
Dialogue: 1,0:09:01.59,0:09:02.15,Dial_CH,,0,0,0,,看啊
Dialogue: 1,0:09:02.38,0:09:05.24,Dial_CH2,,0,0,0,,先豎著讀 第1個碰到的數字是4
Dialogue: 1,0:09:05.49,0:09:08.23,Dial_CH2,,0,0,0,,所以把所有字母都往後推4個
Dialogue: 1,0:09:08.23,0:09:11.05,Dial_CH2,,0,0,0,,繼續豎著讀 第2個碰到的數字是3
Dialogue: 1,0:09:11.05,0:09:13.84,Dial_CH2,,0,0,0,,所以隔3個取1個字母 排在一起
Dialogue: 1,0:09:04.65,0:09:05.81,Dial_CH,,0,0,0,,喂 記下來
Dialogue: 1,0:09:06.56,0:09:06.91,Dial_CH,,0,0,0,,是
Dialogue: 1,0:09:14.84,0:09:16.45,Dial_CH,,0,0,0,,就是這樣
Dialogue: 1,0:09:17.32,0:09:17.75,Dial_CH,,0,0,0,,所以
Dialogue: 1,0:09:18.06,0:09:22.19,Dial_CH,,0,0,0,,這麼複雜的運算 你一瞬間就處理完了
Dialogue: 1,0:09:22.44,0:09:23.58,Dial_CH,,0,0,0,,還光靠腦算
Dialogue: 1,0:09:25.09,0:09:26.58,Dial_CH,,0,0,0,,就這麼點東西
Dialogue: 1,0:09:26.58,0:09:28.96,Dial_CH,,0,0,0,,還用得著筆算嗎
Dialogue: 1,0:09:29.98,0:09:32.22,Dial_CH,,0,0,0,,太國二了
Dialogue: 1,0:09:34.90,0:09:36.72,Dial_CH,,0,0,0,,包括上次那回
Dialogue: 1,0:09:37.43,0:09:39.23,Dial_CH,,0,0,0,,不敢相信這是人類能做到的
Dialogue: 1,0:09:39.57,0:09:41.21,Dial_CH,,0,0,0,,糟了糟了
Dialogue: 1,0:09:41.53,0:09:45.83,Dial_CH,,0,0,0,,又要開始女神啊神使的劇本了嗎
Dialogue: 1,0:09:46.16,0:09:46.95,Dial_CH,,0,0,0,,你
Dialogue: 1,0:09:46.95,0:09:47.71,Dial_CH,,0,0,0,,要來了
Dialogue: 1,0:09:49.39,0:09:50.72,Dial_CH,,0,0,0,,要不要來軍隊呀
Dialogue: 1,0:09:53.34,0:09:55.77,Dial_CH,,0,0,0,,現在來當情報軍官 少尉…
Dialogue: 1,0:09:55.77,0:09:58.08,Dial_CH,,0,0,0,,不對 中尉肯定有的
Dialogue: 1,0:09:59.19,0:10:00.07,Dial_CH,,0,0,0,,中尉
Dialogue: 1,0:10:00.44,0:10:02.62,Dial_CH,,0,0,0,,一上來就當幹部 待遇真不錯
Dialogue: 1,0:10:03.00,0:10:05.16,Dial_CH,,0,0,0,,不是 鬼才去啊
Dialogue: 1,0:10:05.71,0:10:07.35,Dial_CH,,0,0,0,,我覺得挺好的啊
Dialogue: 1,0:10:07.61,0:10:09.56,Dial_CH,,0,0,0,,那我還怎麼做藥
Dialogue: 1,0:10:09.85,0:10:10.75,Dial_CH,,0,0,0,,問題不大
Dialogue: 1,0:10:10.75,0:10:12.14,Dial_CH,,0,0,0,,允許你開展副業
Dialogue: 1,0:10:12.14,0:10:13.93,Dial_CH,,0,0,0,,話不是這麼說
Dialogue: 1,0:10:17.06,0:10:19.54,Dial_CH,,0,0,0,,總算是逃出來了
Dialogue: 1,0:10:20.26,0:10:23.10,Dial_CH,,0,0,0,,真得小心了 千萬不能暴露
Dialogue: 1,0:10:23.50,0:10:26.70,Dial_CH,,0,0,0,,魔法藥劑也得小心點著做了
Dialogue: 1,0:10:28.54,0:10:29.89,Dial_CH,,0,0,0,,歡迎光臨
Dialogue: 1,0:10:30.25,0:10:31.88,Dial_CH,,0,0,0,,歡迎關臨
Dialogue: 1,0:10:32.06,0:10:35.67,Dial_CH,,0,0,0,,嗯 再來幾次就能申請非物質文化遺產了
Dialogue: 1,0:10:36.71,0:10:39.55,Dial_CH,,0,0,0,,咦 這不是中隊長先生嗎
Dialogue: 1,0:10:40.57,0:10:42.82,Dial_CH,,0,0,0,,我有件私事想要找你幫忙
Dialogue: 1,0:10:43.43,0:10:45.48,Dial_CH,,0,0,0,,可以來我府上一趟嗎
Dialogue: 1,0:10:47.38,0:10:48.99,Dial_CH,,0,0,0,,私事
Dialogue: 1,0:10:50.23,0:10:51.43,Dial_CH,,0,0,0,,有點可疑
Dialogue: 1,0:10:52.24,0:10:52.87,Dial_CH,,0,0,0,,不過…
Dialogue: 1,0:10:53.51,0:10:56.30,Dial_CH,,0,0,0,,上門費1枚小金幣
Dialogue: 1,0:10:56.96,0:10:58.38,Dial_CH,,0,0,0,,感覺很有趣
Dialogue: 1,0:11:00.16,0:11:02.06,Dial_CH,,0,0,0,,該不會這個中隊長先生
Dialogue: 1,0:11:02.45,0:11:04.06,Dial_CH,,0,0,0,,就是倒賣團伙的一員
Dialogue: 1,0:11:04.06,0:11:06.80,Dial_CH,,0,0,0,,因為暗號一事想要除掉我
Dialogue: 1,0:11:06.80,0:11:08.06,Dial_CH,,0,0,0,,還以為是這樣
Dialogue: 1,0:11:08.06,0:11:10.29,Dial_CH,,0,0,0,,看樣子好像不是
Dialogue: 1,0:11:11.06,0:11:13.27,Dial_CH,,0,0,0,,不過就算有甚麼動作
Dialogue: 1,0:11:14.32,0:11:16.50,Dial_CH,,0,0,0,,他們也會隨時跳出來阻攔
Dialogue: 1,0:11:16.92,0:11:19.58,Dial_CH,,0,0,0,,不是 芙蘭這個護衛是從幾點到幾點啊
Dialogue: 1,0:11:20.14,0:11:21.11,Dial_CH,,0,0,0,,全年無休？
Dialogue: 1,0:11:21.47,0:11:23.58,Dial_CH,,0,0,0,,甚麼黑心企業
Dialogue: 1,0:11:24.26,0:11:25.10,Dial_CH,,0,0,0,,到了
Dialogue: 1,0:11:31.60,0:11:33.77,Dial_CH,,0,0,0,,歡迎回家 先生
Dialogue: 1,0:11:35.05,0:11:38.63,Dial_CH,,0,0,0,,那個 你是貴族家主嗎
Dialogue: 1,0:11:39.68,0:11:40.89,Dial_CH,,0,0,0,,嗯 是的
Dialogue: 1,0:11:41.73,0:11:44.26,Dial_CH,,0,0,0,,我是賽波斯·馮·拉魯斯立克
Dialogue: 1,0:11:44.75,0:11:46.35,Dial_CH,,0,0,0,,拉魯斯立克子爵
Dialogue: 1,0:11:48.29,0:11:51.80,Dial_CH,,0,0,0,,擁有爵位的貴族現任家主
Dialogue: 1,0:11:52.88,0:11:53.81,Dial_CH,,0,0,0,,但是
Dialogue: 1,0:11:55.03,0:11:57.11,Dial_CH,,0,0,0,,傢俱挺陳舊的
Dialogue: 1,0:11:57.61,0:12:00.62,Dial_CH,,0,0,0,,經濟不是很寬裕嗎
Dialogue: 1,0:12:01.33,0:12:02.79,Dial_CH,,0,0,0,,茶來了
Dialogue: 1,0:12:03.60,0:12:04.17,Dial_CH,,0,0,0,,請慢用
Dialogue: 1,0:12:05.46,0:12:06.91,Dial_CH,,0,0,0,,謝謝
Dialogue: 1,0:12:09.19,0:12:10.47,Dial_CH,,0,0,0,,真好吃
Dialogue: 1,0:12:10.98,0:12:12.55,Dial_CH,,0,0,0,,不夠還有
Dialogue: 1,0:12:12.89,0:12:14.15,Dial_CH,,0,0,0,,謝謝
Dialogue: 1,0:12:14.83,0:12:15.31,Dial_CH,,0,0,0,,慢用
Dialogue: 1,0:12:18.78,0:12:21.26,Dial_CH,,0,0,0,,我的訴求是…
Dialogue: 1,0:12:22.37,0:12:23.11,Dial_CH,,0,0,0,,來了
Dialogue: 1,0:12:24.52,0:12:26.59,Dial_CH,,0,0,0,,請幫我找個寶藏
Dialogue: 1,0:12:30.67,0:12:32.57,Dial_CH,,0,0,0,,尋寶？
Dialogue: 1,0:12:36.12,0:12:37.78,Dial_CH,,0,0,0,,尋寶…
Dialogue: 1,0:12:38.15,0:12:41.04,Dial_CH,,0,0,0,,我還以為多大的事呢
Dialogue: 1,0:12:41.79,0:12:45.91,Dial_CH,,0,0,0,,這事對我們家來說極其重要
Dialogue: 1,0:12:46.91,0:12:50.79,Dial_CH,,0,0,0,,近年來我們這裡連年歉收
Dialogue: 1,0:12:51.41,0:12:53.19,Dial_CH,,0,0,0,,想盡辦法挺到了現在
Dialogue: 1,0:12:53.55,0:12:57.55,Dial_CH,,0,0,0,,但金庫和儲備糧已近乎枯竭
Dialogue: 1,0:12:58.09,0:12:59.71,Dial_CH,,0,0,0,,如果再來個事件
Dialogue: 1,0:13:01.25,0:13:03.05,Dial_CH,,0,0,0,,可能會造成致命打擊
Dialogue: 1,0:13:03.67,0:13:05.71,Dial_CH,,0,0,0,,這財政還真是搖搖欲墜
Dialogue: 1,0:13:06.27,0:13:09.77,Dial_CH,,0,0,0,,一般來說 只能向大貴族借錢
Dialogue: 1,0:13:10.08,0:13:13.31,Dial_CH,,0,0,0,,放棄尊嚴 向其俯首稱臣
Dialogue: 1,0:13:13.61,0:13:14.97,Dial_CH,,0,0,0,,「一般來說」？
Dialogue: 1,0:13:15.75,0:13:18.31,Dial_CH,,0,0,0,,我們家有一筆隱藏財產
Dialogue: 1,0:13:18.76,0:13:20.82,Dial_CH,,0,0,0,,按理來說是有的
Dialogue: 1,0:13:22.08,0:13:23.57,Dial_CH,,0,0,0,,好幾代以前
Dialogue: 1,0:13:23.88,0:13:26.33,Dial_CH,,0,0,0,,有一艘無人的大型船隻漂到了這裡
Dialogue: 1,0:13:27.05,0:13:31.33,Dial_CH,,0,0,0,,大量的黃金珠寶原封不動地裝載在船上
Dialogue: 1,0:13:31.82,0:13:34.56,Dial_CH,,0,0,0,,當時也是連年歉收
Dialogue: 1,0:13:34.56,0:13:36.69,Dial_CH,,0,0,0,,我的祖先面對危機
Dialogue: 1,0:13:36.69,0:13:40.46,Dial_CH,,0,0,0,,將其換為金幣 用一部分渡過了難關
Dialogue: 1,0:13:41.23,0:13:43.04,Dial_CH,,0,0,0,,而剩下金幣的所在之處
Dialogue: 1,0:13:43.04,0:13:45.63,Dial_CH,,0,0,0,,由代代家主口口相傳
Dialogue: 1,0:13:46.21,0:13:50.73,Dial_CH,,0,0,0,,但3代前的家主死於突發事故
Dialogue: 1,0:13:51.24,0:13:53.73,Dial_CH,,0,0,0,,只留下了這麼一張紙
Dialogue: 1,0:13:54.28,0:13:56.17,Dial_CH,,0,0,0,,幫忙解讀一下 求求了
Dialogue: 1,0:13:56.86,0:13:57.84,Dial_CH,,0,0,0,,原來如此
Dialogue: 1,0:13:58.21,0:14:00.58,Dial_CH,,0,0,0,,用暗號記錄了藏寶地
Dialogue: 1,0:14:01.04,0:14:01.46,Dial_CH,,0,0,0,,嗯
Dialogue: 1,0:14:01.69,0:14:04.24,Dial_CH,,0,0,0,,做個備份以防萬一還是很有必要的
Dialogue: 1,0:14:04.90,0:14:06.70,Dial_CH,,0,0,0,,想起了那個混蛋科長
Dialogue: 1,0:14:06.70,0:14:09.19,Dial_CH,,0,0,0,,居然3個月都沒備份
Dialogue: 1,0:14:10.06,0:14:11.13,Dial_CH,,0,0,0,,氣死了
Dialogue: 1,0:14:11.13,0:14:12.75,Dial_CH,,0,0,0,,都是我在擦屁股
Dialogue: 1,0:14:13.27,0:14:14.50,Dial_CH,,0,0,0,,怎麼了嗎
Dialogue: 1,0:14:15.90,0:14:17.11,Dial_CH,,0,0,0,,沒甚麼
Dialogue: 1,0:14:17.77,0:14:19.57,Dial_CH,,0,0,0,,我試著解讀一下
Dialogue: 1,0:14:20.06,0:14:22.20,Dial_CH,,0,0,0,,在領地面臨危機
Dialogue: 1,0:14:22.43,0:14:25.42,Dial_CH,,0,0,0,,並且無計可施之時
Dialogue: 1,0:14:25.42,0:14:27.30,Dial_CH,,0,0,0,,可用祖上的財產渡過難關
Dialogue: 1,0:14:27.54,0:14:29.27,Dial_CH,,0,0,0,,克雷克斯·馮·拉魯斯立克
Dialogue: 1,0:14:29.67,0:14:31.30,Dial_CH,,0,0,0,,鬼知道在哪
Dialogue: 1,0:14:35.66,0:14:37.67,Dial_CH,,0,0,0,,不知道哦親 哦吼吼吼吼
Dialogue: 1,0:14:37.91,0:14:39.12,Dial_CH,,0,0,0,,噁心死了
Dialogue: 1,0:14:40.73,0:14:42.21,Dial_CH,,0,0,0,,我先退下了
Dialogue: 1,0:14:44.87,0:14:47.82,Dial_CH,,0,0,0,,你這叫哪門子暗號啊
Dialogue: 1,0:14:47.82,0:14:50.54,Dial_CH,,0,0,0,,這你讓我怎麼找
Dialogue: 1,0:14:51.68,0:14:55.10,Dial_CH,,0,0,0,,你不是能從筆跡讀取書寫人的想法嗎
Dialogue: 1,0:14:55.59,0:14:58.03,Dial_CH,,0,0,0,,我又不會超能力
Dialogue: 1,0:14:58.33,0:15:01.87,Dial_CH,,0,0,0,,寫的人在想甚麼我哪知道
Dialogue: 1,0:15:02.33,0:15:03.01,Dial_CH,,0,0,0,,所以
Dialogue: 1,0:15:03.35,0:15:06.04,Dial_CH,,0,0,0,,要是有人讓我趕緊領盒飯
Dialogue: 1,0:15:06.25,0:15:09.38,Dial_CH,,0,0,0,,那我會以為他想請我吃盒飯
Dialogue: 1,0:15:09.38,0:15:13.31,Dial_CH,,0,0,0,,誰知道他其實是想要我趕緊死啊
Dialogue: 1,0:15:15.07,0:15:16.62,Dial_CH,,0,0,0,,解讀不了嗎
Dialogue: 1,0:15:18.27,0:15:21.82,Dial_CH,,0,0,0,,反正能找到錢在哪兒就行唄
Dialogue: 1,0:15:21.98,0:15:23.21,Dial_CH,,0,0,0,,是啊
Dialogue: 1,0:15:23.54,0:15:25.87,Dial_CH,,0,0,0,,但是 我爺爺我爸爸還有我
Dialogue: 1,0:15:26.11,0:15:29.33,Dial_CH,,0,0,0,,把家裡翻了個底朝天也沒找到
Dialogue: 1,0:15:29.86,0:15:32.26,Dial_CH,,0,0,0,,因為國境附近的那個宅邸比較危險
Dialogue: 1,0:15:32.54,0:15:36.38,Dial_CH,,0,0,0,,所以搬到了王都這裡 這點是能肯定的
Dialogue: 1,0:15:39.08,0:15:44.26,Dial_CH,,0,0,0,,超高性能超小型黃金探測器型魔法藥劑容器 出來
Dialogue: 1,0:15:46.34,0:15:48.94,Dial_CH,,0,0,0,,黃金探測器
Dialogue: 1,0:15:50.55,0:15:51.48,Dial_CH,,0,0,0,,那是甚麼
Dialogue: 1,0:15:51.78,0:15:55.73,Dial_CH,,0,0,0,,探測並指出附近黃金所在地的機器
Dialogue: 1,0:15:57.51,0:16:01.35,Dial_CH,,0,0,0,,它只會對精煉純金起反應
Dialogue: 1,0:16:01.67,0:16:03.52,Dial_CH,,0,0,0,,有效距離也很短
Dialogue: 1,0:16:03.52,0:16:05.86,Dial_CH,,0,0,0,,無法用來尋找金礦
Dialogue: 1,0:16:06.06,0:16:06.95,Dial_CH,,0,0,0,,嗯？
Dialogue: 1,0:16:07.79,0:16:09.24,Dial_CH,,0,0,0,,先試試再說
Dialogue: 1,0:16:09.63,0:16:12.43,Dial_CH,,0,0,0,,嗯 按下這個按鈕
Dialogue: 1,0:16:15.28,0:16:16.24,Dial_CH,,0,0,0,,在這邊
Dialogue: 1,0:16:18.88,0:16:21.90,Dial_CH,,0,0,0,,指到你錢包去了
Dialogue: 1,0:16:22.20,0:16:23.38,Dial_CH,,0,0,0,,改下設置
Dialogue: 1,0:16:23.38,0:16:26.33,Dial_CH,,0,0,0,,篩選範圍 300克以上的黃金
Dialogue: 1,0:16:30.23,0:16:31.36,Dial_CH,,0,0,0,,在樓上的房間
Dialogue: 1,0:16:32.67,0:16:33.58,Dial_CH,,0,0,0,,蕾耶特醬
Dialogue: 1,0:16:33.58,0:16:34.76,Dial_CH,,0,0,0,,乖乖等著哦
Dialogue: 1,0:16:34.98,0:16:36.03,Dial_CH,,0,0,0,,好
Dialogue: 1,0:16:40.43,0:16:41.10,Dial_CH,,0,0,0,,在這邊
Dialogue: 1,0:16:44.03,0:16:44.71,Dial_CH,,0,0,0,,就是這裡
Dialogue: 1,0:16:45.70,0:16:47.06,Dial_CH,,0,0,0,,金庫？
Dialogue: 1,0:16:53.60,0:16:54.67,Dial_CH,,0,0,0,,呃…
Dialogue: 1,0:16:55.31,0:16:58.73,Dial_CH,,0,0,0,,值錢的基本上都賣完了
Dialogue: 1,0:16:58.99,0:17:00.43,Dial_CH,,0,0,0,,看起來是這樣的
Dialogue: 1,0:17:01.55,0:17:03.81,Dial_CH,,0,0,0,,以防萬一 再打開看看吧
Dialogue: 1,0:17:04.47,0:17:05.03,Dial_CH,,0,0,0,,行吧
Dialogue: 1,0:17:09.21,0:17:12.08,Dial_CH,,0,0,0,,這就是我最後一點資金了
Dialogue: 1,0:17:12.95,0:17:14.99,Dial_CH,,0,0,0,,再等等
Dialogue: 1,0:17:15.35,0:17:18.36,Dial_CH,,0,0,0,,呃…把這個金庫除外
Dialogue: 1,0:17:22.58,0:17:25.98,Dial_CH,,0,0,0,,嗯 範圍內無對象
Dialogue: 1,0:17:26.50,0:17:27.88,Dial_CH,,0,0,0,,謝謝惠顧
Dialogue: 1,0:17:33.29,0:17:34.56,Dial_CH,,0,0,0,,很遺憾
Dialogue: 1,0:17:34.56,0:17:37.63,Dial_CH,,0,0,0,,這裡應該是沒有金條或者大量金幣了
Dialogue: 1,0:17:39.65,0:17:40.85,Dial_CH,,0,0,0,,不對 等等
Dialogue: 1,0:17:41.18,0:17:44.94,Dial_CH,,0,0,0,,剛才我探測的是300克以上的黃金
Dialogue: 1,0:17:45.52,0:17:47.49,Dial_CH,,0,0,0,,1枚金幣不到10克
Dialogue: 1,0:17:47.83,0:17:52.52,Dial_CH,,0,0,0,,也就是說 那裡頂多也就150克
Dialogue: 1,0:17:52.89,0:17:54.85,Dial_CH,,0,0,0,,探測器不該起反應
Dialogue: 1,0:17:55.21,0:17:56.22,Dial_CH,,0,0,0,,也就是說
Dialogue: 1,0:17:56.82,0:17:58.61,Dial_CH,,0,0,0,,篩選範圍500克以上
Dialogue: 1,0:18:03.03,0:18:04.07,Dial_CH,,0,0,0,,懂了
Dialogue: 1,0:18:05.89,0:18:06.51,Dial_CH,,0,0,0,,怎麼了
Dialogue: 1,0:18:11.49,0:18:13.06,Dial_CH,,0,0,0,,我知道錢藏在哪兒了
Dialogue: 1,0:18:13.35,0:18:14.31,Dial_CH,,0,0,0,,就是這裡
Dialogue: 1,0:18:14.84,0:18:16.87,Dial_CH,,0,0,0,,金庫所在的牆壁內
Dialogue: 1,0:18:17.03,0:18:18.68,Dial_CH,,0,0,0,,怎麼會放到那種地方…
Dialogue: 1,0:18:19.25,0:18:21.74,Dial_CH,,0,0,0,,該不會就是利用這個心理吧
Dialogue: 1,0:18:22.15,0:18:23.91,Dial_CH,,0,0,0,,開始鑿牆吧
Dialogue: 1,0:18:24.92,0:18:25.26,Dial_CH,,0,0,0,,嗯
Dialogue: 1,0:18:36.17,0:18:36.81,Dial_CH,,0,0,0,,哎呀
Dialogue: 1,0:18:40.73,0:18:42.64,Dial_CH,,0,0,0,,那我先告辭了
Dialogue: 1,0:18:42.73,0:18:44.65,Dial_CH,,0,0,0,,給我站住
Dialogue: 1,0:18:46.58,0:18:49.47,Dial_CH,,0,0,0,,乾脆把我埋到這個洞裡吧
Dialogue: 1,0:18:49.71,0:18:50.90,Dial_CH,,0,0,0,,抱歉
Dialogue: 1,0:18:51.43,0:18:52.85,Dial_CH,,0,0,0,,卡奧露姐姐
Dialogue: 1,0:18:53.18,0:18:54.66,Dial_CH,,0,0,0,,給我些藥
Dialogue: 1,0:18:55.97,0:18:57.47,Dial_CH,,0,0,0,,喉嚨疼
Dialogue: 1,0:18:57.98,0:18:59.48,Dial_CH,,0,0,0,,感冒了嗎
Dialogue: 1,0:18:59.81,0:19:00.81,Dial_CH,,0,0,0,,張大嘴讓我看看
Dialogue: 1,0:19:01.30,0:19:02.35,Dial_CH,,0,0,0,,不是
Dialogue: 1,0:19:03.66,0:19:04.32,Dial_CH,,0,0,0,,是這裡
Dialogue: 1,0:19:04.80,0:19:06.07,Dial_CH,,0,0,0,,被蟲子咬了嗎
Dialogue: 1,0:19:06.46,0:19:09.17,Dial_CH,,0,0,0,,嗯 撓了撓就開始疼了
Dialogue: 1,0:19:10.99,0:19:13.05,Dial_CH,,0,0,0,,專治蚊蟲叮咬
Dialogue: 1,0:19:15.65,0:19:16.73,Dial_CH,,0,0,0,,謝謝
Dialogue: 1,0:19:16.95,0:19:18.15,Dial_CH,,0,0,0,,嚇了我一跳
Dialogue: 1,0:19:18.43,0:19:21.75,Dial_CH,,0,0,0,,你說喉嚨疼 我還以為生病了
Dialogue: 1,0:19:22.08,0:19:24.44,Dial_CH,,0,0,0,,原來不是裡面是外面啊
Dialogue: 1,0:19:26.30,0:19:28.44,Dial_CH,,0,0,0,,不是裡面是外面…
Dialogue: 1,0:19:32.83,0:19:33.75,Dial_CH,,0,0,0,,中隊長先生
Dialogue: 1,0:19:34.02,0:19:36.39,Dial_CH,,0,0,0,,有沒有甚麼硬的東西 壞了也沒事的
Dialogue: 1,0:19:41.95,0:19:42.62,Dial_CH,,0,0,0,,喂
Dialogue: 1,0:19:43.05,0:19:44.15,Dial_CH,,0,0,0,,你在幹嘛
Dialogue: 1,0:19:50.88,0:19:52.37,Dial_CH,,0,0,0,,不是裡面 而是外面
Dialogue: 1,0:19:52.97,0:19:55.47,Dial_CH,,0,0,0,,寶藏就是金庫本身
Dialogue: 1,0:19:57.95,0:19:59.90,Dial_CH,,0,0,0,,父親 祖先
Dialogue: 1,0:19:59.90,0:20:02.46,Dial_CH,,0,0,0,,還有女神瑟蕾絲緹努
Dialogue: 1,0:20:02.82,0:20:04.70,Dial_CH,,0,0,0,,拉魯斯立克的人民
Dialogue: 1,0:20:04.70,0:20:06.62,Dial_CH,,0,0,0,,將跨過這次危機
Dialogue: 1,0:20:06.62,0:20:09.71,Dial_CH,,0,0,0,,雄赳赳氣昂昂地向著未來前進
Dialogue: 1,0:20:09.71,0:20:13.48,Dial_CH,,0,0,0,,但你這動不動就歉收陷入危機
Dialogue: 1,0:20:13.48,0:20:15.59,Dial_CH,,0,0,0,,早晚有一天得把這錢用盡
Dialogue: 1,0:20:15.59,0:20:17.17,Dial_CH,,0,0,0,,最後還不是要完
Dialogue: 1,0:20:17.39,0:20:18.02,Dial_CH,,0,0,0,,甚麼
Dialogue: 1,0:20:18.74,0:20:20.99,Dial_CH,,0,0,0,,破財消災
Dialogue: 1,0:20:21.21,0:20:23.75,Dial_CH,,0,0,0,,治標不治本
Dialogue: 1,0:20:23.99,0:20:25.58,Dial_CH,,0,0,0,,要從根本上解決問題
Dialogue: 1,0:20:27.18,0:20:28.75,Dial_CH,,0,0,0,,話是那麼說
Dialogue: 1,0:20:28.75,0:20:30.25,Dial_CH,,0,0,0,,那我該怎麼辦呢
Dialogue: 1,0:20:30.75,0:20:33.72,Dial_CH,,0,0,0,,認真分析一下以往歉收的原因
Dialogue: 1,0:20:34.12,0:20:35.90,Dial_CH,,0,0,0,,如果是因為冷夏
Dialogue: 1,0:20:36.14,0:20:39.42,Dial_CH,,0,0,0,,就從北方引進耐寒品種
Dialogue: 1,0:20:39.42,0:20:41.51,Dial_CH,,0,0,0,,花錢研究下栽培方法
Dialogue: 1,0:20:41.89,0:20:43.27,Dial_CH,,0,0,0,,如果是因為乾旱
Dialogue: 1,0:20:43.27,0:20:46.16,Dial_CH,,0,0,0,,可以深挖井 也可以從河流挖渠引水
Dialogue: 1,0:20:48.00,0:20:50.14,Dial_CH,,0,0,0,,分散風險 別光種麥子
Dialogue: 1,0:20:50.14,0:20:52.83,Dial_CH,,0,0,0,,玉米 薯類 都可以種
Dialogue: 1,0:20:53.22,0:20:57.08,Dial_CH,,0,0,0,,薯類雖然不值錢
Dialogue: 1,0:20:57.32,0:20:59.53,Dial_CH,,0,0,0,,但命都沒了還要甚麼錢
Dialogue: 1,0:20:59.53,0:21:00.10,Dial_CH,,0,0,0,,是不是
Dialogue: 1,0:21:00.31,0:21:01.53,Dial_CH,,0,0,0,,原來如此
Dialogue: 1,0:21:02.01,0:21:04.19,Dial_CH,,0,0,0,,把錢好好利用起來吧
Dialogue: 1,0:21:04.68,0:21:07.91,Dial_CH,,0,0,0,,嗯 1枚小金幣的活兒差不多就這樣了
Dialogue: 1,0:21:09.12,0:21:10.83,Dial_CH,,0,0,0,,今天真是謝謝你了
Dialogue: 1,0:21:11.24,0:21:14.55,Dial_CH,,0,0,0,,我準備了晚餐 吃完再走吧
Dialogue: 1,0:21:16.38,0:21:17.55,Dial_CH,,0,0,0,,呃…
Dialogue: 1,0:21:18.08,0:21:19.11,Dial_CH,,0,0,0,,我來介紹一下
Dialogue: 1,0:21:19.39,0:21:22.30,Dial_CH,,0,0,0,,這是我妻子 還有兒子奧古斯坦和克羅維斯
Dialogue: 1,0:21:22.77,0:21:24.37,Dial_CH,,0,0,0,,怎麼全家都來了
Dialogue: 1,0:21:25.39,0:21:26.04,Dial_CH,,0,0,0,,咦
Dialogue: 1,0:21:26.87,0:21:28.04,Dial_CH,,0,0,0,,該不會
Dialogue: 1,0:21:28.95,0:21:29.98,Dial_CH,,0,0,0,,魅惑到他們了嗎
Dialogue: 1,0:21:30.54,0:21:32.21,Dial_CH,,0,0,0,,看到了 我看到了
Dialogue: 1,0:21:32.21,0:21:35.32,Dial_CH,,0,0,0,,嫁到子爵家後的未來
Dialogue: 1,0:21:36.20,0:21:37.84,Dial_CH,,0,0,0,,說不上富裕
Dialogue: 1,0:21:38.07,0:21:40.26,Dial_CH,,0,0,0,,忙於推進治水和農業改革
Dialogue: 1,0:21:40.72,0:21:43.92,Dial_CH,,0,0,0,,成為中隊長先生眼裡的好兒媳
Dialogue: 1,0:21:44.28,0:21:47.33,Dial_CH,,0,0,0,,生兒育女 受到民眾愛戴
Dialogue: 1,0:21:47.80,0:21:50.08,Dial_CH,,0,0,0,,嗯 還挺不錯的
Dialogue: 1,0:21:50.40,0:21:52.83,Dial_CH,,0,0,0,,卡奧露小姐 我有一事相求
Dialogue: 1,0:21:52.83,0:21:53.96,Dial_CH,,900,0,0,,來了
Dialogue: 1,0:21:53.60,0:21:55.10,Dial_CH,,0,600,0,,不 先等一下 哥哥
Dialogue: 1,0:21:55.29,0:21:56.13,Dial_CH,,0,0,0,,我先
Dialogue: 1,0:21:56.32,0:21:57.56,Dial_CH,,0,0,0,,不對 我先
Dialogue: 1,0:21:57.56,0:21:58.84,Dial_CH,,0,0,0,,不對 是我
Dialogue: 1,0:21:59.18,0:22:01.39,Dial_CH2,,0,900,0,,當哥哥的不能讓著點弟弟嗎
Dialogue: 1,0:21:59.47,0:22:03.09,Dial_CH,,0,0,0,,是時候說那句做夢都想說的臺詞了
Dialogue: 1,0:22:03.97,0:22:09.41,Dial_CH,,0,0,0,,拜託了 請不要為了我而爭吵
Dialogue: 1,0:22:11.42,0:22:12.08,Dial_CH2,,0,500,0,,夠了
Dialogue: 1,0:22:12.08,0:22:12.63,Dial_CH,,0,0,0,,拜託了
Dialogue: 1,0:22:12.63,0:22:13.37,Dial_CH,,0,0,0,,卡奧露小姐
Dialogue: 1,0:22:13.86,0:22:16.40,Dial_CH,,0,0,0,,請分我瓶軍人病治療藥
Dialogue: 1,0:22:17.41,0:22:19.06,Dial_CH,,0,0,0,,嗯 猜到了
Dialogue: 1,0:22:20.46,0:22:22.74,Dial_CH,,0,0,0,,混蛋
Dialogue: 1,0:22:31.58,0:22:34.52,Dial_CH,,0,0,0,,哎呀 今天也是忙碌的一天
Dialogue: 1,0:22:35.22,0:22:38.33,Dial_CH,,0,0,0,,感覺離輕鬆是越來越遠了
Dialogue: 1,0:22:38.93,0:22:41.67,Dial_CH,,0,0,0,,謝謝
Dialogue: 1,0:22:41.92,0:22:43.99,Dial_CH,,0,0,0,,不過現在這樣也不錯
Dialogue: 1,0:22:45.96,0:22:48.29,Dial_CH,,0,0,0,,明早還要做便當
Dialogue: 1,0:22:48.29,0:22:49.53,Dial_CH,,0,0,0,,得趕緊睡了
Dialogue: 1,0:22:49.97,0:22:51.94,Dial_CH,,0,0,0,,卡奧露 卡奧露
Dialogue: 1,0:22:54.50,0:22:55.16,Dial_CH,,0,0,0,,加姆
Dialogue: 1,0:22:55.75,0:22:56.28,Dial_CH,,0,0,0,,怎…
Dialogue: 1,0:22:56.28,0:22:58.66,Dial_CH,,0,0,0,,馬露和摩露出事了
Dialogue: 1,0:23:09.40,0:23:10.53,Dial_CH,,0,0,0,,好燙
Dialogue: 1,0:23:10.88,0:23:12.15,Dial_CH,,0,0,0,,不是普通的感冒
Dialogue: 1,0:23:12.48,0:23:14.86,Dial_CH,,0,0,0,,剛白天還沒事 突然就這樣了
Dialogue: 1,0:23:16.99,0:23:17.54,Dial_CH,,0,0,0,,加姆
Dialogue: 1,0:23:20.22,0:23:20.91,Dial_CH,,0,0,0,,難道是
Dialogue: 1,0:23:28.17,0:23:30.65,Dial_CH,,0,0,0,,媽媽 喉嚨好疼
Dialogue: 1,0:23:36.13,0:23:37.40,Dial_CH,,0,0,0,,傳染病？
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,Comment

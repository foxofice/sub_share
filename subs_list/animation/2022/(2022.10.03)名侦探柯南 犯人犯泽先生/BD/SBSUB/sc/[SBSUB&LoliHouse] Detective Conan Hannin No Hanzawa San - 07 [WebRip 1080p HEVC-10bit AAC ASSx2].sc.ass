Dialogue: 0,0:01:31.87,0:01:34.72,DefaultSingle-S,,0,0,0,,		决定了  我决不回头
Dialogue: 0,0:01:35.35,0:01:38.17,DefaultSingle-S,,0,0,0,,		这是纠结很久之后做出的决定  我不会后悔
Dialogue: 0,0:01:38.92,0:01:40.51,DefaultSingle-S,,0,0,0,,		现在正是行动之时
Dialogue: 0,0:01:41.26,0:01:44.57,DefaultSingle-S,,0,0,0,,		喂  我看到了您贴的招聘启示
Dialogue: 0,0:01:44.57,0:01:45.14,DefaultSingle-S,,0,0,0,,		是的
Dialogue: 0,0:01:45.27,0:01:47.16,DefaultSingle-S,,0,0,0,,		我想应聘这份工作
Dialogue: 0,0:01:47.16,0:01:47.69,DefaultSingle-S,,0,0,0,,		是的
Dialogue: 0,0:01:47.69,0:01:48.58,DefaultSingle-S,,0,0,0,,		等电话？好的
Dialogue: 0,0:01:56.27,0:01:57.44,DefaultSingle-S,,0,0,0,,		电话打完了
Dialogue: 0,0:01:57.99,0:01:59.09,DefaultSingle-S,,0,0,0,,		开业员工
Dialogue: 0,0:01:59.44,0:02:01.34,DefaultSingle-S,,0,0,0,,		大家的起点都一样
Dialogue: 0,0:02:01.34,0:02:03.26,DefaultSingle-S,,0,0,0,,		不会有人对着我装前辈
Dialogue: 0,0:02:03.26,0:02:05.75,DefaultSingle-S,,0,0,0,,		大家都是新人  就算犯错也能互相鼓励
Dialogue: 0,0:02:05.99,0:02:06.71,DefaultSingle-S,,0,0,0,,		别在意
Dialogue: 0,0:02:06.71,0:02:08.17,DefaultSingle-S,,0,0,0,,		我也犯过同样的错
Dialogue: 0,0:02:08.17,0:02:10.15,DefaultSingle-S,,0,0,0,,		简直太适合我了
Dialogue: 0,0:02:11.70,0:02:14.05,DefaultSingle-S,,0,0,0,,		我要在这个米花町杀死那个男人
Dialogue: 0,0:02:14.79,0:02:15.43,DefaultSingle-S,,0,0,0,,		但是
Dialogue: 0,0:02:15.63,0:02:18.73,DefaultSingle-S,,0,0,0,,		我现在连他在这座城市的哪个地方都还不知道
Dialogue: 0,0:02:19.40,0:02:22.03,DefaultSingle-S,,0,0,0,,		需要的只有杀意和执着
Dialogue: 0,0:02:22.27,0:02:23.06,DefaultSingle-S,,0,0,0,,		以及…
Dialogue: 0,0:02:23.81,0:02:25.45,DefaultSingle-S,,0,0,0,,		稳定的收入
Dialogue: 0,0:02:25.95,0:02:27.46,DefaultSingle-S,,0,0,0,,		你想在哪个时间段上班
Dialogue: 0,0:02:27.46,0:02:29.67,DefaultSingle-S,,0,0,0,,		尽可能白天  不过晚上也没问题
Dialogue: 0,0:02:30.12,0:02:31.71,DefaultSingle-S,,0,0,0,,		一周想上五天班
Dialogue: 0,0:02:35.88,0:02:36.13,DefaultSingle-S,,0,0,0,,		喂
Dialogue: 0,0:02:36.13,0:02:39.51,DefaultSingle-S,,0,0,0,,		三天后有开业员工全体参加的培训会
Dialogue: 0,0:02:39.51,0:02:39.84,DefaultSingle-S,,0,0,0,,		好的
Dialogue: 0,0:02:39.84,0:02:40.64,DefaultSingle-S,,0,0,0,,		时间是…
Dialogue: 0,0:02:40.64,0:02:41.34,DefaultSingle-S,,0,0,0,,		好的  好的
Dialogue: 0,0:02:41.97,0:02:43.93,DefaultSingle-S,,0,0,0,,		找到工作啦
Dialogue: 0,0:02:45.01,0:02:46.60,DefaultSingle-S,,0,0,0,,		犯泽先生好开心啊
Dialogue: 0,0:02:46.60,0:02:48.18,DefaultSingle-S,,0,0,0,,		找到工作了吗
Dialogue: 0,0:02:49.06,0:02:51.27,DefaultSingle-S,,0,0,0,,		今天开派对啦
Dialogue: 0,0:02:53.02,0:02:55.48,DefaultSingle-S,,0,0,0,,		其他兼职同事都是什么人啊
Dialogue: 0,0:02:55.48,0:02:58.03,DefaultSingle-S,,0,0,0,,		是同龄人吗  能不能友好相处啊
Dialogue: 0,0:02:58.03,0:03:00.11,DefaultSingle-S,,0,0,0,,		不  说不定会和很棒的人…
Dialogue: 0,0:03:00.15,0:03:01.53,DefaultSingle-S,,0,0,0,,		来一场命运的邂逅
Dialogue: 0,0:03:10.75,0:03:12.38,DefaultSingle-S,,0,0,0,,		店…长…
Dialogue: 0,0:03:12.63,0:03:16.71,DefaultSingle-S,,0,0,0,,		杀害店长的犯人就在我们开业员工当中
Dialogue: 0,0:03:19.80,0:03:21.13,DefaultSingle-S,,0,0,0,,		我  我头一次看到尸体
Dialogue: 0,0:03:21.13,0:03:22.59,DefaultSingle-S,,0,0,0,,		也头一次看到凶案现场
Dialogue: 0,0:03:22.59,0:03:23.97,DefaultSingle-S,,0,0,0,,		这是血腥味吗
Dialogue: 0,0:03:24.30,0:03:27.47,DefaultSingle-S,,0,0,0,,		哎呀  这就是日式的员工培训会吗
Dialogue: 0,0:03:27.47,0:03:30.56,DefaultSingle-S,,0,0,0,,		身为兼职员工  必须预想到所有情况
Dialogue: 0,0:03:31.06,0:03:31.94,DefaultSingle-S,,0,0,0,,		鲁米诺试剂
Dialogue: 0,0:03:31.94,0:03:34.69,DefaultSingle-S,,0,0,0,,		不愧是前验尸官  拿了个好东西啊
Dialogue: 0,0:03:34.69,0:03:37.64,DefaultSingle-S,,0,0,0,,		对着心脏一刀毙命  是谋杀
Dialogue: 0,0:03:38.03,0:03:39.49,DefaultSingle-S,,0,0,0,,		只有我一个人在害怕？
Dialogue: 0,0:03:39.49,0:03:40.90,DefaultSingle-S,,0,0,0,,		他们怎么全都轻车熟路的
Dialogue: 0,0:03:41.20,0:03:44.12,DefaultSingle-S,,0,0,0,,		店长死亡的时候  我们全都在同一个地方这个那个
Dialogue: 0,0:03:44.12,0:03:45.74,DefaultSingle-S,,0,0,0,,		犯人是趁他不备这个那个
Dialogue: 0,0:03:45.95,0:03:48.58,DefaultSingle-S,,0,0,0,,		是啊  我们开业员工的这个那个
Dialogue: 0,0:03:48.58,0:03:50.62,DefaultSingle-S,,0,0,0,,		那么当然就会这个那个
Dialogue: 0,0:03:50.62,0:03:52.25,DefaultSingle-S,,0,0,0,,		门锁被店长这个那个
Dialogue: 0,0:03:52.25,0:03:54.13,DefaultSingle-S,,0,0,0,,	{\a6\fs54}	那难道是这个那个
Dialogue: 0,0:03:54.13,0:03:55.59,DefaultSingle-S,,0,0,0,,	{\a6\fs54}	这个那个这个那个
Dialogue: 0,0:03:53.37,0:03:56.42,DefaultSingle-S,,0,0,0,,		内容过于高端  我一点都听不懂
Dialogue: 0,0:03:56.79,0:03:58.59,DefaultSingle-S,,0,0,0,,		也就是说  犯人是…
Dialogue: 0,0:04:00.13,0:04:01.26,DefaultSingle-S,,0,0,0,,		我是犯人？
Dialogue: 0,0:04:01.26,0:04:02.55,DefaultSingle-S,,0,0,0,,		不对  我不是犯人
Dialogue: 0,0:04:02.55,0:04:04.55,DefaultSingle-S,,0,0,0,,		我还不是犯人  我还是清白的
Dialogue: 0,0:04:04.55,0:04:06.22,DefaultSingle-S,,0,0,0,,		对  犯人是…
Dialogue: 0,0:04:06.22,0:04:08.43,DefaultSingle-S,,0,0,0,,		正打算丢掉凶器的…
Dialogue: 0,0:04:09.35,0:04:10.89,DefaultSingle-S,,0,0,0,,		犯间先生
Dialogue: 0,0:04:10.89,0:04:13.85,DefaultSingle-S,,0,0,0,,		你首先把时钟的指针这个那个这个那个
Dialogue: 0,0:04:13.85,0:04:15.10,DefaultSingle-S,,0,0,0,,		伪造了不在场证明
Dialogue: 0,0:04:15.10,0:04:17.90,DefaultSingle-S,,0,0,0,,	{\a6\fs54}	然后把凶器这个那个这个那个
Dialogue: 0,0:04:15.10,0:04:15.73,DefaultSingle-S,,0,0,0,,		好厉害
Dialogue: 0,0:04:15.73,0:04:17.90,DefaultSingle-S,,0,0,0,,		他应该是在搞推理秀  虽然我听不懂
Dialogue: 0,0:04:19.98,0:04:21.69,DefaultSingle-S,,0,0,0,,		对不起  我们装作在怀疑你
Dialogue: 0,0:04:21.82,0:04:24.74,DefaultSingle-S,,0,0,0,,		谎言就像强效药  对犯人非常有效
Dialogue: 0,0:04:25.24,0:04:26.82,DefaultSingle-S,,0,0,0,,		好华丽的推理
Dialogue: 0,0:04:26.82,0:04:29.62,DefaultSingle-S,,0,0,0,,		居然在警察赶到之前就破案
Dialogue: 0,0:04:29.62,0:04:31.33,DefaultSingle-S,,0,0,0,,		简直就像…侦探
Dialogue: 0,0:04:31.75,0:04:33.08,DefaultSingle-S,,0,0,0,,		嘘
Dialogue: 0,0:04:33.25,0:04:35.29,DefaultSingle-S,,0,0,0,,		我的侦探身份要保密
Dialogue: 0,0:04:35.29,0:04:38.67,DefaultSingle-S,,0,0,0,,		我正在卧底调查这家公司的负面传闻
Dialogue: 0,0:04:38.67,0:04:39.80,DefaultSingle-S,,0,0,0,,		千万别说出去啊
Dialogue: 0,0:04:39.80,0:04:42.30,DefaultSingle-S,,0,0,0,,		这都被你看穿了啊  你也是侦探吗
Dialogue: 0,0:04:42.59,0:04:44.47,DefaultSingle-S,,0,0,0,,		他们就是我的同事？
Dialogue: 0,0:04:44.47,0:04:46.22,DefaultSingle-S,,0,0,0,,		我听说过  侦探就是…
Dialogue: 0,0:04:46.55,0:04:47.89,DefaultSingle-S,,0,0,0,,		拥有敏锐的洞察力
Dialogue: 0,0:04:47.89,0:04:50.93,DefaultSingle-S,,0,0,0,,		超群的记忆力  注意力  判断力
Dialogue: 0,0:04:50.93,0:04:54.39,DefaultSingle-S,,0,0,0,,		还有能制服犯人的过人体力
Dialogue: 0,0:04:54.77,0:04:55.27,DefaultSingle-S,,0,0,0,,		真是…
Dialogue: 0,0:04:55.27,0:04:56.94,DefaultSingle-S,,0,0,0,,		真是太可靠了
Dialogue: 0,0:04:57.40,0:04:59.44,DefaultSingle-S,,0,0,0,,		我叫犯泽  今后也请多关照
Dialogue: 0,0:04:59.44,0:04:59.98,DefaultSingle-S,,0,0,0,,		请多关照
Dialogue: 0,0:04:59.98,0:05:00.44,DefaultSingle-S,,0,0,0,,		请多关照
Dialogue: 0,0:05:00.44,0:05:00.94,DefaultSingle-S,,0,0,0,,		请多关照
Dialogue: 0,0:05:00.94,0:05:01.73,DefaultSingle-S,,0,0,0,,		请多关照
Dialogue: 0,0:05:01.94,0:05:02.94,DefaultSingle-S,,0,0,0,,		开业当天
Dialogue: 0,0:05:02.94,0:05:03.90,DefaultSingle-S,,0,0,0,,		欢迎光临
Dialogue: 0,0:05:04.28,0:05:05.66,DefaultSingle-S,,0,0,0,,		好多人啊
Dialogue: 0,0:05:05.66,0:05:07.37,DefaultSingle-S,,0,0,0,,		因为这里发生过杀人案
Dialogue: 0,0:05:07.37,0:05:09.62,DefaultSingle-S,,0,0,0,,		所以搞了开业酬宾  租碟1张10日元
Dialogue: 0,0:05:09.62,0:05:11.20,DefaultSingle-S,,0,0,0,,		这是新店长的决定
Dialogue: 0,0:05:12.08,0:05:13.79,DefaultSingle-S,,0,0,0,,		好厉害  收银极其精准
Dialogue: 0,0:05:13.91,0:05:16.00,DefaultSingle-S,,0,0,0,,		请问一下《爆炸牧童》在哪里啊
Dialogue: 0,0:05:16.00,0:05:19.50,DefaultSingle-S,,0,0,0,,		6号柜从上面数第2层  从右边数第32张
Dialogue: 0,0:05:19.50,0:05:20.55,DefaultSingle-S,,0,0,0,,		这么快就记住位置了吗
Dialogue: 0,0:05:24.34,0:05:25.17,DefaultSingle-S,,0,0,0,,		我们去
Dialogue: 0,0:05:25.17,0:05:26.47,DefaultSingle-S,,0,0,0,,		归还碟片
Dialogue: 0,0:05:26.84,0:05:29.01,DefaultSingle-S,,0,0,0,,		这才第一天  没有归还的碟片吧
Dialogue: 0,0:05:29.05,0:05:31.10,DefaultSingle-S,,0,0,0,,		请问有《奇幻动物》吗
Dialogue: 0,0:05:31.10,0:05:32.35,DefaultSingle-S,,0,0,0,,		有的  位置在…
Dialogue: 0,0:05:32.35,0:05:36.44,DefaultSingle-S,,0,0,0,,		别看奇幻片了  要不要看看疯狂死人的悬疑片呢
Dialogue: 0,0:05:36.44,0:05:37.48,DefaultSingle-S,,0,0,0,,		我带您去找
Dialogue: 0,0:05:37.48,0:05:39.81,DefaultSingle-S,,0,0,0,,		我推荐的十佳影片是…
Dialogue: 0,0:05:39.94,0:05:40.73,DefaultSingle-S,,0,0,0,,		茂木先生
Dialogue: 0,0:05:40.86,0:05:41.82,DefaultSingle-S,,0,0,0,,		收银台排起队了
Dialogue: 0,0:05:42.82,0:05:44.82,DefaultSingle-S,,0,0,0,,		正经工作的只有白马
Dialogue: 0,0:05:47.28,0:05:50.66,DefaultSingle-S,,0,0,0,,		我收到联系说有个疑难案件  先早退了
Dialogue: 0,0:05:50.66,0:05:52.33,DefaultSingle-S,,0,0,0,,		我把华生留下了
Dialogue: 0,0:05:53.37,0:05:54.54,DefaultSingle-S,,0,0,0,,		白马
Dialogue: 0,0:05:55.08,0:05:56.46,DefaultSingle-S,,0,0,0,,		老鹰在敲收银机
Dialogue: 0,0:05:56.46,0:05:57.33,DefaultSingle-S,,0,0,0,,		好帅
Dialogue: 0,0:05:57.33,0:05:58.25,DefaultSingle-S,,0,0,0,,		好可爱
Dialogue: 0,0:05:59.75,0:06:01.13,DefaultSingle-S,,0,0,0,,		这是什么  好厉害
Dialogue: 0,0:06:01.13,0:06:02.13,DefaultSingle-S,,0,0,0,,		好罕见
Dialogue: 0,0:06:02.13,0:06:03.13,DefaultSingle-S,,0,0,0,,		去看看吧
Dialogue: 0,0:06:05.59,0:06:07.93,DefaultSingle-S,,0,0,0,,		店员请注意  收银台请求支援
Dialogue: 0,0:06:07.93,0:06:10.18,DefaultSingle-S,,0,0,0,,		店员请注意  收银台请求支援
Dialogue: 0,0:06:10.39,0:06:11.39,DefaultSingle-S,,0,0,0,,		侦探
Dialogue: 0,0:06:11.39,0:06:15.98,DefaultSingle-S,,0,0,0,,		给我干活啊
Dialogue: 0,0:06:21.61,0:06:21.94,DefaultSingle-S,,0,0,0,,		喂
Dialogue: 0,0:06:21.94,0:06:23.36,DefaultSingle-S,,0,0,0,,		喂  兼职领班？
Dialogue: 0,0:06:23.36,0:06:24.94,DefaultSingle-S,,0,0,0,,		是…我不是兼职领班
Dialogue: 0,0:06:24.94,0:06:26.99,DefaultSingle-S,,0,0,0,,		我被卷入了案件
Dialogue: 0,0:06:26.99,0:06:29.07,DefaultSingle-S,,0,0,0,,		抱歉  你今天能跟我换个班吗
Dialogue: 0,0:06:29.41,0:06:33.16,DefaultSingle-S,,0,0,0,,		可是…我连上五天班了  今天难得休息
Dialogue: 0,0:06:33.37,0:06:34.54,DefaultSingle-S,,0,0,0,,		拜托了  兼职领班
Dialogue: 0,0:06:34.54,0:06:36.87,DefaultSingle-S,,0,0,0,,		有个女孩被绑架了  正在等待营救
Dialogue: 0,0:06:36.87,0:06:38.83,DefaultSingle-S,,0,0,0,,		绑架犯点名要见我
Dialogue: 0,0:06:42.34,0:06:44.75,DefaultSingle-S,,0,0,0,,		好吧  你去救那个女孩吧
Dialogue: 0,0:06:44.75,0:06:45.50,DefaultSingle-S,,0,0,0,,		那是当然
Dialogue: 0,0:06:45.50,0:06:46.92,DefaultSingle-S,,0,0,0,,		多谢了  兼职领班
Dialogue: 0,0:06:46.92,0:06:48.63,DefaultSingle-S,,0,0,0,,		我不是兼职领班…
Dialogue: 0,0:06:53.18,0:06:56.89,DefaultSingle-S,,0,0,0,,		混蛋侦探
Dialogue: 0,0:06:59.52,0:07:00.77,DefaultSingle-S,,0,0,0,,		再见啦
Dialogue: 0,0:08:32.15,0:08:33.90,DefaultSingle-S,,0,0,0,,		真是的  开什么玩笑啊
Dialogue: 0,0:08:34.03,0:08:36.53,DefaultSingle-S,,0,0,0,,		我怎么能一直被区区侦探小瞧下去
Dialogue: 0,0:08:36.53,0:08:37.32,DefaultSingle-S,,0,0,0,,		所以说
Dialogue: 0,0:08:37.32,0:08:40.54,DefaultSingle-S,,0,0,0,,		就算是在恶搞国民级推理动画  认真起来也是能成事的
Dialogue: 0,0:08:40.54,0:08:42.00,DefaultSingle-S,,0,0,0,,		下集我要证明这一点
Dialogue: 0,0:08:42.00,0:08:44.71,DefaultSingle-S,,0,0,0,,		标题就叫「下集柯南提示  毛球」
Dialogue: 0,0:08:44.71,0:08:47.79,DefaultSingle-S,,0,0,0,,		足以碾压某个猫形机器人和某只黄色电老鼠的
Dialogue: 0,0:08:47.79,0:08:51.26,DefaultSingle-S,,0,0,0,,		必定人气爆棚的秘密武器终于要登场了
Dialogue: 0,0:08:51.26,0:08:53.97,DefaultSingle-S,,0,0,0,,		对我呼来唤去的混蛋侦探
Dialogue: 0,0:08:53.97,0:08:57.26,DefaultSingle-S,,0,0,0,,		你们就洗干净脖子  漱好口  用肥皂把手洗干净
Dialogue: 0,0:08:57.26,0:08:58.80,DefaultSingle-S,,0,0,0,,		再保持社交距离等着我
Dialogue: 0,0:08:58.80,0:08:59.93,DefaultSingle-S,,0,0,0,,		紧跟时代
Dialogue: 0,0:01:36.37,0:01:39.37,DefaultSingle-S,,0,0,0,,

Comment: 0,0:04:51.89,0:04:51.89,TEATIME-OP-BOTTOM,,0,0,0,,
Dialogue: 0,0:04:51.90,0:04:53.94,TEATIME-OP-BOTTOM,,0,0,0,,Get the Volume up
Dialogue: 0,0:04:53.94,0:04:55.90,TEATIME-OP-BOTTOM,,0,0,0,,飛馳於失去色彩的Highway
Dialogue: 0,0:04:55.90,0:04:59.95,TEATIME-OP-BOTTOM,,0,0,0,,在停滯的時間中 turn me on
Dialogue: 0,0:04:59.95,0:05:02.07,TEATIME-OP-BOTTOM,,0,0,0,,the truth is always blind
Dialogue: 0,0:05:02.07,0:05:03.99,TEATIME-OP-BOTTOM,,0,0,0,,虛假的話語
Dialogue: 0,0:05:03.99,0:05:08.08,TEATIME-OP-BOTTOM,,0,0,0,,也重疊於今日 聲音消散
Dialogue: 0,0:05:08.83,0:05:10.54,TEATIME-OP-BOTTOM,,0,0,0,,急切渴求的理由
Dialogue: 0,0:05:10.83,0:05:13.29,TEATIME-OP-BOTTOM,,0,0,0,,也在城市天空的盡頭
Dialogue: 0,0:05:13.29,0:05:17.59,TEATIME-OP-BOTTOM,,0,0,0,,清晰可見
Dialogue: 0,0:05:17.59,0:05:20.13,TEATIME-OP-BOTTOM,,0,0,0,,世界Like a Shooting Star
Dialogue: 0,0:05:20.13,0:05:22.18,TEATIME-OP-BOTTOM,,0,0,0,,若知曉心願
Dialogue: 0,0:05:22.18,0:05:23.97,TEATIME-OP-BOTTOM,,0,0,0,,不論何人
Dialogue: 0,0:05:23.97,0:05:26.51,TEATIME-OP-BOTTOM,,0,0,0,,都會深陷瞬間而永恆的夢
Dialogue: 0,0:05:26.51,0:05:28.02,TEATIME-OP-BOTTOM,,0,0,0,,若知曉「哀傷」
Dialogue: 0,0:05:28.02,0:05:30.31,TEATIME-OP-BOTTOM,,0,0,0,,便能回歸零點Tears in Lies
Dialogue: 0,0:05:30.31,0:05:34.02,TEATIME-OP-BOTTOM,,0,0,0,,即便知曉善惡之罪
Dialogue: 0,0:05:34.02,0:05:40.82,TEATIME-OP-BOTTOM,,0,0,0,,也要抬頭鎖定目標
Comment: 0,0:12:13.75,0:12:16.76,TEATIME-ED-BOTTOM,,0,0,0,,
Dialogue: 0,0:12:16.72,0:12:21.68,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	無色透明的我
Dialogue: 0,0:12:22.10,0:12:26.64,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	駐足於緋紅的天空下
Dialogue: 0,0:12:27.64,0:12:34.48,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便憎惡這不近人情的世界
Dialogue: 0,0:12:34.90,0:12:38.57,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也無法逃離 Decided
Dialogue: 0,0:12:39.41,0:12:43.95,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	將手伸向光芒
Dialogue: 0,0:12:39.41,0:12:43.95,TEATIME-ED-BOTTOM,ED,0,0,0,,{\pos(1034,1032)}	{\blur3\fs34}	明天
Dialogue: 0,0:12:43.95,0:12:48.91,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday
Dialogue: 0,0:12:48.91,0:12:54.21,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	不懈追逐 仍遙不可及
Dialogue: 0,0:12:54.21,0:12:59.84,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便想要守護之物不復存在
Dialogue: 0,0:13:00.01,0:13:04.47,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也只能繼續掙扎
Dialogue: 0,0:13:04.47,0:13:05.97,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	你聽
Dialogue: 0,0:13:05.97,0:13:10.73,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, promise to yourself
Dialogue: 0,0:13:10.73,0:13:16.19,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	用無數張面孔塗改未來
Dialogue: 0,0:13:16.19,0:13:23.82,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3\fad(0,200}	將一去不返的時光深藏於心
Comment: 0,0:03:08.00,0:03:08.00,Title,,0,0,0,,
Dialogue: 0,0:04:51.90,0:04:53.94,TEATIME-OP-TOP,,0,0,0,,Get the Volume up
Dialogue: 0,0:04:53.94,0:04:55.90,TEATIME-OP-TOP,,0,0,0,,色を無くしたHighway
Dialogue: 0,0:04:55.90,0:04:59.95,TEATIME-OP-TOP,,0,0,0,,止まってしまった時間に turn me on
Dialogue: 0,0:04:59.95,0:05:02.07,TEATIME-OP-TOP,,0,0,0,,the truth is always blind
Dialogue: 0,0:05:02.07,0:05:03.99,TEATIME-OP-TOP,,0,0,0,,偽りの声も
Dialogue: 0,0:05:03.99,0:05:08.08,TEATIME-OP-TOP,,0,0,0,,重なる今日に音が消える
Dialogue: 0,0:05:08.83,0:05:10.54,TEATIME-OP-TOP,,0,0,0,,焦がれ求む理由も
Dialogue: 0,0:05:10.83,0:05:13.29,TEATIME-OP-TOP,,0,0,0,,街の空の果てに
Dialogue: 0,0:05:13.29,0:05:17.59,TEATIME-OP-TOP,,0,0,0,,見える
Dialogue: 0,0:05:17.59,0:05:20.13,TEATIME-OP-TOP,,0,0,0,,世界はLike a Shooting Star
Dialogue: 0,0:05:20.13,0:05:22.18,TEATIME-OP-TOP,,0,0,0,,願いを知れば
Dialogue: 0,0:05:22.18,0:05:23.97,TEATIME-OP-TOP,,0,0,0,,一瞬が永遠の
Dialogue: 0,0:05:23.97,0:05:26.51,TEATIME-OP-TOP,,0,0,0,,夢に誰も捉われる
Dialogue: 0,0:05:26.51,0:05:28.02,TEATIME-OP-TOP,,0,0,0,,「哀」を知れば
Dialogue: 0,0:05:28.02,0:05:30.31,TEATIME-OP-TOP,,0,0,0,,ゼロに戻るTears in Lies
Dialogue: 0,0:05:30.31,0:05:34.02,TEATIME-OP-TOP,,0,0,0,,善悪の罪を知る
Dialogue: 0,0:05:34.02,0:05:40.82,TEATIME-OP-TOP,,0,0,0,,それでも顔上げ狙い定める
Dialogue: 0,0:05:11.95,0:05:11.95,Title,,0,0,0,,

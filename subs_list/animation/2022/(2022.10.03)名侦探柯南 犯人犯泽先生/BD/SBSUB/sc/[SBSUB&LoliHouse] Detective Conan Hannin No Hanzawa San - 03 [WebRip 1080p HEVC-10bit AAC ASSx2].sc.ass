Dialogue: 0,0:02:04.40,0:02:06.40,DefaultSingle-S,,0,0,0,,{\pos(1798,528)}	{\fn@方正粗圆_GBK\frz-90\bord4\shad0}岛根县 犯泽的老家
Dialogue: 0,0:03:21.14,0:03:24.48,DefaultSingle-S,,0,0,0,,	{\an8\c&H4562CA&\3c&HAC7B81&\4c&H85F1F7&\bord5\shad2\fs48}消灭犯人 消灭犯人
Dialogue: 0,0:03:36.74,0:03:39.07,DefaultSingle-S,,0,0,0,,{\pos(1808,76)}	{\fs40}消灭犯人
Dialogue: 0,0:06:57.23,0:07:00.98,DefaultSingle-S,,0,0,0,,{\pos(598,1056)}	欢迎再来
Dialogue: 0,0:01:35.71,0:01:37.30,DefaultSingle-S,,0,0,0,,		请问您有什么事
Dialogue: 0,0:01:37.59,0:01:40.33,DefaultSingle-S,,0,0,0,,		什么事？
Dialogue: 0,0:01:42.10,0:01:44.01,DefaultSingle-S,,0,0,0,,		我要变更住址
Dialogue: 0,0:01:53.13,0:01:57.24,DefaultSingle-S,,0,0,0,,		请填写这张表  拿着这个号码牌等待
Dialogue: 0,0:01:57.54,0:01:58.20,DefaultSingle-S,,0,0,0,,		好的
Dialogue: 0,0:02:02.44,0:02:04.39,DefaultSingle-S,,0,0,0,,		要排队是意料之中
Dialogue: 0,0:02:06.75,0:02:09.53,DefaultSingle-S,,0,0,0,,		大城市的市政府肯定很多人
Dialogue: 0,0:02:09.53,0:02:11.44,DefaultSingle-S,,0,0,0,,		你可要趁上午去
Dialogue: 0,0:02:11.44,0:02:13.72,DefaultSingle-S,,0,0,0,,		我老家的老妈也叮嘱过了
Dialogue: 0,0:02:13.72,0:02:14.61,DefaultSingle-S,,0,0,0,,		万无一失
Dialogue: 0,0:02:14.82,0:02:17.05,DefaultSingle-S,,0,0,0,,		请108号来窗口办业务
Dialogue: 0,0:02:17.19,0:02:17.66,DefaultSingle-S,,0,0,0,,		叫我了
Dialogue: 0,0:02:17.94,0:02:20.00,DefaultSingle-S,,0,0,0,,		请填写转入申请和转出证明
Dialogue: 0,0:02:20.00,0:02:20.49,DefaultSingle-S,,0,0,0,,		好的
Dialogue: 0,0:02:21.66,0:02:23.66,DefaultSingle-S,,0,0,0,,		好  手续办完了
Dialogue: 0,0:02:23.66,0:02:24.74,DefaultSingle-S,,0,0,0,,		欢迎来到米花町
Dialogue: 0,0:02:28.54,0:02:30.75,DefaultSingle-S,,0,0,0,,		这下我也是米花町的居民了
Dialogue: 0,0:02:31.01,0:02:34.25,DefaultSingle-S,,0,0,0,,		这是送给转入者的礼物  用它们开启新生活吧
Dialogue: 0,0:02:34.84,0:02:36.36,DefaultSingle-S,,0,0,0,,		还印有米花町的标志
Dialogue: 0,0:02:36.36,0:02:37.91,DefaultSingle-S,,0,0,0,,		「米」字成了花朵的形状
Dialogue: 0,0:02:37.91,0:02:38.55,DefaultSingle-S,,0,0,0,,		还真是
Dialogue: 0,0:02:38.78,0:02:40.33,DefaultSingle-S,,0,0,0,,		拿这么多真的好吗
Dialogue: 0,0:02:40.44,0:02:41.59,DefaultSingle-S,,0,0,0,,		请不用客气
Dialogue: 0,0:02:44.57,0:02:46.56,DefaultSingle-S,,0,0,0,,		我照你说的重新填了
Dialogue: 0,0:02:47.91,0:02:49.98,DefaultSingle-S,,0,0,0,,		这里漏了勾
Dialogue: 0,0:02:50.12,0:02:52.09,DefaultSingle-S,,0,0,0,,		无法受理  下一位
Dialogue: 0,0:02:54.60,0:02:55.96,DefaultSingle-S,,0,0,0,,	{\an8\fs55}	请来这边
Dialogue: 0,0:02:53.40,0:02:56.08,DefaultSingle-S,,0,0,0,,		放我离开这个城市吧  我不想死啊
Dialogue: 0,0:02:56.08,0:02:57.80,DefaultSingle-S,,0,0,0,,		这里还真热情
Dialogue: 0,0:02:58.14,0:02:59.80,DefaultSingle-S,,0,0,0,,		一切都很顺利
Dialogue: 0,0:02:59.92,0:03:02.53,DefaultSingle-S,,0,0,0,,		说不定能趁着这股势头干一票
Dialogue: 0,0:03:02.66,0:03:04.25,DefaultSingle-S,,0,0,0,,		杀人
Dialogue: 0,0:03:05.34,0:03:06.63,DefaultSingle-S,,0,0,0,,		对了  犯泽先生
Dialogue: 0,0:03:06.63,0:03:08.38,DefaultSingle-S,,0,0,0,,		您有驾驶证的吗
Dialogue: 0,0:03:09.02,0:03:09.46,DefaultSingle-S,,0,0,0,,		有
Dialogue: 0,0:03:09.46,0:03:12.27,DefaultSingle-S,,0,0,0,,		那要不要把驾驶证上的住址也变更一下呢
Dialogue: 0,0:03:12.62,0:03:13.24,DefaultSingle-S,,0,0,0,,		那有劳了
Dialogue: 0,0:03:13.24,0:03:16.34,DefaultSingle-S,,0,0,0,,		不  这里不办理驾驶证的住址变更
Dialogue: 0,0:03:16.46,0:03:18.11,DefaultSingle-S,,0,0,0,,		请去隔壁的…
Dialogue: 0,0:03:19.80,0:03:21.31,DefaultSingle-S,,0,0,0,,		米花警察署
Dialogue: 0,0:03:22.46,0:03:23.96,DefaultSingle-S,,0,0,0,,		威慑力十足啊
Dialogue: 0,0:03:24.70,0:03:26.89,DefaultSingle-S,,0,0,0,,		对了  我听说过
Dialogue: 0,0:03:26.89,0:03:30.71,DefaultSingle-S,,0,0,0,,		米花町虽然犯罪率很高  但破案率也是100%
Dialogue: 0,0:03:30.90,0:03:33.72,DefaultSingle-S,,0,0,0,,		消灭犯罪特殊团体
Dialogue: 0,0:03:35.56,0:03:36.36,DefaultSingle-S,,0,0,0,,		惊
Dialogue: 0,0:03:36.96,0:03:39.07,DefaultSingle-S,,0,0,0,,		没  没事  我还什么都没做
Dialogue: 0,0:03:39.29,0:03:40.96,DefaultSingle-S,,0,0,0,,		说实话  我很想调头离开
Dialogue: 0,0:03:41.05,0:03:43.30,DefaultSingle-S,,0,0,0,,		但要是不把驾驶证的住址改掉
Dialogue: 0,0:03:43.30,0:03:45.21,DefaultSingle-S,,0,0,0,,		就没法用它当身份证明了
Dialogue: 0,0:03:45.70,0:03:48.86,DefaultSingle-S,,0,0,0,,		要在书店办会员卡的时候会有点麻烦
Dialogue: 0,0:03:49.01,0:03:52.67,DefaultSingle-S,,0,0,0,,		请问您有写有住址的公共费用收据吗
Dialogue: 0,0:03:53.55,0:03:54.36,DefaultSingle-S,,0,0,0,,		进去吧
Dialogue: 0,0:04:02.59,0:04:03.84,DefaultSingle-S,,0,0,0,,		好多人啊
Dialogue: 0,0:04:04.27,0:04:06.35,DefaultSingle-S,,0,0,0,,		没看到警察
Dialogue: 0,0:04:06.62,0:04:08.51,DefaultSingle-S,,0,0,0,,		妈妈  我们什么时候能回家啊
Dialogue: 0,0:04:08.51,0:04:11.34,DefaultSingle-S,,0,0,0,,		快了  等变更好驾照就回家
Dialogue: 0,0:04:11.49,0:04:13.54,DefaultSingle-S,,0,0,0,,		你昨天也这么说的
Dialogue: 0,0:04:13.54,0:04:15.64,DefaultSingle-S,,0,0,0,,		哎呀  是吗
Dialogue: 0,0:04:16.38,0:04:19.15,DefaultSingle-S,,0,0,0,,		这些人都是在等着变更驾照的吗
Dialogue: 0,0:04:19.34,0:04:22.47,DefaultSingle-S,,0,0,0,,		警察都忙着查案呢
Dialogue: 0,0:04:22.47,0:04:24.82,DefaultSingle-S,,0,0,0,,		每天都会发生案件
Dialogue: 0,0:04:24.82,0:04:27.24,DefaultSingle-S,,0,0,0,,		所有人都去查案了
Dialogue: 0,0:04:27.43,0:04:30.93,DefaultSingle-S,,0,0,0,,		警察叔叔一定会把坏人抓住的
Dialogue: 0,0:04:31.01,0:04:32.48,DefaultSingle-S,,0,0,0,,		再坚持一下
Dialogue: 0,0:04:32.48,0:04:33.08,DefaultSingle-S,,0,0,0,,		嗯
Dialogue: 0,0:04:34.35,0:04:35.64,DefaultSingle-S,,0,0,0,,		回来了
Dialogue: 0,0:04:38.16,0:04:39.85,DefaultSingle-S,,0,0,0,,		这下就能开办事窗口了
Dialogue: 0,0:04:39.85,0:04:41.53,DefaultSingle-S,,0,0,0,,		能回家啦
Dialogue: 0,0:04:44.06,0:04:45.47,DefaultSingle-S,,0,0,0,,		喂  我是目暮
Dialogue: 0,0:04:45.58,0:04:47.37,DefaultSingle-S,,0,0,0,,		什么  你发现了遗体？
Dialogue: 0,0:04:47.37,0:04:48.60,DefaultSingle-S,,0,0,0,,		真的吗  毛利老弟
Dialogue: 0,0:04:48.82,0:04:50.07,DefaultSingle-S,,0,0,0,,		立刻赶往现场
Dialogue: 0,0:04:50.07,0:04:50.97,DefaultSingle-S,,0,0,0,,		是
Dialogue: 0,0:04:51.16,0:04:54.71,DefaultSingle-S,,0,0,0,,		该死的毛利
Dialogue: 0,0:04:55.08,0:04:56.32,DefaultSingle-S,,0,0,0,,		不行了
Dialogue: 0,0:04:56.32,0:04:59.28,DefaultSingle-S,,0,0,0,,		解决了一个案子  又会有新的案子
Dialogue: 0,0:04:59.42,0:05:01.56,DefaultSingle-S,,0,0,0,,		窗口根本开不了
Dialogue: 0,0:05:01.56,0:05:02.15,DefaultSingle-S,,0,0,0,,		妈妈
Dialogue: 0,0:05:02.30,0:05:05.19,DefaultSingle-S,,0,0,0,,		犯人都是坏蛋吧  我会抓到他们的
Dialogue: 0,0:05:05.28,0:05:08.30,DefaultSingle-S,,0,0,0,,		和我一样大的孩子也经常抓到犯人
Dialogue: 0,0:05:08.30,0:05:09.44,DefaultSingle-S,,0,0,0,,		我也要抓犯人
Dialogue: 0,0:05:09.44,0:05:11.12,DefaultSingle-S,,0,0,0,,		所以别哭了  妈妈
Dialogue: 0,0:05:11.12,0:05:11.98,DefaultSingle-S,,0,0,0,,		浩树…
Dialogue: 0,0:05:11.98,0:05:14.14,DefaultSingle-S,,0,0,0,,		对了  我们亲手去抓犯人吧
Dialogue: 0,0:05:14.14,0:05:16.79,DefaultSingle-S,,0,0,0,,		就是  怎么能全丢给警察
Dialogue: 0,0:05:16.79,0:05:18.56,DefaultSingle-S,,0,0,0,,		我们也要抓犯人
Dialogue: 0,0:05:19.18,0:05:20.01,DefaultSingle-S,,0,0,0,,		那人怎么回事
Dialogue: 0,0:05:20.01,0:05:20.56,DefaultSingle-S,,0,0,0,,		他跑掉了
Dialogue: 0,0:05:20.56,0:05:21.13,DefaultSingle-S,,0,0,0,,		好可疑
Dialogue: 0,0:05:21.22,0:05:22.39,DefaultSingle-S,,0,0,0,,		抓住他
Dialogue: 0,0:05:28.54,0:05:31.45,DefaultSingle-S,,0,0,0,,		你没事吧  我看你脸色不好
Dialogue: 0,0:05:31.45,0:05:32.03,DefaultSingle-S,,0,0,0,,		惊
Dialogue: 0,0:05:32.03,0:05:34.51,DefaultSingle-S,,0,0,0,,		没事的  这是常有的事
Dialogue: 0,0:05:34.62,0:05:37.71,DefaultSingle-S,,0,0,0,,		反正我们没法转出这个城市
Dialogue: 0,0:05:37.81,0:05:39.34,DefaultSingle-S,,0,0,0,,		就是发泄一下怨气而已
Dialogue: 0,0:05:40.96,0:05:43.52,DefaultSingle-S,,0,0,0,,		来呼吸一下外面的空气…
Dialogue: 0,0:05:48.33,0:05:50.07,DefaultSingle-S,,0,0,0,,		真是春天啊
Dialogue: 0,0:05:53.30,0:05:57.58,DefaultSingle-S,,0,0,0,,		爆炸声  永不停歇  陷入迷宫
Dialogue: 0,0:05:58.57,0:06:01.45,DefaultSingle-S,,0,0,0,,		写得真好  有种世事无常的感觉
Dialogue: 0,0:06:01.79,0:06:04.43,DefaultSingle-S,,0,0,0,,		什么  你说没有季语？
Dialogue: 0,0:06:04.81,0:06:07.23,DefaultSingle-S,,0,0,0,,		「爆炸」就是春季的季语啊
Dialogue: 0,0:06:08.47,0:06:10.84,DefaultSingle-S,,0,0,0,,		老妈
Dialogue: 0,0:06:13.75,0:06:14.48,DefaultSingle-S,,0,0,0,,		第二天
Dialogue: 0,0:06:15.66,0:06:18.01,DefaultSingle-S,,0,0,0,,		任务完成
Dialogue: 0,0:06:18.24,0:06:21.44,DefaultSingle-S,,0,0,0,,		驾驶证住址变更完毕
Dialogue: 0,0:06:21.62,0:06:23.88,DefaultSingle-S,,0,0,0,,		通宵排队总算是办好了
Dialogue: 0,0:06:24.20,0:06:26.15,DefaultSingle-S,,0,0,0,,		我再也不去警察署了
Dialogue: 0,0:06:26.71,0:06:29.55,DefaultSingle-S,,0,0,0,,		这下手续就全办完了
Dialogue: 0,0:06:29.84,0:06:33.26,DefaultSingle-S,,0,0,0,,		终于可以正式开始了
Dialogue: 0,0:06:34.28,0:06:36.36,DefaultSingle-S,,0,0,0,,		制定杀人计划
Dialogue: 0,0:06:37.04,0:06:39.00,DefaultSingle-S,,0,0,0,,		犯泽先生  有你的包裹
Dialogue: 0,0:06:39.21,0:06:39.92,DefaultSingle-S,,0,0,0,,		老妈寄来的
Dialogue: 0,0:06:41.32,0:06:45.52,DefaultSingle-S,,0,0,0,,		我收到了你的驾照更新通知单  就一起寄来了
Dialogue: 0,0:06:45.58,0:06:48.25,DefaultSingle-S,,0,0,0,,		你可别忘了去警察署更新哦
Dialogue: 0,0:06:48.46,0:06:54.41,DefaultSingle-S,,0,0,0,,		老妈啊
Dialogue: 0,0:08:31.58,0:08:34.00,DefaultSingle-S,,0,0,0,,		《犯人犯泽》也播出三集了
Dialogue: 0,0:08:34.00,0:08:37.98,DefaultSingle-S,,0,0,0,,		人们常说「三集定律」  很多人追了三集就会弃番
Dialogue: 0,0:08:37.98,0:08:39.63,DefaultSingle-S,,0,0,0,,		为了让大家继续看下去
Dialogue: 0,0:08:39.63,0:08:42.33,DefaultSingle-S,,0,0,0,,		我犯泽就来一次名副其实的挺身而出吧
Dialogue: 0,0:08:42.33,0:08:45.58,DefaultSingle-S,,0,0,0,,		所以  下集将从我的沐浴场景开始
Dialogue: 0,0:08:45.58,0:08:48.36,DefaultSingle-S,,0,0,0,,		标题简单粗暴  就是「漆黑的入浴」
Dialogue: 0,0:08:48.49,0:08:52.58,DefaultSingle-S,,0,0,0,,		犯罪搞笑动画《犯人犯泽》即将挑战最危险情节
Dialogue: 0,0:08:52.58,0:08:55.04,DefaultSingle-S,,0,0,0,,		现代对表现手法的约束越来越多
Dialogue: 0,0:08:55.04,0:08:58.98,DefaultSingle-S,,0,0,0,,		请大家继续支持全裸出镜的犯泽吧
Dialogue: 0,0:08:58.98,0:09:00.79,DefaultSingle-S,,0,0,0,,		每人要看13遍哦
Dialogue: 0,0:06:01.79,0:06:04.43,Note,,0,0,0,,		注：季语是日本俳句等作品中必须含有的季节代表词
Dialogue: 0,0:01:33.37,0:01:36.37,DefaultSingle-S,,0,0,0,,

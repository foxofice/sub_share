Dialogue: 0,0:02:06.07,0:02:11.07,Default,,0,0,5,,{\fad(500,500)\an8\shad0\bord1\blur0\b1\c&HFFFFFF&\1a&H00&\fs19\fn思源宋体 CN\3c&H383634&\3a&H0F&}後期＆時軸：{\3c&H98736D&\3a&H0F&}orion  {\3c&H373634&\3a&H0F&}壓製：{\3c&H98736D&\3a&H0F&}冰白\N{\3c&H373634&\3a&H0F&\fs17}Telegram頻道：{\c&H26F4FF&}https://t.me/+7H24kZLhIqoyMjk1
Dialogue: 0,0:00:31.11,0:00:33.32,op jp,,0,0,0,,Whatever it takes
Dialogue: 0,0:00:31.11,0:00:33.32,op zh,,0,0,0,,不惜一切代價
Dialogue: 0,0:00:33.37,0:00:36.95,op jp,,0,0,0,,譲れない その胸の
Dialogue: 0,0:00:33.37,0:00:36.95,op zh,,0,0,0,,絕不讓步 將那心中的
Dialogue: 0,0:00:37.11,0:00:41.17,op jp,,0,0,0,,火花を散らして just kill the noise
Dialogue: 0,0:00:37.11,0:00:41.17,op zh,,0,0,0,,火花迸發四濺 只需消滅一切雜音
Dialogue: 0,0:01:01.22,0:01:05.56,op jp,,0,0,0,,崩れ落ちた 夢の亡骸を
Dialogue: 0,0:01:01.22,0:01:05.56,op zh,,0,0,0,,哪怕踐踏著崩毀墜落的夢之殘骸
Dialogue: 0,0:01:05.68,0:01:10.15,op jp,,0,0,0,,踏みつけても 何も感じられない
Dialogue: 0,0:01:05.68,0:01:10.15,op zh,,0,0,0,,也已麻木到毫無知覺
Dialogue: 0,0:01:10.29,0:01:13.84,op jp,,0,0,0,,あの時 こうしてなかったら
Dialogue: 0,0:01:10.29,0:01:13.84,op zh,,0,0,0,,“如果那時沒有那樣做就好了”
Dialogue: 0,0:01:13.84,0:01:18.98,op jp,,0,0,0,,なんて 耳鳴りのよう 囚われたまま
Dialogue: 0,0:01:13.84,0:01:18.98,op zh,,0,0,0,,如同耳鳴般 始終囚禁著我
Dialogue: 0,0:01:19.13,0:01:24.28,op jp,,0,0,0,,時効がないなら 朽ちたままの
Dialogue: 0,0:01:19.13,0:01:24.28,op zh,,0,0,0,,倘若沒有時效 這已腐朽的
Dialogue: 0,0:01:25.11,0:01:28.00,op jp,,0,0,0,,誓いも果たせるかい?
Dialogue: 0,0:01:25.11,0:01:28.00,op zh,,0,0,0,,誓言是否還能兌現？
Dialogue: 0,0:01:28.20,0:01:30.37,op jp,,0,0,0,,Whatever it takes
Dialogue: 0,0:01:28.20,0:01:30.37,op zh,,0,0,0,,不惜一切代價
Dialogue: 0,0:01:30.61,0:01:37.06,op jp,,0,0,0,,繋がれた未来を 解き放てるまで
Dialogue: 0,0:01:30.61,0:01:37.06,op zh,,0,0,0,,直到能解放那被束縛的未來
Dialogue: 0,0:01:37.41,0:01:43.22,op jp,,0,0,0,,何十回だって 何百回だって 挑むよ
Dialogue: 0,0:01:37.41,0:01:43.22,op zh,,0,0,0,,幾十次也好 幾百次也罷 我都會挑戰
Dialogue: 0,0:01:43.47,0:01:47.47,op jp,,0,0,0,,涙を喰らい just kill the noise
Dialogue: 0,0:01:43.47,0:01:47.47,op zh,,0,0,0,,將淚水嚥下 只需消滅一切雜音

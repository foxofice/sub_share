Dialogue: 0,0:00:09.51,0:00:11.93,TEXT-CN,,0,0,0,,饶了我吧 山本先生
Dialogue: 0,0:00:12.01,0:00:13.97,TEXT-CN,,0,0,0,,这阵子我每个星期都出动耶
Dialogue: 0,0:00:14.06,0:00:16.81,TEXT-CN,,0,0,0,,换成是普通人 早就过劳死了
Dialogue: 0,0:00:16.89,0:00:18.23,TEXT-CN,,0,0,0,,抱歉 优
Dialogue: 0,0:00:18.31,0:00:20.40,TEXT-CN,,0,0,0,,听说这次是紧急任务
Dialogue: 0,0:00:20.48,0:00:22.27,TEXT-CN,,0,0,0,,现在能出动的只有你了
Dialogue: 0,0:00:22.36,0:00:25.23,TEXT-CN,,0,0,0,,我得去总部处理另外一件事情
Dialogue: 0,0:00:25.32,0:00:28.32,TEXT-CN,,0,0,0,,任务内容会由其他员工替你说明
Dialogue: 0,0:00:28.40,0:00:31.11,TEXT-CN,,0,0,0,,我现在旷课日数已经够多了
Dialogue: 0,0:00:31.20,0:00:33.49,TEXT-CN,,0,0,0,,要是再请假 我就要留级了啦
Dialogue: 0,0:00:33.58,0:00:37.04,TEXT-CN,,0,0,0,,什么嘛 原来你还没放弃升学啊？
Dialogue: 0,0:00:37.12,0:00:40.29,TEXT-CN,,0,0,0,,当然啦！话说你怎么讲这种话啊
Dialogue: 0,0:00:40.37,0:00:42.00,TEXT-CN,,0,0,0,,好啦 我知道了
Dialogue: 0,0:00:42.08,0:00:45.67,TEXT-CN,,0,0,0,,任务结束之后 我再安排你来阿卡姆上特别课程
Dialogue: 0,0:00:45.75,0:00:48.26,TEXT-CN,,0,0,0,,你就在直升机上听战前简报吧
Dialogue: 0,0:00:48.34,0:00:50.40,TEXT-CN,,0,0,15,,{\an8}拜托你了 优 再见
Dialogue: 0,0:00:49.38,0:00:50.55,TEXT-CN,,0,0,0,,喂 山本先生
Dialogue: 0,0:00:53.14,0:00:55.39,TEXT-CN,,0,0,0,,可恶
Dialogue: 0,0:00:57.97,0:00:59.06,TEXT-CN,,0,0,0,,所以呢？
Dialogue: 0,0:00:59.14,0:01:03.44,TEXT-CN,,0,0,0,,你今天又要拿什么理由 提早回去呢 御神苗同学？
Dialogue: 0,0:01:03.52,0:01:05.02,TEXT-CN,,0,0,0,,这个嘛…
Dialogue: 0,0:01:05.11,0:01:07.03,TEXT-CN,,0,0,0,,我的肚子不太舒服
Dialogue: 0,0:01:07.11,0:01:08.11,TEXT-CN,,0,0,0,,少骗人了
Dialogue: 0,0:01:08.19,0:01:11.32,TEXT-CN,,0,0,0,,御神苗同学 你不打算升学吗？
Dialogue: 0,0:01:11.40,0:01:13.03,TEXT-CN,,0,0,0,,才没有
Dialogue: 0,0:01:13.11,0:01:15.53,TEXT-CN,,0,0,0,,受不了 怎么每个人都这样？
Dialogue: 0,0:01:19.91,0:01:22.37,TEXT-CN,,0,0,0,,冈部？怎么了？
Dialogue: 0,0:01:23.21,0:01:26.71,TEXT-CN,,0,0,0,,这周星期五请你一定要来学校
Dialogue: 0,0:01:27.30,0:01:28.13,TEXT-CN,,0,0,0,,你说什么？
Dialogue: 0,0:01:30.13,0:01:33.72,TEXT-CN,,0,0,0,,这周星期五请你一定要来学校
Dialogue: 0,0:01:39.64,0:01:41.02,TEXT-CN,,0,0,0,,她是怎么啦？
Dialogue: 0,0:01:41.10,0:01:44.90,TEXT-CN,,0,0,0,,弥生她要转学 下个周末就要搬家了
Dialogue: 0,0:01:44.98,0:01:46.23,TEXT-CN,,0,0,0,,什么意思啊？
Dialogue: 0,0:01:46.31,0:01:49.07,TEXT-CN,,0,0,0,,受不了你这个旷课大王耶
Dialogue: 0,0:01:49.15,0:01:54.53,TEXT-CN,,0,0,0,,冈部她的意思是 希望你也能参加这星期的运动会啦
Dialogue: 0,0:01:54.61,0:01:55.78,TEXT-CN,,0,0,0,,运动会？
Dialogue: 0,0:01:55.87,0:01:58.45,TEXT-CN,,0,0,0,,弥生她是筹办委员会的一员
Dialogue: 0,0:01:59.08,0:02:03.50,TEXT-CN,,0,0,0,,我猜她一定是希望 最后能跟大家一起创造回忆吧
Dialogue: 0,0:02:04.04,0:02:05.92,TEXT-CN,,0,0,0,,就算这么说…
Dialogue: 0,0:02:06.50,0:02:07.34,TEXT-CN,,0,0,0,,好痛
Dialogue: 0,0:02:07.42,0:02:09.88,TEXT-CN,,0,0,0,,不要啰嗦 反正你来就对了
Dialogue: 0,0:02:09.96,0:02:12.22,TEXT-CN,,0,0,0,,拜托你 御神苗同学
Dialogue: 0,0:02:15.14,0:02:18.47,TEXT-CN,,0,0,0,,拿你们没办法 是什么时候来着？
Dialogue: 0,0:02:18.56,0:02:20.56,TEXT-CN,,0,0,0,,这周星期五
Dialogue: 0,0:02:20.64,0:02:24.27,TEXT-CN,,0,0,0,,你好歹也关心一下学校有什么活动嘛
Dialogue: 0,0:02:26.10,0:02:28.15,TEXT-CN,,0,0,0,,到时候应该可以来吧
Dialogue: 0,0:02:29.02,0:02:32.82,TEXT-CN,,0,0,0,,知道了 我会参加这场运动会啦
Dialogue: 0,0:02:33.40,0:02:37.74,TEXT-CN,,0,0,0,,不过我可能会晚点到 先把我排在接力赛最后一棒吧
Dialogue: 0,0:02:37.82,0:02:38.66,TEXT-CN,,0,0,0,,好
Dialogue: 0,0:02:38.74,0:02:41.16,TEXT-CN,,0,0,0,,敢迟到就要你好看喔
Dialogue: 0,0:03:01.97,0:03:04.93,TEXT-CN,,0,0,0,,应该可以
Dialogue: 0,0:03:10.27,0:03:12.03,TEXT-CN,,0,0,0,,可以才怪啦
Dialogue: 0,0:03:12.11,0:03:15.15,TEXT-CN,,0,0,0,,拜托你把重要的事 讲清楚嘛 山本先生
Dialogue: 0,0:03:15.78,0:03:19.66,TEXT-CN,,0,0,0,,竟然偏偏要处理狂战士
Dialogue: 0,0:03:26.33,0:03:29.46,TEXT-CN,,0,0,0,,这里有一面金属板
Dialogue: 0,0:03:30.42,0:03:33.50,TEXT-CN,,0,0,0,,它是因过于发达而导致灭亡的
Dialogue: 0,0:03:33.59,0:03:35.88,TEXT-CN,,0,0,0,,超古代文明中的某些人士
Dialogue: 0,0:03:35.97,0:03:38.80,TEXT-CN,,0,0,0,,用这面留言板
Dialogue: 0,0:03:38.89,0:03:40.55,TEXT-CN,,0,0,0,,写下了对我们现代人的警告
Dialogue: 0,0:03:41.68,0:03:42.93,TEXT-CN,,0,0,0,,他们是这么说的
Dialogue: 0,0:03:43.56,0:03:46.68,TEXT-CN,,0,0,0,,“从恶人手中守护住我们的遗产”
Dialogue: 0,0:03:47.85,0:03:50.02,TEXT-CN,,0,0,0,,有一个组织诚挚地接收了这个讯息
Dialogue: 0,0:03:50.10,0:03:54.94,TEXT-CN,,0,0,0,,并以封印超古代文明为目的展开活动
Dialogue: 0,0:03:55.03,0:03:58.20,TEXT-CN,,0,0,0,,而这个组织的特工
Dialogue: 0,0:03:59.66,0:04:01.24,TEXT-CN,,0,0,0,,被称为“史普利根”
Dialogue: 0,0:03:59.66,0:04:01.24,TEXT-CN,,172,0,0,,{\fs40}SPRIGGAN
Comment: 0,0:02:13.98,0:02:13.98,Screen,,0,0,0,code once,math.randomseed(2077); g_cols = {"&HFFFFFF&","&HFFFFFF&","&HFFFF00&","&HFF00FF&","&H00FFFF&"}; function glitch_slice(l, j, maxj, s, total_s, amp, drop_p, mode) local decay = (mode == "in") and ((maxj - j + 1) / maxj) or (j / maxj); if j > 1 and math.random() < (drop_p * decay) then return "{\\alpha&HFF&}"; end; if j == 1 and (s == 2 or s == 5) then return "{\\alpha&HFF&}"; end; local pad = 6; local h_tot = l.height + pad * 2; local y1 = math.floor(l.top - pad + h_tot * s / total_s); local y2 = math.floor(l.top - pad + h_tot * (s + 1) / total_s); local dir = (s % 2 == 0) and -1 or 1; local dx = math.floor(dir * math.random(math.floor(amp * 0.45), amp) * decay); local tint = ""; if decay > 0.6 and math.random() < 0.28 then tint = (dir < 0) and "\\1c&HFFFF00&" or "\\1c&HFF00FF&"; end; local al = (l.styleref and l.styleref.align) or 2; return string.format("{\\an%d\\pos(%d,%d)\\clip(%d,%d,%d,%d)%s\\bord1\\blur1.2\\3c&H181818&\\3a&H50&}", al, math.floor(l.x + dx), math.floor(l.y), math.floor(l.left - 90), y1, math.floor(l.right + 90), y2, tint); end; function glitch_rgb(l, j, maxj, col, dir, amp, mode) local decay = (mode == "in") and ((maxj - j + 1) / maxj) or (j / maxj); local dx = math.floor(dir * amp * decay + math.random(-5, 5) * decay); local cut = math.floor(l.top + l.height * (0.3 + math.random() * 0.4)); local y1 = (dir < 0) and math.floor(l.top - 6) or cut; local y2 = (dir < 0) and cut or math.floor(l.bottom + 6); local al = (l.styleref and l.styleref.align) or 2; return string.format("{\\an%d\\pos(%d,%d)\\clip(%d,%d,%d,%d)\\1c%s\\1a&H48&\\bord0\\blur0.8}", al, math.floor(l.x + dx), math.floor(l.y), math.floor(l.left - 90), y1, math.floor(l.right + 90), y2, col); end; function glitch_bar(l) local w = math.random(40, math.max(90, math.floor(l.width * 0.55))); local h = math.random(2, 5); local x1 = math.floor(l.left + math.random(-35, math.max(10, math.floor(l.width - w + 35)))); local y1 = math.floor(l.top + math.random(-2, math.max(2, math.floor(l.height - 2)))); local col = g_cols[math.random(1, #g_cols)]; return string.format("{\\an7\\pos(%d,%d)\\1c%s\\1a&H18&\\bord0\\shad0\\p1}m 0 0 l %d 0 l %d %d l 0 %d", x1, y1, col, w, w, h, h); end; function glitch_pixel(l) local w = math.random(4, 10); local h = math.random(3, 7); local x1 = math.floor(l.left + math.random(-45, math.max(10, math.floor(l.width + 45)))); local y1 = math.floor(l.top + math.random(-10, math.max(6, math.floor(l.height + 10)))); local col = g_cols[math.random(3, #g_cols)]; return string.format("{\\an7\\pos(%d,%d)\\1c%s\\1a&H20&\\bord0\\shad0\\p1}m 0 0 l %d 0 l %d %d l 0 %d", x1, y1, col, w, w, h, h); end

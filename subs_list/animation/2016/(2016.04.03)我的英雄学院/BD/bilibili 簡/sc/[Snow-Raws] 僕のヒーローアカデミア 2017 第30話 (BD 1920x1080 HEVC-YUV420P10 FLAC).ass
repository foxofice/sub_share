Dialogue: 0,0:09:36.97,0:09:38.93,On Top,,0,0,0,,数分钟前
Dialogue: 0,0:09:54.99,0:09:59.24,On Top,,120,0,0,,{\an7}职业英雄\N格兰特里诺\N个性：喷射
Dialogue: 0,0:10:04.45,0:10:08.75,On Top,,120,0,0,,{\an7}职业英雄\N安德瓦\N个性：地狱烈焰
Dialogue: 0,0:19:13.96,0:19:18.84,On Top,,360,0,0,,{\an7}敌人\N死柄木吊\N个性：崩坏
Dialogue: 0,0:19:13.96,0:19:18.84,On Top,,1260,0,0,,{\an7}敌人\N黑雾\N个性：传送门

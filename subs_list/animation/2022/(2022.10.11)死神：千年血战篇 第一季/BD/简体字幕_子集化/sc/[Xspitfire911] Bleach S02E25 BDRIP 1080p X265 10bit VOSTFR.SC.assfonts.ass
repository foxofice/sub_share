Dialogue: 0,1:00:23.77,2:00:23.77,Screen,,0,0,0,,字幕整理：xg小鬼
Comment: 0,0:01:56.01,0:01:56.06,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:02:07.48,0:02:13.37,op-jp,,0,0,0,,オーマイダーリン　こころの行方さえ知らず
Dialogue: 0,0:02:13.37,0:02:19.02,op-jp,,0,0,0,,いつしか　夢見たことも忘れてた
Dialogue: 0,0:02:19.18,0:02:24.74,op-jp,,0,0,0,,大人になること＝建前とブラフ
Dialogue: 0,0:02:24.97,0:02:31.51,op-jp,,0,0,0,,塗り潰す鏡に　ねえ何が映るの
Dialogue: 0,0:02:31.68,0:02:37.34,op-jp,,0,0,0,,あなたの写真が　色褪せてく
Dialogue: 0,0:02:37.48,0:02:42.06,op-jp,,0,0,0,,変わってく僕を　残して
Dialogue: 0,0:02:42.06,0:02:48.07,op-jp,,0,0,0,,振り絞ったその声で　夜を切り裂いて
Dialogue: 0,0:02:48.26,0:02:53.86,op-jp,,0,0,0,,形の無いこの恐怖ごと　胸を焦がして
Dialogue: 0,0:02:53.86,0:02:59.70,op-jp,,0,0,0,,あの日みたいに　笑えなくていい
Dialogue: 0,0:02:59.70,0:03:05.62,op-jp,,0,0,0,,哀しみも傷も全部　連れていきたい
Dialogue: 0,0:03:06.41,0:03:09.09,op-jp,,0,0,0,,{\fsp0}You can't kill my vibe, oh baby
Dialogue: 0,0:03:09.09,0:03:11.97,op-jp,,0,0,0,,{\fsp0}Burning out now, like a shooting star
Dialogue: 0,0:03:12.22,0:03:14.84,op-jp,,0,0,0,,{\fsp0}You can't kill my vibe, oh baby
Dialogue: 0,0:03:14.84,0:03:17.68,op-jp,,0,0,0,,{\fsp0}Burning out now, like a shooting star
Dialogue: 0,0:02:07.48,0:02:13.37,op-cn,,0,0,0,,亲爱的 连心都已不知去向
Dialogue: 0,0:02:13.37,0:02:19.02,op-cn,,0,0,0,,曾经的梦也已经忘记
Dialogue: 0,0:02:19.18,0:02:24.74,op-cn,,0,0,0,,长大成人=心口不一和虚张声势
Dialogue: 0,0:02:24.97,0:02:31.51,op-cn,,0,0,0,,那涂毁的镜子 究竟映出了什么
Dialogue: 0,0:02:31.68,0:02:37.34,op-cn,,0,0,0,,你的照片已经褪色
Dialogue: 0,0:02:37.48,0:02:42.06,op-cn,,0,0,0,,留下不断改变的我
Dialogue: 0,0:02:42.06,0:02:48.07,op-cn,,0,0,0,,用声嘶力竭的呼喊 划破夜晚
Dialogue: 0,0:02:48.26,0:02:53.86,op-cn,,0,0,0,,连同这无形的恐惧 催促内心
Dialogue: 0,0:02:53.86,0:02:59.70,op-cn,,0,0,0,,无需像那天一样欢笑
Dialogue: 0,0:02:59.70,0:03:05.62,op-cn,,0,0,0,,想把悲痛与创伤全部带走
Dialogue: 0,0:03:06.41,0:03:09.09,op-cn,,0,0,0,,{\fsp0}You can't kill my vibe, oh baby

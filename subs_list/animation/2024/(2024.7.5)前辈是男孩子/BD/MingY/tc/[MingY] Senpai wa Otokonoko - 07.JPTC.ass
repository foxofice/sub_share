Dialogue: 0,0:01:57.50,0:02:02.77,F,,0,108,148,,{\fad(500,500)\an3\fn方正中雅宋_GBK\fs60\fsp3\bord7\blur5\t(750,1500,\bord5\blur3)\1a&Hff&\3c&HEDAD90&}第{\3c&HECB194&}7{\3c&HEBB699&}話 {\3c&HE9BFA2&}那{\3c&HE8C3A6&}樣{\3c&HE7C8AB&}的{\3c&HE7CDB0&}人
Dialogue: 0,0:01:57.50,0:02:02.77,F,,0,108,148,,{\fad(500,500)\an3\fn方正中雅宋_GBK\fs60\fsp3\bord0\blur2\t(0,500,\blur0)\shad3\c&HFFFFFF&\4c&H8B8A86&}第7話 那樣的人
Dialogue: 1,0:00:01.07,0:00:02.77,F,,0,0,0,,這是龍二的校服吧
Dialogue: 1,0:00:03.01,0:00:05.15,F,,0,0,0,,沒事  我自己拿
Dialogue: 1,0:00:06.38,0:00:07.61,F,,0,0,0,,給你  龍二
Dialogue: 1,0:02:02.70,0:02:05.32,F,,0,0,0,,我和真琴從小就一起玩
Dialogue: 1,0:02:05.32,0:02:08.02,F,,0,0,0,,從小學起我們就關係很好
Dialogue: 1,0:02:08.53,0:02:11.12,F,,0,0,0,,真琴經常來我家玩
Dialogue: 1,0:02:12.74,0:02:14.90,F,,0,0,0,,小真  今天要留宿嗎
Dialogue: 1,0:02:15.51,0:02:16.69,F,,0,0,0,,留下來吧
Dialogue: 1,0:02:16.69,0:02:17.87,F,,0,0,0,,啊  嗯
Dialogue: 1,0:02:17.87,0:02:20.03,F,,0,0,0,,那我去拿床被子
Dialogue: 1,0:02:20.03,0:02:22.07,F,,0,0,0,,不用了  我們睡一張床
Dialogue: 1,0:02:22.07,0:02:22.88,F,,0,0,0,,對吧
Dialogue: 1,0:02:22.88,0:02:23.66,F,,0,0,0,,嗯
Dialogue: 1,0:02:23.66,0:02:25.41,F,,0,0,0,,這樣啊
Dialogue: 1,0:02:28.16,0:02:30.29,F,,0,0,0,,那晚安了
Dialogue: 1,0:02:30.29,0:02:31.93,F,,0,800,0,,晚安
Dialogue: 1,0:02:30.29,0:02:31.93,F,,300,0,0,,晚安
Dialogue: 1,0:02:34.74,0:02:37.25,F,,0,0,0,,我很喜歡你家
Dialogue: 1,0:02:37.25,0:02:38.22,F,,0,0,0,,為什麼
Dialogue: 1,0:02:39.49,0:02:40.30,F,,0,0,0,,就是覺得
Dialogue: 1,0:02:42.21,0:02:44.18,F,,0,0,0,,在這裡睡得特別好
Dialogue: 1,0:02:45.29,0:02:46.81,F,,0,0,0,,是嗎
Dialogue: 1,0:02:47.12,0:02:48.32,F,,0,0,0,,晚安
Dialogue: 1,0:02:51.36,0:02:52.57,F,,0,0,0,,晚安
Dialogue: 1,0:02:53.31,0:02:57.32,F,,0,0,0,,那晚  真琴說的話讓我特別開心
Dialogue: 1,0:02:57.76,0:03:00.07,F,,0,0,0,,心裡總覺得癢癢的
Dialogue: 1,0:03:00.61,0:03:02.48,F,,0,0,0,,怎麼也睡不著
Dialogue: 1,0:03:02.48,0:03:07.68,F,,0,0,0,,月光照得真琴的睫毛閃閃發光  我就一直盯著看
Dialogue: 1,0:03:09.10,0:03:10.69,F,,0,0,0,,好漂亮
Dialogue: 1,0:03:12.84,0:03:14.34,F,,0,0,0,,進入國中後
Dialogue: 1,0:03:14.60,0:03:17.93,F,,0,0,0,,有個不良少年似的同學打了耳洞
Dialogue: 1,0:03:20.09,0:03:21.85,F,,0,0,0,,真夠大膽的
Dialogue: 1,0:03:21.85,0:03:22.84,F,,0,0,0,,他傻嗎
Dialogue: 1,0:03:23.18,0:03:26.55,F,,0,0,0,,他馬上就被叫去生徒指導室了
Dialogue: 1,0:03:26.55,0:03:28.51,F,,0,0,0,,但他依舊笑嘻嘻的
Dialogue: 1,0:03:28.51,0:03:30.10,F,,0,0,0,,我覺得這人真奇怪
Dialogue: 1,0:03:31.05,0:03:32.82,F,,0,0,0,,我跟他根本不是一類人
Dialogue: 1,0:03:33.35,0:03:35.74,F,,0,0,0,,我只是個再普通不過的人
Dialogue: 1,0:03:35.74,0:03:38.64,F,,0,0,0,,和「那樣的人」怎麼也不會扯上關係
Dialogue: 1,0:03:39.42,0:03:42.11,F,,0,0,0,,這些規定要嚴格遵守
Dialogue: 1,0:03:42.72,0:03:44.24,F,,0,0,0,,喂  龍二龍二
Dialogue: 1,0:03:45.04,0:03:45.99,F,,0,0,0,,什麼事
Dialogue: 1,0:03:46.40,0:03:48.99,F,,0,0,0,,這個傢伙說他喜歡真琴哦
Dialogue: 1,0:03:49.32,0:03:50.95,F,,0,0,0,,明明都是男生
Dialogue: 1,0:03:52.63,0:03:53.76,F,,0,0,0,,不是啊
Dialogue: 1,0:03:53.76,0:03:56.67,F,,0,0,0,,我只是說他長得好看罷了
Dialogue: 1,0:03:56.67,0:03:58.63,F,,0,0,0,,真琴  過來一下
Dialogue: 1,0:03:58.97,0:04:00.39,F,,0,0,0,,欸  什麼事
Dialogue: 1,0:04:00.39,0:04:01.88,F,,0,0,0,,來拍張男女合影
Dialogue: 1,0:04:01.88,0:04:03.46,F,,0,0,0,,別說了
Dialogue: 1,0:04:03.46,0:04:05.02,F,,0,0,0,,準備拍照了哦
Dialogue: 1,0:04:06.91,0:04:09.94,F,,0,0,0,,當然  我也不想成為那樣的人
Dialogue: 1,0:04:12.56,0:04:14.10,F,,0,0,0,,挺好的嘛
Dialogue: 1,0:04:20.39,0:04:23.22,F,,0,0,0,,這個傢伙說他喜歡真琴哦
Dialogue: 1,0:04:23.22,0:04:25.96,F,,0,0,0,,我只是說他長得好看罷了
Dialogue: 1,0:04:31.51,0:04:34.46,F,,0,0,0,,那天晚上我只想盡快入睡
Dialogue: 1,0:04:39.50,0:04:40.92,F,,0,0,0,,從那以後
Dialogue: 1,0:04:41.36,0:04:44.17,F,,0,0,0,,我開始莫名其妙地在意真琴
Dialogue: 1,0:04:46.30,0:04:48.80,F,,0,0,0,,有意地想要避開他
Dialogue: 1,0:04:56.14,0:04:59.82,F,,0,0,0,,不知不覺中  我們的關係疏遠了
Dialogue: 1,0:05:12.50,0:05:15.46,F,,0,0,0,,高中去見不到真琴的地方吧
Dialogue: 1,0:05:18.34,0:05:20.88,F,,0,0,0,,所以我選擇了離家很遠的學校
Dialogue: 1,0:05:35.85,0:05:39.36,F,,0,0,0,,看到了穿著水手服的真琴  嚇了一跳
Dialogue: 1,0:05:40.28,0:05:41.23,F,,0,0,0,,真琴？
Dialogue: 1,0:05:48.24,0:05:49.15,F,,0,0,0,,拜託了
Dialogue: 1,0:05:49.15,0:05:51.74,F,,0,0,0,,請不要告訴別人我是男生
Dialogue: 1,0:05:51.74,0:05:54.90,F,,0,0,0,,發生了很多事  現在大家都以為我是女孩子
Dialogue: 1,0:05:54.90,0:05:56.53,F,,0,0,0,,我不想被發現
Dialogue: 1,0:05:56.53,0:05:58.00,F,,0,0,0,,很多事…？
Dialogue: 1,0:05:58.00,0:06:02.19,F,,0,0,0,,那個  說來話長…
Dialogue: 1,0:06:03.13,0:06:06.88,F,,0,0,0,,穿著水手服的真琴  是個奇怪的傢伙
Dialogue: 1,0:06:09.89,0:06:12.64,F,,0,0,0,,但是  真琴還是真琴
Dialogue: 1,0:06:17.54,0:06:19.98,F,,0,0,0,,明明想要遠離他
Dialogue: 1,0:06:21.14,0:06:22.77,F,,0,0,0,,卻又不由自主地靠近了
Dialogue: 1,0:06:29.18,0:06:30.42,F,,0,0,0,,我得保持距離…
Dialogue: 1,0:06:33.54,0:06:35.52,F,,0,0,0,,明明都是男生
Dialogue: 1,0:06:35.52,0:06:37.12,F,,0,0,0,,我得保持距離…
Dialogue: 1,0:06:41.23,0:06:42.82,F,,0,0,0,,早安  龍二
Dialogue: 1,0:06:44.05,0:06:45.46,F,,0,0,0,,我得保持距離…
Dialogue: 1,0:06:49.72,0:06:50.61,F,,0,0,0,,我…
Dialogue: 1,0:06:53.48,0:06:54.94,F,,0,0,0,,想要保持普通
Dialogue: 1,0:06:57.68,0:06:59.23,F,,0,0,0,,喂  聽說了嗎
Dialogue: 1,0:06:59.23,0:07:02.73,F,,0,0,0,,聽說花岡真琴其實是男生
Dialogue: 1,0:07:09.86,0:07:12.12,F,,0,0,0,,欸  一直在男扮女裝？
Dialogue: 1,0:07:12.12,0:07:13.62,F,,0,0,0,,太糟了吧
Dialogue: 1,0:07:13.62,0:07:15.37,F,,0,0,0,,不正常啊
Dialogue: 1,0:07:15.37,0:07:17.87,F,,0,0,0,,我早就覺得不對勁了
Dialogue: 1,0:07:17.87,0:07:19.12,F,,0,0,0,,好噁心
Dialogue: 1,0:07:19.12,0:07:19.99,F,,0,0,0,,怎麼了
Dialogue: 1,0:07:19.99,0:07:21.47,F,,0,0,0,,被騙了
Dialogue: 1,0:07:20.49,0:07:22.00,D,,0,0,0,,真糟糕
Dialogue: 1,0:07:21.47,0:07:22.37,F,,0,0,0,,怎麼回事
Dialogue: 1,0:07:32.99,0:07:34.64,F,,0,0,0,,喂  真琴
Dialogue: 1,0:07:35.76,0:07:36.89,F,,0,0,0,,龍二
Dialogue: 1,0:07:36.89,0:07:40.15,F,,0,0,0,,那…那個  怎麼說呢…
Dialogue: 1,0:07:42.00,0:07:43.90,F,,0,0,0,,你以後不要再來這裡了
Dialogue: 1,0:07:45.36,0:07:46.01,F,,0,0,0,,欸
Dialogue: 1,0:07:46.40,0:07:48.19,F,,0,0,0,,和我在一起的話
Dialogue: 1,0:07:48.19,0:07:49.93,F,,0,0,0,,別人也會用奇怪的眼光看待你
Dialogue: 1,0:07:51.00,0:07:51.83,F,,0,0,0,,所以
Dialogue: 1,0:07:53.07,0:07:55.08,F,,0,0,0,,你還是不要和我有交集了
Dialogue: 1,0:07:57.40,0:07:59.82,F,,0,0,0,,真琴變成那樣的人了
Dialogue: 1,0:08:03.64,0:08:05.17,F,,0,0,0,,那我…
Dialogue: 1,0:08:10.53,0:08:11.80,F,,0,0,0,,喂  你
Dialogue: 1,0:08:13.15,0:08:15.30,F,,0,0,0,,你耳朵上是什麼
Dialogue: 1,0:08:15.69,0:08:18.06,F,,0,0,0,,喂  站住！
Dialogue: 1,0:08:22.58,0:08:25.05,F,,0,0,0,,我也成為那樣的人就好了
Dialogue: 1,0:08:30.02,0:08:31.09,F,,0,0,0,,真琴！
Dialogue: 1,0:08:34.49,0:08:37.01,F,,0,0,0,,一起吃午餐吧
Dialogue: 1,0:08:49.85,0:08:53.66,F,,0,0,0,,夏天到了  我像往常一樣來到屋頂
Dialogue: 1,0:08:55.02,0:08:56.36,F,,0,0,0,,卻發現那裡有個女孩子
Dialogue: 1,0:08:58.03,0:08:59.88,F,,0,0,0,,啊  龍二
Dialogue: 1,0:09:02.18,0:09:05.01,F,,0,0,0,,你…  你的頭髮…
Dialogue: 1,0:09:05.67,0:09:08.18,F,,0,0,0,,嗯  我買了假髮
Dialogue: 1,0:09:08.56,0:09:11.80,F,,0,0,0,,反正大家都知道我在女裝了  就乾脆這樣吧
Dialogue: 1,0:09:11.80,0:09:14.82,F,,0,0,0,,你在這種奇怪的地方真是果斷啊
Dialogue: 1,0:09:15.81,0:09:18.57,F,,0,0,0,,我憧憬長髮很久了呢
Dialogue: 1,0:09:19.58,0:09:22.08,F,,0,0,0,,雖然真琴依舊有些格格不入
Dialogue: 1,0:09:23.00,0:09:25.54,F,,0,0,0,,但他的日常還算不錯
Dialogue: 1,0:09:28.11,0:09:29.45,F,,0,0,0,,直到有一天…
Dialogue: 1,0:09:30.09,0:09:32.05,F,,0,0,0,,喂  龍二龍二
Dialogue: 1,0:09:33.01,0:09:34.88,F,,0,0,0,,你看這個
Dialogue: 1,0:09:34.88,0:09:36.98,F,,0,0,0,,真琴的照片
Dialogue: 1,0:09:38.98,0:09:40.26,F,,0,0,0,,哪裡來的
Dialogue: 1,0:09:40.56,0:09:42.65,F,,0,0,0,,E{\fscx50} {\fscx}班的人給我的
Dialogue: 1,0:09:42.65,0:09:44.16,F,,0,0,0,,你怎麼這麼高興
Dialogue: 1,0:09:44.16,0:09:46.36,F,,0,0,0,,別忘了  花岡可是男的
Dialogue: 1,0:09:46.36,0:09:48.88,F,,0,0,0,,男扮女裝有什麼好的
Dialogue: 1,0:09:48.88,0:09:51.10,F,,0,0,0,,有什麼關係嘛  很可愛啊
Dialogue: 1,0:09:51.10,0:09:54.13,F,,0,0,0,,你們也想要的話  我再去拿些來
Dialogue: 1,0:09:58.29,0:09:59.21,F,,0,0,0,,怎麼了怎麼了
Dialogue: 1,0:10:01.09,0:10:02.52,F,,0,0,0,,喂  住手
Dialogue: 1,0:10:02.52,0:10:04.28,F,,0,0,0,,冷靜點  大我
Dialogue: 1,0:10:05.04,0:10:07.55,F,,0,0,0,,快去叫老師過來
Dialogue: 1,0:10:09.29,0:10:11.17,F,,0,0,0,,真的非常抱歉
Dialogue: 1,0:10:11.17,0:10:12.77,F,,0,0,0,,沒關係的
Dialogue: 1,0:10:13.19,0:10:14.39,F,,0,0,0,,對不起
Dialogue: 1,0:10:14.39,0:10:16.67,F,,0,0,0,,龍二  你也道歉
Dialogue: 1,0:10:16.67,0:10:19.32,F,,0,0,0,,但我並沒能順利過好校園生活
Dialogue: 1,0:10:28.19,0:10:30.75,F,,0,0,0,,不過高一還是勉強撐了下來
Dialogue: 1,0:10:31.44,0:10:32.41,F,,0,0,0,,可是…
Dialogue: 1,0:10:39.19,0:10:41.45,F,,0,0,0,,怎麼會這樣被發現
Dialogue: 1,0:10:42.70,0:10:44.45,F,,0,0,0,,真…真琴…
Dialogue: 1,0:10:45.28,0:10:47.40,F,,0,0,0,,這是  那個…
Dialogue: 1,0:10:48.92,0:10:50.13,F,,0,0,0,,怎麼了
Dialogue: 1,0:10:50.92,0:10:53.06,F,,0,0,0,,給你  快點換衣服吧
Dialogue: 1,0:10:53.67,0:10:55.95,F,,0,0,0,,哦…哦…
Dialogue: 1,0:10:56.63,0:10:58.54,F,,0,0,0,,他沒看到嗎
Dialogue: 1,0:10:59.84,0:11:01.84,F,,0,0,0,,好險啊
Dialogue: 1,0:11:04.85,0:11:07.32,F,,0,0,0,,那我先去和班上的人會合了
Dialogue: 1,0:11:07.32,0:11:08.85,F,,0,0,0,,哦  再見
Dialogue: 1,0:11:12.51,0:11:13.58,F,,0,0,0,,太好了
Dialogue: 1,0:11:14.22,0:11:15.37,F,,0,0,0,,沒被發現
Dialogue: 1,0:11:26.45,0:11:29.20,F,,0,0,0,,我不是喜歡蒼井同學
Dialogue: 1,0:11:29.20,0:11:33.33,F,,0,0,0,,就是你最熟悉的人
Dialogue: 1,0:11:34.68,0:11:35.82,F,,0,0,0,,怎麼辦
Dialogue: 1,0:11:37.99,0:11:39.31,F,,0,0,0,,都是我的錯
Dialogue: 1,0:11:46.85,0:11:48.85,F,,0,0,0,,早安
Dialogue: 1,0:11:49.26,0:11:50.77,F,,0,0,0,,早…早安
Dialogue: 1,0:11:50.77,0:11:52.73,F,,0,0,0,,你好像…很睏
Dialogue: 1,0:11:52.73,0:11:56.01,F,,0,0,0,,嗯  昨天和小夏一起打遊戲了
Dialogue: 1,0:12:00.40,0:12:03.53,F,,0,0,0,,真琴  你是不是忘了戴圍巾
Dialogue: 1,0:12:05.28,0:12:06.45,F,,0,0,0,,要不要這個
Dialogue: 1,0:12:11.66,0:12:13.89,F,,0,0,0,,啊  不用了
Dialogue: 1,0:12:13.89,0:12:15.66,F,,0,0,0,,我今天不冷
Dialogue: 1,0:12:15.66,0:12:17.42,F,,0,0,0,,哦…  好吧
Dialogue: 1,0:13:01.22,0:13:02.21,F,,0,0,0,,真琴同學
Dialogue: 1,0:13:02.99,0:13:04.22,F,,0,0,0,,真琴同學
Dialogue: 1,0:13:04.94,0:13:06.69,F,,0,0,0,,真琴同學
Dialogue: 1,0:13:06.69,0:13:07.91,F,,0,0,0,,喂
Dialogue: 1,0:13:08.97,0:13:11.03,F,,0,0,0,,怎麼了  在想事情嗎？
Dialogue: 1,0:13:11.03,0:13:13.05,F,,0,0,0,,啊…  沒有
Dialogue: 1,0:13:13.89,0:13:16.73,F,,0,0,0,,有什麼煩惱的話可以跟我說哦
Dialogue: 1,0:13:21.23,0:13:24.44,F,,0,0,0,,我…我有一個認識的人
Dialogue: 1,0:13:24.44,0:13:25.49,F,,0,0,0,,嗯
Dialogue: 1,0:13:25.49,0:13:30.64,F,,0,0,0,,他朋友的學生手冊裡放了他的照片
Dialogue: 1,0:13:30.64,0:13:33.22,F,,0,0,0,,你覺得這代表什麼
Dialogue: 1,0:13:33.22,0:13:36.00,F,,0,0,0,,那肯定是因為喜歡他呀
Dialogue: 1,0:13:36.29,0:13:39.32,F,,0,0,0,,欸  這…這樣嗎
Dialogue: 1,0:13:39.32,0:13:42.71,F,,0,0,0,,不過那位朋友可能不想讓他知道吧
Dialogue: 1,0:13:42.71,0:13:44.09,F,,0,0,0,,為什麼
Dialogue: 1,0:13:44.70,0:13:47.84,F,,0,0,0,,那位朋友一定很珍惜他
Dialogue: 1,0:13:48.19,0:13:50.68,F,,0,0,0,,才會想隨身帶著他的照片
Dialogue: 1,0:13:51.24,0:13:52.36,F,,0,0,0,,這樣啊
Dialogue: 1,0:13:53.44,0:13:56.72,F,,0,0,0,,所以你是喜歡那位朋友嗎
Dialogue: 1,0:13:57.35,0:14:01.04,F,,0,0,0,,那個…  不…不是…
Dialogue: 1,0:14:01.04,0:14:02.74,F,,0,0,0,,我說的不是我自己
Dialogue: 1,0:14:02.74,0:14:04.03,F,,0,0,0,,啊  是哦
Dialogue: 1,0:14:04.03,0:14:06.36,F,,0,0,0,,對不起  說錯了
Dialogue: 1,0:14:13.80,0:14:16.10,F,,0,0,0,,真琴  回家吧
Dialogue: 1,0:14:20.51,0:14:22.76,F,,0,0,0,,我說  等下回家的路上…
Dialogue: 1,0:14:22.76,0:14:24.18,F,,0,0,0,,對不起  龍二
Dialogue: 1,0:14:25.01,0:14:27.76,F,,0,0,0,,我今天打算去參加籃球部的活動
Dialogue: 1,0:14:27.76,0:14:30.88,F,,0,0,0,,是嗎  那我先回去了
Dialogue: 1,0:14:30.88,0:14:31.89,F,,0,0,0,,嗯
Dialogue: 1,0:14:35.86,0:14:39.02,F,,0,0,0,,真琴  你頭髮上有灰塵
Dialogue: 1,0:14:47.64,0:14:49.94,F,,0,0,0,,那…那我先走了
Dialogue: 1,0:14:49.94,0:14:50.91,F,,0,0,0,,明天見
Dialogue: 1,0:14:51.19,0:14:52.66,F,,0,0,0,,你看到了嗎
Dialogue: 1,0:14:56.21,0:14:57.54,F,,0,0,0,,看到了什麼
Dialogue: 1,0:14:59.82,0:15:01.79,F,,0,0,0,,你真的不知道嗎
Dialogue: 1,0:15:02.14,0:15:04.04,F,,0,0,0,,欸  不知道
Dialogue: 1,0:15:06.80,0:15:09.80,F,,0,0,0,,你啊  真的很不會說謊
Dialogue: 1,0:15:09.80,0:15:11.80,F,,0,0,0,,我…我沒撒謊
Dialogue: 1,0:15:14.12,0:15:15.18,F,,0,0,0,,我能看出來
Dialogue: 1,0:15:17.68,0:15:19.50,F,,0,0,0,,因為我一直都在看著你
Dialogue: 1,0:15:26.00,0:15:28.54,F,,0,0,0,,我喜歡你  真琴
Dialogue: 1,0:15:47.40,0:15:48.09,F,,0,0,0,,對不起
Dialogue: 1,0:15:48.44,0:15:49.83,F,,0,0,0,,都是我的錯
Dialogue: 1,0:15:50.37,0:15:53.34,F,,0,0,0,,都怪我穿成這樣
Dialogue: 1,0:15:53.34,0:15:55.87,F,,0,0,0,,才會讓你誤以為我是女孩子
Dialogue: 1,0:15:57.10,0:15:59.59,F,,0,0,0,,真的很抱歉
Dialogue: 1,0:16:01.00,0:16:01.90,F,,0,0,0,,對不起…
Dialogue: 1,0:16:02.93,0:16:04.60,F,,0,0,0,,沒有誤會
Dialogue: 1,0:16:05.61,0:16:07.86,F,,0,0,0,,拜託你  不要再道歉了
Dialogue: 1,0:16:09.07,0:16:09.95,F,,0,0,0,,可是…
Dialogue: 1,0:16:10.86,0:16:12.54,F,,0,0,0,,這不是你的錯
Dialogue: 1,0:16:13.53,0:16:16.83,F,,0,0,0,,對不起  是我沒能藏住自己的感情
Dialogue: 1,0:16:18.24,0:16:19.44,F,,0,0,0,,我回去了
Dialogue: 1,0:16:19.44,0:16:20.75,F,,0,0,0,,等一下  龍二！
Dialogue: 1,0:16:20.75,0:16:22.75,F,,0,0,0,,明天我們還會一起上學的吧
Dialogue: 1,0:16:23.73,0:16:25.00,F,,0,0,0,,對不起
Dialogue: 1,0:16:25.00,0:16:27.00,F,,0,0,0,,我們不是好朋友嗎
Dialogue: 1,0:16:28.48,0:16:29.50,F,,0,0,0,,對不起
Dialogue: 1,0:16:37.33,0:16:39.92,F,,0,0,0,,難道…回不去了嗎
Dialogue: 1,0:17:01.54,0:17:03.37,F,,0,0,0,,{\3c&HFFFFFF&\t(65,400,\3c&H202020&)}因為我一直都在看著你
Dialogue: 1,0:17:03.37,0:17:05.61,F,,0,0,0,,我喜歡你  真琴
Dialogue: 1,0:17:05.61,0:17:06.74,F,,0,0,0,,拜託你…
Dialogue: 1,0:17:07.38,0:17:08.39,F,,0,0,0,,對不起
Dialogue: 1,0:17:10.29,0:17:11.34,F,,0,0,0,,什麼時候開始的
Dialogue: 1,0:17:12.38,0:17:14.70,F,,0,0,0,,蒼井同學早就知道了嗎
Dialogue: 1,0:17:18.22,0:17:20.81,F,,0,0,0,,我們第一次穿著水手服見面的時候
Dialogue: 1,0:17:21.10,0:17:23.56,F,,0,0,0,,大家知道我是男生的時候
Dialogue: 1,0:17:23.56,0:17:26.27,F,,0,0,0,,還有我沉迷於可愛東西的時候
Dialogue: 1,0:17:26.27,0:17:29.56,F,,0,0,0,,龍二從來沒有否定過我
Dialogue: 1,0:17:30.21,0:17:31.34,F,,0,0,0,,這樣下去…
Dialogue: 1,0:17:45.61,0:17:48.12,F,,0,0,0,,咦  小真  早安
Dialogue: 1,0:17:48.12,0:17:49.92,F,,0,0,0,,早安  小夏
Dialogue: 1,0:17:49.92,0:17:51.16,F,,0,0,0,,龍二在嗎
Dialogue: 1,0:17:51.16,0:17:53.22,F,,0,0,0,,哥哥已經走了
Dialogue: 1,0:17:53.22,0:17:55.18,F,,0,0,0,,欸  是嗎
Dialogue: 1,0:17:58.45,0:17:59.50,F,,0,0,0,,大我？
Dialogue: 1,0:18:03.14,0:18:04.77,F,,0,0,0,,他好像還沒來
Dialogue: 1,0:18:24.00,0:18:26.79,F,,0,0,0,,真是老套
Dialogue: 1,0:18:26.79,0:18:30.01,F,,0,0,0,,失戀後逃學去海邊
Dialogue: 1,0:18:30.01,0:18:33.69,F,,0,0,0,,好蠢啊  以為自己是青春豬頭少年嗎
Dialogue: 1,0:18:35.53,0:18:39.11,F,,0,0,0,,我這樣很噁心吧
Dialogue: 1,0:18:42.27,0:18:43.81,F,,0,0,0,,努力學習
Dialogue: 1,0:18:44.29,0:18:47.82,F,,0,0,0,,然後考上大學  和真琴分開
Dialogue: 1,0:18:48.32,0:18:50.65,F,,0,0,0,,不再去想真琴
Dialogue: 1,0:18:51.33,0:18:53.82,F,,0,0,0,,或許有一天  我們還能再做朋友…
Dialogue: 1,0:19:20.24,0:19:21.22,F,,0,0,0,,龍二！
Dialogue: 1,0:19:34.48,0:19:37.20,F,,0,0,0,,真琴…  為什麼
Dialogue: 1,0:19:37.61,0:19:40.30,F,,0,0,0,,我不想就這樣下去
Dialogue: 1,0:19:41.12,0:19:42.37,F,,0,0,0,,龍二
Dialogue: 1,0:19:42.37,0:19:44.10,F,,0,0,0,,我們交往吧
Dialogue: 1,0:19:50.12,0:19:53.63,F,,0,0,0,,不  但是…  真的？
Dialogue: 1,0:19:53.63,0:19:55.30,F,,0,0,0,,你不願意嗎
Dialogue: 1,0:20:05.18,0:20:07.66,F,,0,0,0,,我怎麼會…不願意
Dialogue: 1,0:20:18.57,0:20:20.70,F,,0,0,0,,蒼井  能出來一下嗎
Dialogue: 1,0:20:27.78,0:20:30.43,F,,0,0,0,,欸  奶奶？
Dialogue: 1,0:20:37.81,0:20:39.90,F,,0,0,0,,我得回學校了
Dialogue: 1,0:20:39.90,0:20:40.96,F,,0,0,0,,你有什麼打算
Dialogue: 1,0:20:41.72,0:20:44.04,F,,0,0,0,,我就不去了
Dialogue: 1,0:20:44.04,0:20:45.22,F,,0,0,0,,我回家
Dialogue: 1,0:20:45.22,0:20:47.55,F,,0,0,0,,好  我知道了
Dialogue: 1,0:20:48.15,0:20:49.05,F,,0,0,0,,在害羞
Dialogue: 1,0:20:50.78,0:20:52.15,F,,0,0,0,,那再見
Dialogue: 1,0:20:52.15,0:20:53.60,F,,0,0,0,,哦  再見
Dialogue: 1,0:21:00.18,0:21:01.81,F,,0,0,0,,有點害羞呢
Dialogue: 1,0:21:03.61,0:21:04.99,F,,0,0,0,,不過太好了
Dialogue: 1,0:21:05.99,0:21:09.55,F,,0,0,0,,這下我和龍二又能和好了
Dialogue: 0,0:00:01.07,0:00:02.77,A,,0,0,0,,竜二の制服　これ
Dialogue: 0,0:00:03.01,0:00:05.15,A,,0,0,0,,ああ　いい　自分で取る
Dialogue: 0,0:00:06.38,0:00:07.61,A,,0,0,0,,はい　竜二
Dialogue: 0,0:02:02.70,0:02:05.32,A,,0,0,0,,俺とまことは幼なじみで
Dialogue: 0,0:02:05.32,0:02:08.02,A,,0,0,0,,小学生のころも仲がよくて
Dialogue: 0,0:02:08.53,0:02:11.12,A,,0,0,0,,まことはよく俺の家に遊びに来ていた
Dialogue: 0,0:02:12.74,0:02:14.90,A,,0,0,0,,まこちゃん　今日泊まっていく
Dialogue: 0,0:02:15.51,0:02:16.69,A,,0,0,0,,そうしろよ
Dialogue: 0,0:02:16.69,0:02:17.87,A,,0,0,0,,あっ　うん
Dialogue: 0,0:02:17.87,0:02:20.03,A,,0,0,0,,じゃあ　お布団出しとくわね
Dialogue: 0,0:02:20.03,0:02:22.07,A,,0,0,0,,いいよ　一緒に寝るし
Dialogue: 0,0:02:22.07,0:02:22.88,A,,0,0,0,,なあ
Dialogue: 0,0:02:22.88,0:02:23.66,A,,0,0,0,,うん
Dialogue: 0,0:02:23.66,0:02:25.41,A,,0,0,0,,あら　そう
Dialogue: 0,0:02:28.16,0:02:30.29,A,,0,0,0,,じゃ　おやすみなさい
Dialogue: 0,0:02:30.29,0:02:31.93,A,,0,800,0,,おやすみ
Dialogue: 0,0:02:30.29,0:02:31.93,A,,300,0,0,,おやすみなさい
Dialogue: 0,0:02:34.74,0:02:37.25,A,,0,0,0,,僕　竜二んち好きだな
Dialogue: 0,0:02:37.25,0:02:38.22,A,,0,0,0,,なんで
Dialogue: 0,0:02:39.49,0:02:40.30,A,,0,0,0,,なんか
Dialogue: 0,0:02:42.21,0:02:44.18,A,,0,0,0,,よく寝れるんだよね
Dialogue: 0,0:02:45.29,0:02:46.81,A,,0,0,0,,そっか
Dialogue: 0,0:02:47.12,0:02:48.32,A,,0,0,0,,おやすみ
Dialogue: 0,0:02:51.36,0:02:52.57,A,,0,0,0,,おやすみ
Dialogue: 0,0:02:53.31,0:02:57.32,A,,0,0,0,,その夜は　まことが言ったことがやけにうれしくて
Dialogue: 0,0:02:57.76,0:03:00.07,A,,0,0,0,,なんだかずっとむずがゆくって
Dialogue: 0,0:03:00.61,0:03:02.48,A,,0,0,0,,全然眠れなくて
Dialogue: 0,0:03:02.48,0:03:07.68,A,,0,0,0,,月明かりに照らされて　キラキラ光るまことのまつげずっと見ていた
Dialogue: 0,0:03:09.10,0:03:10.69,A,,0,0,0,,きれいだな
Dialogue: 0,0:03:12.84,0:03:14.34,A,,0,0,0,,中学に入って
Dialogue: 0,0:03:14.60,0:03:17.93,A,,0,0,0,,不良っぽい同級生の{\fscx50} {\fscx}1{\fscx50} {\fscx}人がピアスを開けてきた
Dialogue: 0,0:03:20.09,0:03:21.85,A,,0,0,0,,よくやるよな～
Dialogue: 0,0:03:21.85,0:03:22.84,A,,0,0,0,,バカじゃん
Dialogue: 0,0:03:23.18,0:03:26.55,A,,0,0,0,,即行で生徒指導室に呼ばれてたそいつは
Dialogue: 0,0:03:26.55,0:03:28.51,A,,0,0,0,,それでもヘラヘラしてて
Dialogue: 0,0:03:28.51,0:03:30.10,A,,0,0,0,,変なヤツだなと思った
Dialogue: 0,0:03:31.05,0:03:32.82,A,,0,0,0,,俺とは違う人種だ
Dialogue: 0,0:03:33.35,0:03:35.74,A,,0,0,0,,俺はド普通な人間だから
Dialogue: 0,0:03:35.74,0:03:38.64,A,,0,0,0,,「そーいうの」に関わることはないと思ってたし
Dialogue: 0,0:03:39.42,0:03:42.11,A,,0,0,0,,以上のことをしっかり守るように
Dialogue: 0,0:03:42.72,0:03:44.24,A,,0,0,0,,おい　竜二竜二
Dialogue: 0,0:03:45.04,0:03:45.99,A,,0,0,0,,なんだ
Dialogue: 0,0:03:46.40,0:03:48.99,A,,0,0,0,,こいつ　まことのこと好きなんだって
Dialogue: 0,0:03:49.32,0:03:50.95,A,,0,0,0,,男同士なのに
Dialogue: 0,0:03:52.63,0:03:53.76,A,,0,0,0,,違うって
Dialogue: 0,0:03:53.76,0:03:56.67,A,,0,0,0,,きれいな顔してるよなって言っただけだろ
Dialogue: 0,0:03:56.67,0:03:58.63,A,,0,0,0,,まこと　こっち来いって
Dialogue: 0,0:03:58.97,0:04:00.39,A,,0,0,0,,えっ　なに
Dialogue: 0,0:04:00.39,0:04:01.88,A,,0,0,0,,ツーショット撮ってやるよ
Dialogue: 0,0:04:01.88,0:04:03.46,A,,0,0,0,,やめろよ～
Dialogue: 0,0:04:03.46,0:04:05.02,A,,0,0,0,,お～し　撮るぞ
Dialogue: 0,0:04:06.91,0:04:09.94,A,,0,0,0,,もちろん　俺もそーいうのにはなりたくなかったし
Dialogue: 0,0:04:12.56,0:04:14.10,A,,0,0,0,,よかったじゃん
Dialogue: 0,0:04:20.39,0:04:23.22,A,,0,0,0,,こいつ　まことのこと好きなんだって
Dialogue: 0,0:04:23.22,0:04:25.96,A,,0,0,0,,きれいな顔してるよなって言っただけだろ
Dialogue: 0,0:04:31.51,0:04:34.46,A,,0,0,0,,この日はどうにかして眠りたいと思った
Dialogue: 0,0:04:39.50,0:04:40.92,A,,0,0,0,,それ以来
Dialogue: 0,0:04:41.36,0:04:44.17,A,,0,0,0,,変にまことを意識してしまって
Dialogue: 0,0:04:46.30,0:04:48.80,A,,0,0,0,,なんとなく避けるようになって
Dialogue: 0,0:04:56.14,0:04:59.82,A,,0,0,0,,気付いたら　まこととは疎遠になっていた
Dialogue: 0,0:05:12.50,0:05:15.46,A,,0,0,0,,高校はまことがいないところに行こう
Dialogue: 0,0:05:18.34,0:05:20.88,A,,0,0,0,,だから家から遠い所にしたのに
Dialogue: 0,0:05:35.85,0:05:39.36,A,,0,0,0,,セーラー服を着たまことを見て驚いた
Dialogue: 0,0:05:40.28,0:05:41.23,A,,0,0,0,,まこと？
Dialogue: 0,0:05:48.24,0:05:49.15,A,,0,0,0,,お願い
Dialogue: 0,0:05:49.15,0:05:51.74,A,,0,0,0,,僕が男ってこと　誰にも言わないで
Dialogue: 0,0:05:51.74,0:05:54.90,A,,0,0,0,,いろいろあって　今女の子だと思われてて
Dialogue: 0,0:05:54.90,0:05:56.53,A,,0,0,0,,バレたくないんだ
Dialogue: 0,0:05:56.53,0:05:58.00,A,,0,0,0,,いろいろ…？
Dialogue: 0,0:05:58.00,0:06:02.19,A,,0,0,0,,その　話すと長いんだけど…
Dialogue: 0,0:06:03.13,0:06:06.88,A,,0,0,0,,セーラー服を着たまことは　変なヤツだった
Dialogue: 0,0:06:09.89,0:06:12.64,A,,0,0,0,,でも　やっぱりまことはまことで
Dialogue: 0,0:06:17.54,0:06:19.98,A,,0,0,0,,せっかく離れようと思ってたのに
Dialogue: 0,0:06:21.14,0:06:22.77,A,,0,0,0,,また近づいてしまった
Dialogue: 0,0:06:29.18,0:06:30.42,A,,0,0,0,,離れなければ…
Dialogue: 0,0:06:33.54,0:06:35.52,A,,0,0,0,,男同士なのに
Dialogue: 0,0:06:35.52,0:06:37.12,A,,0,0,0,,離れなければ…
Dialogue: 0,0:06:41.23,0:06:42.82,A,,0,0,0,,おはよう　竜二
Dialogue: 0,0:06:44.05,0:06:45.46,A,,0,0,0,,離れなければ…
Dialogue: 0,0:06:49.72,0:06:50.61,A,,0,0,0,,俺は…
Dialogue: 0,0:06:53.48,0:06:54.94,A,,0,0,0,,普通でいたい
Dialogue: 0,0:06:57.68,0:06:59.23,A,,0,0,0,,おい　聞いたか
Dialogue: 0,0:06:59.23,0:07:02.73,A,,0,0,0,,花岡まことってさ　男なんだって
Dialogue: 0,0:07:09.86,0:07:12.12,A,,0,0,0,,えっ　女装してたってこと？
Dialogue: 0,0:07:12.12,0:07:13.62,A,,0,0,0,,ヤバくない
Dialogue: 0,0:07:13.62,0:07:15.37,A,,0,0,0,,普通じゃないじゃん
Dialogue: 0,0:07:15.37,0:07:17.87,A,,0,0,0,,前からおかしいと思ってたんだよ
Dialogue: 0,0:07:17.87,0:07:19.12,A,,0,0,0,,キモッ
Dialogue: 0,0:07:19.12,0:07:19.99,A,,0,0,0,,なになに
Dialogue: 0,0:07:19.99,0:07:21.47,A,,0,0,0,,だまされてたわ
Dialogue: 0,0:07:20.49,0:07:22.00,G,,0,0,0,,ヤッバ～
Dialogue: 0,0:07:21.47,0:07:22.37,A,,0,0,0,,どういうこと
Dialogue: 0,0:07:32.99,0:07:34.64,A,,0,0,0,,おい　まこと
Dialogue: 0,0:07:35.76,0:07:36.89,A,,0,0,0,,竜二
Dialogue: 0,0:07:36.89,0:07:40.15,A,,0,0,0,,そ… その　なんだ…
Dialogue: 0,0:07:42.00,0:07:43.90,A,,0,0,0,,もうここに来ちゃ駄目だよ
Dialogue: 0,0:07:45.36,0:07:46.01,A,,0,0,0,,えっ
Dialogue: 0,0:07:46.40,0:07:48.19,A,,0,0,0,,僕と一緒にいたら
Dialogue: 0,0:07:48.19,0:07:49.93,A,,0,0,0,,竜二まで変に見られちゃう
Dialogue: 0,0:07:51.00,0:07:51.83,A,,0,0,0,,だから
Dialogue: 0,0:07:53.07,0:07:55.08,A,,0,0,0,,僕と関わらない方がいいよ
Dialogue: 0,0:07:57.40,0:07:59.82,A,,0,0,0,,まことはそーいうのになってしまった
Dialogue: 0,0:08:03.64,0:08:05.17,A,,0,0,0,,なら俺は…
Dialogue: 0,0:08:10.53,0:08:11.80,A,,0,0,0,,おい　お前
Dialogue: 0,0:08:13.15,0:08:15.30,A,,0,0,0,,なんだ　その耳は
Dialogue: 0,0:08:15.69,0:08:18.06,A,,0,0,0,,おい　こら　待て～！
Dialogue: 0,0:08:22.58,0:08:25.05,A,,0,0,0,,そーいう感じになったっていい
Dialogue: 0,0:08:30.02,0:08:31.09,A,,0,0,0,,まこと！
Dialogue: 0,0:08:34.49,0:08:37.01,A,,0,0,0,,昼飯　一緒に食おうぜ
Dialogue: 0,0:08:49.85,0:08:53.66,A,,0,0,0,,夏になって　いつものように屋上に行くと
Dialogue: 0,0:08:55.02,0:08:56.36,A,,0,0,0,,女の子がいた
Dialogue: 0,0:08:58.03,0:08:59.88,A,,0,0,0,,あっ　竜二
Dialogue: 0,0:09:02.18,0:09:05.01,A,,0,0,0,,おま…　その髪…
Dialogue: 0,0:09:05.67,0:09:08.18,A,,0,0,0,,うん　ウィッグ買ったんだ
Dialogue: 0,0:09:08.56,0:09:11.80,A,,0,0,0,,もう女装なのバレてるし　いいかなって
Dialogue: 0,0:09:11.80,0:09:14.82,A,,0,0,0,,お前って　変なとこ思い切りいいよな
Dialogue: 0,0:09:15.81,0:09:18.57,A,,0,0,0,,憧れてたんだよね　ロングヘア
Dialogue: 0,0:09:19.58,0:09:22.08,A,,0,0,0,,やっぱりまことは浮いてたけど
Dialogue: 0,0:09:23.00,0:09:25.54,A,,0,0,0,,それなりにうまくやってるみたいだった
Dialogue: 0,0:09:28.11,0:09:29.45,A,,0,0,0,,そんな　ある日…
Dialogue: 0,0:09:30.09,0:09:32.05,A,,0,0,0,,おい　竜二竜二
Dialogue: 0,0:09:33.01,0:09:34.88,A,,0,0,0,,見てみ　これ
Dialogue: 0,0:09:34.88,0:09:36.98,A,,0,0,0,,まことちゃんのブロマイド
Dialogue: 0,0:09:38.98,0:09:40.26,A,,0,0,0,,なんで持ってんの
Dialogue: 0,0:09:40.56,0:09:42.65,A,,0,0,0,,E{\fscx50} {\fscx}組のやつからもらった～
Dialogue: 0,0:09:42.65,0:09:44.16,A,,0,0,0,,なんでうれしそうなんだよ
Dialogue: 0,0:09:44.16,0:09:46.36,A,,0,0,0,,お前　花岡男だぞ
Dialogue: 0,0:09:46.36,0:09:48.88,A,,0,0,0,,何がいいんだよ　女装なんかしてるヤツ
Dialogue: 0,0:09:48.88,0:09:51.10,A,,0,0,0,,いいじゃん　カワイイだろ～
Dialogue: 0,0:09:51.10,0:09:54.13,A,,0,0,0,,お前らも欲しいなら　またもらってきてやるよ
Dialogue: 0,0:09:58.29,0:09:59.21,A,,0,0,0,,なになになに
Dialogue: 0,0:10:01.09,0:10:02.52,A,,0,0,0,,おい　やめろって
Dialogue: 0,0:10:02.52,0:10:04.28,A,,0,0,0,,落ち着けって　大我
Dialogue: 0,0:10:05.04,0:10:07.55,A,,0,0,0,,誰か　先生呼んできて
Dialogue: 0,0:10:09.29,0:10:11.17,A,,0,0,0,,本っ当にすみません
Dialogue: 0,0:10:11.17,0:10:12.77,A,,0,0,0,,いいんですよ
Dialogue: 0,0:10:13.19,0:10:14.39,A,,0,0,0,,すまん
Dialogue: 0,0:10:14.39,0:10:16.67,A,,0,0,0,,ほら　竜二も
Dialogue: 0,0:10:16.67,0:10:19.32,A,,0,0,0,,俺はあんまりうまくできなかったけど
Dialogue: 0,0:10:28.19,0:10:30.75,A,,0,0,0,,それでもなんとか{\fscx50} {\fscx}1{\fscx50} {\fscx}年やってきた
Dialogue: 0,0:10:31.44,0:10:32.41,A,,0,0,0,,なのに…
Dialogue: 0,0:10:39.19,0:10:41.45,A,,0,0,0,,こんなバレ方あるか
Dialogue: 0,0:10:42.70,0:10:44.45,A,,0,0,0,,ま… まこと…
Dialogue: 0,0:10:45.28,0:10:47.40,A,,0,0,0,,これは　その…
Dialogue: 0,0:10:48.92,0:10:50.13,A,,0,0,0,,どうしたの
Dialogue: 0,0:10:50.92,0:10:53.06,A,,0,0,0,,はい　早く着替えよ
Dialogue: 0,0:10:53.67,0:10:55.95,A,,0,0,0,,お… おう…
Dialogue: 0,0:10:56.63,0:10:58.54,A,,0,0,0,,見られてなかったのか
Dialogue: 0,0:10:59.84,0:11:01.84,A,,0,0,0,,あっぶね～
Dialogue: 0,0:11:04.85,0:11:07.32,A,,0,0,0,,じゃ僕　クラスに合流するね
Dialogue: 0,0:11:07.32,0:11:08.85,A,,0,0,0,,おう　またな
Dialogue: 0,0:11:12.51,0:11:13.58,A,,0,0,0,,よかった
Dialogue: 0,0:11:14.22,0:11:15.37,A,,0,0,0,,バレてなくて
Dialogue: 0,0:11:26.45,0:11:29.20,A,,0,0,0,,俺別に蒼井のこと好きじゃないぞ
Dialogue: 0,0:11:29.20,0:11:33.33,A,,0,0,0,,お前が　よ～く知ってるやつだよ
Dialogue: 0,0:11:34.68,0:11:35.82,A,,0,0,0,,どうしよう
Dialogue: 0,0:11:37.99,0:11:39.31,A,,0,0,0,,僕のせいだ
Dialogue: 0,0:11:46.85,0:11:48.85,A,,0,0,0,,おはよう
Dialogue: 0,0:11:49.26,0:11:50.77,A,,0,0,0,,お… おはよう
Dialogue: 0,0:11:50.77,0:11:52.73,A,,0,0,0,,眠そう… だね
Dialogue: 0,0:11:52.73,0:11:56.01,A,,0,0,0,,おう　昨日小夏とゲームしててな
Dialogue: 0,0:12:00.40,0:12:03.53,A,,0,0,0,,まこと　お前マフラー忘れてきたのか
Dialogue: 0,0:12:05.28,0:12:06.45,A,,0,0,0,,これ　使うか
Dialogue: 0,0:12:11.66,0:12:13.89,A,,0,0,0,,ああ　いや　いい
Dialogue: 0,0:12:13.89,0:12:15.66,A,,0,0,0,,今日暑いんだ　僕
Dialogue: 0,0:12:15.66,0:12:17.42,A,,0,0,0,,あ…　そう
Dialogue: 0,0:13:01.22,0:13:02.21,A,,0,0,0,,まことくん
Dialogue: 0,0:13:02.99,0:13:04.22,A,,0,0,0,,まことくん
Dialogue: 0,0:13:04.94,0:13:06.69,A,,0,0,0,,まことくん
Dialogue: 0,0:13:06.69,0:13:07.91,A,,0,0,0,,お～い
Dialogue: 0,0:13:08.97,0:13:11.03,A,,0,0,0,,どうしたの　考え事？
Dialogue: 0,0:13:11.03,0:13:13.05,A,,0,0,0,,ああ…　いや
Dialogue: 0,0:13:13.89,0:13:16.73,A,,0,0,0,,何か悩んでることでもあるなら　聞くよ
Dialogue: 0,0:13:21.23,0:13:24.44,A,,0,0,0,,し… 知り合いの話なんだけど
Dialogue: 0,0:13:24.44,0:13:25.49,A,,0,0,0,,うん
Dialogue: 0,0:13:25.49,0:13:30.64,A,,0,0,0,,その子の友達の生徒手帳に　自分の写真が入ってたんだって
Dialogue: 0,0:13:30.64,0:13:33.22,A,,0,0,0,,それって　どういうことだと思う
Dialogue: 0,0:13:33.22,0:13:36.00,A,,0,0,0,,そりゃあ　その子のことが好きなんじゃない
Dialogue: 0,0:13:36.29,0:13:39.32,A,,0,0,0,,えっ　そ… そうなの
Dialogue: 0,0:13:39.32,0:13:42.71,A,,0,0,0,,でも　友達の方はバレたくなかったかもね
Dialogue: 0,0:13:42.71,0:13:44.09,A,,0,0,0,,どうして
Dialogue: 0,0:13:44.70,0:13:47.84,A,,0,0,0,,きっと　すごくその子のこと大事なんだよ
Dialogue: 0,0:13:48.19,0:13:50.68,A,,0,0,0,,写真を身につけておきたいくらいだもん
Dialogue: 0,0:13:51.24,0:13:52.36,A,,0,0,0,,そっか
Dialogue: 0,0:13:53.44,0:13:56.72,A,,0,0,0,,で　まことくんはその友達のことが好きなの
Dialogue: 0,0:13:57.35,0:14:01.04,A,,0,0,0,,えっと…　それは　ち… 違う…
Dialogue: 0,0:14:01.04,0:14:02.74,A,,0,0,0,,僕の話じゃないから
Dialogue: 0,0:14:02.74,0:14:04.03,A,,0,0,0,,あっ　そうだよね～
Dialogue: 0,0:14:04.03,0:14:06.36,A,,0,0,0,,ごめ～ん　うっかり～
Dialogue: 0,0:14:13.80,0:14:16.10,A,,0,0,0,,まこと　帰ろうぜ
Dialogue: 0,0:14:20.51,0:14:22.76,A,,0,0,0,,あのさ～　この後途中でさ…
Dialogue: 0,0:14:22.76,0:14:24.18,A,,0,0,0,,ごめん　竜二
Dialogue: 0,0:14:25.01,0:14:27.76,A,,0,0,0,,今日　バスケ部参加しようと思ってて
Dialogue: 0,0:14:27.76,0:14:30.88,A,,0,0,0,,おっ　そうなのか　じゃあ先帰るわ
Dialogue: 0,0:14:30.88,0:14:31.89,A,,0,0,0,,うん
Dialogue: 0,0:14:35.86,0:14:39.02,A,,0,0,0,,まこと　髪にほこりついてるぞ
Dialogue: 0,0:14:47.64,0:14:49.94,A,,0,0,0,,じ… じゃあ　僕もう行くね
Dialogue: 0,0:14:49.94,0:14:50.91,A,,0,0,0,,またあした
Dialogue: 0,0:14:51.19,0:14:52.66,A,,0,0,0,,見えてたのか
Dialogue: 0,0:14:56.21,0:14:57.54,A,,0,0,0,,なんのこと
Dialogue: 0,0:14:59.82,0:15:01.79,A,,0,0,0,,本当に分からないのか
Dialogue: 0,0:15:02.14,0:15:04.04,A,,0,0,0,,えっ　ああ　うん
Dialogue: 0,0:15:06.80,0:15:09.80,A,,0,0,0,,お前　ホント嘘つくの下手だよな
Dialogue: 0,0:15:09.80,0:15:11.80,A,,0,0,0,,う… 嘘じゃないよ
Dialogue: 0,0:15:14.12,0:15:15.18,A,,0,0,0,,分かるよ
Dialogue: 0,0:15:17.68,0:15:19.50,A,,0,0,0,,ずっと見てきたから
Dialogue: 0,0:15:26.00,0:15:28.54,A,,0,0,0,,好きだよ　まこと
Dialogue: 0,0:15:47.40,0:15:48.09,A,,0,0,0,,ごめん
Dialogue: 0,0:15:48.44,0:15:49.83,A,,0,0,0,,僕のせいだよね
Dialogue: 0,0:15:50.37,0:15:53.34,A,,0,0,0,,僕が　こんなカッコしてるから
Dialogue: 0,0:15:53.34,0:15:55.87,A,,0,0,0,,女の子だって　勘違いしちゃったんだ
Dialogue: 0,0:15:57.10,0:15:59.59,A,,0,0,0,,本当に　ごめん
Dialogue: 0,0:16:01.00,0:16:01.90,A,,0,0,0,,ごめん…
Dialogue: 0,0:16:02.93,0:16:04.60,A,,0,0,0,,勘違いじゃない
Dialogue: 0,0:16:05.61,0:16:07.86,A,,0,0,0,,頼むから　もう謝らないでくれ
Dialogue: 0,0:16:09.07,0:16:09.95,A,,0,0,0,,でも…
Dialogue: 0,0:16:10.86,0:16:12.54,A,,0,0,0,,まことは悪くない
Dialogue: 0,0:16:13.53,0:16:16.83,A,,0,0,0,,ごめんな　俺の方こそ隠しきれなくて
Dialogue: 0,0:16:18.24,0:16:19.44,A,,0,0,0,,帰るわ
Dialogue: 0,0:16:19.44,0:16:20.75,A,,0,0,0,,待って　竜二！
Dialogue: 0,0:16:20.75,0:16:22.75,A,,0,0,0,,あした　一緒に登校するよね
Dialogue: 0,0:16:23.73,0:16:25.00,A,,0,0,0,,ごめん
Dialogue: 0,0:16:25.00,0:16:27.00,A,,0,0,0,,僕たち親友じゃないの
Dialogue: 0,0:16:28.48,0:16:29.50,A,,0,0,0,,ごめん
Dialogue: 0,0:16:37.33,0:16:39.92,A,,0,0,0,,もう… 戻れないの
Dialogue: 0,0:17:01.54,0:17:03.37,A,,0,0,0,,{\3c&HFFFFFF&\t(65,400,\3c&H202020&)}ずっと見てきたから
Dialogue: 0,0:17:03.37,0:17:05.61,A,,0,0,0,,好きだよ　まこと
Dialogue: 0,0:17:05.61,0:17:06.74,A,,0,0,0,,頼むから…
Dialogue: 0,0:17:07.38,0:17:08.39,A,,0,0,0,,ごめん
Dialogue: 0,0:17:10.29,0:17:11.34,A,,0,0,0,,いつから
Dialogue: 0,0:17:12.38,0:17:14.70,A,,0,0,0,,蒼井さんは知ってたのかな
Dialogue: 0,0:17:18.22,0:17:20.81,A,,0,0,0,,セーラー服で初めて会ったときも
Dialogue: 0,0:17:21.10,0:17:23.56,A,,0,0,0,,みんなに男だってバレたときも
Dialogue: 0,0:17:23.56,0:17:26.27,A,,0,0,0,,カワイイものに夢中になってたときも
Dialogue: 0,0:17:26.27,0:17:29.56,A,,0,0,0,,竜二は一度だって　僕を否定しなかった
Dialogue: 0,0:17:30.21,0:17:31.34,A,,0,0,0,,このままじゃ…
Dialogue: 0,0:17:45.61,0:17:48.12,A,,0,0,0,,あれ　まこちゃん　おはよう
Dialogue: 0,0:17:48.12,0:17:49.92,A,,0,0,0,,おはよう　小夏ちゃん
Dialogue: 0,0:17:49.92,0:17:51.16,A,,0,0,0,,竜二いる
Dialogue: 0,0:17:51.16,0:17:53.22,A,,0,0,0,,お兄ならもう行ったよ
Dialogue: 0,0:17:53.22,0:17:55.18,A,,0,0,0,,えっ　そうなの
Dialogue: 0,0:17:58.45,0:17:59.50,A,,0,0,0,,大我？
Dialogue: 0,0:18:03.14,0:18:04.77,A,,0,0,0,,まだ来てないっぽいけど
Dialogue: 0,0:18:24.00,0:18:26.79,A,,0,0,0,,すげえべたなことしちゃった
Dialogue: 0,0:18:26.79,0:18:30.01,A,,0,0,0,,失恋して学校サボって海とか
Dialogue: 0,0:18:30.01,0:18:33.69,A,,0,0,0,,バカか　俺は　青春野郎か
Dialogue: 0,0:18:35.53,0:18:39.11,A,,0,0,0,,気持ち悪かったよな　普通に
Dialogue: 0,0:18:42.27,0:18:43.81,A,,0,0,0,,勉強しよう
Dialogue: 0,0:18:44.29,0:18:47.82,A,,0,0,0,,んで　大学行って　まことと離れて
Dialogue: 0,0:18:48.32,0:18:50.65,A,,0,0,0,,まことのこと考えないようにして
Dialogue: 0,0:18:51.33,0:18:53.82,A,,0,0,0,,そしたら　いつかまた友達…
Dialogue: 0,0:19:20.24,0:19:21.22,A,,0,0,0,,竜二！
Dialogue: 0,0:19:34.48,0:19:37.20,A,,0,0,0,,まこと…　なんで
Dialogue: 0,0:19:37.61,0:19:40.30,A,,0,0,0,,僕　このままじゃ嫌だよ
Dialogue: 0,0:19:41.12,0:19:42.37,A,,0,0,0,,竜二
Dialogue: 0,0:19:42.37,0:19:44.10,A,,0,0,0,,僕と付き合おう
Dialogue: 0,0:19:50.12,0:19:53.63,A,,0,0,0,,いや　でも…　えっ　マジで？
Dialogue: 0,0:19:53.63,0:19:55.30,A,,0,0,0,,竜二は嫌なの
Dialogue: 0,0:20:05.18,0:20:07.66,A,,0,0,0,,嫌なわけ… ない
Dialogue: 0,0:20:18.57,0:20:20.70,A,,0,0,0,,蒼井　ちょっといいか
Dialogue: 0,0:20:27.78,0:20:30.43,A,,0,0,0,,えっ　おばあちゃんが？
Dialogue: 0,0:20:37.81,0:20:39.90,A,,0,0,0,,僕　学校戻るけど
Dialogue: 0,0:20:39.90,0:20:40.96,A,,0,0,0,,竜二はどうする
Dialogue: 0,0:20:41.72,0:20:44.04,A,,0,0,0,,いや　俺はいいわ
Dialogue: 0,0:20:44.04,0:20:45.22,A,,0,0,0,,帰る
Dialogue: 0,0:20:45.22,0:20:47.55,A,,0,0,0,,そっか　分かった
Dialogue: 0,0:20:48.15,0:20:49.05,A,,0,0,0,,照れてる
Dialogue: 0,0:20:50.78,0:20:52.15,A,,0,0,0,,じゃ　また
Dialogue: 0,0:20:52.15,0:20:53.60,A,,0,0,0,,おう　また
Dialogue: 0,0:21:00.18,0:21:01.81,A,,0,0,0,,なんか照れるな
Dialogue: 0,0:21:03.61,0:21:04.99,A,,0,0,0,,でも　よかった
Dialogue: 0,0:21:05.99,0:21:09.55,A,,0,0,0,,これで　竜二と元に戻れる
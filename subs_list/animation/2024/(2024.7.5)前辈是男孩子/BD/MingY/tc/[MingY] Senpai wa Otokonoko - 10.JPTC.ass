Dialogue: 0,0:01:55.50,0:02:00.76,E,,0,108,148,,{\fad(500,500)\an3\fn方正中雅宋_GBK\fs60\fsp3\bord7\blur5\t(750,1500,\bord5\blur3)\1a&Hff&\3c&HDD967D&}第{\3c&HDE9C82&}1{\3c&HDFA288&}0{\3c&HE0A88E&}話 {\3c&HE2B499&}二{\3c&HE3BA9F&}人{\3c&HE4C0A4&}的{\3c&HE5C6AA&}情{\3c&HE7CDB0&}感
Dialogue: 0,0:01:55.50,0:02:00.76,E,,0,108,148,,{\fad(500,500)\an3\fn方正中雅宋_GBK\fs60\fsp3\bord0\blur2\t(0,500,\blur0)\shad3\c&HFFFFFF&\4c&H8B8A86&}第10話 二人的情感
Dialogue: 1,0:00:05.14,0:00:06.03,E,,0,0,0,,我…
Dialogue: 1,0:00:06.61,0:00:08.36,E,,0,0,0,,我想說些什麼
Dialogue: 1,0:00:08.78,0:00:11.36,E,,0,0,0,,可是不知道說什麼才能不傷害他
Dialogue: 1,0:00:11.62,0:00:14.70,E,,0,0,0,,也不知道說什麼才能讓他高興
Dialogue: 1,0:00:16.55,0:00:18.36,E,,0,0,0,,真是一點都不明白
Dialogue: 1,0:00:18.36,0:00:19.12,E,,0,0,0,,真琴
Dialogue: 1,0:00:22.75,0:00:23.62,E,,0,0,0,,再見
Dialogue: 1,0:02:01.98,0:02:03.55,E,,0,0,0,,師傅
Dialogue: 1,0:02:03.55,0:02:04.60,E,,0,0,0,,喲
Dialogue: 1,0:02:09.25,0:02:11.53,E,,0,0,0,,我說啊
Dialogue: 1,0:02:11.53,0:02:14.24,E,,0,0,0,,給你添麻煩也沒關係吧
Dialogue: 1,0:02:14.73,0:02:17.24,E,,0,0,0,,那倒是沒關係
Dialogue: 1,0:02:17.87,0:02:20.61,E,,0,0,0,,你真了不起啊
Dialogue: 1,0:02:20.94,0:02:22.91,E,,0,0,0,,即使知道真琴是男扮女裝
Dialogue: 1,0:02:22.91,0:02:24.78,E,,0,0,0,,即使知道我喜歡真琴
Dialogue: 1,0:02:24.78,0:02:26.62,E,,0,0,0,,你也沒有表現出一點驚訝
Dialogue: 1,0:02:26.98,0:02:29.12,E,,0,0,0,,那是什麼意思
Dialogue: 1,0:02:30.62,0:02:33.25,E,,0,0,0,,大多數人都會嚇一跳
Dialogue: 1,0:02:33.25,0:02:35.13,E,,0,0,0,,至少會有點驚訝吧
Dialogue: 1,0:02:36.05,0:02:39.32,E,,0,0,0,,我真羨慕你…
Dialogue: 1,0:02:43.43,0:02:46.64,E,,0,0,0,,我倒是羨慕師傅你呢
Dialogue: 1,0:02:50.99,0:02:52.24,E,,0,0,0,,為什麼
Dialogue: 1,0:02:52.24,0:02:54.40,E,,0,0,0,,為什麼我就做不好呢
Dialogue: 1,0:02:58.67,0:03:00.99,E,,0,0,0,,如果是蒼井同學  會怎麼做呢
Dialogue: 1,0:03:03.89,0:03:05.24,E,,0,0,0,,不行
Dialogue: 1,0:03:06.54,0:03:08.12,E,,0,0,0,,得靠自己去想
Dialogue: 1,0:03:08.87,0:03:12.09,E,,0,0,0,,這是我必須自己去想的
Dialogue: 1,0:03:15.65,0:03:16.88,E,,0,0,0,,如果能…
Dialogue: 1,0:03:19.43,0:03:20.40,E,,0,0,0,,活得…
Dialogue: 1,0:03:21.76,0:03:23.57,E,,0,0,0,,更輕鬆一點就好了
Dialogue: 1,0:03:31.40,0:03:33.02,E,,0,0,0,,喂  等等
Dialogue: 1,0:03:33.43,0:03:34.63,E,,0,0,0,,你要去哪裡
Dialogue: 1,0:03:36.00,0:03:37.90,E,,0,0,0,,你看不出來嗎
Dialogue: 1,0:03:43.72,0:03:46.09,E,,0,0,0,,我要去沒有前輩的地方
Dialogue: 1,0:03:47.71,0:03:51.18,E,,0,0,0,,前輩做不出普通的選擇
Dialogue: 1,0:03:51.18,0:03:53.92,E,,0,0,0,,所以我們不會幸福的
Dialogue: 1,0:03:54.62,0:03:57.54,E,,0,0,0,,我們不能在一起了
Dialogue: 1,0:03:58.06,0:03:58.92,E,,0,0,0,,等一下
Dialogue: 1,0:03:59.49,0:04:03.02,E,,0,0,0,,那我應該怎麼做才好呢
Dialogue: 1,0:04:04.23,0:04:06.43,E,,0,0,0,,倒是真琴前輩你呢
Dialogue: 1,0:04:06.75,0:04:08.58,E,,0,0,0,,你想怎麼樣
Dialogue: 1,0:04:08.58,0:04:10.94,E,,0,0,0,,你得自己去想清楚
Dialogue: 1,0:04:11.92,0:04:12.94,E,,0,0,0,,蒼井同學
Dialogue: 1,0:04:13.23,0:04:14.46,E,,0,0,0,,我大概是…
Dialogue: 1,0:04:15.23,0:04:16.64,E,,0,0,0,,對你…
Dialogue: 1,0:04:22.06,0:04:23.99,E,,0,0,0,,是…是夢啊…
Dialogue: 1,0:04:24.53,0:04:27.77,E,,0,0,0,,如果我能是個女孩就好了
Dialogue: 1,0:04:27.77,0:04:30.54,E,,0,0,0,,這樣就能真正地喜歡上龍二了…
Dialogue: 1,0:04:31.61,0:04:32.87,E,,0,0,0,,喜歡上…
Dialogue: 1,0:04:38.38,0:04:40.88,E,,0,0,0,,不對  不是這樣的
Dialogue: 1,0:04:41.81,0:04:42.74,E,,0,0,0,,我…
Dialogue: 1,0:04:52.08,0:04:53.89,E,,0,0,0,,謝謝你的照顧了
Dialogue: 1,0:04:54.38,0:04:57.31,E,,0,0,0,,太好了啊  能這麼快出院
Dialogue: 1,0:04:57.31,0:05:01.15,E,,0,0,0,,新年也到了  希望最近都不用再來了
Dialogue: 1,0:05:01.15,0:05:02.86,E,,0,0,0,,京子阿姨
Dialogue: 1,0:05:04.00,0:05:05.65,E,,0,0,0,,謝謝你能來
Dialogue: 1,0:05:05.92,0:05:07.16,E,,0,0,0,,沒事
Dialogue: 1,0:05:07.46,0:05:10.36,E,,0,0,0,,我正好有些話想和你媽媽聊聊呢
Dialogue: 1,0:05:10.36,0:05:11.66,E,,0,0,0,,原來如此
Dialogue: 1,0:05:11.99,0:05:14.61,E,,0,0,0,,找個地方去吃飯吧
Dialogue: 1,0:05:14.61,0:05:16.17,E,,0,0,0,,媽媽想吃什麼
Dialogue: 1,0:05:16.97,0:05:18.89,E,,0,0,0,,壽司吧
Dialogue: 1,0:05:22.43,0:05:23.72,E,,0,0,0,,新年快樂
Dialogue: 1,0:05:23.72,0:05:25.17,E,,0,0,0,,今年請多關照
Dialogue: 1,0:05:27.28,0:05:29.43,E,,0,0,0,,第三學期
Dialogue: 1,0:05:29.83,0:05:31.98,E,,0,0,0,,耶
Dialogue: 1,0:05:39.80,0:05:41.18,E,,0,0,0,,前輩！
Dialogue: 1,0:05:41.95,0:05:44.32,E,,0,0,0,,蒼井同學  早…
Dialogue: 1,0:05:44.32,0:05:46.76,E,,0,0,0,,不對  已經中午了
Dialogue: 1,0:05:46.76,0:05:47.95,E,,0,0,0,,是啊
Dialogue: 1,0:05:47.95,0:05:49.53,E,,0,0,0,,啊  師傅
Dialogue: 1,0:05:54.45,0:05:56.96,E,,0,0,0,,你不跟他打聲招呼嗎
Dialogue: 1,0:05:57.63,0:05:58.34,E,,0,0,0,,嗯
Dialogue: 1,0:05:59.10,0:06:01.71,E,,0,0,0,,不去找他可能會更好吧
Dialogue: 1,0:06:03.59,0:06:06.47,E,,0,0,0,,抱歉  我先回教室了
Dialogue: 1,0:06:18.73,0:06:19.60,E,,0,0,0,,是你啊
Dialogue: 1,0:06:20.24,0:06:22.11,E,,0,0,0,,等等…  師傅
Dialogue: 1,0:06:22.11,0:06:27.11,E,,0,0,0,,你不會再和真琴前輩一起吃便當 一起聊天了嗎
Dialogue: 1,0:06:27.11,0:06:29.29,E,,0,0,0,,也沒辦法吧
Dialogue: 1,0:06:29.29,0:06:32.87,E,,0,0,0,,繼續和我有聯繫  對真琴沒有好處
Dialogue: 1,0:06:35.37,0:06:36.19,E,,0,0,0,,不要啊！
Dialogue: 1,0:06:36.19,0:06:38.37,E,,0,0,0,,你這麼說也沒用…
Dialogue: 1,0:06:38.68,0:06:41.89,E,,0,0,0,,他和我在一起的時候  總是在忍耐
Dialogue: 1,0:06:41.89,0:06:44.45,E,,0,0,0,,不喜歡我  卻還和我在一起
Dialogue: 1,0:06:45.81,0:06:47.40,E,,0,0,0,,所以這樣就好
Dialogue: 1,0:06:48.87,0:06:50.31,E,,0,0,0,,怎麼會這樣…
Dialogue: 1,0:07:03.07,0:07:04.08,E,,0,0,0,,龍二
Dialogue: 1,0:07:04.08,0:07:05.10,E,,0,0,0,,真琴
Dialogue: 1,0:07:08.20,0:07:09.12,E,,0,0,0,,辛苦了
Dialogue: 1,0:07:13.36,0:07:15.62,E,,0,0,0,,我追上去要幹什麼
Dialogue: 1,0:07:15.92,0:07:18.62,E,,0,0,0,,我們應該保持距離才對
Dialogue: 1,0:07:19.76,0:07:21.13,E,,0,0,0,,我不想再…
Dialogue: 1,0:07:26.06,0:07:27.57,E,,0,0,0,,讓你討厭我了
Dialogue: 1,0:07:37.68,0:07:38.74,E,,0,0,0,,怎麼了
Dialogue: 1,0:07:38.74,0:07:41.11,E,,0,0,0,,你從剛才開始就心煩意亂的
Dialogue: 1,0:07:41.11,0:07:42.52,E,,0,0,0,,啊  奶奶
Dialogue: 1,0:07:42.52,0:07:45.52,E,,0,0,0,,真是稀奇  沒想到你也會煩惱
Dialogue: 1,0:07:46.00,0:07:49.65,E,,0,0,0,,我以為你是那種在煩惱之前就先行動的人
Dialogue: 1,0:07:50.87,0:07:52.15,E,,0,0,0,,是啊
Dialogue: 1,0:07:52.70,0:07:54.32,E,,0,0,0,,謝謝你  奶奶
Dialogue: 1,0:08:01.71,0:08:02.50,E,,0,0,0,,什…
Dialogue: 1,0:08:03.42,0:08:04.48,E,,0,0,0,,什…
Dialogue: 1,0:08:06.00,0:08:07.86,E,,0,800,0,,為什麼真琴在？
Dialogue: 1,0:08:06.00,0:08:07.86,E,,800,0,0,,為什麼龍二在？
Dialogue: 1,0:08:08.90,0:08:09.93,E,,0,0,0,,嘿嘿
Dialogue: 1,0:08:10.99,0:08:13.51,E,,0,0,0,,你說要幫忙  所以我就來了
Dialogue: 1,0:08:14.45,0:08:17.10,E,,0,0,0,,跟我說的是找到個非可愛的地方
Dialogue: 1,0:08:18.08,0:08:19.60,E,,0,0,0,,輕鬆拿捏
Dialogue: 1,0:08:19.60,0:08:21.10,E,,0,0,0,,你啊…
Dialogue: 1,0:08:21.49,0:08:23.77,E,,0,0,0,,蒼井同學  抱歉  但我們…
Dialogue: 1,0:08:23.77,0:08:26.27,E,,0,0,0,,好了好了  來個小測驗吧
Dialogue: 1,0:08:26.73,0:08:30.86,E,,0,0,0,,鯨魚之間能交流的距離有多遠
Dialogue: 1,0:08:30.86,0:08:32.00,E,,0,0,0,,欸？
Dialogue: 1,0:08:32.00,0:08:34.17,E,,0,0,0,,①  50{\fscx50} {\fscx}米
Dialogue: 1,0:08:34.17,0:08:36.28,E,,0,0,0,,②  5{\fscx50} {\fscx}公里
Dialogue: 1,0:08:36.28,0:08:38.54,E,,0,0,0,,③  500{\fscx50} {\fscx}公里
Dialogue: 1,0:08:38.54,0:08:40.94,E,,0,0,0,,呃  正常來說應該是①吧
Dialogue: 1,0:08:40.94,0:08:42.25,E,,0,0,0,,鯨魚那麼大  可能是②？
Dialogue: 1,0:08:42.25,0:08:43.53,E,,0,0,0,,③好像不可能
Dialogue: 1,0:08:43.53,0:08:45.54,E,,0,0,0,,不對！
Dialogue: 1,0:08:45.54,0:08:47.44,E,,0,0,0,,答案是③
Dialogue: 1,0:08:47.44,0:08:50.15,E,,0,0,0,,因為它們在深海裡  所以能做到
Dialogue: 1,0:08:51.98,0:08:54.91,E,,0,0,0,,但我們不是鯨魚
Dialogue: 1,0:08:54.91,0:08:56.56,E,,0,0,0,,如果不見面
Dialogue: 1,0:08:56.56,0:08:58.55,E,,0,0,0,,就無法交談
Dialogue: 1,0:08:58.93,0:09:02.73,E,,0,0,0,,那時  因為前輩和師傅帶我出去
Dialogue: 1,0:09:02.73,0:09:05.14,E,,0,0,0,,讓我覺得「啊  沒事了」
Dialogue: 1,0:09:05.44,0:09:08.70,E,,0,0,0,,所以這次輪到我來幫你們兩個了
Dialogue: 1,0:09:09.40,0:09:10.81,E,,0,0,0,,小不點…
Dialogue: 1,0:09:10.81,0:09:11.94,E,,0,0,0,,蒼井同學
Dialogue: 1,0:09:12.72,0:09:14.90,E,,0,0,0,,那麼  你們去吧
Dialogue: 1,0:09:20.39,0:09:22.62,E,,0,0,0,,你應該想和蒼井同學單獨相處吧
Dialogue: 1,0:09:22.62,0:09:23.72,E,,0,0,0,,呃！
Dialogue: 1,0:09:24.12,0:09:27.37,E,,0,0,0,,龍二  你不就是以為我不會來所以才來的吧
Dialogue: 1,0:09:29.04,0:09:31.13,E,,0,0,0,,雖然對不起蒼井同學  我要回去了
Dialogue: 1,0:09:31.13,0:09:32.50,E,,0,0,0,,你要逃跑嗎？
Dialogue: 1,0:09:34.18,0:09:34.95,E,,0,0,0,,你啊…
Dialogue: 1,0:09:34.95,0:09:35.84,E,,0,0,0,,我…
Dialogue: 1,0:09:37.28,0:09:39.22,E,,0,0,0,,我想和你好好談談
Dialogue: 1,0:09:41.68,0:09:42.90,E,,0,0,0,,我知道了
Dialogue: 1,0:09:44.15,0:09:45.92,E,,0,0,0,,我們先去找個項目玩玩吧
Dialogue: 1,0:09:45.92,0:09:46.56,E,,0,0,0,,嗯
Dialogue: 1,0:09:50.78,0:09:51.77,E,,0,0,0,,好害怕…
Dialogue: 1,0:09:51.77,0:09:53.32,E,,0,0,0,,太厲害了吧
Dialogue: 1,0:09:54.02,0:09:55.32,E,,0,0,0,,龍二  快看
Dialogue: 1,0:09:55.65,0:09:56.95,E,,0,0,0,,那裡有什麼東西
Dialogue: 1,0:09:57.28,0:09:58.57,E,,0,0,0,,那是什麼
Dialogue: 1,0:09:58.57,0:10:01.16,E,,0,0,0,,是外星人嗎  好可愛
Dialogue: 1,0:10:01.16,0:10:03.45,E,,0,0,0,,那東西  可愛嗎
Dialogue: 1,0:10:30.19,0:10:31.86,E,,0,0,0,,去坐那個吧
Dialogue: 1,0:10:31.86,0:10:33.36,E,,0,0,0,,嗯  走吧
Dialogue: 1,0:10:34.15,0:10:35.48,E,,0,0,0,,好懷念啊
Dialogue: 1,0:10:35.98,0:10:40.79,E,,0,0,0,,幼兒園的時候  我超級怕龍二的
Dialogue: 1,0:10:40.79,0:10:42.49,E,,0,0,0,,欸 是嗎
Dialogue: 1,0:10:42.49,0:10:43.51,E,,0,0,0,,嗯
Dialogue: 1,0:10:43.51,0:10:46.50,E,,0,0,0,,你每天都要捉弄我
Dialogue: 1,0:10:46.50,0:10:49.10,E,,0,0,0,,總是把青蛙和蟲子塞給我看
Dialogue: 1,0:10:50.16,0:10:52.25,E,,0,0,0,,哦  好像是這樣
Dialogue: 1,0:10:52.78,0:10:57.09,E,,0,0,0,,你記得我們玩捉迷藏時  你一直沒出來嗎
Dialogue: 1,0:10:57.38,0:10:59.59,E,,0,0,0,,嗯  記得
Dialogue: 1,0:11:00.16,0:11:03.16,E,,0,0,0,,那時候我想  如果找不到龍二的話
Dialogue: 1,0:11:03.16,0:11:05.86,E,,0,0,0,,就不會有人說我討厭的話了
Dialogue: 1,0:11:05.86,0:11:08.68,E,,0,0,0,,所以我求神讓你不要出來
Dialogue: 1,0:11:09.32,0:11:11.53,E,,0,0,0,,結果你真的沒出來
Dialogue: 1,0:11:12.19,0:11:15.56,E,,0,0,0,,我以為是我導致你消失了
Dialogue: 1,0:11:15.56,0:11:18.19,E,,0,0,0,,然後  我變得很難過
Dialogue: 1,0:11:19.13,0:11:21.03,E,,0,0,0,,非常難過
Dialogue: 1,0:11:23.53,0:11:24.69,E,,0,0,0,,這樣啊
Dialogue: 1,0:11:32.21,0:11:34.15,E,,0,0,0,,你喜歡這個嗎
Dialogue: 1,0:11:34.80,0:11:36.21,E,,0,0,0,,我要買
Dialogue: 1,0:11:36.48,0:11:37.40,E,,0,0,0,,哦…
Dialogue: 1,0:11:41.22,0:11:43.20,E,,0,0,0,,是當作禮物嗎
Dialogue: 1,0:11:43.20,0:11:45.66,E,,0,0,0,,不  是我自己用的
Dialogue: 1,0:11:45.66,0:11:47.22,E,,0,0,0,,明白了
Dialogue: 1,0:11:55.65,0:11:57.73,E,,0,0,0,,你變了呢
Dialogue: 1,0:11:57.73,0:11:58.55,E,,0,0,0,,欸？
Dialogue: 1,0:11:59.23,0:12:02.56,E,,0,0,0,,你對那些東西不再那麼顧慮了
Dialogue: 1,0:12:03.36,0:12:05.99,E,,0,0,0,,剛才你也不在意周圍的目光
Dialogue: 1,0:12:06.75,0:12:08.49,E,,0,0,0,,是啊
Dialogue: 1,0:12:08.49,0:12:10.70,E,,0,0,0,,喜歡的東西沒變
Dialogue: 1,0:12:12.34,0:12:16.75,E,,0,0,0,,我依然喜歡像女孩子一樣的長髮
Dialogue: 1,0:12:17.46,0:12:19.00,E,,0,0,0,,可愛的小飾品
Dialogue: 1,0:12:19.78,0:12:21.51,E,,0,0,0,,還有粉色
Dialogue: 1,0:12:21.77,0:12:25.71,E,,0,0,0,,最近我還想著  如果能告訴媽媽就好了
Dialogue: 1,0:12:25.71,0:12:29.39,E,,0,0,0,,和媽媽的關係  也希望能夠好起來
Dialogue: 1,0:12:30.46,0:12:31.48,E,,0,0,0,,還有你
Dialogue: 1,0:12:32.92,0:12:34.34,E,,0,0,0,,龍二
Dialogue: 1,0:12:34.34,0:12:37.27,E,,0,0,0,,我不想這樣繼續下去
Dialogue: 1,0:12:39.70,0:12:40.73,E,,0,0,0,,別這樣
Dialogue: 1,0:12:41.08,0:12:42.74,E,,0,0,0,,我很噁心吧
Dialogue: 1,0:12:45.17,0:12:47.74,E,,0,0,0,,不  可是該怎麼辦呢
Dialogue: 1,0:12:48.93,0:12:50.20,E,,0,0,0,,我不知道
Dialogue: 1,0:12:50.20,0:12:51.96,E,,0,0,0,,你該知道的
Dialogue: 1,0:12:51.96,0:12:54.61,E,,0,0,0,,我是個男的  卻喜歡你
Dialogue: 1,0:12:54.61,0:12:57.58,E,,0,0,0,,和你在一起  你也會覺得不舒服…
Dialogue: 1,0:12:58.45,0:13:00.59,E,,0,0,0,,我反覆想過
Dialogue: 1,0:13:01.60,0:13:05.37,E,,0,0,0,,我該對你說什麼  該怎麼做才是對的
Dialogue: 1,0:13:05.37,0:13:06.59,E,,0,0,0,,真琴…
Dialogue: 1,0:13:07.45,0:13:09.12,E,,0,0,0,,但是我不明白…
Dialogue: 1,0:13:09.98,0:13:13.10,E,,0,0,0,,可是我也無法就這麼算了
Dialogue: 1,0:13:13.10,0:13:17.10,E,,0,0,0,,所以  你能不能和我一起想想
Dialogue: 1,0:13:19.24,0:13:21.05,E,,0,0,0,,你真的可以接受這樣嗎
Dialogue: 1,0:13:21.54,0:13:22.56,E,,0,0,0,,嗯
Dialogue: 1,0:13:22.56,0:13:24.61,E,,0,0,0,,你可能會覺得不舒服啊
Dialogue: 1,0:13:24.61,0:13:26.86,E,,0,0,0,,這種事對我們都一樣啊
Dialogue: 1,0:13:27.26,0:13:29.91,E,,0,0,0,,如果我一直都無法放棄呢
Dialogue: 1,0:13:31.81,0:13:33.40,E,,0,0,0,,那也沒關係
Dialogue: 1,0:13:34.87,0:13:37.10,E,,0,0,0,,龍二
Dialogue: 1,0:13:38.38,0:13:41.63,E,,0,0,0,,我們再一起吃午餐吧
Dialogue: 1,0:13:44.36,0:13:46.81,E,,0,0,0,,那時候我也很難過
Dialogue: 1,0:13:46.81,0:13:48.72,E,,0,0,0,,在黑暗中  心中不安
Dialogue: 1,0:13:50.07,0:13:50.72,E,,0,0,0,,不過…
Dialogue: 1,0:13:53.03,0:13:54.83,E,,0,0,0,,原來你也是那樣
Dialogue: 1,0:13:56.01,0:13:58.27,E,,0,0,0,,我們兩個人都很難過
Dialogue: 1,0:14:02.68,0:14:03.98,E,,0,0,0,,我回來了
Dialogue: 1,0:14:05.01,0:14:07.06,E,,0,0,0,,所以我才擔心你
Dialogue: 1,0:14:07.06,0:14:09.49,E,,0,0,0,,如果又暈倒了該怎麼辦
Dialogue: 1,0:14:10.24,0:14:11.73,E,,0,0,0,,京子阿姨？
Dialogue: 1,0:14:13.10,0:14:15.50,E,,0,0,0,,雖然這麼說
Dialogue: 1,0:14:15.50,0:14:19.79,E,,0,0,0,,你哥哥只顧著鯨魚的事  根本指望不上他
Dialogue: 1,0:14:33.51,0:14:35.34,E,,0,0,0,,啊  飛機的尾跡
Dialogue: 1,0:14:37.37,0:14:38.92,E,,0,0,0,,今天一定要…
Dialogue: 1,0:14:38.92,0:14:41.40,E,,0,0,0,,今天一定要  今天一定要
Dialogue: 1,0:14:41.40,0:14:42.96,E,,0,0,0,,保佑我…
Dialogue: 1,0:14:43.40,0:14:45.28,E,,0,0,0,,見到小咲
Dialogue: 1,0:14:47.99,0:14:49.78,E,,0,0,0,,好痛痛痛…
Dialogue: 1,0:14:53.26,0:14:55.11,E,,0,0,0,,小…咲？
Dialogue: 1,0:14:56.54,0:14:58.79,E,,0,0,0,,媽媽？
Dialogue: 1,0:15:00.39,0:15:01.69,E,,0,0,0,,本人？
Dialogue: 1,0:15:05.52,0:15:08.93,E,,0,0,0,,真琴  頭髮長了呢
Dialogue: 1,0:15:08.93,0:15:11.05,E,,0,0,0,,差不多該剪了吧
Dialogue: 1,0:15:11.05,0:15:14.08,E,,0,0,0,,我幫你預約美容院吧
Dialogue: 1,0:15:14.08,0:15:15.56,E,,0,0,0,,這個週末怎麼樣
Dialogue: 1,0:15:20.00,0:15:21.06,E,,0,0,0,,真琴
Dialogue: 1,0:15:21.56,0:15:22.62,E,,0,0,0,,怎麼了
Dialogue: 1,0:15:24.19,0:15:25.82,E,,0,0,0,,和媽媽的關係…
Dialogue: 1,0:15:27.10,0:15:31.91,E,,0,0,0,,我…我自己決定  什麼時候剪頭髮
Dialogue: 1,0:15:34.91,0:15:36.41,E,,0,0,0,,哎呀  這樣啊
Dialogue: 1,0:15:37.39,0:15:40.41,E,,0,0,0,,對不起啊  不知不覺就把你當小孩了
Dialogue: 1,0:15:40.41,0:15:43.04,E,,0,0,0,,真琴也快要高三了嘛
Dialogue: 1,0:15:45.54,0:15:47.53,E,,0,0,0,,說…說出來了
Dialogue: 1,0:15:49.40,0:15:50.86,E,,0,0,0,,說出來了！
Dialogue: 1,0:15:52.05,0:15:54.68,E,,0,0,0,,我真是不行啊
Dialogue: 1,0:15:55.92,0:16:01.03,E,,0,0,0,,明明真琴跟那個人不一樣
Dialogue: 1,0:16:02.96,0:16:05.20,E,,0,0,0,,什麼時候才能放下心啊
Dialogue: 1,0:16:07.39,0:16:08.53,E,,0,0,0,,奶奶
Dialogue: 1,0:16:09.10,0:16:11.90,E,,0,0,0,,明天我可以晚點回家嗎
Dialogue: 1,0:16:12.41,0:16:14.21,E,,0,0,0,,是要跟朋友出去玩嗎
Dialogue: 1,0:16:15.09,0:16:19.54,E,,0,0,0,,其實呢  今天我見到媽媽了…
Dialogue: 1,0:16:20.79,0:16:21.98,E,,0,0,0,,不行
Dialogue: 1,0:16:22.79,0:16:25.79,E,,0,0,0,,明天要按時回家
Dialogue: 1,0:16:25.79,0:16:28.23,E,,0,0,0,,好了  這個話題就到此為止吧
Dialogue: 1,0:16:28.23,0:16:29.30,E,,0,0,0,,為什麼
Dialogue: 1,0:16:30.10,0:16:31.06,E,,0,0,0,,為什麼
Dialogue: 1,0:16:33.30,0:16:35.01,E,,0,0,0,,為什麼不行
Dialogue: 1,0:16:35.87,0:16:38.01,E,,0,0,0,,我說的都是為你好
Dialogue: 1,0:16:38.74,0:16:41.36,E,,0,0,0,,別再和她接觸了
Dialogue: 1,0:16:46.64,0:16:48.52,E,,0,0,0,,為什麼啊
Dialogue: 1,0:16:49.07,0:16:51.36,E,,0,0,0,,哦  有煩惱嗎
Dialogue: 1,0:16:51.36,0:16:52.71,E,,0,0,0,,老師
Dialogue: 1,0:16:52.71,0:16:56.84,E,,0,0,0,,怎麼讓固執的老人家鬆口呢
Dialogue: 1,0:16:56.84,0:17:00.87,E,,0,0,0,,那就給她沏一杯茶  再配上大佛餅乾
Dialogue: 1,0:17:00.87,0:17:02.05,E,,0,0,0,,咲
Dialogue: 1,0:17:02.87,0:17:05.36,E,,0,0,0,,有客人來了哦~
Dialogue: 1,0:17:07.38,0:17:10.88,E,,0,0,0,,那個…  怎麼說呢…
Dialogue: 1,0:17:11.52,0:17:13.47,E,,0,0,0,,我們和好了…
Dialogue: 1,0:17:13.47,0:17:15.93,E,,0,0,0,,但是  還是感覺很尷尬啊
Dialogue: 1,0:17:15.93,0:17:16.93,E,,0,0,0,,你能明白的吧
Dialogue: 1,0:17:16.93,0:17:17.97,E,,0,0,0,,哦哦
Dialogue: 1,0:17:17.97,0:17:21.47,E,,0,0,0,,所以呢  你也一起來吃午餐吧
Dialogue: 1,0:17:21.77,0:17:23.98,E,,0,0,0,,這倒是沒問題
Dialogue: 1,0:17:23.98,0:17:27.48,E,,0,0,0,,不過你得陪陪我哦
Dialogue: 1,0:17:33.48,0:17:36.17,E,,0,0,0,,也就是說  你奶奶生氣了
Dialogue: 1,0:17:36.17,0:17:40.27,E,,0,0,0,,你想確認你媽媽是不是個危險人物
Dialogue: 1,0:17:40.27,0:17:42.36,E,,0,0,0,,嗯  差不多吧
Dialogue: 1,0:17:42.36,0:17:45.00,E,,0,0,0,,有點像偵探呢  好興奮啊
Dialogue: 1,0:17:45.73,0:17:47.75,E,,0,0,0,,啊  看到了  就是那個人
Dialogue: 1,0:17:48.07,0:17:49.74,E,,0,0,0,,看起來是個溫柔的人
Dialogue: 1,0:17:50.72,0:17:54.77,E,,0,0,0,,有種似曾相識的感覺  好像某個人
Dialogue: 1,0:17:54.77,0:17:56.34,E,,0,0,0,,欸  像誰
Dialogue: 1,0:17:57.76,0:18:01.76,E,,0,0,0,,她一直在等我吧
Dialogue: 1,0:18:01.76,0:18:06.02,E,,0,0,0,,她一定很在乎蒼井同學吧
Dialogue: 1,0:18:06.02,0:18:07.73,E,,0,0,0,,是啊
Dialogue: 1,0:18:07.73,0:18:09.77,E,,0,0,0,,你也想和她說話吧
Dialogue: 1,0:18:09.77,0:18:12.27,E,,0,0,0,,是這樣沒錯…
Dialogue: 1,0:18:12.27,0:18:14.58,E,,0,0,0,,那你應該去見她
Dialogue: 1,0:18:14.58,0:18:17.53,E,,0,0,0,,嗯  去吧  小不點
Dialogue: 1,0:18:20.28,0:18:21.01,E,,0,0,0,,好的
Dialogue: 1,0:18:22.03,0:18:24.29,E,,0,0,0,,奶奶  對不起
Dialogue: 1,0:18:24.29,0:18:26.54,E,,0,0,0,,今天不能聽你的了
Dialogue: 1,0:18:26.54,0:18:28.56,E,,0,0,0,,因為那是我媽媽啊
Dialogue: 1,0:18:28.56,0:18:29.54,E,,0,0,0,,是我的…
Dialogue: 1,0:18:36.78,0:18:38.39,E,,0,0,0,,媽媽啊
Dialogue: 1,0:18:45.56,0:18:48.56,E,,0,0,0,,呃  好像還不夠吧
Dialogue: 1,0:18:48.98,0:18:50.02,E,,0,0,0,,不好意思
Dialogue: 1,0:18:50.02,0:18:52.66,E,,0,0,0,,夠…夠了  真的夠了
Dialogue: 1,0:18:52.66,0:18:54.19,E,,0,0,0,,真的？
Dialogue: 1,0:18:54.93,0:18:58.48,E,,0,0,0,,話說  來這麼貴的地方沒問題嗎
Dialogue: 1,0:18:58.48,0:18:59.57,E,,0,0,0,,當然
Dialogue: 1,0:19:00.10,0:19:03.17,E,,0,0,0,,和你爸爸離婚的時候  我確實沒什麼錢
Dialogue: 1,0:19:03.17,0:19:07.36,E,,0,0,0,,但我考到了資格證  足夠跟小咲一起生活了
Dialogue: 1,0:19:07.36,0:19:08.33,E,,0,0,0,,欸
Dialogue: 1,0:19:08.33,0:19:11.33,E,,0,0,0,,啊  對不起  順序不太對
Dialogue: 1,0:19:11.33,0:19:14.53,E,,0,0,0,,也不是馬上就和你…
Dialogue: 1,0:19:14.53,0:19:18.84,E,,0,0,0,,但是我一直想和小咲一起生活
Dialogue: 1,0:19:19.40,0:19:21.90,E,,0,0,0,,見不到你的這段時間  我也一直想著
Dialogue: 1,0:19:24.81,0:19:26.75,E,,0,0,0,,欸  不好意思  小咲
Dialogue: 1,0:19:26.75,0:19:29.85,E,,0,0,0,,太突然了  你可能接受不了
Dialogue: 1,0:19:30.93,0:19:32.60,E,,0,0,0,,沒錯
Dialogue: 1,0:19:32.96,0:19:34.81,E,,0,0,0,,我的媽媽…
Dialogue: 1,0:19:35.95,0:19:40.22,E,,0,0,0,,在我哭的時候  會比我還傷心
Dialogue: 1,0:19:40.72,0:19:42.70,E,,0,0,0,,會跟我一起哭
Dialogue: 1,0:19:43.47,0:19:47.20,E,,0,0,0,,這樣的人就是我的媽媽
Dialogue: 1,0:19:49.84,0:19:51.83,E,,0,0,0,,今天真的很開心
Dialogue: 1,0:19:52.40,0:19:54.36,E,,0,0,0,,我還可以再來看你嗎
Dialogue: 1,0:19:54.36,0:19:55.21,E,,0,0,0,,嗯
Dialogue: 1,0:19:55.21,0:19:57.90,E,,0,0,0,,啊  不介意的話要不要去我家 就在附近
Dialogue: 1,0:19:57.90,0:20:00.12,E,,0,0,0,,不了  我還是不去了
Dialogue: 1,0:20:00.12,0:20:02.72,E,,0,0,0,,婆婆一定會生氣的
Dialogue: 1,0:20:03.46,0:20:04.45,E,,0,0,0,,這樣啊
Dialogue: 1,0:20:04.45,0:20:06.57,E,,0,0,0,,那再見了  小咲
Dialogue: 1,0:20:06.57,0:20:07.96,E,,0,0,0,,嗯 再見
Dialogue: 1,0:20:10.56,0:20:13.38,E,,0,0,0,,為什麼奶奶會反對呢
Dialogue: 1,0:20:22.11,0:20:24.66,E,,0,0,0,,和她聊一聊就能知道了
Dialogue: 1,0:20:27.12,0:20:30.12,E,,0,0,0,,我不是讓你按時回家了嗎
Dialogue: 1,0:20:30.80,0:20:33.12,E,,0,0,0,,對不起  可是…
Dialogue: 1,0:20:33.48,0:20:35.99,E,,0,0,0,,下次一定要聽話哦
Dialogue: 1,0:20:36.49,0:20:37.63,E,,0,0,0,,為什麼
Dialogue: 1,0:20:37.63,0:20:39.41,E,,0,0,0,,為什麼不行
Dialogue: 1,0:20:40.38,0:20:44.38,E,,0,0,0,,奶奶是不想讓你受委屈
Dialogue: 1,0:20:44.72,0:20:47.35,E,,0,0,0,,我沒有受什麼委屈
Dialogue: 1,0:20:48.83,0:20:50.02,E,,0,0,0,,咲…
Dialogue: 1,0:20:50.60,0:20:53.48,E,,0,0,0,,見到媽媽我真的很開心啊
Dialogue: 1,0:20:59.23,0:21:00.80,E,,0,0,0,,我知道了
Dialogue: 1,0:21:00.80,0:21:01.48,E,,0,0,0,,來
Dialogue: 1,0:21:01.73,0:21:02.74,E,,0,0,0,,欸
Dialogue: 1,0:21:02.74,0:21:04.01,E,,0,0,0,,電話
Dialogue: 1,0:21:04.01,0:21:06.40,E,,0,0,0,,能給媽媽打電話嗎
Dialogue: 1,0:21:06.40,0:21:07.24,E,,0,0,0,,嗯
Dialogue: 1,0:21:08.28,0:21:10.02,E,,0,0,0,,對不起啊
Dialogue: 1,0:21:10.02,0:21:13.25,E,,0,0,0,,咲也到了能自己做決定的年紀了
Dialogue: 1,0:21:13.81,0:21:17.00,E,,0,0,0,,讓我跟你媽媽聊一會吧
Dialogue: 1,0:21:17.83,0:21:18.54,E,,0,0,0,,嗯
Dialogue: 0,0:00:05.14,0:00:06.03,A,,0,0,0,,何か…
Dialogue: 0,0:00:06.61,0:00:08.36,A,,0,0,0,,何か言いたいんだけど
Dialogue: 0,0:00:08.78,0:00:11.36,A,,0,0,0,,何を言えば傷つけなくて済むのか
Dialogue: 0,0:00:11.62,0:00:14.70,A,,0,0,0,,何を言えば　喜んでもらえるのか
Dialogue: 0,0:00:16.55,0:00:18.36,A,,0,0,0,,一つも分からない
Dialogue: 0,0:00:18.36,0:00:19.12,A,,0,0,0,,まこと
Dialogue: 0,0:00:22.75,0:00:23.62,A,,0,0,0,,じゃあな
Dialogue: 0,0:02:01.98,0:02:03.55,A,,0,0,0,,師匠
Dialogue: 0,0:02:03.55,0:02:04.60,A,,0,0,0,,よう
Dialogue: 0,0:02:09.25,0:02:11.53,A,,0,0,0,,俺だってさあ
Dialogue: 0,0:02:11.53,0:02:14.24,A,,0,0,0,,お前なら迷惑かけていいだろ
Dialogue: 0,0:02:14.73,0:02:17.24,A,,0,0,0,,そりゃあいいですけど
Dialogue: 0,0:02:17.87,0:02:20.61,A,,0,0,0,,お前はさ　すごいよな
Dialogue: 0,0:02:20.94,0:02:22.91,A,,0,0,0,,まことが女装って知っても
Dialogue: 0,0:02:22.91,0:02:24.78,A,,0,0,0,,俺がまことを好きって知っても
Dialogue: 0,0:02:24.78,0:02:26.62,A,,0,0,0,,「えっ」ってならなかっただろ
Dialogue: 0,0:02:26.98,0:02:29.12,A,,0,0,0,,「えっ」ってなんですか
Dialogue: 0,0:02:30.62,0:02:33.25,A,,0,0,0,,大抵のヤツはびっくりするんだよ
Dialogue: 0,0:02:33.25,0:02:35.13,A,,0,0,0,,ちょっとは「えっ」ってなるんだよ
Dialogue: 0,0:02:36.05,0:02:39.32,A,,0,0,0,,俺は　お前が羨ましい…
Dialogue: 0,0:02:43.43,0:02:46.64,A,,0,0,0,,私は師匠が羨ましいですけどね
Dialogue: 0,0:02:50.99,0:02:52.24,A,,0,0,0,,どうして
Dialogue: 0,0:02:52.24,0:02:54.40,A,,0,0,0,,なんでうまくできないんだ
Dialogue: 0,0:02:58.67,0:03:00.99,A,,0,0,0,,蒼井さんならどうしてたかな
Dialogue: 0,0:03:03.89,0:03:05.24,A,,0,0,0,,ダメだ
Dialogue: 0,0:03:06.54,0:03:08.12,A,,0,0,0,,自分で考えなきゃ
Dialogue: 0,0:03:08.87,0:03:12.09,A,,0,0,0,,これは僕が考えなきゃ
Dialogue: 0,0:03:15.65,0:03:16.88,A,,0,0,0,,もっと…
Dialogue: 0,0:03:19.43,0:03:20.40,A,,0,0,0,,うまく…
Dialogue: 0,0:03:21.76,0:03:23.57,A,,0,0,0,,生きられたらいいのに
Dialogue: 0,0:03:31.40,0:03:33.02,A,,0,0,0,,ねえ　待って
Dialogue: 0,0:03:33.43,0:03:34.63,A,,0,0,0,,どこに行くの
Dialogue: 0,0:03:36.00,0:03:37.90,A,,0,0,0,,分からないんですか
Dialogue: 0,0:03:43.72,0:03:46.09,A,,0,0,0,,先輩のいない所ですよ
Dialogue: 0,0:03:47.71,0:03:51.18,A,,0,0,0,,先輩が普通の選択をしてくれないから
Dialogue: 0,0:03:51.18,0:03:53.92,A,,0,0,0,,私たち　幸せになれないんです
Dialogue: 0,0:03:54.62,0:03:57.54,A,,0,0,0,,もう　一緒にいられない
Dialogue: 0,0:03:58.06,0:03:58.92,A,,0,0,0,,待って
Dialogue: 0,0:03:59.49,0:04:03.02,A,,0,0,0,,じゃあ僕は　どうしたらよかったの
Dialogue: 0,0:04:04.23,0:04:06.43,A,,0,0,0,,まこと先輩こそ
Dialogue: 0,0:04:06.75,0:04:08.58,A,,0,0,0,,どうしたいんですか
Dialogue: 0,0:04:08.58,0:04:10.94,A,,0,0,0,,それを考えなきゃ
Dialogue: 0,0:04:11.92,0:04:12.94,A,,0,0,0,,蒼井さん
Dialogue: 0,0:04:13.23,0:04:14.46,A,,0,0,0,,僕はきっと…
Dialogue: 0,0:04:15.23,0:04:16.64,A,,0,0,0,,蒼井さんのことが…
Dialogue: 0,0:04:22.06,0:04:23.99,A,,0,0,0,,ゆ… 夢か…
Dialogue: 0,0:04:24.53,0:04:27.77,A,,0,0,0,,僕が女の子だったらよかったのかな
Dialogue: 0,0:04:27.77,0:04:30.54,A,,0,0,0,,そしたら竜二のこともちゃんと好きに…
Dialogue: 0,0:04:31.61,0:04:32.87,A,,0,0,0,,好きに…
Dialogue: 0,0:04:38.38,0:04:40.88,A,,0,0,0,,違う　そうじゃないんだ
Dialogue: 0,0:04:41.81,0:04:42.74,A,,0,0,0,,僕は…
Dialogue: 0,0:04:52.08,0:04:53.89,A,,0,0,0,,お世話になりました
Dialogue: 0,0:04:54.38,0:04:57.31,A,,0,0,0,,よかったわねえ　早く退院できて
Dialogue: 0,0:04:57.31,0:05:01.15,A,,0,0,0,,年も明けたことだし　しばらくは来たくないねえ
Dialogue: 0,0:05:01.15,0:05:02.86,A,,0,0,0,,京子おばちゃん
Dialogue: 0,0:05:04.00,0:05:05.65,A,,0,0,0,,来てくれてありがとう
Dialogue: 0,0:05:05.92,0:05:07.16,A,,0,0,0,,いいのよ
Dialogue: 0,0:05:07.46,0:05:10.36,A,,0,0,0,,ちょっと母さんと話したいこともあったから
Dialogue: 0,0:05:10.36,0:05:11.66,A,,0,0,0,,そうなんだ
Dialogue: 0,0:05:11.99,0:05:14.61,A,,0,0,0,,どっかご飯でも食べに行きましょうか
Dialogue: 0,0:05:14.61,0:05:16.17,A,,0,0,0,,母さんは何がいい
Dialogue: 0,0:05:16.97,0:05:18.89,A,,0,0,0,,お寿司がいいかね
Dialogue: 0,0:05:22.43,0:05:23.72,A,,0,0,0,,あけおめ～
Dialogue: 0,0:05:23.72,0:05:25.17,A,,0,0,0,,ことよろ～
Dialogue: 0,0:05:27.28,0:05:29.43,A,,0,0,0,,3{\fscx50} {\fscx}学期
Dialogue: 0,0:05:29.83,0:05:31.98,A,,0,0,0,,イエ～イ
Dialogue: 0,0:05:39.80,0:05:41.18,A,,0,0,0,,先輩！
Dialogue: 0,0:05:41.95,0:05:44.32,A,,0,0,0,,蒼井さん　おはよう…
Dialogue: 0,0:05:44.32,0:05:46.76,A,,0,0,0,,じゃなくて　もうお昼だった
Dialogue: 0,0:05:46.76,0:05:47.95,A,,0,0,0,,ですね
Dialogue: 0,0:05:47.95,0:05:49.53,A,,0,0,0,,あっ　師匠だ
Dialogue: 0,0:05:54.45,0:05:56.96,A,,0,0,0,,声かけなくていいんですか
Dialogue: 0,0:05:57.63,0:05:58.34,A,,0,0,0,,うん
Dialogue: 0,0:05:59.10,0:06:01.71,A,,0,0,0,,きっと　そのほうがいいんだ
Dialogue: 0,0:06:03.59,0:06:06.47,A,,0,0,0,,ごめん　教室戻るね
Dialogue: 0,0:06:18.73,0:06:19.60,A,,0,0,0,,お前か
Dialogue: 0,0:06:20.24,0:06:22.11,A,,0,0,0,,ちょっ…　師匠
Dialogue: 0,0:06:22.11,0:06:27.11,A,,0,0,0,,もうまこと先輩と　お弁当食べたり話したりしないんですか
Dialogue: 0,0:06:27.11,0:06:29.29,A,,0,0,0,,しかたないだろ
Dialogue: 0,0:06:29.29,0:06:32.87,A,,0,0,0,,このまま俺と関わってても　まことにいいことねえし
Dialogue: 0,0:06:35.37,0:06:36.19,A,,0,0,0,,嫌です！
Dialogue: 0,0:06:36.19,0:06:38.37,A,,0,0,0,,いや　そんなこと言われても…
Dialogue: 0,0:06:38.68,0:06:41.89,A,,0,0,0,,あいつ我慢しちゃうだろ　俺といるの
Dialogue: 0,0:06:41.89,0:06:44.45,A,,0,0,0,,好きじゃないのに　つきあっちゃうくらいだし
Dialogue: 0,0:06:45.81,0:06:47.40,A,,0,0,0,,だからこれでいいんだよ
Dialogue: 0,0:06:48.87,0:06:50.31,A,,0,0,0,,そんな…
Dialogue: 0,0:07:03.07,0:07:04.08,A,,0,0,0,,竜二
Dialogue: 0,0:07:04.08,0:07:05.10,A,,0,0,0,,まこと
Dialogue: 0,0:07:08.20,0:07:09.12,A,,0,0,0,,お疲れ
Dialogue: 0,0:07:13.36,0:07:15.62,A,,0,0,0,,追いかけてどうするんだ
Dialogue: 0,0:07:15.92,0:07:18.62,A,,0,0,0,,こうやってなるべく離れてたらいい
Dialogue: 0,0:07:19.76,0:07:21.13,A,,0,0,0,,もうこれ以上…
Dialogue: 0,0:07:26.06,0:07:27.57,A,,0,0,0,,嫌われたくない
Dialogue: 0,0:07:37.68,0:07:38.74,A,,0,0,0,,なんだい
Dialogue: 0,0:07:38.74,0:07:41.11,A,,0,0,0,,さっきから　モヤモヤモヤモヤ
Dialogue: 0,0:07:41.11,0:07:42.52,A,,0,0,0,,あっ　おばあちゃん
Dialogue: 0,0:07:42.52,0:07:45.52,A,,0,0,0,,珍しいねえ　あんたが悩むなんて
Dialogue: 0,0:07:46.00,0:07:49.65,A,,0,0,0,,悩む前に行動しちゃう子だと思ってたけど
Dialogue: 0,0:07:50.87,0:07:52.15,A,,0,0,0,,そうだった
Dialogue: 0,0:07:52.70,0:07:54.32,A,,0,0,0,,ありがとう　おばあちゃん
Dialogue: 0,0:08:01.71,0:08:02.50,A,,0,0,0,,な…
Dialogue: 0,0:08:03.42,0:08:04.48,A,,0,0,0,,な…
Dialogue: 0,0:08:06.00,0:08:07.86,A,,0,800,0,,なんでまことが？
Dialogue: 0,0:08:06.00,0:08:07.86,A,,800,0,0,,なんで竜二が？
Dialogue: 0,0:08:08.90,0:08:09.93,A,,0,0,0,,てへぺろ
Dialogue: 0,0:08:10.99,0:08:13.51,A,,0,0,0,,助けてくれって言うから　来てみれば
Dialogue: 0,0:08:14.45,0:08:17.10,A,,0,0,0,,めちゃくちゃラブリーなスポットがあるって
Dialogue: 0,0:08:18.08,0:08:19.60,A,,0,0,0,,ちょろいもんです
Dialogue: 0,0:08:19.60,0:08:21.10,A,,0,0,0,,お前なあ…
Dialogue: 0,0:08:21.49,0:08:23.77,A,,0,0,0,,蒼井さん　悪いけど僕ら…
Dialogue: 0,0:08:23.77,0:08:26.27,A,,0,0,0,,まあまあ　ここでクイズです
Dialogue: 0,0:08:26.73,0:08:30.86,A,,0,0,0,,クジラはどのくらいの距離で会話できるでしょうか
Dialogue: 0,0:08:30.86,0:08:32.00,A,,0,0,0,,え？
Dialogue: 0,0:08:32.00,0:08:34.17,A,,0,0,0,,①　50{\fscx50} {\fscx}メートル
Dialogue: 0,0:08:34.17,0:08:36.28,A,,0,0,0,,②　5{\fscx50} {\fscx}キロメートル
Dialogue: 0,0:08:36.28,0:08:38.54,A,,0,0,0,,③　500{\fscx50} {\fscx}キロメートル
Dialogue: 0,0:08:38.54,0:08:40.94,A,,0,0,0,,えっと　普通に①かな
Dialogue: 0,0:08:40.94,0:08:42.25,A,,0,0,0,,デカいし　②？
Dialogue: 0,0:08:42.25,0:08:43.53,A,,0,0,0,,③はないだろ
Dialogue: 0,0:08:43.53,0:08:45.54,A,,0,0,0,,ブッブ～！
Dialogue: 0,0:08:45.54,0:08:47.44,A,,0,0,0,,答えは③です
Dialogue: 0,0:08:47.44,0:08:50.15,A,,0,0,0,,深い海だからできるんですけどね
Dialogue: 0,0:08:51.98,0:08:54.91,A,,0,0,0,,でも　私たちはクジラじゃないので
Dialogue: 0,0:08:54.91,0:08:56.56,A,,0,0,0,,こうやって会わないと
Dialogue: 0,0:08:56.56,0:08:58.55,A,,0,0,0,,話せないんですよね
Dialogue: 0,0:08:58.93,0:09:02.73,A,,0,0,0,,私　あのとき先輩と師匠が連れ出してくれたから
Dialogue: 0,0:09:02.73,0:09:05.14,A,,0,0,0,,「あっ　大丈夫だ」って思えたんです
Dialogue: 0,0:09:05.44,0:09:08.70,A,,0,0,0,,だから　今度は私が二人を
Dialogue: 0,0:09:09.40,0:09:10.81,A,,0,0,0,,ちびっこ…
Dialogue: 0,0:09:10.81,0:09:11.94,A,,0,0,0,,蒼井さん
Dialogue: 0,0:09:12.72,0:09:14.90,A,,0,0,0,,じゃあ　いってらっしゃ～い
Dialogue: 0,0:09:20.39,0:09:22.62,A,,0,0,0,,蒼井と二人がよかっただろうに
Dialogue: 0,0:09:22.62,0:09:23.72,A,,0,0,0,,なっ！
Dialogue: 0,0:09:24.12,0:09:27.37,A,,0,0,0,,竜二だって　僕がいないと思って来たんでしょ
Dialogue: 0,0:09:29.04,0:09:31.13,A,,0,0,0,,蒼井には悪いけど　帰るわ
Dialogue: 0,0:09:31.13,0:09:32.50,A,,0,0,0,,逃げるんだ？
Dialogue: 0,0:09:34.18,0:09:34.95,A,,0,0,0,,お前なあ…
Dialogue: 0,0:09:34.95,0:09:35.84,A,,0,0,0,,僕は…
Dialogue: 0,0:09:37.28,0:09:39.22,A,,0,0,0,,僕はちゃんと話したい
Dialogue: 0,0:09:41.68,0:09:42.90,A,,0,0,0,,分かったよ
Dialogue: 0,0:09:44.15,0:09:45.92,A,,0,0,0,,とりあえず　何か乗ろうぜ
Dialogue: 0,0:09:45.92,0:09:46.56,A,,0,0,0,,うん
Dialogue: 0,0:09:50.78,0:09:51.77,A,,0,0,0,,怖かった…
Dialogue: 0,0:09:51.77,0:09:53.32,A,,0,0,0,,すごかったね
Dialogue: 0,0:09:54.02,0:09:55.32,A,,0,0,0,,竜二　見て見て
Dialogue: 0,0:09:55.65,0:09:56.95,A,,0,0,0,,何かいる
Dialogue: 0,0:09:57.28,0:09:58.57,A,,0,0,0,,なんだ　あれ
Dialogue: 0,0:09:58.57,0:10:01.16,A,,0,0,0,,宇宙人かな　かわいい
Dialogue: 0,0:10:01.16,0:10:03.45,A,,0,0,0,,かわいいのか　あれ
Dialogue: 0,0:10:30.19,0:10:31.86,A,,0,0,0,,あれに乗ろうぜ
Dialogue: 0,0:10:31.86,0:10:33.36,A,,0,0,0,,うん　乗ろう
Dialogue: 0,0:10:34.15,0:10:35.48,A,,0,0,0,,懐かしいな
Dialogue: 0,0:10:35.98,0:10:40.79,A,,0,0,0,,僕　幼稚園のとき　竜二のことめちゃくちゃ苦手だったんだよね
Dialogue: 0,0:10:40.79,0:10:42.49,A,,0,0,0,,えっ　そうだったのか
Dialogue: 0,0:10:42.49,0:10:43.51,A,,0,0,0,,うん
Dialogue: 0,0:10:43.51,0:10:46.50,A,,0,0,0,,だって毎日僕のことからかってくるし
Dialogue: 0,0:10:46.50,0:10:49.10,A,,0,0,0,,カエルとか虫とか　すごい見せてきたじゃん
Dialogue: 0,0:10:50.16,0:10:52.25,A,,0,0,0,,あ～　そうだったか
Dialogue: 0,0:10:52.78,0:10:57.09,A,,0,0,0,,かくれんぼして　竜二が全然出てこなかったの　覚えてる
Dialogue: 0,0:10:57.38,0:10:59.59,A,,0,0,0,,ああ　覚えてる
Dialogue: 0,0:11:00.16,0:11:03.16,A,,0,0,0,,あのとき　竜二が見つからなかったら
Dialogue: 0,0:11:03.16,0:11:05.86,A,,0,0,0,,もう嫌なこと言われないと思って
Dialogue: 0,0:11:05.86,0:11:08.68,A,,0,0,0,,出てこないでって　神様にお願いしたんだ
Dialogue: 0,0:11:09.32,0:11:11.53,A,,0,0,0,,そしたら本当に出てこなくて
Dialogue: 0,0:11:12.19,0:11:15.56,A,,0,0,0,,僕のせいで竜二が消えちゃったんだと思った
Dialogue: 0,0:11:15.56,0:11:18.19,A,,0,0,0,,そしたら　すごく悲しくなって
Dialogue: 0,0:11:19.13,0:11:21.03,A,,0,0,0,,すごい悲しかったんだ
Dialogue: 0,0:11:23.53,0:11:24.69,A,,0,0,0,,そっか
Dialogue: 0,0:11:32.21,0:11:34.15,A,,0,0,0,,気に入ったのか　それ
Dialogue: 0,0:11:34.80,0:11:36.21,A,,0,0,0,,買ってくる
Dialogue: 0,0:11:36.48,0:11:37.40,A,,0,0,0,,おう…
Dialogue: 0,0:11:41.22,0:11:43.20,A,,0,0,0,,プレゼント用ですか
Dialogue: 0,0:11:43.20,0:11:45.66,A,,0,0,0,,いえ　自分用です
Dialogue: 0,0:11:45.66,0:11:47.22,A,,0,0,0,,かしこまりました
Dialogue: 0,0:11:55.65,0:11:57.73,A,,0,0,0,,変わったよな　お前
Dialogue: 0,0:11:57.73,0:11:58.55,A,,0,0,0,,え？
Dialogue: 0,0:11:59.23,0:12:02.56,A,,0,0,0,,そういうもんに対して　遠慮がなくなったっていうか
Dialogue: 0,0:12:03.36,0:12:05.99,A,,0,0,0,,さっきも周りの目とか気にしてなかったし
Dialogue: 0,0:12:06.75,0:12:08.49,A,,0,0,0,,そうだね
Dialogue: 0,0:12:08.49,0:12:10.70,A,,0,0,0,,好きなのは変わらないから
Dialogue: 0,0:12:12.34,0:12:16.75,A,,0,0,0,,僕は　女の子みたいなロングヘアも
Dialogue: 0,0:12:17.46,0:12:19.00,A,,0,0,0,,かわいい小物も
Dialogue: 0,0:12:19.78,0:12:21.51,A,,0,0,0,,ピンク色も好きだ
Dialogue: 0,0:12:21.77,0:12:25.71,A,,0,0,0,,最近は　母さんにも言えたらいいなって思ってる
Dialogue: 0,0:12:25.71,0:12:29.39,A,,0,0,0,,母さんとの関係も　なんとかできたらなって
Dialogue: 0,0:12:30.46,0:12:31.48,A,,0,0,0,,竜二とも
Dialogue: 0,0:12:32.92,0:12:34.34,A,,0,0,0,,ねえ　竜二
Dialogue: 0,0:12:34.34,0:12:37.27,A,,0,0,0,,やっぱり僕　このままじゃ嫌だよ
Dialogue: 0,0:12:39.70,0:12:40.73,A,,0,0,0,,やめて
Dialogue: 0,0:12:41.08,0:12:42.74,A,,0,0,0,,キモいよな
Dialogue: 0,0:12:45.17,0:12:47.74,A,,0,0,0,,いや　でも　どうするんだよ
Dialogue: 0,0:12:48.93,0:12:50.20,A,,0,0,0,,分かんないんだ
Dialogue: 0,0:12:50.20,0:12:51.96,A,,0,0,0,,分かれよ
Dialogue: 0,0:12:51.96,0:12:54.61,A,,0,0,0,,俺は男なのにお前が好きで
Dialogue: 0,0:12:54.61,0:12:57.58,A,,0,0,0,,一緒にいてもお前は嫌な思いするって…
Dialogue: 0,0:12:58.45,0:13:00.59,A,,0,0,0,,何度も考えたんだ
Dialogue: 0,0:13:01.60,0:13:05.37,A,,0,0,0,,何を今伝えるべきで　どうするのが正解なのか
Dialogue: 0,0:13:05.37,0:13:06.59,A,,0,0,0,,まこと…
Dialogue: 0,0:13:07.45,0:13:09.12,A,,0,0,0,,でも分かんなくて…
Dialogue: 0,0:13:09.98,0:13:13.10,A,,0,0,0,,でも　もういいやとも思えなくて
Dialogue: 0,0:13:13.10,0:13:17.10,A,,0,0,0,,だから　一緒に考えてくれないかな
Dialogue: 0,0:13:19.24,0:13:21.05,A,,0,0,0,,お前はそれでいいのかよ
Dialogue: 0,0:13:21.54,0:13:22.56,A,,0,0,0,,うん
Dialogue: 0,0:13:22.56,0:13:24.61,A,,0,0,0,,嫌な思いするかもしれないぞ
Dialogue: 0,0:13:24.61,0:13:26.86,A,,0,0,0,,そんなの　お互いさまだよ
Dialogue: 0,0:13:27.26,0:13:29.91,A,,0,0,0,,もし俺がずっと諦められなかったら
Dialogue: 0,0:13:31.81,0:13:33.40,A,,0,0,0,,それでもいいよ
Dialogue: 0,0:13:34.87,0:13:37.10,A,,0,0,0,,ねえ　竜二
Dialogue: 0,0:13:38.38,0:13:41.63,A,,0,0,0,,とりあえず　またお弁当一緒に食べない
Dialogue: 0,0:13:44.36,0:13:46.81,A,,0,0,0,,あのとき俺も悲しかったんだ
Dialogue: 0,0:13:46.81,0:13:48.72,A,,0,0,0,,暗くて　不安で
Dialogue: 0,0:13:50.07,0:13:50.72,A,,0,0,0,,でも…
Dialogue: 0,0:13:53.03,0:13:54.83,A,,0,0,0,,お前もそうだったんだな
Dialogue: 0,0:13:56.01,0:13:58.27,A,,0,0,0,,二人で悲しかったんだよな
Dialogue: 0,0:14:02.68,0:14:03.98,A,,0,0,0,,ただいま
Dialogue: 0,0:14:05.01,0:14:07.06,A,,0,0,0,,だからね　心配なのよ
Dialogue: 0,0:14:07.06,0:14:09.49,A,,0,0,0,,また倒れたら　どうするの
Dialogue: 0,0:14:10.24,0:14:11.73,A,,0,0,0,,京子おばちゃん？
Dialogue: 0,0:14:13.10,0:14:15.50,A,,0,0,0,,そうは言ってもねえ
Dialogue: 0,0:14:15.50,0:14:19.79,A,,0,0,0,,兄さんはクジラのことばかりで　頼りにならないし
Dialogue: 0,0:14:33.51,0:14:35.34,A,,0,0,0,,あっ　飛行機雲
Dialogue: 0,0:14:37.37,0:14:38.92,A,,0,0,0,,今日こそは…
Dialogue: 0,0:14:38.92,0:14:41.40,A,,0,0,0,,今日こそは　今日こそは　今日こそは
Dialogue: 0,0:14:41.40,0:14:42.96,A,,0,0,0,,咲ちゃんに…
Dialogue: 0,0:14:43.40,0:14:45.28,A,,0,0,0,,会えますように
Dialogue: 0,0:14:47.99,0:14:49.78,A,,0,0,0,,いててててて…
Dialogue: 0,0:14:53.26,0:14:55.11,A,,0,0,0,,咲… ちゃん？
Dialogue: 0,0:14:56.54,0:14:58.79,A,,0,0,0,,お母さん？
Dialogue: 0,0:15:00.39,0:15:01.69,A,,0,0,0,,本物？
Dialogue: 0,0:15:05.52,0:15:08.93,A,,0,0,0,,まこと　髪伸びたわね
Dialogue: 0,0:15:08.93,0:15:11.05,A,,0,0,0,,そろそろ切ったほうがいいんじゃない
Dialogue: 0,0:15:11.05,0:15:14.08,A,,0,0,0,,美容院　予約しておくわね
Dialogue: 0,0:15:14.08,0:15:15.56,A,,0,0,0,,今週末でいいかしら
Dialogue: 0,0:15:20.00,0:15:21.06,A,,0,0,0,,まこと
Dialogue: 0,0:15:21.56,0:15:22.62,A,,0,0,0,,どうしたの
Dialogue: 0,0:15:24.19,0:15:25.82,A,,0,0,0,,母さんとの関係も…
Dialogue: 0,0:15:27.10,0:15:31.91,A,,0,0,0,,か… 髪　切るときは　自分で決めるから
Dialogue: 0,0:15:34.91,0:15:36.41,A,,0,0,0,,あら　そう
Dialogue: 0,0:15:37.39,0:15:40.41,A,,0,0,0,,ごめんね　ついつい子供扱いしちゃって
Dialogue: 0,0:15:40.41,0:15:43.04,A,,0,0,0,,まことももうすぐ高{\fscx50} {\fscx}3{\fscx50} {\fscx}だもんね
Dialogue: 0,0:15:45.54,0:15:47.53,A,,0,0,0,,い… 言えた
Dialogue: 0,0:15:49.40,0:15:50.86,A,,0,0,0,,言えた！
Dialogue: 0,0:15:52.05,0:15:54.68,A,,0,0,0,,ダメね　私ったら
Dialogue: 0,0:15:55.92,0:16:01.03,A,,0,0,0,,まことは　あの人とは違うのに
Dialogue: 0,0:16:02.96,0:16:05.20,A,,0,0,0,,いつまでも気にしてしまって
Dialogue: 0,0:16:07.39,0:16:08.53,A,,0,0,0,,おばあちゃん
Dialogue: 0,0:16:09.10,0:16:11.90,A,,0,0,0,,明日　帰り遅くなってもいい
Dialogue: 0,0:16:12.41,0:16:14.21,A,,0,0,0,,友達と遊ぶのかい
Dialogue: 0,0:16:15.09,0:16:19.54,A,,0,0,0,,えっとね　実は今日　お母さんに会って…
Dialogue: 0,0:16:20.79,0:16:21.98,A,,0,0,0,,ダメだ
Dialogue: 0,0:16:22.79,0:16:25.79,A,,0,0,0,,明日はいつもどおりに帰ること
Dialogue: 0,0:16:25.79,0:16:28.23,A,,0,0,0,,はい　この話はおしまい
Dialogue: 0,0:16:28.23,0:16:29.30,A,,0,0,0,,なんで
Dialogue: 0,0:16:30.10,0:16:31.06,A,,0,0,0,,なんで
Dialogue: 0,0:16:33.30,0:16:35.01,A,,0,0,0,,なんでダメなの
Dialogue: 0,0:16:35.87,0:16:38.01,A,,0,0,0,,悪いことは言わない
Dialogue: 0,0:16:38.74,0:16:41.36,A,,0,0,0,,あの子と関わるのはやめておきなさい
Dialogue: 0,0:16:46.64,0:16:48.52,A,,0,0,0,,なんで～
Dialogue: 0,0:16:49.07,0:16:51.36,A,,0,0,0,,おや　お悩みですかな
Dialogue: 0,0:16:51.36,0:16:52.71,A,,0,0,0,,先生
Dialogue: 0,0:16:52.71,0:16:56.84,A,,0,0,0,,頑固なお年寄りの口を割るにはどうしたらいいですか
Dialogue: 0,0:16:56.84,0:17:00.87,A,,0,0,0,,それはね　大仏サブレを　お茶に添えて出して
Dialogue: 0,0:17:00.87,0:17:02.05,A,,0,0,0,,咲
Dialogue: 0,0:17:02.87,0:17:05.36,A,,0,0,0,,お客だよ～
Dialogue: 0,0:17:07.38,0:17:10.88,A,,0,0,0,,その…　なんつうか…
Dialogue: 0,0:17:11.52,0:17:13.47,A,,0,0,0,,仲直りはした…
Dialogue: 0,0:17:13.47,0:17:15.93,A,,0,0,0,,でも　気まずいものは気まずいんだよ
Dialogue: 0,0:17:15.93,0:17:16.93,A,,0,0,0,,分かるだろ
Dialogue: 0,0:17:16.93,0:17:17.97,A,,0,0,0,,ほうほう
Dialogue: 0,0:17:17.97,0:17:21.47,A,,0,0,0,,ということで　お前も参加しろ　昼メシ
Dialogue: 0,0:17:21.77,0:17:23.98,A,,0,0,0,,いいですけど～
Dialogue: 0,0:17:23.98,0:17:27.48,A,,0,0,0,,代わりにちょっとつきあってくれませんか
Dialogue: 0,0:17:33.48,0:17:36.17,A,,0,0,0,,つまりお前のばあさんが怒ってるから
Dialogue: 0,0:17:36.17,0:17:40.27,A,,0,0,0,,母親がヤバいヤツじゃないか　確認すればいいってことか
Dialogue: 0,0:17:40.27,0:17:42.36,A,,0,0,0,,まあ　そんなとこです
Dialogue: 0,0:17:42.36,0:17:45.00,A,,0,0,0,,ちょっと探偵みたいでわくわくするね
Dialogue: 0,0:17:45.73,0:17:47.75,A,,0,0,0,,あっ　いました　あの人です
Dialogue: 0,0:17:48.07,0:17:49.74,A,,0,0,0,,優しそうな人だね
Dialogue: 0,0:17:50.72,0:17:54.77,A,,0,0,0,,なんか既視感あるような　誰かに似てるような
Dialogue: 0,0:17:54.77,0:17:56.34,A,,0,0,0,,えっ　誰にですか
Dialogue: 0,0:17:57.76,0:18:01.76,A,,0,0,0,,私のこと　待ってくれてるんですよね
Dialogue: 0,0:18:01.76,0:18:06.02,A,,0,0,0,,きっと蒼井さんのこと　大切に思ってるんじゃないかな
Dialogue: 0,0:18:06.02,0:18:07.73,A,,0,0,0,,そうだな
Dialogue: 0,0:18:07.73,0:18:09.77,A,,0,0,0,,ってかお前も話したいんだろ
Dialogue: 0,0:18:09.77,0:18:12.27,A,,0,0,0,,まあ　そうなんですけど…
Dialogue: 0,0:18:12.27,0:18:14.58,A,,0,0,0,,じゃあ会うべきだよ
Dialogue: 0,0:18:14.58,0:18:17.53,A,,0,0,0,,ああ　行ってこいよ　ちびっこ
Dialogue: 0,0:18:20.28,0:18:21.01,A,,0,0,0,,はい
Dialogue: 0,0:18:22.03,0:18:24.29,A,,0,0,0,,おばあちゃん　ごめん
Dialogue: 0,0:18:24.29,0:18:26.54,A,,0,0,0,,今日は言うこと聞けないや
Dialogue: 0,0:18:26.54,0:18:28.56,A,,0,0,0,,だってお母さんだもん
Dialogue: 0,0:18:28.56,0:18:29.54,A,,0,0,0,,私の…
Dialogue: 0,0:18:36.78,0:18:38.39,A,,0,0,0,,お母さんだもん
Dialogue: 0,0:18:45.56,0:18:48.56,A,,0,0,0,,えっと　まだ足りないわよね
Dialogue: 0,0:18:48.98,0:18:50.02,A,,0,0,0,,すみませ～ん
Dialogue: 0,0:18:50.02,0:18:52.66,A,,0,0,0,,も… もういい　もう十分だから
Dialogue: 0,0:18:52.66,0:18:54.19,A,,0,0,0,,本当に？
Dialogue: 0,0:18:54.93,0:18:58.48,A,,0,0,0,,それより　大丈夫なの　こんな高そうなとこ
Dialogue: 0,0:18:58.48,0:18:59.57,A,,0,0,0,,もちろん
Dialogue: 0,0:19:00.10,0:19:03.17,A,,0,0,0,,お父さんと別れたときはお金なかったけど
Dialogue: 0,0:19:03.17,0:19:07.36,A,,0,0,0,,やっと資格も取れて　咲ちゃんと暮らせるくらいになったの
Dialogue: 0,0:19:07.36,0:19:08.33,A,,0,0,0,,えっ
Dialogue: 0,0:19:08.33,0:19:11.33,A,,0,0,0,,あっ　ごめん　順番が違うよね
Dialogue: 0,0:19:11.33,0:19:14.53,A,,0,0,0,,その　すぐにってわけじゃなくて…
Dialogue: 0,0:19:14.53,0:19:18.84,A,,0,0,0,,でも私　ずっと咲ちゃんと暮らしたかったの
Dialogue: 0,0:19:19.40,0:19:21.90,A,,0,0,0,,会えなかった間もず～っと
Dialogue: 0,0:19:24.81,0:19:26.75,A,,0,0,0,,えっ　やだ　ごめんね　咲ちゃん
Dialogue: 0,0:19:26.75,0:19:29.85,A,,0,0,0,,急に　そんな　嫌だったよね
Dialogue: 0,0:19:30.93,0:19:32.60,A,,0,0,0,,そうだった
Dialogue: 0,0:19:32.96,0:19:34.81,A,,0,0,0,,私のお母さんは…
Dialogue: 0,0:19:35.95,0:19:40.22,A,,0,0,0,,私が泣いてたら　私より悲しくなっちゃうような
Dialogue: 0,0:19:40.72,0:19:42.70,A,,0,0,0,,一緒に泣いちゃうような
Dialogue: 0,0:19:43.47,0:19:47.20,A,,0,0,0,,そんな人が　私のお母さん
Dialogue: 0,0:19:49.84,0:19:51.83,A,,0,0,0,,今日はとっても楽しかった
Dialogue: 0,0:19:52.40,0:19:54.36,A,,0,0,0,,また会いに来てもいい
Dialogue: 0,0:19:54.36,0:19:55.21,A,,0,0,0,,うん
Dialogue: 0,0:19:55.21,0:19:57.90,A,,0,0,0,,あっ　よかったらうち寄らない　すぐそこだし
Dialogue: 0,0:19:57.90,0:20:00.12,A,,0,0,0,,ううん　やめておく
Dialogue: 0,0:20:00.12,0:20:02.72,A,,0,0,0,,きっとお義母さんに怒られちゃうから
Dialogue: 0,0:20:03.46,0:20:04.45,A,,0,0,0,,そっか
Dialogue: 0,0:20:04.45,0:20:06.57,A,,0,0,0,,じゃあまたね　咲ちゃん
Dialogue: 0,0:20:06.57,0:20:07.96,A,,0,0,0,,うん　また
Dialogue: 0,0:20:10.56,0:20:13.38,A,,0,0,0,,なんでおばあちゃんは反対なのかな
Dialogue: 0,0:20:22.11,0:20:24.66,A,,0,0,0,,きっと話せば分かるのに
Dialogue: 0,0:20:27.12,0:20:30.12,A,,0,0,0,,いつもどおり帰るよう言っただろ
Dialogue: 0,0:20:30.80,0:20:33.12,A,,0,0,0,,ごめんなさい　でも…
Dialogue: 0,0:20:33.48,0:20:35.99,A,,0,0,0,,次からはちゃんと言うこと聞くんだよ
Dialogue: 0,0:20:36.49,0:20:37.63,A,,0,0,0,,なんで
Dialogue: 0,0:20:37.63,0:20:39.41,A,,0,0,0,,なんでダメなの
Dialogue: 0,0:20:40.38,0:20:44.38,A,,0,0,0,,ばあちゃんは　あんたに嫌な思いをしてほしくないんだよ
Dialogue: 0,0:20:44.72,0:20:47.35,A,,0,0,0,,嫌な思いなんて　そんなのしてない
Dialogue: 0,0:20:48.83,0:20:50.02,A,,0,0,0,,咲…
Dialogue: 0,0:20:50.60,0:20:53.48,A,,0,0,0,,私は　お母さんに会えてよかったもん
Dialogue: 0,0:20:59.23,0:21:00.80,A,,0,0,0,,分かったよ
Dialogue: 0,0:21:00.80,0:21:01.48,A,,0,0,0,,ほれ
Dialogue: 0,0:21:01.73,0:21:02.74,A,,0,0,0,,えっ
Dialogue: 0,0:21:02.74,0:21:04.01,A,,0,0,0,,電話
Dialogue: 0,0:21:04.01,0:21:06.40,A,,0,0,0,,お母さんにかけられるかい
Dialogue: 0,0:21:06.40,0:21:07.24,A,,0,0,0,,うん
Dialogue: 0,0:21:08.28,0:21:10.02,A,,0,0,0,,悪かったね
Dialogue: 0,0:21:10.02,0:21:13.25,A,,0,0,0,,咲ももう自分で決められる年だもんね
Dialogue: 0,0:21:13.81,0:21:17.00,A,,0,0,0,,少しお母さんと話をさせておくれ
Dialogue: 0,0:21:17.83,0:21:18.54,A,,0,0,0,,うん
Dialogue: 0,0:00:03.44,0:00:05.52,DefaultSingle-T,,0,0,0,,		喂  茱蒂小姐？
Dialogue: 0,0:00:06.52,0:00:07.57,DefaultSingle-T,,0,0,0,,		知道了
Dialogue: 0,0:00:07.94,0:00:10.03,DefaultSingle-T,,0,0,0,,		嗯  沒問題
Dialogue: 0,0:00:10.69,0:00:13.11,DefaultSingle-T,,0,0,0,,		我正在打發時間  等著集合
Dialogue: 0,0:00:13.57,0:00:15.11,DefaultSingle-T,,0,0,0,,		稍後見
Dialogue: 0,0:00:20.79,0:00:23.50,DefaultSingle-T,,0,0,0,,		我叫安德烈·卡邁爾
Dialogue: 0,0:00:24.08,0:00:28.46,DefaultSingle-T,,0,0,0,,		我為追蹤黑暗組織  來到了日本
Dialogue: 0,0:00:30.96,0:00:33.55,DefaultSingle-T,,0,0,0,,		咖啡廳啊  正好
Dialogue: 0,0:00:36.84,0:00:39.26,DefaultSingle-T,,0,0,0,,		研磨咖啡的香味
Dialogue: 0,0:00:39.72,0:00:41.43,DefaultSingle-T,,0,0,0,,		舒緩的音樂
Dialogue: 0,0:00:42.23,0:00:45.85,DefaultSingle-T,,0,0,0,,		嚴加控制的溫溼度  十分宜人
Dialogue: 0,0:00:46.85,0:00:48.98,DefaultSingle-T,,0,0,0,,		只要踏入一步就知道
Dialogue: 0,0:00:50.15,0:00:52.82,DefaultSingle-T,,0,0,0,,		這家店…來對了
Dialogue: 0,0:00:53.36,0:00:54.53,DefaultSingle-T,,0,0,0,,		歡迎光臨
Dialogue: 0,0:00:55.66,0:00:57.41,DefaultSingle-T,,0,0,0,,		您是開車來的嗎
Dialogue: 0,0:00:57.49,0:00:59.99,DefaultSingle-T,,0,0,0,,		是的  停在附近…
Dialogue: 0,0:01:03.04,0:01:04.46,DefaultSingle-T,,0,0,0,,		請點單
Dialogue: 0,0:01:05.00,0:01:06.67,DefaultSingle-T,,0,0,0,,		為  為什麼…
Dialogue: 0,0:01:07.00,0:01:08.46,DefaultSingle-T,,0,0,0,,		請點單
Dialogue: 0,0:01:09.79,0:01:10.67,DefaultSingle-T,,0,0,0,,		馬上
Dialogue: 0,0:01:12.30,0:01:14.67,DefaultSingle-T,,0,0,0,,		為什麼是他
Dialogue: 0,0:01:14.97,0:01:17.55,DefaultSingle-T,,0,0,0,,		我卡邁爾深惡痛絕的人
Dialogue: 0,0:01:17.76,0:01:21.97,DefaultSingle-T,,0,0,0,,		要是沒有想點的  就請趕緊離開
Dialogue: 0,0:01:22.77,0:01:24.18,DefaultSingle-T,,0,0,0,,		離開這家白羅
Dialogue: 0,0:01:26.44,0:01:28.19,DefaultSingle-T,,0,0,0,,		淺  淺焙美式咖啡
Dialogue: 0,0:01:30.02,0:01:32.53,DefaultSingle-T,,0,0,0,,		有什麼問題嗎
Dialogue: 0,0:01:32.90,0:01:33.82,DefaultSingle-T,,0,0,0,,		請稍等
Dialogue: 0,0:01:43.49,0:01:45.12,DefaultSingle-T,,0,0,0,,		這咖啡真好喝
Dialogue: 0,0:01:45.54,0:01:47.46,DefaultSingle-T,,0,0,0,,		濃郁而帶有酸味
Dialogue: 0,0:01:47.67,0:01:48.79,DefaultSingle-T,,0,0,0,,		多謝誇獎
Dialogue: 0,0:01:49.17,0:01:51.84,DefaultSingle-T,,0,0,0,,		使用淺焙咖啡豆  按通常方法沖泡的咖啡
Dialogue: 0,0:01:52.21,0:01:55.05,DefaultSingle-T,,0,0,0,,		在日本卻有「淺焙美式咖啡」這個特有名稱
Dialogue: 0,0:01:55.30,0:01:57.30,DefaultSingle-T,,0,0,0,,		來到這邊之後  我還挺驚訝的
Dialogue: 0,0:01:58.09,0:02:02.10,DefaultSingle-T,,0,0,0,,		本來還以為是模仿我們美國人的喝法命名的
Dialogue: 0,0:02:03.64,0:02:06.06,DefaultSingle-T,,0,0,0,,		看來你學習了不少啊
Dialogue: 0,0:02:07.10,0:02:08.23,DefaultSingle-T,,0,0,0,,		FBI
Dialogue: 0,0:02:09.94,0:02:12.02,DefaultSingle-T,,0,0,0,,		可以點食物嗎
Dialogue: 0,0:02:12.36,0:02:13.78,DefaultSingle-T,,0,0,0,,		焗義大利麵
Dialogue: 0,0:02:14.19,0:02:17.11,DefaultSingle-T,,0,0,0,,		這個準備起來很花時間
Dialogue: 0,0:02:17.78,0:02:19.49,DefaultSingle-T,,0,0,0,,		要多久啊
Dialogue: 0,0:02:22.87,0:02:24.87,DefaultSingle-T,,0,0,0,,		有沒有能很快做好的
Dialogue: 0,0:02:25.45,0:02:27.00,DefaultSingle-T,,0,0,0,,		這個嘛
Dialogue: 0,0:02:27.50,0:02:29.00,DefaultSingle-T,,0,0,0,,		非要說的話  就是…
Dialogue: 0,0:02:33.67,0:02:35.46,DefaultSingle-T,,0,0,0,,		這個也非常好吃
Dialogue: 0,0:02:35.80,0:02:39.59,DefaultSingle-T,,0,0,0,,		醬汁將簡單的材料完美調和
Dialogue: 0,0:02:40.22,0:02:42.35,DefaultSingle-T,,0,0,0,,		醋香濃郁的蛋黃醬…
Dialogue: 0,0:02:42.60,0:02:44.39,DefaultSingle-T,,0,0,0,,		應該還加入了某種提味的食材
Dialogue: 0,0:02:44.68,0:02:47.02,DefaultSingle-T,,0,0,0,,		總是和你一起的那位女性呢
Dialogue: 0,0:02:48.64,0:02:49.73,DefaultSingle-T,,0,0,0,,		不知道
Dialogue: 0,0:02:50.19,0:02:51.90,DefaultSingle-T,,0,0,0,,		她有別的事嗎
Dialogue: 0,0:02:52.27,0:02:54.98,DefaultSingle-T,,0,0,0,,		不用快點和她集合嗎
Dialogue: 0,0:02:55.48,0:02:57.28,DefaultSingle-T,,0,0,0,,		與你無關
Dialogue: 0,0:02:58.49,0:03:00.20,DefaultSingle-T,,0,0,0,,		真有臉啊
Dialogue: 0,0:03:00.45,0:03:02.53,DefaultSingle-T,,0,0,0,,		我不知道你們是來旅遊還是來幹什麼的
Dialogue: 0,0:03:03.07,0:03:05.24,DefaultSingle-T,,0,0,0,,		居然在這種時間跑來喝咖啡
Dialogue: 0,0:03:05.45,0:03:08.33,DefaultSingle-T,,0,0,0,,		歐美人真是悠閒得令人羨慕
Dialogue: 0,0:03:08.58,0:03:11.04,DefaultSingle-T,,0,0,0,,		人生的一半都是茶點時間
Dialogue: 0,0:03:15.50,0:03:16.80,DefaultSingle-T,,0,0,0,,		是茱蒂小姐
Dialogue: 0,0:03:20.59,0:03:22.14,DefaultSingle-T,,0,0,0,,		好吧好吧
Dialogue: 0,0:03:22.30,0:03:23.34,DefaultSingle-T,,0,0,0,,		我走了
Dialogue: 0,0:03:24.14,0:03:25.60,DefaultSingle-T,,0,0,0,,		多謝款待
Dialogue: 0,0:03:26.76,0:03:27.52,DefaultSingle-T,,0,0,0,,		不謝
Dialogue: 0,0:03:28.81,0:03:34.31,DefaultSingle-T,,0,0,0,,		極其舒適的空間  極其美味的咖啡和食物
Dialogue: 0,0:03:34.86,0:03:37.53,DefaultSingle-T,,0,0,0,,		以及極其差勁的店員
Dialogue: 0,0:03:40.65,0:03:43.07,DefaultSingle-T,,0,0,0,,		怎麼這麼多人
Dialogue: 0,0:03:43.99,0:03:45.45,DefaultSingle-T,,0,0,0,,		煙火大會？
Dialogue: 0,0:03:46.16,0:03:47.49,DefaultSingle-T,,0,0,0,,		交通管制？
Dialogue: 0,0:03:47.95,0:03:49.00,DefaultSingle-T,,0,0,0,,		我得快點走
Dialogue: 0,0:03:53.83,0:03:55.42,DefaultSingle-T,,0,0,0,,		好險啊
Dialogue: 0,0:03:55.88,0:03:59.76,DefaultSingle-T,,0,0,0,,		要是繼續閒坐下去  車就開不出來了
Dialogue: 0,0:03:59.96,0:04:00.97,DefaultSingle-T,,0,0,0,,		難道說…
Dialogue: 0,0:04:02.30,0:04:04.26,DefaultSingle-T,,0,0,0,,		他是預料到這種事…
Dialogue: 0,0:04:04.59,0:04:06.55,DefaultSingle-T,,0,0,0,,		呃  可是…
Dialogue: 0,0:04:11.31,0:04:12.64,DefaultSingle-T,,0,0,0,,		不管怎麼說
Dialogue: 0,0:04:12.89,0:04:16.65,DefaultSingle-T,,0,0,0,,		只看結果的話  我還得感謝他才行
Dialogue: 0,0:04:17.15,0:04:20.49,DefaultSingle-T,,0,0,0,,		感謝那個男人  安室透
Dialogue: 0,0:05:59.88,0:06:00.84,DefaultSingle-T,,0,0,0,,		好
Dialogue: 0,0:06:01.38,0:06:03.21,DefaultSingle-T,,0,0,0,,		我來把你洗乾淨
Dialogue: 0,0:06:36.62,0:06:37.71,DefaultSingle-T,,0,0,0,,		四個指頭
Dialogue: 0,0:06:37.96,0:06:39.62,DefaultSingle-T,,0,0,0,,		爪尖的痕跡也很清晰
Dialogue: 0,0:06:40.12,0:06:41.13,DefaultSingle-T,,0,0,0,,		不是貓
Dialogue: 0,0:06:41.71,0:06:42.25,DefaultSingle-T,,0,0,0,,		狗嗎
Dialogue: 0,0:06:42.88,0:06:43.63,DefaultSingle-T,,0,0,0,,		也可能是狸
Dialogue: 0,0:06:44.38,0:06:46.17,DefaultSingle-T,,0,0,0,,		長度大約2公分
Dialogue: 0,0:06:46.80,0:06:48.17,DefaultSingle-T,,0,0,0,,		也可能是黃鼠狼
Dialogue: 0,0:06:53.47,0:06:57.22,DefaultSingle-T,,0,0,0,,		在我車上留下腳印的就是你嗎
Dialogue: 0,0:07:00.48,0:07:02.73,DefaultSingle-T,,0,0,0,,		你真愛搗蛋
Dialogue: 0,0:07:04.57,0:07:06.07,DefaultSingle-T,,0,0,0,,		你該不會是…
Dialogue: 0,0:07:07.23,0:07:09.61,DefaultSingle-T,,0,0,0,,		之前在河邊見過的…
Dialogue: 0,0:07:16.33,0:07:18.75,DefaultSingle-T,,0,0,0,,		我看看  找到了
Dialogue: 0,0:07:19.75,0:07:20.67,DefaultSingle-T,,0,0,0,,		要吃嗎
Dialogue: 0,0:07:22.08,0:07:23.17,DefaultSingle-T,,0,0,0,,		別急
Dialogue: 0,0:07:23.88,0:07:25.71,DefaultSingle-T,,0,0,0,,		我來把蘋果籽去掉
Dialogue: 0,0:07:26.25,0:07:29.05,DefaultSingle-T,,0,0,0,,		畢竟帶有一點點毒性
Dialogue: 0,0:07:29.72,0:07:31.26,DefaultSingle-T,,0,0,0,,		來  吃吧
Dialogue: 0,0:07:33.68,0:07:34.76,DefaultSingle-T,,0,0,0,,		沒有項圈
Dialogue: 0,0:07:36.01,0:07:37.77,DefaultSingle-T,,0,0,0,,		你究竟是從哪裡來的
Dialogue: 0,0:07:41.69,0:07:42.69,DefaultSingle-T,,0,0,0,,		怎麼了  風見
Dialogue: 0,0:07:44.86,0:07:45.98,DefaultSingle-T,,0,0,0,,		對  我在附近
Dialogue: 0,0:07:46.82,0:07:47.65,DefaultSingle-T,,0,0,0,,		知道了
Dialogue: 0,0:07:47.65,0:07:49.86,DefaultSingle-T,,0,0,0,,		你在那裡待命  我馬上過去
Dialogue: 0,0:08:05.58,0:08:07.50,DefaultSingle-T,,0,0,0,,		你們繼續盯著
Dialogue: 0,0:08:08.67,0:08:09.59,DefaultSingle-T,,0,0,0,,		嗯  有勞了
Dialogue: 0,0:08:10.09,0:08:11.55,DefaultSingle-T,,0,0,0,,		我還有別的事
Dialogue: 0,0:08:31.74,0:08:33.15,DefaultSingle-T,,0,0,0,,		又是你啊
Dialogue: 0,0:08:34.24,0:08:35.53,DefaultSingle-T,,0,0,0,,		你怎麼找來的
Dialogue: 0,0:08:36.49,0:08:38.70,DefaultSingle-T,,0,0,0,,		不可以爬到這個上面
Dialogue: 0,0:08:39.16,0:08:40.24,DefaultSingle-T,,0,0,0,,		下來吧
Dialogue: 0,0:08:47.71,0:08:49.00,DefaultSingle-T,,0,0,0,,		這下頭疼了
Dialogue: 0,0:09:01.64,0:09:03.64,DefaultSingle-T,,0,0,0,,		你在這裡待了一晚上嗎
Dialogue: 0,0:09:04.19,0:09:06.85,DefaultSingle-T,,0,0,0,,		很遺憾  我不能養你
Dialogue: 0,0:09:07.27,0:09:09.44,DefaultSingle-T,,0,0,0,,		再說了  這裡不允許養寵物
Dialogue: 0,0:09:15.03,0:09:16.53,DefaultSingle-T,,0,0,0,,		好像也不是
Dialogue: 0,0:09:20.33,0:09:21.87,DefaultSingle-T,,0,0,0,,		你受傷了啊
Dialogue: 0,0:09:23.20,0:09:24.46,DefaultSingle-T,,0,0,0,,		沒有化膿
Dialogue: 0,0:09:24.87,0:09:27.08,DefaultSingle-T,,0,0,0,,		不過還是清洗一下塗點凡士林  以防萬一
Dialogue: 0,0:09:30.34,0:09:31.46,DefaultSingle-T,,0,0,0,,		這樣就好了
Dialogue: 0,0:09:33.55,0:09:34.92,DefaultSingle-T,,0,0,0,,		我走了
Dialogue: 0,0:09:35.72,0:09:37.51,DefaultSingle-T,,0,0,0,,		你不可以再待在這裡了
Dialogue: 0,0:09:38.14,0:09:38.80,DefaultSingle-T,,0,0,0,,		明白了嗎
Dialogue: 0,0:09:44.81,0:09:45.68,DefaultSingle-T,,0,0,0,,		對
Dialogue: 0,0:09:46.27,0:09:48.65,DefaultSingle-T,,0,0,0,,		有勞了  風見
Dialogue: 0,0:10:04.58,0:10:06.46,DefaultSingle-T,,0,0,0,,		總是受傷
Dialogue: 0,0:10:08.04,0:10:11.04,DefaultSingle-T,,0,0,0,,		你為什麼不惜受傷也要來找我
Dialogue: 0,0:10:11.50,0:10:13.13,DefaultSingle-T,,0,0,0,,		別再追我了
Dialogue: 0,0:10:13.63,0:10:15.67,DefaultSingle-T,,0,0,0,,		我不忍心看到你渾身是傷
Dialogue: 0,0:10:18.72,0:10:20.22,DefaultSingle-T,,0,0,0,,		這是最後一次給你治療了
Dialogue: 0,0:10:22.10,0:10:22.89,DefaultSingle-T,,0,0,0,,		再見了
Dialogue: 0,0:10:42.62,0:10:44.29,DefaultSingle-T,,0,0,0,,		沒  沒事吧
Dialogue: 0,0:10:45.91,0:10:48.62,DefaultSingle-T,,0,0,0,,		沒事  我絆了一跤
Dialogue: 0,0:10:49.50,0:10:52.21,DefaultSingle-T,,0,0,0,,		一點事都沒有  請放心
Dialogue: 0,0:10:52.33,0:10:54.09,DefaultSingle-T,,0,0,0,,		是  是這樣啊
Dialogue: 0,0:10:54.75,0:10:55.63,DefaultSingle-T,,0,0,0,,		我先走了
Dialogue: 0,0:10:58.55,0:11:00.47,DefaultSingle-T,,0,0,0,,		都說不要追過來了
Dialogue: 0,0:11:00.80,0:11:02.68,DefaultSingle-T,,0,0,0,,		你差點就受重傷了
Dialogue: 0,0:11:03.18,0:11:05.93,DefaultSingle-T,,0,0,0,,		我每次都要給你治療  你也為我想想啊
Dialogue: 0,0:11:06.39,0:11:08.23,DefaultSingle-T,,0,0,0,,		你知道我是什麼心情…
Dialogue: 0,0:11:10.10,0:11:11.73,DefaultSingle-T,,0,0,0,,		都說不可以了
Dialogue: 0,0:11:12.73,0:11:14.11,DefaultSingle-T,,0,0,0,,		不要再打架了
Dialogue: 0,0:11:14.94,0:11:15.86,DefaultSingle-T,,0,0,0,,		可是…
Dialogue: 0,0:11:16.40,0:11:20.11,DefaultSingle-T,,0,0,0,,		你下次再受傷  我也沒法給你治療了
Dialogue: 0,0:11:20.57,0:11:22.91,DefaultSingle-T,,0,0,0,,		醫生要去很遠的地方了
Dialogue: 0,0:11:24.99,0:11:25.91,DefaultSingle-T,,0,0,0,,		難道…
Dialogue: 0,0:11:26.74,0:11:29.04,DefaultSingle-T,,0,0,0,,		拜拜  零
Dialogue: 0,0:11:31.67,0:11:33.88,DefaultSingle-T,,0,0,0,,		你也是故意…
Dialogue: 0,0:11:39.42,0:11:40.51,DefaultSingle-T,,0,0,0,,		好吧
Dialogue: 0,0:11:41.51,0:11:42.80,DefaultSingle-T,,0,0,0,,		是我輸了
Dialogue: 0,0:11:47.77,0:11:49.93,DefaultSingle-T,,0,0,0,,		怎麼了  來吧
Dialogue: 0,0:12:11.75,0:12:13.12,DefaultSingle-T,,0,0,0,,		一起回家吧

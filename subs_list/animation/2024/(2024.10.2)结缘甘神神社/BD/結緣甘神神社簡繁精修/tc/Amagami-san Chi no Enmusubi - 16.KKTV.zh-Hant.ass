Dialogue: 0,0:02:51.01,0:02:53.52,screen2,,0,0,0,,{\pos(1300,415)\frz3\fs45\1c&559FC0&\b0}北園 慢跑步道
Dialogue: 0,0:02:51.49,0:02:55.30,title,,0,0,0,,{\blur4\fad(500,560)\pos(252,880)}滿載願望的天秤 前進
Dialogue: 0,0:03:00.17,0:03:04.28,Default,,0,0,0,,沒想到妳哥哥是個變態戀妹偷窺狂
Dialogue: 0,0:03:04.67,0:03:08.09,Default,,0,0,0,,就是啊 而且偷窺技巧特別好
Dialogue: 0,0:03:08.09,0:03:09.92,Default,,0,0,0,,可惡 早知道就不擔心妳了
Dialogue: 0,0:03:10.59,0:03:13.29,Default,,0,0,0,,還有為什麼我也要被抓來跑步
Dialogue: 0,0:03:13.29,0:03:15.66,Default,,0,0,0,,這是偷窺少女房間的懲罰
Dialogue: 0,0:03:16.04,0:03:17.67,Default,,0,0,0,,你負責計時
Dialogue: 0,0:03:18.84,0:03:20.43,Default,,0,0,0,,我來說明規則
Dialogue: 0,0:03:21.63,0:03:24.71,Default,,0,0,0,,按照大賽規定 跑十公里馬拉松
Dialogue: 0,0:03:24.71,0:03:27.85,Default,,0,0,0,,一圈兩公里的步道 先跑完五圈的人獲勝
Dialogue: 0,0:03:28.29,0:03:29.12,Default,,0,0,0,,知道了
Dialogue: 0,0:03:29.50,0:03:34.44,Default,,0,0,0,,另外 輸的人必須對贏的人言聽計從
Dialogue: 0,0:03:34.84,0:03:36.06,Default,,0,0,0,,任何要求?
Dialogue: 0,0:03:36.06,0:03:37.79,Default,,0,0,0,,太任性的規則了吧
Dialogue: 0,0:03:41.75,0:03:42.98,Default,,0,0,0,,如果我贏了
Dialogue: 0,0:03:43.84,0:03:46.96,Default,,0,0,0,,妳就放棄跑步吧 甘神朝姬
Dialogue: 0,0:03:49.34,0:03:51.41,Default,,0,0,0,,好 開始吧 戀妹大哥
Dialogue: 0,0:03:52.37,0:03:53.04,Default,,0,0,0,,知道了…
Dialogue: 0,0:03:55.14,0:03:56.10,Default,,0,0,0,,各就各位
Dialogue: 0,0:03:57.75,0:03:58.59,Default,,0,0,0,,預備
Dialogue: 0,0:03:59.64,0:04:00.01,Default,,0,0,0,,開始
Dialogue: 0,0:04:05.59,0:04:08.23,Default,,0,0,0,,花蓮 妳剛才說的話是什麼意思
Dialogue: 0,0:04:09.84,0:04:11.46,Default,,0,0,0,,妳從今年春天起
Dialogue: 0,0:04:11.46,0:04:13.56,Default,,0,0,0,,就沒刷新過自己的紀錄吧
Dialogue: 0,0:04:14.83,0:04:16.05,Default,,0,0,0,,這是因為…
Dialogue: 0,0:04:16.59,0:04:18.11,Default,,0,0,0,,太懈怠了吧
Dialogue: 0,0:04:18.71,0:04:20.54,Default,,0,0,0,,而在妳鬆懈的這段期間
Dialogue: 0,0:04:20.54,0:04:23.74,Default,,0,0,0,,我就快超越妳的最高紀錄了
Dialogue: 0,0:04:26.00,0:04:27.90,Default,,0,0,0,,我這麼認真在準備
Dialogue: 0,0:04:28.72,0:04:31.26,Default,,0,0,0,,而妳卻這麼敷衍 真的是太礙事了
Dialogue: 0,0:04:31.85,0:04:34.15,Default,,0,0,0,,現在的妳根本就不配跑馬拉松
Dialogue: 0,0:04:35.14,0:04:37.20,Default,,0,0,0,,我不再追著妳的背影了
Dialogue: 0,0:04:39.48,0:04:42.24,Default,,0,0,0,,甘神朝姬 妳乾脆就繼續當妳的巫女
Dialogue: 0,0:04:42.24,0:04:44.83,Default,,0,0,0,,反正妳超適合主持祭典啦
Dialogue: 0,0:04:46.53,0:04:47.52,Default,,0,0,0,,花蓮
Dialogue: 0,0:04:50.60,0:05:00.12,screen2,,0,0,0,,{\fs30\pos(750,356)\1c&666650&}特訓表單
Dialogue: 0,0:04:51.46,0:04:53.28,Default,,0,0,0,,自從和甘神朝姬相遇後
Dialogue: 0,0:04:53.84,0:04:56.44,Default,,0,0,0,,持續奔跑以跑贏她為目標
Dialogue: 0,0:04:56.84,0:04:59.13,Default,,0,0,0,,對我來說有著特殊的意義
Dialogue: 0,0:05:00.71,0:05:02.93,Default,,0,0,0,,可是對甘神朝姬來說
Dialogue: 0,0:05:03.42,0:05:05.11,Default,,0,0,0,,馬拉松並不是什麼特殊的事
Dialogue: 0,0:05:05.88,0:05:08.88,Default,,0,0,0,,既然如此 我就在這裡贏過妳
Dialogue: 0,0:05:09.84,0:05:10.92,Default,,0,0,0,,斬斷…
Dialogue: 0,0:05:11.84,0:05:13.13,Default,,0,0,0,,這段關係
Dialogue: 0,0:05:25.30,0:05:26.62,Default,,0,0,0,,怎麼會…
Dialogue: 0,0:05:31.46,0:05:32.32,Default,,0,0,0,,朝姬…
Dialogue: 0,0:05:33.20,0:05:33.93,Default,,0,0,0,,跑輸了
Dialogue: 0,0:05:36.21,0:05:37.08,Default,,0,0,0,,成功了
Dialogue: 0,0:05:38.97,0:05:42.25,Default,,0,0,0,,成功了 我跑贏甘神朝姬了
Dialogue: 0,0:05:42.25,0:05:44.92,Default,,0,0,0,,而且還超過甘神朝姬的最佳紀錄
Dialogue: 0,0:05:44.92,0:05:47.38,Default,,0,0,0,,是堂堂正正地贏了
Dialogue: 0,0:05:50.24,0:05:51.16,Default,,0,0,0,,如此一來
Dialogue: 0,0:05:51.80,0:05:53.75,Default,,0,0,0,,我就不必執著在妳身上了
Dialogue: 0,0:05:55.82,0:05:56.92,Default,,0,0,0,,按照約定
Dialogue: 0,0:05:57.59,0:05:59.25,Default,,0,0,0,,妳要放棄跑馬拉松
Dialogue: 0,0:05:59.96,0:06:00.88,Default,,0,0,0,,甘神朝姬
Dialogue: 0,0:06:04.63,0:06:05.36,Default,,0,0,0,,算…
Dialogue: 0,0:06:07.59,0:06:10.88,Default,,0,0,0,,不算 不算數 剛才的比賽不算數
Dialogue: 0,0:06:12.84,0:06:15.09,Default,,0,0,0,,輸了還賴皮 很丟臉耶
Dialogue: 0,0:06:15.09,0:06:18.75,Default,,0,0,0,,妳在比賽中 以言語動搖對手
Dialogue: 0,0:06:18.75,0:06:20.38,Default,,0,0,0,,我認為這是犯規
Dialogue: 0,0:06:20.75,0:06:23.54,Default,,0,0,0,,誰叫妳每次都心不在焉的…
Dialogue: 0,0:06:27.25,0:06:29.50,Default,,0,0,0,,妳什麼都不懂
Dialogue: 0,0:06:30.75,0:06:34.62,Default,,0,0,0,,當神社的祭典和馬拉松大賽被放在抉擇的天秤上時
Dialogue: 0,0:06:34.96,0:06:38.25,Default,,0,0,0,,老實說 我的確曾想放棄馬拉松
Dialogue: 0,0:06:38.63,0:06:42.25,Default,,0,0,0,,反正對我來說 只要能一個人隨心所欲地奔跑就足夠了
Dialogue: 0,0:06:42.82,0:06:44.58,Default,,0,0,0,,可是我還是辦不到
Dialogue: 0,0:06:45.42,0:06:48.52,Default,,0,0,0,,不管選哪一個 我都會心煩意亂
Dialogue: 0,0:06:49.63,0:06:52.18,Default,,0,0,0,,為何會這樣 我也不清楚
Dialogue: 0,0:06:53.92,0:06:58.12,Default,,0,0,0,,不過今天 被妳說"放棄跑馬拉松"
Dialogue: 0,0:06:58.12,0:07:02.16,Default,,0,0,0,,看到妳先抵達終點 我才發覺…
Dialogue: 0,0:07:03.21,0:07:07.55,Default,,0,0,0,,我很高興自己能成為別人的目標
Dialogue: 0,0:07:08.88,0:07:11.50,Default,,0,0,0,,我一直想成為他人憧憬的對象
Dialogue: 0,0:07:11.50,0:07:13.75,Default,,0,0,0,,\N我一直想成為他人憧憬的對象
Dialogue: 0,0:07:14.46,0:07:17.59,Default,,0,0,0,,因為妳把我當成目標
Dialogue: 0,0:07:17.59,0:07:20.09,Default,,0,0,0,,我才有不斷朝著夢想前進的動力
Dialogue: 0,0:07:21.21,0:07:23.22,Default,,0,0,0,,所以對我來說
Dialogue: 0,0:07:23.22,0:07:26.65,Default,,0,0,0,,馬拉松也和供奉神社一樣有著特殊意義
Dialogue: 0,0:07:30.46,0:07:34.26,Default,,0,0,0,,比賽的勝負留到7月7日大賽時見真章
Dialogue: 0,0:07:37.05,0:07:38.30,Default,,0,0,0,,我不再猶豫了
Dialogue: 0,0:07:39.62,0:07:43.94,Default,,0,0,0,,以後我會以成為他人景仰的目標盡全力奔跑
Dialogue: 0,0:07:46.96,0:07:48.50,Default,,0,0,0,,甘神朝姬…
Dialogue: 0,0:07:51.59,0:07:54.56,Default,,0,0,0,,花蓮 我們7月7日來認真比賽吧
Dialogue: 0,0:07:55.31,0:07:56.67,Default,,0,0,0,,正合我意
Dialogue: 0,0:07:56.67,0:07:59.79,Default,,0,0,0,,這次在正式比賽場合我一定會贏過妳的
Dialogue: 0,0:08:00.59,0:08:01.84,Default,,0,0,0,,真拿妳們沒辦法
Dialogue: 0,0:08:02.30,0:08:04.57,Default,,0,0,0,,那我再去幫妳加油吧
Dialogue: 0,0:08:04.85,0:08:05.49,Default,,0,0,0,,"再"?
Dialogue: 0,0:08:05.88,0:08:07.77,Default,,0,0,0,,瓜生哥不用來
Dialogue: 0,0:08:09.13,0:08:13.07,Default,,0,0,0,,不好意思 這次我要集中精神跟花蓮比賽
Dialogue: 0,0:08:13.84,0:08:19.31,Default,,0,0,0,,而且我可是個冷靜沉著跑步帥氣帶回獎盃的成熟大人
Dialogue: 0,0:08:21.17,0:08:22.91,Default,,0,0,0,,這樣啊… 妳加油…
Dialogue: 0,0:08:23.42,0:08:26.84,Default,,0,0,0,,到頭來 我還是沒能幫上朝姬的忙
Dialogue: 0,0:08:26.84,0:08:30.00,Default,,0,0,0,,被妹妹拒絕居然這麼沮喪
Dialogue: 0,0:08:30.00,0:08:31.46,Default,,0,0,0,,不愧是戀妹大哥
Dialogue: 0,0:08:32.80,0:08:35.71,Default,,0,0,0,,不過 還是謝謝瓜生哥
Dialogue: 0,0:08:37.34,0:08:42.36,Default,,0,0,0,,我非常高興 你總是為我著想
Dialogue: 0,0:08:42.96,0:08:44.53,Default,,0,0,0,,所以就別再沮喪了
Dialogue: 0,0:08:47.67,0:08:50.75,Default,,0,0,0,,我在家時 會當個愛撒嬌的妹妹
Dialogue: 0,0:08:50.75,0:08:54.76,Default,,0,0,0,,記得要好好疼妹妹喔 戀妹大哥
Dialogue: 0,0:08:57.09,0:09:00.55,Default,,0,0,0,,妳真的是個不可愛的妹妹
Dialogue: 0,0:09:03.21,0:09:06.25,Default,,0,0,0,,我總覺得好像有不純潔異性交往的氣息
Dialogue: 0,0:09:07.15,0:09:10.01,Default,,0,0,0,,你們該不會已經跨越兄妹的那條界線了吧
Dialogue: 0,0:09:10.92,0:09:12.28,Default,,0,0,0,,妳覺得呢
Dialogue: 0,0:09:12.28,0:09:13.98,Default,,0,0,0,,妳給我好好否定啊
Dialogue: 0,0:09:13.98,0:09:15.19,Default,,0,0,0,,根本沒這回事啊

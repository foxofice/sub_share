Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerTopMusic,,0,0,0,,dakishimete, kinou yori
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerMusic,,0,0,0,,抱紧我
Dialogue: 0,0:23:01.80,0:23:07.11,LayznerTopMusic,,0,0,0,,aishitai hito tidak iru
Dialogue: 0,0:23:01.80,0:23:07.25,LayznerMusic,,0,0,0,,比昨天更爱你
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerTopMusic,,0,0,0,,toki ha hitoshizuku nigai namida
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerMusic,,0,0,0,,时间是一滴 苦涩的泪
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerTopMusic,,0,0,0,,kizutsuita pururougu
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerMusic,,0,0,0,,受伤的序曲
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerTopMusic,,0,0,0,,yasashisa e tsuzukuno yo
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerMusic,,0,0,0,,继续着温柔
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerTopMusic,,0,0,0,,mayowanai futari dake no
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerMusic,,0,0,0,,只为这不再迷惘的两人
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerTopMusic,,0,0,0,,LA ROSE ROUGE
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerMusic,,0,0,0,,献上一曲野玫瑰之歌
Dialogue: 0,0:01:01.35,0:01:05.96,Layzner,,0,0,0,,地球人们 你们连一个女人都救不了
Dialogue: 0,0:01:05.97,0:01:08.35,Layzner,,0,0,0,,给我睁大眼睛好好看着
Dialogue: 0,0:01:09.23,0:01:10.33,Layzner,,0,0,0,,古斯特罗 我来对付你
Dialogue: 0,0:02:01.16,0:02:04.98,Layzner,,0,0,0,,今天阳光也普照大地
Dialogue: 0,0:02:05.82,0:02:08.14,Layzner,,0,0,0,,照耀着地球 也照耀着古拉特斯
Dialogue: 0,0:02:08.50,0:02:13.46,Layzner,,0,0,0,,编排好的圣战
Dialogue: 0,0:02:15.37,0:02:20.17,Layzner,,0,0,0,,阁下 今天库斯科的圣女仍在希望谒见阁下
Dialogue: 0,0:02:20.17,0:02:22.44,Layzner,,0,0,0,,要怎么处理 赶走吗
Dialogue: 0,0:02:24.20,0:02:26.17,Layzner,,0,0,0,,不 我想见见她
Dialogue: 0,0:02:27.97,0:02:29.24,Layzner,,0,0,0,,让她进来
Dialogue: 0,0:02:29.24,0:02:30.13,Layzner,,0,0,0,,可是
Dialogue: 0,0:02:31.57,0:02:33.76,Layzner,,0,0,0,,人心很容易改变
Dialogue: 0,0:02:35.06,0:02:36.93,Layzner,,0,0,0,,就像这香一样
Dialogue: 0,0:02:38.66,0:02:40.40,Layzner,,0,0,0,,我变得想见她了
Dialogue: 0,0:02:40.40,0:02:41.33,Layzner,,0,0,0,,是
Dialogue: 0,0:03:15.61,0:03:18.13,Layzner,,0,0,0,,你知道这是什么香味吗
Dialogue: 0,0:03:19.40,0:03:20.26,Layzner,,0,0,0,,是麝香
Dialogue: 0,0:03:21.60,0:03:23.46,Layzner,,0,0,0,,2000年前
Dialogue: 0,0:03:26.30,0:03:31.77,Layzner,,0,0,0,,地球的男人们似乎为了这香料甘愿堵上性命
Dialogue: 0,0:03:33.55,0:03:35.68,Layzner,,0,0,0,,阿尔巴特罗·米鲁·玖丽亚·飞鸟
Dialogue: 0,0:03:36.61,0:03:40.30,Layzner,,0,0,0,,身为普通士兵的你身上到底发生了什么
Dialogue: 0,0:03:41.85,0:03:43.77,Layzner,,0,0,0,,在这地球上的三年中
Dialogue: 0,0:03:43.77,0:03:48.36,Layzner,,0,0,0,,请阁下也静下心来品味一下太阳的光辉与风的声音吧
Dialogue: 0,0:03:49.46,0:03:50.88,Layzner,,0,0,0,,那又如何呢
Dialogue: 0,0:03:52.44,0:03:57.20,Layzner,,0,0,0,,求您了 阁下 双方的人民应该互相友爱
Dialogue: 0,0:03:57.20,0:04:02.08,Layzner,,0,0,0,,只要有阁下的命令 古拉特斯和地球应该能够携手共进
Dialogue: 0,0:04:02.70,0:04:07.77,Layzner,,0,0,0,,玖丽亚 你以为我会下达这种命令吗
Dialogue: 0,0:04:08.30,0:04:09.73,Layzner,,0,0,0,,我请求您
Dialogue: 0,0:04:11.77,0:04:13.80,Layzner,,0,0,0,,阁下 我请求您
Dialogue: 0,0:04:14.62,0:04:16.26,Layzner,,0,0,0,,父亲大人 不能这样
Dialogue: 0,0:04:17.40,0:04:23.66,Layzner,,0,0,0,,父亲大人您不会把这种疯女人的话当真吧
Dialogue: 0,0:04:25.73,0:04:28.33,Layzner,,0,0,0,,我代替父亲回答你吧
Dialogue: 0,0:04:29.18,0:04:32.70,Layzner,,0,0,0,,不管从哪方面看 地球人都劣于古拉特斯人
Dialogue: 0,0:04:32.86,0:04:36.00,Layzner,,0,0,0,,携手共进什么的实在可笑之极
Dialogue: 0,0:04:36.00,0:04:40.63,Layzner,,0,0,0,,不 古拉特斯人和地球人本质上都是一样的
Dialogue: 0,0:04:41.33,0:04:45.37,Layzner,,0,0,0,,倾心于美的事物 相信真理
Dialogue: 0,0:04:45.37,0:04:47.77,Layzner,,0,0,0,,具有爱与尊严
Dialogue: 0,0:04:48.45,0:04:50.96,Layzner,,0,0,0,,那样的地球人在什么地方
Dialogue: 0,0:04:51.92,0:04:55.33,Layzner,,0,0,0,,看看周围吧 不都是唯我们之命是从吗
Dialogue: 0,0:04:55.33,0:04:57.63,Layzner,,0,0,0,,那是你们造成的
Dialogue: 0,0:04:58.46,0:05:02.76,Layzner,,0,0,0,,像小孩子一样 仅为了巩固自己的地位而进行这种无意义的行为
Dialogue: 0,0:05:04.31,0:05:05.63,Layzner,,0,0,0,,挺有意思的
Dialogue: 0,0:05:07.20,0:05:12.04,Layzner,,0,0,0,,那就让我看看你所相信的地球人所具有的力量吧
Dialogue: 0,0:05:14.18,0:05:16.10,Layzner,,0,0,0,,舞台就由我来布置
Dialogue: 0,0:05:18.36,0:05:22.35,Layzner,,0,0,0,,古拉特斯人和地球人谁更优秀
Dialogue: 0,0:05:22.35,0:05:24.60,Layzner,,0,0,0,,就通过战斗来证明吧
Dialogue: 0,0:05:25.74,0:05:31.68,Layzner,,0,0,0,,地球人胜了的话 就饶了你饶舌之罪 赏你一条命
Dialogue: 0,0:05:31.68,0:05:34.16,Layzner,,0,0,0,,我不期望战斗
Dialogue: 0,0:05:34.90,0:05:39.03,Layzner,,0,0,0,,可要是地球人输了 你的命就没了
Dialogue: 0,0:05:39.68,0:05:41.60,Layzner,,0,0,0,,当场处决你
Dialogue: 0,0:05:43.06,0:05:45.20,Layzner,,0,0,0,,如何 父亲大人
Dialogue: 0,0:05:45.20,0:05:50.06,Layzner,,0,0,0,,我认为这也符合父亲您不愿做无谓杀戮的理念
Dialogue: 0,0:05:54.67,0:05:57.76,Layzner,,0,0,0,,那么这女人就由我看管了
Dialogue: 0,0:06:07.00,0:06:09.20,Layzner,,0,0,0,,听好 地球人
Dialogue: 0,0:06:10.16,0:06:13.63,Layzner,,0,0,0,,古拉特斯司令部逮捕了库斯科的圣女
Dialogue: 0,0:06:14.44,0:06:16.57,Layzner,,0,0,0,,敢于赌上地球人的尊严
Dialogue: 0,0:06:16.57,0:06:21.10,Layzner,,0,0,0,,为她与古拉特斯战士战斗的勇者快前来挑战
Dialogue: 0,0:06:21.30,0:06:24.96,Layzner,,0,0,0,,胜利的话 圣女将被释放
Dialogue: 0,0:06:24.96,0:06:29.50,Layzner,,0,0,0,,但是 没有人出战的话 圣女就要被处决
Dialogue: 0,0:06:31.34,0:06:35.15,Layzner,,0,0,0,,还有 参加的选手必须是地球人
Dialogue: 0,0:06:35.15,0:06:38.08,Layzner,,0,0,0,,战斗兵器也必须是地球制造
Dialogue: 0,0:06:38.08,0:06:40.26,Layzner,,0,0,0,,禁止使用枪支
Dialogue: 0,0:06:40.26,0:06:44.03,Layzner,,0,0,0,,可以自由观战 允许一切地球人观战
Dialogue: 0,0:06:44.03,0:06:46.73,Layzner,,0,0,0,,时间地点如这里所写
Dialogue: 0,0:06:48.97,0:06:50.48,Layzner,,0,0,0,,得快通知大家才行
Dialogue: 0,0:06:53.20,0:06:54.16,Layzner,,0,0,0,,打扰了
Dialogue: 0,0:06:56.18,0:07:00.31,Layzner,,0,0,0,,作为决斗场的体育馆我已经安排好了
Dialogue: 0,0:07:01.12,0:07:02.93,Layzner,,0,0,0,,这是工作人员的配置图
Dialogue: 0,0:07:03.84,0:07:05.85,Layzner,,0,0,0,,市民的反响如何
Dialogue: 0,0:07:06.53,0:07:09.00,Layzner,,0,0,0,,似乎受了很大的冲击
Dialogue: 0,0:07:09.76,0:07:14.30,Layzner,,0,0,0,,那么愿意为了圣女战斗的人一定出现了吧
Dialogue: 0,0:07:14.68,0:07:15.93,Layzner,,0,0,0,,不 还没有
Dialogue: 0,0:07:16.48,0:07:18.35,Layzner,,0,0,0,,真可悲啊
Dialogue: 0,0:07:19.56,0:07:24.75,Layzner,,0,0,0,,怎么样 罗安 你代表地球出战如何
Dialogue: 0,0:07:24.75,0:07:27.70,Layzner,,0,0,0,,不 我还有自知之明
Dialogue: 0,0:07:28.88,0:07:33.71,Layzner,,0,0,0,,真可惜 这可是难得的当英雄的机会啊
Dialogue: 0,0:07:34.62,0:07:38.59,Layzner,,0,0,0,,与鲁·凯恩阁下的智慧相比 英雄之流不过尔尔
Dialogue: 0,0:07:40.20,0:07:46.12,Layzner,,0,0,0,,我认为阁下是借处决圣女之名探察地球的战力
Dialogue: 0,0:07:47.70,0:07:49.60,Layzner,,0,0,0,,好了 你退下吧
Dialogue: 0,0:07:49.60,0:07:50.36,Layzner,,0,0,0,,是
Dialogue: 0,0:07:54.76,0:07:57.92,Layzner,,0,0,0,,怎么样 地球人的战士出现了吗
Dialogue: 0,0:07:59.34,0:08:00.96,Layzner,,0,0,0,,不 还一个都没有
Dialogue: 0,0:08:01.78,0:08:03.84,Layzner,,0,0,0,,基乌拉会长叫我去打
Dialogue: 0,0:08:04.10,0:08:06.53,Layzner,,0,0,0,,真的吗 你接受了吗
Dialogue: 0,0:08:07.56,0:08:09.46,Layzner,,0,0,0,,我推荐你去了
Dialogue: 0,0:08:09.56,0:08:12.53,Layzner,,0,0,0,,怎么能这样 都没跟我打招呼啊
Dialogue: 0,0:08:13.36,0:08:14.26,Layzner,,0,0,0,,开玩笑的
Dialogue: 0,0:08:21.32,0:08:25.02,Layzner,,0,0,0,,可是鲁·凯恩阁下真正的目的是什么啊
Dialogue: 0,0:08:25.02,0:08:28.84,Layzner,,0,0,0,,地球人开始以库斯科的圣女为精神支柱了
Dialogue: 0,0:08:29.50,0:08:32.62,Layzner,,0,0,0,,所以圣女就显得碍事了吧
Dialogue: 0,0:08:32.94,0:08:37.96,Layzner,,0,0,0,,那样的话一开始就处决了不是少很多麻烦吗
Dialogue: 0,0:08:38.80,0:08:42.10,Layzner,,0,0,0,,那样仇恨的焦点就会聚集在古拉特斯军身上
Dialogue: 0,0:08:43.08,0:08:47.73,Layzner,,0,0,0,,可是 要是变成地球人对圣女见死不救的话
Dialogue: 0,0:08:47.92,0:08:48.58,Layzner,,0,0,0,,会怎么样呢
Dialogue: 0,0:08:50.20,0:08:52.66,Layzner,,0,0,0,,地球人会受到心理创伤
Dialogue: 0,0:08:53.46,0:08:57.67,Layzner,,0,0,0,,认为是自己杀死了自己的心里支柱
Dialogue: 0,0:08:58.52,0:09:05.90,Layzner,,0,0,0,,就是说 在达到目的的同时 又给予了地球人精神上的败北感
Dialogue: 0,0:09:06.70,0:09:09.33,Layzner,,0,0,0,,而 阁下的目的不仅如此
Dialogue: 0,0:09:11.76,0:09:13.95,Layzner,,0,0,0,,我说 英二 求你了啊
Dialogue: 0,0:09:13.95,0:09:17.68,Layzner,,0,0,0,,就算是大卫你求我 我也没办法告诉你地下工厂的位置
Dialogue: 0,0:09:17.96,0:09:21.88,Layzner,,0,0,0,,这是为了保护地下组织的规矩 你应该明白
Dialogue: 0,0:09:22.26,0:09:26.28,Layzner,,0,0,0,,我知道才求你的啊 你只要带我去就好了
Dialogue: 0,0:09:26.28,0:09:27.50,Layzner,,0,0,0,,你去打会输的
Dialogue: 0,0:09:28.16,0:09:32.26,Layzner,,0,0,0,,开发中的SPT还没有那样的能力
Dialogue: 0,0:09:32.26,0:09:35.60,Layzner,,0,0,0,,那你是说要对圣女见死不救吗
Dialogue: 0,0:09:36.54,0:09:39.98,Layzner,,0,0,0,,那样地球人会显得更无能啊
Dialogue: 0,0:09:40.50,0:09:41.32,Layzner,,0,0,0,,太让人难受了
Dialogue: 0,0:09:41.72,0:09:42.80,Layzner,,0,0,0,,你就没事啦
Dialogue: 0,0:09:44.52,0:09:45.46,Layzner,,0,0,0,,你就
Dialogue: 0,0:09:45.88,0:09:48.70,Layzner,,0,0,0,,但我们地球人会怎么样啊
Dialogue: 0,0:09:49.02,0:09:52.64,Layzner,,0,0,0,,鲁·凯恩是对我们地球人发起挑战啊
Dialogue: 0,0:09:52.64,0:09:56.98,Layzner,,0,0,0,,你也知道圣女给了我们多大的激励吧
Dialogue: 0,0:09:57.82,0:09:59.20,Layzner,,0,0,0,,但是会输的
Dialogue: 0,0:09:59.20,0:10:01.76,Layzner,,0,0,0,,比起胜负 这是尊严的问题
Dialogue: 0,0:10:12.92,0:10:14.22,Layzner,,0,0,0,,你们给我听好
Dialogue: 0,0:10:15.42,0:10:20.36,Layzner,,0,0,0,,我要给予你们中的一个代表古拉特斯出战的荣誉
Dialogue: 0,0:10:23.86,0:10:24.80,Layzner,,0,0,0,,你去吗
Dialogue: 0,0:10:26.76,0:10:27.53,Layzner,,0,0,0,,你去吗
Dialogue: 0,0:10:29.10,0:10:29.86,Layzner,,0,0,0,,你去吗
Dialogue: 0,0:10:31.94,0:10:34.30,Layzner,,0,0,0,,还是你去
Dialogue: 0,0:10:34.50,0:10:37.06,Layzner,,0,0,0,,鲁·凯恩阁下 这个任务就请交给我
Dialogue: 0,0:10:37.52,0:10:39.18,Layzner,,0,0,0,,谁让你说话了
Dialogue: 0,0:10:39.18,0:10:40.20,Layzner,,0,0,0,,请饶恕小的无礼
Dialogue: 0,0:10:40.20,0:10:43.26,Layzner,,0,0,0,,但是这个使命唯小的能胜任
Dialogue: 0,0:10:44.08,0:10:47.10,Layzner,,0,0,0,,你已经屡战屡败了
Dialogue: 0,0:10:47.10,0:10:51.30,Layzner,,0,0,0,,阁下 这次就请给小的最后一个机会吧
Dialogue: 0,0:10:51.88,0:10:54.53,Layzner,,0,0,0,,你就这么恨圣女吗
Dialogue: 0,0:10:55.16,0:10:57.88,Layzner,,0,0,0,,我绝不能把她拱手让人
Dialogue: 0,0:10:58.98,0:11:01.83,Layzner,,0,0,0,,小的正是最合适的战士
Dialogue: 0,0:11:03.16,0:11:06.64,Layzner,,0,0,0,,你别忘了自己说的话 这是最后的机会了
Dialogue: 0,0:11:07.20,0:11:08.63,Layzner,,0,0,0,,请交给我吧
Dialogue: 0,0:11:15.36,0:11:17.80,Layzner,,0,0,0,,就这么恨甩了你的女人吗
Dialogue: 0,0:11:17.84,0:11:21.16,Layzner,,0,0,0,,看你这样子一定是对她很着迷吧
Dialogue: 0,0:11:21.16,0:11:23.28,Layzner,,0,0,0,,求你了 玖丽亚 我爱你啊
Dialogue: 0,0:11:23.80,0:11:29.14,Layzner,,0,0,0,,混蛋 你们这些下流东西没资格杀玖丽亚
Dialogue: 0,0:11:45.54,0:11:47.36,Layzner,,0,0,0,,比想象中要大很多啊
Dialogue: 0,0:11:53.50,0:11:55.80,Layzner,,0,0,0,,博士 基鲁巴特博士
Dialogue: 0,0:11:57.96,0:12:02.33,Layzner,,0,0,0,,在地下工厂制造SPT的是你们吗
Dialogue: 0,0:12:02.96,0:12:06.28,Layzner,,0,0,0,,虽然听英二说过了 还真是差点认不出了啊
Dialogue: 0,0:12:06.54,0:12:10.06,Layzner,,0,0,0,,博士你也是 这发型很漂亮啊
Dialogue: 0,0:12:11.08,0:12:11.86,Layzner,,0,0,0,,你也是
Dialogue: 0,0:12:12.08,0:12:16.32,Layzner,,0,0,0,,早点跟我们说嘛 英二你也真是的
Dialogue: 0,0:12:16.32,0:12:19.06,Layzner,,0,0,0,,不 这也是以防万一
Dialogue: 0,0:12:19.80,0:12:25.20,Layzner,,0,0,0,,我们的战力还不充分 被敌人知道了我们的组织就糟了
Dialogue: 0,0:12:26.90,0:12:29.26,Layzner,,0,0,0,,你们的来意我基本知道了
Dialogue: 0,0:12:29.98,0:12:34.82,Layzner,,0,0,0,,大卫 你想要的是我们正在实验的SPT吧
Dialogue: 0,0:12:35.40,0:12:39.04,Layzner,,0,0,0,,不愧是博士 不用拐弯抹角 那么 赶紧
Dialogue: 0,0:12:39.04,0:12:40.33,Layzner,,0,0,0,,不能借给你
Dialogue: 0,0:12:40.35,0:12:41.17,Layzner,,0,0,0,,哎
Dialogue: 0,0:12:41.18,0:12:42.33,Layzner,,0,0,0,,博士
Dialogue: 0,0:12:43.02,0:12:45.90,Layzner,,0,0,0,,营救圣女的事就交给英二吧
Dialogue: 0,0:12:46.62,0:12:48.52,Layzner,,0,0,0,,不用管鲁·凯恩的挑拨
Dialogue: 0,0:12:49.04,0:12:52.42,Layzner,,0,0,0,,但是博士 这关系到地球人的尊严啊
Dialogue: 0,0:12:52.42,0:12:55.14,Layzner,,0,0,0,,我觉得不是救出来就可以这么简单啊
Dialogue: 0,0:12:55.80,0:12:59.82,Layzner,,0,0,0,,这也是为了保护你们的性命与这未完成的SPT
Dialogue: 0,0:13:00.04,0:13:05.40,Layzner,,0,0,0,,对圣女见死不救而完成地球制SPT也没什么意义
Dialogue: 0,0:13:06.00,0:13:07.24,Layzner,,0,0,0,,不会见死不救的
Dialogue: 0,0:13:07.48,0:13:10.20,Layzner,,0,0,0,,都一样 不是地球人去救吧
Dialogue: 0,0:13:10.88,0:13:15.44,Layzner,,0,0,0,,我认为就算完成了SPT 失去的尊严也没有那么容易被挽回
Dialogue: 0,0:13:16.22,0:13:19.06,Layzner,,0,0,0,,这世上无法挽回的只有人的生命
Dialogue: 0,0:13:19.90,0:13:20.52,Layzner,,0,0,0,,别这么冲动
Dialogue: 0,0:14:00.76,0:14:03.88,Layzner,,0,0,0,,不借我SPT我也束手无策吧
Dialogue: 0,0:14:04.52,0:14:05.82,Layzner,,0,0,0,,好了 回去吧
Dialogue: 0,0:14:05.82,0:14:09.72,Layzner,,0,0,0,,真是的 我们到底干什么来了啊 你真是差劲
Dialogue: 0,0:14:09.72,0:14:12.18,Layzner,,0,0,0,,大话说完结果就这样算了
Dialogue: 0,0:14:12.18,0:14:16.14,Layzner,,0,0,0,,就是啊 我真是没用 对吧 英二
Dialogue: 0,0:14:16.84,0:14:17.70,Layzner,,0,0,0,,你怎么觉得
Dialogue: 0,0:14:21.46,0:14:22.52,Layzner,,0,0,0,,大卫
Dialogue: 0,0:14:22.52,0:14:24.24,Layzner,,0,0,0,,这是干什么
Dialogue: 0,0:14:24.58,0:14:25.86,Layzner,,0,0,0,,大卫
Dialogue: 0,0:14:27.02,0:14:30.16,Layzner,,0,0,0,,西蒙妮 打开出口 我要开这个出去
Dialogue: 0,0:14:34.46,0:14:35.92,Layzner,,0,0,0,,安娜 英二拜托你了
Dialogue: 0,0:14:41.36,0:14:43.16,Layzner,,0,0,0,,西蒙妮 快点
Dialogue: 0,0:14:46.32,0:14:49.26,Layzner,,0,0,0,,站住 你干什么
Dialogue: 0,0:14:49.86,0:14:53.40,Layzner,,0,0,0,,快回来 大卫 别乱来 大卫
Dialogue: 0,0:15:34.14,0:15:36.68,Layzner,,0,0,0,,出来吧 地球人的战士
Dialogue: 0,0:15:42.78,0:15:44.62,Layzner,,0,0,0,,地球没有战士吗
Dialogue: 0,0:15:47.96,0:15:50.68,Layzner,,0,0,0,,圣女为了你们堵上了性命
Dialogue: 0,0:15:52.66,0:15:54.93,Layzner,,0,0,0,,就没有人愿意出来一战吗
Dialogue: 0,0:15:55.58,0:16:00.34,Layzner,,0,0,0,,这样的事不是保护地球人的尊严 不要出来战斗
Dialogue: 0,0:16:05.90,0:16:06.63,Layzner,,0,0,0,,玖丽亚
Dialogue: 0,0:16:07.26,0:16:10.32,Layzner,,0,0,0,,不管你说什么地球人都不会回应的
Dialogue: 0,0:16:10.84,0:16:12.84,Layzner,,0,0,0,,这就是他们的真面目
Dialogue: 0,0:16:14.80,0:16:19.00,Layzner,,0,0,0,,看啊 他们不过是些胆小的猴子
Dialogue: 0,0:16:19.66,0:16:23.36,Layzner,,0,0,0,,没有尊严也没有气概 连同伴都不愿拯救
Dialogue: 0,0:16:26.50,0:16:28.16,Layzner,,0,0,0,,这下应该很清楚了
Dialogue: 0,0:16:28.76,0:16:33.68,Layzner,,0,0,0,,地球人被我们征服是理所当然的
Dialogue: 0,0:16:34.58,0:16:35.62,Layzner,,0,0,0,,地球人啊
Dialogue: 0,0:16:36.76,0:16:39.80,Layzner,,0,0,0,,你们连一个女人都拯救不了
Dialogue: 0,0:16:40.60,0:16:46.84,Layzner,,0,0,0,,给我睁大眼睛好好看着 这为你们而死的女人
Dialogue: 0,0:16:48.46,0:16:50.43,Layzner,,0,0,0,,不是我杀的
Dialogue: 0,0:16:51.28,0:16:53.13,Layzner,,0,0,0,,是你们杀的
Dialogue: 0,0:16:56.76,0:16:57.81,Layzner,,0,0,0,,处决圣女
Dialogue: 0,0:17:14.48,0:17:18.08,Layzner,,0,0,0,,玖丽亚啊 快叫 快求饶
Dialogue: 0,0:17:19.06,0:17:22.03,Layzner,,0,0,0,,这样至少能饶你一命
Dialogue: 0,0:17:23.06,0:17:26.08,Layzner,,0,0,0,,哭吧 下跪吧
Dialogue: 0,0:17:31.28,0:17:33.60,Layzner,,0,0,0,,好像在做梦啊 玖丽亚
Dialogue: 0,0:17:40.10,0:17:42.98,Layzner,,0,0,0,,我都快受不了了
Dialogue: 0,0:17:55.88,0:17:57.58,Layzner,,0,0,0,,古斯特罗 我来对付你
Dialogue: 0,0:17:57.94,0:17:58.52,Layzner,,0,0,0,,大卫
Dialogue: 0,0:17:59.48,0:18:00.71,Layzner,,0,0,0,,出现了啊 暴徒
Dialogue: 0,0:18:00.86,0:18:03.60,Layzner,,0,0,0,,切 等会再收拾你 给我等着
Dialogue: 0,0:18:05.64,0:18:06.70,Layzner,,0,0,0,,请让一下
Dialogue: 0,0:18:08.60,0:18:10.80,Layzner,,0,0,0,,还行脱帽礼真是守礼节啊
Dialogue: 0,0:18:25.34,0:18:26.06,Layzner,,0,0,0,,可恶
Dialogue: 0,0:18:46.88,0:18:48.48,Layzner,,0,0,0,,就是这样 大卫
Dialogue: 0,0:18:48.56,0:18:51.01,Layzner,,0,0,0,,给我起来 让你看看地球人的志气
Dialogue: 0,0:19:09.52,0:19:12.28,Layzner,,0,0,0,,别乱动 我这也有准备啊
Dialogue: 0,0:19:23.84,0:19:24.72,Layzner,,0,0,0,,可恶
Dialogue: 0,0:19:33.72,0:19:34.67,Layzner,,0,0,0,,大卫
Dialogue: 0,0:19:41.14,0:19:43.54,Layzner,,0,0,0,,难得有这机会 我要华丽的杀了你
Dialogue: 0,0:19:46.30,0:19:47.56,Layzner,,0,0,0,,大卫 快跑
Dialogue: 0,0:19:47.82,0:19:48.60,Layzner,,0,0,0,,西蒙妮
Dialogue: 0,0:19:49.16,0:19:50.83,Layzner,,0,0,0,,小心点 有人在使诈
Dialogue: 0,0:19:55.58,0:19:58.58,Layzner,,0,0,0,,这次是女人吗 我喜欢
Dialogue: 0,0:20:24.50,0:20:25.26,Layzner,,0,0,0,,西蒙妮
Dialogue: 0,0:20:36.62,0:20:37.93,Layzner,,0,0,0,,西蒙妮
Dialogue: 0,0:20:39.56,0:20:42.76,Layzner,,0,0,0,,正好 两个一起收拾
Dialogue: 0,0:20:43.74,0:20:44.80,Layzner,,0,0,0,,住手 古斯特罗
Dialogue: 0,0:20:47.28,0:20:49.32,Layzner,,0,0,0,,你没资格杀那两个人
Dialogue: 0,0:20:49.80,0:20:51.16,Layzner,,0,0,0,,闭嘴 卑鄙小人
Dialogue: 0,0:20:52.04,0:20:54.88,Layzner,,0,0,0,,这是地球人和古拉特斯人的战斗
Dialogue: 0,0:20:55.70,0:20:58.26,Layzner,,0,0,0,,不关你这流着肮脏血液之人的事
Dialogue: 0,0:20:58.92,0:21:00.16,Layzner,,0,0,0,,谁才卑鄙
Dialogue: 0,0:21:00.94,0:21:02.98,Layzner,,0,0,0,,你问问这个士兵
Dialogue: 0,0:21:02.98,0:21:05.40,Layzner,,0,0,0,,那两个地球人受伤的原因吧
Dialogue: 0,0:21:07.42,0:21:08.40,Layzner,,0,0,0,,古斯特罗这混蛋
Dialogue: 0,0:21:09.26,0:21:11.38,Layzner,,0,0,0,,臭小子 做这种多余的事
Dialogue: 0,0:21:29.28,0:21:30.50,Layzner,,0,0,0,,把古斯特罗给我揪出来
Dialogue: 0,0:21:35.42,0:21:40.56,Layzner,,0,0,0,,鲁·凯恩阁下 请原谅 请原谅 求您绕了小的
Dialogue: 0,0:21:41.78,0:21:46.08,Layzner,,0,0,0,,你这不要脸的东西 你就是古拉特斯的耻辱
Dialogue: 0,0:21:46.68,0:21:47.70,Layzner,,0,0,0,,我毙了你
Dialogue: 0,0:21:48.96,0:21:50.00,Layzner,,0,0,0,,请住手
Dialogue: 0,0:21:50.82,0:21:51.52,Layzner,,0,0,0,,什么
Dialogue: 0,0:21:52.42,0:21:54.28,Layzner,,0,0,0,,请原谅这个男人
Dialogue: 0,0:21:55.48,0:21:57.88,Layzner,,0,0,0,,他可是屡次想杀你啊
Dialogue: 0,0:21:58.80,0:22:01.68,Layzner,,0,0,0,,我不想见到杀戮
Dialogue: 0,0:22:02.34,0:22:04.28,Layzner,,0,0,0,,你不恨他吗
Dialogue: 0,0:22:05.04,0:22:06.88,Layzner,,0,0,0,,他很可悲
Dialogue: 0,0:22:08.86,0:22:09.52,Layzner,,0,0,0,,可悲
Dialogue: 0,0:22:10.42,0:22:11.32,Layzner,,0,0,0,,可悲吗
Dialogue: 0,0:22:13.02,0:22:14.20,Layzner,,0,0,0,,给我押近大牢
Dialogue: 0,0:22:17.70,0:22:18.88,Layzner,,0,0,0,,非常感谢您
Dialogue: 0,0:22:19.68,0:22:20.88,Layzner,,0,0,0,,不用道谢
Dialogue: 0,0:22:21.76,0:22:23.90,Layzner,,0,0,0,,阁下 如何处置他们
Dialogue: 0,0:22:26.48,0:22:29.56,Layzner,,0,0,0,,你还想继续给我丢脸吗
Dialogue: 0,0:22:30.36,0:22:31.12,Layzner,,0,0,0,,撤了
Dialogue: 0,0:22:38.92,0:22:39.96,Layzner,,0,0,0,,鲁·凯恩啊
Dialogue: 0,0:22:41.16,0:22:43.24,Layzner,,0,0,0,,你还太年轻
Dialogue: 0,0:22:44.40,0:22:48.17,Layzner,,0,0,0,,有太多不懂的事
Dialogue: 0,0:23:54.50,0:23:57.08,Layzner,,0,0,0,,你这混蛋把我的心弄得痛如刀绞
Dialogue: 0,0:23:57.38,0:24:01.70,Layzner,,0,0,0,,这次我要你们姐弟也尝尝这滋味
Dialogue: 0,0:24:04.02,0:24:07.56,Layzner,,0,0,0,,此回 啊 古斯特罗

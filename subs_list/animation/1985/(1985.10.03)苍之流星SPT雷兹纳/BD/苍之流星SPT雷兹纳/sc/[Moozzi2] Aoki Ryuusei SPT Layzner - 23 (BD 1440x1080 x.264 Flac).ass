Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:01:01.73,0:01:02.33,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:01:02.30,0:01:03.05,Layzner,,0,0,0,,玖丽亚
Dialogue: 0,0:01:03.08,0:01:03.94,Layzner,,0,0,0,,凯利
Dialogue: 0,0:01:03.99,0:01:06.68,Layzner,,0,0,0,,总统 事到如今只能使用核弹了
Dialogue: 0,0:01:06.80,0:01:08.14,Layzner,,0,0,0,,是英二吗
Dialogue: 0,0:01:08.18,0:01:09.24,Layzner,,0,0,0,,大家都在航天飞机里吗
Dialogue: 0,0:01:09.24,0:01:10.49,Layzner,,0,0,0,,大家都在这
Dialogue: 0,0:01:44.23,0:01:47.36,Layzner,,0,0,0,,等一下 姐姐 我刚才说的是真的
Dialogue: 0,0:01:48.88,0:01:51.11,Layzner,,0,0,0,,我们两人不就是最好的证据吗
Dialogue: 0,0:01:52.32,0:01:54.21,Layzner,,0,0,0,,英二 觉悟吧
Dialogue: 0,0:01:54.42,0:01:56.74,Layzner,,0,0,0,,现在开始突入大气层
Dialogue: 0,0:01:56.74,0:02:01.76,Layzner,,0,0,0,,雷兹纳的失控原因是出自两部电脑的秘密
Dialogue: 0,0:02:02.69,0:02:07.41,Layzner,,0,0,0,,然后姐弟自相残杀
Dialogue: 0,0:02:08.13,0:02:14.23,Layzner,,0,0,0,,我们知道这件事是好久之后的事了
Dialogue: 0,0:02:14.23,0:02:19.23,Layzner,,0,0,0,,第二十三话 寻求奇迹
Dialogue: 0,0:02:57.27,0:03:00.86,Layzner,,0,0,0,,警告信息 追击队从第一区域接近
Dialogue: 0,0:03:00.86,0:03:01.93,Layzner,,0,0,0,,姐姐 不要过来
Dialogue: 0,0:03:16.95,0:03:19.43,Layzner,,0,0,0,,不是这样的 姐姐
Dialogue: 0,0:03:24.11,0:03:26.91,Layzner,,0,0,0,,掩护玖丽亚机 击落雷兹纳
Dialogue: 0,0:03:31.47,0:03:34.56,Layzner,,0,0,0,,不是 凯利前辈不是我杀的
Dialogue: 0,0:03:37.06,0:03:42.11,Layzner,,0,0,0,,雷兹纳体内的另一部电脑做的
Dialogue: 0,0:03:37.06,0:03:42.11,Layzner,,0,0,0,,我知道说了你也不会相信 可是是雷兹纳做的
Dialogue: 0,0:03:42.11,0:03:44.58,Layzner,,0,0,0,,英二 我不想听借口了
Dialogue: 0,0:03:47.87,0:03:49.61,Layzner,,0,0,0,,不是说谎 是真的
Dialogue: 0,0:03:49.81,0:03:53.01,Layzner,,0,0,0,,左腰部受损 损伤轻微 尽快反击
Dialogue: 0,0:03:53.01,0:03:56.37,Layzner,,0,0,0,,怎么可以 她是我唯一的姐姐
Dialogue: 0,0:04:00.06,0:04:00.75,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:04:14.12,0:04:15.38,Layzner,,0,0,0,,住手 姐姐
Dialogue: 0,0:04:19.06,0:04:20.78,Layzner,,0,0,0,,凯利是我的一切
Dialogue: 0,0:04:23.32,0:04:28.28,Layzner,,0,0,0,,前辈最后说了要保护这美丽的星球
Dialogue: 0,0:04:28.72,0:04:30.14,Layzner,,0,0,0,,他这么说了 姐姐
Dialogue: 0,0:04:30.14,0:04:34.22,Layzner,,0,0,0,,怎么可能 他是纯古拉特斯人
Dialogue: 0,0:04:34.54,0:04:38.25,Layzner,,0,0,0,,不 不管他说什么我都不会原谅你的
Dialogue: 0,0:04:43.26,0:04:47.04,Layzner,,0,0,0,,你听一下姐姐 是前辈的声音 还留在雷里面
Dialogue: 0,0:04:47.27,0:04:51.04,Layzner,,0,0,0,,不要 不管听什么 我都
Dialogue: 0,0:04:56.98,0:05:00.24,Layzner,,0,0,0,,基乌拉队长 玖丽亚离敌人太近无法射击
Dialogue: 0,0:05:00.24,0:05:01.14,Layzner,,0,0,0,,别管她
Dialogue: 0,0:05:01.72,0:05:04.06,Layzner,,0,0,0,,你们三架同时射击
Dialogue: 0,0:05:04.25,0:05:06.63,Layzner,,0,0,0,,让他们姐弟一起死 这总行了吧
Dialogue: 0,0:05:07.23,0:05:12.12,Layzner,,0,0,0,,古雷斯库陛下说了用尽一切方法也要毁了雷兹纳
Dialogue: 0,0:05:14.97,0:05:16.84,Layzner,,0,0,0,,第二区域有热源反应
Dialogue: 0,0:05:16.84,0:05:17.39,Layzner,,0,0,0,,什么
Dialogue: 0,0:05:27.36,0:05:29.43,Layzner,,0,0,0,,无法回避
Dialogue: 0,0:05:31.34,0:05:32.04,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:05:33.78,0:05:34.66,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:05:35.02,0:05:37.88,Layzner,,0,0,0,,雷 启动V-MAX
Dialogue: 0,0:05:37.88,0:05:38.71,Layzner,,0,0,0,,Ready!
Dialogue: 0,0:06:12.22,0:06:13.14,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:06:51.22,0:06:52.09,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:07:24.10,0:07:25.40,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:07:31.69,0:07:34.31,Layzner,,0,0,0,,姐姐 玖丽亚姐姐
Dialogue: 0,0:08:44.32,0:08:46.04,Layzner,,0,0,0,,注入附加能源
Dialogue: 0,0:08:46.87,0:08:49.36,Layzner,,0,0,0,,二三号机填充能源
Dialogue: 0,0:08:49.36,0:08:51.48,Layzner,,0,0,0,,四五号机开始填充能源
Dialogue: 0,0:08:52.02,0:08:54.92,Layzner,,0,0,0,,离补足破坏能源还有十分钟
Dialogue: 0,0:09:02.36,0:09:06.16,Layzner,,0,0,0,,马上就可以听到猴子们的哀鸣了
Dialogue: 0,0:09:07.98,0:09:10.10,Layzner,,0,0,0,,对了 有收到基乌拉的联络吗
Dialogue: 0,0:09:10.29,0:09:12.29,Layzner,,0,0,0,,没有 现在去联络
Dialogue: 0,0:09:15.51,0:09:18.88,Layzner,,0,0,0,,要征服地球只是时间的问题
Dialogue: 0,0:09:18.88,0:09:24.32,Layzner,,0,0,0,,比起这个要快把雷兹纳的秘密消灭
Dialogue: 0,0:09:55.16,0:09:57.05,Layzner,,0,0,0,,在准备作战了呢
Dialogue: 0,0:09:57.05,0:10:01.84,Layzner,,0,0,0,,他们是认真的吗 他们以为真的可以和古拉特斯打吗
Dialogue: 0,0:10:01.84,0:10:05.65,Layzner,,0,0,0,,可是我也能了解不想一直站着挨打的心情啊
Dialogue: 0,0:10:06.13,0:10:07.69,Layzner,,0,0,0,,这是地球人的自尊吗
Dialogue: 0,0:10:07.91,0:10:08.62,Layzner,,0,0,0,,没错
Dialogue: 0,0:10:09.01,0:10:11.13,Layzner,,0,0,0,,古拉特斯来的话你就会拿枪抵抗了吗
Dialogue: 0,0:10:11.20,0:10:13.22,Layzner,,0,0,0,,这 可能吧
Dialogue: 0,0:10:13.46,0:10:16.75,Layzner,,0,0,0,,英二到现在的努力都白费了
Dialogue: 0,0:10:17.21,0:10:18.94,Layzner,,0,0,0,,英二那家伙到底在干什么啊
Dialogue: 0,0:10:19.70,0:10:21.81,Layzner,,0,0,0,,他好像也没有和基地联络
Dialogue: 0,0:10:23.76,0:10:25.77,Layzner,,0,0,0,,该不会被古拉特斯那些人给
Dialogue: 0,0:10:25.77,0:10:26.90,Layzner,,0,0,0,,不可能的
Dialogue: 0,0:10:27.65,0:10:31.41,Layzner,,0,0,0,,可是这么久都没联络了 也就是说
Dialogue: 0,0:10:31.41,0:10:32.88,Layzner,,0,0,0,,英二一定还活着
Dialogue: 0,0:10:33.03,0:10:33.71,Layzner,,0,0,0,,对
Dialogue: 0,0:10:34.64,0:10:37.56,Layzner,,0,0,0,,对 他命一直都很大的
Dialogue: 0,0:10:37.79,0:10:38.74,Layzner,,0,0,0,,说的也是
Dialogue: 0,0:10:46.67,0:10:47.92,Layzner,,0,0,0,,那个是
Dialogue: 0,0:11:07.22,0:11:09.22,Layzner,,0,0,0,,姐姐 回答我
Dialogue: 0,0:11:14.75,0:11:15.56,Layzner,,0,0,0,,难不成
Dialogue: 0,0:12:11.97,0:12:17.82,Layzner,,0,0,0,,总统先生 大家都手牵手 世界头一次团结起来
Dialogue: 0,0:12:18.02,0:12:20.10,Layzner,,0,0,0,,马上就会有好消息的
Dialogue: 0,0:13:33.42,0:13:36.00,Layzner,,0,0,0,,什么 都被消灭了
Dialogue: 0,0:13:37.87,0:13:39.08,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:13:46.21,0:13:49.83,Layzner,,0,0,0,,有史以来头一次全世界团结起来
Dialogue: 0,0:13:49.83,0:13:53.54,Layzner,,0,0,0,,但这样还是不能解决吗
Dialogue: 0,0:13:54.46,0:13:56.32,Layzner,,0,0,0,,真的到此为止了吗
Dialogue: 0,0:14:06.05,0:14:09.55,Layzner,,0,0,0,,总统先生 事到如今只有使用核武了
Dialogue: 0,0:14:10.96,0:14:15.28,Layzner,,0,0,0,,在宇宙产生的爆炸对地球的影响很小
Dialogue: 0,0:14:24.63,0:14:28.04,Layzner,,0,0,0,,我是美国总统迪理杰
Dialogue: 0,0:14:28.45,0:14:30.62,Layzner,,0,0,0,,准备发射核弹
Dialogue: 0,0:14:32.32,0:14:36.71,Layzner,,0,0,0,,可恶 竟然被逼到要发射核武的地步
Dialogue: 0,0:14:36.75,0:14:39.24,Layzner,,0,0,0,,不过也只有这样才能救我们了
Dialogue: 0,0:14:39.26,0:14:41.17,Layzner,,0,0,0,,马上向各国宣布 这里是奥斯卡 阿尔法1522
Dialogue: 0,0:14:41.42,0:14:47.07,Layzner,,0,0,0,,胶囊 这里是奥斯卡11 信息编号2252231323
Dialogue: 0,0:15:33.12,0:15:35.85,Layzner,,0,0,0,,这样啊
Dialogue: 0,0:15:49.00,0:15:51.37,Layzner,,0,0,0,,总统先生 还有希望
Dialogue: 0,0:15:52.51,0:15:55.35,Layzner,,0,0,0,,难不成你还有魔杖
Dialogue: 0,0:15:55.97,0:15:59.06,Layzner,,0,0,0,,就算有万分之一的机会也要赌赌看
Dialogue: 0,0:15:59.35,0:16:02.27,Layzner,,0,0,0,,你是说他们吗
Dialogue: 0,0:16:08.50,0:16:11.68,Layzner,,0,0,0,,我有重要的事要对你们说
Dialogue: 0,0:16:11.96,0:16:17.47,Layzner,,0,0,0,,你们也看到了 就连核弹也没用
Dialogue: 0,0:16:17.88,0:16:22.00,Layzner,,0,0,0,,老实说再过24小时地球可能就被毁了
Dialogue: 0,0:16:22.24,0:16:23.64,Layzner,,0,0,0,,24小时
Dialogue: 0,0:16:23.64,0:16:27.88,Layzner,,0,0,0,,你说毁灭 那我们会被怎么样
Dialogue: 0,0:16:28.00,0:16:31.50,Layzner,,0,0,0,,被古拉特斯征服 或是 死
Dialogue: 0,0:16:31.50,0:16:33.18,Layzner,,0,0,0,,你们
Dialogue: 0,0:16:33.18,0:16:36.96,Layzner,,0,0,0,,司令官 你是特别来说这个的吗
Dialogue: 0,0:16:36.96,0:16:38.96,Layzner,,0,0,0,,不 接下来才是我要说的
Dialogue: 0,0:16:40.75,0:16:42.95,Layzner,,0,0,0,,想请你们救救我们
Dialogue: 0,0:16:46.76,0:16:48.97,Layzner,,0,0,0,,请你们拯救地球
Dialogue: 0,0:16:49.37,0:16:51.55,Layzner,,0,0,0,,我们怎么会有办法
Dialogue: 0,0:17:00.68,0:17:03.28,Layzner,,0,0,0,,喂 长官
Dialogue: 0,0:17:03.28,0:17:05.28,Layzner,,0,0,0,,是伊丽莎白博士吗
Dialogue: 0,0:17:05.81,0:17:09.65,Layzner,,0,0,0,,我从卡布斯那听说了 要活下去只有一个办法
Dialogue: 0,0:17:09.92,0:17:12.53,Layzner,,0,0,0,,就是你们拥有的外星人武器
Dialogue: 0,0:17:12.53,0:17:16.05,Layzner,,0,0,0,,长官 你不会真的叫那些孩子
Dialogue: 0,0:17:16.05,0:17:20.88,Layzner,,0,0,0,,你们活着从火星回来了 这是奇迹
Dialogue: 0,0:17:21.45,0:17:26.72,Layzner,,0,0,0,,这次我们也只能寄望你们再创造一次奇迹了
Dialogue: 0,0:17:28.04,0:17:30.06,Layzner,,0,0,0,,我们办不到的
Dialogue: 0,0:17:30.37,0:17:32.06,Layzner,,0,0,0,,唉 是总统
Dialogue: 0,0:17:32.30,0:17:35.32,Layzner,,0,0,0,,没错 是办不到
Dialogue: 0,0:17:35.32,0:17:41.52,Layzner,,0,0,0,,当然不是命令或强迫你们 你们有选择的自由
Dialogue: 0,0:17:52.37,0:17:59.97,Layzner,,0,0,0,,能存活下来唯一的可能性就只有靠你们了
Dialogue: 0,0:17:52.37,0:17:59.97,Layzner,,0,0,0,,如果人类还有明天的话
Dialogue: 0,0:18:03.11,0:18:08.37,Layzner,,0,0,0,,他们的行为太卑鄙了 根本就是叫我们去送死嘛
Dialogue: 0,0:18:08.37,0:18:14.80,Layzner,,0,0,0,,如果英二在就好了
Dialogue: 0,0:18:08.37,0:18:14.80,Layzner,,0,0,0,,真是的 不管我们怎么努力也没胜算啊
Dialogue: 0,0:18:15.49,0:18:19.87,Layzner,,0,0,0,,不 现在也没空去找他或者等他了 所以
Dialogue: 0,0:18:19.87,0:18:25.54,Layzner,,0,0,0,,对了 没有英二的话 我们早就死在火星了
Dialogue: 0,0:18:25.87,0:18:32.50,Layzner,,0,0,0,,至少我们现在还不只一个人
Dialogue: 0,0:18:25.87,0:18:32.50,Layzner,,0,0,0,,他一个人来到地球 只有他一个人
Dialogue: 0,0:18:33.10,0:18:38.42,Layzner,,0,0,0,,有罗安 亚瑟 有西蒙尼 安娜 还有伊丽莎白博士
Dialogue: 0,0:18:39.30,0:18:45.31,Layzner,,0,0,0,,我去 为了完成英二的心愿 还有为了我们的未来
Dialogue: 0,0:18:45.54,0:18:46.85,Layzner,,0,0,0,,当然了 我也去
Dialogue: 0,0:18:47.18,0:18:49.70,Layzner,,0,0,0,,我也去 还有航天飞机是吧
Dialogue: 0,0:18:49.70,0:18:51.61,Layzner,,0,0,0,,航天飞机交给我吧
Dialogue: 0,0:18:51.61,0:18:53.02,Layzner,,0,0,0,,那么走吧
Dialogue: 0,0:18:54.00,0:18:58.48,anna,,0,0,0,,（我不去谁念旁白）
Dialogue: 0,0:18:54.00,0:18:58.48,Layzner,,0,0,0,,让我也去 我不能丢下英二不管
Dialogue: 0,0:18:58.48,0:19:01.18,Layzner,,0,0,0,,我也去 我也是男人
Dialogue: 0,0:19:01.50,0:19:03.27,Layzner,,0,0,0,,好 大家走吧
Dialogue: 0,0:19:21.13,0:19:23.09,Layzner,,0,0,0,,好漂亮
Dialogue: 0,0:19:26.29,0:19:31.87,Layzner,,0,0,0,,蓝色的水 对了 这是海 是海啊
Dialogue: 0,0:19:32.01,0:19:34.26,Layzner,,0,0,0,,是地球所有生命的起源
Dialogue: 0,0:19:35.08,0:19:37.73,Layzner,,0,0,0,,住着这么可爱生物的地球
Dialogue: 0,0:19:40.19,0:19:44.71,Layzner,,0,0,0,,多么蔚蓝而绮丽的光芒
Dialogue: 0,0:19:44.71,0:19:50.59,Layzner,,0,0,0,,你这么拼命保护的 就是这地球吗
Dialogue: 0,0:19:51.07,0:19:52.41,Layzner,,0,0,0,,玖丽亚
Dialogue: 0,0:19:52.41,0:19:53.90,Layzner,,0,0,0,,凯利 你
Dialogue: 0,0:19:56.11,0:20:00.64,Layzner,,0,0,0,,姐姐 你在听吗 这就是凯利前辈最后的遗言
Dialogue: 0,0:20:02.39,0:20:06.93,Layzner,,0,0,0,,多么蔚蓝而绮丽的光芒
Dialogue: 0,0:20:07.57,0:20:15.32,Layzner,,0,0,0,,你这么拼命保护的 就是这地球吗 玖丽亚
Dialogue: 0,0:20:15.39,0:20:16.81,Layzner,,0,0,0,,凯利
Dialogue: 0,0:20:20.93,0:20:22.88,Layzner,,0,0,0,,拜托了 各位
Dialogue: 0,0:20:24.86,0:20:26.06,Layzner,,0,0,0,,安娜
Dialogue: 0,0:20:26.06,0:20:30.20,Layzner,,0,0,0,,地球真的不行了吗 没这回事吧
Dialogue: 0,0:20:30.45,0:20:34.04,Layzner,,0,0,0,,我是这么深信的 所以也请你们相信
Dialogue: 0,0:20:35.29,0:20:38.85,Layzner,,0,0,0,,请给我一朵 我想送给一个人
Dialogue: 0,0:20:38.94,0:20:39.88,Layzner,,0,0,0,,安娜
Dialogue: 0,0:20:39.93,0:20:43.78,Layzner,,0,0,0,,对不起 我现在就去
Dialogue: 0,0:20:43.78,0:20:45.78,Layzner,,0,0,0,,拜托你们了
Dialogue: 0,0:21:09.43,0:21:10.56,Layzner,,0,0,0,,马上出发
Dialogue: 0,0:21:10.56,0:21:10.86,Layzner,,0,0,0,,是
Dialogue: 0,0:21:26.01,0:21:30.11,Layzner,,0,0,0,,英二 听得到吗 英二 请回答
Dialogue: 0,0:21:30.63,0:21:32.09,Layzner,,0,0,0,,还是不行吗
Dialogue: 0,0:21:32.09,0:21:35.00,Layzner,,0,0,0,,这里是美国空军WX231战斗大队
Dialogue: 0,0:21:35.31,0:21:39.05,Layzner,,0,0,0,,请让我们护送你们直到我们不行为止
Dialogue: 0,0:21:39.05,0:21:41.67,Layzner,,0,0,0,,这里是爱尔兰空军第13部队
Dialogue: 0,0:21:41.74,0:21:44.23,Layzner,,0,0,0,,请看 苏联军也来了
Dialogue: 0,0:21:44.23,0:21:47.32,Layzner,,0,0,0,,对啊 对面的不是加拿大军吗
Dialogue: 0,0:21:47.32,0:21:51.62,Layzner,,0,0,0,,好棒哦 还有德国跟中国 法国跟瑞士 大家都来了
Dialogue: 0,0:21:52.00,0:21:53.43,Layzner,,0,0,0,,怎么会这样
Dialogue: 0,0:21:53.43,0:21:55.80,Layzner,,0,0,0,,很感谢大家 谢谢
Dialogue: 0,0:21:56.15,0:22:00.77,Layzner,,0,0,0,,伊丽莎白博士 人类今后也没问题对吧
Dialogue: 0,0:22:00.89,0:22:01.61,Layzner,,0,0,0,,对
Dialogue: 0,0:22:05.91,0:22:07.84,Layzner,,0,0,0,,大卫 罗安 听得到吗
Dialogue: 0,0:22:10.79,0:22:12.63,Layzner,,0,0,0,,是英二吗
Dialogue: 0,0:22:12.63,0:22:17.01,Layzner,,0,0,0,,西蒙尼 安娜 亚瑟 大家都在航天飞机里吗 博士也在吗
Dialogue: 0,0:22:17.12,0:22:19.08,Layzner,,0,0,0,,对 大家都在哦
Dialogue: 0,0:22:19.08,0:22:20.65,Layzner,,0,0,0,,那我马上过去跟你们会和
Dialogue: 0,0:22:21.15,0:22:24.73,Layzner,,0,0,0,,可恶 感觉好像要发生奇迹了
Dialogue: 0,0:22:24.73,0:22:25.83,Layzner,,0,0,0,,我也有同感
Dialogue: 0,0:22:33.22,0:22:34.95,Layzner,,0,0,0,,英二来了
Dialogue: 0,0:22:36.00,0:22:41.50,Layzner,,0,0,0,,我们多了这一个同伴 勇气忽然如泉涌
Dialogue: 0,0:22:42.40,0:22:48.70,Layzner,,0,0,0,,然后还有 预感奇迹要发生了
Dialogue: 0,0:22:57.01,0:23:02.30,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:02.65,0:23:07.06,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.98,0:23:14.44,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:14.62,0:23:20.40,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:20.66,0:23:26.41,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:26.67,0:23:33.62,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:34.47,0:23:40.30,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.93,0:23:45.97,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:57.40,0:23:03.20,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:03.20,0:23:07.62,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:09.50,0:23:14.83,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.83,0:23:21.05,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:21.05,0:23:27.26,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:27.26,0:23:34.23,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:35.06,0:23:40.90,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:41.53,0:23:46.32,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.82,0:23:51.75,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:23:54.58,0:24:00.07,Layzner,,0,0,0,,军人就算了 竟把地球的命运交给那些小鬼
Dialogue: 0,0:24:00.07,0:24:05.02,Layzner,,0,0,0,,那些孩子是为了要解决你们这些权利者愚蠢的行为
Dialogue: 0,0:24:05.02,0:24:05.91,Layzner,,0,0,0,,拼命一搏吧
Dialogue: 0,0:24:05.91,0:24:07.91,Layzner,,0,0,0,,下一集 化为光影的英二

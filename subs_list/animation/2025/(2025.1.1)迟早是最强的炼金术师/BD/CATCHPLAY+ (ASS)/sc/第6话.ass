Dialogue: 0,0:00:02.38,0:00:05.75,Default,,0,0,0,,巴奇拉王国利用净化魔导具
Dialogue: 0,0:00:05.75,0:00:08.42,Default,,0,0,0,,净化下水道的传闻
Dialogue: 0,0:00:08.42,0:00:10.84,Default,,0,0,0,,已经传进希德尼亚
Dialogue: 0,0:00:11.26,0:00:12.76,Default,,0,0,0,,关于此事
Dialogue: 0,0:00:12.76,0:00:14.60,Default,,0,0,0,,神光教会
Dialogue: 0,0:00:14.60,0:00:18.31,Default,,0,0,0,,已向希德尼亚神皇国教皇提出申诉
Dialogue: 0,0:00:18.89,0:00:21.15,Default,,0,0,0,,毕竟光属性魔法
Dialogue: 0,0:00:21.15,0:00:24.02,Default,,0,0,0,,原本就是神赐予神光教会之物
Dialogue: 0,0:00:24.65,0:00:27.40,Default,,0,0,0,,因此净化魔法
Dialogue: 0,0:00:27.40,0:00:30.40,Default,,0,0,0,,应当归属于神光教会所有
Dialogue: 0,0:00:30.40,0:00:31.49,Default,,0,0,0,,所以呢
Dialogue: 0,0:00:33.20,0:00:35.99,Default,,0,0,0,,应立即将净化魔法阵与专利
Dialogue: 0,0:00:35.99,0:00:38.79,Default,,0,0,0,,移交给教会才是
Dialogue: 0,0:00:39.96,0:00:42.58,Default,,0,0,0,,既然是神所赐予的力量
Dialogue: 0,0:00:43.00,0:00:46.63,Default,,0,0,0,,教会自行创造净化魔法阵即可
Dialogue: 0,0:00:47.71,0:00:50.59,Default,,0,0,0,,关于此事教皇认为
Dialogue: 0,0:00:50.59,0:00:52.55,Default,,0,0,0,,将神圣的净化魔法
Dialogue: 0,0:00:52.55,0:00:54.55,Default,,0,0,0,,作为马桶的魔导具使用
Dialogue: 0,0:00:54.55,0:00:55.97,Default,,0,0,0,,实在荒唐
Dialogue: 0,0:00:56.22,0:00:57.18,Default,,0,0,0,,所以他下令
Dialogue: 0,0:00:57.18,0:00:59.48,Default,,0,0,0,,应尽快将引进净化魔导具之人
Dialogue: 0,0:00:59.48,0:01:04.61,Default,,0,0,0,,交给希德尼亚神皇国
Dialogue: 0,0:01:04.61,0:01:05.94,Default,,0,0,0,,恕难从命
Dialogue: 0,0:01:06.98,0:01:09.32,Default,,0,0,0,,教皇正考虑是否要召回
Dialogue: 0,0:01:09.32,0:01:14.78,Default,,0,0,0,,派驻在巴奇拉王国的神光教会神官
Dialogue: 0,0:01:14.78,0:01:17.99,Default,,0,0,0,,那就麻烦教皇召回吧
Dialogue: 0,0:01:19.75,0:01:23.04,Default,,0,0,0,,我国完全不介意
Dialogue: 0,0:01:31.84,0:01:37.14,Default,,0,0,0,,（迟早是最强的炼金术师？）
Dialogue: 0,0:01:41.98,0:01:47.27,Default,,0,0,0,,从道歉开始的 咦？ 是常有的事？
Dialogue: 0,0:01:47.27,0:01:52.24,Default,,0,0,0,,将印象拼凑起来 我的故事开始倒数
Dialogue: 0,0:01:52.24,0:01:54.57,Default,,0,0,0,,（拜托）女神大人（是的）
Dialogue: 0,0:01:54.57,0:01:57.78,Default,,0,0,0,,意外也能成机会（换个角度）
Dialogue: 0,0:01:57.78,0:02:02.20,Default,,0,0,0,,（冒险啊 没错总有一天） 冒险者啊 逆风迟早会成顺风
Dialogue: 0,0:02:02.20,0:02:05.33,Default,,0,0,0,,一个人不如两个人的心跳
Dialogue: 0,0:02:05.33,0:02:07.96,Default,,0,0,0,,然后大家一起更是心动
Dialogue: 0,0:02:07.96,0:02:11.26,Default,,0,0,0,,可能性应该就在手里
Dialogue: 0,0:02:11.26,0:02:13.67,Default,,0,0,0,,（确实存在 充满愿望）
Dialogue: 0,0:02:13.67,0:02:16.26,Default,,0,0,0,,试试看吧
Dialogue: 0,0:02:16.26,0:02:20.89,Default,,0,0,0,,什么事情都有可能 因为我们是自由的
Dialogue: 0,0:02:20.89,0:02:23.81,Default,,0,0,0,,感到迷惘是很棒的事情
Dialogue: 0,0:02:23.81,0:02:26.77,Default,,0,0,0,,一连串的选择
Dialogue: 0,0:02:26.77,0:02:31.57,Default,,0,0,0,,欢声笑语中增加的纽带 如同树枝延展
Dialogue: 0,0:02:31.57,0:02:34.36,Default,,0,0,0,,相遇与邂逅 重逢的誓言
Dialogue: 0,0:02:34.36,0:02:37.49,Default,,0,0,0,,那些全都是宝物
Dialogue: 0,0:02:37.49,0:02:41.87,Default,,0,0,0,,（全是宝物追过时间奔向明天） 超越时间奔向明天
Dialogue: 0,0:02:41.87,0:02:47.46,Default,,0,0,0,,前进 前进 前进
Dialogue: 0,0:02:55.84,0:02:58.22,Default,,0,0,0,,（第六话 龙马出现） 真的不会有问题吗
Dialogue: 0,0:02:58.22,0:03:00.05,Default,,0,0,0,,（第六话 龙马出现） 对希德尼亚的使者
Dialogue: 0,0:03:00.05,0:03:02.39,Default,,0,0,0,,采取那么强势的态度
Dialogue: 0,0:03:02.64,0:03:04.47,Default,,0,0,0,,完全没问题
Dialogue: 0,0:03:04.77,0:03:08.23,Default,,0,0,0,,这么做不会和教会反目成仇吗
Dialogue: 0,0:03:08.23,0:03:12.98,Default,,0,0,0,,巧先生您来自乡下 所以可能不清楚
Dialogue: 0,0:03:12.98,0:03:14.32,Default,,0,0,0,,这个国家
Dialogue: 0,0:03:14.32,0:03:17.40,Default,,0,0,0,,除了神光教外还有其他的信仰
Dialogue: 0,0:03:18.57,0:03:21.20,Default,,0,0,0,,创世教对吧
Dialogue: 0,0:03:21.20,0:03:22.99,Default,,0,0,0,,没想到您如此清楚啊
Dialogue: 0,0:03:22.99,0:03:26.87,Default,,0,0,0,,确实是以信奉 女神诺纶大人为主神的创世教
Dialogue: 0,0:03:26.87,0:03:31.71,Default,,0,0,0,,既然创世教的主神是诺纶大人
Dialogue: 0,0:03:31.71,0:03:34.46,Default,,0,0,0,,神光教的主神又是哪一位
Dialogue: 0,0:03:34.71,0:03:38.43,Default,,0,0,0,,我记得是叫亚娜托
Dialogue: 0,0:03:38.68,0:03:40.01,Default,,0,0,0,,亚娜托
Dialogue: 0,0:03:40.01,0:03:41.39,Default,,0,0,0,,先不说这件事了
Dialogue: 0,0:03:41.39,0:03:44.89,Default,,0,0,0,,在巴奇拉王国境内 信仰自由受到保障
Dialogue: 0,0:03:44.89,0:03:48.52,Default,,0,0,0,,历史悠久的创世教的信徒也很多
Dialogue: 0,0:03:48.81,0:03:51.36,Default,,0,0,0,,最重要的是创世教的神官
Dialogue: 0,0:03:51.36,0:03:52.94,Default,,0,0,0,,只要聊表一点心意
Dialogue: 0,0:03:52.94,0:03:55.61,Default,,0,0,0,,就愿意为人施加回复魔法
Dialogue: 0,0:03:55.94,0:03:58.65,Default,,0,0,0,,相反的神光教的神官
Dialogue: 0,0:03:58.65,0:04:01.53,Default,,0,0,0,,要收取高额谢礼才肯办事对吗
Dialogue: 0,0:04:01.53,0:04:02.32,Default,,0,0,0,,是的
Dialogue: 0,0:04:02.66,0:04:05.91,Default,,0,0,0,,而以神光教监管者自居的
Dialogue: 0,0:04:05.91,0:04:08.04,Default,,0,0,0,,就是希德尼亚神皇国吧
Dialogue: 0,0:04:08.04,0:04:11.25,Default,,0,0,0,,-我今天登门拜访 -看来我最好别跟它牵扯上
Dialogue: 0,0:04:11.25,0:04:14.17,Default,,0,0,0,,是有事情要麻烦巧先生
Dialogue: 0,0:04:14.71,0:04:15.67,Default,,0,0,0,,有事要麻烦我
Dialogue: 0,0:04:15.88,0:04:16.88,Default,,0,0,0,,那个…
Dialogue: 0,0:04:16.88,0:04:20.43,Default,,0,0,0,,我们通过领主戈德文藩侯大人
Dialogue: 0,0:04:20.43,0:04:23.01,Default,,0,0,0,,将马桶 净化魔导具以及冰箱
Dialogue: 0,0:04:23.01,0:04:25.76,Default,,0,0,0,,进贡给国王陛下
Dialogue: 0,0:04:25.97,0:04:27.43,Default,,0,0,0,,所以说…
Dialogue: 0,0:04:28.27,0:04:30.98,Default,,0,0,0,,由于国王陛下想见您一面
Dialogue: 0,0:04:30.98,0:04:34.06,Default,,0,0,0,,下令藩侯大人和我带您前去觐见
Dialogue: 0,0:04:34.15,0:04:36.07,Default,,0,0,0,,请等一下
Dialogue: 0,0:04:36.07,0:04:38.19,Default,,0,0,0,,当然如果您拒绝的话
Dialogue: 0,0:04:38.19,0:04:41.15,Default,,0,0,0,,应该不至于触怒国王陛下
Dialogue: 0,0:04:41.32,0:04:44.74,Default,,0,0,0,,请巧先生顺从心里的想法就好
Dialogue: 0,0:04:44.95,0:04:46.66,Default,,0,0,0,,巴奇拉托斯？
Dialogue: 0,0:04:46.66,0:04:48.70,Default,,0,0,0,,您要去王都吗
Dialogue: 0,0:04:49.96,0:04:53.17,Default,,0,0,0,,国王陛下保护我免除了
Dialogue: 0,0:04:53.17,0:04:55.54,Default,,0,0,0,,希德尼亚神皇国的干涉
Dialogue: 0,0:04:55.79,0:04:58.46,Default,,0,0,0,,如果拒绝了恐怕会很失礼
Dialogue: 0,0:04:58.46,0:05:01.17,Default,,0,0,0,,你们可以和我一起去吗
Dialogue: 0,0:05:01.17,0:05:02.38,Default,,0,0,0,,当然没问题
Dialogue: 0,0:05:02.38,0:05:05.35,Default,,0,0,0,,这是我第一次去王都
Dialogue: 0,0:05:05.35,0:05:07.93,Default,,0,0,0,,苏菲亚小姐去过王都吗
Dialogue: 0,0:05:07.93,0:05:08.85,Default,,0,0,0,,没有
Dialogue: 0,0:05:08.85,0:05:10.27,Default,,0,0,0,,我也是第一次
Dialogue: 0,0:05:10.48,0:05:12.77,Default,,0,0,0,,枫也是第一次
Dialogue: 0,0:05:13.35,0:05:15.44,Default,,0,0,0,,一周后出发
Dialogue: 0,0:05:15.44,0:05:18.61,Default,,0,0,0,,出发前得做好各种准备才行
Dialogue: 0,0:05:18.98,0:05:21.86,Default,,0,0,0,,到王都需要多久时间啊
Dialogue: 0,0:05:21.86,0:05:23.49,Default,,0,0,0,,坐魔马马车的话
Dialogue: 0,0:05:23.49,0:05:24.95,Default,,0,0,0,,听说要花七天左右
Dialogue: 0,0:05:24.95,0:05:25.99,Default,,0,0,0,,这样的话
Dialogue: 0,0:05:25.99,0:05:29.45,Default,,0,0,0,,得准备大量的食材才行
Dialogue: 0,0:05:29.91,0:05:31.54,Default,,0,0,0,,那就都交给玛莉亚负责吧
Dialogue: 0,0:05:32.50,0:05:35.04,Default,,0,0,0,,请放心把所有家事交给我
Dialogue: 0,0:05:35.04,0:05:38.84,Default,,0,0,0,,还有我想帮你们制作新的外套
Dialogue: 0,0:05:38.84,0:05:40.88,Default,,0,0,0,,外套吗
Dialogue: 0,0:05:41.63,0:05:42.84,Default,,0,0,0,,我跟帕佩克先生
Dialogue: 0,0:05:42.84,0:05:45.84,Default,,0,0,0,,订购了暗属性的魔石
Dialogue: 0,0:05:46.22,0:05:47.14,Default,,0,0,0,,有了它
Dialogue: 0,0:05:47.14,0:05:49.93,Default,,0,0,0,,应该就能赋予"识别阻碍"的机能
Dialogue: 0,0:05:50.18,0:05:52.14,Default,,0,0,0,,识别阻碍
Dialogue: 0,0:05:52.14,0:05:54.64,Default,,0,0,0,,的确在战斗中很有用
Dialogue: 0,0:05:55.40,0:05:57.77,Default,,0,0,0,,而且穿上外套走在城中
Dialogue: 0,0:05:57.77,0:05:59.11,Default,,0,0,0,,苏菲亚和玛莉亚
Dialogue: 0,0:05:59.11,0:06:02.19,Default,,0,0,0,,应该也能避免被怪人骚扰
Dialogue: 0,0:06:02.94,0:06:04.78,Default,,0,0,0,,话说回来
Dialogue: 0,0:06:04.78,0:06:08.74,Default,,0,0,0,,总觉得巧先生对自己的评价过低了
Dialogue: 0,0:06:08.74,0:06:10.29,Default,,0,0,0,,我也有同感
Dialogue: 0,0:06:10.29,0:06:11.66,Default,,0,0,0,,外貌就不用说
Dialogue: 0,0:06:11.66,0:06:13.87,Default,,0,0,0,,在生产职业中的才能
Dialogue: 0,0:06:13.87,0:06:15.42,Default,,0,0,0,,以及高超实力
Dialogue: 0,0:06:15.42,0:06:17.13,Default,,0,0,0,,再加上他的为人
Dialogue: 0,0:06:17.96,0:06:18.88,Default,,0,0,0,,怎么了
Dialogue: 0,0:06:21.76,0:06:23.42,Default,,0,0,0,,我…我只是在表达
Dialogue: 0,0:06:23.42,0:06:25.93,Default,,0,0,0,,他身为主人是多么的优秀
Dialogue: 0,0:06:26.43,0:06:28.39,Default,,0,0,0,,原来如此原来如此
Dialogue: 0,0:06:28.39,0:06:29.30,Default,,0,0,0,,快看
Dialogue: 0,0:06:29.30,0:06:32.18,Default,,0,0,0,,那边有卖黑野牛的肉
Dialogue: 0,0:06:32.43,0:06:35.77,Default,,0,0,0,,索菲亚小姐好少女哦
Dialogue: 0,0:06:43.36,0:06:46.53,Default,,0,0,0,,供品呢
Dialogue: 0,0:06:48.32,0:06:49.57,Default,,0,0,0,,诺纶大人
Dialogue: 0,0:06:49.57,0:06:51.33,Default,,0,0,0,,哈啰 阿巧
Dialogue: 0,0:06:51.33,0:06:52.62,Default,,0,0,0,,好几天没见了
Dialogue: 0,0:06:52.62,0:06:54.66,Default,,0,0,0,,听说你要去王都啊
Dialogue: 0,0:06:54.66,0:06:57.17,Default,,0,0,0,,是来祈求旅途平安的吗
Dialogue: 0,0:06:57.46,0:07:00.09,Default,,0,0,0,,你没带供品来吗
Dialogue: 0,0:07:00.09,0:07:01.80,Default,,0,0,0,,我有问题要问
Dialogue: 0,0:07:02.42,0:07:05.72,Default,,0,0,0,,神光教的主神是叫亚娜托吧
Dialogue: 0,0:07:05.72,0:07:06.76,Default,,0,0,0,,是啊
Dialogue: 0,0:07:06.97,0:07:09.72,Default,,0,0,0,,那位亚娜托大人
Dialogue: 0,0:07:09.72,0:07:12.60,Default,,0,0,0,,和诺纶大人是不同的女神吗
Dialogue: 0,0:07:13.89,0:07:15.93,Default,,0,0,0,,女神只有我一个
Dialogue: 0,0:07:15.93,0:07:18.10,Default,,0,0,0,,那么亚娜托是…
Dialogue: 0,0:07:18.44,0:07:21.15,Default,,0,0,0,,不久之后你就会知道了
Dialogue: 0,0:07:21.31,0:07:22.52,Default,,0,0,0,,不久之后是指…
Dialogue: 0,0:07:22.52,0:07:24.86,Default,,0,0,0,,怎么了？ 你这么想知道啊
Dialogue: 0,0:07:25.44,0:07:31.45,Default,,0,0,0,,最近希德尼亚神皇国好像离我越来越近了
Dialogue: 0,0:07:31.66,0:07:34.04,Default,,0,0,0,,之前诺纶大人也说过吧
Dialogue: 0,0:07:34.04,0:07:35.25,Default,,0,0,0,,因为我做的决定
Dialogue: 0,0:07:35.25,0:07:37.71,Default,,0,0,0,,将导致一部分的加护失效
Dialogue: 0,0:07:38.25,0:07:40.42,Default,,0,0,0,,该不会希德尼亚的干涉
Dialogue: 0,0:07:40.42,0:07:41.92,Default,,0,0,0,,也是因为加护失效的关系
Dialogue: 0,0:07:41.92,0:07:43.34,Default,,0,0,0,,才不是呢
Dialogue: 0,0:07:43.34,0:07:46.34,Default,,0,0,0,,说到底阿巧来到米鲁多嘉鲁多的原因
Dialogue: 0,0:07:46.34,0:07:48.13,Default,,0,0,0,,就是出自于希德尼亚
Dialogue: 0,0:07:48.13,0:07:50.55,Default,,0,0,0,,和加护是不同次元的问题
Dialogue: 0,0:07:50.80,0:07:52.30,Default,,0,0,0,,这样啊
Dialogue: 0,0:07:52.97,0:07:55.89,Default,,0,0,0,,那么被召唤去希德尼亚的勇者
Dialogue: 0,0:07:55.89,0:07:57.27,Default,,0,0,0,,现在怎么样了
Dialogue: 0,0:07:57.43,0:08:00.44,Default,,0,0,0,,照理说应该会造成很大的骚动
Dialogue: 0,0:08:00.94,0:08:04.02,Default,,0,0,0,,其实把你送走的时候
Dialogue: 0,0:08:04.02,0:08:06.28,Default,,0,0,0,,我对时间轴动了一点手脚
Dialogue: 0,0:08:06.28,0:08:09.24,Default,,0,0,0,,把你送到了召唤勇者的一年之前
Dialogue: 0,0:08:10.41,0:08:13.41,Default,,0,0,0,,那现在勇者还没有被召唤吗
Dialogue: 0,0:08:14.20,0:08:16.45,Default,,0,0,0,,应该还要过好几个月之后吧
Dialogue: 0,0:08:16.45,0:08:17.62,Default,,0,0,0,,请等一下
Dialogue: 0,0:08:17.62,0:08:20.21,Default,,0,0,0,,为什么要刻意送我到一年前
Dialogue: 0,0:08:20.21,0:08:22.00,Default,,0,0,0,,时间到了 入间
Dialogue: 0,0:08:22.00,0:08:24.92,Default,,0,0,0,,这里又不是监狱的会客室
Dialogue: 0,0:08:25.30,0:08:26.80,Default,,0,0,0,,那我们下次见
Dialogue: 0,0:08:26.80,0:08:28.80,Default,,0,0,0,,麻烦记得带供品来哦
Dialogue: 0,0:08:28.80,0:08:30.51,Default,,0,0,0,,最好是甜食
Dialogue: 0,0:08:30.80,0:08:33.85,Default,,0,0,0,,不是 您还没有回答我
Dialogue: 0,0:08:38.68,0:08:42.23,Default,,0,0,0,,感觉女神好像急着摆脱我
Dialogue: 0,0:08:42.52,0:08:46.15,Default,,0,0,0,,反正我也遇不到勇者
Dialogue: 0,0:08:46.15,0:08:47.36,Default,,0,0,0,,不关我的事
Dialogue: 0,0:08:47.82,0:08:49.82,Default,,0,0,0,,（希德尼亚神皇国 巧所在的时间的十个月后）
Dialogue: 0,0:08:49.82,0:08:51.91,Default,,0,0,0,,非常好 飞鸟大人 （希德尼亚神皇国 巧所在的时间的十个月后）
Dialogue: 0,0:08:53.95,0:08:55.49,Default,,0,0,0,,了不起
Dialogue: 0,0:08:55.49,0:08:56.79,Default,,0,0,0,,要是稍有迟疑
Dialogue: 0,0:08:56.79,0:09:00.04,Default,,0,0,0,,我帕卡德就会当场没命
Dialogue: 0,0:09:00.04,0:09:02.04,Default,,0,0,0,,真会奉承人呢
Dialogue: 0,0:09:02.25,0:09:03.63,Default,,0,0,0,,不不
Dialogue: 0,0:09:03.63,0:09:06.42,Default,,0,0,0,,这几周以来飞鸟大人的成长
Dialogue: 0,0:09:06.42,0:09:08.80,Default,,0,0,0,,真叫我瞠目结舌
Dialogue: 0,0:09:18.52,0:09:20.06,Default,,0,0,0,,和主人同款
Dialogue: 0,0:09:20.06,0:09:22.69,Default,,0,0,0,,我感到十分惶恐
Dialogue: 0,0:09:23.02,0:09:25.90,Default,,0,0,0,,奇怪了 这设计你不喜欢吗
Dialogue: 0,0:09:25.90,0:09:26.90,Default,,0,0,0,,不是的
Dialogue: 0,0:09:26.90,0:09:28.36,Default,,0,0,0,,我岂敢不喜欢
Dialogue: 0,0:09:28.36,0:09:29.61,Default,,0,0,0,,很漂亮
Dialogue: 0,0:09:29.90,0:09:31.57,Default,,0,0,0,,那就好
Dialogue: 0,0:09:31.57,0:09:34.16,Default,,0,0,0,,你们不管穿什么都很好看
Dialogue: 0,0:09:34.86,0:09:36.91,Default,,0,0,0,,哪有哪有 您过奖了
Dialogue: 0,0:09:38.66,0:09:41.20,Default,,0,0,0,,难道我又说了不恰当的话吗
Dialogue: 0,0:09:44.04,0:09:46.79,Default,,0,0,0,,您要建造马车吗
Dialogue: 0,0:09:46.79,0:09:49.13,Default,,0,0,0,,考虑到使用期间比较长
Dialogue: 0,0:09:49.13,0:09:50.21,Default,,0,0,0,,与其租借马车
Dialogue: 0,0:09:50.21,0:09:53.68,Default,,0,0,0,,不如自己造一辆舒服的马车更好
Dialogue: 0,0:09:54.01,0:09:55.51,Default,,0,0,0,,马车只要造出来就可以了
Dialogue: 0,0:09:55.51,0:09:57.26,Default,,0,0,0,,问题是魔马的取得
Dialogue: 0,0:09:57.26,0:09:59.64,Default,,0,0,0,,看来只能向公会借了
Dialogue: 0,0:10:01.60,0:10:02.81,Default,,0,0,0,,巧先生
Dialogue: 0,0:10:02.81,0:10:06.23,Default,,0,0,0,,波鲁顿为何被称为冒险者之城
Dialogue: 0,0:10:06.23,0:10:08.36,Default,,0,0,0,,您知道理由吗
Dialogue: 0,0:10:08.69,0:10:09.36,Default,,0,0,0,,不知道
Dialogue: 0,0:10:09.36,0:10:12.69,Default,,0,0,0,,老实说这称号我还是第一次听到
Dialogue: 0,0:10:15.86,0:10:17.82,Default,,0,0,0,,巧先生明明不知道
Dialogue: 0,0:10:17.82,0:10:20.83,Default,,0,0,0,,却以他知道为前提说个不停
Dialogue: 0,0:10:21.24,0:10:22.37,Default,,0,0,0,,我这个人根本就跟
Dialogue: 0,0:10:22.37,0:10:25.92,Default,,0,0,0,,假冒冰箱的冰冷马桶一样
Dialogue: 0,0:10:26.33,0:10:28.25,Default,,0,0,0,,又拿马桶来做比喻
Dialogue: 0,0:10:28.50,0:10:30.63,Default,,0,0,0,,那…为什么会有这个称号啊
Dialogue: 0,0:10:30.63,0:10:32.21,Default,,0,0,0,,波鲁顿的周围
Dialogue: 0,0:10:32.21,0:10:33.51,Default,,0,0,0,,以死亡之森为首
Dialogue: 0,0:10:33.51,0:10:35.93,Default,,0,0,0,,有很多魔物的栖息地
Dialogue: 0,0:10:36.18,0:10:37.55,Default,,0,0,0,,在魔物之中
Dialogue: 0,0:10:37.55,0:10:39.51,Default,,0,0,0,,比魔马速度还快力量更强的
Dialogue: 0,0:10:39.51,0:10:43.39,Default,,0,0,0,,独角马 龙马还有狮鹫 听说都在这附近栖息
Dialogue: 0,0:10:53.49,0:10:56.78,Default,,0,0,0,,龙马跟魔马比起来速度还要快很多吗
Dialogue: 0,0:10:56.78,0:10:57.66,Default,,0,0,0,,是的
Dialogue: 0,0:10:57.66,0:10:59.74,Default,,0,0,0,,在速度和体力上
Dialogue: 0,0:10:59.74,0:11:02.41,Default,,0,0,0,,都遥遥领先魔马而且很强壮
Dialogue: 0,0:11:02.41,0:11:05.21,Default,,0,0,0,,因为它是龙类的魔物吧
Dialogue: 0,0:11:05.46,0:11:06.21,Default,,0,0,0,,不是的
Dialogue: 0,0:11:06.21,0:11:07.42,Default,,0,0,0,,龙马不是龙类
Dialogue: 0,0:11:07.42,0:11:09.67,Default,,0,0,0,,外观看起来与马更相近
Dialogue: 0,0:11:09.88,0:11:12.13,Default,,0,0,0,,它与马最关键的差异
Dialogue: 0,0:11:12.13,0:11:13.76,Default,,0,0,0,,在于如犀牛般的角
Dialogue: 0,0:11:13.76,0:11:17.51,Default,,0,0,0,,还有身体像龙一样被鳞片覆盖
Dialogue: 0,0:11:17.93,0:11:19.14,Default,,0,0,0,,原来如此
Dialogue: 0,0:11:19.14,0:11:20.51,Default,,0,0,0,,所以才会叫做龙马
Dialogue: 0,0:11:20.51,0:11:21.97,Default,,0,0,0,,主人
Dialogue: 0,0:11:21.97,0:11:26.48,Default,,0,0,0,,苏菲亚姐 玛利亚 快点快点
Dialogue: 0,0:11:26.89,0:11:28.98,Default,,0,0,0,,枫真是干劲十足呢
Dialogue: 0,0:11:28.98,0:11:31.27,Default,,0,0,0,,该不会是就快要有后辈了
Dialogue: 0,0:11:31.27,0:11:32.61,Default,,0,0,0,,所以才那么高兴
Dialogue: 0,0:11:33.86,0:11:35.11,Default,,0,0,0,,枫前辈
Dialogue: 0,0:11:35.11,0:11:38.15,Default,,0,0,0,,不是有我这个后辈了吗
Dialogue: 0,0:11:41.78,0:11:42.95,Default,,0,0,0,,是草狼
Dialogue: 0,0:11:45.75,0:11:47.16,Default,,0,0,0,,走掉了
Dialogue: 0,0:11:47.16,0:11:49.67,Default,,0,0,0,,是外套识别阻碍的效果
Dialogue: 0,0:11:49.92,0:11:52.42,Default,,0,0,0,,能够混淆草狼的嗅觉
Dialogue: 0,0:11:52.42,0:11:54.55,Default,,0,0,0,,这件外套真好用
Dialogue: 0,0:11:55.17,0:11:56.67,Default,,0,0,0,,您说得没错
Dialogue: 0,0:11:56.67,0:11:57.72,Default,,0,0,0,,可是
Dialogue: 0,0:11:59.26,0:12:01.05,Default,,0,0,0,,为了训练
Dialogue: 0,0:12:01.05,0:12:04.51,Default,,0,0,0,,也许也要脱下外套战斗才行
Dialogue: 0,0:12:05.85,0:12:08.48,Default,,0,0,0,,又触碰到她身上奇怪的开关了
Dialogue: 0,0:12:12.69,0:12:13.90,Default,,0,0,0,,好厉害
Dialogue: 0,0:12:13.90,0:12:15.07,Default,,0,0,0,,只用了一击
Dialogue: 0,0:12:15.07,0:12:17.32,Default,,0,0,0,,得到追加的肉品了
Dialogue: 0,0:12:17.32,0:12:21.03,Default,,0,0,0,,这样就能制作很多容易保存的肉干
Dialogue: 0,0:12:21.03,0:12:23.16,Default,,0,0,0,,快点走啦
Dialogue: 0,0:12:25.58,0:12:27.16,Default,,0,0,0,,是树精
Dialogue: 0,0:12:27.16,0:12:28.62,Default,,0,0,0,,已经死了
Dialogue: 0,0:12:28.62,0:12:31.46,Default,,0,0,0,,这个可以带走吧
Dialogue: 0,0:12:31.96,0:12:35.04,Default,,0,0,0,,建造马车需要树精木材
Dialogue: 0,0:12:35.04,0:12:37.88,Default,,0,0,0,,本来想跟帕佩可先生买的
Dialogue: 0,0:12:38.21,0:12:39.47,Default,,0,0,0,,只要有了这些
Dialogue: 0,0:12:39.47,0:12:42.34,Default,,0,0,0,,就等于有一辆马车所需的木材了
Dialogue: 0,0:12:42.34,0:12:43.64,Default,,0,0,0,,我来帮忙
Dialogue: 0,0:12:43.64,0:12:45.47,Default,,0,0,0,,主人
Dialogue: 0,0:12:45.68,0:12:47.93,Default,,0,0,0,,肉 肉…
Dialogue: 0,0:12:47.93,0:12:52.10,Default,,0,0,0,,木材 木材…
Dialogue: 0,0:12:52.40,0:12:55.48,Default,,0,0,0,,真是的 我先走了哦
Dialogue: 0,0:13:00.99,0:13:04.82,Default,,0,0,0,,倒下了好多只木头妖怪
Dialogue: 0,0:13:06.20,0:13:07.49,Default,,0,0,0,,好像有什么
Dialogue: 0,0:13:23.38,0:13:26.35,Default,,0,0,0,,你…受伤了吗
Dialogue: 0,0:13:47.49,0:13:51.37,Default,,0,0,0,,枫有个非常好的主人哦
Dialogue: 0,0:13:51.66,0:13:53.37,Default,,0,0,0,,他会治好你的
Dialogue: 0,0:13:59.42,0:14:01.21,Default,,0,0,0,,你是被这两个家伙弄伤的吗
Dialogue: 0,0:14:08.10,0:14:09.35,Default,,0,0,0,,你等等
Dialogue: 0,0:14:09.35,0:14:10.89,Default,,0,0,0,,我去叫主人来
Dialogue: 0,0:14:12.48,0:14:14.64,Default,,0,0,0,,别过来
Dialogue: 0,0:14:29.58,0:14:31.83,Default,,0,0,0,,主人 主人
Dialogue: 0,0:14:34.33,0:14:36.62,Default,,0,0,0,,为什么不回答我
Dialogue: 0,0:14:37.25,0:14:38.46,Default,,0,0,0,,主人
Dialogue: 0,0:14:38.46,0:14:40.30,Default,,0,0,0,,心里只有木头
Dialogue: 0,0:14:41.09,0:14:42.26,Default,,0,0,0,,大家…
Dialogue: 0,0:14:42.26,0:14:43.38,Default,,0,0,0,,大家…
Dialogue: 0,0:14:43.38,0:14:48.60,Default,,0,0,0,,一定是忘记枫 回家去了
Dialogue: 0,0:15:01.11,0:15:02.53,Default,,0,0,0,,主人
Dialogue: 0,0:15:03.78,0:15:07.49,Default,,0,0,0,,主人…是笨蛋
Dialogue: 0,0:15:07.86,0:15:10.58,Default,,0,0,0,,大笨蛋主人
Dialogue: 0,0:15:14.50,0:15:16.96,Default,,0,0,0,,我撑不下去了
Dialogue: 0,0:15:27.47,0:15:28.89,Default,,0,0,0,,主人
Dialogue: 0,0:15:28.89,0:15:29.80,Default,,0,0,0,,枫
Dialogue: 0,0:15:30.76,0:15:33.14,Default,,0,0,0,,主人
Dialogue: 0,0:15:34.22,0:15:35.77,Default,,0,0,0,,你真的做得很好了
Dialogue: 0,0:15:36.48,0:15:38.60,Default,,0,0,0,,主人
Dialogue: 0,0:15:38.60,0:15:39.90,Default,,0,0,0,,幸好你平安无事
Dialogue: 0,0:15:39.90,0:15:41.31,Default,,0,0,0,,枫前辈
Dialogue: 0,0:15:41.56,0:15:44.23,Default,,0,0,0,,我明明叫了你们
Dialogue: 0,0:15:44.23,0:15:46.86,Default,,0,0,0,,我明明叫了主人
Dialogue: 0,0:15:46.86,0:15:47.78,Default,,0,0,0,,对不起
Dialogue: 0,0:15:48.45,0:15:49.70,Default,,0,0,0,,是因为这个
Dialogue: 0,0:15:49.70,0:15:52.12,Default,,0,0,0,,这个层层堆叠的丝线
Dialogue: 0,0:15:52.12,0:15:53.95,Default,,0,0,0,,在提供强大保护力的同时
Dialogue: 0,0:15:53.95,0:15:56.41,Default,,0,0,0,,好像也遮蔽了魔力
Dialogue: 0,0:15:56.41,0:15:58.71,Default,,0,0,0,,跟你的魔力连结突然中断的同时
Dialogue: 0,0:15:58.71,0:16:00.17,Default,,0,0,0,,就想说会不会出事了
Dialogue: 0,0:16:00.17,0:16:02.04,Default,,0,0,0,,于是追着魔力的残渣赶过来了
Dialogue: 0,0:16:03.09,0:16:04.42,Default,,0,0,0,,我来晚 对不起
Dialogue: 0,0:16:04.42,0:16:05.76,Default,,0,0,0,,很害怕吧
Dialogue: 0,0:16:05.76,0:16:07.88,Default,,0,0,0,,主人
Dialogue: 0,0:16:07.88,0:16:10.47,Default,,0,0,0,,这孩子…是龙马
Dialogue: 0,0:16:10.47,0:16:13.01,Default,,0,0,0,,而且还是麒麟龙马对吧
Dialogue: 0,0:16:13.01,0:16:15.10,Default,,0,0,0,,好严重的伤势 它昏迷了
Dialogue: 0,0:16:15.72,0:16:17.89,Default,,0,0,0,,求求主人
Dialogue: 0,0:16:17.89,0:16:20.02,Default,,0,0,0,,救救这孩子
Dialogue: 0,0:16:20.02,0:16:23.48,Default,,0,0,0,,原来是你保护了这孩子啊
Dialogue: 0,0:16:23.48,0:16:24.44,Default,,0,0,0,,我知道了
Dialogue: 0,0:16:28.36,0:16:29.53,Default,,0,0,0,,魔法被弹开了
Dialogue: 0,0:16:29.53,0:16:31.03,Default,,0,0,0,,也许就算昏迷
Dialogue: 0,0:16:31.03,0:16:33.37,Default,,0,0,0,,它也还保持着警戒
Dialogue: 0,0:16:33.37,0:16:36.12,Default,,0,0,0,,这样会死掉的
Dialogue: 0,0:16:36.91,0:16:39.08,Default,,0,0,0,,魔物的气息正在接近中
Dialogue: 0,0:16:39.08,0:16:40.54,Default,,0,0,0,,继续逗留下去会有危险
Dialogue: 0,0:16:40.54,0:16:41.54,Default,,0,0,0,,主人
Dialogue: 0,0:16:41.54,0:16:43.17,Default,,0,0,0,,不要丢下这孩子不管
Dialogue: 0,0:16:43.17,0:16:44.13,Default,,0,0,0,,拜托你
Dialogue: 0,0:16:44.13,0:16:45.09,Default,,0,0,0,,放心
Dialogue: 0,0:16:45.09,0:16:46.46,Default,,0,0,0,,我怎么会丢下它不管
Dialogue: 0,0:16:48.55,0:16:50.76,Default,,0,0,0,,难道您要让它进入亚空间
Dialogue: 0,0:16:50.76,0:16:52.55,Default,,0,0,0,,枫 在我叫你之前
Dialogue: 0,0:16:52.55,0:16:53.76,Default,,0,0,0,,就先陪在它身边
Dialogue: 0,0:16:56.76,0:16:58.06,Default,,0,0,0,,太乱来了
Dialogue: 0,0:16:58.06,0:17:01.64,Default,,0,0,0,,让没有缔结 从魔契约的高等魔物进入亚空间
Dialogue: 0,0:17:01.64,0:17:03.86,Default,,0,0,0,,这样会对巧先生的身体
Dialogue: 0,0:17:03.86,0:17:05.61,Default,,0,0,0,,造成剧烈的负担
Dialogue: 0,0:17:06.73,0:17:08.15,Default,,0,0,0,,没关系
Dialogue: 0,0:17:08.15,0:17:10.24,Default,,0,0,0,,我…没事
Dialogue: 0,0:17:11.20,0:17:13.24,Default,,0,0,0,,我喝瓶药水
Dialogue: 0,0:17:13.91,0:17:17.12,Default,,0,0,0,,就能…回复了
Dialogue: 0,0:17:18.54,0:17:20.08,Default,,0,0,0,,巧先生
Dialogue: 0,0:17:22.75,0:17:26.00,Default,,0,0,0,,过了半天以上都还没有醒过来
Dialogue: 0,0:17:26.00,0:17:27.38,Default,,0,0,0,,这是当然的
Dialogue: 0,0:17:27.80,0:17:29.26,Default,,0,0,0,,就算巧先生在睡眠中
Dialogue: 0,0:17:29.26,0:17:32.84,Default,,0,0,0,,也是在高负荷的状态下维持着亚空间
Dialogue: 0,0:17:33.18,0:17:35.97,Default,,0,0,0,,枫前辈也一直没有出来
Dialogue: 0,0:17:35.97,0:17:39.35,Default,,0,0,0,,应该是没听到巧先生呼唤
Dialogue: 0,0:17:39.35,0:17:41.68,Default,,0,0,0,,而且龙马也还在害怕
Dialogue: 0,0:17:42.10,0:17:43.94,Default,,0,0,0,,枫不打开亚空间出来
Dialogue: 0,0:17:43.94,0:17:46.90,Default,,0,0,0,,龙马在亚空间里的状态就会持续下去
Dialogue: 0,0:17:46.90,0:17:49.57,Default,,0,0,0,,巧先生也会越来越衰弱
Dialogue: 0,0:17:50.57,0:17:52.28,Default,,0,0,0,,得想办法做点什么
Dialogue: 0,0:17:52.28,0:17:54.03,Default,,0,0,0,,有什么办法？
Dialogue: 0,0:17:54.03,0:17:56.12,Default,,0,0,0,,必须在情况变得无法收拾前
Dialogue: 0,0:17:59.62,0:18:01.16,Default,,0,0,0,,苏菲亚小姐
Dialogue: 0,0:18:01.95,0:18:04.00,Default,,0,0,0,,通过巧先生的魔力
Dialogue: 0,0:18:04.50,0:18:05.46,Default,,0,0,0,,枫
Dialogue: 0,0:18:07.25,0:18:09.88,Default,,0,0,0,,枫 听得到吗
Dialogue: 0,0:18:09.88,0:18:11.17,Default,,0,0,0,,枫
Dialogue: 0,0:18:11.17,0:18:12.63,Default,,0,0,0,,苏菲亚姐
Dialogue: 0,0:18:12.92,0:18:14.55,Default,,0,0,0,,那边情况怎么样了
Dialogue: 0,0:18:14.55,0:18:17.26,Default,,0,0,0,,这孩子还是很害怕
Dialogue: 0,0:18:17.64,0:18:19.47,Default,,0,0,0,,没办法带它从里面出来吗
Dialogue: 0,0:18:19.47,0:18:21.35,Default,,0,0,0,,可能是突然到了一个陌生的地方
Dialogue: 0,0:18:21.35,0:18:22.85,Default,,0,0,0,,还感到很混乱
Dialogue: 0,0:18:23.60,0:18:25.90,Default,,0,0,0,,可是如果它不出来
Dialogue: 0,0:18:25.90,0:18:27.56,Default,,0,0,0,,就没办法进行治疗
Dialogue: 0,0:18:27.56,0:18:30.40,Default,,0,0,0,,巧先生也会一直昏迷不醒
Dialogue: 0,0:18:31.69,0:18:33.19,Default,,0,0,0,,你能做出和森林一样的
Dialogue: 0,0:18:33.19,0:18:35.28,Default,,0,0,0,,丝线防护罩吗
Dialogue: 0,0:18:35.28,0:18:36.82,Default,,0,0,0,,如果能阻隔视野
Dialogue: 0,0:18:36.82,0:18:38.99,Default,,0,0,0,,应该能缓解龙马的不安
Dialogue: 0,0:18:40.83,0:18:42.08,Default,,0,0,0,,对哦
Dialogue: 0,0:18:42.08,0:18:43.33,Default,,0,0,0,,知道了
Dialogue: 0,0:18:44.41,0:18:45.71,Default,,0,0,0,,我尽力
Dialogue: 0,0:18:45.71,0:18:47.17,Default,,0,0,0,,那就先到院子去咯
Dialogue: 0,0:18:49.13,0:18:51.59,Default,,0,0,0,,苏菲亚小姐你要去哪里
Dialogue: 0,0:18:51.59,0:18:53.05,Default,,0,0,0,,帕佩克商会
Dialogue: 0,0:18:53.88,0:18:55.84,Default,,0,0,0,,我去买适合魔物的药草
Dialogue: 0,0:18:55.84,0:18:58.43,Default,,0,0,0,,跑腿的事请交给我
Dialogue: 0,0:18:58.68,0:19:00.01,Default,,0,0,0,,苏菲亚小姐
Dialogue: 0,0:19:00.01,0:19:02.56,Default,,0,0,0,,请留在巧先生身边
Dialogue: 0,0:19:02.56,0:19:04.48,Default,,0,0,0,,让他醒来就能看得到你
Dialogue: 0,0:19:04.48,0:19:06.06,Default,,0,0,0,,我去去就回
Dialogue: 0,0:19:11.23,0:19:13.86,Default,,0,0,0,,好温暖啊
Dialogue: 0,0:19:14.28,0:19:16.24,Default,,0,0,0,,巧先生
Dialogue: 0,0:19:16.24,0:19:18.36,Default,,0,0,0,,您该起来了
Dialogue: 0,0:19:19.16,0:19:22.33,Default,,0,0,0,,我准备了很好喝的汤
Dialogue: 0,0:19:22.33,0:19:25.66,Default,,0,0,0,,主人是贪睡虫
Dialogue: 0,0:19:25.66,0:19:27.92,Default,,0,0,0,,说得也对
Dialogue: 0,0:19:28.37,0:19:30.00,Default,,0,0,0,,我得起床了
Dialogue: 0,0:19:36.30,0:19:38.51,Default,,0,0,0,,那个温暖的感觉是…
Dialogue: 0,0:19:44.77,0:19:47.35,Default,,0,0,0,,巧先生
Dialogue: 0,0:19:47.35,0:19:48.81,Default,,0,0,0,,早安
Dialogue: 0,0:19:48.81,0:19:51.23,Default,,0,0,0,,大家都很努力了呢
Dialogue: 0,0:19:51.23,0:19:53.23,Default,,0,0,0,,有你们在我的身边
Dialogue: 0,0:19:53.23,0:19:54.69,Default,,0,0,0,,真的是太好了
Dialogue: 0,0:19:55.65,0:19:58.20,Default,,0,0,0,,走吧 得去看看龙马
Dialogue: 0,0:20:00.16,0:20:02.53,Default,,0,0,0,,主人 快进来
Dialogue: 0,0:20:08.00,0:20:09.87,Default,,0,0,0,,这位是我一直跟你提到
Dialogue: 0,0:20:09.87,0:20:11.71,Default,,0,0,0,,能救你的人
Dialogue: 0,0:20:11.96,0:20:13.88,Default,,0,0,0,,伤势大致都痊愈了
Dialogue: 0,0:20:13.88,0:20:17.17,Default,,0,0,0,,是枫尽全力治疗的吧
Dialogue: 0,0:20:17.17,0:20:18.13,Default,,0,0,0,,这么一来
Dialogue: 0,0:20:18.72,0:20:21.26,Default,,0,0,0,,你和枫应该变得很要好了
Dialogue: 0,0:20:21.26,0:20:23.76,Default,,0,0,0,,愿意也和我做朋友吗
Dialogue: 0,0:20:23.97,0:20:25.10,Default,,0,0,0,,拜托了
Dialogue: 0,0:20:37.19,0:20:38.32,Default,,0,0,0,,主人
Dialogue: 0,0:20:38.90,0:20:39.78,Default,,0,0,0,,很好
Dialogue: 0,0:20:43.12,0:20:45.08,Default,,0,0,0,,高级治愈
Dialogue: 0,0:21:03.47,0:21:05.89,Default,,0,0,0,,多亏大家的努力
Dialogue: 0,0:21:06.26,0:21:08.47,Default,,0,0,0,,我们有了新伙伴
Dialogue: 0,0:21:08.77,0:21:09.98,Default,,0,0,0,,主人
Dialogue: 0,0:21:09.98,0:21:11.48,Default,,0,0,0,,这孩子要叫什么名字
Dialogue: 0,0:21:11.48,0:21:12.94,Default,,0,0,0,,这个嘛
Dialogue: 0,0:21:12.94,0:21:16.27,Default,,0,0,0,,枫因为身体的纹路和枫叶很像
Dialogue: 0,0:21:16.27,0:21:18.11,Default,,0,0,0,,所以帮你取了枫这个名字
Dialogue: 0,0:21:19.03,0:21:22.24,Default,,0,0,0,,那也用叶子来帮这孩子取名吧
Dialogue: 0,0:21:28.12,0:21:29.25,Default,,0,0,0,,山茶
Dialogue: 0,0:21:29.25,0:21:30.37,Default,,0,0,0,,山茶
Dialogue: 0,0:21:31.12,0:21:33.79,Default,,0,0,0,,是一种整年都不会掉落叶子的树
Dialogue: 0,0:21:33.79,0:21:36.34,Default,,0,0,0,,会开红色与白色的花
Dialogue: 0,0:21:36.67,0:21:38.80,Default,,0,0,0,,好美的名字
Dialogue: 0,0:21:39.84,0:21:42.34,Default,,0,0,0,,山茶 太好了
Dialogue: 0,0:21:42.93,0:21:45.39,Default,,0,0,0,,枫在森林里受伤
Dialogue: 0,0:21:45.39,0:21:48.35,Default,,0,0,0,,孤零零的很害怕又寂寞的时候
Dialogue: 0,0:21:48.35,0:21:50.02,Default,,0,0,0,,是主人救了我
Dialogue: 0,0:21:50.02,0:21:52.69,Default,,0,0,0,,非常非常开心
Dialogue: 0,0:21:52.69,0:21:55.06,Default,,0,0,0,,所以这次我也想救山茶
Dialogue: 0,0:21:55.06,0:21:57.73,Default,,0,0,0,,好了 我们去吃饭吧
Dialogue: 0,0:21:57.73,0:22:00.44,Default,,0,0,0,,美味的餐点都做好了哦
Dialogue: 0,0:22:00.82,0:22:03.40,Default,,0,0,0,,肚子饿扁了
Dialogue: 0,0:22:03.40,0:22:05.91,Default,,0,0,0,,因为您睡了一整天什么都没吃
Dialogue: 0,0:22:05.91,0:22:08.70,Default,,0,0,0,,枫肚子也饿了
Dialogue: 0,0:22:11.79,0:22:19.30,Default,,0,0,0,,我要到那片天空的另一端
Dialogue: 0,0:22:28.72,0:22:34.31,Default,,0,0,0,,初见的景色是如此地耀眼夺目
Dialogue: 0,0:22:34.31,0:22:40.07,Default,,0,0,0,,描绘中的故事 止不住兴奋之情
Dialogue: 0,0:22:40.07,0:22:46.11,Default,,0,0,0,,取得的技能 一点一点的加在我身上
Dialogue: 0,0:22:46.11,0:22:48.53,Default,,0,0,0,,想做的事情好多
Dialogue: 0,0:22:48.53,0:22:53.45,Default,,0,0,0,,就算还没成为大人也无所谓
Dialogue: 0,0:22:53.45,0:22:59.84,Default,,0,0,0,,在这个未知的世界 有什么在等待着我
Dialogue: 0,0:22:59.84,0:23:04.72,Default,,0,0,0,,提高宝箱地图的分辨率
Dialogue: 0,0:23:04.72,0:23:07.97,Default,,0,0,0,,我想变得更强大
Dialogue: 0,0:23:07.97,0:23:11.01,Default,,0,0,0,,我确信我什么都做得到
Dialogue: 0,0:23:11.01,0:23:13.35,Default,,0,0,0,,一切都在我的掌握中
Dialogue: 0,0:23:13.35,0:23:16.64,Default,,0,0,0,,要怀抱希望才能实现不是吗
Dialogue: 0,0:23:16.64,0:23:24.07,Default,,0,0,0,,立刻前往那颗星星的另一端
Dialogue: 0,0:23:24.07,0:23:29.20,Default,,0,0,0,,永远哦 要在一起哦
Dialogue: 0,0:23:29.20,0:23:36.58,Default,,0,0,0,,我要让你见识心跳加速的冒险

Dialogue: 0,0:00:01.54,0:00:04.21,Default,,0,0,0,,雄英是孕育了許多英雄的名門高校
Dialogue: 0,0:00:04.29,0:00:06.79,Default,,0,0,0,,進入雄英英雄科就讀的我
Dialogue: 0,0:00:07.30,0:00:09.43,Default,,0,0,0,,正朝著夢想努力邁進
Dialogue: 1,0:00:09.51,0:00:13.56,Default2,,0,0,0,,這一切都是為了成為
Dialogue: 0,0:00:09.51,0:00:13.56,Default,,0,0,0,,勇於面對任何困難
Dialogue: 1,0:00:14.22,0:00:17.27,Default2,,0,0,0,,並帶著笑容拯救人們的
Dialogue: 0,0:00:14.22,0:00:17.27,Default,,0,0,0,,最棒的英雄
Dialogue: 0,0:01:50.02,0:01:51.11,Default,,0,0,0,,（臨時證照測驗會場）
Dialogue: 0,0:01:51.19,0:01:54.03,Default,,0,0,0,,我們雄英高中英雄科A班
Dialogue: 0,0:01:54.11,0:01:57.07,Default,,0,0,0,,將挑戰英雄臨時證照測驗
Dialogue: 0,0:01:58.37,0:02:01.75,Default,,0,0,0,,要是通過測驗，拿到臨時證照的話
Dialogue: 0,0:02:01.83,0:02:04.00,Default,,0,0,0,,你們就能從蛋孵化成雛鳥
Dialogue: 0,0:02:04.08,0:02:05.96,Default,,0,0,0,,成為半職業級英雄
Dialogue: 0,0:02:06.96,0:02:08.21,Default,,0,0,0,,好好加油吧
Dialogue: 0,0:02:09.04,0:02:11.08,Default,,0,0,0,,測驗的第一輪
Dialogue: 1,0:02:11.17,0:02:14.92,Default2,,0,0,0,,考生必須將三個標靶
Dialogue: 0,0:02:11.17,0:02:14.92,Default,,0,0,0,,任意設置在身上
Dialogue: 1,0:02:15.34,0:02:18.30,Default2,,0,0,0,,如果三個標靶都被球擊中
Dialogue: 0,0:02:15.34,0:02:18.30,Default,,0,0,0,,就會被淘汰
Dialogue: 1,0:02:18.89,0:02:22.64,Default2,,0,0,0,,如果用配給到的六顆球
Dialogue: 0,0:02:18.89,0:02:22.64,Default,,0,0,0,,淘汰兩名以上的考生
Dialogue: 0,0:02:22.72,0:02:25.72,Default,,0,0,0,,就能通過測驗，名額限定100人
Dialogue: 0,0:02:25.93,0:02:27.93,Default,,0,0,0,,你這麼疼這個班級
Dialogue: 0,0:02:28.02,0:02:30.31,Default,,0,0,0,,怎麼不事先告訴學生呢？
Dialogue: 0,0:02:30.94,0:02:33.48,Default,,0,0,0,,每屆測驗最一開始一定會發生的
Dialogue: 0,0:02:33.57,0:02:35.82,Default,,0,0,0,,打爆雄英這件事
Dialogue: 0,0:02:40.07,0:02:41.78,Default,,0,0,0,,One For All
Dialogue: 0,0:02:41.87,0:02:43.54,Default,,0,0,0,,全覆蓋
Dialogue: 1,0:02:44.49,0:02:47.62,Default2,,0,0,0,,-射門風格
Dialogue: 0,0:02:44.49,0:02:47.62,Default,,0,0,0,,-黑影
Dialogue: 1,0:02:47.71,0:02:49.63,Default2,,0,0,0,,-打爆雄英
Dialogue: 0,0:02:47.71,0:02:49.63,Default,,0,0,0,,-知道了
Dialogue: 0,0:02:49.71,0:02:52.50,Default,,0,0,0,,雖然沒特別原因不告訴他們這件事
Dialogue: 0,0:02:52.59,0:02:55.09,Default,,0,0,0,,就算說了，該做的事也不會變
Dialogue: 0,0:02:55.17,0:02:58.01,Default,,0,0,0,,只能不斷跨越障礙前進
Dialogue: 1,0:02:58.09,0:03:01.09,Default2,,0,0,0,,所謂的“英雄”
Dialogue: 0,0:02:58.09,0:03:01.09,Default,,0,0,0,,就是能顛覆不合理的現況
Dialogue: 0,0:03:01.18,0:03:03.02,Default,,0,0,0,,再說了，成為職業英雄後
Dialogue: 0,0:03:03.10,0:03:05.10,Default,,0,0,0,,個性也一定會曝光
Dialogue: 0,0:03:05.18,0:03:06.10,Default,,0,0,0,,不好意思
Dialogue: 0,0:03:06.18,0:03:09.85,Default,,0,0,0,,我們班的著眼點比其他人都要放得遠
Dialogue: 0,0:03:17.15,0:03:18.32,Default,,0,0,0,,抹消磁頭
Dialogue: 0,0:03:18.57,0:03:21.99,Default,,0,0,0,,第一輪篩選的名額是先搶先贏
Dialogue: 0,0:03:22.07,0:03:24.11,Default,,0,0,0,,所以容易給人搶攻者贏的印象
Dialogue: 0,0:03:24.20,0:03:26.83,Default,,0,0,0,,不過這一次應該不一樣吧？
Dialogue: 0,0:03:27.58,0:03:29.46,Default,,0,0,0,,我想關鍵就在於團結及合作
Dialogue: 0,0:03:29.54,0:03:32.34,Default,,0,0,0,,還有情蒐能力吧
Dialogue: 1,0:03:33.25,0:03:36.09,Default2,,0,0,0,,如果被“前100名才合格”
Dialogue: 0,0:03:33.25,0:03:36.09,Default,,0,0,0,,這句話迷惑
Dialogue: 0,0:03:36.17,0:03:38.01,Default,,0,0,0,,焦急搶攻的話
Dialogue: 0,0:03:38.67,0:03:40.21,Default,,0,0,0,,反而會被反將一軍喔
Dialogue: 0,0:03:41.01,0:03:42.26,Default,,0,0,0,,幾乎都被他們擋開了
Dialogue: 0,0:03:42.34,0:03:44.18,Default,,0,0,0,,看來這種程度的攻擊
Dialogue: 0,0:03:44.26,0:03:46.26,Default,,0,0,0,,果然撂不倒雄英的人呢
Dialogue: 0,0:03:46.35,0:03:47.48,Default,,0,0,0,,不過呢
Dialogue: 0,0:03:47.56,0:03:49.19,Default,,0,0,0,,我慢慢看到了
Dialogue: 0,0:03:50.14,0:03:51.89,Default,,0,0,0,,傑物學園，二年級
Dialogue: 0,0:03:51.98,0:03:53.07,Default,,0,0,0,,真壁漆喰
Dialogue: 0,0:03:53.15,0:03:54.94,Default,,0,0,0,,個性，硬質化
Dialogue: 0,0:03:55.02,0:03:57.19,Default,,0,0,0,,被他雙手揉捏摩擦過的東西
Dialogue: 0,0:03:57.28,0:03:59.07,Default,,0,0,0,,都會變得硬梆梆的
Dialogue: 0,0:03:59.15,0:04:01.36,Default,,0,0,0,,不過，無法用於生物上
Dialogue: 0,0:04:01.45,0:04:02.45,Default,,0,0,0,,交給你了
Dialogue: 0,0:04:02.53,0:04:04.11,Default,,0,0,0,,包在我身上
Dialogue: 1,0:04:04.20,0:04:08.37,Default2,,0,0,0,,不過用這招的話
Dialogue: 0,0:04:04.20,0:04:08.37,Default,,0,0,0,,搞不好我會是第一個過關的人
Dialogue: 1,0:04:08.50,0:04:13.09,Default2,,0,0,0,,這麼一來就能淘汰一些敵人
Dialogue: 0,0:04:08.50,0:04:13.09,Default,,0,0,0,,所以也請多多包涵啦
Dialogue: 0,0:04:14.79,0:04:16.79,Default,,0,0,0,,目標鎖定
Dialogue: 0,0:04:18.96,0:04:20.09,Default,,0,0,0,,迴旋鏢
Dialogue: 0,0:04:20.17,0:04:21.80,Default,,0,0,0,,軌道，弦月
Dialogue: 0,0:04:22.26,0:04:23.93,Default,,0,0,0,,已經鎖定目標了
Dialogue: 0,0:04:24.26,0:04:26.51,Default,,0,0,0,,將球藏到地底，隱藏行進軌道
Dialogue: 0,0:04:26.60,0:04:28.69,Default,,0,0,0,,這樣你們就沒辦法反應了
Dialogue: 0,0:04:29.81,0:04:31.85,Default,,0,0,0,,傑物學園，二年級
Dialogue: 0,0:04:31.94,0:04:33.02,Default,,0,0,0,,投擲射手次郎
Dialogue: 0,0:04:33.10,0:04:34.85,Default,,0,0,0,,個性，迴旋鏢
Dialogue: 1,0:04:34.94,0:04:37.94,Default2,,0,0,0,,能將手持的東西
Dialogue: 0,0:04:34.94,0:04:37.94,Default,,0,0,0,,按照自己設定的軌道丟出去
Dialogue: 0,0:04:38.02,0:04:39.86,Default,,0,0,0,,連地底也一樣可以
Dialogue: 0,0:04:39.94,0:04:40.86,Default,,0,0,0,,會從哪邊攻過來？
Dialogue: 0,0:04:40.94,0:04:42.69,Default,,0,0,0,,大家退後，讓我來吧
Dialogue: 0,0:04:44.45,0:04:45.83,Default,,0,0,0,,音響增幅
Dialogue: 0,0:04:45.91,0:04:47.83,Default,,0,0,0,,耳機插孔增幅
Dialogue: 0,0:04:47.91,0:04:50.00,Default,,0,0,0,,心跳震動
Dialogue: 0,0:04:52.25,0:04:54.13,Default,,0,0,0,,居然把地面翻起來
Dialogue: 0,0:04:55.04,0:04:56.13,Default,,0,0,0,,不過呢
Dialogue: 0,0:04:56.63,0:04:58.38,Default,,0,0,0,,球朝著我過來了
Dialogue: 0,0:04:58.46,0:05:01.17,Default,,0,0,0,,黏度、溶解度，最強
Dialogue: 0,0:05:02.05,0:05:04.76,Default,,0,0,0,,酸液遮罩
Dialogue: 0,0:05:05.26,0:05:07.60,Default,,0,0,0,,得救了，妳這招真厲害
Dialogue: 1,0:05:07.68,0:05:10.77,Default2,,0,0,0,,這是把酸液變黏稠
Dialogue: 0,0:05:07.68,0:05:10.77,Default,,0,0,0,,當成護壁的防禦技喔
Dialogue: 0,0:05:10.85,0:05:13.14,Default,,0,0,0,,他們都創造出自己的必殺技了
Dialogue: 0,0:05:13.23,0:05:14.90,Default,,0,0,0,,這是一定要的
Dialogue: 0,0:05:14.98,0:05:16.61,Default,,0,0,0,,深淵闇軀
Dialogue: 0,0:05:16.69,0:05:19.23,Default,,0,0,0,,招式名變得更帥氣順口了
Dialogue: 0,0:05:20.19,0:05:21.48,Default,,0,0,0,,發自霄闇
Dialogue: 0,0:05:21.57,0:05:23.32,Default,,0,0,0,,穿心爪
Dialogue: 0,0:05:26.70,0:05:27.87,Default,,0,0,0,,好強喔
Dialogue: 0,0:05:28.95,0:05:30.70,Default,,0,0,0,,傑物學園，二年級
Dialogue: 0,0:05:30.79,0:05:31.75,Default,,0,0,0,,中瓶疊
Dialogue: 0,0:05:31.83,0:05:33.50,Default,,0,0,0,,個性，折疊
Dialogue: 1,0:05:33.58,0:05:36.37,Default2,,0,0,0,,可以像烏龜那樣
Dialogue: 0,0:05:33.58,0:05:36.37,Default,,0,0,0,,把自己的身體折疊起來
Dialogue: 0,0:05:36.46,0:05:39.09,Default,,0,0,0,,半夜回家看到肯定會嚇死的
Dialogue: 0,0:05:39.17,0:05:40.17,Default,,0,0,0,,原來如此
Dialogue: 0,0:05:40.25,0:05:42.88,Default,,0,0,0,,他們已經不是運動會時的A班了
Dialogue: 0,0:05:42.96,0:05:45.80,Default,,0,0,0,,這些日子成長幅度很驚人嘛
Dialogue: 0,0:05:46.89,0:05:49.73,Default,,0,0,0,,現在不管哪一邊戰況都陷入膠著
Dialogue: 0,0:05:49.80,0:05:51.59,Default,,0,0,0,,現階段沒有人通過
Dialogue: 0,0:05:52.43,0:05:53.81,Default,,0,0,0,,只要任何新戰況傳來
Dialogue: 0,0:05:53.89,0:05:55.85,Default,,0,0,0,,我都會從播放席這邊
Dialogue: 0,0:05:55.94,0:05:58.86,Default,,0,0,0,,為各位逐一進行轉播喔
Dialogue: 0,0:05:59.19,0:06:00.65,Default,,0,0,0,,還沒有人通過
Dialogue: 0,0:06:00.86,0:06:02.32,Default,,0,0,0,,裝著標靶的部位
Dialogue: 0,0:06:02.40,0:06:04.32,Default,,0,0,0,,也就是那個人的弱點
Dialogue: 0,0:06:04.65,0:06:07.61,Default,,0,0,0,,大家都是邊保護標靶，邊進行戰鬥
Dialogue: 1,0:06:07.70,0:06:11.04,Default2,,0,0,0,,如果想碰運氣丟球
Dialogue: 0,0:06:07.70,0:06:11.04,Default,,0,0,0,,擊中的可能性也會很低
Dialogue: 0,0:06:11.24,0:06:13.62,Default,,0,0,0,,不過呢，我慢慢看到了
Dialogue: 0,0:06:13.87,0:06:15.91,Default,,0,0,0,,現在還在觀察階段
Dialogue: 1,0:06:16.58,0:06:19.92,Default2,,0,0,0,,觀察對手的弱點
Dialogue: 0,0:06:16.58,0:06:19.92,Default,,0,0,0,,還有對方怎麼運用個性
Dialogue: 0,0:06:20.21,0:06:23.13,Default,,0,0,0,,看來戰鬥階段會非常短暫
Dialogue: 0,0:06:23.46,0:06:24.63,Default,,0,0,0,,很好
Dialogue: 1,0:06:25.13,0:06:27.88,Default2,,0,0,0,,“我們班的著眼點
Dialogue: 0,0:06:25.13,0:06:27.88,Default,,0,0,0,,比其他人放得要遠”
Dialogue: 0,0:06:27.97,0:06:29.14,Default,,0,0,0,,是嗎？
Dialogue: 1,0:06:29.39,0:06:32.52,Default2,,0,0,0,,抹消磁頭，你這句話
Dialogue: 0,0:06:29.39,0:06:32.52,Default,,0,0,0,,聽起來很高高在上
Dialogue: 0,0:06:32.68,0:06:35.81,Default,,0,0,0,,想當上英雄的孩子可說是多如繁星
Dialogue: 0,0:06:35.89,0:06:37.68,Default,,0,0,0,,無論有名或無名
Dialogue: 0,0:06:37.77,0:06:40.15,Default,,0,0,0,,大家都立定了遠大的志向
Dialogue: 0,0:06:40.52,0:06:43.02,Default,,0,0,0,,如果自以為主角，狗眼看人低
Dialogue: 0,0:06:43.11,0:06:44.49,Default,,0,0,0,,會被反咬一口的
Dialogue: 0,0:06:44.57,0:06:45.91,Default,,0,0,0,,可能會是你們喔
Dialogue: 0,0:06:45.99,0:06:46.99,Default,,0,0,0,,退遠一點
Dialogue: 0,0:06:47.07,0:06:49.11,Default,,0,0,0,,看樣子他們的防禦很堅固
Dialogue: 0,0:06:49.86,0:06:51.20,Default,,0,0,0,,裂開吧
Dialogue: 0,0:06:51.87,0:06:54.04,Default,,0,0,0,,最大威力
Dialogue: 0,0:06:55.58,0:06:58.04,Default,,0,0,0,,震動傳地
Dialogue: 0,0:07:01.42,0:07:03.13,Default,,0,0,0,,糟糕，快逃啊各位
Dialogue: 0,0:07:03.21,0:07:05.17,Default,,0,0,0,,這是怎麼回事啦？
Dialogue: 0,0:07:05.26,0:07:07.26,Default,,0,0,0,,也太亂來了吧
Dialogue: 0,0:07:07.34,0:07:09.34,Default,,0,0,0,,笨久同學
Dialogue: 0,0:07:09.88,0:07:11.30,Default,,0,0,0,,說到必殺技
Dialogue: 0,0:07:11.39,0:07:13.81,Default,,0,0,0,,我們這一邊當然也會有囉
Dialogue: 0,0:07:13.89,0:07:14.93,Default,,0,0,0,,傑物學園
Dialogue: 0,0:07:15.02,0:07:16.94,Default,,0,0,0,,二年級，真堂搖
Dialogue: 0,0:07:17.02,0:07:18.27,Default,,0,0,0,,個性，搖撼
Dialogue: 0,0:07:18.35,0:07:19.69,Default,,0,0,0,,能搖撼被他碰到的東西
Dialogue: 0,0:07:19.77,0:07:21.44,Default,,0,0,0,,但是根據大小及速度
Dialogue: 1,0:07:21.52,0:07:24.57,Default2,,0,0,0,,身體也會受到相對的餘震
Dialogue: 0,0:07:21.52,0:07:24.57,Default,,0,0,0,,而無法動彈
Dialogue: 0,0:07:25.78,0:07:27.07,Default,,0,0,0,,地在搖晃
Dialogue: 0,0:07:27.15,0:07:28.28,Default,,0,0,0,,地震？
Dialogue: 0,0:07:28.36,0:07:29.24,Default,,0,0,0,,不對
Dialogue: 0,0:07:29.32,0:07:30.99,Default,,0,0,0,,是某個人的個性嗎？
Dialogue: 0,0:07:32.24,0:07:33.95,Default,,0,0,0,,這是什麼個性啊？
Dialogue: 0,0:07:34.03,0:07:35.36,Default,,0,0,0,,是哪所學校的人啊？
Dialogue: 0,0:07:35.45,0:07:36.87,Default,,0,0,0,,別站著發呆
Dialogue: 0,0:07:36.95,0:07:38.95,Default,,0,0,0,,敵人就在我們附近
Dialogue: 0,0:07:41.37,0:07:42.29,Default,,0,0,0,,好了
Dialogue: 0,0:07:42.38,0:07:45.05,Default,,0,0,0,,到現在這個階段差不多也該出現…
Dialogue: 0,0:07:45.13,0:07:47.84,Default,,0,0,0,,一、兩個過關的考生了吧？
Dialogue: 0,0:07:49.34,0:07:50.38,Default,,0,0,0,,起風了？
Dialogue: 0,0:07:52.97,0:07:54.60,Default,,0,0,0,,球被吹走了
Dialogue: 0,0:07:55.10,0:07:57.44,Default,,0,0,0,,奇怪，怎麼只有球被捲走？
Dialogue: 0,0:08:00.35,0:08:01.39,Default,,0,0,0,,我
Dialogue: 0,0:08:01.48,0:08:04.11,Default,,0,0,0,,認為所謂的“英雄”就是要熱血
Dialogue: 0,0:08:04.19,0:08:05.27,Default,,0,0,0,,各位的戰鬥
Dialogue: 0,0:08:05.36,0:08:06.86,Default,,0,0,0,,真的非常火熱
Dialogue: 0,0:08:06.94,0:08:09.69,Default,,0,0,0,,我最喜歡這種火熱氣氛
Dialogue: 0,0:08:09.78,0:08:11.78,Default,,0,0,0,,士傑高中，只有他一個嗎？
Dialogue: 0,0:08:11.86,0:08:13.95,Default,,0,0,0,,他在說什麼啊？雖然猜得到
Dialogue: 1,0:08:14.03,0:08:16.70,Default2,,0,0,0,,等等
Dialogue: 0,0:08:14.03,0:08:16.70,Default,,0,0,0,,球被捲走，我們不就完了
Dialogue: 1,0:08:17.49,0:08:21.41,Default2,,0,0,0,,所以，請你們讓我
Dialogue: 0,0:08:17.49,0:08:21.41,Default,,0,0,0,,一起加入這火熱的戰鬥吧
Dialogue: 0,0:08:22.25,0:08:24.96,Default,,0,0,0,,還請各位多多指教
Dialogue: 0,0:08:38.39,0:08:40.94,Default,,0,0,0,,總算有一位考生通過了
Dialogue: 0,0:08:43.06,0:08:45.27,Default,,0,0,0,,而且還淘汰了120位考生
Dialogue: 1,0:08:45.36,0:08:48.86,Default2,,0,0,0,,竟然一個人
Dialogue: 0,0:08:45.36,0:08:48.86,Default,,0,0,0,,就解決了120位考生過關了
Dialogue: 0,0:08:51.82,0:08:54.45,Default,,0,0,0,,好耶，我贏啦
Dialogue: 0,0:08:56.37,0:08:59.00,Default,,0,0,0,,因為太過驚訝，我都被嚇醒了
Dialogue: 0,0:08:59.08,0:09:00.71,Default,,0,0,0,,感覺接著會有考生陸續過關
Dialogue: 0,0:09:00.79,0:09:04.00,Default,,0,0,0,,各位，請加緊腳步，好好加油
Dialogue: 0,0:09:04.08,0:09:05.04,Default,,0,0,0,,好痛
Dialogue: 0,0:09:05.29,0:09:06.92,Default,,0,0,0,,好驚人的個性
Dialogue: 0,0:09:07.00,0:09:09.80,Default,,0,0,0,,不過在有建築物的地方應該不好發揮
Dialogue: 0,0:09:10.80,0:09:12.97,Default,,0,0,0,,糟糕，跟其他人分散了
Dialogue: 0,0:09:13.05,0:09:16.43,Default,,0,0,0,,看樣子，這個狀況就是傑物學園要的
Dialogue: 0,0:09:16.51,0:09:17.80,Default,,0,0,0,,得快點跟大家…
Dialogue: 0,0:09:17.89,0:09:19.35,Default,,0,0,0,,跟任何一個人會合才行
Dialogue: 0,0:09:19.43,0:09:21.47,Default,,0,0,0,,落單的話肯定會被幹掉
Dialogue: 0,0:09:21.56,0:09:23.40,Default,,0,0,0,,活用彼此能力的合作
Dialogue: 0,0:09:23.48,0:09:25.52,Default,,0,0,0,,跟戰況分析的資歷有差
Dialogue: 0,0:09:25.65,0:09:27.65,Default,,0,0,0,,這就是多了一年訓練的差距
Dialogue: 0,0:09:27.73,0:09:30.40,Default,,0,0,0,,光靠經驗值是沒有辦法彌補的
Dialogue: 0,0:09:30.73,0:09:31.86,Default,,0,0,0,,夜嵐
Dialogue: 0,0:09:31.94,0:09:33.19,Default,,0,0,0,,在去年
Dialogue: 0,0:09:33.28,0:09:35.70,Default,,0,0,0,,也就是你們那年的推甄入學考試
Dialogue: 0,0:09:35.78,0:09:38.24,Default,,0,0,0,,他以第一名的成績錄取
Dialogue: 0,0:09:38.32,0:09:41.24,Default,,0,0,0,,但是不知道為什麼卻拒絕報到
Dialogue: 0,0:09:41.33,0:09:43.58,Default,,0,0,0,,以第一名的成績錄取
Dialogue: 0,0:09:43.66,0:09:46.20,Default,,0,0,0,,這就代表他的實力比轟同學還厲害
Dialogue: 0,0:09:46.79,0:09:48.88,Default,,0,0,0,,我會向諸位看齊好好努力的
Dialogue: 0,0:09:48.96,0:09:50.59,Default,,0,0,0,,今天還請賜教了
Dialogue: 0,0:09:50.84,0:09:52.59,Default,,0,0,0,,最大威力
Dialogue: 0,0:09:53.59,0:09:56.22,Default,,0,0,0,,震動傳地
Dialogue: 0,0:09:58.01,0:10:00.39,Default,,0,0,0,,來自全國的各路強敵
Dialogue: 0,0:10:00.76,0:10:02.05,Default,,0,0,0,,但是為什麼呢？
Dialogue: 0,0:10:02.39,0:10:04.89,Default,,0,0,0,,我竟然開始興奮起來了
Dialogue: 0,0:10:08.27,0:10:10.61,Default,,0,0,0,,竟然突然在我面前出現
Dialogue: 0,0:10:11.94,0:10:14.48,Default,,0,0,0,,打中了，怎麼在發呆？
Dialogue: 0,0:10:14.57,0:10:16.20,Default,,0,0,0,,這樣不行喔
Dialogue: 1,0:10:16.28,0:10:20.37,Default2,,0,0,0,,不過，你真奇怪
Dialogue: 0,0:10:16.28,0:10:20.37,Default,,0,0,0,,在這種情形還笑得出來
Dialogue: 0,0:10:20.70,0:10:21.99,Default,,0,0,0,,這個人
Dialogue: 0,0:10:22.24,0:10:23.66,Default,,0,0,0,,是士傑高中的
Comment: 0,0:10:23.75,0:10:25.75,Default,,0,0,0,,（現見凱咪）
Dialogue: 0,0:10:25.83,0:10:27.58,Default,,0,0,0,,還挺帥的嘛
Comment: 1,0:10:32.80,0:10:35.89,Default2,,0,0,0,,（瀨呂範太，能從手肘射出膠帶
Comment: 0,0:10:32.80,0:10:35.89,Default,,0,0,0,,用於綑綁或是移動）
Comment: 1,0:10:37.09,0:10:39.80,Default2,,0,0,0,,（夜嵐稻佐，能在自身周圍
Comment: 0,0:10:37.09,0:10:39.80,Default,,0,0,0,,颳起暴風並加以操控）
Dialogue: 0,0:10:41.76,0:10:44.18,Default,,0,0,0,,拆散人的方式也太亂來了
Dialogue: 0,0:10:44.31,0:10:46.69,Default,,0,0,0,,一個不小心可是會出人命的耶
Dialogue: 0,0:10:47.44,0:10:48.94,Default,,0,0,0,,雖然很想出聲呼叫大家
Dialogue: 0,0:10:49.02,0:10:51.31,Default,,0,0,0,,但很可能會因此被其他學校盯上
Dialogue: 0,0:10:51.65,0:10:53.94,Default,,0,0,0,,我想大家應該不會離得太遠
Dialogue: 0,0:10:54.03,0:10:56.07,Default,,0,0,0,,為了避免多對一
Dialogue: 0,0:10:56.15,0:10:57.69,Default,,0,0,0,,得先跟他們會合
Dialogue: 0,0:10:57.86,0:10:58.99,Default,,0,0,0,,這種時候
Dialogue: 0,0:10:59.07,0:11:01.07,Default,,0,0,0,,更應該冷靜慎重地行動
Dialogue: 0,0:11:01.45,0:11:03.29,Default,,0,0,0,,潛行吧，無重麗
Dialogue: 1,0:11:04.04,0:11:07.13,Default2,,0,0,0,,不難料到這種測驗
Dialogue: 0,0:11:04.04,0:11:07.13,Default,,0,0,0,,一定會出現大亂鬥的場面
Dialogue: 1,0:11:07.21,0:11:11.71,Default2,,0,0,0,,所以有很多人都會想挑
Dialogue: 0,0:11:07.21,0:11:11.71,Default,,0,0,0,,情報量多的學校下手
Dialogue: 1,0:11:11.79,0:11:15.21,Default2,,0,0,0,,我想雄英的學生很有可能
Dialogue: 0,0:11:11.79,0:11:15.21,Default,,0,0,0,,因此早早被淘汰
Dialogue: 0,0:11:15.30,0:11:17.14,Default,,0,0,0,,所以就特地來見你了
Dialogue: 1,0:11:17.55,0:11:20.64,Default2,,0,0,0,,畢竟這是難得可以
Dialogue: 0,0:11:17.55,0:11:20.64,Default,,0,0,0,,跟強校交流的大好機會呀
Dialogue: 0,0:11:20.72,0:11:22.85,Default,,0,0,0,,我想更瞭解你們
Dialogue: 0,0:11:23.18,0:11:25.72,Default,,0,0,0,,妳這個人，話還真多啊
Dialogue: 0,0:11:26.39,0:11:28.56,Default,,0,0,0,,傑物學園跟其他學校的人
Dialogue: 0,0:11:28.64,0:11:30.14,Default,,0,0,0,,應該很快就會蜂擁而至
Dialogue: 0,0:11:30.48,0:11:32.69,Default,,0,0,0,,沒時間再悠哉聊天了
Dialogue: 0,0:11:33.11,0:11:34.99,Default,,0,0,0,,我想她也很清楚這一點
Dialogue: 0,0:11:35.36,0:11:37.20,Default,,0,0,0,,會不會有夥伴在暗中支援？
Dialogue: 0,0:11:37.28,0:11:39.57,Default,,0,0,0,,還是說她對自己相當有自信？
Dialogue: 0,0:11:41.36,0:11:42.32,Default,,0,0,0,,沒辦法了
Dialogue: 0,0:11:42.41,0:11:44.12,Default,,0,0,0,,只能設法讓自己不要被打到
Dialogue: 0,0:11:45.37,0:11:47.54,Default,,0,0,0,,又不見了，到哪去了？
Dialogue: 0,0:11:47.62,0:11:50.83,Default,,0,0,0,,這種測驗只要拿球互毆不就好了嗎？
Dialogue: 0,0:11:52.00,0:11:53.25,Default,,0,0,0,,好險
Dialogue: 0,0:11:53.54,0:11:55.13,Default,,0,0,0,,反擊
Dialogue: 0,0:11:56.75,0:11:57.63,Default,,0,0,0,,可惡
Dialogue: 0,0:11:57.71,0:11:59.38,Default,,0,0,0,,根本就辦不到
Dialogue: 0,0:11:59.76,0:12:02.18,Default,,0,0,0,,你以為我能讓自己消失嗎？
Dialogue: 0,0:12:02.43,0:12:03.47,Default,,0,0,0,,糟糕
Dialogue: 0,0:12:04.97,0:12:07.39,Default,,0,0,0,,我剛剛只不過是躲起來罷了
Dialogue: 0,0:12:07.47,0:12:09.22,Default,,0,0,0,,只是躲起來罷了？
Dialogue: 0,0:12:09.31,0:12:10.19,Default,,0,0,0,,沒錯
Dialogue: 0,0:12:10.27,0:12:11.48,Default,,0,0,0,,這就是技術
Dialogue: 0,0:12:11.60,0:12:13.48,Default,,0,0,0,,轉移對手的視覺跟聽覺
Dialogue: 0,0:12:13.56,0:12:15.73,Default,,0,0,0,,讓他察覺不到我的存在
Dialogue: 0,0:12:15.82,0:12:16.90,Default,,0,0,0,,在那一瞬間
Dialogue: 0,0:12:16.98,0:12:19.65,Default,,0,0,0,,屏住呼吸，什麼都不想地潛藏
Dialogue: 0,0:12:19.74,0:12:20.87,Default,,0,0,0,,然後混入其中
Dialogue: 0,0:12:20.95,0:12:23.37,Default,,0,0,0,,不過最難的就在於什麼都不想
Dialogue: 1,0:12:23.45,0:12:26.62,Default2,,0,0,0,,在士傑高中
Dialogue: 0,0:12:23.45,0:12:26.62,Default,,0,0,0,,連那些技巧都能學會嗎？
Dialogue: 0,0:12:26.70,0:12:29.95,Default,,0,0,0,,訣竅就是不把訓練當成是訓練
Dialogue: 0,0:12:31.08,0:12:33.25,Default,,0,0,0,,我們都很求知若渴呢
Dialogue: 0,0:12:33.50,0:12:34.84,Default,,0,0,0,,換我發問囉
Dialogue: 0,0:12:34.92,0:12:37.92,Default,,0,0,0,,你為什麼會想成為英雄呢？
Dialogue: 0,0:12:38.00,0:12:39.79,Default,,0,0,0,,為了名譽、驕傲
Dialogue: 0,0:12:39.88,0:12:41.13,Default,,0,0,0,,還是為了某個人？
Dialogue: 0,0:12:41.34,0:12:45.09,Default,,0,0,0,,我真的很想多瞭解關於你的大小事呢
Dialogue: 0,0:12:55.44,0:12:56.65,Default,,0,0,0,,士傑的人也在
Dialogue: 0,0:12:56.73,0:12:57.77,Default,,0,0,0,,真討厭
Dialogue: 0,0:12:59.40,0:13:00.65,Default,,0,0,0,,這下糟了
Dialogue: 0,0:13:00.86,0:13:02.07,Default,,0,0,0,,糟透了
Dialogue: 0,0:13:02.15,0:13:03.78,Default,,0,0,0,,根本來不及跟其他人會合
Dialogue: 0,0:13:03.86,0:13:05.28,Default,,0,0,0,,還被大批對手包圍
Dialogue: 0,0:13:05.57,0:13:08.74,Default,,0,0,0,,剛才設想的最糟糕情況成真了
Dialogue: 0,0:13:10.04,0:13:11.25,Default,,0,0,0,,要來了
Dialogue: 0,0:13:11.50,0:13:12.63,Default,,0,0,0,,快躲開
Dialogue: 0,0:13:13.96,0:13:16.46,Default,,0,0,0,,快躲開…
Dialogue: 0,0:13:16.54,0:13:18.63,Default,,0,0,0,,無論如何都要躲開
Dialogue: 0,0:13:19.55,0:13:20.89,Default,,0,0,0,,你沒事吧？
Dialogue: 0,0:13:21.21,0:13:22.38,Default,,0,0,0,,麗日同學
Dialogue: 0,0:13:22.47,0:13:23.89,Default,,0,0,0,,來我這邊，快點
Dialogue: 0,0:13:23.97,0:13:26.18,Default,,0,0,0,,為什麼？她有什麼對策嗎？
Dialogue: 0,0:13:26.26,0:13:28.05,Default,,0,0,0,,快點妳個頭啦
Dialogue: 0,0:13:28.14,0:13:30.14,Default,,0,0,0,,討厭，真礙事
Dialogue: 0,0:13:32.02,0:13:33.65,Default,,0,0,0,,這分數我要定了
Dialogue: 0,0:13:34.02,0:13:35.15,Default,,0,0,0,,等一下
Dialogue: 0,0:13:36.52,0:13:37.65,Default,,0,0,0,,那個時候
Dialogue: 0,0:13:37.94,0:13:40.32,Default,,0,0,0,,因為我選擇跟惡人戰鬥
Dialogue: 0,0:13:40.40,0:13:41.86,Default,,0,0,0,,才會把手臂搞壞
Dialogue: 0,0:13:42.44,0:13:43.73,Default,,0,0,0,,如果手臂沒壞
Dialogue: 0,0:13:44.24,0:13:46.87,Default,,0,0,0,,說不定當時就能把小勝搶回來
Dialogue: 0,0:13:47.70,0:13:49.41,Default,,0,0,0,,如果搶回小勝
Dialogue: 1,0:13:49.78,0:13:53.53,Default2,,0,0,0,,或許後來歐爾麥特就不用
Dialogue: 0,0:13:49.78,0:13:53.53,Default,,0,0,0,,跟All For One戰鬥了
Dialogue: 0,0:13:53.79,0:13:54.83,Default,,0,0,0,,那個時候
Dialogue: 0,0:13:54.91,0:13:56.54,Default,,0,0,0,,如果我能保護洸汰
Dialogue: 0,0:13:56.62,0:14:00.17,Default,,0,0,0,,比惡人搶先一步趕到相澤老師那邊去
Dialogue: 0,0:14:01.96,0:14:04.21,Default,,0,0,0,,我早該把主力放在鍛鍊雙腳
Dialogue: 0,0:14:04.80,0:14:07.47,Default,,0,0,0,,然後盡可能地早一步趕到才對
Dialogue: 0,0:14:08.22,0:14:09.47,Default,,0,0,0,,有機可乘
Dialogue: 0,0:14:11.06,0:14:12.44,Default,,0,0,0,,想救人的話
Dialogue: 0,0:14:12.52,0:14:15.11,Default,,0,0,0,,就得先讓自己平安無事
Dialogue: 0,0:14:20.44,0:14:22.94,Default,,0,0,0,,可惡，腳下的地被破壞啦
Dialogue: 0,0:14:25.82,0:14:26.99,Default,,0,0,0,,不對喔
Dialogue: 0,0:14:27.07,0:14:29.82,Default,,0,0,0,,剛剛那招絕對比臨陣磨槍來得強
Dialogue: 0,0:14:30.20,0:14:32.79,Default,,0,0,0,,特別是在臨時證照測驗中
Dialogue: 0,0:14:32.87,0:14:34.91,Default,,0,0,0,,真的跟歐爾麥特說的一樣
Dialogue: 0,0:14:35.29,0:14:36.29,Default,,0,0,0,,決定了
Dialogue: 0,0:14:36.37,0:14:37.54,Default,,0,0,0,,在我身體能配合力量之前
Dialogue: 0,0:14:37.62,0:14:40.25,Default,,0,0,0,,我不會使用One For All百分之一百
Dialogue: 0,0:14:40.50,0:14:42.17,Default,,0,0,0,,相對的，得改用腳
Dialogue: 1,0:14:42.25,0:14:45.17,Default2,,0,0,0,,這個鐵製的鞋底
Dialogue: 0,0:14:42.25,0:14:45.17,Default,,0,0,0,,給予強大衝擊力的瞬間
Dialogue: 1,0:14:45.26,0:14:49.31,Default2,,0,0,0,,彈簧的力量就會讓腳尖
Dialogue: 0,0:14:45.26,0:14:49.31,Default,,0,0,0,,再次往前撞，瞬間兩擊
Dialogue: 1,0:14:49.43,0:14:52.60,Default2,,0,0,0,,這是能補足腳的威力
Dialogue: 0,0:14:49.43,0:14:52.60,Default,,0,0,0,,及後收力的輔助道具
Dialogue: 0,0:14:53.76,0:14:57.10,Default,,0,0,0,,我要讓這雙腳變得更強，還要更強
Dialogue: 0,0:14:57.23,0:15:00.15,Default,,0,0,0,,這是為了成為我理想中的英雄
Dialogue: 0,0:15:03.65,0:15:06.45,Default,,0,0,0,,這下終於有30位考生過關
Dialogue: 0,0:15:06.82,0:15:09.03,Default,,0,0,0,,看樣子還有得等
Dialogue: 0,0:15:09.11,0:15:10.61,Default,,0,0,0,,拜託快點結束好嗎？
Dialogue: 0,0:15:10.70,0:15:11.95,Default,,0,0,0,,我說真的
Dialogue: 0,0:15:12.78,0:15:14.91,Default,,0,0,0,,雄英學生逃跑的速度真快
Dialogue: 0,0:15:14.99,0:15:16.58,Default,,0,0,0,,不見了，躲起來了嗎？
Dialogue: 0,0:15:16.66,0:15:18.00,Default,,0,0,0,,應該在附近才對
Dialogue: 1,0:15:18.33,0:15:21.79,Default2,,0,0,0,,不過我剛剛才想到
Dialogue: 0,0:15:18.33,0:15:21.79,Default,,0,0,0,,這招還挺沒效率的
Dialogue: 0,0:15:23.54,0:15:24.79,Default,,0,0,0,,追兵呢？
Dialogue: 0,0:15:25.17,0:15:26.46,Default,,0,0,0,,看來沒追上來
Dialogue: 0,0:15:26.84,0:15:28.05,Default,,0,0,0,,他們是不是放棄了？
Dialogue: 0,0:15:28.55,0:15:29.80,Default,,0,0,0,,真謝謝你
Dialogue: 0,0:15:29.88,0:15:31.63,Default,,0,0,0,,對不起，我剛剛搞砸了
Dialogue: 0,0:15:32.76,0:15:34.93,Default,,0,0,0,,不，妳別這麼說
Dialogue: 0,0:15:58.20,0:16:01.33,Default,,0,0,0,,妳該不會是士傑的人吧？
Dialogue: 0,0:16:02.54,0:16:04.12,Default,,0,0,0,,麗日同學的個性
Dialogue: 0,0:16:04.21,0:16:05.50,Default,,0,0,0,,經過鍛鍊
Dialogue: 1,0:16:05.59,0:16:08.64,Default2,,0,0,0,,在極短的時間內
Dialogue: 0,0:16:05.59,0:16:08.64,Default,,0,0,0,,可以不用在意副作用
Dialogue: 0,0:16:08.76,0:16:10.76,Default,,0,0,0,,對自己使用個性了
Dialogue: 0,0:16:10.97,0:16:12.14,Default,,0,0,0,,妳剛剛…
Dialogue: 1,0:16:12.26,0:16:15.39,Default2,,0,0,0,,明明面臨危險
Dialogue: 0,0:16:12.26,0:16:15.39,Default,,0,0,0,,卻完全沒有發動個性的意思
Dialogue: 0,0:16:15.47,0:16:16.51,Default,,0,0,0,,更重要的是
Dialogue: 1,0:16:16.60,0:16:19.56,Default2,,0,0,0,,妳居然在沒有計策的情況下
Dialogue: 0,0:16:16.60,0:16:19.56,Default,,0,0,0,,出現在敵人面前
Dialogue: 1,0:16:19.64,0:16:22.81,Default2,,0,0,0,,種種跡象顯示
Dialogue: 0,0:16:19.64,0:16:22.81,Default,,0,0,0,,妳不是我認識的麗日同學
Dialogue: 0,0:16:25.52,0:16:27.77,Default,,0,0,0,,明明發現了卻還是救了我
Dialogue: 0,0:16:27.86,0:16:30.70,Default,,0,0,0,,是想反過來利用這一點嗎？
Dialogue: 0,0:16:31.99,0:16:34.03,Default,,0,0,0,,我當下並沒有想到這麼多
Dialogue: 0,0:16:34.12,0:16:36.66,Default,,0,0,0,,但是結果倒是讓我很慶幸
Dialogue: 0,0:16:36.74,0:16:38.28,Default,,0,0,0,,如果妳不是麗日同學
Dialogue: 0,0:16:38.37,0:16:40.50,Default,,0,0,0,,就更不可能讓自己浮起來
Dialogue: 1,0:16:40.58,0:16:44.21,Default2,,0,0,0,,要是就那樣摔落地面的話
Dialogue: 0,0:16:40.58,0:16:44.21,Default,,0,0,0,,肯定會傷到背部
Dialogue: 0,0:16:44.96,0:16:46.13,Default,,0,0,0,,原來如此
Dialogue: 0,0:16:46.34,0:16:48.80,Default,,0,0,0,,這就是你想成為英雄的理由吧
Dialogue: 0,0:16:49.96,0:16:53.67,Default,,0,0,0,,再多跟我分享一點你的事吧
Dialogue: 0,0:16:54.93,0:16:57.18,Default,,0,0,0,,難道就不能等到考完再聊嗎？
Dialogue: 0,0:16:57.47,0:16:59.89,Default,,0,0,0,,不管是誰，你都會出手相救嗎？
Dialogue: 0,0:16:59.97,0:17:01.14,Default,,0,0,0,,界線呢？
Dialogue: 0,0:17:01.23,0:17:03.44,Default,,0,0,0,,你是以什麼為根據訂下標準的？
Dialogue: 0,0:17:03.52,0:17:04.65,Default,,0,0,0,,妳的衣服呢？
Dialogue: 0,0:17:04.73,0:17:06.69,Default,,0,0,0,,為什麼裸體？快穿上啦
Dialogue: 0,0:17:06.77,0:17:08.90,Default,,0,0,0,,等到我先辦好事再說
Dialogue: 0,0:17:09.65,0:17:10.69,Default,,0,0,0,,用抓的？
Dialogue: 0,0:17:10.78,0:17:12.57,Default,,0,0,0,,這個女生到底怎麼回事？
Dialogue: 0,0:17:18.58,0:17:19.75,Default,,0,0,0,,真是的
Dialogue: 0,0:17:19.83,0:17:21.08,Default,,0,0,0,,膠帶
Dialogue: 0,0:17:21.16,0:17:22.12,Default,,0,0,0,,綠谷
Dialogue: 0,0:17:22.20,0:17:23.99,Default,,0,0,0,,你這是什麼令人羨慕的狀況？
Dialogue: 0,0:17:24.08,0:17:25.12,Default,,0,0,0,,瀨呂同學
Dialogue: 0,0:17:25.21,0:17:26.21,Default,,0,0,0,,麗日
Dialogue: 0,0:17:27.54,0:17:29.17,Default,,0,0,0,,解除
Dialogue: 0,0:17:32.42,0:17:33.88,Default,,0,0,0,,反應好快
Dialogue: 0,0:17:37.35,0:17:40.27,Default,,0,0,0,,剛剛聊得正開心的說，真遺憾
Dialogue: 0,0:17:40.77,0:17:41.90,Default,,0,0,0,,真的
Dialogue: 0,0:17:42.22,0:17:43.93,Default,,0,0,0,,非常遺憾
Dialogue: 0,0:17:44.35,0:17:46.48,Default,,0,0,0,,我本來還想跟你多聊聊
Dialogue: 0,0:17:46.73,0:17:48.86,Default,,0,0,0,,但看來是沒辦法了
Dialogue: 0,0:17:48.94,0:17:50.32,Default,,0,0,0,,真遺憾
Dialogue: 0,0:17:51.61,0:17:53.70,Default,,0,0,0,,麗日御茶子同學
Dialogue: 0,0:17:53.78,0:17:56.37,Default,,0,0,0,,看樣子他很信任妳呢
Dialogue: 0,0:17:58.82,0:17:59.91,Default,,0,0,0,,別跑，花痴
Dialogue: 0,0:17:59.99,0:18:01.16,Default,,0,0,0,,不，不用追她了
Dialogue: 0,0:18:01.24,0:18:02.74,Default,,0,0,0,,為什麼不追？
Dialogue: 0,0:18:02.83,0:18:04.92,Default,,0,0,0,,或許是因為個性的關係吧
Dialogue: 0,0:18:05.16,0:18:07.20,Default,,0,0,0,,她把標靶連同衣服一起脫了
Dialogue: 0,0:18:07.50,0:18:09.50,Default,,0,0,0,,雖然可能還會盯上我們
Dialogue: 0,0:18:09.75,0:18:11.46,Default,,0,0,0,,但考慮到時間還有眾多因素
Dialogue: 0,0:18:11.71,0:18:14.09,Default,,0,0,0,,想從她身上得分非常困難
Dialogue: 0,0:18:14.59,0:18:15.68,Default,,0,0,0,,更重要的是
Dialogue: 0,0:18:15.76,0:18:17.55,Default,,0,0,0,,你們兩個都是本人吧？
Dialogue: 0,0:18:18.09,0:18:19.68,Default,,0,0,0,,你在說什麼啊？綠谷
Dialogue: 0,0:18:19.76,0:18:21.51,Default,,0,0,0,,不是啦，其實那個人
Dialogue: 0,0:18:21.76,0:18:24.18,Default,,0,0,0,,剛才變身成麗日同學的樣子
Dialogue: 0,0:18:25.56,0:18:27.60,Default,,0,0,0,,綠谷，她有沒有穿衣服啊？
Dialogue: 0,0:18:27.69,0:18:28.77,Default,,0,0,0,,重點是這個嗎？
Dialogue: 0,0:18:28.85,0:18:30.81,Default,,0,0,0,,有啦，她戰鬥服穿得好好的
Dialogue: 0,0:18:31.61,0:18:33.11,Default,,0,0,0,,變成別人的樣子
Dialogue: 0,0:18:33.40,0:18:35.32,Default,,0,0,0,,這就是那個女生的個性嗎？
Dialogue: 0,0:18:35.44,0:18:36.65,Default,,0,0,0,,八成是
Dialogue: 1,0:18:37.20,0:18:40.33,Default2,,0,0,0,,看來其他學校
Dialogue: 0,0:18:37.20,0:18:40.33,Default,,0,0,0,,果然都事先調查過我們了
Dialogue: 1,0:18:40.91,0:18:43.66,Default2,,0,0,0,,畢竟連綠谷跟麗日很要好這件事
Dialogue: 0,0:18:40.91,0:18:43.66,Default,,0,0,0,,都查到了
Dialogue: 1,0:18:44.25,0:18:47.75,Default2,,0,0,0,,運動會騎馬打仗的時候
Dialogue: 0,0:18:44.25,0:18:47.75,Default,,0,0,0,,我們不是同一組嗎？
Dialogue: 0,0:18:48.21,0:18:49.21,Default,,0,0,0,,原來如此
Dialogue: 0,0:18:49.29,0:18:50.29,Default,,0,0,0,,比起這件事
Dialogue: 0,0:18:50.54,0:18:52.83,Default,,0,0,0,,瀨呂同學跟麗日同學怎麼會來這裡？
Dialogue: 0,0:18:52.92,0:18:55.17,Default,,0,0,0,,看到這邊打得乒乒乓乓的就過來啦
Dialogue: 0,0:18:55.76,0:18:57.64,Default,,0,0,0,,跟麗日也是在中途會合的
Dialogue: 0,0:18:57.84,0:18:59.22,Default,,0,0,0,,幸好我們趕上了
Dialogue: 0,0:19:00.01,0:19:01.18,Default,,0,0,0,,謝謝你們
Dialogue: 0,0:19:01.43,0:19:03.72,Default,,0,0,0,,總之我們有三個人，對吧？
Dialogue: 0,0:19:03.81,0:19:05.19,Default,,0,0,0,,如果可以的話
Dialogue: 0,0:19:05.27,0:19:07.94,Default,,0,0,0,,還是想跟其他分散的人會合就是了
Dialogue: 0,0:19:08.14,0:19:09.02,Default,,0,0,0,,但是
Dialogue: 0,0:19:09.10,0:19:11.94,Default,,0,0,0,,目前已經有30個人通過第一輪測驗了
Dialogue: 0,0:19:12.52,0:19:13.60,Default,,0,0,0,,得快點才行
Dialogue: 0,0:19:13.94,0:19:16.11,Default,,0,0,0,,100個名額一下子就會被搶光
Dialogue: 1,0:19:18.24,0:19:22.20,Default2,,0,0,0,,不管哪所學校
Dialogue: 0,0:19:18.24,0:19:22.20,Default,,0,0,0,,都是十人以上為一組採取行動
Dialogue: 0,0:19:22.99,0:19:24.83,Default,,0,0,0,,雖然要我主動出擊也無所謂
Dialogue: 0,0:19:25.04,0:19:27.79,Default,,0,0,0,,但要是有人的個性能剋我就糟了
Dialogue: 0,0:19:28.21,0:19:30.13,Default,,0,0,0,,最理想的狀況是兩組人馬打起來
Dialogue: 0,0:19:30.21,0:19:32.96,Default,,0,0,0,,再趁雙方人數減少的時候進行突擊
Dialogue: 0,0:19:33.04,0:19:34.54,Default,,0,0,0,,坐收漁翁之利
Dialogue: 0,0:19:35.59,0:19:37.47,Default,,0,0,0,,狀況持續有進展喔
Dialogue: 0,0:19:37.55,0:19:39.34,Default,,0,0,0,,目前有52位…
Dialogue: 0,0:19:39.43,0:19:40.93,Default,,0,0,0,,變53位了
Dialogue: 0,0:19:41.01,0:19:42.80,Default,,0,0,0,,陸續有考生通過
Dialogue: 0,0:19:43.30,0:19:45.59,Default,,0,0,0,,有些人淘汰了2位以上考生
Dialogue: 0,0:19:45.68,0:19:47.68,Default,,0,0,0,,所以有230位被淘汰
Dialogue: 0,0:19:47.81,0:19:50.06,Default,,0,0,0,,就在剛才，過關人數來到了54位
Dialogue: 0,0:19:50.14,0:19:52.10,Default,,0,0,0,,剩不到一半，快點
Dialogue: 0,0:19:52.19,0:19:53.82,Default,,0,0,0,,結束吧
Dialogue: 0,0:19:54.19,0:19:56.28,Default,,0,0,0,,沒時間悠哉等下去了
Dialogue: 0,0:20:05.53,0:20:07.24,Default,,0,0,0,,真厲害
Dialogue: 0,0:20:07.41,0:20:11.33,Default,,0,0,0,,真不愧是拿下雄英運動會第二名的人
Dialogue: 0,0:20:11.71,0:20:13.71,Default,,0,0,0,,你叫轟對不對？
Dialogue: 0,0:20:13.79,0:20:17.34,Default,,0,0,0,,你也真大膽，竟然敢一個人單獨行動
Dialogue: 0,0:20:17.42,0:20:18.92,Default,,0,0,0,,這麼遊刃有餘啊
Dialogue: 0,0:20:19.01,0:20:21.60,Default,,0,0,0,,不過，就算雄英再怎麼厲害
Dialogue: 0,0:20:21.68,0:20:23.52,Default,,0,0,0,,單槍匹馬還是不太妙吧？
Dialogue: 0,0:20:23.59,0:20:25.09,Default,,0,0,0,,現在一對十喔
Dialogue: 0,0:20:25.18,0:20:26.26,Default,,0,0,0,,你打算怎麼辦？
Dialogue: 0,0:20:26.35,0:20:27.56,Default,,0,0,0,,幫了我大忙
Dialogue: 0,0:20:27.64,0:20:29.81,Default,,0,0,0,,省去找人的時間
Dialogue: 0,0:20:31.02,0:20:32.90,Default,,0,0,0,,挺帥氣的嘛
Dialogue: 0,0:20:40.61,0:20:42.61,Default,,0,0,0,,可惡，動不了了
Dialogue: 0,0:20:44.99,0:20:46.28,Default,,0,0,0,,你們幾個…
Dialogue: 0,0:20:46.91,0:20:49.37,Default,,0,0,0,,真的好好看過運動會轉播了嗎？
Dialogue: 0,0:20:51.75,0:20:54.04,Default,,0,0,0,,當然仔細看過了
Dialogue: 0,0:20:58.92,0:21:01.13,Default,,0,0,0,,他的個性是能讓東西變大嗎？
Dialogue: 0,0:21:01.22,0:21:03.14,Default,,0,0,0,,還沒完呢
Dialogue: 0,0:21:05.43,0:21:07.10,Default,,0,0,0,,要發揮全力嗎？
Dialogue: 0,0:21:07.18,0:21:08.01,Default,,0,0,0,,不過
Dialogue: 0,0:21:08.10,0:21:09.56,Default,,0,0,0,,他還有其他同伴在
Dialogue: 0,0:21:20.28,0:21:22.16,Default,,0,0,0,,就算沒辦法融化
Dialogue: 0,0:21:22.24,0:21:23.99,Default,,0,0,0,,怎麼可能完全起不了作用？
Dialogue: 0,0:21:26.03,0:21:28.66,Default,,0,0,0,,因為這不是普通的金屬啊
Dialogue: 0,0:21:28.74,0:21:31.83,Default,,0,0,0,,我可是特地使用了耐高熱的鎢金屬
Dialogue: 0,0:21:36.13,0:21:38.42,Default,,0,0,0,,我不是說過了嗎？轟同學
Dialogue: 1,0:21:38.96,0:21:42.84,Default2,,0,0,0,,就算雄英再怎麼厲害
Dialogue: 0,0:21:38.96,0:21:42.84,Default,,0,0,0,,一個人單槍匹馬行動
Dialogue: 0,0:21:43.97,0:21:46.85,Default,,0,0,0,,也太遊刃有餘了
Comment: 0,0:23:20.60,0:23:21.69,Default,,0,0,0,,下集預告
Comment: 0,0:23:21.77,0:23:23.40,Default,,0,0,0,,在臨時證照測驗中
Comment: 0,0:23:23.48,0:23:25.61,Default,,0,0,0,,危機接二連三襲向我們A班
Comment: 0,0:23:25.69,0:23:27.94,Default,,0,0,0,,轟同學被誠刃高中盯上
Comment: 0,0:23:28.03,0:23:29.70,Default,,0,0,0,,八百萬同學他們也…
Comment: 0,0:23:29.78,0:23:31.74,Default,,0,0,0,,下一集，一年A班
Comment: 0,0:23:31.82,0:23:33.11,Default,,0,0,0,,更向前邁進吧
Comment: 0,0:23:33.20,0:23:34.54,Default,,0,0,0,,超越巔峰

Dialogue: 0,0:22:08.01,0:22:11.01,Title,,0,0,0,,{\fsp12\fs48\pos(969.6,446)}第10集 {\fsp12\fs58}\N 黃金與獅子
Dialogue: 0,0:00:28.63,0:00:28.63,STAFF,,0,0,0,,
Dialogue: 0,0:00:01.97,0:00:04.38,CHS,,0,0,0,,作戰中止 快撤
Dialogue: 0,0:00:04.38,0:00:05.48,CHS,,0,0,0,,重複一次
Dialogue: 0,0:00:05.48,0:00:07.56,CHS,,0,0,0,,作戰中止 快撤
Dialogue: 0,0:00:09.56,0:00:11.90,CHS,,0,0,0,,不是吧 約翰
Dialogue: 0,0:00:11.90,0:00:13.99,CHS,,0,0,0,,作戰中止 快撤
Dialogue: 0,0:00:14.20,0:00:15.99,CHS,,0,0,0,,作戰中止 快撤
Dialogue: 0,0:00:18.70,0:00:19.62,CHS,,0,0,0,,撤退
Dialogue: 0,0:00:21.03,0:00:22.41,CHS,,0,0,0,,所有人撤退
Dialogue: 0,0:00:36.63,0:00:38.84,CHS,,0,0,0,,混亂的殺人魔啊
Dialogue: 0,0:00:38.84,0:00:43.48,CHS,,0,0,0,,沒想到以人為對手 能發揮出這般力量
Dialogue: 0,0:00:44.29,0:00:46.45,CHS,,0,0,0,,以那般姿態出現的我
Dialogue: 0,0:00:47.19,0:00:49.43,CHS,,0,0,0,,你也稱之為人嗎
Dialogue: 0,0:00:49.43,0:00:52.46,CHS,,0,0,0,,外形樣貌 無關緊要
Dialogue: 0,0:00:52.46,0:00:54.65,CHS,,0,0,0,,我甚至不知你的名諱
Dialogue: 0,0:00:55.25,0:00:59.32,CHS,,0,0,0,,但我承諾 我會銘記方才一戰
Dialogue: 0,0:01:00.20,0:01:02.83,CHS,,0,0,0,,抱歉 御主
Dialogue: 0,0:02:41.22,0:02:44.34,CHS,,0,0,0,,你心中烙下的小紅帽
Dialogue: 0,0:02:44.80,0:02:46.72,CHS,,0,0,0,,讓我教你遺忘吧
Dialogue: 0,0:02:47.77,0:02:52.00,CHS,,0,0,0,,參加聖杯戰爭吧 沙條綾香
Dialogue: 0,0:02:52.69,0:02:56.76,CHS,,0,0,0,,除非妳想被小紅帽吞噬殆盡
Dialogue: 0,0:03:00.36,0:03:01.75,CHS,,0,0,0,,Saber
Dialogue: 0,0:03:22.55,0:03:24.62,CHS,,0,0,0,,躲起來吧 很危險
Dialogue: 0,0:03:24.62,0:03:25.76,CHS,,0,0,0,,不
Dialogue: 0,0:03:26.13,0:03:28.40,CHS,,0,0,0,,我既是英雄王的御主
Dialogue: 0,0:03:28.40,0:03:31.19,CHS,,0,0,0,,就有持續守望王的背影的義務
Dialogue: 0,0:03:35.07,0:03:38.78,CHS,,0,0,0,,我能觸及你的要素或許不多
Dialogue: 0,0:03:39.23,0:03:40.24,CHS,,0,0,0,,但是
Dialogue: 0,0:03:45.61,0:03:48.33,CHS,,0,0,0,,論速度 是我更快
Dialogue: 0,0:03:49.27,0:03:51.71,CHS,,0,0,0,,永恆遙遠的勝利之劍
Dialogue: 0,0:03:49.27,0:03:51.71,CHS - skill,,0,0,0,,Excalibur
Dialogue: 0,0:03:52.19,0:03:53.18,CHS,,0,0,0,,天真
Dialogue: 0,0:03:57.12,0:03:58.96,CHS,,0,0,0,,永恆遙遠的勝利之劍
Dialogue: 0,0:03:57.12,0:03:58.96,CHS - skill,,0,0,0,,Excalibur
Dialogue: 0,0:04:01.63,0:04:02.95,CHS,,0,0,0,,永恆遙遠的勝利之劍
Dialogue: 0,0:04:01.63,0:04:02.95,CHS - skill,,0,0,0,,Excalibur
Dialogue: 0,0:04:06.45,0:04:10.06,CHS,,0,0,0,,Excalibur
Dialogue: 0,0:04:11.93,0:04:13.19,CHS,,0,0,0,,混蛋
Dialogue: 0,0:04:16.81,0:04:24.55,CHS,,0,0,0,,Excalibur
Dialogue: 0,0:04:29.80,0:04:32.98,CHS,,0,0,0,,小姑娘 妳身體沒事嗎？
Dialogue: 0,0:04:32.98,0:04:36.75,CHS,,0,0,0,,啊 說起來 是有點無力
Dialogue: 0,0:04:37.63,0:04:39.29,CHS,,0,0,0,,有點…
Dialogue: 0,0:04:39.77,0:04:40.77,CHS,,0,0,0,,小姑娘
Dialogue: 0,0:04:42.77,0:04:45.23,CHS,,0,0,0,,妳是　什麼人？
Dialogue: 0,0:04:48.64,0:04:53.44,CHS,,0,0,0,,繰丘椿的房間 從這裡看是頂樓最右邊
Dialogue: 0,0:04:53.44,0:04:56.30,CHS,,0,0,0,,感謝 接下來交給我
Dialogue: 0,0:04:57.49,0:04:59.16,CHS,,0,0,0,,不 等等
Dialogue: 0,0:05:04.13,0:05:05.36,CHS,,0,0,0,,我也去
Dialogue: 0,0:05:13.99,0:05:16.92,CHS,,0,0,0,,不錯的判斷啊 小子
Dialogue: 0,0:05:17.96,0:05:21.94,CHS,,0,0,0,,若你敢將剛剛那位可愛的姑娘棄之不顧
Dialogue: 0,0:05:21.94,0:05:24.88,CHS,,0,0,0,,獨自撤退的話
Dialogue: 0,0:05:25.39,0:05:28.98,CHS,,0,0,0,,我定會挖出 擊碎 碾爛你的心臟
Dialogue: 0,0:05:28.98,0:05:30.52,CHS,,0,0,0,,與沙土混合
Dialogue: 0,0:05:30.52,0:05:34.60,CHS,,0,0,0,,撒遍養豬場的飼料槽
Dialogue: 0,0:05:36.10,0:05:39.25,CHS,,0,0,0,,但是 你也做了最差的判斷啊
Dialogue: 0,0:05:40.69,0:05:46.51,CHS,,0,0,0,,區區矮小的人類 竟想與我心愛的王同行
Dialogue: 0,0:05:46.51,0:05:49.49,CHS,,0,0,0,,我絕不允許
Dialogue: 0,0:05:50.62,0:05:54.43,CHS,,0,0,0,,纏繞黑劍 Zabani…
Dialogue: 0,0:05:56.03,0:05:57.54,CHS,,0,0,0,,捷斯塔·卡托雷
Dialogue: 0,0:05:58.23,0:06:02.03,CHS,,0,0,0,,你體內的子彈還剩下多少
Dialogue: 0,0:06:03.74,0:06:08.09,CHS,,0,0,0,,你這混蛋 從何得知我的資訊
Dialogue: 0,0:06:17.23,0:06:19.72,CHS,,0,0,0,,沒事吧 傑克先生？
Dialogue: 0,0:06:23.58,0:06:24.82,CHS,,0,0,0,,御主
Dialogue: 0,0:06:28.12,0:06:30.99,CHS,,0,0,0,,傳送了瀕死的從者嗎
Dialogue: 0,0:06:31.65,0:06:35.20,CHS,,0,0,0,,會在此地使用令咒的蠢貨 只有你了吧
Dialogue: 0,0:06:38.67,0:06:40.26,CHS,,0,0,0,,打倒那個人
Dialogue: 0,0:06:40.26,0:06:44.38,CHS,,0,0,0,,傑…Berserker 你的靈基能恢復嗎？
Dialogue: 0,0:06:44.38,0:06:46.60,CHS,,0,0,0,,沒關係了 叫我傑克就好
Dialogue: 0,0:06:46.60,0:06:48.65,CHS,,0,0,0,,你能看見吧？
Dialogue: 0,0:06:48.65,0:06:52.62,CHS,,0,0,0,,是 已經和靈基完全融合了
Dialogue: 0,0:06:52.62,0:06:56.42,CHS,,0,0,0,,像是在泥沼般的東西裡溶在一起了
Dialogue: 0,0:06:56.42,0:06:58.98,CHS,,0,0,0,,恐怕 即使打倒那個
Dialogue: 0,0:06:58.98,0:07:01.14,CHS,,0,0,0,,我的力量也不會恢復
Dialogue: 0,0:07:01.98,0:07:06.95,CHS,,0,0,0,,除非徹底消滅我 再從座上重新召喚
Dialogue: 0,0:07:06.95,0:07:09.39,CHS,,0,0,0,,但那樣的傑克先生
Dialogue: 0,0:07:09.39,0:07:11.58,CHS,,0,0,0,,就和現在是不同的人了吧
Dialogue: 0,0:07:14.49,0:07:15.49,CHS,,0,0,0,,且慢
Dialogue: 0,0:07:15.83,0:07:18.00,CHS,,0,0,0,,請停下 來者何人
Dialogue: 0,0:07:19.03,0:07:20.64,CHS,,0,0,0,,哎呀呀
Dialogue: 0,0:07:20.64,0:07:24.38,CHS,,0,0,0,,讓作家幹粗活 這算怎麼回事啊
Dialogue: 0,0:07:24.98,0:07:27.33,CHS,,0,0,0,,我的名字是 仲馬
Dialogue: 0,0:07:27.33,0:07:29.51,CHS,,0,0,0,,亞歷山大·仲馬
Dialogue: 0,0:07:29.51,0:07:31.02,CHS,,0,0,0,,沒聽過嗎？
Dialogue: 0,0:07:31.63,0:07:33.43,CHS,,0,0,0,,英靈為何自報真名？
Dialogue: 0,0:07:33.43,0:07:36.25,CHS,,0,0,0,,仲馬先生是哪位？
Dialogue: 0,0:07:36.25,0:07:38.06,CHS,,0,0,0,,拿破崙麾下的將軍
Dialogue: 0,0:07:38.06,0:07:39.93,CHS,,0,0,0,,還是「三劍客」的作者
Dialogue: 0,0:07:40.33,0:07:42.32,CHS,,0,0,0,,不 是「茶花女」那個…
Dialogue: 0,0:07:42.32,0:07:45.44,CHS,,0,0,0,,是後者 你不是很清楚嘛
Dialogue: 0,0:07:45.77,0:07:48.57,CHS,,0,0,0,,當然知道啊
Dialogue: 0,0:07:48.57,0:07:52.40,CHS,,0,0,0,,「三劍客」的電影 動畫 人偶劇我都看過
Dialogue: 0,0:07:52.40,0:07:54.32,CHS,,0,0,0,,那真是多謝了
Dialogue: 0,0:07:54.79,0:07:58.54,CHS,,0,0,0,,但是 你這小子 我有點不確定啊
Dialogue: 0,0:07:58.87,0:08:01.09,CHS,,0,0,0,,明明聊得起勁
Dialogue: 0,0:08:01.09,0:08:05.59,CHS,,0,0,0,,卻在我影子裡設下術式 真不愧是魔術師
Dialogue: 0,0:08:05.59,0:08:08.72,CHS,,0,0,0,,但是啊 即便術式完成
Dialogue: 0,0:08:08.72,0:08:12.02,CHS,,0,0,0,,卻還能接著聊「三劍客」
Dialogue: 0,0:08:12.02,0:08:13.63,CHS,,0,0,0,,這可不像是魔術師
Dialogue: 0,0:08:13.94,0:08:14.78,CHS,,0,0,0,,欸？
Dialogue: 0,0:08:14.78,0:08:19.15,CHS,,0,0,0,,因為 如果是敵人就很危險 所以設下了
Dialogue: 0,0:08:19.15,0:08:22.87,CHS,,0,0,0,,可是對不是敵人的人發動魔術 又浪費魔力了
Dialogue: 0,0:08:22.87,0:08:24.71,CHS,,0,0,0,,而且對你也不好
Dialogue: 0,0:08:26.75,0:08:28.83,CHS,,0,0,0,,小子 你呀
Dialogue: 0,0:08:28.83,0:08:30.57,CHS,,0,0,0,,雖不像魔術師
Dialogue: 0,0:08:31.27,0:08:37.32,CHS,,0,0,0,,但有為達目的 將自己性命投入鍋中的覺悟嗎？
Dialogue: 0,0:08:46.06,0:08:47.92,CHS,,0,0,0,,這並非蠻勇
Dialogue: 0,0:08:47.92,0:08:50.88,CHS,,0,0,0,,那是…
Dialogue: 0,0:08:56.65,0:08:58.18,CHS,,0,0,0,,還能動嗎？
Dialogue: 0,0:09:02.58,0:09:03.86,CHS,,0,0,0,,可笑
Dialogue: 0,0:09:13.41,0:09:16.78,CHS,,0,0,0,,魔術師 從地窖裡爬出來了嗎
Dialogue: 0,0:09:26.02,0:09:27.50,CHS,,0,0,0,,開 開始應對
Dialogue: 0,0:09:26.02,0:09:27.50,CHS - skill,,0,0,0,,Play Ball
Dialogue: 0,0:09:32.61,0:09:33.60,CHS,,0,0,0,,御主
Dialogue: 0,0:09:34.25,0:09:37.63,CHS,,0,0,0,,做還是不做 小子你給句痛快話
Dialogue: 0,0:09:38.05,0:09:39.62,CHS,,0,0,0,,開膛手傑克
Dialogue: 0,0:09:39.62,0:09:43.04,CHS,,0,0,0,,能成為任何人 是最佳的材料
Dialogue: 0,0:09:43.04,0:09:45.94,CHS,,0,0,0,,將那傢伙與你的存在混合
Dialogue: 0,0:09:45.94,0:09:48.85,CHS,,0,0,0,,便能暫時強化能力
Dialogue: 0,0:09:49.12,0:09:52.45,CHS,,0,0,0,,但是 與殺人鬼一同「熬煮」的御主
Dialogue: 0,0:09:52.45,0:09:56.07,CHS,,0,0,0,,會出現什麼副作用 我無法想像
Dialogue: 0,0:09:58.53,0:09:59.99,CHS,,0,0,0,,就這樣嗎？
Dialogue: 0,0:10:04.29,0:10:07.06,CHS,,0,0,0,,槍手們啊 挑戰風車吧
Dialogue: 0,0:10:04.29,0:10:07.06,CHS - skill,,0,0,0,,Musketeers' Masquerade\N
Dialogue: 0,0:10:04.29,0:10:07.06,CHS - an7,,0,0,0,,{\fs35}將對象的人生加入自己的體驗和創作進行「執筆·修訂」\N一次召喚之中只能使用規定次數的寶具。\N
Dialogue: 0,0:10:08.76,0:10:09.50,CHS,,0,0,0,,什麼
Dialogue: 0,0:10:14.91,0:10:17.34,CHS,,0,0,0,,開始介入
Dialogue: 0,0:10:14.91,0:10:17.34,CHS - skill,,0,0,0,,Game Select\N
Dialogue: 0,0:10:25.14,0:10:29.34,CHS,,0,0,0,,我以他身上從傑克先生那裡奪來的寶具之力為媒介
Dialogue: 0,0:10:29.34,0:10:32.73,CHS,,0,0,0,,注入了擾亂魔力流向的術式
Dialogue: 0,0:10:33.15,0:10:35.12,CHS,,0,0,0,,這怎麼可能
Dialogue: 0,0:10:35.12,0:10:36.90,CHS,,0,0,0,,不靠近到這個距離 是做不到的
Dialogue: 0,0:10:39.17,0:10:44.20,CHS,,0,0,0,,即便你變化為御主施加術式 結果也一樣
Dialogue: 0,0:10:44.20,0:10:48.80,CHS,,0,0,0,,為何 你的御主要冒險立於戰場？
Dialogue: 0,0:10:49.47,0:10:52.21,CHS,,0,0,0,,因為他有我無法擁有的東西
Dialogue: 0,0:10:52.48,0:10:56.96,CHS,,0,0,0,,Archer你的御主 已經用完令咒了吧？
Dialogue: 0,0:10:56.96,0:10:59.15,CHS,,0,0,0,,如果還剩下一劃
Dialogue: 0,0:10:59.15,0:11:02.18,CHS,,0,0,0,,那份連接的力量 應該會將我彈開
Dialogue: 0,0:11:02.18,0:11:05.12,CHS,,0,0,0,,竟有看透至此的眼嗎？
Dialogue: 0,0:11:05.12,0:11:06.49,CHS,,0,0,0,,但是 還沒完
Dialogue: 0,0:11:13.19,0:11:14.57,CHS,,0,0,0,,這 這樣下去…
Dialogue: 0,0:11:15.59,0:11:18.22,CHS,,0,0,0,,演員展現了勇氣
Dialogue: 0,0:11:18.22,0:11:22.20,CHS,,0,0,0,,我也想修正一下軌道了
Dialogue: 0,0:11:23.66,0:11:25.91,CHS,,0,0,0,,你們這樣的傢伙
Dialogue: 0,0:11:27.09,0:11:29.33,CHS,,0,0,0,,才該是英雄
Dialogue: 0,0:11:29.73,0:11:30.87,CHS,,0,0,0,,你是…
Dialogue: 0,0:11:32.08,0:11:32.91,CHS,,0,0,0,,約翰…
Dialogue: 0,0:12:05.27,0:12:06.87,CHS,,0,0,0,,觀測完成
Dialogue: 0,0:12:05.27,0:12:06.87,CHS - skill,,0,0,0,,Game Over\N
Dialogue: 0,0:12:07.91,0:12:10.41,CHS,,0,0,0,,你用了九頭蛇的毒液嗎？
Dialogue: 0,0:12:13.33,0:12:19.09,CHS,,0,0,0,,但你被賦予的力量 並非神的加護
Dialogue: 0,0:12:19.71,0:12:22.36,CHS,,0,0,0,,是人與大地所生的力量
Dialogue: 0,0:12:22.36,0:12:24.74,CHS,,0,0,0,,同胞啊 稱頌吧
Dialogue: 0,0:12:24.74,0:12:28.04,CHS,,0,0,0,,然後 哀悼吧 勇者啊
Dialogue: 0,0:12:28.91,0:12:31.26,CHS,,0,0,0,,我這汙濁之血
Dialogue: 0,0:12:31.73,0:12:35.19,CHS,,0,0,0,,我靈魂所懷抱的復仇之火
Dialogue: 0,0:12:36.10,0:12:39.90,CHS,,0,0,0,,豈是區區劇毒之物所能侵染
Dialogue: 0,0:12:44.03,0:12:45.91,CHS,,0,0,0,,這是要做什麼？
Dialogue: 0,0:12:48.47,0:12:50.44,CHS,,0,0,0,,妳是什麼人
Dialogue: 0,0:12:50.44,0:12:52.25,CHS,,0,0,0,,什麼意思
Dialogue: 0,0:12:52.25,0:12:57.04,CHS,,0,0,0,,能給予從者那般魔力量 這非比尋常
Dialogue: 0,0:12:57.04,0:13:01.27,CHS,,0,0,0,,至少也是一流的魔術師了
Dialogue: 0,0:13:02.21,0:13:04.24,CHS,,0,0,0,,你話是這麼說
Dialogue: 0,0:13:04.24,0:13:07.38,CHS,,0,0,0,,但我本來也不太懂魔力這東西…
Dialogue: 0,0:13:08.55,0:13:09.76,CHS,,0,0,0,,小姑娘
Dialogue: 0,0:13:10.45,0:13:12.66,CHS,,0,0,0,,妳是什麼人？
Dialogue: 0,0:13:16.92,0:13:20.69,CHS,,0,0,0,,本打算連教堂一併消滅的
Dialogue: 0,0:13:26.57,0:13:29.41,CHS,,0,0,0,,我對這東西的末路產生了興趣
Dialogue: 0,0:13:30.37,0:13:31.37,CHS,,0,0,0,,吉爾伽美什
Dialogue: 0,0:13:31.49,0:13:34.79,CHS,,0,0,0,,這是昔日 你對我做過的事
Dialogue: 0,0:13:35.95,0:13:39.17,CHS,,0,0,0,,是想守護這個場所嗎？
Dialogue: 0,0:13:39.45,0:13:42.00,CHS,,0,0,0,,雖應以狂妄誅之
Dialogue: 0,0:13:42.59,0:13:46.24,CHS,,0,0,0,,但你抵消了那一擊 值得褒獎
Dialogue: 0,0:13:48.53,0:13:51.81,CHS,,0,0,0,,深感榮幸
Dialogue: 0,0:14:00.75,0:14:02.48,CHS,,0,0,0,,Saber
Dialogue: 0,0:14:08.41,0:14:09.70,CHS,,0,0,0,,能贏
Dialogue: 0,0:14:09.70,0:14:12.87,CHS,,0,0,0,,能贏的 吉爾伽美什大人
Dialogue: 0,0:14:20.35,0:14:24.86,CHS,,0,0,0,,雜種 你體內蘊含著何物？
Dialogue: 0,0:14:25.64,0:14:27.76,CHS,,0,0,0,,在說什麼？
Dialogue: 0,0:14:28.59,0:14:31.45,CHS,,0,0,0,,不是說你那些隨從
Dialogue: 0,0:14:31.99,0:14:35.14,CHS,,0,0,0,,是你自身靈基根源的話題
Dialogue: 0,0:14:36.19,0:14:37.82,CHS,,0,0,0,,無論如何
Dialogue: 0,0:14:37.82,0:14:41.82,CHS,,0,0,0,,你似乎 尚未擁有戰鬥的理由
Dialogue: 0,0:14:42.50,0:14:46.15,CHS,,0,0,0,,以此等心境向我挑起戰端
Dialogue: 0,0:14:46.89,0:14:50.44,CHS,,0,0,0,,這才叫狂妄至極 雜種
Dialogue: 0,0:14:50.99,0:14:56.36,CHS,,0,0,0,,我將做出裁定 在此之前 有遺言嗎？
Dialogue: 0,0:14:57.15,0:15:00.16,CHS,,0,0,0,,我想說沒有 但是…
Dialogue: 0,0:15:00.53,0:15:01.63,CHS,,0,0,0,,是啊
Dialogue: 0,0:15:02.68,0:15:06.48,CHS,,0,0,0,,為我輸送魔力的姑娘 不是位御主
Dialogue: 0,0:15:06.93,0:15:10.96,CHS,,0,0,0,,只是我單方面榨取而已
Dialogue: 0,0:15:10.96,0:15:15.60,CHS,,0,0,0,,她並未與你敵對 請酌情處置
Dialogue: 0,0:15:16.12,0:15:17.34,CHS,,0,0,0,,好吧
Dialogue: 0,0:15:17.83,0:15:21.64,CHS,,0,0,0,,但若判明是無趣的存在 轟飛就是了
Dialogue: 0,0:15:22.48,0:15:25.18,CHS,,0,0,0,,與其餘烏合之眾並無二致
Dialogue: 0,0:15:26.11,0:15:29.07,CHS,,0,0,0,,雜種 對你的裁定是…
Dialogue: 0,0:15:33.30,0:15:34.74,CHS,,0,0,0,,不識趣的把戲…
Dialogue: 0,0:15:35.52,0:15:38.50,CHS,,0,0,0,,臨死之前 來做個了斷嗎？
Dialogue: 0,0:15:39.65,0:15:42.24,CHS,,0,0,0,,但那等程度的汙濁之泥
Dialogue: 0,0:15:42.24,0:15:45.00,CHS,,0,0,0,,你真以為能觸及我嗎？
Dialogue: 0,0:15:45.91,0:15:47.48,CHS,,0,0,0,,強大的王啊
Dialogue: 0,0:15:47.89,0:15:49.72,CHS,,0,0,0,,以及 弱小的戰士啊
Dialogue: 0,0:15:50.53,0:15:53.76,CHS,,0,0,0,,將你屠戮的 並非我那份汙濁
Dialogue: 0,0:15:53.76,0:15:54.68,CHS,,0,0,0,,哦？
Dialogue: 0,0:15:54.90,0:15:59.02,CHS,,0,0,0,,是沉溺於那泥沼的 屍骸
Dialogue: 0,0:15:59.02,0:16:02.94,CHS,,0,0,0,,偉大的敵人 亦是可悲之輩啊
Dialogue: 0,0:16:02.94,0:16:06.15,CHS,,0,0,0,,你也與我一同 狂舞吧
Dialogue: 0,0:16:06.74,0:16:08.36,CHS,,0,0,0,,射殺百頭
Dialogue: 0,0:16:06.74,0:16:08.36,CHS - skill,,0,0,0,,Nine lives\N
Dialogue: 0,0:16:06.74,0:16:08.36,CHS - an7,,0,0,0,,纏繞著災禍之黑泥的，將火焰、寒氣和雷電全部喰碎的巨大九頭毒蛇。\N
Dialogue: 0,0:16:15.60,0:16:18.12,CHS,,0,0,0,,就由我這雙手 親自檢定
Dialogue: 0,0:16:18.79,0:16:20.56,CHS,,0,0,0,,你的毛皮
Dialogue: 0,0:16:20.56,0:16:23.75,CHS,,0,0,0,,究竟 在多大程度上可視為人之業果
Dialogue: 0,0:16:36.20,0:16:37.96,CHS,,0,0,0,,九頭蛇的毒嗎
Dialogue: 0,0:16:38.43,0:16:41.14,CHS,,0,0,0,,那種程度的毒 我早已收入寶庫
Dialogue: 0,0:16:41.76,0:16:44.85,CHS,,0,0,0,,不愧是我王
Dialogue: 0,0:17:05.87,0:17:07.50,CHS,,0,0,0,,聖杯竟然
Dialogue: 0,0:17:07.85,0:17:10.46,CHS,,0,0,0,,能喚出此等存在嗎？
Dialogue: 0,0:17:19.53,0:17:20.18,CHS,,0,0,0,,欸？
Dialogue: 0,0:17:31.66,0:17:33.32,CHS,,0,0,0,,有礙事者闖入嗎？
Dialogue: 0,0:17:34.11,0:17:36.72,CHS,,0,0,0,,竟會迷失至此…
Dialogue: 0,0:17:37.57,0:17:41.12,CHS,,0,0,0,,妳啊 墮落至此等地步了嗎？
Dialogue: 0,0:17:41.43,0:17:43.90,CHS,,0,0,0,,豐收女神伊絲塔啊
Dialogue: 0,0:17:45.00,0:17:48.54,CHS,,0,0,0,,「墮落」 說得真難聽
Dialogue: 0,0:17:49.11,0:17:52.80,CHS,,0,0,0,,我所在的高處 從一開始就未曾改變
Dialogue: 0,0:17:53.41,0:17:58.01,CHS,,0,0,0,,只是你以為自己到達了我們之上罷了
Dialogue: 0,0:17:58.49,0:18:01.79,CHS,,0,0,0,,得意忘形 連御主都拋下
Dialogue: 0,0:18:01.79,0:18:05.54,CHS,,0,0,0,,聖杯戰爭沒那麼簡單
Dialogue: 0,0:18:05.54,0:18:08.35,CHS,,0,0,0,,沒有合作 你還想要獨自勝出
Dialogue: 0,0:18:08.78,0:18:11.86,CHS,,0,0,0,,話說 毒的劇痛還在吧？
Dialogue: 0,0:18:12.37,0:18:16.28,CHS,,0,0,0,,快滿地打滾 取悅我吧
Dialogue: 0,0:18:16.28,0:18:19.82,CHS,,0,0,0,,附於妳靈魂的 那份傲慢
Dialogue: 0,0:18:20.33,0:18:23.04,CHS,,0,0,0,,縱使千年也無法消弭嗎？
Dialogue: 0,0:18:23.04,0:18:27.45,CHS,,0,0,0,,竟讓我行走在那般潮濕的洞穴
Dialogue: 0,0:18:27.45,0:18:30.21,CHS,,0,0,0,,單此一項 便已罪該萬死
Dialogue: 0,0:18:31.07,0:18:32.63,CHS,,0,0,0,,洞穴？
Dialogue: 0,0:18:34.01,0:18:35.82,CHS,,0,0,0,,不過 託你的福
Dialogue: 0,0:18:35.82,0:18:40.05,CHS,,0,0,0,,我找到了能殺死你的頗有價值之物
Dialogue: 0,0:18:40.56,0:18:41.97,CHS,,0,0,0,,寶庫的鑰匙
Dialogue: 0,0:18:42.27,0:18:43.93,CHS,,0,0,0,,妳這傢伙…
Dialogue: 0,0:18:44.33,0:18:47.56,CHS,,0,0,0,,對普通人類來說 是用不上的東西
Dialogue: 0,0:18:48.12,0:18:49.90,CHS,,0,0,0,,但是 我嘛
Dialogue: 0,0:18:49.90,0:18:52.44,CHS,,0,0,0,,重新上一下鎖還是會的
Dialogue: 0,0:18:53.43,0:18:58.11,CHS,,0,0,0,,不窺視我財寶 就關閉了門扉嗎
Dialogue: 0,0:18:58.11,0:19:00.57,CHS,,0,0,0,,雖用墮落形容妳 但我需要更正一下
Dialogue: 0,0:19:01.08,0:19:03.95,CHS,,0,0,0,,妳可真是相當之謙遜了
Dialogue: 0,0:19:04.27,0:19:08.10,CHS,,0,0,0,,還是說 受了那容器的影響？
Dialogue: 0,0:19:08.10,0:19:09.86,CHS,,0,0,0,,並不是
Dialogue: 0,0:19:09.86,0:19:14.92,CHS,,0,0,0,,這身體 是為成為容器而被製造的人偶
Dialogue: 0,0:19:15.46,0:19:17.15,CHS,,0,0,0,,就像這孩子一樣
Dialogue: 0,0:19:18.31,0:19:21.36,CHS,,0,0,0,,竟是我看錯了嗎？
Dialogue: 0,0:19:21.36,0:19:26.68,CHS,,0,0,0,,並非本尊 而是劣化的殘響啊…
Dialogue: 0,0:19:27.50,0:19:29.82,CHS,,0,0,0,,我本想多玩玩的
Dialogue: 0,0:19:29.82,0:19:32.90,CHS,,0,0,0,,但再繼續下去 似乎會有點麻煩
Dialogue: 0,0:19:33.61,0:19:34.85,CHS,,0,0,0,,什麼？
Dialogue: 0,0:19:40.59,0:19:42.94,CHS,,0,0,0,,是詛咒本身嗎
Dialogue: 0,0:19:42.94,0:19:45.07,CHS,,0,0,0,,或許我該逃了
Dialogue: 0,0:19:45.07,0:19:47.45,CHS,,0,0,0,,我難得避開了你的要害
Dialogue: 0,0:19:47.45,0:19:49.96,CHS,,0,0,0,,你就帶著這份痛苦 苟延殘喘好了
Dialogue: 0,0:19:50.89,0:19:52.96,CHS,,0,0,0,,雖然想這麼說…
Dialogue: 0,0:19:53.87,0:19:58.34,CHS,,0,0,0,,我或許能原諒 但這孩子似乎不答應
Dialogue: 0,0:20:32.66,0:20:33.70,CHS,,0,0,0,,吉爾伽美什大人
Dialogue: 0,0:20:33.70,0:20:35.71,CHS,,0,0,0,,緹妮大人 危險！
Dialogue: 0,0:20:36.08,0:20:36.97,CHS,,0,0,0,,不
Dialogue: 0,0:20:37.81,0:20:38.67,CHS,,0,0,0,,不要…
Dialogue: 0,0:20:40.25,0:20:42.92,CHS,,0,0,0,,不要啊
Dialogue: 0,0:20:43.95,0:20:45.92,CHS,,0,0,0,,哎呀呀
Dialogue: 0,0:20:45.92,0:20:50.77,CHS,,0,0,0,,這樣下去 觀眾與舞台豈不都要燃盡了嗎？
Dialogue: 0,0:20:51.17,0:20:55.83,CHS,,0,0,0,,既然如此 由我親手落下帷幕吧
Dialogue: 0,0:20:56.89,0:20:59.11,CHS,,0,0,0,,這 可能不妙了
Dialogue: 0,0:21:03.70,0:21:04.84,CHS,,0,0,0,,Saber
Dialogue: 0,0:21:04.84,0:21:07.98,CHS,,0,0,0,,抱歉啊 綾香
Dialogue: 0,0:21:08.47,0:21:11.62,CHS,,0,0,0,,本想死守教堂的
Dialogue: 0,0:21:12.12,0:21:14.14,CHS,,0,0,0,,我有點搞砸了
Dialogue: 0,0:21:15.28,0:21:18.00,CHS,,0,0,0,,別說這些 快點處理傷口
Dialogue: 0,0:21:18.00,0:21:20.84,CHS,,0,0,0,,教堂這裡有繃帶什麼的嗎…
Dialogue: 0,0:21:20.84,0:21:25.00,CHS,,0,0,0,,妳呀 果然不是魔術師
Dialogue: 0,0:21:25.00,0:21:29.26,CHS,,0,0,0,,比起繃帶 妳的心意才是更好的草藥
Dialogue: 0,0:21:29.26,0:21:30.88,CHS,,0,0,0,,別開玩笑了
Dialogue: 0,0:21:34.50,0:21:36.88,CHS,,0,0,0,,不快點離開這裡的話…
Dialogue: 0,0:21:39.20,0:21:40.84,CHS,,0,0,0,,等等 等等
Dialogue: 0,0:21:40.84,0:21:43.58,CHS,,0,0,0,,讓我應該守護的民眾做那種事
Dialogue: 0,0:21:43.58,0:21:46.41,CHS,,0,0,0,,無論作為騎士還是王 都有辱名聲
Dialogue: 0,0:21:46.96,0:21:49.01,CHS,,0,0,0,,和我這種人在一起的時候
Dialogue: 0,0:21:49.01,0:21:51.41,CHS,,0,0,0,,你名聲早就一敗塗地啦
Dialogue: 0,0:21:51.93,0:21:53.78,CHS,,0,0,0,,好了 快點
Dialogue: 0,0:21:54.78,0:21:58.99,CHS,,0,0,0,,讓妳這樣貶低自己
Dialogue: 0,0:21:58.99,0:22:01.38,CHS,,0,0,0,,才是有辱我身為從者的名聲
Dialogue: 0,0:24:46.91,0:24:46.91,CHS,,0,0,0,,
Dialogue: 0,0:00:01.97,0:00:04.38,JPN,,0,0,0,,作戦中止　撤退しろ
Dialogue: 0,0:00:04.38,0:00:05.48,JPN,,0,0,0,,繰り返す
Dialogue: 0,0:00:05.48,0:00:07.56,JPN,,0,0,0,,作戦中止　撤退しろ
Dialogue: 0,0:00:09.56,0:00:11.90,JPN,,0,0,0,,ウソだろ　ジョン
Dialogue: 0,0:00:11.90,0:00:13.99,JPN,,0,0,0,,作戦中止　撤退しろ
Dialogue: 0,0:00:14.20,0:00:15.99,JPN,,0,0,0,,作戦中止　撤退しろ
Dialogue: 0,0:00:18.70,0:00:19.62,JPN,,0,0,0,,撤退しろっ
Dialogue: 0,0:00:21.03,0:00:22.41,JPN,,0,0,0,,総員　撤退を
Dialogue: 0,0:00:36.63,0:00:38.84,JPN,,0,0,0,,混沌たる殺人鬼よ
Dialogue: 0,0:00:38.84,0:00:43.48,JPN,,0,0,0,,人を相手に　ここまで力を振るえるとは思わなかったぞ
Dialogue: 0,0:00:44.29,0:00:46.45,JPN,,0,0,0,,人と呼んでくれるのかね
Dialogue: 0,0:00:47.19,0:00:49.43,JPN,,0,0,0,,あのような姿をとった私を
Dialogue: 0,0:00:49.43,0:00:52.46,JPN,,0,0,0,,姿形など　ささいなことよ
Dialogue: 0,0:00:52.46,0:00:54.65,JPN,,0,0,0,,私は貴様の名すら知らんが
Dialogue: 0,0:00:55.25,0:00:59.32,JPN,,0,0,0,,今の戦いだけは心に刻むと約束しよう
Dialogue: 0,0:01:00.20,0:01:02.83,JPN,,0,0,0,,すまない　マスター
Dialogue: 0,0:02:41.22,0:02:44.34,JPN,,0,0,0,,お前の中に焼き付けられた赤ずきん
Dialogue: 0,0:02:44.80,0:02:46.72,JPN,,0,0,0,,私が　薄れさせてやろう
Dialogue: 0,0:02:47.77,0:02:52.00,JPN,,0,0,0,,聖杯戦争に参加しろサジョウ・アヤカ
Dialogue: 0,0:02:52.69,0:02:56.76,JPN,,0,0,0,,赤ずきんに食らい尽くされたくなければな
Dialogue: 0,0:03:00.36,0:03:01.75,JPN,,0,0,0,,セイバー
Dialogue: 0,0:03:22.55,0:03:24.62,JPN,,0,0,0,,隠れましょう　危険です
Dialogue: 0,0:03:24.62,0:03:25.76,JPN,,0,0,0,,いえ
Dialogue: 0,0:03:26.13,0:03:28.40,JPN,,0,0,0,,英雄王のマスターである以上
Dialogue: 0,0:03:28.40,0:03:31.19,JPN,,0,0,0,,あの方の背中を見続ける義務があります
Dialogue: 0,0:03:35.07,0:03:38.78,JPN,,0,0,0,,俺にはあんたに届く要素は少ないかもな
Dialogue: 0,0:03:39.23,0:03:40.24,JPN,,0,0,0,,だが
Dialogue: 0,0:03:45.61,0:03:48.33,JPN,,0,0,0,,速さなら　俺が勝てる
Dialogue: 0,0:03:49.27,0:03:51.71,JPN,,0,0,0,,永久に遠き勝利の剣
Dialogue: 0,0:03:52.19,0:03:53.18,JPN,,0,0,0,,甘いわ
Dialogue: 0,0:03:57.12,0:03:58.96,JPN,,0,0,0,,永久に遠き勝利の剣
Dialogue: 0,0:04:01.63,0:04:02.93,JPN,,0,0,0,,永久に遠き勝利の剣
Dialogue: 0,0:04:06.45,0:04:10.06,JPN,,0,0,0,,エクスカリバー
Dialogue: 0,0:04:11.93,0:04:13.19,JPN,,0,0,0,,貴様
Dialogue: 0,0:04:16.81,0:04:24.55,JPN,,0,0,0,,エクスカリバーッ
Dialogue: 0,0:04:29.80,0:04:32.98,JPN,,0,0,0,,お嬢さん　体はなんともないのか
Dialogue: 0,0:04:32.98,0:04:36.75,JPN,,0,0,0,,ああ　そういえば　少しダルいかも
Dialogue: 0,0:04:37.63,0:04:39.29,JPN,,0,0,0,,少し
Dialogue: 0,0:04:39.77,0:04:40.77,JPN,,0,0,0,,お嬢さん
Dialogue: 0,0:04:42.77,0:04:45.23,JPN,,0,0,0,,君は　なんだ
Dialogue: 0,0:04:48.64,0:04:53.44,JPN,,0,0,0,,繰丘椿がいる部屋はこちらから見て最上階の右端だ
Dialogue: 0,0:04:53.44,0:04:56.30,JPN,,0,0,0,,感謝する　あとは私がやろう
Dialogue: 0,0:04:57.49,0:04:59.16,JPN,,0,0,0,,いや　待ってくれ
Dialogue: 0,0:05:04.13,0:05:05.36,JPN,,0,0,0,,俺も行こう
Dialogue: 0,0:05:13.99,0:05:16.92,JPN,,0,0,0,,いい判断をしたな　小僧
Dialogue: 0,0:05:17.96,0:05:21.94,JPN,,0,0,0,,もしも先刻かくも可憐な彼女を置いて
Dialogue: 0,0:05:21.94,0:05:24.88,JPN,,0,0,0,,一人で撤退するなどしていたら
Dialogue: 0,0:05:25.39,0:05:28.98,JPN,,0,0,0,,心臓をえぐり　砕いて　すり潰し
Dialogue: 0,0:05:28.98,0:05:30.52,JPN,,0,0,0,,砂と練り合わせて
Dialogue: 0,0:05:30.52,0:05:34.60,JPN,,0,0,0,,養豚場の餌箱にばらまくところだったよ
Dialogue: 0,0:05:36.10,0:05:39.25,JPN,,0,0,0,,だが　最悪な判断をしたなあ
Dialogue: 0,0:05:40.69,0:05:46.51,JPN,,0,0,0,,矮小な人間ごときが我が愛しの君と共に歩もうなど
Dialogue: 0,0:05:46.51,0:05:49.49,JPN,,0,0,0,,決して許されることではないわ
Dialogue: 0,0:05:50.62,0:05:54.43,JPN,,0,0,0,,黒剡を纏え　ザバーニー
Dialogue: 0,0:05:56.03,0:05:57.54,JPN,,0,0,0,,ジェスター・カルトゥーレ
Dialogue: 0,0:05:58.23,0:06:02.03,JPN,,0,0,0,,お前の中の弾丸はあといくつ残っている
Dialogue: 0,0:06:03.74,0:06:08.09,JPN,,0,0,0,,貴様どうやって私の情報を知った
Dialogue: 0,0:06:17.23,0:06:19.72,JPN,,0,0,0,,大丈夫ですか　ジャックさん
Dialogue: 0,0:06:23.58,0:06:24.82,JPN,,0,0,0,,マスター
Dialogue: 0,0:06:28.12,0:06:30.99,JPN,,0,0,0,,死にかけの英霊を転送したのか
Dialogue: 0,0:06:31.65,0:06:35.20,JPN,,0,0,0,,ここで令呪を使う愚か者は君だけだろうな
Dialogue: 0,0:06:38.67,0:06:40.26,JPN,,0,0,0,,あの人を倒せば
Dialogue: 0,0:06:40.26,0:06:44.38,JPN,,0,0,0,,ジャバーサーカーさんの霊基は戻りますか
Dialogue: 0,0:06:44.38,0:06:46.60,JPN,,0,0,0,,もう　ジャックで構わん
Dialogue: 0,0:06:46.60,0:06:48.65,JPN,,0,0,0,,君には見えているだろう
Dialogue: 0,0:06:48.65,0:06:52.62,JPN,,0,0,0,,はいもう完全に霊基が融合してます
Dialogue: 0,0:06:52.62,0:06:56.42,JPN,,0,0,0,,泥みたいなものの中で溶け合ってるみたいな
Dialogue: 0,0:06:56.42,0:06:58.98,JPN,,0,0,0,,恐らく　あれを倒しても
Dialogue: 0,0:06:58.98,0:07:01.14,JPN,,0,0,0,,私に力は戻らないだろう
Dialogue: 0,0:07:01.98,0:07:06.95,JPN,,0,0,0,,それこそ　一度消滅して座より再召喚でもされなければな
Dialogue: 0,0:07:06.95,0:07:09.39,JPN,,0,0,0,,でも　そのジャックさんは
Dialogue: 0,0:07:09.39,0:07:11.58,JPN,,0,0,0,,今とは別人なんですよね
Dialogue: 0,0:07:14.49,0:07:15.49,JPN,,0,0,0,,待て
Dialogue: 0,0:07:15.83,0:07:18.00,JPN,,0,0,0,,止まってもらおう　何者か
Dialogue: 0,0:07:19.03,0:07:20.64,JPN,,0,0,0,,やれやれ
Dialogue: 0,0:07:20.64,0:07:24.38,JPN,,0,0,0,,作家に肉体労働させるなって話だよな
Dialogue: 0,0:07:24.98,0:07:27.33,JPN,,0,0,0,,俺の名前はデュマだ
Dialogue: 0,0:07:27.33,0:07:29.51,JPN,,0,0,0,,アレクサンドル・デュマ
Dialogue: 0,0:07:29.51,0:07:31.02,JPN,,0,0,0,,聞いたことないか
Dialogue: 0,0:07:31.63,0:07:33.43,JPN,,0,0,0,,英霊がなぜ真名を
Dialogue: 0,0:07:33.43,0:07:36.25,JPN,,0,0,0,,デュデュマさんってどの
Dialogue: 0,0:07:36.25,0:07:38.06,JPN,,0,0,0,,ナポレオンの部下の将軍さん
Dialogue: 0,0:07:38.06,0:07:39.93,JPN,,0,0,0,,それとも三銃士の作者さん
Dialogue: 0,0:07:40.33,0:07:42.32,JPN,,0,0,0,,いや　椿姫のほう
Dialogue: 0,0:07:42.32,0:07:45.44,JPN,,0,0,0,,２番目だ　よく知ってるじゃねえか
Dialogue: 0,0:07:45.77,0:07:48.57,JPN,,0,0,0,,知ってるに決まってるじゃないですか
Dialogue: 0,0:07:48.57,0:07:52.40,JPN,,0,0,0,,俺　三銃士の映画もアニメも人形劇も見ました
Dialogue: 0,0:07:52.40,0:07:54.32,JPN,,0,0,0,,そりゃありがたいね
Dialogue: 0,0:07:54.79,0:07:58.54,JPN,,0,0,0,,しかし　坊主のことは少しはかりかねるな
Dialogue: 0,0:07:58.87,0:08:01.09,JPN,,0,0,0,,話に食いついときながら
Dialogue: 0,0:08:01.09,0:08:05.59,JPN,,0,0,0,,俺の影に術式を仕込むのはいかにも魔術師だ
Dialogue: 0,0:08:05.59,0:08:08.72,JPN,,0,0,0,,だがな　術式が完成しても
Dialogue: 0,0:08:08.72,0:08:12.02,JPN,,0,0,0,,そのまま三銃士の話で盛り上がるってのは
Dialogue: 0,0:08:12.02,0:08:13.63,JPN,,0,0,0,,魔術師らしくねえ
Dialogue: 0,0:08:13.94,0:08:14.78,JPN,,0,0,0,,え
Dialogue: 0,0:08:14.78,0:08:19.15,JPN,,0,0,0,,だって　もし敵だったら危ないと思って　仕込みましたけど
Dialogue: 0,0:08:19.15,0:08:22.87,JPN,,0,0,0,,敵じゃないのに発動させたら　魔力のムダ遣いだし
Dialogue: 0,0:08:22.87,0:08:24.71,JPN,,0,0,0,,あなたに悪いじゃないですか
Dialogue: 0,0:08:26.75,0:08:28.83,JPN,,0,0,0,,小僧　お前よ
Dialogue: 0,0:08:28.83,0:08:30.57,JPN,,0,0,0,,魔術師らしかねえが
Dialogue: 0,0:08:31.27,0:08:37.32,JPN,,0,0,0,,目的のために　自分の命を鍋にぶち込む覚悟はあるか
Dialogue: 0,0:08:46.06,0:08:47.92,JPN,,0,0,0,,蛮勇とは言うまい
Dialogue: 0,0:08:47.92,0:08:50.88,JPN,,0,0,0,,あ…　あれは
Dialogue: 0,0:08:56.65,0:08:58.18,JPN,,0,0,0,,まだ動けたか
Dialogue: 0,0:09:02.58,0:09:03.86,JPN,,0,0,0,,笑止
Dialogue: 0,0:09:13.41,0:09:16.78,JPN,,0,0,0,,魔術師め　穴蔵から出てきたか
Dialogue: 0,0:09:26.02,0:09:27.50,JPN,,0,0,0,,プ　対処開始
Dialogue: 0,0:09:32.61,0:09:33.60,JPN,,0,0,0,,マスター
Dialogue: 0,0:09:34.25,0:09:37.63,JPN,,0,0,0,,やるかどうかは　小僧に任せるがな
Dialogue: 0,0:09:38.05,0:09:39.62,JPN,,0,0,0,,ジャック・ザ・リッパー
Dialogue: 0,0:09:39.62,0:09:43.04,JPN,,0,0,0,,誰にでもなれるってのは最高の材料だ
Dialogue: 0,0:09:43.04,0:09:45.94,JPN,,0,0,0,,そいつと小僧の存在を混ぜることで
Dialogue: 0,0:09:45.94,0:09:48.85,JPN,,0,0,0,,能力を一時的に強化させられる
Dialogue: 0,0:09:49.12,0:09:52.45,JPN,,0,0,0,,だが　殺人鬼と煮詰めたマスターに
Dialogue: 0,0:09:52.45,0:09:56.07,JPN,,0,0,0,,どんな副作用があるかは想像もつかねえ
Dialogue: 0,0:09:58.53,0:09:59.99,JPN,,0,0,0,,それだけですか
Dialogue: 0,0:10:04.29,0:10:07.06,JPN,,0,0,0,,銃士達よ　風車に挑め
Dialogue: 0,0:10:08.76,0:10:09.50,JPN,,0,0,0,,なに
Dialogue: 0,0:10:14.91,0:10:17.34,JPN,,0,0,0,,介入開始
Dialogue: 0,0:10:25.14,0:10:29.34,JPN,,0,0,0,,ジャックさんから奪った宝具の力　その部分を介して
Dialogue: 0,0:10:29.34,0:10:32.73,JPN,,0,0,0,,魔力の流れを混乱させる術式を流し込みました
Dialogue: 0,0:10:33.15,0:10:35.12,JPN,,0,0,0,,そんなことできるわけ
Dialogue: 0,0:10:35.12,0:10:36.90,JPN,,0,0,0,,この距離まで近づかなきゃ無理でしたよ
Dialogue: 0,0:10:39.17,0:10:44.20,JPN,,0,0,0,,貴様がマスターに変化し術をかけても同じだろう
Dialogue: 0,0:10:44.20,0:10:48.80,JPN,,0,0,0,,何故　お前のマスターは危険を冒し戦場に立った
Dialogue: 0,0:10:49.47,0:10:52.21,JPN,,0,0,0,,私では持てぬものがあるからだ
Dialogue: 0,0:10:52.48,0:10:56.96,JPN,,0,0,0,,アーチャーさんのマスターさんもう令呪を使い切ってますよね
Dialogue: 0,0:10:56.96,0:10:59.15,JPN,,0,0,0,,もし一画でも残ってたら
Dialogue: 0,0:10:59.15,0:11:02.18,JPN,,0,0,0,,そのつながりの力にはじかれていたと思います
Dialogue: 0,0:11:02.18,0:11:05.12,JPN,,0,0,0,,そこまで見通す眼を持つか
Dialogue: 0,0:11:05.12,0:11:06.49,JPN,,0,0,0,,だが　まだだ
Dialogue: 0,0:11:13.19,0:11:14.57,JPN,,0,0,0,,こ　このままじゃ
Dialogue: 0,0:11:15.59,0:11:18.22,JPN,,0,0,0,,役者が勇気を見せたんだ
Dialogue: 0,0:11:18.22,0:11:22.20,JPN,,0,0,0,,俺も少しは筋道を直したくなるってもんだよな
Dialogue: 0,0:11:23.66,0:11:25.91,JPN,,0,0,0,,お前らみてえなヤツこそ
Dialogue: 0,0:11:27.09,0:11:29.33,JPN,,0,0,0,,英雄であるべきだ
Dialogue: 0,0:11:29.73,0:11:30.87,JPN,,0,0,0,,お前は
Dialogue: 0,0:11:32.08,0:11:32.91,JPN,,0,0,0,,ジョン
Dialogue: 0,0:12:05.27,0:12:06.87,JPN,,0,0,0,,観測完了
Dialogue: 0,0:12:07.91,0:12:10.41,JPN,,0,0,0,,ヒュドラの毒を行使したか
Dialogue: 0,0:12:13.33,0:12:19.09,JPN,,0,0,0,,だが　貴様に与えられた力は神の加護などではない
Dialogue: 0,0:12:19.71,0:12:22.36,JPN,,0,0,0,,人と地が生んだ力だ
Dialogue: 0,0:12:22.36,0:12:24.74,JPN,,0,0,0,,同胞よ　称賛しよう
Dialogue: 0,0:12:24.74,0:12:28.04,JPN,,0,0,0,,そして　哀れもう　勇者よ
Dialogue: 0,0:12:28.91,0:12:31.26,JPN,,0,0,0,,この汚れた私の血を
Dialogue: 0,0:12:31.73,0:12:35.19,JPN,,0,0,0,,我が魂が抱く復讐の炎を
Dialogue: 0,0:12:36.10,0:12:39.90,JPN,,0,0,0,,死毒程度のもので染められるものか
Dialogue: 0,0:12:44.03,0:12:45.91,JPN,,0,0,0,,何をしようってんだ
Dialogue: 0,0:12:48.47,0:12:50.44,JPN,,0,0,0,,君は何者だ
Dialogue: 0,0:12:50.44,0:12:52.25,JPN,,0,0,0,,どういう意味ですか
Dialogue: 0,0:12:52.25,0:12:57.04,JPN,,0,0,0,,あれほどの魔力を英霊に与えることができるというのは　尋常ではない
Dialogue: 0,0:12:57.04,0:13:01.27,JPN,,0,0,0,,少なくとも一流と呼ばれる魔術師でなければ
Dialogue: 0,0:13:02.21,0:13:04.24,JPN,,0,0,0,,そんなこと言われても
Dialogue: 0,0:13:04.24,0:13:07.38,JPN,,0,0,0,,魔力っていうのが　そもそもよく分からないし
Dialogue: 0,0:13:08.55,0:13:09.76,JPN,,0,0,0,,お嬢さん
Dialogue: 0,0:13:10.45,0:13:12.66,JPN,,0,0,0,,君はなんだ
Dialogue: 0,0:13:16.92,0:13:20.69,JPN,,0,0,0,,教会ごと消滅させるつもりだったのだがな
Dialogue: 0,0:13:26.57,0:13:29.41,JPN,,0,0,0,,これの末路に興味がわいた
Dialogue: 0,0:13:30.37,0:13:31.37,JPN,,0,0,0,,ギルガメッシュ
Dialogue: 0,0:13:31.49,0:13:34.79,JPN,,0,0,0,,かつて　お前が私にやったことだ
Dialogue: 0,0:13:35.95,0:13:39.17,JPN,,0,0,0,,この場を守ろうとでも思ったか
Dialogue: 0,0:13:39.45,0:13:42.00,JPN,,0,0,0,,思い上がりだと誅するべきだが
Dialogue: 0,0:13:42.59,0:13:46.24,JPN,,0,0,0,,あの一撃を相殺したことは褒めてやろう
Dialogue: 0,0:13:48.53,0:13:51.81,JPN,,0,0,0,,それは光栄だな
Dialogue: 0,0:14:00.75,0:14:02.48,JPN,,0,0,0,,セイバー
Dialogue: 0,0:14:08.41,0:14:09.70,JPN,,0,0,0,,勝てる
Dialogue: 0,0:14:09.70,0:14:12.87,JPN,,0,0,0,,勝てます　ギルガメッシュ様
Dialogue: 0,0:14:20.35,0:14:24.86,JPN,,0,0,0,,雑種　貴様　何を内包している
Dialogue: 0,0:14:25.64,0:14:27.76,JPN,,0,0,0,,なんの話だ
Dialogue: 0,0:14:28.59,0:14:31.45,JPN,,0,0,0,,貴様の供回りどもの話ではない
Dialogue: 0,0:14:31.99,0:14:35.14,JPN,,0,0,0,,貴様自身の霊基の源の話だ
Dialogue: 0,0:14:36.19,0:14:37.82,JPN,,0,0,0,,いずれにせよ
Dialogue: 0,0:14:37.82,0:14:41.82,JPN,,0,0,0,,貴様はまだ戦う理由を持ち合わせてはいないらしい
Dialogue: 0,0:14:42.50,0:14:46.15,JPN,,0,0,0,,かような心持ちのまま我に戦を挑むとは
Dialogue: 0,0:14:46.89,0:14:50.44,JPN,,0,0,0,,それこそ思い上がりも甚だしいぞ　雑種
Dialogue: 0,0:14:50.99,0:14:56.36,JPN,,0,0,0,,裁定を下すが　その前に言い残すことはあるか
Dialogue: 0,0:14:57.15,0:15:00.16,JPN,,0,0,0,,ないと言いたいところだが
Dialogue: 0,0:15:00.53,0:15:01.63,JPN,,0,0,0,,そうだな
Dialogue: 0,0:15:02.68,0:15:06.48,JPN,,0,0,0,,俺に魔力を回してくれた子はマスターじゃない
Dialogue: 0,0:15:06.93,0:15:10.96,JPN,,0,0,0,,俺が一方的に搾取してただけだ
Dialogue: 0,0:15:10.96,0:15:15.60,JPN,,0,0,0,,あんたに敵対したわけじゃないから　酌量してやってくれ
Dialogue: 0,0:15:16.12,0:15:17.34,JPN,,0,0,0,,いいだろう
Dialogue: 0,0:15:17.83,0:15:21.64,JPN,,0,0,0,,だがつまらぬ存在と分かれば消し飛ばすまでのこと
Dialogue: 0,0:15:22.48,0:15:25.18,JPN,,0,0,0,,ほかの有象無象と何も変わらん
Dialogue: 0,0:15:26.11,0:15:29.07,JPN,,0,0,0,,雑種　貴様への裁定は
Dialogue: 0,0:15:33.30,0:15:34.74,JPN,,0,0,0,,不粋な真似を
Dialogue: 0,0:15:35.52,0:15:38.50,JPN,,0,0,0,,死に絶える前に決着をつけに来たか
Dialogue: 0,0:15:39.65,0:15:42.24,JPN,,0,0,0,,だがその程度の汚れた泥
Dialogue: 0,0:15:42.24,0:15:45.00,JPN,,0,0,0,,我にはらえぬとでも思ったか
Dialogue: 0,0:15:45.91,0:15:47.48,JPN,,0,0,0,,強き王よ
Dialogue: 0,0:15:47.89,0:15:49.72,JPN,,0,0,0,,そして弱き戦士よ
Dialogue: 0,0:15:50.53,0:15:53.76,JPN,,0,0,0,,貴様を屠るのはその汚れではない
Dialogue: 0,0:15:53.76,0:15:54.68,JPN,,0,0,0,,ほう
Dialogue: 0,0:15:54.90,0:15:59.02,JPN,,0,0,0,,その泥に溺れる屍だ
Dialogue: 0,0:15:59.02,0:16:02.94,JPN,,0,0,0,,偉大なる敵にして哀れなる輩よ
Dialogue: 0,0:16:02.94,0:16:06.15,JPN,,0,0,0,,貴様も我が狂奔と共に踊るがいい
Dialogue: 0,0:16:06.74,0:16:08.36,JPN,,0,0,0,,射殺す百頭
Dialogue: 0,0:16:15.60,0:16:18.12,JPN,,0,0,0,,この我が手ずから査定してやろう
Dialogue: 0,0:16:18.79,0:16:20.56,JPN,,0,0,0,,貴様の毛皮が
Dialogue: 0,0:16:20.56,0:16:23.75,JPN,,0,0,0,,果たしてどこまでを人の業と見なすのかをな
Dialogue: 0,0:16:36.20,0:16:37.96,JPN,,0,0,0,,ヒュドラの毒か
Dialogue: 0,0:16:38.43,0:16:41.14,JPN,,0,0,0,,その程度の毒は貯蔵済みよ
Dialogue: 0,0:16:41.76,0:16:44.85,JPN,,0,0,0,,さすがでございます　我が王よ
Dialogue: 0,0:17:05.87,0:17:07.50,JPN,,0,0,0,,聖杯とは
Dialogue: 0,0:17:07.85,0:17:10.46,JPN,,0,0,0,,ここまでのものを喚べるものなのか
Dialogue: 0,0:17:19.53,0:17:20.18,JPN,,0,0,0,,え
Dialogue: 0,0:17:31.66,0:17:33.32,JPN,,0,0,0,,邪魔が入ったか
Dialogue: 0,0:17:34.11,0:17:36.72,JPN,,0,0,0,,まさか迷い出るとはな
Dialogue: 0,0:17:37.57,0:17:41.12,JPN,,0,0,0,,貴様そこまで堕ちていたか
Dialogue: 0,0:17:41.43,0:17:43.90,JPN,,0,0,0,,豊穣の女神イシュタルよ
Dialogue: 0,0:17:45.00,0:17:48.54,JPN,,0,0,0,,堕ちたなんて　ひどい物言いね
Dialogue: 0,0:17:49.11,0:17:52.80,JPN,,0,0,0,,私がいる高みは最初から変わっていないわ
Dialogue: 0,0:17:53.41,0:17:58.01,JPN,,0,0,0,,あなたが私たちより　上り詰めたと思い込んでいるだけ
Dialogue: 0,0:17:58.49,0:18:01.79,JPN,,0,0,0,,調子に乗って　マスターも置いてきちゃって
Dialogue: 0,0:18:01.79,0:18:05.54,JPN,,0,0,0,,聖杯戦争は共闘なくして勝ち抜けるほど
Dialogue: 0,0:18:05.54,0:18:08.35,JPN,,0,0,0,,甘いものじゃないって知ってるでしょ
Dialogue: 0,0:18:08.78,0:18:11.86,JPN,,0,0,0,,っていうか　毒の激痛はまだ
Dialogue: 0,0:18:12.37,0:18:16.28,JPN,,0,0,0,,さっさと転げ回って　私を笑わせなさいよ
Dialogue: 0,0:18:16.28,0:18:19.82,JPN,,0,0,0,,貴様の魂に貼り付いたその傲慢
Dialogue: 0,0:18:20.33,0:18:23.04,JPN,,0,0,0,,千年単位でも消えぬとは
Dialogue: 0,0:18:23.04,0:18:27.45,JPN,,0,0,0,,私にあんなジメジメした洞窟を歩かせるなんて
Dialogue: 0,0:18:27.45,0:18:30.21,JPN,,0,0,0,,それだけで　万死に値するところよ
Dialogue: 0,0:18:31.07,0:18:32.63,JPN,,0,0,0,,洞窟
Dialogue: 0,0:18:34.01,0:18:35.82,JPN,,0,0,0,,まっ　おかげで
Dialogue: 0,0:18:35.82,0:18:40.05,JPN,,0,0,0,,あなたを殺すための有意義なものが見つかったんだけど
Dialogue: 0,0:18:40.56,0:18:41.97,JPN,,0,0,0,,宝物庫の鍵
Dialogue: 0,0:18:42.27,0:18:43.93,JPN,,0,0,0,,貴様
Dialogue: 0,0:18:44.33,0:18:47.56,JPN,,0,0,0,,ただの人間には使いみちのない物よね
Dialogue: 0,0:18:48.12,0:18:49.90,JPN,,0,0,0,,でも私なら
Dialogue: 0,0:18:49.90,0:18:52.44,JPN,,0,0,0,,鍵を掛け直すことぐらいはできるわ
Dialogue: 0,0:18:53.43,0:18:58.11,JPN,,0,0,0,,我の財に目をくらませる前に扉を閉じるとは
Dialogue: 0,0:18:58.11,0:19:00.57,JPN,,0,0,0,,堕ちたと言ったが訂正しよう
Dialogue: 0,0:19:01.08,0:19:03.95,JPN,,0,0,0,,随分と殊勝になったではないか
Dialogue: 0,0:19:04.27,0:19:08.10,JPN,,0,0,0,,それともその器にでも影響されたか
Dialogue: 0,0:19:08.10,0:19:09.86,JPN,,0,0,0,,それはないわね
Dialogue: 0,0:19:09.86,0:19:14.92,JPN,,0,0,0,,この体器になるためだけに作られた類いの人形だもの
Dialogue: 0,0:19:15.46,0:19:17.15,JPN,,0,0,0,,この子みたいにね
Dialogue: 0,0:19:18.31,0:19:21.36,JPN,,0,0,0,,我としたことが見誤ったか
Dialogue: 0,0:19:21.36,0:19:26.68,JPN,,0,0,0,,本人ではなく劣化した残響とはな
Dialogue: 0,0:19:27.50,0:19:29.82,JPN,,0,0,0,,もっと遊びたかったけれど
Dialogue: 0,0:19:29.82,0:19:32.90,JPN,,0,0,0,,これ以上は少し面倒なことになりそうね
Dialogue: 0,0:19:33.61,0:19:34.85,JPN,,0,0,0,,なに
Dialogue: 0,0:19:40.59,0:19:42.94,JPN,,0,0,0,,呪いそのものなのかしら
Dialogue: 0,0:19:42.94,0:19:45.07,JPN,,0,0,0,,逃げたほうがいいかもね
Dialogue: 0,0:19:45.07,0:19:47.45,JPN,,0,0,0,,せっかく急所は避けたんだし
Dialogue: 0,0:19:47.45,0:19:49.96,JPN,,0,0,0,,できるだけ長く苦しみなさい
Dialogue: 0,0:19:50.89,0:19:52.96,JPN,,0,0,0,,って言いたいところだけど
Dialogue: 0,0:19:53.87,0:19:58.34,JPN,,0,0,0,,私は許してもこの子は許せないみたいね
Dialogue: 0,0:20:32.66,0:20:33.70,JPN,,0,0,0,,ギルガメッシュ様
Dialogue: 0,0:20:33.70,0:20:35.71,JPN,,0,0,0,,ティーネ様　危険です
Dialogue: 0,0:20:36.08,0:20:36.97,JPN,,0,0,0,,いや
Dialogue: 0,0:20:37.81,0:20:38.67,JPN,,0,0,0,,いや
Dialogue: 0,0:20:40.25,0:20:42.92,JPN,,0,0,0,,いやあああっ
Dialogue: 0,0:20:43.95,0:20:45.92,JPN,,0,0,0,,やれやれ
Dialogue: 0,0:20:45.92,0:20:50.77,JPN,,0,0,0,,このままでは　観客も舞台も全て燃え尽きてしまうではないか
Dialogue: 0,0:20:51.17,0:20:55.83,JPN,,0,0,0,,ならば　自らの手で閉幕してしまおう
Dialogue: 0,0:20:56.89,0:20:59.11,JPN,,0,0,0,,これヤバいかもです
Dialogue: 0,0:21:03.70,0:21:04.84,JPN,,0,0,0,,セイバー
Dialogue: 0,0:21:04.84,0:21:07.98,JPN,,0,0,0,,ああ　悪いな　アヤカ
Dialogue: 0,0:21:08.47,0:21:11.62,JPN,,0,0,0,,教会は守り通すつもりだったんだが
Dialogue: 0,0:21:12.12,0:21:14.14,JPN,,0,0,0,,ちょっとだけしくじった
Dialogue: 0,0:21:15.28,0:21:18.00,JPN,,0,0,0,,いいから早くケガの手当てを
Dialogue: 0,0:21:18.00,0:21:20.84,JPN,,0,0,0,,教会なら包帯か何か
Dialogue: 0,0:21:20.84,0:21:25.00,JPN,,0,0,0,,君はつくづく魔術師じゃあないんだな
Dialogue: 0,0:21:25.00,0:21:29.26,JPN,,0,0,0,,包帯より　君の気持ちのほうがいい薬草だ
Dialogue: 0,0:21:29.26,0:21:30.88,JPN,,0,0,0,,冗談はやめて
Dialogue: 0,0:21:34.50,0:21:36.88,JPN,,0,0,0,,早くここから出ないと
Dialogue: 0,0:21:39.20,0:21:40.84,JPN,,0,0,0,,待った待った
Dialogue: 0,0:21:40.84,0:21:43.58,JPN,,0,0,0,,守るべき民にそんなことをさせたら
Dialogue: 0,0:21:43.58,0:21:46.41,JPN,,0,0,0,,騎士としても王としても名折れだ
Dialogue: 0,0:21:46.96,0:21:49.01,JPN,,0,0,0,,私なんかと一緒にいる時点で
Dialogue: 0,0:21:49.01,0:21:51.41,JPN,,0,0,0,,とっくに名前なんか折れっぱなしだよ
Dialogue: 0,0:21:51.93,0:21:53.78,JPN,,0,0,0,,いいから早く
Dialogue: 0,0:21:54.78,0:21:58.99,JPN,,0,0,0,,君にそうやって自分を卑下させてしまうのは
Dialogue: 0,0:21:58.99,0:22:01.38,JPN,,0,0,0,,英霊としての名折れだ
Dialogue: 0,0:23:39.31,0:23:39.44,CHS,,0,0,0,,
Dialogue: 0,0:01:18.84,0:01:20.08,OPJP-01 Special,,0,0,0,,幻惑の対価
Dialogue: 0,0:01:18.84,0:01:20.08,OPCN-01 Special,,0,0,0,,幻惑帶來的代價
Dialogue: 0,0:01:20.08,0:01:20.80,OPJP-01 Special,,0,0,0,,Chya don't get it
Dialogue: 0,0:01:20.08,0:01:20.80,OPCN-01 Special,,0,0,0,,你根本就不懂
Dialogue: 0,0:01:20.80,0:01:22.29,OPJP-01 Special,,0,0,0,,絶命か GIFT かの脅威
Dialogue: 0,0:01:20.80,0:01:22.29,OPCN-01 Special,,0,0,0,,這威脅 是殺意還是饋贈？
Dialogue: 0,0:01:22.29,0:01:24.62,OPJP-01 Special,,0,0,0,,甘んじて受けるか？ that they tag you with
Dialogue: 0,0:01:22.29,0:01:24.62,OPCN-01 Special,,0,0,0,,貼給你的標籤 你就甘願忍受？
Dialogue: 0,0:01:24.62,0:01:26.95,OPJP-01 Special,,0,0,0,,So go face what's coming and don't ask why
Dialogue: 0,0:01:24.62,0:01:26.95,OPCN-01 Special,,0,0,0,,去面對接下來的一切 不問緣由
Dialogue: 0,0:01:26.95,0:01:28.61,OPJP-01 Special,,0,0,0,,度外視のfake が牽強付会
Dialogue: 0,0:01:26.95,0:01:28.61,OPCN-01 Special,,0,0,0,,小小贗品聖杯 實在牽強附會
Dialogue: 0,0:01:28.61,0:01:30.18,OPJP-01 Special,,0,0,0,,I'm always getting your back
Dialogue: 0,0:01:28.61,0:01:30.18,OPCN-01 Special,,0,0,0,,我會永遠站在你身後
Dialogue: 0,0:01:30.18,0:01:31.43,OPJP-01 Special,,0,0,0,,But now you got to grip the trigger
Dialogue: 0,0:01:30.18,0:01:31.43,OPCN-01 Special,,0,0,0,,但如今 需要你時刻攥緊扳機
Dialogue: 0,0:01:31.43,0:01:32.14,OPJP-01 Special,,0,0,0,,翻す深紅
Dialogue: 0,0:01:31.43,0:01:32.14,OPCN-01 Special,,0,0,0,,深紅的鮮血翻湧
Dialogue: 0,0:01:32.14,0:01:33.68,OPJP-01 Special,,0,0,0,,Come on! Show me how you think!
Dialogue: 0,0:01:32.14,0:01:33.68,OPCN-01 Special,,0,0,0,,是時候 說出你的想法
Dialogue: 0,0:01:33.68,0:01:36.23,OPJP-01 Special,,0,0,0,,繋げ さもなくば低コントラストの善悪
Dialogue: 0,0:01:33.68,0:01:36.23,OPCN-01 Special,,0,0,0,,投身其中 去辨明一個個善惡
Dialogue: 0,0:01:36.23,0:01:38.40,OPJP-01 Special,,0,0,0,,懺悔を吐けば 骰子次第
Dialogue: 0,0:01:36.23,0:01:38.40,OPCN-01 Special,,0,0,0,,別著急懺悔 先丟骰子試試運氣
Dialogue: 0,0:01:38.40,0:01:47.78,OPJP-01 Special,,0,0,0,,Just like all the rest?
Dialogue: 0,0:01:38.40,0:01:47.78,OPCN-01 Special,,0,0,0,,和其餘人一樣？
Dialogue: 0,0:01:48.82,0:01:50.03,OPJP-01 Special,,0,0,0,,Go take some cover
Dialogue: 0,0:01:48.82,0:01:50.03,OPCN-01 Special,,0,0,0,,去掩體後面躲好了
Dialogue: 0,0:01:50.03,0:01:52.04,OPJP-01 Special,,0,0,0,,Butchya gotta break out to be the brat
Dialogue: 0,0:01:50.03,0:01:52.04,OPCN-01 Special,,0,0,0,,可還需要你殺出重圍 拆了他們的台
Dialogue: 0,0:01:52.04,0:01:54.54,OPJP-01 Special,,0,0,0,,Cuz ya tired of being just a copycat
Dialogue: 0,0:01:52.04,0:01:54.54,OPCN-01 Special,,0,0,0,,我猜你也不願意就當個跟屁蟲
Dialogue: 0,0:01:54.54,0:01:58.12,OPJP-01 Special,,0,0,0,,Feel the blues チラつく筋書き乱す飢渇を feedback
Dialogue: 0,0:01:54.54,0:01:58.12,OPCN-01 Special,,0,0,0,,體味憂鬱 填滿若有若無的飢渴 別壞了這場大戲
Dialogue: 0,0:01:58.12,0:01:59.46,OPJP-01 Special,,0,0,0,,Duck and cover
Dialogue: 0,0:01:58.12,0:01:59.46,OPCN-01 Special,,0,0,0,,蹲下 掩蔽
Dialogue: 0,0:01:59.46,0:02:00.87,OPJP-01 Special,,0,0,0,,Butchya gotta bite back
Dialogue: 0,0:01:59.46,0:02:00.87,OPCN-01 Special,,0,0,0,,然後來個反戈一擊
Dialogue: 0,0:02:00.87,0:02:02.00,OPJP-01 Special,,0,0,0,,This ain't chitchat
Dialogue: 0,0:02:00.87,0:02:02.00,OPCN-01 Special,,0,0,0,,沒有和你胡謅
Dialogue: 0,0:02:02.00,0:02:03.96,OPJP-01 Special,,0,0,0,,Cuz ya tired of being just a copycat
Dialogue: 0,0:02:02.00,0:02:03.96,OPCN-01 Special,,0,0,0,,我猜你也不願意就當個跟屁蟲
Dialogue: 0,0:02:03.96,0:02:07.46,OPJP-01 Special,,0,0,0,,Cuts and bruises 超俗した次元の契約を刻む
Dialogue: 0,0:02:03.96,0:02:07.46,OPCN-01 Special,,0,0,0,,割出血 擦破皮 刻下那份超凡入聖的契約
Dialogue: 0,0:02:07.46,0:02:08.64,OPJP-01 Special,,0,0,0,,Fist emblazoned
Dialogue: 0,0:02:07.46,0:02:08.64,OPCN-01 Special,,0,0,0,,然後留下一記拳痕
Dialogue: 0,0:02:08.64,0:02:11.01,OPJP-01 Special,,0,0,0,,Don't pretend to be someone you're not cuz you feel
Dialogue: 0,0:02:08.64,0:02:11.01,OPCN-01 Special,,0,0,0,,別是一時心血來潮 就想將自己裝成他人
Dialogue: 0,0:02:11.01,0:02:13.18,OPJP-01 Special,,0,0,0,,攻め込んだ in check なぎ倒した Knight
Dialogue: 0,0:02:11.01,0:02:13.18,OPCN-01 Special,,0,0,0,,步步為營來掌控全局 用一隻騎士橫掃千軍
Dialogue: 0,0:02:13.18,0:02:16.14,OPJP-01 Special,,0,0,0,,Today's not the day for you to die
Dialogue: 0,0:02:13.18,0:02:16.14,OPCN-01 Special,,0,0,0,,“今天不是你的死期”
Dialogue: 0,0:02:16.14,0:02:18.28,OPJP-01 Special,,0,0,0,,The drifting phantoms 下す采配
Dialogue: 0,0:02:16.14,0:02:18.28,OPCN-01 Special,,0,0,0,,是那遊蕩的幽靈 給你下的命令
Dialogue: 0,0:02:18.28,0:02:19.40,OPJP-01 Special,,0,0,0,,Don't pretend to be trapped
Dialogue: 0,0:02:18.28,0:02:19.40,OPCN-01 Special,,0,0,0,,擺出一副走投無路的樣子
Dialogue: 0,0:02:19.40,0:02:20.73,OPJP-01 Special,,0,0,0,,You can always appeal
Dialogue: 0,0:02:19.40,0:02:20.73,OPCN-01 Special,,0,0,0,,其實求援的機會多得是
Dialogue: 0,0:02:20.73,0:02:22.82,OPJP-01 Special,,0,0,0,,無抵抗に匙を投げる tech はない
Dialogue: 0,0:02:20.73,0:02:22.82,OPCN-01 Special,,0,0,0,,從來沒有這種技巧 說還沒抵抗就繳械投降
Dialogue: 0,0:02:22.82,0:02:24.98,OPJP-01 Special,,0,0,0,,So cast all your spells up in the sky
Dialogue: 0,0:02:22.82,0:02:24.98,OPCN-01 Special,,0,0,0,,向著天空 傾瀉你的咒語
Dialogue: 0,0:02:24.98,0:02:27.36,OPJP-01 Special,,0,0,0,,Judge his master 破滅問う原罪
Dialogue: 0,0:02:24.98,0:02:27.36,OPCN-01 Special,,0,0,0,,對他的御主降下審判 用毀滅詰問他的罪責
Dialogue: 0,0:02:27.36,0:02:29.81,OPJP-01 Special,,0,0,0,,Don't pretend to be someone you're not cuz you feel
Dialogue: 0,0:02:27.36,0:02:29.81,OPCN-01 Special,,0,0,0,,別是一時心血來潮 就想將自己裝成他人
Dialogue: 0,0:02:29.81,0:02:32.16,OPJP-01 Special,,0,0,0,,攻め込んだ in check なぎ倒した Knight
Dialogue: 0,0:02:29.81,0:02:32.16,OPCN-01 Special,,0,0,0,,步步為營來掌控全局 用一隻騎士橫掃千軍
Dialogue: 0,0:02:32.16,0:02:34.24,OPJP-01 Special,,0,0,0,,Today's not the day for you to die
Dialogue: 0,0:02:32.16,0:02:34.24,OPCN-01 Special,,0,0,0,,“今天不是你的死期”
Dialogue: 0,0:02:34.24,0:02:36.37,OPJP-01 Special,,0,0,0,,The drifting phantoms 下す采配
Dialogue: 0,0:02:34.24,0:02:36.37,OPCN-01 Special,,0,0,0,,是那遊蕩的幽靈 給你下的命令
Dialogue: 0,0:22:12.03,0:22:15.32,EDCN-02,,0,0,0,,{\blur5}內心深處瘋狂的自我啊
Dialogue: 0,0:22:15.32,0:22:18.94,EDCN-02,,0,0,0,,{\blur5}別再隱藏自己的想法 還要客氣就真的可惜了
Dialogue: 0,0:22:18.94,0:22:22.07,EDCN-02,,0,0,0,,{\blur5}內心深處被揭穿的自我啊
Dialogue: 0,0:22:22.07,0:22:25.94,EDCN-02,,0,0,0,,{\blur5}跳起舞來 去點綴我們的故事吧
Dialogue: 0,0:22:33.04,0:22:34.60,EDCN-02,,0,0,0,,{\blur5}妄想自己無敵 結果大敗一場
Dialogue: 0,0:22:34.60,0:22:36.59,EDCN-02,,0,0,0,,{\blur5}一陣迷糊後疲憊感襲來
Dialogue: 0,0:22:36.59,0:22:38.13,EDCN-02,,0,0,0,,{\blur5}是亂七八糟 還是真實寫照
Dialogue: 0,0:22:38.13,0:22:40.14,EDCN-02,,0,0,0,,{\blur5}疲憊不堪卻還要去比較 有什麼意義
Dialogue: 0,0:22:40.14,0:22:42.52,EDCN-02,,0,0,0,,{\blur5}信了一些陳詞濫調的空談
Dialogue: 0,0:22:42.52,0:22:44.60,EDCN-02,,0,0,0,,{\blur5}心裡比誰都平靜
Dialogue: 0,0:22:44.60,0:22:46.97,EDCN-02,,0,0,0,,{\blur5}多一事不如少一事 結果還是失眠
Dialogue: 0,0:22:46.97,0:22:50.58,EDCN-02,,0,0,0,,{\blur5\fad(271,0)}這樣下去 人生得一路變廢為寶了
Dialogue: 0,0:22:50.58,0:22:54.41,EDCN-02,,0,0,0,,{\blur5}日子都被玩弄於股掌之間
Dialogue: 0,0:22:54.41,0:22:57.56,EDCN-02,,0,0,0,,{\blur5}可是全人類都知道 要靠什麼
Dialogue: 0,0:22:57.56,0:23:01.02,EDCN-02,,0,0,0,,{\blur5}才能逃離這種控制
Dialogue: 0,0:23:01.02,0:23:04.13,EDCN-02,,0,0,0,,{\blur5}那就是 內心深處瘋狂的自我
Dialogue: 0,0:23:04.13,0:23:07.90,EDCN-02,,0,0,0,,{\blur5\fad(0,200)}別再隱藏自己的想法 還要客氣就真的可惜了
Dialogue: 0,0:23:07.90,0:23:11.20,EDCN-02,,0,0,0,,{\blur5\fad(200,0)}用一般的理論還不知道呢
Dialogue: 0,0:23:11.20,0:23:15.08,EDCN-02,,0,0,0,,{\blur5}每次眨眼都很重要 我只為你展現這個自我
Dialogue: 0,0:23:15.08,0:23:17.06,EDCN-02,,0,0,0,,{\blur5}圍成一個圈 盡情歡樂吧
Dialogue: 0,0:23:17.06,0:23:18.46,EDCN-02,,0,0,0,,{\blur5}然後放大音量 盡情高喊吧
Dialogue: 0,0:23:18.46,0:23:21.92,EDCN-02,,0,0,0,,{\blur5}別忘記去享受當下
Dialogue: 0,0:23:21.92,0:23:24.96,EDCN-02,,0,0,0,,{\blur5}內心深處被揭穿的自我
Dialogue: 0,0:23:24.96,0:23:29.76,EDCN-02,,0,0,0,,{\blur5}其實最為真實
Dialogue: 0,0:23:30.64,0:23:34.60,EDCN-02,,0,0,0,,{\blur5}內心深處的自我啊
Dialogue: 0,0:22:12.03,0:22:15.32,EDJP-02,,0,0,0,,{\blur5\pos(1877,35)}潜在的狂乱のアイ
Dialogue: 0,0:22:15.32,0:22:18.94,EDJP-02,,0,0,0,,{\blur5}手の内隠さないで　遠慮は勿体ない
Dialogue: 0,0:22:18.94,0:22:22.07,EDJP-02,,0,0,0,,{\blur5}潜在的暴かれるアイ
Dialogue: 0,0:22:22.07,0:22:25.94,EDJP-02,,0,0,0,,{\blur5}踊りだして彩られてくストーリー
Dialogue: 0,0:22:33.04,0:22:34.60,EDJP-02,,0,0,0,,{\blur5}無双幻想で大敗
Dialogue: 0,0:22:34.60,0:22:36.59,EDJP-02,,0,0,0,,{\blur5}曖昧　倦怠で渋滞
Dialogue: 0,0:22:36.59,0:22:38.13,EDJP-02,,0,0,0,,{\blur5}ひっちゃかめっちゃか等身大
Dialogue: 0,0:22:38.13,0:22:40.14,EDJP-02,,0,0,0,,{\blur5}もうしんどい並べてどうすんだい？
Dialogue: 0,0:22:40.14,0:22:42.52,EDJP-02,,0,0,0,,{\blur5}ありきたりな卓論に飲まれちゃって
Dialogue: 0,0:22:42.52,0:22:44.60,EDJP-02,,0,0,0,,{\blur5}極度な心頭滅却
Dialogue: 0,0:22:44.60,0:22:46.97,EDJP-02,,0,0,0,,{\blur5}事勿れな現状　不眠で症
Dialogue: 0,0:22:46.97,0:22:50.58,EDJP-02,,0,0,0,,{\blur5\fad(271,0)}このままじゃ　彼方まで我楽多
Dialogue: 0,0:22:50.58,0:22:54.41,EDJP-02,,0,0,0,,{\blur5}手のひらで操られる毎日
Dialogue: 0,0:22:54.41,0:22:57.56,EDJP-02,,0,0,0,,{\blur5}抜け出す為に　欠かせないもの
Dialogue: 0,0:22:57.56,0:23:01.02,EDJP-02,,0,0,0,,{\blur5}全人類備えてる
Dialogue: 0,0:23:01.02,0:23:04.13,EDJP-02,,0,0,0,,{\blur5}潜在的狂乱のアイ
Dialogue: 0,0:23:04.13,0:23:07.90,EDJP-02,,0,0,0,,{\blur5\fad(0,200)}手の内隠さないで　遠慮は勿体ない
Dialogue: 0,0:23:07.90,0:23:11.20,EDJP-02,,0,0,0,,{\blur5\fad(200,0)}一般論でははかれまい
Dialogue: 0,0:23:11.20,0:23:15.08,EDJP-02,,0,0,0,,{\blur5}瞬き肝心　アナタだけのアイ
Dialogue: 0,0:23:15.08,0:23:17.06,EDJP-02,,0,0,0,,{\blur5}騒ごうよ輪になって
Dialogue: 0,0:23:17.06,0:23:18.46,EDJP-02,,0,0,0,,{\blur5}鳴らそうよ声張って
Dialogue: 0,0:23:18.46,0:23:21.92,EDJP-02,,0,0,0,,{\blur5}楽しむ事を忘れないで
Dialogue: 0,0:23:21.92,0:23:24.96,EDJP-02,,0,0,0,,{\blur5}潜在的暴かれたアイ
Dialogue: 0,0:23:24.96,0:23:29.76,EDJP-02,,0,0,0,,{\blur5}それが真実　潜在的なアイ
Dialogue: 0,0:23:30.64,0:23:34.60,EDJP-02,,0,0,0,,{\blur5}潜在的なアイ
Dialogue: 0,0:24:46.91,0:24:49.91,CHS,,0,0,0,,

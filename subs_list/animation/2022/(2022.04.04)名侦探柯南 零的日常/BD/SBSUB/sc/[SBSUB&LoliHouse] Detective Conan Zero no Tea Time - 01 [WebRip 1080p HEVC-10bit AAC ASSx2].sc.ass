Dialogue: 0,0:00:27.84,0:00:28.46,DefaultSingle-S,,0,0,0,,	3
Dialogue: 0,0:00:29.46,0:00:29.92,DefaultSingle-S,,0,0,0,,	2
Dialogue: 0,0:00:30.84,0:00:31.34,DefaultSingle-S,,0,0,0,,	1
Dialogue: 0,0:00:32.38,0:00:32.84,DefaultSingle-S,,0,0,0,,	0
Dialogue: 0,0:02:50.56,0:02:51.44,DefaultSingle-S,,0,0,0,,	好
Dialogue: 0,0:03:27.64,0:03:29.68,DefaultSingle-S,,0,0,0,,	今天的最高气温是？
Dialogue: 0,0:03:30.39,0:03:30.85,DefaultSingle-S,,0,0,0,,	嗯
Dialogue: 0,0:03:31.35,0:03:34.90,DefaultSingle-S,,0,0,0,,	多做一些冷萃咖啡吧
Dialogue: 0,0:03:37.94,0:03:39.82,DefaultSingle-S,,0,0,0,,	早上好
Dialogue: 0,0:03:39.90,0:03:41.57,DefaultSingle-S,,0,0,0,,	早上好  梓小姐
Dialogue: 0,0:03:43.16,0:03:45.07,DefaultSingle-S,,0,0,0,,	你来得好早啊  安室先生
Dialogue: 0,0:03:45.83,0:03:47.62,DefaultSingle-S,,0,0,0,,	我也是刚到
Dialogue: 0,0:03:57.80,0:03:58.67,DefaultSingle-S,,0,0,0,,	小梓
Dialogue: 0,0:03:59.21,0:04:01.01,DefaultSingle-S,,0,0,0,,	我想追加点单
Dialogue: 0,0:04:01.34,0:04:02.80,DefaultSingle-S,,0,0,0,,	好的  马上来
Dialogue: 0,0:04:08.06,0:04:10.06,DefaultSingle-S,,0,0,0,,	绿小姐  欢迎光临
Dialogue: 0,0:04:10.48,0:04:11.35,DefaultSingle-S,,0,0,0,,	欢迎光临
Dialogue: 0,0:04:14.44,0:04:16.02,DefaultSingle-S,,0,0,0,,	不好意思  安室先生
Dialogue: 0,0:04:16.06,0:04:18.32,DefaultSingle-S,,0,0,0,,	抱歉在你这么忙的时候来麻烦你
Dialogue: 0,0:04:18.32,0:04:19.44,DefaultSingle-S,,0,0,0,,	要和平常一样的…
Dialogue: 0,0:04:19.57,0:04:20.74,DefaultSingle-S,,0,0,0,,	火腿三明治吧
Dialogue: 0,0:04:20.90,0:04:22.32,DefaultSingle-S,,0,0,0,,	是的  还有…
Dialogue: 0,0:04:22.36,0:04:23.78,DefaultSingle-S,,0,0,0,,	冰咖啡吗
Dialogue: 0,0:04:23.91,0:04:24.41,DefaultSingle-S,,0,0,0,,	是的
Dialogue: 0,0:04:24.74,0:04:26.41,DefaultSingle-S,,0,0,0,,	我和妃律师两个人的
Dialogue: 0,0:04:26.62,0:04:28.28,DefaultSingle-S,,0,0,0,,	可以打包吗
Dialogue: 0,0:04:30.29,0:04:31.29,DefaultSingle-S,,0,0,0,,	当然可以
Dialogue: 0,0:04:36.13,0:04:39.09,DefaultSingle-S,,0,0,0,,	绿小姐  你还是那么忙啊
Dialogue: 0,0:04:39.46,0:04:40.51,DefaultSingle-S,,0,0,0,,	你也是
Dialogue: 0,0:04:40.67,0:04:42.09,DefaultSingle-S,,0,0,0,,	我们那也很忙
Dialogue: 0,0:04:42.17,0:04:45.26,DefaultSingle-S,,0,0,0,,	不过  为了更新妃律师的不败记录
Dialogue: 0,0:04:45.26,0:04:46.68,DefaultSingle-S,,0,0,0,,	我也得多多努力
Dialogue: 0,0:04:46.89,0:04:47.51,DefaultSingle-S,,0,0,0,,	是呀
Dialogue: 0,0:04:47.51,0:04:48.68,DefaultSingle-S,,0,0,0,,	服务员
Dialogue: 0,0:04:48.68,0:04:49.26,DefaultSingle-S,,0,0,0,,	来了
Dialogue: 0,0:04:51.39,0:04:52.81,DefaultSingle-S,,0,0,0,,	让您久等了
Dialogue: 0,0:04:53.43,0:04:56.56,DefaultSingle-S,,0,0,0,,	请问  今天的甜点是…
Dialogue: 0,0:04:56.56,0:04:58.19,DefaultSingle-S,,0,0,0,,	我看看  今天的是…
Dialogue: 0,0:04:59.61,0:05:01.07,DefaultSingle-S,,0,0,0,,	久等了
Dialogue: 0,0:05:01.19,0:05:02.74,DefaultSingle-S,,0,0,0,,	这么快就好了吗
Dialogue: 0,0:05:02.90,0:05:04.03,DefaultSingle-S,,0,0,0,,	谢谢你
Dialogue: 0,0:05:04.20,0:05:04.61,DefaultSingle-S,,0,0,0,,	给
Dialogue: 0,0:05:05.40,0:05:07.49,DefaultSingle-S,,0,0,0,,	刚刚好  多谢
Dialogue: 0,0:05:09.20,0:05:10.58,DefaultSingle-S,,0,0,0,,	我走了
Dialogue: 0,0:05:11.66,0:05:12.58,DefaultSingle-S,,0,0,0,,	请加油
Dialogue: 0,0:05:14.00,0:05:15.46,DefaultSingle-S,,0,0,0,,	谢谢惠顾
Dialogue: 0,0:05:27.93,0:05:30.35,DefaultSingle-S,,0,0,0,,	今天很多人点冰咖啡啊
Dialogue: 0,0:05:30.89,0:05:32.56,DefaultSingle-S,,0,0,0,,	你知道吗  安室先生
Dialogue: 0,0:05:32.97,0:05:37.56,DefaultSingle-S,,0,0,0,,	初春气温超过23度  夏季气温超过30度时
Dialogue: 0,0:05:37.56,0:05:40.65,DefaultSingle-S,,0,0,0,,	关东人就会更偏爱冰咖啡  而不是热咖啡
Dialogue: 0,0:05:40.82,0:05:42.32,DefaultSingle-S,,0,0,0,,	是这样啊
Dialogue: 0,0:05:43.03,0:05:45.11,DefaultSingle-S,,0,0,0,,	是老板告诉我的
Dialogue: 0,0:05:45.95,0:05:46.82,DefaultSingle-S,,0,0,0,,	确实
Dialogue: 0,0:05:46.95,0:05:49.24,DefaultSingle-S,,0,0,0,,	今天这种会出一点汗的天气
Dialogue: 0,0:05:49.41,0:05:51.24,DefaultSingle-S,,0,0,0,,	我也会想喝冰咖啡
Dialogue: 0,0:05:52.58,0:05:54.12,DefaultSingle-S,,0,0,0,,	我来洗盘子了
Dialogue: 0,0:05:55.54,0:05:58.71,DefaultSingle-S,,0,0,0,,	你怎么了  梓小姐  遇到什么好事了吗
Dialogue: 0,0:06:00.00,0:06:02.09,DefaultSingle-S,,0,0,0,,	没什么
Dialogue: 0,0:06:02.46,0:06:03.80,DefaultSingle-S,,0,0,0,,	毕竟正值换季
Dialogue: 0,0:06:04.26,0:06:06.88,DefaultSingle-S,,0,0,0,,	我好像快感冒了  喉咙不太舒服
Dialogue: 0,0:06:07.38,0:06:09.84,DefaultSingle-S,,0,0,0,,	不过进入店里之后就舒服了
Dialogue: 0,0:06:10.05,0:06:11.55,DefaultSingle-S,,0,0,0,,	太好了
Dialogue: 0,0:06:12.31,0:06:15.43,DefaultSingle-S,,0,0,0,,	这都是多亏了你的好品行
Dialogue: 0,0:06:16.14,0:06:17.85,DefaultSingle-S,,0,0,0,,	安室先生  这可不行
Dialogue: 0,0:06:18.35,0:06:21.27,DefaultSingle-S,,0,0,0,,	身为侦探  想事情就要有理有据
Dialogue: 0,0:06:22.57,0:06:23.69,DefaultSingle-S,,0,0,0,,	你说得对
Dialogue: 0,0:06:25.15,0:06:28.24,DefaultSingle-S,,0,0,0,,	看来得让毛利老师更严格地教导我才行
Dialogue: 0,0:06:31.66,0:06:32.74,DefaultSingle-S,,0,0,0,,	欢迎光临
Dialogue: 0,0:06:34.95,0:06:36.25,DefaultSingle-S,,0,0,0,,	鹤山婆婆
Dialogue: 0,0:06:37.00,0:06:40.92,DefaultSingle-S,,0,0,0,,	中午都快过了  还有这么多客人啊
Dialogue: 0,0:06:41.54,0:06:43.34,DefaultSingle-S,,0,0,0,,	您常坐的位置没有人坐哦
Dialogue: 0,0:06:43.46,0:06:44.59,DefaultSingle-S,,0,0,0,,	谢谢你
Dialogue: 0,0:06:46.01,0:06:49.22,DefaultSingle-S,,0,0,0,,	您是要常点的三明治拼盘和热咖啡吗
Dialogue: 0,0:06:50.43,0:06:53.10,DefaultSingle-S,,0,0,0,,	或者今天有点热  要换成冰咖啡吗
Dialogue: 0,0:06:53.30,0:06:54.72,DefaultSingle-S,,0,0,0,,	我想想
Dialogue: 0,0:06:56.77,0:06:57.93,DefaultSingle-S,,0,0,0,,	只要凉白开吗
Dialogue: 0,0:06:58.31,0:07:00.27,DefaultSingle-S,,0,0,0,,	是的  不知道是怎么了
Dialogue: 0,0:07:00.60,0:07:02.94,DefaultSingle-S,,0,0,0,,	婆婆来得也比平时要晚
Dialogue: 0,0:07:03.31,0:07:05.90,DefaultSingle-S,,0,0,0,,	她明明很喜欢波洛的咖啡  今天却…
Dialogue: 0,0:07:10.57,0:07:12.37,DefaultSingle-S,,0,0,0,,	梓小姐  麻烦你了
Dialogue: 0,0:07:14.49,0:07:16.95,DefaultSingle-S,,0,0,0,,	让您久等了  这是三明治拼盘
Dialogue: 0,0:07:18.75,0:07:22.21,DefaultSingle-S,,0,0,0,,	真懂事啊  居然换成了温开水
Dialogue: 0,0:07:22.63,0:07:27.30,DefaultSingle-S,,0,0,0,,	我今天是从医院回来的  想在这里吃药
Dialogue: 0,0:07:27.80,0:07:29.72,DefaultSingle-S,,0,0,0,,	我刚才跟你说过吗
Dialogue: 0,0:07:30.51,0:07:32.05,DefaultSingle-S,,0,0,0,,	给你们添麻烦了
Dialogue: 0,0:07:32.05,0:07:33.05,DefaultSingle-S,,0,0,0,,	不会的
Dialogue: 0,0:07:33.43,0:07:36.22,DefaultSingle-S,,0,0,0,,	椅子坐着也很舒服  谢谢
Dialogue: 0,0:07:36.56,0:07:37.39,DefaultSingle-S,,0,0,0,,	请慢用
Dialogue: 0,0:07:39.60,0:07:41.10,DefaultSingle-S,,0,0,0,,	温开水？椅子？
Dialogue: 0,0:07:49.90,0:07:51.24,DefaultSingle-S,,0,0,0,,	多谢款待
Dialogue: 0,0:07:51.49,0:07:52.95,DefaultSingle-S,,0,0,0,,	谢谢惠顾
Dialogue: 0,0:07:59.04,0:07:59.95,DefaultSingle-S,,0,0,0,,	安室先生
Dialogue: 0,0:08:00.29,0:08:02.08,DefaultSingle-S,,0,0,0,,	工作餐吃意面可以吗
Dialogue: 0,0:08:02.29,0:08:03.42,DefaultSingle-S,,0,0,0,,	谢谢
Dialogue: 0,0:08:05.13,0:08:06.25,DefaultSingle-S,,0,0,0,,	麻烦少做一点
Dialogue: 0,0:08:07.88,0:08:11.17,DefaultSingle-S,,0,0,0,,	其实  我早上尝试做了新的甜点
Dialogue: 0,0:08:12.26,0:08:14.89,DefaultSingle-S,,0,0,0,,	梓小姐  能请你也试吃一下吗
Dialogue: 0,0:08:15.14,0:08:15.76,DefaultSingle-S,,0,0,0,,	好的
Dialogue: 0,0:08:16.60,0:08:19.85,DefaultSingle-S,,0,0,0,,	只有一片面包  就尝尝味道而已
Dialogue: 0,0:08:20.35,0:08:23.31,DefaultSingle-S,,0,0,0,,	安室先生  你早餐习惯吃面包的吗
Dialogue: 0,0:08:23.44,0:08:25.02,DefaultSingle-S,,0,0,0,,	为什么会这么认为呢
Dialogue: 0,0:08:25.40,0:08:28.11,DefaultSingle-S,,0,0,0,,	看你的外表  就那么觉得了
Dialogue: 0,0:08:28.27,0:08:29.82,DefaultSingle-S,,0,0,0,,	毕竟是一头金发
Dialogue: 0,0:08:31.19,0:08:35.28,DefaultSingle-S,,0,0,0,,	不思考得更深一点  可不叫有理有据哦
Dialogue: 0,0:08:36.41,0:08:38.87,DefaultSingle-S,,0,0,0,,	我又不是侦探
Dialogue: 0,0:08:42.29,0:08:43.58,DefaultSingle-S,,0,0,0,,	很好吃的样子
Dialogue: 0,0:08:44.12,0:08:45.00,DefaultSingle-S,,0,0,0,,	请用
Dialogue: 0,0:08:45.75,0:08:48.84,DefaultSingle-S,,0,0,0,,	虽然不会推理  不过做意面就交给我吧
Dialogue: 0,0:08:49.84,0:08:52.30,DefaultSingle-S,,0,0,0,,	不过  你会不会很辛苦啊
Dialogue: 0,0:08:54.13,0:08:57.26,DefaultSingle-S,,0,0,0,,	波洛的兼职  毛利老师的徒弟
Dialogue: 0,0:08:57.26,0:08:59.35,DefaultSingle-S,,0,0,0,,	还有侦探这个本职工作
Dialogue: 0,0:08:59.51,0:09:03.52,DefaultSingle-S,,0,0,0,,	都不是一心二用  而是一心三用了
Dialogue: 0,0:09:05.56,0:09:06.77,DefaultSingle-S,,0,0,0,,	很开心的
Dialogue: 0,0:09:08.61,0:09:10.19,DefaultSingle-S,,0,0,0,,	毕竟都是学习
Dialogue: 0,0:09:11.07,0:09:13.24,DefaultSingle-S,,0,0,0,,	都是为了实现同一个目标
Dialogue: 0,0:09:17.49,0:09:20.28,DefaultSingle-S,,0,0,0,,	毛利老师的事务所  今天也很闹腾啊
Dialogue: 0,0:09:20.70,0:09:24.25,DefaultSingle-S,,0,0,0,,	相比之下  波洛算是平和无事
Dialogue: 0,0:09:26.12,0:09:28.25,DefaultSingle-S,,0,0,0,,	安室先生  你要喝冰咖啡吗
Dialogue: 0,0:09:29.92,0:09:30.34,DefaultSingle-S,,0,0,0,,	好的
Dialogue: 0,0:09:32.88,0:09:33.96,DefaultSingle-S,,0,0,0,,	我就不客气了
Dialogue: 0,0:09:42.35,0:09:43.93,DefaultSingle-S,,0,0,0,,	冰咖啡两杯
Dialogue: 0,0:09:44.64,0:09:46.89,DefaultSingle-S,,0,0,0,,	刚好卖完
Dialogue: 0,0:09:59.95,0:10:00.53,DefaultSingle-S,,0,0,0,,	风见
Dialogue: 0,0:10:01.33,0:10:03.29,DefaultSingle-S,,0,0,0,,	右手再放松一点
Dialogue: 0,0:10:03.83,0:10:04.54,DefaultSingle-S,,0,0,0,,	降谷先生
Dialogue: 0,0:10:05.04,0:10:09.08,DefaultSingle-S,,0,0,0,,	举枪时  惯用手出三成力气  另一只手出七成力气
Dialogue: 0,0:10:09.67,0:10:11.71,DefaultSingle-S,,0,0,0,,	姿势模仿拳击手
Dialogue: 0,0:10:11.79,0:10:13.88,DefaultSingle-S,,0,0,0,,	重心下沉  身体略微前倾
Dialogue: 0,0:10:15.01,0:10:17.01,DefaultSingle-S,,0,0,0,,	都有些偏左啊
Dialogue: 0,0:10:17.93,0:10:20.30,DefaultSingle-S,,0,0,0,,	枪支的日常保养做了吗
Dialogue: 0,0:10:20.72,0:10:21.14,DefaultSingle-S,,0,0,0,,	做了
Dialogue: 0,0:10:21.68,0:10:24.64,DefaultSingle-S,,0,0,0,,	要是一周不保养  准头就会变差
Dialogue: 0,0:10:25.56,0:10:26.48,DefaultSingle-S,,0,0,0,,	再来一次
Dialogue: 0,0:10:27.18,0:10:27.60,DefaultSingle-S,,0,0,0,,	是
Dialogue: 0,0:10:37.90,0:10:40.20,DefaultSingle-S,,0,0,0,,	你快看  降谷先…
Dialogue: 0,0:10:41.45,0:10:42.37,DefaultSingle-S,,0,0,0,,	降谷先生…
Dialogue: 0,0:11:14.90,0:11:17.36,DefaultSingle-S,,0,0,0,,	不过  你会不会很辛苦啊
Dialogue: 0,0:11:19.78,0:11:22.91,DefaultSingle-S,,0,0,0,,	波洛的兼职  毛利老师的徒弟
Dialogue: 0,0:11:22.91,0:11:25.03,DefaultSingle-S,,0,0,0,,	还有侦探这个本职工作
Dialogue: 0,0:11:25.16,0:11:29.12,DefaultSingle-S,,0,0,0,,	都不是一心二用  而是一心三用了
Dialogue: 0,0:11:35.59,0:11:37.00,DefaultSingle-S,,0,0,0,,	如果是原本的我
Dialogue: 0,0:11:40.34,0:11:44.47,DefaultSingle-S,,0,0,0,,	何止是三重面孔  一百重面孔我都能完美扮演
Dialogue: 0,0:11:49.27,0:11:50.14,DefaultSingle-S,,0,0,0,,	我总是在想
Dialogue: 0,0:11:52.02,0:11:53.52,DefaultSingle-S,,0,0,0,,	赤井秀一
Dialogue: 0,0:11:57.69,0:12:01.15,DefaultSingle-S,,0,0,0,,	要是能忘记你该多好

Dialogue: 0,0:02:17.49,0:02:22.75,F,,0,108,148,,{\fad(500,500)\an3\fn方正中雅宋_GBK\fs60\fsp3\bord0\blur2\t(0,500,\blur0)\shad3\c&HFFFFFF&\4c&H8B8A86&}第6話 必須決定的事
Dialogue: 1,0:00:01.53,0:00:03.98,F,,0,0,0,,嗯  是的
Dialogue: 1,0:00:04.40,0:00:05.90,F,,0,0,0,,就是你…
Dialogue: 1,0:00:05.90,0:00:08.68,F,,0,0,0,,最熟悉的人
Dialogue: 1,0:00:22.79,0:00:24.89,F,,0,0,0,,那時真琴的表情…
Dialogue: 1,0:00:26.14,0:00:28.95,F,,0,0,0,,果然還是不該說的
Dialogue: 1,0:00:31.37,0:00:33.17,F,,0,0,0,,燒退了嗎
Dialogue: 1,0:00:34.16,0:00:36.42,F,,0,0,0,,你出場方式能不能正常點
Dialogue: 1,0:00:36.42,0:00:39.51,F,,0,0,0,,我想你一整天待在家裡應該閒得發慌吧
Dialogue: 1,0:00:39.51,0:00:42.02,F,,0,0,0,,會傳染的  你出去吧
Dialogue: 1,0:00:42.02,0:00:44.02,F,,0,0,0,,小真來了哦
Dialogue: 1,0:00:45.73,0:00:46.42,F,,0,0,0,,欸
Dialogue: 1,0:02:19.07,0:02:21.53,F,,0,800,0,,龍二  你身體好了嗎
Dialogue: 1,0:02:21.53,0:02:23.99,F,,0,800,0,,嗯  差不多吧
Dialogue: 1,0:02:23.99,0:02:26.62,F,,0,0,0,,你別被傳染感冒了
Dialogue: 1,0:02:26.62,0:02:28.07,F,,0,0,0,,嗯  謝謝
Dialogue: 1,0:02:29.95,0:02:31.88,F,,0,0,0,,小夏也很可靠呢
Dialogue: 1,0:02:32.69,0:02:34.87,F,,0,0,0,,這是果凍  高興的話就嚐嚐吧
Dialogue: 1,0:02:34.87,0:02:37.01,F,,0,0,0,,哦…哦  真不好意思
Dialogue: 1,0:02:39.60,0:02:41.89,F,,0,0,0,,龍二
Dialogue: 1,0:02:43.42,0:02:45.12,F,,0,0,0,,我有事要說
Dialogue: 1,0:02:46.27,0:02:49.27,F,,0,0,0,,什什什…什麼…什麼事
Dialogue: 1,0:02:51.07,0:02:54.52,F,,0,0,0,,你之前說有喜歡的人  對吧
Dialogue: 1,0:02:56.65,0:02:59.78,F,,0,0,0,,我知道是誰了
Dialogue: 1,0:03:01.58,0:03:04.03,F,,0,0,0,,龍二
Dialogue: 1,0:03:04.03,0:03:06.29,F,,0,0,0,,你不用顧慮我的
Dialogue: 1,0:03:09.06,0:03:12.07,F,,0,0,0,,你要珍惜自己的感情
Dialogue: 1,0:03:14.75,0:03:16.49,F,,0,0,0,,這是夢嗎
Dialogue: 1,0:03:17.60,0:03:18.79,F,,0,0,0,,不
Dialogue: 1,0:03:19.43,0:03:20.82,F,,0,0,0,,就算是夢也好
Dialogue: 1,0:03:22.12,0:03:24.37,F,,0,0,0,,既然真琴希望我這麼做的話…
Dialogue: 1,0:03:30.09,0:03:31.19,F,,0,0,0,,真琴  我…
Dialogue: 1,0:03:31.19,0:03:34.81,F,,0,0,0,,我會為你和蒼井同學加油的
Dialogue: 1,0:03:40.24,0:03:41.82,F,,0,0,0,,蒼井？
Dialogue: 1,0:03:42.94,0:03:44.41,F,,0,0,0,,沒關係的
Dialogue: 1,0:03:44.41,0:03:47.32,F,,0,0,0,,蒼井同學已經不喜歡我了
Dialogue: 1,0:03:47.32,0:03:49.60,F,,0,0,0,,那我先走了
Dialogue: 1,0:03:49.60,0:03:51.32,F,,0,0,0,,哦…哦
Dialogue: 1,0:04:00.44,0:04:02.19,F,,0,0,0,,啊  睡死了
Dialogue: 1,0:04:08.47,0:04:10.27,F,,0,0,0,,喲  康復的傢伙
Dialogue: 1,0:04:11.44,0:04:13.35,F,,0,0,0,,挺有精神的嘛
Dialogue: 1,0:04:14.08,0:04:16.35,F,,0,0,0,,這是昨天發的東西
Dialogue: 1,0:04:16.35,0:04:18.16,F,,0,0,0,,說是這週要交
Dialogue: 1,0:04:20.14,0:04:22.27,F,,0,0,0,,志願啊…
Dialogue: 1,0:04:27.76,0:04:28.74,F,,0,0,0,,咦  咲
Dialogue: 1,0:04:28.74,0:04:31.25,F,,0,0,0,,午餐你不和前輩吃嗎
Dialogue: 1,0:04:31.25,0:04:32.50,F,,0,0,0,,怎麼了
Dialogue: 1,0:04:32.50,0:04:34.50,F,,0,0,0,,能跟你們一起吃嗎
Dialogue: 1,0:04:34.99,0:04:37.51,F,,0,0,0,,當然了  不要走了
Dialogue: 1,0:04:38.28,0:04:39.88,F,,0,0,0,,發生什麼事了嗎
Dialogue: 1,0:04:41.84,0:04:43.32,F,,0,0,0,,那個
Dialogue: 1,0:04:43.32,0:04:45.78,F,,0,0,0,,我覺得該放棄了
Dialogue: 1,0:04:50.14,0:04:52.22,F,,0,0,0,,這樣啊  那就選我吧
Dialogue: 1,0:04:52.22,0:04:54.19,F,,0,0,0,,不對  是我
Dialogue: 1,0:05:02.90,0:05:06.91,F,,0,0,0,,其實  我不是喜歡蒼井同學
Dialogue: 1,0:05:13.34,0:05:16.45,F,,0,0,0,,那…那你喜歡誰
Dialogue: 1,0:05:16.45,0:05:17.37,F,,0,0,0,,要說出來嗎
Dialogue: 1,0:05:18.56,0:05:20.00,F,,0,0,0,,欸  是誰啊
Dialogue: 1,0:05:22.41,0:05:24.81,F,,0,0,0,,對了  蒼井不喜歡你了這事
Dialogue: 1,0:05:24.81,0:05:27.00,F,,0,0,0,,你怎麼知道…  察覺的
Dialogue: 1,0:05:27.00,0:05:28.23,F,,0,0,0,,她說的
Dialogue: 1,0:05:28.23,0:05:29.57,F,,0,0,0,,她說的啊
Dialogue: 1,0:05:29.57,0:05:31.37,F,,0,0,0,,你已經知道了啊
Dialogue: 1,0:05:32.51,0:05:34.42,F,,0,0,0,,一般會直接告訴本人嗎
Dialogue: 1,0:05:34.42,0:05:36.09,F,,0,0,0,,耶  師傅
Dialogue: 1,0:05:36.09,0:05:37.90,F,,0,0,0,,那傢伙應該會吧
Dialogue: 1,0:05:39.27,0:05:43.28,F,,0,0,0,,我會為你和前輩加油的
Dialogue: 1,0:05:43.75,0:05:46.81,F,,0,0,0,,真是搞不懂那傢伙啊
Dialogue: 1,0:05:47.84,0:05:51.50,F,,0,0,0,,對了真琴  你們班的志願調查表發了嗎
Dialogue: 1,0:05:51.50,0:05:53.36,F,,0,0,0,,啊  發了
Dialogue: 1,0:05:53.36,0:05:55.29,F,,0,0,0,,畢竟也到這個時候了
Dialogue: 1,0:05:55.86,0:05:58.79,F,,0,0,0,,從小時候起我和你就一直在一起
Dialogue: 1,0:05:59.12,0:06:01.54,F,,0,0,0,,但可能終於要分開了
Dialogue: 1,0:06:04.17,0:06:05.96,F,,0,0,0,,有點無法想像呢
Dialogue: 1,0:06:07.15,0:06:08.42,F,,0,0,0,,是啊
Dialogue: 1,0:06:10.05,0:06:14.42,F,,0,0,0,,這樣一起度過的日子  也只剩下一年多了
Dialogue: 1,0:06:18.18,0:06:19.19,F,,0,0,0,,真琴
Dialogue: 1,0:06:21.14,0:06:22.86,F,,0,0,0,,要不要去兜風
Dialogue: 1,0:06:26.98,0:06:29.70,F,,0,0,0,,聽說你拿到了志願調查表
Dialogue: 1,0:06:29.95,0:06:31.00,F,,0,0,0,,嗯
Dialogue: 1,0:06:31.00,0:06:32.95,F,,0,0,0,,決定好做什麼了嗎
Dialogue: 1,0:06:33.51,0:06:35.42,F,,0,0,0,,還沒有
Dialogue: 1,0:06:35.42,0:06:36.38,F,,0,0,0,,這樣啊
Dialogue: 1,0:06:37.34,0:06:41.58,F,,0,0,0,,還記得上高中前爸爸問你的嗎
Dialogue: 1,0:06:42.31,0:06:43.08,F,,0,0,0,,嗯
Dialogue: 1,0:06:44.30,0:06:47.30,F,,0,0,0,,你想當女孩子嗎
Dialogue: 1,0:06:56.35,0:06:59.97,F,,0,0,0,,如果我說想成為女孩子
Dialogue: 1,0:06:59.97,0:07:01.06,F,,0,0,0,,你會怎麼做呢
Dialogue: 1,0:07:02.55,0:07:05.42,F,,0,0,0,,應該會非常煩惱吧
Dialogue: 1,0:07:07.37,0:07:09.33,F,,0,0,0,,會不斷思考
Dialogue: 1,0:07:09.33,0:07:14.99,F,,0,0,0,,爸爸應該怎麼幫你  才能讓你幸福
Dialogue: 1,0:07:14.99,0:07:16.83,F,,0,0,0,,我一直想著這個問題
Dialogue: 1,0:07:18.13,0:07:20.65,F,,0,0,0,,媽媽肯定會非常不安
Dialogue: 1,0:07:20.65,0:07:22.71,F,,0,0,0,,但爸爸會想辦法解決的
Dialogue: 1,0:07:24.96,0:07:27.72,F,,0,0,0,,所以  放心地做出你的決定吧
Dialogue: 1,0:07:27.72,0:07:30.77,F,,0,0,0,,是想繼續作為男孩子生活
Dialogue: 1,0:07:30.77,0:07:32.92,F,,0,0,0,,還是作為女孩子生活
Dialogue: 1,0:07:35.29,0:07:35.99,F,,0,0,0,,嗯
Dialogue: 1,0:07:46.77,0:07:49.99,F,,0,0,0,,喂  大我  過來一下
Dialogue: 1,0:07:49.99,0:07:50.74,F,,0,0,0,,好
Dialogue: 1,0:07:51.88,0:07:53.73,F,,0,0,0,,你成績這麼好
Dialogue: 1,0:07:53.73,0:07:56.49,F,,0,0,0,,不如考慮一下報考一所好大學
Dialogue: 1,0:07:56.49,0:07:58.93,F,,0,0,0,,這所大學就很不錯哦
Dialogue: 1,0:08:00.68,0:08:01.87,F,,0,0,0,,花岡
Dialogue: 1,0:08:03.40,0:08:05.63,F,,0,0,0,,你決定要加入籃球部了嗎
Dialogue: 1,0:08:05.92,0:08:07.19,F,,0,0,0,,啊  抱歉
Dialogue: 1,0:08:07.19,0:08:09.01,F,,0,0,0,,讓我再考慮一下
Dialogue: 1,0:08:09.01,0:08:10.19,F,,0,0,0,,沒問題
Dialogue: 1,0:08:12.98,0:08:14.96,F,,0,0,0,,加入還是不加入
Dialogue: 1,0:08:15.96,0:08:17.97,F,,0,0,0,,男孩子還是女孩子
Dialogue: 1,0:08:19.13,0:08:21.21,F,,0,0,0,,真是有太多事情必須要決定了
Dialogue: 1,0:08:32.83,0:08:34.99,F,,0,0,0,,真琴前輩
Dialogue: 1,0:08:38.23,0:08:40.55,F,,0,0,0,,蒼井同學  你在做什麼
Dialogue: 1,0:08:40.55,0:08:41.60,F,,0,0,0,,有貓
Dialogue: 1,0:08:41.60,0:08:42.62,F,,0,0,0,,貓？
Dialogue: 1,0:08:42.62,0:08:43.87,F,,0,0,0,,你看  在那
Dialogue: 1,0:08:45.38,0:08:46.75,F,,0,0,0,,真的欸
Dialogue: 1,0:08:47.04,0:08:49.25,F,,0,0,0,,好…  好可愛
Dialogue: 1,0:08:49.65,0:08:50.37,F,,0,0,0,,對吧
Dialogue: 1,0:08:56.01,0:08:59.14,F,,0,0,0,,籃球部邀請你入部啊
Dialogue: 1,0:08:59.57,0:09:03.37,F,,0,0,0,,但是  就算加入了  半年後也要退出了
Dialogue: 1,0:09:03.37,0:09:05.14,F,,0,0,0,,而且  那個…
Dialogue: 1,0:09:05.63,0:09:07.70,F,,0,0,0,,還會給大家很多麻煩
Dialogue: 1,0:09:08.40,0:09:10.69,F,,0,0,0,,但他好心邀請我
Dialogue: 1,0:09:10.69,0:09:13.51,F,,0,0,0,,我也不好意思拒絕
Dialogue: 1,0:09:14.24,0:09:17.44,F,,0,0,0,,換作是你  你會答應還是拒絕？
Dialogue: 1,0:09:20.14,0:09:22.04,F,,0,0,0,,我想想
Dialogue: 1,0:09:23.85,0:09:28.19,F,,0,0,0,,這個  一定要選其中一個嗎
Dialogue: 1,0:09:33.43,0:09:37.70,F,,0,0,0,,之所以會煩惱  就是因為對兩個選項猶豫不決吧
Dialogue: 1,0:09:37.70,0:09:41.19,F,,0,0,0,,只在想參加的時候加入不就好了嗎
Dialogue: 1,0:09:41.19,0:09:45.18,F,,0,0,0,,當然也得籃球部的人同意
Dialogue: 1,0:09:46.86,0:09:49.69,F,,0,0,0,,確實  是這樣沒錯
Dialogue: 1,0:09:49.69,0:09:51.21,F,,0,0,0,,是吧
Dialogue: 1,0:09:52.80,0:09:54.65,F,,0,0,0,,蒼井同學真厲害啊
Dialogue: 1,0:10:02.67,0:10:04.45,F,,0,0,0,,早安
Dialogue: 1,0:10:07.45,0:10:09.71,F,,0,0,0,,喲  你很睏啊
Dialogue: 1,0:10:10.01,0:10:12.72,F,,0,0,0,,今天要交志願調查表了
Dialogue: 1,0:10:12.72,0:10:14.60,F,,0,0,0,,所以我思考了很久
Dialogue: 1,0:10:14.60,0:10:16.47,F,,0,0,0,,這樣啊
Dialogue: 1,0:10:17.07,0:10:20.96,F,,0,0,0,,我暫且決定要升學  所以就這麼寫了
Dialogue: 1,0:10:20.96,0:10:21.85,F,,0,0,0,,你呢
Dialogue: 1,0:10:24.05,0:10:25.87,F,,0,0,0,,我也差不多
Dialogue: 1,0:10:25.87,0:10:26.97,F,,0,0,0,,是嗎
Dialogue: 1,0:10:28.31,0:10:31.36,F,,0,0,0,,不入部  但是想偶爾參加？
Dialogue: 1,0:10:31.79,0:10:34.32,F,,0,0,0,,好  就這麼定了
Dialogue: 1,0:10:34.32,0:10:36.11,F,,0,0,0,,欸  可以嗎
Dialogue: 1,0:10:36.48,0:10:38.99,F,,0,0,0,,怎麼是你被嚇到了
Dialogue: 1,0:10:39.37,0:10:40.87,F,,0,0,0,,我們很隨意的
Dialogue: 1,0:10:40.87,0:10:44.37,F,,0,0,0,,不過  有困難的時候你可得來幫忙哦
Dialogue: 1,0:10:45.10,0:10:47.25,F,,0,0,0,,嗯  沒問題
Dialogue: 1,0:10:51.90,0:10:53.63,F,,0,0,0,,大學嗎
Dialogue: 1,0:10:54.15,0:10:56.38,F,,0,0,0,,如果去了不同的大學
Dialogue: 1,0:10:56.80,0:10:59.85,F,,0,0,0,,就見不到真琴了…吧
Dialogue: 1,0:11:00.88,0:11:03.39,F,,0,0,0,,要向學長表白？
Dialogue: 1,0:11:03.69,0:11:06.14,F,,0,0,0,,你不是說看著他就夠了嗎
Dialogue: 1,0:11:06.40,0:11:09.04,F,,0,0,0,,因為學長就要畢業了
Dialogue: 1,0:11:09.04,0:11:11.14,F,,0,0,0,,以後就見不到了
Dialogue: 1,0:11:11.39,0:11:13.58,F,,0,0,0,,我更不想因為什麼都不做而後悔
Dialogue: 1,0:11:13.58,0:11:15.65,F,,0,0,0,,嗯嗯  我覺得可以
Dialogue: 1,0:11:15.65,0:11:18.00,D,,0,0,0,,什麼時候  在哪裡
Dialogue: 1,0:11:16.73,0:11:18.00,F,,0,0,0,,這樣啊
Dialogue: 1,0:11:18.42,0:11:20.53,F,,0,0,0,,既然就要見不到了  乾脆就…
Dialogue: 1,0:11:27.68,0:11:28.91,F,,0,0,0,,我喜歡你
Dialogue: 1,0:11:29.17,0:11:30.41,F,,0,0,0,,我也是
Dialogue: 1,0:11:35.43,0:11:36.80,F,,0,0,0,,表白…
Dialogue: 1,0:11:39.12,0:11:41.17,F,,0,0,0,,真的要去嗎？
Dialogue: 1,0:11:43.49,0:11:45.68,F,,0,0,0,,你是那樣看我的嗎
Dialogue: 1,0:11:47.44,0:11:50.73,F,,0,0,0,,好噁心  別再接近我了
Dialogue: 1,0:11:52.05,0:11:54.78,F,,0,0,0,,好開心  我也是
Dialogue: 1,0:12:06.71,0:12:08.22,F,,0,0,0,,景色真美啊
Dialogue: 1,0:12:09.02,0:12:10.66,F,,0,0,0,,來  張嘴
Dialogue: 1,0:12:11.95,0:12:14.42,F,,0,0,0,,是你最喜歡的馬鈴薯燉牛肉哦
Dialogue: 1,0:12:17.16,0:12:18.90,F,,0,0,0,,浴室空出來了
Dialogue: 1,0:12:19.30,0:12:20.96,F,,0,0,0,,哦…哦
Dialogue: 1,0:12:20.96,0:12:23.06,F,,0,0,0,,啊  老套的電視劇
Dialogue: 1,0:12:23.06,0:12:24.38,F,,0,0,0,,好看嗎？
Dialogue: 1,0:12:24.96,0:12:26.30,F,,0,0,0,,就那樣吧
Dialogue: 1,0:12:26.55,0:12:28.19,F,,0,0,0,,但是不行啊
Dialogue: 1,0:12:33.05,0:12:35.37,F,,0,0,0,,一定要選其中一個嗎
Dialogue: 1,0:12:36.04,0:12:38.30,F,,0,0,0,,沒必要做出選擇
Dialogue: 1,0:12:39.14,0:12:41.28,D,,0,0,0,,還能怎麼做呢
Dialogue: 1,0:12:41.62,0:12:43.78,D,,0,0,0,,你連這都不知道啊
Dialogue: 1,0:12:44.02,0:12:46.28,D,,0,0,0,,你們倆真笨啊
Dialogue: 1,0:12:39.61,0:12:43.30,F,,0,0,0,,既不是男孩子  也不是女孩子
Dialogue: 1,0:12:44.51,0:12:46.28,F,,0,0,0,,這樣的答案…
Dialogue: 1,0:12:53.68,0:12:56.86,F,,0,0,0,,即使要與全世界為敵
Dialogue: 1,0:12:56.86,0:12:58.58,F,,0,0,0,,只要有你在  我就滿足了
Dialogue: 1,0:12:59.72,0:13:02.30,F,,0,0,0,,咲  去洗澡吧
Dialogue: 1,0:13:02.78,0:13:04.05,F,,0,0,0,,好的
Dialogue: 1,0:13:04.05,0:13:05.68,F,,0,0,0,,我也是  除了你…
Dialogue: 1,0:13:21.21,0:13:23.44,F,,0,0,0,,紙箱可能不夠了
Dialogue: 1,0:13:24.04,0:13:25.73,F,,0,0,0,,我去拿吧
Dialogue: 1,0:13:33.57,0:13:34.55,F,,0,0,0,,蒼井同學
Dialogue: 1,0:13:35.08,0:13:36.96,F,,0,0,0,,啊  真琴前輩
Dialogue: 1,0:13:37.23,0:13:39.08,F,,0,0,0,,要我幫你搬嗎
Dialogue: 1,0:13:39.08,0:13:42.09,F,,0,0,0,,不用  很輕的  我一個人可以
Dialogue: 1,0:13:42.74,0:13:44.37,F,,0,0,0,,是嗎
Dialogue: 1,0:13:44.37,0:13:45.97,F,,0,0,0,,那再見
Dialogue: 1,0:13:45.97,0:13:47.22,F,,0,0,0,,嗯  再見
Dialogue: 1,0:13:56.23,0:13:59.06,F,,0,0,0,,蒼井同學  我還是幫你拿一半吧
Dialogue: 1,0:14:06.19,0:14:08.78,F,,0,0,0,,前輩你們班準備辦什麼活動
Dialogue: 1,0:14:09.07,0:14:10.98,F,,0,0,0,,我們班是章魚燒店
Dialogue: 1,0:14:10.98,0:14:12.67,F,,0,0,0,,你們班呢
Dialogue: 1,0:14:12.67,0:14:14.04,F,,0,0,0,,鬼屋
Dialogue: 1,0:14:14.93,0:14:17.29,F,,0,0,0,,師傅他們班是什麼呢
Dialogue: 1,0:14:17.55,0:14:21.17,F,,0,0,0,,我問了他也不告訴我  不知道為什麼
Dialogue: 1,0:14:21.17,0:14:23.74,F,,0,0,0,,聽起來挺有意思的
Dialogue: 1,0:14:28.64,0:14:30.30,F,,0,0,0,,那我就放在這裡了
Dialogue: 1,0:14:30.59,0:14:32.26,F,,0,0,0,,謝謝
Dialogue: 1,0:14:32.26,0:14:34.31,F,,0,0,0,,蒼井  紙箱拿過來…
Dialogue: 1,0:14:39.72,0:14:42.05,F,,0,0,0,,前輩幫我搬了
Dialogue: 1,0:14:42.05,0:14:45.16,F,,0,0,0,,那…那個  謝謝你了
Dialogue: 1,0:14:45.16,0:14:46.39,F,,0,0,0,,不客氣
Dialogue: 1,0:14:49.74,0:14:51.68,F,,0,0,0,,第一次這麼近距離地看他
Dialogue: 1,0:14:51.68,0:14:53.15,F,,0,0,0,,臉好漂亮
Dialogue: 1,0:14:53.15,0:14:54.34,F,,0,0,0,,我懂
Dialogue: 1,0:14:55.21,0:14:59.16,F,,0,0,0,,不過就是  他比我想像中還要普通一點
Dialogue: 1,0:14:59.16,0:15:00.96,F,,0,0,0,,還跟我聊天呢
Dialogue: 1,0:15:02.39,0:15:03.48,F,,0,0,0,,對啊
Dialogue: 1,0:15:04.38,0:15:08.33,F,,0,0,0,,前輩已經不再是特別之人了
Dialogue: 1,0:15:19.24,0:15:20.98,F,,0,0,0,,太好了
Dialogue: 1,0:15:21.24,0:15:22.85,F,,0,0,0,,真假
Dialogue: 1,0:15:23.12,0:15:24.11,F,,0,0,0,,好了
Dialogue: 1,0:15:24.11,0:15:27.61,F,,0,0,0,,請中了獎的同學來這邊哦
Dialogue: 1,0:15:27.61,0:15:30.40,F,,0,0,0,,這也是青春的一章嘛
Dialogue: 1,0:15:37.99,0:15:40.50,F,,0,0,0,,師傅  好久不見
Dialogue: 1,0:15:40.84,0:15:42.98,F,,0,0,0,,最近怎麼都不來了啊
Dialogue: 1,0:15:42.98,0:15:44.50,F,,0,0,0,,對不起…
Dialogue: 1,0:15:46.50,0:15:50.51,F,,0,0,0,,午餐的事  忘記告訴師傅了
Dialogue: 1,0:15:50.78,0:15:52.45,F,,0,0,0,,不止這件事
Dialogue: 1,0:15:55.12,0:15:56.12,F,,0,0,0,,確實
Dialogue: 1,0:15:57.36,0:15:58.52,F,,0,0,0,,喂  蒼井
Dialogue: 1,0:15:59.43,0:16:01.81,F,,0,0,0,,有什麼煩惱要說出來啊
Dialogue: 1,0:16:03.88,0:16:05.76,F,,0,0,0,,師傅你人真好
Dialogue: 1,0:16:06.91,0:16:08.82,F,,0,0,0,,說什麼呢
Dialogue: 1,0:16:09.12,0:16:12.60,F,,0,0,0,,對了對了  師傅你們班會搞什麼活動啊
Dialogue: 1,0:16:12.60,0:16:13.81,F,,0,0,0,,我要去
Dialogue: 1,0:16:13.81,0:16:15.70,F,,0,0,0,,千萬不要來
Dialogue: 1,0:17:38.15,0:17:39.78,F,,0,0,0,,真琴前輩
Dialogue: 1,0:17:40.06,0:17:42.46,F,,0,0,0,,請給我一個章魚燒
Dialogue: 1,0:17:43.53,0:17:44.80,F,,0,0,0,,你來了啊
Dialogue: 1,0:17:44.80,0:17:46.29,F,,0,0,0,,那當然了
Dialogue: 1,0:17:46.59,0:17:48.29,F,,0,0,0,,真琴同學  這個給你
Dialogue: 1,0:17:48.69,0:17:50.22,F,,0,0,0,,輪班已經結束了
Dialogue: 1,0:17:50.22,0:17:51.80,F,,0,0,0,,你們一起去吃吧
Dialogue: 1,0:17:57.05,0:17:59.58,D,,0,0,0,,前輩  你的髮型真好看
Dialogue: 1,0:17:59.58,0:18:02.33,D,,0,0,0,,你的鬼怪裝扮也很合身哦
Dialogue: 1,0:18:02.33,0:18:04.07,D,,0,0,0,,雖然有點被嚇到了
Dialogue: 1,0:18:04.07,0:18:07.06,F,,0,0,0,,哦對  前輩你害怕可怕的東西啊
Dialogue: 1,0:18:07.46,0:18:09.06,F,,0,0,0,,你還好嗎
Dialogue: 1,0:18:09.78,0:18:10.92,F,,0,0,0,,不…
Dialogue: 1,0:18:10.92,0:18:13.65,F,,0,0,0,,你的鬼怪裝扮很可愛  沒事的
Dialogue: 1,0:18:14.32,0:18:15.80,F,,0,0,0,,那就好
Dialogue: 1,0:18:17.04,0:18:18.93,F,,0,0,0,,章魚燒真好吃
Dialogue: 1,0:18:18.93,0:18:20.29,F,,0,0,0,,是啊
Dialogue: 1,0:18:21.87,0:18:23.89,F,,0,0,0,,吃完我們去龍二的班上吧
Dialogue: 1,0:18:23.89,0:18:25.28,F,,0,0,0,,贊成
Dialogue: 1,0:18:38.63,0:18:40.73,F,,0,0,0,,師傅真可愛
Dialogue: 1,0:18:40.73,0:18:42.72,F,,0,0,0,,很適合你哦  龍二
Dialogue: 1,0:18:42.72,0:18:44.93,F,,0,0,0,,我不是說了不要來嗎
Dialogue: 1,0:18:44.93,0:18:47.28,F,,0,0,0,,哎呀  沒關係啦
Dialogue: 1,0:18:47.98,0:18:50.02,F,,0,0,0,,超漂亮的
Dialogue: 1,0:18:50.02,0:18:50.78,F,,0,0,0,,別說了
Dialogue: 1,0:18:50.36,0:18:51.48,F,,800,0,0,,挺不錯的嘛
Dialogue: 1,0:18:51.71,0:18:53.96,F,,0,0,0,,喂  龍二  認真工作
Dialogue: 1,0:18:53.96,0:18:55.98,F,,0,0,0,,請…請問要點什麼
Dialogue: 1,0:18:56.38,0:18:57.44,F,,0,0,0,,蛋包飯
Dialogue: 1,0:18:57.44,0:18:58.46,F,,0,0,0,,我也要
Dialogue: 1,0:18:58.46,0:19:00.74,F,,0,0,0,,請用番茄醬畫一個愛心
Dialogue: 1,0:19:01.10,0:19:02.87,F,,0,0,0,,我明白了…
Dialogue: 1,0:19:17.43,0:19:20.78,D,,0,0,0,,我該去扮鬼了
Dialogue: 1,0:19:20.78,0:19:22.26,D,,0,0,0,,先走了
Dialogue: 1,0:19:22.26,0:19:25.01,D,,0,0,0,,我要去扮演最強的鬼怪啦
Dialogue: 1,0:19:25.01,0:19:26.06,D,,0,0,0,,最強？
Dialogue: 1,0:19:26.06,0:19:27.22,D,,0,0,0,,搞什麼啊
Dialogue: 1,0:19:27.77,0:19:30.85,F,,0,0,0,,現在有男生可以來換班嗎
Dialogue: 1,0:19:30.85,0:19:31.77,F,,0,0,0,,怎麼了
Dialogue: 1,0:19:31.77,0:19:35.06,F,,0,0,0,,有個人身體不舒服  所以少了一個人
Dialogue: 1,0:19:36.62,0:19:39.73,F,,0,0,0,,讓其他班的人頂上也行吧
Dialogue: 1,0:19:56.17,0:19:58.36,D,,0,0,0,,客人突然多了起來啊
Dialogue: 1,0:19:58.36,0:19:59.55,D,,0,0,0,,是啊
Dialogue: 1,0:19:59.55,0:20:00.17,D,,0,0,0,,嗯
Dialogue: 1,0:20:00.50,0:20:02.81,F,,0,0,0,,哎  太可愛了吧
Dialogue: 1,0:20:02.81,0:20:04.17,F,,0,0,0,,完全是個女生
Dialogue: 1,0:20:04.17,0:20:06.78,F,,0,0,0,,畢竟她穿女裝很久了嘛
Dialogue: 1,0:20:14.49,0:20:16.81,F,,0,0,0,,篝火晚會開始了
Dialogue: 1,0:20:17.20,0:20:21.32,F,,0,0,0,,打掃完的同學請到操場集合
Dialogue: 1,0:20:22.57,0:20:23.82,F,,0,0,0,,真漂亮
Dialogue: 1,0:20:24.64,0:20:25.90,F,,0,0,0,,你不去嗎
Dialogue: 1,0:20:28.23,0:20:30.70,F,,0,0,0,,我還想再穿一會這身衣服
Dialogue: 1,0:20:31.45,0:20:32.59,F,,0,0,0,,這樣啊
Dialogue: 1,0:20:34.23,0:20:36.44,F,,0,0,0,,我做得還好嗎
Dialogue: 1,0:20:36.44,0:20:37.46,F,,0,0,0,,你說什麼
Dialogue: 1,0:20:37.72,0:20:40.82,F,,0,0,0,,有沒有給大家添麻煩
Dialogue: 1,0:20:40.82,0:20:41.97,F,,0,0,0,,沒事的
Dialogue: 1,0:20:42.26,0:20:44.94,F,,0,0,0,,而且你穿著比我合適多了
Dialogue: 1,0:20:49.68,0:20:51.54,F,,0,0,0,,該換回來了
Dialogue: 1,0:20:51.54,0:20:52.48,F,,0,0,0,,嗯
Dialogue: 1,0:20:52.80,0:20:54.29,F,,0,0,0,,這是龍二的校服吧
Dialogue: 1,0:20:54.98,0:20:57.11,F,,0,0,0,,沒事  我自己拿
Dialogue: 1,0:20:58.38,0:20:59.57,F,,0,0,0,,給你  龍二
Dialogue: 0,0:00:01.53,0:00:03.98,A,,0,0,0,,ああ　そうだよ
Dialogue: 0,0:00:04.40,0:00:05.90,A,,0,0,0,,お前が…
Dialogue: 0,0:00:05.90,0:00:08.68,A,,0,0,0,,よ～く知ってるヤツだよ
Dialogue: 0,0:00:22.79,0:00:24.89,A,,0,0,0,,あのときのまことの顔…
Dialogue: 0,0:00:26.14,0:00:28.95,A,,0,0,0,,やっぱ言うんじゃなかった
Dialogue: 0,0:00:31.37,0:00:33.17,A,,0,0,0,,熱下がった
Dialogue: 0,0:00:34.16,0:00:36.42,A,,0,0,0,,もっと普通に登場しろよ
Dialogue: 0,0:00:36.42,0:00:39.51,A,,0,0,0,,一日家で暇だったかなと思って
Dialogue: 0,0:00:39.51,0:00:42.02,A,,0,0,0,,うつるからあっち行ってろ
Dialogue: 0,0:00:42.02,0:00:44.02,A,,0,0,0,,まこちゃん来てるよ
Dialogue: 0,0:00:45.73,0:00:46.42,A,,0,0,0,,えっ
Dialogue: 0,0:02:19.07,0:02:21.53,A,,0,800,0,,竜二　具合はどう
Dialogue: 0,0:02:21.53,0:02:23.99,A,,0,800,0,,まあ　ぼちぼち
Dialogue: 0,0:02:23.99,0:02:26.62,A,,0,0,0,,じゃ　風邪うつされないようにね
Dialogue: 0,0:02:26.62,0:02:28.07,A,,0,0,0,,うん　ありがとう
Dialogue: 0,0:02:29.95,0:02:31.88,A,,0,0,0,,小夏ちゃん　しっかりしてるよね
Dialogue: 0,0:02:32.69,0:02:34.87,A,,0,0,0,,これゼリー　よかったら食べて
Dialogue: 0,0:02:34.87,0:02:37.01,A,,0,0,0,,お… おお　悪いな
Dialogue: 0,0:02:39.60,0:02:41.89,A,,0,0,0,,ねえ　竜二
Dialogue: 0,0:02:43.42,0:02:45.12,A,,0,0,0,,話があるんだけど
Dialogue: 0,0:02:46.27,0:02:49.27,A,,0,0,0,,ははは… はな… 話ってなんだ
Dialogue: 0,0:02:51.07,0:02:54.52,A,,0,0,0,,この前　竜二好きな人がいるって言ってたよね
Dialogue: 0,0:02:56.65,0:02:59.78,A,,0,0,0,,僕　誰のことか分かっちゃったんだ
Dialogue: 0,0:03:01.58,0:03:04.03,A,,0,0,0,,ねえ　竜二
Dialogue: 0,0:03:04.03,0:03:06.29,A,,0,0,0,,僕に遠慮しなくていいから
Dialogue: 0,0:03:09.06,0:03:12.07,A,,0,0,0,,竜二も　自分の気持ち大事にしてね
Dialogue: 0,0:03:14.75,0:03:16.49,A,,0,0,0,,これは夢か
Dialogue: 0,0:03:17.60,0:03:18.79,A,,0,0,0,,いや　いい
Dialogue: 0,0:03:19.43,0:03:20.82,A,,0,0,0,,たとえ夢でも
Dialogue: 0,0:03:22.12,0:03:24.37,A,,0,0,0,,まことが望んでくれてるのなら…
Dialogue: 0,0:03:30.09,0:03:31.19,A,,0,0,0,,まこと　俺…
Dialogue: 0,0:03:31.19,0:03:34.81,A,,0,0,0,,僕　応援するから　竜二と蒼井さんのこと
Dialogue: 0,0:03:40.24,0:03:41.82,A,,0,0,0,,あおい？
Dialogue: 0,0:03:42.94,0:03:44.41,A,,0,0,0,,大丈夫だよ
Dialogue: 0,0:03:44.41,0:03:47.32,A,,0,0,0,,蒼井さんはもう僕のこと好きじゃないから
Dialogue: 0,0:03:47.32,0:03:49.60,A,,0,0,0,,じゃ　僕もう帰るね
Dialogue: 0,0:03:49.60,0:03:51.32,A,,0,0,0,,お… おう
Dialogue: 0,0:04:00.44,0:04:02.19,A,,0,0,0,,あっ　ちゃんと寝てる
Dialogue: 0,0:04:08.47,0:04:10.27,A,,0,0,0,,よう　病み上がりマン
Dialogue: 0,0:04:11.44,0:04:13.35,A,,0,0,0,,元気そうじゃん
Dialogue: 0,0:04:14.08,0:04:16.35,A,,0,0,0,,これ　昨日配られたやつ
Dialogue: 0,0:04:16.35,0:04:18.16,A,,0,0,0,,今週中に出せってさ
Dialogue: 0,0:04:20.14,0:04:22.27,A,,0,0,0,,進路か…
Dialogue: 0,0:04:27.76,0:04:28.74,A,,0,0,0,,あれ　咲
Dialogue: 0,0:04:28.74,0:04:31.25,A,,0,0,0,,お昼　先輩と食べないの
Dialogue: 0,0:04:31.25,0:04:32.50,A,,0,0,0,,どうしたん
Dialogue: 0,0:04:32.50,0:04:34.50,A,,0,0,0,,一緒に食べていい
Dialogue: 0,0:04:34.99,0:04:37.51,A,,0,0,0,,当たり前でしょ　もう離さない
Dialogue: 0,0:04:38.28,0:04:39.88,A,,0,0,0,,なんかあったん
Dialogue: 0,0:04:41.84,0:04:43.32,A,,0,0,0,,え～っと
Dialogue: 0,0:04:43.32,0:04:45.78,A,,0,0,0,,もう諦めよっかな～って
Dialogue: 0,0:04:50.14,0:04:52.22,A,,0,0,0,,そかそか　あたしにしときな
Dialogue: 0,0:04:52.22,0:04:54.19,A,,0,0,0,,いや　あたし
Dialogue: 0,0:05:02.90,0:05:06.91,A,,0,0,0,,あのさぁ　俺別に蒼井のこと好きじゃないぞ
Dialogue: 0,0:05:13.34,0:05:16.45,A,,0,0,0,,じ… じゃあ　誰が好きなの
Dialogue: 0,0:05:16.45,0:05:17.37,A,,0,0,0,,言うか
Dialogue: 0,0:05:18.56,0:05:20.00,A,,0,0,0,,え～　誰だろ
Dialogue: 0,0:05:22.41,0:05:24.81,A,,0,0,0,,てか　なんで蒼井がお前のこと好きじゃないの
Dialogue: 0,0:05:24.81,0:05:27.00,A,,0,0,0,,知って…　気付いたんだ
Dialogue: 0,0:05:27.00,0:05:28.23,A,,0,0,0,,言われたから
Dialogue: 0,0:05:28.23,0:05:29.57,A,,0,0,0,,言われたんだ
Dialogue: 0,0:05:29.57,0:05:31.37,A,,0,0,0,,竜二は知ってたんだ
Dialogue: 0,0:05:32.51,0:05:34.42,A,,0,0,0,,普通本人に言うか
Dialogue: 0,0:05:34.42,0:05:36.09,A,,0,0,0,,イェーイ　師匠
Dialogue: 0,0:05:36.09,0:05:37.90,A,,0,0,0,,あいつなら言うか
Dialogue: 0,0:05:39.27,0:05:43.28,A,,0,0,0,,私　応援します　師匠と先輩のこと
Dialogue: 0,0:05:43.75,0:05:46.81,A,,0,0,0,,ホントよく分かんねえな　あいつ
Dialogue: 0,0:05:47.84,0:05:51.50,A,,0,0,0,,そういやまことのクラス　進路調査の紙もらったか
Dialogue: 0,0:05:51.50,0:05:53.36,A,,0,0,0,,あ～　もらったよ
Dialogue: 0,0:05:53.36,0:05:55.29,A,,0,0,0,,もうそんな時期なんだね
Dialogue: 0,0:05:55.86,0:05:58.79,A,,0,0,0,,小さいときから竜二とはずっと一緒だったけど
Dialogue: 0,0:05:59.12,0:06:01.54,A,,0,0,0,,ついに別になるかもしれないんだね
Dialogue: 0,0:06:04.17,0:06:05.96,A,,0,0,0,,なんか想像つかないや
Dialogue: 0,0:06:07.15,0:06:08.42,A,,0,0,0,,そうか
Dialogue: 0,0:06:10.05,0:06:14.42,A,,0,0,0,,こうやって一緒に過ごせるのも　あと{\fscx50} {\fscx}1{\fscx50} {\fscx}年ちょっとなのか
Dialogue: 0,0:06:18.18,0:06:19.19,A,,0,0,0,,まこと
Dialogue: 0,0:06:21.14,0:06:22.86,A,,0,0,0,,ドライブに行かないか
Dialogue: 0,0:06:26.98,0:06:29.70,A,,0,0,0,,進路調査票　もらったんだって
Dialogue: 0,0:06:29.95,0:06:31.00,A,,0,0,0,,うん
Dialogue: 0,0:06:31.00,0:06:32.95,A,,0,0,0,,どうするか決まってるのか
Dialogue: 0,0:06:33.51,0:06:35.42,A,,0,0,0,,いや　まだ
Dialogue: 0,0:06:35.42,0:06:36.38,A,,0,0,0,,そうか
Dialogue: 0,0:06:37.34,0:06:41.58,A,,0,0,0,,高校に入る前に父さんが聞いたこと　覚えてるか
Dialogue: 0,0:06:42.31,0:06:43.08,A,,0,0,0,,うん
Dialogue: 0,0:06:44.30,0:06:47.30,A,,0,0,0,,まことは女の子になりたいのか
Dialogue: 0,0:06:56.35,0:06:59.97,A,,0,0,0,,父さんは　もし僕が女の子になりたいって言ったら
Dialogue: 0,0:06:59.97,0:07:01.06,A,,0,0,0,,どうするの
Dialogue: 0,0:07:02.55,0:07:05.42,A,,0,0,0,,とても悩むだろうなぁ　きっと
Dialogue: 0,0:07:07.37,0:07:09.33,A,,0,0,0,,考えて考えて
Dialogue: 0,0:07:09.33,0:07:14.99,A,,0,0,0,,まことが幸せになるために　父さんはどう手伝えばいいのか
Dialogue: 0,0:07:14.99,0:07:16.83,A,,0,0,0,,ずっと考えるよ
Dialogue: 0,0:07:18.13,0:07:20.65,A,,0,0,0,,母さんはきっと戸惑うだろうが
Dialogue: 0,0:07:20.65,0:07:22.71,A,,0,0,0,,父さんがなんとかするよ
Dialogue: 0,0:07:24.96,0:07:27.72,A,,0,0,0,,だから　安心して答えを出しなさい
Dialogue: 0,0:07:27.72,0:07:30.77,A,,0,0,0,,このまま男の子として生きたいのか
Dialogue: 0,0:07:30.77,0:07:32.92,A,,0,0,0,,女の子として生きたいのか
Dialogue: 0,0:07:35.29,0:07:35.99,A,,0,0,0,,うん
Dialogue: 0,0:07:46.77,0:07:49.99,A,,0,0,0,,お～い　大我　ちょっといいか
Dialogue: 0,0:07:49.99,0:07:50.74,A,,0,0,0,,はい
Dialogue: 0,0:07:51.88,0:07:53.73,A,,0,0,0,,お前成績いいから
Dialogue: 0,0:07:53.73,0:07:56.49,A,,0,0,0,,どうせならいい大学目指したらどうだ
Dialogue: 0,0:07:56.49,0:07:58.93,A,,0,0,0,,その大学とかいいと思うぞ
Dialogue: 0,0:08:00.68,0:08:01.87,A,,0,0,0,,花岡
Dialogue: 0,0:08:03.40,0:08:05.63,A,,0,0,0,,バスケ部入るか　決めてくれたか
Dialogue: 0,0:08:05.92,0:08:07.19,A,,0,0,0,,あっ　ごめん
Dialogue: 0,0:08:07.19,0:08:09.01,A,,0,0,0,,もうちょっと考えてもいい
Dialogue: 0,0:08:09.01,0:08:10.19,A,,0,0,0,,オッケー
Dialogue: 0,0:08:12.98,0:08:14.96,A,,0,0,0,,入部するか　しないか
Dialogue: 0,0:08:15.96,0:08:17.97,A,,0,0,0,,男か　女か
Dialogue: 0,0:08:19.13,0:08:21.21,A,,0,0,0,,決めなきゃいけないことばっかだ
Dialogue: 0,0:08:32.83,0:08:34.99,A,,0,0,0,,まこと先輩
Dialogue: 0,0:08:38.23,0:08:40.55,A,,0,0,0,,蒼井さん　何してるの
Dialogue: 0,0:08:40.55,0:08:41.60,A,,0,0,0,,猫です
Dialogue: 0,0:08:41.60,0:08:42.62,A,,0,0,0,,猫？
Dialogue: 0,0:08:42.62,0:08:43.87,A,,0,0,0,,ほら　そこ
Dialogue: 0,0:08:45.38,0:08:46.75,A,,0,0,0,,ホントだ
Dialogue: 0,0:08:47.04,0:08:49.25,A,,0,0,0,,カ… カワイイ
Dialogue: 0,0:08:49.65,0:08:50.37,A,,0,0,0,,ねっ
Dialogue: 0,0:08:56.01,0:08:59.14,A,,0,0,0,,バスケ部から入部のお誘いですか
Dialogue: 0,0:08:59.57,0:09:03.37,A,,0,0,0,,でも　入部しても　あと半年くらいで引退だし
Dialogue: 0,0:09:03.37,0:09:05.14,A,,0,0,0,,それに　その…
Dialogue: 0,0:09:05.63,0:09:07.70,A,,0,0,0,,いろいろ迷惑かけるかなとか
Dialogue: 0,0:09:08.40,0:09:10.69,A,,0,0,0,,でも　せっかく誘ってくれたのに
Dialogue: 0,0:09:10.69,0:09:13.51,A,,0,0,0,,断るのももったいないかなとか考えちゃって
Dialogue: 0,0:09:14.24,0:09:17.44,A,,0,0,0,,もし蒼井さんなら入部する　しない？
Dialogue: 0,0:09:20.14,0:09:22.04,A,,0,0,0,,そうですねえ
Dialogue: 0,0:09:23.85,0:09:28.19,A,,0,0,0,,それって　どっちかじゃないとダメなんですか
Dialogue: 0,0:09:33.43,0:09:37.70,A,,0,0,0,,悩むってことは　どっちもう～んって感じなんですよね
Dialogue: 0,0:09:37.70,0:09:41.19,A,,0,0,0,,参加したいときだけ　交ぜてもらえばいいんじゃないですか
Dialogue: 0,0:09:41.19,0:09:45.18,A,,0,0,0,,もちろん　バスケ部の人たちがいいって言えばですけど
Dialogue: 0,0:09:46.86,0:09:49.69,A,,0,0,0,,確かに　そうだね
Dialogue: 0,0:09:49.69,0:09:51.21,A,,0,0,0,,そうですよ
Dialogue: 0,0:09:52.80,0:09:54.65,A,,0,0,0,,蒼井さんはすごいな
Dialogue: 0,0:10:02.67,0:10:04.45,A,,0,0,0,,おはよう
Dialogue: 0,0:10:07.45,0:10:09.71,A,,0,0,0,,よっ　眠そうだな
Dialogue: 0,0:10:10.01,0:10:12.72,A,,0,0,0,,今日進路調査の紙出すでしょ
Dialogue: 0,0:10:12.72,0:10:14.60,A,,0,0,0,,いろいろ考えちゃって
Dialogue: 0,0:10:14.60,0:10:16.47,A,,0,0,0,,あ～　なるほど
Dialogue: 0,0:10:17.07,0:10:20.96,A,,0,0,0,,とりあえず　進学ってことは決めたから　そう書いたんだ
Dialogue: 0,0:10:20.96,0:10:21.85,A,,0,0,0,,竜二は
Dialogue: 0,0:10:24.05,0:10:25.87,A,,0,0,0,,俺も似たようなもん
Dialogue: 0,0:10:25.87,0:10:26.97,A,,0,0,0,,そっか
Dialogue: 0,0:10:28.31,0:10:31.36,A,,0,0,0,,入部しないけど　時々参加したい？
Dialogue: 0,0:10:31.79,0:10:34.32,A,,0,0,0,,オッケー　んじゃそんな感じで
Dialogue: 0,0:10:34.32,0:10:36.11,A,,0,0,0,,えっ　いいの
Dialogue: 0,0:10:36.48,0:10:38.99,A,,0,0,0,,なんで花岡が驚いてんだよ
Dialogue: 0,0:10:39.37,0:10:40.87,A,,0,0,0,,うち緩いし
Dialogue: 0,0:10:40.87,0:10:44.37,A,,0,0,0,,そのかわり　またピンチのときは助っ人してくれよ
Dialogue: 0,0:10:45.10,0:10:47.25,A,,0,0,0,,うん　もちろん
Dialogue: 0,0:10:51.90,0:10:53.63,A,,0,0,0,,大学か
Dialogue: 0,0:10:54.15,0:10:56.38,A,,0,0,0,,別々の大学行ったら
Dialogue: 0,0:10:56.80,0:10:59.85,A,,0,0,0,,まこととは会えなくなる… よな
Dialogue: 0,0:11:00.88,0:11:03.39,A,,0,0,0,,先輩に告白するの？
Dialogue: 0,0:11:03.69,0:11:06.14,A,,0,0,0,,見てるだけでいいって言ってたよね
Dialogue: 0,0:11:06.40,0:11:09.04,A,,0,0,0,,だって先輩　もう卒業じゃん
Dialogue: 0,0:11:09.04,0:11:11.14,A,,0,0,0,,このままだと会えなくなるし
Dialogue: 0,0:11:11.39,0:11:13.58,A,,0,0,0,,何もしないで後悔するよりは
Dialogue: 0,0:11:13.58,0:11:15.65,A,,0,0,0,,うんうん　いいと思う
Dialogue: 0,0:11:15.65,0:11:18.00,G,,0,0,0,,じゃあ　いつ　どこで
Dialogue: 0,0:11:16.73,0:11:18.00,A,,0,0,0,,そうか
Dialogue: 0,0:11:18.42,0:11:20.53,A,,0,0,0,,会えなくなるなら　いっそ…
Dialogue: 0,0:11:27.68,0:11:28.91,A,,0,0,0,,好きだ
Dialogue: 0,0:11:29.17,0:11:30.41,A,,0,0,0,,私も
Dialogue: 0,0:11:35.43,0:11:36.80,A,,0,0,0,,告白…
Dialogue: 0,0:11:39.12,0:11:41.17,A,,0,0,0,,するのか　マジで？
Dialogue: 0,0:11:43.49,0:11:45.68,A,,0,0,0,,僕のこと　そんな目で見てたの
Dialogue: 0,0:11:47.44,0:11:50.73,A,,0,0,0,,キモッ　二度と近寄らないで
Dialogue: 0,0:11:52.05,0:11:54.78,A,,0,0,0,,うれしい　僕も
Dialogue: 0,0:12:06.71,0:12:08.22,A,,0,0,0,,いい景色だね
Dialogue: 0,0:12:09.02,0:12:10.66,A,,0,0,0,,はい　あ～ん
Dialogue: 0,0:12:11.95,0:12:14.42,A,,0,0,0,,竜二の好きな肉じゃがだよ
Dialogue: 0,0:12:17.16,0:12:18.90,A,,0,0,0,,お風呂空いたよ
Dialogue: 0,0:12:19.30,0:12:20.96,A,,0,0,0,,お… おう
Dialogue: 0,0:12:20.96,0:12:23.06,A,,0,0,0,,あっ　ベタなドラマ
Dialogue: 0,0:12:23.06,0:12:24.38,A,,0,0,0,,面白い？
Dialogue: 0,0:12:24.96,0:12:26.30,A,,0,0,0,,それなりに
Dialogue: 0,0:12:26.55,0:12:28.19,A,,0,0,0,,でもダメなのよ
Dialogue: 0,0:12:33.05,0:12:35.37,A,,0,0,0,,どっちかじゃないとダメなんですか
Dialogue: 0,0:12:36.04,0:12:38.30,A,,0,0,0,,どっちか選ぶ必要はない
Dialogue: 0,0:12:39.14,0:12:41.28,G,,0,0,0,,他にどうしたらいいんだ
Dialogue: 0,0:12:41.62,0:12:43.78,G,,0,0,0,,そんなことも分からないんだね
Dialogue: 0,0:12:44.02,0:12:46.28,G,,0,0,0,,バカね　あんたたち
Dialogue: 0,0:12:39.61,0:12:43.30,A,,0,0,0,,男でも　女でもない
Dialogue: 0,0:12:44.51,0:12:46.28,A,,0,0,0,,そんな答え…
Dialogue: 0,0:12:53.68,0:12:56.86,A,,0,0,0,,たとえ　世界中を敵に回しても
Dialogue: 0,0:12:56.86,0:12:58.58,A,,0,0,0,,お前だけがいればいい
Dialogue: 0,0:12:59.72,0:13:02.30,A,,0,0,0,,咲　お風呂入り～
Dialogue: 0,0:13:02.78,0:13:04.05,A,,0,0,0,,は～い
Dialogue: 0,0:13:04.05,0:13:05.68,A,,0,0,0,,私も　あなた以外…
Dialogue: 0,0:13:21.21,0:13:23.44,A,,0,0,0,,段ボール足んねえかも
Dialogue: 0,0:13:24.04,0:13:25.73,A,,0,0,0,,私　取ってくるね
Dialogue: 0,0:13:33.57,0:13:34.55,A,,0,0,0,,蒼井さん
Dialogue: 0,0:13:35.08,0:13:36.96,A,,0,0,0,,あっ　まこと先輩
Dialogue: 0,0:13:37.23,0:13:39.08,A,,0,0,0,,運ぶの　手伝おうか
Dialogue: 0,0:13:39.08,0:13:42.09,A,,0,0,0,,いえ　軽いので　余裕です
Dialogue: 0,0:13:42.74,0:13:44.37,A,,0,0,0,,そっか
Dialogue: 0,0:13:44.37,0:13:45.97,A,,0,0,0,,じゃあまた
Dialogue: 0,0:13:45.97,0:13:47.22,A,,0,0,0,,はい　また
Dialogue: 0,0:13:56.23,0:13:59.06,A,,0,0,0,,蒼井さん　やっぱり半分持つよ
Dialogue: 0,0:14:06.19,0:14:08.78,A,,0,0,0,,先輩のクラスは何やるんですか
Dialogue: 0,0:14:09.07,0:14:10.98,A,,0,0,0,,うちはたこ焼き屋さん
Dialogue: 0,0:14:10.98,0:14:12.67,A,,0,0,0,,蒼井さんのクラスは
Dialogue: 0,0:14:12.67,0:14:14.04,A,,0,0,0,,お化け屋敷です
Dialogue: 0,0:14:14.93,0:14:17.29,A,,0,0,0,,師匠のクラスは何やるんですかね
Dialogue: 0,0:14:17.55,0:14:21.17,A,,0,0,0,,それが聞いても教えてくれないんだよね　なぜか
Dialogue: 0,0:14:21.17,0:14:23.74,A,,0,0,0,,それは面白そうですね
Dialogue: 0,0:14:28.64,0:14:30.30,A,,0,0,0,,じゃあ　ここに置いとくね
Dialogue: 0,0:14:30.59,0:14:32.26,A,,0,0,0,,ありがとうございました
Dialogue: 0,0:14:32.26,0:14:34.31,A,,0,0,0,,蒼井　段ボールくれ…
Dialogue: 0,0:14:39.72,0:14:42.05,A,,0,0,0,,先輩が手伝ってくれたんだ
Dialogue: 0,0:14:42.05,0:14:45.16,A,,0,0,0,,あ… あの　ありがとうございました
Dialogue: 0,0:14:45.16,0:14:46.39,A,,0,0,0,,どういたしまして
Dialogue: 0,0:14:49.74,0:14:51.68,A,,0,0,0,,初めて近くで見た
Dialogue: 0,0:14:51.68,0:14:53.15,A,,0,0,0,,きれいな顔
Dialogue: 0,0:14:53.15,0:14:54.34,A,,0,0,0,,分かる分かる
Dialogue: 0,0:14:55.21,0:14:59.16,A,,0,0,0,,でもあれだな　思ったより普通の人なんだな
Dialogue: 0,0:14:59.16,0:15:00.96,A,,0,0,0,,会話もしてくれたし
Dialogue: 0,0:15:02.39,0:15:03.48,A,,0,0,0,,そっか
Dialogue: 0,0:15:04.38,0:15:08.33,A,,0,0,0,,先輩はもう　特別な人じゃないんだ
Dialogue: 0,0:15:19.24,0:15:20.98,A,,0,0,0,,セーフ
Dialogue: 0,0:15:21.24,0:15:22.85,A,,0,0,0,,マジか～
Dialogue: 0,0:15:23.12,0:15:24.11,A,,0,0,0,,は～い
Dialogue: 0,0:15:24.11,0:15:27.61,A,,0,0,0,,当たりくじを引いた人　こちらにお願いしま～す
Dialogue: 0,0:15:27.61,0:15:30.40,A,,0,0,0,,これも青春の{\fscx50} {\fscx}1{\fscx50} {\fscx}ページ
Dialogue: 0,0:15:37.99,0:15:40.50,A,,0,0,0,,師匠　お久しぶりです
Dialogue: 0,0:15:40.84,0:15:42.98,A,,0,0,0,,なんで最近来ねえんだよ
Dialogue: 0,0:15:42.98,0:15:44.50,A,,0,0,0,,ふひはへん…
Dialogue: 0,0:15:46.50,0:15:50.51,A,,0,0,0,,お昼ご飯のこと　師匠に言ってなかったですよね
Dialogue: 0,0:15:50.78,0:15:52.45,A,,0,0,0,,それだけじゃねえよ
Dialogue: 0,0:15:55.12,0:15:56.12,A,,0,0,0,,確かに
Dialogue: 0,0:15:57.36,0:15:58.52,A,,0,0,0,,おい　蒼井
Dialogue: 0,0:15:59.43,0:16:01.81,A,,0,0,0,,何か困ってたらちゃんと言えよ
Dialogue: 0,0:16:03.88,0:16:05.76,A,,0,0,0,,師匠はいい人ですね
Dialogue: 0,0:16:06.91,0:16:08.82,A,,0,0,0,,なんだよそれ
Dialogue: 0,0:16:09.12,0:16:12.60,A,,0,0,0,,あ～　そうそう　師匠のクラス何やるんですか
Dialogue: 0,0:16:12.60,0:16:13.81,A,,0,0,0,,行きますよ～
Dialogue: 0,0:16:13.81,0:16:15.70,A,,0,0,0,,絶対来るなよ
Dialogue: 0,0:17:38.15,0:17:39.78,A,,0,0,0,,まこと先輩
Dialogue: 0,0:17:40.06,0:17:42.46,A,,0,0,0,,たこ焼き{\fscx50} {\fscx}1{\fscx50} {\fscx}つく～ださい
Dialogue: 0,0:17:43.53,0:17:44.80,A,,0,0,0,,来てくれたんだ
Dialogue: 0,0:17:44.80,0:17:46.29,A,,0,0,0,,もちろんですよ
Dialogue: 0,0:17:46.59,0:17:48.29,A,,0,0,0,,はい　まことくん　これ
Dialogue: 0,0:17:48.69,0:17:50.22,A,,0,0,0,,シフトはもう終わりだし
Dialogue: 0,0:17:50.22,0:17:51.80,A,,0,0,0,,2{\fscx50} {\fscx}人で食べてきなよ
Dialogue: 0,0:17:57.05,0:17:59.58,G,,0,0,0,,先輩　髪すてきですね
Dialogue: 0,0:17:59.58,0:18:02.33,G,,0,0,0,,蒼井さんも　お化けの格好似合ってるよ
Dialogue: 0,0:18:02.33,0:18:04.07,G,,0,0,0,,ちょっとびっくりしたけど
Dialogue: 0,0:18:04.07,0:18:07.06,A,,0,0,0,,そういえば　先輩怖いの苦手でしたよね
Dialogue: 0,0:18:07.46,0:18:09.06,A,,0,0,0,,大丈夫ですか
Dialogue: 0,0:18:09.78,0:18:10.92,A,,0,0,0,,や…
Dialogue: 0,0:18:10.92,0:18:13.65,A,,0,0,0,,蒼井さんのお化けはカワイイから　大丈夫
Dialogue: 0,0:18:14.32,0:18:15.80,A,,0,0,0,,じゃあよかったです
Dialogue: 0,0:18:17.04,0:18:18.93,A,,0,0,0,,たこ焼き　おいしいね
Dialogue: 0,0:18:18.93,0:18:20.29,A,,0,0,0,,ですね～
Dialogue: 0,0:18:21.87,0:18:23.89,A,,0,0,0,,食べたら竜二のクラス行こっか
Dialogue: 0,0:18:23.89,0:18:25.28,A,,0,0,0,,大賛成です
Dialogue: 0,0:18:38.63,0:18:40.73,A,,0,0,0,,師匠　カワイイ
Dialogue: 0,0:18:40.73,0:18:42.72,A,,0,0,0,,似合ってるよ　竜二
Dialogue: 0,0:18:42.72,0:18:44.93,A,,0,0,0,,来るなって言っただろ
Dialogue: 0,0:18:44.93,0:18:47.28,A,,0,0,0,,え～　いいじゃないですかあ
Dialogue: 0,0:18:47.98,0:18:50.02,A,,0,0,0,,超プリティーですよ
Dialogue: 0,0:18:50.02,0:18:50.78,A,,0,0,0,,言うな
Dialogue: 0,0:18:50.36,0:18:51.48,A,,800,0,0,,いい感じだね
Dialogue: 0,0:18:51.71,0:18:53.96,A,,0,0,0,,おい　竜二　ちゃんとやれよ
Dialogue: 0,0:18:53.96,0:18:55.98,A,,0,0,0,,ご… ご注文は
Dialogue: 0,0:18:56.38,0:18:57.44,A,,0,0,0,,オムライスで
Dialogue: 0,0:18:57.44,0:18:58.46,A,,0,0,0,,私も
Dialogue: 0,0:18:58.46,0:19:00.74,A,,0,0,0,,ケチャップでハートかいてください
Dialogue: 0,0:19:01.10,0:19:02.87,A,,0,0,0,,かしこまりました…
Dialogue: 0,0:19:17.43,0:19:20.78,G,,0,0,0,,じゃあ　私そろそろお化けタイムなので
Dialogue: 0,0:19:20.78,0:19:22.26,G,,0,0,0,,行きますね
Dialogue: 0,0:19:22.26,0:19:25.01,G,,0,0,0,,最強のお化けを演じてきます～
Dialogue: 0,0:19:25.01,0:19:26.06,G,,0,0,0,,最強？
Dialogue: 0,0:19:26.06,0:19:27.22,G,,0,0,0,,どんなんだよ
Dialogue: 0,0:19:27.77,0:19:30.85,A,,0,0,0,,ねえ　今からシフト入れる男子いない
Dialogue: 0,0:19:30.85,0:19:31.77,A,,0,0,0,,どうした
Dialogue: 0,0:19:31.77,0:19:35.06,A,,0,0,0,,体調不良で　1{\fscx50} {\fscx}人足りなくなっちゃって
Dialogue: 0,0:19:36.62,0:19:39.73,A,,0,0,0,,それって　ほかのクラスのヤツでもいいか
Dialogue: 0,0:19:56.17,0:19:58.36,G,,0,0,0,,一気に客増えたなあ
Dialogue: 0,0:19:58.36,0:19:59.55,G,,0,0,0,,そうだね
Dialogue: 0,0:19:59.55,0:20:00.17,G,,0,0,0,,ね
Dialogue: 0,0:20:00.50,0:20:02.81,A,,0,0,0,,いや　もう普通にかわいいよな
Dialogue: 0,0:20:02.81,0:20:04.17,A,,0,0,0,,女に見えてきた
Dialogue: 0,0:20:04.17,0:20:06.78,A,,0,0,0,,そりゃもともと女装してるしな
Dialogue: 0,0:20:14.49,0:20:16.81,A,,0,0,0,,キャンプファイヤーが始まります
Dialogue: 0,0:20:17.20,0:20:21.32,A,,0,0,0,,片付けの終わった生徒は　グラウンドに集合してください
Dialogue: 0,0:20:22.57,0:20:23.82,A,,0,0,0,,きれいだね
Dialogue: 0,0:20:24.64,0:20:25.90,A,,0,0,0,,行かないのか
Dialogue: 0,0:20:28.23,0:20:30.70,A,,0,0,0,,もうちょっとだけ　これ着てたいなって
Dialogue: 0,0:20:31.45,0:20:32.59,A,,0,0,0,,そっか
Dialogue: 0,0:20:34.23,0:20:36.44,A,,0,0,0,,僕　大丈夫だったかな
Dialogue: 0,0:20:36.44,0:20:37.46,A,,0,0,0,,何が
Dialogue: 0,0:20:37.72,0:20:40.82,A,,0,0,0,,いろいろ　迷惑かけてなかった
Dialogue: 0,0:20:40.82,0:20:41.97,A,,0,0,0,,大丈夫だ
Dialogue: 0,0:20:42.26,0:20:44.94,A,,0,0,0,,それに似合ってた　俺よりもな
Dialogue: 0,0:20:49.68,0:20:51.54,A,,0,0,0,,そろそろ着替えよっか
Dialogue: 0,0:20:51.54,0:20:52.48,A,,0,0,0,,ああ
Dialogue: 0,0:20:52.80,0:20:54.29,A,,0,0,0,,竜二の制服　これ
Dialogue: 0,0:20:54.98,0:20:57.11,A,,0,0,0,,ああ　いい　自分で取る
Dialogue: 0,0:20:58.38,0:20:59.57,A,,0,0,0,,はい　竜二
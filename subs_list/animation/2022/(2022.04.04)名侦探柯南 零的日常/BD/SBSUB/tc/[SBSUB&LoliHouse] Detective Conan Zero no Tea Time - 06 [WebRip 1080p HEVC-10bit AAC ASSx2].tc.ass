Comment: 0,0:00:33.01,0:00:33.01,TEATIME-OP-BOTTOM,,0,0,0,,
Dialogue: 0,0:00:31.89,0:00:33.93,TEATIME-OP-BOTTOM,,0,0,0,,Get the Volume up
Dialogue: 0,0:00:33.93,0:00:35.89,TEATIME-OP-BOTTOM,,0,0,0,,飛馳於失去色彩的Highway
Dialogue: 0,0:00:35.89,0:00:39.94,TEATIME-OP-BOTTOM,,0,0,0,,在停滯的時間中 turn me on
Dialogue: 0,0:00:39.94,0:00:42.06,TEATIME-OP-BOTTOM,,0,0,0,,the truth is always blind
Dialogue: 0,0:00:42.06,0:00:43.98,TEATIME-OP-BOTTOM,,0,0,0,,虛假的話語
Dialogue: 0,0:00:43.98,0:00:48.07,TEATIME-OP-BOTTOM,,0,0,0,,也重疊於今日 聲音消散
Dialogue: 0,0:00:48.82,0:00:50.53,TEATIME-OP-BOTTOM,,0,0,0,,急切渴求的理由
Dialogue: 0,0:00:50.82,0:00:53.28,TEATIME-OP-BOTTOM,,0,0,0,,也在城市天空的盡頭
Dialogue: 0,0:00:53.28,0:00:57.58,TEATIME-OP-BOTTOM,,0,0,0,,清晰可見
Dialogue: 0,0:00:57.58,0:01:00.12,TEATIME-OP-BOTTOM,,0,0,0,,世界Like a Shooting Star
Dialogue: 0,0:01:00.12,0:01:02.17,TEATIME-OP-BOTTOM,,0,0,0,,若知曉心願
Dialogue: 0,0:01:02.17,0:01:03.96,TEATIME-OP-BOTTOM,,0,0,0,,不論何人
Dialogue: 0,0:01:03.96,0:01:06.50,TEATIME-OP-BOTTOM,,0,0,0,,都會深陷瞬間而永恆的夢
Dialogue: 0,0:01:06.50,0:01:08.01,TEATIME-OP-BOTTOM,,0,0,0,,若知曉「哀傷」
Dialogue: 0,0:01:08.01,0:01:10.30,TEATIME-OP-BOTTOM,,0,0,0,,便能回歸零點Tears in Lies
Dialogue: 0,0:01:10.30,0:01:14.01,TEATIME-OP-BOTTOM,,0,0,0,,即便知曉善惡之罪
Dialogue: 0,0:01:14.01,0:01:20.81,TEATIME-OP-BOTTOM,,0,0,0,,也要抬頭鎖定目標
Comment: 0,0:12:14.76,0:12:17.76,TEATIME-ED-BOTTOM,,0,0,0,,
Dialogue: 0,0:09:50.90,0:09:55.87,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	無色透明的我
Dialogue: 0,0:09:56.28,0:10:00.83,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	駐足於緋紅的天空下
Dialogue: 0,0:10:01.83,0:10:08.67,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便憎惡這不近人情的世界
Dialogue: 0,0:10:09.09,0:10:12.76,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也無法逃離 Decided
Dialogue: 0,0:10:13.59,0:10:18.14,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	將手伸向光芒
Dialogue: 0,0:10:13.59,0:10:18.14,TEATIME-ED-BOTTOM,ED,0,0,0,,{\pos(1034,1032)}	{\blur3\fs34}	明天
Dialogue: 0,0:10:18.14,0:10:23.10,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday
Dialogue: 0,0:10:23.10,0:10:28.40,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	不懈追逐 仍遙不可及
Dialogue: 0,0:10:28.40,0:10:34.03,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便想要守護之物不復存在
Dialogue: 0,0:10:34.20,0:10:38.66,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也只能繼續掙扎
Dialogue: 0,0:10:38.66,0:10:40.16,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	你聽
Dialogue: 0,0:10:40.16,0:10:44.92,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, promise to yourself
Dialogue: 0,0:10:44.92,0:10:50.38,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	用無數張面孔塗改未來
Dialogue: 0,0:10:50.38,0:10:58.01,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3\fad(0,200}	將一去不返的時光深藏於心
Comment: 0,0:03:09.00,0:03:09.00,Title,,0,0,0,,
Dialogue: 0,0:00:31.89,0:00:33.93,TEATIME-OP-TOP,,0,0,0,,Get the Volume up
Dialogue: 0,0:00:33.93,0:00:35.89,TEATIME-OP-TOP,,0,0,0,,色を無くしたHighway
Dialogue: 0,0:00:35.89,0:00:39.94,TEATIME-OP-TOP,,0,0,0,,止まってしまった時間に turn me on
Dialogue: 0,0:00:39.94,0:00:42.06,TEATIME-OP-TOP,,0,0,0,,the truth is always blind
Dialogue: 0,0:00:42.06,0:00:43.98,TEATIME-OP-TOP,,0,0,0,,偽りの声も
Dialogue: 0,0:00:43.98,0:00:48.07,TEATIME-OP-TOP,,0,0,0,,重なる今日に音が消える
Dialogue: 0,0:00:48.82,0:00:50.53,TEATIME-OP-TOP,,0,0,0,,焦がれ求む理由も
Dialogue: 0,0:00:50.82,0:00:53.28,TEATIME-OP-TOP,,0,0,0,,街の空の果てに
Dialogue: 0,0:00:53.28,0:00:57.58,TEATIME-OP-TOP,,0,0,0,,見える
Dialogue: 0,0:00:57.58,0:01:00.12,TEATIME-OP-TOP,,0,0,0,,世界はLike a Shooting Star
Dialogue: 0,0:01:00.12,0:01:02.17,TEATIME-OP-TOP,,0,0,0,,願いを知れば
Dialogue: 0,0:01:02.17,0:01:03.96,TEATIME-OP-TOP,,0,0,0,,一瞬が永遠の
Dialogue: 0,0:01:03.96,0:01:06.50,TEATIME-OP-TOP,,0,0,0,,夢に誰も捉われる
Dialogue: 0,0:01:06.50,0:01:08.01,TEATIME-OP-TOP,,0,0,0,,「哀」を知れば
Dialogue: 0,0:01:08.01,0:01:10.30,TEATIME-OP-TOP,,0,0,0,,ゼロに戻るTears in Lies
Dialogue: 0,0:01:10.30,0:01:14.01,TEATIME-OP-TOP,,0,0,0,,善悪の罪を知る
Dialogue: 0,0:01:14.01,0:01:20.81,TEATIME-OP-TOP,,0,0,0,,それでも顔上げ狙い定める
Dialogue: 0,0:00:52.99,0:00:52.99,Title,,0,0,0,,
Comment: 0,0:03:09.00,0:03:09.00,Title,,0,0,0,,
Dialogue: 0,0:09:50.90,0:09:55.87,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	透明な僕をみていた
Dialogue: 0,0:09:56.28,0:10:00.83,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	空があかく染まって
Dialogue: 0,0:10:01.83,0:10:08.67,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	不条理を憎んでもここからは
Dialogue: 0,0:10:09.09,0:10:12.76,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	逃げ出せないから Decided
Dialogue: 0,0:10:13.59,0:10:18.14,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	光へ手をのばして
Dialogue: 0,0:10:13.59,0:10:18.14,TEATIME-ED-TOP,ED,0,0,0,,{\pos(842,3)}	{\blur3\fs28}	あした
Dialogue: 0,0:10:18.14,0:10:23.10,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday
Dialogue: 0,0:10:23.10,0:10:28.40,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	追いかけても追いかけても　未だ
Dialogue: 0,0:10:28.40,0:10:34.03,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	守りたいものさえ消えていくけど
Dialogue: 0,0:10:34.20,0:10:38.66,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	足掻き続けるしかないの
Dialogue: 0,0:10:38.66,0:10:40.16,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	ねぇ、聞いて
Dialogue: 0,0:10:40.16,0:10:44.92,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	Find the truth, promise to yourself
Dialogue: 0,0:10:44.92,0:10:50.38,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	いくつもの顔で塗り変えて行く未来
Dialogue: 0,0:10:50.38,0:10:58.01,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3\fad(0,200)}	戻らない時間を胸にそっとしまって

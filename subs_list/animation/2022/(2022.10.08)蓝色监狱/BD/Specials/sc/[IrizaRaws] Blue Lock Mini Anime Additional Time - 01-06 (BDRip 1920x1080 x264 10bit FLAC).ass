Dialogue: 1,0:03:37.28,0:03:40.40,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:03:40.86,0:03:44.49,CN - Top,,0,0,0,,我说 其他人的菜是什么啊？
Dialogue: 1,0:03:44.49,0:03:47.87,CN,,0,0,0,,总要比我们的纳豆和萝卜干要好吧
Dialogue: 1,0:03:47.87,0:03:49.29,CN,,0,0,0,,去调查看看吧
Dialogue: 1,0:03:49.71,0:03:52.42,CN,,0,0,0,,嗯？我的是炒蔬菜
Dialogue: 1,0:03:52.42,0:03:54.59,CN,,0,0,0,,完美的营养搭配
Dialogue: 1,0:03:54.59,0:03:56.75,CN,,0,0,0,,好羡慕啊
Dialogue: 1,0:03:57.05,0:03:58.34,CN,,0,0,0,,我的是咖喱
Dialogue: 1,0:03:58.34,0:04:02.18,CN,,0,0,0,,王者！绝对的拌饭王 咖喱！
Dialogue: 1,0:04:02.18,0:04:04.10,CN,,0,0,0,,我的神啊
Dialogue: 1,0:04:04.43,0:04:07.43,CN,,0,0,0,,国神 能不能换一下菜？
Dialogue: 1,0:04:07.43,0:04:10.27,CN,,0,0,0,,纳豆和萝卜干都可以给你
Dialogue: 1,0:04:10.27,0:04:12.19,CN,,0,0,0,,求你了 就一次
Dialogue: 1,0:04:12.19,0:04:14.98,CN,,0,0,0,,让我们尝尝伟大的咖喱吧
Dialogue: 1,0:04:15.44,0:04:17.53,CN,,0,0,0,,真没你们办法
Dialogue: 1,0:04:17.53,0:04:18.90,CN,,0,0,0,,就今天而已啊
Dialogue: 1,0:04:18.90,0:04:20.53,CN,,0,0,0,,神啊
Dialogue: 1,0:04:20.53,0:04:22.95,CN,,0,0,0,,咖喱神 国神大人
Dialogue: 1,0:04:23.32,0:04:25.83,CN,,0,0,0,,嗯？我也想吃咖喱啊
Dialogue: 1,0:04:26.24,0:04:28.74,CN,,0,0,0,,要不要交换 国神
Dialogue: 1,0:04:28.74,0:04:31.41,CN,,0,0,0,,和我的炒蔬菜 选哪个？
Dialogue: 1,0:04:32.54,0:04:34.38,CN,,0,0,0,,不嫌弃的话 请和我交换
Dialogue: 1,0:04:36.96,0:04:39.05,CN,,0,0,0,,我就知道会这样
Dialogue: 1,0:04:39.05,0:04:40.51,CN,,0,0,0,,我的神啊
Dialogue: 0,0:03:37.28,0:03:40.40,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:03:40.86,0:03:44.49,JP - Top,,0,0,0,,なあ　他の奴のおかずって　何食ってんだろう？
Dialogue: 0,0:03:44.49,0:03:47.87,JP,,0,0,0,,俺らの納豆とたくあんよりはマシだろ
Dialogue: 0,0:03:47.87,0:03:49.29,JP,,0,0,0,,調査しに行くか！
Dialogue: 0,0:03:49.71,0:03:52.42,JP,,0,0,0,,え？俺は野菜炒めだけど
Dialogue: 0,0:03:52.42,0:03:54.59,JP,,0,0,0,,圧倒的栄養バランス！
Dialogue: 0,0:03:54.59,0:03:56.75,JP,,0,0,0,,うらやましすぎる！
Dialogue: 0,0:03:57.05,0:03:58.34,JP,,0,0,0,,俺はカレー
Dialogue: 0,0:03:58.34,0:04:02.18,JP,,0,0,0,,王者！ご飯のお供の絶対王　カレー！
Dialogue: 0,0:04:02.18,0:04:04.10,JP,,0,0,0,,ナマステ！
Dialogue: 0,0:04:04.43,0:04:07.43,JP,,0,0,0,,なあ　國神　おかず　トレードしてくんねえ？
Dialogue: 0,0:04:07.43,0:04:10.27,JP,,0,0,0,,納豆とたくあん　両方つけるから
Dialogue: 0,0:04:10.27,0:04:12.19,JP,,0,0,0,,お願い　一回だけ
Dialogue: 0,0:04:12.19,0:04:14.98,JP,,0,0,0,,カレーさまのスペクタクルを我々にも
Dialogue: 0,0:04:15.44,0:04:17.53,JP,,0,0,0,,ったく　しかたねえな
Dialogue: 0,0:04:17.53,0:04:18.90,JP,,0,0,0,,今日だけだぞ
Dialogue: 0,0:04:18.90,0:04:20.53,JP,,0,0,0,,おお　神
Dialogue: 0,0:04:20.53,0:04:22.95,JP,,0,0,0,,カレー神　国神さま
Dialogue: 0,0:04:23.32,0:04:25.83,JP,,0,0,0,,え？俺もカレー食いたいが
Dialogue: 0,0:04:26.24,0:04:28.74,JP,,0,0,0,,トレードしようぜ　国神
Dialogue: 0,0:04:28.74,0:04:31.41,JP,,0,0,0,,この野菜炒めとどっちをとる？
Dialogue: 0,0:04:32.54,0:04:34.38,JP,,0,0,0,,よろしくお願いします　僕でよければ
Dialogue: 0,0:04:36.96,0:04:39.05,JP,,0,0,0,,どうせこんなこったると思うんだよ
Dialogue: 0,0:04:39.05,0:04:40.51,JP,,0,0,0,,ナマステ！
Dialogue: 0,0:04:53.82,0:04:56.74,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#5　蓝色监狱物资介绍
Dialogue: 1,0:04:50.77,0:04:53.77,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:04:54.44,0:04:57.57,CN - Top,,0,0,0,,这个 这个 还有这个
Dialogue: 1,0:04:57.57,0:05:00.53,CN - Top,,0,0,0,,都是蓝色监狱的特有物资呢
Dialogue: 1,0:05:00.99,0:05:03.24,CN,,0,0,0,,那个 现在牙刷上写下名字吧
Dialogue: 1,0:05:03.24,0:05:04.70,CN,,0,0,0,,不然到时候会弄混
Dialogue: 1,0:05:05.08,0:05:06.08,CN,,0,0,0,,好
Dialogue: 1,0:05:06.08,0:05:07.79,CN,,0,0,0,,了解
Dialogue: 1,0:05:11.96,0:05:17.30,CN,,0,0,0,,字 会反映内心 是人之鉴也
Dialogue: 1,0:05:20.93,0:05:21.72,CN,,0,0,0,,写好了
Dialogue: 1,0:05:22.51,0:05:24.68,CN,,0,0,0,,快看 这是我的
Dialogue: 1,0:05:24.97,0:05:26.77,CN,,0,0,0,,海豚图案
Dialogue: 1,0:05:28.18,0:05:30.73,CN,,0,0,0,,写着「我」字的就是我的牙刷
Dialogue: 1,0:05:30.73,0:05:33.06,CN,,0,0,0,,敢弄错就宰了你们
Dialogue: 1,0:05:33.69,0:05:35.61,CN,,0,0,0,,我牙丸字写得好丑
Dialogue: 1,0:05:35.90,0:05:39.24,CN,,0,0,0,,第一次吗 你是第一次写字吗
Dialogue: 1,0:05:42.28,0:05:45.41,CN,,0,0,0,,我到底能不能
Dialogue: 1,0:05:45.41,0:05:47.08,CN,,0,0,0,,和这群家伙相处下去啊…
Dialogue: 0,0:04:50.77,0:04:53.77,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:04:54.44,0:04:57.57,JP - Top,,0,0,0,,これも　これも　ってこれも
Dialogue: 0,0:04:57.57,0:05:00.53,JP - Top,,0,0,0,,全部ブルーロックの特殊の備品なんだね
Dialogue: 0,0:05:00.99,0:05:03.24,JP,,0,0,0,,ぁなぁ　歯ブラシは名前書いとこよ
Dialogue: 0,0:05:03.24,0:05:04.70,JP,,0,0,0,,誰のが分かんなくなるから
Dialogue: 0,0:05:05.08,0:05:06.08,JP,,0,0,0,,ほい
Dialogue: 0,0:05:06.08,0:05:07.79,JP,,0,0,0,,了解
Dialogue: 0,0:05:11.96,0:05:17.30,JP,,0,0,0,,字とは　心を表す　その人間の鏡なり
Dialogue: 0,0:05:20.93,0:05:21.72,JP,,0,0,0,,できた
Dialogue: 0,0:05:22.51,0:05:24.68,JP,,0,0,0,,みてみて　これ俺のだね
Dialogue: 0,0:05:24.97,0:05:26.77,JP,,0,0,0,,イルカのマーク
Dialogue: 0,0:05:28.18,0:05:30.73,JP,,0,0,0,,「おれ」って書いてるやつを俺のだから
Dialogue: 0,0:05:30.73,0:05:33.06,JP,,0,0,0,,間ちっかたら殺すぞ
Dialogue: 0,0:05:33.69,0:05:35.61,JP,,0,0,0,,我牙丸　字汚ねえ
Dialogue: 0,0:05:35.90,0:05:39.24,JP,,0,0,0,,初めてか　初めて文字書いたか
Dialogue: 0,0:05:42.28,0:05:45.41,JP,,0,0,0,,俺　やっていけるかな
Dialogue: 0,0:05:45.41,0:05:47.08,JP,,0,0,0,,こいつらと
Dialogue: 0,0:05:58.21,0:06:01.13,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#6 叛徒
Dialogue: 1,0:05:55.13,0:05:58.17,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:05:58.63,0:06:03.34,CN,,0,0,0,,看吧 这就是最好的早餐
Dialogue: 1,0:06:03.34,0:06:05.64,CN,,0,0,0,,早餐还是得吃面包啊
Dialogue: 1,0:06:05.64,0:06:08.35,CN,,0,0,0,,不 不吃饭怎么赢
Dialogue: 1,0:06:08.35,0:06:11.43,CN,,0,0,0,,米饭乃是日本人的灵魂
Dialogue: 1,0:06:11.43,0:06:12.81,CN,,0,0,0,,不对
Dialogue: 1,0:06:12.81,0:06:15.65,CN,,0,0,0,,吃面包搭配多啊
Dialogue: 1,0:06:15.65,0:06:18.02,CN,,0,0,0,,中午和晚上都吃饭
Dialogue: 1,0:06:18.02,0:06:20.86,CN,,0,0,0,,那早上只能吃面包了啊 笨蛋
Dialogue: 1,0:06:20.86,0:06:22.86,CN,,0,0,0,,早上才该要吃饭啊
Dialogue: 1,0:06:22.86,0:06:25.36,CN,,0,0,0,,吃面包很快就饿了
Dialogue: 1,0:06:25.36,0:06:27.16,CN,,0,0,0,,味噌汁和米板
Dialogue: 1,0:06:27.16,0:06:30.87,CN,,0,0,0,,现在正是夺回传统早餐之时
Dialogue: 1,0:06:32.79,0:06:34.46,CN,,0,0,0,,洗得真爽
Dialogue: 1,0:06:35.37,0:06:36.33,CN,,0,0,0,,喂 久远
Dialogue: 1,0:06:36.33,0:06:37.67,CN,,0,0,0,,早餐吃面包对吧
Dialogue: 1,0:06:38.04,0:06:39.84,CN,,0,0,0,,作为日本人 吃饭才对
Dialogue: 1,0:06:40.38,0:06:42.09,CN,,0,0,0,,选哪个 回答我
Dialogue: 1,0:06:42.34,0:06:44.09,CN,,0,0,0,,请投出你神圣的一票
Dialogue: 1,0:06:44.09,0:06:46.14,CN,,0,0,0,,呃 这…
Dialogue: 1,0:06:46.51,0:06:51.22,CN,,0,0,0,,我觉得牛奶泡玉米片最好
Dialogue: 1,0:06:51.32,0:06:53.37,CN,,0,0,0,,你这混蛋 叛徒
Dialogue: 1,0:06:53.37,0:06:55.58,CN,,0,0,0,,这有隐藏的玉米片派
Dialogue: 1,0:06:55.58,0:06:57.96,CN,,0,0,0,,加入米饭教吧
Dialogue: 1,0:06:57.96,0:07:00.29,CN,,0,0,0,,诅咒你长酵母菌
Dialogue: 0,0:05:55.13,0:05:58.17,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:05:58.63,0:06:03.34,JP,,0,0,0,,見よ　ベスト　オブ　ブレックファースト
Dialogue: 0,0:06:03.34,0:06:05.64,JP,,0,0,0,,朝はやっぱパンでしょ
Dialogue: 0,0:06:05.64,0:06:08.35,JP,,0,0,0,,いいや　ご飯しか勝たん
Dialogue: 0,0:06:08.35,0:06:11.43,JP,,0,0,0,,お米は日本人の心なりよ
Dialogue: 0,0:06:11.43,0:06:12.81,JP,,0,0,0,,いいや　いいや
Dialogue: 0,0:06:12.81,0:06:15.65,JP,,0,0,0,,パンのほうがバリエーション豊富だし
Dialogue: 0,0:06:15.65,0:06:18.02,JP,,0,0,0,,昼も夜も白飯食うんだから
Dialogue: 0,0:06:18.02,0:06:20.86,JP,,0,0,0,,朝はパンしかねえだろ　バーカ
Dialogue: 0,0:06:20.86,0:06:22.86,JP,,0,0,0,,朝こそ　ご飯でしょ
Dialogue: 0,0:06:22.86,0:06:25.36,JP,,0,0,0,,パンなんて腹持ち悪いし～
Dialogue: 0,0:06:25.36,0:06:27.16,JP,,0,0,0,,みそ汁とご飯
Dialogue: 0,0:06:27.16,0:06:30.87,JP,,0,0,0,,今こそ　日本人の朝食を　取り戻すなりよ
Dialogue: 0,0:06:32.79,0:06:34.46,JP,,0,0,0,,いいお風呂だった
Dialogue: 0,0:06:35.37,0:06:36.33,JP,,0,0,0,,おい　久遠
Dialogue: 0,0:06:36.33,0:06:37.67,JP,,0,0,0,,朝　パンだよな
Dialogue: 0,0:06:38.04,0:06:39.84,JP,,0,0,0,,ご飯っしょ　日本人なら
Dialogue: 0,0:06:40.38,0:06:42.09,JP,,0,0,0,,どっち　答えろ
Dialogue: 0,0:06:42.34,0:06:44.09,JP,,0,0,0,,清き一票を
Dialogue: 0,0:06:44.09,0:06:46.14,JP,,0,0,0,,えっ…やぁ
Dialogue: 0,0:06:46.51,0:06:51.22,JP,,0,0,0,,お…俺は　コーンフレークに牛乳がベストかな
Dialogue: 0,0:06:51.32,0:06:53.37,JP,,0,0,0,,てめえ　コラ　裏切り者
Dialogue: 0,0:06:53.37,0:06:55.58,JP,,0,0,0,,隠れコーンフレーク派がいるぞ
Dialogue: 0,0:06:55.58,0:06:57.96,JP,,0,0,0,,ご飯教へ入信せよ
Dialogue: 0,0:06:57.96,0:07:00.29,JP,,0,0,0,,久遠にイースト菌の呪いを

Dialogue: 0,0:00:00.17,0:00:02.92,Default,,0,0,0,SP,（一年A班宿舍）
Dialogue: 0,0:00:10.30,0:00:12.14,Default,,0,0,0,,綠谷，爆豪
Dialogue: 0,0:00:14.89,0:00:16.81,Default,,0,0,0,,如果你們沒有地方可去的話
Dialogue: 0,0:00:17.72,0:00:18.93,Default,,0,0,0,,要來嗎？
Dialogue: 0,0:00:19.60,0:00:21.35,Default,,0,0,0,,到第一名英雄
Dialogue: 0,0:00:21.94,0:00:23.94,Default,,0,0,0,,安德瓦那裡實習
Dialogue: 0,0:00:30.32,0:00:33.24,Default,,0,0,0,,雄英高中英雄科的每一位學生
Dialogue: 0,0:00:33.32,0:00:37.16,Default,,0,0,0,,都利用寒假時間，開始了英雄實習
Dialogue: 1,0:00:38.95,0:00:43.79,Default2,,0,0,0,,我跟小勝、轟同學
Dialogue: 0,0:00:38.95,0:00:43.79,Default,,0,0,0,,到了第一名英雄安德瓦那邊實習
Dialogue: 1,0:00:45.17,0:00:50.84,Default2,,0,0,0,,峰田同學、上鳴同學、瀨呂同學
Dialogue: 0,0:00:45.17,0:00:50.84,Default,,0,0,0,,跟鹽崎同學到了潛伏者團隊
Dialogue: 0,0:00:51.68,0:00:54.39,Default,,0,0,0,,切島同學跟鐵哲同學、天喰學長
Dialogue: 0,0:00:54.47,0:00:56.10,Default,,0,0,0,,到了胖胖橡膠那裡
Dialogue: 1,0:00:57.26,0:01:01.64,Default2,,0,0,0,,當其他同學各自在其他職業英雄
Dialogue: 0,0:00:57.26,0:01:01.64,Default,,0,0,0,,那邊過著繁忙生活的時候
Dialogue: 0,0:01:01.73,0:01:02.56,Default,,0,0,0,,我們幾個…
Dialogue: 0,0:01:05.44,0:01:08.19,Default,,0,0,0,,光是為了跟上安德瓦就費盡力氣
Dialogue: 0,0:01:08.28,0:01:10.41,Default,,0,0,0,,就這樣結束了實習的第一天
Dialogue: 1,0:01:13.07,0:01:16.12,Default2,,0,0,0,,麗日同學跟蛙吹同學
Dialogue: 0,0:01:13.07,0:01:16.12,Default,,0,0,0,,去了龍九事務所啊
Dialogue: 0,0:01:16.74,0:01:18.95,Default,,0,0,0,,在那裡應該很辛苦吧
Dialogue: 0,0:01:26.17,0:01:29.34,Default,,0,0,0,,我委託的新戰鬥服已經送到了喔
Dialogue: 0,0:01:29.42,0:01:31.42,Default,,0,0,0,,很棒喔，御茶子
Dialogue: 0,0:01:31.51,0:01:33.22,Default,,0,0,0,,很適合妳，無重麗
Dialogue: 0,0:01:34.05,0:01:35.18,Default,,0,0,0,,謝謝妳們
Dialogue: 0,0:01:35.26,0:01:38.64,Default,,0,0,0,,為什麼妳要做新的戰鬥服？
Dialogue: 0,0:01:38.72,0:01:40.43,Default,,0,0,0,,有什麼理由？告訴我嘛
Dialogue: 0,0:01:40.52,0:01:42.44,Default,,0,0,0,,這個是因為…
Dialogue: 0,0:01:48.02,0:01:49.65,Default,,0,0,0,,這是秘密
Dialogue: 0,0:01:49.73,0:01:53.11,Default,,0,0,0,,是秘密啊，為什麼？真不可思議
Dialogue: 0,0:01:53.95,0:01:56.70,Default,,0,0,0,,各位，實習第一天辛苦了
Dialogue: 0,0:01:56.78,0:01:58.87,Default,,0,0,0,,我們辦了小小的歡迎會
Dialogue: 0,0:01:59.66,0:02:01.04,Default,,0,0,0,,看起來好好吃
Dialogue: 1,0:02:02.04,0:02:03.71,Default2,,0,0,0,,-乾杯
Dialogue: 0,0:02:02.04,0:02:03.71,Default,,0,0,0,,-乾杯
Dialogue: 0,0:02:08.84,0:02:10.84,Default,,0,0,0,,出乎意料地很開心
Dialogue: 0,0:03:45.02,0:03:45.94,Default,,0,0,0,SP,（龍牌）
Dialogue: 0,0:03:46.02,0:03:47.98,Default,,0,0,0,,接著播報下一則新聞
Dialogue: 0,0:03:48.98,0:03:51.15,Default,,0,0,0,,卡非林國在發生大規模森林火災後
Dialogue: 0,0:03:51.23,0:03:52.65,Default,,0,0,0,,經過了一星期
Dialogue: 0,0:03:52.73,0:03:55.73,Default,,0,0,0,,火勢終於出現了控制的跡象
Dialogue: 0,0:03:55.82,0:03:57.03,Default,,0,0,0,,目前研判
Dialogue: 0,0:03:57.11,0:03:59.65,Default,,0,0,0,,火災發生的原因是由於
Dialogue: 1,0:03:59.74,0:04:02.16,Default2,,0,0,0,,生產違禁藥物“催格”的
Dialogue: 0,0:03:59.74,0:04:02.16,Default,,0,0,0,,地下工廠發生爆炸
Dialogue: 0,0:04:02.24,0:04:03.16,Default,,0,0,0,,催格？
Dialogue: 0,0:04:03.24,0:04:05.16,Default,,0,0,0,,我知道那個喔
Dialogue: 0,0:04:05.74,0:04:06.91,Default,,0,0,0,,我可以說嗎？
Dialogue: 0,0:04:07.00,0:04:08.17,Default,,0,0,0,,所謂的“催格”
Dialogue: 0,0:04:08.25,0:04:10.63,Default,,0,0,0,,就跟“布斯特”一樣是違禁藥物喔
Dialogue: 0,0:04:10.71,0:04:11.54,Default,,0,0,0,,是的
Dialogue: 1,0:04:12.33,0:04:16.04,Default2,,0,0,0,,據說可以強制
Dialogue: 0,0:04:12.33,0:04:16.04,Default,,0,0,0,,將個性的力量強化好幾倍
Dialogue: 0,0:04:16.88,0:04:18.97,Default,,0,0,0,,催格跟布斯特一樣
Dialogue: 0,0:04:19.05,0:04:21.34,Default,,0,0,0,,大量在日本國內市場上流通
Dialogue: 0,0:04:21.89,0:04:25.14,Default,,0,0,0,,如果流通的數量能因此減少就好了
Dialogue: 0,0:04:25.22,0:04:27.56,Default,,0,0,0,,關於那間爆炸的秘密工廠
Dialogue: 1,0:04:28.27,0:04:33.57,Default2,,0,0,0,,原本在倉庫內用來提煉
Dialogue: 0,0:04:28.27,0:04:33.57,Default,,0,0,0,,催格的藥物好像全部都不見了
Dialogue: 1,0:04:34.15,0:04:38.15,Default2,,0,0,0,,根據傳言，那些藥物
Dialogue: 0,0:04:34.15,0:04:38.15,Default,,0,0,0,,在爆炸前就已經被偷走了
Dialogue: 0,0:04:38.24,0:04:40.08,Default,,0,0,0,,那麼工廠之所以會爆炸
Dialogue: 1,0:04:40.15,0:04:43.24,Default2,,0,0,0,,目的就是為了
Dialogue: 0,0:04:40.15,0:04:43.24,Default,,0,0,0,,毀滅證據並誤導搜查囉？
Dialogue: 0,0:04:43.82,0:04:47.70,Default,,0,0,0,,不確定，不管怎樣這也僅止於傳言
Dialogue: 0,0:04:51.75,0:04:53.42,Default,,0,0,0,,那邊那艘船籍不明的船
Dialogue: 0,0:04:53.50,0:04:55.50,Default,,0,0,0,,快點給我停下來
Dialogue: 0,0:04:55.59,0:04:57.34,Default,,0,0,0,,這邊是日本的領海
Dialogue: 0,0:04:57.42,0:05:00.13,Default,,0,0,0,,不是其他國的人可以亂來的地方
Dialogue: 0,0:05:00.22,0:05:01.47,Default,,0,0,0,,小心我打飛你們
Dialogue: 0,0:05:01.55,0:05:03.97,Default,,0,0,0,,船長，您這樣太刺激對方了
Dialogue: 0,0:05:05.30,0:05:06.34,Default,,0,0,0,,這樣啊
Dialogue: 0,0:05:08.14,0:05:10.48,Default,,0,0,0,,船籍不明的船，快給我停下來
Dialogue: 0,0:05:10.56,0:05:11.77,Default,,0,0,0,,要是不停的話…
Dialogue: 0,0:05:12.48,0:05:13.98,Default,,0,0,0,,我會很困擾唷
Dialogue: 0,0:05:14.06,0:05:17.77,Default,,0,0,0,,一點都不可愛，而且對方根本沒在看
Dialogue: 0,0:05:17.86,0:05:20.07,Default,,0,0,0,,船長，那艘船上有人影
Dialogue: 0,0:05:20.65,0:05:21.57,Default,,0,0,0,,什麼？
Dialogue: 0,0:05:35.54,0:05:36.46,Default,,0,0,0,,是煙霧
Dialogue: 0,0:05:36.54,0:05:37.54,Default,,0,0,0,,視野被遮蔽了
Dialogue: 0,0:05:37.63,0:05:39.34,Default,,0,0,0,,雷達出現多個反應
Dialogue: 0,0:05:39.42,0:05:41.55,Default,,0,0,0,,煙霧裡摻有干擾箔嗎？
Dialogue: 0,0:05:41.63,0:05:43.76,Default,,0,0,0,,把海上瑪麗娜號動力開到最大
Dialogue: 0,0:05:43.84,0:05:45.17,Default,,0,0,0,,衝出這片煙霧
Dialogue: 0,0:05:45.26,0:05:46.93,Default,,0,0,0,,遵命
Dialogue: 1,0:05:48.39,0:05:52.35,Default2,,0,0,0,,在船籍不明船上的男人
Dialogue: 0,0:05:48.39,0:05:52.35,Default,,0,0,0,,應該是用了催格
Dialogue: 0,0:05:52.43,0:05:53.26,Default,,0,0,0,,是的
Dialogue: 0,0:05:53.35,0:05:56.27,Default,,0,0,0,,根據這艘船的航行路線進行推測
Dialogue: 1,0:05:56.35,0:05:59.27,Default2,,0,0,0,,能判斷出他們很有可能是從
Dialogue: 0,0:05:56.35,0:05:59.27,Default,,0,0,0,,卡非林國的港口出航的
Dialogue: 1,0:05:59.86,0:06:02.53,Default2,,0,0,0,,有傳聞指出
Dialogue: 0,0:05:59.86,0:06:02.53,Default,,0,0,0,,催格秘密工廠的爆炸事故中
Dialogue: 0,0:06:02.61,0:06:05.24,Default,,0,0,0,,有藥物被人偷走了
Dialogue: 0,0:06:05.32,0:06:08.24,Default,,0,0,0,,該不會藥物就在那艘船上？
Dialogue: 0,0:06:08.33,0:06:11.63,Default,,0,0,0,,我聞得到，味道都傳過來了
Dialogue: 0,0:06:12.62,0:06:14.62,Default,,0,0,0,,再過不久就能衝出這片煙霧了
Dialogue: 0,0:06:19.59,0:06:22.09,Default,,0,0,0,,失去船籍不明船的蹤影了
Dialogue: 0,0:06:22.67,0:06:24.01,Default,,0,0,0,,雷達也沒有任何反應
Dialogue: 0,0:06:24.92,0:06:27.01,Default,,0,0,0,,逃的速度倒是挺快的
Dialogue: 0,0:06:27.09,0:06:29.30,Default,,0,0,0,,從那艘船的逃跑路線來看…
Dialogue: 0,0:06:29.93,0:06:32.73,Default,,0,0,0,,他們應該藏在貝里斯群島的某個地方
Dialogue: 0,0:06:32.81,0:06:34.27,Default,,0,0,0,,這下棘手了
Dialogue: 0,0:06:34.89,0:06:36.93,Default,,0,0,0,,對方持有催格
Dialogue: 0,0:06:37.02,0:06:38.90,Default,,0,0,0,,雖然我方也有戰力
Dialogue: 0,0:06:39.61,0:06:41.70,Default,,0,0,0,,但貝里斯群島很複雜
Dialogue: 1,0:06:42.28,0:06:46.37,Default2,,0,0,0,,不光是海上
Dialogue: 0,0:06:42.28,0:06:46.37,Default,,0,0,0,,也需要從空中進行搜索嗎？
Dialogue: 0,0:06:46.91,0:06:48.24,Default,,0,0,0,,這樣的話…
Dialogue: 0,0:06:48.32,0:06:51.32,Default,,0,0,0,,天狼星，發出組隊的要求吧
Dialogue: 0,0:06:51.41,0:06:52.75,Default,,0,0,0,,要向哪一隊發出要求？
Dialogue: 0,0:06:53.95,0:06:55.79,Default,,0,0,0,,英雄告示牌排行榜第十名的…
Dialogue: 0,0:06:56.37,0:06:59.29,Default,,0,0,0,,龍之英雄，也就是龍九
Dialogue: 0,0:06:59.38,0:07:00.55,Default,,0,0,0,SP,（龍牌）
Dialogue: 0,0:07:00.63,0:07:03.01,Default,,0,0,0,,我們收到組隊要求，龍九
Dialogue: 0,0:07:03.09,0:07:04.01,Default,,0,0,0,,是誰發出的？
Dialogue: 0,0:07:04.09,0:07:06.30,Default,,0,0,0,,是海難英雄，塞爾奇
Dialogue: 0,0:07:06.38,0:07:07.71,Default,,0,0,0,,是塞爾奇先生？
Dialogue: 1,0:07:07.80,0:07:12.30,Default2,,0,0,0,,塞爾奇是梅雨職場體驗時
Dialogue: 0,0:07:07.80,0:07:12.30,Default,,0,0,0,,照顧妳的英雄吧
Dialogue: 0,0:07:12.39,0:07:14.35,Default,,0,0,0,,到底發生了什麼事情呢？
Dialogue: 0,0:07:14.43,0:07:17.02,Default,,0,0,0,,無重麗，弗洛皮還有捻麗
Dialogue: 0,0:07:17.10,0:07:18.56,Default,,0,0,0,,快點準備
Dialogue: 0,0:07:18.65,0:07:20.90,Default,,0,0,0,,龍九小隊，即將出動
Dialogue: 1,0:07:21.48,0:07:22.31,Default2,,0,0,0,,-好的
Dialogue: 0,0:07:21.48,0:07:22.31,Default,,0,0,0,,-好的
Dialogue: 0,0:07:27.03,0:07:29.32,Default,,0,0,0,SP,（太平洋，緣津群島）
Dialogue: 0,0:07:29.41,0:07:31.41,Default,,0,0,0,,歡迎妳的到來，龍九
Dialogue: 0,0:07:31.99,0:07:34.83,Default,,0,0,0,,既然逃走的走私船跟催格有關聯
Dialogue: 0,0:07:34.91,0:07:36.41,Default,,0,0,0,,我就不能坐視不管
Dialogue: 0,0:07:37.00,0:07:39.71,Default,,0,0,0,,我很樂意提供協助，塞爾奇
Dialogue: 0,0:07:39.79,0:07:41.50,Default,,0,0,0,,真是可靠啊
Dialogue: 0,0:07:41.58,0:07:43.62,Default,,0,0,0,,塞爾奇好開心
Dialogue: 0,0:07:44.25,0:07:45.67,Default,,0,0,0,,一點都不可愛
Dialogue: 0,0:07:45.76,0:07:47.14,Default,,0,0,0,,好可愛
Dialogue: 0,0:07:47.22,0:07:49.93,Default,,0,0,0,,塞爾奇船長，你完全沒變呢
Dialogue: 0,0:07:50.93,0:07:53.27,Default,,0,0,0,,妳過得還好嗎？弗洛皮
Dialogue: 0,0:07:53.35,0:07:57.23,Default,,0,0,0,,很好，職場體驗的時候受您照顧了
Dialogue: 0,0:08:02.65,0:08:05.70,Default,,0,0,0,,我們必須聽從船長下達的指令才行
Dialogue: 1,0:08:05.78,0:08:08.58,Default2,,0,0,0,,因為我們相信船長的決定
Dialogue: 0,0:08:05.78,0:08:08.58,Default,,0,0,0,,一定是最妥當的
Dialogue: 0,0:08:09.82,0:08:11.16,Default,,0,0,0,,弗洛皮也相信吧
Dialogue: 0,0:08:11.24,0:08:13.87,Default,,0,0,0,,相信船長，相信我們
Dialogue: 1,0:08:15.74,0:08:21.45,Default2,,0,0,0,,船長跟天狼星小姐教會了我
Dialogue: 0,0:08:15.74,0:08:21.45,Default,,0,0,0,,對英雄而言最重要的要領是什麼
Dialogue: 0,0:08:21.54,0:08:23.46,Default,,0,0,0,,妳成長了不少呢
Dialogue: 0,0:08:24.25,0:08:26.67,Default,,0,0,0,,我真的…
Dialogue: 0,0:08:27.34,0:08:28.47,Default,,0,0,0,,很感動呢
Dialogue: 0,0:08:29.05,0:08:30.18,Default,,0,0,0,,一點都不可愛
Dialogue: 0,0:08:30.26,0:08:31.76,Default,,0,0,0,,好可愛喔
Dialogue: 0,0:08:31.84,0:08:34.63,Default,,0,0,0,,對了，梅雨妳拿到臨時證照了吧
Dialogue: 0,0:08:34.72,0:08:36.14,Default,,0,0,0,,恭喜妳啊
Dialogue: 0,0:08:37.47,0:08:39.14,Default,,0,0,0,,妳已經能獨當一面了
Dialogue: 1,0:08:39.23,0:08:42.15,Default2,,0,0,0,,我很期待妳在這次
Dialogue: 0,0:08:39.23,0:08:42.15,Default,,0,0,0,,任務的表現喔，弗洛皮
Dialogue: 0,0:08:44.15,0:08:46.28,Default,,0,0,0,,好了，雖然妳們才剛到
Dialogue: 0,0:08:46.90,0:08:48.82,Default,,0,0,0,,但我希望妳們立刻去海灘…
Dialogue: 0,0:08:59.83,0:09:02.25,Default,,0,0,0,,去海灘好好地養精蓄銳一下
Dialogue: 0,0:09:02.33,0:09:03.25,Default,,0,0,0,,這邊…
Dialogue: 0,0:09:03.33,0:09:04.46,Default,,0,0,0,,來了
Dialogue: 0,0:09:04.54,0:09:05.83,Default,,0,0,0,,你到底想做什麼啊？
Dialogue: 0,0:09:05.92,0:09:07.21,Default,,0,0,0,,有什麼關係
Dialogue: 1,0:09:07.30,0:09:11.43,Default2,,0,0,0,,畢竟催格的走私船
Dialogue: 0,0:09:07.30,0:09:11.43,Default,,0,0,0,,應該要到晚上才會行動
Dialogue: 0,0:09:13.47,0:09:17.31,Default,,0,0,0,,所以現在就提高警戒也無濟於事啊
Dialogue: 0,0:09:17.39,0:09:18.85,Default,,0,0,0,,看我的
Dialogue: 0,0:09:45.04,0:09:47.29,Default,,0,0,0,,真好，看她們玩得這麼開心
Dialogue: 0,0:09:47.38,0:09:49.51,Default,,0,0,0,,感覺好和平
Dialogue: 0,0:09:49.59,0:09:52.09,Default,,0,0,0,,原來如此，是這麼回事啊
Dialogue: 1,0:09:53.22,0:09:56.35,Default2,,0,0,0,,因為我們英雄必須要
Dialogue: 0,0:09:53.22,0:09:56.35,Default,,0,0,0,,長時間跟邪惡對峙
Dialogue: 0,0:09:56.43,0:09:58.72,Default,,0,0,0,,並持續面對惡意
Dialogue: 1,0:09:58.81,0:10:01.98,Default2,,0,0,0,,所以你希望讓她們
Dialogue: 0,0:09:58.81,0:10:01.98,Default,,0,0,0,,親身感受到和平的可貴
Dialogue: 0,0:10:02.06,0:10:05.27,Default,,0,0,0,,進而產生守護和平的強烈意識
Dialogue: 0,0:10:05.35,0:10:07.27,Default,,0,0,0,,你是這麼想的吧
Dialogue: 0,0:10:07.86,0:10:11.91,Default,,0,0,0,,這是在跟邪惡戰鬥前的心理準備
Dialogue: 0,0:10:20.16,0:10:23.83,Default,,0,0,0,,英雄跟海上保安廳似乎加強了警戒
Dialogue: 0,0:10:23.91,0:10:27.33,Default,,0,0,0,,該怎麼辦？需要聯絡一下客戶嗎？
Dialogue: 0,0:10:27.42,0:10:28.25,Default,,0,0,0,,不了
Dialogue: 0,0:10:28.33,0:10:32.21,Default,,0,0,0,,最好假設我們的通訊都會遭到監聽
Dialogue: 0,0:10:32.30,0:10:34.22,Default,,0,0,0,,應該也會透過衛星監視我們
Dialogue: 0,0:10:34.30,0:10:37.26,Default,,0,0,0,,也就是說我們只能照計畫進行了嗎？
Dialogue: 0,0:10:37.34,0:10:38.68,Default,,0,0,0,,是啊，沒有錯
Dialogue: 0,0:10:38.76,0:10:40.10,Default,,0,0,0,,等到日落就展開行動
Dialogue: 0,0:10:41.22,0:10:42.97,Default,,0,0,0,,先準備好催格
Dialogue: 0,0:10:43.56,0:10:47.23,Default,,0,0,0,,在緊急時刻就會需要它幫忙了
Comment: 0,0:10:49.11,0:10:50.45,Default,,0,0,0,SP,（麗日御茶子，個性，無重力）
Comment: 0,0:10:50.52,0:10:52.98,Default,,0,0,0,SP,（透過指尖的肉球，能將碰到的東西\N或人化為無重力狀態）
Comment: 0,0:10:53.07,0:10:54.49,Default,,0,0,0,SP,（蛙吹梅雨，個性，青蛙）
Comment: 0,0:10:54.57,0:10:56.99,Default,,0,0,0,SP,（把舌頭伸長這種\N類似青蛙的特性都能辦得到）
Dialogue: 0,0:11:01.28,0:11:03.87,Default,,0,0,0,,我跟捻麗會從空中進行搜索
Dialogue: 0,0:11:04.45,0:11:07.16,Default,,0,0,0,,塞爾奇，無重麗跟弗洛皮就拜託你了
Dialogue: 0,0:11:07.96,0:11:09.30,Default,,0,0,0,,沒問題
Dialogue: 0,0:11:09.38,0:11:11.05,Default,,0,0,0,,準備出航
Dialogue: 1,0:11:11.13,0:11:12.30,Default2,,0,0,0,,-遵命
Dialogue: 0,0:11:11.13,0:11:12.30,Default,,0,0,0,,-遵命
Dialogue: 0,0:11:18.05,0:11:20.05,Default,,0,0,0,,繫船纜已經收起
Dialogue: 0,0:11:20.14,0:11:21.81,Default,,0,0,0,,兩舷微速前進
Dialogue: 0,0:11:21.89,0:11:23.89,Default,,0,0,0,,調頭方向沒有異常
Dialogue: 0,0:11:23.97,0:11:25.85,Default,,0,0,0,,右舵
Dialogue: 0,0:11:25.93,0:11:29.35,Default,,0,0,0,,很好，海上瑪麗娜，出航
Dialogue: 0,0:11:32.69,0:11:33.82,Default,,0,0,0,SP,（海上瑪麗娜）
Dialogue: 0,0:11:40.53,0:11:42.99,Default,,0,0,0,,我們也出發吧，捻麗
Dialogue: 0,0:11:48.62,0:11:50.75,Default,,0,0,0,,龍之英雄，龍九
Dialogue: 0,0:11:50.83,0:11:52.37,Default,,0,0,0,,個性，龍
Dialogue: 0,0:11:52.46,0:11:54.96,Default,,0,0,0,,跟字面一樣，可以巨大化變成龍
Dialogue: 0,0:11:55.05,0:11:57.68,Default,,0,0,0,,能藉由背後的翅膀在天空飛行
Dialogue: 0,0:11:57.76,0:11:59.10,Default,,0,0,0,,超級帥的
Dialogue: 0,0:12:04.39,0:12:05.89,Default,,0,0,0,,英雄，捻麗
Dialogue: 0,0:12:05.97,0:12:07.43,Default,,0,0,0,,個性，波動
Dialogue: 1,0:12:07.52,0:12:10.98,Default2,,0,0,0,,可以將自身的活力
Dialogue: 0,0:12:07.52,0:12:10.98,Default,,0,0,0,,化為能量並發射衝擊波
Dialogue: 0,0:12:11.06,0:12:14.65,Default,,0,0,0,,能透過衝擊波讓自己在空中飛喔
Dialogue: 0,0:12:17.57,0:12:20.37,Default,,0,0,0,,拜託妳囉，第十名
Dialogue: 0,0:12:20.45,0:12:23.54,Default,,0,0,0,,天狼星，別漏聽摩斯密碼囉
Dialogue: 0,0:12:23.62,0:12:24.58,Default,,0,0,0,,遵命
Dialogue: 0,0:12:24.66,0:12:27.08,Default,,0,0,0,,弗洛皮，抓好我的背
Dialogue: 0,0:12:34.21,0:12:36.13,Default,,0,0,0,,海難英雄，塞爾奇
Dialogue: 0,0:12:36.21,0:12:38.13,Default,,0,0,0,,個性是，斑海豹
Dialogue: 1,0:12:38.21,0:12:41.17,Default2,,0,0,0,,斑海豹能做到的事
Dialogue: 0,0:12:38.21,0:12:41.17,Default,,0,0,0,,他大致上都做得到
Dialogue: 0,0:12:41.26,0:12:43.39,Default,,0,0,0,,可以潛到深海一千五百公尺處
Dialogue: 0,0:12:43.47,0:12:46.14,Default,,0,0,0,,並發出像聲納一樣的咂嘴聲
Dialogue: 0,0:12:46.22,0:12:49.35,Default,,0,0,0,,能藉由聲音反射鎖定目標的所在位置
Dialogue: 0,0:12:57.78,0:13:00.49,Default,,0,0,0,,前方的岩礁，目測沒有發現異常
Dialogue: 0,0:13:00.57,0:13:02.86,Default,,0,0,0,,溫度感應器，沒有變化
Dialogue: 0,0:13:02.95,0:13:04.74,Default,,0,0,0,,現在前往下一個地點
Dialogue: 0,0:13:04.82,0:13:06.16,Default,,0,0,0,,遵命
Dialogue: 0,0:13:06.24,0:13:08.74,Default,,0,0,0,,龍九，請妳報告那邊的狀況
Dialogue: 0,0:13:08.83,0:13:11.79,Default,,0,0,0,,這邊是龍九，現在沒有異常
Dialogue: 0,0:13:12.37,0:13:14.62,Default,,0,0,0,,請下指示，告訴我下一個搜尋點
Dialogue: 0,0:13:14.71,0:13:18.01,Default,,0,0,0,,收到，請妳們前往43號點
Dialogue: 0,0:13:18.09,0:13:19.18,Default,,0,0,0,,收到
Dialogue: 0,0:13:28.35,0:13:30.81,Default,,0,0,0,,時間到了，準備出航
Dialogue: 0,0:13:31.52,0:13:33.77,Default,,0,0,0,,只要一發現敵人，就立刻放出煙霧
Dialogue: 0,0:13:33.85,0:13:35.73,Default,,0,0,0,,這我知道
Dialogue: 0,0:13:53.50,0:13:54.33,Default,,0,0,0,,來了
Dialogue: 0,0:13:54.42,0:13:55.55,Default,,0,0,0,,船長捎來訊息了
Dialogue: 0,0:13:56.13,0:13:58.63,Default,,0,0,0,,天狼星，個性是，靈敏聽覺
Dialogue: 1,0:13:58.71,0:14:01.71,Default2,,0,0,0,,她可以聽得見
Dialogue: 0,0:13:58.71,0:14:01.71,Default,,0,0,0,,一般人類聽不到的高頻率聲音喔
Dialogue: 0,0:14:02.63,0:14:05.76,Default,,0,0,0,,走私船在57號點
Dialogue: 0,0:14:06.34,0:14:07.63,Default,,0,0,0,,船長正在尾隨
Dialogue: 0,0:14:07.72,0:14:09.60,Default,,0,0,0,,左舵
Dialogue: 0,0:14:09.68,0:14:11.60,Default,,0,0,0,,57號點，收到
Dialogue: 0,0:14:11.68,0:14:12.60,Default,,0,0,0,,捻麗
Dialogue: 0,0:14:13.60,0:14:14.94,Default,,0,0,0,,妳要緊緊跟著我喔
Dialogue: 0,0:14:20.98,0:14:22.15,Default,,0,0,0,,我們被發現了
Dialogue: 0,0:14:22.24,0:14:25.16,Default,,0,0,0,,什麼？在哪裡？我看不到雷達船啊
Dialogue: 0,0:14:25.24,0:14:26.07,Default,,0,0,0,,在天空
Dialogue: 0,0:14:26.16,0:14:27.33,Default,,0,0,0,,在天空？
Dialogue: 0,0:14:27.41,0:14:28.74,Default,,0,0,0,,雷達有反應了
Dialogue: 0,0:14:28.83,0:14:30.50,Default,,0,0,0,,巡邏船就在前面
Dialogue: 0,0:14:46.59,0:14:48.05,Default,,0,0,0,,真的冒出煙了
Dialogue: 0,0:14:48.64,0:14:50.02,Default,,0,0,0,,目標施放煙霧了
Dialogue: 0,0:14:50.10,0:14:51.64,Default,,0,0,0,,雷達出現多個反應
Dialogue: 0,0:14:51.72,0:14:53.06,Default,,0,0,0,,是干擾箔
Dialogue: 0,0:14:53.14,0:14:54.64,Default,,0,0,0,,跟計畫一樣
Dialogue: 0,0:15:02.11,0:15:03.40,Default,,0,0,0,,這什麼？
Dialogue: 0,0:15:10.58,0:15:13.37,Default,,0,0,0,,難道說被對方摸上船了嗎？
Dialogue: 0,0:15:14.04,0:15:15.38,Default,,0,0,0,,是從哪裡…
Dialogue: 0,0:15:15.46,0:15:17.21,Default,,0,0,0,,不對，是怎麼辦到的？
Dialogue: 0,0:15:20.04,0:15:21.96,Default,,0,0,0,,因為我是海豹啊
Dialogue: 0,0:15:24.80,0:15:26.47,Default,,0,0,0,,弗洛皮，妳在原地待命
Dialogue: 0,0:15:42.44,0:15:45.61,Default,,0,0,0,,剛剛的聲音是怎麼回事？
Dialogue: 0,0:15:47.40,0:15:49.65,Default,,0,0,0,,臭傢伙，你從哪來的…
Dialogue: 0,0:15:54.83,0:15:58.04,Default,,0,0,0,,塞爾奇鐵拳
Dialogue: 0,0:15:59.42,0:16:01.96,Default,,0,0,0,,順利壓制操舵室
Dialogue: 0,0:16:03.63,0:16:05.34,Default,,0,0,0,,龍九，妳聽得到嗎？
Dialogue: 0,0:16:05.42,0:16:06.34,Default,,0,0,0,,我聽得到
Dialogue: 0,0:16:06.96,0:16:08.96,Default,,0,0,0,,這邊也可以清楚目視到目標
Dialogue: 0,0:16:09.55,0:16:11.72,Default,,0,0,0,,我會直接從空中掩護塞爾奇
Dialogue: 0,0:16:13.43,0:16:16.31,Default,,0,0,0,,龍九，妳看，船的後面
Dialogue: 0,0:16:21.56,0:16:23.98,Default,,0,0,0,,難道說那邊才是本體嗎？
Dialogue: 0,0:16:25.11,0:16:26.07,Default,,0,0,0,,是想要逃跑嗎？
Dialogue: 0,0:16:27.07,0:16:29.24,Default,,0,0,0,,以為那是貨物所以就大意了
Dialogue: 0,0:16:34.16,0:16:35.08,Default,,0,0,0,,弗洛皮
Dialogue: 0,0:16:40.25,0:16:41.92,Default,,0,0,0,,快追，龍九
Dialogue: 0,0:16:42.50,0:16:43.71,Default,,0,0,0,,弗洛皮
Dialogue: 0,0:16:43.79,0:16:45.42,Default,,0,0,0,,我沒事喔
Dialogue: 0,0:16:50.76,0:16:52.64,Default,,0,0,0,,速度實在差太多了
Dialogue: 0,0:16:54.10,0:16:56.56,Default,,0,0,0,,可惡，束手無策了嗎？
Dialogue: 0,0:16:56.64,0:16:57.68,Default,,0,0,0,,船長
Dialogue: 0,0:16:58.27,0:17:00.44,Default,,0,0,0,,就此放棄就太不像你的作風了
Dialogue: 0,0:17:00.52,0:17:02.61,Default,,0,0,0,,還有方法可以…
Dialogue: 0,0:17:03.23,0:17:04.19,Default,,0,0,0,,追上他們
Dialogue: 0,0:17:05.36,0:17:07.45,Default,,0,0,0,,無重麗，做好覺悟了嗎？
Dialogue: 0,0:17:07.53,0:17:08.36,Default,,0,0,0,,是的
Dialogue: 0,0:17:08.44,0:17:11.69,Default,,0,0,0,,等到任務結束了，我們再去海灘玩吧
Dialogue: 0,0:17:12.28,0:17:13.82,Default,,0,0,0,,我還想要吃烤肉
Dialogue: 0,0:17:13.91,0:17:15.20,Default,,0,0,0,,收到
Dialogue: 0,0:17:15.28,0:17:17.66,Default,,0,0,0,,上吧
Dialogue: 0,0:17:23.67,0:17:25.46,Default,,0,0,0,,不能像那個時候…
Dialogue: 0,0:17:26.54,0:17:29.04,Default,,0,0,0,,腦子什麼都沒想就衝上去
Dialogue: 0,0:17:30.88,0:17:32.92,Default,,0,0,0,,得好好動腦筋
Dialogue: 0,0:17:34.84,0:17:36.84,Default,,0,0,0,,確實地幫上忙
Dialogue: 0,0:17:38.01,0:17:39.64,Default,,0,0,0,,絕對要…
Dialogue: 0,0:17:41.02,0:17:42.52,Default,,0,0,0,,絕對要…
Dialogue: 0,0:17:47.15,0:17:48.36,Default,,0,0,0,,什麼？
Dialogue: 0,0:17:50.90,0:17:53.65,Default,,0,0,0,,槍豪武術
Dialogue: 0,0:17:53.74,0:17:55.37,Default,,0,0,0,,無重麗加強
Dialogue: 0,0:18:05.67,0:18:07.84,Default,,0,0,0,,這個…那個…
Dialogue: 0,0:18:08.42,0:18:09.59,Default,,0,0,0,,該怎麼辦才好？
Dialogue: 0,0:18:19.47,0:18:22.01,Default,,0,0,0,,為什麼？怎麼會這樣？
Dialogue: 0,0:18:27.90,0:18:30.44,Default,,0,0,0,,無重麗，快拉操控桿
Dialogue: 0,0:18:33.69,0:18:36.03,Default,,0,0,0,,不行，阻止不了失速
Dialogue: 0,0:18:36.61,0:18:37.86,Default,,0,0,0,,御茶子，快點逃出去
Dialogue: 0,0:18:37.95,0:18:39.29,Default,,0,0,0,,御茶子
Dialogue: 0,0:18:39.83,0:18:41.25,Default,,0,0,0,,我辦不到
Dialogue: 1,0:18:41.33,0:18:45.38,Default2,,0,0,0,,要是飛艇墜落的話
Dialogue: 0,0:18:41.33,0:18:45.38,Default,,0,0,0,,貨物就會流進海裡
Dialogue: 0,0:18:45.96,0:18:47.34,Default,,0,0,0,,這些違法藥物
Dialogue: 0,0:18:47.42,0:18:50.30,Default,,0,0,0,,會把海洋的生態搞得一團糟
Dialogue: 0,0:18:52.88,0:18:55.55,Default,,0,0,0,,無重麗，快點讓飛艇變得無重力
Dialogue: 1,0:18:55.63,0:19:01.51,Default2,,0,0,0,,但是，飛艇太重了
Dialogue: 0,0:18:55.63,0:19:01.51,Default,,0,0,0,,沒辦法讓它完全無重力
Dialogue: 0,0:19:01.60,0:19:02.89,Default,,0,0,0,,妳要放棄嗎？
Dialogue: 0,0:19:05.69,0:19:07.69,Default,,0,0,0,,不要，我不要放棄
Dialogue: 0,0:19:11.73,0:19:12.77,Default,,0,0,0,,捻麗
Dialogue: 0,0:19:20.12,0:19:23.12,Default,,0,0,0,,充能全滿，輸出90
Dialogue: 0,0:19:24.33,0:19:26.37,Default,,0,0,0,,格林波動
Dialogue: 0,0:19:36.59,0:19:38.22,Default,,0,0,0,,無重麗，趁現在
Dialogue: 0,0:19:41.43,0:19:45.89,Default,,0,0,0,,我才不要就這樣放棄
Dialogue: 0,0:20:03.16,0:20:04.70,Default,,0,0,0,,太好了，成功了
Dialogue: 0,0:20:05.29,0:20:07.79,Default,,0,0,0,,飛艇平安無事喔，龍九也平安無事
Dialogue: 0,0:20:08.71,0:20:10.88,Default,,0,0,0,,無重麗有點不妙
Dialogue: 0,0:20:11.88,0:20:14.05,Default,,0,0,0,,龍九已經扣押了那些貨物
Dialogue: 0,0:20:14.13,0:20:16.88,Default,,0,0,0,,好像真的是製作違法藥物的藥品
Dialogue: 0,0:20:16.96,0:20:19.71,Default,,0,0,0,,這樣作戰應該結束了吧
Dialogue: 0,0:20:20.43,0:20:21.93,Default,,0,0,0,,達成任務
Dialogue: 0,0:20:31.06,0:20:33.19,Default,,0,0,0,,根據警方偵訊的結果
Dialogue: 0,0:20:33.77,0:20:36.56,Default,,0,0,0,,走私船的船員只是負責運貨
Dialogue: 1,0:20:36.65,0:20:39.95,Default2,,0,0,0,,並不清楚這些違法藥物
Dialogue: 0,0:20:36.65,0:20:39.95,Default,,0,0,0,,會被拿去做什麼
Dialogue: 0,0:20:40.03,0:20:43.20,Default,,0,0,0,,下單委託的人使用了假名
Dialogue: 0,0:20:43.28,0:20:45.66,Default,,0,0,0,,也不清楚對方的行蹤
Dialogue: 0,0:20:45.74,0:20:46.66,Default,,0,0,0,,這樣啊
Dialogue: 0,0:20:47.20,0:20:49.58,Default,,0,0,0,,目前只知道的一件事就是…
Dialogue: 0,0:20:50.16,0:20:53.41,Default,,0,0,0,,運貨員們只知道目的地似乎是奧賽翁
Dialogue: 0,0:20:53.50,0:20:57.30,Default,,0,0,0,,奧賽翁國不就在歐洲嗎？
Dialogue: 1,0:20:57.88,0:21:00.72,Default2,,0,0,0,,雖然不知道對方
Dialogue: 0,0:20:57.88,0:21:00.72,Default,,0,0,0,,打算在奧賽翁國做些什麼
Dialogue: 0,0:21:00.80,0:21:02.93,Default,,0,0,0,,不過既然都防患未然了
Dialogue: 0,0:21:03.01,0:21:04.43,Default,,0,0,0,,就這樣算了…
Dialogue: 0,0:21:05.18,0:21:06.31,Default,,0,0,0,,才怪呢
Dialogue: 0,0:21:08.64,0:21:10.27,Default,,0,0,0,,根本一點都不可愛
Dialogue: 0,0:21:10.35,0:21:13.27,Default,,0,0,0,,是啊，最近我也開始有自覺了
Dialogue: 0,0:21:14.19,0:21:16.03,Default,,0,0,0,,但是，有什麼關係嘛
Dialogue: 0,0:21:19.99,0:21:24.54,Default,,0,0,0,,就好好享受這短暫的和平吧
Dialogue: 0,0:22:58.13,0:23:02.55,Default,,0,0,0,,這樣啊，被英雄從旁干涉了嗎？
Dialogue: 0,0:23:02.63,0:23:04.38,Default,,0,0,0,,該怎麼辦才好呢？
Dialogue: 0,0:23:04.47,0:23:05.76,Default,,0,0,0,,不要緊
Dialogue: 0,0:23:05.84,0:23:09.26,Default,,0,0,0,,我已經確保執行計畫所需的數量了
Dialogue: 0,0:23:11.47,0:23:14.10,Default,,0,0,0,,好了，那麼就開始吧
Dialogue: 0,0:23:14.18,0:23:16.47,Default,,0,0,0,,準備拯救人類
Dialogue: 0,0:23:21.40,0:23:22.65,Default,,0,0,0,,下集預告
Dialogue: 0,0:23:23.94,0:23:26.74,Default,,0,0,0,,在安德瓦事務所進行英雄實習的我們
Dialogue: 0,0:23:26.82,0:23:28.78,Default,,0,0,0,,正認真面對各自面臨的課題
Dialogue: 0,0:23:29.57,0:23:31.28,Default,,0,0,0,,每每目睹安德瓦的活躍表現
Dialogue: 0,0:23:31.37,0:23:33.79,Default,,0,0,0,,新的課題也跟著浮現出來
Dialogue: 0,0:23:34.54,0:23:38.17,Default,,0,0,0,,在這個時候，安德瓦招待我們去他家
Dialogue: 0,0:23:39.17,0:23:41.67,Default,,0,0,0,,下一集，地獄的轟同學家
Dialogue: 0,0:23:42.25,0:23:45.92,Default,,0,0,0,,轟同學好像有姐姐跟哥哥呢
Dialogue: 0,0:23:46.01,0:23:47.18,Default,,0,0,0,,更向前邁進吧
Dialogue: 0,0:23:47.26,0:23:48.68,Default,,0,0,0,,超越巔峰


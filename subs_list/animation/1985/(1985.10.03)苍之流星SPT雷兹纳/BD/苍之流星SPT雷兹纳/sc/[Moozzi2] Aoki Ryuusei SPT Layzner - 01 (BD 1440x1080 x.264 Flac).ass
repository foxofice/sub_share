Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:04.18,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕制作：你在那里吗 时间轴、字体调整：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中苍蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,仿佛在夜之运河上滑行
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人通过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找着远方的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用你悲伤的眼瞳
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,来责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么也别说就这样让我离开
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的肩膀
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱着
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,泪水用亲吻拭干
Dialogue: 0,0:01:02.15,0:01:04.09,Layzner,Simone,0,0,0,,那是什么
Dialogue: 0,0:01:04.09,0:01:06.04,Layzner,Elizabeth,0,0,0,,幸存下来的学生都在这里了
Dialogue: 0,0:01:06.04,0:01:07.58,Layzner,Simone,0,0,0,,不要 不要
Dialogue: 0,0:01:08.27,0:01:09.87,Layzner,David,0,0,0,,谁来解释一下
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 按着自己的想法
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 朝着自己的目标前进
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 去探寻遥远彼方的梦
Dialogue: 0,0:02:18.87,0:02:23.92,Layzner,Pilot,0,0,0,,这里是美国火星基地所属宇宙军部队Cosmofire129
Dialogue: 0,0:02:23.92,0:02:26.53,Layzner,Pilot,0,0,0,,104航天飞机请回答
Dialogue: 0,0:02:26.53,0:02:28.78,Layzner,Shuttle,0,0,0,,这里是104航天飞机 请讲
Dialogue: 0,0:02:28.78,0:02:32.75,Layzner,Pilot,0,0,0,,请报告你们要降落的地点，搭乘者的国籍、人数
Dialogue: 0,0:02:32.75,0:02:36.00,LayznerWhite,Anna,0,0,0,,公元1996年10月3日
Dialogue: 0,0:02:36.91,0:02:43.70,LayznerWhite,Anna,0,0,0,,{\fs20}当我们临近联合国的火星基地时，最先遇到的是美国的战斗机
Dialogue: 0,0:02:44.23,0:02:45.34,LayznerWhite,Anna,0,0,0,,还有
Dialogue: 0,0:02:45.34,0:02:50.74,Layzner,Control,0,0,0,,这里是USSR 104航天飞机 请回应代号为AN的频道
Dialogue: 0,0:02:50.74,0:02:52.40,Layzner,Pilot,0,0,0,,这里是UNSS104
Dialogue: 0,0:02:52.40,0:02:58.58,Layzner,Anna,0,0,0,,两大强国的军事竞争，已经从月球延伸到了火星
Dialogue: 0,0:02:58.58,0:03:02.83,Layzner,Anna,0,0,0,,两国的军事基地，把紧张感带到了宇宙
Dialogue: 0,0:03:04.02,0:03:08.93,Layzner,Anna,0,0,0,,地球上的状况现在又在火星上重现
Dialogue: 0,0:03:09.49,0:03:14.08,Layzner,,0,0,0,,即将着陆的我们也感到了莫名的不安
Dialogue: 0,0:03:14.92,0:03:18.45,Layzner,,0,0,0,,我的名字叫安娜·斯蒂芬妮 14岁
Dialogue: 0,0:03:18.45,0:03:23.27,Layzner,,0,0,0,,在那红色的星球
Dialogue: 0,0:03:34.13,0:03:36.18,Layzner,Officer 1,0,0,0,,OK，启动开关
Dialogue: 0,0:03:36.18,0:03:37.00,Layzner,???,0,0,0,,启动开关
Dialogue: 0,0:03:39.01,0:03:39.99,Layzner,Officer 2,0,0,0,,时间正好
Dialogue: 0,0:03:39.99,0:03:41.93,Layzner,Judo,0,0,0,,我们到了 是火星 是火星
Dialogue: 0,0:03:41.93,0:03:43.79,Layzner,David,0,0,0,,但是这里什么也没有
Dialogue: 0,0:03:43.79,0:03:44.95,Layzner,?,0,0,0,,看 是火山
Dialogue: 0,0:03:44.95,0:03:45.91,Layzner,Simone,0,0,0,,哪里 哪里
Dialogue: 0,0:03:45.91,0:03:46.59,Layzner,?,0,0,0,,看那边
Dialogue: 0,0:03:46.59,0:03:49.54,Layzner,Arthur,0,0,0,,那个是Koroharika火山 有14600米高
Dialogue: 0,0:03:49.54,0:03:52.00,Layzner,David,0,0,0,,知道了 知道了 你还真是博学多才
Dialogue: 0,0:03:52.00,0:03:53.63,Layzner,Anna,0,0,0,,这里的天空真够红的
Dialogue: 0,0:03:53.63,0:03:55.89,Layzner,Simone,0,0,0,,当然了 这里可是火星啊
Dialogue: 0,0:04:01.47,0:04:03.71,Layzner,Pilot,0,0,0,,连接完成 开始输入氧气
Dialogue: 0,0:04:03.71,0:04:06.06,Layzner,B,0,0,0,,气体输入 可以进去了
Dialogue: 0,0:04:19.82,0:04:20.86,Layzner,David,0,0,0,,太好了 朱诺
Dialogue: 0,0:04:20.86,0:04:22.12,Layzner,Judo,0,0,0,,我们终于到了
Dialogue: 0,0:04:22.12,0:04:23.87,Layzner,??,0,0,0,,真是盛大的欢迎
Dialogue: 0,0:04:24.55,0:04:25.77,Layzner,?,0,0,0,,感激不尽
Dialogue: 0,0:04:25.77,0:04:27.78,Layzner,?,0,0,0,,和我想象的排场差不多呢
Dialogue: 0,0:04:41.58,0:04:42.88,Layzner,Elizabeth,0,0,0,,Attention!列队
Dialogue: 0,0:04:47.05,0:04:51.30,Layzner,Elizabeth,0,0,0,,宇宙体验学校第一期全体16名学员集合完毕
Dialogue: 0,0:04:51.93,0:04:55.80,Layzner,Lee,0,0,0,,你们终于来了，我是基地的副队长利布雷
Dialogue: 0,0:04:55.80,0:05:00.93,Layzner,Elizabeth,0,0,0,,我是联合国宇宙体验学校第一负责人伊丽莎白
Dialogue: 0,0:05:00.93,0:05:01.95,Layzner,Lee,0,0,0,,辛苦了
Dialogue: 0,0:05:01.95,0:05:03.36,Layzner,Elizabeth,0,0,0,,这是学员名单
Dialogue: 0,0:05:04.36,0:05:06.58,Layzner,David,0,0,0,,我的梦想就是能穿上那件制服
Dialogue: 0,0:05:06.58,0:05:09.97,Layzner,Judo,0,0,0,,不要以为你来到这里就一定能实现哦
Dialogue: 0,0:05:09.97,0:05:11.28,Layzner,David,0,0,0,,我知道啦
Dialogue: 0,0:05:11.28,0:05:13.30,Layzner,Lee,0,0,0,,亚瑟是哪位
Dialogue: 0,0:05:13.30,0:05:14.06,Layzner,Elizabeth,0,0,0,,亚瑟
Dialogue: 0,0:05:14.06,0:05:14.74,Layzner,Arthur,0,0,0,,是
Dialogue: 0,0:05:15.64,0:05:18.16,Layzner,Lee,0,0,0,,这里不是军队 不需要行礼
Dialogue: 0,0:05:18.16,0:05:19.50,Layzner,Asa,0,0,0,,是
Dialogue: 0,0:05:22.25,0:05:24.57,Layzner,Lee,0,0,0,,你是这里最年长的
Dialogue: 0,0:05:24.57,0:05:30.65,Layzner,Arthur,0,0,0,,我今年17岁 准确来说按地球时间计算应该是17岁五个月零三天
Dialogue: 0,0:05:30.65,0:05:32.03,Layzner,Lee,0,0,0,,真了不起
Dialogue: 0,0:05:32.03,0:05:33.03,Layzner,Arthur,0,0,0,,没什么
Dialogue: 0,0:05:33.78,0:05:36.34,Layzner,Lee,0,0,0,,安娜  安娜·斯蒂芬妮
Dialogue: 0,0:05:37.21,0:05:38.37,Layzner,Anna,0,0,0,,是我
Dialogue: 0,0:05:38.37,0:05:41.70,Layzner,Lee,0,0,0,,虽然你是这里年龄最小的 但是要加油不要输给大家哦
Dialogue: 0,0:05:42.61,0:05:46.41,Layzner,Lee,0,0,0,,等下队长会来这里给你们布置任务
Dialogue: 0,0:05:47.26,0:05:49.28,Layzner,Lee,0,0,0,,比鲁 把那个拿给他们
Dialogue: 0,0:05:51.74,0:05:54.91,Layzner,Bill,0,0,0,,这是我们一点小小的心意
Dialogue: 0,0:05:54.91,0:05:57.70,Layzner,Bill,0,0,0,,.请你们的代表收下
Dialogue: 0,0:06:02.27,0:06:05.69,Layzner,Bill,0,0,0,,有什么不懂的请尽管问
Dialogue: 0,0:06:07.45,0:06:08.53,Layzner,Anna,0,0,0,,非常感谢
Dialogue: 0,0:06:24.13,0:06:27.93,Layzner,Anna,0,0,0,,请问这花是在这里种的吗
Dialogue: 0,0:06:27.93,0:06:31.84,Layzner,Bill,0,0,0,,要活下去光有食物是不够的
Dialogue: 0,0:06:32.85,0:06:36.21,Layzner,Bill,0,0,0,,这是在这火星上最先盛开的花
Dialogue: 0,0:06:36.21,0:06:41.50,Layzner,Lee,0,0,0,,我们和人类的宇宙开发 现在就像这盛开的花一样
Dialogue: 0,0:06:41.50,0:06:47.05,Layzner,Lee,0,0,0,,我们要让花朵继续盛开，总有一天一定会变成一个美丽的花园
Dialogue: 0,0:06:47.05,0:06:50.77,Layzner,Bill,0,0,0,,我们觉得这是最适合你们的礼物
Dialogue: 0,0:07:00.67,0:07:05.66,Layzner,Anna,0,0,0,,两年前 联合国宇宙局成立了Cosmic Culture Club
Dialogue: 0,0:07:05.66,0:07:09.33,Layzner,Anna,0,0,0,,也就是宇宙体验学校
Dialogue: 0,0:07:08.19,0:07:10.19,Layzner,Officer,0,0,0,,我们经过不断的筛选
Dialogue: 0,0:07:09.33,0:07:14.82,Layzner,Anna,0,0,0,,最后好不容易被选上
Dialogue: 0,0:07:14.82,0:07:20.90,Layzner,Anna,0,0,0,,接下来的半年 我们接受了火星生活的适应训练
Dialogue: 0,0:07:20.90,0:07:24.45,Layzner,Anna,0,0,0,,然后现在 我们终于来到这里了
Dialogue: 0,0:07:26.48,0:07:28.50,Layzner,Simone,0,0,0,,让我看一下
Dialogue: 0,0:07:33.40,0:07:36.78,Layzner,Simone,0,0,0,,这真是最棒的花香
Comment: 0,0:07:36.78,0:07:37.17,Layzner,Anna,0,0,0,,Hmmm...
Dialogue: 0,0:07:38.11,0:07:43.40,Layzner,Simone,0,0,0,,这花一定值一千万 毕竟是火星上的
Dialogue: 0,0:07:43.40,0:07:45.55,Layzner,Anna,0,0,0,,喜欢的话就收下吧
Dialogue: 0,0:07:45.55,0:07:49.30,Layzner,Simone,0,0,0,,真是太好了 谢谢你
Dialogue: 0,0:07:56.11,0:08:01.00,Layzner,Arthur,0,0,0,,罗安 第一次和你住同一房间 你有洁癖吗
Dialogue: 0,0:08:01.00,0:08:02.74,Layzner,Roanne,0,0,0,,我还好啦
Dialogue: 0,0:08:02.74,0:08:06.39,Layzner,Arthur,0,0,0,,就连桌布铺得凌乱我也会觉得浑身难受
Dialogue: 0,0:08:06.39,0:08:09.09,Layzner,Arthur,0,0,0,,我想事先和你说清楚比较好
Dialogue: 0,0:08:10.44,0:08:11.79,Layzner,Roanne,0,0,0,,还有别的吗
Dialogue: 0,0:08:11.79,0:08:13.79,Layzner,Arthur,0,0,0,,剩下就随便了
Dialogue: 0,0:08:13.79,0:08:15.74,Layzner,Roanne,0,0,0,,那就多谢了
Dialogue: 0,0:08:17.67,0:08:22.78,Layzner,David,0,0,0,,Yahoo 朱诺 我们真有缘 又分到同一房间了
Dialogue: 0,0:08:22.78,0:08:25.46,Layzner,Judo,0,0,0,,不是在训练期间就和我待够了吗
Dialogue: 0,0:08:25.46,0:08:29.61,Layzner,David,0,0,0,,{\fs20}没那回事 从我第一次见到你就觉得你是个好人
Dialogue: 0,0:08:29.61,0:08:31.34,Layzner,David,0,0,0,,我的直觉很准的
Dialogue: 0,0:08:31.34,0:08:37.12,Layzner,Judo,0,0,0,,我们来打个赌怎么样  看看我们谁先成为这里的工作人员
Dialogue: 0,0:08:37.12,0:08:39.89,Layzner,David,0,0,0,,我认为是我 我的运气一直比你好
Dialogue: 0,0:08:39.89,0:08:41.35,Layzner,Judo,0,0,0,,你这家伙
Dialogue: 0,0:08:41.35,0:08:43.37,Layzner,David,0,0,0,,住手 我是开玩笑的 好痛 朱诺
Dialogue: 0,0:08:45.60,0:08:50.99,Layzner,Job,0,0,0,,我是这里的队长乔布葛连巴 欢迎各位的到来
Dialogue: 0,0:08:50.99,0:08:52.87,Layzner,,0,0,0,,我们就开门见山地说
Dialogue: 0,0:08:52.87,0:08:57.78,Layzner,,0,0,0,,在座的各位今后要适应宇宙时代的生活
Dialogue: 0,0:08:57.78,0:09:07.31,Layzner,,0,0,0,,如大家所见 非常遗憾 这里遍布着军事要塞
Dialogue: 0,0:09:07.31,0:09:10.71,Layzner,,0,0,0,,这就是现状
Dialogue: 0,0:09:10.71,0:09:15.68,Layzner,,0,0,0,,我们必须在此强调 我们的价值观与他们不同
Dialogue: 0,0:09:15.68,0:09:20.21,Layzner,,0,0,0,,我们努力至今 也同样期待你们的努力表现
Dialogue: 0,0:09:20.21,0:09:24.02,Layzner,,0,0,0,,要如何度过即将面临的时代 相信大家都已经有了自己的想法和判断
Dialogue: 0,0:09:24.02,0:09:26.35,Layzner,,0,0,0,,尽管只有短短半年时间
Dialogue: 0,0:09:26.35,0:09:31.82,Layzner,,0,0,0,,还是希望大家在宇宙居住的这段时间里能或多或少学到些东西
Dialogue: 0,0:09:31.82,0:09:35.78,Layzner,,0,0,0,,我们在此成立Cosmic Culture Club的目的
Dialogue: 0,0:09:35.78,0:09:37.45,Layzner,,0,0,0,,只有一个
Dialogue: 0,0:09:37.87,0:09:38.47,Layzner,,0,0,0,,是
Dialogue: 0,0:09:38.14,0:09:40.16,Layzner,,0,0,0,,人类要想在火星上生活
Dialogue: 0,0:09:39.87,0:09:40.37,Layzner,,0,0,0,,What?什么
Dialogue: 0,0:09:40.16,0:09:46.89,Layzner,,0,0,0,,还需要数千年的时间 不 是数万年的时间
Dialogue: 0,0:09:48.44,0:09:49.30,Layzner,,0,0,0,,什么
Dialogue: 0,0:09:49.30,0:09:50.85,Layzner,Lee,0,0,0,,还没确认吗
Dialogue: 0,0:09:50.85,0:09:52.67,Layzner,Officer,0,0,0,,无法确认
Dialogue: 0,0:09:52.67,0:09:54.79,Layzner,Officer,0,0,0,,接收到十四号卫星的信号
Dialogue: 0,0:09:54.79,0:09:56.62,Layzner,Off2,0,0,0,,好 把影像传过来
Dialogue: 0,0:09:56.62,0:09:57.44,Layzner,Off,0,0,0,,Yes sir.是
Dialogue: 0,0:10:03.41,0:10:06.11,Layzner,Job,0,0,0,,大家稍等一下 我马上回来
Dialogue: 0,0:10:08.21,0:10:12.75,Layzner,Elizabeth,0,0,0,,大家安静  在下一个指示到来前请在位子上坐好
Dialogue: 0,0:10:13.59,0:10:15.06,Layzner,Officer,0,0,0,,队长 请看
Dialogue: 0,0:10:17.28,0:10:18.55,Layzner,Job,0,0,0,,这是什么
Dialogue: 0,0:10:18.55,0:10:21.52,Layzner,Officer,0,0,0,,这是二号卫星捕捉到的影像
Dialogue: 0,0:10:21.52,0:10:24.42,Layzner,Job,0,0,0,,大小了 看不清楚 把影像放大
Dialogue: 0,0:10:24.42,0:10:25.47,Layzner,Officer,0,0,0,,是
Dialogue: 0,0:10:27.98,0:10:29.51,Layzner,Officer,0,0,0,,被破坏了
Dialogue: 0,0:10:32.30,0:10:33.54,Layzner,David,0,0,0,,发生什么事了
Dialogue: 0,0:10:33.54,0:10:35.36,Layzner,Elizabeth,0,0,0,,回到座位上坐好
Dialogue: 0,0:10:35.36,0:10:38.47,Layzner,Judo,0,0,0,,难道是美国和苏联开战了
Dialogue: 0,0:10:38.47,0:10:39.23,Layzner,Arthur,0,0,0,,怎么会
Dialogue: 0,0:10:39.23,0:10:41.06,Layzner,Roanne,0,0,0,,我觉得有这种可能
Dialogue: 0,0:10:41.76,0:10:43.67,Layzner,Simone,0,0,0,,没事的 没事的
Dialogue: 0,0:10:43.67,0:10:47.14,Layzner,Elizabeth,0,0,0,,请安静 大家不要擅作推论
Dialogue: 0,0:10:47.14,0:10:49.52,Layzner,Officer,0,0,0,,不行 没有回应
Dialogue: 0,0:10:49.52,0:10:50.99,Layzner,Lee,0,0,0,,你那边如何
Dialogue: 0,0:10:50.99,0:10:54.83,Layzner,2,0,0,0,,不行 无论是美国基地还是苏联基地都联络不上
Comment: 0,0:10:54.83,0:10:56.75,Layzner,Lee,0,0,0,,[???]
Dialogue: 0,0:10:54.83,0:10:55.85,Layzner,Job,0,0,0,,继续联络
Dialogue: 0,0:10:55.85,0:10:56.75,Layzner,Officer,0,0,0,,是
Dialogue: 0,0:10:56.75,0:10:58.29,Layzner,Job,0,0,0,,和月球基地取得联络
Dialogue: 0,0:10:58.29,0:10:59.08,Layzner,Officer,0,0,0,,是
Dialogue: 0,0:10:59.08,0:11:00.12,Layzner,Officer,0,0,0,,请回答
Dialogue: 0,0:11:00.12,0:11:03.99,Layzner,Officer,0,0,0,,发现飞行部队的热源反应 好像打算发射激光
Dialogue: 0,0:11:03.99,0:11:05.34,Layzner,Lee,0,0,0,,队长
Dialogue: 0,0:11:07.18,0:11:08.22,Layzner,David,0,0,0,,怎么了
Dialogue: 0,0:11:10.44,0:11:12.65,Layzner,Officer,0,0,0,,请各位马上去避难
Dialogue: 0,0:11:12.65,0:11:13.49,Layzner,Elizabeth,0,0,0,,发生什么事了
Dialogue: 0,0:11:13.49,0:11:14.29,Layzner,Officer,0,0,0,,快点
Dialogue: 0,0:11:15.46,0:11:17.47,Layzner,Elizabeth,0,0,0,,大卫 朱诺 快回来
Dialogue: 0,0:11:18.44,0:11:19.39,Layzner,Elizabeth,0,0,0,,你们几个
Dialogue: 0,0:11:19.39,0:11:20.69,Layzner,?,0,0,0,,我去叫他们回来
Dialogue: 0,0:11:20.69,0:11:21.66,Layzner,?,0,0,0,,快回来
Dialogue: 0,0:11:27.37,0:11:29.18,Layzner,?,0,0,0,,你们几个快回来
Dialogue: 0,0:12:25.80,0:12:28.40,Layzner,Simone,0,0,0,,那是什么
Dialogue: 0,0:12:28.40,0:12:30.51,Layzner,Anna,0,0,0,,当我看见那东西的时候
Dialogue: 0,0:12:30.51,0:12:34.46,Layzner,Anna,0,0,0,,不知为何 心中一点也不觉得奇怪
Comment: 0,0:12:34.46,0:12:44.00,Layzner,,0,0,0,,-Eye Catch
Dialogue: 0,0:12:55.09,0:12:56.49,Layzner,Elizabeth,0,0,0,,你们在干什么
Dialogue: 0,0:12:57.96,0:13:00.18,Layzner,Elizabeth,0,0,0,,快点去穿上宇宙服
Dialogue: 0,0:13:00.18,0:13:01.53,Layzner,Arthur,0,0,0,,那是什么东西
Dialogue: 0,0:13:01.53,0:13:04.40,Layzner,Elizabeth,0,0,0,,好了 先去避难 快点
Dialogue: 0,0:13:14.24,0:13:17.23,Layzner,Job,0,0,0,,看起来好像是新型机甲
Dialogue: 0,0:13:17.23,0:13:20.56,Layzner,Lee,0,0,0,,我从没见过这么大的 而且好想拥有很强的火力
Dialogue: 0,0:13:21.25,0:13:23.60,Layzner,?,0,0,0,,也不知道是属于那边的
Dialogue: 0,0:13:23.60,0:13:24.92,Layzner,Job,0,0,0,,还联络不上吗
Dialogue: 0,0:13:24.92,0:13:27.48,Layzner,Officer,0,0,0,,无论哪边都联络不上
Dialogue: 0,0:13:27.48,0:13:31.43,Layzner,Job,0,0,0,,这里只是普通的观测基地 这样下去会出事的
Dialogue: 0,0:13:33.11,0:13:37.14,Layzner,Lee,0,0,0,,就算是新型武器的训练 不过到底是那边的
Dialogue: 0,0:13:37.14,0:13:42.24,Layzner,Job,0,0,0,,那种事稍后再说 先让大家去避难 看情形可能要从这逃离
Dialogue: 0,0:13:42.24,0:13:43.44,Layzner,Lee,0,0,0,,我明白了
Dialogue: 0,0:13:52.03,0:13:53.51,Layzner,Simone,0,0,0,,安娜 快点
Dialogue: 0,0:14:00.49,0:14:02.77,Layzner,David,0,0,0,,那一定是宇宙战
Dialogue: 0,0:14:02.77,0:14:04.68,Layzner,Judo,0,0,0,,那一定是秘密武器
Dialogue: 0,0:14:04.68,0:14:06.52,Layzner,David,0,0,0,,能看到这些还真是不错的体验呢
Dialogue: 0,0:14:06.52,0:14:07.80,Layzner,Arthur,0,0,0,,等 等一下
Dialogue: 0,0:14:29.88,0:14:32.75,Layzner,Officer,0,0,0,,准备逃离 快点 快点
Dialogue: 0,0:14:32.75,0:14:34.44,Layzner,Officer,0,0,0,,快打开第三舱门
Dialogue: 0,0:14:34.44,0:14:36.55,Layzner,Elizabeth,0,0,0,,你们快把头盔戴上
Dialogue: 0,0:14:36.55,0:14:37.51,Layzner,Guys,0,0,0,,是
Dialogue: 0,0:14:38.51,0:14:45.05,Layzner,Elizabeth,0,0,0,,大家冷静点听我说 待会一定要听我的指示 不可擅自行动 明白了吗
Dialogue: 0,0:15:10.64,0:15:13.48,Layzner,Officer,0,0,0,,主雷达被破坏了
Dialogue: 0,0:15:13.48,0:15:15.59,Layzner,2,0,0,0,,二号三号雷达也不能用了
Dialogue: 0,0:15:16.27,0:15:17.67,Layzner,Job,0,0,0,,到底是怎么回事
Dialogue: 0,0:15:17.67,0:15:20.50,Layzner,3,0,0,0,,六号雷达也被破坏了
Dialogue: 0,0:15:20.50,0:15:25.34,Layzner,Job,0,0,0,,我是基地负责人乔布葛连巴 你们的国籍和所属是
Dialogue: 0,0:15:25.34,0:15:26.70,Layzner,Job,0,0,0,,回答我
Dialogue: 0,0:15:26.70,0:15:31.89,Layzner,Job,0,0,0,,你知道我们的身份吧 为什么要在这里进行军事行动
Dialogue: 0,0:15:31.89,0:15:36.24,Layzner,Job,0,0,0,,不能再允许你们乱来了 马上离开
Dialogue: 0,0:15:42.42,0:15:43.64,Layzner,Guys,0,0,0,,怎么回事
Dialogue: 0,0:15:43.64,0:15:45.07,Layzner,Guys,0,0,0,,好像哪里被攻击了
Dialogue: 0,0:15:44.33,0:15:46.06,Layzner,Elizabeth,0,0,0,,安静点 安静点
Dialogue: 0,0:15:49.50,0:15:52.65,Layzner,Elizabeth,0,0,0,,喂 观测室 观测室 请回答
Dialogue: 0,0:16:11.16,0:16:13.03,Layzner,Simone,0,0,0,,不要
Dialogue: 0,0:16:13.03,0:16:14.97,Layzner,Simone,0,0,0,,不要 不要
Dialogue: 0,0:16:15.80,0:16:18.80,Layzner,Simone,0,0,0,,不要
Dialogue: 0,0:16:34.81,0:16:36.57,Layzner,Elizabeth,0,0,0,,太过分了
Dialogue: 0,0:16:38.52,0:16:41.24,Layzner,Elizabeth,0,0,0,,去地下室 大家快躲到地下室去
Dialogue: 0,0:16:43.07,0:16:45.35,Layzner,Elizabeth,0,0,0,,亚瑟 去帮帮西蒙尼她们
Dialogue: 0,0:16:46.31,0:16:47.38,Layzner,Arthur,0,0,0,,来 站起来
Dialogue: 0,0:16:47.86,0:16:50.36,Layzner,,0,0,0,,不要 不要 不要
Dialogue: 0,0:16:50.36,0:16:51.93,Layzner,Roanne,0,0,0,,西蒙尼 振作点
Dialogue: 0,0:16:51.93,0:16:53.13,Layzner,Arthur,0,0,0,,快点 安娜
Dialogue: 0,0:16:53.85,0:16:55.00,Layzner,,0,0,0,,振作一点
Dialogue: 0,0:16:55.00,0:16:55.89,Layzner,David,0,0,0,,朱诺
Dialogue: 0,0:16:56.93,0:16:58.51,Layzner,David,0,0,0,,朱诺
Dialogue: 0,0:16:58.51,0:16:59.61,Layzner,Elizbeth,0,0,0,,大卫
Dialogue: 0,0:17:00.32,0:17:02.22,Layzner,Elizbeth,0,0,0,,快点到地下室去避难
Dialogue: 0,0:17:02.22,0:17:03.20,Layzner,David,0,0,0,,朱诺
Dialogue: 0,0:17:03.20,0:17:07.11,Layzner,Elizabeth,0,0,0,,大卫 振作点 我们要去避难 明白吗
Dialogue: 0,0:17:19.53,0:17:20.33,Layzner,David,0,0,0,,朱诺
Dialogue: 0,0:17:24.00,0:17:25.72,Layzner,Elizabeth,0,0,0,,快点 到地下室去
Dialogue: 0,0:17:36.85,0:17:38.23,Layzner,Roanne,0,0,0,,是苏联军队
Dialogue: 0,0:18:28.17,0:18:31.05,Layzner,Arthur,0,0,0,,苏联军被干掉了
Dialogue: 0,0:18:31.40,0:18:33.59,Layzner,Arthur,0,0,0,,也就是说另一边是美军
Dialogue: 0,0:18:33.59,0:18:36.35,Layzner,Roanne,0,0,0,,照这样说被追的是哪边的人
Dialogue: 0,0:18:45.72,0:18:46.96,Layzner,Arthur,0,0,0,,已经没事了
Dialogue: 0,0:18:47.64,0:18:48.92,Layzner,Arthur,0,0,0,,他们被干掉了
Dialogue: 0,0:18:50.62,0:18:51.72,Layzner,Simone,0,0,0,,其他人呢
Dialogue: 0,0:18:54.98,0:18:56.98,Layzner,Elizabeth,0,0,0,,幸存下来的学生都在这里了
Dialogue: 0,0:19:06.93,0:19:08.72,Layzner,,0,0,0,,谁能解释一下
Dialogue: 0,0:19:10.44,0:19:13.01,Layzner,,0,0,0,,到底是怎么回事
Dialogue: 0,0:19:13.01,0:19:15.42,Layzner,,0,0,0,,谁来解释一下
Dialogue: 0,0:19:17.55,0:19:21.30,Layzner,Elizabeth,0,0,0,,我也不知道 为什么会发生这种事
Dialogue: 0,0:19:25.73,0:19:27.95,Layzner,David,0,0,0,,只差五十厘米
Dialogue: 0,0:19:30.34,0:19:32.64,Layzner,David,0,0,0,,只差了五十厘米
Dialogue: 0,0:19:32.64,0:19:34.91,Layzner,,0,0,0,,朱诺就死了
Dialogue: 0,0:19:37.04,0:19:40.15,Layzner,,0,0,0,,是啊 我的运气比较好
Dialogue: 0,0:19:41.39,0:19:43.50,Layzner,,0,0,0,,但那又如何
Dialogue: 0,0:19:46.66,0:19:51.01,Layzner,,0,0,0,,我一点也不会高兴 如果那家伙...
Dialogue: 0,0:19:53.40,0:19:55.40,Layzner,,0,0,0,,如果他...
Dialogue: 0,0:20:08.58,0:20:09.61,Layzner,Roanne,0,0,0,,回 回来了
Dialogue: 0,0:20:27.82,0:20:29.78,Layzner,Officer,0,0,0,,不行 快到里面去
Dialogue: 0,0:20:44.07,0:20:45.66,Layzner,Officer,0,0,0,,只剩下你们了吗
Dialogue: 0,0:20:49.54,0:20:51.10,Layzner,Elizabeth,0,0,0,,其他工作人员呢
Dialogue: 0,0:20:53.91,0:20:56.49,Layzner,Officer,0,0,0,,到里面 快到里面去
Dialogue: 0,0:21:54.70,0:21:56.78,Layzner,Officer,0,0,0,,站住 站住
Dialogue: 0,0:21:59.25,0:22:00.21,Layzner,Officer,0,0,0,,不要动
Dialogue: 0,0:22:00.21,0:22:00.93,Layzner,Eiji,0,0,0,,不要开枪
Dialogue: 0,0:22:03.33,0:22:04.56,Layzner,Eiji,0,0,0,,不要开枪
Dialogue: 0,0:22:20.86,0:22:22.61,Layzner,Officer,0,0,0,,所属是哪里
Dialogue: 0,0:22:22.61,0:22:23.69,Layzner,Officer,0,0,0,,叫什么名字
Dialogue: 0,0:22:25.01,0:22:26.40,Layzner,Eiji,0,0,0,,我是从古拉多斯来的
Dialogue: 0,0:22:28.04,0:22:29.60,Layzner,Eiji,0,0,0,,我的名字叫英二
Dialogue: 0,0:22:30.42,0:22:31.91,Layzner,Eiji,0,0,0,,地球被盯上了
Dialogue: 0,0:22:37.44,0:22:45.21,LayznerWhite,Anna,0,0,0,,这时候 没有人明白那个少年所说的话
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:45.21,0:22:49.36,Layzner,,0,0,0,,但是 这一切都是真的
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:23:53.75,0:23:57.78,Layzner,,0,0,0,,就算这样我身体里也有一半地球人的血统 爸爸是地球人
Dialogue: 0,0:23:57.78,0:24:00.67,Layzner,Gail,0,0,0,,醒醒吧 英二 睁大你的眼睛看清楚
Dialogue: 0,0:24:00.67,0:24:05.22,Layzner,Eiji,0,0,0,,不要 基地里面有和我一样的地球人

Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕組製作 僅供學習交流 禁止用於商業用途
Comment: 0,0:01:39.99,0:01:40.04,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:01:40.81,0:01:45.98,op-jp,,0,0,0,,希望に溢れた　お前の目に浮かぶのは
Dialogue: 0,0:01:45.98,0:01:47.74,op-jp,,0,0,0,,誰の幻想？
Dialogue: 0,0:01:47.74,0:01:51.09,op-jp,,0,0,0,,何もかも失いそうになって
Dialogue: 0,0:01:51.09,0:01:56.27,op-jp,,0,0,0,,巡り会うんだ　再会の誓いを
Dialogue: 0,0:02:09.22,0:02:12.22,op-jp,,0,0,0,,段々と熱くなる
Dialogue: 0,0:02:12.22,0:02:16.47,op-jp,,0,0,0,,心　燃やす　咆哮に変えてけ
Dialogue: 0,0:02:16.47,0:02:19.30,op-jp,,0,0,0,,飄々と歩くのさ
Dialogue: 0,0:02:19.30,0:02:24.20,op-jp,,0,0,0,,先の見えぬ夢を掴むまで
Dialogue: 0,0:02:24.37,0:02:29.70,op-jp,,0,0,0,,時には涙を流す夜もある
Dialogue: 0,0:02:29.70,0:02:34.33,op-jp,,0,0,0,,誓ったあの日を共に笑った事
Dialogue: 0,0:02:34.33,0:02:36.83,op-jp,,0,0,0,,胸に刻み込んで
Dialogue: 0,0:02:36.83,0:02:43.88,op-jp,,0,0,0,,嗚呼　息もできないこの世界であなたにあった夜
Dialogue: 0,0:02:43.88,0:02:50.64,op-jp,,0,0,0,,消えかけた心の灯火　輝いた
Dialogue: 0,0:02:51.01,0:02:55.39,op-jp,,0,0,0,,どんな未来だって　受け容れる
Dialogue: 0,0:02:55.39,0:02:58.15,op-jp,,0,0,0,,生きる理由なんだ
Dialogue: 0,0:02:58.15,0:03:03.40,op-jp,,0,0,0,,燃やせ　今この声が響く限り
Dialogue: 0,0:03:03.40,0:03:09.31,op-jp,,0,0,0,,果てなき明日へ
Dialogue: 0,0:03:09.31,0:03:09.31,op-jp,,0,0,0,,
Dialogue: 0,0:01:40.81,0:01:45.98,op-cn,,0,0,0,,你那充滿希望的雙眸中
Dialogue: 0,0:01:45.98,0:01:47.74,op-cn,,0,0,0,,映出誰的幻想？
Dialogue: 0,0:01:47.74,0:01:51.09,op-cn,,0,0,0,,在即將失去一切之時
Dialogue: 0,0:01:51.09,0:01:56.27,op-cn,,0,0,0,,邂逅重逢的誓言
Dialogue: 0,0:02:09.22,0:02:12.22,op-cn,,0,0,0,,身體愈發火熱
Dialogue: 0,0:02:12.22,0:02:16.47,op-cn,,0,0,0,,燃燒內心 化為咆哮
Dialogue: 0,0:02:16.47,0:02:19.30,op-cn,,0,0,0,,步伐愈顯輕盈
Dialogue: 0,0:02:19.30,0:02:24.20,op-cn,,0,0,0,,直至抓住 未知之夢
Dialogue: 0,0:02:24.37,0:02:29.70,op-cn,,0,0,0,,時而於夜晚落淚
Dialogue: 0,0:02:29.70,0:02:34.33,op-cn,,0,0,0,,一同歡笑 共度立誓之日
Dialogue: 0,0:02:34.33,0:02:36.83,op-cn,,0,0,0,,將其銘記於心
Dialogue: 0,0:02:36.83,0:02:43.88,op-cn,,0,0,0,,在這窒息的世界 邂逅你的夜晚
Dialogue: 0,0:02:43.88,0:02:50.64,op-cn,,0,0,0,,即將熄滅的心中燈火 光芒四射
Dialogue: 0,0:02:51.01,0:02:55.39,op-cn,,0,0,0,,不論怎樣的未來 都甘願接受
Dialogue: 0,0:02:55.39,0:02:58.15,op-cn,,0,0,0,,這就是活著的理由
Dialogue: 0,0:02:58.15,0:03:03.40,op-cn,,0,0,0,,燃燒吧 只要這聲音迴響不止
Dialogue: 0,0:03:03.40,0:03:09.31,op-cn,,0,0,8,,前往永無止境的明天
Dialogue: 0,0:00:30.33,0:00:32.33,op-cn,,0,0,0,,
Comment: 0,0:23:15.95,0:23:16.04,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:29.89,0:23:40.15,ed-jp,,0,0,0,,真っ暗闇の中、光の希望が消え去ることない
Dialogue: 0,0:23:40.15,0:23:43.59,ed-jp,,0,0,0,,ただひとつの誓い
Dialogue: 0,0:23:43.59,0:23:49.82,ed-jp,,0,0,0,,傷だらけでも傷んだ分だけ
Dialogue: 0,0:23:49.82,0:23:56.98,ed-jp,,0,0,0,,繋いだ心　そばにあるさ
Dialogue: 0,0:23:57.17,0:24:03.79,ed-jp,,0,0,0,,大切なもの守り抜けと　その血、汗、涙が導く
Dialogue: 0,0:24:03.79,0:24:10.82,ed-jp,,0,0,0,,己の心に従え、振り向くな、さぁ立ち上がれ
Dialogue: 0,0:24:10.82,0:24:16.53,ed-jp,,0,0,0,,俺が俺である限り　己信じ、明日を思い描け
Dialogue: 0,0:24:16.53,0:24:19.78,ed-jp,,0,0,0,,恐れるな、さぁ高く翔べ
Dialogue: 0,0:24:19.78,0:24:25.73,ed-jp,,0,0,0,,俺たちが輝く日まで
Dialogue: 0,0:24:25.73,0:24:27.73,ed-jp,,0,0,0,,
Dialogue: 0,0:23:29.89,0:23:40.15,ed-cn,,0,0,0,,即便陷入黑暗 希望之光也不會消失
Dialogue: 0,0:23:40.15,0:23:43.59,ed-cn,,0,0,0,,這唯一的誓言
Dialogue: 0,0:23:43.59,0:23:49.82,ed-cn,,0,0,0,,受傷幾次 就強大幾分
Dialogue: 0,0:23:49.82,0:23:56.98,ed-cn,,0,0,0,,我們心心相連 不離不棄
Dialogue: 0,0:23:57.17,0:24:03.79,ed-cn,,0,0,0,,守護珍視之物 以鮮血 汗水 淚水為指引
Dialogue: 0,0:24:03.79,0:24:10.82,ed-cn,,0,0,0,,遵循內心 不要回頭 奮起戰鬥
Dialogue: 0,0:24:10.82,0:24:16.53,ed-cn,,0,0,0,,只要我還是我 就相信自己 描繪明天
Dialogue: 0,0:24:16.53,0:24:19.78,ed-cn,,0,0,0,,不要畏懼 展翅高飛
Dialogue: 0,0:24:19.78,0:24:25.73,ed-cn,,0,0,0,,飛向我們大放異彩之日
Dialogue: 0,0:24:25.73,0:24:25.73,ed-cn,,0,0,0,,
Dialogue: 0,0:00:08.74,0:00:12.99,Default,,0,0,0,,雖然還算及時趕到 但局勢不容樂觀
Dialogue: 0,0:00:13.30,0:00:16.55,Default,,0,0,0,,敵軍有三萬 而我們只有約千騎
Dialogue: 0,0:00:17.19,0:00:18.95,Default,,0,0,0,,速度就是生命
Dialogue: 0,0:00:19.58,0:00:20.78,Default,,0,0,0,,沒錯
Dialogue: 0,0:00:21.25,0:00:21.95,Default,,0,0,0,,我們走
Dialogue: 0,0:00:24.26,0:00:25.96,Default,,0,0,0,,來 來了
Dialogue: 0,0:00:26.23,0:00:28.13,Default,,0,0,0,,快向後列隊
Dialogue: 0,0:00:31.24,0:00:32.88,Default,,0,0,0,,黃龍 向右脫離
Dialogue: 0,0:00:33.23,0:00:33.83,Default,,0,0,0,,是
Dialogue: 0,0:00:34.15,0:00:35.15,Default,,0,0,0,,跟我來
Dialogue: 0,0:00:38.42,0:00:40.50,Default,,0,0,0,,在右邊分出了別動隊
Dialogue: 0,0:00:41.71,0:00:43.61,Default,,0,0,0,,秦軍總司令 昌平君
Dialogue: 0,0:00:44.50,0:00:48.04,Default,,0,0,0,,他是軍略天才 這一點毋庸置疑
Dialogue: 0,0:00:48.88,0:00:52.60,Default,,0,0,0,,但我從未聽說過他以武將身份上陣殺過敵
Dialogue: 0,0:00:54.59,0:00:58.16,Default,,0,0,0,,如今他親身立於戰場 又會怎樣作戰呢
Dialogue: 0,0:00:58.95,0:01:03.11,Default,,0,0,0,,他親自打頭陣鼓舞士氣 確實十分英勇
Dialogue: 0,0:01:04.25,0:01:07.17,Default,,0,0,0,,足夠了 快後撤吧 昌平君
Dialogue: 0,0:01:10.02,0:01:11.67,Default,,0,0,0,,等 等等 昌平君
Dialogue: 0,0:01:11.94,0:01:14.17,Default,,0,0,0,,快退後 你在想什麼啊
Dialogue: 0,0:01:14.36,0:01:15.41,Default,,0,0,0,,來了
Dialogue: 0,0:01:15.41,0:01:17.64,Default,,0,0,0,,幹掉最前面那匹花俏的馬
Dialogue: 0,0:01:17.75,0:01:19.49,Default,,0,0,0,,不必擔心
Dialogue: 0,0:01:20.28,0:01:21.56,Default,,0,0,0,,您不知道嗎
Dialogue: 0,0:01:22.10,0:01:24.31,Default,,0,0,0,,我的主公在兒時
Dialogue: 0,0:01:24.64,0:01:25.64,Default,,0,0,0,,去死吧
Dialogue: 0,0:01:27.16,0:01:29.98,Default,,0,0,0,,可是比蒙武都強
Dialogue: 0,0:01:32.05,0:01:34.90,Default,,0,0,0,,介億 我們要把戎翟公幹掉
Dialogue: 0,0:01:35.22,0:01:36.36,Default,,0,0,0,,遵命
Dialogue: 0,0:03:10.41,0:03:13.58,biaoti,,0,0,0,,{\fad(480,470)}強勢反攻
Dialogue: 0,0:03:29.50,0:03:33.13,Default,,0,0,0,,戎翟公 背後的敵人勢不可擋
Dialogue: 0,0:03:33.22,0:03:35.19,Default,,0,0,0,,筆直朝我們衝過來了
Dialogue: 0,0:03:35.61,0:03:37.54,Default,,0,0,0,,快朝後方調兵
Dialogue: 0,0:03:39.30,0:03:43.33,Default,,0,0,0,,我為應對正面的敵人 把主陣後移
Dialogue: 0,0:03:43.40,0:03:44.77,Default,,0,0,0,,看來適得其反了啊
Dialogue: 0,0:03:46.37,0:03:48.40,Default,,0,0,0,,不出所料 是強敵
Dialogue: 0,0:03:48.51,0:03:50.82,Default,,0,0,0,,不要想著一招制敵
Dialogue: 0,0:03:50.82,0:03:53.33,Default,,0,0,0,,從側面進攻 延緩敵人的攻勢
Dialogue: 0,0:04:03.68,0:04:04.87,Default,,0,0,0,,太驚人了
Dialogue: 0,0:04:05.25,0:04:05.91,Default,,0,0,0,,壁
Dialogue: 0,0:04:06.21,0:04:09.79,Default,,0,0,0,,總司令居然是如此勇猛的武將
Dialogue: 0,0:04:12.55,0:04:14.20,Default,,0,0,0,,誇張來說
Dialogue: 0,0:04:15.35,0:04:17.26,Default,,0,0,0,,武力與蒙武相當
Dialogue: 0,0:04:17.44,0:04:21.75,Default,,0,0,0,,而毫不誇張地說 頭腦與李牧相當
Dialogue: 0,0:04:24.29,0:04:26.16,Default,,0,0,0,,你們一定心裡一驚吧
Dialogue: 0,0:04:26.75,0:04:31.89,Default,,0,0,0,,若他沒有來到秦國 而是身處故鄉楚國…
Dialogue: 0,0:04:35.75,0:04:36.61,Default,,0,0,0,,確實
Dialogue: 0,0:04:39.09,0:04:40.74,Default,,0,0,0,,右側有騎兵攻來
Dialogue: 0,0:04:40.74,0:04:42.80,Default,,0,0,0,,敵人想從側面進攻
Dialogue: 0,0:04:43.19,0:04:44.93,Default,,0,0,0,,從側面切斷敵人
Dialogue: 0,0:04:45.80,0:04:48.95,Default,,0,0,0,,不必擔心 交給黃龍便是
Dialogue: 0,0:04:49.26,0:04:51.52,pm1,,0,0,0,,{\pos(524,794)}昌平君主力
Dialogue: 0,0:04:49.26,0:04:51.52,pm1,,0,0,0,,{\pos(1494,182)}諾克隊
Dialogue: 0,0:04:49.26,0:04:51.52,pm1,,0,0,0,,{\pos(1560,596)}黃龍隊
Dialogue: 0,0:04:51.68,0:04:52.39,Default,,0,0,0,,什麼
Dialogue: 0,0:04:54.52,0:04:56.25,Default,,0,0,0,,右側分離出的部隊…
Dialogue: 0,0:04:56.25,0:04:57.77,Default,,0,0,0,,回來了嗎
Dialogue: 0,0:04:58.13,0:05:00.74,Default,,0,0,0,,那就是黃龍隊的任務
Dialogue: 0,0:05:00.74,0:05:05.06,Default,,0,0,0,,敵人反被攻了側面
Dialogue: 0,0:05:05.86,0:05:06.85,Default,,0,0,0,,不會吧
Dialogue: 0,0:05:07.25,0:05:10.41,Default,,0,0,0,,左翼的諾克隊瞬間就被…
Dialogue: 0,0:05:12.56,0:05:14.66,Default,,0,0,0,,右翼的哈穆伊隊還沒回來嗎
Dialogue: 0,0:05:15.04,0:05:17.16,Default,,0,0,0,,是的 還需要時間
Dialogue: 0,0:05:18.37,0:05:20.65,Default,,0,0,0,,哈穆伊隊八百騎回來了
Dialogue: 0,0:05:21.55,0:05:23.89,Default,,0,0,0,,就那樣從右側攻擊
Dialogue: 0,0:05:23.99,0:05:24.61,Default,,0,0,0,,是
Dialogue: 0,0:05:25.91,0:05:28.61,Default,,0,0,0,,敵人的左翼沒有別動隊
Dialogue: 0,0:05:29.24,0:05:32.21,Default,,0,0,0,,左側 有騎兵隊沿著城牆攻來了
Dialogue: 0,0:05:32.21,0:05:32.95,Default,,0,0,0,,什麼
Dialogue: 0,0:05:33.38,0:05:34.94,Default,,0,0,0,,人數眾多
Dialogue: 0,0:05:36.61,0:05:38.45,Default,,0,0,0,,這下又從左側進攻嗎
Dialogue: 0,0:05:38.78,0:05:40.80,Default,,0,0,0,,壁隊兩百人 跟我來
Dialogue: 0,0:05:40.97,0:05:43.28,Default,,0,0,0,,我們去拖住那隊敵人
Dialogue: 0,0:05:46.21,0:05:47.18,Default,,0,0,0,,等等 壁
Dialogue: 0,0:05:48.61,0:05:49.89,Default,,0,0,0,,不必過去
Dialogue: 0,0:05:52.21,0:05:53.71,Default,,0,0,0,,好 衝過去
Dialogue: 0,0:05:59.84,0:06:02.13,Default,,0,0,0,,城內衝出了黑色的騎兵
Dialogue: 0,0:06:02.95,0:06:04.98,Default,,0,0,0,,那是直屬總司令的…
Dialogue: 0,0:06:06.99,0:06:09.00,Default,,0,0,0,,果然力量尚存啊
Dialogue: 0,0:06:09.07,0:06:10.72,Default,,0,0,0,,豹司牙黑騎兵
Dialogue: 0,0:06:11.21,0:06:12.20,Default,,0,0,0,,我們殺
Dialogue: 0,0:06:12.28,0:06:12.96,Default,,0,0,0,,是
Dialogue: 0,0:06:14.02,0:06:16.59,Default,,0,0,0,,這下左右兩側就築起了牆壁
Dialogue: 0,0:06:18.13,0:06:21.61,Default,,0,0,0,,你怎麼也跟來了 蒙毅
Dialogue: 0,0:06:22.04,0:06:26.32,Default,,0,0,0,,老師親自指揮的戰鬥 怎能不在陣中觀摩
Dialogue: 0,0:06:27.59,0:06:28.74,Default,,0,0,0,,沒錯
Dialogue: 0,0:06:30.95,0:06:32.47,Default,,0,0,0,,話說回來 介億老師
Dialogue: 0,0:06:33.16,0:06:35.07,Default,,0,0,0,,這是「包雷」之陣吧
Dialogue: 0,0:06:39.44,0:06:42.09,Default,,0,0,0,,是守住正面城門的黑騎兵
Dialogue: 0,0:06:42.66,0:06:45.63,Default,,0,0,0,,他們呼應著總司令出來了嗎
Dialogue: 0,0:06:47.54,0:06:51.13,Default,,0,0,0,,左右似乎順利護住了中央的前進路線
Dialogue: 0,0:06:52.68,0:06:53.68,Default,,0,0,0,,這是…
Dialogue: 0,0:06:55.48,0:06:56.26,Default,,0,0,0,,包雷
Dialogue: 0,0:07:00.64,0:07:01.86,Default,,0,0,0,,尚鹿將軍
Dialogue: 0,0:07:02.05,0:07:07.41,Default,,0,0,0,,立刻命令全體士兵解除隊形 朝前方組成人牆
Dialogue: 0,0:07:08.80,0:07:10.51,Default,,0,0,0,,你瞎說什麼
Dialogue: 0,0:07:10.71,0:07:13.57,Default,,0,0,0,,我們可是被包圍 正在混戰啊
Dialogue: 0,0:07:13.73,0:07:16.60,Default,,0,0,0,,要是解除隊形 連一個時辰都撐不住
Dialogue: 0,0:07:16.60,0:07:17.79,Default,,0,0,0,,沒錯
Dialogue: 0,0:07:18.00,0:07:19.41,Default,,0,0,0,,不需要一個時辰
Dialogue: 0,0:07:20.07,0:07:21.81,Default,,0,0,0,,勝負只在一瞬間
Dialogue: 0,0:07:22.86,0:07:25.44,Default,,0,0,0,,只能將一切託付給總司令了
Dialogue: 0,0:07:26.87,0:07:28.42,Default,,0,0,0,,我無法認可
Dialogue: 0,0:07:28.64,0:07:31.58,Default,,0,0,0,,這裡還有五千多名士兵啊
Dialogue: 0,0:07:31.80,0:07:36.18,Default,,0,0,0,,怎能不清不楚地賭上他們所有人的性命
Dialogue: 0,0:07:37.22,0:07:39.68,Default,,0,0,0,,我是飛信隊的軍師
Dialogue: 0,0:07:40.15,0:07:43.19,Default,,0,0,0,,同時也是總司令·昌平君的學生
Dialogue: 0,0:07:43.78,0:07:46.70,Default,,0,0,0,,我很清楚你的意思
Dialogue: 0,0:07:46.99,0:07:48.84,Default,,0,0,0,,作為將領 你說得很對
Dialogue: 0,0:07:49.47,0:07:50.12,Default,,0,0,0,,但是…
Dialogue: 0,0:07:52.09,0:07:53.20,Default,,0,0,0,,現在請相信我…
Dialogue: 0,0:07:54.00,0:07:55.95,Default,,0,0,0,,相信昌平君
Dialogue: 0,0:08:02.76,0:08:04.03,Default,,0,0,0,,所謂包雷
Dialogue: 0,0:08:04.03,0:08:08.58,Default,,0,0,0,,即在敵人左右及後側築起防壁 封住敵將的行動
Dialogue: 0,0:08:08.58,0:08:12.84,Default,,0,0,0,,再以中央的鋒刃取其首級 乃一擊必殺之術
Dialogue: 0,0:08:13.19,0:08:17.41,Default,,0,0,0,,此戰術通常用於大規模廣範圍的戰場
Dialogue: 0,0:08:17.54,0:08:21.20,Default,,0,0,0,,但此刻 主公正打算在以少對多的情況下實施
Dialogue: 0,0:08:22.40,0:08:25.97,Default,,0,0,0,,可是 敵將背後築不起牆啊
Dialogue: 0,0:08:26.40,0:08:29.37,Default,,0,0,0,,敵將背後是混戰戰場
Dialogue: 0,0:08:31.09,0:08:34.02,Default,,0,0,0,,這次就勉強讓那一戰場充當人牆
Dialogue: 0,0:08:34.50,0:08:38.07,Default,,0,0,0,,雖不太可靠 但聊勝於無…
Dialogue: 0,0:08:47.88,0:08:50.04,Default,,0,0,0,,把所有軍旗都舉起來
Dialogue: 0,0:08:50.46,0:08:52.05,Default,,0,0,0,,不需要向前推進
Dialogue: 0,0:08:52.25,0:08:53.88,Default,,0,0,0,,全力維持陣型
Dialogue: 0,0:08:54.43,0:08:56.18,Default,,0,0,0,,後面也頂住
Dialogue: 0,0:08:57.44,0:08:59.20,Default,,0,0,0,,後方形成了牆壁
Dialogue: 0,0:09:02.09,0:09:04.14,Default,,0,0,0,,你在那裡嗎 河了貂
Dialogue: 0,0:09:04.61,0:09:05.73,Default,,0,0,0,,河了貂
Dialogue: 0,0:09:09.12,0:09:10.02,Default,,0,0,0,,貂？
Dialogue: 0,0:09:10.44,0:09:12.13,Default,,0,0,0,,包雷完成了
Dialogue: 0,0:09:12.40,0:09:14.34,Default,,0,0,0,,你無處可逃了 戎翟公
Dialogue: 0,0:09:14.90,0:09:17.27,Default,,0,0,0,,這下就…結束了
Dialogue: 0,0:09:21.11,0:09:22.83,Default,,0,0,0,,衝啊 衝啊
Dialogue: 0,0:09:23.06,0:09:24.87,Default,,0,0,0,,敵人勢如破竹
Dialogue: 0,0:09:25.01,0:09:26.44,Default,,0,0,0,,你們在做什麼
Dialogue: 0,0:09:26.44,0:09:27.54,Default,,0,0,0,,雖說敵人只有一千
Dialogue: 0,0:09:27.54,0:09:30.59,Default,,0,0,0,,但若是全力衝鋒 我們的主陣也防不住
Dialogue: 0,0:09:31.84,0:09:34.09,Default,,0,0,0,,左右的援軍過不來嗎
Dialogue: 0,0:09:36.29,0:09:39.72,Default,,0,0,0,,右側的哈穆伊隊依舊在和黑騎兵戰鬥
Dialogue: 0,0:09:40.05,0:09:42.22,Default,,0,0,0,,左側被敵人的別動隊拖住了
Dialogue: 0,0:09:42.72,0:09:46.20,Default,,0,0,0,,背後也有人牆 就像在封鎖我們一般
Dialogue: 0,0:09:47.09,0:09:51.08,Default,,0,0,0,,可惡 他們怎麼還有這種力量
Dialogue: 0,0:09:51.19,0:09:52.02,Default,,0,0,0,,戎翟公
Dialogue: 0,0:09:52.55,0:09:55.01,Default,,0,0,0,,請朝左側或右側逃吧
Dialogue: 0,0:09:55.32,0:09:58.37,Default,,0,0,0,,這樣下去 會受到敵人的正面衝鋒
Dialogue: 0,0:09:59.52,0:10:01.49,Default,,0,0,0,,還 還沒好嗎 河了貂
Dialogue: 0,0:10:01.63,0:10:03.73,Default,,0,0,0,,撐住 只差一點了
Dialogue: 0,0:10:03.86,0:10:04.93,Default,,0,0,0,,只差一點
Dialogue: 0,0:10:05.75,0:10:09.75,Default,,0,0,0,,昌平君的鋒刃 就能觸及敵將戎翟公了
Dialogue: 0,0:10:10.69,0:10:11.53,Default,,0,0,0,,衝啊
Dialogue: 0,0:10:11.53,0:10:14.05,Default,,0,0,0,,殺啊 殺了他們
Dialogue: 0,0:10:16.92,0:10:18.90,Default,,0,0,0,,諸位 時機已到
Dialogue: 0,0:10:19.27,0:10:21.28,Default,,0,0,0,,此包圍網只此一次
Dialogue: 0,0:10:21.63,0:10:25.56,Default,,0,0,0,,此刻就是我等的唯一勝機
Dialogue: 0,0:10:25.89,0:10:27.56,Default,,0,0,0,,一擊必殺
Dialogue: 0,0:10:27.63,0:10:31.25,Default,,0,0,0,,豁出性命 誓要取戎翟公之首級
Dialogue: 0,0:10:36.60,0:10:39.45,Default,,0,0,0,,在這個時候將士氣激發至最高
Dialogue: 0,0:10:39.84,0:10:42.40,Default,,0,0,0,,戎翟公 請快些撤離
Dialogue: 0,0:10:42.64,0:10:44.47,Default,,0,0,0,,我們來爭取時間
Dialogue: 0,0:10:44.47,0:10:47.20,Default,,0,0,0,,請趁此機會 在左側或右側開闢退路
Dialogue: 0,0:10:47.49,0:10:50.61,Default,,0,0,0,,只要脫離這個險境 就是我們的勝利
Dialogue: 0,0:10:50.74,0:10:51.96,Default,,0,0,0,,戎翟公
Dialogue: 0,0:10:53.26,0:10:55.60,Default,,0,0,0,,此刻沒有退路
Dialogue: 0,0:10:57.56,0:10:59.26,Default,,0,0,0,,戎 戎翟公…
Dialogue: 0,0:11:01.00,0:11:03.01,Default,,0,0,0,,即便朝左右或背後逃離
Dialogue: 0,0:11:03.19,0:11:05.85,Default,,0,0,0,,也會被人牆拖住 被敵人攻至背後
Dialogue: 0,0:11:06.48,0:11:10.85,Default,,0,0,0,,他們應該也很清楚 這就是唯一的勝機
Dialogue: 0,0:11:11.44,0:11:13.87,Default,,0,0,0,,敵人非比尋常
Dialogue: 0,0:11:14.28,0:11:17.05,Default,,0,0,0,,不可能有所疏漏
Dialogue: 0,0:11:17.97,0:11:19.11,Default,,0,0,0,,戎翟公
Dialogue: 0,0:11:19.80,0:11:23.74,Default,,0,0,0,,戎翟之王 永遠都是一族最強
Dialogue: 0,0:11:25.97,0:11:27.24,Default,,0,0,0,,我問你們
Dialogue: 0,0:11:28.21,0:11:30.87,Default,,0,0,0,,你們相信我戎翟之王的力量嗎
Dialogue: 0,0:11:33.79,0:11:34.75,Default,,0,0,0,,相信
Dialogue: 0,0:11:35.13,0:11:36.43,Default,,0,0,0,,當然相信
Dialogue: 0,0:11:36.43,0:11:39.16,Default,,0,0,0,,我們願為戎翟公赴湯蹈火
Dialogue: 0,0:11:40.26,0:11:42.01,Default,,0,0,0,,那就跟我來
Dialogue: 0,0:11:42.76,0:11:44.71,Default,,0,0,0,,身後無活路
Dialogue: 0,0:11:54.76,0:11:55.50,Default,,0,0,0,,什麼
Dialogue: 0,0:11:57.04,0:11:58.32,Default,,0,0,0,,怎麼了 河了貂
Dialogue: 0,0:11:58.82,0:11:59.97,Default,,0,0,0,,戎翟公
Dialogue: 0,0:12:01.03,0:12:02.89,Default,,0,0,0,,讓開 讓開
Dialogue: 0,0:12:03.01,0:12:06.53,Default,,0,0,0,,戎翟公出陣了 把路讓開
Dialogue: 0,0:12:11.33,0:12:13.22,Default,,0,0,0,,敵人主陣開始行動了
Dialogue: 0,0:12:13.22,0:12:15.29,Default,,0,0,0,,筆直朝我們衝來了
Dialogue: 0,0:12:16.16,0:12:16.87,Default,,0,0,0,,什麼
Dialogue: 0,0:12:19.24,0:12:20.36,Default,,0,0,0,,真敏銳
Dialogue: 0,0:12:20.98,0:12:22.98,Default,,0,0,0,,要想脫離這包雷之陣
Dialogue: 0,0:12:23.44,0:12:25.32,Default,,0,0,0,,就只能衝向中央的主攻部隊
Dialogue: 0,0:12:22.47,0:12:34.23,pm2,,0,0,0,,{\c&H363432&\fs50\pos(365.6,543.2)}河了貂築起的人牆
Dialogue: 0,0:12:25.51,0:12:27.54,Default,,0,0,0,,與其擦肩而出
Dialogue: 0,0:12:28.24,0:12:29.87,Default,,0,0,0,,如果我們失手
Dialogue: 0,0:12:30.08,0:12:33.68,Default,,0,0,0,,敵將就會逃入我們身後的戎翟兵人海中
Dialogue: 0,0:12:34.68,0:12:35.37,Default,,0,0,0,,但是
Dialogue: 0,0:12:35.72,0:12:40.52,Default,,0,0,0,,兩軍如此猛烈的碰撞 敵將真有自信能沖出重圍嗎
Dialogue: 0,0:12:41.43,0:12:44.20,Default,,0,0,0,,敵人也挺勇猛嘛
Dialogue: 0,0:12:44.64,0:12:45.69,Default,,0,0,0,,蠻勇罷了
Dialogue: 0,0:12:46.00,0:12:47.57,Default,,0,0,0,,省了追擊的工夫
Dialogue: 0,0:12:49.65,0:12:51.08,Default,,0,0,0,,鞏固前方
Dialogue: 0,0:12:53.33,0:12:54.79,Default,,0,0,0,,衝散他們
Dialogue: 0,0:13:07.49,0:13:09.22,Default,,0,0,0,,去死
Dialogue: 0,0:13:09.81,0:13:10.71,Default,,0,0,0,,壁
Dialogue: 0,0:13:17.41,0:13:18.12,Default,,0,0,0,,布達伊
Dialogue: 0,0:13:18.30,0:13:18.96,Default,,0,0,0,,在
Dialogue: 0,0:13:19.97,0:13:22.69,Default,,0,0,0,,這支叛軍是烏合之眾
Dialogue: 0,0:13:23.17,0:13:25.40,Default,,0,0,0,,如今樊於期進入了城內
Dialogue: 0,0:13:25.58,0:13:28.87,Default,,0,0,0,,若是我陣亡 整支部隊就將瓦解
Dialogue: 0,0:13:30.01,0:13:31.01,Default,,0,0,0,,戎翟公…
Dialogue: 0,0:13:32.36,0:13:36.80,Default,,0,0,0,,到那時 你們幾個重臣無論如何都要活下去
Dialogue: 0,0:13:37.40,0:13:42.34,Default,,0,0,0,,活下去 將這仇恨傳給下一代戎翟族人
Dialogue: 0,0:13:45.48,0:13:46.97,Default,,0,0,0,,直到百年後
Dialogue: 0,0:13:48.80,0:13:51.80,Default,,0,0,0,,讓戎翟之血再次沸騰
Dialogue: 0,0:13:52.28,0:13:53.52,Default,,0,0,0,,戎翟公
Dialogue: 0,0:13:56.16,0:13:59.30,Default,,0,0,0,,與我一戰 秦國的勇士
Dialogue: 0,0:14:10.12,0:14:12.93,Default,,0,0,0,,這傢伙…一開始就瞄準了我的手
Dialogue: 0,0:14:15.57,0:14:19.46,Default,,0,0,0,,智勇均不及他嗎 這怪物
Dialogue: 0,0:14:27.94,0:14:30.18,Default,,0,0,0,,戎翟公
Dialogue: 0,0:14:30.80,0:14:31.59,Default,,0,0,0,,介億
Dialogue: 0,0:14:36.39,0:14:39.35,Default,,0,0,0,,叛軍之將 戎翟公
Dialogue: 0,0:14:39.59,0:14:42.90,Default,,0,0,0,,以被秦軍總司令 昌平君
Dialogue: 0,0:14:43.03,0:14:45.11,Default,,0,0,0,,親手斬殺
Dialogue: 0,0:14:50.75,0:14:52.37,Default,,0,0,0,,為勝利吶喊吧
Dialogue: 0,0:15:14.36,0:15:15.97,Default,,0,0,0,,不 不會吧
Dialogue: 0,0:15:16.61,0:15:18.98,Default,,0,0,0,,這 這歡呼聲是…
Dialogue: 0,0:15:20.47,0:15:21.18,Default,,0,0,0,,好
Dialogue: 0,0:15:21.28,0:15:22.44,Default,,0,0,0,,尚鹿將軍
Dialogue: 0,0:15:22.78,0:15:26.20,Default,,0,0,0,,立刻傳令 解除人牆
Dialogue: 0,0:15:26.20,0:15:27.19,Default,,0,0,0,,什 什麼
Dialogue: 0,0:15:27.88,0:15:31.20,Default,,0,0,0,,雖說主公斬殺了戎翟公
Dialogue: 0,0:15:31.58,0:15:35.79,Default,,0,0,0,,但叛軍依舊有人數優勢
Dialogue: 0,0:15:37.47,0:15:42.44,Default,,0,0,0,,我們的最重要使命 並非殲滅叛軍
Dialogue: 0,0:15:43.16,0:15:47.34,Default,,0,0,0,,而是盡快拯救咸陽的危機
Dialogue: 0,0:15:54.77,0:15:57.39,Default,,0,0,0,,快 快看 人牆有縫隙
Dialogue: 0,0:15:57.79,0:16:01.53,Default,,0,0,0,,在敵軍重建指揮體系之前 故意解除包圍
Dialogue: 0,0:16:01.53,0:16:02.95,Default,,0,0,0,,促其敗退
Dialogue: 0,0:16:03.19,0:16:06.85,Default,,0,0,0,,判斷越來越快了啊 河了貂
Dialogue: 0,0:16:08.87,0:16:11.15,Default,,0,0,0,,去從各個方向推動敵軍
Dialogue: 0,0:16:11.46,0:16:12.38,Default,,0,0,0,,是
Dialogue: 0,0:16:13.24,0:16:16.62,Default,,0,0,0,,快逃 東邊敞開了退路
Dialogue: 0,0:16:16.62,0:16:18.53,Default,,0,0,0,,暫且撤退
Dialogue: 0,0:16:19.15,0:16:21.50,Default,,0,0,0,,等 等等 不要被迷惑了
Dialogue: 0,0:16:21.50,0:16:23.12,Default,,0,0,0,,這是敵人的喊聲
Dialogue: 0,0:16:23.49,0:16:26.38,Default,,0,0,0,,蒙武軍馬上就從前線回來了
Dialogue: 0,0:16:26.66,0:16:28.13,Default,,0,0,0,,撤退
Dialogue: 0,0:16:28.43,0:16:30.43,Default,,0,0,0,,桓騎軍要來了
Dialogue: 0,0:16:30.43,0:16:32.76,Default,,0,0,0,,朝東邊逃 跑起來
Dialogue: 0,0:16:33.15,0:16:35.89,Default,,0,0,0,,樊於期大人在哪裡啊
Dialogue: 0,0:16:36.13,0:16:38.95,Default,,0,0,0,,戎翟公真的戰死了嗎
Dialogue: 0,0:16:39.66,0:16:45.84,Default,,0,0,0,,叛軍由樊於期軍 戎翟軍 強制徵召的士兵組成
Dialogue: 0,0:16:45.84,0:16:47.19,Default,,0,0,0,,乃烏合之眾
Dialogue: 0,0:16:48.04,0:16:49.04,Default,,0,0,0,,因此
Dialogue: 0,0:16:49.17,0:16:53.51,Default,,0,0,0,,只要形成敗退流向 便會瞬間化為猛烈的濁流
Dialogue: 0,0:16:53.65,0:16:56.53,Default,,0,0,0,,發展為全軍敗退之勢
Dialogue: 0,0:17:03.38,0:17:05.14,Default,,0,0,0,,輸了嗎
Dialogue: 0,0:17:06.19,0:17:09.59,Default,,0,0,0,,為什麼要逃 我軍分明依然佔據數量優勢
Dialogue: 0,0:17:09.94,0:17:11.82,Default,,0,0,0,,不好 朝這邊來了
Dialogue: 0,0:17:11.92,0:17:13.53,Default,,0,0,0,,暫且撤退
Dialogue: 0,0:17:13.53,0:17:16.30,Default,,0,0,0,,朝東邊 往毐國方向逃
Dialogue: 0,0:17:16.42,0:17:17.51,Default,,0,0,0,,調頭
Dialogue: 0,0:17:18.93,0:17:19.92,Default,,0,0,0,,嫪毐大人
Dialogue: 0,0:17:20.03,0:17:21.31,Default,,0,0,0,,請快上馬車
Dialogue: 0,0:17:22.13,0:17:23.73,Default,,0,0,0,,不 不對
Dialogue: 0,0:17:24.68,0:17:26.76,Default,,0,0,0,,不 不是東邊
Dialogue: 0,0:17:27.33,0:17:29.85,Default,,0,0,0,,要去西邊…西邊的雍城
Dialogue: 0,0:17:30.90,0:17:34.96,Default,,0,0,0,,我 我們約定好了 要去接她
Dialogue: 0,0:17:35.52,0:17:37.70,Default,,0,0,0,,我先過去等你了
Dialogue: 0,0:17:38.07,0:17:39.16,Default,,0,0,0,,嫪毐
Dialogue: 0,0:17:39.84,0:17:42.46,Default,,0,0,0,,我 我們約定要攻下咸陽
Dialogue: 0,0:17:43.30,0:17:45.76,Default,,0,0,0,,去雍城迎接她
Dialogue: 0,0:17:46.88,0:17:50.71,Default,,0,0,0,,我和太后約定好了啊
Dialogue: 0,0:17:51.04,0:17:55.21,Default,,0,0,0,,太后
Dialogue: 0,0:17:55.57,0:17:58.22,Default,,0,0,0,,收到報告 城外的部隊正在撤退
Dialogue: 0,0:17:58.60,0:18:01.72,Default,,0,0,0,,樊於期大人 我們也暫且出城吧
Dialogue: 0,0:18:04.60,0:18:08.30,Default,,0,0,0,,太子的護衛也是黑騎兵這群強手
Dialogue: 0,0:18:08.58,0:18:12.08,Default,,0,0,0,,秦軍總司令竟如此滴水不漏
Dialogue: 0,0:18:12.63,0:18:16.61,Default,,0,0,0,,再加上城外的戰敗 失算一個接一個
Dialogue: 0,0:18:17.59,0:18:22.31,Default,,0,0,0,,助我飛黃騰達的階梯竟如此弱不禁風
Dialogue: 0,0:18:23.12,0:18:26.00,Default,,0,0,0,,撤出咸陽 去通知琉期他們
Dialogue: 0,0:18:26.27,0:18:27.30,Default,,0,0,0,,是
Dialogue: 0,0:18:33.43,0:18:34.52,Default,,0,0,0,,太好了
Dialogue: 0,0:18:35.07,0:18:37.75,Default,,0,0,0,,可惡 為什麼會變成這樣
Dialogue: 0,0:18:38.43,0:18:40.12,Default,,0,0,0,,已經沒事了嗎
Dialogue: 0,0:19:02.58,0:19:04.53,Default,,0,0,0,,河了貂 你真厲害
Dialogue: 0,0:19:04.87,0:19:06.50,Default,,0,0,0,,謝謝誇獎 蒙毅
Dialogue: 0,0:19:06.85,0:19:08.93,Default,,0,0,0,,算你欠我的 壁
Dialogue: 0,0:19:09.41,0:19:10.96,Default,,0,0,0,,我知道
Dialogue: 0,0:19:12.23,0:19:13.53,Default,,0,0,0,,昌文君
Dialogue: 0,0:19:16.42,0:19:18.05,Default,,0,0,0,,政的加冠大典呢
Dialogue: 0,0:19:18.79,0:19:19.82,Default,,0,0,0,,昌文君
Dialogue: 0,0:19:20.37,0:19:21.63,Default,,0,0,0,,沒問題
Dialogue: 0,0:19:21.92,0:19:25.87,Default,,0,0,0,,雖然稍有倉促 但還是正式完成了
Dialogue: 0,0:19:27.55,0:19:28.77,Default,,0,0,0,,這 這麼說…
Dialogue: 0,0:19:29.60,0:19:31.62,Default,,0,0,0,,咸陽也脫離險境
Dialogue: 0,0:19:32.44,0:19:35.77,Default,,0,0,0,,此次叛亂 呂不韋也將被問罪
Dialogue: 0,0:19:37.35,0:19:40.78,Default,,0,0,0,,也就是說 呂不韋將就此倒台
Dialogue: 0,0:19:53.46,0:19:56.66,Default,,0,0,0,,我能問你一個問題嗎 昌平君
Dialogue: 0,0:19:57.75,0:20:01.22,Default,,0,0,0,,你為什麼背叛了呂不韋
Dialogue: 0,0:20:04.42,0:20:08.67,Default,,0,0,0,,說實話 要是你沒有用密文把叛亂的事告訴貂
Dialogue: 0,0:20:09.50,0:20:11.28,Default,,0,0,0,,政就已經輸掉了
Dialogue: 0,0:20:22.98,0:20:23.98,Default,,0,0,0,,因為
Dialogue: 0,0:20:25.92,0:20:29.68,Default,,0,0,0,,我也心懷統領全中華的夢想
Dialogue: 0,0:20:33.04,0:20:34.08,Default,,0,0,0,,而我認為
Dialogue: 0,0:20:35.92,0:20:42.00,Default,,0,0,0,,當代秦王之器量 足以讓我託付夢想
Dialogue: 0,0:20:47.88,0:20:51.56,Default,,0,0,0,,我們這些家臣才最是不服氣
Dialogue: 0,0:20:52.25,0:20:54.23,Default,,0,0,0,,但我們的主公
Dialogue: 0,0:20:54.86,0:20:59.62,Default,,0,0,0,,賭上一切 加入了大王麾下
Dialogue: 0,0:21:06.40,0:21:07.32,Default,,0,0,0,,我想也是
Dialogue: 0,0:21:07.76,0:21:10.20,Default,,0,0,0,,這次是真的多虧了你
Dialogue: 0,0:21:11.06,0:21:14.77,Default,,0,0,0,,我代替秦王·政 對你表示感謝 昌平君
Dialogue: 0,0:21:15.96,0:21:16.60,Default,,0,0,0,,不過
Dialogue: 0,0:21:16.97,0:21:20.90,Default,,0,0,0,,從蕞城那會兒開始 我就沒覺得你是敵人了
Dialogue: 0,0:21:21.70,0:21:23.24,Default,,0,0,0,,今後請多指教啦
Dialogue: 0,0:21:24.44,0:21:27.25,Default,,0,0,0,,你憑什麼代替大王啊
Dialogue: 0,0:21:27.41,0:21:29.07,Default,,0,0,0,,你這口氣…
Dialogue: 0,0:21:29.89,0:21:32.12,Default,,0,0,0,,你以為你是誰啊
Dialogue: 0,0:21:34.24,0:21:37.42,Default,,0,0,0,,所以呢 逃走的叛軍要怎麼辦
Dialogue: 0,0:21:37.68,0:21:40.08,Default,,0,0,0,,讓他們逃回毐國嗎
Dialogue: 0,0:21:40.92,0:21:42.55,Default,,0,0,0,,情緒轉換得真快
Dialogue: 0,0:21:43.11,0:21:46.72,Default,,0,0,0,,趙國前線的桓騎軍正在往回趕
Dialogue: 0,0:21:47.31,0:21:51.32,Default,,0,0,0,,應該會在函谷關一帶迎擊叛軍 將其殲滅
Dialogue: 0,0:21:53.88,0:21:54.60,Default,,0,0,0,,這樣啊
Dialogue: 0,0:21:56.12,0:21:56.90,Default,,0,0,0,,這麼說…
Dialogue: 0,0:22:05.69,0:22:06.98,Default,,0,0,0,,昌文君
Dialogue: 0,0:22:07.99,0:22:08.88,Default,,0,0,0,,幹什麼
Dialogue: 0,0:22:09.76,0:22:11.94,Default,,0,0,0,,這話你來說吧
Dialogue: 0,0:22:12.74,0:22:16.24,Default,,0,0,0,,政的加冠 呂不韋的倒台
Dialogue: 0,0:22:17.26,0:22:19.73,Default,,0,0,0,,這意味著什麼
Dialogue: 0,0:22:27.14,0:22:27.72,Default,,0,0,0,,好
Dialogue: 0,0:22:28.78,0:22:31.16,Default,,0,0,0,,這意味著我們…
Dialogue: 0,0:22:32.47,0:22:35.61,Default,,0,0,0,,不 意味著大王…
Dialogue: 0,0:22:36.98,0:22:38.92,Default,,0,0,0,,我在邯鄲沒有學習過
Dialogue: 0,0:22:40.07,0:22:43.30,Default,,0,0,0,,有勞你多加教導了 昌文君
Dialogue: 0,0:22:44.88,0:22:50.72,Default,,0,0,0,,自即位以來 經歷了…
Dialogue: 0,0:22:52.07,0:22:55.71,Default,,0,0,0,,與呂不韋長達九年的鬥爭…
Dialogue: 0,0:22:56.26,0:22:59.33,Default,,0,0,0,,終 終於…
Dialogue: 0,0:23:01.14,0:23:03.89,Default,,0,0,0,,大獲全勝
Dialogue: 0,0:23:04.39,0:23:05.20,Default,,0,0,0,,主公
Dialogue: 0,0:23:05.59,0:23:06.50,Default,,0,0,0,,主公
Dialogue: 0,0:24:48.22,0:24:49.99,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:50.53,0:24:52.40,Default,,0,0,0,,「內亂的終點」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

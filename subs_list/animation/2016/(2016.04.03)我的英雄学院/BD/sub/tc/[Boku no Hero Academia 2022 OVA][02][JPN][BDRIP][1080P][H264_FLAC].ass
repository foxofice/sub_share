Dialogue: 0,0:00:03.50,0:00:05.70,Default,,0,0,0,,我 綠谷出久
Dialogue: 0,0:00:05.70,0:00:08.66,Default,,0,0,0,,在進入雄英高中英雄科就讀之後
Dialogue: 0,0:00:08.66,0:00:11.04,Default,,0,0,0,,已經過了快十個月
Dialogue: 0,0:00:13.20,0:00:14.79,Default,,0,0,0,,季節來到了冬天
Dialogue: 0,0:00:15.91,0:00:19.33,Default,,0,0,0,,我在學校接受一般課程之餘
Dialogue: 0,0:00:19.33,0:00:20.66,Default,,0,0,0,,每個星期都會花四天
Dialogue: 0,0:00:20.66,0:00:23.50,Default,,0,0,0,,在NO.1英雄 安德瓦的事務所
Dialogue: 0,0:00:23.50,0:00:26.16,Default,,0,0,0,,每天努力地進行英雄實習
Dialogue: 0,0:00:36.62,0:00:38.83,Default,,0,0,0,,接下來要講述的插曲
Dialogue: 0,0:00:38.83,0:00:41.45,Default,,0,0,0,,是我在英雄實習時發生的
Dialogue: 0,0:00:41.45,0:00:42.70,Default,,0,0,0,,一個既奇妙
Dialogue: 0,0:00:42.70,0:00:45.83,Default,,0,0,0,,又恐怖的事件的完整經過
Dialogue: 0,0:00:58.12,0:01:05.83,Default,,0,0,0,,(我的英雄學院)
Dialogue: 1,0:02:22.79,0:02:26.37,Default2,,0,0,0,,目前為止
Dialogue: 0,0:02:22.79,0:02:26.37,Default,,0,0,0,,受害的案件已經超過50起了
Dialogue: 1,0:02:26.37,0:02:30.75,Default2,,0,0,0,,拜託您了 請您務必幫忙
Dialogue: 0,0:02:26.37,0:02:30.75,Default,,0,0,0,,協助我們逮捕犯人好嗎
Dialogue: 1,0:02:31.79,0:02:35.12,Default2,,0,0,0,,你是要我們
Dialogue: 0,0:02:31.79,0:02:35.12,Default,,0,0,0,,幫忙抓到亂塗鴉的犯人嗎
Dialogue: 0,0:02:35.12,0:02:35.87,Default,,0,0,0,,請務必幫忙
Dialogue: 0,0:02:35.87,0:02:37.50,Default,,0,0,0,,我拒絕
Dialogue: 1,0:02:37.50,0:02:40.75,Default2,,0,0,0,,這種程度的輕微犯罪
Dialogue: 0,0:02:37.50,0:02:40.75,Default,,0,0,0,,叫警察處理就好了
Dialogue: 0,0:02:40.75,0:02:42.66,Default,,0,0,0,,不過 那位亂塗鴉
Dialogue: 1,0:02:42.66,0:02:47.45,Default2,,0,0,0,,自稱是Mr.微笑的犯人
Dialogue: 0,0:02:42.66,0:02:47.45,Default,,0,0,0,,他的個性實在太強大了
Dialogue: 0,0:02:47.45,0:02:49.04,Default,,0,0,0,,個性太強大了
Dialogue: 0,0:02:49.04,0:02:51.00,Default,,0,0,0,,他擁有什麼樣的個性
Dialogue: 0,0:02:51.00,0:02:53.37,Default,,0,0,0,,只要看到Mr.微笑的臉之後
Dialogue: 0,0:02:53.37,0:02:55.16,Default,,0,0,0,,不知道為什麼
Dialogue: 0,0:02:55.16,0:02:58.16,Default,,0,0,0,,就會突然開始大笑 笑到無法自拔
Dialogue: 0,0:02:58.16,0:02:59.75,Default,,0,0,0,,到底是什麼情況
Dialogue: 1,0:02:59.75,0:03:03.91,Default2,,0,0,0,,看到他的人會捧腹大笑 笑到頭昏
Dialogue: 0,0:02:59.75,0:03:03.91,Default,,0,0,0,,而且程度是嚴重到站不起來那種
Dialogue: 1,0:03:03.91,0:03:07.33,Default2,,0,0,0,,不僅這樣
Dialogue: 0,0:03:03.91,0:03:07.33,Default,,0,0,0,,效果還會持續兩個小時之久
Dialogue: 0,0:03:07.33,0:03:09.37,Default,,0,0,0,,就算想要逮捕Mr.微笑
Dialogue: 0,0:03:09.37,0:03:12.04,Default,,0,0,0,,也會被他害得發笑 讓他揚長而去
Dialogue: 0,0:03:16.25,0:03:17.50,Default,,0,0,0,,我知道了
Dialogue: 1,0:03:17.50,0:03:21.50,Default2,,0,0,0,,下次巡邏的時候
Dialogue: 0,0:03:17.50,0:03:21.50,Default,,0,0,0,,我會注意那個亂塗鴉的犯人
Dialogue: 0,0:03:21.50,0:03:23.29,Default,,0,0,0,,那麼就萬事拜託了
Dialogue: 0,0:03:25.57,0:03:27.07,Default,,0,0,0,,真是的
Dialogue: 0,0:03:27.07,0:03:29.95,Default,,0,0,0,,為什麼把這麼無聊的事件推給我
Dialogue: 0,0:03:29.95,0:03:32.25,Default,,0,0,0,,不過 他畫的塗鴉還真醜
Dialogue: 1,0:03:32.25,0:03:35.75,Default2,,0,0,0,,所以這個藝術恐怖分子
Dialogue: 0,0:03:32.25,0:03:35.75,Default,,0,0,0,,自以為是班克斯嗎
Dialogue: 0,0:03:35.75,0:03:38.95,Default,,0,0,0,,會強制讓對手大笑不止嗎…
Dialogue: 0,0:03:38.95,0:03:42.70,Default,,0,0,0,,他的個性跟Ms.笑話很像呢
Dialogue: 0,0:03:43.54,0:03:45.16,Default,,0,0,0,,只要盡量不要看犯人的臉
Dialogue: 0,0:03:45.16,0:03:47.29,Default,,0,0,0,,然後逮捕他就可以了對嗎
Dialogue: 0,0:03:47.29,0:03:50.79,Default,,0,0,0,,你們這群廢物 別這麼認真討論啦
Dialogue: 0,0:03:50.79,0:03:52.54,Default,,0,0,0,,我會先回家一陣子
Dialogue: 0,0:03:52.54,0:03:54.16,Default,,0,0,0,,就麻煩你們去巡邏了
Dialogue: 0,0:03:54.16,0:03:55.57,Default,,0,0,0,,收到
Dialogue: 0,0:04:00.91,0:04:03.16,Default,,0,0,0,,要我們協助逮捕這種輕罪犯啊
Dialogue: 0,0:04:03.16,0:04:07.00,Default,,0,0,0,,No.1英雄啊 你被人家瞧不起了呢
Dialogue: 0,0:04:07.00,0:04:08.37,Default,,0,0,0,,就是啊
Dialogue: 1,0:04:09.12,0:04:14.37,Default2,,0,0,0,,光是超常解放戰線的事
Dialogue: 0,0:04:09.12,0:04:14.37,Default,,0,0,0,,就已經夠讓人頭痛了
Dialogue: 0,0:04:25.95,0:04:28.08,Default,,0,0,0,,這…這個是…
Dialogue: 0,0:04:34.95,0:04:37.00,Default,,0,0,0,,我饒不了他
Dialogue: 0,0:04:42.12,0:04:43.95,Default,,0,0,0,,安德瓦
Dialogue: 0,0:04:43.95,0:04:48.00,Default,,0,0,0,,(就像在地獄一樣笑吧)
Dialogue: 1,0:04:48.87,0:04:52.08,Default2,,0,0,0,,我要動員所有人
Dialogue: 0,0:04:48.87,0:04:52.08,Default,,0,0,0,,逮捕那個什麼叫Mr.微笑的
Dialogue: 0,0:04:52.08,0:04:54.12,Default,,0,0,0,,得意忘形的塗鴉犯
Dialogue: 0,0:04:54.12,0:04:55.15,Default,,0,0,0,,聽到沒
Dialogue: 0,0:04:55.15,0:04:56.62,Default,,0,0,0,,收到
Dialogue: 0,0:04:57.62,0:04:59.79,Default,,0,0,0,,安德瓦是怎麼了啊
Dialogue: 0,0:04:59.79,0:05:02.37,Default,,0,0,0,,我們家的牆壁好像被亂塗鴉了
Dialogue: 0,0:05:02.37,0:05:03.54,Default,,0,0,0,,根本是私怨嘛
Dialogue: 0,0:05:03.54,0:05:04.91,Default,,0,0,0,,給我閉嘴
Dialogue: 0,0:05:04.91,0:05:06.12,Default,,0,0,0,,這裡是B小隊
Dialogue: 1,0:05:06.12,0:05:09.16,Default2,,0,0,0,,我們發現了塗鴉犯
Dialogue: 0,0:05:06.12,0:05:09.16,Default,,0,0,0,,現在就立刻逮捕他
Dialogue: 0,0:05:09.16,0:05:10.12,Default,,0,0,0,,我們走
Dialogue: 0,0:05:10.12,0:05:11.54,Default,,0,0,0,,收到
Dialogue: 0,0:05:15.33,0:05:17.62,Default,,0,0,0,,他應該就在這附近才對…
Dialogue: 0,0:05:19.16,0:05:20.58,Default,,0,0,0,,這個聲音是…
Dialogue: 0,0:05:26.50,0:05:28.00,Default,,0,0,0,,你們振作一點
Dialogue: 0,0:05:30.95,0:05:32.45,Default,,0,0,0,,你們分頭去找犯人
Dialogue: 0,0:05:32.45,0:05:33.87,Default,,0,0,0,,收到
Dialogue: 0,0:05:48.62,0:05:51.00,Default,,0,0,0,,那個人看起來就很可疑
Dialogue: 0,0:05:53.54,0:05:55.33,Default,,0,0,0,,那邊那個人…
Dialogue: 0,0:05:55.33,0:05:57.62,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:06:07.16,0:06:08.33,Default,,0,0,0,,笨久
Dialogue: 0,0:06:09.95,0:06:11.50,Default,,0,0,0,,就是他嗎
Dialogue: 0,0:06:11.50,0:06:13.91,Default,,0,0,0,,從背後動手的話就不會看到他的臉了
Dialogue: 0,0:06:13.91,0:06:15.95,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:06:25.08,0:06:27.54,Default,,0,0,0,,這狡猾的死敵人
Dialogue: 0,0:06:28.75,0:06:31.87,Default,,0,0,0,,吃我這招…穿甲彈
Dialogue: 0,0:06:33.25,0:06:34.83,Default,,0,0,0,,怎麼樣
Dialogue: 0,0:06:35.40,0:06:37.50,Default,,0,0,0,,Mr.微笑
Dialogue: 1,0:06:55.20,0:06:58.20,Default2,,0,0,0,,看來只要保持這樣的距離
Dialogue: 0,0:06:55.20,0:06:58.20,Default,,0,0,0,,他的個性就起不了作用
Dialogue: 0,0:06:59.29,0:07:02.37,Default,,0,0,0,,這裡是焦凍 我已經逮捕塗鴉犯了
Dialogue: 0,0:07:05.16,0:07:07.41,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:07:13.87,0:07:14.91,Default,,0,0,0,,焦凍
Dialogue: 0,0:07:15.83,0:07:17.33,Default,,0,0,0,,犯人呢
Dialogue: 0,0:07:20.16,0:07:21.95,Default,,0,0,0,,被他逃走了啊…
Dialogue: 0,0:07:23.83,0:07:26.95,Default,,0,0,0,,我的名字叫作Mr.微笑…
Dialogue: 0,0:07:26.95,0:07:29.50,Default,,0,0,0,,是四處流浪的天才藝術家
Dialogue: 1,0:07:29.50,0:07:34.20,Default2,,0,0,0,,聚集在美術界的
Dialogue: 0,0:07:29.50,0:07:34.20,Default,,0,0,0,,都是一群不認同我才華的無能廢物
Dialogue: 0,0:07:34.20,0:07:36.58,Default,,0,0,0,,為了讓世界看見我的作品
Dialogue: 0,0:07:36.58,0:07:39.00,Default,,0,0,0,,見識到什麼叫作真正的藝術
Dialogue: 1,0:07:39.00,0:07:43.45,Default2,,0,0,0,,我這個孤傲的天才
Dialogue: 0,0:07:39.00,0:07:43.45,Default,,0,0,0,,才日以繼夜地不斷持續創作
Dialogue: 0,0:07:43.45,0:07:45.20,Default,,0,0,0,,乖乖束手就擒吧
Dialogue: 0,0:07:45.20,0:07:47.15,Default,,0,0,0,,Mr.微笑
Dialogue: 1,0:07:50.62,0:07:55.04,Default2,,0,0,0,,沒有任何一個人
Dialogue: 0,0:07:50.62,0:07:55.04,Default,,0,0,0,,可以妨礙我進行創作
Dialogue: 0,0:07:56.25,0:07:59.20,Default,,0,0,0,,沒錯 誰都不能…
Dialogue: 0,0:08:02.29,0:08:05.41,Default,,0,0,0,,(兩小時後)
Dialogue: 0,0:08:08.95,0:08:12.75,Default,,0,0,0,,我饒不了你 Mr.微笑
Dialogue: 0,0:08:12.75,0:08:14.87,Default,,0,0,0,,一定要殺爆那傢伙
Dialogue: 0,0:08:14.87,0:08:17.58,Default,,0,0,0,,我在大眾面前丟臉丟大了
Dialogue: 0,0:08:17.58,0:08:20.54,Default,,0,0,0,,幸好我沒有把臉露出來
Dialogue: 0,0:08:20.54,0:08:22.83,Default,,0,0,0,,Mr.微笑…
Dialogue: 0,0:08:22.83,0:08:25.08,Default,,0,0,0,,他的個性實在太驚人了
Dialogue: 0,0:08:25.08,0:08:26.12,Default,,0,0,0,,是啊
Dialogue: 1,0:08:26.12,0:08:29.00,Default2,,0,0,0,,就算只看影像
Dialogue: 0,0:08:26.12,0:08:29.00,Default,,0,0,0,,也會被他的個性影響
Dialogue: 1,0:08:29.00,0:08:33.70,Default2,,0,0,0,,如果他出現在電視上的話
Dialogue: 0,0:08:29.00,0:08:33.70,Default,,0,0,0,,會引起很大的騷動
Dialogue: 0,0:08:33.70,0:08:36.53,Default,,0,0,0,,到底要怎麼做才有辦法逮到他呢
Dialogue: 0,0:08:36.53,0:08:39.15,Default,,0,0,0,,也只能靠我冰凍跟安德瓦的火焰
Dialogue: 0,0:08:39.15,0:08:41.87,Default,,0,0,0,,對他發動遠距離攻擊了吧
Dialogue: 1,0:08:41.87,0:08:45.95,Default2,,0,0,0,,但如果在人潮洶湧的地方
Dialogue: 0,0:08:41.87,0:08:45.95,Default,,0,0,0,,這麼做又會破壞街道
Dialogue: 1,0:08:45.95,0:08:50.37,Default2,,0,0,0,,得想個辦法在
Dialogue: 0,0:08:45.95,0:08:50.37,Default,,0,0,0,,不笑出來的情況下接近他
Dialogue: 0,0:08:50.37,0:08:51.70,Default,,0,0,0,,對了…
Dialogue: 1,0:08:54.04,0:08:57.62,Default2,,0,0,0,,後勤科回應呼叫
Dialogue: 0,0:08:54.04,0:08:57.62,Default,,0,0,0,,前來支援囉 我是發目明
Dialogue: 1,0:08:57.62,0:09:00.70,Default2,,0,0,0,,聽說你們希望我們
Dialogue: 0,0:08:57.62,0:09:00.70,Default,,0,0,0,,出借自律型機器人
Dialogue: 0,0:09:00.70,0:09:03.00,Default,,0,0,0,,是的 工程機器人老師
Dialogue: 1,0:09:03.00,0:09:06.16,Default2,,0,0,0,,因為犯人個性的關係
Dialogue: 0,0:09:03.00,0:09:06.16,Default,,0,0,0,,沒辦法輕易接近他
Dialogue: 1,0:09:06.16,0:09:09.08,Default2,,0,0,0,,我也預料到這點
Dialogue: 0,0:09:06.16,0:09:09.08,Default,,0,0,0,,所以就準備了這個
Dialogue: 1,0:09:10.33,0:09:13.33,Default2,,0,0,0,,這是我跟工程機器人老師
Dialogue: 0,0:09:10.33,0:09:13.33,Default,,0,0,0,,製作的壓箱寶寶貝
Dialogue: 0,0:09:13.33,0:09:14.58,Default,,0,0,0,,捕捉機器人
Dialogue: 0,0:09:14.58,0:09:16.87,Default,,0,0,0,,是我第280個孩子喔
Dialogue: 0,0:09:18.00,0:09:20.50,Default,,0,0,0,,請你多多指教了
Dialogue: 0,0:09:21.45,0:09:24.00,Default,,0,0,0,,這種玩意能有什麼幫助嗎
Dialogue: 0,0:09:27.87,0:09:29.45,Default,,0,0,0,,搞什麼你這臭東西
Dialogue: 0,0:09:29.45,0:09:32.16,Default,,0,0,0,,這只是性能實驗 愚蠢的人類
Dialogue: 0,0:09:32.16,0:09:33.79,Default,,0,0,0,,你說什麼 該死的東西
Dialogue: 0,0:09:33.79,0:09:34.95,Default,,0,0,0,,真是對不起
Dialogue: 0,0:09:34.95,0:09:36.41,Default,,0,0,0,,這下你們都見識到了吧
Dialogue: 1,0:09:36.41,0:09:39.75,Default2,,0,0,0,,我的寶貝可以用這種方式
Dialogue: 0,0:09:36.41,0:09:39.75,Default,,0,0,0,,抓到犯人喔
Dialogue: 0,0:09:39.75,0:09:41.45,Default,,0,0,0,,很厲害
Dialogue: 0,0:09:41.45,0:09:43.91,Default,,0,0,0,,請問可以把這個機器人借給我們嗎
Dialogue: 0,0:09:43.91,0:09:45.00,Default,,0,0,0,,當然可以
Dialogue: 0,0:09:45.00,0:09:46.95,Default,,0,0,0,,我們就是為了這個目的才帶它來的
Dialogue: 0,0:09:47.70,0:09:50.16,Default,,0,0,0,,D小隊這邊發現Mr.微笑了
Dialogue: 0,0:09:50.16,0:09:51.70,Default,,0,0,0,,綠谷
Dialogue: 0,0:09:51.70,0:09:53.66,Default,,0,0,0,,拜託你囉 機器人小弟
Dialogue: 0,0:09:54.58,0:09:56.33,Default,,0,0,0,,請交給我處理
Dialogue: 0,0:10:07.29,0:10:09.08,Default,,0,0,0,,你還不快點住手
Dialogue: 0,0:10:09.08,0:10:11.16,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:10:13.79,0:10:17.00,Default,,0,0,0,,請你們不要來妨礙我進行藝術創作
Dialogue: 0,0:10:21.50,0:10:24.87,Default,,0,0,0,,捕捉噴射網的射程大約是五公尺…
Dialogue: 0,0:10:24.87,0:10:27.16,Default,,0,0,0,,拜託了 機器人小弟…
Dialogue: 0,0:10:32.00,0:10:32.87,Default,,0,0,0,,就是現在
Dialogue: 0,0:10:33.87,0:10:35.75,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:10:44.50,0:10:45.41,Default,,0,0,0,,機器人小弟
Dialogue: 0,0:10:45.41,0:10:46.91,Default,,0,0,0,,這…怎麼可能
Dialogue: 0,0:10:46.91,0:10:49.54,Default,,0,0,0,,那傢伙的個性對機器人也有用
Dialogue: 0,0:10:50.79,0:10:52.79,Default,,0,0,0,,我要加倍奉還幹掉你
Dialogue: 0,0:10:53.91,0:10:55.75,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:11:01.08,0:11:02.12,Default,,0,0,0,,爆豪
Dialogue: 0,0:11:03.25,0:11:05.08,Default,,0,0,0,,先預測對手的位置
Dialogue: 0,0:11:05.08,0:11:06.54,Default,,0,0,0,,再使出爆碎風
Dialogue: 0,0:11:08.62,0:11:10.25,Default,,0,0,0,,快來人啊
Dialogue: 0,0:11:10.25,0:11:11.66,Default,,0,0,0,,快點救救我
Dialogue: 0,0:11:11.66,0:11:13.54,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:11:19.54,0:11:20.79,Default,,0,0,0,,綠谷
Dialogue: 0,0:11:21.45,0:11:23.29,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:11:36.08,0:11:37.29,Default,,0,0,0,,(我的英雄學院)
Dialogue: 0,0:11:37.29,0:11:40.00,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:11:40.00,0:11:44.00,Default,,0,0,0,,(我的英雄學院)
Dialogue: 0,0:11:44.91,0:11:46.37,Default,,0,0,0,,該死的
Dialogue: 0,0:11:46.37,0:11:47.75,Default,,0,0,0,,我一定要把那個傢伙燒成灰
Dialogue: 1,0:11:47.75,0:11:49.70,Default2,,0,0,0,,-他死定了
Dialogue: 0,0:11:47.75,0:11:49.70,Default,,0,0,0,,-你先冷靜一下
Dialogue: 0,0:11:51.20,0:11:53.95,Default,,0,0,0,,我跟老師心愛的寶貝啊
Dialogue: 1,0:11:53.95,0:11:56.87,Default2,,0,0,0,,拜託妳不要用這種
Dialogue: 0,0:11:53.95,0:11:56.87,Default,,0,0,0,,會引人誤會的說法
Dialogue: 0,0:11:56.87,0:11:58.16,Default,,0,0,0,,老師
Dialogue: 0,0:11:58.16,0:12:01.66,Default,,0,0,0,,為什麼機器人也會被個性影響呢
Dialogue: 1,0:12:01.66,0:12:05.37,Default2,,0,0,0,,我想 或許是機器人
Dialogue: 0,0:12:01.66,0:12:05.37,Default,,0,0,0,,以圖像辨識那個Mr.微笑的臉之後
Dialogue: 0,0:12:05.37,0:12:08.25,Default,,0,0,0,,其中的迴路因此被影響了
Dialogue: 1,0:12:08.25,0:12:12.45,Default2,,0,0,0,,從它的感應功能全部壞掉這點
Dialogue: 0,0:12:08.25,0:12:12.45,Default,,0,0,0,,可以佐證這個猜測
Dialogue: 1,0:12:12.45,0:12:16.04,Default2,,0,0,0,,總之
Dialogue: 0,0:12:12.45,0:12:16.04,Default,,0,0,0,,最好就當作機器派不上用場吧
Dialogue: 0,0:12:16.04,0:12:17.41,Default,,0,0,0,,怎麼會…
Dialogue: 0,0:12:17.41,0:12:18.41,Default,,0,0,0,,這樣吧
Dialogue: 1,0:12:18.41,0:12:20.70,Default2,,0,0,0,,就發射麻醉槍之類的東西
Dialogue: 0,0:12:18.41,0:12:20.70,Default,,0,0,0,,放倒他好了
Dialogue: 0,0:12:20.70,0:12:22.83,Default,,0,0,0,,怎麼能採用這麼不英雄的行動…
Dialogue: 0,0:12:22.83,0:12:24.54,Default,,0,0,0,,那就用火箭一擊給他下去
Dialogue: 0,0:12:24.54,0:12:26.12,Default,,0,0,0,,這樣更不行啦
Dialogue: 0,0:12:26.12,0:12:27.16,Default,,0,0,0,,既然這樣
Dialogue: 0,0:12:27.16,0:12:29.83,Default,,0,0,0,,也只能請相澤老師消除他的個性了
Dialogue: 0,0:12:29.83,0:12:32.70,Default,,0,0,0,,現在老師正在照顧壞理
Dialogue: 1,0:12:32.70,0:12:35.70,Default2,,0,0,0,,沒必要為了這種小事件
Dialogue: 0,0:12:32.70,0:12:35.70,Default,,0,0,0,,特地把他叫來吧
Dialogue: 0,0:12:35.70,0:12:37.87,Default,,0,0,0,,叫我們來就可以嗎
Dialogue: 0,0:12:37.87,0:12:39.04,Default,,0,0,0,,爆豪
Dialogue: 0,0:12:39.04,0:12:40.20,Default,,0,0,0,,幹嘛啦
Dialogue: 1,0:12:40.20,0:12:42.75,Default2,,0,0,0,,你可以閉著眼睛
Dialogue: 0,0:12:40.20,0:12:42.75,Default,,0,0,0,,按照我的指示行動嗎
Dialogue: 0,0:12:42.75,0:12:44.00,Default,,0,0,0,,當然可以
Dialogue: 0,0:12:44.00,0:12:45.33,Default,,0,0,0,,跟我來
Dialogue: 0,0:12:48.95,0:12:51.70,Default,,0,0,0,,把眼睛閉起來 是嗎
Dialogue: 0,0:12:52.95,0:12:55.12,Default,,0,0,0,,Mr.微笑…
Dialogue: 1,0:12:55.12,0:12:58.41,Default2,,0,0,0,,他的個性明明就強到
Dialogue: 0,0:12:55.12,0:12:58.41,Default,,0,0,0,,可以成為英雄的
Dialogue: 0,0:12:58.41,0:13:00.95,Default,,0,0,0,,為什麼要在牆壁上亂塗鴉呢
Dialogue: 0,0:13:00.95,0:13:03.45,Default,,0,0,0,,(搜查對象)(微笑真治郎)
Dialogue: 0,0:13:03.45,0:13:08.54,Default,,0,0,0,,Mr.微笑 本名是微笑真治郎
Dialogue: 0,0:13:08.54,0:13:12.62,Default,,0,0,0,,28歲 自稱是藝術家
Dialogue: 1,0:13:12.62,0:13:17.50,Default2,,0,0,0,,雖然在國高中時期大量發表作品
Dialogue: 0,0:13:12.62,0:13:17.50,Default,,0,0,0,,卻得不到任何賞識
Dialogue: 0,0:13:17.50,0:13:19.91,Default,,0,0,0,,也沒考上美術大學
Dialogue: 1,0:13:19.91,0:13:26.00,Default2,,0,0,0,,在那之後就開始四處流浪
Dialogue: 0,0:13:19.91,0:13:26.00,Default,,0,0,0,,持續在牆壁上亂塗鴉…是嗎
Dialogue: 0,0:13:28.54,0:13:31.41,Default,,0,0,0,,就算沒有個性 也能夠成為英雄嗎
Dialogue: 0,0:13:32.87,0:13:34.83,Default,,0,0,0,,即使是沒有個性的人
Dialogue: 0,0:13:35.79,0:13:38.20,Default,,0,0,0,,也能成為像你一樣的人嗎
Dialogue: 0,0:13:43.33,0:13:45.66,Default,,0,0,0,,原來他還沒辦法放棄
Dialogue: 0,0:13:48.33,0:13:51.08,Default,,0,0,0,,就像那個時候的我一樣
Dialogue: 0,0:13:51.08,0:13:53.95,Default,,0,0,0,,持續在尋找可能性
Dialogue: 0,0:14:03.37,0:14:05.04,Default,,0,0,0,,我把人給帶來了
Dialogue: 0,0:14:06.79,0:14:08.79,Default,,0,0,0,,我們想再麻煩你做一件事
Dialogue: 0,0:14:08.79,0:14:11.04,Default,,0,0,0,,事成後再平分 可以吧
Dialogue: 0,0:14:11.04,0:14:12.95,Default,,0,0,0,,那當然了
Dialogue: 0,0:14:12.95,0:14:15.12,Default,,0,0,0,,我們就好好大撈一筆吧
Dialogue: 0,0:14:15.12,0:14:16.54,Default,,0,0,0,,好喔
Dialogue: 0,0:14:24.95,0:14:29.25,Default,,0,0,0,,A3 B2 G9
Dialogue: 0,0:14:30.04,0:14:33.66,Default,,0,0,0,,A2 E3 Y7
Dialogue: 0,0:14:33.66,0:14:36.16,Default,,0,0,0,,C2 D1
Dialogue: 0,0:14:36.16,0:14:37.70,Default,,0,0,0,,E4
Dialogue: 0,0:14:38.95,0:14:40.54,Default,,0,0,0,,爆破
Dialogue: 0,0:14:43.37,0:14:46.50,Default,,0,0,0,,你學習的速度比我預料的快很多嘛
Dialogue: 1,0:14:46.50,0:14:49.83,Default2,,0,0,0,,就說了
Dialogue: 0,0:14:46.50,0:14:49.83,Default,,0,0,0,,我根本就不需要什麼練習吧
Dialogue: 0,0:14:54.04,0:14:55.33,Default,,0,0,0,,你在做什麼
Dialogue: 0,0:14:55.33,0:14:58.25,Default,,0,0,0,,我看你從昨天起就一直泡在電腦前
Dialogue: 0,0:14:58.25,0:15:00.54,Default,,0,0,0,,我認為先別想著要抓住Mr.微笑
Dialogue: 0,0:15:00.54,0:15:04.04,Default,,0,0,0,,應該先阻止他在牆上塗鴉
Dialogue: 0,0:15:04.04,0:15:04.87,Default,,0,0,0,,你看看這個
Dialogue: 1,0:15:04.87,0:15:05.70,Default2,,0,0,0,,(歡迎光臨Mr.微笑的微笑畫廊)
Dialogue: 0,0:15:04.87,0:15:05.70,Default,,0,0,0,,(大家好 歡迎來到微笑畫廊)
Dialogue: 1,0:15:05.70,0:15:08.70,Default2,,0,0,0,,(以下是他的作品)
Dialogue: 0,0:15:05.70,0:15:08.70,Default,,0,0,0,,這是我請電腦很強的上鳴教我做的
Dialogue: 0,0:15:12.87,0:15:15.45,Default,,0,0,0,,老實說 我對藝術實在一竅不通
Dialogue: 0,0:15:16.25,0:15:18.25,Default,,0,0,0,,我想問 這些作品很棒嗎
Dialogue: 0,0:15:20.25,0:15:22.33,Default,,0,0,0,,我也不知道
Dialogue: 0,0:15:22.33,0:15:23.50,Default,,0,0,0,,不過…
Dialogue: 1,0:15:23.50,0:15:26.91,Default2,,0,0,0,,我覺得對他本人來說
Dialogue: 0,0:15:23.50,0:15:26.91,Default,,0,0,0,,每一幅應該很重要吧
Dialogue: 0,0:15:27.91,0:15:31.66,Default,,0,0,0,,這裡是C小隊 我們發現Mr.微笑了
Dialogue: 0,0:15:31.66,0:15:32.70,Default,,0,0,0,,在哪裡
Dialogue: 0,0:15:32.70,0:15:34.91,Default,,0,0,0,,是以前遭到塗鴉的商業大樓
Dialogue: 0,0:15:34.91,0:15:37.62,Default,,0,0,0,,這次他好像選在室內塗鴉
Dialogue: 0,0:15:37.62,0:15:39.12,Default,,0,0,0,,綠谷 該怎麼辦
Dialogue: 0,0:15:39.12,0:15:40.20,Default,,0,0,0,,如果沒有什麼對策的話
Dialogue: 0,0:15:40.20,0:15:42.33,Default,,0,0,0,,肯定又會像之前那樣被他撂倒
Dialogue: 0,0:15:42.33,0:15:44.95,Default,,0,0,0,,可是 我們也不能因為這樣就不去
Dialogue: 0,0:15:57.12,0:15:59.20,Default,,0,0,0,,我們明明就離他很近了…
Dialogue: 1,0:15:59.20,0:16:03.45,Default2,,0,0,0,,要是又不用大腦就衝出去
Dialogue: 0,0:15:59.20,0:16:03.45,Default,,0,0,0,,肯定會淪為眾人的笑柄
Dialogue: 0,0:16:05.16,0:16:07.20,Default,,0,0,0,,綠谷 該怎麼辦
Dialogue: 0,0:16:07.20,0:16:10.20,Default,,0,0,0,,總之 我先再試探看看他的能力吧
Dialogue: 0,0:16:12.45,0:16:15.04,Default,,0,0,0,,Mr.微笑先生
Dialogue: 0,0:16:15.04,0:16:17.87,Default,,0,0,0,,我覺得這幅作品完成後會很棒呢
Dialogue: 1,0:16:19.12,0:16:23.08,Default2,,0,0,0,,懂得欣賞藝術的少年
Dialogue: 0,0:16:19.12,0:16:23.08,Default,,0,0,0,,非常謝謝你啊
Dialogue: 0,0:16:23.08,0:16:25.00,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:16:26.91,0:16:27.87,Default,,0,0,0,,果然沒錯
Dialogue: 0,0:16:27.87,0:16:29.79,Default,,0,0,0,,只要閉上眼睛就沒問題了
Dialogue: 1,0:16:29.79,0:16:33.54,Default2,,0,0,0,,這樣安德瓦跟爆豪的戰策
Dialogue: 0,0:16:29.79,0:16:33.54,Default,,0,0,0,,應該就能順利進行
Dialogue: 0,0:16:33.54,0:16:34.54,Default,,0,0,0,,是啊
Dialogue: 0,0:16:35.41,0:16:37.50,Default,,0,0,0,,抱歉啊 微笑
Dialogue: 0,0:16:39.95,0:16:42.08,Default,,0,0,0,,爆豪 準備好了嗎
Dialogue: 0,0:16:42.08,0:16:43.29,Default,,0,0,0,,包在我身上
Dialogue: 0,0:16:43.29,0:16:46.25,Default,,0,0,0,,事不過三 我不會再中招的
Dialogue: 0,0:16:46.25,0:16:48.70,Default,,0,0,0,,好 上吧 A8
Dialogue: 0,0:16:51.20,0:16:52.58,Default,,0,0,0,,哎呀哎呀…
Dialogue: 0,0:16:52.58,0:16:55.87,Default,,0,0,0,,又有人要來妨礙我進行創作了嗎
Dialogue: 0,0:16:55.87,0:16:57.95,Default,,0,0,0,,真是位放肆的少年
Dialogue: 0,0:16:58.50,0:17:00.75,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:17:02.50,0:17:04.50,Default,,0,0,0,,他竟然沒有微笑
Dialogue: 0,0:17:04.50,0:17:07.04,Default,,0,0,0,,A2 E3 Y7
Dialogue: 0,0:17:10.16,0:17:13.20,Default,,0,0,0,,C2 D1 E4
Dialogue: 0,0:17:14.25,0:17:17.41,Default,,0,0,0,,B1 E5 X2
Dialogue: 0,0:17:17.41,0:17:19.16,Default,,0,0,0,,去死吧
Dialogue: 0,0:17:20.57,0:17:22.04,Default,,0,0,0,,小勝等一下
Dialogue: 0,0:17:22.04,0:17:24.07,Default,,0,0,0,,少命令我了 臭笨…
Dialogue: 0,0:17:24.79,0:17:25.82,Default,,0,0,0,,糟糕
Dialogue: 0,0:17:25.82,0:17:27.86,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:17:35.66,0:17:38.16,Default,,0,0,0,,小勝 對不起了
Dialogue: 0,0:17:43.70,0:17:46.08,Default,,0,0,0,,為什麼…要保護我…
Dialogue: 1,0:17:46.08,0:17:49.75,Default2,,0,0,0,,不對 你剛才
Dialogue: 0,0:17:46.08,0:17:49.75,Default,,0,0,0,,為什麼要保護我的作品
Dialogue: 0,0:17:50.50,0:17:52.83,Default,,0,0,0,,雖然我沒辦法理解
Dialogue: 1,0:17:52.83,0:17:57.95,Default2,,0,0,0,,但我想這幅插畫應該對你非常重要
Dialogue: 0,0:17:52.83,0:17:57.95,Default,,0,0,0,,所以才會這麼做
Dialogue: 0,0:17:59.91,0:18:01.04,Default,,0,0,0,,不過
Dialogue: 1,0:18:01.04,0:18:04.25,Default2,,0,0,0,,在別人名下的建築
Dialogue: 0,0:18:01.04,0:18:04.25,Default,,0,0,0,,進行塗鴉的這個行為
Dialogue: 0,0:18:04.25,0:18:06.41,Default,,0,0,0,,已經觸犯了輕犯罪法了
Dialogue: 0,0:18:07.70,0:18:09.75,Default,,0,0,0,,如果你這麼看重自己的作品
Dialogue: 0,0:18:09.75,0:18:12.50,Default,,0,0,0,,就請你在正當的平台上發表吧
Dialogue: 0,0:18:13.75,0:18:17.62,Default,,0,0,0,,持續創作一些沒有人要觀賞的作品
Dialogue: 0,0:18:17.62,0:18:19.83,Default,,0,0,0,,真的非常空虛
Dialogue: 0,0:18:19.83,0:18:22.25,Default,,0,0,0,,即使如此 我還是不希望你放棄
Dialogue: 0,0:18:24.08,0:18:26.70,Default,,0,0,0,,因為我也跟你一樣
Dialogue: 0,0:18:26.70,0:18:29.54,Default,,0,0,0,,大家都說我不可能成為英雄
Dialogue: 0,0:18:29.54,0:18:32.08,Default,,0,0,0,,但我還是沒有就此放棄
Dialogue: 1,0:18:32.08,0:18:35.62,Default2,,0,0,0,,更借助了許多人的力量
Dialogue: 0,0:18:32.08,0:18:35.62,Default,,0,0,0,,成為了一名英雄
Dialogue: 0,0:18:37.25,0:18:41.04,Default,,0,0,0,,微笑先生 請你不要輕易放棄
Dialogue: 0,0:18:41.04,0:18:43.12,Default,,0,0,0,,我會助你一臂之力的
Dialogue: 0,0:18:44.25,0:18:46.08,Default,,0,0,0,,少年…
Dialogue: 0,0:18:47.91,0:18:49.29,Default,,0,0,0,,是啊
Dialogue: 0,0:18:49.29,0:18:52.75,Default,,0,0,0,,我以為自己這麼做是在對抗美術界
Dialogue: 0,0:18:52.75,0:18:56.04,Default,,0,0,0,,不過 或許我只是在逃避罷了
Dialogue: 0,0:18:56.04,0:18:58.12,Default,,0,0,0,,微笑先生
Dialogue: 0,0:19:05.79,0:19:07.00,Default,,0,0,0,,是強盜嗎
Dialogue: 0,0:19:08.58,0:19:10.12,Default,,0,0,0,,怎麼偏偏挑現在
Dialogue: 0,0:19:15.20,0:19:15.95,Default,,0,0,0,,你沒事吧
Dialogue: 0,0:19:15.95,0:19:17.37,Default,,0,0,0,,轟同學
Dialogue: 0,0:19:19.45,0:19:23.29,Default,,0,0,0,,我的…作品被…
Dialogue: 0,0:19:25.37,0:19:26.37,Default,,0,0,0,,把東西吸出來
Dialogue: 0,0:19:26.37,0:19:27.91,Default,,0,0,0,,好
Dialogue: 0,0:19:30.79,0:19:33.37,Default,,0,0,0,,安德瓦 其中一個搶匪是店員
Dialogue: 1,0:19:34.25,0:19:38.12,Default2,,0,0,0,,如果想保住市民的小命
Dialogue: 0,0:19:34.25,0:19:38.12,Default,,0,0,0,,就乖乖在一邊咬手指吧
Dialogue: 0,0:19:38.12,0:19:40.20,Default,,0,0,0,,趁他被轉移注意力時行動吧
Dialogue: 0,0:19:40.20,0:19:41.04,Default,,0,0,0,,好
Dialogue: 0,0:19:41.04,0:19:42.20,Default,,0,0,0,,你們先等一下
Dialogue: 0,0:19:44.37,0:19:47.04,Default,,0,0,0,,這件事就交給我來處理吧
Dialogue: 0,0:19:47.04,0:19:48.79,Default,,0,0,0,,這太危險了 微笑先生
Dialogue: 1,0:19:48.79,0:19:53.16,Default2,,0,0,0,,他們毀了我偉大的藝術作品
Dialogue: 0,0:19:48.79,0:19:53.16,Default,,0,0,0,,那麼他們…
Dialogue: 0,0:19:54.91,0:19:57.08,Default,,0,0,0,,就應該接受相應的懲罰
Dialogue: 0,0:19:57.08,0:19:58.50,Default,,0,0,0,,你是誰啊 你
Dialogue: 0,0:19:58.50,0:19:59.54,Default,,0,0,0,,趁現在
Dialogue: 0,0:20:01.95,0:20:03.37,Default,,0,0,0,,去死吧
Dialogue: 0,0:20:05.08,0:20:08.75,Default,,0,0,0,,噢 奇蹟微笑
Dialogue: 0,0:20:17.41,0:20:19.45,Default,,0,0,0,,微笑先生
Dialogue: 0,0:20:21.25,0:20:23.83,Default,,0,0,0,,Mr.微笑 也就是微笑真治郎
Dialogue: 0,0:20:23.83,0:20:25.25,Default,,0,0,0,,個性 微笑
Dialogue: 0,0:20:25.25,0:20:26.91,Default,,0,0,0,,讓別人看到自己的笑臉之後
Dialogue: 1,0:20:26.91,0:20:30.12,Default2,,0,0,0,,不管對象是誰
Dialogue: 0,0:20:26.91,0:20:30.12,Default,,0,0,0,,都會持續大笑兩個小時
Dialogue: 1,0:20:30.12,0:20:33.79,Default2,,0,0,0,,只要是即時收看
Dialogue: 0,0:20:30.12,0:20:33.79,Default,,0,0,0,,不管是透過鏡子或是螢幕都有效果
Dialogue: 1,0:20:33.79,0:20:36.95,Default2,,0,0,0,,中招的人一定會
Dialogue: 0,0:20:33.79,0:20:36.95,Default,,0,0,0,,捧腹大笑 笑甲反過
Dialogue: 0,0:20:37.75,0:20:40.20,Default,,0,0,0,,你的個性果然非常厲害
Dialogue: 0,0:20:40.20,0:20:42.54,Default,,0,0,0,,如果可以成為英雄的話就好了
Dialogue: 0,0:20:42.54,0:20:45.04,Default,,0,0,0,,我很不擅長跟人打鬥
Dialogue: 1,0:20:46.33,0:20:50.00,Default2,,0,0,0,,總之 未來我會再次
Dialogue: 0,0:20:46.33,0:20:50.00,Default,,0,0,0,,向美術界發起挑戰的
Dialogue: 0,0:20:50.00,0:20:53.70,Default,,0,0,0,,但在那之前 我得先贖罪才可以呢
Dialogue: 0,0:20:58.00,0:21:00.45,Default,,0,0,0,,打倒遭到全國通緝的犯人的人
Dialogue: 0,0:21:00.45,0:21:01.75,Default,,0,0,0,,就是你對吧
Dialogue: 1,0:21:01.75,0:21:05.20,Default2,,0,0,0,,現在在進行現場轉播
Dialogue: 0,0:21:01.75,0:21:05.20,Default,,0,0,0,,請發表一下感想
Dialogue: 0,0:21:05.20,0:21:08.45,Default,,0,0,0,,我是個不成材的天才藝術家
Dialogue: 0,0:21:08.45,0:21:10.41,Default,,0,0,0,,名字就叫 沒錯
Dialogue: 0,0:21:10.41,0:21:12.41,Default,,0,0,0,,Mr.微笑
Dialogue: 0,0:21:13.04,0:21:25.91,Default,,0,0,0,,Mr.微笑…
Dialogue: 0,0:21:25.91,0:21:33.16,Default,,0,0,0,,微笑 微笑 微笑 一直微笑
Dialogue: 0,0:21:36.45,0:21:39.58,Default,,0,0,0,,或許這則報導成為了一個契機
Dialogue: 0,0:21:39.58,0:21:43.87,Default,,0,0,0,,Mr.微笑的作品透過網頁
Dialogue: 0,0:21:43.87,0:21:47.41,Default,,0,0,0,,獲得了許多大眾的認可
Dialogue: 0,0:21:47.41,0:21:49.87,Default,,0,0,0,,不過 這又是另一件事了

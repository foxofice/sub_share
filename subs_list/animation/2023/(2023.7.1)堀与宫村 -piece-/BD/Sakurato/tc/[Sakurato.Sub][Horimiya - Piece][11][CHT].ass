Comment: 0,0:22:29.03,0:22:32.12,EDJP - 1,,0,0,0,,{\pos(724.571,222.857)\c&HFFFFFF&\3c&H000000&}增田利嘉
Comment: 0,0:22:29.03,0:22:32.12,EDJP - 1,,0,0,0,,荒野に忍ぶ黒い影
Comment: 0,0:22:32.12,0:22:35.16,EDJP - 1,,0,0,0,,光を宿すその刃
Comment: 0,0:22:35.16,0:22:38.21,EDJP - 1,,0,0,0,,守るは孤独戦場に
Comment: 0,0:22:38.21,0:22:41.29,EDJP - 1,,0,0,0,,姿　暗ます
Comment: 0,0:22:41.29,0:22:47.13,EDJP - 1,,0,0,0,,今宵も百鬼の供物で
Comment: 0,0:22:47.13,0:22:48.40,EDJP - 1,,0,0,0,,微か
Comment: 0,0:22:48.40,0:22:49.88,EDJP - 1,,0,0,0,,五月雨
Comment: 0,0:22:49.88,0:22:52.89,EDJP - 1,,0,0,0,,枝垂れ柳から
Comment: 0,0:22:52.89,0:22:55.60,EDJP - 1,,0,0,0,,篝火
Comment: 0,0:22:55.60,0:22:59.30,EDJP - 1,,0,0,0,,己の信じる戦いを
Comment: 0,0:22:59.30,0:23:02.90,EDJP - 1,,0,0,0,,争いのない極楽へと
Comment: 0,0:23:02.90,0:23:05.61,EDJP - 1,,0,0,0,,望みを重ねて
Comment: 0,0:23:05.61,0:23:08.32,EDJP - 1,,0,0,0,,風に散るは
Comment: 0,0:23:08.32,0:23:11.32,EDJP - 1,,0,0,0,,コノハ
Comment: 0,0:23:11.32,0:23:14.84,EDJP - 1,,0,0,0,,己の信じる戦いを
Comment: 0,0:23:14.84,0:23:18.27,EDJP - 1,,0,0,0,,争いのない極楽へと
Comment: 0,0:23:18.27,0:23:21.21,EDJP - 1,,0,0,0,,笑うがいいさと
Comment: 0,0:23:21.21,0:23:23.58,EDJP - 1,,0,0,0,,生きる我は
Comment: 0,0:23:23.58,0:23:27.21,EDJP - 1,,0,0,0,,{\fad(0,1700)\pos(400,1080)}コノハ
Comment: 0,0:22:29.03,0:22:32.12,EDCH - 1,,0,0,0,,潛藏於荒野的暗影
Comment: 0,0:22:32.12,0:22:35.16,EDCH - 1,,0,0,0,,寄宿著光芒的利刃
Comment: 0,0:22:35.16,0:22:38.21,EDCH - 1,,0,0,0,,獨自守護這片戰場
Comment: 0,0:22:38.21,0:22:41.29,EDCH - 1,,0,0,0,,隱去身姿
Comment: 0,0:22:41.29,0:22:47.13,EDCH - 1,,0,0,0,,今夜也將是百鬼夜行
Comment: 0,0:22:47.13,0:22:48.40,EDCH - 1,,0,0,0,,些微
Comment: 0,0:22:48.40,0:22:49.88,EDCH - 1,,0,0,0,,細雨
Comment: 0,0:22:49.88,0:22:52.89,EDCH - 1,,0,0,0,,招搖的柳枝間
Comment: 0,0:22:52.89,0:22:55.60,EDCH - 1,,0,0,0,,燃起焰火
Comment: 0,0:22:55.60,0:22:59.30,EDCH - 1,,0,0,0,,為了信念拚命戰鬥
Comment: 0,0:22:59.30,0:23:02.90,EDCH - 1,,0,0,0,,向著和平的淨土
Comment: 0,0:23:02.90,0:23:05.61,EDCH - 1,,0,0,0,,載上這希望
Comment: 0,0:23:05.61,0:23:08.32,EDCH - 1,,0,0,0,,飄蕩而去的是我
Comment: 0,0:23:08.32,0:23:11.32,EDCH - 1,,0,0,0,,木葉
Comment: 0,0:23:11.32,0:23:14.84,EDCH - 1,,0,0,0,,為了信念拚命戰鬥
Comment: 0,0:23:14.84,0:23:18.27,EDCH - 1,,0,0,0,,向著和平的淨土
Comment: 0,0:23:18.27,0:23:21.21,EDCH - 1,,0,0,0,,儘管放聲大笑
Comment: 0,0:23:21.21,0:23:23.58,EDCH - 1,,0,0,0,,活在當下的正是我
Comment: 0,0:23:23.58,0:23:27.21,EDCH - 1,,0,0,0,,{\fad(0,1700)\pos(400,5)}木葉

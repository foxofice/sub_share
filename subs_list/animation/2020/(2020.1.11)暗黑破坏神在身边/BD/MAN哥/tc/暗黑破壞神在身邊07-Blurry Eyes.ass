Dialogue: 0,0:00:03.32,0:00:05.68,Default,,0,0,0,,（熱狗）
Dialogue: 0,0:00:05.72,0:00:08.64,Default,,0,0,0,,（可麗餅，草莓、香蕉\N熱騰騰的豬肉味噌湯）
Dialogue: 0,0:00:11.80,0:00:12.84,Default,,0,0,0,,各位同學
Dialogue: 0,0:00:12.92,0:00:15.28,Default,,0,0,0,,今天就是期待已久的文化祭
Dialogue: 0,0:00:16.08,0:00:17.36,Default,,0,0,0,,你們是怎麼了？
Dialogue: 0,0:00:17.68,0:00:18.80,Default,,0,0,0,,今天開的店
Dialogue: 0,0:00:18.84,0:00:20.96,Default,,0,0,0,,如果賣得好，可是有獎賞的喔
Dialogue: 0,0:00:21.08,0:00:22.56,Default,,0,0,0,,餐飲店部門營業額
Dialogue: 0,0:00:22.60,0:00:24.96,Default,,0,0,0,,跟滿意度調查第一名的班級
Dialogue: 0,0:00:25.00,0:00:26.84,Default,,0,0,0,,能得到慶功費用喔
Dialogue: 0,0:00:27.92,0:00:30.88,Default,,0,0,0,,請問慶功能去唱歌\N或是打保齡球嗎？
Dialogue: 0,0:00:32.16,0:00:33.72,Default,,0,0,0,,不會玩太晚的都可以啊
Dialogue: 0,0:00:33.76,0:00:35.24,Default,,0,0,0,,這是真的嗎？
Dialogue: 0,0:00:35.72,0:00:37.72,Default,,0,0,0,,- 看我的\N- 放開我，快點放開
Dialogue: 0,0:00:37.76,0:00:39.32,Default,,0,0,0,,一起努力吧，老師
Dialogue: 0,0:00:39.36,0:00:41.68,Default,,0,0,0,,好啊，月宮，你會幫忙嗎？
Dialogue: 0,0:00:42.00,0:00:43.52,Default,,0,0,0,,那個突然的幹勁是怎樣？
Dialogue: 0,0:00:44.04,0:00:45.80,Default,,0,0,0,,我只有不好的預感
Dialogue: 0,0:01:00.96,0:01:05.36,Default,,0,0,0,,（暗黑破壞神在身邊）
Dialogue: 0,0:01:06.24,0:01:08.28,Default,,0,0,0,,（回顧過往）
Dialogue: 0,0:01:08.76,0:01:12.12,Default,,0,0,0,,（那時我過著乏味的生活）
Dialogue: 0,0:01:14.16,0:01:16.00,Default,,0,0,0,,（不知為何，總覺得今天）
Dialogue: 0,0:01:16.76,0:01:20.12,Default,,0,0,0,,（會成為很棒的一天\N不禁面露微笑）
Dialogue: 0,0:01:20.20,0:01:23.88,Default,,0,0,0,,（彷彿要被遺留在）
Dialogue: 0,0:01:23.96,0:01:28.20,Default,,0,0,0,,（妄想與現實的間隙中）
Dialogue: 0,0:01:28.28,0:01:32.72,Default,,0,0,0,,（即便不帥氣或快崩潰）
Dialogue: 0,0:01:32.80,0:01:36.36,Default,,0,0,0,,（我都不想隱瞞）
Dialogue: 0,0:01:36.44,0:01:38.32,Default,,0,0,0,,（我想要更多的機會）
Dialogue: 0,0:01:38.40,0:01:40.68,Default,,0,0,0,,（必須繼續前進）
Dialogue: 0,0:01:40.76,0:01:44.56,Default,,0,0,0,,（不用勉強改變自己）
Dialogue: 0,0:01:44.64,0:01:46.16,Default,,0,0,0,,（必須感受光明）
Dialogue: 0,0:01:46.24,0:01:48.68,Default,,0,0,0,,（你看，陽光普照）
Dialogue: 0,0:01:48.76,0:01:53.28,Default,,0,0,0,,（我們就這樣做自己就好）
Dialogue: 0,0:01:59.52,0:02:01.52,Default,,0,0,0,,（必須繼續，現在必須繼續）
Dialogue: 0,0:02:04.04,0:02:06.68,Default,,0,0,0,,（若還能微笑的話）
Dialogue: 0,0:02:06.76,0:02:11.32,Default,,0,0,0,,（天空就是哈利路亞）
Dialogue: 0,0:02:16.52,0:02:18.24,Default,,0,0,0,,好了，盛大開店
Dialogue: 0,0:02:18.80,0:02:20.96,Default,,0,0,0,,日式咖啡店，煉獄茶屋
Dialogue: 0,0:02:21.00,0:02:21.88,Default,,0,0,0,,先等一下
Dialogue: 0,0:02:22.08,0:02:23.44,Default,,0,0,0,,為什麼取這種名字？
Dialogue: 0,0:02:24.24,0:02:25.92,Default,,0,0,0,,阿芹怎麼還沒換衣服？
Dialogue: 0,0:02:26.00,0:02:27.36,Default,,0,0,0,,客人都要來了
Dialogue: 0,0:02:27.84,0:02:29.84,Default,,0,0,0,,不對，我是內場的人
Dialogue: 0,0:02:29.88,0:02:31.72,Default,,0,0,0,,怎麼可能讓你做內場呢？
Dialogue: 0,0:02:31.84,0:02:34.00,Default,,0,0,0,,快點，動作快點，快點
Dialogue: 0,0:02:35.28,0:02:37.28,Default,,0,0,0,,為…為什麼只有我？
Dialogue: 0,0:02:37.32,0:02:39.36,Default,,0,0,0,,好適合您，小雪吉大人
Dialogue: 0,0:02:39.56,0:02:43.12,Default,,0,0,0,,請您讓在下承受\N那個風車的吹氣之刑吧
Dialogue: 0,0:02:43.16,0:02:45.84,Default,,0,0,0,,制裁的時刻來臨了\N蓋修提伯，走吧
Dialogue: 0,0:02:45.88,0:02:47.04,Default,,0,0,0,,要弄你們自己去弄
Dialogue: 0,0:02:47.20,0:02:48.80,Default,,0,0,0,,你們兩個聽好了
Dialogue: 0,0:02:49.00,0:02:51.52,Default,,0,0,0,,花鳥，你想跟阿芹唱二重唱
Dialogue: 0,0:02:51.56,0:02:53.76,Default,,0,0,0,,讓他想起過去的羈絆，對吧？
Dialogue: 0,0:02:54.08,0:02:55.08,Default,,0,0,0,,最上這邊呢
Dialogue: 0,0:02:55.12,0:02:58.20,Default,,0,0,0,,想要讓阿芹用保齡球\N砸成兩半，對吧？
Dialogue: 0,0:02:58.52,0:03:00.08,Default,,0,0,0,,那麼要做的事只有一件
Dialogue: 0,0:03:00.12,0:03:03.64,Default,,0,0,0,,不擇手段\N拚命爭取獲得班級第一名
Dialogue: 0,0:03:04.96,0:03:06.68,Default,,0,0,0,,他們在團結一心什麼？
Dialogue: 0,0:03:06.76,0:03:08.60,Default,,0,0,0,,他們在圖謀什麼？好可怕
Dialogue: 0,0:03:09.04,0:03:11.80,Default,,0,0,0,,不管事情怎樣發展\N都讓人很有壓力
Dialogue: 0,0:03:12.08,0:03:13.84,Default,,0,0,0,,能不能找到空隙逃走啊？
Dialogue: 0,0:03:13.88,0:03:14.76,Default,,0,0,0,,營業中嗎？
Dialogue: 0,0:03:14.92,0:03:17.28,Default,,0,0,0,,好想看澄楚同學戴貓耳
Dialogue: 0,0:03:17.64,0:03:21.04,Default,,0,0,0,,阿芹，客人來了喔，歡迎光臨
Dialogue: 0,0:03:23.08,0:03:24.92,Default,,0,0,0,,久等了，特製艾草丸…
Dialogue: 0,0:03:27.12,0:03:28.00,Default,,0,0,0,,怎麼了？
Dialogue: 0,0:03:28.76,0:03:29.72,Default,,0,0,0,,花鳥
Dialogue: 0,0:03:29.92,0:03:31.76,Default,,0,0,0,,手汗…
Dialogue: 0,0:03:31.80,0:03:32.76,Default,,0,0,0,,- 什麼？\N- 等等
Dialogue: 0,0:03:34.00,0:03:34.88,Default,,0,0,0,,什麼？
Dialogue: 0,0:03:39.04,0:03:40.64,Default,,0,0,0,,兩位客人，不好意思
Dialogue: 0,0:03:40.76,0:03:43.00,Default,,0,0,0,,讓我幫你們換一個乾淨的盤子
Dialogue: 0,0:03:43.40,0:03:46.44,Default,,0,0,0,,為了道歉\N我們還附上這個蓮花餐巾喔
Dialogue: 0,0:03:47.16,0:03:48.40,Default,,0,0,0,,- 好厲害喔\N- 他做了什麼？
Dialogue: 0,0:03:48.52,0:03:50.04,Default,,0,0,0,,那到底是什麼神技？
Dialogue: 0,0:03:50.20,0:03:52.32,Default,,0,0,0,,好，要越賺越多
Dialogue: 0,0:03:53.80,0:03:56.56,Default,,0,0,0,,（奶油紅豆蜜、抹茶迷你聖代）
Dialogue: 0,0:03:56.84,0:04:00.24,Default,,0,0,0,,前輩們這裡有好多\N看起來很美味的食物呢
Dialogue: 0,0:04:00.68,0:04:01.68,Default,,0,0,0,,希里烏斯
Dialogue: 0,0:04:01.72,0:04:02.76,Default,,0,0,0,,你來啦
Dialogue: 0,0:04:03.40,0:04:04.80,Default,,0,0,0,,小響，歡迎光臨
Dialogue: 0,0:04:05.00,0:04:06.72,Default,,0,0,0,,我已經等你好久了
Dialogue: 0,0:04:07.92,0:04:10.32,Default,,0,0,0,,來吧，貴賓席還空著喔
Dialogue: 0,0:04:11.56,0:04:12.60,Default,,0,0,0,,歡迎光臨
Dialogue: 0,0:04:12.88,0:04:14.16,Default,,0,0,0,,這是冰水、濕毛巾
Dialogue: 0,0:04:14.20,0:04:15.12,Default,,0,0,0,,這是菜單
Dialogue: 0,0:04:15.16,0:04:16.40,Default,,0,0,0,,您可以慢慢參考
Dialogue: 0,0:04:16.44,0:04:17.96,Default,,0,0,0,,請您選喜歡的吧
Dialogue: 0,0:04:19.16,0:04:22.68,Default,,0,0,0,,受到這樣的歡迎\N我真的覺得好開心喔
Dialogue: 0,0:04:22.96,0:04:25.00,Default,,0,0,0,,我要店裡的推薦商品
Dialogue: 0,0:04:25.04,0:04:26.60,Default,,0,0,0,,全都是推薦商品
Dialogue: 0,0:04:27.24,0:04:29.08,Default,,0,0,0,,這邊全部各來一份
Dialogue: 0,0:04:29.16,0:04:30.24,Default,,0,0,0,,- 好\N- 好
Dialogue: 0,0:04:30.44,0:04:33.40,Default,,0,0,0,,這位客人，總計金額是14萬元
Dialogue: 0,0:04:33.44,0:04:34.44,Default,,0,0,0,,可以嗎？
Dialogue: 0,0:04:34.60,0:04:35.96,Default,,0,0,0,,- 怎麼可能可以\N- 開玩笑的
Dialogue: 0,0:04:36.00,0:04:37.84,Default,,0,0,0,,- 開玩笑的啦\N- 這個價錢是怎麼算出來的啊？
Dialogue: 0,0:04:37.96,0:04:40.28,Default,,0,0,0,,- 他嚇到都動不了了\N- 小響…
Dialogue: 0,0:04:40.32,0:04:42.16,Default,,0,0,0,,不要用惡劣手段賺學弟的錢
Dialogue: 0,0:04:42.56,0:04:46.08,Default,,0,0,0,,- 謝謝你們的招待\N- 抱歉…
Dialogue: 0,0:04:47.28,0:04:50.36,Default,,0,0,0,,- 像我這種人…\N- 小響
Dialogue: 0,0:04:50.52,0:04:52.32,Default,,0,0,0,,如果傳出什麼不好的流言
Dialogue: 0,0:04:52.36,0:04:53.60,Default,,0,0,0,,就不用慶功了喔
Dialogue: 0,0:04:55.40,0:04:56.56,Default,,0,0,0,,什麼嘛
Dialogue: 0,0:04:56.64,0:04:59.08,Default,,0,0,0,,其實阿芹也很認真經營啊
Dialogue: 0,0:04:59.12,0:05:00.00,Default,,0,0,0,,才沒有
Dialogue: 0,0:05:00.72,0:05:01.88,Default,,0,0,0,,可以進去嗎？
Dialogue: 0,0:05:02.88,0:05:03.80,Default,,0,0,0,,不好意思
Dialogue: 0,0:05:03.84,0:05:05.72,Default,,0,0,0,,請坐裡面的座位
Dialogue: 0,0:05:05.76,0:05:09.24,Default,,0,0,0,,真是的\N小密你不是說一定是歐風的嗎？
Dialogue: 0,0:05:09.28,0:05:11.32,Default,,0,0,0,,我們的服裝太不搭了
Dialogue: 0,0:05:12.20,0:05:14.24,Default,,0,0,0,,我…是竹田
Dialogue: 0,0:05:14.44,0:05:17.88,Default,,0,0,0,,竹田小密時宗是也，初次見面
Dialogue: 0,0:05:18.00,0:05:18.92,Default,,0,0,0,,你是誰啊？
Dialogue: 0,0:05:18.96,0:05:21.24,Default,,0,0,0,,小密又是什麼啊？是客串才對吧
Dialogue: 0,0:05:21.52,0:05:23.44,Default,,0,0,0,,我知道你是死亡公牛的成員
Dialogue: 0,0:05:23.68,0:05:26.36,Default,,0,0,0,,那是怎樣？難道是打算偽裝嗎？
Dialogue: 0,0:05:26.84,0:05:28.88,Default,,0,0,0,,今天又是特地來看花鳥的嗎？
Dialogue: 0,0:05:29.68,0:05:31.20,Default,,0,0,0,,普通的說話不行嗎？
Dialogue: 0,0:05:33.00,0:05:34.76,Default,,0,0,0,,為您送上冰水、濕毛巾
Dialogue: 0,0:05:40.04,0:05:41.68,Default,,0,0,0,,請您慢慢參考
Dialogue: 0,0:05:44.00,0:05:44.96,Default,,0,0,0,,什麼？
Dialogue: 0,0:05:46.56,0:05:48.56,Default,,0,0,0,,糟糕，剛剛吃螺絲了
Dialogue: 0,0:05:48.76,0:05:49.92,Default,,0,0,0,,放錯重點了吧
Dialogue: 0,0:05:50.24,0:05:52.68,Default,,0,0,0,,原來如此，他根本沒發現那個人
Dialogue: 0,0:05:53.08,0:05:55.00,Default,,0,0,0,,他明明對花鳥這麼執著
Dialogue: 0,0:05:55.28,0:05:56.20,Default,,0,0,0,,真可憐
Dialogue: 0,0:05:56.28,0:05:57.60,Default,,0,0,0,,米蓋爾…
Dialogue: 0,0:05:58.20,0:06:01.72,Default,,0,0,0,,完全看不出我這是跟他\N開過狂熱演唱會的人
Dialogue: 0,0:06:01.84,0:06:05.00,Default,,0,0,0,,沒想到他現在的敏銳度也變差了
Dialogue: 0,0:06:05.28,0:06:07.60,Default,,0,0,0,,我們變裝不就是為了這個嗎？
Dialogue: 0,0:06:08.00,0:06:09.00,Default,,0,0,0,,這位客人
Dialogue: 0,0:06:09.08,0:06:10.88,Default,,0,0,0,,我們店的艾草丸子
Dialogue: 0,0:06:10.92,0:06:14.32,Default,,0,0,0,,全部都是花鳥\N親手精心揉製而成的
Dialogue: 0,0:06:14.84,0:06:17.72,Default,,0,0,0,,要變好吃喔…
Dialogue: 0,0:06:18.80,0:06:20.76,Default,,0,0,0,,你們要不要來一份呢？
Dialogue: 0,0:06:21.04,0:06:24.12,Default,,0,0,0,,送上來吧，這些我全都要了
Dialogue: 0,0:06:25.16,0:06:27.28,Default,,0,0,0,,米蓋爾親手揉製的每一樣東西
Dialogue: 0,0:06:27.32,0:06:29.04,Default,,0,0,0,,只要有我在…
Dialogue: 0,0:06:29.36,0:06:32.76,Default,,0,0,0,,我會全部吞進這個身體裡的
Dialogue: 0,0:06:32.80,0:06:33.92,Default,,0,0,0,,謝謝光臨
Dialogue: 0,0:06:34.40,0:06:36.40,Default,,0,0,0,,有勇氣說出這麼丟臉的話
Dialogue: 0,0:06:36.56,0:06:38.08,Default,,0,0,0,,不如直接相認就好了
Dialogue: 0,0:06:38.92,0:06:39.80,Default,,0,0,0,,小雪
Dialogue: 0,0:06:40.52,0:06:41.56,Default,,0,0,0,,有營業嗎？
Dialogue: 0,0:06:42.16,0:06:43.36,Default,,0,0,0,,要喝杯茶再走嗎？
Dialogue: 0,0:06:43.64,0:06:44.52,Default,,0,0,0,,我不要
Dialogue: 0,0:06:44.88,0:06:46.20,Default,,0,0,0,,好像有奇怪的客人
Dialogue: 0,0:06:47.84,0:06:50.28,Default,,0,0,0,,先不說這個，你來我們班一下吧
Dialogue: 0,0:06:50.80,0:06:54.36,Default,,0,0,0,,聽說是很準的哥德蘿莉塔\N女高中生算命咖啡廳
Dialogue: 0,0:06:54.76,0:06:55.88,Default,,0,0,0,,就是這樣
Dialogue: 0,0:06:56.04,0:06:58.96,Default,,0,0,0,,在下必須接受小雪吉大人的處罰
Dialogue: 0,0:06:59.12,0:07:01.72,Default,,0,0,0,,但是溫柔的大人拒絕處罰我
Dialogue: 0,0:07:02.08,0:07:03.52,Default,,0,0,0,,我該怎麼辦呢？
Dialogue: 0,0:07:03.72,0:07:06.32,Default,,0,0,0,,什麼？你突然問這些幹嘛啊？
Dialogue: 0,0:07:08.32,0:07:10.16,Default,,0,0,0,,你還是沒變呢，哥哥
Dialogue: 0,0:07:10.20,0:07:13.40,Default,,0,0,0,,我建議你還是趴下\N當小雪芹的椅子吧
Dialogue: 0,0:07:13.44,0:07:15.28,Default,,0,0,0,,這是什麼建議…什麼？哥哥
Dialogue: 0,0:07:17.12,0:07:19.68,Default,,0,0,0,,我記得最上的妹妹跟他是雙胞胎
Dialogue: 0,0:07:20.04,0:07:21.96,Default,,0,0,0,,難道就是她嗎？
Dialogue: 0,0:07:22.28,0:07:24.44,Default,,0,0,0,,可是我好像之前在哪裡見過
Dialogue: 0,0:07:30.84,0:07:33.20,Default,,0,0,0,,你請妹妹算命\N怎麼會跟不認識一樣？
Dialogue: 0,0:07:33.24,0:07:34.24,Default,,0,0,0,,是我妹妹
Dialogue: 0,0:07:34.28,0:07:35.76,Default,,0,0,0,,哥哥的眼力真差啊
Dialogue: 0,0:07:35.96,0:07:38.68,Default,,0,0,0,,小雪芹，我還記得你
Dialogue: 0,0:07:41.20,0:07:42.60,Default,,0,0,0,,寫生大賽那天
Dialogue: 0,0:07:43.16,0:07:45.52,Default,,0,0,0,,你來不及去廁所大哭的樣子
Dialogue: 0,0:07:45.84,0:07:47.68,Default,,0,0,0,,我全部都畫下來了
Dialogue: 0,0:07:48.88,0:07:51.24,Default,,0,0,0,,兄妹挖苦的方式都一樣，別說了
Dialogue: 0,0:07:51.60,0:07:54.40,Default,,0,0,0,,你們特地來找我有什麼事嗎？
Dialogue: 0,0:07:54.64,0:07:56.72,Default,,0,0,0,,那個…是什麼？什麼事呢？
Dialogue: 0,0:07:56.76,0:07:59.08,Default,,0,0,0,,你的店獲得第一名我們會很困擾
Dialogue: 0,0:07:59.12,0:08:00.76,Default,,0,0,0,,所以我們來踢館了
Dialogue: 0,0:08:01.16,0:08:02.88,Default,,0,0,0,,這裡是算命咖啡館
Dialogue: 0,0:08:03.68,0:08:06.16,Default,,0,0,0,,所以我要用算命一決勝負
Dialogue: 0,0:08:06.20,0:08:07.12,Default,,0,0,0,,你在說什麼啊？
Dialogue: 0,0:08:07.24,0:08:09.60,Default,,0,0,0,,我也會算命而且不需要道具
Dialogue: 0,0:08:09.80,0:08:12.00,Default,,0,0,0,,我只要聽宇宙的聲音就好
Dialogue: 0,0:08:12.12,0:08:15.36,Default,,0,0,0,,所有會發生的事\N都是宇宙注定好的
Dialogue: 0,0:08:15.56,0:08:17.16,Default,,0,0,0,,我只是看著他們發生
Dialogue: 0,0:08:17.96,0:08:20.64,Default,,0,0,0,,你做的其實不是真正的算命
Dialogue: 0,0:08:20.68,0:08:22.80,Default,,0,0,0,,而是近距離仔細觀察人
Dialogue: 0,0:08:22.84,0:08:24.84,Default,,0,0,0,,所得到的知識跟研究
Dialogue: 0,0:08:25.24,0:08:27.40,Default,,0,0,0,,那個卡片也是裝飾的吧？
Dialogue: 0,0:08:28.20,0:08:30.52,Default,,0,0,0,,怎麼樣啊？最上鈴蘭同學
Dialogue: 0,0:08:31.92,0:08:32.80,Default,,0,0,0,,然後呢？
Dialogue: 0,0:08:33.04,0:08:36.12,Default,,0,0,0,,難道你想用這個理由\N威脅我關店嗎？
Dialogue: 0,0:08:36.16,0:08:37.04,Default,,0,0,0,,不對
Dialogue: 0,0:08:37.08,0:08:39.76,Default,,0,0,0,,請你來我們店裡消費一次吧
Dialogue: 0,0:08:40.60,0:08:43.32,Default,,0,0,0,,月宮到底在想什麼啊？
Dialogue: 0,0:08:43.60,0:08:46.04,Default,,0,0,0,,難道你打算在茶裡下毒嗎？
Dialogue: 0,0:08:46.84,0:08:48.72,Default,,0,0,0,,我觀察了同年級的人
Dialogue: 0,0:08:48.92,0:08:52.40,Default,,0,0,0,,得到跟月宮宇津木\N不要有瓜葛比較好的結論
Dialogue: 0,0:08:52.44,0:08:53.36,Default,,0,0,0,,正確
Dialogue: 0,0:08:54.92,0:08:57.64,Default,,0,0,0,,可是你要過來也是命中注定
Dialogue: 0,0:08:58.04,0:08:59.96,Default,,0,0,0,,只要看我的眼睛你就知道
Dialogue: 0,0:09:06.52,0:09:07.36,Default,,0,0,0,,眼睛？
Dialogue: 0,0:09:08.28,0:09:10.72,Default,,0,0,0,,沒錯，看我的眼睛
Dialogue: 0,0:09:14.28,0:09:15.80,Default,,0,0,0,,乖孩子
Dialogue: 0,0:09:20.76,0:09:21.84,Default,,0,0,0,,最上同學
Dialogue: 0,0:09:21.88,0:09:22.84,Default,,0,0,0,,妹妹，你怎麼了？
Dialogue: 0,0:09:22.88,0:09:24.60,Default,,0,0,0,,等一下，月宮你做了什麼？
Dialogue: 0,0:09:24.88,0:09:26.80,Default,,0,0,0,,她只是暫時昏倒而已
Dialogue: 0,0:09:26.84,0:09:28.40,Default,,0,0,0,,所以說你做了什麼？
Dialogue: 0,0:09:29.00,0:09:30.88,Default,,0,0,0,,剛剛月宮的眼睛是不是睜開了？
Dialogue: 0,0:09:30.92,0:09:33.52,Default,,0,0,0,,阿芹，安靜點，計畫會被發現喔
Dialogue: 0,0:09:34.40,0:09:36.44,Default,,0,0,0,,（獎狀，第一名）
Dialogue: 0,0:09:38.00,0:09:39.44,Default,,0,0,0,,第一名
Dialogue: 0,0:09:39.52,0:09:41.52,Default,,0,0,0,,大家表現得很好
Dialogue: 0,0:09:41.72,0:09:44.40,Default,,0,0,0,,在那之後，最上同學馬上站起來
Dialogue: 0,0:09:44.44,0:09:45.84,Default,,0,0,0,,說「我要去你們的店」
Dialogue: 0,0:09:45.88,0:09:47.20,Default,,0,0,0,,就沒有再回來了
Dialogue: 0,0:09:47.68,0:09:48.84,Default,,0,0,0,,那到底是？
Dialogue: 0,0:09:48.88,0:09:51.72,Default,,0,0,0,,那是為了獲勝的和平解決對策
Dialogue: 0,0:09:51.76,0:09:53.92,Default,,0,0,0,,該不會是心靈控制之類的？
Dialogue: 0,0:09:54.00,0:09:55.28,Default,,0,0,0,,再怎麼說也不好吧
Dialogue: 0,0:09:55.32,0:09:56.76,Default,,0,0,0,,那不是喔
Dialogue: 0,0:09:58.68,0:10:00.44,Default,,0,0,0,,那是她個人的意志
Dialogue: 0,0:10:00.56,0:10:02.44,Default,,0,0,0,,命中注定的事發生了
Dialogue: 0,0:10:03.20,0:10:05.44,Default,,0,0,0,,那個就是宇宙的指示
Dialogue: 0,0:10:05.52,0:10:06.92,Default,,0,0,0,,感覺很可疑
Dialogue: 0,0:10:07.64,0:10:09.20,Default,,0,0,0,,他居然這麼不擇手段
Dialogue: 0,0:10:09.24,0:10:10.88,Default,,0,0,0,,千萬不能跟他作對
Dialogue: 0,0:10:11.72,0:10:13.36,Default,,0,0,0,,蓋修提伯，你怎麼了？
Dialogue: 0,0:10:13.64,0:10:16.68,Default,,0,0,0,,明明獲勝了\N可是看起來卻不開心
Dialogue: 0,0:10:16.96,0:10:18.60,Default,,0,0,0,,算了啦，我也沒差
Dialogue: 0,0:10:19.36,0:10:20.52,Default,,0,0,0,,只是最後…
Dialogue: 0,0:10:20.84,0:10:23.08,Default,,0,0,0,,還是沒去看澄楚同學的貓耳
Dialogue: 0,0:10:23.44,0:10:24.60,Default,,0,0,0,,心好累啊
Dialogue: 0,0:10:26.40,0:10:29.36,Default,,0,0,0,,這樣啊，蓋修提伯，你很努力了
Dialogue: 0,0:10:29.92,0:10:32.68,Default,,0,0,0,,辛苦你了，乖孩子
Dialogue: 0,0:10:37.64,0:10:39.08,Default,,0,0,0,,蓋修提伯，乖孩…
Dialogue: 0,0:10:39.12,0:10:41.36,Default,,0,0,0,,- 幹嘛要模仿月宮講話啊？\N- 不准你學宇津木大人
Dialogue: 0,0:10:42.20,0:10:44.20,Default,,0,0,0,,鈴蘭，你怎麼在這裡？
Dialogue: 0,0:10:44.68,0:10:45.92,Default,,0,0,0,,宇津木大人
Dialogue: 0,0:10:46.00,0:10:46.92,Default,,0,0,0,,奇怪了
Dialogue: 0,0:10:47.00,0:10:50.28,Default,,0,0,0,,我的催眠應該已經解開了啊
Dialogue: 0,0:10:50.84,0:10:52.04,Default,,0,0,0,,果然就是那樣
Dialogue: 0,0:10:52.16,0:10:54.28,Default,,0,0,0,,我看到了宇宙的指示
Dialogue: 0,0:10:54.64,0:10:56.88,Default,,0,0,0,,就在宇津木大人的眼睛裡
Dialogue: 0,0:10:57.12,0:10:59.60,Default,,0,0,0,,那裡又深又廣，沒有盡頭
Dialogue: 0,0:10:59.68,0:11:01.04,Default,,0,0,0,,萬物都存在那裡
Dialogue: 0,0:11:01.12,0:11:04.20,Default,,0,0,0,,我心中的泥沼也因此轉變成幸福
Dialogue: 0,0:11:04.60,0:11:05.84,Default,,0,0,0,,太稀奇了吧
Dialogue: 0,0:11:06.20,0:11:09.36,Default,,0,0,0,,我妹不太跟人親近\N卻這麼喜歡你，代表…
Dialogue: 0,0:11:09.52,0:11:11.04,Default,,0,0,0,,原來哥哥也在啊
Dialogue: 0,0:11:12.04,0:11:13.24,Default,,0,0,0,,月宮大人
Dialogue: 0,0:11:13.52,0:11:15.92,Default,,0,0,0,,你可以把在下當作哥哥
Dialogue: 0,0:11:17.84,0:11:19.52,Default,,0,0,0,,很少看到月宮這麼困擾
Dialogue: 0,0:11:20.00,0:11:21.80,Default,,0,0,0,,連我都忍不住覺得
Dialogue: 0,0:11:22.00,0:11:24.20,Default,,0,0,0,,就讓他這樣吃點苦頭好了
Dialogue: 0,0:11:26.56,0:11:28.88,Default,,0,0,0,,蓋修提伯，這支麥克風給你
Dialogue: 0,0:11:28.96,0:11:29.88,Default,,0,0,0,,我不去
Dialogue: 0,0:11:31.72,0:11:33.80,Default,,0,0,0,,蓋修提伯
Dialogue: 0,0:11:34.32,0:11:36.00,Default,,0,0,0,,今天是文化祭的慶功宴
Dialogue: 0,0:11:36.28,0:11:37.32,Default,,0,0,0,,蓋修提伯
Dialogue: 0,0:11:37.36,0:11:39.32,Default,,0,0,0,,這是調整喉嚨狀態的糖果
Dialogue: 0,0:11:39.52,0:11:41.16,Default,,0,0,0,,先準備比較好喔
Dialogue: 0,0:11:41.24,0:11:42.80,Default,,0,0,0,,為什麼要這麼認真啊？
Dialogue: 0,0:11:43.52,0:11:45.04,Default,,0,0,0,,好興奮
Dialogue: 0,0:11:45.52,0:11:47.40,Default,,0,0,0,,和蓋修提伯二重唱
Dialogue: 0,0:11:47.44,0:11:50.00,Default,,0,0,0,,米蓋爾的黑暗也能稍微被治癒吧
Dialogue: 0,0:11:50.04,0:11:51.56,Default,,0,0,0,,能讓他用在下專用的罪魂
Dialogue: 0,0:11:51.60,0:11:53.44,Default,,0,0,0,,把我的頭砸成兩半了
Dialogue: 0,0:11:53.76,0:11:55.24,Default,,0,0,0,,你們準備得真周到
Dialogue: 0,0:11:55.72,0:11:58.56,Default,,0,0,0,,想唱歌的話\N找死亡公牛的成員唱啊
Dialogue: 0,0:11:58.88,0:12:00.12,Default,,0,0,0,,奇怪的傢伙
Dialogue: 0,0:12:02.40,0:12:03.36,Default,,0,0,0,,雖然是這樣
Dialogue: 0,0:12:03.44,0:12:06.20,Default,,0,0,0,,可是花鳥\N為什麼這麼愛找我搭話呢？
Dialogue: 0,0:12:06.80,0:12:08.16,Default,,0,0,0,,你看…
Dialogue: 0,0:12:08.20,0:12:09.52,Default,,0,0,0,,阿芹老師
Dialogue: 0,0:12:09.56,0:12:11.52,Default,,0,0,0,,幼稚園生在等你了喔
Dialogue: 0,0:12:11.60,0:12:12.80,Default,,0,0,0,,就說我不去啊
Dialogue: 0,0:12:12.84,0:12:14.72,Default,,0,0,0,,什麼？我還想說你來
Dialogue: 0,0:12:14.76,0:12:17.32,Default,,0,0,0,,我就給你看澄楚同學的貓耳影片
Dialogue: 0,0:12:17.40,0:12:18.68,Default,,0,0,0,,我去就是了
Dialogue: 0,0:12:19.52,0:12:22.56,Default,,0,0,0,,因為這樣，我就衝動的跟去了
Dialogue: 0,0:12:24.24,0:12:25.28,Default,,0,0,0,,最上的妹妹
Dialogue: 0,0:12:25.84,0:12:27.00,Default,,0,0,0,,為什麼她也來了？
Dialogue: 0,0:12:27.84,0:12:30.36,Default,,0,0,0,,為了報復前男友而努力變漂亮
Dialogue: 0,0:12:30.40,0:12:32.52,Default,,0,0,0,,表現出自己很幸福的模樣
Dialogue: 0,0:12:32.56,0:12:35.64,Default,,0,0,0,,這樣就好像是在說\N自己不幸福一樣
Dialogue: 0,0:12:35.68,0:12:36.56,Default,,0,0,0,,不是嗎？
Dialogue: 0,0:12:36.64,0:12:38.00,Default,,0,0,0,,如果真的幸福的話
Dialogue: 0,0:12:38.04,0:12:39.64,Default,,0,0,0,,就不需要這樣表現
Dialogue: 0,0:12:39.96,0:12:42.20,Default,,0,0,0,,我要先說，這不是算命
Dialogue: 0,0:12:42.44,0:12:44.40,Default,,0,0,0,,這都是我觀察出來的
Dialogue: 0,0:12:44.84,0:12:46.24,Default,,0,0,0,,會這麼表現的人
Dialogue: 0,0:12:46.28,0:12:48.68,Default,,0,0,0,,前提都是其實並不幸福
Dialogue: 0,0:12:48.96,0:12:50.00,Default,,0,0,0,,說得對吧？
Dialogue: 0,0:12:50.36,0:12:52.28,Default,,0,0,0,,小雪芹跟他的愉快小伙伴
Dialogue: 0,0:12:52.32,0:12:53.24,Default,,0,0,0,,不要說了
Dialogue: 0,0:12:53.28,0:12:54.96,Default,,0,0,0,,不要把我說成他們的老大
Dialogue: 0,0:12:55.28,0:12:56.96,Default,,0,0,0,,你們兩個在演什麼啊？
Dialogue: 0,0:12:57.12,0:12:58.60,Default,,0,0,0,,宇津木大人在哪裡？
Dialogue: 0,0:12:59.40,0:13:01.56,Default,,0,0,0,,月宮的話應該在那邊…
Dialogue: 0,0:13:01.92,0:13:03.88,Default,,0,0,0,,奇怪，剛剛明明還在啊
Dialogue: 0,0:13:05.00,0:13:06.96,Default,,0,0,0,,宇津木大人告訴我
Dialogue: 0,0:13:07.20,0:13:09.56,Default,,0,0,0,,如果有事找他，要透過你
Dialogue: 0,0:13:09.60,0:13:11.76,Default,,0,0,0,,- 什麼？我沒聽他說啊\N- 請你務必好好傳達
Dialogue: 0,0:13:13.00,0:13:15.84,Default,,0,0,0,,要努力照顧大家喔，阿芹老師
Dialogue: 0,0:13:15.88,0:13:17.08,Default,,0,0,0,,那個混蛋
Dialogue: 0,0:13:17.32,0:13:20.52,Default,,0,0,0,,我想跟宇津木大人\N聊聊關於宇宙的神秘
Dialogue: 0,0:13:20.68,0:13:22.16,Default,,0,0,0,,還有生命的活動
Dialogue: 0,0:13:22.28,0:13:24.08,Default,,0,0,0,,可是他卻馬上消失了
Dialogue: 0,0:13:25.28,0:13:27.92,Default,,0,0,0,,所以你的任務就是幫我找到他
Dialogue: 0,0:13:28.04,0:13:28.96,Default,,0,0,0,,小雪芹
Dialogue: 0,0:13:29.32,0:13:31.32,Default,,0,0,0,,可是我又不知道他在哪裡
Dialogue: 0,0:13:31.88,0:13:32.80,Default,,0,0,0,,對啊
Dialogue: 0,0:13:32.84,0:13:35.60,Default,,0,0,0,,而且蓋修提伯\N要跟我二重唱，對吧？
Dialogue: 0,0:13:35.64,0:13:36.52,Default,,0,0,0,,我不唱
Dialogue: 0,0:13:37.92,0:13:39.28,Default,,0,0,0,,這首歌誰點的啊？
Dialogue: 0,0:13:39.52,0:13:42.60,Default,,0,0,0,,這首歌獻給我的搭檔，蓋修提伯
Dialogue: 0,0:13:43.04,0:13:44.68,Default,,0,0,0,,「永遠是好朋友」
Dialogue: 0,0:13:46.16,0:13:47.60,Default,,0,0,0,,真的有這種歌嗎？
Dialogue: 0,0:13:47.68,0:13:48.88,Default,,0,0,0,,不要唱了
Dialogue: 0,0:13:49.04,0:13:50.36,Default,,0,0,0,,蓋修提伯
Dialogue: 0,0:13:50.44,0:13:51.80,Default,,0,0,0,,你也一起唱嘛
Dialogue: 0,0:13:51.84,0:13:52.76,Default,,0,0,0,,別說了
Dialogue: 0,0:13:52.80,0:13:53.84,Default,,0,0,0,,唱嘛…
Dialogue: 0,0:13:54.00,0:13:55.76,Default,,0,0,0,,蓋修提伯，你要唱嗎？
Dialogue: 0,0:13:55.80,0:13:56.20,Default,,0,0,0,,來吧
Dialogue: 0,0:13:58.20,0:14:00.40,Default,,0,0,0,,很抱歉，我們有急事
Dialogue: 0,0:14:02.56,0:14:05.52,Default,,0,0,0,,小雪芹現在要跟我\N去找宇津木大人
Dialogue: 0,0:14:05.64,0:14:06.64,Default,,0,0,0,,再見了
Dialogue: 0,0:14:06.96,0:14:08.20,Default,,0,0,0,,等…一下
Dialogue: 0,0:14:08.28,0:14:09.68,Default,,0,0,0,,為什麼大家都抓我的皮帶？
Dialogue: 0,0:14:12.84,0:14:15.00,Default,,0,0,0,,等等，小雪吉大人，對不起
Dialogue: 0,0:14:15.20,0:14:16.96,Default,,0,0,0,,我妹妹的要求太任性了
Dialogue: 0,0:14:17.00,0:14:19.72,Default,,0,0,0,,那是因為哥完全幫不上我的忙啊
Dialogue: 0,0:14:19.76,0:14:20.96,Default,,0,0,0,,說得好過份啊
Dialogue: 0,0:14:22.00,0:14:23.16,Default,,0,0,0,,小雪吉大人
Dialogue: 0,0:14:23.28,0:14:26.56,Default,,0,0,0,,如果像這樣只是嘴上怒罵\N我也可以接受喔
Dialogue: 0,0:14:26.60,0:14:28.00,Default,,0,0,0,,這位哥哥在高興什麼啊？
Dialogue: 0,0:14:28.32,0:14:30.36,Default,,0,0,0,,宇津木大人去哪裡了呢？
Dialogue: 0,0:14:30.72,0:14:31.84,Default,,0,0,0,,一定在館內
Dialogue: 0,0:14:31.88,0:14:33.52,Default,,0,0,0,,蓋修提伯
Dialogue: 0,0:14:33.68,0:14:34.56,Default,,0,0,0,,花鳥
Dialogue: 0,0:14:35.36,0:14:37.44,Default,,0,0,0,,- 唱歌\N- 不要
Dialogue: 0,0:14:37.68,0:14:40.88,Default,,0,0,0,,你不擅長跟女生相處\N可是卻很努力
Dialogue: 0,0:14:40.92,0:14:43.08,Default,,0,0,0,,你沒發現的話，我就告訴你吧
Dialogue: 0,0:14:43.24,0:14:44.24,Default,,0,0,0,,花鳥兜
Dialogue: 0,0:14:44.36,0:14:47.00,Default,,0,0,0,,其實小雪芹非常的討厭你
Dialogue: 0,0:14:47.20,0:14:48.56,Default,,0,0,0,,把你當成笨蛋
Dialogue: 0,0:14:48.72,0:14:50.24,Default,,0,0,0,,他覺得你很麻煩
Dialogue: 0,0:14:50.76,0:14:52.08,Default,,0,0,0,,你這種行為
Dialogue: 0,0:14:52.12,0:14:53.84,Default,,0,0,0,,我不知道你想假裝什麼
Dialogue: 0,0:14:54.00,0:14:56.24,Default,,0,0,0,,如果演不好，最好現在放棄
Dialogue: 0,0:14:56.32,0:14:59.12,Default,,0,0,0,,就算是這樣\N還是想跟他來往的話
Dialogue: 0,0:14:59.16,0:15:01.04,Default,,0,0,0,,最好想一想自己的行為
Dialogue: 0,0:15:01.40,0:15:03.28,Default,,0,0,0,,等一下，最上同學
Dialogue: 0,0:15:06.76,0:15:08.32,Default,,0,0,0,,你不用講得這麼直接吧？
Dialogue: 0,0:15:08.44,0:15:10.12,Default,,0,0,0,,你明明覺得很困擾
Dialogue: 0,0:15:10.28,0:15:11.76,Default,,0,0,0,,卻放任他這樣
Dialogue: 0,0:15:12.00,0:15:13.40,Default,,0,0,0,,是在裝好人嗎？
Dialogue: 0,0:15:13.64,0:15:14.52,Default,,0,0,0,,還是說
Dialogue: 0,0:15:14.76,0:15:16.28,Default,,0,0,0,,你其實不討厭…
Dialogue: 0,0:15:16.64,0:15:18.04,Default,,0,0,0,,當蓋修提伯呢
Dialogue: 0,0:15:18.52,0:15:20.12,Default,,0,0,0,,沒這回事，但是…
Dialogue: 0,0:15:20.76,0:15:23.68,Default,,0,0,0,,館內的男生廁所全部去找一遍
Dialogue: 0,0:15:23.72,0:15:24.64,Default,,0,0,0,,不可能的
Dialogue: 0,0:15:24.76,0:15:26.36,Default,,0,0,0,,如果他真的想逃的話
Dialogue: 0,0:15:26.40,0:15:27.88,Default,,0,0,0,,我們是不可能找得到的
Dialogue: 0,0:15:28.32,0:15:31.96,Default,,0,0,0,,看來你對宇津木大人已經屈服了
Dialogue: 0,0:15:33.24,0:15:34.40,Default,,0,0,0,,最上同學才是
Dialogue: 0,0:15:34.60,0:15:36.96,Default,,0,0,0,,明明說不要跟月宮有瓜葛
Dialogue: 0,0:15:37.80,0:15:38.72,Default,,0,0,0,,對啊
Dialogue: 0,0:15:38.84,0:15:41.56,Default,,0,0,0,,我最討厭那種總是在一邊看好戲
Dialogue: 0,0:15:41.72,0:15:43.24,Default,,0,0,0,,還輕浮笑著的人
Dialogue: 0,0:15:44.28,0:15:46.76,Default,,0,0,0,,直到看了那雙眼睛之後
Dialogue: 0,0:15:47.00,0:15:49.72,Default,,0,0,0,,我了解了那裡面沒有善惡
Dialogue: 0,0:15:49.76,0:15:51.80,Default,,0,0,0,,沒有階級，而是全部
Dialogue: 0,0:15:51.84,0:15:54.00,Default,,0,0,0,,是包容一切的宇宙之心
Dialogue: 0,0:15:54.28,0:15:57.20,Default,,0,0,0,,他會接受沒有價值、最真實的我
Dialogue: 0,0:15:57.60,0:15:59.72,Default,,0,0,0,,他能將我玩弄於股掌之間
Dialogue: 0,0:16:02.28,0:16:03.72,Default,,0,0,0,,只要我一說話
Dialogue: 0,0:16:04.00,0:16:05.88,Default,,0,0,0,,很多人都是這種表情
Dialogue: 0,0:16:06.60,0:16:08.72,Default,,0,0,0,,因為被很有個性的人包圍
Dialogue: 0,0:16:08.76,0:16:11.36,Default,,0,0,0,,心裡覺得很困擾的普通人的表情
Dialogue: 0,0:16:11.76,0:16:13.32,Default,,0,0,0,,如果要我說的話
Dialogue: 0,0:16:13.52,0:16:15.96,Default,,0,0,0,,不要假裝自己是被害者
Dialogue: 0,0:16:16.00,0:16:18.44,Default,,0,0,0,,直接絕交才是為了對方好吧
Dialogue: 0,0:16:19.16,0:16:21.16,Default,,0,0,0,,大家搞錯好人的意思了
Dialogue: 0,0:16:21.32,0:16:23.56,Default,,0,0,0,,小雪芹，我就是在說你
Dialogue: 0,0:16:24.20,0:16:25.24,Default,,0,0,0,,什麼？
Dialogue: 0,0:16:25.60,0:16:28.56,Default,,0,0,0,,可是就算嚴肅拒絕他
Dialogue: 0,0:16:28.68,0:16:30.00,Default,,0,0,0,,他也只會說「好棒」
Dialogue: 0,0:16:30.20,0:16:31.84,Default,,0,0,0,,以為這樣有用他卻哭了
Dialogue: 0,0:16:32.00,0:16:33.56,Default,,0,0,0,,這樣叫裝好人的話…
Dialogue: 0,0:16:34.04,0:16:35.36,Default,,0,0,0,,好像也可以理解
Dialogue: 0,0:16:35.40,0:16:37.92,Default,,0,0,0,,蓋修提伯
Dialogue: 0,0:16:38.00,0:16:40.16,Default,,0,0,0,,那麼，我現在覺得…
Dialogue: 0,0:16:40.56,0:16:41.92,Default,,0,0,0,,你讓我很困擾
Dialogue: 0,0:16:42.12,0:16:43.64,Default,,0,0,0,,我不會再陪你找了
Dialogue: 0,0:16:50.40,0:16:52.00,Default,,0,0,0,,小雪吉大人
Dialogue: 0,0:16:52.16,0:16:53.84,Default,,0,0,0,,再次跟您道歉
Dialogue: 0,0:16:53.92,0:16:55.72,Default,,0,0,0,,我妹妹其實沒有惡意
Dialogue: 0,0:16:55.84,0:16:57.76,Default,,0,0,0,,全部都是在下的錯
Dialogue: 0,0:16:57.80,0:16:59.36,Default,,0,0,0,,請您直接痛罵在下
Dialogue: 0,0:16:59.52,0:17:01.08,Default,,0,0,0,,不用了，沒關係
Dialogue: 0,0:17:01.72,0:17:04.40,Default,,0,0,0,,最上同學說得其實也沒錯
Dialogue: 0,0:17:05.40,0:17:07.64,Default,,0,0,0,,可是到底是為什麼？
Dialogue: 0,0:17:07.96,0:17:09.00,Default,,0,0,0,,鈴蘭嗎？
Dialogue: 0,0:17:09.08,0:17:10.68,Default,,0,0,0,,不是，是花鳥
Dialogue: 0,0:17:11.60,0:17:13.84,Default,,0,0,0,,他為什麼會這麼找上我呢？
Dialogue: 0,0:17:14.92,0:17:17.32,Default,,0,0,0,,一開始他好像以為
Dialogue: 0,0:17:17.36,0:17:19.60,Default,,0,0,0,,我想要有個像他一樣的朋友
Dialogue: 0,0:17:20.88,0:17:23.16,Default,,0,0,0,,月宮又跟他說了前世什麼的
Dialogue: 0,0:17:24.56,0:17:26.12,Default,,0,0,0,,只是因為那樣
Dialogue: 0,0:17:26.20,0:17:29.28,Default,,0,0,0,,他就這麼喜歡我嗎？
Dialogue: 0,0:17:30.56,0:17:32.12,Default,,0,0,0,,明明不是我也可以吧
Dialogue: 0,0:17:33.00,0:17:35.80,Default,,0,0,0,,他應該還有其他更合得來的人
Dialogue: 0,0:17:36.04,0:17:39.32,Default,,0,0,0,,不過就算這樣也不能改變吧
Dialogue: 0,0:17:40.00,0:17:43.92,Default,,0,0,0,,在下倒是有一點了解兜兄的心情
Dialogue: 0,0:17:46.60,0:17:48.08,Default,,0,0,0,,阿芹回來了啊
Dialogue: 0,0:17:48.28,0:17:50.32,Default,,0,0,0,,- 小宇津，再見了\N- 月宮
Dialogue: 0,0:17:50.36,0:17:51.84,Default,,0,0,0,,你怎麼會從隔壁包廂出來？
Dialogue: 0,0:17:51.88,0:17:53.24,Default,,0,0,0,,阿芹，先別管這個了
Dialogue: 0,0:17:53.36,0:17:55.36,Default,,0,0,0,,花鳥他一個人先回去了喔
Dialogue: 0,0:17:56.44,0:17:58.36,Default,,0,0,0,,（空桶之館）
Dialogue: 0,0:18:03.88,0:18:06.24,Default,,0,0,0,,不行…我是要去哪裡啊？
Dialogue: 0,0:18:06.64,0:18:08.64,Default,,0,0,0,,去找他的話就重蹈覆轍了
Dialogue: 0,0:18:08.80,0:18:11.32,Default,,0,0,0,,沒錯，反正一定又是白擔心一場
Dialogue: 0,0:18:11.72,0:18:13.12,Default,,0,0,0,,怎麼了？蓋修提伯
Dialogue: 0,0:18:13.20,0:18:15.40,Default,,0,0,0,,你想一起帶刻耳柏洛斯散步嗎？
Dialogue: 0,0:18:16.00,0:18:18.20,Default,,0,0,0,,想到他會這麼說就好想揍他
Dialogue: 0,0:18:18.28,0:18:19.20,Default,,0,0,0,,不過…
Dialogue: 0,0:18:19.24,0:18:20.88,Default,,0,0,0,,他覺得你很麻煩
Dialogue: 0,0:18:22.08,0:18:23.56,Default,,0,0,0,,我的確是這麼想的
Dialogue: 0,0:18:24.96,0:18:26.64,Default,,0,0,0,,但是我不想這麼說
Dialogue: 0,0:18:27.40,0:18:29.64,Default,,0,0,0,,這也許就是我這個人的缺點
Dialogue: 0,0:18:32.64,0:18:34.04,Default,,0,0,0,,我什麼時候到這裡的？
Dialogue: 0,0:18:34.32,0:18:35.32,Default,,0,0,0,,我在幹嘛？
Dialogue: 0,0:18:38.32,0:18:39.32,Default,,0,0,0,,別這樣啦
Dialogue: 0,0:18:39.60,0:18:40.84,Default,,0,0,0,,- 他在這裡\N- 癢癢啦
Dialogue: 0,0:18:41.12,0:18:43.00,Default,,0,0,0,,還真的在跟刻耳柏洛斯玩
Dialogue: 0,0:18:43.96,0:18:44.92,Default,,0,0,0,,回家吧
Dialogue: 0,0:18:45.52,0:18:47.00,Default,,0,0,0,,真是無聊的一天
Dialogue: 0,0:18:47.84,0:18:49.68,Default,,0,0,0,,聽我說，刻耳柏洛斯
Dialogue: 0,0:18:50.56,0:18:52.68,Default,,0,0,0,,一開始幫助你的不是我
Dialogue: 0,0:18:53.64,0:18:55.04,Default,,0,0,0,,是蓋修提伯
Dialogue: 0,0:18:57.24,0:18:59.88,Default,,0,0,0,,那是一個下毛毛雨的早上
Dialogue: 0,0:19:10.92,0:19:13.56,Default,,0,0,0,,我沒有照顧你的自信\N所以不看你
Dialogue: 0,0:19:13.72,0:19:15.00,Default,,0,0,0,,會產生感情的
Dialogue: 0,0:19:15.04,0:19:16.72,Default,,0,0,0,,那個冷酷的小雪竟然…
Dialogue: 0,0:19:16.80,0:19:17.92,Default,,0,0,0,,不會吧？好意外
Dialogue: 0,0:19:17.96,0:19:19.04,Default,,0,0,0,,幹嘛跟著我啊？
Dialogue: 0,0:19:19.72,0:19:22.00,Default,,0,0,0,,好像有這件事，又好像沒有
Dialogue: 0,0:19:22.44,0:19:23.84,Default,,0,0,0,,那是刻耳柏洛斯嗎？
Dialogue: 0,0:19:24.20,0:19:26.52,Default,,0,0,0,,可是別捏造我說的話啊
Dialogue: 0,0:19:26.60,0:19:28.04,Default,,0,0,0,,我絕對沒有那麼說
Dialogue: 0,0:19:29.00,0:19:30.72,Default,,0,0,0,,蓋修提伯很溫柔吧？
Dialogue: 0,0:19:30.96,0:19:32.36,Default,,0,0,0,,而且在那之後…
Dialogue: 0,0:19:32.68,0:19:34.20,Default,,0,0,0,,他在選班長的時候…
Dialogue: 0,0:19:35.28,0:19:37.08,Default,,0,0,0,,真是拿你們沒辦法啊
Dialogue: 0,0:19:37.24,0:19:38.36,Default,,0,0,0,,好帥喔
Dialogue: 0,0:19:38.44,0:19:39.80,Default,,0,0,0,,我才沒有那樣說
Dialogue: 0,0:19:39.92,0:19:42.84,Default,,0,0,0,,我開始擔心起花鳥他眼中的我了
Dialogue: 0,0:19:43.60,0:19:44.64,Default,,0,0,0,,所以說
Dialogue: 0,0:19:44.68,0:19:46.92,Default,,0,0,0,,我們能再恢復像以前一樣的關係
Dialogue: 0,0:19:47.00,0:19:48.92,Default,,0,0,0,,我真的非常開心
Dialogue: 0,0:19:49.32,0:19:51.92,Default,,0,0,0,,不過他可能很討厭我
Dialogue: 0,0:19:52.24,0:19:54.52,Default,,0,0,0,,我們不是「永遠的好朋友」
Dialogue: 0,0:19:54.76,0:19:57.40,Default,,0,0,0,,沒錯，那只是你的幻想
Dialogue: 0,0:19:58.12,0:19:59.64,Default,,0,0,0,,如果要我說的話
Dialogue: 0,0:19:59.68,0:20:01.72,Default,,0,0,0,,直接絕交才是為了對方好吧
Dialogue: 0,0:20:03.88,0:20:04.76,Default,,0,0,0,,花鳥
Dialogue: 0,0:20:05.64,0:20:07.52,Default,,0,0,0,,蓋修提伯
Dialogue: 0,0:20:08.32,0:20:10.28,Default,,0,0,0,,我已經跟你說過很多次了
Dialogue: 0,0:20:12.08,0:20:14.72,Default,,0,0,0,,我的名字不是蓋修提伯
Dialogue: 0,0:20:14.76,0:20:15.80,Default,,0,0,0,,而是小雪芹
Dialogue: 0,0:20:16.28,0:20:17.92,Default,,0,0,0,,我沒跟什麼東西戰鬥
Dialogue: 0,0:20:17.96,0:20:19.08,Default,,0,0,0,,也不是你的伙伴
Dialogue: 0,0:20:19.16,0:20:20.60,Default,,0,0,0,,- 蓋修提…\N- 可是…
Dialogue: 0,0:20:22.20,0:20:23.68,Default,,0,0,0,,你要是能好好叫我
Dialogue: 0,0:20:24.08,0:20:25.44,Default,,0,0,0,,我們就能當普通的…
Dialogue: 0,0:20:26.00,0:20:26.88,Default,,0,0,0,,同學
Dialogue: 0,0:20:30.00,0:20:31.32,Default,,0,0,0,,謝謝你的糖果
Dialogue: 0,0:20:34.72,0:20:36.36,Default,,0,0,0,,接下來要去打保齡球
Dialogue: 0,0:20:36.88,0:20:39.60,Default,,0,0,0,,如果你不在隊伍\N那人數就不夠了
Dialogue: 0,0:20:40.00,0:20:41.00,Default,,0,0,0,,知道了
Dialogue: 0,0:20:41.28,0:20:42.44,Default,,0,0,0,,那個
Dialogue: 0,0:20:42.68,0:20:43.88,Default,,0,0,0,,謝謝你，蓋修…
Dialogue: 0,0:20:43.92,0:20:45.92,Default,,0,0,0,,不是，是那個…
Dialogue: 0,0:20:46.00,0:20:47.12,Default,,0,0,0,,小…
Dialogue: 0,0:20:47.32,0:20:49.40,Default,,0,0,0,,小雪
Dialogue: 0,0:20:52.12,0:20:55.40,Default,,0,0,0,,你還是叫我蓋修提伯吧
Dialogue: 0,0:21:01.04,0:21:03.84,Default,,0,0,0,,你們兩個怎麼全身濕成這樣？
Dialogue: 0,0:21:05.20,0:21:07.08,Default,,0,0,0,,我到底在幹嘛？
Dialogue: 0,0:21:07.60,0:21:09.24,Default,,0,0,0,,結果什麼都沒變
Dialogue: 0,0:21:09.88,0:21:10.84,Default,,0,0,0,,小雪芹
Dialogue: 0,0:21:11.04,0:21:13.00,Default,,0,0,0,,比想像中更感情用事
Dialogue: 0,0:21:13.12,0:21:14.20,Default,,0,0,0,,真是沒用
Dialogue: 0,0:21:14.72,0:21:17.12,Default,,0,0,0,,這就是小雪吉大人的優點啊
Dialogue: 0,0:21:17.64,0:21:20.08,Default,,0,0,0,,- 他說我可以叫他蓋修提伯\N- 所以花鳥兜積極的
Dialogue: 0,0:21:20.12,0:21:22.20,Default,,0,0,0,,- 從今以後一樣是伙伴\N- 一直接近…
Dialogue: 0,0:21:22.24,0:21:23.72,Default,,0,0,0,,- 這樣啊，真是太好了\N- 然後突然遠離
Dialogue: 0,0:21:23.80,0:21:26.56,Default,,0,0,0,,他以自己是被愛的想法之下活著
Dialogue: 0,0:21:27.16,0:21:29.24,Default,,0,0,0,,比我以為的更像小惡魔
Dialogue: 0,0:21:29.36,0:21:30.52,Default,,0,0,0,,更像幼犬
Dialogue: 0,0:21:30.92,0:21:34.44,Default,,0,0,0,,- 不過阿芹也太容易動搖了吧\N- 洗溝
Dialogue: 0,0:21:35.20,0:21:36.24,Default,,0,0,0,,太開心了
Dialogue: 0,0:21:36.28,0:21:39.60,Default,,0,0,0,,就算我不插手\N他也能一個人融入其中了
Dialogue: 0,0:21:39.96,0:21:43.44,Default,,0,0,0,,米蓋爾是天使，也是小惡魔
Dialogue: 0,0:21:45.44,0:21:47.76,Default,,0,0,0,,（A、E、I、U\NE、O、A、O）
Dialogue: 0,0:21:47.84,0:21:48.80,Default,,0,0,0,,（好了，準備好了嗎？）
Dialogue: 0,0:21:48.88,0:21:51.08,Default,,0,0,0,,（Ka、Ke、Ki、Ku\NKe、Ko、Ka、Ko）
Dialogue: 0,0:21:51.16,0:21:52.52,Default,,0,0,0,,（來唸一句繞口令！）
Dialogue: 0,0:21:52.60,0:21:54.80,Default,,0,0,0,,（Sa、Se、Shi、Su\NSe、So、Sa、So）
Dialogue: 0,0:21:54.88,0:21:55.76,Default,,0,0,0,,（那樣的話）
Dialogue: 0,0:21:55.84,0:21:58.00,Default,,0,0,0,,（Ta、Te、Chi、Tsu\NTe、To、Ta、To）
Dialogue: 0,0:21:58.04,0:21:59.56,Default,,0,0,0,,（東京特許許可局！）
Dialogue: 0,0:22:06.04,0:22:10.28,Default,,0,0,0,,（感受吧！我想如此活著）
Dialogue: 0,0:22:10.36,0:22:12.44,Default,,0,0,0,,（這就是我！）
Dialogue: 0,0:22:12.56,0:22:15.52,Default,,0,0,0,,（自由！即使被嫌很怪）
Dialogue: 0,0:22:15.60,0:22:17.60,Default,,0,0,0,,（先別放在心上總之）
Dialogue: 0,0:22:17.68,0:22:19.56,Default,,0,0,0,,（休息一下）
Dialogue: 0,0:22:19.64,0:22:24.52,Default,,0,0,0,,（風輕柔的笑著）
Dialogue: 0,0:22:24.60,0:22:27.12,Default,,0,0,0,,（向天空道早安）
Dialogue: 0,0:22:27.20,0:22:29.44,Default,,0,0,0,,（要是想得太難）
Dialogue: 0,0:22:29.56,0:22:32.00,Default,,0,0,0,,（因此煩惱、困擾的話）
Dialogue: 0,0:22:32.04,0:22:33.60,Default,,0,0,0,,（不管是麻煩事，跳躍！）
Dialogue: 0,0:22:33.68,0:22:35.28,Default,,0,0,0,,（還是障礙，跳躍！）
Dialogue: 0,0:22:35.32,0:22:38.44,Default,,0,0,0,,（都跳過去閃躲開吧！\N我們走吧！）
Dialogue: 0,0:22:38.56,0:22:43.08,Default,,0,0,0,,（奔馳吧！席捲吧！來吧！）
Dialogue: 0,0:22:43.16,0:22:45.00,Default,,0,0,0,,（革命，耶！）
Dialogue: 0,0:22:45.04,0:22:46.72,Default,,0,0,0,,（要集中精神，專注）
Dialogue: 0,0:22:46.80,0:22:48.52,Default,,0,0,0,,（要充電，有插座喔）
Dialogue: 0,0:22:48.60,0:22:51.60,Default,,0,0,0,,（拔掉、插進去，追趕吧！\N更多、更多！）
Dialogue: 0,0:22:51.68,0:22:53.28,Default,,0,0,0,,（得享受才行！）
Dialogue: 0,0:22:53.36,0:22:56.36,Default,,0,0,0,,（想要保持笑容，沒錯！）
Dialogue: 0,0:22:56.44,0:22:58.08,Default,,0,0,0,,（無論何時，耶！）
Dialogue: 0,0:22:58.16,0:23:03.04,Default,,0,0,0,,（自由、世界、閃耀吧）
Dialogue: 0,0:23:03.12,0:23:04.72,Default,,0,0,0,,（自由且過分無敵）
Dialogue: 0,0:23:04.80,0:23:07.12,Default,,0,0,0,,（Ra、Re、Ri、Ru\NRe、Ro、Ra、Ro）
Dialogue: 0,0:23:07.16,0:23:08.04,Default,,0,0,0,,（滾動吧，滾動吧！）
Dialogue: 0,0:23:08.16,0:23:11.12,Default,,0,0,0,,（Wa、Wo、N，結束）
Dialogue: 0,0:23:15.00,0:23:16.92,Default,,0,0,0,,文化祭結束了，我也累了
Dialogue: 0,0:23:17.60,0:23:20.28,Default,,0,0,0,,我要以澄楚同學的貓耳舞\N治癒我的心
Dialogue: 0,0:23:20.64,0:23:22.40,Default,,0,0,0,,澄楚同學是哪個？
Dialogue: 0,0:23:22.68,0:23:24.44,Default,,0,0,0,,貓耳不是這樣的
Dialogue: 0,0:23:25.40,0:23:28.40,Default,,0,0,0,,為什麼梅努可洛伊亞\N變成可愛的角色？
Dialogue: 0,0:23:28.44,0:23:30.32,Default,,0,0,0,,應該是總作畫監督月宮拜託的吧
Dialogue: 0,0:23:30.56,0:23:32.88,Default,,0,0,0,,可惡，怎麼變成胸部在晃動？
Dialogue: 0,0:23:33.00,0:23:35.28,Default,,0,0,0,,要晃動的是梅努可洛伊亞的屁股
Dialogue: 0,0:23:35.52,0:23:38.64,Default,,0,0,0,,這樣的話\N只能讓本總總作畫監督上了

Dialogue: 0,0:00:05.01,0:00:07.94,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#7 大小姐的发型
Dialogue: 1,0:00:01.63,0:00:04.97,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:00:10.85,0:00:14.06,CN,,0,0,0,,不行 总感觉哪里不对
Dialogue: 1,0:00:14.44,0:00:16.98,CN,,0,0,0,,给 要不要试试发带
Dialogue: 1,0:00:16.98,0:00:19.61,CN,,0,0,0,,哦 谢谢 这个不错
Dialogue: 1,0:00:19.61,0:00:21.36,CN,,0,0,0,,挺上道的嘛 国神
Dialogue: 1,0:00:21.78,0:00:24.95,CN,,0,0,0,,我家里有姐姐妹妹
Dialogue: 1,0:00:24.95,0:00:26.78,CN,,0,0,0,,少女心还是懂一点的
Dialogue: 1,0:00:27.20,0:00:29.33,CN,,0,0,0,,说谁少女呢
Dialogue: 1,0:00:30.29,0:00:33.62,CN,,0,0,0,,不过 时尚不单纯是一种感觉
Dialogue: 1,0:00:33.62,0:00:36.58,CN,,0,0,0,,还关乎到能否提起干劲
Dialogue: 1,0:00:37.29,0:00:39.38,CN,,0,0,0,,挺不错的啊 新的千切
Dialogue: 1,0:00:42.01,0:00:43.05,CN,,0,0,0,,总感觉不对
Dialogue: 1,0:00:43.55,0:00:48.60,CN,,0,0,0,,那个 大小姐… 大家都在等你开会呢
Dialogue: 0,0:00:01.63,0:00:04.97,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:00:10.85,0:00:14.06,JP,,0,0,0,,駄目だ　なんか違うんだよな
Dialogue: 0,0:00:14.44,0:00:16.98,JP,,0,0,0,,ほい　ヘアバンとか使ってみっか？
Dialogue: 0,0:00:16.98,0:00:19.61,JP,,0,0,0,,おお～サンキュー　いいなそれ
Dialogue: 0,0:00:19.61,0:00:21.36,JP,,0,0,0,,気ぃきくじゃん　国神
Dialogue: 0,0:00:21.78,0:00:24.95,JP,,0,0,0,,俺んち　姉ちゃんと妹いるからな
Dialogue: 0,0:00:24.95,0:00:26.78,JP,,0,0,0,,乙女心はちょっとはわかる
Dialogue: 0,0:00:27.20,0:00:29.33,JP,,0,0,0,,だれが乙女だっつの
Dialogue: 0,0:00:30.29,0:00:33.62,JP,,0,0,0,,まぁ　でも　ファッションって気のせいだけじゃなくて
Dialogue: 0,0:00:33.62,0:00:36.58,JP,,0,0,0,,テンション上がるかどうか　大事だもんな
Dialogue: 0,0:00:37.29,0:00:39.38,JP,,0,0,0,,いいんじゃなね　ニュー千切
Dialogue: 0,0:00:42.01,0:00:43.05,JP,,0,0,0,,なんか違う
Dialogue: 0,0:00:43.55,0:00:48.60,JP,,0,0,0,,あの…お嬢様　みんなずっとミーティング待つんですが
Dialogue: 0,0:01:01.75,0:01:04.67,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#8 送上门的玲王老婆
Dialogue: 1,0:00:58.74,0:01:01.70,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:01:01.70,0:01:05.37,CN,,900,0,0,,玲王 足球的规则是怎样的？
Dialogue: 1,0:01:05.37,0:01:09.30,CN,,0,0,0,,简而言之 你接到我的传球 然后射门得分就行了
Dialogue: 1,0:01:10.01,0:01:12.72,CN,,0,0,0,,凪 想要哪种钉鞋？
Dialogue: 1,0:01:13.89,0:01:16.73,CN,,0,0,0,,好麻烦 随便吧
Dialogue: 1,0:01:16.73,0:01:19.06,CN,,0,0,0,,练习好累
Dialogue: 1,0:01:20.27,0:01:21.77,CN,,0,0,0,,那休息一下
Dialogue: 1,0:01:21.77,0:01:23.73,CN,,0,0,0,,我背你 来
Dialogue: 1,0:01:23.93,0:01:26.44,CN,,0,0,0,,肌肉好痛
Dialogue: 1,0:01:26.44,0:01:27.50,CN,,0,0,0,,这附近？
Dialogue: 1,0:01:27.50,0:01:29.47,CN,,0,0,0,,再往下一点
Dialogue: 1,0:01:29.47,0:01:31.38,CN,,0,0,0,,应该是成长期的肌肉痛吧
Dialogue: 1,0:01:31.88,0:01:33.93,CN,,0,0,0,,明天能来练习吗？
Dialogue: 1,0:01:35.70,0:01:38.37,CN,,0,0,0,,足球果然很麻烦
Dialogue: 1,0:01:38.37,0:01:41.12,CN,,0,0,0,,放学后我来接你
Dialogue: 1,0:01:42.29,0:01:44.16,CN,,0,0,0,,好麻烦
Dialogue: 0,0:00:58.74,0:01:01.70,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:01:01.70,0:01:05.37,JP,,900,0,0,,ねえ　玲王　サッカーって　どんなルールだっけ？
Dialogue: 0,0:01:05.37,0:01:09.30,JP,,0,0,0,,とりあえず　俺からのパスでゴール入れりゃいいよ　お前は
Dialogue: 0,0:01:10.01,0:01:12.72,JP,,0,0,0,,おい　凪　どっちのスパイクがいい？
Dialogue: 0,0:01:13.89,0:01:16.73,JP,,0,0,0,,面倒くさいから何でもいい
Dialogue: 0,0:01:16.73,0:01:19.06,JP,,0,0,0,,練習疲れた
Dialogue: 0,0:01:20.27,0:01:21.77,JP,,0,0,0,,んじゃ休憩
Dialogue: 0,0:01:21.77,0:01:23.73,JP,,0,0,0,,おぶってやるから　こっちこい
Dialogue: 0,0:01:23.93,0:01:26.44,JP,,0,0,0,,筋肉痛いてぇ
Dialogue: 0,0:01:26.44,0:01:27.50,JP,,0,0,0,,この辺か？
Dialogue: 0,0:01:27.50,0:01:29.47,JP,,0,0,0,,もうちょい下
Dialogue: 0,0:01:29.47,0:01:31.38,JP,,0,0,0,,成長痛だな
Dialogue: 0,0:01:31.88,0:01:33.93,JP,,0,0,0,,明日も練習来れるか？
Dialogue: 0,0:01:35.70,0:01:38.37,JP,,0,0,0,,やっぱサッカーは面倒くさい
Dialogue: 0,0:01:38.37,0:01:41.12,JP,,0,0,0,,授業終わったら迎えに行くからな
Dialogue: 0,0:01:42.29,0:01:44.16,JP,,0,0,0,,面倒くさい
Dialogue: 0,0:01:57.30,0:02:00.22,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#9 Z队模仿王大赛
Dialogue: 1,0:01:53.84,0:01:57.26,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:01:57.71,0:02:01.22,CN - Top,,0,0,0,,喂 我的饺子
Dialogue: 1,0:02:01.51,0:02:03.14,CN,,0,0,0,,是我牙丸
Dialogue: 1,0:02:03.14,0:02:04.18,CN,,0,0,0,,正确
Dialogue: 1,0:02:04.18,0:02:05.10,CN,,0,0,0,,真像啊
Dialogue: 1,0:02:06.68,0:02:08.18,CN,,0,0,0,,在干啥呢？
Dialogue: 1,0:02:08.18,0:02:10.52,CN,,0,0,0,,是「我在模仿谁」大赛
Dialogue: 1,0:02:10.52,0:02:12.81,CN,,0,0,0,,好 下一个轮到我
Dialogue: 1,0:02:13.19,0:02:15.07,CN,,0,0,0,,就算背叛也要赢
Dialogue: 1,0:02:15.07,0:02:17.53,CN,,0,0,0,,辛苦了 Z队
Dialogue: 1,0:02:17.53,0:02:18.99,CN,,0,0,0,,久远
Dialogue: 1,0:02:18.99,0:02:21.91,CN,,0,0,0,,正确 辛苦辣
Dialogue: 1,0:02:21.91,0:02:23.91,CN,,0,0,0,,这谁都能做到吧
Dialogue: 1,0:02:23.91,0:02:26.08,CN,,0,0,0,,那下一个 千切
Dialogue: 1,0:02:26.79,0:02:28.12,CN,,0,0,0,,我就不了吧
Dialogue: 1,0:02:28.12,0:02:30.96,CN,,0,0,0,,快点 害羞鬼
Dialogue: 1,0:02:30.96,0:02:34.04,CN,,0,0,0,,耶 大小姐的出道模仿秀
Dialogue: 1,0:02:34.04,0:02:35.67,CN,,0,0,0,,那…
Dialogue: 1,0:02:38.01,0:02:42.59,CN,,0,0,0,,想玩好朋友过家家的话 滚
Dialogue: 1,0:02:42.59,0:02:44.39,CN,,0,0,0,,冠军
Dialogue: 1,0:02:44.39,0:02:46.56,CN,,0,0,0,,服了 大小姐
Dialogue: 1,0:02:46.56,0:02:50.85,CN,,0,0,0,,滚
Dialogue: 1,0:02:38.01,0:02:42.59,Ruby,,0,0,0,,{\pos(1242,975)}lock off
Dialogue: 1,0:02:46.56,0:02:50.85,Ruby,,0,0,0,,{\pos(960,975)}lock off
Dialogue: 0,0:01:53.84,0:01:57.26,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:01:57.71,0:02:01.22,JP - Top,,0,0,0,,おーい　俺の餃子～
Dialogue: 0,0:02:01.51,0:02:03.14,JP,,0,0,0,,我牙丸だ　我牙丸
Dialogue: 0,0:02:03.14,0:02:04.18,JP,,0,0,0,,正解
Dialogue: 0,0:02:04.18,0:02:05.10,JP,,0,0,0,,似てる
Dialogue: 0,0:02:06.68,0:02:08.18,JP,,0,0,0,,何やってんの？
Dialogue: 0,0:02:08.18,0:02:10.52,JP,,0,0,0,,誰のモノマネでしょうか選手権
Dialogue: 0,0:02:10.52,0:02:12.81,JP,,0,0,0,,はいはーい　次　俺やる
Dialogue: 0,0:02:13.19,0:02:15.07,JP,,0,0,0,,裏切ってでも勝つ
Dialogue: 0,0:02:15.07,0:02:17.53,JP,,0,0,0,,お疲れ　チームＺ
Dialogue: 0,0:02:17.53,0:02:18.99,JP,,0,0,0,,久遠
Dialogue: 0,0:02:18.99,0:02:21.91,JP,,0,0,0,,正解　お疲れちゃん
Dialogue: 0,0:02:21.91,0:02:23.91,JP,,0,0,0,,いや　誰でもできるだろ
Dialogue: 0,0:02:23.91,0:02:26.08,JP,,0,0,0,,じゃ　次　千切ね
Dialogue: 0,0:02:26.79,0:02:28.12,JP,,0,0,0,,いいよ俺は
Dialogue: 0,0:02:28.12,0:02:30.96,JP,,0,0,0,,やれやれ　引っ込み思案
Dialogue: 0,0:02:30.96,0:02:34.04,JP,,0,0,0,,イェイ　お嬢のモノマネデビュー
Dialogue: 0,0:02:34.04,0:02:35.67,JP,,0,0,0,,え～っと
Dialogue: 0,0:02:38.01,0:02:42.59,JP,,0,0,0,,仲良し絆ごっこしたいなら　ロック・オフ
Dialogue: 0,0:02:42.59,0:02:44.39,JP,,0,0,0,,優勝
Dialogue: 0,0:02:44.39,0:02:46.56,JP,,0,0,0,,参りました　お嬢
Dialogue: 0,0:02:46.56,0:02:50.85,JP,,0,0,0,,ロック・オフ
Dialogue: 0,0:03:00.53,0:03:03.45,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#10 Z队模仿王大赛 其二
Dialogue: 1,0:02:57.19,0:03:00.48,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:03:00.82,0:03:04.91,CN - Top,,0,0,0,,在绿茵场上 我就是国王
Dialogue: 1,0:03:04.91,0:03:06.45,CN,,0,0,0,,菜鸟
Dialogue: 1,0:03:06.45,0:03:07.95,CN,,0,0,0,,一点都不像
Dialogue: 1,0:03:08.95,0:03:10.54,CN,,0,0,0,,你这是模仿马狼吗？
Dialogue: 1,0:03:11.58,0:03:13.96,CN,,0,0,0,,做什么都是你自己的风格啊
Dialogue: 1,0:03:13.96,0:03:15.96,CN,,0,0,0,,来 下一个到洁
Dialogue: 1,0:03:15.96,0:03:18.75,CN,,0,0,0,,开始你的模仿
Dialogue: 1,0:03:18.75,0:03:21.05,CN,,0,0,0,,真好啊 有纳豆
Dialogue: 1,0:03:21.05,0:03:23.67,CN,,0,0,0,,我可是一直都只有萝卜干啊
Dialogue: 1,0:03:23.67,0:03:24.84,CN,,0,0,0,,秃头栗子
Dialogue: 1,0:03:24.84,0:03:27.43,CN,,0,0,0,,正确 南无三 南无三
Dialogue: 1,0:03:27.43,0:03:30.14,CN,,0,0,0,,好 最后轮到我
Dialogue: 1,0:03:30.14,0:03:32.06,CN,,0,0,0,,就等你了 英雄
Dialogue: 1,0:03:32.06,0:03:33.89,CN,,0,0,0,,来 压轴好戏
Dialogue: 1,0:03:38.86,0:03:40.52,CN,,0,0,0,,呃 这谁？
Dialogue: 1,0:03:40.52,0:03:42.44,CN,,0,0,0,,输给我们的二子
Dialogue: 1,0:03:42.44,0:03:44.19,CN,,0,0,0,,这挑的啥啊
Dialogue: 1,0:03:44.19,0:03:45.40,CN,,0,0,0,,可爱
Dialogue: 1,0:03:45.40,0:03:48.45,CN,,0,0,0,,可爱 我死了
Dialogue: 0,0:02:57.19,0:03:00.48,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:03:00.82,0:03:04.91,JP - Top,,0,0,0,,ピッチの上じゃ　俺がキングだぁ…
Dialogue: 0,0:03:04.91,0:03:06.45,JP,,0,0,0,,下手くそぉ
Dialogue: 0,0:03:06.45,0:03:07.95,JP,,0,0,0,,似てねえ
Dialogue: 0,0:03:08.95,0:03:10.54,JP,,0,0,0,,それ　馬狼のつもりか？
Dialogue: 0,0:03:11.58,0:03:13.96,JP,,0,0,0,,何やっても　我牙丸のまんまじゃんかよ
Dialogue: 0,0:03:13.96,0:03:15.96,JP,,0,0,0,,はい　じゃあ　次　潔
Dialogue: 0,0:03:15.96,0:03:18.75,JP,,0,0,0,,誰のモノマネでしょうか選手権
Dialogue: 0,0:03:18.75,0:03:21.05,JP,,0,0,0,,いいなあ　納豆
Dialogue: 0,0:03:21.05,0:03:23.67,JP,,0,0,0,,俺なんかずっとたくあんだぜ～
Dialogue: 0,0:03:23.67,0:03:24.84,JP,,0,0,0,,イガグリ
Dialogue: 0,0:03:24.84,0:03:27.43,JP,,0,0,0,,正解　南無三　南無三
Dialogue: 0,0:03:27.43,0:03:30.14,JP,,0,0,0,,よし　じゃあラスト　俺　やります
Dialogue: 0,0:03:30.14,0:03:32.06,JP,,0,0,0,,よっ　待ってました　ヒーロー
Dialogue: 0,0:03:32.06,0:03:33.89,JP,,0,0,0,,いけ　大トリ
Dialogue: 0,0:03:38.86,0:03:40.52,JP,,0,0,0,,えっ…　誰？
Dialogue: 0,0:03:40.52,0:03:42.44,JP,,0,0,0,,俺だちに負けたときの二子
Dialogue: 0,0:03:42.44,0:03:44.19,JP,,0,0,0,,どこチョイスしてんだよ
Dialogue: 0,0:03:44.19,0:03:45.40,JP,,0,0,0,,キューです
Dialogue: 0,0:03:45.40,0:03:48.45,JP,,0,0,0,,きゃわわ　バブい
Dialogue: 0,0:04:00.92,0:04:03.84,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#11 第二次选拔猜拳
Dialogue: 1,0:03:57.66,0:04:00.87,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:04:01.58,0:04:03.54,CN,,0,0,0,,洁第一个走了
Dialogue: 1,0:04:03.54,0:04:05.13,CN,,0,0,0,,下一个猜拳决定？
Dialogue: 1,0:04:05.13,0:04:07.80,CN,,0,0,0,,我我 下一个到我
Dialogue: 1,0:04:07.80,0:04:09.47,CN,,0,0,0,,啊？到我啊
Dialogue: 1,0:04:09.47,0:04:10.43,CN,,0,0,0,,我
Dialogue: 1,0:04:10.43,0:04:11.43,CN,,0,0,0,,我
Dialogue: 1,0:04:11.43,0:04:12.47,CN,,0,0,0,,到我
Dialogue: 1,0:04:12.47,0:04:13.93,CN,,0,0,0,,千切呢？
Dialogue: 1,0:04:13.93,0:04:16.51,CN,,0,0,0,,谁先去都没差吧
Dialogue: 1,0:04:17.35,0:04:20.44,CN,,0,0,0,,这种时候的自我主义也有可能被看在眼里的啊
Dialogue: 1,0:04:20.44,0:04:21.56,Ruby,,0,0,0,,{\pos(960,975)}Lock off
Dialogue: 1,0:04:20.44,0:04:21.56,CN,,0,0,0,,滚啦
Dialogue: 1,0:04:21.56,0:04:24.40,CN,,0,0,0,,足球和猜拳都要当个利己主义者
Dialogue: 1,0:04:24.40,0:04:25.32,Ruby,,0,0,0,,{\pos(960,975)}Lock off
Dialogue: 1,0:04:24.40,0:04:25.32,CN,,0,0,0,,滚
Dialogue: 1,0:04:25.32,0:04:27.90,CN,,0,0,0,,一点都不像绘心
Dialogue: 1,0:04:27.90,0:04:29.90,CN,,0,0,0,,那一起来猜拳吧
Dialogue: 1,0:04:29.90,0:04:32.70,CN,,0,0,0,,石头剪刀布
Dialogue: 1,0:04:32.70,0:04:34.78,CN,,0,0,0,,啊 我赢了
Dialogue: 1,0:04:35.12,0:04:36.41,CN,,0,0,0,,那我第一个
Dialogue: 1,0:04:36.41,0:04:37.79,CN,,0,0,0,,为什么啊
Dialogue: 1,0:04:37.79,0:04:39.12,Ruby,,0,0,0,,{\pos(960,975)}Lock off
Dialogue: 1,0:04:37.79,0:04:39.12,CN,,0,0,0,,滚
Dialogue: 1,0:04:39.12,0:04:41.41,CN,,0,0,0,,好啦 来决定下一个
Dialogue: 1,0:04:41.41,0:04:42.50,CN,,0,0,0,,耶
Dialogue: 1,0:04:42.50,0:04:43.58,CN,,0,0,0,,好
Dialogue: 1,0:04:43.58,0:04:44.79,CN,,0,0,0,,先走一步
Dialogue: 1,0:04:44.79,0:04:46.04,CN,,0,0,0,,哦 赢了
Dialogue: 1,0:04:49.67,0:04:52.68,CN,,0,0,0,,为毛啊
Dialogue: 0,0:03:57.66,0:04:00.87,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:04:01.58,0:04:03.54,JP,,0,0,0,,潔が一番に行っちゃったけど
Dialogue: 0,0:04:03.54,0:04:05.13,JP,,0,0,0,,次はじゃんけんで決める？
Dialogue: 0,0:04:05.13,0:04:07.80,JP,,0,0,0,,はいはい　次　俺が行く
Dialogue: 0,0:04:07.80,0:04:09.47,JP,,0,0,0,,はあ？俺だろ
Dialogue: 0,0:04:09.47,0:04:10.43,JP,,0,0,0,,俺
Dialogue: 0,0:04:10.43,0:04:11.43,JP,,0,0,0,,俺
Dialogue: 0,0:04:11.43,0:04:12.47,JP,,0,0,0,,俺だ
Dialogue: 0,0:04:12.47,0:04:13.93,JP,,0,0,0,,千切は？
Dialogue: 0,0:04:13.93,0:04:16.51,JP,,0,0,0,,入る順が何か変わるわけじゃないだろ
Dialogue: 0,0:04:17.35,0:04:20.44,JP,,0,0,0,,こういうところのエゴさも評価されるかもしれないのに
Dialogue: 0,0:04:20.44,0:04:21.56,JP,,0,0,0,,ロック・オフだ
Dialogue: 0,0:04:21.56,0:04:24.40,JP,,0,0,0,,じゃんけんもサッカーもエゴイストであれ
Dialogue: 0,0:04:24.40,0:04:25.32,JP,,0,0,0,,ロック・オフ
Dialogue: 0,0:04:25.32,0:04:27.90,JP,,0,0,0,,絵心のモノマネ似てねえ
Dialogue: 0,0:04:27.90,0:04:29.90,JP,,0,0,0,,じゃあ　もう全員でやるよ
Dialogue: 0,0:04:29.90,0:04:32.70,JP,,0,0,0,,じゃん　けん　ぽん
Dialogue: 0,0:04:32.70,0:04:34.78,JP,,0,0,0,,あっ　勝った
Dialogue: 0,0:04:35.12,0:04:36.41,JP,,0,0,0,,じゃあ　一番で
Dialogue: 0,0:04:36.41,0:04:37.79,JP,,0,0,0,,なんでだよ
Dialogue: 0,0:04:37.79,0:04:39.12,JP,,0,0,0,,ロック・オフ
Dialogue: 0,0:04:39.12,0:04:41.41,JP,,0,0,0,,はい　次の人決めるよ
Dialogue: 0,0:04:41.41,0:04:42.50,JP,,0,0,0,,イェイ
Dialogue: 0,0:04:42.50,0:04:43.58,JP,,0,0,0,,うっし
Dialogue: 0,0:04:43.58,0:04:44.79,JP,,0,0,0,,お先
Dialogue: 0,0:04:44.79,0:04:46.04,JP,,0,0,0,,おっ　勝った
Dialogue: 0,0:04:49.67,0:04:52.68,JP,,0,0,0,,なんでだよ
Dialogue: 0,0:05:03.82,0:05:06.74,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#12 哥哥 说话了！
Dialogue: 1,0:05:00.44,0:05:03.78,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:05:03.78,0:05:05.82,CN,,0,0,0,,拜拜 哥哥
Dialogue: 1,0:05:05.82,0:05:08.78,CN,,0,0,0,,我就到此为止了
Dialogue: 1,0:05:08.78,0:05:12.29,CN,,0,0,0,,等哥哥成为世界第一前锋的时候
Dialogue: 1,0:05:12.29,0:05:16.17,CN,,0,0,0,,我就当模仿你的艺人
Dialogue: 1,0:05:16.17,0:05:20.21,CN,,0,0,0,,艺名就叫 计助·戴维森
Dialogue: 1,0:05:16.17,0:05:20.21,Ruby,,0,0,0,,{\pos(1147,975)}Davidson
Dialogue: 1,0:05:21.96,0:05:23.59,CN,,0,0,0,,再见了 哥哥
Dialogue: 1,0:05:23.59,0:05:25.68,CN,,0,0,0,,一定要活下去啊
Dialogue: 1,0:05:30.60,0:05:32.43,CN,,0,0,0,,交给我吧 计助
Dialogue: 1,0:05:32.43,0:05:36.02,CN,,0,0,0,,我会亲手击溃那些分开我们的人
Dialogue: 1,0:05:36.02,0:05:38.40,CN,,0,0,0,,我是这么说的
Dialogue: 1,0:05:38.40,0:05:40.52,CN,,0,0,0,,咦 这家伙…
Dialogue: 1,0:05:40.52,0:05:42.11,CN,,0,0,0,,能说话的啊
Dialogue: 1,0:05:43.40,0:05:44.45,CN,,0,0,0,,怪人
Dialogue: 1,0:05:44.45,0:05:45.76,CN,,0,0,0,,好可怕
Dialogue: 0,0:05:00.44,0:05:03.78,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:05:03.78,0:05:05.82,JP,,0,0,0,,バイバイ　お兄…
Dialogue: 0,0:05:05.82,0:05:08.78,JP,,0,0,0,,俺は　ここまでだぁ…
Dialogue: 0,0:05:08.78,0:05:12.29,JP,,0,0,0,,お兄が世界一のストライカーになったら　俺
Dialogue: 0,0:05:12.29,0:05:16.17,JP,,0,0,0,,お兄のモノマネタレントとしてやっていこうと思った
Dialogue: 0,0:05:16.17,0:05:20.21,JP,,0,0,0,,芸名は　ケイスケ·デイビッドジョンにしようと思ってる
Dialogue: 0,0:05:21.96,0:05:23.59,JP,,0,0,0,,じゃあな　お兄
Dialogue: 0,0:05:23.59,0:05:25.68,JP,,0,0,0,,絶対生き残れよ
Dialogue: 0,0:05:30.60,0:05:32.43,JP,,0,0,0,,任せろ　計助
Dialogue: 0,0:05:32.43,0:05:36.02,JP,,0,0,0,,俺たちを引き裂いた奴ら　俺が潰す
Dialogue: 0,0:05:36.02,0:05:38.40,JP,,0,0,0,,っと　俺が言ってる
Dialogue: 0,0:05:38.40,0:05:40.52,JP,,0,0,0,,あれ　あいつ…
Dialogue: 0,0:05:40.52,0:05:42.11,JP,,0,0,0,,普通に喋れるのか
Dialogue: 0,0:05:43.40,0:05:44.45,JP,,0,0,0,,変人だ
Dialogue: 0,0:05:44.45,0:05:45.76,JP,,0,0,0,,超怖え

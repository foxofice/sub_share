Dialogue: 0,0:01:32.00,0:01:40.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕組製作 僅供學習交流 禁止用於商業用途
Comment: 0,0:00:01.00,0:00:01.05,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:00:22.23,0:00:28.66,op-jp,,0,0,0,,滴る汗と日差しで閉じた目
Dialogue: 0,0:00:28.66,0:00:34.91,op-jp,,0,0,0,,映し出したのはあなたとの約束
Dialogue: 0,0:00:34.91,0:00:41.55,op-jp,,0,0,0,,意志を紡いだ導火線に火をつけたら
Dialogue: 0,0:00:41.55,0:00:47.30,op-jp,,0,0,0,,今より強く高く翔べる
Dialogue: 0,0:00:47.30,0:00:54.03,op-jp,,0,0,0,,恐れを知って哀を知って進むなら
Dialogue: 0,0:00:54.03,0:01:01.50,op-jp,,0,0,0,,己の全て捧げ旗を上げろ
Dialogue: 0,0:01:01.50,0:01:07.07,op-jp,,0,0,0,,掠れた声を何度も張りあげてよ
Dialogue: 0,0:01:07.07,0:01:11.95,op-jp,,0,0,0,,希望を決意を抱いて
Dialogue: 0,0:00:22.23,0:00:28.66,op-cn,,0,0,0,,汗水滾落 烈日當頭 我閉上雙眼
Dialogue: 0,0:00:28.66,0:00:34.91,op-cn,,0,0,0,,眼中映出 與你的約定
Dialogue: 0,0:00:34.91,0:00:41.55,op-cn,,0,0,0,,點燃以意志織成的導火線
Dialogue: 0,0:00:41.55,0:00:47.30,op-cn,,0,0,0,,向著更高更強 振翅高飛
Dialogue: 0,0:00:47.30,0:00:54.03,op-cn,,0,0,0,,知曉恐懼 知曉哀傷 前進不息
Dialogue: 0,0:00:54.03,0:01:01.50,op-cn,,0,0,0,,獻出一切 高舉旗幟
Dialogue: 0,0:01:01.50,0:01:07.07,op-cn,,0,0,0,,無數次發出嘶吼
Dialogue: 0,0:01:07.07,0:01:11.95,op-cn,,0,0,0,,心懷希望 堅定決心
Comment: 0,0:23:15.96,0:23:15.96,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:27.05,0:23:30.00,ed-jp,,0,0,1,,なぁ坊やどうした？ここは戦場だぜ
Dialogue: 0,0:23:30.00,0:23:32.83,ed-jp,,0,0,1,,たぎる憎悪のラリー　背馳の成長過程
Dialogue: 0,0:23:32.83,0:23:35.64,ed-jp,,0,0,1,,加減も知らず殺気立ったままの剣に
Dialogue: 0,0:23:35.64,0:23:38.81,ed-jp,,0,0,1,,発汗する体　カルマか咎　如何に？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-jp,,0,0,1,,恒　現実は不調和な旋律さ
Dialogue: 0,0:23:41.28,0:23:44.29,ed-jp,,0,0,1,,冷血なステンレス製の心臓持つ演説者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-jp,,0,0,1,,何回目の明滅　また凱旋するテンペスタ
Dialogue: 0,0:23:46.94,0:23:50.04,ed-jp,,0,0,1,,アーチかける善悪　もう応答しない生存者
Dialogue: 0,0:23:51.14,0:23:53.78,ed-jp,,0,0,0,,花のよう　咲うＭｙ　Ｒｅｄ
Dialogue: 0,0:23:53.95,0:24:02.32,ed-jp,,0,0,0,,守りたいものだって　この掌離れれば
Dialogue: 0,0:24:02.48,0:24:09.95,ed-jp,,0,0,0,,壊したいものなんて　壊せないものだけ
Dialogue: 0,0:24:11.85,0:24:17.59,ed-jp,,0,0,0,,唸る　その狂気が　花咲かすダリア
Dialogue: 0,0:24:17.59,0:24:20.31,ed-jp,,0,0,0,,振りかざす度　歪んだ定規
Dialogue: 0,0:24:20.31,0:24:23.15,ed-jp,,0,0,0,,反射する対照的な正義
Dialogue: 0,0:24:23.15,0:24:28.82,ed-jp,,0,0,0,,裏切りのゲリラ　散らす羽たちが
Dialogue: 0,0:24:28.82,0:24:31.80,ed-jp,,0,0,0,,飛ぶ鳥の蹴った地面のようさ
Dialogue: 0,0:24:31.80,0:24:36.87,ed-jp,,0,0,0,,君にもあるんでしょう？キズツケタクナイモノ
Dialogue: 0,0:23:27.05,0:23:30.00,ed-cn,,0,0,0,,怎麼了小弟弟？這裡可是戰場
Dialogue: 0,0:23:30.00,0:23:32.83,ed-cn,,0,0,0,,是憎惡翻騰的拉力賽 與成長背道而馳
Dialogue: 0,0:23:32.83,0:23:35.64,ed-cn,,0,0,0,,不知輕重 利劍殺氣騰騰
Dialogue: 0,0:23:35.64,0:23:38.81,ed-cn,,0,0,0,,汗流浹背 是業是罪 如何判定？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-cn,,0,0,0,,現實永遠是不和諧旋律
Dialogue: 0,0:23:41.28,0:23:44.29,ed-cn,,0,0,0,,擁有鋼鐵心臟的冷血演講者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-cn,,0,0,0,,第幾次電閃雷鳴 暴風雨再次凱旋
Dialogue: 0,0:23:46.94,0:23:50.04,ed-cn,,0,0,0,,善惡架上彩虹 生還者已無應答
Dialogue: 0,0:23:51.14,0:23:53.78,ed-cn,,0,0,0,,如花般綻放笑容 My Red
Dialogue: 0,0:23:53.95,0:24:02.32,ed-cn,,0,0,0,,想要守護之物 離開掌中便無從守護
Dialogue: 0,0:24:02.48,0:24:09.95,ed-cn,,0,0,0,,想要毀滅之物 全都是無法毀滅之物
Dialogue: 0,0:24:11.85,0:24:17.59,ed-cn,,0,0,0,,呻吟不止 瘋狂如盛開的大麗花
Dialogue: 0,0:24:17.59,0:24:20.31,ed-cn,,0,0,0,,標尺一經舉起 立刻扭曲
Dialogue: 0,0:24:20.31,0:24:23.15,ed-cn,,0,0,0,,反射出對立的正義
Dialogue: 0,0:24:23.15,0:24:28.82,ed-cn,,0,0,0,,叛逆的游擊 散落的羽翼
Dialogue: 0,0:24:28.82,0:24:31.80,ed-cn,,0,0,0,,如飛鳥蹬踏的地面一般
Dialogue: 0,0:24:31.80,0:24:36.87,ed-cn,,0,0,0,,你一定也有不願傷害之物
Dialogue: 0,0:01:34.49,0:01:37.70,biaoti,,0,0,0,,{\fad(480,480)}離眼的悲劇
Dialogue: 0,0:01:34.16,0:01:38.99,Default,,0,0,0,,應該是15年前的事了
Dialogue: 0,0:01:39.56,0:01:41.39,Default,,0,0,0,,紀彗大人他們
Dialogue: 0,0:01:42.04,0:01:47.39,Default,,0,0,0,,眼看著包括時任城主在內的幾乎所有離眼成年人
Dialogue: 0,0:01:48.24,0:01:51.38,Default,,0,0,0,,被全部殺死
Dialogue: 0,0:01:52.76,0:01:57.64,Default,,0,0,0,,那個時候 離眼一帶尚未統一
Dialogue: 0,0:01:58.00,0:01:59.77,Default,,0,0,0,,當時的離眼城
Dialogue: 0,0:02:00.22,0:02:04.41,Default,,0,0,0,,還是前一任紀昌在擔任城主
Dialogue: 0,0:02:05.98,0:02:08.06,Default,,0,0,0,,當時那一帶
Dialogue: 0,0:02:08.26,0:02:13.95,Default,,0,0,0,,離眼和暗何兩座城 在爭奪地區霸權
Dialogue: 0,0:02:14.45,0:02:19.07,Default,,0,0,0,,王都邯鄲似乎將其視為小規模衝突
Dialogue: 0,0:02:19.07,0:02:22.11,Default,,0,0,0,,但實際卻是激烈的戰爭
Dialogue: 0,0:02:22.68,0:02:25.93,Default,,0,0,0,,暗何的唐寒 以暴力壓迫治理城池
Dialogue: 0,0:02:26.40,0:02:29.56,Default,,0,0,0,,而離眼的紀昌 因仁德親善頗得民心
Dialogue: 0,0:02:29.56,0:02:32.66,Default,,0,0,0,,城池上下一心
Dialogue: 0,0:02:33.32,0:02:36.90,Default,,0,0,0,,暗何的兵力比離眼多一倍有餘
Dialogue: 0,0:02:37.06,0:02:42.63,Default,,0,0,0,,但紀昌驍勇善戰 其親信猛將雲集
Dialogue: 0,0:02:43.07,0:02:47.11,Default,,0,0,0,,軍隊訓練有素
Dialogue: 0,0:02:47.11,0:02:49.53,Default,,0,0,0,,使得離眼與暗何勢均力敵
Dialogue: 0,0:02:49.84,0:02:53.76,Default,,0,0,0,,年輕將領 紀彗 劉冬 馬呈也鋒芒漸露
Dialogue: 0,0:02:53.88,0:02:57.20,Default,,0,0,0,,離眼開始逐漸佔據優勢
Dialogue: 0,0:02:57.95,0:03:00.32,Default,,0,0,0,,竟然這就快結束了
Dialogue: 0,0:03:00.39,0:03:02.58,Default,,0,0,0,,看來派援軍是多此一舉了
Dialogue: 0,0:03:03.06,0:03:05.64,Default,,0,0,0,,雖然我們本就很看好他們
Dialogue: 0,0:03:06.02,0:03:10.09,Default,,0,0,0,,看來那三人非同尋常啊 城主
Dialogue: 0,0:03:10.55,0:03:11.24,Default,,0,0,0,,是啊
Dialogue: 0,0:03:11.54,0:03:14.09,Default,,0,0,0,,身為父親 我實在欣慰之至
Dialogue: 0,0:03:14.66,0:03:18.97,Default,,0,0,0,,紀昌是劉冬和馬呈的養父
Dialogue: 0,0:03:19.48,0:03:22.42,Default,,0,0,0,,二人似乎是紀昌已故心腹之子
Dialogue: 0,0:03:22.99,0:03:27.59,Default,,0,0,0,,所以此二人與紀彗情同手足
Dialogue: 0,0:03:28.38,0:03:31.36,Default,,0,0,0,,面對聲勢漸盛的離眼
Dialogue: 0,0:03:31.46,0:03:34.11,Default,,0,0,0,,暗何發起了決戰
Dialogue: 0,0:03:34.60,0:03:39.05,Default,,0,0,0,,那就是這一帶有名的「旦虎之戰」
Dialogue: 0,0:03:39.42,0:03:41.54,Default,,0,0,0,,離眼舉全軍迎戰
Dialogue: 0,0:03:41.54,0:03:45.71,Default,,0,0,0,,而暗何軍憑藉財力召集周邊軍隊
Dialogue: 0,0:03:45.71,0:03:47.87,Default,,0,0,0,,其兵力為離眼的五倍
Dialogue: 0,0:03:48.68,0:03:51.29,Default,,0,0,0,,聽說那是一場激烈異常的戰鬥
Dialogue: 0,0:03:52.11,0:03:55.71,Default,,0,0,0,,劉冬和馬呈也在激戰中身受重傷
Dialogue: 0,0:03:56.23,0:03:57.72,Default,,0,0,0,,不過最後
Dialogue: 0,0:03:59.76,0:04:02.58,Default,,0,0,0,,紀彗衝破五倍的敵軍
Dialogue: 0,0:04:02.58,0:04:05.64,Default,,0,0,0,,親手擊殺暗何城主唐寒
Dialogue: 0,0:04:05.94,0:04:08.47,Default,,0,0,0,,離眼取得了戰鬥的勝利
Dialogue: 0,0:04:09.36,0:04:13.40,Default,,0,0,0,,如果這是真的 那趙將紀彗一定本領高強
Dialogue: 0,0:04:13.98,0:04:17.51,Default,,0,0,0,,那時一定也有許多人欣喜地以為
Dialogue: 0,0:04:17.51,0:04:21.41,Default,,0,0,0,,紀昌的統治範圍將就此擴大
Dialogue: 0,0:04:22.04,0:04:22.89,Default,,0,0,0,,然而
Dialogue: 0,0:04:23.08,0:04:26.68,Default,,0,0,0,,離眼與暗何那長久的恩怨
Dialogue: 0,0:04:26.68,0:04:29.96,Default,,0,0,0,,並沒有因旦虎之戰而終結
Dialogue: 0,0:04:31.32,0:04:35.84,Default,,0,0,0,,就在紀彗軍追擊唐寒殘部時
Dialogue: 0,0:04:35.84,0:04:40.22,Default,,0,0,0,,防守空虛的離眼城被攻陷了
Dialogue: 0,0:04:40.80,0:04:44.85,Default,,0,0,0,,攻城者是唐寒之子 唐釣
Dialogue: 0,0:04:45.51,0:04:51.62,Default,,0,0,0,,唐釣生性懦弱 未參加旦虎之戰而留在了暗何城
Dialogue: 0,0:04:51.70,0:04:55.86,Default,,0,0,0,,他帶領城內為數不多的衛兵 發起了奇襲
Dialogue: 0,0:04:56.35,0:05:00.99,Default,,0,0,0,,他雖不成器 似乎卻還是有為父報仇的孝心
Dialogue: 0,0:05:01.43,0:05:06.87,Default,,0,0,0,,當時的離眼守軍 只有從旦虎歸來的重傷兵
Dialogue: 0,0:05:07.06,0:05:10.82,Default,,0,0,0,,馬呈和劉冬也在城內
Dialogue: 0,0:05:07.54,0:05:09.49,zhu,,0,0,0,,該死的
Dialogue: 0,0:05:09.49,0:05:10.82,zhu,,0,0,0,,劉冬
Dialogue: 0,0:05:10.82,0:05:14.35,Default,,0,0,0,,但二人一定也無計可施
Dialogue: 0,0:05:15.00,0:05:17.41,Default,,0,0,0,,總而言之 離眼陷落
Dialogue: 0,0:05:17.48,0:05:23.00,Default,,0,0,0,,城內的老弱婦孺全都成了人質
Dialogue: 0,0:05:23.99,0:05:27.99,Default,,0,0,0,,而唐釣以人質為籌碼
Dialogue: 0,0:05:28.28,0:05:32.60,Default,,0,0,0,,逼迫紀昌與其手下將士投降
Dialogue: 0,0:05:33.24,0:05:34.72,Default,,0,0,0,,不可以 父親
Dialogue: 0,0:05:34.82,0:05:36.53,Default,,0,0,0,,去了一定會被殺
Dialogue: 0,0:05:36.85,0:05:38.25,Default,,0,0,0,,對方太卑鄙了
Dialogue: 0,0:05:38.76,0:05:42.36,Default,,0,0,0,,唐釣答應了放過未成年者
Dialogue: 0,0:05:42.76,0:05:44.28,Default,,0,0,0,,一定不會再作讓步
Dialogue: 0,0:05:44.72,0:05:45.74,Default,,0,0,0,,父親
Dialogue: 0,0:05:46.18,0:05:47.28,Default,,0,0,0,,城主大人
Dialogue: 0,0:05:47.85,0:05:51.22,Default,,0,0,0,,岳印 你為何不勸阻我父親
Dialogue: 0,0:05:51.49,0:05:54.14,Default,,0,0,0,,要是去了 你們也會性命不保
Dialogue: 0,0:05:54.56,0:05:55.67,Default,,0,0,0,,赫公 你也是
Dialogue: 0,0:05:56.33,0:06:00.36,Default,,0,0,0,,要是不去 我們留在城內的孩子就會被殺
Dialogue: 0,0:06:03.28,0:06:04.14,Default,,0,0,0,,彗
Dialogue: 0,0:06:05.19,0:06:09.28,Default,,0,0,0,,唐釣企圖以婦孺為人質 換取武將之首級
Dialogue: 0,0:06:09.28,0:06:12.93,Default,,0,0,0,,我們是故意應允了這一卑劣之舉
Dialogue: 0,0:06:14.11,0:06:19.50,Default,,0,0,0,,我們雖是絕不遜於中央的強大武將
Dialogue: 0,0:06:20.22,0:06:24.32,Default,,0,0,0,,但我不僅是武將 更是離眼城主
Dialogue: 0,0:06:24.88,0:06:28.47,Default,,0,0,0,,而我的親信們 亦是離眼的成年人
Dialogue: 0,0:06:29.64,0:06:34.21,Default,,0,0,0,,父母為孩子豁出性命是理所當然
Dialogue: 0,0:06:34.85,0:06:37.96,Default,,0,0,0,,而雖有些過早
Dialogue: 0,0:06:38.46,0:06:40.96,Default,,0,0,0,,這一職責就由你繼承了
Dialogue: 0,0:06:41.38,0:06:42.53,Default,,0,0,0,,吾兒啊
Dialogue: 0,0:06:45.22,0:06:48.22,Default,,0,0,0,,隨後雙方開始了人質交換
Dialogue: 0,0:06:48.51,0:06:49.76,Default,,0,0,0,,城主大人
Dialogue: 0,0:06:49.76,0:06:51.18,Default,,0,0,0,,紀昌大人
Dialogue: 0,0:06:51.59,0:06:53.52,Default,,0,0,0,,怎麼會這樣
Dialogue: 0,0:06:53.52,0:06:54.81,Default,,0,0,0,,之後就拜託大家了
Dialogue: 0,0:06:55.04,0:06:58.36,Default,,0,0,0,,我這老骨頭活著也無益啊
Dialogue: 0,0:06:58.77,0:07:02.08,Default,,0,0,0,,這不是為了你們 是為了孩子們
Dialogue: 0,0:07:03.47,0:07:04.40,Default,,0,0,0,,城主
Dialogue: 0,0:07:05.03,0:07:06.50,Default,,0,0,0,,請恕罪
Dialogue: 0,0:07:06.60,0:07:09.02,Default,,0,0,0,,我明明就在城內…
Dialogue: 0,0:07:09.42,0:07:11.54,Default,,0,0,0,,{\pos(1332.8,1067)}卻成了這樣…
Dialogue: 0,0:07:09.31,0:07:11.54,Default,,0,0,0,,{\pos(536,1067)}不 都怪我
Dialogue: 0,0:07:11.61,0:07:13.92,Default,,0,0,0,,{\pos(536,1067)}我竟會成了人質
Dialogue: 0,0:07:11.84,0:07:13.06,Default,,0,0,0,,{\pos(1332.8,1067)}請恕罪
Dialogue: 0,0:07:15.04,0:07:17.09,Default,,0,0,0,,城主請恕罪
Dialogue: 0,0:07:19.49,0:07:20.20,Default,,0,0,0,,沒關係
Dialogue: 0,0:07:20.64,0:07:24.13,Default,,0,0,0,,感謝上天 你們還活著
Dialogue: 0,0:07:24.77,0:07:25.51,Default,,0,0,0,,劉冬
Dialogue: 0,0:07:27.16,0:07:28.01,Default,,0,0,0,,馬呈
Dialogue: 0,0:07:29.90,0:07:31.45,Default,,0,0,0,,彗就拜託你們照顧了
Dialogue: 0,0:07:34.42,0:07:35.28,Default,,0,0,0,,對了
Dialogue: 0,0:07:36.38,0:07:37.79,Default,,0,0,0,,這個還給你們
Dialogue: 0,0:07:38.56,0:07:40.84,Default,,0,0,0,,也象徵著你們的獨當一面
Dialogue: 0,0:07:43.03,0:07:47.20,Default,,0,0,0,,我名為善滿 奉王都邯鄲之命而來
Dialogue: 0,0:07:47.63,0:07:52.41,Default,,0,0,0,,此次人質交換 將在朝廷見證之下進行
Dialogue: 0,0:07:52.80,0:07:53.60,Default,,0,0,0,,這意味著
Dialogue: 0,0:07:53.68,0:07:55.08,Default,,0,0,0,,交換完成後
Dialogue: 0,0:07:55.27,0:08:01.46,Default,,0,0,0,,暗何不得以任何方式 加害離眼殘兵及老弱婦孺
Dialogue: 0,0:08:01.84,0:08:05.79,Default,,0,0,0,,若違背約定 則視為與朝廷為敵
Dialogue: 0,0:08:05.79,0:08:09.42,Default,,0,0,0,,我善滿軍將以武力給予制裁
Dialogue: 0,0:08:09.56,0:08:10.72,Default,,0,0,0,,明白了嗎
Dialogue: 0,0:08:12.00,0:08:15.72,Default,,0,0,0,,邯鄲若是更早派兵前來仲裁就好了
Dialogue: 0,0:08:17.74,0:08:18.63,Default,,0,0,0,,是嗎
Dialogue: 0,0:08:19.76,0:08:22.60,Default,,0,0,0,,他就是在旦虎擊殺了唐寒的紀彗啊
Dialogue: 0,0:08:23.73,0:08:25.44,Default,,0,0,0,,都綁上去
Dialogue: 0,0:08:32.37,0:08:38.96,Default,,0,0,0,,唐釣 謝謝你答應放過我兒子等人
Dialogue: 0,0:08:40.72,0:08:42.19,Default,,0,0,0,,你別誤會了
Dialogue: 0,0:08:42.69,0:08:45.21,Default,,0,0,0,,這是為了讓他們嚐嚐同樣的痛苦
Dialogue: 0,0:08:46.59,0:08:47.60,Default,,0,0,0,,是嗎
Dialogue: 0,0:08:47.98,0:08:49.65,Default,,0,0,0,,該死 該死的
Dialogue: 0,0:08:50.13,0:08:51.67,Default,,0,0,0,,點火
Dialogue: 0,0:08:55.04,0:08:55.76,Default,,0,0,0,,紀昌大人
Dialogue: 0,0:08:55.76,0:08:56.82,Default,,0,0,0,,父親
Dialogue: 0,0:08:56.82,0:08:58.98,Default,,0,0,0,,城主大人
Dialogue: 0,0:08:59.69,0:09:02.94,Default,,0,0,0,,彗就是離眼的新城主
Dialogue: 0,0:09:03.97,0:09:07.17,Default,,0,0,0,,他就是年輕的父親 眾人要輔佐他
Dialogue: 0,0:09:07.78,0:09:08.53,Default,,0,0,0,,是
Dialogue: 0,0:09:08.79,0:09:10.12,Default,,0,0,0,,城主
Dialogue: 0,0:09:10.12,0:09:11.78,Default,,0,0,0,,遵命
Dialogue: 0,0:09:14.06,0:09:15.13,Default,,0,0,0,,彗
Dialogue: 0,0:09:17.19,0:09:19.92,Default,,0,0,0,,保護好離眼的子民
Dialogue: 0,0:09:20.61,0:09:23.13,Default,,0,0,0,,託付給你了 吾兒
Dialogue: 0,0:09:25.69,0:09:27.88,Default,,0,0,0,,是 定不辱使命
Dialogue: 0,0:09:33.29,0:09:37.34,Default,,0,0,0,,所以紀彗之名才沒有外傳啊
Dialogue: 0,0:09:37.85,0:09:38.60,Default,,0,0,0,,對
Dialogue: 0,0:09:39.31,0:09:41.31,Default,,0,0,0,,那場處刑
Dialogue: 0,0:09:41.46,0:09:44.98,Default,,0,0,0,,幾乎殺死了所有作為離眼主心骨的成年人
Dialogue: 0,0:09:45.34,0:09:50.45,Default,,0,0,0,,而紀彗大人僅用五年就復興了離眼
Dialogue: 0,0:09:50.61,0:09:56.62,Default,,0,0,0,,又用三年擊敗暗何 成了這一帶的盟主
Dialogue: 0,0:09:57.56,0:10:01.75,Default,,0,0,0,,他為政以德 治下無人有怨言
Dialogue: 0,0:10:03.48,0:10:06.45,Default,,0,0,0,,那個人偶又是什麼
Dialogue: 0,0:10:07.10,0:10:12.01,Default,,0,0,0,,這是「守護兒」 是離眼自古以來的習俗
Dialogue: 0,0:10:12.59,0:10:18.82,Default,,0,0,0,,由孩子送給即將上前線的父親 充當護身符
Dialogue: 0,0:10:19.95,0:10:23.20,Default,,0,0,0,,砍傷我的劉冬拿著三個
Dialogue: 0,0:10:23.84,0:10:25.33,Default,,0,0,0,,所以他有三個孩子？
Dialogue: 0,0:10:25.82,0:10:27.90,Default,,0,0,0,,這我就不知道了
Dialogue: 0,0:10:29.04,0:10:31.99,Default,,0,0,0,,等等 你是被劉冬砍傷的？
Dialogue: 0,0:10:33.62,0:10:34.76,Default,,0,0,0,,也罷
Dialogue: 0,0:10:35.56,0:10:38.48,Default,,0,0,0,,總而言之 紀彗軍很強
Dialogue: 0,0:10:38.83,0:10:42.85,Default,,0,0,0,,紀昌時期就戰勝了五倍於己的暗何軍
Dialogue: 0,0:10:43.20,0:10:46.30,Default,,0,0,0,,而聽說他們現在要遠強於過去
Dialogue: 0,0:10:47.03,0:10:51.43,Default,,0,0,0,,而且為阻止敵人穿過黑羊 他們士氣也很高
Dialogue: 0,0:10:52.19,0:10:52.87,Default,,0,0,0,,怎麼樣
Dialogue: 0,0:10:53.25,0:10:57.12,Default,,0,0,0,,是不是覺得還是留在這裡別回部隊更好了
Dialogue: 0,0:10:57.70,0:10:58.49,Default,,0,0,0,,恰恰相反
Dialogue: 0,0:11:00.16,0:11:03.21,Default,,0,0,0,,既然是強敵 那我就更要回到同伴身邊
Dialogue: 0,0:11:04.72,0:11:06.20,Default,,0,0,0,,不論是怎樣的對手
Dialogue: 0,0:11:07.46,0:11:09.35,Default,,0,0,0,,我們都不能輸
Dialogue: 0,0:11:11.35,0:11:15.63,Default,,0,0,0,,黑羊第三天的夜晚 在近乎瘮人的安靜中漸深
Dialogue: 0,0:11:18.35,0:11:19.16,Default,,0,0,0,,夜過之後
Dialogue: 0,0:11:20.01,0:11:23.88,Default,,0,0,0,,第四天的朝陽 就像昭示著最激烈的戰鬥一般
Dialogue: 0,0:11:24.03,0:11:26.22,Default,,0,0,0,,如血般鮮紅
Dialogue: 0,0:11:33.63,0:11:34.51,Default,,0,0,0,,什麼？
Dialogue: 0,0:11:35.14,0:11:37.97,Default,,0,0,0,,要我們就這樣堅守在原地？
Dialogue: 0,0:11:38.54,0:11:39.39,Default,,0,0,0,,怎麼了？
Dialogue: 0,0:11:39.84,0:11:43.35,Default,,0,0,0,,好像桓騎將軍的傳令兵一大早就來了
Dialogue: 0,0:11:44.74,0:11:45.71,Default,,0,0,0,,我告訴你
Dialogue: 0,0:11:45.89,0:11:49.01,Default,,0,0,0,,都怪你老大白費了昨天的大好機會
Dialogue: 0,0:11:49.09,0:11:51.44,Default,,0,0,0,,這次是我們陷入絕境了
Dialogue: 0,0:11:51.85,0:11:54.79,Default,,0,0,0,,被我們甩掉的馬呈軍趁著夜晚追了上來
Dialogue: 0,0:11:54.79,0:11:56.70,Default,,0,0,0,,來到我們背後了
Dialogue: 0,0:11:57.21,0:11:58.18,Default,,0,0,0,,再說了
Dialogue: 0,0:11:58.18,0:12:00.88,Default,,0,0,0,,桓騎昨天為什麼沒行動
Dialogue: 0,0:12:01.65,0:12:03.04,Default,,0,0,0,,不許直呼頭兒的名字
Dialogue: 0,0:12:03.48,0:12:04.60,Default,,0,0,0,,等一下 信
Dialogue: 0,0:12:06.10,0:12:08.21,Default,,0,0,0,,不需要他下令
Dialogue: 0,0:12:08.58,0:12:12.24,Default,,0,0,0,,我本就打算在原地能撐多久是多久
Dialogue: 0,0:12:12.76,0:12:13.67,Default,,0,0,0,,理由是…
Dialogue: 0,0:12:14.48,0:12:18.92,Default,,0,0,0,,和昨天一樣 只要我們飛信隊留在這裡
Dialogue: 0,0:12:19.40,0:12:22.00,Default,,0,0,0,,戰局就對桓騎軍有利
Dialogue: 0,0:12:22.80,0:12:23.59,Default,,0,0,0,,但是
Dialogue: 0,0:12:23.73,0:12:27.89,Default,,0,0,0,,我們背後的敵人可不會放著我們不管
Dialogue: 0,0:12:28.23,0:12:29.39,Default,,0,0,0,,沒錯
Dialogue: 0,0:12:29.91,0:12:33.32,Default,,0,0,0,,關於這個 頭兒讓我帶話給你們
Dialogue: 0,0:12:33.58,0:12:34.53,Default,,0,0,0,,什麼話
Dialogue: 0,0:12:34.98,0:12:36.53,Default,,0,0,0,,他說會派遣援軍
Dialogue: 0,0:12:37.53,0:12:38.15,Default,,0,0,0,,援軍？
Dialogue: 0,0:12:40.47,0:12:42.00,Default,,0,0,0,,這話可信嗎
Dialogue: 0,0:12:42.43,0:12:43.66,Default,,0,0,0,,不知道
Dialogue: 0,0:12:47.92,0:12:48.96,Default,,0,0,0,,好吧
Dialogue: 0,0:12:49.56,0:12:52.92,Default,,0,0,0,,飛信隊會在這裡撐到撐不住為止
Dialogue: 0,0:12:53.42,0:12:55.81,Default,,0,0,0,,但我估計最多撐到中午
Dialogue: 0,0:12:56.20,0:13:00.30,Default,,0,0,0,,你轉告桓騎將軍 要派援軍就在中午之前
Dialogue: 0,0:13:01.29,0:13:02.38,Default,,0,0,0,,知道了
Dialogue: 0,0:13:07.52,0:13:10.35,Default,,0,0,0,,頭兒 要開始了
Dialogue: 0,0:13:14.27,0:13:15.68,Default,,0,0,0,,好了
Dialogue: 0,0:13:17.84,0:13:18.94,Default,,0,0,0,,擋住他們
Dialogue: 0,0:13:19.02,0:13:20.60,Default,,0,0,0,,給我衝
Dialogue: 0,0:13:23.31,0:13:24.63,Default,,0,0,0,,宰了他們
Dialogue: 0,0:13:24.63,0:13:25.41,Default,,0,0,0,,要來了
Dialogue: 0,0:13:26.24,0:13:29.23,Default,,0,0,0,,把昨天的仇加倍奉還
Dialogue: 0,0:13:30.76,0:13:32.75,Default,,0,0,0,,不要貿然接近馬呈
Dialogue: 0,0:13:33.17,0:13:36.59,Default,,0,0,0,,把弓箭手集中起來 放箭把他逼退
Dialogue: 0,0:13:38.32,0:13:39.20,Default,,0,0,0,,我們上
Dialogue: 0,0:13:41.76,0:13:42.34,Default,,0,0,0,,貂
Dialogue: 0,0:13:42.86,0:13:45.84,Default,,0,0,0,,我們不去後面真的沒問題嗎
Dialogue: 0,0:13:46.01,0:13:46.94,Default,,0,0,0,,沒問題
Dialogue: 0,0:13:47.11,0:13:51.19,Default,,0,0,0,,我們昨天先到這裡 事先佔據了所有有利地形
Dialogue: 0,0:13:51.35,0:13:53.35,Default,,0,0,0,,沒這麼容易被攻破
Dialogue: 0,0:13:53.95,0:13:55.90,Default,,0,0,0,,重點是前面
Dialogue: 0,0:13:56.17,0:14:00.44,Default,,0,0,0,,必須做好準備 桓騎將軍一下令就攻上山丘
Dialogue: 0,0:14:02.53,0:14:05.67,Default,,0,0,0,,桓騎他今天真的會下令嗎
Dialogue: 0,0:14:06.35,0:14:08.73,Default,,0,0,0,,話說援軍連影都沒有啊
Dialogue: 0,0:14:20.02,0:14:20.50,Default,,0,0,0,,大姐頭
Dialogue: 0,0:14:20.50,0:14:21.33,Default,,0,0,0,,閉嘴
Dialogue: 0,0:14:26.03,0:14:28.25,Default,,0,0,0,,敵軍沒有要出動的跡象
Dialogue: 0,0:14:28.81,0:14:30.74,Default,,0,0,0,,說不定桓騎今天也…
Dialogue: 0,0:14:33.35,0:14:35.21,Default,,0,0,0,,真是這樣也好
Dialogue: 0,0:14:36.28,0:14:41.01,Default,,0,0,0,,劉冬和馬呈追上飛信隊 使其威脅減半了
Dialogue: 0,0:14:42.24,0:14:45.17,Default,,0,0,0,,只要他們消滅或趕走飛信隊
Dialogue: 0,0:14:45.56,0:14:49.24,Default,,0,0,0,,我們就能集中攻擊前方的敵人了
Dialogue: 0,0:14:51.04,0:14:53.50,Default,,0,0,0,,雖然不知道你有何意圖
Dialogue: 0,0:14:54.26,0:14:57.47,Default,,0,0,0,,你就繼續保持不動吧 桓騎
Dialogue: 0,0:15:07.12,0:15:09.85,Default,,0,0,0,,河了貂 渕副長那裡危險了
Dialogue: 0,0:15:10.30,0:15:13.10,Default,,0,0,0,,楚水副長的預備兵也耗盡了
Dialogue: 0,0:15:13.44,0:15:14.60,Default,,0,0,0,,我知道
Dialogue: 0,0:15:15.00,0:15:17.86,Default,,0,0,0,,田有去支援渕叔 沛浪去支援楚水
Dialogue: 0,0:15:18.06,0:15:19.31,Default,,0,0,0,,好
Dialogue: 0,0:15:19.81,0:15:21.69,Default,,0,0,0,,可惡 可惡
Dialogue: 0,0:15:22.09,0:15:24.88,Default,,0,0,0,,桓騎那傢伙又打算不動嗎
Dialogue: 0,0:15:25.97,0:15:28.83,Default,,0,0,0,,截至此時 除飛信隊之外
Dialogue: 0,0:15:28.93,0:15:32.51,Default,,0,0,0,,其他戰場全都和前一天一樣 戰況膠著
Dialogue: 0,0:15:39.97,0:15:40.60,Default,,0,0,0,,但是
Dialogue: 0,0:15:44.50,0:15:45.64,Default,,0,0,0,,該死的
Dialogue: 0,0:15:49.09,0:15:50.34,Default,,0,0,0,,該死的
Dialogue: 0,0:15:52.73,0:15:57.26,Default,,0,0,0,,你竟如此執著地不想讓我捕捉到動向嗎 桓騎
Dialogue: 0,0:16:03.50,0:16:05.81,Default,,0,0,0,,那好啊 桓騎
Dialogue: 0,0:16:07.03,0:16:12.07,Default,,0,0,0,,既然你不動 那我就趁現在砍下你一條手臂
Dialogue: 0,0:16:12.18,0:16:14.75,Default,,0,0,0,,讓你真的無法動彈
Dialogue: 0,0:16:15.68,0:16:16.55,Default,,0,0,0,,陽央
Dialogue: 0,0:16:16.70,0:16:17.16,Default,,0,0,0,,在
Dialogue: 0,0:16:18.19,0:16:23.34,Default,,0,0,0,,你那礙眼的右翼 就像抵在我胸前的尖釘
Dialogue: 0,0:16:23.83,0:16:26.52,Default,,0,0,0,,我要去把那飛信隊趕盡殺絕
Dialogue: 0,0:16:31.03,0:16:32.70,Default,,0,0,0,,慶舍大人出動了？
Dialogue: 0,0:16:33.15,0:16:34.64,Default,,0,0,0,,敵 敵襲
Dialogue: 0,0:16:34.76,0:16:36.01,Default,,0,0,0,,人數好多
Dialogue: 0,0:16:36.01,0:16:37.35,Default,,0,0,0,,要 要來了
Dialogue: 0,0:16:41.34,0:16:42.73,Default,,0,0,0,,敵襲
Dialogue: 0,0:16:41.69,0:16:42.52,Default,,0,0,0,,{\pos(1352,1067)}是前面
Dialogue: 0,0:16:44.30,0:16:45.32,Default,,0,0,0,,毀滅吧
Dialogue: 0,0:16:47.48,0:16:48.95,Default,,0,0,0,,飛信隊
Dialogue: 0,0:16:54.19,0:16:56.29,Default,,0,0,0,,河了貂 危險 快退後
Dialogue: 0,0:16:56.29,0:16:57.29,Default,,0,0,0,,等等
Dialogue: 0,0:16:57.98,0:17:00.93,Default,,0,0,0,,這是想把我們一分為二 糟糕了
Dialogue: 0,0:17:01.59,0:17:05.95,Default,,0,0,0,,而且後方的楚水和渕叔他們正在和馬呈軍交戰
Dialogue: 0,0:17:07.16,0:17:09.03,Default,,0,0,0,,要是前方的敵人攻至我軍後方
Dialogue: 0,0:17:09.10,0:17:11.56,Default,,0,0,0,,整支部隊就會瞬間瓦解
Dialogue: 0,0:17:12.14,0:17:14.65,Default,,0,0,0,,全力擋住前方攻來的敵軍
Dialogue: 0,0:17:14.65,0:17:16.52,Default,,0,0,0,,不能讓他們攻至後方
Dialogue: 0,0:17:16.67,0:17:18.36,Default,,0,0,0,,不 不行啊 河了貂
Dialogue: 0,0:17:18.36,0:17:19.92,Default,,0,0,0,,這裡也很危險
Dialogue: 0,0:17:19.92,0:17:21.14,Default,,0,0,0,,要 要來了
Dialogue: 0,0:17:21.82,0:17:22.65,Default,,0,0,0,,信
Dialogue: 0,0:17:23.02,0:17:23.98,Default,,0,0,0,,我去了
Dialogue: 0,0:17:24.39,0:17:25.19,Default,,0,0,0,,信
Dialogue: 0,0:17:29.86,0:17:31.41,Default,,0,0,0,,我呂 岳雷
Dialogue: 0,0:17:31.62,0:17:32.87,Default,,0,0,0,,別高興太早
Dialogue: 0,0:17:33.24,0:17:36.87,Default,,0,0,0,,僅憑我們撐不了太久
Dialogue: 0,0:17:42.67,0:17:44.02,Default,,0,0,0,,敵軍不僅人數多
Dialogue: 0,0:17:44.13,0:17:46.83,Default,,0,0,0,,而且每個人都很強
Dialogue: 0,0:17:54.48,0:17:55.96,Default,,0,0,0,,那個人是誰
Dialogue: 0,0:17:56.78,0:17:57.75,Default,,0,0,0,,慶字…
Dialogue: 0,0:17:59.08,0:18:02.46,Default,,0,0,0,,難道他就是趙軍主將？
Dialogue: 0,0:18:03.08,0:18:05.81,Default,,0,0,0,,那個手持長刀的年輕男子就是信
Dialogue: 0,0:18:08.65,0:18:12.57,Default,,0,0,0,,李牧大人指名將桓騎與他列為目標
Dialogue: 0,0:18:13.56,0:18:15.83,Default,,0,0,0,,定要取他首級
Dialogue: 0,0:18:18.28,0:18:19.85,Default,,0,0,0,,終 終於…
Dialogue: 0,0:18:20.94,0:18:24.62,Default,,0,0,0,,李牧終於還是把信視為威脅了嗎
Dialogue: 0,0:18:26.90,0:18:27.73,Default,,0,0,0,,李牧…
Dialogue: 0,0:18:28.97,0:18:31.48,Default,,0,0,0,,我甚至嫌你太慢 混蛋
Dialogue: 0,0:18:32.43,0:18:34.40,Default,,0,0,0,,怕你不成
Dialogue: 0,0:18:34.51,0:18:36.85,Default,,0,0,0,,有本事就來取啊
Dialogue: 0,0:18:37.96,0:18:39.35,Default,,0,0,0,,河了貂
Dialogue: 0,0:18:39.67,0:18:40.76,Default,,0,0,0,,我知道
Dialogue: 0,0:18:40.98,0:18:42.65,Default,,0,0,0,,我們撤離這裡
Dialogue: 0,0:18:42.65,0:18:44.87,Default,,0,0,0,,我去後方指揮撤退
Dialogue: 0,0:18:45.45,0:18:47.99,Default,,0,0,0,,你們想辦法爭取時間
Dialogue: 0,0:18:49.28,0:18:50.53,Default,,0,0,0,,快點啊
Dialogue: 0,0:18:51.80,0:18:52.53,Default,,0,0,0,,劉冬大人
Dialogue: 0,0:18:52.92,0:18:55.35,Default,,0,0,0,,山上下來一支騎兵 正攻擊飛信隊前方
Dialogue: 0,0:18:55.47,0:18:57.03,Default,,0,0,0,,紀彗大人終於行動了？
Dialogue: 0,0:18:57.71,0:18:58.55,Default,,0,0,0,,不對
Dialogue: 0,0:18:58.66,0:19:01.95,Default,,0,0,0,,那是山丘後方的慶舍大人的精銳部隊
Dialogue: 0,0:19:02.87,0:19:05.04,Default,,0,0,0,,而且幾乎全部出動了
Dialogue: 0,0:19:05.46,0:19:09.71,Default,,0,0,0,,主將慶舍打算一舉消滅飛信隊
Dialogue: 0,0:19:10.31,0:19:11.21,Default,,0,0,0,,配合友軍
Dialogue: 0,0:19:11.80,0:19:14.16,Default,,0,0,0,,後方部隊朝兩側展開
Dialogue: 0,0:19:14.16,0:19:15.72,Default,,0,0,0,,將敵軍徹底包圍
Dialogue: 0,0:19:16.44,0:19:17.63,Default,,0,0,0,,也去告訴馬呈
Dialogue: 0,0:19:17.76,0:19:18.31,Default,,0,0,0,,是
Dialogue: 0,0:19:18.52,0:19:20.10,Default,,0,0,0,,不要放跑一個人
Dialogue: 0,0:19:20.24,0:19:21.34,Default,,0,0,0,,是
Dialogue: 0,0:19:23.25,0:19:26.35,Default,,0,0,0,,居然還有 慶舍大人的騎兵好多啊
Dialogue: 0,0:19:26.55,0:19:29.86,Default,,0,0,0,,和第一天一樣 每次出動都置敵於死地
Dialogue: 0,0:19:31.49,0:19:34.92,Default,,0,0,0,,城主 這下飛信隊就不堪一擊了
Dialogue: 0,0:19:36.00,0:19:38.20,Default,,0,0,0,,確實不堪一擊
Dialogue: 0,0:19:38.52,0:19:42.52,Default,,0,0,0,,慶舍大人出動了幾乎整個主力部隊
Dialogue: 0,0:19:42.94,0:19:46.08,Default,,0,0,0,,劉冬和馬呈也加以配合 正在展開包圍網
Dialogue: 0,0:19:47.04,0:19:49.31,Default,,0,0,0,,從上方看就很清楚
Dialogue: 0,0:19:49.81,0:19:52.37,Default,,0,0,0,,飛信隊沒有一條活路
Dialogue: 0,0:19:54.11,0:19:56.77,Default,,0,0,0,,但是為什麼 總覺得有點不對勁
Dialogue: 0,0:19:58.05,0:20:00.16,Default,,0,0,0,,不是飛信隊
Dialogue: 0,0:20:01.14,0:20:02.56,Default,,0,0,0,,而是慶舍大人
Dialogue: 0,0:20:03.61,0:20:07.37,Default,,0,0,0,,不 這次突襲毫無疑問是上策
Dialogue: 0,0:20:07.72,0:20:11.51,Default,,0,0,0,,因為桓騎軍會因此而失去右翼
Dialogue: 0,0:20:13.00,0:20:16.79,Default,,0,0,0,,但是 總覺得有些不對勁
Dialogue: 0,0:20:18.33,0:20:19.83,Default,,0,0,0,,其實此時
Dialogue: 0,0:20:20.07,0:20:22.83,Default,,0,0,0,,因慶舍出動而心有不安者
Dialogue: 0,0:20:22.94,0:20:25.28,Default,,0,0,0,,除紀彗外還有一人
Dialogue: 0,0:20:26.22,0:20:29.79,Default,,0,0,0,,那就是長年跟隨慶舍左右的金毛
Dialogue: 0,0:20:30.62,0:20:32.88,Default,,0,0,0,,山丘另一側的探子來報
Dialogue: 0,0:20:33.34,0:20:36.30,Default,,0,0,0,,慶舍大人的精銳部隊正在攻擊飛信隊
Dialogue: 0,0:20:36.45,0:20:39.76,Default,,0,0,0,,飛信隊似乎已經陷入絕境
Dialogue: 0,0:20:41.39,0:20:42.55,Default,,0,0,0,,那是當然
Dialogue: 0,0:20:42.69,0:20:46.02,Default,,0,0,0,,居然貿然闖入我軍腹地 一群蠢貨
Dialogue: 0,0:20:46.74,0:20:50.99,Default,,0,0,0,,怎麼回事 桓騎應該沒有動靜才對啊
Dialogue: 0,0:20:51.97,0:20:54.00,Default,,0,0,0,,您怎麼了 副將
Dialogue: 0,0:20:54.21,0:20:57.88,Default,,0,0,0,,和第一天一樣 慶舍大人親自出馬
Dialogue: 0,0:20:58.10,0:21:00.41,Default,,0,0,0,,這場戰鬥 慶舍大人狀態絕佳啊
Dialogue: 0,0:21:00.50,0:21:01.20,Default,,0,0,0,,是啊
Dialogue: 0,0:21:01.78,0:21:02.85,Default,,0,0,0,,蠢貨
Dialogue: 0,0:21:04.11,0:21:05.88,Default,,0,0,0,,這和第一天完全不同
Dialogue: 0,0:21:06.94,0:21:11.60,Default,,0,0,0,,第一天是桓騎軍左翼進入了「網」中
Dialogue: 0,0:21:11.60,0:21:12.60,Default,,0,0,0,,他才前去獵殺
Dialogue: 0,0:21:13.48,0:21:18.17,Default,,0,0,0,,但是 這次或許與獵殺桓騎的網無關
Dialogue: 0,0:21:18.79,0:21:21.46,Default,,0,0,0,,而是為了除去礙眼的飛信隊而出動
Dialogue: 0,0:21:22.89,0:21:27.64,Default,,0,0,0,,在旁人看來 飛信隊或許也是誤入網中的獵物
Dialogue: 0,0:21:29.00,0:21:31.69,Default,,0,0,0,,但在我看來 這是慶舍大人的焦躁之舉
Dialogue: 0,0:21:32.60,0:21:36.23,Default,,0,0,0,,是因未能感受到桓騎的氣息 而發起的報復
Dialogue: 0,0:21:38.26,0:21:42.35,Default,,0,0,0,,桓騎面對昨天的最好機會都沒有行動
Dialogue: 0,0:21:42.80,0:21:46.47,Default,,0,0,0,,他一直銷聲匿跡 定是激怒了慶舍大人
Dialogue: 0,0:21:47.92,0:21:52.48,Default,,0,0,0,,我跟隨慶舍大人多年 還是第一次見到他這樣
Dialogue: 0,0:22:01.27,0:22:04.91,Default,,0,0,0,,我想到了一件令人發毛的事
Dialogue: 0,0:22:06.19,0:22:08.60,Default,,0,0,0,,看到慶舍大人親自出馬
Dialogue: 0,0:22:09.37,0:22:13.87,Default,,0,0,0,,桓騎此刻會不會露出了笑容
Dialogue: 0,0:22:16.14,0:22:18.88,Default,,0,0,0,,被俘的敵兵說
Dialogue: 0,0:22:19.04,0:22:23.96,Default,,0,0,0,,慶舍是「沉默的獵人」 很擅於「等待」
Dialogue: 0,0:22:24.75,0:22:28.65,Default,,0,0,0,,每一場戰鬥中 都會悄悄設下陷阱
Dialogue: 0,0:22:28.94,0:22:31.69,Default,,0,0,0,,等敵人先行動 再將其獵殺
Dialogue: 0,0:22:32.36,0:22:38.07,Default,,0,0,0,,所以他每次都能把敵人玩弄於股掌 將其擊敗
Dialogue: 0,0:22:39.78,0:22:41.13,Default,,0,0,0,,還挺可怕
Dialogue: 0,0:22:42.04,0:22:44.96,Default,,0,0,0,,但越是這樣的人
Dialogue: 0,0:22:45.08,0:22:49.16,Default,,0,0,0,,越是會被我玩弄於股掌丟掉性命
Dialogue: 0,0:22:49.36,0:22:51.08,Default,,0,0,0,,把屎拉褲襠裡
Dialogue: 0,0:22:51.08,0:22:52.29,Default,,0,0,0,,對吧 俚玉
Dialogue: 0,0:22:52.48,0:22:53.52,Default,,0,0,0,,是啊
Dialogue: 0,0:22:54.68,0:22:55.94,Default,,0,0,0,,屎拉褲襠
Dialogue: 0,0:22:56.93,0:22:58.90,Default,,0,0,0,,沉默的獵人？
Dialogue: 0,0:22:59.98,0:23:04.57,Default,,0,0,0,,這麼快就紅著眼出動了 小嘍囉
Dialogue: 0,0:23:10.83,0:23:11.61,Default,,0,0,0,,澤諾？
Dialogue: 0,0:23:12.50,0:23:15.68,Default,,0,0,0,,借個道 黑櫻
Dialogue: 0,0:24:49.92,0:24:51.60,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:51.96,0:24:53.72,Default,,0,0,0,,「皆在一瞬間」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

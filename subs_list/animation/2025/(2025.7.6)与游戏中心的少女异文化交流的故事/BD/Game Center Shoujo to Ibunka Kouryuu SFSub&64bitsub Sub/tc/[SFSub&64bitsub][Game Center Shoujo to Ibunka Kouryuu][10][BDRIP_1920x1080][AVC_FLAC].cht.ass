Dialogue: 0,0:22:18.73,0:22:19.73,Title,ED,0,0,0,,{\an8\pos(960,600)\fnCubic 11\fs70\c&HFAFDFF&\4c&H0CB1CF&\4a&00&\bord0\shad4}遊樂場少女的異文化交流
Dialogue: 0,0:22:05.55,0:22:07.26,EDJP,ED,0,0,0,,Chance！ Chance！ Chance！ つかめ
Dialogue: 0,0:22:07.26,0:22:09.06,EDJP,ED,0,0,0,,Luck！ Luck！ Luck！ パワー
Dialogue: 0,0:22:09.06,0:22:11.64,EDJP,ED,0,0,0,,Up！ Up！ Up！ Right Here, Right Now.
Dialogue: 0,0:22:12.56,0:22:14.44,EDJP,ED,0,0,0,,Fight！ Fight！ Fight！ 欲張れ
Dialogue: 0,0:22:14.44,0:22:15.56,EDJP,ED,0,0,0,,Beat Down！ Down！ Down！
Dialogue: 0,0:22:15.56,0:22:18.73,EDJP,ED,0,0,0,,いざEn-Joy！ Joy！ Joy！ Let's Get Over！
Dialogue: 0,0:22:19.73,0:22:22.57,EDJP,ED,0,0,0,,クレジット入れた瞬間に
Dialogue: 0,0:22:23.45,0:22:26.20,EDJP,ED,0,0,0,,広がる世界 interaction
Dialogue: 0,0:22:26.83,0:22:28.41,EDJP,ED,0,0,0,,What a fresh experience！
Dialogue: 0,0:22:28.41,0:22:31.37,EDJP,ED,0,0,0,,いつの間にかみんなで
Dialogue: 0,0:22:31.37,0:22:33.50,EDJP,ED,0,0,0,,楽しんだり
Dialogue: 0,0:22:34.83,0:22:36.88,EDJP,ED,0,0,0,,熱くなったり
Dialogue: 0,0:22:38.34,0:22:40.26,EDJP,ED,0,0,0,,ハマったり
Dialogue: 0,0:22:41.88,0:22:46.26,EDJP,ED,0,0,0,,ボコボコにやられてへこんだりと
Comment: 0,0:22:46.26,0:22:52.85,EDJP,ED,0,0,0,karaoke,{\k0}作る思い出　賑わうこの{\k0}空間|<ばしょ{\k0}で
Dialogue: 0,0:22:46.26,0:22:52.85,EDJP,ED,0,0,0,,作る思い出　賑わうこの空間で
Dialogue: 0,0:22:53.10,0:22:56.52,EDJP,ED,0,0,0,,たまには Like a superhero に
Dialogue: 0,0:22:56.52,0:23:02.69,EDJP,ED,0,0,0,,誰でもなれるかもしれない
Dialogue: 0,0:23:04.20,0:23:05.70,EDJP,ED,0,0,0,,Anytime we enjoy them！
Dialogue: 0,0:23:05.70,0:23:07.49,EDJP,ED,0,0,0,,Anytime we love it all！
Dialogue: 0,0:23:07.49,0:23:10.95,EDJP,ED,0,0,0,,日々更新される楽しさの理論値
Dialogue: 0,0:23:10.95,0:23:12.79,EDJP,ED,0,0,0,,So here's the wonderland！
Dialogue: 0,0:23:12.79,0:23:14.41,EDJP,ED,0,0,0,,Why don't you come with me？
Dialogue: 0,0:23:14.41,0:23:18.34,EDJP,ED,0,0,0,,失敗してもう一回　次も一緒にね
Dialogue: 0,0:23:18.34,0:23:20.21,EDJP,ED,0,0,0,,Chance！ Chance！ Chance！ つかめ
Dialogue: 0,0:23:20.21,0:23:21.92,EDJP,ED,0,0,0,,Luck！ Luck！ Luck！ パワー
Dialogue: 0,0:23:21.92,0:23:24.47,EDJP,ED,0,0,0,,Up！ Up！ Up！ Right Here, Right Now.
Dialogue: 0,0:23:24.47,0:23:25.43,EDJP,ED,0,0,0,,(Oh my gosh！)
Dialogue: 0,0:23:25.43,0:23:28.43,EDJP,ED,0,0,0,,Uh！ Oh！ Oh！ もう It's Time Up！ Up！ Up！
Dialogue: 0,0:23:28.43,0:23:33.77,EDJP,ED,0,0,0,,それじゃまた明日もここで　See you again！
Dialogue: 0,0:22:05.55,0:22:07.26,EDCHT,ED,0,0,0,,Chance！ Chance！ Chance！ 把握機會
Dialogue: 0,0:22:07.26,0:22:09.06,EDCHT,ED,0,0,0,,Luck！ Luck！ Luck！ 充滿力量
Dialogue: 0,0:22:09.06,0:22:11.64,EDCHT,ED,0,0,0,,Up！ Up！ Up！ Right Here, Right Now.
Dialogue: 0,0:22:12.56,0:22:14.44,EDCHT,ED,0,0,0,,Fight！ Fight！ Fight！ 不要吝嗇慾望
Dialogue: 0,0:22:14.44,0:22:15.56,EDCHT,ED,0,0,0,,Beat Down！ Down！ Down！
Dialogue: 0,0:22:15.56,0:22:18.73,EDCHT,ED,0,0,0,,來吧 En-Joy！ Joy！ Joy！ Let's Get Over！
Dialogue: 0,0:22:19.73,0:22:22.57,EDCHT,ED,0,0,0,,投下代幣的那一瞬間
Dialogue: 0,0:22:23.45,0:22:26.20,EDCHT,ED,0,0,0,,展開嶄新世界 interaction
Dialogue: 0,0:22:26.83,0:22:28.41,EDCHT,ED,0,0,0,,What a fresh experience！
Dialogue: 0,0:22:28.41,0:22:31.37,EDCHT,ED,0,0,0,,不知不覺間大家也一起
Dialogue: 0,0:22:31.37,0:22:33.50,EDCHT,ED,0,0,0,,享受其中
Dialogue: 0,0:22:34.83,0:22:36.88,EDCHT,ED,0,0,0,,熱血沸騰
Dialogue: 0,0:22:38.34,0:22:40.26,EDCHT,ED,0,0,0,,上癮不已
Dialogue: 0,0:22:41.88,0:22:46.26,EDCHT,ED,0,0,0,,被虐得體無完膚 意志消沉
Dialogue: 0,0:22:46.26,0:22:52.85,EDCHT,ED,0,0,0,,但也一起創造回憶 在這熱鬧的空間中
Dialogue: 0,0:22:53.10,0:22:56.52,EDCHT,ED,0,0,0,,偶爾 Like a superhero
Dialogue: 0,0:22:56.52,0:23:02.69,EDCHT,ED,0,0,0,,說不定任何人都有機會成為主角
Dialogue: 0,0:23:04.20,0:23:05.70,EDCHT,ED,0,0,0,,Anytime we enjoy them！
Dialogue: 0,0:23:05.70,0:23:07.49,EDCHT,ED,0,0,0,,Anytime we love it all！
Dialogue: 0,0:23:07.49,0:23:10.95,EDCHT,ED,0,0,0,,每天都在更新的樂趣理論值
Dialogue: 0,0:23:10.95,0:23:12.79,EDCHT,ED,0,0,0,,So here's the wonderland！
Dialogue: 0,0:23:12.79,0:23:14.41,EDCHT,ED,0,0,0,,Why don't you come with me？
Dialogue: 0,0:23:14.41,0:23:18.34,EDCHT,ED,0,0,0,,即使失敗再一次 下次也一起挑戰吧！
Dialogue: 0,0:23:18.34,0:23:20.21,EDCHT,ED,0,0,0,,Chance！ Chance！ Chance！ 抓住它
Dialogue: 0,0:23:20.21,0:23:21.92,EDCHT,ED,0,0,0,,Luck！ Luck！ Luck！ 是力量
Dialogue: 0,0:23:21.92,0:23:24.47,EDCHT,ED,0,0,0,,Up！ Up！ Up！ Right Here, Right Now.
Dialogue: 0,0:23:24.47,0:23:25.43,EDCHT,ED,0,0,0,,（Oh my gosh！）
Dialogue: 0,0:23:25.43,0:23:28.43,EDCHT,ED,0,0,0,,Uh！ Oh！ Oh！ 已經 It's Time Up！ Up！ Up！
Dialogue: 0,0:23:28.43,0:23:33.77,EDCHT,ED,0,0,0,,那麼明天再來這裡見吧 See you again！

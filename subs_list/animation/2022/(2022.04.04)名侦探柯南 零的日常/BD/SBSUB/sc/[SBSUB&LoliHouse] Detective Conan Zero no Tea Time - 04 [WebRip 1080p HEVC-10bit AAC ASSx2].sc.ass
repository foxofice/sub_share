Comment: 0,0:01:53.00,0:01:53.00,TEATIME-OP-BOTTOM,,0,0,0,,
Dialogue: 0,0:01:52.00,0:01:54.05,TEATIME-OP-BOTTOM,,0,0,0,,Get the Volume up
Dialogue: 0,0:01:54.05,0:01:55.92,TEATIME-OP-BOTTOM,,0,0,0,,飞驰于失去色彩的Highway
Dialogue: 0,0:01:55.92,0:01:59.97,TEATIME-OP-BOTTOM,,0,0,0,,在停滞的时间中 turn me on
Dialogue: 0,0:01:59.97,0:02:02.18,TEATIME-OP-BOTTOM,,0,0,0,,the truth is always blind
Dialogue: 0,0:02:02.18,0:02:04.10,TEATIME-OP-BOTTOM,,0,0,0,,虚假的话语
Dialogue: 0,0:02:04.10,0:02:08.19,TEATIME-OP-BOTTOM,,0,0,0,,也重叠于今日 声音消散
Dialogue: 0,0:02:08.94,0:02:10.65,TEATIME-OP-BOTTOM,,0,0,0,,急切渴求的理由
Dialogue: 0,0:02:10.94,0:02:13.40,TEATIME-OP-BOTTOM,,0,0,0,,也在城市天空的尽头
Dialogue: 0,0:02:13.40,0:02:17.70,TEATIME-OP-BOTTOM,,0,0,0,,清晰可见
Dialogue: 0,0:02:17.70,0:02:20.24,TEATIME-OP-BOTTOM,,0,0,0,,世界Like a Shooting Star
Dialogue: 0,0:02:20.24,0:02:22.28,TEATIME-OP-BOTTOM,,0,0,0,,若知晓心愿
Dialogue: 0,0:02:22.28,0:02:24.08,TEATIME-OP-BOTTOM,,0,0,0,,不论何人
Dialogue: 0,0:02:24.08,0:02:26.54,TEATIME-OP-BOTTOM,,0,0,0,,都会深陷瞬间而永恒的梦
Dialogue: 0,0:02:26.54,0:02:28.12,TEATIME-OP-BOTTOM,,0,0,0,,若知晓「哀伤」
Dialogue: 0,0:02:28.12,0:02:30.42,TEATIME-OP-BOTTOM,,0,0,0,,便能回归零点Tears in Lies
Dialogue: 0,0:02:30.42,0:02:34.13,TEATIME-OP-BOTTOM,,0,0,0,,即便知晓善恶之罪
Dialogue: 0,0:02:34.13,0:02:40.93,TEATIME-OP-BOTTOM,,0,0,0,,也要抬头锁定目标
Comment: 0,0:12:13.75,0:12:16.76,TEATIME-ED-BOTTOM,,0,0,0,,
Dialogue: 0,0:12:16.84,0:12:21.80,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	无色透明的我
Dialogue: 0,0:12:22.22,0:12:26.76,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	驻足于绯红的天空下
Dialogue: 0,0:12:27.76,0:12:34.60,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便憎恶这不近人情的世界
Dialogue: 0,0:12:35.02,0:12:38.69,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也无法逃离 Decided
Dialogue: 0,0:12:39.53,0:12:44.07,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	将手伸向光芒
Dialogue: 0,0:12:39.53,0:12:44.07,TEATIME-ED-BOTTOM,ED,0,0,0,,{\pos(1034,1032)}	{\blur3\fs34}	明天
Dialogue: 0,0:12:44.07,0:12:49.03,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday
Dialogue: 0,0:12:49.03,0:12:54.33,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	不懈追逐 仍遥不可及
Dialogue: 0,0:12:54.33,0:12:59.96,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便想要守护之物不复存在
Dialogue: 0,0:13:00.13,0:13:04.59,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也只能继续挣扎
Dialogue: 0,0:13:04.59,0:13:06.09,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	你听
Dialogue: 0,0:13:06.09,0:13:10.85,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, promise to yourself
Dialogue: 0,0:13:10.85,0:13:16.31,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	用无数张面孔涂改未来
Dialogue: 0,0:13:16.31,0:13:23.94,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3\fad(0,200}	将一去不返的时光深藏于心
Comment: 0,0:03:08.00,0:03:08.00,Title,,0,0,0,,
Dialogue: 0,0:01:52.00,0:01:54.05,TEATIME-OP-TOP,,0,0,0,,Get the Volume up
Dialogue: 0,0:01:54.05,0:01:55.92,TEATIME-OP-TOP,,0,0,0,,色を無くしたHighway
Dialogue: 0,0:01:55.92,0:01:59.97,TEATIME-OP-TOP,,0,0,0,,止まってしまった時間に turn me on
Dialogue: 0,0:01:59.97,0:02:02.18,TEATIME-OP-TOP,,0,0,0,,the truth is always blind
Dialogue: 0,0:02:02.18,0:02:04.10,TEATIME-OP-TOP,,0,0,0,,偽りの声も
Dialogue: 0,0:02:04.10,0:02:08.19,TEATIME-OP-TOP,,0,0,0,,重なる今日に音が消える
Dialogue: 0,0:02:08.94,0:02:10.65,TEATIME-OP-TOP,,0,0,0,,焦がれ求む理由も
Dialogue: 0,0:02:10.94,0:02:13.40,TEATIME-OP-TOP,,0,0,0,,街の空の果てに
Dialogue: 0,0:02:13.40,0:02:17.70,TEATIME-OP-TOP,,0,0,0,,見える
Dialogue: 0,0:02:17.70,0:02:20.24,TEATIME-OP-TOP,,0,0,0,,世界はLike a Shooting Star
Dialogue: 0,0:02:20.24,0:02:22.28,TEATIME-OP-TOP,,0,0,0,,願いを知れば
Dialogue: 0,0:02:22.28,0:02:24.08,TEATIME-OP-TOP,,0,0,0,,一瞬が永遠の
Dialogue: 0,0:02:24.08,0:02:26.54,TEATIME-OP-TOP,,0,0,0,,夢に誰も捉われる
Dialogue: 0,0:02:26.54,0:02:28.12,TEATIME-OP-TOP,,0,0,0,,「哀」を知れば
Dialogue: 0,0:02:28.12,0:02:30.42,TEATIME-OP-TOP,,0,0,0,,ゼロに戻るTears in Lies
Dialogue: 0,0:02:30.42,0:02:34.13,TEATIME-OP-TOP,,0,0,0,,善悪の罪を知る
Dialogue: 0,0:02:34.13,0:02:40.93,TEATIME-OP-TOP,,0,0,0,,それでも顔上げ狙い定める
Dialogue: 0,0:02:13.07,0:02:13.07,Title,,0,0,0,,
Comment: 0,0:03:08.00,0:03:08.00,Title,,0,0,0,,
Dialogue: 0,0:12:16.84,0:12:21.80,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	透明な僕をみていた
Dialogue: 0,0:12:22.22,0:12:26.76,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	空があかく染まって
Dialogue: 0,0:12:27.76,0:12:34.60,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	不条理を憎んでもここからは
Dialogue: 0,0:12:35.02,0:12:38.69,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	逃げ出せないから Decided
Dialogue: 0,0:12:39.53,0:12:44.07,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	光へ手をのばして
Dialogue: 0,0:12:39.53,0:12:44.07,TEATIME-ED-TOP,ED,0,0,0,,{\pos(842,3)}	{\blur3\fs28}	あした
Dialogue: 0,0:12:44.07,0:12:49.03,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday
Dialogue: 0,0:12:49.03,0:12:54.33,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	追いかけても追いかけても　未だ
Dialogue: 0,0:12:54.33,0:12:59.96,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	守りたいものさえ消えていくけど
Dialogue: 0,0:13:00.13,0:13:04.59,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	足掻き続けるしかないの
Dialogue: 0,0:13:04.59,0:13:06.09,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	ねぇ、聞いて
Dialogue: 0,0:13:06.09,0:13:10.85,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	Find the truth, promise to yourself
Dialogue: 0,0:13:10.85,0:13:16.31,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	いくつもの顔で塗り変えて行く未来
Dialogue: 0,0:13:16.31,0:13:23.94,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3\fad(0,200)}	戻らない時間を胸にそっとしまって

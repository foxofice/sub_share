Dialogue: 1,0:00:00.56,0:00:03.98,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:00:04.43,0:00:07.94,CN - Top,,0,0,0,,喂 我的饺子
Dialogue: 1,0:00:08.23,0:00:09.86,CN,,0,0,0,,是我牙丸
Dialogue: 1,0:00:09.86,0:00:10.90,CN,,0,0,0,,正确
Dialogue: 1,0:00:10.90,0:00:11.82,CN,,0,0,0,,真像啊
Dialogue: 1,0:00:13.40,0:00:14.90,CN,,0,0,0,,在干啥呢？
Dialogue: 1,0:00:14.90,0:00:17.24,CN,,0,0,0,,是「我在模仿谁」大赛
Dialogue: 1,0:00:17.24,0:00:19.53,CN,,0,0,0,,好 下一个轮到我
Dialogue: 1,0:00:19.91,0:00:21.79,CN,,0,0,0,,就算背叛也要赢
Dialogue: 1,0:00:21.79,0:00:24.25,CN,,0,0,0,,辛苦了 Z队
Dialogue: 1,0:00:24.25,0:00:25.71,CN,,0,0,0,,久远
Dialogue: 1,0:00:25.71,0:00:28.63,CN,,0,0,0,,正确 辛苦辣
Dialogue: 1,0:00:28.63,0:00:30.63,CN,,0,0,0,,这谁都能做到吧
Dialogue: 1,0:00:30.63,0:00:32.80,CN,,0,0,0,,那下一个 千切
Dialogue: 1,0:00:33.51,0:00:34.84,CN,,0,0,0,,我就不了吧
Dialogue: 1,0:00:34.84,0:00:37.68,CN,,0,0,0,,快点 害羞鬼
Dialogue: 1,0:00:37.68,0:00:40.76,CN,,0,0,0,,耶 大小姐的出道模仿秀
Dialogue: 1,0:00:40.76,0:00:42.39,CN,,0,0,0,,那…
Dialogue: 1,0:00:44.73,0:00:49.31,CN,,0,0,0,,想玩好朋友过家家的话 滚
Dialogue: 1,0:00:49.31,0:00:51.11,CN,,0,0,0,,冠军
Dialogue: 1,0:00:51.11,0:00:53.28,CN,,0,0,0,,服了 大小姐
Dialogue: 1,0:00:53.28,0:00:57.57,CN,,0,0,0,,滚
Dialogue: 1,0:00:44.73,0:00:49.31,Ruby,,0,0,0,,{\pos(1242,975)}lock off
Dialogue: 1,0:00:53.28,0:00:57.57,Ruby,,0,0,0,,{\pos(960,975)}lock off
Dialogue: 0,0:00:00.56,0:00:03.98,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:00:04.43,0:00:07.94,JP - Top,,0,0,0,,おーい　俺の餃子～
Dialogue: 0,0:00:08.23,0:00:09.86,JP,,0,0,0,,我牙丸だ　我牙丸
Dialogue: 0,0:00:09.86,0:00:10.90,JP,,0,0,0,,正解
Dialogue: 0,0:00:10.90,0:00:11.82,JP,,0,0,0,,似てる
Dialogue: 0,0:00:13.40,0:00:14.90,JP,,0,0,0,,何やってんの？
Dialogue: 0,0:00:14.90,0:00:17.24,JP,,0,0,0,,誰のモノマネでしょうか選手権
Dialogue: 0,0:00:17.24,0:00:19.53,JP,,0,0,0,,はいはーい　次　俺やる
Dialogue: 0,0:00:19.91,0:00:21.79,JP,,0,0,0,,裏切ってでも勝つ
Dialogue: 0,0:00:21.79,0:00:24.25,JP,,0,0,0,,お疲れ　チームＺ
Dialogue: 0,0:00:24.25,0:00:25.71,JP,,0,0,0,,久遠
Dialogue: 0,0:00:25.71,0:00:28.63,JP,,0,0,0,,正解　お疲れちゃん
Dialogue: 0,0:00:28.63,0:00:30.63,JP,,0,0,0,,いや　誰でもできるだろ
Dialogue: 0,0:00:30.63,0:00:32.80,JP,,0,0,0,,じゃ　次　千切ね
Dialogue: 0,0:00:33.51,0:00:34.84,JP,,0,0,0,,いいよ俺は
Dialogue: 0,0:00:34.84,0:00:37.68,JP,,0,0,0,,やれやれ　引っ込み思案
Dialogue: 0,0:00:37.68,0:00:40.76,JP,,0,0,0,,イェイ　お嬢のモノマネデビュー
Dialogue: 0,0:00:40.76,0:00:42.39,JP,,0,0,0,,え～っと
Dialogue: 0,0:00:44.73,0:00:49.31,JP,,0,0,0,,仲良し絆ごっこしたいなら　ロック・オフ
Dialogue: 0,0:00:49.31,0:00:51.11,JP,,0,0,0,,優勝
Dialogue: 0,0:00:51.11,0:00:53.28,JP,,0,0,0,,参りました　お嬢
Dialogue: 0,0:00:53.28,0:00:57.57,JP,,0,0,0,,ロック・オフ

Dialogue: 0,0:00:01.21,0:00:02.04,Default,,0,0,0,SP,（A班對B班）
Dialogue: 0,0:00:02.12,0:00:03.04,Default,,0,0,0,SP,（第一戰）
Dialogue: 0,0:00:04.88,0:00:06.51,Default,,0,0,0,,雄英高中英雄科
Dialogue: 0,0:00:06.59,0:00:08.51,Default,,0,0,0,,一年A班跟一年B班
Dialogue: 0,0:00:08.59,0:00:10.72,Default,,0,0,0,,展開了小組對戰的戰鬥訓練
Dialogue: 0,0:00:14.34,0:00:15.42,Default,,0,0,0,SP,（重擊）
Dialogue: 0,0:00:16.01,0:00:17.43,Default,,0,0,0,,第一場比賽
Dialogue: 1,0:00:17.51,0:00:21.56,Default2,,0,0,0,,心操同學的個性
Dialogue: 0,0:00:17.51,0:00:21.56,Default,,0,0,0,,成功打散了B班的團隊合作
Dialogue: 0,0:00:23.02,0:00:25.02,Default,,0,0,0,,比賽便以A班的勝利告終
Dialogue: 0,0:00:29.69,0:00:32.94,Default,,0,0,0,SP,（歡迎光臨，徒刑99999年）
Comment: 0,0:02:02.99,0:02:03.99,Default,,0,0,0,SP,（職業英雄，相澤消太）
Dialogue: 0,0:02:04.08,0:02:05.87,Default,,0,0,0,,說說第一場比賽該反省的地方
Dialogue: 0,0:02:06.37,0:02:08.75,Default,,0,0,0,,如果對手不想跟我打的話
Dialogue: 0,0:02:08.83,0:02:10.87,Default,,0,0,0,,我的個性根本派不上用場
Dialogue: 0,0:02:11.59,0:02:13.22,Default,,0,0,0,,要是戰鬥是來真的
Dialogue: 0,0:02:13.30,0:02:16.51,Default,,0,0,0,,我早就在被鹽崎抓到的那瞬間被殺了
Dialogue: 1,0:02:16.59,0:02:20.80,Default2,,0,0,0,,我得學著讓自己給蟲子們下達
Dialogue: 0,0:02:16.59,0:02:20.80,Default,,0,0,0,,更精細的指示才行
Dialogue: 0,0:02:20.89,0:02:22.27,Default,,0,0,0,,我的表現不錯吧
Dialogue: 0,0:02:22.35,0:02:25.19,Default,,0,0,0,,迷上我了吧，儘管迷上我沒關係
Dialogue: 0,0:02:25.93,0:02:28.97,Default,,0,0,0,,我知道戀愛這種東西是沒辦法控制的
Dialogue: 0,0:02:29.06,0:02:30.60,Default,,0,0,0,,所以沒關係的唷
Dialogue: 0,0:02:30.69,0:02:34.95,Default,,0,0,0,,失去了小口田跟小切島這兩個隊友
Dialogue: 0,0:02:35.03,0:02:37.70,Default,,0,0,0,,我很想不失去任何一個隊友獲勝的
Dialogue: 0,0:02:37.78,0:02:38.86,Default,,0,0,0,,結果搞得一團亂
Dialogue: 0,0:02:38.95,0:02:40.12,Default,,0,0,0,,捕縛布
Dialogue: 0,0:02:40.20,0:02:41.20,Default,,0,0,0,,呱呱？
Dialogue: 1,0:02:41.28,0:02:44.62,Default2,,0,0,0,,老師教給我的東西
Dialogue: 0,0:02:41.28,0:02:44.62,Default,,0,0,0,,我連一成都沒能實踐
Dialogue: 0,0:02:44.70,0:02:46.12,Default,,0,0,0,,真的很不甘心
Dialogue: 1,0:02:46.70,0:02:49.04,Default2,,0,0,0,,要是一下就能學會
Dialogue: 0,0:02:46.70,0:02:49.04,Default,,0,0,0,,就不用那麼辛苦了
Dialogue: 1,0:02:49.12,0:02:52.58,Default2,,0,0,0,,我也是花了六年的時間
Dialogue: 0,0:02:49.12,0:02:52.58,Default,,0,0,0,,才變得能將捕縛布應用自如
Dialogue: 0,0:02:52.67,0:02:55.01,Default,,0,0,0,,別忘了不甘心的心情，再接再厲吧
Dialogue: 0,0:02:56.67,0:02:57.63,Default,,0,0,0,,是的
Dialogue: 0,0:02:57.72,0:02:59.43,Default,,0,0,0,,去參加英雄實習的那兩個人
Dialogue: 0,0:02:59.51,0:03:01.35,Default,,0,0,0,,他們的感想真嚴肅
Dialogue: 0,0:03:01.43,0:03:03.47,Default,,0,0,0,,那是當然的啊
Dialogue: 0,0:03:03.55,0:03:05.59,Default,,0,0,0,,那什麼死穢八齋會是吧？
Dialogue: 1,0:03:06.43,0:03:09.27,Default2,,0,0,0,,聽說跟他們的戰鬥
Dialogue: 0,0:03:06.43,0:03:09.27,Default,,0,0,0,,根本就是九死一生
Dialogue: 0,0:03:09.35,0:03:11.10,Default,,0,0,0,,畢竟經歷過那種實戰
Dialogue: 0,0:03:11.69,0:03:14.32,Default,,0,0,0,,所以就算只是進行訓練
Dialogue: 0,0:03:14.40,0:03:16.78,Default,,0,0,0,,心態跟動力也會變得很不一樣啊
Dialogue: 0,0:03:17.82,0:03:19.20,Default,,0,0,0,,跟他們比起來
Dialogue: 1,0:03:19.78,0:03:22.99,Default2,,0,0,0,,電波干擾嗚咿男的脫線舉動
Dialogue: 0,0:03:19.78,0:03:22.99,Default,,0,0,0,,就特別突兀
Dialogue: 0,0:03:23.49,0:03:24.66,Default,,0,0,0,,聽好了
Dialogue: 1,0:03:24.74,0:03:29.45,Default2,,0,0,0,,切島要知道怎麼安排
Dialogue: 0,0:03:24.74,0:03:29.45,Default,,0,0,0,,引誘對手跟你進行正面對決
Dialogue: 0,0:03:29.54,0:03:30.37,Default,,0,0,0,,是的
Dialogue: 0,0:03:30.46,0:03:32.17,Default,,0,0,0,,口田就跟自己說的一樣
Dialogue: 0,0:03:32.25,0:03:34.88,Default,,0,0,0,,要更加提升操控生物的細緻程度
Dialogue: 1,0:03:34.96,0:03:38.26,Default2,,0,0,0,,除了正面迎戰之外
Dialogue: 0,0:03:34.96,0:03:38.26,Default,,0,0,0,,也要思考怎麼偷襲對手
Dialogue: 0,0:03:39.05,0:03:41.05,Default,,0,0,0,,上鳴一開始太鬆懈了
Dialogue: 1,0:03:41.13,0:03:43.92,Default2,,0,0,0,,要是同伴不被撂倒
Dialogue: 0,0:03:41.13,0:03:43.92,Default,,0,0,0,,你就發揮不了實力嗎？
Dialogue: 0,0:03:44.01,0:03:45.01,Default,,0,0,0,,嗚咿…
Dialogue: 0,0:03:45.10,0:03:46.10,Default,,0,0,0,,蛙吹
Dialogue: 1,0:03:46.18,0:03:49.89,Default2,,0,0,0,,與其在意失誤
Dialogue: 0,0:03:46.18,0:03:49.89,Default,,0,0,0,,更應該學會怎麼迅速補救
Dialogue: 0,0:03:49.98,0:03:50.81,Default,,0,0,0,,呱呱
Dialogue: 1,0:03:50.89,0:03:53.85,Default2,,0,0,0,,將今天檢討的地方
Dialogue: 0,0:03:50.89,0:03:53.85,Default,,0,0,0,,運用在未來的訓練上
Dialogue: 0,0:03:53.94,0:03:54.77,Default,,0,0,0,,就這樣
Dialogue: 1,0:03:54.86,0:03:55.94,Default2,,0,0,0,,-是的
Dialogue: 0,0:03:54.86,0:03:55.94,Default,,0,0,0,,-是的
Dialogue: 1,0:04:06.99,0:04:10.91,Default2,,0,0,0,,雖然贏得勝利
Dialogue: 0,0:04:06.99,0:04:10.91,Default,,0,0,0,,卻深刻體認到自己有多不成熟
Dialogue: 0,0:04:11.00,0:04:13.17,Default,,0,0,0,,儘管這樣，也沒有因此感到沮喪
Dialogue: 0,0:04:13.25,0:04:14.50,Default,,0,0,0,,而是為了下一場比賽
Dialogue: 1,0:04:14.58,0:04:19.08,Default2,,0,0,0,,邊在腦中進行模擬
Dialogue: 0,0:04:14.58,0:04:19.08,Default,,0,0,0,,邊摸索改善戰略的方法
Dialogue: 0,0:04:19.17,0:04:20.55,Default,,0,0,0,,太棒了
Dialogue: 0,0:04:20.63,0:04:23.97,Default,,0,0,0,,心操同學的青澀感真不錯
Dialogue: 0,0:04:24.05,0:04:25.55,Default,,0,0,0,,妳喔…
Comment: 0,0:04:25.64,0:04:26.48,Default,,0,0,0,SP,（弗拉德之王）
Dialogue: 0,0:04:26.55,0:04:27.97,Default,,0,0,0,,我想你們應該很清楚…
Dialogue: 0,0:04:28.77,0:04:30.90,Default,,0,0,0,,自己為什麼會戰敗了吧
Dialogue: 0,0:04:31.73,0:04:34.44,Default,,0,0,0,,不管是以肉田為主軸
Dialogue: 0,0:04:34.52,0:04:37.32,Default,,0,0,0,,或是以鹽崎為主軸
Dialogue: 1,0:04:37.40,0:04:40.90,Default2,,0,0,0,,要是你們能好好整合
Dialogue: 0,0:04:37.40,0:04:40.90,Default,,0,0,0,,早就贏得這場比賽了
Dialogue: 1,0:04:40.99,0:04:43.41,Default2,,0,0,0,,眼神好可怕啊
Dialogue: 0,0:04:40.99,0:04:43.41,Default,,0,0,0,,我們的弗拉德之王老師
Dialogue: 0,0:04:43.91,0:04:46.62,Default,,0,0,0,,鹽崎不會使計騙人
Dialogue: 1,0:04:46.70,0:04:49.45,Default2,,0,0,0,,肉田，你在這部分的考量
Dialogue: 0,0:04:46.70,0:04:49.45,Default,,0,0,0,,得到了反效果呢
Dialogue: 0,0:04:49.54,0:04:51.33,Default,,0,0,0,,物間…
Dialogue: 1,0:04:51.41,0:04:55.33,Default2,,0,0,0,,就結果來說
Dialogue: 0,0:04:51.41,0:04:55.33,Default,,0,0,0,,的確是讓對手有時間做準備了
Dialogue: 0,0:04:55.42,0:04:57.51,Default,,0,0,0,,很抱歉，鹽崎
Dialogue: 0,0:04:57.59,0:04:59.26,Default,,0,0,0,,被業火灼燒吧
Dialogue: 0,0:04:59.34,0:05:00.34,Default,,0,0,0,,不過呢
Dialogue: 0,0:05:00.42,0:05:02.96,Default,,0,0,0,,我看了一場很精采的比賽就是了
Dialogue: 0,0:05:03.05,0:05:05.14,Default,,0,0,0,,很期待跟他並肩作戰
Dialogue: 0,0:05:05.22,0:05:06.85,Default,,0,0,0,,嘿，心操同學
Dialogue: 1,0:05:06.93,0:05:09.52,Default2,,0,0,0,,我們來擬定
Dialogue: 0,0:05:06.93,0:05:09.52,Default,,0,0,0,,能讓A班哇哇大哭的戰術吧
Dialogue: 0,0:05:09.60,0:05:12.23,Default,,0,0,0,,最好是讓他們叫都叫不出來的那種
Dialogue: 0,0:05:12.31,0:05:13.77,Default,,0,0,0,,讓A班每一個人看了都望塵莫及
Dialogue: 1,0:05:13.85,0:05:15.81,Default2,,0,0,0,,-他自己講得好高興喔
Dialogue: 0,0:05:13.85,0:05:15.81,Default,,0,0,0,,-只能跪在B班面前哭著認輸
Dialogue: 0,0:05:15.90,0:05:18.07,Default,,0,0,0,,我們也得擬定好戰術才行
Dialogue: 1,0:05:19.57,0:05:22.95,Default2,,0,0,0,,我們把現在能做到的事
Dialogue: 0,0:05:19.57,0:05:22.95,Default,,0,0,0,,還有點子都列出來吧
Dialogue: 0,0:05:23.03,0:05:23.86,Default,,0,0,0,,好喔
Dialogue: 0,0:05:23.95,0:05:26.16,Default,,0,0,0,,來設計組合技吧，一擊必殺的那種
Dialogue: 0,0:05:26.24,0:05:28.28,Default,,0,0,0,,我們也來集思廣益一下好了
Dialogue: 0,0:05:28.37,0:05:30.33,Default,,0,0,0,,以轟為主軸行動吧
Dialogue: 0,0:05:30.41,0:05:31.24,Default,,0,0,0,,我嗎？
Dialogue: 0,0:05:31.33,0:05:32.46,Default,,0,0,0,,我覺得很不錯
Dialogue: 0,0:05:32.54,0:05:34.67,Default,,0,0,0,,爆豪，我們也來想戰術吧
Dialogue: 0,0:05:34.75,0:05:37.50,Default,,0,0,0,,你們幾個可不要扯我後腿喔
Dialogue: 0,0:05:38.38,0:05:40.05,Default,,0,0,0,,好煩
Dialogue: 0,0:05:40.13,0:05:42.63,Default,,0,0,0,,第五場比賽會對上心操同學
Dialogue: 0,0:05:43.88,0:05:45.51,Default,,0,0,0,,他的變聲器會是一大威脅
Dialogue: 0,0:05:45.59,0:05:48.05,Default,,0,0,0,,黏呼呼酸液輕飄飄飛踢
Dialogue: 0,0:05:48.14,0:05:50.02,Default,,0,0,0,,那是什麼招數啊？
Dialogue: 0,0:05:50.10,0:05:52.39,Default,,0,0,0,,場地非常複雜，要藏身很容易
Dialogue: 0,0:05:52.47,0:05:54.06,Default,,0,0,0,,這樣很難搜尋敵人
Dialogue: 0,0:05:54.14,0:05:54.97,Default,,0,0,0,,交給我吧
Dialogue: 0,0:05:55.06,0:05:57.48,Default,,0,0,0,,我來想以我為主
Dialogue: 0,0:05:57.56,0:05:58.98,Default,,0,0,0,,為我打造的戰術
Dialogue: 0,0:05:59.06,0:06:01.81,Default,,0,0,0,,在緊要關頭把飯田當王牌用吧
Dialogue: 0,0:06:02.48,0:06:03.40,Default,,0,0,0,,在那之前
Dialogue: 1,0:06:03.48,0:06:06.48,Default2,,0,0,0,,我想先告訴大家一件事
Dialogue: 0,0:06:03.48,0:06:06.48,Default,,0,0,0,,是關於我的往復式招數
Dialogue: 0,0:06:06.57,0:06:08.28,Default,,0,0,0,,瞬殺游泳球
Dialogue: 0,0:06:08.36,0:06:10.07,Default,,0,0,0,,所以那到底是什麼招數啦？
Dialogue: 1,0:06:10.16,0:06:12.33,Default2,,0,0,0,,-就是把我的酸液裹住你的葡萄
Dialogue: 0,0:06:10.16,0:06:12.33,Default,,0,0,0,,-受傷的人就去保健室
Dialogue: 1,0:06:12.41,0:06:14.62,Default2,,0,0,0,,-然後從空中丟向敵人
Dialogue: 0,0:06:12.41,0:06:14.62,Default,,0,0,0,,-人類是沒辦法替換零件的下等生物
Dialogue: 0,0:06:14.70,0:06:15.91,Default,,0,0,0,,最好可以啦
Dialogue: 0,0:06:16.00,0:06:18.13,Default,,0,0,0,,就是這樣，就是這樣啊
Dialogue: 0,0:06:18.92,0:06:20.38,Default,,0,0,0,,年輕人的青澀春天
Dialogue: 0,0:06:20.46,0:06:21.84,Default,,0,0,0,,現在是冬天
Dialogue: 0,0:06:24.21,0:06:26.80,Default,,0,0,0,,轉眼間就已經年底了
Dialogue: 1,0:06:27.43,0:06:32.10,Default2,,0,0,0,,大家都在努力發展個性
Dialogue: 0,0:06:27.43,0:06:32.10,Default,,0,0,0,,並研發各自的必殺技
Dialogue: 1,0:06:32.18,0:06:35.60,Default2,,0,0,0,,綠谷少年也掌握了
Dialogue: 0,0:06:32.18,0:06:35.60,Default,,0,0,0,,One For All的使用方式
Dialogue: 0,0:06:36.77,0:06:40.52,Default,,0,0,0,,並學會了射門風格跟空中武力
Dialogue: 0,0:06:41.36,0:06:43.15,Default,,0,0,0,,臨時證照測驗
Dialogue: 0,0:06:44.98,0:06:47.48,Default,,0,0,0,,跟死穢八齋會的戰鬥
Dialogue: 0,0:06:49.78,0:06:50.95,Default,,0,0,0,,文化祭
Dialogue: 0,0:06:54.12,0:06:57.29,Default,,0,0,0,,透過各式各樣的活動或是棘手事件
Dialogue: 0,0:06:57.37,0:06:59.37,Default,,0,0,0,,一個勁地往前邁進
Dialogue: 1,0:07:01.17,0:07:06.09,Default2,,0,0,0,,就趁這個機會
Dialogue: 0,0:07:01.17,0:07:06.09,Default,,0,0,0,,比較自己跟其他人的力量
Dialogue: 0,0:07:06.17,0:07:08.59,Default,,0,0,0,,掌握自己現階段的位置在哪裡
Dialogue: 0,0:07:11.51,0:07:14.60,Default,,0,0,0,,這次的課程算是某種總結
Dialogue: 0,0:07:15.97,0:07:17.26,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:07:17.85,0:07:19.48,Default,,0,0,0,,你覺得心操的表現怎麼樣？
Dialogue: 0,0:07:19.56,0:07:20.56,Default,,0,0,0,,很不錯
Dialogue: 0,0:07:21.90,0:07:23.40,Default,,0,0,0,,他完全不會怯場
Dialogue: 1,0:07:24.40,0:07:28.07,Default2,,0,0,0,,會先表現出不甘心的感情
Dialogue: 0,0:07:24.40,0:07:28.07,Default,,0,0,0,,這點很值得讚賞
Dialogue: 1,0:07:28.65,0:07:32.74,Default2,,0,0,0,,這次的訓練就是
Dialogue: 0,0:07:28.65,0:07:32.74,Default,,0,0,0,,轉入英雄科之前的轉科考試
Dialogue: 1,0:07:32.82,0:07:36.24,Default2,,0,0,0,,相信他在下一場比賽
Dialogue: 0,0:07:32.82,0:07:36.24,Default,,0,0,0,,會打起十二萬分精神應戰吧
Dialogue: 0,0:07:37.04,0:07:38.96,Default,,0,0,0,,弗拉德，開始下一場比賽吧
Dialogue: 0,0:07:39.58,0:07:41.04,Default,,0,0,0,,那麼…
Dialogue: 0,0:07:44.59,0:07:46.09,Default,,0,0,0,,第二場比賽
Dialogue: 0,0:07:46.17,0:07:47.92,Default,,0,0,0,,請準備上場
Dialogue: 0,0:07:48.42,0:07:50.01,Default,,0,0,0,SP,（第二戰）
Dialogue: 0,0:07:58.27,0:07:59.48,Default,,0,0,0,,對了，八百萬
Dialogue: 0,0:07:59.56,0:08:01.19,Default,,0,0,0,,什麼事？拳藤同學
Dialogue: 1,0:08:01.27,0:08:04.27,Default2,,0,0,0,,妳為什麼沒參加
Dialogue: 0,0:08:01.27,0:08:04.27,Default,,0,0,0,,之前文化祭的校園小姐選拔？
Dialogue: 0,0:08:04.36,0:08:06.11,Default,,0,0,0,,我還以為妳一定會參加
Dialogue: 1,0:08:06.19,0:08:10.99,Default2,,0,0,0,,因為相澤老師
Dialogue: 0,0:08:06.19,0:08:10.99,Default,,0,0,0,,並沒有告訴我那個比賽的消息
Dialogue: 1,0:08:11.07,0:08:14.95,Default2,,0,0,0,,加上還要忙著練團
Dialogue: 0,0:08:11.07,0:08:14.95,Default,,0,0,0,,到頭來應該還是沒辦法參加
Dialogue: 1,0:08:15.03,0:08:19.24,Default2,,0,0,0,,我在想，相澤老師可能是判斷
Dialogue: 0,0:08:15.03,0:08:19.24,Default,,0,0,0,,我沒有必要參賽吧
Dialogue: 0,0:08:21.58,0:08:24.25,Default,,0,0,0,,因為職場體驗時我們一起拍了廣告
Dialogue: 0,0:08:24.83,0:08:28.33,Default,,0,0,0,,所以我們似乎就被綁在一起看了
Dialogue: 0,0:08:28.42,0:08:31.05,Default,,0,0,0,,就像是所謂的“箱推”那樣
Dialogue: 0,0:08:31.55,0:08:33.34,Default,,0,0,0,,“箱推”？
Dialogue: 0,0:08:34.55,0:08:35.97,Default,,0,0,0,,所謂“箱推”就是
Dialogue: 1,0:08:36.05,0:08:38.72,Default2,,0,0,0,,這個也好，那個也讚
Dialogue: 0,0:08:36.05,0:08:38.72,Default,,0,0,0,,全都喜歡的意思
Dialogue: 1,0:08:38.81,0:08:40.69,Default2,,0,0,0,,文化祭的時候
Dialogue: 0,0:08:38.81,0:08:40.69,Default,,0,0,0,,不是也有同一個人在喊
Dialogue: 0,0:08:40.77,0:08:44.32,Default,,0,0,0,,“八百萬、拳藤”嗎？
Dialogue: 0,0:08:45.15,0:08:46.57,Default,,0,0,0,,的確是這樣
Dialogue: 0,0:08:46.65,0:08:49.78,Default,,0,0,0,,伊朵拉，偶像崇拜
Dialogue: 0,0:08:49.86,0:08:51.70,Default,,0,0,0,,該怎麼說呢？
Dialogue: 1,0:08:51.78,0:08:56.54,Default2,,0,0,0,,八百萬的成績跟個性明明都比我好
Dialogue: 0,0:08:51.78,0:08:56.54,Default,,0,0,0,,卻被拿來跟我相提並論
Dialogue: 0,0:08:56.62,0:08:58.75,Default,,0,0,0,,其實我不太喜歡這種感覺
Dialogue: 1,0:08:58.83,0:09:02.17,Default2,,0,0,0,,就我個人來說
Dialogue: 0,0:08:58.83,0:09:02.17,Default,,0,0,0,,我一直想跟妳好好打一場呢
Dialogue: 0,0:09:03.87,0:09:05.46,Default,,0,0,0,,那我就誠心誠意…
Dialogue: 0,0:09:06.08,0:09:07.58,Default,,0,0,0,,接下妳的挑戰書了
Dialogue: 0,0:09:08.38,0:09:10.01,Default,,0,0,0,,常闇
Dialogue: 0,0:09:10.09,0:09:11.59,Default,,0,0,0,,你跟我…
Dialogue: 0,0:09:11.67,0:09:13.80,Default,,0,0,0,,是同一種人
Dialogue: 0,0:09:13.88,0:09:15.34,Default,,0,0,0,,黑色支配
Dialogue: 0,0:09:15.89,0:09:18.23,Default,,0,0,0,,你的個性是能融入“黑”之中
Dialogue: 0,0:09:18.30,0:09:21.55,Default,,0,0,0,,並且能在黑之中自由移動，沒錯吧
Dialogue: 0,0:09:23.93,0:09:28.23,Default,,0,0,0,,我跟你是宿命的存在
Dialogue: 0,0:09:30.19,0:09:32.32,Default,,0,0,0,,看來你也是深淵的理解者
Dialogue: 0,0:09:33.03,0:09:35.07,Default,,0,0,0,,居住在永恆的黑暗中
Dialogue: 0,0:09:36.24,0:09:38.45,Default,,0,0,0,,他們兩個一點也不閃耀呢
Dialogue: 0,0:09:39.95,0:09:43.20,Default,,0,0,0,,雙方隊伍，準備完畢
Dialogue: 0,0:09:43.95,0:09:45.33,Default,,0,0,0,,那麼…
Dialogue: 0,0:09:46.50,0:09:48.21,Default,,0,0,0,,加油啊，拳藤隊
Dialogue: 0,0:09:48.29,0:09:50.21,Default,,0,0,0,,第二場比賽，開始
Dialogue: 0,0:09:50.29,0:09:52.13,Default,,0,0,0,,反對偏心實況轉播
Dialogue: 1,0:09:52.21,0:09:53.80,Default2,,0,0,0,,-反對
Dialogue: 0,0:09:52.21,0:09:53.80,Default,,0,0,0,,-反對
Dialogue: 0,0:09:53.88,0:09:56.22,Default,,0,0,0,,很好，我們上吧
Dialogue: 1,0:09:56.30,0:09:57.72,Default2,,0,0,0,,-好
Dialogue: 0,0:09:56.30,0:09:57.72,Default,,0,0,0,,-好
Dialogue: 0,0:09:58.59,0:10:01.47,Default,,0,0,0,,拳藤在B班的定位到底是什麼呢？
Dialogue: 0,0:10:02.06,0:10:03.69,Default,,0,0,0,,拳藤啊，她可厲害了
Dialogue: 0,0:10:03.77,0:10:05.23,Default,,0,0,0,,你好大聲
Dialogue: 0,0:10:05.31,0:10:07.73,Default,,0,0,0,,畢竟她是我們班的班長啊
Dialogue: 1,0:10:07.81,0:10:11.15,Default2,,0,0,0,,她的腦筋動得很快
Dialogue: 0,0:10:07.81,0:10:11.15,Default,,0,0,0,,也能即時做出很冷靜的判斷
Dialogue: 0,0:10:11.23,0:10:14.82,Default,,0,0,0,,更擁有在緊要關頭挺身而出的勇氣
Dialogue: 0,0:10:14.90,0:10:18.15,Default,,0,0,0,,同時還擁有整合全班的開朗性格
Dialogue: 0,0:10:18.24,0:10:19.07,Default,,0,0,0,,如果沒有她的話
Dialogue: 0,0:10:19.16,0:10:21.96,Default,,0,0,0,,現在B班的人早就都被物間拉攏了
Dialogue: 0,0:10:22.03,0:10:23.70,Default,,0,0,0,,喂，怎麼這樣說？
Dialogue: 0,0:10:23.79,0:10:25.33,Default,,0,0,0,,B班的大姐大
Dialogue: 0,0:10:25.41,0:10:28.96,Default,,0,0,0,,就是這個女生，拳藤一佳
Dialogue: 0,0:10:29.67,0:10:31.13,Default,,0,0,0,,八百萬的作戰
Dialogue: 0,0:10:31.21,0:10:33.05,Default,,0,0,0,,究竟能不能在比賽中順利切入呢？
Dialogue: 0,0:10:33.13,0:10:34.38,Default,,0,0,0,,作戰？
Dialogue: 0,0:10:35.26,0:10:37.85,Default,,0,0,0,,那麼就按照預定，麻煩你先去探路了
Dialogue: 0,0:10:37.93,0:10:39.22,Default,,0,0,0,,常闇同學
Dialogue: 0,0:10:39.30,0:10:40.18,Default,,0,0,0,,遵令
Dialogue: 0,0:10:40.26,0:10:41.22,Default,,0,0,0,,黑影
Dialogue: 0,0:10:41.30,0:10:42.68,Default,,0,0,0,,知道了
Dialogue: 0,0:10:42.76,0:10:44.60,Default,,0,0,0,,只要一發現對手就立刻回報
Dialogue: 0,0:10:44.68,0:10:45.76,Default,,0,0,0,,交給我吧
Dialogue: 0,0:10:52.77,0:10:55.44,Default,,0,0,0,,雖然我們都大致瞭解彼此的個性
Dialogue: 1,0:10:55.53,0:10:58.45,Default2,,0,0,0,,不過對於發展過的個性或新招式
Dialogue: 0,0:10:55.53,0:10:58.45,Default,,0,0,0,,卻一無所知
Dialogue: 0,0:10:58.53,0:11:00.62,Default,,0,0,0,,很可能因此吃敗仗
Dialogue: 0,0:11:00.70,0:11:02.49,Default,,0,0,0,,所以首先
Dialogue: 0,0:11:03.62,0:11:05.87,Default,,0,0,0,,就看一下情況是怎樣吧
Dialogue: 0,0:11:07.50,0:11:09.54,Default,,0,0,0,,黑影好像發現對手的行蹤了
Dialogue: 0,0:11:10.37,0:11:12.25,Default,,0,0,0,,就在那個煙囪下方前面
Dialogue: 0,0:11:12.33,0:11:13.54,Default,,0,0,0,,我們過去吧
Dialogue: 0,0:11:15.09,0:11:18.89,Default,,0,0,0,,看一下情況…看個大頭啦
Dialogue: 0,0:11:18.97,0:11:22.10,Default,,0,0,0,,就趁現在解決感覺好對付的傢伙
Dialogue: 0,0:11:22.18,0:11:23.22,Default,,0,0,0,,包在你身上囉
Dialogue: 0,0:11:23.30,0:11:24.89,Default,,0,0,0,,黑色
Dialogue: 0,0:11:28.81,0:11:31.06,Default,,0,0,0,,我去去就回
Dialogue: 0,0:11:33.19,0:11:36.82,Default,,0,0,0,,黑影好像已經去到很遠的地方了呢
Dialogue: 1,0:11:37.65,0:11:40.24,Default2,,0,0,0,,你是不是也在實習的那段期間
Dialogue: 0,0:11:37.65,0:11:40.24,Default,,0,0,0,,提升實力了？
Dialogue: 0,0:11:40.32,0:11:41.57,Default,,0,0,0,,這很難說
Dialogue: 0,0:11:41.66,0:11:44.96,Default,,0,0,0,,離得越遠，黑影能維持的時間就越短
Dialogue: 0,0:11:45.03,0:11:46.57,Default,,0,0,0,,牠回來了
Dialogue: 0,0:11:50.25,0:11:51.34,Default,,0,0,0,,各位，快散開
Dialogue: 0,0:11:51.42,0:11:53.01,Default,,0,0,0,,常闇同學
Dialogue: 0,0:11:53.08,0:11:55.12,Default,,0,0,0,,什麼？這是怎麼回事？
Dialogue: 0,0:11:56.50,0:11:57.92,Default,,0,0,0,,踏陰
Dialogue: 0,0:11:58.01,0:12:01.43,Default,,0,0,0,,我們中計了
Dialogue: 0,0:12:03.26,0:12:05.14,Default,,0,0,0,,黑影到底是怎麼了？
Dialogue: 0,0:12:05.22,0:12:06.26,Default,,0,0,0,,失控了？
Dialogue: 0,0:12:06.35,0:12:07.73,Default,,0,0,0,,不對
Dialogue: 1,0:12:07.81,0:12:11.27,Default2,,0,0,0,,比賽場地並沒有暗到
Dialogue: 0,0:12:07.81,0:12:11.27,Default,,0,0,0,,常闇同學沒辦法控制的程度
Dialogue: 0,0:12:11.35,0:12:13.64,Default,,0,0,0,,難道說牠被操控了嗎？
Dialogue: 0,0:12:14.27,0:12:16.44,Default,,0,0,0,,因為B班某人的個性？
Dialogue: 0,0:12:19.03,0:12:21.53,Default,,0,0,0,,等等，先等一下
Dialogue: 0,0:12:24.03,0:12:25.78,Default,,0,0,0,,葉隱同學，放出光線
Dialogue: 0,0:12:25.87,0:12:27.04,Default,,0,0,0,,收到
Dialogue: 0,0:12:27.12,0:12:28.66,Default,,0,0,0,,集光屈折
Dialogue: 0,0:12:28.74,0:12:30.70,Default,,0,0,0,,來，笑一個
Dialogue: 0,0:12:35.54,0:12:38.75,Default,,0,0,0,,快回來，黑影
Dialogue: 0,0:12:39.88,0:12:42.51,Default,,0,0,0,,黑色同學從黑影裡面跑出來了
Dialogue: 0,0:12:48.60,0:12:49.85,Default,,0,0,0,,消失不見了
Dialogue: 0,0:12:49.93,0:12:52.22,Default,,0,0,0,,他融入到影子裡面去了
Dialogue: 0,0:12:52.31,0:12:54.27,Default,,0,0,0,,那就是黑色同學的…
Dialogue: 0,0:12:56.61,0:12:58.45,Default,,0,0,0,,B班，黑色支配
Dialogue: 0,0:12:58.52,0:13:00.06,Default,,0,0,0,,個性是黑
Dialogue: 0,0:13:00.15,0:13:02.07,Default,,0,0,0,,能夠融入“黑”之中
Dialogue: 1,0:13:02.15,0:13:06.86,Default2,,0,0,0,,而且，他在發展個性之後
Dialogue: 0,0:13:02.15,0:13:06.86,Default,,0,0,0,,還能操控自己融入的黑色物體
Dialogue: 0,0:13:06.95,0:13:09.37,Default,,0,0,0,,不過僅限於能夠移動的東西喔
Dialogue: 0,0:13:10.70,0:13:13.04,Default,,0,0,0,,常闇踏陰
Dialogue: 0,0:13:13.83,0:13:16.79,Default,,0,0,0,,我會把你給刺穿
Dialogue: 0,0:13:18.84,0:13:22.05,Default,,0,0,0,,我跟你是宿命的存在
Dialogue: 0,0:13:22.13,0:13:24.92,Default,,0,0,0,,原來如此，宿敵
Dialogue: 0,0:13:25.01,0:13:26.55,Default,,0,0,0,,那好吧
Dialogue: 0,0:13:26.64,0:13:29.10,Default,,0,0,0,,我就用跟隨霍克斯時創造出的招式
Dialogue: 0,0:13:29.18,0:13:31.06,Default,,0,0,0,,“黑色墮天使”來迎戰吧
Dialogue: 0,0:13:32.14,0:13:33.81,Default,,0,0,0,,墮天使…
Dialogue: 0,0:13:34.39,0:13:35.43,Default,,0,0,0,,沒錯
Dialogue: 0,0:13:36.06,0:13:38.06,Default,,0,0,0,,黑色墮天使
Comment: 0,0:13:41.03,0:13:42.16,Default,,0,0,0,SP,（常闇踏陰，個性，黑影）
Comment: 0,0:13:42.23,0:13:44.94,Default,,0,0,0,SP,（體內寄宿著能跟自己一起戰鬥\N猶如影子一般伸縮自如的怪物）
Comment: 0,0:13:45.03,0:13:46.28,Default,,0,0,0,SP,（霍克斯，個性，剛翼）
Comment: 0,0:13:46.36,0:13:48.95,Default,,0,0,0,SP,（能自由操縱背上羽毛\N將其射出或是改變形狀）
Dialogue: 0,0:13:49.03,0:13:51.95,Default,,0,0,0,SP,（數個月前，九州地區）
Dialogue: 0,0:13:52.04,0:13:54.50,Default,,0,0,0,,他總是一個人就把事情都解決了
Dialogue: 0,0:13:57.21,0:13:59.67,Default,,0,0,0,,這可不是合成的，是天然的鑽石呢
Dialogue: 0,0:14:00.59,0:14:02.55,Default,,0,0,0,,拿了這麼多，肯定有三億…
Dialogue: 0,0:14:02.63,0:14:04.55,Default,,0,0,0,,奇怪…
Dialogue: 0,0:14:06.55,0:14:07.80,Default,,0,0,0,,好了，抓到你了
Dialogue: 0,0:14:07.89,0:14:09.81,Default,,0,0,0,,霍克斯
Dialogue: 0,0:14:11.68,0:14:13.56,Default,,0,0,0,,你們動作太慢了
Dialogue: 0,0:14:13.64,0:14:16.52,Default,,0,0,0,,完庭那的酒吧好像有客人在鬧事
Dialogue: 0,0:14:16.60,0:14:17.98,Default,,0,0,0,,接下來就去那邊吧
Dialogue: 0,0:14:18.81,0:14:21.90,Default,,0,0,0,,那就麻煩你們幫忙收拾善後囉
Dialogue: 0,0:14:23.82,0:14:25.07,Default,,0,0,0,,月讀同學
Dialogue: 0,0:14:25.99,0:14:28.91,Default,,0,0,0,,我們幾個助手要負責處理這個傢伙喔
Dialogue: 0,0:14:28.99,0:14:30.87,Default,,0,0,0,,因為霍克斯真的太快了
Dialogue: 0,0:14:31.58,0:14:34.75,Default,,0,0,0,,所以這個工作模式是最有效率的
Dialogue: 0,0:14:34.83,0:14:35.92,Default,,0,0,0,,我要追上去
Dialogue: 0,0:14:36.00,0:14:37.00,Default,,0,0,0,,月讀同學
Dialogue: 0,0:14:37.92,0:14:39.88,Default,,0,0,0,,他還真是有幹勁呢
Dialogue: 1,0:14:40.96,0:14:45.51,Default2,,0,0,0,,聽說霍克斯是第一次參與
Dialogue: 0,0:14:40.96,0:14:45.51,Default,,0,0,0,,運動會的指名活動
Dialogue: 1,0:14:48.22,0:14:50.85,Default2,,0,0,0,,在職場體驗的時候
Dialogue: 0,0:14:48.22,0:14:50.85,Default,,0,0,0,,我也只是一直追在他後面跑
Dialogue: 1,0:14:51.51,0:14:54.76,Default2,,0,0,0,,不斷地收拾他搞定好的事情
Dialogue: 0,0:14:51.51,0:14:54.76,Default,,0,0,0,,或意外善後
Dialogue: 0,0:14:57.73,0:14:59.07,Default,,0,0,0,,這讓我產生疑問
Dialogue: 1,0:14:59.90,0:15:03.07,Default2,,0,0,0,,要是在等別人追上我腳步的這段時間
Dialogue: 0,0:14:59.90,0:15:03.07,Default,,0,0,0,,讓災情因此擴大的話
Dialogue: 0,0:15:03.15,0:15:04.65,Default,,0,0,0,,這是不能被原諒的吧
Dialogue: 0,0:15:04.73,0:15:06.11,Default,,0,0,0,,那麼
Dialogue: 0,0:15:06.19,0:15:08.61,Default,,0,0,0,,你到底是為了什麼才指名我的呢？
Dialogue: 0,0:15:08.70,0:15:10.28,Default,,0,0,0,,因為都是鳥
Dialogue: 0,0:15:12.28,0:15:13.37,Default,,0,0,0,,你在開玩笑？
Dialogue: 0,0:15:13.45,0:15:15.54,Default,,0,0,0,,沒啦，有兩成是真心話
Dialogue: 1,0:15:15.62,0:15:19.29,Default2,,0,0,0,,有一半是因為我想跟一年A班的人
Dialogue: 0,0:15:15.62,0:15:19.29,Default,,0,0,0,,打聽一些事情
Dialogue: 1,0:15:19.96,0:15:23.76,Default2,,0,0,0,,就是關於那群襲擊你們
Dialogue: 0,0:15:19.96,0:15:23.76,Default,,0,0,0,,叫敵人聯軍的小混混
Dialogue: 0,0:15:25.30,0:15:26.59,Default,,0,0,0,,所以既然要找
Dialogue: 1,0:15:27.17,0:15:30.17,Default2,,0,0,0,,當然要找感覺能跟得上我的
Dialogue: 0,0:15:27.17,0:15:30.17,Default,,0,0,0,,優秀人才囉
Dialogue: 0,0:15:30.88,0:15:33.63,Default,,0,0,0,,於是就從雄英運動會排名前幾名之中
Dialogue: 0,0:15:33.72,0:15:37.06,Default,,0,0,0,,指名了感覺不錯的鳥人，就是這樣
Dialogue: 1,0:15:39.31,0:15:43.02,Default2,,0,0,0,,首先，我想要問你USJ事件的事
Dialogue: 0,0:15:39.31,0:15:43.02,Default,,0,0,0,,可以告訴我嗎？
Dialogue: 1,0:15:45.36,0:15:49.07,Default2,,0,0,0,,就在我跟他說明
Dialogue: 0,0:15:45.36,0:15:49.07,Default,,0,0,0,,USJ襲擊事件的詳情時
Dialogue: 0,0:15:49.15,0:15:51.44,Default,,0,0,0,,不甘心的感覺不斷湧上心頭
Dialogue: 0,0:15:53.62,0:15:55.87,Default,,0,0,0,,我又不是傳信鴿
Dialogue: 1,0:15:57.75,0:16:01.55,Default2,,0,0,0,,為期一週的職場體驗
Dialogue: 0,0:15:57.75,0:16:01.55,Default,,0,0,0,,我什麼都沒學到就結束了
Dialogue: 0,0:16:02.29,0:16:04.79,Default,,0,0,0,,問你喔，九州怎麼樣？
Dialogue: 0,0:16:05.54,0:16:06.79,Default,,0,0,0,,很普通
Dialogue: 0,0:16:08.17,0:16:09.34,Default,,0,0,0,,沒什麼
Dialogue: 0,0:16:10.09,0:16:11.59,Default,,0,0,0,,而之後的實習
Dialogue: 0,0:16:12.51,0:16:14.85,Default,,0,0,0,,他又再次接受了我
Dialogue: 0,0:16:15.35,0:16:17.94,Default,,0,0,0,,從職場體驗到實習的這段期間
Dialogue: 0,0:16:18.02,0:16:19.86,Default,,0,0,0,,雄英也有不少動作
Dialogue: 0,0:16:20.85,0:16:22.48,Default,,0,0,0,,你就是想要問有哪些動作對吧
Dialogue: 0,0:16:22.56,0:16:23.81,Default,,0,0,0,,霍克斯
Dialogue: 0,0:16:24.56,0:16:26.44,Default,,0,0,0,,你可別小看我，第三名…
Dialogue: 0,0:16:26.52,0:16:27.44,Default,,0,0,0,,不對
Dialogue: 0,0:16:27.52,0:16:29.36,Default,,0,0,0,,第二名英雄
Dialogue: 0,0:16:30.90,0:16:32.86,Default,,0,0,0,,月讀同學還真是拼命
Dialogue: 0,0:16:32.95,0:16:34.08,Default,,0,0,0,,前途無量呢
Dialogue: 1,0:16:39.62,0:16:41.58,Default2,,0,0,0,,-真的是辛苦您了
Dialogue: 0,0:16:39.62,0:16:41.58,Default,,0,0,0,,-真的是辛苦您了
Dialogue: 0,0:16:42.08,0:16:43.96,Default,,0,0,0,,常闇同學，可以過來一下嗎？
Dialogue: 0,0:16:46.17,0:16:48.30,Default,,0,0,0,,這次你又要問我什麼了？
Dialogue: 0,0:16:48.38,0:16:50.59,Default,,0,0,0,,我沒有要問你問題啦
Dialogue: 0,0:16:51.72,0:16:53.35,Default,,0,0,0,,霍克斯
Dialogue: 0,0:16:59.60,0:17:01.69,Default,,0,0,0,,我們現在化成風了
Dialogue: 0,0:17:01.77,0:17:03.77,Default,,0,0,0,,你是第一次飛嗎？
Dialogue: 1,0:17:04.90,0:17:08.74,Default2,,0,0,0,,我之所以會找常闇同學來
Dialogue: 0,0:17:04.90,0:17:08.74,Default,,0,0,0,,有兩成是因為你是鳥
Dialogue: 0,0:17:08.82,0:17:11.49,Default,,0,0,0,,五成是想聽敵人聯軍的事情
Dialogue: 1,0:17:11.57,0:17:17.45,Default2,,0,0,0,,剩下的三成是因為我覺得
Dialogue: 0,0:17:11.57,0:17:17.45,Default,,0,0,0,,你在做的事情真是太浪費時間了
Dialogue: 0,0:17:19.45,0:17:21.83,Default,,0,0,0,,天空啊，是很棒的
Dialogue: 0,0:17:21.91,0:17:24.79,Default,,0,0,0,,因為可以俯瞰事物
Dialogue: 0,0:17:26.08,0:17:28.00,Default,,0,0,0,,你說的“浪費時間”是指？
Dialogue: 0,0:17:30.17,0:17:33.67,Default,,0,0,0,,盡力彌補自己在近戰的缺點是很不錯
Dialogue: 1,0:17:33.76,0:17:36.93,Default2,,0,0,0,,只是你最好也不要忘記
Dialogue: 0,0:17:33.76,0:17:36.93,Default,,0,0,0,,發展自己擅長的東西
Dialogue: 0,0:17:37.51,0:17:40.01,Default,,0,0,0,,你可以更自由地行動
Dialogue: 0,0:17:41.10,0:17:44.27,Default,,0,0,0,,雖然我從沒想過要栽培後輩啦
Dialogue: 0,0:17:44.35,0:17:46.77,Default,,0,0,0,,但畢竟我們都是鳥，也算有緣
Dialogue: 0,0:17:51.44,0:17:54.07,Default,,0,0,0,,能飛的傢伙就應該飛上天
Dialogue: 0,0:17:58.07,0:18:01.24,Default,,0,0,0,,根本沒有必要被地面束縛
Dialogue: 0,0:18:04.41,0:18:07.37,Default,,0,0,0,,我就用跟隨霍克斯時創造出的招式
Dialogue: 0,0:18:07.46,0:18:09.42,Default,,0,0,0,,“黑色墮天使”來迎戰吧
Dialogue: 0,0:18:10.75,0:18:13.04,Default,,0,0,0,,黑色墮天使？
Dialogue: 0,0:18:14.17,0:18:15.50,Default,,0,0,0,,聽起來很不錯嘛
Dialogue: 0,0:18:15.59,0:18:17.26,Default,,0,0,0,,就讓我見識看看
Dialogue: 0,0:18:20.01,0:18:21.76,Default,,0,0,0,,他正在影子裡面移動
Dialogue: 0,0:18:21.85,0:18:24.94,Default,,0,0,0,,真沒想到他們又單槍匹馬進行突擊了
Dialogue: 0,0:18:25.52,0:18:27.86,Default,,0,0,0,,沒想到戰況居然會跟第一場一樣
Dialogue: 0,0:18:28.85,0:18:30.39,Default,,0,0,0,,將計就計嗎？
Dialogue: 0,0:18:30.48,0:18:33.57,Default,,0,0,0,,在這種充滿管線的場地
Dialogue: 0,0:18:33.65,0:18:36.07,Default,,0,0,0,,根本不可能掌握他的位置
Dialogue: 0,0:18:36.15,0:18:37.78,Default,,0,0,0,,常闇同學，沒事吧？
Dialogue: 0,0:18:37.86,0:18:39.11,Default,,0,0,0,,沒事
Dialogue: 0,0:18:39.20,0:18:40.87,Default,,0,0,0,,常闇踏陰
Dialogue: 0,0:18:40.95,0:18:43.41,Default,,0,0,0,,我會把你給刺穿
Dialogue: 0,0:18:43.49,0:18:45.41,Default,,0,0,0,,他的目標是我
Dialogue: 0,0:18:46.08,0:18:48.92,Default,,0,0,0,,你們一定是這麼想的吧，A班
Dialogue: 0,0:18:49.92,0:18:52.80,Default,,0,0,0,,我跟你是宿命的存在
Dialogue: 0,0:18:54.05,0:18:58.14,Default,,0,0,0,,從比賽開始前我就設置了精神陷阱
Dialogue: 0,0:18:58.22,0:19:00.89,Default,,0,0,0,,讓人以為我的目標是常闇踏陰
Dialogue: 0,0:19:00.97,0:19:04.10,Default,,0,0,0,,你們應該會這麼認定，但並非如此
Dialogue: 0,0:19:04.18,0:19:07.39,Default,,0,0,0,,陰謀英雄，奈米碳管黑體
Dialogue: 0,0:19:07.48,0:19:10.65,Default,,0,0,0,,這就是我的作風
Dialogue: 0,0:19:12.27,0:19:13.56,Default,,0,0,0,,青山同學？
Dialogue: 0,0:19:14.40,0:19:17.82,Default,,0,0,0,,救命啊
Dialogue: 0,0:19:18.99,0:19:20.20,Default,,0,0,0,,陰謀…
Dialogue: 0,0:19:20.28,0:19:22.20,Default,,0,0,0,,實在太卑鄙了
Dialogue: 0,0:19:22.78,0:19:25.70,Default,,0,0,0,,就從根本徹底地悔悟吧
Dialogue: 0,0:19:25.79,0:19:27.54,Default,,0,0,0,,以我的速度
Dialogue: 0,0:19:27.62,0:19:30.37,Default,,0,0,0,,加上場地既狹窄又複雜
Dialogue: 1,0:19:30.46,0:19:34.63,Default2,,0,0,0,,黑影會因為那條
Dialogue: 0,0:19:30.46,0:19:34.63,Default,,0,0,0,,跟本體相連的“臍帶”而難以行動吧
Dialogue: 0,0:19:34.71,0:19:35.96,Default,,0,0,0,,也就是說
Dialogue: 0,0:19:36.05,0:19:39.76,Default,,0,0,0,,那些傢伙根本沒有辦法追上我
Dialogue: 0,0:19:39.84,0:19:41.22,Default,,0,0,0,,你是這麼認為的嗎？
Dialogue: 0,0:19:43.93,0:19:45.39,Default,,0,0,0,,黑影
Dialogue: 0,0:19:45.47,0:19:47.01,Default,,0,0,0,,黑色墮天使
Dialogue: 1,0:19:47.52,0:19:49.02,Default2,,0,0,0,,-他飛起來了？
Dialogue: 0,0:19:47.52,0:19:49.02,Default,,0,0,0,,-他飛起來了？
Dialogue: 0,0:19:49.10,0:19:50.52,Default,,0,0,0,,常闇同學他…
Dialogue: 0,0:19:50.60,0:19:51.69,Default,,0,0,0,,那是新招
Dialogue: 0,0:19:51.77,0:19:53.52,Default,,0,0,0,,為什麼他可以飛？
Dialogue: 0,0:19:53.61,0:19:55.61,Default,,0,0,0,,這個原理其實很簡單
Dialogue: 0,0:19:55.69,0:19:58.11,Default,,0,0,0,,因為黑影經常處於浮游狀態
Dialogue: 0,0:19:58.19,0:20:01.53,Default,,0,0,0,,所以也能抱著常闇同學移動
Dialogue: 0,0:20:01.61,0:20:03.45,Default,,0,0,0,,更因為被斗篷包起來的關係
Dialogue: 1,0:20:03.53,0:20:07.28,Default2,,0,0,0,,能阻隔光線這個弱點
Dialogue: 0,0:20:03.53,0:20:07.28,Default,,0,0,0,,時時維持著很高的輸出力
Dialogue: 1,0:20:07.37,0:20:10.75,Default2,,0,0,0,,而且那種抱姿的話
Dialogue: 0,0:20:07.37,0:20:10.75,Default,,0,0,0,,雙手也能自由活動
Dialogue: 0,0:20:10.83,0:20:12.62,Default,,0,0,0,,黑影處於浮游狀態
Dialogue: 1,0:20:12.71,0:20:16.80,Default2,,0,0,0,,他看準了大家認為理所當然
Dialogue: 0,0:20:12.71,0:20:16.80,Default,,0,0,0,,並因此疏漏的事實，然後加以應用
Dialogue: 0,0:20:16.88,0:20:19.38,Default,,0,0,0,,這個點子看似單純卻很難想到
Dialogue: 0,0:20:19.46,0:20:22.96,Default,,0,0,0,,好厲害，太厲害了，常闇同學
Dialogue: 1,0:20:23.05,0:20:26.72,Default2,,0,0,0,,只是你最好也不要忘記
Dialogue: 0,0:20:23.05,0:20:26.72,Default,,0,0,0,,發展自己擅長的東西
Dialogue: 0,0:20:26.81,0:20:29.35,Default,,0,0,0,,霍克斯，真的很謝謝你
Dialogue: 0,0:20:33.44,0:20:35.65,Default,,0,0,0,,我會更上一層樓的
Dialogue: 0,0:20:35.73,0:20:38.36,Default,,0,0,0,,閃亮亮的漫步約會
Dialogue: 0,0:20:38.94,0:20:40.86,Default,,0,0,0,,A計畫失敗了
Dialogue: 0,0:20:40.94,0:20:43.53,Default,,0,0,0,,青山同學，使出肚臍自助餐
Dialogue: 0,0:20:43.61,0:20:45.28,Default,,0,0,0,,常闇同學，請自由飛行
Dialogue: 0,0:20:45.37,0:20:47.25,Default,,0,0,0,,黑影，纏住外套
Dialogue: 0,0:20:47.33,0:20:48.29,Default,,0,0,0,,知道了
Dialogue: 0,0:20:48.37,0:20:51.08,Default,,0,0,0,,只要改變影子的形狀就好
Dialogue: 0,0:20:51.16,0:20:52.87,Default,,0,0,0,,肚臍自助餐
Dialogue: 0,0:20:59.09,0:21:00.63,Default,,0,0,0,,找到他了，葉隱同學
Dialogue: 0,0:21:00.71,0:21:03.67,Default,,0,0,0,,好耶，這下能抓住他了
Dialogue: 0,0:21:04.30,0:21:05.22,Default,,0,0,0,,就到此為止了
Dialogue: 0,0:21:05.30,0:21:07.09,Default,,0,0,0,,不會讓你逃掉的
Dialogue: 0,0:21:07.93,0:21:10.18,Default,,0,0,0,,沒想到你會獨自進行突擊
Dialogue: 0,0:21:10.27,0:21:13.11,Default,,0,0,0,,不過，所有意料之外的情形
Dialogue: 0,0:21:13.19,0:21:16.57,Default,,0,0,0,,早就都在我的預料之中了
Dialogue: 0,0:21:17.15,0:21:19.11,Default,,0,0,0,,預料之中啊…
Dialogue: 0,0:21:19.19,0:21:20.27,Default,,0,0,0,,給我站住
Dialogue: 0,0:21:20.36,0:21:21.94,Default,,0,0,0,,還不快點束手就擒
Dialogue: 0,0:21:23.40,0:21:26.53,Default,,0,0,0,,這是磨菇？
Dialogue: 0,0:21:27.91,0:21:29.83,Default,,0,0,0,,果然
Dialogue: 0,0:21:29.91,0:21:32.41,Default,,0,0,0,,還是拳藤技高一籌啊
Dialogue: 0,0:21:34.21,0:21:36.59,Default,,0,0,0,,就跟拳藤說的一樣菇菇
Dialogue: 1,0:21:36.67,0:21:40.30,Default2,,0,0,0,,只要看到光
Dialogue: 0,0:21:36.67,0:21:40.30,Default,,0,0,0,,就代表黑色的A計畫失敗了
Dialogue: 0,0:21:42.34,0:21:44.47,Default,,0,0,0,,開始B計畫
Dialogue: 0,0:21:45.34,0:21:48.01,Default,,0,0,0,,我要讓你們全身都是菇菇
Dialogue: 0,0:23:22.02,0:23:23.10,Default,,0,0,0,,下集預告
Dialogue: 0,0:23:23.19,0:23:25.98,Default,,0,0,0,,雖然A班嘗試進行反擊
Dialogue: 1,0:23:26.07,0:23:29.49,Default2,,0,0,0,,但卻因為B班小森同學
Dialogue: 0,0:23:26.07,0:23:29.49,Default,,0,0,0,,跟吹出同學的大範圍攻擊
Dialogue: 0,0:23:29.57,0:23:32.41,Default,,0,0,0,,讓戰況再次被他們逆轉了
Dialogue: 0,0:23:32.49,0:23:35.58,Default,,0,0,0,,不僅如此，還讓八百萬同學落單了
Dialogue: 0,0:23:36.24,0:23:38.83,Default,,0,0,0,,A班隊伍該怎麼辦？
Dialogue: 0,0:23:38.91,0:23:41.12,Default,,0,0,0,,下一集，放眼未來
Dialogue: 0,0:23:41.21,0:23:43.38,Default,,0,0,0,,預測到戰況的八百萬同學
Dialogue: 0,0:23:43.46,0:23:45.96,Default,,0,0,0,,將為了迎向勝利進行“創造”
Dialogue: 0,0:23:46.05,0:23:47.13,Default,,0,0,0,,更向前邁進吧
Dialogue: 0,0:23:47.21,0:23:48.96,Default,,0,0,0,,超越巔峰


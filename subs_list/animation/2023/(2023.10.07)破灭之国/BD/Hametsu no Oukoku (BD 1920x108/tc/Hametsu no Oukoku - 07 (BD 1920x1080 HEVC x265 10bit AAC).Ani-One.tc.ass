Dialogue: 0,0:00:03.29,0:00:06.33,Default,,0,0,0,,傳送著陸點 座標設定完成
Dialogue: 0,0:00:06.92,0:00:08.46,Default,,0,0,0,,10秒後完成傳送
Dialogue: 0,0:00:08.46,0:00:10.30,Default,,0,0,0,,大和局長要回來了
Dialogue: 0,0:00:10.67,0:00:14.51,Default,,0,0,0,,正確來說 是假扮成大和的魔女弟子
Dialogue: 0,0:00:14.88,0:00:17.30,Default,,0,0,0,,我會替你報仇的 大和
Dialogue: 0,0:00:20.02,0:00:21.89,Default,,0,0,0,,3秒後完成傳送
Dialogue: 0,0:00:21.89,0:00:22.89,Default,,0,0,0,,2
Dialogue: 0,0:00:22.89,0:00:23.85,Default,,0,0,0,,1
Dialogue: 0,0:00:24.14,0:00:24.56,Default,,0,0,0,,開火
Dialogue: 0,0:00:34.65,0:00:35.49,Default,,0,0,0,,什麼
Dialogue: 0,0:00:35.49,0:00:38.99,Default,,0,0,0,,傳…傳送系統裡有追加指令的跡象
Dialogue: 0,0:00:38.99,0:00:41.29,Default,,0,0,0,,傳送座標似乎有所更動
Dialogue: 0,0:00:41.29,0:00:42.87,Default,,0,0,0,,傳送到哪裡去了 快查出來
Dialogue: 0,0:00:42.87,0:00:44.46,Default,,0,0,0,,終端沒有回應
Dialogue: 0,0:00:44.46,0:00:45.92,Default,,0,0,0,,無法進行反追蹤
Dialogue: 0,0:00:58.26,0:01:00.01,Default,,0,0,0,,真有你的…
Dialogue: 0,0:01:01.89,0:01:03.43,Default,,0,0,0,,魔女的弟子
Dialogue: 0,0:01:10.43,0:01:14.50,OPEDJP,,0,0,0,,記憶たどり歩く
Dialogue: 0,0:01:15.83,0:01:19.88,OPEDJP,,0,0,0,,両手で傷を隠し
Dialogue: 0,0:01:21.04,0:01:23.56,OPEDJP,,0,0,0,,絆されたまま
Dialogue: 0,0:01:23.56,0:01:26.33,OPEDJP,,0,0,0,,沈みゆく世界
Dialogue: 0,0:01:26.78,0:01:31.81,OPEDJP,,0,0,0,,ただ纏う悲しみ
Dialogue: 0,0:01:32.28,0:01:37.54,OPEDJP,,0,0,0,,鍵をかけた心の扉
Dialogue: 0,0:01:37.54,0:01:41.28,OPEDJP,,0,0,0,,浚うなら
Dialogue: 0,0:01:41.62,0:01:47.33,OPEDJP,,0,0,0,,闇を消す正義は
Dialogue: 0,0:01:47.61,0:01:52.65,OPEDJP,,0,0,0,,赤く燃える定めのように
Dialogue: 0,0:01:52.97,0:01:58.06,OPEDJP,,0,0,0,,影を写し　堕ちてゆく
Dialogue: 0,0:01:58.06,0:02:02.62,OPEDJP,,0,0,0,,夜さえ越えて
Dialogue: 0,0:02:02.81,0:02:08.52,OPEDJP,,0,0,0,,追いかけた幻影
Dialogue: 0,0:02:08.78,0:02:13.91,OPEDJP,,0,0,0,,掴んでは消える　一縷の希望
Dialogue: 0,0:02:14.04,0:02:19.13,OPEDJP,,0,0,0,,混ざり燃えて　この業火と
Dialogue: 0,0:02:19.36,0:02:24.03,OPEDJP,,0,0,0,,つれ合い奈落へ
Dialogue: 0,0:02:24.29,0:02:25.86,OPEDJP,,0,0,0,,消えるまで
Dialogue: 0,0:01:10.43,0:01:14.50,OPEDCN,,0,0,0,,追溯記憶而行
Dialogue: 0,0:01:15.83,0:01:19.88,OPEDCN,,0,0,0,,以雙手掩蓋傷口
Dialogue: 0,0:01:21.04,0:01:23.56,OPEDCN,,0,0,0,,依然被牽絆束縛
Dialogue: 0,0:01:23.56,0:01:26.33,OPEDCN,,0,0,0,,逐漸沉淪的世界
Dialogue: 0,0:01:26.78,0:01:31.81,OPEDCN,,0,0,0,,只是沉浸在悲傷中
Dialogue: 0,0:01:32.28,0:01:37.54,OPEDCN,,0,0,0,,上了鎖的心扉
Dialogue: 0,0:01:37.54,0:01:41.28,OPEDCN,,0,0,0,,若要使之敞開
Dialogue: 0,0:01:41.62,0:01:47.33,OPEDCN,,0,0,0,,驅散黑暗的正義
Dialogue: 0,0:01:47.61,0:01:52.65,OPEDCN,,0,0,0,,宛若熾烈燃燒的宿命
Dialogue: 0,0:01:52.97,0:01:58.06,OPEDCN,,0,0,0,,捕捉記憶中的身影　逐漸深陷其中
Dialogue: 0,0:01:58.06,0:02:02.62,OPEDCN,,0,0,0,,比黑夜更為深邃
Dialogue: 0,0:02:02.81,0:02:08.52,OPEDCN,,0,0,0,,追逐著往昔幻影
Dialogue: 0,0:02:08.78,0:02:13.91,OPEDCN,,0,0,0,,每當抓住卻又轉瞬即逝的　一線希望
Dialogue: 0,0:02:14.04,0:02:19.13,OPEDCN,,0,0,0,,與這猛烈燃燒的業火融為一體
Dialogue: 0,0:02:19.36,0:02:24.03,OPEDCN,,0,0,0,,一同墜入地獄深淵
Dialogue: 0,0:02:24.29,0:02:25.86,OPEDCN,,0,0,0,,直到化為烏有
Dialogue: 0,0:03:02.68,0:03:04.05,Default,,0,0,0,,妳看那裡
Dialogue: 0,0:03:04.76,0:03:06.43,Default,,0,0,0,,是南十字星座
Dialogue: 0,0:03:07.97,0:03:09.93,Default,,0,0,0,,我們回到地表了
Dialogue: 0,0:03:12.35,0:03:13.44,Default,,0,0,0,,地表…
Dialogue: 0,0:03:18.61,0:03:21.15,Default,,0,0,0,,看來要對付利迪亞不能操之過急
Dialogue: 0,0:03:21.65,0:03:23.20,Default,,0,0,0,,必須從長計議
Dialogue: 0,0:03:28.91,0:03:30.46,Default,,0,0,0,,等一下 阿德尼斯
Dialogue: 0,0:03:30.46,0:03:33.75,Default,,0,0,0,,還有…還有魔女還活著啊…
Dialogue: 0,0:03:35.17,0:03:36.92,Default,,0,0,0,,更正系統命令
Dialogue: 0,0:03:37.63,0:03:39.71,Default,,0,0,0,,變更傳送座標
Dialogue: 0,0:03:40.67,0:03:43.68,Default,,0,0,0,,傳送地點改為地表座標37N-42
Dialogue: 0,0:03:43.95,0:03:48.46,UP,,0,0,0,,（聲音確認）
Dialogue: 0,0:03:44.51,0:03:45.95,Default,,0,0,0,,確認變更
Dialogue: 0,0:03:46.18,0:03:48.24,Default,,0,0,0,,授權人 大和局長
Dialogue: 0,0:03:59.65,0:04:02.20,Default,,0,0,0,,在前往位於北半球的利迪亞的路上
Dialogue: 0,0:04:02.20,0:04:03.57,Default,,0,0,0,,襲進沿路村莊及城鎮
Dialogue: 0,0:04:04.11,0:04:07.87,Default,,0,0,0,,一邊蒐集情報 掠奪物資\N一邊重整態勢
Dialogue: 0,0:04:09.08,0:04:10.45,Default,,0,0,0,,也需要準備些藥物
Dialogue: 0,0:04:15.42,0:04:18.00,Default,,0,0,0,,我想回去跟大家待在一起
Dialogue: 0,0:04:19.59,0:04:21.21,Default,,0,0,0,,妳是不是傻了
Dialogue: 0,0:04:21.67,0:04:24.88,Default,,0,0,0,,那種狀況下\N月球上的魔女不會有人活著的
Dialogue: 0,0:04:25.26,0:04:26.55,Default,,0,0,0,,才沒有那種事
Dialogue: 0,0:04:27.30,0:04:28.26,Default,,0,0,0,,讓我回去吧
Dialogue: 0,0:04:28.89,0:04:30.10,Default,,0,0,0,,妳是鬧脾氣的小孩嗎
Dialogue: 0,0:04:30.81,0:04:32.64,Default,,0,0,0,,那是你吧
Dialogue: 0,0:04:32.64,0:04:35.23,Default,,0,0,0,,張口閉口就是復仇復仇的
Dialogue: 0,0:04:37.65,0:04:39.36,Default,,0,0,0,,書寫式召喚魔法
Dialogue: 0,0:04:39.73,0:04:41.36,Default,,0,0,0,,記憶召喚
Dialogue: 0,0:04:43.24,0:04:49.24,Default,,0,0,0,,請你答應我\N不再追殺我們與阿德尼斯
Dialogue: 0,0:04:49.24,0:04:50.83,Default,,0,0,0,,這樣的話
Dialogue: 0,0:04:51.49,0:04:53.00,Default,,0,0,0,,我就解除魔法
Dialogue: 0,0:04:53.54,0:04:55.25,Default,,0,0,0,,讓我們握手言和吧
Dialogue: 0,0:04:56.12,0:04:57.33,Default,,0,0,0,,不要這樣
Dialogue: 0,0:04:58.00,0:05:01.67,Default,,0,0,0,,所有魔女之中就妳最奇怪
Dialogue: 0,0:05:02.17,0:05:04.72,Default,,0,0,0,,居然想跟人類握手言和
Dialogue: 0,0:05:04.72,0:05:05.97,Default,,0,0,0,,妳腦袋是不是有問題
Dialogue: 0,0:05:08.55,0:05:10.89,Default,,0,0,0,,我一直期待著能見到你
Dialogue: 0,0:05:11.47,0:05:13.85,Default,,0,0,0,,一直在想被魔女克羅耶所選上\N並收為弟子的人
Dialogue: 0,0:05:13.85,0:05:15.64,Default,,0,0,0,,會是個什麼樣的人
Dialogue: 0,0:05:16.31,0:05:20.65,Default,,0,0,0,,一直很好奇 這個"阿德尼斯"\N會是個什麼樣的人
Dialogue: 0,0:05:21.61,0:05:23.74,Default,,0,0,0,,身為人類卻做了魔女的弟子
Dialogue: 0,0:05:24.19,0:05:26.86,Default,,0,0,0,,我認為生活在兩個世界中間的你
Dialogue: 0,0:05:27.45,0:05:31.62,Default,,0,0,0,,一定能成為人類與魔女之間\N溝通的橋梁
Dialogue: 0,0:05:32.29,0:05:33.45,Default,,0,0,0,,所以才…
Dialogue: 0,0:05:34.79,0:05:36.33,Default,,0,0,0,,你明明是大家的希望啊…
Dialogue: 0,0:05:38.12,0:05:38.96,Default,,0,0,0,,妳看吧
Dialogue: 0,0:05:40.00,0:05:41.96,Default,,0,0,0,,妳根本就一點也不瞭解我
Dialogue: 0,0:05:42.59,0:05:44.96,Default,,0,0,0,,那你打算做到什麼地步
Dialogue: 0,0:05:45.51,0:05:47.84,Default,,0,0,0,,經過月面上的戰鬥你應該就明白了
Dialogue: 0,0:05:48.51,0:05:51.43,Default,,0,0,0,,就如同你憎恨人類一般
Dialogue: 0,0:05:51.43,0:05:53.56,Default,,0,0,0,,他們也不可能會原諒你
Dialogue: 0,0:05:54.18,0:05:57.23,Default,,0,0,0,,如此下去 這場鬥爭永遠不會結束
Dialogue: 0,0:05:57.23,0:06:00.52,Default,,0,0,0,,要是不從某個地方斬斷仇恨的連鎖\N這些憎恨是不會消失的
Dialogue: 0,0:06:00.52,0:06:03.36,Default,,0,0,0,,妳說的話撼動不了我
Dialogue: 0,0:06:04.94,0:06:08.53,Default,,0,0,0,,克羅耶的性命\N比全人類的命都還要高貴
Dialogue: 0,0:06:09.11,0:06:12.24,Default,,0,0,0,,奪走她生命的這個世界\N不如毀了算了
Dialogue: 0,0:06:13.83,0:06:15.62,Default,,0,0,0,,為此你打算造成多少犧牲
Dialogue: 0,0:06:16.62,0:06:19.79,Default,,0,0,0,,你可知就因為你的憤怒\N魔女們有何遭遇
Dialogue: 0,0:06:20.21,0:06:22.67,Default,,0,0,0,,都是因為你把人類叫來月球…
Dialogue: 0,0:06:22.67,0:06:26.34,Default,,0,0,0,,不正是因為如此\N我們現在才能回到地表嗎
Dialogue: 0,0:06:28.76,0:06:31.39,Default,,0,0,0,,妳的同伴為我們做了最棒的掩護
Dialogue: 0,0:06:32.80,0:06:34.01,Default,,0,0,0,,好過份…
Dialogue: 0,0:06:35.35,0:06:37.23,Default,,0,0,0,,你怎麼能說出這種話…
Dialogue: 0,0:06:39.89,0:06:42.73,Default,,0,0,0,,大家可是拼死拼活\N才從魔女狩獵中活下來的啊
Dialogue: 0,0:06:42.73,0:06:46.78,Default,,0,0,0,,我不准你嘲笑我們 嘲笑那些生命
Dialogue: 0,0:06:46.78,0:06:48.61,Default,,0,0,0,,到底是誰在嘲笑那些生命
Dialogue: 0,0:06:49.20,0:06:51.53,Default,,0,0,0,,說得這麼好聽
Dialogue: 0,0:06:51.53,0:06:54.45,Default,,0,0,0,,妳剛剛不也看見一堆同伴死在眼前
Dialogue: 0,0:06:54.45,0:06:56.99,Default,,0,0,0,,而妳卻還傻傻地想跟人類握手言和
Dialogue: 0,0:06:56.99,0:07:00.29,Default,,0,0,0,,妳才是最褻瀆那些犧牲的人吧
Dialogue: 0,0:07:02.58,0:07:03.88,Default,,0,0,0,,即便如此…
Dialogue: 0,0:07:05.34,0:07:08.84,Default,,0,0,0,,就算報了仇 也無法治癒你的傷痛啊
Dialogue: 0,0:07:09.38,0:07:10.38,Default,,0,0,0,,無所謂
Dialogue: 0,0:07:11.13,0:07:13.93,Default,,0,0,0,,反正我已經沒什麼好失去的了
Dialogue: 0,0:07:27.48,0:07:29.82,Default,,0,0,0,,你的命是克羅耶捨命守護下來的
Dialogue: 0,0:07:30.61,0:07:35.78,Default,,0,0,0,,無論這個世界再怎麼殘酷\N再怎麼空虛 再怎麼無情
Dialogue: 0,0:07:36.58,0:07:38.79,Default,,0,0,0,,你也別因此淪落
Dialogue: 0,0:07:40.62,0:07:43.88,Default,,0,0,0,,我不會要你原諒他們的所做所為
Dialogue: 0,0:07:43.88,0:07:48.05,Default,,0,0,0,,但如果讓你繼續復仇\N你的心總有一天會崩潰的
Dialogue: 0,0:07:48.84,0:07:52.26,Default,,0,0,0,,你的心會變得跟\N奪走克羅耶生命的那些人類一樣
Dialogue: 0,0:07:54.26,0:07:58.10,Default,,0,0,0,,你明明就有很多不能失去的東西啊
Dialogue: 0,0:08:03.19,0:08:05.90,Default,,0,0,0,,妳果然一點也不瞭解我
Dialogue: 0,0:08:06.94,0:08:09.07,Default,,0,0,0,,復仇是我的存在意義
Dialogue: 0,0:08:10.36,0:08:15.20,Default,,0,0,0,,是魔女克羅耶與我一起相依為命\N無可替代的證明
Dialogue: 0,0:08:16.45,0:08:21.45,Default,,0,0,0,,要是我放棄為她復仇\N她存在的痕跡恐怕會就此消失
Dialogue: 0,0:08:22.58,0:08:23.83,Default,,0,0,0,,我很害怕這一點
Dialogue: 0,0:08:25.25,0:08:27.25,Default,,0,0,0,,妳能理解這種感覺嗎
Dialogue: 0,0:08:33.13,0:08:35.84,Default,,0,0,0,,妳真的是有夠愛哭耶
Dialogue: 0,0:08:37.93,0:08:39.60,Default,,0,0,0,,抱歉
Dialogue: 0,0:08:39.60,0:08:40.97,Default,,0,0,0,,我…
Dialogue: 0,0:08:46.56,0:08:47.86,Default,,0,0,0,,阿德尼斯
Dialogue: 0,0:08:49.27,0:08:50.78,Default,,0,0,0,,你儂我儂耶
Dialogue: 0,0:08:52.28,0:08:54.45,Default,,0,0,0,,總之先報告一下吧
Dialogue: 0,0:08:54.95,0:08:59.83,Default,,0,0,0,,12點鐘方向有對男女在月光下\N正打得火熱
Dialogue: 0,0:09:01.12,0:09:04.00,Default,,0,0,0,,在沙漠的正中央搞也算是厲害了
Dialogue: 0,0:09:04.41,0:09:06.71,Default,,0,0,0,,是從城市逃出來的奴隸嗎
Dialogue: 0,0:09:06.71,0:09:08.42,Default,,0,0,0,,但看他們的穿著還挺整齊的
Dialogue: 0,0:09:08.79,0:09:11.59,Default,,0,0,0,,八成是一起私奔的小鬼頭吧
Dialogue: 0,0:09:11.59,0:09:14.17,Default,,0,0,0,,真是的 淨會給人添麻煩
Dialogue: 0,0:09:14.17,0:09:16.51,Default,,0,0,0,,出現什麼樣的人都不足為奇
Dialogue: 0,0:09:16.51,0:09:18.09,Default,,0,0,0,,畢竟這裡可不是舊世界啊
Dialogue: 0,0:09:19.68,0:09:22.64,Default,,0,0,0,,那麼我們該怎麼做呢 拳頭哥
Dialogue: 0,0:09:23.42,0:09:26.98,Screen,,0,0,0,,{\blur3\fad(450,0)\pos(370,1080)}頭目 拳頭
Dialogue: 0,0:09:43.95,0:09:46.37,Default,,0,0,0,,我真的是受夠了
Dialogue: 0,0:09:46.37,0:09:49.17,Default,,0,0,0,,這種在不明地點醒來的狀況…
Dialogue: 0,0:09:50.42,0:09:53.25,Default,,0,0,0,,我失去了意識…
Dialogue: 0,0:09:54.09,0:09:55.30,Default,,0,0,0,,然後…
Dialogue: 0,0:10:02.97,0:10:04.77,Default,,0,0,0,,那個 不好意思
Dialogue: 0,0:10:04.77,0:10:06.14,Default,,0,0,0,,請你們幫幫忙
Dialogue: 0,0:10:06.73,0:10:08.64,Default,,0,0,0,,我的朋友受傷了
Dialogue: 0,0:10:12.19,0:10:15.48,Default,,0,0,0,,我們兩個…在這裡迷了路
Dialogue: 0,0:10:18.78,0:10:22.49,Default,,0,0,0,,也就是說\N這裡是那群飆車族的地盤嗎
Dialogue: 0,0:10:22.49,0:10:24.45,Default,,0,0,0,,你醒來啦 小鬼
Dialogue: 0,0:10:27.16,0:10:30.12,Default,,0,0,0,,這眼神還真是可怕 你是殺了人嗎
Dialogue: 0,0:10:33.84,0:10:35.80,Default,,0,0,0,,總之 先來一口吧
Dialogue: 0,0:10:35.80,0:10:37.42,Default,,0,0,0,,要療傷喝酒就對了
Dialogue: 0,0:10:40.34,0:10:41.51,Default,,0,0,0,,廢棄民…
Dialogue: 0,0:10:41.97,0:10:44.85,Default,,0,0,0,,不好意思 我沒有喝污水的習慣
Dialogue: 0,0:10:47.02,0:10:48.68,Default,,0,0,0,,你還挺有趣的嘛
Dialogue: 0,0:10:48.93,0:10:52.81,Default,,0,0,0,,居然把人類最棒的發明\N稱之為"污水"
Dialogue: 0,0:10:57.07,0:10:58.78,Default,,0,0,0,,我叫拳頭
Dialogue: 0,0:10:58.78,0:11:00.03,Default,,0,0,0,,是這裡的老大
Dialogue: 0,0:11:00.91,0:11:02.91,Default,,0,0,0,,"這裡"果然是聚居地嗎
Dialogue: 0,0:11:03.45,0:11:05.49,Default,,0,0,0,,但卻不像是利迪亞支配下的地區
Dialogue: 0,0:11:06.79,0:11:09.04,Default,,0,0,0,,除了我之外\N應該還有一位年輕女性吧
Dialogue: 0,0:11:09.46,0:11:10.50,Default,,0,0,0,,她怎麼了
Dialogue: 0,0:11:10.50,0:11:13.75,Default,,0,0,0,,你說那個有著桃紅色頭髮的姑娘嗎
Dialogue: 0,0:11:13.75,0:11:15.21,Default,,0,0,0,,她很可愛耶
Dialogue: 0,0:11:15.63,0:11:17.25,Default,,0,0,0,,是你的女人嗎
Dialogue: 0,0:11:17.80,0:11:20.09,Default,,0,0,0,,她剛剛還在這裡照顧你
Dialogue: 0,0:11:20.09,0:11:23.84,Default,,0,0,0,,然後就被我的小弟們帶走了
Dialogue: 0,0:11:23.84,0:11:25.18,Default,,0,0,0,,回答我的問題
Dialogue: 0,0:11:25.89,0:11:27.10,Default,,0,0,0,,那個女人怎麼了
Dialogue: 0,0:11:28.85,0:11:31.06,Default,,0,0,0,,別那麼衝嘛
Dialogue: 0,0:11:32.40,0:11:34.52,Default,,0,0,0,,跟我來吧 小鬼
Dialogue: 0,0:11:44.45,0:11:45.99,Default,,0,0,0,,這裡是廢材平原
Dialogue: 0,0:11:46.41,0:11:51.62,Default,,0,0,0,,是超產業革命所帶來的另一種風景
Dialogue: 0,0:11:52.16,0:11:54.71,Default,,0,0,0,,發展中國家的居民和難民
Dialogue: 0,0:11:54.71,0:11:57.42,Default,,0,0,0,,還有從利迪亞逃離的奴隸們
Dialogue: 0,0:11:57.42,0:12:01.30,Default,,0,0,0,,被科學所淘汰的人們都流落到這裡
Dialogue: 0,0:12:01.30,0:12:03.55,Default,,0,0,0,,久而久之 大家就都成了廢棄民
Dialogue: 0,0:12:03.79,0:12:05.29,Default,,0,0,0,,（產地 利迪亞）
Dialogue: 0,0:12:07.10,0:12:08.31,Default,,0,0,0,,真是悲慘
Dialogue: 0,0:12:08.76,0:12:09.85,Default,,0,0,0,,可不是嗎
Dialogue: 0,0:12:09.85,0:12:10.98,Default,,0,0,0,,不要 快住手
Dialogue: 0,0:12:15.27,0:12:17.77,Default,,0,0,0,,拜託 請不要這樣
Dialogue: 0,0:12:17.77,0:12:19.53,Default,,0,0,0,,不可以這個樣子
Dialogue: 0,0:12:21.03,0:12:23.32,Default,,0,0,0,,不要 我都說不要了
Dialogue: 0,0:12:23.32,0:12:24.78,Default,,0,0,0,,不要啊
Dialogue: 0,0:12:26.03,0:12:27.07,Default,,0,0,0,,他們想做什麼
Dialogue: 0,0:12:27.58,0:12:30.49,Default,,0,0,0,,這一帶女人可是很稀有的
Dialogue: 0,0:12:30.49,0:12:32.62,Default,,0,0,0,,更別說是年輕女孩了
Dialogue: 0,0:12:32.62,0:12:36.04,Default,,0,0,0,,你的女人叫得可真是動聽啊
Dialogue: 0,0:12:44.26,0:12:45.38,Default,,0,0,0,,這群人渣
Dialogue: 0,0:12:52.77,0:12:55.64,Default,,0,0,0,,不行啦 會掉下去的啦
Dialogue: 0,0:12:56.85,0:12:58.69,Default,,0,0,0,,這個要怎麼停下來啦
Dialogue: 0,0:12:58.69,0:13:02.36,Default,,0,0,0,,拜託來個人幫我停下來啊
Dialogue: 0,0:13:02.74,0:13:06.07,Default,,0,0,0,,腰要挺直 膝蓋要微彎來做緩衝
Dialogue: 0,0:13:06.91,0:13:08.95,Default,,0,0,0,,這表演太讚了
Dialogue: 0,0:13:10.03,0:13:11.48,Default,,0,0,0,,妳這是在搞什麼
Dialogue: 0,0:13:12.75,0:13:14.83,Default,,0,0,0,,阿德尼斯 你醒來了啊
Dialogue: 0,0:13:14.83,0:13:15.75,Default,,0,0,0,,太好了
Dialogue: 0,0:13:21.30,0:13:22.71,Default,,0,0,0,,你的傷勢還好吧
Dialogue: 0,0:13:22.71,0:13:23.96,Default,,0,0,0,,妳傷得才重吧
Dialogue: 0,0:13:24.80,0:13:26.88,Default,,0,0,0,,對了 請收下這個
Dialogue: 0,0:13:27.04,0:13:32.04,UP,,0,0,0,,（和好的證明）
Dialogue: 0,0:13:28.14,0:13:31.53,Default,,0,0,0,,抱歉 我沒注意到你的傷勢
Dialogue: 0,0:13:32.47,0:13:35.73,Default,,0,0,0,,還有對你說了很過分的話
Dialogue: 0,0:13:38.69,0:13:39.98,Default,,0,0,0,,這什麼鬼 我才不要
Dialogue: 0,0:13:41.61,0:13:43.03,Default,,0,0,0,,喂 兄弟們
Dialogue: 0,0:13:43.61,0:13:45.15,Default,,0,0,0,,要開趴了
Dialogue: 0,0:13:45.15,0:13:46.28,Default,,0,0,0,,快去準備
Dialogue: 0,0:13:46.28,0:13:48.49,Default,,0,0,0,,- 好啊\N- 是時隔半天的酒啊
Dialogue: 0,0:13:48.86,0:13:50.53,Default,,0,0,0,,你們也來幫忙
Dialogue: 0,0:13:50.53,0:13:53.41,Default,,0,0,0,,救了你們一命 至少來幫忙倒酒吧
Dialogue: 0,0:13:58.96,0:14:01.46,Default,,0,0,0,,乾杯…
Dialogue: 0,0:14:01.46,0:14:03.55,Default,,0,0,0,,很好 別輸了
Dialogue: 0,0:14:03.55,0:14:04.92,Default,,0,0,0,,喂 拿酒來
Dialogue: 0,0:14:04.92,0:14:06.42,Default,,0,0,0,,- 這裡還要三杯\N- 這裡沒酒了
Dialogue: 0,0:14:06.42,0:14:07.22,Default,,0,0,0,,這裡也要
Dialogue: 0,0:14:08.47,0:14:10.97,Default,,0,0,0,,好 馬上就來
Dialogue: 0,0:14:12.93,0:14:16.39,Default,,0,0,0,,妳就是拳頭救回來的那位姑娘嗎
Dialogue: 0,0:14:17.18,0:14:18.44,Default,,0,0,0,,是的
Dialogue: 0,0:14:18.44,0:14:19.94,Default,,0,0,0,,我很感謝他出手相助
Dialogue: 0,0:14:21.81,0:14:25.11,Default,,0,0,0,,妳好漂亮 好可愛喔
Dialogue: 0,0:14:25.69,0:14:27.03,Default,,0,0,0,,糟了 不行
Dialogue: 0,0:14:30.85,0:14:31.60,Default,,0,0,0,,（鎖定奶子）
Dialogue: 0,0:14:31.60,0:14:33.66,Default,,0,0,0,,我的年事已高
Dialogue: 0,0:14:33.66,0:14:35.49,Default,,0,0,0,,小手手不聽話啦
Dialogue: 0,0:14:43.59,0:14:46.71,Default,,0,0,0,,要是想續杯的話再叫我喔
Dialogue: 0,0:14:47.97,0:14:50.38,Default,,0,0,0,,小姑娘身手不錯嘛
Dialogue: 0,0:15:08.53,0:15:11.36,Default,,0,0,0,,難不成妳跟男朋友吵架了嗎
Dialogue: 0,0:15:11.36,0:15:13.45,Default,,0,0,0,,男…
Dialogue: 0,0:15:13.45,0:15:15.41,Default,,0,0,0,,不是的 我們不是那種關係…
Dialogue: 0,0:15:15.78,0:15:19.37,Default,,0,0,0,,不是的話\N那為什麼你們會出現在那裡
Dialogue: 0,0:15:19.37,0:15:21.83,Default,,0,0,0,,他們肯定是一對啦
Dialogue: 0,0:15:21.83,0:15:23.42,Default,,0,0,0,,她這麼可愛
Dialogue: 0,0:15:23.42,0:15:24.96,Default,,0,0,0,,羨慕死我了
Dialogue: 0,0:15:24.96,0:15:26.63,Default,,0,0,0,,才不是咧 豬頭
Dialogue: 0,0:15:26.63,0:15:30.34,Default,,0,0,0,,應該是跟我們一樣\N整個國家被利迪亞滅掉了吧
Dialogue: 0,0:15:30.72,0:15:32.47,Default,,0,0,0,,所以才會逃到這裡來
Dialogue: 0,0:15:33.05,0:15:36.01,Default,,0,0,0,,我們是那個…
Dialogue: 0,0:15:36.01,0:15:38.18,Default,,0,0,0,,是…是一起旅行的同伴
Dialogue: 0,0:15:38.18,0:15:40.48,Default,,0,0,0,,我跟那邊的那位阿德…
Dialogue: 0,0:15:40.48,0:15:45.40,Default,,0,0,0,,跟那位朋友正在進行環遊世界之旅
Dialogue: 0,0:15:45.40,0:15:47.86,Default,,0,0,0,,這裡…也是個很棒的地方呢
Dialogue: 0,0:15:52.74,0:15:55.16,Default,,0,0,0,,這姑娘果然有趣啊
Dialogue: 0,0:15:55.16,0:15:56.16,Default,,0,0,0,,太棒了
Dialogue: 0,0:15:56.16,0:15:59.58,Default,,0,0,0,,居然還想在這個世道旅行
Dialogue: 0,0:16:02.41,0:16:03.62,Default,,0,0,0,,說得也是…
Dialogue: 0,0:16:08.46,0:16:09.67,Default,,0,0,0,,你沒事吧
Dialogue: 0,0:16:14.89,0:16:16.14,Default,,0,0,0,,大家…
Dialogue: 0,0:16:16.14,0:16:17.55,Default,,0,0,0,,你們是怎麼了
Dialogue: 0,0:16:19.22,0:16:23.85,Default,,0,0,0,,就是因為不留心吃下肚的東西\N你們才會淪為廢棄民的
Dialogue: 0,0:16:23.85,0:16:24.90,Default,,0,0,0,,一群蠢蛋
Dialogue: 0,0:16:24.90,0:16:27.19,Default,,0,0,0,,阿德尼斯 你做了什麼
Dialogue: 0,0:16:27.65,0:16:29.07,Default,,0,0,0,,你該不會在酒裡下毒了吧
Dialogue: 0,0:16:29.07,0:16:30.23,Default,,0,0,0,,並沒有
Dialogue: 0,0:16:31.24,0:16:37.07,Default,,0,0,0,,只要將酒精的結構稍加重組\N就能使其轉變為安眠藥
Dialogue: 0,0:16:38.16,0:16:40.45,Default,,0,0,0,,妳連這種術式都看不懂嗎
Dialogue: 0,0:16:41.29,0:16:42.50,Default,,0,0,0,,虧妳還是魔女
Dialogue: 0,0:16:42.61,0:16:43.98,Default,,0,0,0,,（虧妳還是魔女）
Dialogue: 0,0:16:44.33,0:16:46.67,Default,,0,0,0,,因為我比較笨嘛
Dialogue: 0,0:16:46.67,0:16:48.88,Default,,0,0,0,,完全沒看出來
Dialogue: 0,0:16:48.88,0:16:51.63,Default,,0,0,0,,他們都沒死對吧
Dialogue: 0,0:16:51.63,0:16:52.76,Default,,0,0,0,,目前是這樣
Dialogue: 0,0:16:54.47,0:16:55.72,Default,,0,0,0,,等一下
Dialogue: 0,0:16:55.72,0:16:58.47,Default,,0,0,0,,阿德尼斯 我想你錯怪他們了
Dialogue: 0,0:16:58.97,0:17:01.85,Default,,0,0,0,,這裡的人都是親切的好人喔
Dialogue: 0,0:17:01.85,0:17:04.94,Default,,0,0,0,,不僅從沙漠中把我們救了回來
Dialogue: 0,0:17:04.94,0:17:06.40,Default,,0,0,0,,還為我們上藥包紮…
Dialogue: 0,0:17:06.40,0:17:07.19,Default,,0,0,0,,那又怎樣
Dialogue: 0,0:17:08.65,0:17:10.44,Default,,0,0,0,,我是說 他們是我們的救命恩人
Dialogue: 0,0:17:11.07,0:17:13.07,Default,,0,0,0,,妳知道有句話叫"恩將仇報"嗎
Dialogue: 0,0:17:13.53,0:17:16.57,Default,,0,0,0,,要是沒有他們你現在早就…
Dialogue: 0,0:17:18.12,0:17:19.28,Default,,0,0,0,,我不會殺他們
Dialogue: 0,0:17:20.74,0:17:22.87,Default,,0,0,0,,廢棄民比人類還不如
Dialogue: 0,0:17:23.33,0:17:24.29,Default,,0,0,0,,沒有動手的價值
Dialogue: 0,0:17:26.33,0:17:27.12,Default,,0,0,0,,還有
Dialogue: 0,0:17:29.21,0:17:32.46,Default,,0,0,0,,我果然還是不需要妳
Dialogue: 0,0:17:33.38,0:17:34.38,Default,,0,0,0,,再見
Dialogue: 0,0:17:34.38,0:17:36.47,Default,,0,0,0,,等…等一下
Dialogue: 0,0:17:37.09,0:17:38.01,Default,,0,0,0,,為什麼…
Dialogue: 0,0:17:38.43,0:17:41.26,Default,,0,0,0,,我跟妳一樣 失去了最重視的人
Dialogue: 0,0:17:41.26,0:17:43.47,Default,,0,0,0,,但我無法像妳這樣嘻皮笑臉
Dialogue: 0,0:17:44.77,0:17:49.44,Default,,0,0,0,,更別說要我跟這群人混在一起打鬧
Dialogue: 0,0:17:51.11,0:17:53.90,Default,,0,0,0,,我們從根本上\N就是水火不容的兩個人
Dialogue: 0,0:17:56.45,0:17:57.57,Default,,0,0,0,,因為…
Dialogue: 0,0:17:58.16,0:18:01.74,Default,,0,0,0,,要是我們的身分暴露的話\N那該怎麼辦
Dialogue: 0,0:18:02.37,0:18:05.00,Default,,0,0,0,,必須得混入人群裡生活
Dialogue: 0,0:18:05.62,0:18:08.58,Default,,0,0,0,,所有舉止必須要小心\N不能讓人發現自己是魔女
Dialogue: 0,0:18:09.58,0:18:12.54,Default,,0,0,0,,所以我只能笑 只能迎合他們
Dialogue: 0,0:18:14.30,0:18:17.76,Default,,0,0,0,,但是 大家發生了那種事\N我怎麼可能…
Dialogue: 0,0:18:17.76,0:18:19.09,Default,,0,0,0,,如果妳我互不相容
Dialogue: 0,0:18:19.80,0:18:21.39,Default,,0,0,0,,那妳就別變成我這個樣子
Dialogue: 0,0:18:21.39,0:18:22.22,Default,,0,0,0,,多羅卡
Dialogue: 0,0:18:42.37,0:18:44.20,Default,,0,0,0,,謝謝你們
Dialogue: 0,0:18:44.20,0:18:45.83,Default,,0,0,0,,你們真是溫柔
Dialogue: 0,0:18:45.83,0:18:47.91,Default,,0,0,0,,妳男朋友走掉了嗎
Dialogue: 0,0:18:48.91,0:18:50.00,Default,,0,0,0,,拳頭先生
Dialogue: 0,0:18:51.54,0:18:53.25,Default,,0,0,0,,他不是我男朋友
Dialogue: 0,0:18:54.71,0:18:57.71,Default,,0,0,0,,話說回來 他也太沒禮貌了吧
Dialogue: 0,0:18:57.71,0:19:00.97,Default,,0,0,0,,居然連聲謝謝都沒跟本大爺說\N就這麼走了
Dialogue: 0,0:19:01.68,0:19:05.89,Default,,0,0,0,,而且還把一個姑娘丟在這種地方
Dialogue: 0,0:19:05.89,0:19:08.93,Default,,0,0,0,,妳跟他分手是正確的
Dialogue: 0,0:19:11.35,0:19:13.61,Default,,0,0,0,,不是的 他其實…
Dialogue: 0,0:19:16.65,0:19:18.19,Default,,0,0,0,,那妳就別變成我這個樣子
Dialogue: 0,0:19:20.53,0:19:23.24,Default,,0,0,0,,他其實是個非常溫柔的人
Dialogue: 0,0:19:36.71,0:19:40.76,Default,,0,0,0,,就算報了仇 也無法治癒你的傷痛啊
Dialogue: 0,0:19:40.76,0:19:43.39,Default,,0,0,0,,不要 快住手 阿德尼斯
Dialogue: 0,0:19:43.39,0:19:46.97,Default,,0,0,0,,要是克羅耶看到你現在這個樣子\N不知道她會怎麼想
Dialogue: 0,0:19:46.97,0:19:52.90,Default,,0,0,0,,這是世上最棒的魔女\N為她的弟子取的名字
Dialogue: 0,0:19:52.90,0:19:55.06,Default,,0,0,0,,你不再是一個人了
Dialogue: 0,0:19:55.77,0:19:56.52,Default,,0,0,0,,阿德尼斯
Dialogue: 0,0:19:58.11,0:19:59.07,Default,,0,0,0,,可惡
Dialogue: 0,0:20:00.82,0:20:01.82,Default,,0,0,0,,追兵來了嗎
Dialogue: 0,0:20:02.74,0:20:04.95,Default,,0,0,0,,安眠藥的藥效太弱了嗎
Dialogue: 0,0:20:05.45,0:20:06.99,Default,,0,0,0,,還是說那是利迪亞的…
Dialogue: 0,0:20:07.66,0:20:08.04,Default,,0,0,0,,不
Dialogue: 0,0:20:08.91,0:20:10.16,Default,,0,0,0,,誰來都無所謂
Dialogue: 0,0:20:11.50,0:20:13.87,Default,,0,0,0,,誰敢擋我 我就殺了他
Dialogue: 0,0:20:13.87,0:20:15.46,Default,,0,0,0,,誰來都一樣
Dialogue: 0,0:20:19.84,0:20:21.97,Default,,0,0,0,,魔女弟子 阿德尼斯
Dialogue: 0,0:20:22.63,0:20:24.26,Default,,0,0,0,,你…你剛剛說什麼
Dialogue: 0,0:20:24.26,0:20:26.14,Default,,0,0,0,,不是的 他是…
Dialogue: 0,0:20:26.93,0:20:28.85,Default,,0,0,0,,我以前見過他
Dialogue: 0,0:20:29.81,0:20:30.31,Default,,0,0,0,,咦
Dialogue: 0,0:20:31.14,0:20:33.48,Default,,0,0,0,,我不曾忘記過 那天發生的事
Dialogue: 0,0:20:34.44,0:20:37.06,Default,,0,0,0,,命懸一線時的我看到了
Dialogue: 0,0:20:39.15,0:20:41.24,Default,,0,0,0,,看到陣陣發光的白雪
Dialogue: 0,0:20:42.07,0:20:43.74,Default,,0,0,0,,以及那位冰之魔女
Dialogue: 0,0:20:50.62,0:20:55.00,Default,,0,0,0,,身邊有個不惜與世界為敵\N也要重視的珍愛之人
Dialogue: 0,0:20:55.00,0:20:57.08,Default,,0,0,0,,那是種極致的幸福
Dialogue: 0,0:20:58.75,0:20:59.88,Default,,0,0,0,,拳頭先生…
Dialogue: 0,0:21:01.21,0:21:04.26,Default,,0,0,0,,姑娘妳的想法或許是對的
Dialogue: 0,0:21:04.68,0:21:08.43,Default,,0,0,0,,然而復仇到底是好還是壞
Dialogue: 0,0:21:08.43,0:21:11.10,Default,,0,0,0,,這種事情\N是無法簡簡單單就能下定論的
Dialogue: 0,0:21:11.89,0:21:15.69,Default,,0,0,0,,這個世界就是如此殘酷到\N令人不忍直視
Dialogue: 0,0:21:17.40,0:21:19.86,Default,,0,0,0,,那個小鬼選擇走上復仇之路
Dialogue: 0,0:21:19.86,0:21:22.69,Default,,0,0,0,,即便明知這是個有去無回的旅程
Dialogue: 0,0:21:22.69,0:21:24.70,Default,,0,0,0,,那也是他自己選的
Dialogue: 0,0:21:26.03,0:21:27.57,Default,,0,0,0,,那妳呢
Dialogue: 0,0:21:29.74,0:21:32.62,Default,,0,0,0,,我不想再看到有人死去了
Dialogue: 0,0:21:33.79,0:21:36.33,Default,,0,0,0,,既然我沒能保護好安娜還有其他人
Dialogue: 0,0:21:37.71,0:21:39.58,Default,,0,0,0,,那我至少要保護好阿德尼斯
Dialogue: 0,0:21:40.21,0:21:42.84,Default,,0,0,0,,那妳還有時間在這裡跟我聊天嗎
Dialogue: 0,0:21:42.84,0:21:43.67,Default,,0,0,0,,魔女
Dialogue: 0,0:21:44.59,0:21:46.47,Default,,0,0,0,,讓開啊
Dialogue: 0,0:21:46.47,0:21:47.72,Default,,0,0,0,,阿德尼斯
Dialogue: 0,0:21:47.72,0:21:48.72,Default,,0,0,0,,什麼
Dialogue: 0,0:21:54.14,0:21:55.89,Default,,0,0,0,,混帳東西
Dialogue: 0,0:21:55.89,0:21:57.14,Default,,0,0,0,,妳是想撞死我嗎
Dialogue: 0,0:21:58.06,0:21:59.86,Default,,0,0,0,,阿德尼斯 那個…
Dialogue: 0,0:21:59.86,0:22:02.82,Default,,0,0,0,,我會盡量努力不扯你的後腿的
Dialogue: 0,0:22:02.82,0:22:03.94,Default,,0,0,0,,所以…
Dialogue: 0,0:22:03.94,0:22:04.90,Default,,0,0,0,,什麼
Dialogue: 0,0:22:05.99,0:22:07.82,Default,,0,0,0,,我們還是一起走吧
Dialogue: 0,0:22:10.37,0:22:14.29,Default,,0,0,0,,我想了一下\N我覺得你還是需要我的
Dialogue: 0,0:22:14.29,0:22:15.75,Default,,0,0,0,,一個人上路很危險的
Dialogue: 0,0:22:15.75,0:22:18.62,Default,,0,0,0,,不是常有人說嗎\N出門遠行要結伴同行
Dialogue: 0,0:22:18.62,0:22:20.96,Default,,0,0,0,,而且你一個人會很寂寞吧
Dialogue: 0,0:22:20.96,0:22:24.88,Default,,0,0,0,,我的意思是說\N我們彼此都很會寂寞
Dialogue: 0,0:22:24.88,0:22:27.84,Default,,0,0,0,,所以要在一路上互相扶持之類的…
Dialogue: 0,0:22:27.84,0:22:29.47,Default,,0,0,0,,為什麼不停車…
Dialogue: 0,0:22:34.22,0:22:35.47,Default,,0,0,0,,真是的…
Dialogue: 0,0:22:35.47,0:22:37.14,Default,,0,0,0,,這個靜不下來的傢伙
Dialogue: 0,0:22:37.98,0:22:41.44,Default,,0,0,0,,那個…這個要怎麼停下來啦
Dialogue: 0,0:22:44.90,0:22:47.65,Default,,0,0,0,,你可別惹女人哭了喔
Dialogue: 0,0:22:48.24,0:22:50.16,Default,,0,0,0,,救命啊
Dialogue: 0,0:22:50.16,0:22:52.12,Default,,0,0,0,,按下煞車 就是那個像握桿的東西
Dialogue: 0,0:22:52.12,0:22:55.12,Default,,0,0,0,,魔女克羅耶的愛徒
Dialogue: 0,0:23:12.56,0:23:16.45,OPEDJP,,0,0,0,,小さな幸せ胸に隠して
Dialogue: 0,0:23:16.45,0:23:20.38,OPEDJP,,0,0,0,,壊れないようにそっと温めた
Dialogue: 0,0:23:20.38,0:23:24.14,OPEDJP,,0,0,0,,戻らない日々が瞬くたびに
Dialogue: 0,0:23:24.27,0:23:29.56,OPEDJP,,0,0,0,,痛みが波打つように覆いかかる
Dialogue: 0,0:23:29.56,0:23:37.09,OPEDJP,,0,0,0,,奪った分だけ　奪い返されるなら
Dialogue: 0,0:23:37.42,0:23:44.45,OPEDJP,,0,0,0,,託した願いが　願いを繋ぐように
Dialogue: 0,0:23:44.45,0:23:53.00,OPEDJP,,0,0,0,,どうか怒りも涙も　叫んで
Dialogue: 0,0:23:53.00,0:23:59.02,OPEDJP,,0,0,0,,ひとり絡まって　二度と戻れなくなる前に
Dialogue: 0,0:23:59.02,0:24:08.48,OPEDJP,,0,0,0,,どんな痛みも　消し去ることのできない思い出も
Dialogue: 0,0:24:08.62,0:24:18.44,OPEDJP,,0,0,0,,もう譲ることなく　ただ振り上げたその手に触れて
Dialogue: 0,0:24:19.83,0:24:24.19,OPEDJP,,0,0,0,,結ぶ指で祈りをそっと
Dialogue: 0,0:23:12.56,0:23:16.45,OPEDCN,,0,0,0,,將微小的幸福珍藏於心
Dialogue: 0,0:23:16.45,0:23:20.38,OPEDCN,,0,0,0,,害怕會破碎而小心呵護著
Dialogue: 0,0:23:20.38,0:23:24.14,OPEDCN,,0,0,0,,每當不願回想的往昔湧上心頭
Dialogue: 0,0:23:24.27,0:23:29.56,OPEDCN,,0,0,0,,痛楚就如浪潮般一波一波地襲來
Dialogue: 0,0:23:29.56,0:23:37.09,OPEDCN,,0,0,0,,若是能奪回　那些被奪走的一切
Dialogue: 0,0:23:37.42,0:23:44.45,OPEDCN,,0,0,0,,願你託付給我的心願　仍連繫著我的願望
Dialogue: 0,0:23:44.45,0:23:53.00,OPEDCN,,0,0,0,,請將怒火和淚水　都發泄出來吧
Dialogue: 0,0:23:53.00,0:23:59.02,OPEDCN,,0,0,0,,在一個人心亂如麻　變得無法再回頭之前
Dialogue: 0,0:23:59.02,0:24:08.48,OPEDCN,,0,0,0,,無論是痛苦　抑或那些無法盡數抹去的記憶
Dialogue: 0,0:24:08.62,0:24:18.44,OPEDCN,,0,0,0,,並非是已經妥協　只不過是要去觸碰那雙高舉的手
Dialogue: 0,0:24:19.83,0:24:24.19,OPEDCN,,0,0,0,,用十指緊扣的手指靜靜地祈禱
Dialogue: 0,0:22:55.54,0:22:58.54,Default,,0,0,0,,

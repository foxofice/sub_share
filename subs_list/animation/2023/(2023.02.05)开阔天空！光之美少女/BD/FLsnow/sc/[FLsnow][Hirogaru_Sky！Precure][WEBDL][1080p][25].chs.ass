Dialogue: 0,0:15:33.46,0:15:35.67,CureSky,NTP,0,0,0,,小空 去安全的地方！
Dialogue: 0,0:15:36.05,0:15:37.17,PrinAir,NTP,0,0,0,,小空！
Dialogue: 0,0:15:38.45,0:15:39.66,DarkBnd,NTP,0,0,0,,突击！
Dialogue: 0,0:15:39.85,0:15:41.72,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:15:43.32,0:15:44.18,CurePri,NTP,0,0,0,,喝！
Dialogue: 0,0:15:44.36,0:15:45.41,DarkBnd,NTP,0,0,0,,乱！
Dialogue: 0,0:15:45.74,0:15:46.71,DarkBnd,NTP,0,0,0,,暴！
Dialogue: 0,0:15:48.09,0:15:49.84,DarkBnd,NTP,0,0,0,,哇哈哈哈...
Dialogue: 0,0:15:50.05,0:15:52.75,DarkBnd,NTP,0,0,0,,吾乃暗塌谷帝国最强的武人
Dialogue: 0,0:15:53.12,0:15:57.06,DarkBnd,NTP,0,0,0,,吾变化而出的乱暴兽可谓是强中强
Dialogue: 0,0:15:58.99,0:16:01.82,CureWin,NTP,0,0,0,,霸天龙的原型是霸王龙
Dialogue: 0,0:16:02.12,0:16:04.77,CureWin,NTP,0,0,0,,霸王龙的咬合力非常强
Dialogue: 0,0:16:05.42,0:16:07.70,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:16:09.93,0:16:12.33,DarkBnd,NTP,0,0,0,,乱！乱！
Dialogue: 0,0:16:12.51,0:16:14.55,CureBut,NTP,0,0,0,,喂喂 这也太吓人了
Dialogue: 0,0:16:14.83,0:16:15.86,CurePri,NTP,0,0,0,,呀！
Dialogue: 0,0:16:16.28,0:16:18.80,CureSky,NTP,0,0,0,,打脸不行的话... 哼！
Dialogue: 0,0:16:19.09,0:16:21.74,CureSky,NTP,0,0,0,,就打身子！喝！
Dialogue: 0,0:16:21.92,0:16:22.61,DarkBnd,NTP,0,0,0,,乱！
Dialogue: 0,0:16:22.79,0:16:23.39,CureWin,NTP,0,0,0,,危险！
Dialogue: 0,0:16:24.44,0:16:26.08,DarkBnd,NTP,0,0,0,,暴！
Dialogue: 0,0:16:29.24,0:16:30.68,DarkBnd,NTP,0,0,0,,乱
Dialogue: 0,0:16:32.17,0:16:32.78,CurePri,NTP,0,0,0,,喝！
Dialogue: 0,0:16:32.96,0:16:33.86,DarkBnd,NTP,0,0,0,,拉拉...
Dialogue: 0,0:16:34.06,0:16:37.19,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:16:52.01,0:16:54.08,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:16:54.35,0:16:56.60,PrinAir,NTP,0,0,0,,小空... 小空？
Dialogue: 0,0:17:00.76,0:17:01.89,PrinAir,NTP,0,0,0,,兔兔！
Dialogue: 0,0:17:04.01,0:17:05.83,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:17:11.39,0:17:12.51,CurePri,NTP,0,0,0,,啊！
Dialogue: 0,0:17:12.71,0:17:13.88,DarkBnd,NTP,0,0,0,,乱？
Dialogue: 0,0:17:14.08,0:17:14.91,CurePri,NTP,0,0,0,,小空！
Dialogue: 0,0:17:14.08,0:17:14.91,CureWin,NTP,0,0,0,,{\an3}公主！
Dialogue: 0,0:17:15.74,0:17:17.50,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:17:17.64,0:17:18.74,PrinAir,NTP,0,0,0,,小空...
Dialogue: 0,0:17:20.79,0:17:23.34,PrinAir,NTP,0,0,0,,回家家！
Dialogue: 0,0:17:25.38,0:17:31.83,CureSky,NTP,0,0,0,,我们回爸爸妈妈... 回家里去吧？
Dialogue: 0,0:17:33.48,0:17:34.74,CureSky,NTP,0,0,0,,小空...
Dialogue: 0,0:17:35.66,0:17:37.65,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:17:44.05,0:17:45.16,CurePri,NTP,0,0,0,,诶
Dialogue: 0,0:17:45.87,0:17:47.07,DarkBnd,NTP,0,0,0,,拉拉
Dialogue: 0,0:17:47.27,0:17:49.57,DarkBnd,NTP,0,0,0,,敢于面对强者的勇气！
Dialogue: 0,0:17:49.82,0:17:50.92,DarkBnd,NTP,0,0,0,,还只是一个孩子...
Dialogue: 0,0:17:51.38,0:17:53.35,DarkBnd,NTP,0,0,0,,佩服！
Dialogue: 0,0:17:54.58,0:17:56.37,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:17:56.57,0:17:57.70,CureBut,NTP,0,0,0,,诶
Dialogue: 0,0:17:58.86,0:18:01.52,CurePri,NTP,0,0,0,,小空和小兔子快去安全的地方！
Dialogue: 0,0:18:01.74,0:18:02.95,PrinAir,NTP,0,0,0,,小空！
Dialogue: 0,0:18:03.40,0:18:05.98,CureSky,NTP,0,0,0,,你们的目标是小空吧！
Dialogue: 0,0:18:06.48,0:18:09.40,CureSky,NTP,0,0,0,,那为什么还要从乱暴兽的攻击下保护她
Dialogue: 0,0:18:10.54,0:18:14.33,DarkBnd,NTP,0,0,0,,武人不会向小孩利齿相向
Dialogue: 0,0:18:15.87,0:18:18.84,DarkBnd,NTP,0,0,0,,天空公主等打倒你们再说
Dialogue: 0,0:18:19.21,0:18:21.53,DarkBnd,NTP,0,0,0,,吾已迫不及待
Dialogue: 0,0:18:21.86,0:18:24.41,DarkBnd,NTP,0,0,0,,期待与你们这样的强者一战！
Dialogue: 0,0:18:25.92,0:18:28.65,DarkBnd,NTP,0,0,0,,继续！上吧！乱暴兽！
Dialogue: 0,0:18:28.87,0:18:30.60,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:18:30.92,0:18:32.30,CureBut,NTP,0,0,0,,喝！
Dialogue: 0,0:18:35.76,0:18:37.40,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:18:37.58,0:18:39.52,CureWin,NTP,0,0,0,,那嘴太强了 无法打近身！
Dialogue: 0,0:18:39.79,0:18:41.22,CureSky,NTP,0,0,0,,嘴不行的话...
Dialogue: 0,0:18:42.44,0:18:44.51,CureSky,NTP,0,0,0,,就断尾 哼！
Dialogue: 0,0:18:45.75,0:18:46.63,DarkBnd,NTP,0,0,0,,乱！
Dialogue: 0,0:18:46.92,0:18:47.83,CureSky,NTP,0,0,0,,Butterfly！
Dialogue: 0,0:18:48.14,0:18:49.20,CureBut,NTP,0,0,0,,OK！
Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0,0,0,,
Dialogue: 0,0:18:56.75,0:18:58.53,CureBut,NTP,0,0,0,,双色合一！
Dialogue: 0,0:18:58.94,0:19:00.13,CureBut,NTP,0,0,0,,红色！
Dialogue: 0,0:18:58.94,0:19:00.13,CureBut,NTP,0,0,0,,{\fs50}Red！
Dialogue: 0,0:19:01.58,0:19:02.73,CureBut,NTP,0,0,0,,白色！
Dialogue: 0,0:19:01.58,0:19:02.73,CureBut,NTP,0,0,0,,{\fs50}White！
Dialogue: 0,0:19:06.50,0:19:09.22,CureBut,NTP,0,0,0,,活力 飞扬起来吧！
Dialogue: 0,0:19:12.04,0:19:13.07,DarkBnd,NTP,0,0,0,,拉拉
Dialogue: 0,0:19:13.80,0:19:16.03,CureSky,NTP,0,0,0,,看招！
Dialogue: 0,0:19:16.54,0:19:19.56,DarkBnd,NTP,0,0,0,,乱暴！
Dialogue: 0,0:19:20.57,0:19:22.10,CureBut,NTP,0,0,0,,神采飞扬地上 Wing！
Dialogue: 0,0:19:22.32,0:19:23.53,CureWin,NTP,0,0,0,,是！
Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0,0,0,,
Dialogue: 0,0:19:24.90,0:19:26.94,CureBut,NTP,0,0,0,,全色合一！
Dialogue: 0,0:19:27.23,0:19:28.57,CureBut,NTP,0,0,0,,融合调色盘！
Dialogue: 0,0:19:27.23,0:19:28.57,CureBut,NTP,0,0,0,,{\fs50}Mix Palette！
Dialogue: 0,0:19:29.01,0:19:29.85,CureBut,NTP,0,0,0,,红色！
Dialogue: 0,0:19:29.01,0:19:29.85,CureBut,NTP,0,0,0,,{\fs50}Red！
Dialogue: 0,0:19:31.71,0:19:32.87,CureBut,NTP,0,0,0,,黄色！
Dialogue: 0,0:19:31.71,0:19:32.87,CureBut,NTP,0,0,0,,{\fs50}Yellow！
Dialogue: 0,0:19:34.31,0:19:35.50,CureBut,NTP,0,0,0,,蓝色！
Dialogue: 0,0:19:34.31,0:19:35.50,CureBut,NTP,0,0,0,,{\fs50}Blue！
Dialogue: 0,0:19:37.01,0:19:38.28,CureBut,NTP,0,0,0,,白色！
Dialogue: 0,0:19:37.01,0:19:38.28,CureBut,NTP,0,0,0,,{\fs50}White！
Dialogue: 0,0:19:44.86,0:19:45.74,CureBut,NTP,0,0,0,,搅拌搅拌
Dialogue: 0,0:19:45.91,0:19:47.42,CureBut,NTP,0,0,0,,色彩填充！
Dialogue: 0,0:19:45.91,0:19:47.42,CureBut,NTP,0,0,0,,{\fs50}Colour Charge！
Dialogue: 0,0:20:01.02,0:20:11.31,CureBut,NTP,0,0,0,,光美·绚烂彩虹冲击！
Dialogue: 0,0:20:01.02,0:20:11.31,CureBut,NTP,0,0,0,,{\fs50}Precure Titanic Rainbow Attack！
Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0,0,0,,
Dialogue: 0,0:20:16.03,0:20:18.38,DarkBnd,NTP,0,0,0,,豁然开朗
Dialogue: 1,0:20:16.03,0:20:18.38,Default,NTP,0,0,0,,{\fad(500,0)}豁然开朗
Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0,0,0,,
Dialogue: 0,0:20:27.00,0:20:31.19,DarkBnd,NTP,0,0,0,,嗯！这才够格与吾一战
Dialogue: 0,0:20:31.37,0:20:33.00,DarkBnd,NTP,0,0,0,,弥诺彤彤！
Dialogue: 0,0:20:34.98,0:20:37.09,PrinAir,NTP,0,0,0,,兔兔 请用
Dialogue: 0,0:20:40.46,0:20:44.80,CureBut,NTP,0,0,0,,这样啊 刚才小空是在模仿小晴啊
Dialogue: 0,0:20:45.19,0:20:46.64,CureSky,NTP,0,0,0,,好像是的
Dialogue: 0,0:20:46.83,0:20:49.73,CureSky,NTP,0,0,0,,虽然不希望她模仿这种危险的举动...
Dialogue: 0,0:20:50.79,0:20:53.27,Default,NTP,0,0,0,,呜！哇！
Dialogue: 0,0:20:54.05,0:20:56.14,Default,NTP,0,0,0,,来呀 不怕的
Dialogue: 0,0:21:00.12,0:21:01.60,PrinAir,NTP,0,0,0,,请用
Dialogue: 0,0:21:08.84,0:21:10.05,Default,NTP,0,0,0,,哇！
Dialogue: 0,0:21:10.25,0:21:11.92,PrinAir,NTP,0,0,0,,好朋友
Dialogue: 0,0:21:15.15,0:21:18.22,PrinAir,NTP,0,0,0,,好 好朋友
Dialogue: 0,0:21:18.44,0:21:19.63,CurePri,NTP,0,0,0,,小空...
Dialogue: 0,0:21:19.88,0:21:22.92,CureWin,NTP,0,0,0,,之前还不懂礼让的
Dialogue: 0,0:21:23.15,0:21:27.34,CureBut,NTP,0,0,0,,小白画书讲的道理 小空记在心里了
Dialogue: 0,0:21:29.37,0:21:32.29,CureSky,NTP,0,0,0,,小空 在我们没有察觉的时候
Dialogue: 0,0:21:32.52,0:21:35.57,CureSky,NTP,0,0,0,,学会了各种各样的道理呢
Dialogue: 0,0:21:35.86,0:21:36.81,CurePri,NTP,0,0,0,,嗯
Dialogue: 0,0:21:39.87,0:21:42.85,CurePri,NTP,0,0,0,,类似“这样就行了吗”的不安和烦恼
Dialogue: 0,0:21:43.08,0:21:45.56,CurePri,NTP,0,0,0,,以后还会一直持续吧
Dialogue: 0,0:21:46.02,0:21:49.86,CurePri,NTP,0,0,0,,但是 小空在我们的养育下 越来越善良
Dialogue: 0,0:21:50.14,0:21:52.83,CurePri,NTP,0,0,0,,所以 现在这样就行了吧
Dialogue: 0,0:21:53.04,0:21:54.28,CureSky,NTP,0,0,0,,没问题！
Dialogue: 0,0:21:54.70,0:21:58.10,CureWin,NTP,0,0,0,,大伙一起来思考 属于我们的答案吧
Dialogue: 0,0:21:58.59,0:22:01.16,CureBut,NTP,0,0,0,,嗯 大伙一起照料她
Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0,0,0,,
Dialogue: 0,0:22:07.74,0:22:10.11,CureBut,NTP,0,0,0,,今天是我 Cure Bloom哦！
Dialogue: 0,0:22:07.74,0:22:10.11,CureBut,NTP,0,0,0,,{\fs50\pos(1060,970)}花愈卫
Dialogue: 0,0:22:10.83,0:22:14.13,CureBut,NTP,0,0,0,,大家和我都要状态绝佳！
Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0,0,0,,
Dialogue: 0,0:23:47.43,0:23:49.46,CureBut,NTP,0,0,0,,说到机场 就属这个了
Dialogue: 0,0:23:49.68,0:23:51.39,PrinAir,NTP,0,0,0,,灰机 飞了！
Dialogue: 0,0:23:51.58,0:23:54.04,CureSky,NTP,0,0,0,,为什么那么大的东西都能飞？
Dialogue: 0,0:23:54.29,0:23:56.44,CurePri,NTP,0,0,0,,呜... 阿翼 你来说吧
Dialogue: 0,0:23:56.65,0:23:58.69,CureWin,NTP,0,0,0,,是 我来说明
Dialogue: 0,0:23:59.78,0:24:01.14,CureSky,NTP,0,0,0,,Hirogaru Sky！Precure
Dialogue: 0,0:23:59.78,0:24:01.14,CureSky,NTP,0,0,0,,{\fs50}海阔天空！光之美少女
Dialogue: 0,0:24:01.33,0:24:03.83,CureSky,NTP,0,0,0,,起飞！由飞机相系的感情
Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0,0,0,,
Dialogue: 0,0:01:36.18,0:01:38.39,OP,NTP,0,0,0,,{\fad(300,0)}（冲上蓝天！）
Dialogue: 0,0:01:38.39,0:01:43.98,OP,NTP,0,0,0,,振翅高飞 超越云巅
Dialogue: 0,0:01:44.19,0:01:49.53,OP,NTP,0,0,0,,飞吧！向着海阔天空的世界 Precure
Dialogue: 0,0:01:49.53,0:01:57.24,OP,NTP,0,0,0,,（晴空万里 美丽蓝天 翱翔吧）
Dialogue: 0,0:01:57.44,0:02:02.40,OP,NTP,0,0,0,,雨后初霁天空棱镜折射出彩虹
Dialogue: 0,0:02:02.65,0:02:06.65,OP,NTP,0,0,0,,蓝天的景色预告着有好事发生
Dialogue: 0,0:02:06.65,0:02:08.13,OP,NTP,0,0,0,,（蓝天的景色）
Dialogue: 0,0:02:08.13,0:02:12.43,OP,NTP,0,0,0,,想要确认一下 便伸直了双手
Dialogue: 0,0:02:13.01,0:02:17.01,OP,NTP,0,0,0,,抓住了名为希望的光芒
Dialogue: 0,0:02:17.10,0:02:18.97,OP,NTP,0,0,0,,秒速紧握！紧紧握住！
Dialogue: 0,0:02:19.10,0:02:23.56,OP,NTP,0,0,0,,战胜绝望吧
Dialogue: 0,0:02:23.94,0:02:27.51,OP,NTP,0,0,0,,我们能坚强
Dialogue: 0,0:02:27.51,0:02:30.90,OP,NTP,0,0,0,,{\pos(700,1070)}擦干眼泪
Dialogue: 0,0:02:28.55,0:02:30.90,OP,NTP,0,0,0,,{\fad(300,0)}{\pos(1090,1070)}（你已经做好准备了吗）
Dialogue: 0,0:02:30.90,0:02:32.93,OP,NTP,0,0,0,,{\pos(700,1070)}飞跃而起
Dialogue: 0,0:02:31.30,0:02:32.93,OP,NTP,0,0,0,,{\fad(300,0)}{\pos(1090,1070)}(让我们张开勇气之翼）
Dialogue: 0,0:02:33.28,0:02:38.66,OP,NTP,0,0,0,,振翅高飞 朝气蓬勃
Dialogue: 0,0:02:38.87,0:02:43.33,OP,NTP,0,0,0,,把烦躁化为光芒
Dialogue: 0,0:02:43.58,0:02:48.63,OP,NTP,0,0,0,,未知的世界 未来的图景 充满着可能
Dialogue: 0,0:02:48.80,0:02:53.38,OP,NTP,0,0,0,,与在同一片蓝天下的伙伴
Dialogue: 0,0:02:53.76,0:02:56.18,OP,NTP,0,0,0,,一起唤起通向明日的奇迹！
Dialogue: 0,0:02:56.30,0:03:04.18,OP,NTP,0,0,0,,英雄少女 海阔天空！Precure

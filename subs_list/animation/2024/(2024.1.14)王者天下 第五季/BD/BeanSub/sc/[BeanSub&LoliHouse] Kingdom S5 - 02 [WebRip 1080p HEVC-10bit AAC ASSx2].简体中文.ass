Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕组制作 仅供学习交流 禁止用于商业用途
Comment: 0,0:01:28.98,0:01:29.03,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:01:50.21,0:01:56.64,op-jp,,0,0,0,,滴る汗と日差しで閉じた目
Dialogue: 0,0:01:56.64,0:02:02.89,op-jp,,0,0,0,,映し出したのはあなたとの約束
Dialogue: 0,0:02:02.89,0:02:09.53,op-jp,,0,0,0,,意志を紡いだ導火線に火をつけたら
Dialogue: 0,0:02:09.53,0:02:15.28,op-jp,,0,0,0,,今より強く高く翔べる
Dialogue: 0,0:02:15.28,0:02:22.01,op-jp,,0,0,0,,恐れを知って哀を知って進むなら
Dialogue: 0,0:02:22.01,0:02:29.48,op-jp,,0,0,0,,己の全て捧げ旗を上げろ
Dialogue: 0,0:02:29.48,0:02:35.05,op-jp,,0,0,0,,掠れた声を何度も張りあげてよ
Dialogue: 0,0:02:35.05,0:02:39.93,op-jp,,0,0,0,,希望を決意を抱いて
Dialogue: 0,0:01:50.21,0:01:56.64,op-cn,,0,0,0,,汗水滚落 烈日当头 我闭上双眼
Dialogue: 0,0:01:56.64,0:02:02.89,op-cn,,0,0,0,,眼中映出 与你的约定
Dialogue: 0,0:02:02.89,0:02:09.53,op-cn,,0,0,0,,点燃以意志织成的导火线
Dialogue: 0,0:02:09.53,0:02:15.28,op-cn,,0,0,0,,向着更高更强 振翅高飞
Dialogue: 0,0:02:15.28,0:02:22.01,op-cn,,0,0,0,,知晓恐惧 知晓哀伤 前进不息
Dialogue: 0,0:02:22.01,0:02:29.48,op-cn,,0,0,0,,献出一切 高举旗帜
Dialogue: 0,0:02:29.48,0:02:35.05,op-cn,,0,0,0,,无数次发出嘶吼
Dialogue: 0,0:02:35.05,0:02:39.93,op-cn,,0,0,0,,心怀希望 坚定决心
Comment: 0,0:23:15.96,0:23:15.96,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:27.05,0:23:30.00,ed-jp,,0,0,1,,なぁ坊やどうした？ここは戦場だぜ
Dialogue: 0,0:23:30.00,0:23:32.83,ed-jp,,0,0,1,,たぎる憎悪のラリー　背馳の成長過程
Dialogue: 0,0:23:32.83,0:23:35.64,ed-jp,,0,0,1,,加減も知らず殺気立ったままの剣に
Dialogue: 0,0:23:35.64,0:23:38.81,ed-jp,,0,0,1,,発汗する体　カルマか咎　如何に？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-jp,,0,0,1,,恒　現実は不調和な旋律さ
Dialogue: 0,0:23:41.28,0:23:44.29,ed-jp,,0,0,1,,冷血なステンレス製の心臓持つ演説者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-jp,,0,0,1,,何回目の明滅　また凱旋するテンペスタ
Dialogue: 0,0:23:46.94,0:23:50.04,ed-jp,,0,0,1,,アーチかける善悪　もう応答しない生存者
Dialogue: 0,0:23:51.14,0:23:53.78,ed-jp,,0,0,0,,花のよう　咲うＭｙ　Ｒｅｄ
Dialogue: 0,0:23:53.95,0:24:02.32,ed-jp,,0,0,0,,守りたいものだって　この掌離れれば
Dialogue: 0,0:24:02.48,0:24:09.95,ed-jp,,0,0,0,,壊したいものなんて　壊せないものだけ
Dialogue: 0,0:24:11.85,0:24:17.59,ed-jp,,0,0,0,,唸る　その狂気が　花咲かすダリア
Dialogue: 0,0:24:17.59,0:24:20.31,ed-jp,,0,0,0,,振りかざす度　歪んだ定規
Dialogue: 0,0:24:20.31,0:24:23.15,ed-jp,,0,0,0,,反射する対照的な正義
Dialogue: 0,0:24:23.15,0:24:28.82,ed-jp,,0,0,0,,裏切りのゲリラ　散らす羽たちが
Dialogue: 0,0:24:28.82,0:24:31.80,ed-jp,,0,0,0,,飛ぶ鳥の蹴った地面のようさ
Dialogue: 0,0:24:31.80,0:24:36.87,ed-jp,,0,0,0,,君にもあるんでしょう？キズツケタクナイモノ
Dialogue: 0,0:23:27.05,0:23:30.00,ed-cn,,0,0,0,,怎么了小弟弟？这里可是战场
Dialogue: 0,0:23:30.00,0:23:32.83,ed-cn,,0,0,0,,是憎恶翻腾的拉力赛 与成长背道而驰
Dialogue: 0,0:23:32.83,0:23:35.64,ed-cn,,0,0,0,,不知轻重 利剑杀气腾腾
Dialogue: 0,0:23:35.64,0:23:38.81,ed-cn,,0,0,0,,汗流浃背 是业是罪 如何判定？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-cn,,0,0,0,,现实永远是不和谐旋律
Dialogue: 0,0:23:41.28,0:23:44.29,ed-cn,,0,0,0,,拥有钢铁心脏的冷血演讲者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-cn,,0,0,0,,第几次电闪雷鸣 暴风雨再次凯旋
Dialogue: 0,0:23:46.94,0:23:50.04,ed-cn,,0,0,0,,善恶架上彩虹 生还者已无应答
Dialogue: 0,0:23:51.14,0:23:53.78,ed-cn,,0,0,0,,如花般绽放笑容 My Red
Dialogue: 0,0:23:53.95,0:24:02.32,ed-cn,,0,0,0,,想要守护之物 离开掌中便无从守护
Dialogue: 0,0:24:02.48,0:24:09.95,ed-cn,,0,0,0,,想要毁灭之物 全都是无法毁灭之物
Dialogue: 0,0:24:11.85,0:24:17.59,ed-cn,,0,0,0,,呻吟不止 疯狂如盛开的大丽花
Dialogue: 0,0:24:17.59,0:24:20.31,ed-cn,,0,0,0,,标尺一经举起 立刻扭曲
Dialogue: 0,0:24:20.31,0:24:23.15,ed-cn,,0,0,0,,反射出对立的正义
Dialogue: 0,0:24:23.15,0:24:28.82,ed-cn,,0,0,0,,叛逆的游击 散落的羽翼
Dialogue: 0,0:24:28.82,0:24:31.80,ed-cn,,0,0,0,,如飞鸟蹬踏的地面一般
Dialogue: 0,0:24:31.80,0:24:36.87,ed-cn,,0,0,0,,你一定也有不愿伤害之物
Dialogue: 0,0:00:06.99,0:00:07.91,Default,,0,0,0,,信大人
Dialogue: 0,0:00:09.20,0:00:12.23,Default,,0,0,0,,这家伙…力气好大
Dialogue: 0,0:00:13.40,0:00:16.01,Default,,0,0,0,,竟然能挡下我的一击
Dialogue: 0,0:00:16.21,0:00:16.83,Default,,0,0,0,,信…
Dialogue: 0,0:00:20.57,0:00:21.76,Default,,0,0,0,,连骑兵都来了
Dialogue: 0,0:00:22.34,0:00:23.79,Default,,0,0,0,,他们究竟是…
Dialogue: 0,0:00:24.17,0:00:25.11,Default,,0,0,0,,后退
Dialogue: 0,0:00:25.11,0:00:27.76,Default,,0,0,0,,就照军师姑娘说的 暂时后退…
Dialogue: 0,0:00:33.48,0:00:35.32,Default,,0,0,0,,不要后退 飞信队
Dialogue: 0,0:00:35.69,0:00:37.04,Default,,0,0,0,,什么？
Dialogue: 0,0:00:38.50,0:00:40.93,Default,,0,0,0,,现在背朝敌人很危险
Dialogue: 0,0:00:41.03,0:00:44.57,Default,,0,0,0,,既然被夹击 就互相掩护背后 原地战斗
Dialogue: 0,0:00:44.66,0:00:48.67,Default,,0,0,0,,再坚持一下 后方的楚水骑兵队马上就来了
Dialogue: 0,0:00:49.07,0:00:50.79,Default,,0,0,0,,那样就能重整旗鼓
Dialogue: 0,0:00:50.87,0:00:54.53,Default,,0,0,0,,把这些大摇大摆攻来的家伙全部干掉
Dialogue: 0,0:00:54.53,0:00:57.08,Default,,0,0,0,,都给我坚持到那时 伙计们
Dialogue: 0,0:00:59.17,0:01:00.71,Default,,0,0,0,,重整旗鼓啊
Dialogue: 0,0:01:01.14,0:01:03.85,Default,,0,0,0,,你们有那个时间吗
Dialogue: 0,0:01:09.38,0:01:11.09,Default,,0,0,0,,那是什么
Dialogue: 0,0:01:11.40,0:01:13.21,Default,,0,0,0,,秦国的蠢货们
Dialogue: 0,0:01:13.49,0:01:16.87,Default,,0,0,0,,我们的统率 纪彗说过一句话
Dialogue: 0,0:01:17.08,0:01:18.64,Default,,0,0,0,,在这个黑羊
Dialogue: 0,0:01:19.84,0:01:22.90,Default,,0,0,0,,将对手玩弄于股掌者胜
Dialogue: 0,0:01:24.23,0:01:24.82,Default,,0,0,0,,什么？
Dialogue: 0,0:01:25.55,0:01:28.05,Default,,0,0,0,,我们这一侧的山丘被占领了？
Dialogue: 0,0:02:59.53,0:03:02.74,biaoti,,0,0,0,,{\fad(480,480)}战场的气味
Dialogue: 0,0:03:00.60,0:03:02.21,Default,,0,0,0,,头儿 你看那个
Dialogue: 0,0:03:02.32,0:03:04.36,Default,,0,0,0,,靠近我方山丘上的烟
Dialogue: 0,0:03:04.53,0:03:07.05,Default,,0,0,0,,飞信队应该会直接通过不作占领
Dialogue: 0,0:03:07.34,0:03:10.04,Default,,0,0,0,,而右翼应该还没那么快能占领
Dialogue: 0,0:03:10.64,0:03:13.13,Default,,0,0,0,,而且 我们有那种信号吗
Dialogue: 0,0:03:13.49,0:03:16.13,Default,,0,0,0,,那个蠢货奴仆
Dialogue: 0,0:03:21.78,0:03:25.40,Default,,0,0,0,,上啊 信 干掉那个大块头
Dialogue: 0,0:03:25.40,0:03:26.95,Default,,0,0,0,,那匹马能撑住吗
Dialogue: 0,0:03:28.13,0:03:29.15,Default,,0,0,0,,将军
Dialogue: 0,0:03:30.18,0:03:30.86,Default,,0,0,0,,将军？
Dialogue: 0,0:03:39.48,0:03:40.46,Default,,0,0,0,,真惊人
Dialogue: 0,0:03:40.55,0:03:43.08,Default,,0,0,0,,就连刘冬都挡不住我的战斧
Dialogue: 0,0:03:43.32,0:03:45.60,Default,,0,0,0,,而你却挡下了两次正面挥砍
Dialogue: 0,0:03:45.60,0:03:47.11,Default,,0,0,0,,信大人
Dialogue: 0,0:03:50.64,0:03:52.12,Default,,0,0,0,,是楚水副长
Dialogue: 0,0:03:52.12,0:03:53.30,Default,,0,0,0,,好
Dialogue: 0,0:03:53.72,0:03:56.01,Default,,0,0,0,,将军 应该已经足够了
Dialogue: 0,0:03:57.44,0:03:58.58,Default,,0,0,0,,我叫马呈
Dialogue: 0,0:03:58.99,0:04:03.51,Default,,0,0,0,,没想到一上来就能和猎物本人交手
Dialogue: 0,0:04:04.29,0:04:06.41,Default,,0,0,0,,这是好机会 但没时间了
Dialogue: 0,0:04:07.20,0:04:10.84,Default,,0,0,0,,下次我会率大军攻来 好好期待吧
Dialogue: 0,0:04:11.24,0:04:13.36,Default,,0,0,0,,飞信队 信
Dialogue: 0,0:04:14.15,0:04:15.39,Default,,0,0,0,,告辞
Dialogue: 0,0:04:16.91,0:04:20.01,Default,,0,0,0,,开什么玩笑 谁会乖乖放你逃走啊
Dialogue: 0,0:04:20.01,0:04:21.33,Default,,0,0,0,,等等 信
Dialogue: 0,0:04:22.19,0:04:24.22,Default,,0,0,0,,追击就交给楚水队
Dialogue: 0,0:04:24.65,0:04:26.25,Default,,0,0,0,,有件事更重要
Dialogue: 0,0:04:28.44,0:04:31.08,Default,,0,0,0,,现在的问题是那边
Dialogue: 0,0:04:32.52,0:04:35.93,Default,,0,0,0,,一开始就派出两名亲信
Dialogue: 0,0:04:36.01,0:04:38.30,Default,,0,0,0,,胆量不小啊 纪彗
Dialogue: 0,0:04:38.91,0:04:44.64,Default,,0,0,0,,在这黑羊 不择手段抢先取得主导权尤为重要
Dialogue: 0,0:04:44.97,0:04:48.50,Default,,0,0,0,,但若是失败 将会付出巨大代价
Dialogue: 0,0:04:49.28,0:04:50.60,Default,,0,0,0,,你是喜好赌博吗
Dialogue: 0,0:04:51.04,0:04:52.40,Default,,0,0,0,,这并非赌博
Dialogue: 0,0:04:53.32,0:04:57.80,Default,,0,0,0,,我相信马呈和刘冬的实力
Dialogue: 0,0:04:58.75,0:05:01.41,Default,,0,0,0,,刘冬大人 准备已经就绪
Dialogue: 0,0:05:03.69,0:05:06.79,Default,,0,0,0,,真的要只靠我们去攻打山丘吗
Dialogue: 0,0:05:07.40,0:05:08.92,Default,,0,0,0,,那样的高低差
Dialogue: 0,0:05:09.07,0:05:13.48,Default,,0,0,0,,我们往上爬的时候 会被箭雨和石头直击啊
Dialogue: 0,0:05:13.77,0:05:16.92,Default,,0,0,0,,而且 还不知道敌军有多少人
Dialogue: 0,0:05:17.56,0:05:20.97,Default,,0,0,0,,占领山丘的一定是小队
Dialogue: 0,0:05:22.36,0:05:26.79,Default,,0,0,0,,敌人应该是利用我们不知道的河川支流
Dialogue: 0,0:05:26.98,0:05:28.68,Default,,0,0,0,,来到了这么深的地方
Dialogue: 0,0:05:29.75,0:05:33.31,Default,,0,0,0,,但大规模的军队绝不可能以这种方式移动
Dialogue: 0,0:05:34.24,0:05:35.55,Default,,0,0,0,,如果只是小队敌人
Dialogue: 0,0:05:35.76,0:05:39.00,Default,,0,0,0,,那即使对方占据地利 我们飞信队也能单独作战
Dialogue: 0,0:05:39.84,0:05:42.12,Default,,0,0,0,,那也不可能没有损失
Dialogue: 0,0:05:42.71,0:05:43.57,Default,,0,0,0,,我知道
Dialogue: 0,0:05:44.20,0:05:45.87,Default,,0,0,0,,但要是现在不打下来
Dialogue: 0,0:05:46.18,0:05:48.56,Default,,0,0,0,,敌人就会在山丘上集结 筑城要塞
Dialogue: 0,0:05:48.89,0:05:51.47,Default,,0,0,0,,那时就真的需要大军才能攻下了
Dialogue: 0,0:05:54.37,0:05:56.79,Default,,0,0,0,,要打只能趁现在 是吧
Dialogue: 0,0:05:57.46,0:05:57.94,Default,,0,0,0,,对
Dialogue: 0,0:05:58.45,0:06:00.68,Default,,0,0,0,,但是 要怎么攻打山丘
Dialogue: 0,0:06:01.30,0:06:02.06,Default,,0,0,0,,放心
Dialogue: 0,0:06:02.88,0:06:05.41,Default,,0,0,0,,用单纯的战术就一定能攻下
Dialogue: 0,0:06:06.14,0:06:07.20,Default,,0,0,0,,听好了
Dialogue: 0,0:06:07.35,0:06:10.00,Default,,0,0,0,,组成盾墙 不要留一丝空隙
Dialogue: 0,0:06:10.36,0:06:13.96,Default,,0,0,0,,我们要顶着箭雨 从正面光明正大地往上爬
Dialogue: 0,0:06:14.95,0:06:16.53,Default,,0,0,0,,能做到吗
Dialogue: 0,0:06:17.48,0:06:19.23,Default,,0,0,0,,能做到吗
Dialogue: 0,0:06:20.89,0:06:23.00,Default,,0,0,0,,好 我们上
Dialogue: 0,0:06:23.00,0:06:24.86,Default,,0,0,0,,山丘比预想的要大
Dialogue: 0,0:06:24.86,0:06:27.52,Default,,0,0,0,,敌军小队不可能防守所有方向
Dialogue: 0,0:06:27.60,0:06:31.28,Default,,0,0,0,,所以田有要从正面 大张旗鼓地进攻
Dialogue: 0,0:06:31.28,0:06:33.10,Default,,0,0,0,,箭雨快来了
Dialogue: 0,0:06:33.10,0:06:34.03,Default,,0,0,0,,举盾
Dialogue: 0,0:06:34.03,0:06:35.65,Default,,0,0,0,,而在此期间
Dialogue: 0,0:06:36.58,0:06:38.94,Default,,0,0,0,,信和崇源带领轻装小队
Dialogue: 0,0:06:39.05,0:06:42.21,Default,,0,0,0,,躲避着敌人 从后方往上爬
Dialogue: 0,0:06:43.07,0:06:43.61,Default,,0,0,0,,很好
Dialogue: 0,0:06:44.34,0:06:47.70,Default,,0,0,0,,敌人的注意力全部集中在了正面的田有那边
Dialogue: 0,0:06:56.32,0:06:58.45,Default,,0,0,0,,等等 有哨兵
Dialogue: 0,0:06:58.93,0:07:01.82,Default,,0,0,0,,十…二十人左右
Dialogue: 0,0:07:04.10,0:07:06.37,Default,,0,0,0,,周围没有别的岗哨
Dialogue: 0,0:07:09.78,0:07:11.41,Default,,0,0,0,,右边有路能绕过去
Dialogue: 0,0:07:12.61,0:07:14.91,Default,,0,0,0,,我就这样从下面攻过去
Dialogue: 0,0:07:15.23,0:07:17.05,Default,,0,0,0,,嗯 好
Dialogue: 0,0:07:29.12,0:07:29.85,Default,,0,0,0,,准备好了吗
Dialogue: 0,0:07:32.39,0:07:32.93,Default,,0,0,0,,上
Dialogue: 0,0:07:38.15,0:07:40.29,Default,,0,0,0,,这 这是什么
Dialogue: 0,0:07:44.48,0:07:47.64,Default,,0,0,0,,奇 奇怪 一支箭也没有
Dialogue: 0,0:07:49.08,0:07:50.70,Default,,0,0,0,,都说了
Dialogue: 0,0:07:51.39,0:07:54.50,Default,,0,0,0,,在黑羊要玩弄对手
Dialogue: 0,0:07:57.42,0:07:58.57,Default,,0,0,0,,不好
Dialogue: 0,0:07:59.60,0:08:03.29,Default,,0,0,0,,登顶之后 信才终于意识到
Dialogue: 0,0:08:03.78,0:08:07.21,Default,,0,0,0,,他被那突然出现的两支部队算计了
Dialogue: 0,0:08:08.32,0:08:10.49,Default,,0,0,0,,发现山丘被占领后
Dialogue: 0,0:08:10.65,0:08:14.75,Default,,0,0,0,,飞信队便改变路线 前去夺取山丘
Dialogue: 0,0:08:15.36,0:08:16.26,Default,,0,0,0,,如此一来
Dialogue: 0,0:08:16.37,0:08:22.00,Default,,0,0,0,,飞信队赶赴中央丘前方制造前线的战术失败
Dialogue: 0,0:08:22.50,0:08:28.84,Default,,0,0,0,,赵军抢先一步 越过中央丘制造了前线
Dialogue: 0,0:08:29.60,0:08:32.74,Default,,0,0,0,,在信登上山丘时
Dialogue: 0,0:08:33.19,0:08:37.97,Default,,0,0,0,,作为飞信队斥候向前深入的羌瘣小队…
Dialogue: 0,0:08:39.83,0:08:40.58,Default,,0,0,0,,这是…
Dialogue: 0,0:08:41.78,0:08:45.26,Default,,0,0,0,,黑羊原来不是荒无人烟的树海地带啊
Dialogue: 0,0:08:46.83,0:08:51.35,Default,,0,0,0,,刚到黑羊时 我就看到有细烟柱升起
Dialogue: 0,0:08:51.52,0:08:54.15,Default,,0,0,0,,果然就是这里的炊烟啊
Dialogue: 0,0:08:55.70,0:08:56.56,Default,,0,0,0,,如果是这样…
Dialogue: 0,0:08:57.55,0:08:59.21,Default,,0,0,0,,果然还有其他聚落
Dialogue: 0,0:09:00.32,0:09:01.36,Default,,0,0,0,,等一下
Dialogue: 0,0:09:01.87,0:09:05.01,Default,,0,0,0,,他们怎么还在悠哉地干农活啊
Dialogue: 0,0:09:06.16,0:09:08.55,Default,,0,0,0,,小孩也在外面玩
Dialogue: 0,0:09:09.16,0:09:12.55,Default,,0,0,0,,难道是不知道这里成了战场吗
Dialogue: 0,0:09:13.28,0:09:19.00,Default,,0,0,0,,秦国领土上 也有多个不从属于国家的偏僻地区
Dialogue: 0,0:09:19.69,0:09:23.70,Default,,0,0,0,,在这密林当中 不知道战事也很正常
Dialogue: 0,0:09:25.38,0:09:26.90,Default,,0,0,0,,我们继续前进吧 羌瘣
Dialogue: 0,0:09:27.43,0:09:29.26,Default,,0,0,0,,这是他们自己的问题
Dialogue: 0,0:09:29.77,0:09:33.73,Default,,0,0,0,,这么说虽然很冷漠 但这事和现在的我们无关
Dialogue: 0,0:09:37.89,0:09:39.66,Default,,0,0,0,,怎么可能无关
Dialogue: 0,0:09:41.00,0:09:41.73,Default,,0,0,0,,副长？
Dialogue: 0,0:09:41.98,0:09:45.15,Default,,0,0,0,,黄丙 你去将聚落之事告诉信的主阵
Dialogue: 0,0:09:45.56,0:09:46.47,Default,,0,0,0,,是
Dialogue: 0,0:09:47.45,0:09:49.04,Default,,0,0,0,,其他人警惕四周
Dialogue: 0,0:09:49.32,0:09:51.36,Default,,0,0,0,,我去警告他们
Dialogue: 0,0:09:51.61,0:09:53.08,Default,,0,0,0,,别去啊 羌瘣
Dialogue: 0,0:09:53.20,0:09:56.66,Default,,0,0,0,,对他们来说 我们可是侵略者啊
Dialogue: 0,0:09:57.03,0:09:59.10,Default,,0,0,0,,我只说一句就立刻回来
Dialogue: 0,0:09:59.82,0:10:04.99,Default,,0,0,0,,这场战斗果然会错综复杂 信
Dialogue: 0,0:10:06.65,0:10:09.92,Default,,0,0,0,,右侧生乱不久后
Dialogue: 0,0:10:10.32,0:10:12.71,Default,,0,0,0,,左侧的战局也开始变化
Dialogue: 0,0:10:17.33,0:10:21.73,Default,,0,0,0,,桓 桓骑军的行军一直都这么快吗 巴印
Dialogue: 0,0:10:23.36,0:10:23.98,Default,,0,0,0,,就是…
Dialogue: 0,0:10:24.25,0:10:27.48,Default,,0,0,0,,虽然飞信队有时也比这更快啦…
Dialogue: 0,0:10:28.75,0:10:31.59,Default,,0,0,0,,平时当然不可能这么快
Dialogue: 0,0:10:31.96,0:10:34.95,Default,,0,0,0,,这次的战术是…虽然具体的我不清楚吧
Dialogue: 0,0:10:35.69,0:10:38.05,Default,,0,0,0,,首先是雷土军往前冲
Dialogue: 0,0:10:38.11,0:10:40.88,Default,,0,0,0,,在中央丘前方制造前线
Dialogue: 0,0:10:41.59,0:10:43.99,Default,,0,0,0,,这么说 我们是雷土军吗
Dialogue: 0,0:10:44.13,0:10:46.79,Default,,0,0,0,,对 是雷土军第二列
Dialogue: 0,0:10:47.98,0:10:48.84,Default,,0,0,0,,雷土…
Dialogue: 0,0:10:49.35,0:10:53.48,Default,,0,0,0,,是那个左眼周围有刺青 一脸凶相的人吧
Dialogue: 0,0:10:54.36,0:10:54.97,Default,,0,0,0,,对
Dialogue: 0,0:10:55.40,0:10:57.80,Default,,0,0,0,,雷土大哥很凶悍 而且强得要命
Dialogue: 0,0:10:58.48,0:11:03.27,Default,,0,0,0,,听说头儿也是费了好大功夫 才收服了他们家
Dialogue: 0,0:11:03.50,0:11:05.58,Default,,0,0,0,,收服他们家？
Dialogue: 0,0:11:07.18,0:11:09.30,Default,,0,0,0,,你们怎么这都不知道啊
Dialogue: 0,0:11:10.32,0:11:13.72,Default,,0,0,0,,虽然现在都是桓骑军
Dialogue: 0,0:11:13.91,0:11:17.31,Default,,0,0,0,,但他们之前都是不同的强盗团
Dialogue: 0,0:11:17.72,0:11:20.37,Default,,0,0,0,,是头儿把他们一个个击败
Dialogue: 0,0:11:20.37,0:11:22.74,Default,,0,0,0,,连打带劝地把他们收入麾下
Dialogue: 0,0:11:22.74,0:11:24.54,Default,,0,0,0,,桓骑军才发展到这个规模的
Dialogue: 0,0:11:24.78,0:11:26.27,Default,,0,0,0,,好强
Dialogue: 0,0:11:26.87,0:11:31.63,Default,,0,0,0,,这么说 我们是隶属于桓骑军最强的雷土队吗
Dialogue: 0,0:11:32.28,0:11:33.64,Default,,0,0,0,,算是吧
Dialogue: 0,0:11:33.84,0:11:37.89,Default,,0,0,0,,但真正危险的是另外两个团体
Dialogue: 0,0:11:38.28,0:11:39.96,Default,,0,0,0,,其中之一是泽诺家
Dialogue: 0,0:11:40.16,0:11:42.94,Default,,0,0,0,,正在我们左侧 和我们齐头并进
Dialogue: 0,0:11:43.24,0:11:46.18,Default,,0,0,0,,他们原本是在北侧威震一方的强盗团
Dialogue: 0,0:11:46.28,0:11:51.44,Default,,0,0,0,,但极度好战 简直就像是战斗民族
Dialogue: 0,0:11:51.67,0:11:52.84,Default,,0,0,0,,是吗…
Dialogue: 0,0:11:53.12,0:11:56.80,Default,,0,0,0,,他们的武力在桓骑军中毫无疑问是最强
Dialogue: 0,0:11:57.03,0:11:59.44,Default,,0,0,0,,会兴冲冲地往死地里冲
Dialogue: 0,0:12:00.36,0:12:02.70,Default,,0,0,0,,尤其是族长泽诺
Dialogue: 0,0:12:02.95,0:12:07.27,Default,,0,0,0,,他身形壮硕 能徒手拧断雄牛的脖子
Dialogue: 0,0:12:07.88,0:12:10.08,Default,,0,0,0,,我曾见过一次蒙武
Dialogue: 0,0:12:10.26,0:12:12.37,Default,,0,0,0,,但泽诺比蒙武还要壮一圈
Dialogue: 0,0:12:13.72,0:12:18.95,Default,,0,0,0,,单纯比拼武力的局面下 泽诺家一定最能发挥作用
Dialogue: 0,0:12:19.24,0:12:21.06,Default,,0,0,0,,但他们有个大问题
Dialogue: 0,0:12:21.62,0:12:26.82,Default,,0,0,0,,他们像野兽一样凶猛 时刻杀气腾腾
Dialogue: 0,0:12:26.82,0:12:30.02,Default,,0,0,0,,只要看不顺眼 就连自己人也照杀不误
Dialogue: 0,0:12:32.15,0:12:35.39,Default,,0,0,0,,就连头儿都很少会接近泽诺
Dialogue: 0,0:12:35.39,0:12:38.03,Default,,0,0,0,,所以 你们可千万别去左边啊
Dialogue: 0,0:12:38.33,0:12:43.05,Default,,0,0,0,,你 你们听好 就算掉队也千万别去左边
Dialogue: 0,0:12:45.09,0:12:49.16,Default,,0,0,0,,另一个危险团体 就在我们后方那一列
Dialogue: 0,0:12:49.25,0:12:50.56,Default,,0,0,0,,是砂鬼家
Dialogue: 0,0:12:50.65,0:12:52.07,Default,,0,0,0,,砂鬼家？
Dialogue: 0,0:12:52.07,0:12:57.92,Default,,0,0,0,,他们是桓骑军中最残忍的团体 这样说你就懂了
Dialogue: 0,0:12:58.45,0:13:02.80,Default,,0,0,0,,他们喜欢把活人从下往上戳成串
Dialogue: 0,0:13:03.08,0:13:05.01,Default,,0,0,0,,就是群疯子
Dialogue: 0,0:13:05.74,0:13:10.48,Default,,0,0,0,,人人都说 全中华最不幸的事 就是被砂鬼活捉
Dialogue: 0,0:13:11.51,0:13:13.92,Default,,0,0,0,,你 你们都跑快点
Dialogue: 0,0:13:13.92,0:13:16.19,Default,,0,0,0,,千万不要停下来啊
Dialogue: 0,0:13:18.07,0:13:19.17,Default,,0,0,0,,喂 尾平
Dialogue: 0,0:13:19.98,0:13:24.30,Default,,0,0,0,,这场仗打完之后 他们真的会放我们回飞信队吗
Dialogue: 0,0:13:24.62,0:13:26.20,Default,,0,0,0,,是这样说好的
Dialogue: 0,0:13:26.20,0:13:30.24,Default,,0,0,0,,我当时喝醉了不太记得 但应该就是这么说的
Dialogue: 0,0:13:37.87,0:13:40.11,Default,,0,0,0,,桓 桓骑将军
Dialogue: 0,0:13:40.81,0:13:43.43,Default,,0,0,0,,头儿？你怎么在这里
Dialogue: 0,0:13:43.74,0:13:46.01,Default,,0,0,0,,你们是雷土的第二列吗
Dialogue: 0,0:13:46.16,0:13:46.97,Default,,0,0,0,,是的
Dialogue: 0,0:13:47.52,0:13:49.18,Default,,0,0,0,,那还在更左边
Dialogue: 0,0:13:49.40,0:13:50.19,Default,,0,0,0,,俚玉
Dialogue: 0,0:13:50.39,0:13:51.19,Default,,0,0,0,,是啊
Dialogue: 0,0:13:51.52,0:13:53.13,Default,,0,0,0,,出什么事了吗
Dialogue: 0,0:13:53.50,0:13:55.85,Default,,0,0,0,,你为什么要亲自来这里
Dialogue: 0,0:13:56.28,0:13:58.24,Default,,0,0,0,,没什么 来办点事
Dialogue: 0,0:13:58.99,0:14:01.95,Default,,0,0,0,,右侧的奴仆刚开打就搞砸了
Dialogue: 0,0:14:03.56,0:14:04.33,Default,,0,0,0,,我们走
Dialogue: 0,0:14:04.76,0:14:05.54,Default,,0,0,0,,是
Dialogue: 0,0:14:09.20,0:14:12.37,Default,,0,0,0,,纪彗副将赢了赌博
Dialogue: 0,0:14:12.54,0:14:16.89,Default,,0,0,0,,多亏他的二位副官 战局顺利推进
Dialogue: 0,0:14:17.16,0:14:18.17,Default,,0,0,0,,感谢
Dialogue: 0,0:14:18.42,0:14:20.43,Default,,0,0,0,,你太得意了 岳婴
Dialogue: 0,0:14:20.68,0:14:25.68,Default,,0,0,0,,你的矮个子使我的视野宽阔 感谢
Dialogue: 0,0:14:25.79,0:14:27.07,Default,,0,0,0,,岳婴
Dialogue: 0,0:14:27.62,0:14:30.92,Default,,0,0,0,,你刚开战就立了大功啊 纪彗
Dialogue: 0,0:14:31.04,0:14:33.23,Default,,0,0,0,,都是马呈和刘冬的功劳
Dialogue: 0,0:14:36.35,0:14:38.84,Default,,0,0,0,,看 是中央丘
Dialogue: 0,0:14:39.10,0:14:43.65,Default,,0,0,0,,是足以左右此战胜负的黑羊最大山丘
Dialogue: 0,0:14:43.92,0:14:45.59,Default,,0,0,0,,左侧并无威胁
Dialogue: 0,0:14:46.41,0:14:48.92,Default,,0,0,0,,只需警惕右侧 继续前进
Dialogue: 0,0:14:49.72,0:14:52.15,Default,,0,0,0,,我军要抢先占领它
Dialogue: 0,0:15:00.94,0:15:04.63,Default,,0,0,0,,头 头儿 我们直接冲过去没问题吗
Dialogue: 0,0:15:04.89,0:15:06.05,Default,,0,0,0,,没问题
Dialogue: 0,0:15:06.84,0:15:08.30,Default,,0,0,0,,你们是谁啊
Dialogue: 0,0:15:08.30,0:15:10.19,Default,,0,0,0,,知道这是谁的队…
Dialogue: 0,0:15:10.34,0:15:11.22,Default,,0,0,0,,别挡道
Dialogue: 0,0:15:12.59,0:15:14.48,Default,,0,0,0,,杀掉还是不好吧 头儿
Dialogue: 0,0:15:16.28,0:15:18.84,Default,,0,0,0,,住 住手 蠢货 是友军
Dialogue: 0,0:15:19.04,0:15:22.07,Default,,0,0,0,,你的队还是老样子啊
Dialogue: 0,0:15:23.27,0:15:25.61,Default,,0,0,0,,来活儿了 泽诺
Dialogue: 0,0:15:25.99,0:15:29.95,Default,,0,0,0,,用你的力量 去打乱黑羊的棋局
Dialogue: 0,0:15:31.42,0:15:32.95,Default,,0,0,0,,桓骑
Dialogue: 0,0:15:34.72,0:15:35.91,Default,,0,0,0,,休想过去
Dialogue: 0,0:15:39.26,0:15:40.90,Default,,0,0,0,,好 冲出来了
Dialogue: 0,0:15:42.23,0:15:44.05,Default,,0,0,0,,又是开阔地带
Dialogue: 0,0:15:44.27,0:15:46.01,Default,,0,0,0,,不好 有埋伏
Dialogue: 0,0:15:48.69,0:15:51.05,Default,,0,0,0,,信大人 先撤退吧
Dialogue: 0,0:15:51.05,0:15:52.64,Default,,0,0,0,,从这里无法前进
Dialogue: 0,0:15:54.08,0:15:55.04,Default,,0,0,0,,该死
Dialogue: 0,0:15:55.58,0:15:59.12,Default,,0,0,0,,在马呈·刘冬队巧妙的游击战术之下
Dialogue: 0,0:15:59.12,0:16:03.89,Default,,0,0,0,,飞信队陷入苦战 难以将前线向前推进
Dialogue: 0,0:16:04.76,0:16:07.24,Default,,0,0,0,,而赵军主力的先锋队
Dialogue: 0,0:16:07.66,0:16:12.53,Default,,0,0,0,,距离中央丘已经近在咫尺
Dialogue: 0,0:16:13.76,0:16:15.91,Default,,0,0,0,,我们暂不登上山丘吗
Dialogue: 0,0:16:20.69,0:16:21.88,Default,,0,0,0,,我知道了
Dialogue: 0,0:16:22.20,0:16:26.05,Default,,0,0,0,,部队在山丘上布阵时 防守最为薄弱
Dialogue: 0,0:16:26.65,0:16:31.65,Default,,0,0,0,,等先锋队将要塞搭建成形后 大本营再上去也不迟
Dialogue: 0,0:16:32.21,0:16:36.68,Default,,0,0,0,,确实没错 但敌军此时尚未逼近
Dialogue: 0,0:16:37.35,0:16:40.56,Default,,0,0,0,,这位大人比预想中更加谨慎
Dialogue: 0,0:16:40.97,0:16:42.94,Default,,0,0,0,,此举并非谨慎起见
Dialogue: 0,0:16:44.40,0:16:47.78,Default,,0,0,0,,而是因为我尚未在山丘下闻到桓骑的气味
Dialogue: 0,0:16:50.56,0:16:52.31,Default,,0,0,0,,这…
Dialogue: 0,0:17:00.82,0:17:01.85,Default,,0,0,0,,在那里啊
Dialogue: 0,0:17:09.57,0:17:11.68,Default,,0,0,0,,这怪物
Dialogue: 0,0:17:12.29,0:17:13.30,Default,,0,0,0,,雷土大哥
Dialogue: 0,0:17:13.30,0:17:16.47,Default,,0,0,0,,泽诺家一来 我们的功劳都要被抢了
Dialogue: 0,0:17:17.33,0:17:21.18,Default,,0,0,0,,不过 没想到头儿一上来就出动了泽诺
Dialogue: 0,0:17:23.96,0:17:27.77,Default,,0,0,0,,我 我们第二列也一上来就冲锋吗
Dialogue: 0,0:17:27.86,0:17:29.28,Default,,0,0,0,,没错
Dialogue: 0,0:17:29.61,0:17:33.28,Default,,0,0,0,,泽诺家和雷土大哥去攻打敌军前线了
Dialogue: 0,0:17:34.51,0:17:36.64,Default,,0,0,0,,我们也要跟在后面加入战斗
Dialogue: 0,0:17:36.82,0:17:38.30,Default,,0,0,0,,这么说 我们已经…
Dialogue: 0,0:17:38.97,0:17:41.21,Default,,0,0,0,,山丘 那就是中央的…
Dialogue: 0,0:17:41.21,0:17:44.25,Default,,0,0,0,,好大 那就是一座山吧
Dialogue: 0,0:17:44.64,0:17:47.25,Default,,0,0,0,,是啊 很大 大才不妙
Dialogue: 0,0:17:48.16,0:17:53.04,Default,,0,0,0,,我们原本不是强盗就是山贼 所以很清楚
Dialogue: 0,0:17:53.60,0:17:56.25,Default,,0,0,0,,要是敌人占了那么大的山丘当要塞
Dialogue: 0,0:17:56.34,0:17:58.39,Default,,0,0,0,,我们就束手无策了
Dialogue: 0,0:17:58.76,0:18:00.50,Default,,0,0,0,,所以为了避免这种事发生
Dialogue: 0,0:18:00.61,0:18:03.79,Default,,0,0,0,,头儿才一上来就出动了泽诺这个撒手锏
Dialogue: 0,0:18:05.73,0:18:10.95,Default,,0,0,0,,我们说什么也要阻止赵军抢先占领山丘
Dialogue: 0,0:18:11.59,0:18:12.70,Default,,0,0,0,,急报
Dialogue: 0,0:18:12.70,0:18:16.62,Default,,0,0,0,,右翼前线溃决 似乎已被敌军突破
Dialogue: 0,0:18:18.19,0:18:20.50,Default,,0,0,0,,前线居然溃决 被突破了？
Dialogue: 0,0:18:20.98,0:18:23.71,Default,,0,0,0,,右翼的两万大军竟被突破了？
Dialogue: 0,0:18:24.50,0:18:30.28,Default,,0,0,0,,在这密林地带被突破 说明敌我力量悬殊
Dialogue: 0,0:18:31.04,0:18:34.17,Default,,0,0,0,,桓骑很可能出动了最强部队
Dialogue: 0,0:18:34.48,0:18:36.12,Default,,0,0,0,,而他的目的是…
Dialogue: 0,0:18:36.30,0:18:37.33,Default,,0,0,0,,庆舍大人
Dialogue: 0,0:18:37.92,0:18:40.02,Default,,0,0,0,,中央先锋队来报
Dialogue: 0,0:18:40.71,0:18:43.10,Default,,0,0,0,,已经准备好攀登山丘了
Dialogue: 0,0:18:43.70,0:18:48.44,Default,,0,0,0,,庆舍大人 请让先锋队暂缓登丘
Dialogue: 0,0:18:50.04,0:18:52.21,Default,,0,0,0,,突破右翼前线的敌军
Dialogue: 0,0:18:52.57,0:18:55.78,Default,,0,0,0,,必定会企图从侧面攻击登丘部队
Dialogue: 0,0:18:56.41,0:19:00.41,Default,,0,0,0,,若面朝山丘遭遇袭击 将损失惨重
Dialogue: 0,0:19:03.85,0:19:04.73,Default,,0,0,0,,庆舍大人
Dialogue: 0,0:19:05.21,0:19:07.16,Default,,0,0,0,,不必插嘴 纪彗
Dialogue: 0,0:19:08.60,0:19:11.92,Default,,0,0,0,,现在是我与桓骑的较量 容不得你插嘴
Dialogue: 0,0:19:12.58,0:19:14.80,Default,,0,0,0,,命先锋队登上山丘搭建要塞
Dialogue: 0,0:19:15.15,0:19:15.69,Default,,0,0,0,,是
Dialogue: 0,0:19:15.94,0:19:17.72,Default,,0,0,0,,报
Dialogue: 0,0:19:17.87,0:19:22.10,Default,,0,0,0,,突破右翼前线的敌军即将突破预备部队
Dialogue: 0,0:19:22.43,0:19:25.39,Default,,0,0,0,,这样下去 敌军会攻入中央
Dialogue: 0,0:19:29.14,0:19:32.62,Default,,0,0,0,,赵军开始进入中央丘
Dialogue: 0,0:19:36.89,0:19:40.21,Default,,0,0,0,,他们开始登丘了 胆子真不小
Dialogue: 0,0:19:40.41,0:19:43.22,Default,,0,0,0,,泽诺 往右前进
Dialogue: 0,0:19:43.40,0:19:47.42,Default,,0,0,0,,从侧面攻击在山脚磨蹭的蠢货 撕开他们的肚子
Dialogue: 0,0:19:47.62,0:19:49.71,Default,,0,0,0,,这是你的活儿
Dialogue: 0,0:19:50.12,0:19:53.42,Default,,0,0,0,,给这股力量带路 雷土
Dialogue: 0,0:20:03.11,0:20:04.14,Default,,0,0,0,,停
Dialogue: 0,0:20:22.87,0:20:26.96,Default,,0,0,0,,那个叫庆舍的也很猛啊
Dialogue: 0,0:20:28.12,0:20:31.29,Default,,0,0,0,,战场上最可怕的是
Dialogue: 0,0:20:31.80,0:20:34.78,Default,,0,0,0,,本以为占据优势的局面
Dialogue: 0,0:20:34.78,0:20:38.60,Default,,0,0,0,,在不知不觉中变成绝境
Dialogue: 0,0:20:38.97,0:20:43.26,Default,,0,0,0,,懂我的意思吗 乡巴佬猴子们
Dialogue: 0,0:20:43.78,0:20:45.94,Default,,0,0,0,,我懂
Dialogue: 0,0:20:46.86,0:20:49.58,Default,,0,0,0,,你在说你自己是傻子吧
Dialogue: 0,0:21:01.81,0:21:04.60,Default,,0,0,0,,岳婴似乎已经接敌了
Dialogue: 0,0:21:05.26,0:21:09.67,Default,,0,0,0,,没问题吗 逼近的敌军很可能非同寻常
Dialogue: 0,0:21:10.01,0:21:11.69,Default,,0,0,0,,岳婴不会有问题
Dialogue: 0,0:21:12.08,0:21:15.29,Default,,0,0,0,,比你在左侧的赌博可靠一万倍
Dialogue: 0,0:21:16.47,0:21:19.74,Default,,0,0,0,,而且 庆舍大人亲自出击了
Dialogue: 0,0:21:20.27,0:21:21.80,Default,,0,0,0,,那支敌军完了
Dialogue: 0,0:21:25.16,0:21:26.91,Default,,0,0,0,,庆舍大人他…
Dialogue: 0,0:21:28.01,0:21:31.72,Default,,0,0,0,,似乎比传闻中更加可怕
Dialogue: 0,0:21:33.09,0:21:34.44,Default,,0,0,0,,您打算如何阻挡敌军
Dialogue: 0,0:21:34.69,0:21:36.36,Default,,0,0,0,,不是阻挡
Dialogue: 0,0:21:36.87,0:21:38.26,Default,,0,0,0,,而是猎杀
Dialogue: 0,0:21:41.01,0:21:43.65,Default,,0,0,0,,可是 敌人并不在那个方向
Dialogue: 0,0:21:44.17,0:21:46.93,Default,,0,0,0,,你就安静地待在这里 纪彗
Dialogue: 0,0:21:47.47,0:21:50.41,Default,,0,0,0,,我会击碎桓骑的一只手臂
Dialogue: 0,0:21:51.48,0:21:52.84,Default,,0,0,0,,让你听到碎裂声
Dialogue: 0,0:21:57.57,0:21:58.62,Default,,0,0,0,,好重…
Dialogue: 0,0:22:00.55,0:22:01.40,Default,,0,0,0,,尾平
Dialogue: 0,0:22:03.72,0:22:07.72,Default,,0,0,0,,尾平 尾平 尾平
Dialogue: 0,0:22:08.40,0:22:10.27,Default,,0,0,0,,我 我没事
Dialogue: 0,0:22:10.40,0:22:11.68,Default,,0,0,0,,比起这个…
Dialogue: 0,0:22:12.59,0:22:14.31,Default,,0,0,0,,快跑啊
Dialogue: 0,0:22:15.00,0:22:16.52,Default,,0,0,0,,混账东西
Dialogue: 0,0:22:16.60,0:22:19.53,Default,,0,0,0,,竟敢偷袭桓骑军 胆子不小啊
Dialogue: 0,0:22:23.98,0:22:26.03,Default,,0,0,0,,好 好强
Dialogue: 0,0:22:26.38,0:22:29.56,Default,,0,0,0,,居然轻松杀死了凶悍的桓骑兵
Dialogue: 0,0:22:29.78,0:22:31.63,Default,,0,0,0,,不只是因为偷袭
Dialogue: 0,0:22:31.87,0:22:35.32,Default,,0,0,0,,这支敌军部队…不是一般地强
Dialogue: 0,0:22:36.36,0:22:38.34,Default,,0,0,0,,庆舍大人 您真英勇
Dialogue: 0,0:22:39.49,0:22:40.59,Default,,0,0,0,,庆舍？
Dialogue: 0,0:22:41.13,0:22:42.02,Default,,0,0,0,,庆舍
Dialogue: 0,0:22:43.10,0:22:46.66,Default,,0,0,0,,庆舍不是赵军主将吗
Dialogue: 0,0:22:46.92,0:22:47.93,Default,,0,0,0,,庆舍大人
Dialogue: 0,0:22:48.00,0:22:50.85,Default,,0,0,0,,这里好像刚好是他们的第二列
Dialogue: 0,0:22:52.46,0:22:56.19,Default,,0,0,0,,敌军主将为什么会亲自来这种地方
Dialogue: 0,0:22:57.27,0:23:00.81,Default,,0,0,0,,前方好像还有数支后续部队
Dialogue: 0,0:23:01.50,0:23:05.20,Default,,0,0,0,,全部击溃 不能放任何一队通过
Dialogue: 0,0:23:05.66,0:23:08.45,Default,,0,0,0,,要在此处彻底切断敌军的脖颈
Dialogue: 0,0:23:09.45,0:23:10.70,Default,,0,0,0,,切断？
Dialogue: 0,0:23:11.44,0:23:14.49,Default,,0,0,0,,伸出手就别想收回了 桓骑
Dialogue: 0,0:24:50.67,0:24:52.39,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:52.73,0:24:54.16,Default,,0,0,0,,「黑羊之夜」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

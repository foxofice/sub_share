Dialogue: 0,0:23:55.96,0:24:00.96,Screen,,0,0,0,,{\fn方正准雅宋_GBK\fscx95\fsp5\blur3\bord0.5\fs70\b1\3c&H000000&\3a&H6E&\pos(960,754.67)}那位执事 伪装
Dialogue: 0,0:00:19.73,0:00:23.20,Default,,0,0,0,,我校受传统与纪律保护
Dialogue: 0,0:00:23.34,0:00:25.86,Default,,0,0,0,,是一所声名显赫的公学
Dialogue: 0,0:00:26.99,0:00:31.40,Default,,0,0,0,,既已入学 就必须遵守校规
Dialogue: 0,0:00:32.43,0:00:34.24,Default,,0,0,0,,夏尔·凡多姆海伍
Dialogue: 0,0:00:35.24,0:00:37.10,Default,,0,0,0,,你是否愿意发誓
Dialogue: 0,0:00:37.63,0:00:41.05,Default,,0,0,0,,遵守我校规定 恪守传统与纪律
Dialogue: 0,0:00:41.38,0:00:41.99,Default,,0,0,0,,是
Dialogue: 0,0:02:41.35,0:02:43.27,Default,,0,0,0,,不好 要迟到了
Dialogue: 0,0:02:48.28,0:02:49.73,Default,,0,0,0,,等 等一下
Dialogue: 0,0:02:54.30,0:02:55.24,Default,,0,0,0,,赶上了
Dialogue: 0,0:03:03.16,0:03:04.32,Default,,0,0,0,,威士顿公学
Dialogue: 0,0:03:05.04,0:03:10.06,Default,,0,0,0,,坐落于泰晤士河畔的英国顶尖名门公学
Dialogue: 0,0:03:11.01,0:03:12.51,Default,,0,0,0,,在广阔的校园内
Dialogue: 0,0:03:12.65,0:03:15.01,Default,,0,0,0,,建有错综复杂的高大教学楼
Dialogue: 0,0:03:15.34,0:03:17.15,Default,,0,0,0,,哥特式的礼拜堂
Dialogue: 0,0:03:17.51,0:03:20.10,Default,,0,0,0,,以及历史悠久的四座学生宿舍楼
Dialogue: 0,0:03:20.65,0:03:24.85,Default,,0,0,0,,学生仅限男生 受到重视传统的严苛纪律约束
Dialogue: 0,0:03:25.30,0:03:27.21,Default,,0,0,0,,过着寄宿生活
Dialogue: 0,0:03:27.48,0:03:30.16,Default,,0,0,0,,在自成一派的教学体系中接受高档教育
Dialogue: 0,0:03:30.56,0:03:32.95,Default,,0,0,0,,成长为真正的英国绅士
Dialogue: 0,0:03:33.71,0:03:36.20,Default,,0,0,0,,即使学费堪称天价
Dialogue: 0,0:03:36.35,0:03:41.45,Default,,0,0,0,,贵族们依然争相将孩子送来镀金
Dialogue: 0,0:03:44.14,0:03:46.27,Default,,0,0,0,,万事开头难
Dialogue: 0,0:03:46.80,0:03:48.25,Default,,0,0,0,,我得万分谨慎才行
Dialogue: 0,0:03:50.77,0:03:51.59,Default,,0,0,0,,不是吧
Dialogue: 0,0:03:51.86,0:03:52.80,Default,,0,0,0,,快看
Dialogue: 0,0:03:53.25,0:03:54.22,Default,,0,0,0,,难以置信
Dialogue: 0,0:03:54.22,0:03:55.63,Default,,0,0,0,,他居然踩了草坪
Dialogue: 0,0:03:56.20,0:03:58.43,Default,,0,0,0,,不是P4竟敢踩草坪 不可理喻
Dialogue: 0,0:03:58.68,0:04:00.12,Default,,0,0,0,,得Y是没跑了
Dialogue: 0,0:04:00.31,0:04:01.38,Default,,0,0,0,,唉
Dialogue: 0,0:04:01.91,0:04:02.83,Default,,0,0,0,,你们在说什…
Dialogue: 0,0:04:02.83,0:04:03.60,Default,,0,0,0,,快看
Dialogue: 0,0:04:04.13,0:04:05.31,Default,,0,0,0,,他们来了
Dialogue: 0,0:04:06.75,0:04:08.40,Default,,0,0,0,,是「Prefect 4」
Dialogue: 0,0:04:13.73,0:04:15.06,Default,,0,0,0,,他要遭殃了
Dialogue: 0,0:04:15.48,0:04:16.44,Default,,0,0,0,,活该
Dialogue: 0,0:04:17.65,0:04:18.68,Default,,0,0,0,,要被打了
Dialogue: 0,0:04:22.02,0:04:23.54,Default,,0,0,0,,你的领带歪了
Dialogue: 0,0:04:27.45,0:04:29.14,Default,,0,0,0,,你叫什么名字
Dialogue: 0,0:04:29.31,0:04:30.63,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:04:30.87,0:04:32.11,Default,,0,0,0,,没听过啊
Dialogue: 0,0:04:32.72,0:04:37.57,Default,,0,0,0,,听校长说 今天蓝馆会来一名新生
Dialogue: 0,0:04:37.68,0:04:38.44,Default,,0,0,0,,就是你吗
Dialogue: 0,0:04:38.50,0:04:39.09,Default,,0,0,0,,是的
Dialogue: 0,0:04:39.48,0:04:42.56,Default,,0,0,0,,威士顿校规第48条
Dialogue: 0,0:04:42.82,0:04:47.39,Default,,0,0,0,,「有权横穿草坪的 仅限监督生及获其准许者」
Dialogue: 0,0:04:42.82,0:04:47.39,zhu-2,,0,0,0,,{\pos(1072,985)}Prefect
Dialogue: 0,0:04:47.66,0:04:49.94,Default,,0,0,0,,入学前就该记住校规
Dialogue: 0,0:04:50.68,0:04:51.64,Default,,0,0,0,,非常抱歉…
Dialogue: 0,0:04:51.64,0:04:53.15,Default,,0,0,0,,快进教学楼吧
Dialogue: 0,0:04:54.17,0:04:55.98,Default,,0,0,0,,外面太晒了
Dialogue: 0,0:04:58.64,0:05:01.83,Default,,0,0,0,,下次可要注意哦 凡多姆海伍
Dialogue: 0,0:05:05.88,0:05:09.96,Default,,0,0,0,,你太幸运了 踩了草坪居然没受罚
Dialogue: 0,0:05:10.31,0:05:10.91,Default,,0,0,0,,给
Dialogue: 0,0:05:11.39,0:05:12.74,Default,,0,0,0,,我叫马克米兰
Dialogue: 0,0:05:12.86,0:05:15.16,Default,,0,0,0,,和你一样 是蓝馆的一年级生
Dialogue: 0,0:05:16.28,0:05:17.92,Default,,0,0,0,,嗯 谢谢你
Dialogue: 0,0:05:18.32,0:05:19.16,Default,,0,0,0,,话说回来
Dialogue: 0,0:05:19.25,0:05:23.40,Default,,0,0,0,,他们刚才说的P4和Y都是什么啊
Dialogue: 0,0:05:23.64,0:05:25.33,Default,,0,0,0,,Y是惩罚单位
Dialogue: 0,0:05:25.55,0:05:29.04,Default,,0,0,0,,每得一个Y 就要抄写一百遍拉丁语诗歌
Dialogue: 0,0:05:29.28,0:05:30.10,Default,,0,0,0,,P4呢
Dialogue: 0,0:05:30.46,0:05:34.31,Default,,0,0,0,,就是刚才那四个人 他们穿着不同颜色的背心吧
Dialogue: 0,0:05:34.91,0:05:39.44,Default,,0,0,0,,只有Prefect能自行选择背心的款式
Dialogue: 0,0:05:39.52,0:05:40.74,Default,,0,0,0,,Prefect？
Dialogue: 0,0:05:40.74,0:05:43.08,Default,,0,0,0,,就是监督生 也就是宿舍长
Dialogue: 0,0:05:44.42,0:05:45.85,Default,,0,0,0,,穿红色背心那位
Dialogue: 0,0:05:45.85,0:05:48.42,Default,,0,0,0,,是身份极其高贵的学生入住的
Dialogue: 0,0:05:48.60,0:05:50.99,Default,,0,0,0,,「深红狐馆」的监督生
Dialogue: 0,0:05:50.99,0:05:52.44,Default,,0,0,0,,艾德嘉·雷德蒙
Dialogue: 0,0:05:53.70,0:05:55.06,Default,,0,0,0,,穿蓝色背心那位
Dialogue: 0,0:05:55.06,0:05:57.12,Default,,0,0,0,,是成绩优秀的学生入住的
Dialogue: 0,0:05:57.25,0:05:59.34,Default,,0,0,0,,「绀碧枭馆」的监督生
Dialogue: 0,0:05:59.54,0:06:01.04,Default,,0,0,0,,劳伦斯·布鲁亚
Dialogue: 0,0:06:02.44,0:06:03.97,Default,,0,0,0,,穿绿色背心那位
Dialogue: 0,0:06:03.97,0:06:06.52,Default,,0,0,0,,是擅长武术和运动的学生入住的
Dialogue: 0,0:06:06.66,0:06:08.75,Default,,0,0,0,,「翡翠狮馆」的监督生
Dialogue: 0,0:06:08.83,0:06:10.20,Default,,0,0,0,,赫曼·格林希尔
Dialogue: 0,0:06:11.96,0:06:13.61,Default,,0,0,0,,穿紫色背心那位
Dialogue: 0,0:06:13.61,0:06:15.75,Default,,0,0,0,,是有一技之长的学生入住的
Dialogue: 0,0:06:15.75,0:06:17.89,Default,,0,0,0,,「紫黑狼馆」的监督生
Dialogue: 0,0:06:18.06,0:06:19.63,Default,,0,0,0,,格雷戈利·威尔利特
Dialogue: 0,0:06:20.69,0:06:24.46,Default,,0,0,0,,威士顿的四座传统宿舍的四位监督生
Dialogue: 0,0:06:24.46,0:06:26.59,Default,,0,0,0,,简称P4
Dialogue: 0,0:06:28.65,0:06:32.13,Default,,0,0,0,,好崇拜他们啊 我以后也想成为监督生
Dialogue: 0,0:06:32.58,0:06:33.63,Default,,0,0,0,,开玩笑
Dialogue: 0,0:06:34.72,0:06:35.61,Default,,0,0,0,,但是
Dialogue: 0,0:06:35.73,0:06:39.10,Default,,0,0,0,,居然不能横穿草坪 这规定也太低效了
Dialogue: 0,0:06:40.01,0:06:41.30,Default,,0,0,0,,毕竟这是传统
Dialogue: 0,0:06:42.85,0:06:44.96,Default,,0,0,0,,不好 上课要迟到了
Dialogue: 0,0:06:44.96,0:06:46.97,Default,,0,0,0,,快走吧 我可不想拿Y
Dialogue: 0,0:06:49.40,0:06:53.59,Default,,0,0,0,,说起来 没想到柯雷特学长居然突然休学了
Dialogue: 0,0:06:53.85,0:06:57.36,Default,,0,0,0,,你在这个尴尬的时间点入学 一定很不容易吧
Dialogue: 0,0:06:57.41,0:06:59.06,Default,,0,0,0,,我一直在等待空缺
Dialogue: 0,0:06:59.42,0:07:01.54,Default,,0,0,0,,做点准备并不算什么
Dialogue: 0,0:07:01.87,0:07:03.50,Default,,0,0,0,,全体集合
Dialogue: 0,0:07:04.19,0:07:08.70,Default,,0,0,0,,最后一个集合的人会被学长差遣做事
Dialogue: 0,0:07:08.70,0:07:09.45,Default,,0,0,0,,什么？
Dialogue: 0,0:07:12.22,0:07:14.45,Default,,0,0,0,,最后一个是…新生啊
Dialogue: 0,0:07:14.55,0:07:15.39,Default,,0,0,0,,是的
Dialogue: 0,0:07:16.12,0:07:20.20,Default,,0,0,0,,那么 你去给监督生擦鞋 结束后就回宿舍
Dialogue: 0,0:07:20.51,0:07:22.50,Default,,0,0,0,,我们给你开欢迎会
Dialogue: 0,0:07:28.88,0:07:31.74,Default,,0,0,0,,欢迎入住 凡多姆海伍
Dialogue: 0,0:07:35.83,0:07:38.06,Default,,0,0,0,,你就好好享受吧
Dialogue: 0,0:07:38.60,0:07:39.96,Default,,0,0,0,,抛
Dialogue: 0,0:07:43.41,0:07:46.74,Default,,0,0,0,,我们宿舍传统的欢迎会如何呀
Dialogue: 0,0:07:46.84,0:07:49.39,Default,,0,0,0,,今后你就是绀碧枭馆的一员了
Dialogue: 0,0:07:49.39,0:07:52.20,Default,,0,0,0,,请更加发奋学习
Dialogue: 0,0:07:52.49,0:07:54.56,Default,,0,0,0,,接下来再抛高一点
Dialogue: 0,0:07:53.69,0:07:54.45,Default,,0,0,0,,{\pos(1578.67,1060)}不要…
Dialogue: 0,0:07:54.56,0:07:57.35,Default,,0,0,0,,你们在闹什么 我要给你们Y了
Dialogue: 0,0:07:57.35,0:07:58.60,Default,,0,0,0,,不好 舍监来了
Dialogue: 0,0:07:59.34,0:08:00.56,Default,,0,0,0,,克雷顿
Dialogue: 0,0:08:00.56,0:08:03.34,Default,,0,0,0,,你身为高年级生 为什么也跟着一起闹
Dialogue: 0,0:08:03.71,0:08:06.66,Default,,0,0,0,,这是我们宿舍的传统…
Dialogue: 0,0:08:08.71,0:08:12.16,Default,,0,0,0,,真是的 遵守传统也要注意分寸
Dialogue: 0,0:08:13.20,0:08:15.97,Default,,0,0,0,,你就是新入学的凡多姆海伍吧
Dialogue: 0,0:08:17.20,0:08:20.15,Default,,0,0,0,,欢迎来到绀碧枭馆
Dialogue: 0,0:08:22.76,0:08:25.04,Default,,0,0,0,,我是舍监 米卡艾利斯
Dialogue: 0,0:08:32.49,0:08:35.39,Default,,0,0,0,,您好 米卡艾利斯老师
Dialogue: 0,0:08:35.72,0:08:37.93,Default,,0,0,0,,刚入学就遇到这种事 真是为难你了
Dialogue: 0,0:08:37.93,0:08:39.25,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:08:39.61,0:08:41.01,Default,,0,0,0,,没受伤吧
Dialogue: 0,0:08:41.60,0:08:43.75,Default,,0,0,0,,谢谢老师关心
Dialogue: 0,0:08:44.06,0:08:48.22,Default,,0,0,0,,要是您再早些来制止就更好了
Dialogue: 0,0:08:48.74,0:08:50.65,Default,,0,0,0,,这也算是一项仪式
Dialogue: 0,0:08:50.79,0:08:54.12,Default,,0,0,0,,若是严令禁止 未免有些不近人情
Dialogue: 0,0:08:55.04,0:08:58.38,Default,,0,0,0,,毕竟我只是一介舍监
Dialogue: 0,0:08:55.04,0:08:58.38,zhu-2,,0,0,0,,{\pos(1060,982.67)}恶魔
Dialogue: 0,0:09:00.90,0:09:02.56,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:09:02.92,0:09:06.26,Default,,0,0,0,,我奉命带话 请你去一趟校长室
Dialogue: 0,0:09:22.45,0:09:24.36,Default,,0,0,0,,入学第一天已近尾声
Dialogue: 0,0:09:24.72,0:09:27.23,Default,,0,0,0,,感觉如何啊 凡多姆海伍
Dialogue: 0,0:09:27.75,0:09:31.49,Default,,0,0,0,,要是无法融入蓝馆 就来红馆吧
Dialogue: 0,0:09:32.04,0:09:35.02,Default,,0,0,0,,以你这样高贵的身份 我们随时欢迎你
Dialogue: 0,0:09:35.55,0:09:39.75,Default,,0,0,0,,有权为学生分配宿舍的 只有校长一人
Dialogue: 0,0:09:39.88,0:09:41.54,Default,,0,0,0,,不得有例外
Dialogue: 0,0:09:42.38,0:09:44.66,Default,,0,0,0,,我是觉得哪个宿舍都一样
Dialogue: 0,0:09:45.14,0:09:48.11,Default,,0,0,0,,我校受传统与纪律保护
Dialogue: 0,0:09:48.24,0:09:50.60,Default,,0,0,0,,是一所声名显赫的公学
Dialogue: 0,0:09:50.96,0:09:55.46,Default,,0,0,0,,既已入学 就必须遵守校规
Dialogue: 0,0:09:57.37,0:10:00.90,Default,,0,0,0,,原本应当由校长在此训话
Dialogue: 0,0:10:01.18,0:10:03.61,Default,,0,0,0,,但校长事务繁忙 就由我代行
Dialogue: 0,0:10:05.02,0:10:08.46,Default,,0,0,0,,我是副校长 约翰·阿格雷斯
Dialogue: 0,0:10:09.20,0:10:12.45,Default,,0,0,0,,一切校内事务均由校长决定
Dialogue: 0,0:10:12.67,0:10:16.22,Default,,0,0,0,,校长对校内事务之定夺不可撼动
Dialogue: 0,0:10:16.44,0:10:20.78,Default,,0,0,0,,校长任命我等监督生 在校内行使自治
Dialogue: 0,0:10:21.43,0:10:24.54,Default,,0,0,0,,麻烦事都丢给我们处理 真是个苦差事
Dialogue: 0,0:10:25.76,0:10:28.94,Default,,0,0,0,,这是我校创立时便定下的传统
Dialogue: 0,0:10:29.68,0:10:30.66,Default,,0,0,0,,而且
Dialogue: 0,0:10:31.60,0:10:33.11,Default,,0,0,0,,传统不容置喙
Dialogue: 0,0:10:35.81,0:10:37.52,Default,,0,0,0,,夏尔·凡多姆海伍
Dialogue: 0,0:10:38.03,0:10:39.98,Default,,0,0,0,,你是否愿意发誓
Dialogue: 0,0:10:40.20,0:10:43.43,Default,,0,0,0,,遵守我校规定 恪守传统与纪律
Dialogue: 0,0:10:44.71,0:10:45.29,Default,,0,0,0,,是
Dialogue: 0,0:10:46.81,0:10:48.92,Default,,0,0,0,,那么 请在此处签名
Dialogue: 0,0:10:51.50,0:10:52.88,Default,,0,0,0,,阿格雷斯老师
Dialogue: 0,0:10:52.88,0:10:54.52,Default,,0,0,0,,对不起 对不起 对不起
Dialogue: 0,0:10:54.65,0:10:56.26,Default,,0,0,0,,对不起 对不起 对不起
Dialogue: 0,0:10:58.44,0:10:59.76,Default,,0,0,0,,请在此处签名
Dialogue: 0,0:11:01.83,0:11:04.59,Default,,0,0,0,,感谢加入威士顿公学 凡多姆海伍
Dialogue: 0,0:11:05.77,0:11:07.52,Default,,0,0,0,,欢迎你的到来
Dialogue: 0,0:11:16.48,0:11:19.01,Default,,0,0,0,,祝你在校内过得愉快
Dialogue: 0,0:11:20.48,0:11:24.98,Default,,0,0,0,,请问 我什么时候能去问候校长呢
Dialogue: 0,0:11:26.05,0:11:30.04,Default,,0,0,0,,校长事务繁忙 不接受普通学生面见
Dialogue: 0,0:11:30.54,0:11:32.55,Default,,0,0,0,,能面见校长的
Dialogue: 0,0:11:33.83,0:11:35.92,Default,,0,0,0,,只有我们监督生
Dialogue: 0,0:11:42.23,0:11:44.99,Default,,0,0,0,,普通学生见不到校长？
Dialogue: 0,0:11:46.14,0:11:50.94,Default,,0,0,0,,看来 校长就是这所学校的绝对君主啊
Dialogue: 0,0:11:54.86,0:11:59.24,Default,,0,0,0,,威士顿的学生大多为13到18岁
Dialogue: 0,0:11:59.45,0:12:03.41,Default,,0,0,0,,他们在宿舍过着集体生活 专注于学习
Dialogue: 0,0:12:04.23,0:12:08.29,Default,,0,0,0,,学生的生活起居 均由钟声管理
Dialogue: 0,0:12:29.64,0:12:30.81,Default,,0,0,0,,直属学弟？
Dialogue: 0,0:12:31.33,0:12:35.53,Default,,0,0,0,,嗯 就是宿舍里的徒弟或小弟
Dialogue: 0,0:12:36.07,0:12:38.84,Default,,0,0,0,,早餐结束后 就是直属学弟的工作时间
Dialogue: 0,0:12:39.25,0:12:41.07,Default,,0,0,0,,这是威士顿特有的传统
Dialogue: 0,0:12:41.07,0:12:44.71,Default,,0,0,0,,每位学生都会照顾特定的一位学长
Dialogue: 0,0:12:45.10,0:12:45.99,Default,,0,0,0,,怎么照顾啊
Dialogue: 0,0:12:46.30,0:12:47.70,Default,,0,0,0,,为他打扫房间
Dialogue: 0,0:12:47.94,0:12:49.54,Default,,0,0,0,,熨烫校服
Dialogue: 0,0:12:49.83,0:12:52.13,Default,,0,0,0,,晚上为他准备暖壶之类的
Dialogue: 0,0:12:52.75,0:12:54.98,Default,,0,0,0,,就是在模仿执事啊
Dialogue: 0,0:12:55.43,0:12:57.33,Default,,0,0,0,,又是一个麻烦的传统
Dialogue: 0,0:12:59.45,0:13:01.70,Default,,0,0,0,,监督生也有直属学弟吗
Dialogue: 0,0:13:01.84,0:13:02.95,Default,,0,0,0,,当然有
Dialogue: 0,0:13:02.95,0:13:06.19,Default,,0,0,0,,蓝馆监督生布鲁亚学长的直属学弟
Dialogue: 0,0:13:06.19,0:13:07.56,Default,,0,0,0,,是克雷顿学长
Dialogue: 0,0:13:07.82,0:13:08.85,Default,,0,0,0,,克雷顿…
Dialogue: 0,0:13:09.70,0:13:10.74,Default,,0,0,0,,就是他啊
Dialogue: 0,0:13:11.72,0:13:16.33,Default,,0,0,0,,和执事不同 学长也会关照直属学弟
Dialogue: 0,0:13:16.50,0:13:20.49,Default,,0,0,0,,最贴切的说法应该是 仅限校内的兄弟关系
Dialogue: 0,0:13:21.09,0:13:22.38,Default,,0,0,0,,兄弟啊
Dialogue: 0,0:13:22.47,0:13:26.51,Default,,0,0,0,,还有啊 监督生的直属学弟有些特殊
Dialogue: 0,0:13:26.61,0:13:29.07,Default,,0,0,0,,他们能和P4一样把舍花插在胸前
Dialogue: 0,0:13:29.07,0:13:31.46,Default,,0,0,0,,获得许可后还能横穿草坪
Dialogue: 0,0:13:31.82,0:13:37.03,Default,,0,0,0,,据说还能和P4一起参加校长主办的「深夜茶会」呢
Dialogue: 0,0:13:37.93,0:13:39.57,Default,,0,0,0,,深夜茶会…
Dialogue: 0,0:13:39.79,0:13:42.72,Default,,0,0,0,,参加这个就能和校长接触
Dialogue: 0,0:13:43.05,0:13:47.06,Default,,0,0,0,,不过只有P4及其直属学弟才能参加
Dialogue: 0,0:13:47.06,0:13:48.43,Default,,0,0,0,,有点难办啊
Dialogue: 0,0:13:48.96,0:13:51.51,Default,,0,0,0,,我以后也好想参加啊
Dialogue: 0,0:13:51.51,0:13:52.49,Default,,0,0,0,,开玩笑
Dialogue: 0,0:13:53.89,0:13:54.86,Default,,0,0,0,,没办法
Dialogue: 0,0:13:55.22,0:14:00.09,Default,,0,0,0,,先直接打探一下不回家的学生的事吧
Dialogue: 0,0:14:00.96,0:14:03.03,Default,,0,0,0,,抱歉 我换个话题
Dialogue: 0,0:14:03.63,0:14:06.70,Default,,0,0,0,,你认识克莱门斯公爵的儿子 德利克·亚登吗
Dialogue: 0,0:14:07.04,0:14:10.65,Default,,0,0,0,,他好像是紫黑狼馆的学生
Dialogue: 0,0:14:15.28,0:14:16.05,Default,,0,0,0,,怎么了
Dialogue: 0,0:14:16.36,0:14:17.59,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:14:18.04,0:14:21.43,Default,,0,0,0,,和其他宿舍的学生关系太好 会被排挤的
Dialogue: 0,0:14:21.43,0:14:24.85,Default,,0,0,0,,啊？怎么跟女生拉小圈子一样
Dialogue: 0,0:14:25.06,0:14:28.30,Default,,0,0,0,,毕竟经常要和其他宿舍竞争
Dialogue: 0,0:14:29.18,0:14:29.88,Default,,0,0,0,,不过
Dialogue: 0,0:14:30.09,0:14:35.59,Default,,0,0,0,,那个人好像是特别获准从红馆转到了紫馆
Dialogue: 0,0:14:36.23,0:14:36.98,Default,,0,0,0,,转过去的？
Dialogue: 0,0:14:37.45,0:14:41.46,Default,,0,0,0,,具体的我不清楚 但听说是校长的命令
Dialogue: 0,0:14:41.70,0:14:42.82,Default,,0,0,0,,校长的命令？
Dialogue: 0,0:14:43.08,0:14:47.28,Default,,0,0,0,,总 总之 最好别去管其他宿舍的事
Dialogue: 0,0:14:47.59,0:14:49.76,Default,,0,0,0,,尤其是紫黑狼馆
Dialogue: 0,0:14:50.69,0:14:51.82,Default,,0,0,0,,这是为什么…
Dialogue: 0,0:14:51.82,0:14:53.67,Default,,0,0,0,,马克米兰 直属学弟的时间到了
Dialogue: 0,0:14:53.67,0:14:54.33,Default,,0,0,0,,来了
Dialogue: 0,0:14:54.58,0:14:55.79,Default,,0,0,0,,我的直属学长来了
Dialogue: 0,0:14:56.41,0:14:58.39,Default,,0,0,0,,回头见啦 凡多姆海伍
Dialogue: 0,0:15:01.36,0:15:03.32,Default,,0,0,0,,那是什么姿势啊
Dialogue: 0,0:15:05.15,0:15:09.07,Default,,0,0,0,,话说回来 德利克居然转过宿舍？
Dialogue: 0,0:15:09.50,0:15:11.57,Default,,0,0,0,,这中间肯定有内情
Dialogue: 0,0:15:11.57,0:15:12.77,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:15:13.40,0:15:14.63,Default,,0,0,0,,克雷顿学长
Dialogue: 0,0:15:15.11,0:15:18.65,Default,,0,0,0,,在你的直属学长确定之前 你负责打扫餐厅
Dialogue: 0,0:15:19.93,0:15:21.24,Default,,0,0,0,,餐厅？
Dialogue: 0,0:15:22.50,0:15:25.06,Default,,0,0,0,,这里全都要我打扫吗
Dialogue: 0,0:15:25.16,0:15:26.15,Default,,0,0,0,,没错
Dialogue: 0,0:15:26.37,0:15:27.61,Default,,0,0,0,,不许偷懒
Dialogue: 0,0:15:33.96,0:15:35.04,Default,,0,0,0,,塞巴斯蒂安
Dialogue: 0,0:15:41.13,0:15:42.03,Default,,0,0,0,,我在
Dialogue: 0,0:15:45.26,0:15:47.55,Default,,0,0,0,,听说德利克转过宿舍
Dialogue: 0,0:15:47.75,0:15:52.56,Default,,0,0,0,,按照名册中的信息 他确实属于紫黑狼馆
Dialogue: 0,0:15:52.56,0:15:54.22,Default,,0,0,0,,他现在应该在宿舍里
Dialogue: 0,0:15:54.33,0:15:57.44,Default,,0,0,0,,我去看看 你把这里打扫干净
Dialogue: 0,0:15:57.57,0:15:58.78,Default,,0,0,0,,遵命
Dialogue: 0,0:16:00.25,0:16:01.39,Default,,0,0,0,,好了
Dialogue: 0,0:16:02.93,0:16:04.20,Default,,0,0,0,,开始工作吧
Dialogue: 0,0:16:13.73,0:16:15.83,Default,,0,0,0,,外观真是不得了
Dialogue: 0,0:16:16.81,0:16:19.50,Default,,0,0,0,,不愧是怪人宿舍
Dialogue: 0,0:16:27.00,0:16:28.38,Default,,0,0,0,,是外人
Dialogue: 0,0:16:28.52,0:16:29.66,Default,,0,0,0,,外人…
Dialogue: 0,0:16:29.89,0:16:31.35,Default,,0,0,0,,那徽章是蓝馆的…
Dialogue: 0,0:16:31.35,0:16:33.06,Default,,0,0,0,,什 什么时候来的
Dialogue: 0,0:16:33.06,0:16:34.40,Default,,0,0,0,,喂喂
Dialogue: 0,0:16:34.40,0:16:38.10,Default,,0,0,0,,书呆子宿舍的人来紫馆干什么
Dialogue: 0,0:16:38.42,0:16:42.56,Default,,0,0,0,,只会念书的家伙可没资格来这里
Dialogue: 0,0:16:42.68,0:16:43.51,Default,,0,0,0,,滚出去
Dialogue: 0,0:16:43.51,0:16:45.33,Default,,0,0,0,,对 滚出去
Dialogue: 0,0:16:45.56,0:16:47.53,Default,,0,0,0,,其他宿舍的滚出去
Dialogue: 0,0:16:47.53,0:16:48.54,Default,,0,0,0,,滚出去
Dialogue: 0,0:16:48.54,0:16:49.20,Default,,0,0,0,,痛
Dialogue: 0,0:16:49.65,0:16:51.61,Default,,0,0,0,,滚出紫馆
Dialogue: 0,0:16:52.53,0:16:57.20,Default,,0,0,0,,下次劝你带本厚字典来保护脑袋 书呆子
Dialogue: 0,0:16:58.00,0:16:59.60,Default,,0,0,0,,怎么回事啊
Dialogue: 0,0:17:00.24,0:17:01.52,Default,,0,0,0,,在闹什么
Dialogue: 0,0:17:03.33,0:17:05.03,Default,,0,0,0,,威尔利特学长
Dialogue: 0,0:17:05.20,0:17:07.44,Default,,0,0,0,,来了个书呆子宿舍的人
Dialogue: 0,0:17:11.53,0:17:12.64,Default,,0,0,0,,那个新生？
Dialogue: 0,0:17:18.51,0:17:20.32,Default,,0,0,0,,真是糟透了
Dialogue: 0,0:17:21.47,0:17:26.10,Default,,0,0,0,,不同宿舍间的敌对心 比预想的还要强啊
Dialogue: 0,0:17:26.95,0:17:30.86,Default,,0,0,0,,别说校长了 就连德利克都很难见到
Dialogue: 0,0:17:31.80,0:17:34.77,Default,,0,0,0,,这所学校里 爵位和金钱都没用
Dialogue: 0,0:17:35.51,0:17:39.50,Default,,0,0,0,,身为普通学生 就连收集情报都很困难
Dialogue: 0,0:17:40.17,0:17:44.31,Default,,0,0,0,,这么一来 接近事件核心的方法就只有一个
Dialogue: 0,0:17:45.52,0:17:48.58,Default,,0,0,0,,必须拉拢P4
Dialogue: 0,0:17:50.00,0:17:51.88,Default,,0,0,0,,但是 要怎么做
Dialogue: 0,0:17:53.16,0:17:54.40,Default,,0,0,0,,好厉害
Dialogue: 0,0:17:54.40,0:17:55.80,Default,,0,0,0,,就凭一个人…
Dialogue: 0,0:17:55.94,0:17:56.61,Default,,0,0,0,,真的假的
Dialogue: 0,0:17:56.61,0:17:57.90,Default,,0,0,0,,怎么做到的
Dialogue: 0,0:18:01.47,0:18:02.51,Default,,0,0,0,,凡多姆海伍
Dialogue: 0,0:18:02.51,0:18:03.23,Default,,0,0,0,,在
Dialogue: 0,0:18:03.56,0:18:05.53,Default,,0,0,0,,不好 偷懒被发现了？
Dialogue: 0,0:18:05.70,0:18:08.41,Default,,0,0,0,,我这人不会轻易夸奖他人
Dialogue: 0,0:18:08.76,0:18:09.62,Default,,0,0,0,,但是
Dialogue: 0,0:18:10.21,0:18:12.82,Default,,0,0,0,,今天我要夸奖你
Dialogue: 0,0:18:17.87,0:18:22.54,Default,,0,0,0,,我们那老土…不 历史悠久的餐厅竟焕然一新
Dialogue: 0,0:18:22.81,0:18:24.63,Default,,0,0,0,,你真能干 凡多姆海伍
Dialogue: 0,0:18:24.63,0:18:26.58,Default,,0,0,0,,过奖了
Dialogue: 0,0:18:26.58,0:18:28.92,Default,,0,0,0,,那家伙做过头了
Dialogue: 0,0:18:29.81,0:18:31.09,Default,,0,0,0,,米卡艾利斯老师
Dialogue: 0,0:18:31.53,0:18:32.63,Default,,0,0,0,,怎么了
Dialogue: 0,0:18:33.08,0:18:35.17,Default,,0,0,0,,您看这餐厅
Dialogue: 0,0:18:35.29,0:18:37.26,Default,,0,0,0,,是凡多姆海伍打理的
Dialogue: 0,0:18:37.26,0:18:38.85,Default,,0,0,0,,可这真是了不得
Dialogue: 0,0:18:39.29,0:18:42.05,Default,,0,0,0,,辛苦你了 凡多姆海伍
Dialogue: 0,0:18:42.63,0:18:44.52,Default,,0,0,0,,就知道多此一举…
Dialogue: 0,0:18:45.16,0:18:46.49,Default,,0,0,0,,不辛苦
Dialogue: 0,0:18:46.89,0:18:48.02,Default,,0,0,0,,等等
Dialogue: 0,0:18:49.25,0:18:51.86,Default,,0,0,0,,他好像是布鲁亚的直属学弟
Dialogue: 0,0:18:52.40,0:18:54.30,Default,,0,0,0,,说不定能利用一下
Dialogue: 0,0:18:49.22,0:18:53.16,zhu,,0,0,0,,他还没有直属学长 我就随便给他分配了个工作
Dialogue: 0,0:18:53.16,0:18:55.24,zhu,,0,0,0,,没想到竟能在短时间内做得如此完美
Dialogue: 0,0:18:55.62,0:18:58.20,Default,,0,0,0,,要接近P4 首先就要…
Dialogue: 0,0:18:59.08,0:19:00.44,Default,,0,0,0,,从他入手
Dialogue: 0,0:19:01.27,0:19:03.40,Default,,0,0,0,,很高兴学长能满意
Dialogue: 0,0:19:03.73,0:19:07.17,Default,,0,0,0,,不瞒你说 我其实非常擅长做家务
Dialogue: 0,0:19:08.63,0:19:13.83,Default,,0,0,0,,有事请尽管吩咐我哦 克雷顿学长
Dialogue: 0,0:19:23.54,0:19:25.34,Default,,0,0,0,,亲爱的小弟弟
Dialogue: 0,0:19:25.79,0:19:28.84,Default,,0,0,0,,坎帕尼亚号的事 真是让你受苦了
Dialogue: 0,0:19:29.81,0:19:33.99,Default,,0,0,0,,希望你的身体已经痊愈 正在享受复活节了
Dialogue: 0,0:19:35.59,0:19:37.05,Default,,0,0,0,,而我呢
Dialogue: 0,0:19:37.05,0:19:39.63,Default,,0,0,0,,难得迎来复活节假期
Dialogue: 0,0:19:39.72,0:19:43.78,Default,,0,0,0,,我却因一件忧心之事 而无法由衷庆祝节日
Dialogue: 0,0:19:44.78,0:19:46.73,Default,,0,0,0,,这件忧心之事
Dialogue: 0,0:19:47.03,0:19:52.10,Default,,0,0,0,,就是我堂兄弟克莱门斯公爵的儿子 德利克
Dialogue: 0,0:19:52.88,0:19:56.13,Default,,0,0,0,,德利克是威士顿公学的五年级学生
Dialogue: 0,0:19:56.31,0:20:00.45,Default,,0,0,0,,但不知为何 他自去年暑假起就一直没有回家
Dialogue: 0,0:20:01.00,0:20:03.62,Default,,0,0,0,,从前他每天都给家里写信
Dialogue: 0,0:20:03.73,0:20:05.18,Default,,0,0,0,,现在信件也中断了
Dialogue: 0,0:20:09.11,0:20:13.52,Default,,0,0,0,,他母亲担心地去宿舍找他 他却拒绝回家
Dialogue: 0,0:20:14.49,0:20:18.48,Default,,0,0,0,,若只有他一人如此 那或许只是单纯进入叛逆期了
Dialogue: 0,0:20:18.68,0:20:23.89,Default,,0,0,0,,但似乎还有好几名学生 也和他一样没有回家
Dialogue: 0,0:20:24.83,0:20:27.87,Default,,0,0,0,,他们究竟是怎么了呢
Dialogue: 0,0:20:31.10,0:20:36.74,Default,,0,0,0,,独生子成了这样 克莱门斯公爵终日无精打采
Dialogue: 0,0:20:37.43,0:20:39.08,Default,,0,0,0,,我十分担心他
Dialogue: 0,0:20:40.97,0:20:45.21,Default,,0,0,0,,衷心希望我珍视的人们
Dialogue: 0,0:20:45.47,0:20:49.52,Default,,0,0,0,,能早日安稳地度过复活节
Dialogue: 0,0:20:50.83,0:20:51.84,Default,,0,0,0,,维多利亚
Dialogue: 0,0:20:54.00,0:20:54.85,Default,,0,0,0,,也就是说
Dialogue: 0,0:20:55.42,0:21:01.16,Default,,0,0,0,,她是命令您调查威士顿的学生不回家的原因吧
Dialogue: 0,0:21:01.71,0:21:07.03,Default,,0,0,0,,公学不接受任何政府干涉 是独立机构
Dialogue: 0,0:21:07.03,0:21:08.12,Default,,0,0,0,,所以她不好出手
Dialogue: 0,0:21:08.94,0:21:09.92,Default,,0,0,0,,更重要的是
Dialogue: 0,0:21:10.32,0:21:14.01,Default,,0,0,0,,她应该是不想把事情闹大 让家事被外界知晓
Dialogue: 0,0:21:14.48,0:21:16.84,Default,,0,0,0,,都这时候了还顾及面子
Dialogue: 0,0:21:17.36,0:21:20.22,Default,,0,0,0,,唉 所以我受不了人类
Dialogue: 0,0:21:20.59,0:21:23.08,Default,,0,0,0,,我想派个人去学校里卧底
Dialogue: 0,0:21:23.08,0:21:26.79,Default,,0,0,0,,但只有贵族子弟才能进入威士顿
Dialogue: 0,0:21:27.19,0:21:31.32,Default,,0,0,0,,有爵位的人本就少 而且互相之间基本都认识
Dialogue: 0,0:21:31.77,0:21:34.06,Default,,0,0,0,,卧底的话 乔装会很危险
Dialogue: 0,0:21:35.16,0:21:36.64,Default,,0,0,0,,那您亲自去办？
Dialogue: 0,0:21:39.18,0:21:40.37,Default,,0,0,0,,这也没办法
Dialogue: 0,0:21:40.72,0:21:43.41,Default,,0,0,0,,卖女王一个人情也不是坏事
Dialogue: 0,0:21:43.91,0:21:47.49,Default,,0,0,0,,问题是威士顿有没有空缺
Dialogue: 0,0:21:47.94,0:21:49.01,Default,,0,0,0,,很简单
Dialogue: 0,0:21:49.21,0:21:51.64,Default,,0,0,0,,若是没有空缺 制造一个便是
Dialogue: 0,0:21:55.26,0:21:58.00,Default,,0,0,0,,在校内的调查就由我来
Dialogue: 0,0:21:58.64,0:22:01.90,Default,,0,0,0,,你在暗中协助我
Dialogue: 0,0:22:02.65,0:22:04.10,Default,,0,0,0,,方法随便你
Dialogue: 0,0:22:20.80,0:22:22.87,Default,,0,0,0,,Yes my lord
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

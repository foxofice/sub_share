Dialogue: 0,0:00:01.85,0:00:08.36,Basic_Sign,,0,0,0,,{\fad(550,675)\an2\pos(964,853)}自由行星同盟军 \N{\fs58\u0}伊谢尔伦要塞
Dialogue: 0,0:00:02.44,0:00:06.68,Default,,0,0,0,,日前在亚典波罗提督的训练舰队
Dialogue: 0,0:00:06.68,0:00:09.50,Default,,0,0,0,,与帝国国境警卫舰队的遭遇战中
Dialogue: 0,0:00:09.95,0:00:13.27,Default,,0,0,0,,同盟军获得了不少俘虏
Dialogue: 0,0:00:14.49,0:00:16.35,Default,,0,0,0,,成为俘虏的帝国兵
Dialogue: 0,0:00:16.35,0:00:19.37,Default,,0,0,0,,暂时被移送到了伊谢尔伦
Dialogue: 0,0:00:20.14,0:00:23.72,Default,,0,0,0,,你们错就错在自以为能战胜奇迹的杨
Dialogue: 0,0:00:24.23,0:00:26.92,Default,,0,0,0,,真希望那金发小子也能吸取教训
Dialogue: 0,0:00:26.92,0:00:29.52,Default,,0,0,0,,别打伊谢尔伦的主意了
Dialogue: 0,0:00:29.88,0:00:31.90,Default,,0,0,0,,你小子刚才说什么
Dialogue: 0,0:00:32.42,0:00:35.12,Default,,0,0,0,,你居然敢叫他金发小子！
Dialogue: 0,0:00:36.35,0:00:38.72,Default,,0,0,0,,冷静 都不准动
Dialogue: 0,0:00:39.55,0:00:40.80,Default,,0,0,0,,我们服从命令
Dialogue: 0,0:00:41.21,0:00:43.18,Default,,0,0,0,,但是 我有句话要说
Dialogue: 0,0:00:44.09,0:00:48.75,Default,,0,0,0,,还请各位不要出言冒犯罗严克拉姆元帅
Dialogue: 0,0:00:49.68,0:00:51.03,Default,,0,0,0,,这样对两边都好
Dialogue: 0,0:00:51.04,0:00:53.55,Basic_Sign2,,0,0,0,,{\fs58\fsp1\pos(1436,866)}卡斯帕•林玆上校
Dialogue: 0,0:00:54.61,0:00:55.77,Default,,0,0,0,,还有这事…
Dialogue: 0,0:00:56.14,0:01:00.44,Default,,0,0,0,,士兵对罗严克拉姆公爵莱因哈特的忠心
Dialogue: 0,0:01:00.44,0:01:01.67,Default,,0,0,0,,实在不容小觑
Dialogue: 0,0:01:02.11,0:01:02.62,Default,,0,0,0,,我们审问了士兵 想获得帝国内战后的情报
Dialogue: 0,0:01:02.62,0:01:07.96,Basic_Sign2,,0,0,0,,{\fad(500,50)\fs58\pos(1525,858)}巴格达胥中校
Dialogue: 0,0:01:02.62,0:01:06.63,Default,,0,0,0,,我们审问了士兵 想获得帝国内战后的情报
Dialogue: 0,0:01:06.63,0:01:11.10,Default,,0,0,0,,结果全在说帝国宰相罗严克拉姆公爵莱因哈特的改革
Dialogue: 0,0:01:11.10,0:01:13.88,Default,,0,0,0,,简直就是有口皆碑
Dialogue: 0,0:01:14.15,0:01:16.37,Default,,0,0,0,,这可大事不好啊
Dialogue: 0,0:01:17.02,0:01:18.73,Default,,0,0,0,,我们的国家元首
Dialogue: 0,0:01:18.73,0:01:21.63,Default,,0,0,0,,特留尼西特议长要是在人心上输了
Dialogue: 0,0:01:22.08,0:01:25.67,Default,,0,0,0,,那同盟可就一无是处了
Dialogue: 0,0:01:26.04,0:01:28.63,Default,,0,0,0,,或许这真不是件小事
Dialogue: 0,0:01:35.52,0:01:38.35,Default,,0,0,0,,罗严克拉姆公爵大刀阔斧的改革
Dialogue: 0,0:01:38.79,0:01:42.21,Default,,0,0,0,,正使得帝国快速转变为一个民族国家
Dialogue: 0,0:01:43.76,0:01:46.78,Default,,0,0,0,,我想 他早晚会篡夺皇位
Dialogue: 0,0:01:47.58,0:01:50.44,Default,,0,0,0,,不靠血统 而是靠实力
Dialogue: 0,0:01:51.53,0:01:55.21,Default,,0,0,0,,届时 由平民支持的帝政
Dialogue: 0,0:01:55.87,0:02:00.17,Default,,0,0,0,,史称「自由帝政」的独特政治体制
Dialogue: 0,0:02:00.17,0:02:02.19,Default,,0,0,0,,或许会在银河之中诞生
Dialogue: 0,0:02:05.78,0:02:08.99,Default,,0,0,0,,而一旦人民将罗严克拉姆公爵的野心
Dialogue: 0,0:02:09.44,0:02:11.95,Default,,0,0,0,,错当成自己的理想时
Dialogue: 0,0:02:12.87,0:02:14.46,Default,,0,0,0,,自由行星同盟…
Dialogue: 0,0:02:14.83,0:02:18.98,Default,,0,0,0,,有可能会遭到狂热的国民军攻击啊
Dialogue: 0,0:02:21.82,0:02:25.37,Default,,0,0,0,,罗严克拉姆公爵…莱因哈特…
Dialogue: 0,0:02:26.16,0:02:31.63,OPCN,,0,0,0,,你是否感觉 自己身处童话
Dialogue: 0,0:02:32.28,0:02:38.90,OPCN,,0,0,0,,在伸出的手掌之上
Dialogue: 0,0:02:38.90,0:02:45.51,OPCN,,0,0,0,,被拨弄的未来做着恒久的梦
Dialogue: 0,0:02:45.51,0:02:52.08,OPCN,,0,0,0,,知晓吐露的话语背后的真意
Dialogue: 0,0:02:52.64,0:03:02.97,OPCN,,0,0,0,,无秩序的开绽 剥去锈蚀的风景
Dialogue: 0,0:03:04.07,0:03:07.48,OPCN,,0,0,0,,满身灰尘地留在明澈的天空下
Dialogue: 0,0:03:07.48,0:03:10.52,OPCN,,0,0,0,,心跳一下接着一下
Dialogue: 0,0:03:10.52,0:03:17.09,OPCN,,0,0,0,,碎裂散落的祈祷在悄悄眨着眼
Dialogue: 0,0:03:17.09,0:03:20.44,OPCN,,0,0,0,,满身灰尘地留在无云的天空下
Dialogue: 0,0:03:20.44,0:03:23.32,OPCN,,0,0,0,,人生如一瞬的耀眼光芒
Dialogue: 0,0:03:23.32,0:03:30.52,OPCN,,0,0,0,,循规蹈矩也找不出的答案
Dialogue: 0,0:02:26.16,0:02:31.63,OPEN,,0,0,0,,Don’t you see yourself in a kind of fairy tale?
Dialogue: 0,0:02:32.28,0:02:38.90,OPEN,,0,0,0,,差し出された掌の上で
Dialogue: 0,0:02:38.90,0:02:45.51,OPEN,,0,0,0,,踊らされてく未来は　永久の夢をみて
Dialogue: 0,0:02:45.51,0:02:52.08,OPEN,,0,0,0,,吐き出された言葉の裏を知る
Dialogue: 0,0:02:52.64,0:03:02.97,OPEN,,0,0,0,,無秩序な綻びが　錆びついた景色を剥ぐ
Dialogue: 0,0:03:04.07,0:03:07.48,OPEN,,0,0,0,,Left in the dust under the airy sky
Dialogue: 0,0:03:07.48,0:03:10.52,OPEN,,0,0,0,,刻まれていく鼓動
Dialogue: 0,0:03:10.52,0:03:17.09,OPEN,,0,0,0,,砕けて散った祈りは人知れず瞬く
Dialogue: 0,0:03:17.09,0:03:20.44,OPEN,,0,0,0,,Left in the dust under the open sky
Dialogue: 0,0:03:20.44,0:03:23.32,OPEN,,0,0,0,,Life is a flash blinding bright
Dialogue: 0,0:03:23.32,0:03:30.52,OPEN,,0,0,0,,ル一ルをなぞっても見出せない答え
Dialogue: 0,0:03:48.66,0:03:56.00,title,,0,0,0,,{\fad(550,0)\be0}银河英雄传说\N全新命题
Dialogue: 0,0:03:56.02,0:03:59.52,Basic_Sign2,,0,0,0,,{\pos(964,874)}帝都奥丁
Dialogue: 0,0:04:04.30,0:04:08.03,Basic_Sign2,,0,0,0,,{\pos(944,866)}新·无忧宫
Dialogue: 0,0:04:13.23,0:04:16.46,Default,,0,0,0,,希尔德 即希尔格尔·冯·玛林道夫
Dialogue: 0,0:04:16.89,0:04:19.40,Default,,0,0,0,,如今任职帝国宰相主席秘书官
Dialogue: 0,0:04:19.40,0:04:22.02,Default,,0,0,0,,辅佐莱因哈特
Dialogue: 0,0:04:27.18,0:04:28.47,Default,,0,0,0,,来 快吃
Dialogue: 0,0:04:28.96,0:04:30.01,Default,,0,0,0,,很好吃的
Dialogue: 0,0:04:32.32,0:04:33.54,Default,,0,0,0,,它不吃啊
Dialogue: 0,0:04:44.45,0:04:46.95,Default,,0,0,0,,早上好
Dialogue: 0,0:04:47.58,0:04:48.91,Default,,0,0,0,,这是怎么了
Dialogue: 0,0:04:49.98,0:04:52.17,Default,,0,0,0,,不知道什么时候跑进来的
Dialogue: 0,0:04:53.21,0:04:54.81,Default,,0,0,0,,我们看它好像很饿
Dialogue: 0,0:04:55.08,0:04:56.99,Default,,0,0,0,,想喂它点吃的
Dialogue: 0,0:04:56.99,0:04:58.18,Default,,0,0,0,,但它不吃
Dialogue: 0,0:04:58.99,0:05:00.33,Default,,0,0,0,,这样啊
Dialogue: 0,0:05:06.48,0:05:07.83,Default,,0,0,0,,辛苦了
Dialogue: 0,0:05:07.83,0:05:08.49,Default,,0,0,0,,是
Dialogue: 0,0:05:13.57,0:05:15.43,Default,,0,0,0,,这家伙脸皮还真厚啊
Dialogue: 0,0:05:15.91,0:05:17.62,Default,,0,0,0,,这里可是帝国宰相
Dialogue: 0,0:05:17.62,0:05:20.82,Default,,0,0,0,,莱因哈特·冯·罗严克拉姆公爵的宅邸啊
Dialogue: 0,0:05:21.48,0:05:24.69,Default,,0,0,0,,那样的大人物居然就住在这样的房子里
Dialogue: 0,0:05:25.04,0:05:26.60,Default,,0,0,0,,说真的 我也不敢相信啊
Dialogue: 0,0:05:33.96,0:05:37.63,Default,,0,0,0,,大人 玛林道夫秘书官来接您了
Dialogue: 0,0:05:38.47,0:05:41.18,Default,,0,0,0,,知道了 告诉她我马上过去
Dialogue: 0,0:05:41.79,0:05:42.54,Default,,0,0,0,,是
Dialogue: 0,0:05:49.01,0:05:53.01,title,,0,0,0,,第二十八集 改革者
Dialogue: 0,0:06:03.69,0:06:04.99,Default,,0,0,0,,你说他？
Dialogue: 0,0:06:07.19,0:06:09.07,Default,,0,0,0,,好吧 让他过来
Dialogue: 0,0:06:10.75,0:06:12.75,Default,,0,0,0,,亚泽·冯·修特莱
Dialogue: 0,0:06:13.33,0:06:15.94,Default,,0,0,0,,曾是门阀贵族联合的盟主
Dialogue: 0,0:06:15.94,0:06:18.30,Default,,0,0,0,,布朗史维克公爵的部下
Dialogue: 0,0:06:18.71,0:06:23.03,Default,,0,0,0,,为了避免大规模内战 他提议刺杀莱因哈特
Dialogue: 0,0:06:23.81,0:06:27.99,Default,,0,0,0,,却招致了主公的不满 反被抛弃
Dialogue: 0,0:06:29.05,0:06:31.55,Default,,0,0,0,,但是 即便是被捕之时
Dialogue: 0,0:06:31.92,0:06:35.08,Default,,0,0,0,,他依然坦荡无畏
Dialogue: 0,0:06:35.69,0:06:39.83,Default,,0,0,0,,莱因哈特对他颇有好感 便将他释放
Dialogue: 0,0:06:41.00,0:06:43.63,Default,,0,0,0,,莱因哈特的改革之一
Dialogue: 0,0:06:43.91,0:06:47.88,Default,,0,0,0,,是没收贵族以非法手段囤积的资产
Dialogue: 0,0:06:49.09,0:06:50.96,Default,,0,0,0,,修特莱前来拜访
Dialogue: 0,0:06:51.30,0:06:54.16,Default,,0,0,0,,是为他的某个亲戚的财产谋求豁免
Dialogue: 0,0:06:54.46,0:06:59.74,Default,,0,0,0,,哪怕留下一部分也好
Dialogue: 0,0:07:03.02,0:07:05.33,Default,,0,0,0,,知道了 我会妥善处理
Dialogue: 0,0:07:06.01,0:07:07.38,Default,,0,0,0,,谢谢您
Dialogue: 0,0:07:07.69,0:07:09.23,Default,,0,0,0,,但是有个条件
Dialogue: 0,0:07:10.25,0:07:14.17,Default,,0,0,0,,我要你成为我的部下 在统帅总部效力
Dialogue: 0,0:07:14.69,0:07:18.49,Default,,0,0,0,,我对你的见识和知识评价甚高
Dialogue: 0,0:07:19.26,0:07:22.93,Default,,0,0,0,,你在民间将近一年 如今已是新年
Dialogue: 0,0:07:23.50,0:07:28.02,Default,,0,0,0,,你对旧主的忠心 也该放下了吧
Dialogue: 0,0:07:31.21,0:07:34.90,Default,,0,0,0,,您宽宏大量 在下的感激之情无以言表
Dialogue: 0,0:07:35.20,0:07:37.49,Default,,0,0,0,,为了报答您的错爱
Dialogue: 0,0:07:37.94,0:07:42.11,Default,,0,0,0,,在下愿献上全部的忠诚
Dialogue: 0,0:07:43.49,0:07:46.14,Default,,0,0,0,,听说修特莱被授予少将衔
Dialogue: 0,0:07:46.53,0:07:48.89,Default,,0,0,0,,任职首席副官啊
Dialogue: 0,0:07:49.54,0:07:51.20,Default,,0,0,0,,真是大胆啊
Dialogue: 0,0:07:51.58,0:07:55.14,Default,,0,0,0,,奥贝斯坦总参谋长居然同意了
Dialogue: 0,0:07:55.81,0:07:56.92,Default,,0,0,0,,你们忘了吗
Dialogue: 0,0:07:57.40,0:07:59.38,Default,,0,0,0,,那家伙手下还有菲尔纳
Dialogue: 0,0:08:00.28,0:08:01.47,Default,,0,0,0,,就是跟修特莱一样
Dialogue: 0,0:08:01.74,0:08:05.40,Default,,0,0,0,,试图刺杀大人 结果被抓到的那个
Dialogue: 0,0:08:06.67,0:08:08.85,Default,,0,0,0,,只要有利用价值就利用
Dialogue: 0,0:08:09.40,0:08:11.82,Default,,0,0,0,,奥贝斯坦就是这种人
Dialogue: 0,0:08:12.42,0:08:13.75,Default,,0,0,0,,这显然不是全部
Dialogue: 0,0:08:14.45,0:08:18.76,Default,,0,0,0,,修特莱这样优秀的人物 对大人效忠这一事实…
Dialogue: 0,0:08:19.31,0:08:23.70,Default,,0,0,0,,对众贵族产生的政治影响一定不小
Dialogue: 0,0:08:24.65,0:08:29.74,Default,,0,0,0,,毕竟大多数旧门阀贵族才刚被剥夺了特权嘛
Dialogue: 0,0:08:30.14,0:08:32.57,Default,,0,0,0,,另一方面 大人下令
Dialogue: 0,0:08:32.91,0:08:35.68,Default,,0,0,0,,释放了不少思想犯和政治犯
Dialogue: 0,0:08:36.09,0:08:40.49,Default,,0,0,0,,化敌为友 又释放被囚之人
Dialogue: 0,0:08:40.92,0:08:44.18,Default,,0,0,0,,看来这也在大人的改革计划之内啊
Dialogue: 0,0:08:44.74,0:08:48.84,Default,,0,0,0,,吉尔菲艾斯提督去世时 我还很担心呢
Dialogue: 0,0:08:49.56,0:08:52.25,Default,,0,0,0,,或许是我们多虑了吧
Dialogue: 0,0:08:58.55,0:09:00.57,Default,,0,0,0,,对于大人的事 你怎么看
Dialogue: 0,0:09:01.42,0:09:03.39,Default,,0,0,0,,真的不必担心了吗
Dialogue: 0,0:09:04.12,0:09:06.91,Default,,0,0,0,,不知道 我们只能保持关注
Dialogue: 0,0:09:08.35,0:09:12.41,Default,,0,0,0,,我们离开战场就派不上什么用场啊
Dialogue: 0,0:09:14.20,0:09:18.72,Default,,0,0,0,,说起来 还选了一个次席副官辅佐修特莱啊
Dialogue: 0,0:09:19.18,0:09:21.41,Default,,0,0,0,,嗯 是谁来着
Dialogue: 0,0:09:22.08,0:09:24.39,Default,,0,0,0,,我记得 原来是坎普手下的
Dialogue: 0,0:09:26.15,0:09:29.04,Default,,0,0,0,,我知道了 我来处理
Dialogue: 0,0:09:29.34,0:09:30.41,Default,,0,0,0,,有劳您了
Dialogue: 0,0:09:30.41,0:09:33.33,Basic_Sign2,,0,0,0,,{\pos(492,694)}迪奥多·冯·留克中尉
Dialogue: 0,0:09:33.33,0:09:35.23,Default,,0,0,0,,你还在紧张吗
Dialogue: 0,0:09:35.76,0:09:38.78,Default,,0,0,0,,让您见笑了 没想到我…
Dialogue: 0,0:09:38.78,0:09:44.53,Default,,0,0,0,,没想到会让在下担任次席副官
Dialogue: 0,0:09:45.43,0:09:48.07,Default,,0,0,0,,是罗严克拉姆公爵选择了你
Dialogue: 0,0:09:48.42,0:09:49.50,Default,,0,0,0,,放松点
Dialogue: 0,0:09:49.81,0:09:53.25,Default,,0,0,0,,是 大人真的很了不起
Dialogue: 0,0:09:53.69,0:09:57.97,Default,,0,0,0,,自从在他身边随侍 这种感觉愈发强烈
Dialogue: 0,0:09:58.65,0:10:02.18,Default,,0,0,0,,我明明跟他同岁 却无法望其项背
Dialogue: 0,0:10:03.37,0:10:06.50,Default,,0,0,0,,与贵族联盟的战争才刚结束
Dialogue: 0,0:10:06.91,0:10:11.03,Default,,0,0,0,,他就修订法律 修改税制 推进改革
Dialogue: 0,0:10:12.38,0:10:15.67,Default,,0,0,0,,解放那些由贵族支配的庄园 还给农民
Dialogue: 0,0:10:16.13,0:10:17.88,Default,,0,0,0,,保障言论自由
Dialogue: 0,0:10:18.35,0:10:21.59,Default,,0,0,0,,被禁的报纸和书籍也得以重新出版
Dialogue: 0,0:10:22.69,0:10:25.39,Default,,0,0,0,,据说如今城里无论何时何地
Dialogue: 0,0:10:25.71,0:10:28.36,Default,,0,0,0,,都有人在举杯欢庆
Dialogue: 0,0:10:29.75,0:10:31.57,Default,,0,0,0,,干杯
Dialogue: 0,0:10:36.93,0:10:39.57,Default,,0,0,0,,这里的烤猪脚可是一绝
Dialogue: 0,0:10:40.59,0:10:41.97,Default,,0,0,0,,那还真是期待
Dialogue: 0,0:10:42.72,0:10:45.50,Default,,0,0,0,,话说回来 还真是热闹啊
Dialogue: 0,0:10:46.30,0:10:47.52,Default,,0,0,0,,久等了
Dialogue: 0,0:10:48.27,0:10:49.15,Default,,0,0,0,,来了来了
Dialogue: 0,0:10:50.43,0:10:53.56,Default,,0,0,0,,话说老板娘 今天怎么这么热闹
Dialogue: 0,0:10:54.06,0:10:58.97,Default,,0,0,0,,附近有个老爷被当成思想犯抓走 这次放出来了
Dialogue: 0,0:10:58.97,0:11:00.14,Default,,0,0,0,,大家在庆祝呢
Dialogue: 0,0:11:00.74,0:11:01.69,Default,,0,0,0,,思想犯？
Dialogue: 0,0:11:02.12,0:11:05.30,Default,,0,0,0,,只是喝多了骂了几句贵族而已
Dialogue: 0,0:11:05.30,0:11:06.94,Default,,0,0,0,,说起来就来气
Dialogue: 0,0:11:07.42,0:11:09.19,Default,,0,0,0,,各位慢用
Dialogue: 0,0:11:10.15,0:11:12.51,Default,,0,0,0,,当年内务部那帮混蛋就是为了冲业绩
Dialogue: 0,0:11:12.51,0:11:15.13,Default,,0,0,0,,你这家伙有个屁的思想啊
Dialogue: 0,0:11:15.53,0:11:17.23,Default,,0,0,0,,你知道思想这词怎么拼吗
Dialogue: 0,0:11:17.23,0:11:18.20,Default,,0,0,0,,你们好烦啊
Dialogue: 0,0:11:19.18,0:11:21.25,Default,,0,0,0,,难得喜事 你也吃点吧
Dialogue: 0,0:11:21.59,0:11:23.72,Default,,0,0,0,,我想写的东西可太多了
Dialogue: 0,0:11:24.25,0:11:27.93,Default,,0,0,0,,没有内务部审查 终于能自由发挥了
Dialogue: 0,0:11:28.56,0:11:30.74,Default,,0,0,0,,这样我就能自己出书了
Dialogue: 0,0:11:31.45,0:11:35.64,Default,,0,0,0,,可我觉得你没能出书 不是审查的问题
Dialogue: 0,0:11:35.64,0:11:37.30,Default,,0,0,0,,就是审查的问题
Dialogue: 0,0:11:37.62,0:11:40.53,Default,,0,0,0,,改革者 罗严克拉姆公爵万岁
Dialogue: 0,0:11:40.53,0:11:42.34,Default,,0,0,0,,好 我们也来喊吧
Dialogue: 0,0:11:42.99,0:11:45.45,Default,,0,0,0,,罗严克拉姆公爵万岁！
Dialogue: 0,0:11:45.78,0:11:47.06,Default,,0,0,0,,万岁！
Dialogue: 0,0:11:47.06,0:11:50.06,Default,,0,0,0,,改革者 罗严克拉姆公爵！
Dialogue: 0,0:11:50.06,0:11:58.85,Default,,0,0,0,,罗严克拉姆公爵万岁！
Dialogue: 0,0:11:59.23,0:12:02.25,Default,,0,0,0,,罗严克拉姆公爵…
Dialogue: 0,0:12:03.34,0:12:04.99,Default,,0,0,0,,美丽的庭园
Dialogue: 0,0:12:05.30,0:12:08.43,Default,,0,0,0,,被贱民的脏脚践踏
Dialogue: 0,0:12:08.90,0:12:11.14,Default,,0,0,0,,厚实的地毯沾上了泥泞的鞋印
Dialogue: 0,0:12:11.61,0:12:13.55,Default,,0,0,0,,肮脏不堪的小孩
Dialogue: 0,0:12:13.94,0:12:17.91,Default,,0,0,0,,在只许高贵之人安睡的 挂着床帘的大床上
Dialogue: 0,0:12:17.91,0:12:19.83,Default,,0,0,0,,留下口水的痕迹
Dialogue: 0,0:12:22.15,0:12:25.12,Default,,0,0,0,,这曾经伟大的国家
Dialogue: 0,0:12:25.12,0:12:29.44,Default,,0,0,0,,如今在一帮无法理解美与高贵的半兽人手里
Dialogue: 0,0:12:29.95,0:12:34.85,Default,,0,0,0,,但求这丑态和惨状 全是噩梦一场
Dialogue: 0,0:12:35.47,0:12:39.27,Default,,0,0,0,,该死的罗严克拉姆公爵…该死的
Dialogue: 0,0:12:39.90,0:12:44.05,Default,,0,0,0,,听说了没 贵族的宅邸向市民开放了
Dialogue: 0,0:12:45.30,0:12:47.67,Default,,0,0,0,,说是要改建成医院和福利设施
Dialogue: 0,0:12:48.00,0:12:50.73,Default,,0,0,0,,没收的绘画和艺术品
Dialogue: 0,0:12:50.73,0:12:54.14,Default,,0,0,0,,也陆续转移到公共美术馆了
Dialogue: 0,0:12:54.95,0:12:55.98,Default,,0,0,0,,如何
Dialogue: 0,0:12:55.98,0:12:58.78,Default,,0,0,0,,为了答谢你推荐的美味餐馆
Dialogue: 0,0:12:58.78,0:13:00.81,Default,,0,0,0,,改天我带你去转转吧
Dialogue: 0,0:13:01.36,0:13:02.48,Default,,0,0,0,,再说吧
Dialogue: 0,0:13:08.61,0:13:10.24,Default,,0,0,0,,哟 你也知道这个好吃啊
Dialogue: 0,0:13:12.09,0:13:13.08,Default,,0,0,0,,给 吃吧
Dialogue: 0,0:13:19.32,0:13:23.18,Default,,0,0,0,,看来它比我们更挑剔食物啊
Dialogue: 0,0:13:23.69,0:13:25.53,Default,,0,0,0,,这狗真讨厌
Dialogue: 0,0:13:37.98,0:13:40.98,Basic_Sign2,,0,0,0,,{\pos(952,854)}装甲投弹兵总监 奥夫雷沙
Dialogue: 0,0:13:41.46,0:13:43.98,Basic_Sign2,,0,0,0,,{\pos(1284,182)}米克贝尔加退役元帅
Dialogue: 0,0:14:11.61,0:14:13.19,Default,,0,0,0,,真是个痴人
Dialogue: 0,0:14:35.19,0:14:35.96,Default,,0,0,0,,进来
Dialogue: 0,0:14:36.29,0:14:37.24,Default,,0,0,0,,打扰了
Dialogue: 0,0:14:39.79,0:14:43.57,Default,,0,0,0,,卡尔·布拉克先生和欧根·里希特先生来了
Dialogue: 0,0:14:44.98,0:14:49.57,Basic_Sign2,,0,0,0,,{\fad(500,525)\fsp2\pos(1056,865)}卡尔•布拉克
Dialogue: 0,0:14:45.65,0:14:49.59,Basic_Sign2,,0,0,0,,{\fad(500,525)\fsp2\pos(329.333,809)}欧根•里希特
Dialogue: 0,0:14:50.59,0:14:53.25,Default,,0,0,0,,卡尔·布拉克 欧根·里希特
Dialogue: 0,0:14:53.92,0:14:57.86,Default,,0,0,0,,二人都曾是贵族 却去掉了冯的名号
Dialogue: 0,0:14:58.28,0:15:01.58,Default,,0,0,0,,领导着一个被称为开明派的团体
Dialogue: 0,0:15:02.77,0:15:08.71,Default,,0,0,0,,为了解决长年战争和宫廷乱开销引发的财政危机
Dialogue: 0,0:15:09.25,0:15:14.52,Default,,0,0,0,,莱因哈特命他们制定「社会经济重建计划」
Dialogue: 0,0:15:21.39,0:15:25.37,Default,,0,0,0,,看来民众已经接受了您的改革方案
Dialogue: 0,0:15:26.61,0:15:29.44,Default,,0,0,0,,想让民众信任政府
Dialogue: 0,0:15:29.76,0:15:31.38,Default,,0,0,0,,满足两个条件便足矣
Dialogue: 0,0:15:32.07,0:15:35.38,Default,,0,0,0,,公平的审判跟同样公平的税制
Dialogue: 0,0:15:36.25,0:15:37.14,Default,,0,0,0,,这就够了
Dialogue: 0,0:15:38.64,0:15:43.36,Default,,0,0,0,,改革确实一帆风顺 进展神速
Dialogue: 0,0:15:44.51,0:15:45.36,Default,,0,0,0,,但是…
Dialogue: 0,0:15:46.18,0:15:47.93,Default,,0,0,0,,他似乎是在被什么追赶着…
Dialogue: 0,0:15:48.77,0:15:52.42,Default,,0,0,0,,不 更像是在拼命渴求着什么
Dialogue: 0,0:16:00.24,0:16:02.57,Default,,0,0,0,,区区财政危机 轻易就能解决
Dialogue: 0,0:16:03.41,0:16:04.60,Default,,0,0,0,,是啊
Dialogue: 0,0:16:06.20,0:16:08.72,Default,,0,0,0,,他宣布设立农民信用社了啊
Dialogue: 0,0:16:09.00,0:16:13.98,Default,,0,0,0,,低息贷给农民务农资金
Dialogue: 0,0:16:14.47,0:16:17.25,Default,,0,0,0,,看来罗严克拉姆公爵不光会打仗
Dialogue: 0,0:16:17.25,0:16:19.22,Default,,0,0,0,,在收买人心方面也是好手啊
Dialogue: 0,0:16:19.22,0:16:21.91,Default,,0,0,0,,是啊 他或许是在收买人心
Dialogue: 0,0:16:22.38,0:16:25.01,Default,,0,0,0,,但那帮旧体制的贵族
Dialogue: 0,0:16:25.01,0:16:26.90,Default,,0,0,0,,甚至连收买人心都没想过
Dialogue: 0,0:16:27.24,0:16:29.82,Default,,0,0,0,,只是在单方面压榨人民而已
Dialogue: 0,0:16:30.50,0:16:33.31,Default,,0,0,0,,相较之下 这绝对是进步
Dialogue: 0,0:16:33.66,0:16:35.97,Default,,0,0,0,,是改良
Dialogue: 0,0:16:35.97,0:16:42.33,Default,,0,0,0,,但不依靠民众自主性的改革真的算是进步吗
Dialogue: 0,0:16:42.33,0:16:44.00,Default,,0,0,0,,进步就是进步
Dialogue: 0,0:16:44.36,0:16:48.12,Default,,0,0,0,,就算是上层强权推动的
Dialogue: 0,0:16:48.47,0:16:51.24,Default,,0,0,0,,一旦民众的权利扩大
Dialogue: 0,0:16:51.70,0:16:53.47,Default,,0,0,0,,就不能走回头路了
Dialogue: 0,0:16:54.20,0:16:56.12,Default,,0,0,0,,对我们而言最好的路
Dialogue: 0,0:16:56.42,0:17:00.14,Default,,0,0,0,,就是拥护罗严克拉姆公爵 推进改革
Dialogue: 0,0:17:00.59,0:17:01.56,Default,,0,0,0,,难道不是吗
Dialogue: 0,0:17:02.54,0:17:04.64,Default,,0,0,0,,没人能保证公爵掌握大权后
Dialogue: 0,0:17:04.64,0:17:09.15,Default,,0,0,0,,不会摇身一变成为专制独裁者哦
Dialogue: 0,0:17:12.44,0:17:13.95,Default,,0,0,0,,就算是为了有备无患
Dialogue: 0,0:17:13.95,0:17:17.69,Default,,0,0,0,,我们也必须推进真正的改革
Dialogue: 0,0:17:18.19,0:17:22.18,Default,,0,0,0,,万一哪天他抛弃了改革者的立场
Dialogue: 0,0:17:22.91,0:17:27.78,Default,,0,0,0,,必须有一批公民站出来批判他 对抗他
Dialogue: 0,0:17:27.78,0:17:30.00,Default,,0,0,0,,我们得及早培养出这群人啊
Dialogue: 0,0:17:30.63,0:17:32.30,Default,,0,0,0,,确实如此
Dialogue: 0,0:17:32.81,0:17:36.52,Default,,0,0,0,,但是 我认为罗严克拉姆公爵绝对不会那样
Dialogue: 0,0:17:37.08,0:17:39.52,Default,,0,0,0,,公爵的宅邸 你听说了吗
Dialogue: 0,0:17:41.27,0:17:44.96,Default,,0,0,0,,有书房和卧房 浴室客厅和餐厅
Dialogue: 0,0:17:44.96,0:17:47.43,Default,,0,0,0,,厨房 勤务兵的单人房
Dialogue: 0,0:17:47.73,0:17:50.30,Default,,0,0,0,,院子里再多一幢警卫宿舍
Dialogue: 0,0:17:50.61,0:17:56.79,Default,,0,0,0,,他可是统治250亿人民和数千恒星系的帝国宰相
Dialogue: 0,0:17:56.79,0:17:59.56,Default,,0,0,0,,其住处之朴素 让人实在不敢相信
Dialogue: 0,0:18:00.19,0:18:02.19,Default,,0,0,0,,跟那帮住在大理石宫殿
Dialogue: 0,0:18:02.56,0:18:05.24,Default,,0,0,0,,下半身泡在黄金和宝石里的
Dialogue: 0,0:18:05.52,0:18:08.62,Default,,0,0,0,,鲁道夫大帝和贵族相比 真是天差地别
Dialogue: 0,0:18:09.91,0:18:14.10,Default,,0,0,0,,听说新无忧宫也封锁了一半的庭园和建筑
Dialogue: 0,0:18:14.50,0:18:17.26,Default,,0,0,0,,要解雇众多侍从和侍女
Dialogue: 0,0:18:18.83,0:18:22.67,Default,,0,0,0,,罗严克拉姆公爵的改革没有禁区
Dialogue: 0,0:18:25.17,0:18:26.54,Default,,0,0,0,,谢谢您了
Dialogue: 0,0:18:27.69,0:18:28.98,Default,,0,0,0,,承蒙您照顾了
Dialogue: 0,0:18:28.98,0:18:32.11,Default,,0,0,0,,你还年轻 还有无限可能
Dialogue: 0,0:18:32.41,0:18:35.85,Default,,0,0,0,,不要害怕 去拥抱新世界吧
Dialogue: 0,0:18:36.57,0:18:37.31,Default,,0,0,0,,好
Dialogue: 0,0:18:40.24,0:18:43.30,Default,,0,0,0,,光是新无忧宫没被拆掉
Dialogue: 0,0:18:43.58,0:18:45.62,Default,,0,0,0,,就该心怀感激了啊
Dialogue: 0,0:19:06.62,0:19:09.80,Default,,0,0,0,,新无忧宫的清理工作正在稳步推进
Dialogue: 0,0:19:10.34,0:19:11.19,Default,,0,0,0,,是吗
Dialogue: 0,0:19:11.61,0:19:14.09,Default,,0,0,0,,我想问您一件事
Dialogue: 0,0:19:14.50,0:19:15.49,Default,,0,0,0,,什么事
Dialogue: 0,0:19:15.49,0:19:18.30,Default,,0,0,0,,关于小皇帝
Dialogue: 0,0:19:18.60,0:19:21.89,Default,,0,0,0,,您今后打算如何处置
Dialogue: 0,0:19:25.05,0:19:26.50,Default,,0,0,0,,我不杀皇帝
Dialogue: 0,0:19:27.23,0:19:29.82,Default,,0,0,0,,让他活着才有利用价值
Dialogue: 0,0:19:30.76,0:19:33.54,Default,,0,0,0,,你不这么想吗 奥贝斯坦
Dialogue: 0,0:19:33.88,0:19:37.24,Default,,0,0,0,,确实 目前的确如此
Dialogue: 0,0:19:38.95,0:19:40.44,Default,,0,0,0,,目前是这样
Dialogue: 0,0:19:49.84,0:19:52.06,Default,,0,0,0,,确实不能杀幼帝
Dialogue: 0,0:19:52.59,0:19:57.74,Default,,0,0,0,,如果杀害幼儿 大人就会失去民心
Dialogue: 0,0:19:59.02,0:19:59.86,Default,,0,0,0,,但是…
Dialogue: 0,0:20:09.28,0:20:10.15,Default,,0,0,0,,怎么了？
Dialogue: 0,0:20:13.47,0:20:14.52,Default,,0,0,0,,这是？
Dialogue: 0,0:20:15.25,0:20:19.15,Default,,0,0,0,,请问 这不是您的爱犬吗
Dialogue: 0,0:20:20.24,0:20:22.28,Default,,0,0,0,,看着像我的狗吗
Dialogue: 0,0:20:22.28,0:20:24.17,Default,,0,0,0,,不 不是吗
Dialogue: 0,0:20:26.04,0:20:30.08,Default,,0,0,0,,这样啊…看着像我的狗啊
Dialogue: 0,0:20:37.54,0:20:38.41,Default,,0,0,0,,开车
Dialogue: 0,0:20:38.41,0:20:39.83,Default,,0,0,0,,啊？是！
Dialogue: 0,0:20:56.97,0:20:57.81,Default,,0,0,0,,狗？
Dialogue: 0,0:20:59.02,0:21:01.50,Default,,0,0,0,,你说奥贝斯坦捡了条狗？
Dialogue: 0,0:21:01.97,0:21:06.47,Default,,0,0,0,,而且听说那条狗只吃炖烂了的鸡肉
Dialogue: 0,0:21:06.91,0:21:10.89,Default,,0,0,0,,总参谋长还半夜亲自去买过呢
Dialogue: 0,0:21:11.35,0:21:13.10,Default,,0,0,0,,你说那个奥贝斯坦？
Dialogue: 0,0:21:15.54,0:21:17.86,Default,,0,0,0,,我们的总参谋长大人
Dialogue: 0,0:21:17.86,0:21:21.56,Default,,0,0,0,,招人讨厌 却招狗喜欢啊
Dialogue: 0,0:21:22.11,0:21:23.82,Default,,0,0,0,,我看是狗性相吸吧
Dialogue: 0,0:21:29.90,0:21:31.67,Default,,0,0,0,,费沙有动静吗
Dialogue: 0,0:21:32.45,0:21:35.81,Default,,0,0,0,,黑狐不可能就这样无所作为
Dialogue: 0,0:21:41.71,0:21:43.09,Default,,0,0,0,,打扰了
Dialogue: 0,0:21:47.79,0:21:50.73,Default,,0,0,0,,老爷您的餐点也准备好了
Dialogue: 0,0:21:51.02,0:21:51.95,Default,,0,0,0,,晚点再说
Dialogue: 0,0:21:52.40,0:21:53.80,Default,,0,0,0,,明白了
Dialogue: 0,0:21:54.32,0:21:57.96,Default,,0,0,0,,那么 你就先用餐吧
Dialogue: 0,0:22:16.56,0:22:19.33,Default,,0,0,0,,辛苦你了 今天你可以走了
Dialogue: 0,0:22:20.16,0:22:20.93,Default,,0,0,0,,好的
Dialogue: 0,0:23:11.33,0:23:17.66,Default,,0,0,0,,莱因哈特大人 请您拿下整个宇宙
Dialogue: 0,0:23:37.06,0:23:43.77,EDCN,,0,0,0,,温柔渐渐融化
Dialogue: 0,0:23:43.77,0:23:49.81,EDCN,,0,0,0,,在杯中盘桓
Dialogue: 0,0:23:49.81,0:23:55.03,EDCN,,0,0,0,,一味旋转却抓不住
Dialogue: 0,0:23:55.42,0:24:02.41,EDCN,,0,0,0,,因为有答案 即将溢出
Dialogue: 0,0:24:02.97,0:24:09.59,EDCN,,0,0,0,,夜空中的寒星啊
Dialogue: 0,0:24:09.59,0:24:16.03,EDCN,,0,0,0,,请将这些苦痛照耀 拥抱
Dialogue: 0,0:24:16.03,0:24:23.82,EDCN,,0,0,0,,这份无边满溢的悲伤
Dialogue: 0,0:24:23.82,0:24:28.99,EDCN,,0,0,0,,也定会改换形貌 亘古闪耀
Dialogue: 0,0:24:29.19,0:24:35.63,EDCN,,0,0,0,,你是我唯一 我终于明白
Dialogue: 0,0:24:35.63,0:24:42.44,EDCN,,0,0,0,,我们正要起步 你却已离开
Dialogue: 0,0:24:49.03,0:24:56.52,EDCN,,0,0,0,,我们正要起步 你却已离开
Dialogue: 0,0:24:42.44,0:24:49.03,EDCN,,0,0,0,,你是我唯一 我终于明白
Dialogue: 0,0:23:37.06,0:23:43.77,EDJP,,0,0,0,,優しさには見えている
Dialogue: 0,0:23:43.77,0:23:49.81,EDJP,,0,0,0,,グラスの中でずっと
Dialogue: 0,0:23:49.81,0:23:55.03,EDJP,,0,0,0,,転がすだけで掴めずに
Dialogue: 0,0:23:55.42,0:24:02.41,EDJP,,0,0,0,,こぼれそうな　答えがあるから
Dialogue: 0,0:24:02.97,0:24:09.59,EDJP,,0,0,0,,夜空の冷たい星よ
Dialogue: 0,0:24:09.59,0:24:16.03,EDJP,,0,0,0,,この痛みたちを照らし抱いて
Dialogue: 0,0:24:16.03,0:24:23.82,EDJP,,0,0,0,,止め処なく溢れる悲しさも
Dialogue: 0,0:24:23.82,0:24:28.99,EDJP,,0,0,0,,形を変え輝いていくだろう
Dialogue: 0,0:24:29.19,0:24:35.63,EDJP,,0,0,0,,You're the only one, I descry
Dialogue: 0,0:24:35.63,0:24:42.44,EDJP,,0,0,0,,We've only just begun to stand by
Dialogue: 0,0:24:42.44,0:24:49.03,EDJP,,0,0,0,,You're the only one, I descry
Dialogue: 0,0:24:49.03,0:24:56.52,EDJP,,0,0,0,,We've only just begun to stand by

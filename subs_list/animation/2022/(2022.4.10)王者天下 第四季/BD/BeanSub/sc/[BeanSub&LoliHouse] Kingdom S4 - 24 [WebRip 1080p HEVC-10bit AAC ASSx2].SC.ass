Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕组制作 仅供学习交流 禁止用于商业用途
Comment: 0,0:00:55.03,0:00:55.08,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:00:55.85,0:01:01.02,op-jp,,0,0,0,,希望に溢れた　お前の目に浮かぶのは
Dialogue: 0,0:01:01.02,0:01:02.78,op-jp,,0,0,0,,誰の幻想？
Dialogue: 0,0:01:02.78,0:01:06.13,op-jp,,0,0,0,,何もかも失いそうになって
Dialogue: 0,0:01:06.13,0:01:11.31,op-jp,,0,0,0,,巡り会うんだ　再会の誓いを
Dialogue: 0,0:01:24.26,0:01:27.26,op-jp,,0,0,0,,段々と熱くなる
Dialogue: 0,0:01:27.26,0:01:31.51,op-jp,,0,0,0,,心　燃やす　咆哮に変えてけ
Dialogue: 0,0:01:31.51,0:01:34.34,op-jp,,0,0,0,,飄々と歩くのさ
Dialogue: 0,0:01:34.34,0:01:39.24,op-jp,,0,0,0,,先の見えぬ夢を掴むまで
Dialogue: 0,0:01:39.41,0:01:44.74,op-jp,,0,0,0,,時には涙を流す夜もある
Dialogue: 0,0:01:44.74,0:01:49.37,op-jp,,0,0,0,,誓ったあの日を共に笑った事
Dialogue: 0,0:01:49.37,0:01:51.87,op-jp,,0,0,0,,胸に刻み込んで
Dialogue: 0,0:01:51.87,0:01:58.92,op-jp,,0,0,0,,嗚呼　息もできないこの世界であなたにあった夜
Dialogue: 0,0:01:58.92,0:02:05.68,op-jp,,0,0,0,,消えかけた心の灯火　輝いた
Dialogue: 0,0:02:06.05,0:02:10.43,op-jp,,0,0,0,,どんな未来だって　受け容れる
Dialogue: 0,0:02:10.43,0:02:13.19,op-jp,,0,0,0,,生きる理由なんだ
Dialogue: 0,0:02:13.19,0:02:18.44,op-jp,,0,0,0,,燃やせ　今この声が響く限り
Dialogue: 0,0:02:18.44,0:02:24.35,op-jp,,0,0,0,,果てなき明日へ
Dialogue: 0,0:02:24.35,0:02:24.35,op-jp,,0,0,0,,
Dialogue: 0,0:00:55.85,0:01:01.02,op-cn,,0,0,0,,你那充满希望的双眸中
Dialogue: 0,0:01:01.02,0:01:02.78,op-cn,,0,0,0,,映出谁的幻想？
Dialogue: 0,0:01:02.78,0:01:06.13,op-cn,,0,0,0,,在即将失去一切之时
Dialogue: 0,0:01:06.13,0:01:11.31,op-cn,,0,0,0,,邂逅重逢的誓言
Dialogue: 0,0:01:24.26,0:01:27.26,op-cn,,0,0,0,,身体愈发火热
Dialogue: 0,0:01:27.26,0:01:31.51,op-cn,,0,0,0,,燃烧内心 化为咆哮
Dialogue: 0,0:01:31.51,0:01:34.34,op-cn,,0,0,0,,步伐愈显轻盈
Dialogue: 0,0:01:34.34,0:01:39.24,op-cn,,0,0,0,,直至抓住 未知之梦
Dialogue: 0,0:01:39.41,0:01:44.74,op-cn,,0,0,0,,时而于夜晚落泪
Dialogue: 0,0:01:44.74,0:01:49.37,op-cn,,0,0,0,,一同欢笑 共度立誓之日
Dialogue: 0,0:01:49.37,0:01:51.87,op-cn,,0,0,0,,将其铭记于心
Dialogue: 0,0:01:51.87,0:01:58.92,op-cn,,0,0,0,,在这窒息的世界 邂逅你的夜晚
Dialogue: 0,0:01:58.92,0:02:05.68,op-cn,,0,0,0,,即将熄灭的心中灯火 光芒四射
Dialogue: 0,0:02:06.05,0:02:10.43,op-cn,,0,0,0,,不论怎样的未来 都甘愿接受
Dialogue: 0,0:02:10.43,0:02:13.19,op-cn,,0,0,0,,这就是活着的理由
Dialogue: 0,0:02:13.19,0:02:18.44,op-cn,,0,0,0,,燃烧吧 只要这声音回响不止
Dialogue: 0,0:02:18.44,0:02:24.35,op-cn,,0,0,8,,前往永无止境的明天
Dialogue: 0,0:00:30.33,0:00:32.33,op-cn,,0,0,0,,
Comment: 0,0:23:15.95,0:23:16.04,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:29.89,0:23:40.15,ed-jp,,0,0,0,,真っ暗闇の中、光の希望が消え去ることない
Dialogue: 0,0:23:40.15,0:23:43.59,ed-jp,,0,0,0,,ただひとつの誓い
Dialogue: 0,0:23:43.59,0:23:49.82,ed-jp,,0,0,0,,傷だらけでも傷んだ分だけ
Dialogue: 0,0:23:49.82,0:23:56.98,ed-jp,,0,0,0,,繋いだ心　そばにあるさ
Dialogue: 0,0:23:57.17,0:24:03.79,ed-jp,,0,0,0,,大切なもの守り抜けと　その血、汗、涙が導く
Dialogue: 0,0:24:03.79,0:24:10.82,ed-jp,,0,0,0,,己の心に従え、振り向くな、さぁ立ち上がれ
Dialogue: 0,0:24:10.82,0:24:16.53,ed-jp,,0,0,0,,俺が俺である限り　己信じ、明日を思い描け
Dialogue: 0,0:24:16.53,0:24:19.78,ed-jp,,0,0,0,,恐れるな、さぁ高く翔べ
Dialogue: 0,0:24:19.78,0:24:25.73,ed-jp,,0,0,0,,俺たちが輝く日まで
Dialogue: 0,0:24:25.73,0:24:27.73,ed-jp,,0,0,0,,
Dialogue: 0,0:23:29.89,0:23:40.15,ed-cn,,0,0,0,,即便陷入黑暗 希望之光也不会消失
Dialogue: 0,0:23:40.15,0:23:43.59,ed-cn,,0,0,0,,这唯一的誓言
Dialogue: 0,0:23:43.59,0:23:49.82,ed-cn,,0,0,0,,受伤几次 就强大几分
Dialogue: 0,0:23:49.82,0:23:56.98,ed-cn,,0,0,0,,我们心心相连 不离不弃
Dialogue: 0,0:23:57.17,0:24:03.79,ed-cn,,0,0,0,,守护珍视之物 以鲜血 汗水 泪水为指引
Dialogue: 0,0:24:03.79,0:24:10.82,ed-cn,,0,0,0,,遵循内心 不要回头 奋起战斗
Dialogue: 0,0:24:10.82,0:24:16.53,ed-cn,,0,0,0,,只要我还是我 就相信自己 描绘明天
Dialogue: 0,0:24:16.53,0:24:19.78,ed-cn,,0,0,0,,不要畏惧 展翅高飞
Dialogue: 0,0:24:19.78,0:24:25.73,ed-cn,,0,0,0,,飞向我们大放异彩之日
Dialogue: 0,0:24:25.73,0:24:25.73,ed-cn,,0,0,0,,
Dialogue: 0,0:00:07.92,0:00:09.72,Default,,0,0,0,,输了吗
Dialogue: 0,0:00:10.75,0:00:14.15,Default,,0,0,0,,为什么要逃 我军分明依然占据数量优势
Dialogue: 0,0:00:14.50,0:00:16.35,Default,,0,0,0,,不好 朝这边来了
Dialogue: 0,0:00:16.46,0:00:18.12,Default,,0,0,0,,暂且撤退
Dialogue: 0,0:00:18.12,0:00:20.87,Default,,0,0,0,,朝东边 往毐国方向逃
Dialogue: 0,0:00:21.01,0:00:22.08,Default,,0,0,0,,调头
Dialogue: 0,0:00:23.56,0:00:24.45,Default,,0,0,0,,嫪毐大人
Dialogue: 0,0:00:24.60,0:00:25.87,Default,,0,0,0,,请快上马车
Dialogue: 0,0:00:26.66,0:00:28.29,Default,,0,0,0,,不 不对
Dialogue: 0,0:00:29.26,0:00:31.32,Default,,0,0,0,,不 不是东边
Dialogue: 0,0:00:31.91,0:00:34.42,Default,,0,0,0,,要去西边…西边的雍城
Dialogue: 0,0:00:35.44,0:00:39.26,Default,,0,0,0,,我 我们约定好了 要去接她
Dialogue: 0,0:00:39.65,0:00:42.29,Default,,0,0,0,,我 我们约定要攻下咸阳
Dialogue: 0,0:00:43.16,0:00:45.61,Default,,0,0,0,,去雍城迎接她
Dialogue: 0,0:00:46.72,0:00:50.52,Default,,0,0,0,,我和太后约定好了啊
Dialogue: 0,0:00:50.80,0:00:54.90,Default,,0,0,0,,太后
Dialogue: 0,0:02:25.45,0:02:28.62,biaoti,,0,0,0,,{\fad(480,470)}内乱的终点
Dialogue: 0,0:03:16.47,0:03:17.01,Default,,0,0,0,,瑠衣
Dialogue: 0,0:03:19.51,0:03:22.36,Default,,0,0,0,,让我过去 是从咸阳发来的急报
Dialogue: 0,0:03:22.36,0:03:23.76,Default,,0,0,0,,让我过去
Dialogue: 0,0:03:24.27,0:03:26.11,Default,,0,0,0,,似乎是吕不韦的传令者
Dialogue: 0,0:03:27.36,0:03:28.01,Default,,0,0,0,,我们进去
Dialogue: 0,0:03:28.23,0:03:29.27,Default,,0,0,0,,是
Dialogue: 0,0:03:39.38,0:03:40.55,Default,,0,0,0,,相国
Dialogue: 0,0:03:41.05,0:03:43.79,Default,,0,0,0,,咸阳的战斗已经决出胜负
Dialogue: 0,0:03:44.21,0:03:45.66,Default,,0,0,0,,特此禀报
Dialogue: 0,0:04:04.28,0:04:06.19,Default,,0,0,0,,无妨 报
Dialogue: 0,0:04:08.13,0:04:08.76,Default,,0,0,0,,是
Dialogue: 0,0:04:09.98,0:04:12.15,Default,,0,0,0,,毐国军叛乱失败
Dialogue: 0,0:04:12.64,0:04:15.02,Default,,0,0,0,,叛军战败 未能攻陷咸阳
Dialogue: 0,0:04:15.64,0:04:18.23,Default,,0,0,0,,正沿北道败退
Dialogue: 0,0:04:32.17,0:04:34.79,Default,,0,0,0,,确认无误吗
Dialogue: 0,0:04:36.53,0:04:39.04,Default,,0,0,0,,是的 千真万确
Dialogue: 0,0:04:42.97,0:04:43.80,Default,,0,0,0,,政陛下
Dialogue: 0,0:04:45.63,0:04:46.71,Default,,0,0,0,,大王
Dialogue: 0,0:04:47.65,0:04:49.01,Default,,0,0,0,,咸阳的战斗…
Dialogue: 0,0:04:50.87,0:04:53.23,Default,,0,0,0,,胜报已经听说了 咸阳现状怎样
Dialogue: 0,0:04:53.76,0:04:54.23,Default,,0,0,0,,回大王
Dialogue: 0,0:04:54.74,0:04:57.44,Default,,0,0,0,,叛军一度攻入咸阳城内
Dialogue: 0,0:04:58.59,0:05:02.86,Default,,0,0,0,,城内居民死伤众多 房屋受损严重
Dialogue: 0,0:05:03.33,0:05:06.96,Default,,0,0,0,,敌人甚至还入侵了王宫和后宫
Dialogue: 0,0:05:07.74,0:05:08.87,Default,,0,0,0,,还入侵了后宫？
Dialogue: 0,0:05:09.24,0:05:10.52,Default,,0,0,0,,不 不过
Dialogue: 0,0:05:10.76,0:05:14.13,Default,,0,0,0,,大王的子嗣 扶苏殿下 丽殿下
Dialogue: 0,0:05:14.20,0:05:17.12,Default,,0,0,0,,以及各位妃子都平安无事
Dialogue: 0,0:05:17.75,0:05:20.88,Default,,0,0,0,,已经仔细确认过 不会有误
Dialogue: 0,0:05:24.69,0:05:25.63,Default,,0,0,0,,是吗
Dialogue: 0,0:05:29.83,0:05:30.48,Default,,0,0,0,,喂
Dialogue: 0,0:05:35.35,0:05:38.19,Default,,0,0,0,,太 太后…
Dialogue: 0,0:05:38.43,0:05:40.17,Default,,0,0,0,,嫪毐怎么样了
Dialogue: 0,0:05:42.36,0:05:47.65,Default,,0,0,0,,叛乱主谋嫪毐 并未收到其战死的报告
Dialogue: 0,0:05:48.55,0:05:56.31,Default,,0,0,0,,推测正与叛军一道 沿北道败退
Dialogue: 0,0:05:59.85,0:06:02.00,Default,,0,0,0,,请 请放开手…
Dialogue: 0,0:06:02.63,0:06:04.56,Default,,0,0,0,,太 太后…
Dialogue: 0,0:06:45.49,0:06:46.42,Default,,0,0,0,,没想到
Dialogue: 0,0:06:49.21,0:06:52.40,Default,,0,0,0,,掷出「正面」的会是你们
Dialogue: 0,0:07:05.67,0:07:06.59,Default,,0,0,0,,大王
Dialogue: 0,0:07:08.08,0:07:09.89,Default,,0,0,0,,不论结果如何
Dialogue: 0,0:07:11.15,0:07:14.44,Default,,0,0,0,,我们终于决出了胜负啊
Dialogue: 0,0:07:20.84,0:07:21.39,Default,,0,0,0,,嗯
Dialogue: 0,0:07:23.03,0:07:23.84,Default,,0,0,0,,是啊
Dialogue: 0,0:07:37.35,0:07:38.49,Default,,0,0,0,,是吗
Dialogue: 0,0:07:39.64,0:07:44.02,Default,,0,0,0,,是我…输了啊
Dialogue: 0,0:08:08.50,0:08:09.29,Default,,0,0,0,,不
Dialogue: 0,0:08:13.54,0:08:17.52,Default,,0,0,0,,我输得彻彻底底
Dialogue: 0,0:08:30.58,0:08:32.28,Default,,0,0,0,,为什么会变成这样
Dialogue: 0,0:08:34.82,0:08:36.41,Default,,0,0,0,,居然和自国人打了一仗
Dialogue: 0,0:08:38.71,0:08:39.93,Default,,0,0,0,,是函谷关
Dialogue: 0,0:08:40.87,0:08:42.93,Default,,0,0,0,,快看 是函谷关
Dialogue: 0,0:08:43.88,0:08:45.43,Default,,0,0,0,,只要通过那里…
Dialogue: 0,0:08:45.83,0:08:49.75,Default,,0,0,0,,嗯 就能逃出去 就能回到毐国
Dialogue: 0,0:08:52.47,0:08:55.27,Default,,0,0,0,,还差一点 只差一点了
Dialogue: 0,0:08:56.98,0:08:58.83,Default,,0,0,0,,出 出来了
Dialogue: 0,0:09:01.09,0:09:03.34,Default,,0,0,0,,是 是桓骑军
Dialogue: 0,0:09:03.34,0:09:06.10,Default,,0,0,0,,有桓骑军的埋伏
Dialogue: 0,0:09:06.43,0:09:10.23,Default,,0,0,0,,败退的叛军刚出函谷关
Dialogue: 0,0:09:10.33,0:09:12.90,Default,,0,0,0,,就遭遇了桓骑军的攻击
Dialogue: 0,0:09:15.30,0:09:17.63,Default,,0,0,0,,蠢货居然大摇大摆地出来了
Dialogue: 0,0:09:17.63,0:09:18.86,Default,,0,0,0,,我们上
Dialogue: 0,0:09:33.15,0:09:34.26,Default,,0,0,0,,放箭
Dialogue: 0,0:09:38.80,0:09:41.03,Default,,0,0,0,,不好 我们后退…
Dialogue: 0,0:09:49.06,0:09:53.53,Default,,0,0,0,,这场战斗 可以说是桓骑军单方面的屠杀
Dialogue: 0,0:09:53.83,0:09:55.68,Default,,0,0,0,,场面惨烈至极
Dialogue: 0,0:10:10.38,0:10:11.67,Default,,0,0,0,,太后…
Dialogue: 0,0:10:13.92,0:10:17.19,Default,,0,0,0,,我必须去太后所在的雍城…
Dialogue: 0,0:10:25.70,0:10:26.90,Default,,0,0,0,,老大
Dialogue: 0,0:10:28.34,0:10:30.54,Default,,0,0,0,,抓到叛军头目了
Dialogue: 0,0:10:39.17,0:10:42.32,Default,,0,0,0,,挖掉双眼 砍断手脚
Dialogue: 0,0:10:43.00,0:10:47.54,Default,,0,0,0,,总司令有令 万万不可这么做
Dialogue: 0,0:10:48.29,0:10:50.54,Default,,0,0,0,,毕竟他是证人
Dialogue: 0,0:11:01.48,0:11:02.32,Default,,0,0,0,,另一方面
Dialogue: 0,0:11:02.82,0:11:05.73,Default,,0,0,0,,秦·楚国境上的玄斗
Dialogue: 0,0:11:05.86,0:11:10.23,Default,,0,0,0,,娲燐军与蒙武联军正在展开激战
Dialogue: 0,0:11:10.96,0:11:15.91,Default,,0,0,0,,什么 毐国的家伙失败了？
Dialogue: 0,0:11:16.37,0:11:17.57,Default,,0,0,0,,是 是的
Dialogue: 0,0:11:20.40,0:11:21.39,Default,,0,0,0,,搞什么鬼
Dialogue: 0,0:11:21.63,0:11:29.03,Default,,0,0,0,,亏我还说接下来要给蒙武那小子吃点苦头
Dialogue: 0,0:11:30.95,0:11:32.75,Default,,0,0,0,,全军撤退
Dialogue: 0,0:11:33.19,0:11:35.25,Default,,0,0,0,,项翼 收到了撤退命令
Dialogue: 0,0:11:36.42,0:11:40.31,Default,,0,0,0,,为啥啊 我们一点都不落下风啊
Dialogue: 0,0:11:40.48,0:11:43.58,Default,,0,0,0,,传令兵说是摇钱树倒了
Dialogue: 0,0:11:45.39,0:11:47.86,Default,,0,0,0,,总之大部队已经开始后退了
Dialogue: 0,0:11:49.84,0:11:53.20,Default,,0,0,0,,那个大块头女人搞什么啊
Dialogue: 0,0:11:53.27,0:11:56.02,Default,,0,0,0,,正在撤退 楚军正在撤退
Dialogue: 0,0:11:56.74,0:11:59.86,Default,,0,0,0,,楚国果然与毐国串通一气了啊
Dialogue: 0,0:12:00.31,0:12:01.77,Default,,0,0,0,,不会错的
Dialogue: 0,0:12:02.64,0:12:06.66,Default,,0,0,0,,毐国刚在太原宣布建国 楚军就前来进犯
Dialogue: 0,0:12:07.14,0:12:09.39,Default,,0,0,0,,再加上这撤退 已经坐实了嫌疑
Dialogue: 0,0:12:10.46,0:12:11.66,Default,,0,0,0,,等一下
Dialogue: 0,0:12:11.96,0:12:16.43,Default,,0,0,0,,毐国都不一定算得上国家 发起了这么个小叛乱
Dialogue: 0,0:12:17.16,0:12:19.38,Default,,0,0,0,,却能请来楚军相助吗
Dialogue: 0,0:12:20.21,0:12:22.63,Default,,0,0,0,,确实 未免有些夸张
Dialogue: 0,0:12:23.27,0:12:23.92,Default,,0,0,0,,不
Dialogue: 0,0:12:24.56,0:12:26.96,Default,,0,0,0,,其实这次失败的叛乱
Dialogue: 0,0:12:28.03,0:12:30.52,Default,,0,0,0,,就是有如此规模
Dialogue: 0,0:12:33.17,0:12:35.06,Default,,0,0,0,,说不定在我们不知道的地方
Dialogue: 0,0:12:35.71,0:12:38.48,Default,,0,0,0,,秦国险些翻天覆地
Dialogue: 0,0:12:42.16,0:12:43.15,Default,,0,0,0,,吕不韦吗
Dialogue: 0,0:12:44.24,0:12:44.95,Default,,0,0,0,,什么
Dialogue: 0,0:12:45.60,0:12:47.11,Default,,0,0,0,,他是败者
Dialogue: 0,0:12:48.31,0:12:49.00,Default,,0,0,0,,王贲
Dialogue: 0,0:12:51.09,0:12:54.39,Default,,0,0,0,,秦国即将进入新时代
Dialogue: 0,0:13:40.88,0:13:46.08,Default,,0,0,0,,接下来 对毐国叛乱主谋执行死刑
Dialogue: 0,0:13:46.29,0:13:48.73,Default,,0,0,0,,在此之前 再次进行核实
Dialogue: 0,0:13:49.49,0:13:52.24,Default,,0,0,0,,你是否为嫪毐
Dialogue: 0,0:13:53.01,0:13:54.10,Default,,0,0,0,,是的
Dialogue: 0,0:13:54.80,0:13:58.60,Default,,0,0,0,,你假扮成宦官 进入后宫
Dialogue: 0,0:13:59.11,0:14:07.05,Default,,0,0,0,,拉拢太后 成立毐国 企图颠覆秦国
Dialogue: 0,0:14:07.05,0:14:08.49,Default,,0,0,0,,你是否认罪
Dialogue: 0,0:14:10.82,0:14:11.81,Default,,0,0,0,,我认罪
Dialogue: 0,0:14:13.00,0:14:16.05,Default,,0,0,0,,上述行为皆由你一人谋划吗
Dialogue: 0,0:14:16.82,0:14:17.61,Default,,0,0,0,,不是我
Dialogue: 0,0:14:18.29,0:14:20.20,Default,,0,0,0,,那么是谁
Dialogue: 0,0:14:22.11,0:14:27.04,Default,,0,0,0,,命令我假扮宦官进入后宫的…
Dialogue: 0,0:14:35.11,0:14:36.64,Default,,0,0,0,,是吕不韦大人
Dialogue: 0,0:14:51.06,0:14:55.91,Default,,0,0,0,,吕不韦大人安排我进入后宫 就是一切的开端
Dialogue: 0,0:14:58.69,0:15:00.08,Default,,0,0,0,,此言是否属实
Dialogue: 0,0:15:00.66,0:15:01.69,Default,,0,0,0,,是的
Dialogue: 0,0:15:02.61,0:15:06.17,Default,,0,0,0,,那么 伪造玉玺一事呢
Dialogue: 0,0:15:09.65,0:15:11.89,Default,,0,0,0,,是我所为
Dialogue: 0,0:15:12.39,0:15:13.78,Default,,0,0,0,,此言是否属实
Dialogue: 0,0:15:14.38,0:15:15.43,Default,,0,0,0,,是的
Dialogue: 0,0:15:16.04,0:15:19.31,Default,,0,0,0,,也有人供述称是太后所为…
Dialogue: 0,0:15:19.31,0:15:20.56,Default,,0,0,0,,不是的
Dialogue: 0,0:15:26.57,0:15:33.03,Default,,0,0,0,,是我从太后处偷得玉玺进行伪造 并起兵造反
Dialogue: 0,0:15:33.03,0:15:36.58,Default,,0,0,0,,一切都是我一人谋划
Dialogue: 0,0:15:36.98,0:15:39.45,Default,,0,0,0,,与太后无关
Dialogue: 0,0:15:40.21,0:15:41.58,Default,,0,0,0,,此话当真？
Dialogue: 0,0:15:42.36,0:15:46.19,Default,,0,0,0,,此次叛乱是我一人的判断
Dialogue: 0,0:15:46.86,0:15:50.32,Default,,0,0,0,,与太后没有丝毫关系
Dialogue: 0,0:15:50.59,0:15:52.84,Default,,0,0,0,,一切都是我嫪毐…
Dialogue: 0,0:15:52.84,0:15:54.28,Default,,0,0,0,,别闹了
Dialogue: 0,0:15:56.23,0:15:56.97,Default,,0,0,0,,什么
Dialogue: 0,0:16:03.36,0:16:04.07,Default,,0,0,0,,太…
Dialogue: 0,0:16:09.86,0:16:11.04,Default,,0,0,0,,太后
Dialogue: 0,0:16:15.65,0:16:16.62,Default,,0,0,0,,卫兵
Dialogue: 0,0:16:18.78,0:16:20.24,Default,,0,0,0,,她是怎么进来的
Dialogue: 0,0:16:21.44,0:16:27.65,Default,,0,0,0,,这名男子无才无能 胸无大志
Dialogue: 0,0:16:28.45,0:16:31.14,Default,,0,0,0,,只是个不值一提的小人物
Dialogue: 0,0:16:35.02,0:16:39.97,Default,,0,0,0,,这样的人不可能独自发起此次叛乱
Dialogue: 0,0:16:40.54,0:16:43.52,Default,,0,0,0,,你们所有人都心知肚明
Dialogue: 0,0:16:49.86,0:16:51.44,Default,,0,0,0,,主谋当然是我
Dialogue: 0,0:16:53.05,0:16:55.48,Default,,0,0,0,,一切都是我策划的
Dialogue: 0,0:16:55.84,0:17:00.20,Default,,0,0,0,,若要处决嫪毐 就先将我太后处决
Dialogue: 0,0:17:00.61,0:17:02.70,Default,,0,0,0,,太 太后
Dialogue: 0,0:17:03.03,0:17:05.46,Default,,0,0,0,,你试试看啊 政
Dialogue: 0,0:17:13.27,0:17:14.13,Default,,0,0,0,,做不到
Dialogue: 0,0:17:15.88,0:17:19.71,Default,,0,0,0,,此次问罪对象 是叛乱主谋·嫪毐
Dialogue: 0,0:17:20.65,0:17:22.22,Default,,0,0,0,,并非母后
Dialogue: 0,0:17:25.01,0:17:26.37,Default,,0,0,0,,混蛋
Dialogue: 0,0:17:26.37,0:17:28.49,Default,,0,0,0,,太 太后 请后退
Dialogue: 0,0:17:28.49,0:17:30.23,Default,,0,0,0,,政
Dialogue: 0,0:17:30.87,0:17:32.10,Default,,0,0,0,,太后…
Dialogue: 0,0:17:50.58,0:17:51.80,Default,,0,0,0,,那两个孩子…
Dialogue: 0,0:17:53.75,0:17:55.13,Default,,0,0,0,,你也要杀掉吗
Dialogue: 0,0:17:58.08,0:18:02.35,Default,,0,0,0,,我和嫪毐生下的两个孩子
Dialogue: 0,0:18:03.81,0:18:05.31,Default,,0,0,0,,你也要杀掉吗
Dialogue: 0,0:18:08.55,0:18:10.28,Default,,0,0,0,,她 她说什么…
Dialogue: 0,0:18:12.74,0:18:13.69,Default,,0,0,0,,政
Dialogue: 0,0:18:23.37,0:18:25.89,Default,,0,0,0,,为了避免再次发生类似的叛乱
Dialogue: 0,0:18:26.94,0:18:32.28,Default,,0,0,0,,会为国家带来灾祸的火种 必须彻底扑灭
Dialogue: 0,0:19:13.70,0:19:14.58,Default,,0,0,0,,美姬…
Dialogue: 0,0:19:26.04,0:19:29.02,Default,,0,0,0,,那 那个太后居然…
Dialogue: 0,0:19:40.98,0:19:42.70,Default,,0,0,0,,我最爱的男人
Dialogue: 0,0:19:43.73,0:19:46.64,Default,,0,0,0,,将我当成飞黄腾达的道具 用完就扔
Dialogue: 0,0:19:48.26,0:19:50.79,Default,,0,0,0,,我的人生就此急转直下
Dialogue: 0,0:19:52.00,0:19:54.62,Default,,0,0,0,,被不爱的人男人玩弄
Dialogue: 0,0:19:55.28,0:19:57.90,Default,,0,0,0,,再次被抛弃
Dialogue: 0,0:19:59.41,0:20:02.70,Default,,0,0,0,,生下秦国王族的肮脏女人
Dialogue: 0,0:20:02.70,0:20:03.86,Default,,0,0,0,,该死的东西
Dialogue: 0,0:20:03.99,0:20:05.47,Default,,0,0,0,,干掉她
Dialogue: 0,0:20:08.48,0:20:13.19,Default,,0,0,0,,自那以后 我便身陷恶意之中
Dialogue: 0,0:20:18.15,0:20:19.05,Default,,0,0,0,,政
Dialogue: 0,0:20:20.23,0:20:21.86,Default,,0,0,0,,当时你还年幼
Dialogue: 0,0:20:22.71,0:20:27.61,Default,,0,0,0,,在邯郸的那段日子 一定也是你不堪回首的记忆
Dialogue: 0,0:20:30.01,0:20:30.71,Default,,0,0,0,,但是
Dialogue: 0,0:20:31.71,0:20:39.25,Default,,0,0,0,,我这个成年人 过得更加艰难 更加凄惨
Dialogue: 0,0:20:56.07,0:20:59.55,Default,,0,0,0,,几年后
Dialogue: 0,0:21:00.17,0:21:04.80,Default,,0,0,0,,把我丢下 自己逃到秦国的人成了太子
Dialogue: 0,0:21:05.71,0:21:09.78,Default,,0,0,0,,我也被迎至咸阳 成了王妃
Dialogue: 0,0:21:10.42,0:21:13.79,Default,,0,0,0,,但我从未觉得得到了拯救
Dialogue: 0,0:21:14.51,0:21:17.79,Default,,0,0,0,,我的世界
Dialogue: 0,0:21:19.00,0:21:21.18,Default,,0,0,0,,不论我做什么
Dialogue: 0,0:21:21.91,0:21:25.40,Default,,0,0,0,,都只是一片无臭无味的灰色
Dialogue: 0,0:21:27.04,0:21:27.73,Default,,0,0,0,,但是
Dialogue: 0,0:21:28.44,0:21:32.54,Default,,0,0,0,,自从我遇到嫪毐 怀上他的孩子
Dialogue: 0,0:21:32.96,0:21:34.81,Default,,0,0,0,,我的世界便发生了变化
Dialogue: 0,0:21:45.67,0:21:49.15,Default,,0,0,0,,我内心那干涸了二十多年的土地
Dialogue: 0,0:21:49.46,0:21:51.28,Default,,0,0,0,,终于有水浇灌其上
Dialogue: 0,0:21:52.14,0:21:55.04,Default,,0,0,0,,渗入了我的身心
Dialogue: 0,0:21:55.84,0:22:00.38,Default,,0,0,0,,而浇灌我内心的 就是嫪毐
Dialogue: 0,0:22:10.06,0:22:13.30,Default,,0,0,0,,我知道嫪毐不可能活命
Dialogue: 0,0:22:14.34,0:22:16.60,Default,,0,0,0,,你也不必留我的性命
Dialogue: 0,0:22:17.60,0:22:19.89,Default,,0,0,0,,但是 求求你
Dialogue: 0,0:22:20.84,0:22:22.93,Default,,0,0,0,,放过那两个孩子
Dialogue: 0,0:22:24.15,0:22:28.68,Default,,0,0,0,,此时此刻 我终于清楚地意识到
Dialogue: 0,0:22:29.59,0:22:34.95,Default,,0,0,0,,和嫪毐生下的那两个孩子 就是我的一切
Dialogue: 0,0:22:39.06,0:22:41.06,Default,,0,0,0,,要是他们被杀
Dialogue: 0,0:22:42.19,0:22:44.21,Default,,0,0,0,,我就一无所有了
Dialogue: 0,0:22:44.83,0:22:48.39,Default,,0,0,0,,我这地狱般的人生将失去一切意义
Dialogue: 0,0:22:49.34,0:22:50.20,Default,,0,0,0,,一无所剩
Dialogue: 0,0:22:50.74,0:22:53.46,Default,,0,0,0,,我知道这是在强人所难
Dialogue: 0,0:22:54.32,0:22:55.18,Default,,0,0,0,,政
Dialogue: 0,0:22:55.88,0:22:56.90,Default,,0,0,0,,求求你
Dialogue: 0,0:22:57.84,0:23:01.24,Default,,0,0,0,,求求你放过那两个孩子
Dialogue: 0,0:23:01.24,0:23:05.30,Default,,0,0,0,,这是我这个母亲对你的第一个也是最后一个请求
Dialogue: 0,0:24:48.20,0:24:49.91,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:50.57,0:24:52.03,Default,,0,0,0,,「雄飞之刻」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕組製作 僅供學習交流 禁止用於商業用途
Comment: 0,0:00:31.01,0:00:31.06,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:00:52.24,0:00:58.67,op-jp,,0,0,0,,滴る汗と日差しで閉じた目
Dialogue: 0,0:00:58.67,0:01:04.92,op-jp,,0,0,0,,映し出したのはあなたとの約束
Dialogue: 0,0:01:04.92,0:01:11.56,op-jp,,0,0,0,,意志を紡いだ導火線に火をつけたら
Dialogue: 0,0:01:11.56,0:01:17.31,op-jp,,0,0,0,,今より強く高く翔べる
Dialogue: 0,0:01:17.31,0:01:24.04,op-jp,,0,0,0,,恐れを知って哀を知って進むなら
Dialogue: 0,0:01:24.04,0:01:31.51,op-jp,,0,0,0,,己の全て捧げ旗を上げろ
Dialogue: 0,0:01:31.51,0:01:37.08,op-jp,,0,0,0,,掠れた声を何度も張りあげてよ
Dialogue: 0,0:01:37.08,0:01:41.96,op-jp,,0,0,0,,希望を決意を抱いて
Dialogue: 0,0:00:52.24,0:00:58.67,op-cn,,0,0,0,,汗水滾落 烈日當頭 我閉上雙眼
Dialogue: 0,0:00:58.67,0:01:04.92,op-cn,,0,0,0,,眼中映出 與你的約定
Dialogue: 0,0:01:04.92,0:01:11.56,op-cn,,0,0,0,,點燃以意志織成的導火線
Dialogue: 0,0:01:11.56,0:01:17.31,op-cn,,0,0,0,,向著更高更強 振翅高飛
Dialogue: 0,0:01:17.31,0:01:24.04,op-cn,,0,0,0,,知曉恐懼 知曉哀傷 前進不息
Dialogue: 0,0:01:24.04,0:01:31.51,op-cn,,0,0,0,,獻出一切 高舉旗幟
Dialogue: 0,0:01:31.51,0:01:37.08,op-cn,,0,0,0,,無數次發出嘶吼
Dialogue: 0,0:01:37.08,0:01:41.96,op-cn,,0,0,0,,心懷希望 堅定決心
Comment: 0,0:22:53.94,0:22:53.94,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:05.03,0:23:07.98,ed-jp,,0,0,1,,なぁ坊やどうした？ここは戦場だぜ
Dialogue: 0,0:23:07.98,0:23:10.81,ed-jp,,0,0,1,,たぎる憎悪のラリー　背馳の成長過程
Dialogue: 0,0:23:10.81,0:23:13.62,ed-jp,,0,0,1,,加減も知らず殺気立ったままの剣に
Dialogue: 0,0:23:13.62,0:23:16.79,ed-jp,,0,0,1,,発汗する体　カルマか咎　如何に？
Dialogue: 0,0:23:16.79,0:23:19.26,ed-jp,,0,0,1,,恒　現実は不調和な旋律さ
Dialogue: 0,0:23:19.26,0:23:22.27,ed-jp,,0,0,1,,冷血なステンレス製の心臓持つ演説者
Dialogue: 0,0:23:22.27,0:23:24.92,ed-jp,,0,0,1,,何回目の明滅　また凱旋するテンペスタ
Dialogue: 0,0:23:24.92,0:23:28.02,ed-jp,,0,0,1,,アーチかける善悪　もう応答しない生存者
Dialogue: 0,0:23:29.12,0:23:31.76,ed-jp,,0,0,0,,花のよう　咲うＭｙ　Ｒｅｄ
Dialogue: 0,0:23:31.93,0:23:40.30,ed-jp,,0,0,0,,守りたいものだって　この掌離れれば
Dialogue: 0,0:23:40.46,0:23:47.93,ed-jp,,0,0,0,,壊したいものなんて　壊せないものだけ
Dialogue: 0,0:23:49.83,0:23:55.57,ed-jp,,0,0,0,,唸る　その狂気が　花咲かすダリア
Dialogue: 0,0:23:55.57,0:23:58.29,ed-jp,,0,0,0,,振りかざす度　歪んだ定規
Dialogue: 0,0:23:58.29,0:24:01.13,ed-jp,,0,0,0,,反射する対照的な正義
Dialogue: 0,0:24:01.13,0:24:06.80,ed-jp,,0,0,0,,裏切りのゲリラ　散らす羽たちが
Dialogue: 0,0:24:06.80,0:24:09.78,ed-jp,,0,0,0,,飛ぶ鳥の蹴った地面のようさ
Dialogue: 0,0:24:09.78,0:24:14.85,ed-jp,,0,0,0,,君にもあるんでしょう？キズツケタクナイモノ
Dialogue: 0,0:23:05.03,0:23:07.98,ed-cn,,0,0,0,,怎麼了小弟弟？這裡可是戰場
Dialogue: 0,0:23:07.98,0:23:10.81,ed-cn,,0,0,0,,是憎惡翻騰的拉力賽 與成長背道而馳
Dialogue: 0,0:23:10.81,0:23:13.62,ed-cn,,0,0,0,,不知輕重 利劍殺氣騰騰
Dialogue: 0,0:23:13.62,0:23:16.79,ed-cn,,0,0,0,,汗流浹背 是業是罪 如何判定？
Dialogue: 0,0:23:16.79,0:23:19.26,ed-cn,,0,0,0,,現實永遠是不和諧旋律
Dialogue: 0,0:23:19.26,0:23:22.27,ed-cn,,0,0,0,,擁有鋼鐵心臟的冷血演講者
Dialogue: 0,0:23:22.27,0:23:24.92,ed-cn,,0,0,0,,第幾次電閃雷鳴 暴風雨再次凱旋
Dialogue: 0,0:23:24.92,0:23:28.02,ed-cn,,0,0,0,,善惡架上彩虹 生還者已無應答
Dialogue: 0,0:23:29.12,0:23:31.76,ed-cn,,0,0,0,,如花般綻放笑容 My Red
Dialogue: 0,0:23:31.93,0:23:40.30,ed-cn,,0,0,0,,想要守護之物 離開掌中便無從守護
Dialogue: 0,0:23:40.46,0:23:47.93,ed-cn,,0,0,0,,想要毀滅之物 全都是無法毀滅之物
Dialogue: 0,0:23:49.83,0:23:55.57,ed-cn,,0,0,0,,呻吟不止 瘋狂如盛開的大麗花
Dialogue: 0,0:23:55.57,0:23:58.29,ed-cn,,0,0,0,,標尺一經舉起 立刻扭曲
Dialogue: 0,0:23:58.29,0:24:01.13,ed-cn,,0,0,0,,反射出對立的正義
Dialogue: 0,0:24:01.13,0:24:06.80,ed-cn,,0,0,0,,叛逆的游擊 散落的羽翼
Dialogue: 0,0:24:06.80,0:24:09.78,ed-cn,,0,0,0,,如飛鳥蹬踏的地面一般
Dialogue: 0,0:24:09.78,0:24:14.85,ed-cn,,0,0,0,,你一定也有不願傷害之物
Dialogue: 0,0:00:03.64,0:00:08.31,Default,,0,0,0,,以上就是頭兒給你們的最後命令
Dialogue: 0,0:00:10.00,0:00:12.60,Default,,0,0,0,,明白了吧 好好幹
Dialogue: 0,0:00:12.86,0:00:14.16,Default,,0,0,0,,等一下 大叔
Dialogue: 0,0:00:15.16,0:00:17.08,Default,,0,0,0,,桓騎真是這麼說的嗎
Dialogue: 0,0:00:17.59,0:00:20.21,Default,,0,0,0,,你們的任務嗎 沒錯
Dialogue: 0,0:00:20.21,0:00:22.04,Default,,0,0,0,,不是這個
Dialogue: 0,0:00:22.64,0:00:26.30,Default,,0,0,0,,桓騎真的說了戰鬥會在今天結束嗎
Dialogue: 0,0:00:27.51,0:00:30.48,Default,,0,0,0,,對 他確實這麼說了
Dialogue: 0,0:02:01.56,0:02:04.77,biaoti,,0,0,0,,{\fad(480,480)}勝敗已決的深夜
Dialogue: 0,0:02:11.92,0:02:14.32,Default,,0,0,0,,快 快叫傳令兵
Dialogue: 0,0:02:18.29,0:02:19.73,Default,,0,0,0,,紀彗大人
Dialogue: 0,0:02:20.67,0:02:23.95,Default,,0,0,0,,請 請快來山腳 快點
Dialogue: 0,0:02:24.15,0:02:24.83,Default,,0,0,0,,山腳？
Dialogue: 0,0:02:25.15,0:02:26.21,Default,,0,0,0,,敵襲嗎
Dialogue: 0,0:02:26.62,0:02:28.55,Default,,0,0,0,,不 不是敵襲
Dialogue: 0,0:02:28.72,0:02:29.96,Default,,0,0,0,,那 那是…
Dialogue: 0,0:02:30.58,0:02:32.57,Default,,0,0,0,,不知道該怎麼形容
Dialogue: 0,0:02:34.49,0:02:36.53,Default,,0,0,0,,還 還收到了桓騎的文書
Dialogue: 0,0:02:37.48,0:02:40.04,Default,,0,0,0,,文書中說 那東西是…
Dialogue: 0,0:02:40.50,0:02:42.85,Default,,0,0,0,,是給紀彗大人的禮物
Dialogue: 0,0:02:43.33,0:02:45.39,Default,,0,0,0,,總 總之請快點去山腳
Dialogue: 0,0:02:46.55,0:02:47.23,Default,,0,0,0,,金毛
Dialogue: 0,0:02:48.89,0:02:50.56,Default,,0,0,0,,大本營暫且交給你了
Dialogue: 0,0:02:56.68,0:02:59.70,Default,,0,0,0,,喂 要出要塞嗎
Dialogue: 0,0:03:00.36,0:03:03.15,Default,,0,0,0,,沒關係 這一帶沒有桓騎兵
Dialogue: 0,0:03:03.42,0:03:06.37,Default,,0,0,0,,我們的部隊也在山下防守著大片區域
Dialogue: 0,0:03:08.12,0:03:09.75,Default,,0,0,0,,究竟是什麼東西
Dialogue: 0,0:03:16.86,0:03:17.68,Default,,0,0,0,,青公
Dialogue: 0,0:03:18.45,0:03:20.43,Default,,0,0,0,,城主 這邊走
Dialogue: 0,0:03:22.80,0:03:25.80,Default,,0,0,0,,青公老爺子居然在害怕？
Dialogue: 0,0:03:57.09,0:03:59.41,Default,,0,0,0,,這 這是什麼
Dialogue: 0,0:03:59.66,0:04:01.18,Default,,0,0,0,,簡直不是人
Dialogue: 0,0:04:01.96,0:04:06.31,Default,,0,0,0,,這簡直不是人之所為 桓騎禽獸
Dialogue: 0,0:04:08.14,0:04:10.52,Default,,0,0,0,,故意不用俘獲的士兵
Dialogue: 0,0:04:10.67,0:04:13.61,Default,,0,0,0,,而是把黑羊居民做成了這樣
Dialogue: 0,0:04:14.86,0:04:17.81,Default,,0,0,0,,桓騎是為了刺激我
Dialogue: 0,0:04:18.20,0:04:20.37,Default,,0,0,0,,而故意把平民…
Dialogue: 0,0:04:23.44,0:04:24.30,Default,,0,0,0,,城主
Dialogue: 0,0:04:24.63,0:04:28.37,Default,,0,0,0,,還有一事 這下面還放著桓騎的文書
Dialogue: 0,0:04:29.84,0:04:31.33,Default,,0,0,0,,念吧
Dialogue: 0,0:04:32.12,0:04:32.73,Default,,0,0,0,,是
Dialogue: 0,0:04:35.16,0:04:38.90,Default,,0,0,0,,「致 敬愛的名將 紀彗大人」
Dialogue: 0,0:04:40.54,0:04:44.50,Default,,0,0,0,,「你身為副將卻戰功卓越 令人敬佩」
Dialogue: 0,0:04:45.32,0:04:47.88,Default,,0,0,0,,「為讚頌英勇的紀彗大人」
Dialogue: 0,0:04:49.04,0:04:51.83,Default,,0,0,0,,「將這屍骸巨像贈送於你」
Dialogue: 0,0:04:52.62,0:04:56.28,Default,,0,0,0,,「你要細細觀賞 把它印在眼底」
Dialogue: 0,0:04:57.12,0:04:58.57,Default,,0,0,0,,「我告訴你 紀彗」
Dialogue: 0,0:04:59.41,0:05:00.82,Default,,0,0,0,,「我會在」…
Dialogue: 0,0:05:05.86,0:05:08.12,Default,,0,0,0,,「我會在」…
Dialogue: 0,0:05:08.83,0:05:12.71,Default,,0,0,0,,「我會在你的離眼城製造更甚於此的慘劇」
Dialogue: 0,0:05:12.71,0:05:14.74,Default,,0,0,0,,「好好期待吧」
Dialogue: 0,0:05:17.71,0:05:19.42,Default,,0,0,0,,什 什麼？
Dialogue: 0,0:05:20.36,0:05:21.87,Default,,0,0,0,,瞭望台的鑼聲？
Dialogue: 0,0:05:22.28,0:05:24.20,Default,,0,0,0,,急報 急報
Dialogue: 0,0:05:24.20,0:05:25.20,Default,,0,0,0,,什麼事
Dialogue: 0,0:05:25.64,0:05:28.56,Default,,0,0,0,,桓 桓騎軍開始移動了
Dialogue: 0,0:05:28.83,0:05:30.58,Default,,0,0,0,,往東南去了
Dialogue: 0,0:05:30.92,0:05:33.08,Default,,0,0,0,,往離眼城方向去了
Dialogue: 0,0:05:34.19,0:05:38.02,Default,,0,0,0,,你會怎麼辦 紀彗
Dialogue: 0,0:05:40.99,0:05:42.40,Default,,0,0,0,,要放棄山丘？
Dialogue: 0,0:05:42.98,0:05:46.22,Default,,0,0,0,,你 你知道你在說什麼嗎 紀彗
Dialogue: 0,0:05:46.63,0:05:48.91,Default,,0,0,0,,占領這座山丘 就能取得戰爭勝利
Dialogue: 0,0:05:49.32,0:05:52.54,Default,,0,0,0,,我們已經勝利在望 你卻要自毀勝利嗎
Dialogue: 0,0:05:53.12,0:05:56.54,Default,,0,0,0,,我必須去救離眼
Dialogue: 0,0:05:58.66,0:06:00.58,Default,,0,0,0,,紀彗 你冷靜一點
Dialogue: 0,0:06:00.88,0:06:04.59,Default,,0,0,0,,從戰略上看 桓騎軍攻打離眼城毫無意義
Dialogue: 0,0:06:04.92,0:06:06.78,Default,,0,0,0,,就算攻下離眼那個飛地
Dialogue: 0,0:06:06.90,0:06:09.56,Default,,0,0,0,,也只會被趙軍包圍 自取滅亡
Dialogue: 0,0:06:09.86,0:06:12.56,Default,,0,0,0,,那明顯就是引你出洞的圈套
Dialogue: 0,0:06:13.26,0:06:14.68,Default,,0,0,0,,他們肯定還藏了部隊
Dialogue: 0,0:06:14.82,0:06:18.33,Default,,0,0,0,,等著在紀彗軍離開後攻打山丘
Dialogue: 0,0:06:18.99,0:06:21.44,Default,,0,0,0,,這種事城主當然也清楚
Dialogue: 0,0:06:23.02,0:06:25.04,Default,,0,0,0,,但也必須要追
Dialogue: 0,0:06:25.14,0:06:29.82,Default,,0,0,0,,否則桓騎一定會把離眼變成血海來洩憤
Dialogue: 0,0:06:29.95,0:06:32.68,Default,,0,0,0,,而且手段會比對黑羊居民更加殘忍
Dialogue: 0,0:06:33.35,0:06:36.69,Default,,0,0,0,,此時此刻 桓騎軍也在不斷前進
Dialogue: 0,0:06:36.69,0:06:38.63,Default,,0,0,0,,快去追吧 紀彗大人
Dialogue: 0,0:06:38.87,0:06:39.66,Default,,0,0,0,,紀彗大人
Dialogue: 0,0:06:39.76,0:06:40.88,Default,,0,0,0,,紀彗大人
Dialogue: 0,0:06:41.96,0:06:42.76,Default,,0,0,0,,金毛
Dialogue: 0,0:06:43.39,0:06:44.29,Default,,0,0,0,,紀彗
Dialogue: 0,0:06:44.50,0:06:47.47,Default,,0,0,0,,你等三天…不 至少等兩天
Dialogue: 0,0:06:47.94,0:06:51.45,Default,,0,0,0,,等要塞完工 就能只靠慶舍軍守住山丘
Dialogue: 0,0:06:51.89,0:06:52.78,Default,,0,0,0,,不可能
Dialogue: 0,0:06:53.19,0:06:56.64,Default,,0,0,0,,現在的離眼跟桓騎軍交戰 連半天都撐不住
Dialogue: 0,0:06:57.48,0:06:58.73,Default,,0,0,0,,你們有完沒完
Dialogue: 0,0:06:59.33,0:07:03.44,Default,,0,0,0,,別以為你們這自私的行為能得逞
Dialogue: 0,0:07:03.99,0:07:07.61,Default,,0,0,0,,事已至此卻放棄戰鬥 我決不容許
Dialogue: 0,0:07:07.92,0:07:09.88,Default,,0,0,0,,既然你執意要走
Dialogue: 0,0:07:09.88,0:07:12.45,Default,,0,0,0,,那我就是殺了你 也要把你留住
Dialogue: 0,0:07:12.79,0:07:13.91,Default,,0,0,0,,紀彗
Dialogue: 0,0:07:15.13,0:07:18.26,Default,,0,0,0,,那我就先殺了你
Dialogue: 0,0:07:19.72,0:07:21.52,Default,,0,0,0,,你真敢說啊 混蛋
Dialogue: 0,0:07:21.52,0:07:23.11,Default,,0,0,0,,住手 岳嬰
Dialogue: 0,0:07:24.22,0:07:26.22,Default,,0,0,0,,要是此時殺了紀彗
Dialogue: 0,0:07:26.73,0:07:30.85,Default,,0,0,0,,離眼軍就將成為敢死隊 襲擊我們
Dialogue: 0,0:07:31.40,0:07:36.35,Default,,0,0,0,,對於如今的趙軍來說 這可是最糟糕的做法
Dialogue: 0,0:07:36.66,0:07:39.86,Default,,0,0,0,,如果連這都不知道 那你就重新從步兵做起吧
Dialogue: 0,0:07:41.98,0:07:43.24,Default,,0,0,0,,金毛大人…
Dialogue: 0,0:07:44.23,0:07:51.99,Default,,0,0,0,,如今我們面臨著選擇戰爭勝敗的終極抉擇
Dialogue: 0,0:07:52.38,0:07:55.81,Default,,0,0,0,,逼迫我們抉擇的 就是桓騎
Dialogue: 0,0:07:56.60,0:08:01.03,Default,,0,0,0,,而做出抉擇的自然是全軍主將
Dialogue: 0,0:08:01.53,0:08:04.48,Default,,0,0,0,,也就是如今趙軍實質上的主將
Dialogue: 0,0:08:04.90,0:08:05.92,Default,,0,0,0,,紀彗
Dialogue: 0,0:08:06.95,0:08:08.92,Default,,0,0,0,,金毛 你個混蛋
Dialogue: 0,0:08:09.89,0:08:10.72,Default,,0,0,0,,金毛…
Dialogue: 0,0:08:14.99,0:08:18.12,Default,,0,0,0,,但是最後 作為中央的武將
Dialogue: 0,0:08:18.25,0:08:21.02,Default,,0,0,0,,離眼城城主紀彗 我要告訴你一句話
Dialogue: 0,0:08:23.00,0:08:25.75,Default,,0,0,0,,我們慶舍軍不是只為離眼
Dialogue: 0,0:08:25.94,0:08:29.53,Default,,0,0,0,,而是為了保衛趙國 才來到黑羊作戰
Dialogue: 0,0:08:31.82,0:08:33.47,Default,,0,0,0,,要是黑羊失守
Dialogue: 0,0:08:33.63,0:08:38.20,Default,,0,0,0,,秦軍就會以此為據點 侵略周圍一帶
Dialogue: 0,0:08:39.02,0:08:41.37,Default,,0,0,0,,離眼只是其中一城
Dialogue: 0,0:08:41.75,0:08:47.28,Default,,0,0,0,,真到那時 不知會有多少趙國人流血喪命
Dialogue: 0,0:08:47.63,0:08:49.30,Default,,0,0,0,,根本無可估量
Dialogue: 0,0:08:50.67,0:08:53.99,Default,,0,0,0,,而當這一帶全部化為秦國領土時
Dialogue: 0,0:08:54.20,0:08:55.37,Default,,0,0,0,,自不必說
Dialogue: 0,0:08:55.64,0:09:00.58,Default,,0,0,0,,趙國將受到範圍更大 程度更深的侵略
Dialogue: 0,0:09:01.30,0:09:03.98,Default,,0,0,0,,黑羊之戰就是為了避免這種事
Dialogue: 0,0:09:04.80,0:09:08.60,Default,,0,0,0,,為了不使這種事發生 大家流血戰鬥
Dialogue: 0,0:09:08.86,0:09:11.49,Default,,0,0,0,,為保家衛國的大義而死
Dialogue: 0,0:09:14.38,0:09:17.00,Default,,0,0,0,,如果只為離眼一城就要離開戰場
Dialogue: 0,0:09:17.14,0:09:19.83,Default,,0,0,0,,那這一切都將化為烏有
Dialogue: 0,0:09:20.41,0:09:22.09,Default,,0,0,0,,只為離眼一城
Dialogue: 0,0:09:22.27,0:09:25.63,Default,,0,0,0,,趙國很可能失去西部的大片疆域
Dialogue: 0,0:09:26.19,0:09:30.32,Default,,0,0,0,,這一抉擇就是如此沉重
Dialogue: 0,0:09:30.48,0:09:33.54,Default,,0,0,0,,你要考慮清楚 紀彗
Dialogue: 0,0:09:43.39,0:09:45.56,Default,,0,0,0,,城 城主…
Dialogue: 0,0:09:53.63,0:09:54.62,Default,,0,0,0,,我…
Dialogue: 0,0:09:59.68,0:10:01.05,Default,,0,0,0,,怎麼樣 爹
Dialogue: 0,0:10:02.51,0:10:04.81,Default,,0,0,0,,做得挺好的嘛 佳德
Dialogue: 0,0:10:05.29,0:10:09.88,Default,,0,0,0,,為了讓紀彗大人平安歸來 我們做了好多呢
Dialogue: 0,0:10:10.91,0:10:12.31,Default,,0,0,0,,是嗎是嗎
Dialogue: 0,0:10:12.79,0:10:14.44,Default,,0,0,0,,喂 快看
Dialogue: 0,0:10:17.53,0:10:19.00,Default,,0,0,0,,是 是軍隊
Dialogue: 0,0:10:19.00,0:10:20.93,Default,,0,0,0,,規 規模好大
Dialogue: 0,0:10:21.20,0:10:22.59,Default,,0,0,0,,這 這不可能
Dialogue: 0,0:10:22.92,0:10:26.22,Default,,0,0,0,,紀彗大人…黑羊來過消息嗎
Dialogue: 0,0:10:26.31,0:10:27.49,Default,,0,0,0,,沒有
Dialogue: 0,0:10:27.49,0:10:29.90,Default,,0,0,0,,黑羊那邊已經兩天沒來過消息了
Dialogue: 0,0:10:32.39,0:10:35.66,Default,,0,0,0,,敵襲 敵襲 大家快進地下
Dialogue: 0,0:10:35.91,0:10:38.41,Default,,0,0,0,,是桓騎 桓騎來了
Dialogue: 0,0:10:38.41,0:10:41.00,Default,,0,0,0,,不會吧 黑羊失守了嗎
Dialogue: 0,0:10:41.11,0:10:42.90,Default,,0,0,0,,這麼說 紀彗大人他們…
Dialogue: 0,0:10:43.20,0:10:44.92,Default,,0,0,0,,輸 輸掉了嗎
Dialogue: 0,0:10:45.39,0:10:46.56,Default,,0,0,0,,紀彗大人…
Dialogue: 0,0:10:46.68,0:10:47.88,Default,,0,0,0,,紀彗大人
Dialogue: 0,0:10:47.88,0:10:49.46,Default,,0,0,0,,快去地下
Dialogue: 0,0:10:49.70,0:10:52.21,Default,,0,0,0,,桓騎軍已經近在眼前了
Dialogue: 0,0:10:52.50,0:10:55.25,Default,,0,0,0,,你幹什麼 佳德 快下去
Dialogue: 0,0:10:55.50,0:10:56.96,Default,,0,0,0,,和你奶奶到地下去
Dialogue: 0,0:10:57.85,0:10:58.84,Default,,0,0,0,,爹
Dialogue: 0,0:11:14.16,0:11:16.66,Default,,0,0,0,,紀彗大人
Dialogue: 0,0:11:17.55,0:11:19.99,Default,,0,0,0,,紀彗大人 恭賀您凱旋
Dialogue: 0,0:11:23.38,0:11:25.12,Default,,0,0,0,,召集家臣
Dialogue: 0,0:11:26.49,0:11:30.14,Default,,0,0,0,,我們必須準備離開離眼
Dialogue: 0,0:11:37.04,0:11:39.44,Default,,0,0,0,,時間回到兩天前
Dialogue: 0,0:11:40.55,0:11:45.19,Default,,0,0,0,,桓騎那傢伙 他真的說要僅憑我們攻下山丘嗎
Dialogue: 0,0:11:45.56,0:11:47.40,Default,,0,0,0,,不只飛信隊
Dialogue: 0,0:11:47.83,0:11:51.42,Default,,0,0,0,,據傳令兵說 還有其他桓騎兵埋伏在此
Dialogue: 0,0:11:51.83,0:11:54.32,Default,,0,0,0,,那也沒多少人吧
Dialogue: 0,0:11:54.63,0:11:57.43,Default,,0,0,0,,桓騎軍的大半都離開了黑羊
Dialogue: 0,0:11:57.56,0:11:59.16,Default,,0,0,0,,信大人 小聲點
Dialogue: 0,0:11:59.92,0:12:00.82,Default,,0,0,0,,再說了
Dialogue: 0,0:12:01.03,0:12:07.99,Default,,0,0,0,,占據山丘的趙軍 怎麼可能特地下來追他們啊
Dialogue: 0,0:12:08.17,0:12:09.20,Default,,0,0,0,,就是
Dialogue: 0,0:12:09.41,0:12:12.14,Default,,0,0,0,,正常想想 這種蠢事…
Dialogue: 0,0:12:13.08,0:12:15.92,Default,,0,0,0,,信大人 趙軍正在下山
Dialogue: 0,0:12:17.39,0:12:18.55,Default,,0,0,0,,不 不是吧
Dialogue: 0,0:12:19.09,0:12:21.12,Default,,0,0,0,,他們…為什麼…
Dialogue: 0,0:12:23.58,0:12:25.46,Default,,0,0,0,,好啊
Dialogue: 0,0:12:28.41,0:12:32.06,Default,,0,0,0,,我不會讓離眼發生你所擔心的事
Dialogue: 0,0:12:35.19,0:12:40.34,Default,,0,0,0,,此時 占據守丘趙軍一半的紀彗軍
Dialogue: 0,0:12:40.34,0:12:43.24,Default,,0,0,0,,奔下山丘 朝遠處離去
Dialogue: 0,0:12:44.22,0:12:46.87,Default,,0,0,0,,全速前進 追趕桓騎
Dialogue: 0,0:12:46.87,0:12:47.78,Default,,0,0,0,,是
Dialogue: 0,0:12:47.99,0:12:48.78,Default,,0,0,0,,另一方面
Dialogue: 0,0:12:49.01,0:12:52.50,Default,,0,0,0,,金毛和岳嬰率領的慶舍軍留在山丘上
Dialogue: 0,0:12:52.66,0:12:55.13,Default,,0,0,0,,擺出了死守到底的架勢
Dialogue: 0,0:12:59.16,0:13:01.46,Default,,0,0,0,,垃圾去死
Dialogue: 0,0:13:10.80,0:13:14.11,Default,,0,0,0,,信 敵軍在陸續下山了
Dialogue: 0,0:13:14.61,0:13:16.11,Default,,0,0,0,,這邊也是 隊長
Dialogue: 0,0:13:16.41,0:13:19.11,Default,,0,0,0,,信大人 這意味著我們…
Dialogue: 0,0:13:22.39,0:13:23.13,Default,,0,0,0,,嗯
Dialogue: 0,0:13:24.03,0:13:25.62,Default,,0,0,0,,岳嬰 快走吧
Dialogue: 0,0:13:25.62,0:13:27.87,Default,,0,0,0,,你先走 我隨後就來
Dialogue: 0,0:13:28.15,0:13:28.84,Default,,0,0,0,,不行
Dialogue: 0,0:13:28.84,0:13:31.33,Default,,0,0,0,,要是死在這裡 只會落個敗將之名
Dialogue: 0,0:13:33.83,0:13:36.34,Default,,0,0,0,,要活下去為慶舍大人報仇
Dialogue: 0,0:13:37.20,0:13:39.72,Default,,0,0,0,,很遺憾 到此為止了
Dialogue: 0,0:13:40.68,0:13:42.72,Default,,0,0,0,,撤離黑羊
Dialogue: 0,0:13:43.37,0:13:47.13,Default,,0,0,0,,第五天日暮時分 趙軍 全軍撤退
Dialogue: 0,0:13:47.72,0:13:52.65,Default,,0,0,0,,至此 秦軍取得了黑羊丘之戰的勝利
Dialogue: 0,0:13:54.08,0:13:58.33,Default,,0,0,0,,而桓騎在確定紀彗軍追來之後
Dialogue: 0,0:13:58.33,0:14:00.48,Default,,0,0,0,,等他們足夠接近後分散部隊
Dialogue: 0,0:14:00.48,0:14:02.40,Default,,0,0,0,,朝多個方向逃離
Dialogue: 0,0:14:04.15,0:14:04.87,Default,,0,0,0,,最後
Dialogue: 0,0:14:05.64,0:14:08.94,Default,,0,0,0,,返回已被桓騎軍占領的中央丘
Dialogue: 0,0:14:10.80,0:14:13.28,Default,,0,0,0,,不緊不慢地登上了丘頂
Dialogue: 0,0:14:27.75,0:14:30.21,Default,,0,0,0,,又不知從哪兒帶來了女人
Dialogue: 0,0:14:30.52,0:14:32.08,Default,,0,0,0,,壓倒性勝利？
Dialogue: 0,0:14:32.25,0:14:32.75,Default,,0,0,0,,嗯
Dialogue: 0,0:14:33.97,0:14:38.92,Default,,0,0,0,,在那貴他們的協助下 我基本掌握了戰局全貌
Dialogue: 0,0:14:39.52,0:14:42.76,Default,,0,0,0,,然後發現 桓騎確實是非同小可
Dialogue: 0,0:14:44.53,0:14:47.28,Default,,0,0,0,,我們昨天正打算擊殺慶舍的時候
Dialogue: 0,0:14:47.84,0:14:51.96,Default,,0,0,0,,桓騎就已經將目標從慶舍轉移到了紀彗身上
Dialogue: 0,0:14:55.75,0:14:59.17,Default,,0,0,0,,於是 他叫來特別的拷問專家
Dialogue: 0,0:14:59.89,0:15:03.56,Default,,0,0,0,,從俘獲的離眼兵口中 問出了紀彗的所有經歷
Dialogue: 0,0:15:04.43,0:15:09.99,Default,,0,0,0,,然後他突然停下兩軍持續了四天的奪丘大戰
Dialogue: 0,0:15:10.26,0:15:14.00,Default,,0,0,0,,把所有部隊撤下山丘 把山丘送給了趙軍
Dialogue: 0,0:15:16.00,0:15:19.86,Default,,0,0,0,,他一邊讓趙軍修築要塞
Dialogue: 0,0:15:20.47,0:15:23.10,Default,,0,0,0,,一邊在黑羊燒村
Dialogue: 0,0:15:24.36,0:15:26.53,Default,,0,0,0,,把平民的屍體收集了起來
Dialogue: 0,0:15:27.43,0:15:30.20,Default,,0,0,0,,再把這些屍體給紀彗看
Dialogue: 0,0:15:31.09,0:15:33.43,Default,,0,0,0,,威脅他說「離眼也會落得這個下場」
Dialogue: 0,0:15:35.80,0:15:39.86,Default,,0,0,0,,因此紀彗捨棄山丘 前去搭救離眼
Dialogue: 0,0:15:41.30,0:15:42.79,Default,,0,0,0,,導致趙軍落敗
Dialogue: 0,0:15:43.59,0:15:45.09,Default,,0,0,0,,這 這麼說
Dialogue: 0,0:15:45.09,0:15:48.72,Default,,0,0,0,,從結果上來說 是燒村幫助秦軍取勝…
Dialogue: 0,0:15:49.50,0:15:50.64,Default,,0,0,0,,{\pos(560,1067)}好痛
Dialogue: 0,0:15:49.98,0:15:50.64,Default,,0,0,0,,{\pos(1264,1067)}昂
Dialogue: 0,0:15:50.93,0:15:52.20,Default,,0,0,0,,昂說得沒錯
Dialogue: 0,0:15:53.53,0:15:55.03,Default,,0,0,0,,就是靠燒村贏的
Dialogue: 0,0:15:57.60,0:15:59.98,Default,,0,0,0,,戰鬥第四天 大局定會有變
Dialogue: 0,0:16:00.44,0:16:04.99,Default,,0,0,0,,換成軍略家 一定會苦思攻占山丘之法
Dialogue: 0,0:16:05.61,0:16:10.35,Default,,0,0,0,,而桓騎卻拋開山丘 轉而攻略紀彗這個人
Dialogue: 0,0:16:11.82,0:16:15.28,Default,,0,0,0,,最後 他以村民的屍體為必殺武器
Dialogue: 0,0:16:15.40,0:16:18.85,Default,,0,0,0,,刺中紀彗的弱點 迫使他離開山丘
Dialogue: 0,0:16:18.85,0:16:21.25,Default,,0,0,0,,取得了黑羊之戰的勝利
Dialogue: 0,0:16:22.18,0:16:25.20,Default,,0,0,0,,這不是軍略也不是戰術
Dialogue: 0,0:16:26.57,0:16:27.88,Default,,0,0,0,,這種取勝方式…
Dialogue: 0,0:16:29.32,0:16:33.54,Default,,0,0,0,,就算是昌平君和李牧 也絕不可能模仿
Dialogue: 0,0:16:35.41,0:16:37.14,Default,,0,0,0,,但正因無法模仿
Dialogue: 0,0:16:37.14,0:16:39.72,Default,,0,0,0,,所以這種壓倒性勝利 也只有頭兒才能實現
Dialogue: 0,0:16:41.26,0:16:44.40,Default,,0,0,0,,奪取山丘後將其建為要塞也是難題
Dialogue: 0,0:16:44.62,0:16:49.79,Default,,0,0,0,,而頭兒迫使趙軍修建要塞 在近乎完工時一舉奪得
Dialogue: 0,0:16:51.52,0:16:53.15,Default,,0,0,0,,最重要的是數量
Dialogue: 0,0:16:53.62,0:16:57.16,Default,,0,0,0,,桓騎中止了純屬消耗戰的奪丘大戰
Dialogue: 0,0:16:57.25,0:16:59.95,Default,,0,0,0,,所以陣亡人數…
Dialogue: 0,0:17:00.54,0:17:02.14,Default,,0,0,0,,不到戰前預估的一半
Dialogue: 0,0:17:02.67,0:17:03.94,Default,,0,0,0,,不到一半？
Dialogue: 0,0:17:04.62,0:17:09.81,Default,,0,0,0,,只看結果的話 他的戰果要遠超大軍略家
Dialogue: 0,0:17:10.94,0:17:12.03,Default,,0,0,0,,等一下
Dialogue: 0,0:17:12.28,0:17:16.13,Default,,0,0,0,,那個只會亂來的混蛋居然比李牧還厲害？
Dialogue: 0,0:17:18.34,0:17:20.95,Default,,0,0,0,,不可能吧 他到底…
Dialogue: 0,0:17:22.50,0:17:25.07,Default,,0,0,0,,他到底是何方神聖
Dialogue: 0,0:17:28.84,0:17:31.03,Default,,0,0,0,,頭兒身上謎團重重
Dialogue: 0,0:17:32.57,0:17:38.10,Default,,0,0,0,,為什麼那麼強 有沒有親屬 又是從哪裡來
Dialogue: 0,0:17:38.43,0:17:40.65,Default,,0,0,0,,就連雷土他們幹部都不知道
Dialogue: 0,0:17:42.22,0:17:42.92,Default,,0,0,0,,頭兒呢
Dialogue: 0,0:17:43.99,0:17:46.25,Default,,0,0,0,,但是有一次
Dialogue: 0,0:17:46.74,0:17:52.30,Default,,0,0,0,,我聽資歷最老的人說起過頭兒的「根」
Dialogue: 0,0:17:53.00,0:17:55.03,Default,,0,0,0,,桓騎的根？
Dialogue: 0,0:17:55.38,0:17:56.38,Default,,0,0,0,,對
Dialogue: 0,0:17:56.51,0:18:01.17,Default,,0,0,0,,那個冷酷無情 戰無不勝的天才
Dialogue: 0,0:18:01.77,0:18:04.10,Default,,0,0,0,,他最為核心的根部到底有什麼
Dialogue: 0,0:18:05.79,0:18:07.73,Default,,0,0,0,,我這麼問道 然後那人說
Dialogue: 0,0:18:09.51,0:18:10.56,Default,,0,0,0,,「憤怒」
Dialogue: 0,0:18:11.38,0:18:15.87,Default,,0,0,0,,桓騎的根是能熔化岩石的憤怒
Dialogue: 0,0:18:17.11,0:18:17.92,Default,,0,0,0,,憤怒？
Dialogue: 0,0:18:18.96,0:18:21.72,Default,,0,0,0,,是對什麼的憤怒
Dialogue: 0,0:18:25.29,0:18:27.13,Default,,0,0,0,,對「一切」
Dialogue: 0,0:18:29.89,0:18:31.13,Default,,0,0,0,,等一下
Dialogue: 0,0:18:31.73,0:18:35.30,Default,,0,0,0,,只靠飛信隊把西邊一座山丘建成要塞 也太難為人了
Dialogue: 0,0:18:35.44,0:18:39.05,Default,,0,0,0,,而且還要我們在黑羊外圍巡邏
Dialogue: 0,0:18:39.05,0:18:40.14,Default,,0,0,0,,開什麼玩笑
Dialogue: 0,0:18:40.43,0:18:44.39,Default,,0,0,0,,但是 你們的八千人還剩五千吧
Dialogue: 0,0:18:44.68,0:18:46.39,Default,,0,0,0,,幾乎都是重傷員
Dialogue: 0,0:18:46.72,0:18:50.03,Default,,0,0,0,,我們在被慶舍主力突襲的時候 傷亡慘重
Dialogue: 0,0:18:50.12,0:18:52.86,Default,,0,0,0,,那還不是因為你們太蠢
Dialogue: 0,0:18:53.06,0:18:56.41,Default,,0,0,0,,你們不會像頭兒那樣用這裡打仗
Dialogue: 0,0:18:56.41,0:18:59.48,Default,,0,0,0,,才會蠢兮兮地死傷那麼多人 蠢貨
Dialogue: 0,0:18:59.48,0:19:01.28,Default,,0,0,0,,不許瞎說 那是…
Dialogue: 0,0:19:01.28,0:19:02.32,Default,,0,0,0,,別說了 貂
Dialogue: 0,0:19:02.83,0:19:05.73,Default,,0,0,0,,任務我已經清楚了 沒事了吧
Dialogue: 0,0:19:05.81,0:19:06.54,Default,,0,0,0,,信
Dialogue: 0,0:19:08.95,0:19:11.93,Default,,0,0,0,,請千萬不要偷懶
Dialogue: 0,0:19:12.42,0:19:15.93,Default,,0,0,0,,畢竟負責監視的那貴已經回我們這邊了
Dialogue: 0,0:19:18.82,0:19:20.30,Default,,0,0,0,,桓騎在做什麼
Dialogue: 0,0:19:20.89,0:19:22.68,Default,,0,0,0,,那之後都沒露過面
Dialogue: 0,0:19:23.52,0:19:27.08,Default,,0,0,0,,頭兒憑什麼要在你面前露面啊
Dialogue: 0,0:19:27.08,0:19:30.72,Default,,0,0,0,,不必擔心 他在上面爽著呢
Dialogue: 0,0:19:31.19,0:19:33.42,Default,,0,0,0,,別得意忘形 前奴僕
Dialogue: 0,0:19:33.85,0:19:37.81,Default,,0,0,0,,頭兒打一開始就沒把你放在眼裡
Dialogue: 0,0:19:38.41,0:19:40.46,Default,,0,0,0,,今後也一輩子不會
Dialogue: 0,0:19:47.58,0:19:48.80,Default,,0,0,0,,你悶悶不樂啊
Dialogue: 0,0:19:52.28,0:19:53.09,Default,,0,0,0,,羌瘣
Dialogue: 0,0:19:53.59,0:19:54.88,Default,,0,0,0,,在哪兒集合
Dialogue: 0,0:19:54.88,0:19:56.01,Default,,0,0,0,,這裡啊
Dialogue: 0,0:19:58.90,0:20:03.06,Default,,0,0,0,,他確實給我們看到了 他所謂大人的戰法
Dialogue: 0,0:20:03.93,0:20:04.55,Default,,0,0,0,,嗯
Dialogue: 0,0:20:05.12,0:20:06.76,Default,,0,0,0,,雖然做法下三濫
Dialogue: 0,0:20:07.07,0:20:10.09,Default,,0,0,0,,但我們還是必須正視結果
Dialogue: 0,0:20:10.55,0:20:14.97,Default,,0,0,0,,畢竟今後可能還會和桓騎一起戰鬥
Dialogue: 0,0:20:17.25,0:20:21.20,Default,,0,0,0,,雖說他很強 但有些事還是必須制止
Dialogue: 0,0:20:21.51,0:20:22.42,Default,,0,0,0,,那是當然
Dialogue: 0,0:20:23.00,0:20:25.99,Default,,0,0,0,,但要想制止他 就必須爬得比他更高
Dialogue: 0,0:20:27.37,0:20:29.83,Default,,0,0,0,,我要在桓騎之前成為大將軍
Dialogue: 0,0:20:32.14,0:20:33.71,Default,,0,0,0,,在他之前很難
Dialogue: 0,0:20:36.20,0:20:38.84,Default,,0,0,0,,但只要和他同級 就足夠制止他了
Dialogue: 0,0:20:39.36,0:20:41.00,Default,,0,0,0,,沒什麼好煩惱的 信
Dialogue: 0,0:20:41.43,0:20:43.31,Default,,0,0,0,,你就照著對尾平說的那樣
Dialogue: 0,0:20:45.17,0:20:48.96,Default,,0,0,0,,用你自己的方式 成為威震天下的大將軍
Dialogue: 0,0:20:53.49,0:20:55.48,Default,,0,0,0,,嗯 我知道
Dialogue: 0,0:20:56.66,0:21:00.58,Default,,0,0,0,,桓騎 雖然我不知道你的想法
Dialogue: 0,0:21:01.35,0:21:02.54,Default,,0,0,0,,但是我絕對…
Dialogue: 0,0:21:03.76,0:21:05.95,Default,,0,0,0,,不會輸給你
Dialogue: 0,0:21:08.38,0:21:09.17,Default,,0,0,0,,羌瘣
Dialogue: 0,0:21:09.26,0:21:11.24,Default,,0,0,0,,給我來一拳鼓鼓勁…
Dialogue: 0,0:21:11.36,0:21:14.26,Default,,0,0,0,,等等 好快 還是用手掌吧
Dialogue: 0,0:21:19.07,0:21:24.83,Default,,0,0,0,,黑羊之戰 使桓騎的強大和恐怖 傳遍了中華大地
Dialogue: 0,0:21:26.38,0:21:27.98,Default,,0,0,0,,而飛信隊
Dialogue: 0,0:21:28.09,0:21:33.67,Default,,0,0,0,,反叛主將桓騎之過 與擊殺慶舍之功相抵 無賞無罰
Dialogue: 0,0:21:33.87,0:21:34.37,Default,,0,0,0,,但是
Dialogue: 0,0:21:34.66,0:21:41.21,Default,,0,0,0,,隊員知曉信的真心後 隊伍更加團結了
Dialogue: 0,0:21:42.12,0:21:45.70,Default,,0,0,0,,也有人因此而被打動
Dialogue: 0,0:21:46.52,0:21:48.08,Default,,0,0,0,,你說什麼？
Dialogue: 0,0:21:48.47,0:21:51.28,Default,,0,0,0,,你再說一遍 那貴
Dialogue: 0,0:21:51.56,0:21:53.83,Default,,0,0,0,,沒什麼好大驚小怪的
Dialogue: 0,0:21:54.59,0:21:57.38,Default,,0,0,0,,我只是說 我要轉到飛信隊去
Dialogue: 0,0:21:58.86,0:22:02.26,Default,,0,0,0,,你想被開膛破肚嗎 混蛋
Dialogue: 0,0:22:02.69,0:22:04.59,Default,,0,0,0,,別激動 雷土
Dialogue: 0,0:22:05.21,0:22:07.26,Default,,0,0,0,,我們是軍亦非軍
Dialogue: 0,0:22:07.72,0:22:11.72,Default,,0,0,0,,桓騎軍的優點 不就是沒有死板的條條框框嗎
Dialogue: 0,0:22:12.66,0:22:14.92,Default,,0,0,0,,沒問題吧 頭兒
Dialogue: 0,0:22:16.97,0:22:19.40,Default,,0,0,0,,至少告訴我理由 那貴
Dialogue: 0,0:22:19.91,0:22:22.87,Default,,0,0,0,,就是我常有的性情使然
Dialogue: 0,0:22:24.21,0:22:27.41,Default,,0,0,0,,非要說理由的話 那就是…
Dialogue: 0,0:22:28.02,0:22:31.66,Default,,0,0,0,,那邊的飯吃著還挺香
Dialogue: 0,0:22:37.78,0:22:39.17,Default,,0,0,0,,別想走
Dialogue: 0,0:22:39.48,0:22:41.09,Default,,0,0,0,,宰了他
Dialogue: 0,0:22:44.20,0:22:47.73,Default,,0,0,0,,是 是那貴 還帶了好多人
Dialogue: 0,0:22:48.22,0:22:49.89,Default,,0,0,0,,怎麼都帶著傷
Dialogue: 0,0:24:29.54,0:24:31.12,Default,,0,0,0,,都是我的錯
Dialogue: 0,0:24:31.94,0:24:34.31,Default,,0,0,0,,我低估了桓騎的實力
Dialogue: 0,0:24:35.24,0:24:37.49,Default,,0,0,0,,我在此對慶舍發誓
Dialogue: 0,0:24:39.76,0:24:42.34,Default,,0,0,0,,我定會親手為你報仇
Dialogue: 0,0:24:49.88,0:24:51.50,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:51.92,0:24:53.51,Default,,0,0,0,,「蔡澤的信念」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:01.39,0:01:03.81,Layzner,David,0,0,0,,我们才不要你来保护我们呢
Dialogue: 0,0:01:03.94,0:01:06.31,Layzner,Simone,0,0,0,,在你们的星球都不会打架吗
Dialogue: 0,0:01:06.31,0:01:08.96,Layzner,Man,0,0,0,,他想把我们都杀了
Dialogue: 0,0:01:49.79,0:01:52.80,Layzner,Eiji,0,0,0,,我留在这里把敌人引开
Dialogue: 0,0:01:53.12,0:01:55.23,Layzner,Eiji,0,0,0,,你们能走多远走多远
Dialogue: 0,0:02:00.66,0:02:02.35,Layzner,Anna,0,0,0,,他被杀了吗
Dialogue: 0,0:02:02.78,0:02:07.17,Layzner,Anna,0,0,0,,当我看到敌人的身影时 胸口感觉好像要裂开了
Dialogue: 0,0:02:07.42,0:02:12.39,Layzner,Title,0,0,0,,第五话 即使被保护 但又...
Dialogue: 0,0:02:20.53,0:02:21.72,Layzner,?,0,0,0,,敌人从左后方来了
Dialogue: 0,0:02:21.72,0:02:22.54,Layzner,Man,0,0,0,,什么
Dialogue: 0,0:02:22.68,0:02:24.15,Layzner,?,0,0,0,,被发现了 快点
Dialogue: 0,0:02:24.15,0:02:24.77,Layzner,?,0,0,0,,了解
Dialogue: 0,0:02:34.85,0:02:36.47,Layzner,Elizabeth,0,0,0,,安娜 快坐下来
Dialogue: 0,0:02:36.77,0:02:38.67,Layzner,Elizabeth,0,0,0,,很危险 找个东西抓好
Dialogue: 0,0:02:49.59,0:02:50.41,Layzner,Rick,0,0,0,,要来了...
Dialogue: 0,0:02:50.63,0:02:51.58,Layzner,Rick,0,0,0,,要来了...
Dialogue: 0,0:02:51.86,0:02:52.92,Layzner,Rick,0,0,0,,要来了...
Dialogue: 0,0:02:53.23,0:02:53.93,Layzner,Rick,0,0,0,,来了
Dialogue: 0,0:03:09.96,0:03:12.38,Layzner,Man2,0,0,0,,比尔 我们留下来 你们先走
Dialogue: 0,0:03:12.38,0:03:13.81,Layzner,Rick,0,0,0,,对不起 拜托你了
Dialogue: 0,0:03:32.48,0:03:35.27,Layzner,Man2,0,0,0,,好 过来这里 来我这里
Dialogue: 0,0:03:56.25,0:03:57.36,Layzner,Man3,0,0,0,,没路了
Dialogue: 0,0:03:57.36,0:03:58.40,Layzner,Man2,0,0,0,,快点回转
Dialogue: 0,0:04:13.04,0:04:14.09,Layzner,Man3,0,0,0,,冲过去
Dialogue: 0,2:02:02.50,2:02:07.50,Layzner,,0,0,0,,SPT LZ-00X\NLayzner
Dialogue: 0,0:04:23.94,0:04:25.30,Layzner,Woman,0,0,0,,看 是那孩子
Dialogue: 0,0:04:25.50,0:04:27.40,Layzner,Woman,0,0,0,,那孩子又来救我们了
Dialogue: 0,0:04:38.43,0:04:39.59,Layzner,Rei,0,0,0,,危险讯号
Dialogue: 0,0:04:39.59,0:04:40.77,Layzner,Rei,0,0,0,,敌人由后方追击过来了
Dialogue: 0,0:04:45.92,0:04:47.85,Layzner,Gosterro,0,0,0,,小鬼 不会再让你逃走了
Dialogue: 0,0:05:09.83,0:05:11.43,Layzner,Eiji,0,0,0,,腿部导弹 准备发射
Dialogue: 0,0:05:11.69,0:05:13.15,Layzner,Rei,0,0,0,,瞄准仪打开
Dialogue: 0,0:05:15.03,0:05:16.83,Layzner,Eiji,0,0,0,,后方方位12处
Dialogue: 0,0:05:16.93,0:05:17.72,Layzner,Rei,0,0,0,,Ready.
Dialogue: 0,0:05:20.72,0:05:22.70,Layzner,Gosterro,0,0,0,,小鬼 你应该再瞄准一点的
Dialogue: 0,0:05:23.86,0:05:24.60,Layzner,Eiji,0,0,0,,发射
Dialogue: 0,0:05:40.54,0:05:43.49,Layzner,Gosterro,0,0,0,,多米利亚 知道对方的位置了吗
Dialogue: 0,0:05:43.49,0:05:45.95,Layzner,Roberia,0,0,0,,不 现在无法进行搜索
Dialogue: 0,0:05:46.26,0:05:48.35,Layzner,Gosterro,0,0,0,,你以为你逃得掉吗
Dialogue: 0,0:05:49.04,0:05:50.75,Layzner,Gosterro,0,0,0,,换成红外线搜索
Dialogue: 0,0:05:50.75,0:05:51.35,Layzner,Com,0,0,0,,Ready.
Dialogue: 0,0:06:27.36,0:06:31.45,Layzner,Man,0,0,0,,只要这暴风不停 我们应该不会被发现
Dialogue: 0,0:06:31.65,0:06:33.60,Layzner,Man2,0,0,0,,真是千钧一发
Dialogue: 0,0:06:34.20,0:06:36.00,Layzner,Roanne,0,0,0,,这里是观测基地吗
Dialogue: 0,0:06:36.00,0:06:37.79,Layzner,Elizabeth,0,0,0,,对 是美国基地
Dialogue: 0,0:06:38.80,0:06:40.70,Layzner,Elizabeth,0,0,0,,看起来好像没事
Dialogue: 0,0:06:41.46,0:06:43.60,Layzner,Woman,0,0,0,,这里不知道能不能跟外界联络
Dialogue: 0,0:06:43.94,0:06:45.65,Layzner,Man,0,0,0,,基地离这里很近
Dialogue: 0,0:06:46.15,0:06:47.96,Layzner,Man,0,0,0,,所以就算有干扰电波
Dialogue: 0,0:06:48.41,0:06:50.15,Layzner,Rick,0,0,0,,试试看吧 知道了
Dialogue: 0,0:06:51.09,0:06:54.17,Layzner,Rick,0,0,0,,不好意思 你们能找一下吃的东西吗
Dialogue: 0,0:06:54.53,0:06:56.76,Layzner,Rick,0,0,0,,这里应该有备用食物
Dialogue: 0,0:06:57.00,0:06:58.56,Layzner,Rick,0,0,0,,你们也饿了吧
Dialogue: 0,0:06:59.85,0:07:01.32,Layzner,Arthur,0,0,0,,喂 我们走吧
Dialogue: 0,0:07:16.04,0:07:16.96,Layzner,Eiji,0,0,0,,分析模式
Dialogue: 0,0:07:17.01,0:07:19.28,Layzner,Eiji,0,0,0,,暴风的动向预测 显示影像
Dialogue: 0,0:07:19.33,0:07:20.71,Layzner,Eiji,0,0,0,,还有敌人的行踪
Dialogue: 0,0:07:20.71,0:07:21.43,Layzner,Rei,0,0,0,,Ready.
Dialogue: 0,0:07:22.14,0:07:24.66,Layzner,Eiji,0,0,0,,我不认为那两架SPT会这样就撤退
Dialogue: 0,0:07:50.76,0:07:52.55,Layzner,Roberia,0,0,0,,队长 嘉斯坦呢
Dialogue: 0,0:07:53.16,0:07:54.04,Layzner,Roberia,0,0,0,,难不成
Dialogue: 0,0:07:54.79,0:07:57.27,Layzner,Gosterro,0,0,0,,在这暴风里真勉强啊
Dialogue: 0,0:07:57.95,0:07:59.39,Layzner,Gosterro,0,0,0,,休息一下好了
Dialogue: 0,0:07:59.39,0:08:00.14,Layzner,Roberia,0,0,0,,队长
Dialogue: 0,0:08:01.09,0:08:02.34,Layzner,Gosterro,0,0,0,,被杀了
Dialogue: 0,0:08:02.82,0:08:04.06,Layzner,Roberia,0,0,0,,被杀了
Dialogue: 0,0:08:05.17,0:08:06.43,Layzner,Roberia,0,0,0,,你说他被杀了
Dialogue: 0,0:08:06.54,0:08:09.09,Layzner,Gosterro,0,0,0,,是 被那小鬼杀了
Dialogue: 0,0:08:09.17,0:08:13.17,Layzner,Gosterro,0,0,0,,如你所说嘉斯坦被那小鬼干掉了
Dialogue: 0,0:08:16.58,0:08:18.70,Layzner,Gosterro,0,0,0,,喂 你有没有在听啊
Dialogue: 0,0:08:19.36,0:08:20.30,Layzner,Roberia,0,0,0,,我在听
Dialogue: 0,0:08:21.45,0:08:24.89,Layzner,Gosterro,0,0,0,,我记得他跟你是同一训练营的吧
Dialogue: 0,0:08:25.92,0:08:27.46,Layzner,Roberia,0,0,0,,我们还是同一地方出身的
Dialogue: 0,0:08:27.85,0:08:29.83,Layzner,Gosterro,0,0,0,,真是太惨了
Dialogue: 0,0:08:30.13,0:08:32.23,Layzner,Gosterro,0,0,0,,帮嘉斯坦报仇吧
Dialogue: 0,0:08:32.37,0:08:35.14,Layzner,Gosterro,0,0,0,,这一战还要一并帮嘉斯坦报仇
Dialogue: 0,0:08:35.96,0:08:40.25,Layzner,Gosterro,0,0,0,,不要再问我作战计划 把通信回路调至05303频道
Dialogue: 0,0:08:40.25,0:08:40.88,Layzner,Roberia,0,0,0,,是
Dialogue: 0,0:08:41.41,0:08:44.37,Layzner,Gosterro,0,0,0,,一定要彻底的干掉敌人
Dialogue: 0,0:08:44.57,0:08:46.07,Layzner,Gosterro,0,0,0,,等着瞧吧
Dialogue: 0,0:08:48.94,0:08:49.86,Layzner,Man,0,0,0,,USA!
Dialogue: 0,0:08:50.18,0:08:51.46,Layzner,Man,0,0,0,,USA火星基地
Dialogue: 0,0:08:51.96,0:08:53.64,Layzner,Man,0,0,0,,我们是联合国基地的工作人员
Dialogue: 0,0:08:54.41,0:08:55.26,Layzner,Man,0,0,0,,USA!
Dialogue: 0,0:08:57.50,0:08:58.36,Layzner,Man,0,0,0,,USA!
Dialogue: 0,0:08:58.86,0:09:00.17,Layzner,Man,0,0,0,,USA火星基地
Dialogue: 0,0:09:00.36,0:09:02.22,Layzner,,0,0,0,,我们是联合国基地的工作人员
Dialogue: 0,0:09:03.22,0:09:07.48,Layzner,Man2,0,0,0,,果然他们也是在战斗中
Dialogue: 0,0:09:08.32,0:09:10.85,Layzner,Man2,0,0,0,,干扰电波真强烈
Dialogue: 0,0:09:11.23,0:09:12.15,Layzner,Man3,0,0,0,,跟谁在战斗
Dialogue: 0,0:09:12.42,0:09:13.39,Layzner,Man2,0,0,0,,跟谁
Dialogue: 0,0:09:14.99,0:09:20.89,Layzner,Woman,0,0,0,,如果同叫英二的少年所说的 跟地球外的生命体作战还是苏联军
Dialogue: 0,0:09:20.99,0:09:22.38,Layzner,Man2,0,0,0,,喂 别说了
Dialogue: 0,0:09:22.38,0:09:26.09,Layzner,Man2,0,0,0,,你不会真的相信那小孩说的吧
Dialogue: 0,0:09:26.19,0:09:27.89,Layzner,Woman2,0,0,0,,我们也不想相信
Dialogue: 0,0:09:28.25,0:09:30.88,Layzner,Woman2,0,0,0,,但冷静地想想最近发生的事
Dialogue: 0,0:09:32.48,0:09:34.97,Layzner,Woman2,0,0,0,,就不觉得那少年只是说说而已了
Dialogue: 0,0:09:34.97,0:09:37.22,Layzner,Man2,0,0,0,,我们来到这火星多少年了
Dialogue: 0,0:09:38.46,0:09:43.08,Layzner,Man2,0,0,0,,在这期间有跟地球外生命体接触过吗
Dialogue: 0,0:09:43.35,0:09:44.98,Layzner,Man2,0,0,0,,还是有谁观测到过吗
Dialogue: 0,0:09:45.62,0:09:46.65,Layzner,Man2,0,0,0,,一次都没有
Dialogue: 0,0:09:46.75,0:09:48.45,Layzner,Woman,0,0,0,,那我们遇到的事呢
Dialogue: 0,0:09:48.80,0:09:53.19,Layzner,Woman,0,0,0,,来追我们的机器人 还有不断发生的战斗你怎么说
Dialogue: 0,0:09:53.29,0:09:54.63,Layzner,Man,0,0,0,,就跟比尔一样
Dialogue: 0,0:09:54.99,0:10:00.50,Layzner,Man,0,0,0,,我们不小心被卷入某国开发秘密武器事件中了
Dialogue: 0,0:10:00.80,0:10:02.78,Layzner,Man,0,0,0,,那孩子是来监视我们的
Dialogue: 0,0:10:02.78,0:10:05.77,Layzner,Bill,0,0,0,,不 让我来纠正一下你
Dialogue: 0,0:10:07.31,0:10:08.87,Layzner,Bill,0,0,0,,他跟弗兰斯一样
Dialogue: 0,0:10:08.87,0:10:12.30,Layzner,Bill,0,0,0,,虽然我也不想相信可是现在我却开始相信了
Dialogue: 0,0:10:15.02,0:10:17.04,Layzner,Man,0,0,0,,医生 你的意见呢
Dialogue: 0,0:10:17.24,0:10:18.56,Layzner,Elizabeth,0,0,0,,我只是个医生啊
Dialogue: 0,0:10:18.56,0:10:21.10,Layzner,Man,0,0,0,,医生也是科学家啊
Dialogue: 0,0:10:23.20,0:10:28.80,Layzner,Eliz,0,0,0,,如果根据我的观察 并看不出那孩子有超过常人的能力
Dialogue: 0,0:10:29.27,0:10:31.84,Layzner,Eliz,0,0,0,,但政治军事方面的能力我就看不懂了
Dialogue: 0,0:10:33.04,0:10:34.35,Layzner,,0,0,0,,这里是USA基地
Dialogue: 0,0:10:35.00,0:10:36.13,Layzner,,0,0,0,,USA基地
Dialogue: 0,0:10:37.33,0:10:38.33,Layzner,Bill,0,0,0,,USA基地
Dialogue: 0,0:10:38.40,0:10:40.23,Layzner,Bill,0,0,0,,我们是联合国基地工作人员
Dialogue: 0,0:10:40.23,0:10:43.50,Layzner,,0,0,0,,联合国基地人员 你们在哪
Dialogue: 0,0:10:46.51,0:10:47.56,Layzner,Bill,0,0,0,,USA基地
Dialogue: 0,0:10:48.15,0:10:49.32,Layzner,Bill,0,0,0,,USA基地
Dialogue: 0,0:10:56.71,0:10:57.87,Layzner,Arthur,0,0,0,,接下来
Dialogue: 0,0:10:57.91,0:10:58.81,Layzner,Arthur,0,0,0,,比尔
Dialogue: 0,0:10:58.85,0:10:59.60,Layzner,Arthur,0,0,0,,鲍勃
Dialogue: 0,0:10:59.70,0:11:01.01,Layzner,Arthur,0,0,0,,尼克拉耶夫
Dialogue: 0,0:11:01.01,0:11:01.81,Layzner,Arthur,0,0,0,,梅
Dialogue: 0,0:11:01.95,0:11:03.06,Layzner,Arthur,0,0,0,,弗兰斯
Dialogue: 0,0:11:03.06,0:11:04.03,Layzner,Arthur,0,0,0,,伊丽莎白
Dialogue: 0,0:11:04.23,0:11:05.37,Layzner,Arthur,0,0,0,,还有我
Dialogue: 0,0:11:05.51,0:11:06.67,Layzner,Arthur,0,0,0,,大卫
Dialogue: 0,0:11:06.67,0:11:07.50,Layzner,Arthur,0,0,0,,西蒙尼
Dialogue: 0,0:11:07.85,0:11:09.06,Layzner,Arthur,0,0,0,,安娜
Dialogue: 0,0:11:09.06,0:11:10.48,Layzner,Arthur,0,0,0,,和罗安的
Dialogue: 0,0:11:11.19,0:11:12.48,Layzner,Arthur,0,0,0,,这样就全分好了
Dialogue: 0,0:11:13.82,0:11:14.96,Layzner,Simone,0,0,0,,他的份呢
Dialogue: 0,0:11:15.61,0:11:16.43,Layzner,Arthur,0,0,0,,他是谁
Dialogue: 0,0:11:16.89,0:11:19.49,Layzner,Roanne,0,0,0,,不是也该分他一份吗
Dialogue: 0,0:11:21.66,0:11:25.98,Layzner,Arthur,0,0,0,,如果被他觉得地球人很小气就不好了
Dialogue: 0,0:11:26.02,0:11:28.38,Layzner,Arthur,0,0,0,,没办法 我拿去好了
Dialogue: 0,0:11:46.48,0:11:47.94,Layzner,Arthur,0,0,0,,大卫那家伙
Dialogue: 0,0:12:04.18,0:12:05.27,Layzner,Eiji,0,0,0,,分析模式
Dialogue: 0,0:12:05.68,0:12:07.99,Layzner,Eiji,0,0,0,,我们的存活率有多大
Dialogue: 0,0:12:07.99,0:12:11.85,Layzner,Rei,0,0,0,,我们是指谁 请重新输入
Dialogue: 0,0:12:13.33,0:12:15.13,Layzner,Eiji,0,0,0,,不用了
Dialogue: 0,0:12:55.35,0:12:56.28,Layzner,Eiji,0,0,0,,是食物吗
Dialogue: 0,0:12:57.31,0:12:58.18,Layzner,David,0,0,0,,是的
Dialogue: 0,0:12:59.22,0:13:00.15,Layzner,Eiji,0,0,0,,给我的
Dialogue: 0,0:13:03.60,0:13:04.36,Layzner,Eiji,0,0,0,,谢谢
Dialogue: 0,0:13:25.80,0:13:27.98,Layzner,David,0,0,0,,谁要给你啊
Dialogue: 0,0:13:29.04,0:13:30.94,Layzner,David,0,0,0,,要吃的话自己捡
Dialogue: 0,0:13:32.10,0:13:36.70,Layzner,David,0,0,0,,你来了之后死了几十人了 几十人了
Dialogue: 0,0:13:39.48,0:13:40.38,Layzner,David,0,0,0,,怎么了 怎么不说话
Dialogue: 0,0:13:40.38,0:13:41.68,Layzner,David,0,0,0,,不爽的话来打我啊
Dialogue: 0,0:13:44.93,0:13:46.75,Layzner,David,0,0,0,,我来当你对手
Dialogue: 0,0:13:47.07,0:13:48.28,Layzner,David,0,0,0,,来打一架如何
Dialogue: 0,0:13:48.38,0:13:49.46,Layzner,David,0,0,0,,来打我啊
Dialogue: 0,0:13:58.91,0:14:02.93,Layzner,David,0,0,0,,你这家伙 去死吧
Dialogue: 0,0:14:04.55,0:14:07.03,Layzner,Anna,0,0,0,,谁去阻止他
Dialogue: 0,0:14:13.25,0:14:14.70,Layzner,Anna,0,0,0,,大卫住手 拜托
Dialogue: 0,0:14:14.87,0:14:17.21,Layzner,Anna,0,0,0,,大卫
Dialogue: 0,0:14:17.26,0:14:21.64,Layzner,David,0,0,0,,如果你 如果你不来就不会发生这种事
Dialogue: 0,0:14:22.15,0:14:23.00,Layzner,David,0,0,0,,都是你
Dialogue: 0,0:14:23.19,0:14:24.05,Layzner,David,0,0,0,,都是你
Dialogue: 0,0:14:24.25,0:14:25.43,Layzner,Anna,0,0,0,,快住手
Dialogue: 0,0:14:27.32,0:14:28.69,Layzner,Man,0,0,0,,大卫 快住手
Dialogue: 0,0:14:29.24,0:14:30.58,Layzner,Elizabeth,0,0,0,,住手 大卫
Dialogue: 0,0:14:36.25,0:14:38.29,Layzner,Man,0,0,0,,为什么 为什么要打他
Dialogue: 0,0:14:40.80,0:14:44.58,Layzner,Eliz,0,0,0,,到底是为什么 亚瑟为什么不阻止他
Dialogue: 0,0:14:44.58,0:14:48.17,Layzner,Arthur,0,0,0,,我们后来才来的 而且又离得这么远
Dialogue: 0,0:14:48.17,0:14:49.32,Layzner,David,0,0,0,,我们才不想你
Dialogue: 0,0:14:50.12,0:14:52.52,Layzner,David,0,0,0,,才不要你来保护我们
Dialogue: 0,0:15:04.18,0:15:08.42,Layzner,Eliz,0,0,0,,你 没事吗
Dialogue: 0,0:15:09.03,0:15:09.80,Layzner,Eiji,0,0,0,,嗯
Dialogue: 0,0:15:59.44,0:16:01.71,Layzner,Simone,0,0,0,,你们的星球不会打架吗
Dialogue: 0,0:16:06.11,0:16:09.09,Layzner,Simone,0,0,0,,这样的话大卫还真可怜
Dialogue: 0,0:16:11.20,0:16:13.79,Layzner,Simone,0,0,0,,你也压抑得过头了
Dialogue: 0,0:16:29.63,0:16:31.04,Layzner,Bill,0,0,0,,走吧
Dialogue: 0,0:16:32.08,0:16:34.88,Layzner,Bill,0,0,0,,暴风停了 也讨论了这么久
Dialogue: 0,0:16:34.98,0:16:38.31,Layzner,Bill,0,0,0,,接下来就根据讨论出来的结论一口气前往美国基地吧
Dialogue: 0,0:16:38.70,0:16:40.01,Layzner,Woman,0,0,0,,好 走吧
Dialogue: 0,0:16:40.31,0:16:42.58,Layzner,Woman,0,0,0,,从这里出发的话一下就到了吧
Dialogue: 0,0:16:42.58,0:16:46.34,Layzner,Man,0,0,0,,这里就是再怎么隐秘 还是会被发现的吧
Dialogue: 0,0:16:51.77,0:16:56.22,Layzner,Gosterro,0,0,0,,激光枪 能源弹夹两单位
Dialogue: 0,0:16:56.22,0:16:56.90,Layzner,Com,0,0,0,,Ready.
Dialogue: 0,0:16:57.02,0:17:01.07,Layzner,Gosterro,0,0,0,,更换枪的口径 换成对人类的标准口径
Dialogue: 0,0:17:01.10,0:17:01.86,Layzner,Com,0,0,0,,Ready.
Dialogue: 0,0:17:03.78,0:17:06.71,Layzner,Gosterro,0,0,0,,大家老说枪不好
Dialogue: 0,0:17:06.87,0:17:09.30,Layzner,Gosterro,0,0,0,,但这样就像在杀只虫一样轻松
Dialogue: 0,0:17:15.76,0:17:16.47,Layzner,Bill,0,0,0,,怎么了
Dialogue: 0,0:17:16.47,0:17:19.18,Layzner,Woman,0,0,0,,刚刚眼前亮了一下
Dialogue: 0,0:17:21.97,0:17:23.45,Layzner,Man2,0,0,0,,比尔 怎么了
Dialogue: 0,0:17:23.45,0:17:24.69,Layzner,Bill,0,0,0,,没事
Dialogue: 0,0:17:25.27,0:17:26.91,Layzner,Bill,0,0,0,,只是我有不好的预感
Dialogue: 0,0:17:27.03,0:17:27.82,Layzner,Bill,0,0,0,,快走吧
Dialogue: 0,0:17:30.60,0:17:37.30,Layzner,Com,0,0,0,,根据刚才发射所推测的位置还要根据射程的推算发射位置是20误差1
Dialogue: 0,0:17:46.91,0:17:47.88,Layzner,Eiji,0,0,0,,在哪里
Dialogue: 0,0:17:48.47,0:17:49.88,Layzner,Eiji,0,0,0,,躲在哪里
Dialogue: 0,0:18:06.60,0:18:07.79,Layzner,David,0,0,0,,可恶
Dialogue: 0,0:18:08.13,0:18:11.45,Layzner,Arthur,0,0,0,,大卫 到USA基地只剩这一段路了
Dialogue: 0,0:18:11.55,0:18:14.95,Layzner,Arthur,0,0,0,,只有能到基地的话我们就能平安的回地球了
Dialogue: 0,0:18:15.21,0:18:18.10,Layzner,Arthur,0,0,0,,然后就再也看不到那家伙了
Dialogue: 0,0:18:18.86,0:18:21.69,Layzner,Simone,0,0,0,,前提是要平安到基地对吧
Dialogue: 0,0:18:21.96,0:18:23.20,Layzner,Elizabeth,0,0,0,,我们会平安到基地的
Dialogue: 0,0:18:23.30,0:18:26.41,Layzner,Elizabeth,0,0,0,,所以我们才会选择这条路
Dialogue: 0,0:18:26.71,0:18:27.45,Layzner,Man,0,0,0,,比尔
Dialogue: 0,0:18:27.55,0:18:32.45,Layzner,Man,0,0,0,,如果美国基地没事的话那为什么会在交战中
Dialogue: 0,0:18:32.85,0:18:34.85,Layzner,Man,0,0,0,,那小孩说的是真的吗
Dialogue: 0,0:18:35.19,0:18:38.07,Layzner,Bill,0,0,0,,到了美国基地就全部知道了
Dialogue: 0,0:18:38.41,0:18:40.43,Layzner,Bill,0,0,0,,还有这件事的责任问题也是
Dialogue: 0,0:19:19.26,0:19:20.59,Layzner,Man,0,0,0,,鲍勃 你没事吗
Dialogue: 0,0:19:20.62,0:19:21.58,Layzner,Eiji,0,0,0,,在哪里
Dialogue: 0,0:19:21.58,0:19:22.96,Layzner,Eiji,0,0,0,,给我出来 卑鄙的家伙
Dialogue: 0,0:19:22.96,0:19:24.65,Layzner,Man,0,0,0,,鲍勃你在哪里 梅受伤了
Dialogue: 0,0:19:24.75,0:19:25.67,Layzner,Woman,0,0,0,,你说是梅吗
Dialogue: 0,0:19:26.04,0:19:27.47,Layzner,Man,0,0,0,,我们被瞄准了
Dialogue: 0,0:19:27.57,0:19:30.38,Layzner,Man,0,0,0,,他想杀了我们
Dialogue: 0,0:19:30.38,0:19:31.30,Layzner,David,0,0,0,,你说什么
Dialogue: 0,0:19:31.30,0:19:32.93,Layzner,Bill,0,0,0,,鲍勃 车还能开动吗
Dialogue: 0,0:19:32.93,0:19:33.77,Layzner,Bob,0,0,0,,不行
Dialogue: 0,0:19:33.87,0:19:35.73,Layzner,Bill,0,0,0,,好吧 了解了 你们快来这里
Dialogue: 0,0:19:35.73,0:19:36.48,Layzner,Bob,0,0,0,,明白
Dialogue: 0,0:19:37.86,0:19:41.13,Layzner,Gosterro,0,0,0,,我要把你们一个个都杀了
Dialogue: 0,0:19:42.81,0:19:44.22,Layzner,Eiji,0,0,0,,到底在哪 快给我出来
Dialogue: 0,0:19:46.78,0:19:48.83,Layzner,Bill,0,0,0,,鲍勃 尼克拉耶夫 怎么了
Dialogue: 0,0:19:48.83,0:19:50.33,Layzner,Man,0,0,0,,不好了 快逃
Dialogue: 0,0:19:57.17,0:19:58.37,Layzner,Eiji,0,0,0,,在那 给我出来
Dialogue: 0,0:20:03.79,0:20:04.99,Layzner,Gosterro,0,0,0,,多利米亚 就是现在
Dialogue: 0,0:20:04.99,0:20:06.79,Layzner,Gosterro,0,0,0,,上吧 快把他打下来
Dialogue: 0,0:20:06.79,0:20:09.15,Layzner,Roberia,0,0,0,,可是对方并没有防备
Dialogue: 0,0:20:09.73,0:20:12.18,Layzner,Gosterro,0,0,0,,算了 那快把那小鬼打下来
Dialogue: 0,0:20:16.81,0:20:18.72,Layzner,Eiji,0,0,0,,卑鄙的家伙 我来做你的对手
Dialogue: 0,0:20:25.63,0:20:27.30,Layzner,Eiji,0,0,0,,不会再让你得逞了
Dialogue: 0,0:20:29.81,0:20:31.43,Layzner,Gosterro,0,0,0,,我送你下地狱 小鬼
Dialogue: 0,0:20:40.54,0:20:41.32,Layzner,Woman,0,0,0,,不要
Dialogue: 0,0:20:41.35,0:20:42.04,Layzner,Woman,0,0,0,,鲍勃
Dialogue: 0,0:20:42.04,0:20:42.95,Layzner,Woman,0,0,0,,尼克拉耶夫
Dialogue: 0,0:20:43.05,0:20:43.74,Layzner,Woman,0,0,0,,梅
Dialogue: 0,0:20:43.74,0:20:44.78,Layzner,Woman,0,0,0,,不要
Dialogue: 0,0:20:44.78,0:20:46.16,Layzner,Woman,0,0,0,,快住手 不要
Dialogue: 0,0:20:50.45,0:20:52.83,Layzner,Elizabeth,0,0,0,,让他们休息一下吧
Dialogue: 0,0:20:53.55,0:20:54.99,Layzner,Bill,0,0,0,,再忍耐一下
Dialogue: 0,0:20:55.29,0:20:57.50,Layzner,Bill,0,0,0,,只有过了那山丘 就是美国基地了
Dialogue: 0,0:20:58.10,0:20:59.14,Layzner,Eiji,0,0,0,,请快一点
Dialogue: 0,0:20:59.74,0:21:01.14,Layzner,Eiji,0,0,0,,我会把敌人挡在这里的
Dialogue: 0,0:21:08.52,0:21:11.28,Layzner,Gosterro,0,0,0,,小鬼 来打我啊
Dialogue: 0,0:21:11.28,0:21:14.45,Layzner,Gosterro,0,0,0,,我杀了你很多同伴
Dialogue: 0,0:21:14.45,0:21:16.77,Layzner,Gosterro,0,0,0,,来吧 随便从哪来都行 来打我啊
Dialogue: 0,0:21:20.04,0:21:21.90,Layzner,Gosterro,0,0,0,,多米利亚 我们一起围攻他
Dialogue: 0,0:21:21.90,0:21:22.68,Layzner,Gosterro,0,0,0,,上吧
Dialogue: 0,0:21:32.13,0:21:33.15,Layzner,Arthur,0,0,0,,是基地
Dialogue: 0,0:21:33.47,0:21:34.49,Layzner,Roanne,0,0,0,,是美国基地
Dialogue: 0,0:21:34.49,0:21:35.64,Layzner,Arthur,0,0,0,,没有错吧
Dialogue: 0,0:21:35.64,0:21:38.80,Layzner,Bill,0,0,0,,对 只要到这里的话就没事了
Dialogue: 0,0:21:38.94,0:21:41.42,Layzner,Elizabeth,0,0,0,,太好了 我们没事
Dialogue: 0,0:21:42.09,0:21:44.26,Layzner,David,0,0,0,,我们差点被那家伙骗了
Dialogue: 0,0:21:44.63,0:21:46.40,Layzner,Roanne,0,0,0,,哪里有战争
Dialogue: 0,0:21:46.53,0:21:47.25,Layzner,Roanne,0,0,0,,对吧
Dialogue: 0,0:21:49.10,0:21:50.50,Layzner,Simone,0,0,0,,好像做梦一样
Dialogue: 0,0:21:50.84,0:21:53.70,Layzner,Simone,0,0,0,,如果这是梦的话 还真希望不要醒来
Dialogue: 0,0:21:54.85,0:21:59.75,Layzner,Anna,0,0,0,,我也是 平安的到了美国基地 我的胸中充满无限的感慨
Dialogue: 0,0:22:00.45,0:22:06.38,Layzner,Anna,0,0,0,,一直追着我们 对战争的不安阴影 在这一瞬间都消失了
Dialogue: 0,0:22:06.88,0:22:13.44,Layzner,Anna,0,0,0,,这时候我突然觉得地球人并不是那么笨的生物
Dialogue: 0,0:22:13.44,0:22:14.14,Layzner,Bill,0,0,0,,哦
Dialogue: 0,0:22:14.57,0:22:15.06,Layzner,Eliz,0,0,0,,唉
Dialogue: 0,0:22:15.06,0:22:16.86,Layzner,Bill,0,0,0,,那是
Dialogue: 0,0:22:32.38,0:22:33.75,Layzner,Bill,0,0,0,,是核弹
Dialogue: 0,0:22:34.79,0:22:35.75,Layzner,Arthur,0,0,0,,怎么会这样
Dialogue: 0,0:22:36.75,0:22:38.05,Layzner,Simone,0,0,0,,为什么
Dialogue: 0,0:22:42.94,0:22:44.08,Layzner,Anna,0,0,0,,我
Dialogue: 0,0:22:44.74,0:22:45.88,Layzner,Anna,0,0,0,,我
Dialogue: 0,0:22:46.86,0:22:47.93,Layzner,Anna,0,0,0,,我
Dialogue: 0,0:23:54.32,0:23:57.79,Layzner,,0,0,0,,要杀光抵抗的人类 古拉特斯星的人都这么冷血吗
Dialogue: 0,0:23:58.45,0:24:00.45,Layzner,,0,0,0,,把那些害虫都杀了也不会有损我们古拉特斯的威名的
Dialogue: 0,0:24:01.96,0:24:03.96,Layzner,,0,0,0,,那连自己部下都杀了的你呢
Dialogue: 0,0:24:03.96,0:24:04.13,Layzner,,0,0,0,,下一集 让我活下去
Dialogue: 0,0:24:04.71,0:24:09.71,Layzner,,0,0,0,,

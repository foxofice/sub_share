Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:01.36,0:01:06.26,Layzner,Carks,0,0,0,,有时因为时间跟地点 必须有舍命的觉悟
Dialogue: 0,0:01:06.26,0:01:08.70,Layzner,Elizabeth,0,0,0,,我们要走 就表示英二也要一起去
Dialogue: 0,0:01:08.89,0:01:10.30,Layzner,Eiji,0,0,0,,走吧 少佐
Dialogue: 0,0:01:46.17,0:01:51.66,Layzner,Anna,0,0,0,,从到达火星到现在已经过了55小时
Dialogue: 0,0:01:51.66,0:01:54.01,Layzner,Anna,0,0,0,,才五十五小时而已
Dialogue: 0,0:01:54.61,0:02:01.48,Layzner,Anna,0,0,0,,可是我却感觉好像已经经历过人生了
Dialogue: 0,0:02:03.36,0:02:07.82,Layzner,Carks,0,0,0,,你的同伴也杀了地球人 没有资格说我野蛮
Dialogue: 0,0:02:09.38,0:02:10.13,Layzner,Carks,0,0,0,,站起来
Dialogue: 0,0:02:11.41,0:02:13.36,Layzner,David,0,0,0,,够了 少佐
Dialogue: 0,0:02:18.73,0:02:23.78,Layzner,Arthur,0,0,0,,我也相信英二 可是
Dialogue: 0,0:02:24.58,0:02:30.22,Layzner,Anna,0,0,0,,大家都选了英二 在生与死之间做了重大的选择
Dialogue: 0,0:02:30.22,0:02:35.21,Layzner,Anna,0,0,0,,相信自己的同伴的话
Dialogue: 0,0:02:30.22,0:02:35.21,Layzner,Anna,0,0,0,,大家都把外星人的英二当做同伴
Dialogue: 0,0:02:36.36,0:02:41.37,Layzner,Anna,0,0,0,,我们的胸中充满了对地球的回忆
Dialogue: 0,0:02:41.37,0:02:46.39,Layzner,,0,0,0,,第十二话 再见 红色之星
Dialogue: 0,0:02:49.84,0:02:54.62,Layzner,Carks,0,0,0,,外星人没再出现吗
Dialogue: 0,0:02:49.84,0:02:54.62,Layzner,Carks,0,0,0,,罗亚 现在我要回去了 没有异状吗
Dialogue: 0,0:02:54.90,0:02:59.09,Layzner,Towyer,0,0,0,,但还是不能大意 请快一点
Dialogue: 0,0:02:54.90,0:02:59.09,Layzner,Towyer,0,0,0,,虽然从刚才的攻击后就没了
Dialogue: 0,0:02:59.73,0:03:02.67,Layzner,Carks,0,0,0,,情报呢 掌握他们的战力了吗
Dialogue: 0,0:03:02.96,0:03:05.11,Layzner,Towyer,0,0,0,,还没 现在还在侦测中
Dialogue: 0,0:03:10.93,0:03:13.70,Layzner,Gail,0,0,0,,武器方面 是激光和导弹吗
Dialogue: 0,0:03:13.70,0:03:16.02,Layzner,Egyle,0,0,0,,是的 性能方面如您所见
Dialogue: 0,0:03:16.65,0:03:21.67,Layzner,Egyle,0,0,0,,还停留在初期的程度 要看解析资料吗
Dialogue: 0,0:03:21.67,0:03:24.06,Layzner,Gail,0,0,0,,不用了 不用一个个看了
Dialogue: 0,0:03:24.47,0:03:27.28,Layzner,Gail,0,0,0,,达尔军曹会死是因为太轻敌了吧
Dialogue: 0,0:03:27.98,0:03:29.99,Layzner,Gail,0,0,0,,阿修 你怎么认为
Dialogue: 0,0:03:30.57,0:03:31.88,Layzner,Ash,0,0,0,,正如您所说
Dialogue: 0,0:03:32.10,0:03:35.55,Layzner,Gail,0,0,0,,当然还是会吃苦头的
Dialogue: 0,0:03:32.10,0:03:35.55,Layzner,Gail,0,0,0,,就算是再差劲的对手 如果瞧不起他的话
Dialogue: 0,0:03:39.07,0:03:40.83,Layzner,Grescco,0,0,0,,保持原姿势听命令就可以了 中尉
Dialogue: 0,0:03:41.37,0:03:44.80,Layzner,Gail,0,0,0,,是 谢谢 我一直在等您的指示
Dialogue: 0,0:03:45.14,0:03:46.77,Layzner,Grescco,0,0,0,,战斗准备进行的如何了
Dialogue: 0,0:03:47.12,0:03:50.42,Layzner,Gail,0,0,0,,把多特尔装备上宇宙用背包
Dialogue: 0,0:03:50.42,0:03:52.75,Layzner,,0,0,0,,再跟迪马修一起出击的话应该就没问题了
Dialogue: 0,0:03:53.11,0:03:56.32,Layzner,Grescco,0,0,0,,好 那就出击吧 一定要完全消灭他们
Dialogue: 0,0:03:56.32,0:04:02.03,Layzner,Grescco,0,0,0,,要注意不要让情报流到敌人手中
Dialogue: 0,0:03:56.32,0:04:02.03,Layzner,Grescco,0,0,0,,直到我们攻到地球为止
Dialogue: 0,0:04:02.03,0:04:02.87,Layzner,Gail,0,0,0,,我知道了
Dialogue: 0,0:04:04.08,0:04:06.34,Layzner,Gail,0,0,0,,阿修 带队马上准备出动
Dialogue: 0,0:04:06.35,0:04:07.10,Layzner,Ash,0,0,0,,是
Dialogue: 0,0:04:09.05,0:04:10.32,Layzner,Egyle,0,0,0,,阿修 等一下
Dialogue: 0,0:04:11.41,0:04:13.97,Layzner,Egyle,0,0,0,,中尉 请马上派我出去
Dialogue: 0,0:04:14.68,0:04:16.66,Layzner,Gail,0,0,0,,卡露拉 你先休息一下
Dialogue: 0,0:04:16.66,0:04:19.87,Layzner,Egyle,0,0,0,,为什么 我又没违反中尉您的命令
Dialogue: 0,0:04:19.87,0:04:23.50,Layzner,Gail,0,0,0,,才想先让你休息一下
Dialogue: 0,0:04:19.87,0:04:23.50,Layzner,Gail,0,0,0,,不是这样的 只是你看起来很累
Dialogue: 0,0:04:23.54,0:04:28.35,Layzner,Egyle,0,0,0,,我才不累 中尉 如果觉得我不合适请直说
Dialogue: 0,0:04:29.09,0:04:31.67,Layzner,Gail,0,0,0,,你一看到英二就会失去冷静
Dialogue: 0,0:04:32.04,0:04:34.65,Layzner,Gail,0,0,0,,你太在意他了 所以你去休息一下吧
Dialogue: 0,0:04:35.87,0:04:39.08,Layzner,Egyle,0,0,0,,中尉 说要杀了英二的不就是中尉你下的命令吗
Dialogue: 0,0:04:39.08,0:04:41.31,Layzner,Egyle,0,0,0,,但你现在竟这么说
Dialogue: 0,0:04:41.31,0:04:44.11,Layzner,,0,0,0,,其实在意英二的是中尉你吧
Dialogue: 0,0:04:45.91,0:04:49.65,Layzner,Arthur,0,0,0,,可恶 可恶 笨蛋 笨蛋
Dialogue: 0,0:04:49.65,0:04:54.50,Layzner,Eiji,0,0,0,,没事的 亚瑟 一定能回地球的 我想一定行的
Dialogue: 0,0:04:54.50,0:04:57.97,Layzner,David,0,0,0,,英二 你不用这么在意
Dialogue: 0,0:04:57.98,0:05:02.19,Layzner,Roanne,0,0,0,,对啊 我们也很了解目前的情况
Dialogue: 0,0:05:02.91,0:05:08.43,Layzner,Roanne,0,0,0,,我们还能若无其事的回去吗
Dialogue: 0,0:05:02.91,0:05:08.43,Layzner,Roanne,0,0,0,,眼前就有敌人压境了
Dialogue: 0,0:05:09.02,0:05:12.38,Layzner,Roanne,0,0,0,,还有那少佐 明明不了解状况还骂人
Dialogue: 0,0:05:13.41,0:05:15.24,Layzner,Roanne,0,0,0,,这是大家的想出来的结论
Dialogue: 0,0:05:16.96,0:05:24.86,Layzner,Arthur,0,0,0,,不管哪丹尼少佐是军人还是杀人犯我都想跟他回地球
Dialogue: 0,0:05:16.96,0:05:24.86,Layzner,Arthur,0,0,0,,老实说 英二 如果没有外星人的话
Dialogue: 0,0:05:24.89,0:05:26.60,Layzner,Arthur,0,0,0,,超想回地球的
Dialogue: 0,0:05:28.21,0:05:30.97,Layzner,David,0,0,0,,没错 你懂我们的心情吗 英二
Dialogue: 0,0:05:30.97,0:05:37.17,Layzner,David,0,0,0,,所以就算概率很低 我们还是会选其中概率较高的
Dialogue: 0,0:05:38.82,0:05:39.52,Layzner,Eiji,0,0,0,,大卫
Dialogue: 0,0:05:41.30,0:05:42.96,Layzner,Eiji,0,0,0,,就算是这样我还是很高兴
Dialogue: 0,0:05:49.02,0:05:55.67,Layzner,Anna,0,0,0,,就算是这样我还是很高兴 英二的话紧紧捉住我们的心
Dialogue: 0,0:05:56.36,0:06:01.19,Layzner,Anna,0,0,0,,他从心里想 就算生或死都要跟我们在一起
Dialogue: 0,0:06:02.49,0:06:06.71,Layzner,Roanne,0,0,0,,大家看 雷达有反应了 有东西接近地球来的船了
Dialogue: 0,0:06:12.11,0:06:12.87,Layzner,Elizabeth,0,0,0,,大卫
Dialogue: 0,0:06:14.63,0:06:15.77,Layzner,David,0,0,0,,罗安 去救他们吧
Dialogue: 0,0:06:15.77,0:06:16.61,Layzner,Roanne,0,0,0,,大卫
Dialogue: 0,0:06:16.61,0:06:19.69,Layzner,Eiji,0,0,0,,不要乱来 大卫 这不是你们俩可以应付得来的
Dialogue: 0,0:06:20.96,0:06:24.36,Layzner,Simone,0,0,0,,那种人别管他了 他们自作自受
Dialogue: 0,0:06:24.36,0:06:27.15,Layzner,David,0,0,0,,我们是地球人 不能见死不救
Dialogue: 0,0:06:33.93,0:06:36.04,Layzner,Eiji,0,0,0,,我知道了 走吧 大卫
Dialogue: 0,0:07:13.44,0:07:14.89,Layzner,Carks,0,0,0,,可恶 又是他们吗
Dialogue: 0,0:07:15.04,0:07:18.69,Layzner,Roger,0,0,0,,不一样 少佐 速度和火力都和之前的不一样
Dialogue: 0,0:07:21.53,0:07:24.09,Layzner,Killy,0,0,0,,第七舱门关闭 第八舱门关闭
Dialogue: 0,0:07:36.28,0:07:37.00,Layzner,Carks,0,0,0,,你要去哪
Dialogue: 0,0:07:38.10,0:07:40.01,Layzner,Killy,0,0,0,,激光炮怪怪的
Dialogue: 0,0:07:40.18,0:07:41.40,Layzner,Carks,0,0,0,,不要去 太危险了
Dialogue: 0,0:07:43.07,0:07:45.04,Layzner,Killy,0,0,0,,那可是本舰的主要武器
Dialogue: 0,0:08:06.91,0:08:07.79,Layzner,Carks,0,0,0,,肯
Dialogue: 0,0:08:08.33,0:08:10.25,Layzner,Roger,0,0,0,,少佐 导弹也没了
Dialogue: 0,0:08:20.63,0:08:22.05,Layzner,Carks,0,0,0,,苏伊士
Dialogue: 0,0:08:24.23,0:08:25.93,Layzner,Carks,0,0,0,,罗吉亚
Dialogue: 0,0:08:49.71,0:08:51.93,Layzner,Carks,0,0,0,,给我看着 你们这些外星人
Dialogue: 0,0:09:02.86,0:09:05.70,Layzner,Carks,0,0,0,,可恶的外星人 快跟过来吧
Dialogue: 0,0:09:17.95,0:09:21.13,Layzner,Ash,0,0,0,,停止攻击 这船要爆炸了 快离开这
Dialogue: 0,0:09:21.13,0:09:23.47,Layzner,Pilot,0,0,0,,有SPT 三架上升接近中
Dialogue: 0,0:09:31.14,0:09:35.11,Layzner,Eiji,0,0,0,,大卫 罗安 不要接近太空船 会被卷入爆炸的
Dialogue: 0,0:09:35.11,0:09:36.73,Layzner,David,0,0,0,,那少佐怎么样了
Dialogue: 0,0:09:36.73,0:09:39.15,Layzner,Eiji,0,0,0,,丹尼少佐 听得到吗
Dialogue: 0,0:09:39.57,0:09:41.98,Layzner,Eiji,0,0,0,,丹尼少佐
Dialogue: 0,0:09:43.49,0:09:47.44,Layzner,Carks,0,0,0,,可恶的外星人 还不跟过来 来啊 一起死吧
Dialogue: 0,0:09:53.37,0:09:55.02,Layzner,Eiji,0,0,0,,少佐
Dialogue: 0,0:09:55.24,0:09:56.27,Layzner,Carks,0,0,0,,可恶
Dialogue: 0,0:10:04.15,0:10:05.04,Layzner,Eiji,0,0,0,,散开
Dialogue: 0,0:10:21.05,0:10:23.20,Layzner,Ash,0,0,0,,作战结束 回去吧
Dialogue: 0,0:10:23.20,0:10:25.86,Layzner,Pilot,0,0,0,,那么那三架怎么办 好像还有一人脱出了
Dialogue: 0,0:10:25.86,0:10:27.88,Layzner,Ash,0,0,0,,深入太危险 回去好了
Dialogue: 0,0:10:48.73,0:10:51.22,Layzner,Elizabeth,0,0,0,,只是轻微的撞伤 马上就会好了
Dialogue: 0,0:10:51.26,0:10:53.52,Layzner,Elizabeth,0,0,0,,部下的事我感到很遗憾
Dialogue: 0,0:10:55.03,0:10:57.05,Layzner,Carks,0,0,0,,他们一定觉得我很讨厌吧
Dialogue: 0,0:10:57.39,0:11:00.63,Layzner,Elizabeth,0,0,0,,他们在你出事后也很担心少佐你
Dialogue: 0,0:11:02.70,0:11:03.90,Layzner,Carks,0,0,0,,伊丽莎白博士
Dialogue: 0,0:11:05.42,0:11:07.68,Layzner,Carks,0,0,0,,我想再听那孩子重新说一次
Dialogue: 0,0:11:09.51,0:11:13.27,Layzner,Carks,0,0,0,,敌人的战略远超我们想象
Dialogue: 0,0:11:17.56,0:11:20.52,Layzner,Elizabeth,0,0,0,,那么 请先听我准备的磁片
Dialogue: 0,0:11:24.05,0:11:27.22,Layzner,Elizabeth,0,0,0,,这是为了以防万一 先请英二录的
Dialogue: 0,0:11:27.81,0:11:30.28,Layzner,Carks,0,0,0,,你是说那个跟外星人生的混血少年吗
Dialogue: 0,0:11:30.53,0:11:31.23,Layzner,Elizabeth,0,0,0,,是
Dialogue: 0,0:11:36.31,0:11:38.12,Layzner,Roanne,0,0,0,,在附近看不到敌人
Dialogue: 0,0:11:41.03,0:11:42.39,Layzner,David,0,0,0,,谢谢 英二
Dialogue: 0,0:11:43.25,0:11:44.00,Layzner,Eiji,0,0,0,,谢什么
Dialogue: 0,0:11:44.15,0:11:45.85,Layzner,David,0,0,0,,救了少佐的事
Dialogue: 0,0:11:46.04,0:11:51.20,Layzner,David,0,0,0,,那家伙被救也不会道歉 不过地球人不是每个都那样的
Dialogue: 0,0:11:52.82,0:11:58.71,Layzner,Eiji,0,0,0,,不用在意 别忘了我的血里有一半是地球人的 大卫
Dialogue: 0,0:11:59.25,0:12:03.16,Layzner,Simone,0,0,0,,英二 那个老顽固好像有话要跟你说
Dialogue: 0,0:12:04.89,0:12:05.75,Layzner,Eiji,0,0,0,,这里麻烦你了
Dialogue: 0,0:12:09.62,0:12:11.10,Layzner,David,0,0,0,,他要说什么
Dialogue: 0,0:12:14.18,0:12:18.53,Layzner,Carks,0,0,0,,阿尔巴特洛·英二·飞鸟 这磁片里说的都是真的吗
Dialogue: 0,0:12:18.62,0:12:19.55,Layzner,Eiji,0,0,0,,是的
Dialogue: 0,0:12:19.62,0:12:21.13,Layzner,Carks,0,0,0,,你说是古雷斯库的舰队吗
Dialogue: 0,0:12:21.29,0:12:22.13,Layzner,Eiji,0,0,0,,当然了
Dialogue: 0,0:12:22.39,0:12:23.64,Layzner,Carks,0,0,0,,他们现在在哪里
Dialogue: 0,0:12:24.00,0:12:25.65,Layzner,Eiji,0,0,0,,应该在向地球进发的途中
Dialogue: 0,0:12:26.01,0:12:28.63,Layzner,Carks,0,0,0,,你是为了把这个情报告诉地球而来的吗
Dialogue: 0,0:12:29.14,0:12:29.93,Layzner,Eiji,0,0,0,,是的
Dialogue: 0,0:12:31.71,0:12:35.25,Layzner,Carks,0,0,0,,对好战的地球人开拓太空的计划感到不安
Dialogue: 0,0:12:35.25,0:12:39.22,Layzner,Carks,0,0,0,,为了宇宙的和平要消灭人类
Dialogue: 0,0:12:39.64,0:12:40.39,Layzner,Eiji,0,0,0,,是的
Dialogue: 0,0:12:43.59,0:12:46.07,Layzner,Carks,0,0,0,,古拉特斯人就不好战吗
Dialogue: 0,0:12:47.57,0:12:51.09,Layzner,Carks,0,0,0,,你们古拉特斯应该也拥有强大武力的战舰吧
Dialogue: 0,0:12:51.38,0:12:54.55,Layzner,Eiji,0,0,0,,那是为了以防万一 为了要保护古拉特斯
Dialogue: 0,0:12:54.55,0:12:57.05,Layzner,Carks,0,0,0,,你先说的那个以防万一
Dialogue: 0,0:12:58.12,0:13:04.09,Layzner,Carks,0,0,0,,是说古拉特斯星受到好战的地球人攻击而引发的危机吗
Dialogue: 0,0:13:05.97,0:13:11.19,Layzner,Carks,0,0,0,,你说我是凡事都用武力解决的野蛮人你还记得吗
Dialogue: 0,0:13:12.16,0:13:13.04,Layzner,Eiji,0,0,0,,我记得
Dialogue: 0,0:13:13.17,0:13:20.29,Layzner,Carks,0,0,0,,跟用武力解决有什么不同
Dialogue: 0,0:13:13.17,0:13:20.29,Layzner,Carks,0,0,0,,对好战的地球人开拓太空感到不安而对地球展开攻击
Dialogue: 0,0:13:20.92,0:13:28.46,Layzner,Carks,0,0,0,,古拉特斯人凭什么摧毁有六十亿人的地球
Dialogue: 0,0:13:20.92,0:13:28.46,Layzner,Carks,0,0,0,,就算我们地球人很好战
Dialogue: 0,0:13:29.15,0:13:31.46,Layzner,Carks,0,0,0,,古拉特斯人有什么资格
Dialogue: 0,0:13:31.78,0:13:35.59,Layzner,Carks,0,0,0,,根据自己的理论而对地球攻击也太乱来了
Dialogue: 0,0:13:35.99,0:13:40.08,Layzner,Carks,0,0,0,,地球就算倾全力也会摧毁古雷斯库的舰队的
Dialogue: 0,0:13:40.25,0:13:44.52,Layzner,Elizabeth,0,0,0,,你的想法会成为古拉特斯攻打地球的借口的
Dialogue: 0,0:13:44.52,0:13:49.79,Layzner,Carks,0,0,0,,够了 伊丽莎白博士 你想告诉我怎么样和平解决是吗
Dialogue: 0,0:13:49.92,0:13:54.21,Layzner,Carks,0,0,0,,我们这里连非战斗人员在内已经死了一百人以上了
Dialogue: 0,0:13:54.57,0:13:59.06,Layzner,Carks,0,0,0,,在跟我接触前你怎么不先去接触敌人 跟敌人说
Dialogue: 0,0:13:59.06,0:14:03.79,Layzner,Elizabeth,0,0,0,,没有用 敌人见人类就杀 我们尽全力也只有逃跑的份
Dialogue: 0,0:14:05.50,0:14:12.23,Layzner,Carks,0,0,0,,那如果是真的话 那我就再问一次 地球人哪里好战了
Dialogue: 0,0:14:12.44,0:14:14.27,Layzner,Carks,0,0,0,,是把导弹带到火星上来吗
Dialogue: 0,0:14:14.87,0:14:17.13,Layzner,Carks,0,0,0,, 还是人类的历史都是杀戮吗
Dialogue: 0,0:14:17.81,0:14:19.91,Layzner,Carks,0,0,0,,那你们古拉特斯人见人就杀的行为又如何
Dialogue: 0,0:14:22.32,0:14:26.52,Layzner,Carks,0,0,0,,我是军人 如你一开始所说 军人都会用武力
Dialogue: 0,0:14:26.79,0:14:32.12,Layzner,Carks,0,0,0,,但那并不是为了政治或私利 不是为了我们自己方便才做的
Dialogue: 0,0:14:32.43,0:14:33.74,Layzner,Carks,0,0,0,,给我好好记住
Dialogue: 0,0:14:35.79,0:14:36.78,Layzner,Elizabeth,0,0,0,,你要去哪 少佐
Dialogue: 0,0:14:37.32,0:14:41.49,Layzner,Carks,0,0,0,,这里应该还有美国的观测台 我去联络他们
Dialogue: 0,0:14:52.46,0:14:54.82,Layzner,Carks,0,0,0,,USA宇宙部队 USA宇宙部队
Dialogue: 0,0:14:55.00,0:14:59.73,Layzner,Carks,0,0,0,,这里是第十三火星基地 第七运输队的丹尼少佐
Dialogue: 0,0:15:08.75,0:15:11.53,Layzner,Officer,0,0,0,,没有异状 没有接受到电波
Dialogue: 0,0:15:11.76,0:15:13.62,Layzner,Officer2,0,0,0,,雷达没反应 没有异常
Dialogue: 0,0:15:21.34,0:15:22.89,Layzner,Grescco,0,0,0,,有一个生还者是吗
Dialogue: 0,0:15:22.89,0:15:27.48,Layzner,Gail,0,0,0,,是 不过已经确认其位置 现在马上就去
Dialogue: 0,0:15:27.92,0:15:34.41,Layzner,Grescco,0,0,0,,就是在地球上的部队接近火星前消灭他们
Dialogue: 0,0:15:27.92,0:15:34.41,Layzner,Grescco,0,0,0,,驻守在火星上的你们的任务
Dialogue: 0,0:15:34.84,0:15:36.19,Layzner,Grescco,0,0,0,,知道吗
Dialogue: 0,0:15:36.58,0:15:37.54,Layzner,Gail,0,0,0,,我知道
Dialogue: 0,0:15:38.35,0:15:39.38,Layzner,Grescco,0,0,0,,不要大意
Dialogue: 0,0:15:39.45,0:15:40.15,Layzner,Gail,0,0,0,,是
Dialogue: 0,0:15:43.20,0:15:46.66,Layzner,Grescco,0,0,0,,捕捉到接近中的地球舰队 就先这样待命吧
Dialogue: 0,0:15:46.66,0:15:47.36,Layzner,Gail,0,0,0,,是
Dialogue: 0,0:15:50.44,0:15:51.14,Layzner,Grescco,0,0,0,,距离多远
Dialogue: 0,0:15:51.23,0:15:54.59,Layzner,Officer,0,0,0,,0.2单位 朝火星前进
Dialogue: 0,0:15:55.36,0:15:56.56,Layzner,Grescco,0,0,0,,火星是吗
Dialogue: 0,0:15:57.04,0:16:04.28,Layzner,Grescco,0,0,0,,回避并且不要和接近中的地球舰开战
Dialogue: 0,0:15:57.04,0:16:04.28,Layzner,Grescco,0,0,0,,我是古雷斯库 对全舰下令 现在要用防护罩
Dialogue: 0,0:16:18.94,0:16:20.44,Layzner,Officer,0,0,0,,这 这是怎么回事
Dialogue: 0,0:16:20.79,0:16:21.49,Layzner,Captain,0,0,0,,怎么了
Dialogue: 0,0:16:21.52,0:16:25.52,Layzner,Officer,0,0,0,,没事 雷达突然变得怪怪的
Dialogue: 0,0:16:25.52,0:16:29.32,Layzner,Officer2,0,0,0,,你也是吗 我这个重力干涉器也怪怪的
Dialogue: 0,0:16:31.41,0:16:32.79,Layzner,Officer2,0,0,0,,这是怎么回事
Dialogue: 0,0:16:33.54,0:16:35.39,Layzner,Officer,0,0,0,,伤脑筋 我这也是
Dialogue: 0,0:16:37.02,0:16:38.53,Layzner,Officer,0,0,0,,地域探测器
Dialogue: 0,0:16:38.77,0:16:40.13,Layzner,Officer,0,0,0,,恢复正常了
Dialogue: 0,0:16:40.24,0:16:40.87,Layzner,Officer,0,0,0,,我这也是
Dialogue: 0,0:16:40.87,0:16:42.65,Layzner,Officer,0,0,0,,这是怎么回事
Dialogue: 0,0:16:42.65,0:16:43.83,Layzner,Officer,0,0,0,,不知道怎么了
Dialogue: 0,0:16:52.25,0:16:56.72,Layzner,Grescco,0,0,0,,地球舰队已到了火星 想必战力一点很不差
Dialogue: 0,0:16:56.93,0:16:59.11,Layzner,Grescco,0,0,0,,中尉 希望你能把他们都消灭
Dialogue: 0,0:16:59.29,0:16:59.99,Layzner,Gail,0,0,0,,是
Dialogue: 0,0:17:00.09,0:17:03.30,Layzner,Grescco,0,0,0,,尽可能在接触到地球舰队前把英二杀了
Dialogue: 0,0:17:03.93,0:17:04.84,Layzner,Gail,0,0,0,,我知道了
Dialogue: 0,0:17:06.14,0:17:09.81,Layzner,Carks,0,0,0,,这里是是第十三火星基地 第七运输队的丹尼少佐
Dialogue: 0,0:17:09.81,0:17:11.59,Layzner,Carks,0,0,0,,USA宇宙部队
Dialogue: 0,0:17:12.75,0:17:14.77,Layzner,Carks,0,0,0,,可恶 没回应
Dialogue: 0,0:17:16.83,0:17:21.60,Layzner,Carks,0,0,0,,我要用你外面的太空船 我命令你送我去宇宙部队那里
Dialogue: 0,0:17:21.68,0:17:23.65,Layzner,Eiji,0,0,0,,不可能的 上空有敌人
Dialogue: 0,0:17:24.55,0:17:28.28,Layzner,Carks,0,0,0,,我知道 你只要乖乖听我的就好
Dialogue: 0,0:17:31.43,0:17:36.09,Layzner,Elizabeth,0,0,0,,少佐 把枪收起来 你怎么动不动就用武力去胁迫别人呢
Dialogue: 0,0:17:37.22,0:17:42.26,Layzner,Carks,0,0,0,,你 还有你 也一起来 如果敌人出现的话你们就去战斗
Dialogue: 0,0:17:42.45,0:17:44.78,Layzner,Elizabeth,0,0,0,,少佐 你要叫他们干什么
Dialogue: 0,0:17:51.04,0:17:55.60,Layzner,Carks,0,0,0,,有时因为时间跟地点必须有舍命的觉悟
Dialogue: 0,0:17:58.52,0:18:01.23,Layzner,Elizabeth,0,0,0,,我还是他们的监护人
Dialogue: 0,0:18:01.54,0:18:03.44,Layzner,Carks,0,0,0,,那你不用干了
Dialogue: 0,0:18:03.92,0:18:08.80,Layzner,Carks,0,0,0,,在那之前给我乖乖待在这里
Dialogue: 0,0:18:03.92,0:18:08.80,Layzner,Carks,0,0,0,,太空部队来了之后就会马上带你们走
Dialogue: 0,0:18:08.80,0:18:11.02,Layzner,Elizabeth,0,0,0,,不要 我们也要一起去
Dialogue: 0,0:18:13.11,0:18:15.10,Layzner,Elizabeth,0,0,0,,亚瑟跟西蒙尼也一起去
Dialogue: 0,0:18:16.25,0:18:19.29,Layzner,Carks,0,0,0,,我不阻止你们 但你们应该也知道其危险性
Dialogue: 0,0:18:19.77,0:18:21.54,Layzner,Simone,0,0,0,,在这也是一样
Dialogue: 0,0:18:28.74,0:18:31.01,Layzner,Elizabeth,0,0,0,,我们要走 就表示英二也要一起去
Dialogue: 0,0:18:31.01,0:18:34.34,Layzner,Elizabeth,0,0,0,,让我们活到今天的英二也要一起去
Dialogue: 0,0:18:35.98,0:18:37.43,Layzner,Eiji,0,0,0,,走吧 少佐
Dialogue: 0,0:18:37.93,0:18:41.68,Layzner,Eiji,0,0,0,,我不是因为你的胁迫才去的 而是因为大家去我才去的
Dialogue: 0,0:18:44.05,0:18:47.68,Layzner,Egyle,0,0,0,,中尉您出击是在讽刺我吗
Dialogue: 0,0:18:47.68,0:18:52.01,Layzner,Gail,0,0,0,,不要想些有的没的 卡露拉你也一起来
Dialogue: 0,0:18:52.39,0:18:54.35,Layzner,Egyle,0,0,0,,可是我想一个人干掉英二
Dialogue: 0,0:18:58.75,0:18:59.46,Layzner,Egyle,0,0,0,,中尉
Dialogue: 0,0:19:00.86,0:19:03.20,Layzner,Gail,0,0,0,,要埋葬英二的 是我
Dialogue: 0,0:19:23.39,0:19:26.73,Layzner,Gail,0,0,0,,卡露拉 好久没一起行动了 好走吧
Dialogue: 0,0:19:36.67,0:19:39.89,Layzner,Eiji,0,0,0,,少佐 没搞错USA宇宙部队的航线吧
Dialogue: 0,0:19:40.55,0:19:43.32,Layzner,Carks,0,0,0,,没错 他和我们都是走同一条航线来的
Dialogue: 0,0:19:43.78,0:19:46.92,Layzner,Com,0,0,0,,出发前30秒 启动没有异状
Dialogue: 0,0:19:47.49,0:19:50.62,Layzner,Eiji,0,0,0,,要离开火星会用掉燃料的百分之九十五
Dialogue: 0,0:19:51.03,0:19:53.98,Layzner,Eiji,0,0,0,,如果接触失败的话当然也没办法回来
Dialogue: 0,0:19:53.98,0:19:56.61,Layzner,Eiji,0,0,0,,也有可能在太阳系失速
Dialogue: 0,0:19:56.73,0:20:00.21,Layzner,Com,0,0,0,,主燃料箱 还有36单位 一号燃料箱 还有30单位
Dialogue: 0,0:20:00.21,0:20:03.92,Layzner,Com,0,0,0,,二号燃料箱 还有15单位 离准备发射还有2秒
Dialogue: 0,0:20:04.13,0:20:09.58,Layzner,Com,0,0,0,,危险讯号 3号位置有五架SPT接近 接触区域102
Dialogue: 0,0:20:13.65,0:20:17.39,Layzner,Com,0,0,0,,航天飞机引擎点火 距离发射15秒
Dialogue: 0,0:20:24.19,0:20:24.98,Layzner,Com,0,0,0,,04...
Dialogue: 0,0:20:25.46,0:20:26.38,Layzner,Com,0,0,0,,03...
Dialogue: 0,0:20:28.92,0:20:29.85,Layzner,Com,0,0,0,,01...
Dialogue: 0,0:20:30.41,0:20:31.11,Layzner,Com,0,0,0,,0.
Dialogue: 0,0:20:45.86,0:20:47.70,Layzner,Egyle,0,0,0,,中尉 敌人在上升
Dialogue: 0,0:20:47.85,0:20:49.14,Layzner,Gail,0,0,0,,准备攻击
Dialogue: 0,0:20:57.53,0:21:00.63,Layzner,Com,0,0,0,,推测接触时间 还有32秒

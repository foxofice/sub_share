Dialogue: 0,0:01:30.37,0:01:33.37,DefaultSingle-S,,0,0,0,,
Dialogue: 0,0:01:31.86,0:01:33.74,DefaultSingle-S,,0,0,0,,		为了杀死那个男人
Dialogue: 0,0:01:34.44,0:01:36.74,DefaultSingle-S,,0,0,0,,		我来到这座城市已经几个月了
Dialogue: 0,0:01:37.20,0:01:39.53,DefaultSingle-S,,0,0,0,,		我建立据点  确保收入来源
Dialogue: 0,0:01:39.91,0:01:41.12,DefaultSingle-S,,0,0,0,,		还拓展了人脉
Dialogue: 0,0:01:41.91,0:01:46.16,DefaultSingle-S,,0,0,0,,		我正一步一步地  在通往那个男人的路上…
Dialogue: 0,0:01:47.79,0:01:48.46,DefaultSingle-S,,0,0,0,,		原地踏步
Dialogue: 0,0:01:58.84,0:02:00.18,DefaultSingle-S,,0,0,0,,		都好几个月了
Dialogue: 0,0:02:00.18,0:02:02.89,DefaultSingle-S,,0,0,0,,		杀死那个男人的计划却没有丝毫进展
Dialogue: 0,0:02:02.89,0:02:05.06,DefaultSingle-S,,0,0,0,,		甚至连计划都没有制定出来
Dialogue: 0,0:02:05.31,0:02:08.81,DefaultSingle-S,,0,0,0,,		就连那个男人在米花町的哪里都不知道
Dialogue: 0,0:02:08.94,0:02:12.15,DefaultSingle-S,,0,0,0,,		就算偶尔休息还碰上个好天气  也没时间在这洗衣服啊
Dialogue: 0,0:02:12.77,0:02:14.78,DefaultSingle-S,,0,0,0,,		居然还一时起劲  把被套都洗了
Dialogue: 0,0:02:15.28,0:02:16.90,DefaultSingle-S,,0,0,0,,		我要找到那个男人
Dialogue: 0,0:02:17.45,0:02:18.82,DefaultSingle-S,,0,0,0,,		杀了他
Dialogue: 0,0:02:23.49,0:02:24.37,DefaultSingle-S,,0,0,0,,		东京…
Dialogue: 0,0:02:24.58,0:02:25.95,DefaultSingle-S,,0,0,0,,		好多人
Dialogue: 0,0:02:27.54,0:02:30.08,DefaultSingle-S,,0,0,0,,		都这么久了我还是想说  为什么有这么多人啊
Dialogue: 0,0:02:30.08,0:02:32.09,DefaultSingle-S,,0,0,0,,		日本不是少子化很严重吗
Dialogue: 0,0:02:32.42,0:02:34.84,DefaultSingle-S,,0,0,0,,		要怎么找那个男人
Dialogue: 0,0:02:35.34,0:02:37.38,DefaultSingle-S,,0,0,0,,		简直就像中彩票一样难
Dialogue: 0,0:02:37.47,0:02:42.35,DefaultSingle-S,,0,0,0,,		必须要运气相当好  否则不可能找到那个男人
Dialogue: 0,0:02:42.68,0:02:46.89,DefaultSingle-S,,0,0,0,,		人与人的邂逅  都是多亏了结缘的神明哦
Dialogue: 0,0:02:47.06,0:02:47.98,DefaultSingle-S,,0,0,0,,		是吗
Dialogue: 0,0:02:51.15,0:02:51.98,DefaultSingle-S,,0,0,0,,		左手
Dialogue: 0,0:02:52.44,0:02:53.15,DefaultSingle-S,,0,0,0,,		右手
Dialogue: 0,0:02:53.82,0:02:54.90,DefaultSingle-S,,0,0,0,,		漱口
Dialogue: 0,0:02:55.73,0:02:57.03,DefaultSingle-S,,0,0,0,,		用水冲洗把手
Dialogue: 0,0:02:57.86,0:03:01.11,DefaultSingle-S,,0,0,0,,		路中间是给神明走的  所以要走两边
Dialogue: 0,0:03:06.79,0:03:07.58,DefaultSingle-S,,0,0,0,,		鞠躬两次
Dialogue: 0,0:03:08.33,0:03:09.16,DefaultSingle-S,,0,0,0,,		拍手两次
Dialogue: 0,0:03:09.71,0:03:11.71,DefaultSingle-S,,0,0,0,,		请保佑我找到那个男人
Dialogue: 0,0:03:12.08,0:03:12.83,DefaultSingle-S,,0,0,0,,		鞠躬一次
Dialogue: 0,0:03:13.33,0:03:13.84,DefaultSingle-S,,0,0,0,,		好
Dialogue: 0,0:03:14.09,0:03:17.63,DefaultSingle-S,,0,0,0,,		我来抽神签试试运气  看看神明有没有听到我的愿望吧
Dialogue: 0,0:03:19.05,0:03:20.01,DefaultSingle-S,,0,0,0,,		凶
Dialogue: 0,0:03:20.09,0:03:23.51,DefaultSingle-S,,0,0,0,,		放弃愿望吧  梦想会破灭  心愿无法实现  不要结仇
Dialogue: 0,0:03:23.51,0:03:25.14,DefaultSingle-S,,0,0,0,,		逃离勒索者  逃离伤人狂
Dialogue: 0,0:03:25.14,0:03:27.43,DefaultSingle-S,,0,0,0,,		无法转出  结婚希望渺茫  努力吧
Dialogue: 0,0:03:27.52,0:03:29.10,DefaultSingle-S,,0,0,0,,		犯罪会暴露  不能干
Dialogue: 0,0:03:30.27,0:03:33.77,DefaultSingle-S,,0,0,0,,		不过  这只是玩玩而已  根本不可信
Dialogue: 0,0:03:34.02,0:03:35.23,DefaultSingle-S,,0,0,0,,		一日百善？
Dialogue: 0,0:03:35.23,0:03:38.48,DefaultSingle-S,,0,0,0,,		「行善积德  人生必将一马平川」
Dialogue: 0,0:03:40.90,0:03:43.99,DefaultSingle-S,,0,0,0,,		乌鸦叫喳喳  回家吧
Dialogue: 0,0:03:43.99,0:03:45.45,DefaultSingle-S,,0,0,0,,		我们就在回家路上  元太
Dialogue: 0,0:03:45.45,0:03:46.95,DefaultSingle-S,,0,0,0,,		辛苦啦
Dialogue: 0,0:03:49.08,0:03:51.08,DefaultSingle-S,,0,0,0,,		居然在捡垃圾  真善良啊
Dialogue: 0,0:03:51.08,0:03:52.29,DefaultSingle-S,,0,0,0,,		还是有好人的啊
Dialogue: 0,0:03:52.29,0:03:55.17,DefaultSingle-S,,0,0,0,,		这座城市也还是有优点的嘛
Dialogue: 0,0:03:59.26,0:04:02.22,DefaultSingle-S,,0,0,0,,		被人感谢真是令人心情舒畅啊
Dialogue: 0,0:04:02.59,0:04:04.84,DefaultSingle-S,,0,0,0,,		这也是为了杀死那个男人
Dialogue: 0,0:04:05.30,0:04:09.31,DefaultSingle-S,,0,0,0,,		而且还能让街道变干净  可以说是双赢
Dialogue: 0,0:04:11.68,0:04:12.81,DefaultSingle-S,,0,0,0,,		杀了你
Dialogue: 0,0:04:13.10,0:04:16.11,DefaultSingle-S,,0,0,0,,		真亏他好意思当着捡垃圾的人的面扔垃圾
Dialogue: 0,0:04:16.61,0:04:19.36,DefaultSingle-S,,0,0,0,,		这座城市的居民怕不是心都死了吧
Dialogue: 0,0:04:20.65,0:04:21.74,DefaultSingle-S,,0,0,0,,		这是什么啊
Dialogue: 0,0:04:22.99,0:04:23.65,DefaultSingle-S,,0,0,0,,		针？
Dialogue: 0,0:04:23.82,0:04:26.32,DefaultSingle-S,,0,0,0,,		好危险啊  这可是学生的必经之路啊
Dialogue: 0,0:04:26.32,0:04:29.20,DefaultSingle-S,,0,0,0,,		说不定会被狗误吞下去
Dialogue: 0,0:04:29.87,0:04:30.91,DefaultSingle-S,,0,0,0,,		还有
Dialogue: 0,0:04:31.37,0:04:32.12,DefaultSingle-S,,0,0,0,,		这里也有
Dialogue: 0,0:04:32.12,0:04:34.08,DefaultSingle-S,,0,0,0,,		为什么会有这么多针啊
Dialogue: 0,0:04:37.50,0:04:40.80,DefaultSingle-S,,0,0,0,,		总感觉离那个男人越来越远了
Dialogue: 0,0:04:40.92,0:04:45.22,DefaultSingle-S,,0,0,0,,		还是普通地在车站前转悠  才更有可能找到那个男人吧
Dialogue: 0,0:04:45.34,0:04:47.01,DefaultSingle-S,,0,0,0,,		我是不是浪费了一天啊
Dialogue: 0,0:04:48.22,0:04:49.51,DefaultSingle-S,,0,0,0,,		侦探事务所
Dialogue: 0,0:04:50.35,0:04:51.35,DefaultSingle-S,,0,0,0,,		对了
Dialogue: 0,0:04:57.61,0:05:00.73,DefaultSingle-S,,0,0,0,,		对了  请侦探找那个男人不就好了吗
Dialogue: 0,0:05:01.11,0:05:02.82,DefaultSingle-S,,0,0,0,,		侦探可是找人专家
Dialogue: 0,0:05:02.82,0:05:04.40,DefaultSingle-S,,0,0,0,,		没想到还有这一手
Dialogue: 0,0:05:04.40,0:05:05.24,DefaultSingle-S,,0,0,0,,		好主意
Dialogue: 0,0:05:05.24,0:05:06.36,DefaultSingle-S,,0,0,0,,		谢谢你  神明
Dialogue: 0,0:05:06.57,0:05:08.20,DefaultSingle-S,,0,0,0,,		不用谢
Dialogue: 0,0:05:08.41,0:05:09.37,DefaultSingle-S,,0,0,0,,		你好
Dialogue: 0,0:05:09.49,0:05:11.70,DefaultSingle-S,,0,0,0,,		那个  我想找一个人
Dialogue: 0,0:05:12.54,0:05:13.87,DefaultSingle-S,,0,0,0,,		找人吗
Dialogue: 0,0:05:14.96,0:05:15.67,DefaultSingle-S,,0,0,0,,		我扔
Dialogue: 0,0:05:20.67,0:05:23.01,DefaultSingle-S,,0,0,0,,		这家伙就是到处扔针的犯人？
Dialogue: 0,0:05:23.71,0:05:26.97,DefaultSingle-S,,0,0,0,,		你想找谁呢
Dialogue: 0,0:05:26.97,0:05:31.22,DefaultSingle-S,,0,0,0,,		是一个疯狂往路上扔针的坏蛋
Dialogue: 0,0:05:31.22,0:05:32.81,DefaultSingle-S,,0,0,0,,		这可真过分
Dialogue: 0,0:05:33.10,0:05:34.98,DefaultSingle-S,,0,0,0,,		看上去四十多岁  男性
Dialogue: 0,0:05:35.31,0:05:37.56,DefaultSingle-S,,0,0,0,,		蓄着小胡子  穿着一身皱巴巴的西装
Dialogue: 0,0:05:38.69,0:05:39.65,DefaultSingle-S,,0,0,0,,		而且
Dialogue: 0,0:05:40.77,0:05:44.36,DefaultSingle-S,,0,0,0,,		和鲜红的血很搭
Dialogue: 0,0:05:44.90,0:05:45.86,DefaultSingle-S,,0,0,0,,		我回来了
Dialogue: 0,0:05:58.17,0:05:59.79,DefaultSingle-S,,0,0,0,,		不好意思  你说什么来着
Dialogue: 0,0:05:59.88,0:06:02.34,DefaultSingle-S,,0,0,0,,		我最近推理完之后困得不行
Dialogue: 0,0:06:02.34,0:06:04.01,DefaultSingle-S,,0,0,0,,		是不是上年纪了啊
Dialogue: 0,0:06:04.80,0:06:05.30,DefaultSingle-S,,0,0,0,,		人呢
Dialogue: 0,0:06:10.89,0:06:12.22,DefaultSingle-S,,0,0,0,,		差点被杀掉
Dialogue: 0,0:06:12.64,0:06:16.64,DefaultSingle-S,,0,0,0,,		没想到会撞见那时候的头顶神秘尖角的超强女高中生
Dialogue: 0,0:06:16.64,0:06:18.60,DefaultSingle-S,,0,0,0,,		这也是结缘力量？
Dialogue: 0,0:06:18.60,0:06:19.56,DefaultSingle-S,,0,0,0,,		算是吧
Dialogue: 0,0:06:21.31,0:06:23.73,DefaultSingle-S,,0,0,0,,		要怎么找那个男人啊
Dialogue: 0,0:06:23.98,0:06:26.53,DefaultSingle-S,,0,0,0,,		要不要委托那几个侦探同事啊
Dialogue: 0,0:06:26.53,0:06:28.28,DefaultSingle-S,,0,0,0,,		但是他们那么忙
Dialogue: 0,0:06:28.28,0:06:29.36,DefaultSingle-S,,0,0,0,,		我们早退
Dialogue: 0,0:06:29.36,0:06:31.37,DefaultSingle-S,,0,0,0,,		刚才那个小胡子看上去很闲  可是…
Dialogue: 0,0:06:32.87,0:06:34.45,DefaultSingle-S,,0,0,0,,		还是不求神了
Dialogue: 0,0:06:34.54,0:06:36.45,DefaultSingle-S,,0,0,0,,		这事也不是积德就能实现的
Dialogue: 0,0:06:36.70,0:06:38.71,DefaultSingle-S,,0,0,0,,		还是只能老老实实地找了
Dialogue: 0,0:06:56.27,0:06:57.56,DefaultSingle-S,,0,0,0,,		找到了
Dialogue: 0,0:08:31.90,0:08:33.74,DefaultSingle-S,,0,0,0,,		终于到这个时候了
Dialogue: 0,0:08:33.86,0:08:37.28,DefaultSingle-S,,0,0,0,,		居然花了11集才找到目标  真是失算了
Dialogue: 0,0:08:37.28,0:08:39.95,DefaultSingle-S,,0,0,0,,		让我在最后一集上演盛大的终幕吧
Dialogue: 0,0:08:40.33,0:08:41.12,DefaultSingle-S,,0,0,0,,		然后
Dialogue: 0,0:08:41.12,0:08:43.37,DefaultSingle-S,,0,0,0,,		感谢演唱片头曲的新滨列昂先生
Dialogue: 0,0:08:43.37,0:08:46.21,DefaultSingle-S,,0,0,0,,		用动人的片尾曲装点节目的仓木麻衣小姐
Dialogue: 0,0:08:46.21,0:08:48.96,DefaultSingle-S,,0,0,0,,		还有坚持跑到最后的大地丙太郎导演
Dialogue: 0,0:08:48.96,0:08:51.01,DefaultSingle-S,,0,0,0,,		谢谢你们
Dialogue: 0,0:08:51.01,0:08:54.18,DefaultSingle-S,,0,0,0,,		我终于要成为心心念念的犯人了
Dialogue: 0,0:08:54.18,0:08:56.30,DefaultSingle-S,,0,0,0,,		下集「第一个目标」
Dialogue: 0,0:08:56.30,0:08:58.72,DefaultSingle-S,,0,0,0,,		犯泽  要上啦
Dialogue: 0,0:01:46.42,0:01:46.61,DefaultSingle-S,,0,0,0,,

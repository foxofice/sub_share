Dialogue: 0,0:01:39.16,0:01:41.49,DefaultSingle-T,,0,0,0,,	是的  案件解決了
Dialogue: 0,0:01:41.74,0:01:43.75,DefaultSingle-T,,0,0,0,,	多虧了毛利名偵探
Dialogue: 0,0:01:44.16,0:01:45.33,DefaultSingle-T,,0,0,0,,	是嗎
Dialogue: 0,0:01:45.46,0:01:48.58,DefaultSingle-T,,0,0,0,,	話說回來  你要在那個偵探身邊待到什麼時候啊
Dialogue: 0,0:01:49.04,0:01:53.38,DefaultSingle-T,,0,0,0,,	通過基爾那件事  我們懷疑那個偵探和雪莉有關聯
Dialogue: 0,0:01:53.38,0:01:55.72,DefaultSingle-T,,0,0,0,,	你說想監視他
Dialogue: 0,0:01:55.72,0:01:57.55,DefaultSingle-T,,0,0,0,,	所以我才幫了你
Dialogue: 0,0:01:58.84,0:02:00.55,DefaultSingle-T,,0,0,0,,	現在已經沒必要了吧
Dialogue: 0,0:02:00.97,0:02:03.89,DefaultSingle-T,,0,0,0,,	幸運的是  你通過他取得了雪莉的情報
Dialogue: 0,0:02:04.31,0:02:07.56,DefaultSingle-T,,0,0,0,,	雪莉也已經除掉了
Dialogue: 0,0:02:07.98,0:02:11.06,DefaultSingle-T,,0,0,0,,	不  我對沉睡的小五郎這個偵探
Dialogue: 0,0:02:11.61,0:02:14.03,DefaultSingle-T,,0,0,0,,	有了極大的興趣
Dialogue: 0,0:02:14.53,0:02:16.53,DefaultSingle-T,,0,0,0,,	沉睡的小五郎啊
Dialogue: 0,0:02:17.99,0:02:22.16,DefaultSingle-T,,0,0,0,,	你要是能順便調查一下他安睡的祕訣就好了
Dialogue: 0,0:02:22.53,0:02:23.99,DefaultSingle-T,,0,0,0,,	你睡不著嗎
Dialogue: 0,0:02:24.12,0:02:25.20,DefaultSingle-T,,0,0,0,,	是啊
Dialogue: 0,0:02:26.79,0:02:29.83,DefaultSingle-T,,0,0,0,,	原來你也有這種大眾煩惱啊
Dialogue: 0,0:02:29.83,0:02:32.71,DefaultSingle-T,,0,0,0,,	我說  你把人家當什麼了啊
Dialogue: 0,0:02:34.09,0:02:37.42,DefaultSingle-T,,0,0,0,,	不建議剛洗完澡就睡覺
Dialogue: 0,0:02:37.63,0:02:41.64,DefaultSingle-T,,0,0,0,,	因為此時深部體溫較高  無法進入深層睡眠
Dialogue: 0,0:02:42.22,0:02:45.06,DefaultSingle-T,,0,0,0,,	手機  電腦的藍光會促人清醒
Dialogue: 0,0:02:45.39,0:02:47.85,DefaultSingle-T,,0,0,0,,	在睡前使用是大忌
Dialogue: 0,0:02:48.98,0:02:50.65,DefaultSingle-T,,0,0,0,,	你該不會在喝酒吧
Dialogue: 0,0:02:51.19,0:02:53.06,DefaultSingle-T,,0,0,0,,	嗯  在喝
Dialogue: 0,0:02:56.07,0:02:57.57,DefaultSingle-T,,0,0,0,,	在你的文化圈
Dialogue: 0,0:02:57.57,0:03:01.95,DefaultSingle-T,,0,0,0,,	被稱為「Nightcap」的睡前酒能促進入睡
Dialogue: 0,0:03:02.53,0:03:04.74,DefaultSingle-T,,0,0,0,,	但那樣會使睡眠變淺  降低睡眠品質
Dialogue: 0,0:03:05.16,0:03:10.16,DefaultSingle-T,,0,0,0,,	因此  我推薦不含咖啡因的梅子海帶茶
Dialogue: 0,0:03:10.92,0:03:13.54,DefaultSingle-T,,0,0,0,,	它含有檸檬酸  鈉  鉀
Dialogue: 0,0:03:13.67,0:03:16.55,DefaultSingle-T,,0,0,0,,	具有緩解疲勞  放鬆身心的功效
Dialogue: 0,0:03:17.80,0:03:19.92,DefaultSingle-T,,0,0,0,,	等我有心情的時候試試
Dialogue: 0,0:03:21.97,0:03:23.43,DefaultSingle-T,,0,0,0,,	好的  請務必試試
Dialogue: 0,0:03:33.06,0:03:34.40,DefaultSingle-T,,0,0,0,,	明天要去警視廳
Dialogue: 0,0:03:35.57,0:03:37.23,DefaultSingle-T,,0,0,0,,	在那之前要去白羅
Dialogue: 0,0:03:37.90,0:03:40.24,DefaultSingle-T,,0,0,0,,	能睡個90分鐘啊
Dialogue: 0,0:04:07.35,0:04:08.97,DefaultSingle-T,,0,0,0,,	喂  你好慢
Dialogue: 0,0:04:09.18,0:04:11.06,DefaultSingle-T,,0,0,0,,	快點來啊  零
Dialogue: 0,0:04:24.03,0:04:25.95,DefaultSingle-T,,0,0,0,,	睡眠變淺了
Dialogue: 0,0:04:28.62,0:04:32.21,DefaultSingle-T,,0,0,0,,	虧我還給別人支招  真是自作自受
Dialogue: 0,0:04:35.50,0:04:37.04,DefaultSingle-T,,0,0,0,,	你睡眠不足嗎
Dialogue: 0,0:04:37.34,0:04:41.30,DefaultSingle-T,,0,0,0,,	肯定是窩在被窩裡玩手機到很晚吧
Dialogue: 0,0:04:41.55,0:04:42.34,DefaultSingle-T,,0,0,0,,	是啊
Dialogue: 0,0:04:42.76,0:04:45.76,DefaultSingle-T,,0,0,0,,	手機的光在睡前是大忌
Dialogue: 0,0:04:46.47,0:04:48.85,DefaultSingle-T,,0,0,0,,	如果睡不著  要不要喝點茶呢
Dialogue: 0,0:04:49.51,0:04:52.06,DefaultSingle-T,,0,0,0,,	梅子海帶茶會不會太俗氣了啊
Dialogue: 0,0:04:57.52,0:04:58.94,DefaultSingle-T,,0,0,0,,	警視廳呼叫中央區
Dialogue: 0,0:04:59.19,0:05:02.34,DefaultSingle-T,,0,0,0,,	嫌疑人駕駛深藍色轎車  正朝20號國道行駛
Dialogue: 0,0:05:02.61,0:05:05.74,DefaultSingle-T,,0,0,0,,	搜查員立刻趕赴現場  攔停車輛進行盤問
Dialogue: 0,0:05:10.37,0:05:11.79,DefaultSingle-T,,0,0,0,,	靠左停車
Dialogue: 0,0:05:12.29,0:05:13.12,DefaultSingle-T,,0,0,0,,	停車
Dialogue: 0,0:05:28.43,0:05:29.93,DefaultSingle-T,,0,0,0,,	喂  你沒事吧
Dialogue: 0,0:05:31.64,0:05:33.89,DefaultSingle-T,,0,0,0,,	看來腿骨折了
Dialogue: 0,0:05:34.27,0:05:35.73,DefaultSingle-T,,0,0,0,,	你自己能叫救護車吧
Dialogue: 0,0:05:35.89,0:05:36.69,DefaultSingle-T,,0,0,0,,	借用一下
Dialogue: 0,0:05:36.89,0:05:38.56,DefaultSingle-T,,0,0,0,,	借  借用？
Dialogue: 0,0:05:39.19,0:05:39.73,DefaultSingle-T,,0,0,0,,	等…
Dialogue: 0,0:05:40.48,0:05:41.77,DefaultSingle-T,,0,0,0,,	等一下
Dialogue: 0,0:06:18.02,0:06:18.64,DefaultSingle-T,,0,0,0,,	該死的
Dialogue: 0,0:06:32.24,0:06:35.04,DefaultSingle-T,,0,0,0,,	《道路交通法》第71條第4款
Dialogue: 0,0:06:35.58,0:06:37.96,DefaultSingle-T,,0,0,0,,	駕駛大型兩輪機動車時
Dialogue: 0,0:06:39.00,0:06:42.42,DefaultSingle-T,,0,0,0,,	必須佩戴頭盔
Dialogue: 0,0:06:44.30,0:06:45.46,DefaultSingle-T,,0,0,0,,	沒錯吧
Dialogue: 0,0:07:14.91,0:07:17.24,DefaultSingle-T,,0,0,0,,	對不起
Dialogue: 0,0:07:18.79,0:07:20.71,DefaultSingle-T,,0,0,0,,	喂  是警察嗎
Dialogue: 0,0:07:21.33,0:07:23.58,DefaultSingle-T,,0,0,0,,	東都灣碼頭有一輛可疑車輛
Dialogue: 0,0:07:23.67,0:07:25.46,DefaultSingle-T,,0,0,0,,	還有被丟棄的警用摩托
Dialogue: 0,0:07:26.25,0:07:28.42,DefaultSingle-T,,0,0,0,,	是的  請火速趕來
Dialogue: 0,0:07:46.27,0:07:50.07,DefaultSingle-T,,0,0,0,,	北緯35度41分39秒
Dialogue: 0,0:07:50.90,0:07:54.74,DefaultSingle-T,,0,0,0,,	東經139度45分29秒
Dialogue: 0,0:07:59.12,0:08:02.29,DefaultSingle-T,,0,0,0,,	非常抱歉  現在沒有空桌了
Dialogue: 0,0:08:03.96,0:08:05.58,DefaultSingle-T,,0,0,0,,	能和您拼桌嗎
Dialogue: 0,0:08:06.09,0:08:07.09,DefaultSingle-T,,0,0,0,,	好的
Dialogue: 0,0:08:07.25,0:08:08.88,DefaultSingle-T,,0,0,0,,	非常感謝
Dialogue: 0,0:08:11.22,0:08:12.26,DefaultSingle-T,,0,0,0,,	多謝款待
Dialogue: 0,0:08:12.43,0:08:14.22,DefaultSingle-T,,0,0,0,,	謝謝惠顧
Dialogue: 0,0:08:16.22,0:08:18.51,DefaultSingle-T,,0,0,0,,	你頭上的傷是怎麼了
Dialogue: 0,0:08:18.85,0:08:21.02,DefaultSingle-T,,0,0,0,,	昨天一不小心…
Dialogue: 0,0:08:21.43,0:08:23.85,DefaultSingle-T,,0,0,0,,	說到昨天  就想到那個逃犯
Dialogue: 0,0:08:24.35,0:08:28.02,DefaultSingle-T,,0,0,0,,	據說在東都港碼頭抓到了  警用摩托也在那裡
Dialogue: 0,0:08:28.73,0:08:32.70,DefaultSingle-T,,0,0,0,,	駕駛警用摩托追捕犯人的人仍在調查
Dialogue: 0,0:08:33.28,0:08:35.49,DefaultSingle-T,,0,0,0,,	但似乎進展緩慢
Dialogue: 0,0:08:36.03,0:08:37.12,DefaultSingle-T,,0,0,0,,	傷勢如何
Dialogue: 0,0:08:37.66,0:08:41.08,DefaultSingle-T,,0,0,0,,	腿骨折了  一個月後應該能…
Dialogue: 0,0:08:41.70,0:08:44.96,DefaultSingle-T,,0,0,0,,	降谷先生  你怎麼知道那個警察受傷了啊
Dialogue: 0,0:08:46.00,0:08:48.84,DefaultSingle-T,,0,0,0,,	道聽途說的而已
Dialogue: 0,0:08:49.21,0:08:50.46,DefaultSingle-T,,0,0,0,,	話說回來
Dialogue: 0,0:08:51.05,0:08:53.01,DefaultSingle-T,,0,0,0,,	請問需要點什麼呢
Dialogue: 0,0:08:53.17,0:08:55.47,DefaultSingle-T,,0,0,0,,	雞肉咖哩  中辣
Dialogue: 0,0:08:55.55,0:08:57.68,DefaultSingle-T,,0,0,0,,	我要牛肉咖哩  超辣的
Dialogue: 0,0:08:58.05,0:09:01.93,DefaultSingle-T,,0,0,0,,	本店的超辣咖哩非常刺激  沒問題嗎
Dialogue: 0,0:09:01.93,0:09:04.56,DefaultSingle-T,,0,0,0,,	沒問題  放馬過來
Dialogue: 0,0:09:06.81,0:09:08.27,DefaultSingle-T,,0,0,0,,	好辣的樣子
Dialogue: 0,0:09:08.86,0:09:12.99,DefaultSingle-T,,0,0,0,,	激發了我的挑戰欲  越辣就越來勁
Dialogue: 0,0:09:13.44,0:09:15.15,DefaultSingle-T,,0,0,0,,	有種嚴陣以待的感覺
Dialogue: 0,0:09:15.40,0:09:16.28,DefaultSingle-T,,0,0,0,,	好了
Dialogue: 0,0:09:19.49,0:09:21.58,DefaultSingle-T,,0,0,0,,	這裡的咖哩味道很濃
Dialogue: 0,0:09:21.66,0:09:23.33,DefaultSingle-T,,0,0,0,,	比起紅色的七味醃菜
Dialogue: 0,0:09:23.75,0:09:26.83,DefaultSingle-T,,0,0,0,,	店家自製的白色酸藠頭會更搭調
Dialogue: 0,0:09:27.54,0:09:30.04,DefaultSingle-T,,0,0,0,,	它營養豐富  又助消化
Dialogue: 0,0:09:30.21,0:09:32.05,DefaultSingle-T,,0,0,0,,	不過  只是我個人喜好而已
Dialogue: 0,0:09:33.76,0:09:36.59,DefaultSingle-T,,0,0,0,,	我也想放藠頭來著
Dialogue: 0,0:09:38.39,0:09:39.93,DefaultSingle-T,,0,0,0,,	我開動了
Dialogue: 0,0:09:41.31,0:09:41.72,DefaultSingle-T,,0,0,0,,	燙
Dialogue: 0,0:09:46.10,0:09:48.35,DefaultSingle-T,,0,0,0,,	雖然分開吃也不錯
Dialogue: 0,0:09:48.98,0:09:53.32,DefaultSingle-T,,0,0,0,,	但我還是更喜歡把馬鈴薯拌在咖哩裡吃
Dialogue: 0,0:09:58.03,0:09:59.57,DefaultSingle-T,,0,0,0,,	好好吃的樣子
Dialogue: 0,0:10:02.37,0:10:03.87,DefaultSingle-T,,0,0,0,,	好  我也這樣吃
Dialogue: 0,0:10:04.16,0:10:05.83,DefaultSingle-T,,0,0,0,,	放馬過來吧
Dialogue: 0,0:10:06.08,0:10:08.21,DefaultSingle-T,,0,0,0,,	超辣咖哩
Dialogue: 0,0:10:10.46,0:10:12.17,DefaultSingle-T,,0,0,0,,	好  好辣
Dialogue: 0,0:10:13.05,0:10:14.00,DefaultSingle-T,,0,0,0,,	我啊
Dialogue: 0,0:10:14.63,0:10:19.13,DefaultSingle-T,,0,0,0,,	吃咖哩的時候不喝水的
Dialogue: 0,0:10:20.64,0:10:23.39,DefaultSingle-T,,0,0,0,,	因為  這樣對咖哩很失禮
Dialogue: 0,0:10:23.72,0:10:26.06,DefaultSingle-T,,0,0,0,,	失  失禮？
Dialogue: 0,0:10:26.06,0:10:28.73,DefaultSingle-T,,0,0,0,,	因為喝水會沖淡這絕美的咖哩
Dialogue: 0,0:10:28.85,0:10:30.86,DefaultSingle-T,,0,0,0,,	所  所言極是
Dialogue: 0,0:10:31.98,0:10:36.32,DefaultSingle-T,,0,0,0,,	喝水解辣其實也只會適得其反
Dialogue: 0,0:10:37.07,0:10:40.41,DefaultSingle-T,,0,0,0,,	咖哩的辣味源於辣椒素  這是種斥水親脂的物質
Dialogue: 0,0:10:40.57,0:10:45.33,DefaultSingle-T,,0,0,0,,	喝水反而會讓辣味遍佈整個舌頭  覺得更辣
Dialogue: 0,0:10:47.25,0:10:50.08,DefaultSingle-T,,0,0,0,,	在把咖哩全部吃完之後再喝水就行
Dialogue: 0,0:10:50.29,0:10:52.63,DefaultSingle-T,,0,0,0,,	好辣
Dialogue: 0,0:11:00.43,0:11:02.93,DefaultSingle-T,,0,0,0,,	好  好辣
Dialogue: 0,0:11:05.60,0:11:07.27,DefaultSingle-T,,0,0,0,,	好  好吃
Dialogue: 0,0:11:17.69,0:11:18.94,DefaultSingle-T,,0,0,0,,	真好吃
Dialogue: 0,0:11:19.36,0:11:21.91,DefaultSingle-T,,0,0,0,,	風見  超辣咖哩怎麼樣
Dialogue: 0,0:11:23.49,0:11:24.20,DefaultSingle-T,,0,0,0,,	風見？
Dialogue: 0,0:11:32.63,0:11:33.88,DefaultSingle-T,,0,0,0,,	好吃
Dialogue: 0,0:11:34.25,0:11:36.96,DefaultSingle-T,,0,0,0,,	水…不好
Dialogue: 0,0:11:37.17,0:11:38.88,DefaultSingle-T,,0,0,0,,	辣味又加劇了
Dialogue: 0,0:11:39.84,0:11:40.76,DefaultSingle-T,,0,0,0,,	是吧
Dialogue: 0,0:11:41.01,0:11:43.01,DefaultSingle-T,,0,0,0,,	這裡的咖哩就是…
Dialogue: 0,0:11:44.60,0:11:45.26,DefaultSingle-T,,0,0,0,,	喂
Dialogue: 0,0:11:55.48,0:11:58.78,DefaultSingle-T,,0,0,0,,	對不起  讓你見笑了
Dialogue: 0,0:13:29.24,0:13:30.53,DefaultSingle-T,,0,0,0,,	TIME.4
Comment: 0,0:03:40.07,0:03:42.07,DefaultSingle-S,,0,0,0,,

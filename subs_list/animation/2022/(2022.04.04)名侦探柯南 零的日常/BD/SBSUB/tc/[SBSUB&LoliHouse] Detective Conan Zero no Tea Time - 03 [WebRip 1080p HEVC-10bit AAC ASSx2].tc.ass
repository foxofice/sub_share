Comment: 0,0:00:33.01,0:00:33.01,TEATIME-OP-BOTTOM,,0,0,0,,
Dialogue: 0,0:00:31.97,0:00:34.01,TEATIME-OP-BOTTOM,,0,0,0,,Get the Volume up
Dialogue: 0,0:00:34.01,0:00:35.89,TEATIME-OP-BOTTOM,,0,0,0,,飛馳於失去色彩的Highway
Dialogue: 0,0:00:35.89,0:00:39.94,TEATIME-OP-BOTTOM,,0,0,0,,在停滯的時間中 turn me on
Dialogue: 0,0:00:39.94,0:00:42.15,TEATIME-OP-BOTTOM,,0,0,0,,the truth is always blind
Dialogue: 0,0:00:42.15,0:00:44.07,TEATIME-OP-BOTTOM,,0,0,0,,虛假的話語
Dialogue: 0,0:00:44.07,0:00:48.15,TEATIME-OP-BOTTOM,,0,0,0,,也重疊於今日 聲音消散
Dialogue: 0,0:00:48.90,0:00:50.61,TEATIME-OP-BOTTOM,,0,0,0,,急切渴求的理由
Dialogue: 0,0:00:50.91,0:00:53.37,TEATIME-OP-BOTTOM,,0,0,0,,也在城市天空的盡頭
Dialogue: 0,0:00:53.37,0:00:57.66,TEATIME-OP-BOTTOM,,0,0,0,,清晰可見
Dialogue: 0,0:00:57.66,0:01:00.21,TEATIME-OP-BOTTOM,,0,0,0,,世界Like a Shooting Star
Dialogue: 0,0:01:00.21,0:01:02.25,TEATIME-OP-BOTTOM,,0,0,0,,若知曉心願
Dialogue: 0,0:01:02.25,0:01:04.04,TEATIME-OP-BOTTOM,,0,0,0,,不論何人
Dialogue: 0,0:01:04.04,0:01:06.50,TEATIME-OP-BOTTOM,,0,0,0,,都會深陷瞬間而永恆的夢
Dialogue: 0,0:01:06.50,0:01:08.09,TEATIME-OP-BOTTOM,,0,0,0,,若知曉「哀傷」
Dialogue: 0,0:01:08.09,0:01:10.38,TEATIME-OP-BOTTOM,,0,0,0,,便能回歸零點Tears in Lies
Dialogue: 0,0:01:10.38,0:01:14.10,TEATIME-OP-BOTTOM,,0,0,0,,即便知曉善惡之罪
Dialogue: 0,0:01:14.10,0:01:20.89,TEATIME-OP-BOTTOM,,0,0,0,,也要抬頭鎖定目標
Comment: 0,0:12:13.75,0:12:16.76,TEATIME-ED-BOTTOM,,0,0,0,,
Dialogue: 0,0:12:16.88,0:12:21.85,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	無色透明的我
Dialogue: 0,0:12:22.26,0:12:26.81,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	駐足於緋紅的天空下
Dialogue: 0,0:12:27.81,0:12:34.65,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便憎惡這不近人情的世界
Dialogue: 0,0:12:35.07,0:12:38.74,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也無法逃離 Decided
Dialogue: 0,0:12:39.57,0:12:43.99,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	將手伸向光芒
Dialogue: 0,0:12:39.57,0:12:43.99,TEATIME-ED-BOTTOM,ED,0,0,0,,{\pos(1034,1032)}	{\blur3\fs34}	明天
Dialogue: 0,0:12:43.99,0:12:49.08,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday
Dialogue: 0,0:12:49.08,0:12:54.38,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	不懈追逐 仍遙不可及
Dialogue: 0,0:12:54.38,0:13:00.01,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便想要守護之物不復存在
Dialogue: 0,0:13:00.18,0:13:04.64,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也只能繼續掙扎
Dialogue: 0,0:13:04.64,0:13:06.14,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	你聽
Dialogue: 0,0:13:06.14,0:13:10.89,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, promise to yourself
Dialogue: 0,0:13:10.89,0:13:16.36,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	用無數張面孔塗改未來
Dialogue: 0,0:13:16.36,0:13:23.99,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3\fad(0,200}	將一去不返的時光深藏於心
Comment: 0,0:03:08.00,0:03:08.00,Title,,0,0,0,,
Dialogue: 0,0:00:31.97,0:00:34.01,TEATIME-OP-TOP,,0,0,0,,Get the Volume up
Dialogue: 0,0:00:34.01,0:00:35.89,TEATIME-OP-TOP,,0,0,0,,色を無くしたHighway
Dialogue: 0,0:00:35.89,0:00:39.94,TEATIME-OP-TOP,,0,0,0,,止まってしまった時間に turn me on
Dialogue: 0,0:00:39.94,0:00:42.15,TEATIME-OP-TOP,,0,0,0,,the truth is always blind
Dialogue: 0,0:00:42.15,0:00:44.07,TEATIME-OP-TOP,,0,0,0,,偽りの声も
Dialogue: 0,0:00:44.07,0:00:48.15,TEATIME-OP-TOP,,0,0,0,,重なる今日に音が消える
Dialogue: 0,0:00:48.90,0:00:50.61,TEATIME-OP-TOP,,0,0,0,,焦がれ求む理由も
Dialogue: 0,0:00:50.91,0:00:53.37,TEATIME-OP-TOP,,0,0,0,,街の空の果てに
Dialogue: 0,0:00:53.37,0:00:57.66,TEATIME-OP-TOP,,0,0,0,,見える
Dialogue: 0,0:00:57.66,0:01:00.21,TEATIME-OP-TOP,,0,0,0,,世界はLike a Shooting Star
Dialogue: 0,0:01:00.21,0:01:02.25,TEATIME-OP-TOP,,0,0,0,,願いを知れば
Dialogue: 0,0:01:02.25,0:01:04.04,TEATIME-OP-TOP,,0,0,0,,一瞬が永遠の
Dialogue: 0,0:01:04.04,0:01:06.50,TEATIME-OP-TOP,,0,0,0,,夢に誰も捉われる
Dialogue: 0,0:01:06.50,0:01:08.09,TEATIME-OP-TOP,,0,0,0,,「哀」を知れば
Dialogue: 0,0:01:08.09,0:01:10.38,TEATIME-OP-TOP,,0,0,0,,ゼロに戻るTears in Lies
Dialogue: 0,0:01:10.38,0:01:14.10,TEATIME-OP-TOP,,0,0,0,,善悪の罪を知る
Dialogue: 0,0:01:14.10,0:01:20.89,TEATIME-OP-TOP,,0,0,0,,それでも顔上げ狙い定める
Dialogue: 0,0:00:53.07,0:00:53.07,Title,,0,0,0,,
Comment: 0,0:03:08.00,0:03:08.00,Title,,0,0,0,,
Dialogue: 0,0:12:16.88,0:12:21.85,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	透明な僕をみていた
Dialogue: 0,0:12:22.26,0:12:26.81,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	空があかく染まって
Dialogue: 0,0:12:27.81,0:12:34.65,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	不条理を憎んでもここからは
Dialogue: 0,0:12:35.07,0:12:38.74,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	逃げ出せないから Decided
Dialogue: 0,0:12:39.57,0:12:43.99,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	光へ手をのばして
Dialogue: 0,0:12:39.57,0:12:43.99,TEATIME-ED-TOP,ED,0,0,0,,{\pos(842,3)}	{\blur3\fs28}	あした
Dialogue: 0,0:12:43.99,0:12:49.08,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday

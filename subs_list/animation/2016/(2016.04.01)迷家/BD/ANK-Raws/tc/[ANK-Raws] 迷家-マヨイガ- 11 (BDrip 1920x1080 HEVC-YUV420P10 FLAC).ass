Dialogue: 0,0:24:23.73,0:24:26.98,Title,,0,0,0,,{\blur1\pos(960,735)\an2}納鳴乃心靈之鏡
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------TIPS-------------------
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------PREV-------------------
Dialogue: 0,0:00:28.24,0:00:30.87,Default,,0,0,0,,拜託妳了 原諒我吧
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------TXTA-------------------
Dialogue: 0,0:02:07.05,0:02:09.19,Default,,0,0,0,,喂 回房間吧
Dialogue: 0,0:02:09.70,0:02:11.11,Default,,0,0,0,,會感冒的喔
Dialogue: 0,0:02:11.33,0:02:12.89,Default,,0,0,0,,來 手給我
Dialogue: 0,0:02:12.93,0:02:16.33,Default,,0,0,0,,哇　屁股被蚊子咬了 好癢
Dialogue: 0,0:02:16.38,0:02:19.03,Default,,0,0,0,,豆奶拿鐵 我要陪睡
Dialogue: 0,0:02:19.11,0:02:20.50,Default,,0,0,0,,你們是怎麼了
Dialogue: 0,0:02:20.93,0:02:22.24,Default,,0,0,0,,為什麼這麼廢
Dialogue: 0,0:02:22.89,0:02:23.79,Default,,0,0,0,,瓦爾卡納
Dialogue: 0,0:02:23.82,0:02:28.17,Default,,0,0,0,,不 總覺得要回房間睡也好累
Dialogue: 0,0:02:29.25,0:02:31.66,Default,,0,0,0,,你們該不會是吃了什麼不妙的東西吧
Dialogue: 0,0:02:31.74,0:02:36.21,Default,,0,0,0,,比起吃不妙的東西 現在可能更想睡…
Dialogue: 0,0:02:36.42,0:02:39.84,Default,,0,0,0,,土佐衛門肚子竟然沒有餓 真稀奇
Dialogue: 0,0:02:39.86,0:02:42.30,Default,,0,0,0,,真是節能 了不起 了不起
Dialogue: 0,0:02:42.40,0:02:44.95,Default,,0,0,0,,欸嘿嘿嘿 好害羞喔
Dialogue: 0,0:02:45.04,0:02:46.39,Default,,0,0,0,,他們一直都是這樣
Dialogue: 0,0:02:46.42,0:02:47.67,Default,,0,0,0,,其他的傢伙也是嗎
Dialogue: 0,0:02:47.71,0:02:50.18,Default,,0,0,0,,嗯 在裡面休息的人也是
Dialogue: 0,0:02:50.80,0:02:53.45,Default,,0,0,0,,但是 並沒有生病
Dialogue: 0,0:02:53.71,0:02:56.01,Default,,0,0,0,,沒有發燒 脈搏也很正常
Dialogue: 0,0:02:56.22,0:02:57.51,Default,,0,0,0,,我也不太清楚
Dialogue: 0,0:02:58.51,0:02:59.44,Default,,0,0,0,,果然
Dialogue: 0,0:02:59.57,0:03:00.17,Default,,0,0,0,,妳們
Dialogue: 0,0:03:00.18,0:03:01.01,Default,,0,0,0,,大家聽我說
Dialogue: 0,0:03:01.36,0:03:03.35,Default,,0,0,0,,繼續留在這個村子會很不妙
Dialogue: 0,0:03:04.03,0:03:05.95,Default,,0,0,0,,如果怪獸一直出現的話
Dialogue: 0,0:03:05.95,0:03:07.95,Default,,0,0,0,,會沒辦法維持身為人的身體機能?
Dialogue: 0,0:03:08.25,0:03:11.38,Default,,0,0,0,,對 雖然叫怪獸但那個應該叫納鳴才對
Dialogue: 0,0:03:11.68,0:03:14.07,Default,,0,0,0,,他說我們不是人欸
Dialogue: 0,0:03:14.15,0:03:16.28,Default,,0,0,0,,總覺得好酷喔
Dialogue: 0,0:03:16.40,0:03:20.46,Default,,0,0,0,,哎 達哈拉什麼的 本來就不像是個人類吧
Dialogue: 0,0:03:20.48,0:03:24.59,Default,,0,0,0,,哇 非人類聽起來好像更酷欸
Dialogue: 0,0:03:24.61,0:03:26.55,Default,,0,0,0,,奈那 妳還真過分欸
Dialogue: 0,0:03:26.61,0:03:28.08,Default,,0,0,0,,雖然描述得十分精確
Dialogue: 0,0:03:29.14,0:03:31.37,Default,,0,0,0,,沒辦法維持身為人的身體機能是怎麼一回事
Dialogue: 0,0:03:31.43,0:03:32.78,Default,,0,0,0,,快說的具體一點
Dialogue: 0,0:03:32.81,0:03:34.65,Default,,0,0,0,,咦 你說具體一點…
Dialogue: 0,0:03:34.91,0:03:37.95,Default,,0,0,0,,就是…自我意識會變得越來越稀薄之類的
Dialogue: 0,0:03:38.05,0:03:39.64,Default,,0,0,0,,有點類似那個樣子的
Dialogue: 0,0:03:40.13,0:03:41.67,Default,,0,0,0,,會變稀薄嗎
Dialogue: 0,0:03:42.04,0:03:46.21,Default,,0,0,0,,哇 萬部腿毛很濃 這樣正剛好欸
Dialogue: 0,0:03:46.24,0:03:48.45,Default,,0,0,0,,這麼說我也太過分了吧 P碳
Dialogue: 0,0:03:49.05,0:03:50.96,Default,,0,0,0,,但是 就算了吧
Dialogue: 0,0:03:51.11,0:03:54.87,Default,,0,0,0,,什麼叫做就算了啦 完全一點都不好吧
Dialogue: 0,0:03:55.20,0:03:59.14,Default,,0,0,0,,納鳴好像會附著於自己的感情上的樣子
Dialogue: 0,0:03:59.49,0:04:01.07,Default,,0,0,0,,如果就這樣出去的話
Dialogue: 0,0:04:01.33,0:04:05.02,Default,,0,0,0,,內心就會變得沒有感覺 變成像廢人一樣
Dialogue: 0,0:04:06.42,0:04:09.01,Default,,0,0,0,,妳們為什麼放那個叫嶺司的人跑了啦
Dialogue: 0,0:04:09.15,0:04:10.84,Default,,0,0,0,,我們有找他過來
Dialogue: 0,0:04:10.94,0:04:14.04,Default,,0,0,0,,妳們都已經問到那裡了 真是沒用
Dialogue: 0,0:04:14.10,0:04:15.25,Default,,0,0,0,,就是因為是女人才會這樣
Dialogue: 0,0:04:15.26,0:04:18.17,Default,,0,0,0,,什麼 為什麼搞性別歧視啦
Dialogue: 0,0:04:18.19,0:04:19.94,Default,,0,0,0,,那 我就換個說法
Dialogue: 0,0:04:19.98,0:04:22.44,Default,,0,0,0,,真・是・沒・用・的・妳
Dialogue: 0,0:04:22.49,0:04:24.03,Default,,0,0,0,,真是火大
Dialogue: 0,0:04:24.18,0:04:26.70,Default,,0,0,0,,吵死了 這是要怎麼睡啦
Dialogue: 0,0:04:27.38,0:04:28.85,Default,,0,0,0,,有什麼關係嘛　真是的
Dialogue: 0,0:04:28.96,0:04:30.47,Default,,0,0,0,,不要管他了啦
Dialogue: 0,0:04:30.57,0:04:31.88,Default,,0,0,0,,怎麼樣都好啦
Dialogue: 0,0:04:31.95,0:04:34.24,Default,,0,0,0,,妳不是那樣的傢伙吧
Dialogue: 0,0:04:34.35,0:04:37.23,Default,,0,0,0,,總之 我現在很想睡
Dialogue: 0,0:04:37.52,0:04:40.09,Default,,0,0,0,,不被任何人打擾 永遠的…
Dialogue: 0,0:04:44.59,0:04:48.42,Default,,0,0,0,,咿 哈! 你們所有人都給我去死吧
Dialogue: 0,0:04:49.62,0:04:50.96,Default,,0,0,0,,討厭 快住手啦
Dialogue: 0,0:04:52.51,0:04:54.47,Default,,0,0,0,,到底在幹什麼啦
Dialogue: 0,0:04:54.54,0:04:56.79,Default,,0,0,0,,怎麼辦 要變成烤乳豬了欸
Dialogue: 0,0:04:56.64,0:05:00.13,Default,,0,0,0,,{\an1}熱帶夜很瘦的 沒關係的啦
Dialogue: 0,0:05:00.66,0:05:03.52,Default,,0,0,0,,{\an1}對了 如果是叉燒的話還真想吃一口欸
Dialogue: 0,0:05:03.77,0:05:04.82,Default,,0,0,0,,是 火箭嗎
Dialogue: 0,0:05:05.33,0:05:07.64,Default,,0,0,0,,殺傷能力有問題
Dialogue: 0,0:05:07.79,0:05:11.09,Default,,0,0,0,,這樣的話 引火的機率也非常的低
Dialogue: 0,0:05:11.58,0:05:13.18,Default,,0,0,0,,所以 我要睡了
Dialogue: 0,0:05:13.31,0:05:17.30,Default,,0,0,0,,要嚇人也先拿把火繩槍來啦喵
Comment: 0,0:05:13.31,0:05:17.30,commed,,0,0,0,,註解|火繩槍|火繩槍是一種使用\N火繩點燃推進用火\N藥來擊發彈丸的滑\N膛槍。

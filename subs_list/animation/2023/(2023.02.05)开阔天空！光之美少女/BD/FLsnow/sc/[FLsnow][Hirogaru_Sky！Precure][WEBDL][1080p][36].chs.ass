Dialogue: 0,0:14:51.88,0:14:53.07,CureBut,NTP,0,0,0,,喝！
Dialogue: 0,0:14:53.32,0:14:54.15,DarkBnd,NTP,0,0,0,,凶！
Dialogue: 0,0:14:54.41,0:14:55.60,CureWin,NTP,0,0,0,,喝！
Dialogue: 0,0:14:55.92,0:14:57.02,DarkBnd,NTP,0,0,0,,暴！
Dialogue: 0,0:14:57.77,0:14:59.10,CureBut,NTP,0,0,0,,继续不要停！
Dialogue: 0,0:14:59.27,0:15:00.37,CureWin,NTP,0,0,0,,是！
Dialogue: 0,0:15:00.68,0:15:02.39,Default,NTP,0,0,0,,大家！不要慌张！
Dialogue: 0,0:15:02.81,0:15:05.31,Default,NTP,0,0,0,,不要怕！我们往那边逃！
Dialogue: 0,0:15:05.72,0:15:06.85,CureWin,NTP,0,0,0,,喝！
Dialogue: 0,0:15:07.05,0:15:08.22,DarkBnd,NTP,0,0,0,,凶！
Dialogue: 0,0:15:08.66,0:15:09.65,CureBut,NTP,0,0,0,,喝！
Dialogue: 0,0:15:09.83,0:15:10.65,DarkBnd,NTP,0,0,0,,暴！
Dialogue: 0,0:15:10.81,0:15:11.66,CureWin,NTP,0,0,0,,好！
Dialogue: 0,0:15:13.38,0:15:15.16,DarkBnd,NTP,0,0,0,,凶凶凶！
Dialogue: 0,0:15:15.45,0:15:16.69,CureBut,NTP,0,0,0,,想得美！
Dialogue: 0,0:15:22.86,0:15:24.09,CureWin,NTP,0,0,0,,Butterfly！
Dialogue: 0,0:15:27.07,0:15:29.21,CureSky,NTP,0,0,0,,两位久等了！
Dialogue: 0,0:15:31.47,0:15:32.56,CureBut,NTP,0,0,0,,大伙！
Dialogue: 0,0:15:32.80,0:15:33.67,CureMaj,NTP,0,0,0,,上吧！
Dialogue: 0,0:15:33.84,0:15:35.05,CurePri,NTP,0,0,0,,是！
Dialogue: 0,0:00:00.10,0:00:00.10,Default,NTP,0,0,0,,

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerTopMusic,,0,0,0,,dakishimete, kinou yori
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerMusic,,0,0,0,,抱紧我
Dialogue: 0,0:23:01.80,0:23:07.11,LayznerTopMusic,,0,0,0,,aishitai hito tidak iru
Dialogue: 0,0:23:01.80,0:23:07.25,LayznerMusic,,0,0,0,,比昨天更爱你
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerTopMusic,,0,0,0,,toki ha hitoshizuku nigai namida
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerMusic,,0,0,0,,时间是一滴 苦涩的泪
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerTopMusic,,0,0,0,,kizutsuita pururougu
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerMusic,,0,0,0,,受伤的序曲
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerTopMusic,,0,0,0,,yasashisa e tsuzukuno yo
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerMusic,,0,0,0,,继续着温柔
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerTopMusic,,0,0,0,,mayowanai futari dake no
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerMusic,,0,0,0,,只为这不再迷惘的两人
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerTopMusic,,0,0,0,,LA ROSE ROUGE
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerMusic,,0,0,0,,献上一曲野玫瑰之歌
Dialogue: 0,0:01:01.30,0:01:03.18,Layzner,,0,0,0,,西 西蒙尼
Dialogue: 0,0:01:03.86,0:01:04.99,Layzner,,0,0,0,,你太轻率了
Dialogue: 0,0:01:07.26,0:01:10.14,Layzner,,0,0,0,,英二 你真的来了啊
Dialogue: 0,0:01:53.67,0:01:59.06,Layzner,,0,0,0,,三年前的那一天 遭到压倒性的古拉特斯的力量蹂躏
Dialogue: 0,0:01:59.48,0:02:02.48,Layzner,,0,0,0,,地球上70%的城市都被烧毁
Dialogue: 0,0:02:02.48,0:02:05.11,Layzner,,0,0,0,,失去了三分之一的人口
Dialogue: 0,0:02:06.50,0:02:10.44,Layzner,,0,0,0,,然后 古拉特斯在这破坏的基础上
Dialogue: 0,0:02:10.92,0:02:14.22,Layzner,,0,0,0,,实行恐怖统治
Dialogue: 0,0:02:14.70,0:02:16.90,Layzner,,0,0,0,,如神般君临了整个地球
Dialogue: 0,0:02:16.99,0:02:21.99,Layzner,,0,0,0,,再会 谜之招待状
Dialogue: 0,0:02:22.62,0:02:24.24,Layzner,,0,0,0,,根据目前的情报
Dialogue: 0,0:02:24.37,0:02:30.17,Layzner,,0,0,0,,已经确认了13个地区的游击队据点 另有32个地区的据点正在调查
Dialogue: 0,0:02:30.42,0:02:32.33,Layzner,,0,0,0,,加上这32个据点
Dialogue: 0,0:02:32.46,0:02:35.34,Layzner,,0,0,0,,一口气歼灭全世界45个据点的话
Dialogue: 0,0:02:35.55,0:02:39.51,Layzner,,0,0,0,,抵抗组织肯定将陷入坏灭状态
Dialogue: 0,0:02:39.93,0:02:43.51,Layzner,,0,0,0,,那剩下的32个地区的据点要什么时候才能查清
Dialogue: 0,0:02:43.93,0:02:47.24,Layzner,,0,0,0,,估计一周后就能查明
Dialogue: 0,0:02:47.60,0:02:51.12,Layzner,,0,0,0,,非常好 将一周后定位X DAY
Dialogue: 0,0:02:51.12,0:02:55.18,Layzner,,0,0,0,,到时一口气歼灭所有据点
Dialogue: 0,0:02:55.65,0:02:56.30,Layzner,,0,0,0,,是
Dialogue: 0,0:03:00.30,0:03:05.28,Layzner,,0,0,0,,喂 多乌 开饭了 多乌 多乌
Dialogue: 0,0:03:06.72,0:03:10.30,Layzner,,0,0,0,,再快点出来啊 真是的
Dialogue: 0,0:03:11.25,0:03:16.05,Layzner,,0,0,0,,这是什么 是信啊 给安娜
Dialogue: 0,0:03:18.84,0:03:24.24,Layzner,,0,0,0,,即将到来的10月18日 你还记得那是什么日子吗
Dialogue: 0,0:03:25.14,0:03:30.52,Layzner,,0,0,0,,那是3年前 我们堵上地球的命运 向古雷斯库的战舰发起挑战
Dialogue: 0,0:03:30.89,0:03:32.65,Layzner,,0,0,0,,并被打败的日子
Dialogue: 0,0:03:33.85,0:03:35.19,Layzner,,0,0,0,,在这三年中
Dialogue: 0,0:03:35.44,0:03:38.36,Layzner,,0,0,0,,我们不幸四散各地
Dialogue: 0,0:03:38.86,0:03:42.20,Layzner,,0,0,0,,我提议我们在这一天呼集旧交
Dialogue: 0,0:03:42.32,0:03:44.87,Layzner,,0,0,0,,重新聚首
Dialogue: 0,0:03:45.70,0:03:47.45,Layzner,,0,0,0,,18日10点
Dialogue: 0,0:03:47.70,0:03:53.21,Layzner,,0,0,0,,希望能在纽约第12区3号码头8号仓库见到大家
Dialogue: 0,0:03:55.83,0:03:56.84,Layzner,,0,0,0,,是谁寄来的
Dialogue: 0,0:04:07.10,0:04:13.44,注释,,0,0,0,,古拉特斯地球占领军 欧洲本部
Dialogue: 0,0:04:14.14,0:04:18.32,Layzner,,0,0,0,,打扰了 属下带了阿登地区的人口调查文件前来
Dialogue: 0,0:04:18.48,0:04:19.23,Layzner,,0,0,0,,辛苦了
Dialogue: 0,0:04:22.44,0:04:24.32,Layzner,,0,0,0,,没事了就快滚
Dialogue: 0,0:04:24.45,0:04:25.61,Layzner,,0,0,0,,那个
Dialogue: 0,0:04:25.86,0:04:26.45,Layzner,,0,0,0,,什么
Dialogue: 0,0:04:26.70,0:04:29.20,Layzner,,0,0,0,,不 没什么 属下告退
Dialogue: 0,0:04:38.63,0:04:41.55,Layzner,,0,0,0,,总不能说我想跟大家碰头
Dialogue: 0,0:04:41.76,0:04:43.34,Layzner,,0,0,0,,就让我去美国吧
Dialogue: 0,0:04:44.20,0:04:46.64,Layzner,,0,0,0,,只有放弃了吧
Dialogue: 0,0:04:47.72,0:04:49.51,Layzner,,0,0,0,,亚瑟·卡明古斯 公务辅佐官
Dialogue: 0,0:04:49.60,0:04:49.80,Layzner,,0,0,0,,是
Dialogue: 0,0:04:50.35,0:04:55.85,Layzner,,0,0,0,,明日16时 随同古利昂中尉 转属第一大陆司令本部
Dialogue: 0,0:04:56.15,0:05:00.23,Layzner,,0,0,0,,30分钟后赴第3人事管理局办理事务交接
Dialogue: 0,0:05:02.07,0:05:02.82,Layzner,,0,0,0,,怎么了
Dialogue: 0,0:05:02.99,0:05:03.90,Layzner,,0,0,0,,快复述
Dialogue: 0,0:05:03.99,0:05:05.24,Layzner,,0,0,0,,十分抱歉
Dialogue: 0,0:05:05.36,0:05:07.20,Layzner,,0,0,0,,亚瑟·卡明古斯 公务辅佐官
Dialogue: 0,0:05:07.28,0:05:11.45,Layzner,,0,0,0,,明日16时 随同古利昂中尉 转属第一大陆司令本部
Dialogue: 0,0:05:11.70,0:05:15.96,Layzner,,0,0,0,,30分钟后赴第3人事管理局办理事务交接
Dialogue: 0,0:05:17.37,0:05:18.79,Layzner,,0,0,0,,好 就这样
Dialogue: 0,0:05:21.59,0:05:26.60,Layzner,,0,0,0,,哈哈 跟做梦一样 今天转属去美国 这下能见到大家了
Dialogue: 0,0:05:32.72,0:05:34.35,Layzner,,0,0,0,,想去第一大陆
Dialogue: 0,0:05:34.35,0:05:38.04,Layzner,,0,0,0,,你经常横渡大西洋吧
Dialogue: 0,0:05:38.15,0:05:40.23,Layzner,,0,0,0,,你去第一大陆干什么
Dialogue: 0,0:05:40.31,0:05:43.11,Layzner,,0,0,0,,想去参加老朋友的生日聚会
Dialogue: 0,0:05:43.19,0:05:47.38,Layzner,,0,0,0,,是吗 可惜我现在有重大的任务
Dialogue: 0,0:05:47.38,0:05:49.32,Layzner,,0,0,0,,暂时去不了那里
Dialogue: 0,0:05:49.37,0:05:50.78,Layzner,,0,0,0,,重大的任务吗
Dialogue: 0,0:05:51.58,0:05:57.25,Layzner,,0,0,0,,你要保密哦 我这一星期找我约会的姑娘都排满了哦
Dialogue: 0,0:06:00.08,0:06:03.30,Layzner,,0,0,0,,这周结束了下周就有空了
Dialogue: 0,0:06:03.50,0:06:07.09,Layzner,,0,0,0,,好啊 我就预约下周吧
Dialogue: 0,0:06:07.22,0:06:08.88,Layzner,,0,0,0,,真是光荣啊
Dialogue: 0,0:06:08.88,0:06:14.56,Layzner,,0,0,0,,能跟第二大陆地区最大的支持者 鲁夫拉恩公爵的大小姐约会
Dialogue: 0,0:06:14.72,0:06:16.48,Layzner,,0,0,0,,对了 生日聚会是什么时候
Dialogue: 0,0:06:16.64,0:06:17.56,Layzner,,0,0,0,,是后天
Dialogue: 0,0:06:17.69,0:06:21.86,Layzner,,0,0,0,,没问题 明天古利昂中尉应该会去第一大陆
Dialogue: 0,0:06:21.94,0:06:24.22,Layzner,,0,0,0,,我会尽力斡旋的
Dialogue: 0,0:06:24.53,0:06:26.44,Layzner,,0,0,0,,谢谢 我好高兴啊
Dialogue: 0,0:06:31.53,0:06:34.41,Layzner,,0,0,0,,这是欧洲司令部的设计图备份
Dialogue: 0,0:06:34.62,0:06:37.91,Layzner,,0,0,0,,小心为上 指挥作战的加及尔中尉
Dialogue: 0,0:06:38.08,0:06:40.62,Layzner,,0,0,0,,这一周都不会离开欧洲本部
Dialogue: 0,0:06:40.96,0:06:43.59,Layzner,,0,0,0,,似乎是在进行什么特别的准备
Dialogue: 0,0:06:43.75,0:06:44.46,Layzner,,0,0,0,,知道了
Dialogue: 0,0:06:44.84,0:06:47.54,Layzner,,0,0,0,,还有 明天我要去美国
Dialogue: 0,0:06:47.84,0:06:48.76,Layzner,,0,0,0,,美国
Dialogue: 0,0:06:48.97,0:06:50.38,Layzner,,0,0,0,,收到朋友的请帖啊
Dialogue: 0,0:06:50.63,0:06:52.43,Layzner,,0,0,0,,那就是上次收到的那个
Dialogue: 0,0:06:52.55,0:06:52.97,Layzner,,0,0,0,,没错
Dialogue: 0,0:06:53.30,0:06:55.89,Layzner,,0,0,0,,你好像把敌人的头头骗得团团转了啊
Dialogue: 0,0:06:56.56,0:06:58.68,Layzner,,0,0,0,,谁叫我天生丽质呢 有什么办法
Dialogue: 0,0:06:59.02,0:07:01.70,Layzner,,0,0,0,,嘛 好好玩吧 回来了跟我联络
Dialogue: 0,0:07:01.94,0:07:02.40,Layzner,,0,0,0,,哎
Dialogue: 0,0:07:03.44,0:07:04.90,Layzner,,0,0,0,,跟月亮说悄悄话吗
Dialogue: 0,0:07:04.94,0:07:05.41,Layzner,,0,0,0,,嘛
Dialogue: 0,0:07:11.03,0:07:12.70,Layzner,,0,0,0,,喂 你在那里干什么
Dialogue: 0,0:07:15.83,0:07:17.49,Layzner,,0,0,0,,怎么啦 哑巴啦
Dialogue: 0,0:07:19.20,0:07:19.66,Layzner,,0,0,0,,站住
Dialogue: 0,0:07:34.68,0:07:36.81,Layzner,,0,0,0,,古利昂中尉 恭候多时了
Dialogue: 0,0:07:37.01,0:07:40.39,Layzner,,0,0,0,,辛苦了 有位女士要与我们同行 我来介绍
Dialogue: 0,0:07:43.52,0:07:45.10,Layzner,,0,0,0,,啊 好久不见了啊
Dialogue: 0,0:07:46.11,0:07:49.94,Layzner,,0,0,0,,西 西蒙妮
Dialogue: 0,0:07:51.24,0:07:52.53,Layzner,,0,0,0,,你 怎么会
Dialogue: 0,0:07:52.66,0:07:54.24,Layzner,,0,0,0,,怎么 原来你们认识吗
Dialogue: 0,0:07:54.45,0:07:56.33,Layzner,,0,0,0,,哎 以前见过 对吧
Dialogue: 0,0:07:58.95,0:07:59.62,Layzner,,0,0,0,,怎么了
Dialogue: 0,0:08:01.00,0:08:04.34,Layzner,,0,0,0,,看你这样子以前是被小姐甩了吧
Dialogue: 0,0:08:05.00,0:08:05.71,Layzner,,0,0,0,,是吗
Dialogue: 0,0:08:05.92,0:08:09.30,Layzner,,0,0,0,,没错啊 就是这么回事 哈哈
Dialogue: 0,0:08:09.96,0:08:11.80,Layzner,,0,0,0,,居然给猜中了 哈哈
Dialogue: 0,0:08:20.39,0:08:24.90,Layzner,,0,0,0,,将您安置在地球人用舱房很是抱歉 这是规定
Dialogue: 0,0:08:25.02,0:08:28.36,Layzner,,0,0,0,,带了机场就能再见面了 祝您旅途愉快
Dialogue: 0,0:08:28.48,0:08:29.15,Layzner,,0,0,0,,告辞
Dialogue: 0,0:08:30.19,0:08:32.86,Layzner,,0,0,0,,西蒙妮 西蒙妮
Dialogue: 0,0:08:32.95,0:08:34.45,Layzner,,0,0,0,,你也要去吗
Dialogue: 0,0:08:34.61,0:08:35.82,Layzner,,0,0,0,,当然了
Dialogue: 0,0:08:37.45,0:08:42.00,Layzner,,0,0,0,,这三年中大家过得如何我一直很在意啊
Dialogue: 0,0:08:42.16,0:08:46.46,Layzner,,0,0,0,,好想跟大家见面 好担心大家啊
Dialogue: 0,0:08:47.13,0:08:50.71,Layzner,,0,0,0,,不过 亚瑟你变成大叔脸了啊
Dialogue: 0,0:08:51.80,0:08:53.80,Layzner,,0,0,0,,小肚子也挺出来了
Dialogue: 0,0:08:53.92,0:08:56.46,Layzner,,0,0,0,,不 不过是有点胖了啊
Dialogue: 0,0:09:00.43,0:09:04.14,Layzner,,0,0,0,,明天终于就是剿灭叛乱分子的日子了
Dialogue: 0,0:09:08.27,0:09:13.90,Layzner,,0,0,0,,在这充斥着无聊的东西的星球上 居然有如此好酒
Dialogue: 0,0:09:14.11,0:09:16.60,Layzner,,0,0,0,,地球人将其比喻为神之血
Dialogue: 0,0:09:22.45,0:09:23.66,Layzner,,0,0,0,,我住这里
Dialogue: 0,0:09:24.58,0:09:26.79,Layzner,,0,0,0,,知道了 到时候我去接你
Dialogue: 0,0:09:27.88,0:09:30.09,Layzner,,0,0,0,,我很期待明天的到来 再见
Dialogue: 0,0:09:31.67,0:09:33.30,Layzner,,0,0,0,,明天见
Dialogue: 0,0:09:34.17,0:09:35.42,Layzner,,0,0,0,,对不起
Dialogue: 0,0:09:46.73,0:09:47.65,Layzner,,0,0,0,,罗安
Dialogue: 0,0:09:50.23,0:09:51.98,Layzner,,0,0,0,,这不是罗安吗
Dialogue: 0,0:09:52.48,0:09:53.86,Layzner,,0,0,0,,按时到了啊
Dialogue: 0,0:09:57.78,0:09:59.41,Layzner,,0,0,0,,恭候您多时了
Dialogue: 0,0:10:02.49,0:10:03.20,Layzner,,0,0,0,,快带路
Dialogue: 0,0:10:03.33,0:10:03.62,Layzner,,0,0,0,,是
Dialogue: 0,0:10:09.12,0:10:11.67,Layzner,,0,0,0,,好了 你没事了 跟我来
Dialogue: 0,0:10:13.05,0:10:14.34,Layzner,,0,0,0,,怎么回事
Dialogue: 0,0:10:15.88,0:10:18.51,Layzner,,0,0,0,,我都不知道你在这里工作啊
Dialogue: 0,0:10:23.85,0:10:25.72,Layzner,,0,0,0,,你在这里是大人物啊
Dialogue: 0,0:10:25.93,0:10:27.30,Layzner,,0,0,0,,好了 请进 这就是你的房间了
Dialogue: 0,0:10:27.73,0:10:31.27,Layzner,,0,0,0,,哎 那是你把我调来这里的了
Dialogue: 0,0:10:31.36,0:10:31.98,Layzner,,0,0,0,,啊
Dialogue: 0,0:10:32.15,0:10:34.74,Layzner,,0,0,0,,为了让我参加那个聚会吗
Dialogue: 0,0:10:34.98,0:10:37.40,Layzner,,0,0,0,,那个聚会 什么聚会
Dialogue: 0,0:10:37.65,0:10:41.07,Layzner,,0,0,0,,你不知道啊 那个请帖
Dialogue: 0,0:10:41.20,0:10:42.20,Layzner,,0,0,0,,请帖
Dialogue: 0,0:10:42.57,0:10:45.20,Layzner,,0,0,0,,我来这里的飞机上碰到了西蒙妮啊
Dialogue: 0,0:10:45.37,0:10:46.12,Layzner,,0,0,0,,西蒙妮吗
Dialogue: 0,0:10:46.25,0:10:49.54,Layzner,,0,0,0,,她真是美女啊
Dialogue: 0,0:10:50.12,0:10:51.17,Layzner,,0,0,0,,看这个
Dialogue: 0,0:10:52.58,0:10:55.88,Layzner,,0,0,0,,是吗 没送来你这里啊
Dialogue: 0,0:10:56.09,0:11:00.52,Layzner,,0,0,0,,在古拉特斯司令部的话 这种信送不进来吧
Dialogue: 0,0:11:00.80,0:11:03.68,Layzner,,0,0,0,,但是正好啊 就在明天
Dialogue: 0,0:11:04.81,0:11:09.52,Layzner,,0,0,0,,你太轻率了 带着这种东西很危险的 先放我这里
Dialogue: 0,0:11:12.77,0:11:15.86,Layzner,,0,0,0,,西蒙妮 快点
Dialogue: 0,0:11:19.07,0:11:21.04,Layzner,,0,0,0,,你还是老样子啊
Dialogue: 0,0:11:22.32,0:11:25.50,Layzner,,0,0,0,,可是我好高兴啊 一想到能见到大家
Dialogue: 0,0:11:28.00,0:11:29.50,Layzner,,0,0,0,,好了 快走吧
Dialogue: 0,0:11:29.62,0:11:31.79,Layzner,,0,0,0,,西蒙妮 快点
Dialogue: 0,0:11:32.33,0:11:36.82,Layzner,,0,0,0,,终于招了 给他本部设计图的是鲁夫拉恩的女儿
Dialogue: 0,0:11:37.00,0:11:42.76,Layzner,,0,0,0,,他女儿似乎很久以前就开始给叛乱分子提供情报了
Dialogue: 0,0:11:44.39,0:11:46.34,Layzner,,0,0,0,,鲁夫拉恩的女儿在哪里
Dialogue: 0,0:11:46.34,0:11:47.35,Layzner,,0,0,0,,快说
Dialogue: 0,0:12:09.88,0:12:10.79,Layzner,,0,0,0,,大卫
Dialogue: 0,0:12:11.00,0:12:13.46,Layzner,,0,0,0,,呦 小鬼你也来了啊
Dialogue: 0,0:12:15.83,0:12:17.75,Layzner,,0,0,0,,大家好像都还没到啊
Dialogue: 0,0:12:26.26,0:12:28.76,Layzner,,0,0,0,,都叫你少来这套了
Dialogue: 0,0:12:31.64,0:12:32.89,Layzner,,0,0,0,,亚瑟啊
Dialogue: 0,0:12:32.89,0:12:35.06,Layzner,,0,0,0,,大家好久不见了
Dialogue: 0,0:12:39.19,0:12:40.19,Layzner,,0,0,0,,等一下 救命啊
Dialogue: 0,0:12:40.23,0:12:40.94,Layzner,,0,0,0,,多乌
Dialogue: 0,0:12:41.44,0:12:44.32,Layzner,,0,0,0,,亚瑟 不用跑啊
Dialogue: 0,0:12:47.03,0:12:47.85,Layzner,,0,0,0,,西蒙妮
Dialogue: 0,0:12:50.33,0:12:53.01,Layzner,,0,0,0,,喂 多乌 没关系了 下来吧
Dialogue: 0,0:12:54.58,0:12:55.70,Layzner,,0,0,0,,就算你这么说也
Dialogue: 0,0:12:59.63,0:13:00.70,Layzner,,0,0,0,,西蒙妮
Dialogue: 0,0:13:13.02,0:13:14.48,Layzner,,0,0,0,,啊 爽~
Dialogue: 0,0:13:15.19,0:13:16.94,Layzner,,0,0,0,,你干啥啊 这么突然
Dialogue: 0,0:13:17.44,0:13:19.40,Layzner,,0,0,0,,报你吻我之仇啊
Dialogue: 0,0:13:20.40,0:13:22.61,Layzner,,0,0,0,,我都等了三年了
Dialogue: 0,0:13:31.54,0:13:33.95,Layzner,,0,0,0,,不过你还真是受欢迎啊
Dialogue: 0,0:13:34.04,0:13:35.87,Layzner,,0,0,0,,别开玩笑了 真是的
Dialogue: 0,0:13:36.08,0:13:39.04,Layzner,,0,0,0,,算了吧 多乌也在反省了
Dialogue: 0,0:13:39.17,0:13:42.59,Layzner,,0,0,0,,喝了这个暖暖身子 是日本酒哦
Dialogue: 0,0:13:42.96,0:13:44.60,Layzner,,0,0,0,,给 西蒙妮
Dialogue: 0,0:13:44.75,0:13:47.62,Layzner,,0,0,0,,古拉特斯啥的见鬼去吧 地球文化还健在呢
Dialogue: 0,0:13:47.68,0:13:48.93,Layzner,,0,0,0,,看吧 看吧 给 小鬼 安娜
Dialogue: 0,0:13:49.05,0:13:51.26,Layzner,,0,0,0,,我也有哦
Dialogue: 0,0:13:52.93,0:13:53.89,Layzner,,0,0,0,,看
Dialogue: 0,0:13:54.81,0:13:56.44,Layzner,,0,0,0,,这很好吃哦
Dialogue: 0,0:13:56.98,0:13:59.48,Layzner,,0,0,0,,这个在古拉特斯也是很高级的哦
Dialogue: 0,0:13:59.90,0:14:05.38,Layzner,,0,0,0,,哦 哦 是吗 是吗 所以你就向古拉特斯摇尾乞怜 吃好东西长肥肉吗
Dialogue: 0,0:14:05.38,0:14:07.86,Layzner,,0,0,0,,真讨厌 居然帮敌人
Dialogue: 0,0:14:07.91,0:14:14.00,Layzner,,0,0,0,,话虽这么说 我也是为了活下去不得已啊
Dialogue: 0,0:14:14.00,0:14:16.83,Layzner,,0,0,0,,嘛嘛 先庆祝大家再会干杯吧
Dialogue: 0,0:14:16.96,0:14:19.10,Layzner,,0,0,0,,啊是 大家高兴点
Dialogue: 0,0:14:19.62,0:14:21.09,Layzner,,0,0,0,,那么 庆祝大家再会
Dialogue: 0,0:14:21.17,0:14:21.67,Layzner,,0,0,0,,等一下
Dialogue: 0,0:14:22.29,0:14:23.21,Layzner,,0,0,0,,现在还不行
Dialogue: 0,0:14:23.34,0:14:24.09,Layzner,,0,0,0,,为什么啊
Dialogue: 0,0:14:24.25,0:14:26.17,Layzner,,0,0,0,,因为 他还没来
Dialogue: 0,0:14:33.56,0:14:34.70,Layzner,,0,0,0,,是英二
Dialogue: 0,0:14:37.85,0:14:39.40,Layzner,,0,0,0,,英二吗
Dialogue: 0,0:14:39.52,0:14:40.44,Layzner,,0,0,0,,正是
Dialogue: 0,0:14:44.61,0:14:46.07,Layzner,,0,0,0,,英二
Dialogue: 0,0:14:46.68,0:14:47.14,Layzner,,0,0,0,,英
Dialogue: 0,0:14:50.24,0:14:51.45,Layzner,,0,0,0,,啊拉
Dialogue: 0,0:14:52.28,0:14:53.96,Layzner,,0,0,0,,亚瑟
Dialogue: 0,0:14:54.08,0:14:55.82,Layzner,,0,0,0,,不是啊 不是故意的
Dialogue: 0,0:14:56.38,0:14:58.10,Layzner,,0,0,0,,干杯
Dialogue: 0,0:15:02.34,0:15:05.75,Layzner,,0,0,0,,爽 大家一起喝 就是这个味
Dialogue: 0,0:15:05.75,0:15:09.13,Layzner,,0,0,0,,就是啊 太棒了 好 我要吃了
Dialogue: 0,0:15:09.17,0:15:14.60,Layzner,,0,0,0,,哦 平时一直吃好东西现在居然还这么好胃口 你这个A级合作者
Dialogue: 0,0:15:14.64,0:15:17.44,Layzner,,0,0,0,,拜托别叫我什么合作者啊
Dialogue: 0,0:15:17.44,0:15:19.64,Layzner,,0,0,0,,可你就是合作者吧
Dialogue: 0,0:15:19.77,0:15:22.48,Layzner,,0,0,0,,我可没连灵魂都卖给古拉特斯
Dialogue: 0,0:15:23.02,0:15:23.56,Layzner,,0,0,0,,亚瑟
Dialogue: 0,0:15:23.61,0:15:25.40,Layzner,,0,0,0,,是 伊丽莎白博士
Dialogue: 0,0:15:25.48,0:15:29.24,Layzner,,0,0,0,,大卫 安娜 西蒙妮 大家都好吧
Dialogue: 0,0:15:29.90,0:15:31.57,Layzner,,0,0,0,,真抱歉今天我去不了
Dialogue: 0,0:15:32.11,0:15:36.54,Layzner,,0,0,0,,所以我想就算只让大家听听声音也好 就拜托了英二
Dialogue: 0,0:15:37.24,0:15:42.12,Layzner,,0,0,0,,我现在每天为地下本部的事手忙脚乱
Dialogue: 0,0:15:42.50,0:15:48.09,Layzner,,0,0,0,,但是我很好 放心吧 今天大家就忘记心酸的往事好好开心一下吧
Dialogue: 0,0:15:48.76,0:15:52.34,Layzner,,0,0,0,,真是的 该说什么好呢
Dialogue: 0,0:15:53.39,0:15:58.93,Layzner,,0,0,0,,总之大家努力吧 好吗 那么再见吧 一定会再见的
Dialogue: 0,0:16:02.23,0:16:04.73,Layzner,,0,0,0,,说是今后也请大家关照了
Dialogue: 0,0:16:06.32,0:16:09.74,Layzner,,0,0,0,,英二 让我摸摸你
Dialogue: 0,0:16:11.28,0:16:14.12,Layzner,,0,0,0,,英二 你真的来了啊
Dialogue: 0,0:16:14.91,0:16:17.00,Layzner,,0,0,0,,我还以为再也见不到了呢
Dialogue: 0,0:16:18.70,0:16:20.04,Layzner,,0,0,0,,啊 抱歉
Dialogue: 0,0:16:20.54,0:16:22.84,Layzner,,0,0,0,,讨厌 妆都花了
Dialogue: 0,0:16:23.17,0:16:28.00,Layzner,,0,0,0,,啊 啊 真是差别对待啊 我可是突然吃了个耳光啊
Dialogue: 0,0:16:28.00,0:16:29.17,Layzner,,0,0,0,,可是啊
Dialogue: 0,0:16:30.42,0:16:31.67,Layzner,,0,0,0,,那
Dialogue: 0,0:16:31.92,0:16:32.63,Layzner,,0,0,0,,怎么了
Dialogue: 0,0:16:32.97,0:16:35.72,Layzner,,0,0,0,,那里是我们组织的地下据点
Dialogue: 0,0:16:36.80,0:16:40.98,Layzner,,0,0,0,,现在世界上大多数的据点都受到了古拉特斯的奇袭
Dialogue: 0,0:16:41.14,0:16:41.93,Layzner,,0,0,0,,怎么会
Dialogue: 0,0:16:41.93,0:16:46.74,Layzner,,0,0,0,,不用担心 因为有内应 消息早都传出去了
Dialogue: 0,0:16:47.02,0:16:54.22,Layzner,,0,0,0,,那就没啥担心啦 大家好好谈谈吧 三年都没见了啊
Dialogue: 0,0:16:55.41,0:16:57.90,Layzner,,0,0,0,,哼 没想到多数据点都是空壳啊
Dialogue: 0,0:16:58.24,0:17:00.29,Layzner,,0,0,0,,只有情报泄露了这一种可能
Dialogue: 0,0:17:00.41,0:17:04.67,Layzner,,0,0,0,,是你吗 你也是地球人 是你泄露的吗
Dialogue: 0,0:17:04.67,0:17:07.13,Layzner,,0,0,0,,我是古拉特斯忠实的仆人
Dialogue: 0,0:17:08.54,0:17:11.28,Layzner,,0,0,0,,如果怀疑我在这里处决我也可以
Dialogue: 0,0:17:11.59,0:17:13.34,Layzner,,0,0,0,,有意思
Dialogue: 0,0:17:18.14,0:17:19.72,Layzner,,0,0,0,,我很生气
Dialogue: 0,0:17:30.11,0:17:33.44,Layzner,,0,0,0,,那要是间谍 那就太可怕了
Dialogue: 0,0:17:35.11,0:17:36.03,Layzner,,0,0,0,,什么事
Dialogue: 0,0:17:36.99,0:17:38.78,Layzner,,0,0,0,,第二大陆发来了联络吗
Dialogue: 0,0:17:38.99,0:17:39.99,Layzner,,0,0,0,,好 说吧
Dialogue: 0,0:17:40.87,0:17:43.00,Layzner,,0,0,0,,什么 鲁夫拉恩家的女儿吗
Dialogue: 0,0:17:43.56,0:17:45.00,Layzner,,0,0,0,,还有事吗 好的 明白了
Dialogue: 0,0:17:45.29,0:17:45.91,Layzner,,0,0,0,,阁下
Dialogue: 0,0:17:46.17,0:17:46.75,Layzner,,0,0,0,,什么事
Dialogue: 0,0:17:47.37,0:17:48.17,Layzner,,0,0,0,,阁下
Dialogue: 0,0:17:48.42,0:17:50.88,Layzner,,0,0,0,,我要向您证明我的忠诚
Dialogue: 0,0:17:52.67,0:17:56.24,Layzner,,0,0,0,,为了免受多余的怀疑 我没有向您报告
Dialogue: 0,0:17:56.93,0:17:59.95,Layzner,,0,0,0,,古拉特斯算个啥
Dialogue: 0,0:18:00.29,0:18:02.06,Layzner,,0,0,0,,老子是地球人啊
Dialogue: 0,0:18:02.06,0:18:03.22,Layzner,,0,0,0,,没错没错
Dialogue: 0,0:18:03.39,0:18:05.88,Layzner,,0,0,0,,老子也有地球人的尊严啊
Dialogue: 0,0:18:06.27,0:18:07.41,Layzner,,0,0,0,,说的好
Dialogue: 0,0:18:09.06,0:18:11.40,Layzner,,0,0,0,,古雷特斯那些混蛋
Dialogue: 0,0:18:12.15,0:18:15.46,Layzner,,0,0,0,,可是我还在他们手下干活 我算个什么东西
Dialogue: 0,0:18:16.15,0:18:19.78,Layzner,,0,0,0,,我是个废物 给古拉特斯当走狗太丢人了
Dialogue: 0,0:18:19.91,0:18:24.95,Layzner,,0,0,0,,不是这样的啊 亚瑟 因为有你这样的人世界才能运转啊
Dialogue: 0,0:18:25.00,0:18:27.41,Layzner,,0,0,0,,没错啊 亚瑟 拿出自信来
Dialogue: 0,0:18:27.58,0:18:31.25,Layzner,,0,0,0,,不 我是废物 又胆小又没用
Dialogue: 0,0:18:31.25,0:18:33.67,Layzner,,0,0,0,,没那种事啊 为了生存不得已嘛
Dialogue: 0,0:18:33.92,0:18:38.88,Layzner,,0,0,0,,不 我是废物 我没有生存的价值啊
Dialogue: 0,0:18:39.22,0:18:41.85,Layzner,,0,0,0,,这请帖是谁发的呢
Dialogue: 0,0:18:42.30,0:18:46.73,Layzner,,0,0,0,,不知道 但是博士说可以放心来参加
Dialogue: 0,0:18:46.93,0:18:48.31,Layzner,,0,0,0,,那博士是知道的了
Dialogue: 0,0:18:48.64,0:18:53.15,Layzner,,0,0,0,,在古拉特斯有所行动的日子举行这种聚会 应该不少偶然吧
Dialogue: 0,0:18:54.27,0:18:56.94,Layzner,,0,0,0,,而不是因为三年前的那一天
Dialogue: 0,0:18:57.07,0:18:57.57,Layzner,,0,0,0,,没错
Dialogue: 0,0:18:57.74,0:19:01.07,Layzner,,0,0,0,,那两个人 好像对般配的情侣啊
Dialogue: 0,0:19:01.16,0:19:02.95,Layzner,,0,0,0,,我们也很配啊
Dialogue: 0,0:19:02.99,0:19:11.38,Layzner,,0,0,0,,呦 谁说的 我可不是什么被亲一口就嫁鸡随鸡的女 人 呦
Dialogue: 0,0:19:12.33,0:19:13.46,Layzner,,0,0,0,,还是老样子啊
Dialogue: 0,0:19:14.04,0:19:19.68,Layzner,,0,0,0,,没错 那种三年前的吻早过期了 我也有权利
Dialogue: 0,0:19:20.05,0:19:21.59,Layzner,,0,0,0,,你醒了啊
Dialogue: 0,0:19:21.72,0:19:22.89,Layzner,,0,0,0,,亚瑟
Dialogue: 0,0:19:23.18,0:19:24.14,Layzner,,0,0,0,,西蒙妮
Dialogue: 0,0:19:28.10,0:19:30.60,Layzner,,0,0,0,,你记得吗 你记得吗
Dialogue: 0,0:19:30.89,0:19:32.65,Layzner,,0,0,0,,罗安那家伙
Dialogue: 0,0:19:33.65,0:19:36.53,Layzner,,0,0,0,,把伊丽莎白博士胸口的拉链给
Dialogue: 0,0:19:39.19,0:19:40.86,Layzner,,0,0,0,,亚瑟
Dialogue: 0,0:19:42.32,0:19:43.82,Layzner,,0,0,0,,真是的
Dialogue: 0,0:19:44.20,0:19:45.87,Layzner,,0,0,0,,对了 罗安还没来啊
Dialogue: 0,0:19:45.95,0:19:46.74,Layzner,,0,0,0,,罗安
Dialogue: 0,0:19:47.49,0:19:49.25,Layzner,,0,0,0,,怎么可能给那种家伙送请帖
Dialogue: 0,0:19:50.71,0:19:51.29,Layzner,,0,0,0,,唉 可是
Dialogue: 0,0:19:51.42,0:19:53.04,Layzner,,0,0,0,,那家伙是背叛者啊
Dialogue: 0,0:19:53.29,0:19:54.06,Layzner,,0,0,0,,背叛者
Dialogue: 0,0:19:55.29,0:19:59.55,Layzner,,0,0,0,,那家伙眼看着我跟安娜上刑场都面不改色啊
Dialogue: 0,0:20:01.96,0:20:06.10,Layzner,,0,0,0,,他跟亚瑟不同 根本骨头里都是古拉特斯的走狗啊
Dialogue: 0,0:20:06.64,0:20:09.89,Layzner,,0,0,0,,我 说给他听了
Dialogue: 0,0:20:09.98,0:20:12.48,Layzner,,0,0,0,,什么 你告诉他今天的事了
Dialogue: 0,0:20:12.60,0:20:13.52,Layzner,,0,0,0,,是啊
Dialogue: 0,0:20:13.73,0:20:17.44,Layzner,,0,0,0,,他要来的话这里就麻烦了 他肯定会带治安部队来
Dialogue: 0,0:20:17.69,0:20:21.57,Layzner,,0,0,0,,我不知道啊 罗安变成那种人了
Dialogue: 0,0:20:23.36,0:20:24.03,Layzner,,0,0,0,,来了
Dialogue: 0,0:20:28.83,0:20:30.34,Layzner,,0,0,0,,不行了 这边走不了
Dialogue: 0,0:20:34.08,0:20:34.92,Layzner,,0,0,0,,被包围了
Dialogue: 0,0:20:35.00,0:20:36.38,Layzner,,0,0,0,,都是我不好
Dialogue: 0,0:20:36.42,0:20:37.56,Layzner,,0,0,0,,快穿衣服
Dialogue: 0,0:20:45.93,0:20:48.56,Layzner,,0,0,0,,果然是罗安 那个混蛋
Dialogue: 0,0:20:48.68,0:20:50.92,Layzner,,0,0,0,,住手 现在刺激他们的话 会一齐开火的
Dialogue: 0,0:20:51.23,0:20:52.06,Layzner,,0,0,0,,那要怎么办
Dialogue: 0,0:20:52.10,0:20:55.98,Layzner,,0,0,0,,我在仓库里装了炸弹 你带大家从那里的下水道逃走
Dialogue: 0,0:21:02.82,0:21:03.34,Layzner,,0,0,0,,Go!
Dialogue: 0,0:21:09.38,0:21:10.20,Layzner,,0,0,0,,大家快来
Dialogue: 0,0:21:17.88,0:21:18.75,Layzner,,0,0,0,,请给我用一下
Dialogue: 0,0:21:22.92,0:21:25.13,Layzner,,0,0,0,,亚瑟 干什么呢 振作点
Dialogue: 0,0:21:25.22,0:21:26.18,Layzner,,0,0,0,,英二 后面
Dialogue: 0,0:21:29.97,0:21:30.56,Layzner,,0,0,0,,罗安
Dialogue: 0,0:21:38.73,0:21:39.52,Layzner,,0,0,0,,大家 快跑
Dialogue: 0,0:22:04.38,0:22:05.34,Layzner,,0,0,0,,罗安
Dialogue: 0,0:22:07.09,0:22:08.30,Layzner,,0,0,0,,像你这种人
Dialogue: 0,0:22:10.60,0:22:11.64,Layzner,,0,0,0,,就因为有你这种
Dialogue: 0,0:22:14.43,0:22:21.40,Layzner,,0,0,0,,有你这种渣滓 连累我都被阁下他怀疑
Dialogue: 0,0:23:55.24,0:24:00.33,Layzner,,0,0,0,,嘿嘿 听着头骨碎裂的声音去死吧
Dialogue: 0,0:24:01.25,0:24:02.10,Layzner,,0,0,0,,大卫
Dialogue: 0,0:24:03.00,0:24:03.86,Layzner,,0,0,0,,嘿嘿 很好很好
Dialogue: 0,0:24:03.88,0:24:09.18,Layzner,,0,0,0,,下一集 贝布鲁夺回作战
Dialogue: 0,0:24:09.38,0:24:11.38,Layzner,,0,0,0,,

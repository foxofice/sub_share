Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕组制作 仅供学习交流 禁止用于商业用途
Comment: 0,0:00:31.01,0:00:31.06,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:00:52.24,0:00:58.67,op-jp,,0,0,0,,滴る汗と日差しで閉じた目
Dialogue: 0,0:00:58.67,0:01:04.92,op-jp,,0,0,0,,映し出したのはあなたとの約束
Dialogue: 0,0:01:04.92,0:01:11.56,op-jp,,0,0,0,,意志を紡いだ導火線に火をつけたら
Dialogue: 0,0:01:11.56,0:01:17.31,op-jp,,0,0,0,,今より強く高く翔べる
Dialogue: 0,0:01:17.31,0:01:24.04,op-jp,,0,0,0,,恐れを知って哀を知って進むなら
Dialogue: 0,0:01:24.04,0:01:31.51,op-jp,,0,0,0,,己の全て捧げ旗を上げろ
Dialogue: 0,0:01:31.51,0:01:37.08,op-jp,,0,0,0,,掠れた声を何度も張りあげてよ
Dialogue: 0,0:01:37.08,0:01:41.96,op-jp,,0,0,0,,希望を決意を抱いて
Dialogue: 0,0:00:52.24,0:00:58.67,op-cn,,0,0,0,,汗水滚落 烈日当头 我闭上双眼
Dialogue: 0,0:00:58.67,0:01:04.92,op-cn,,0,0,0,,眼中映出 与你的约定
Dialogue: 0,0:01:04.92,0:01:11.56,op-cn,,0,0,0,,点燃以意志织成的导火线
Dialogue: 0,0:01:11.56,0:01:17.31,op-cn,,0,0,0,,向着更高更强 振翅高飞
Dialogue: 0,0:01:17.31,0:01:24.04,op-cn,,0,0,0,,知晓恐惧 知晓哀伤 前进不息
Dialogue: 0,0:01:24.04,0:01:31.51,op-cn,,0,0,0,,献出一切 高举旗帜
Dialogue: 0,0:01:31.51,0:01:37.08,op-cn,,0,0,0,,无数次发出嘶吼
Dialogue: 0,0:01:37.08,0:01:41.96,op-cn,,0,0,0,,心怀希望 坚定决心
Comment: 0,0:22:53.94,0:22:53.94,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:05.03,0:23:07.98,ed-jp,,0,0,1,,なぁ坊やどうした？ここは戦場だぜ
Dialogue: 0,0:23:07.98,0:23:10.81,ed-jp,,0,0,1,,たぎる憎悪のラリー　背馳の成長過程
Dialogue: 0,0:23:10.81,0:23:13.62,ed-jp,,0,0,1,,加減も知らず殺気立ったままの剣に
Dialogue: 0,0:23:13.62,0:23:16.79,ed-jp,,0,0,1,,発汗する体　カルマか咎　如何に？
Dialogue: 0,0:23:16.79,0:23:19.26,ed-jp,,0,0,1,,恒　現実は不調和な旋律さ
Dialogue: 0,0:23:19.26,0:23:22.27,ed-jp,,0,0,1,,冷血なステンレス製の心臓持つ演説者
Dialogue: 0,0:23:22.27,0:23:24.92,ed-jp,,0,0,1,,何回目の明滅　また凱旋するテンペスタ
Dialogue: 0,0:23:24.92,0:23:28.02,ed-jp,,0,0,1,,アーチかける善悪　もう応答しない生存者
Dialogue: 0,0:23:29.12,0:23:31.76,ed-jp,,0,0,0,,花のよう　咲うＭｙ　Ｒｅｄ
Dialogue: 0,0:23:31.93,0:23:40.30,ed-jp,,0,0,0,,守りたいものだって　この掌離れれば
Dialogue: 0,0:23:40.46,0:23:47.93,ed-jp,,0,0,0,,壊したいものなんて　壊せないものだけ
Dialogue: 0,0:23:49.83,0:23:55.57,ed-jp,,0,0,0,,唸る　その狂気が　花咲かすダリア
Dialogue: 0,0:23:55.57,0:23:58.29,ed-jp,,0,0,0,,振りかざす度　歪んだ定規
Dialogue: 0,0:23:58.29,0:24:01.13,ed-jp,,0,0,0,,反射する対照的な正義
Dialogue: 0,0:24:01.13,0:24:06.80,ed-jp,,0,0,0,,裏切りのゲリラ　散らす羽たちが
Dialogue: 0,0:24:06.80,0:24:09.78,ed-jp,,0,0,0,,飛ぶ鳥の蹴った地面のようさ
Dialogue: 0,0:24:09.78,0:24:14.85,ed-jp,,0,0,0,,君にもあるんでしょう？キズツケタクナイモノ
Dialogue: 0,0:23:05.03,0:23:07.98,ed-cn,,0,0,0,,怎么了小弟弟？这里可是战场
Dialogue: 0,0:23:07.98,0:23:10.81,ed-cn,,0,0,0,,是憎恶翻腾的拉力赛 与成长背道而驰
Dialogue: 0,0:23:10.81,0:23:13.62,ed-cn,,0,0,0,,不知轻重 利剑杀气腾腾
Dialogue: 0,0:23:13.62,0:23:16.79,ed-cn,,0,0,0,,汗流浃背 是业是罪 如何判定？
Dialogue: 0,0:23:16.79,0:23:19.26,ed-cn,,0,0,0,,现实永远是不和谐旋律
Dialogue: 0,0:23:19.26,0:23:22.27,ed-cn,,0,0,0,,拥有钢铁心脏的冷血演讲者
Dialogue: 0,0:23:22.27,0:23:24.92,ed-cn,,0,0,0,,第几次电闪雷鸣 暴风雨再次凯旋
Dialogue: 0,0:23:24.92,0:23:28.02,ed-cn,,0,0,0,,善恶架上彩虹 生还者已无应答
Dialogue: 0,0:23:29.12,0:23:31.76,ed-cn,,0,0,0,,如花般绽放笑容 My Red
Dialogue: 0,0:23:31.93,0:23:40.30,ed-cn,,0,0,0,,想要守护之物 离开掌中便无从守护
Dialogue: 0,0:23:40.46,0:23:47.93,ed-cn,,0,0,0,,想要毁灭之物 全都是无法毁灭之物
Dialogue: 0,0:23:49.83,0:23:55.57,ed-cn,,0,0,0,,呻吟不止 疯狂如盛开的大丽花
Dialogue: 0,0:23:55.57,0:23:58.29,ed-cn,,0,0,0,,标尺一经举起 立刻扭曲
Dialogue: 0,0:23:58.29,0:24:01.13,ed-cn,,0,0,0,,反射出对立的正义
Dialogue: 0,0:24:01.13,0:24:06.80,ed-cn,,0,0,0,,叛逆的游击 散落的羽翼
Dialogue: 0,0:24:06.80,0:24:09.78,ed-cn,,0,0,0,,如飞鸟蹬踏的地面一般
Dialogue: 0,0:24:09.78,0:24:14.85,ed-cn,,0,0,0,,你一定也有不愿伤害之物
Dialogue: 0,0:00:03.64,0:00:08.31,Default,,0,0,0,,以上就是头儿给你们的最后命令
Dialogue: 0,0:00:10.00,0:00:12.60,Default,,0,0,0,,明白了吧 好好干
Dialogue: 0,0:00:12.86,0:00:14.16,Default,,0,0,0,,等一下 大叔
Dialogue: 0,0:00:15.16,0:00:17.08,Default,,0,0,0,,桓骑真是这么说的吗
Dialogue: 0,0:00:17.59,0:00:20.21,Default,,0,0,0,,你们的任务吗 没错
Dialogue: 0,0:00:20.21,0:00:22.04,Default,,0,0,0,,不是这个
Dialogue: 0,0:00:22.64,0:00:26.30,Default,,0,0,0,,桓骑真的说了战斗会在今天结束吗
Dialogue: 0,0:00:27.51,0:00:30.48,Default,,0,0,0,,对 他确实这么说了
Dialogue: 0,0:02:01.56,0:02:04.77,biaoti,,0,0,0,,{\fad(480,480)}胜败已决的深夜
Dialogue: 0,0:02:11.92,0:02:14.32,Default,,0,0,0,,快 快叫传令兵
Dialogue: 0,0:02:18.29,0:02:19.73,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:02:20.67,0:02:23.95,Default,,0,0,0,,请 请快来山脚 快点
Dialogue: 0,0:02:24.15,0:02:24.83,Default,,0,0,0,,山脚？
Dialogue: 0,0:02:25.15,0:02:26.21,Default,,0,0,0,,敌袭吗
Dialogue: 0,0:02:26.62,0:02:28.55,Default,,0,0,0,,不 不是敌袭
Dialogue: 0,0:02:28.72,0:02:29.96,Default,,0,0,0,,那 那是…
Dialogue: 0,0:02:30.58,0:02:32.57,Default,,0,0,0,,不知道该怎么形容
Dialogue: 0,0:02:34.49,0:02:36.53,Default,,0,0,0,,还 还收到了桓骑的文书
Dialogue: 0,0:02:37.48,0:02:40.04,Default,,0,0,0,,文书中说 那东西是…
Dialogue: 0,0:02:40.50,0:02:42.85,Default,,0,0,0,,是给纪彗大人的礼物
Dialogue: 0,0:02:43.33,0:02:45.39,Default,,0,0,0,,总 总之请快点去山脚
Dialogue: 0,0:02:46.55,0:02:47.23,Default,,0,0,0,,金毛
Dialogue: 0,0:02:48.89,0:02:50.56,Default,,0,0,0,,大本营暂且交给你了
Dialogue: 0,0:02:56.68,0:02:59.70,Default,,0,0,0,,喂 要出要塞吗
Dialogue: 0,0:03:00.36,0:03:03.15,Default,,0,0,0,,没关系 这一带没有桓骑兵
Dialogue: 0,0:03:03.42,0:03:06.37,Default,,0,0,0,,我们的部队也在山下防守着大片区域
Dialogue: 0,0:03:08.12,0:03:09.75,Default,,0,0,0,,究竟是什么东西
Dialogue: 0,0:03:16.86,0:03:17.68,Default,,0,0,0,,青公
Dialogue: 0,0:03:18.45,0:03:20.43,Default,,0,0,0,,城主 这边走
Dialogue: 0,0:03:22.80,0:03:25.80,Default,,0,0,0,,青公老爷子居然在害怕？
Dialogue: 0,0:03:57.09,0:03:59.41,Default,,0,0,0,,这 这是什么
Dialogue: 0,0:03:59.66,0:04:01.18,Default,,0,0,0,,简直不是人
Dialogue: 0,0:04:01.96,0:04:06.31,Default,,0,0,0,,这简直不是人之所为 桓骑禽兽
Dialogue: 0,0:04:08.14,0:04:10.52,Default,,0,0,0,,故意不用俘获的士兵
Dialogue: 0,0:04:10.67,0:04:13.61,Default,,0,0,0,,而是把黑羊居民做成了这样
Dialogue: 0,0:04:14.86,0:04:17.81,Default,,0,0,0,,桓骑是为了刺激我
Dialogue: 0,0:04:18.20,0:04:20.37,Default,,0,0,0,,而故意把平民…
Dialogue: 0,0:04:23.44,0:04:24.30,Default,,0,0,0,,城主
Dialogue: 0,0:04:24.63,0:04:28.37,Default,,0,0,0,,还有一事 这下面还放着桓骑的文书
Dialogue: 0,0:04:29.84,0:04:31.33,Default,,0,0,0,,念吧
Dialogue: 0,0:04:32.12,0:04:32.73,Default,,0,0,0,,是
Dialogue: 0,0:04:35.16,0:04:38.90,Default,,0,0,0,,「致 敬爱的名将 纪彗大人」
Dialogue: 0,0:04:40.54,0:04:44.50,Default,,0,0,0,,「你身为副将却战功卓越 令人敬佩」
Dialogue: 0,0:04:45.32,0:04:47.88,Default,,0,0,0,,「为赞颂英勇的纪彗大人」
Dialogue: 0,0:04:49.04,0:04:51.83,Default,,0,0,0,,「将这尸骸巨像赠送于你」
Dialogue: 0,0:04:52.62,0:04:56.28,Default,,0,0,0,,「你要细细观赏 把它印在眼底」
Dialogue: 0,0:04:57.12,0:04:58.57,Default,,0,0,0,,「我告诉你 纪彗」
Dialogue: 0,0:04:59.41,0:05:00.82,Default,,0,0,0,,「我会在」…
Dialogue: 0,0:05:05.86,0:05:08.12,Default,,0,0,0,,「我会在」…
Dialogue: 0,0:05:08.83,0:05:12.71,Default,,0,0,0,,「我会在你的离眼城制造更甚于此的惨剧」
Dialogue: 0,0:05:12.71,0:05:14.74,Default,,0,0,0,,「好好期待吧」
Dialogue: 0,0:05:17.71,0:05:19.42,Default,,0,0,0,,什 什么？
Dialogue: 0,0:05:20.36,0:05:21.87,Default,,0,0,0,,瞭望台的锣声？
Dialogue: 0,0:05:22.28,0:05:24.20,Default,,0,0,0,,急报 急报
Dialogue: 0,0:05:24.20,0:05:25.20,Default,,0,0,0,,什么事
Dialogue: 0,0:05:25.64,0:05:28.56,Default,,0,0,0,,桓 桓骑军开始移动了
Dialogue: 0,0:05:28.83,0:05:30.58,Default,,0,0,0,,往东南去了
Dialogue: 0,0:05:30.92,0:05:33.08,Default,,0,0,0,,往离眼城方向去了
Dialogue: 0,0:05:34.19,0:05:38.02,Default,,0,0,0,,你会怎么办 纪彗
Dialogue: 0,0:05:40.99,0:05:42.40,Default,,0,0,0,,要放弃山丘？
Dialogue: 0,0:05:42.98,0:05:46.22,Default,,0,0,0,,你 你知道你在说什么吗 纪彗
Dialogue: 0,0:05:46.63,0:05:48.91,Default,,0,0,0,,占领这座山丘 就能取得战争胜利
Dialogue: 0,0:05:49.32,0:05:52.54,Default,,0,0,0,,我们已经胜利在望 你却要自毁胜利吗
Dialogue: 0,0:05:53.12,0:05:56.54,Default,,0,0,0,,我必须去救离眼
Dialogue: 0,0:05:58.66,0:06:00.58,Default,,0,0,0,,纪彗 你冷静一点
Dialogue: 0,0:06:00.88,0:06:04.59,Default,,0,0,0,,从战略上看 桓骑军攻打离眼城毫无意义
Dialogue: 0,0:06:04.92,0:06:06.78,Default,,0,0,0,,就算攻下离眼那个飞地
Dialogue: 0,0:06:06.90,0:06:09.56,Default,,0,0,0,,也只会被赵军包围 自取灭亡
Dialogue: 0,0:06:09.86,0:06:12.56,Default,,0,0,0,,那明显就是引你出洞的圈套
Dialogue: 0,0:06:13.26,0:06:14.68,Default,,0,0,0,,他们肯定还藏了部队
Dialogue: 0,0:06:14.82,0:06:18.33,Default,,0,0,0,,等着在纪彗军离开后攻打山丘
Dialogue: 0,0:06:18.99,0:06:21.44,Default,,0,0,0,,这种事城主当然也清楚
Dialogue: 0,0:06:23.02,0:06:25.04,Default,,0,0,0,,但也必须要追
Dialogue: 0,0:06:25.14,0:06:29.82,Default,,0,0,0,,否则桓骑一定会把离眼变成血海来泄愤
Dialogue: 0,0:06:29.95,0:06:32.68,Default,,0,0,0,,而且手段会比对黑羊居民更加残忍
Dialogue: 0,0:06:33.35,0:06:36.69,Default,,0,0,0,,此时此刻 桓骑军也在不断前进
Dialogue: 0,0:06:36.69,0:06:38.63,Default,,0,0,0,,快去追吧 纪彗大人
Dialogue: 0,0:06:38.87,0:06:39.66,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:06:39.76,0:06:40.88,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:06:41.96,0:06:42.76,Default,,0,0,0,,金毛
Dialogue: 0,0:06:43.39,0:06:44.29,Default,,0,0,0,,纪彗
Dialogue: 0,0:06:44.50,0:06:47.47,Default,,0,0,0,,你等三天…不 至少等两天
Dialogue: 0,0:06:47.94,0:06:51.45,Default,,0,0,0,,等要塞完工 就能只靠庆舍军守住山丘
Dialogue: 0,0:06:51.89,0:06:52.78,Default,,0,0,0,,不可能
Dialogue: 0,0:06:53.19,0:06:56.64,Default,,0,0,0,,现在的离眼跟桓骑军交战 连半天都撑不住
Dialogue: 0,0:06:57.48,0:06:58.73,Default,,0,0,0,,你们有完没完
Dialogue: 0,0:06:59.33,0:07:03.44,Default,,0,0,0,,别以为你们这自私的行为能得逞
Dialogue: 0,0:07:03.99,0:07:07.61,Default,,0,0,0,,事已至此却放弃战斗 我决不容许
Dialogue: 0,0:07:07.92,0:07:09.88,Default,,0,0,0,,既然你执意要走
Dialogue: 0,0:07:09.88,0:07:12.45,Default,,0,0,0,,那我就是杀了你 也要把你留住
Dialogue: 0,0:07:12.79,0:07:13.91,Default,,0,0,0,,纪彗
Dialogue: 0,0:07:15.13,0:07:18.26,Default,,0,0,0,,那我就先杀了你
Dialogue: 0,0:07:19.72,0:07:21.52,Default,,0,0,0,,你真敢说啊 混蛋
Dialogue: 0,0:07:21.52,0:07:23.11,Default,,0,0,0,,住手 岳婴
Dialogue: 0,0:07:24.22,0:07:26.22,Default,,0,0,0,,要是此时杀了纪彗
Dialogue: 0,0:07:26.73,0:07:30.85,Default,,0,0,0,,离眼军就将成为敢死队 袭击我们
Dialogue: 0,0:07:31.40,0:07:36.35,Default,,0,0,0,,对于如今的赵军来说 这可是最糟糕的做法
Dialogue: 0,0:07:36.66,0:07:39.86,Default,,0,0,0,,如果连这都不知道 那你就重新从步兵做起吧
Dialogue: 0,0:07:41.98,0:07:43.24,Default,,0,0,0,,金毛大人…
Dialogue: 0,0:07:44.23,0:07:51.99,Default,,0,0,0,,如今我们面临着选择战争胜败的终极抉择
Dialogue: 0,0:07:52.38,0:07:55.81,Default,,0,0,0,,逼迫我们抉择的 就是桓骑
Dialogue: 0,0:07:56.60,0:08:01.03,Default,,0,0,0,,而做出抉择的自然是全军主将
Dialogue: 0,0:08:01.53,0:08:04.48,Default,,0,0,0,,也就是如今赵军实质上的主将
Dialogue: 0,0:08:04.90,0:08:05.92,Default,,0,0,0,,纪彗
Dialogue: 0,0:08:06.95,0:08:08.92,Default,,0,0,0,,金毛 你个混蛋
Dialogue: 0,0:08:09.89,0:08:10.72,Default,,0,0,0,,金毛…
Dialogue: 0,0:08:14.99,0:08:18.12,Default,,0,0,0,,但是最后 作为中央的武将
Dialogue: 0,0:08:18.25,0:08:21.02,Default,,0,0,0,,离眼城城主纪彗 我要告诉你一句话
Dialogue: 0,0:08:23.00,0:08:25.75,Default,,0,0,0,,我们庆舍军不是只为离眼
Dialogue: 0,0:08:25.94,0:08:29.53,Default,,0,0,0,,而是为了保卫赵国 才来到黑羊作战
Dialogue: 0,0:08:31.82,0:08:33.47,Default,,0,0,0,,要是黑羊失守
Dialogue: 0,0:08:33.63,0:08:38.20,Default,,0,0,0,,秦军就会以此为据点 侵略周围一带
Dialogue: 0,0:08:39.02,0:08:41.37,Default,,0,0,0,,离眼只是其中一城
Dialogue: 0,0:08:41.75,0:08:47.28,Default,,0,0,0,,真到那时 不知会有多少赵国人流血丧命
Dialogue: 0,0:08:47.63,0:08:49.30,Default,,0,0,0,,根本无可估量
Dialogue: 0,0:08:50.67,0:08:53.99,Default,,0,0,0,,而当这一带全部化为秦国领土时
Dialogue: 0,0:08:54.20,0:08:55.37,Default,,0,0,0,,自不必说
Dialogue: 0,0:08:55.64,0:09:00.58,Default,,0,0,0,,赵国将受到范围更大 程度更深的侵略
Dialogue: 0,0:09:01.30,0:09:03.98,Default,,0,0,0,,黑羊之战就是为了避免这种事
Dialogue: 0,0:09:04.80,0:09:08.60,Default,,0,0,0,,为了不使这种事发生 大家流血战斗
Dialogue: 0,0:09:08.86,0:09:11.49,Default,,0,0,0,,为保家卫国的大义而死
Dialogue: 0,0:09:14.38,0:09:17.00,Default,,0,0,0,,如果只为离眼一城就要离开战场
Dialogue: 0,0:09:17.14,0:09:19.83,Default,,0,0,0,,那这一切都将化为乌有
Dialogue: 0,0:09:20.41,0:09:22.09,Default,,0,0,0,,只为离眼一城
Dialogue: 0,0:09:22.27,0:09:25.63,Default,,0,0,0,,赵国很可能失去西部的大片疆域
Dialogue: 0,0:09:26.19,0:09:30.32,Default,,0,0,0,,这一抉择就是如此沉重
Dialogue: 0,0:09:30.48,0:09:33.54,Default,,0,0,0,,你要考虑清楚 纪彗
Dialogue: 0,0:09:43.39,0:09:45.56,Default,,0,0,0,,城 城主…
Dialogue: 0,0:09:53.63,0:09:54.62,Default,,0,0,0,,我…
Dialogue: 0,0:09:59.68,0:10:01.05,Default,,0,0,0,,怎么样 爹
Dialogue: 0,0:10:02.51,0:10:04.81,Default,,0,0,0,,做得挺好的嘛 佳德
Dialogue: 0,0:10:05.29,0:10:09.88,Default,,0,0,0,,为了让纪彗大人平安归来 我们做了好多呢
Dialogue: 0,0:10:10.91,0:10:12.31,Default,,0,0,0,,是吗是吗
Dialogue: 0,0:10:12.79,0:10:14.44,Default,,0,0,0,,喂 快看
Dialogue: 0,0:10:17.53,0:10:19.00,Default,,0,0,0,,是 是军队
Dialogue: 0,0:10:19.00,0:10:20.93,Default,,0,0,0,,规 规模好大
Dialogue: 0,0:10:21.20,0:10:22.59,Default,,0,0,0,,这 这不可能
Dialogue: 0,0:10:22.92,0:10:26.22,Default,,0,0,0,,纪彗大人…黑羊来过消息吗
Dialogue: 0,0:10:26.31,0:10:27.49,Default,,0,0,0,,没有
Dialogue: 0,0:10:27.49,0:10:29.90,Default,,0,0,0,,黑羊那边已经两天没来过消息了
Dialogue: 0,0:10:32.39,0:10:35.66,Default,,0,0,0,,敌袭 敌袭 大家快进地下
Dialogue: 0,0:10:35.91,0:10:38.41,Default,,0,0,0,,是桓骑 桓骑来了
Dialogue: 0,0:10:38.41,0:10:41.00,Default,,0,0,0,,不会吧 黑羊失守了吗
Dialogue: 0,0:10:41.11,0:10:42.90,Default,,0,0,0,,这么说 纪彗大人他们…
Dialogue: 0,0:10:43.20,0:10:44.92,Default,,0,0,0,,输 输掉了吗
Dialogue: 0,0:10:45.39,0:10:46.56,Default,,0,0,0,,纪彗大人…
Dialogue: 0,0:10:46.68,0:10:47.88,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:10:47.88,0:10:49.46,Default,,0,0,0,,快去地下
Dialogue: 0,0:10:49.70,0:10:52.21,Default,,0,0,0,,桓骑军已经近在眼前了
Dialogue: 0,0:10:52.50,0:10:55.25,Default,,0,0,0,,你干什么 佳德 快下去
Dialogue: 0,0:10:55.50,0:10:56.96,Default,,0,0,0,,和你奶奶到地下去
Dialogue: 0,0:10:57.85,0:10:58.84,Default,,0,0,0,,爹
Dialogue: 0,0:11:14.16,0:11:16.66,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:11:17.55,0:11:19.99,Default,,0,0,0,,纪彗大人 恭贺您凯旋
Dialogue: 0,0:11:23.38,0:11:25.12,Default,,0,0,0,,召集家臣
Dialogue: 0,0:11:26.49,0:11:30.14,Default,,0,0,0,,我们必须准备离开离眼
Dialogue: 0,0:11:37.04,0:11:39.44,Default,,0,0,0,,时间回到两天前
Dialogue: 0,0:11:40.55,0:11:45.19,Default,,0,0,0,,桓骑那家伙 他真的说要仅凭我们攻下山丘吗
Dialogue: 0,0:11:45.56,0:11:47.40,Default,,0,0,0,,不只飞信队
Dialogue: 0,0:11:47.83,0:11:51.42,Default,,0,0,0,,据传令兵说 还有其他桓骑兵埋伏在此
Dialogue: 0,0:11:51.83,0:11:54.32,Default,,0,0,0,,那也没多少人吧
Dialogue: 0,0:11:54.63,0:11:57.43,Default,,0,0,0,,桓骑军的大半都离开了黑羊
Dialogue: 0,0:11:57.56,0:11:59.16,Default,,0,0,0,,信大人 小声点
Dialogue: 0,0:11:59.92,0:12:00.82,Default,,0,0,0,,再说了
Dialogue: 0,0:12:01.03,0:12:07.99,Default,,0,0,0,,占据山丘的赵军 怎么可能特地下来追他们啊
Dialogue: 0,0:12:08.17,0:12:09.20,Default,,0,0,0,,就是
Dialogue: 0,0:12:09.41,0:12:12.14,Default,,0,0,0,,正常想想 这种蠢事…
Dialogue: 0,0:12:13.08,0:12:15.92,Default,,0,0,0,,信大人 赵军正在下山
Dialogue: 0,0:12:17.39,0:12:18.55,Default,,0,0,0,,不 不是吧
Dialogue: 0,0:12:19.09,0:12:21.12,Default,,0,0,0,,他们…为什么…
Dialogue: 0,0:12:23.58,0:12:25.46,Default,,0,0,0,,好啊
Dialogue: 0,0:12:28.41,0:12:32.06,Default,,0,0,0,,我不会让离眼发生你所担心的事
Dialogue: 0,0:12:35.19,0:12:40.34,Default,,0,0,0,,此时 占据守丘赵军一半的纪彗军
Dialogue: 0,0:12:40.34,0:12:43.24,Default,,0,0,0,,奔下山丘 朝远处离去
Dialogue: 0,0:12:44.22,0:12:46.87,Default,,0,0,0,,全速前进 追赶桓骑
Dialogue: 0,0:12:46.87,0:12:47.78,Default,,0,0,0,,是
Dialogue: 0,0:12:47.99,0:12:48.78,Default,,0,0,0,,另一方面
Dialogue: 0,0:12:49.01,0:12:52.50,Default,,0,0,0,,金毛和岳婴率领的庆舍军留在山丘上
Dialogue: 0,0:12:52.66,0:12:55.13,Default,,0,0,0,,摆出了死守到底的架势
Dialogue: 0,0:12:59.16,0:13:01.46,Default,,0,0,0,,垃圾去死
Dialogue: 0,0:13:10.80,0:13:14.11,Default,,0,0,0,,信 敌军在陆续下山了
Dialogue: 0,0:13:14.61,0:13:16.11,Default,,0,0,0,,这边也是 队长
Dialogue: 0,0:13:16.41,0:13:19.11,Default,,0,0,0,,信大人 这意味着我们…
Dialogue: 0,0:13:22.39,0:13:23.13,Default,,0,0,0,,嗯
Dialogue: 0,0:13:24.03,0:13:25.62,Default,,0,0,0,,岳婴 快走吧
Dialogue: 0,0:13:25.62,0:13:27.87,Default,,0,0,0,,你先走 我随后就来
Dialogue: 0,0:13:28.15,0:13:28.84,Default,,0,0,0,,不行
Dialogue: 0,0:13:28.84,0:13:31.33,Default,,0,0,0,,要是死在这里 只会落个败将之名
Dialogue: 0,0:13:33.83,0:13:36.34,Default,,0,0,0,,要活下去为庆舍大人报仇
Dialogue: 0,0:13:37.20,0:13:39.72,Default,,0,0,0,,很遗憾 到此为止了
Dialogue: 0,0:13:40.68,0:13:42.72,Default,,0,0,0,,撤离黑羊
Dialogue: 0,0:13:43.37,0:13:47.13,Default,,0,0,0,,第五天日暮时分 赵军 全军撤退
Dialogue: 0,0:13:47.72,0:13:52.65,Default,,0,0,0,,至此 秦军取得了黑羊丘之战的胜利
Dialogue: 0,0:13:54.08,0:13:58.33,Default,,0,0,0,,而桓骑在确定纪彗军追来之后
Dialogue: 0,0:13:58.33,0:14:00.48,Default,,0,0,0,,等他们足够接近后分散部队
Dialogue: 0,0:14:00.48,0:14:02.40,Default,,0,0,0,,朝多个方向逃离
Dialogue: 0,0:14:04.15,0:14:04.87,Default,,0,0,0,,最后
Dialogue: 0,0:14:05.64,0:14:08.94,Default,,0,0,0,,返回已被桓骑军占领的中央丘
Dialogue: 0,0:14:10.80,0:14:13.28,Default,,0,0,0,,不紧不慢地登上了丘顶
Dialogue: 0,0:14:27.75,0:14:30.21,Default,,0,0,0,,又不知从哪儿带来了女人
Dialogue: 0,0:14:30.52,0:14:32.08,Default,,0,0,0,,压倒性胜利？
Dialogue: 0,0:14:32.25,0:14:32.75,Default,,0,0,0,,嗯
Dialogue: 0,0:14:33.97,0:14:38.92,Default,,0,0,0,,在那贵他们的协助下 我基本掌握了战局全貌
Dialogue: 0,0:14:39.52,0:14:42.76,Default,,0,0,0,,然后发现 桓骑确实是非同小可
Dialogue: 0,0:14:44.53,0:14:47.28,Default,,0,0,0,,我们昨天正打算击杀庆舍的时候
Dialogue: 0,0:14:47.84,0:14:51.96,Default,,0,0,0,,桓骑就已经将目标从庆舍转移到了纪彗身上
Dialogue: 0,0:14:55.75,0:14:59.17,Default,,0,0,0,,于是 他叫来特别的拷问专家
Dialogue: 0,0:14:59.89,0:15:03.56,Default,,0,0,0,,从俘获的离眼兵口中 问出了纪彗的所有经历
Dialogue: 0,0:15:04.43,0:15:09.99,Default,,0,0,0,,然后他突然停下两军持续了四天的夺丘大战
Dialogue: 0,0:15:10.26,0:15:14.00,Default,,0,0,0,,把所有部队撤下山丘 把山丘送给了赵军
Dialogue: 0,0:15:16.00,0:15:19.86,Default,,0,0,0,,他一边让赵军修筑要塞
Dialogue: 0,0:15:20.47,0:15:23.10,Default,,0,0,0,,一边在黑羊烧村
Dialogue: 0,0:15:24.36,0:15:26.53,Default,,0,0,0,,把平民的尸体收集了起来
Dialogue: 0,0:15:27.43,0:15:30.20,Default,,0,0,0,,再把这些尸体给纪彗看
Dialogue: 0,0:15:31.09,0:15:33.43,Default,,0,0,0,,威胁他说「离眼也会落得这个下场」
Dialogue: 0,0:15:35.80,0:15:39.86,Default,,0,0,0,,因此纪彗舍弃山丘 前去搭救离眼
Dialogue: 0,0:15:41.30,0:15:42.79,Default,,0,0,0,,导致赵军落败
Dialogue: 0,0:15:43.59,0:15:45.09,Default,,0,0,0,,这 这么说
Dialogue: 0,0:15:45.09,0:15:48.72,Default,,0,0,0,,从结果上来说 是烧村帮助秦军取胜…
Dialogue: 0,0:15:49.50,0:15:50.64,Default,,0,0,0,,{\pos(560,1067)}好痛
Dialogue: 0,0:15:49.98,0:15:50.64,Default,,0,0,0,,{\pos(1264,1067)}昂
Dialogue: 0,0:15:50.93,0:15:52.20,Default,,0,0,0,,昂说得没错
Dialogue: 0,0:15:53.53,0:15:55.03,Default,,0,0,0,,就是靠烧村赢的
Dialogue: 0,0:15:57.60,0:15:59.98,Default,,0,0,0,,战斗第四天 大局定会有变
Dialogue: 0,0:16:00.44,0:16:04.99,Default,,0,0,0,,换成军略家 一定会苦思攻占山丘之法
Dialogue: 0,0:16:05.61,0:16:10.35,Default,,0,0,0,,而桓骑却抛开山丘 转而攻略纪彗这个人
Dialogue: 0,0:16:11.82,0:16:15.28,Default,,0,0,0,,最后 他以村民的尸体为必杀武器
Dialogue: 0,0:16:15.40,0:16:18.85,Default,,0,0,0,,刺中纪彗的弱点 迫使他离开山丘
Dialogue: 0,0:16:18.85,0:16:21.25,Default,,0,0,0,,取得了黑羊之战的胜利
Dialogue: 0,0:16:22.18,0:16:25.20,Default,,0,0,0,,这不是军略也不是战术
Dialogue: 0,0:16:26.57,0:16:27.88,Default,,0,0,0,,这种取胜方式…
Dialogue: 0,0:16:29.32,0:16:33.54,Default,,0,0,0,,就算是昌平君和李牧 也绝不可能模仿
Dialogue: 0,0:16:35.41,0:16:37.14,Default,,0,0,0,,但正因无法模仿
Dialogue: 0,0:16:37.14,0:16:39.72,Default,,0,0,0,,所以这种压倒性胜利 也只有头儿才能实现
Dialogue: 0,0:16:41.26,0:16:44.40,Default,,0,0,0,,夺取山丘后将其建为要塞也是难题
Dialogue: 0,0:16:44.62,0:16:49.79,Default,,0,0,0,,而头儿迫使赵军修建要塞 在近乎完工时一举夺得
Dialogue: 0,0:16:51.52,0:16:53.15,Default,,0,0,0,,最重要的是数量
Dialogue: 0,0:16:53.62,0:16:57.16,Default,,0,0,0,,桓骑中止了纯属消耗战的夺丘大战
Dialogue: 0,0:16:57.25,0:16:59.95,Default,,0,0,0,,所以阵亡人数…
Dialogue: 0,0:17:00.54,0:17:02.14,Default,,0,0,0,,不到战前预估的一半
Dialogue: 0,0:17:02.67,0:17:03.94,Default,,0,0,0,,不到一半？
Dialogue: 0,0:17:04.62,0:17:09.81,Default,,0,0,0,,只看结果的话 他的战果要远超大军略家
Dialogue: 0,0:17:10.94,0:17:12.03,Default,,0,0,0,,等一下
Dialogue: 0,0:17:12.28,0:17:16.13,Default,,0,0,0,,那个只会乱来的混蛋居然比李牧还厉害？
Dialogue: 0,0:17:18.34,0:17:20.95,Default,,0,0,0,,不可能吧 他到底…
Dialogue: 0,0:17:22.50,0:17:25.07,Default,,0,0,0,,他到底是何方神圣
Dialogue: 0,0:17:28.84,0:17:31.03,Default,,0,0,0,,头儿身上谜团重重
Dialogue: 0,0:17:32.57,0:17:38.10,Default,,0,0,0,,为什么那么强 有没有亲属 又是从哪里来
Dialogue: 0,0:17:38.43,0:17:40.65,Default,,0,0,0,,就连雷土他们干部都不知道
Dialogue: 0,0:17:42.22,0:17:42.92,Default,,0,0,0,,头儿呢
Dialogue: 0,0:17:43.99,0:17:46.25,Default,,0,0,0,,但是有一次
Dialogue: 0,0:17:46.74,0:17:52.30,Default,,0,0,0,,我听资历最老的人说起过头儿的「根」
Dialogue: 0,0:17:53.00,0:17:55.03,Default,,0,0,0,,桓骑的根？
Dialogue: 0,0:17:55.38,0:17:56.38,Default,,0,0,0,,对
Dialogue: 0,0:17:56.51,0:18:01.17,Default,,0,0,0,,那个冷酷无情 战无不胜的天才
Dialogue: 0,0:18:01.77,0:18:04.10,Default,,0,0,0,,他最为核心的根部到底有什么
Dialogue: 0,0:18:05.79,0:18:07.73,Default,,0,0,0,,我这么问道 然后那人说
Dialogue: 0,0:18:09.51,0:18:10.56,Default,,0,0,0,,「愤怒」
Dialogue: 0,0:18:11.38,0:18:15.87,Default,,0,0,0,,桓骑的根是能熔化岩石的愤怒
Dialogue: 0,0:18:17.11,0:18:17.92,Default,,0,0,0,,愤怒？
Dialogue: 0,0:18:18.96,0:18:21.72,Default,,0,0,0,,是对什么的愤怒
Dialogue: 0,0:18:25.29,0:18:27.13,Default,,0,0,0,,对「一切」
Dialogue: 0,0:18:29.89,0:18:31.13,Default,,0,0,0,,等一下
Dialogue: 0,0:18:31.73,0:18:35.30,Default,,0,0,0,,只靠飞信队把西边一座山丘建成要塞 也太难为人了
Dialogue: 0,0:18:35.44,0:18:39.05,Default,,0,0,0,,而且还要我们在黑羊外围巡逻
Dialogue: 0,0:18:39.05,0:18:40.14,Default,,0,0,0,,开什么玩笑
Dialogue: 0,0:18:40.43,0:18:44.39,Default,,0,0,0,,但是 你们的八千人还剩五千吧
Dialogue: 0,0:18:44.68,0:18:46.39,Default,,0,0,0,,几乎都是重伤员
Dialogue: 0,0:18:46.72,0:18:50.03,Default,,0,0,0,,我们在被庆舍主力突袭的时候 伤亡惨重
Dialogue: 0,0:18:50.12,0:18:52.86,Default,,0,0,0,,那还不是因为你们太蠢
Dialogue: 0,0:18:53.06,0:18:56.41,Default,,0,0,0,,你们不会像头儿那样用这里打仗
Dialogue: 0,0:18:56.41,0:18:59.48,Default,,0,0,0,,才会蠢兮兮地死伤那么多人 蠢货
Dialogue: 0,0:18:59.48,0:19:01.28,Default,,0,0,0,,不许瞎说 那是…
Dialogue: 0,0:19:01.28,0:19:02.32,Default,,0,0,0,,别说了 貂
Dialogue: 0,0:19:02.83,0:19:05.73,Default,,0,0,0,,任务我已经清楚了 没事了吧
Dialogue: 0,0:19:05.81,0:19:06.54,Default,,0,0,0,,信
Dialogue: 0,0:19:08.95,0:19:11.93,Default,,0,0,0,,请千万不要偷懒
Dialogue: 0,0:19:12.42,0:19:15.93,Default,,0,0,0,,毕竟负责监视的那贵已经回我们这边了
Dialogue: 0,0:19:18.82,0:19:20.30,Default,,0,0,0,,桓骑在做什么
Dialogue: 0,0:19:20.89,0:19:22.68,Default,,0,0,0,,那之后都没露过面
Dialogue: 0,0:19:23.52,0:19:27.08,Default,,0,0,0,,头儿凭什么要在你面前露面啊
Dialogue: 0,0:19:27.08,0:19:30.72,Default,,0,0,0,,不必担心 他在上面爽着呢
Dialogue: 0,0:19:31.19,0:19:33.42,Default,,0,0,0,,别得意忘形 前奴仆
Dialogue: 0,0:19:33.85,0:19:37.81,Default,,0,0,0,,头儿打一开始就没把你放在眼里
Dialogue: 0,0:19:38.41,0:19:40.46,Default,,0,0,0,,今后也一辈子不会
Dialogue: 0,0:19:47.58,0:19:48.80,Default,,0,0,0,,你闷闷不乐啊
Dialogue: 0,0:19:52.28,0:19:53.09,Default,,0,0,0,,羌瘣
Dialogue: 0,0:19:53.59,0:19:54.88,Default,,0,0,0,,在哪儿集合
Dialogue: 0,0:19:54.88,0:19:56.01,Default,,0,0,0,,这里啊
Dialogue: 0,0:19:58.90,0:20:03.06,Default,,0,0,0,,他确实给我们看到了 他所谓大人的战法
Dialogue: 0,0:20:03.93,0:20:04.55,Default,,0,0,0,,嗯
Dialogue: 0,0:20:05.12,0:20:06.76,Default,,0,0,0,,虽然做法下三滥
Dialogue: 0,0:20:07.07,0:20:10.09,Default,,0,0,0,,但我们还是必须正视结果
Dialogue: 0,0:20:10.55,0:20:14.97,Default,,0,0,0,,毕竟今后可能还会和桓骑一起战斗
Dialogue: 0,0:20:17.25,0:20:21.20,Default,,0,0,0,,虽说他很强 但有些事还是必须制止
Dialogue: 0,0:20:21.51,0:20:22.42,Default,,0,0,0,,那是当然
Dialogue: 0,0:20:23.00,0:20:25.99,Default,,0,0,0,,但要想制止他 就必须爬得比他更高
Dialogue: 0,0:20:27.37,0:20:29.83,Default,,0,0,0,,我要在桓骑之前成为大将军
Dialogue: 0,0:20:32.14,0:20:33.71,Default,,0,0,0,,在他之前很难
Dialogue: 0,0:20:36.20,0:20:38.84,Default,,0,0,0,,但只要和他同级 就足够制止他了
Dialogue: 0,0:20:39.36,0:20:41.00,Default,,0,0,0,,没什么好烦恼的 信
Dialogue: 0,0:20:41.43,0:20:43.31,Default,,0,0,0,,你就照着对尾平说的那样
Dialogue: 0,0:20:45.17,0:20:48.96,Default,,0,0,0,,用你自己的方式 成为威震天下的大将军
Dialogue: 0,0:20:53.49,0:20:55.48,Default,,0,0,0,,嗯 我知道
Dialogue: 0,0:20:56.66,0:21:00.58,Default,,0,0,0,,桓骑 虽然我不知道你的想法
Dialogue: 0,0:21:01.35,0:21:02.54,Default,,0,0,0,,但是我绝对…
Dialogue: 0,0:21:03.76,0:21:05.95,Default,,0,0,0,,不会输给你
Dialogue: 0,0:21:08.38,0:21:09.17,Default,,0,0,0,,羌瘣
Dialogue: 0,0:21:09.26,0:21:11.24,Default,,0,0,0,,给我来一拳鼓鼓劲…
Dialogue: 0,0:21:11.36,0:21:14.26,Default,,0,0,0,,等等 好快 还是用手掌吧
Dialogue: 0,0:21:19.07,0:21:24.83,Default,,0,0,0,,黑羊之战 使桓骑的强大和恐怖 传遍了中华大地
Dialogue: 0,0:21:26.38,0:21:27.98,Default,,0,0,0,,而飞信队
Dialogue: 0,0:21:28.09,0:21:33.67,Default,,0,0,0,,反叛主将桓骑之过 与击杀庆舍之功相抵 无赏无罚
Dialogue: 0,0:21:33.87,0:21:34.37,Default,,0,0,0,,但是
Dialogue: 0,0:21:34.66,0:21:41.21,Default,,0,0,0,,队员知晓信的真心后 队伍更加团结了
Dialogue: 0,0:21:42.12,0:21:45.70,Default,,0,0,0,,也有人因此而被打动
Dialogue: 0,0:21:46.52,0:21:48.08,Default,,0,0,0,,你说什么？
Dialogue: 0,0:21:48.47,0:21:51.28,Default,,0,0,0,,你再说一遍 那贵
Dialogue: 0,0:21:51.56,0:21:53.83,Default,,0,0,0,,没什么好大惊小怪的
Dialogue: 0,0:21:54.59,0:21:57.38,Default,,0,0,0,,我只是说 我要转到飞信队去
Dialogue: 0,0:21:58.86,0:22:02.26,Default,,0,0,0,,你想被开膛破肚吗 混蛋
Dialogue: 0,0:22:02.69,0:22:04.59,Default,,0,0,0,,别激动 雷土
Dialogue: 0,0:22:05.21,0:22:07.26,Default,,0,0,0,,我们是军亦非军
Dialogue: 0,0:22:07.72,0:22:11.72,Default,,0,0,0,,桓骑军的优点 不就是没有死板的条条框框吗
Dialogue: 0,0:22:12.66,0:22:14.92,Default,,0,0,0,,没问题吧 头儿
Dialogue: 0,0:22:16.97,0:22:19.40,Default,,0,0,0,,至少告诉我理由 那贵
Dialogue: 0,0:22:19.91,0:22:22.87,Default,,0,0,0,,就是我常有的性情使然
Dialogue: 0,0:22:24.21,0:22:27.41,Default,,0,0,0,,非要说理由的话 那就是…
Dialogue: 0,0:22:28.02,0:22:31.66,Default,,0,0,0,,那边的饭吃着还挺香
Dialogue: 0,0:22:37.78,0:22:39.17,Default,,0,0,0,,别想走
Dialogue: 0,0:22:39.48,0:22:41.09,Default,,0,0,0,,宰了他
Dialogue: 0,0:22:44.20,0:22:47.73,Default,,0,0,0,,是 是那贵 还带了好多人
Dialogue: 0,0:22:48.22,0:22:49.89,Default,,0,0,0,,怎么都带着伤
Dialogue: 0,0:24:29.54,0:24:31.12,Default,,0,0,0,,都是我的错
Dialogue: 0,0:24:31.94,0:24:34.31,Default,,0,0,0,,我低估了桓骑的实力
Dialogue: 0,0:24:35.24,0:24:37.49,Default,,0,0,0,,我在此对庆舍发誓
Dialogue: 0,0:24:39.76,0:24:42.34,Default,,0,0,0,,我定会亲手为你报仇
Dialogue: 0,0:24:49.88,0:24:51.50,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:51.92,0:24:53.51,Default,,0,0,0,,「蔡泽的信念」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

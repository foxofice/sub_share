Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:01.34,0:01:03.25,Layzner,,0,0,0,,请不要调查雷兹纳
Dialogue: 0,0:01:03.25,0:01:05.50,Layzner,,0,0,0,,你好像很迷惘
Dialogue: 0,0:01:05.50,0:01:08.24,Layzner,,0,0,0,,所以我说了不要动雷兹纳的
Dialogue: 0,0:01:08.24,0:01:10.26,Layzner,,0,0,0,,英二 快逃
Dialogue: 0,0:01:40.81,0:01:44.11,Layzner,,0,0,0,,哇 是海 看到海了
Dialogue: 0,0:01:44.34,0:01:46.02,Layzner,,0,0,0,,对 是海
Dialogue: 0,0:01:46.02,0:01:48.61,Layzner,,0,0,0,,头一次看到这么棒的景色
Dialogue: 0,0:01:51.39,0:01:52.92,Layzner,,0,0,0,,有热源反应
Dialogue: 0,0:01:53.77,0:01:57.22,Layzner,,0,0,0,,我们终于回到地球了
Dialogue: 0,0:01:57.22,0:01:59.05,Layzner,,0,0,0,,和英二一起
Dialogue: 0,0:02:07.71,0:02:13.17,Layzner,,0,0,0,,可是在等待他的是可怕的军方调查
Dialogue: 0,0:02:13.17,0:02:15.89,Layzner,,0,0,0,,他被当成
Dialogue: 0,0:02:15.89,0:02:17.58,Layzner,,0,0,0,,要侵略地球的外星人
Dialogue: 0,0:02:17.99,0:02:21.98,Layzner,,0,0,0,,这根本是把我们当俘虏 让我和联合国总部联络
Dialogue: 0,0:02:21.98,0:02:26.98,Layzner,,0,0,0,,第二十话 雷兹纳的愤怒
Dialogue: 0,0:03:03.99,0:03:06.14,Layzner,,0,0,0,,骨骼意外地跟人类好像
Dialogue: 0,0:03:06.14,0:03:09.41,Layzner,,0,0,0,,也就是说古拉特斯的环境跟地球一样
Dialogue: 0,0:03:09.41,0:03:13.28,Layzner,,0,0,0,,可以说他们生活在有重力的星球上
Dialogue: 0,0:03:23.24,0:03:26.35,Layzner,,0,0,0,,内部器官也没什么不同
Dialogue: 0,0:03:26.35,0:03:29.85,Layzner,,0,0,0,,当然血液方面也一样
Dialogue: 0,0:03:35.08,0:03:39.21,Layzner,,0,0,0,,硬要说他跟我们不同的地方就只有波的系数而已
Dialogue: 0,0:03:39.21,0:03:44.86,Layzner,,0,0,0,,可是这方面的问题也会出现在刚回地球的太空人身上
Dialogue: 0,0:03:48.20,0:03:50.41,Layzner,,0,0,0,,调查我就行
Dialogue: 0,0:03:51.77,0:03:56.03,Layzner,,0,0,0,,只是 不要调查雷兹纳
Dialogue: 0,0:03:56.03,0:03:58.03,Layzner,,0,0,0,,一定会出事的
Dialogue: 0,0:03:58.03,0:04:00.62,Layzner,,0,0,0,,所以请绝对不要对雷兹纳动手
Dialogue: 0,0:04:03.53,0:04:05.30,Layzner,,0,0,0,,出现在火星的少年
Dialogue: 0,0:04:05.49,0:04:09.28,Layzner,,0,0,0,,对你们说他们的目标是地球对吧
Dialogue: 0,0:04:09.28,0:04:10.01,Layzner,,0,0,0,,是的
Dialogue: 0,0:04:10.21,0:04:15.49,Layzner,,0,0,0,,之后你们一直跟那外星人在一起 为什么呢
Dialogue: 0,0:04:15.83,0:04:18.93,Layzner,,0,0,0,,因为他保护我们免受敌人攻击
Dialogue: 0,0:04:19.68,0:04:23.23,Layzner,,0,0,0,,他会不会是别有目的
Dialogue: 0,0:04:23.49,0:04:26.99,Layzner,,0,0,0,,比如说利用你们 才不会
Dialogue: 0,0:04:28.02,0:04:28.79,Layzner,,0,0,0,,对吧
Dialogue: 0,0:04:28.79,0:04:29.82,Layzner,,0,0,0,,他不可能会这样的
Dialogue: 0,0:04:29.82,0:04:32.66,Layzner,,0,0,0,,他是我们的同伴 是我们的救命恩人
Dialogue: 0,0:04:32.66,0:04:37.52,Layzner,,0,0,0,,那我换个问题 你们和古拉特斯军遭遇很多次了
Dialogue: 0,0:04:37.52,0:04:40.95,Layzner,,0,0,0,,你们对他们武器的印象呢
Dialogue: 0,0:04:41.09,0:04:44.29,Layzner,,0,0,0,,感觉他们的科技很先进
Dialogue: 0,0:04:44.53,0:04:49.07,Layzner,,0,0,0,,本来以为被监禁就完了 这次换成被审问
Dialogue: 0,0:04:49.48,0:04:52.59,Layzner,,0,0,0,,不只是我们地球人
Dialogue: 0,0:04:52.95,0:04:56.07,Layzner,,0,0,0,,一想到还要调查外星人的英二
Dialogue: 0,0:04:56.07,0:05:00.23,Layzner,,0,0,0,,我就觉得一阵心痛
Dialogue: 0,0:05:03.95,0:05:07.86,Layzner,,0,0,0,,各位 调查暂时到此结束 可以出来了
Dialogue: 0,0:05:12.55,0:05:14.33,Layzner,,0,0,0,,还要调查吗
Dialogue: 0,0:05:14.95,0:05:18.64,Layzner,,0,0,0,,来就知道了 还是会放了我们呢
Dialogue: 0,0:05:20.62,0:05:22.37,Layzner,,0,0,0,,英二怎么样了
Dialogue: 0,0:05:22.37,0:05:25.73,Layzner,,0,0,0,,你们没有虐待他吧 我想见他
Dialogue: 0,0:05:26.38,0:05:28.11,Layzner,,0,0,0,,你说句话
Dialogue: 0,0:05:28.43,0:05:30.44,Layzner,,0,0,0,,他跟你们不一样
Dialogue: 0,0:05:30.44,0:05:31.67,Layzner,,0,0,0,,哪里不一样
Dialogue: 0,0:05:31.94,0:05:34.58,Layzner,,0,0,0,,就是不知道所以才要调查
Dialogue: 0,0:05:34.76,0:05:38.16,Layzner,,0,0,0,,该不会要把他做成外星人标本吧
Dialogue: 0,0:05:40.60,0:05:43.16,Layzner,,0,0,0,,本来就应该放了小孩的
Dialogue: 0,0:05:43.16,0:05:46.69,Layzner,,0,0,0,,他们的安危是由我们联合国宇宙局负责
Dialogue: 0,0:05:47.03,0:05:50.72,Layzner,,0,0,0,,不管你怎么说那外星人少年不一样
Dialogue: 0,0:05:51.29,0:05:53.88,Layzner,,0,0,0,,只有这件事希望你不要提
Dialogue: 0,0:05:57.56,0:05:59.87,Layzner,,0,0,0,,有问题请长话短说
Dialogue: 0,0:05:59.92,0:06:03.51,Layzner,,0,0,0,,这次火星体验学校的学生能平安回来
Dialogue: 0,0:06:03.51,0:06:06.57,Layzner,,0,0,0,,请联合国宇宙局的代表说句话
Dialogue: 0,0:06:06.57,0:06:11.78,Layzner,,0,0,0,,好的 本来派了26名学生去火星
Dialogue: 0,0:06:11.78,0:06:15.58,Layzner,,0,0,0,,因为发生了不幸的事件无法全员归还
Dialogue: 0,0:06:16.34,0:06:21.21,Layzner,,0,0,0,,身为负责人对于发生不幸事件学生的家人
Dialogue: 0,0:06:21.21,0:06:23.21,Layzner,,0,0,0,,我非常抱歉
Dialogue: 0,0:06:26.00,0:06:28.63,Layzner,,0,0,0,,为什么会变成这样
Dialogue: 0,0:06:28.63,0:06:32.62,Layzner,,0,0,0,,今后我会尽全力调查原因
Dialogue: 0,0:06:32.87,0:06:35.12,Layzner,,0,0,0,,那现在回来的学生们在哪里
Dialogue: 0,0:06:35.24,0:06:36.63,Layzner,,0,0,0,,现在要过来了
Dialogue: 0,0:06:39.19,0:06:42.04,Layzner,,0,0,0,,来了 有一个问题 请回答
Dialogue: 0,0:06:44.95,0:06:47.71,Layzner,,0,0,0,,你们是体验学校的学生吧
Dialogue: 0,0:06:47.71,0:06:50.30,Layzner,,0,0,0,,火星的情况怎么样 发生了什么事
Dialogue: 0,0:06:50.30,0:06:52.62,Layzner,,0,0,0,,你们在干嘛 不要挤
Dialogue: 0,0:06:52.62,0:06:56.70,Layzner,,0,0,0,,我刚听比你们早被释放的八个小孩说
Dialogue: 0,0:06:56.70,0:06:58.85,Layzner,,0,0,0,,听说你们跟外星人在一起是真的吗
Dialogue: 0,0:06:59.07,0:06:59.85,Layzner,,0,0,0,,是真的
Dialogue: 0,0:07:00.18,0:07:03.71,Layzner,,0,0,0,,司令官 我们也想采访那外星人可以让我们见面吗
Dialogue: 0,0:07:03.71,0:07:06.13,Layzner,,0,0,0,,不行 要再过一段时间才行
Dialogue: 0,0:07:06.13,0:07:07.44,Layzner,,0,0,0,,为什么
Dialogue: 0,0:07:08.13,0:07:10.62,Layzner,,0,0,0,,现在还在调查他
Dialogue: 0,0:07:10.62,0:07:14.86,Layzner,,0,0,0,,我们很怀疑他到底是不是外星人
Dialogue: 0,0:07:14.86,0:07:18.37,Layzner,,0,0,0,,知道真相的话就会告诉大家
Dialogue: 0,0:07:18.37,0:07:23.26,Layzner,,0,0,0,,还有他们也很累 今天只能拍照
Dialogue: 0,0:07:23.62,0:07:25.56,Layzner,,0,0,0,,英二到底在哪里
Dialogue: 0,0:07:25.56,0:07:27.56,Layzner,,0,0,0,,你们想对他怎么样
Dialogue: 0,0:07:28.21,0:07:31.67,Layzner,,0,0,0,,记者先生们今天就到此为止吧
Dialogue: 0,0:07:31.78,0:07:36.00,Layzner,,0,0,0,,你 英二就是那外星人少年吗 到底怎样
Dialogue: 0,0:07:36.15,0:07:39.61,Layzner,,0,0,0,,他跟你们有什么关系能说清楚点吗
Dialogue: 0,0:07:39.61,0:07:43.79,Layzner,,0,0,0,,再一下就好 让我再采访一下
Dialogue: 0,0:07:43.79,0:07:45.79,Layzner,,0,0,0,,再一下就好 拜托
Dialogue: 0,0:07:45.79,0:07:49.04,Layzner,,0,0,0,,这样我们什么都不知道嘛
Dialogue: 0,0:07:57.96,0:08:02.34,Layzner,,0,0,0,,你们已经自由了 已经通知你们的家人平安的喜讯
Dialogue: 0,0:08:02.64,0:08:04.67,Layzner,,0,0,0,,等一下他们就会来接你们了
Dialogue: 0,0:08:04.67,0:08:07.44,Layzner,,0,0,0,,先别管我们了 英二怎么了
Dialogue: 0,0:08:09.42,0:08:11.56,Layzner,,0,0,0,,该不会要一直在这吧
Dialogue: 0,0:08:11.56,0:08:15.71,Layzner,,0,0,0,,为什么 英二他做了什么 就是啊
Dialogue: 0,0:08:27.21,0:08:29.19,Layzner,,0,0,0,,博士 伊丽莎白博士呢
Dialogue: 0,0:08:30.16,0:08:34.62,Layzner,,0,0,0,,她辞去联合国宇宙局的工作了
Dialogue: 0,0:08:39.56,0:08:42.16,Layzner,,0,0,0,,伊丽莎白博士 博士
Dialogue: 0,0:08:44.36,0:08:45.32,Layzner,,0,0,0,,大家
Dialogue: 0,0:08:55.39,0:08:58.59,Layzner,,0,0,0,,伊丽莎白博士
Dialogue: 0,0:08:55.39,0:08:58.59,Layzner,,0,0,0,,你辞了联合国的工作以后怎么办
Dialogue: 0,0:08:59.18,0:09:01.22,Layzner,,0,0,0,,你们从基鲁巴特博士那里听到的吧
Dialogue: 0,0:09:01.22,0:09:03.98,Layzner,,0,0,0,,一声不响就走 也太见外了吧
Dialogue: 0,0:09:04.31,0:09:05.68,Layzner,,0,0,0,,抱歉
Dialogue: 0,0:09:06.97,0:09:08.60,Layzner,,0,0,0,,今后你要去哪
Dialogue: 0,0:09:08.60,0:09:11.10,Layzner,,0,0,0,,我可能会暂时待在古雷特身边
Dialogue: 0,0:09:11.65,0:09:12.87,Layzner,,0,0,0,,这样啊
Dialogue: 0,0:09:14.09,0:09:16.26,Layzner,,0,0,0,,真的受您照顾
Dialogue: 0,0:09:16.26,0:09:17.66,Layzner,,0,0,0,,我也是
Dialogue: 0,0:09:19.64,0:09:21.14,Layzner,,0,0,0,,谢谢你
Dialogue: 0,0:09:21.14,0:09:23.14,Layzner,,0,0,0,,你们做的很好
Dialogue: 0,0:09:23.14,0:09:27.80,Layzner,,0,0,0,,可是不要忘了这次的经验哦 保重
Dialogue: 0,0:09:23.14,0:09:27.80,Layzner,,0,0,0,,虽然一路上净是些不想再遇到的事了
Dialogue: 0,0:09:30.25,0:09:32.20,Layzner,,0,0,0,,那个人一定会好的
Dialogue: 0,0:09:32.50,0:09:34.20,Layzner,,0,0,0,,谢谢 大卫
Dialogue: 0,0:09:36.44,0:09:41.47,Layzner,,0,0,0,,快交个很棒的男友忘了那些不愉快的事吧
Dialogue: 0,0:09:42.97,0:09:45.34,Layzner,,0,0,0,,我
Dialogue: 0,0:09:46.22,0:09:48.56,Layzner,,0,0,0,,我会写信给你的
Dialogue: 0,0:09:49.10,0:09:51.93,Layzner,,0,0,0,,要寄你住的地方的风景明信片给我哦
Dialogue: 0,0:09:51.93,0:09:53.02,Layzner,,0,0,0,,是
Dialogue: 0,0:09:55.98,0:09:56.91,Layzner,,0,0,0,,那么再见
Dialogue: 0,0:09:59.47,0:10:01.49,Layzner,,0,0,0,,谢谢你
Dialogue: 0,0:10:15.07,0:10:17.26,Layzner,,0,0,0,,我可以问你一件事吗
Dialogue: 0,0:10:17.26,0:10:21.61,Layzner,,0,0,0,,可是你已经跟他分手了对吧
Dialogue: 0,0:10:17.26,0:10:21.61,Layzner,,0,0,0,,你说你要待在古雷特身边
Dialogue: 0,0:10:21.61,0:10:24.10,Layzner,,0,0,0,,对 我们已没关系了
Dialogue: 0,0:10:24.10,0:10:25.31,Layzner,,0,0,0,,那为什么
Dialogue: 0,0:10:25.65,0:10:28.12,Layzner,,0,0,0,,现在我好累
Dialogue: 0,0:10:28.83,0:10:30.90,Layzner,,0,0,0,,他也受了伤
Dialogue: 0,0:10:32.26,0:10:36.30,Layzner,,0,0,0,,等他伤好的时候我也恢复了吧
Dialogue: 0,0:10:36.30,0:10:39.57,Layzner,,0,0,0,,这样我们又可以各自行动了
Dialogue: 0,0:10:40.79,0:10:43.12,Layzner,,0,0,0,,不过在那之前我想跟他在一起
Dialogue: 0,0:10:45.64,0:10:48.49,Layzner,,0,0,0,,你好像很迷惘啊
Dialogue: 0,0:10:49.39,0:10:53.81,Layzner,,0,0,0,,觉得对方怎么样  如果想待在英二身边的话
Dialogue: 0,0:10:53.81,0:10:56.11,Layzner,,0,0,0,,就照你想做的去做吧
Dialogue: 0,0:10:56.11,0:11:01.00,Layzner,,0,0,0,,重要的不是结果而是要对自己的心诚实
Dialogue: 0,0:11:03.05,0:11:06.63,Layzner,,0,0,0,,我现在为了自己的事也没空管别的了
Dialogue: 0,0:11:06.86,0:11:08.98,Layzner,,0,0,0,,所以不能帮英二做什么
Dialogue: 0,0:11:08.98,0:11:10.60,Layzner,,0,0,0,,可是如果是你的话
Dialogue: 0,0:11:10.98,0:11:14.68,Layzner,,0,0,0,,也许能为他做些什么的 不 帮他做些什么吧
Dialogue: 0,0:11:15.76,0:11:18.53,Layzner,,0,0,0,,谢谢你 伊丽莎白博士
Dialogue: 0,0:11:26.31,0:11:27.58,Layzner,,0,0,0,,再见了
Dialogue: 0,0:11:58.56,0:12:01.73,Layzner,,0,0,0,,好怪啊
Dialogue: 0,0:12:01.73,0:12:04.15,Layzner,,0,0,0,,留下英二自己一个人回家
Dialogue: 0,0:12:04.36,0:12:06.36,Layzner,,0,0,0,,你好想这个啊
Dialogue: 0,0:12:06.36,0:12:09.15,Layzner,,0,0,0,,我老爸两天后就会来接我了啊
Dialogue: 0,0:12:09.15,0:12:12.11,Layzner,,0,0,0,,我是明天 大家都一样
Dialogue: 0,0:12:12.11,0:12:13.16,Layzner,,0,0,0,,可是
Dialogue: 0,0:12:13.16,0:12:16.64,Layzner,,0,0,0,,没人会不把你当朋友的
Dialogue: 0,0:12:16.64,0:12:19.76,Layzner,,0,0,0,,对啊 刚才我们要去会面还是被拒绝
Dialogue: 0,0:12:19.76,0:12:22.87,Layzner,,0,0,0,,所以就算还留在这我们也不知还能不能见到他
Dialogue: 0,0:12:22.87,0:12:25.84,Layzner,,0,0,0,,这样的话 不好意思我先走了
Dialogue: 0,0:12:27.27,0:12:28.36,Layzner,,0,0,0,,再见了
Dialogue: 0,0:12:35.02,0:12:37.18,Layzner,,0,0,0,,等一切平静下来后请联络这里
Dialogue: 0,0:12:39.88,0:12:44.97,Layzner,,0,0,0,,不 我还跟大家见面嘛 知道了 快走吧
Dialogue: 0,0:12:44.97,0:12:46.97,Layzner,,0,0,0,,那大家保重
Dialogue: 0,0:12:46.97,0:12:48.97,Layzner,,0,0,0,,再见
Dialogue: 0,0:12:55.76,0:13:00.46,Layzner,,0,0,0,,英二 你听到了吗 我是亚瑟
Dialogue: 0,0:13:00.46,0:13:03.04,Layzner,,0,0,0,,先让我去见一下爸妈 让他们安心一下
Dialogue: 0,0:13:03.04,0:13:05.04,Layzner,,0,0,0,,我还会回来的
Dialogue: 0,0:13:05.04,0:13:05.85,Layzner,,0,0,0,,再见了
Dialogue: 0,0:13:08.64,0:13:10.02,Layzner,,0,0,0,,再见
Dialogue: 0,0:13:24.40,0:13:26.00,Layzner,,0,0,0,,不好意思 失陪一下
Dialogue: 0,0:13:41.74,0:13:45.56,Layzner,,0,0,0,,你说要自己回去 这样我会被骂的
Dialogue: 0,0:13:45.56,0:13:49.74,Layzner,,0,0,0,,老爷说一定要带您回去
Dialogue: 0,0:13:49.74,0:13:51.74,Layzner,,0,0,0,,我想再待一会
Dialogue: 0,0:13:51.74,0:13:54.81,Layzner,,0,0,0,,我会打电话回去的 所以别管我了
Dialogue: 0,0:13:54.81,0:13:56.39,Layzner,,0,0,0,,小姐
Dialogue: 0,0:13:56.39,0:14:01.79,Layzner,,0,0,0,,谢谢你 总之和爸爸说我没事不要担心
Dialogue: 0,0:14:14.14,0:14:16.35,Layzner,,0,0,0,,你留在这干嘛
Dialogue: 0,0:14:17.07,0:14:18.96,Layzner,,0,0,0,,我想再待一会
Dialogue: 0,0:14:22.05,0:14:24.03,Layzner,,0,0,0,,待一会是什么意思
Dialogue: 0,0:14:24.03,0:14:25.07,Layzner,,0,0,0,,没错
Dialogue: 0,0:14:26.40,0:14:29.98,Layzner,,0,0,0,,就只是想待在这里 就这样而已
Dialogue: 0,0:14:34.98,0:14:39.06,Layzner,,0,0,0,,西蒙尼她 喜欢英二是吗
Dialogue: 0,0:14:41.75,0:14:47.47,Layzner,,0,0,0,,留下英二自己回家会心虚的不只西蒙尼而已
Dialogue: 0,0:14:48.41,0:14:49.47,Layzner,,0,0,0,,可是这时
Dialogue: 0,0:14:49.47,0:14:51.66,Layzner,,0,0,0,,我却深深地感觉到
Dialogue: 0,0:14:51.66,0:14:56.29,Layzner,,0,0,0,,她不单只是觉得心虚而已
Dialogue: 0,0:15:09.11,0:15:12.41,Layzner,,0,0,0,,要忍耐 不管发生什么事
Dialogue: 0,0:15:12.68,0:15:16.60,Layzner,,0,0,0,,这里是父亲的故乡 也是我所向往的星球
Dialogue: 0,0:15:16.60,0:15:20.88,Layzner,,0,0,0,,还有我是为了救地球而来的
Dialogue: 0,0:15:22.87,0:15:28.44,Layzner,,0,0,0,,就是这里 只有这里跟其他两架机器人不一样
Dialogue: 0,0:15:28.44,0:15:31.47,Layzner,,0,0,0,,虽然是电脑的一部分 但其他两架没有这照不到的部分
Dialogue: 0,0:15:32.90,0:15:34.64,Layzner,,0,0,0,,这里是什么
Dialogue: 0,0:15:36.01,0:15:40.29,Layzner,,0,0,0,,详细的情形还不知道 不过以目前的状况来说
Dialogue: 0,0:15:40.29,0:15:44.38,Layzner,,0,0,0,,他好像是有意识地故意避开让人调查这部分
Dialogue: 0,0:15:44.55,0:15:47.28,Layzner,,0,0,0,,那么就快点解开这迷
Dialogue: 0,0:15:47.28,0:15:50.43,Layzner,,0,0,0,,这说不定是解明敌人武器的关键
Dialogue: 0,0:15:50.43,0:15:51.21,Layzner,,0,0,0,,是
Dialogue: 0,0:15:52.64,0:15:54.21,Layzner,,0,0,0,,阁下 是
Dialogue: 0,0:15:54.95,0:15:56.93,Layzner,,0,0,0,,苏联的抗议很激烈呢
Dialogue: 0,0:15:56.93,0:16:02.48,Layzner,,0,0,0,,对吧 解读的结果不要泄露 直接送到报告署
Dialogue: 0,0:16:02.86,0:16:05.89,Layzner,,0,0,0,,当然也要送到联合国安全理事会
Dialogue: 0,0:16:08.89,0:16:13.36,Layzner,,0,0,0,,不过 重要的地方含糊带过就好了
Dialogue: 0,0:16:14.84,0:16:18.80,Layzner,,0,0,0,,好不容易找到的王牌怎能这么轻易就交出去
Dialogue: 0,0:16:18.99,0:16:24.71,Layzner,,0,0,0,,为了要主导国际政治这是有必要的
Dialogue: 0,0:16:24.71,0:16:25.77,Layzner,,0,0,0,,知道了吗
Dialogue: 0,0:16:27.40,0:16:30.95,Layzner,,0,0,0,,这东西很精密 小心不要破坏里面
Dialogue: 0,0:16:30.95,0:16:31.85,Layzner,,0,0,0,,了解
Dialogue: 0,0:17:12.21,0:17:14.88,Layzner,,0,0,0,,这令人不安的感觉是什么
Dialogue: 0,0:18:15.79,0:18:18.16,Layzner,,0,0,0,,外星人的武器真的动起来了是吗
Dialogue: 0,0:18:18.33,0:18:20.33,Layzner,,0,0,0,,对 现在正往室内去
Dialogue: 0,0:18:20.75,0:18:24.50,Layzner,,0,0,0,,防卫战斗团出动了 准备好了 攻击开始
Dialogue: 0,0:18:25.87,0:18:28.33,Layzner,,0,0,0,,自己动起来是怎么回事
Dialogue: 0,0:18:31.12,0:18:33.01,Layzner,,0,0,0,,他们好像很焦急
Dialogue: 0,0:18:34.16,0:18:36.46,Layzner,,0,0,0,,好怪 一定有什么事
Dialogue: 0,0:18:36.46,0:18:37.71,Layzner,,0,0,0,,又有了
Dialogue: 0,0:18:37.99,0:18:40.43,Layzner,,0,0,0,,是啊 爸爸明天要来了吗
Dialogue: 0,0:18:40.43,0:18:43.24,Layzner,,0,0,0,,怎么了 你不想见到爸爸吗
Dialogue: 0,0:18:43.24,0:18:47.20,Layzner,,0,0,0,,不是的 我知道了 妈妈 要挂了
Dialogue: 0,0:18:47.20,0:18:50.89,Layzner,,0,0,0,,等一下 现在这里情形怪怪的 不过不要担心
Dialogue: 0,0:18:53.55,0:18:56.82,Layzner,,0,0,0,,不好了 外星人的武器动起来了
Dialogue: 0,0:19:28.50,0:19:30.30,Layzner,,0,0,0,,这震动是
Dialogue: 0,0:19:35.01,0:19:36.23,Layzner,,0,0,0,,雷兹纳动起来了
Dialogue: 0,0:19:36.23,0:19:37.40,Layzner,,0,0,0,,是谁在驾驶
Dialogue: 0,0:19:37.61,0:19:40.61,Layzner,,0,0,0,,一定是英二 别人上不去的
Dialogue: 0,0:19:42.20,0:19:43.14,Layzner,,0,0,0,,英二
Dialogue: 0,0:19:43.19,0:19:44.45,Layzner,,0,0,0,,等一下 很危险
Dialogue: 0,0:19:44.45,0:19:45.08,Layzner,,0,0,0,,西蒙尼
Dialogue: 0,0:19:45.08,0:19:47.08,Layzner,,0,0,0,,快走开 前面很危险
Dialogue: 0,0:19:47.08,0:19:48.03,Layzner,,0,0,0,,走开
Dialogue: 0,0:19:48.15,0:19:50.03,Layzner,,0,0,0,,英二 快逃
Dialogue: 0,0:19:51.42,0:19:53.21,Layzner,,0,0,0,,等一下
Dialogue: 0,0:19:58.75,0:19:59.78,Layzner,,0,0,0,,英二
Dialogue: 0,0:20:11.14,0:20:15.11,Layzner,,0,0,0,,AC130 现在请求着陆
Dialogue: 0,0:20:15.45,0:20:16.97,Layzner,,0,0,0,,叫他们马上攻击
Dialogue: 0,0:20:21.33,0:20:25.00,Layzner,,0,0,0,,各单位 准备攻击 目标外星人的机器人
Dialogue: 0,0:20:25.00,0:20:27.74,Layzner,,0,0,0,,方位8度15分 距离2000
Dialogue: 0,0:20:29.05,0:20:31.54,Layzner,,0,0,0,,锁定目标 射击
Dialogue: 0,0:20:50.74,0:20:53.02,Layzner,,0,0,0,,长官 让那年轻人出去吧
Dialogue: 0,0:20:53.23,0:20:56.29,Layzner,,0,0,0,,这样下去这基地会被毁的
Dialogue: 0,0:21:04.78,0:21:09.41,Layzner,,0,0,0,,快一点 它突然动起来了 请你去阻止他
Dialogue: 0,0:21:09.41,0:21:11.05,Layzner,,0,0,0,,你们对雷兹纳做了什么
Dialogue: 0,0:21:11.25,0:21:12.77,Layzner,,0,0,0,,叫你快去阻止他
Dialogue: 0,0:21:12.77,0:21:16.18,Layzner,,0,0,0,,所以说了不要动雷兹纳的
Dialogue: 0,0:21:19.69,0:21:20.93,Layzner,,0,0,0,,西蒙尼
Dialogue: 0,0:21:24.17,0:21:25.43,Layzner,,0,0,0,,是英二
Dialogue: 0,0:21:25.43,0:21:27.11,Layzner,,0,0,0,,那是谁在雷兹纳上
Dialogue: 0,0:21:31.18,0:21:34.07,Layzner,,0,0,0,,请马上停止攻击
Dialogue: 0,0:21:35.10,0:21:36.92,Layzner,,0,0,0,,我知道了 我会叫他们停下来的
Dialogue: 0,0:22:04.00,0:22:06.97,Layzner,,0,0,0,,雷 这次你不能说你不知道了吧
Dialogue: 0,0:22:14.86,0:22:17.68,Layzner,,0,0,0,,雷兹纳又再次变成蓝色的了
Dialogue: 0,0:22:19.45,0:22:22.67,Layzner,,0,0,0,,然后 对我来说的另一个打击
Dialogue: 0,0:22:22.68,0:22:27.88,Layzner,,0,0,0,,是西蒙尼直接表现出对英二的感觉
Dialogue: 0,0:22:29.04,0:22:32.84,Layzner,,0,0,0,,我在羨慕她的同时
Dialogue: 0,0:22:33.42,0:22:35.28,Layzner,,0,0,0,,也同时产生了嫉妒
Dialogue: 0,0:22:36.65,0:22:38.16,Layzner,,0,0,0,,英二
Dialogue: 0,0:23:54.23,0:23:56.25,Layzner,,0,0,0,,这个驾驶舱就是我的世界
Dialogue: 0,0:23:56.25,0:23:59.24,Layzner,,0,0,0,,可你却存在于我的意料之外
Dialogue: 0,0:24:01.23,0:24:02.45,Layzner,,0,0,0,,回答我
Dialogue: 0,0:24:03.90,0:24:08.28,Layzner,,0,0,0,,下一集 我的名字叫弗隆

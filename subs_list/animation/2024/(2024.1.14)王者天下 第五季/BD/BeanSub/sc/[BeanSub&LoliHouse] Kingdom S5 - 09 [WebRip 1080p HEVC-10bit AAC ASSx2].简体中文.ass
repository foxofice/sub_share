Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕组制作 仅供学习交流 禁止用于商业用途
Comment: 0,0:01:10.97,0:01:11.02,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:01:32.20,0:01:38.63,op-jp,,0,0,0,,滴る汗と日差しで閉じた目
Dialogue: 0,0:01:38.63,0:01:44.88,op-jp,,0,0,0,,映し出したのはあなたとの約束
Dialogue: 0,0:01:44.88,0:01:51.52,op-jp,,0,0,0,,意志を紡いだ導火線に火をつけたら
Dialogue: 0,0:01:51.52,0:01:57.27,op-jp,,0,0,0,,今より強く高く翔べる
Dialogue: 0,0:01:57.27,0:02:04.00,op-jp,,0,0,0,,恐れを知って哀を知って進むなら
Dialogue: 0,0:02:04.00,0:02:11.47,op-jp,,0,0,0,,己の全て捧げ旗を上げろ
Dialogue: 0,0:02:11.47,0:02:17.04,op-jp,,0,0,0,,掠れた声を何度も張りあげてよ
Dialogue: 0,0:02:17.04,0:02:21.92,op-jp,,0,0,0,,希望を決意を抱いて
Dialogue: 0,0:01:32.20,0:01:38.63,op-cn,,0,0,0,,汗水滚落 烈日当头 我闭上双眼
Dialogue: 0,0:01:38.63,0:01:44.88,op-cn,,0,0,0,,眼中映出 与你的约定
Dialogue: 0,0:01:44.88,0:01:51.52,op-cn,,0,0,0,,点燃以意志织成的导火线
Dialogue: 0,0:01:51.52,0:01:57.27,op-cn,,0,0,0,,向着更高更强 振翅高飞
Dialogue: 0,0:01:57.27,0:02:04.00,op-cn,,0,0,0,,知晓恐惧 知晓哀伤 前进不息
Dialogue: 0,0:02:04.00,0:02:11.47,op-cn,,0,0,0,,献出一切 高举旗帜
Dialogue: 0,0:02:11.47,0:02:17.04,op-cn,,0,0,0,,无数次发出嘶吼
Dialogue: 0,0:02:17.04,0:02:21.92,op-cn,,0,0,0,,心怀希望 坚定决心
Comment: 0,0:23:15.96,0:23:15.96,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:27.05,0:23:30.00,ed-jp,,0,0,1,,なぁ坊やどうした？ここは戦場だぜ
Dialogue: 0,0:23:30.00,0:23:32.83,ed-jp,,0,0,1,,たぎる憎悪のラリー　背馳の成長過程
Dialogue: 0,0:23:32.83,0:23:35.64,ed-jp,,0,0,1,,加減も知らず殺気立ったままの剣に
Dialogue: 0,0:23:35.64,0:23:38.81,ed-jp,,0,0,1,,発汗する体　カルマか咎　如何に？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-jp,,0,0,1,,恒　現実は不調和な旋律さ
Dialogue: 0,0:23:41.28,0:23:44.29,ed-jp,,0,0,1,,冷血なステンレス製の心臓持つ演説者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-jp,,0,0,1,,何回目の明滅　また凱旋するテンペスタ
Dialogue: 0,0:23:46.94,0:23:50.04,ed-jp,,0,0,1,,アーチかける善悪　もう応答しない生存者
Dialogue: 0,0:23:51.14,0:23:53.78,ed-jp,,0,0,0,,花のよう　咲うＭｙ　Ｒｅｄ
Dialogue: 0,0:23:53.95,0:24:02.32,ed-jp,,0,0,0,,守りたいものだって　この掌離れれば
Dialogue: 0,0:24:02.48,0:24:09.95,ed-jp,,0,0,0,,壊したいものなんて　壊せないものだけ
Dialogue: 0,0:24:11.85,0:24:17.59,ed-jp,,0,0,0,,唸る　その狂気が　花咲かすダリア
Dialogue: 0,0:24:17.59,0:24:20.31,ed-jp,,0,0,0,,振りかざす度　歪んだ定規
Dialogue: 0,0:24:20.31,0:24:23.15,ed-jp,,0,0,0,,反射する対照的な正義
Dialogue: 0,0:24:23.15,0:24:28.82,ed-jp,,0,0,0,,裏切りのゲリラ　散らす羽たちが
Dialogue: 0,0:24:28.82,0:24:31.80,ed-jp,,0,0,0,,飛ぶ鳥の蹴った地面のようさ
Dialogue: 0,0:24:31.80,0:24:36.87,ed-jp,,0,0,0,,君にもあるんでしょう？キズツケタクナイモノ
Dialogue: 0,0:23:27.05,0:23:30.00,ed-cn,,0,0,0,,怎么了小弟弟？这里可是战场
Dialogue: 0,0:23:30.00,0:23:32.83,ed-cn,,0,0,0,,是憎恶翻腾的拉力赛 与成长背道而驰
Dialogue: 0,0:23:32.83,0:23:35.64,ed-cn,,0,0,0,,不知轻重 利剑杀气腾腾
Dialogue: 0,0:23:35.64,0:23:38.81,ed-cn,,0,0,0,,汗流浃背 是业是罪 如何判定？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-cn,,0,0,0,,现实永远是不和谐旋律
Dialogue: 0,0:23:41.28,0:23:44.29,ed-cn,,0,0,0,,拥有钢铁心脏的冷血演讲者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-cn,,0,0,0,,第几次电闪雷鸣 暴风雨再次凯旋
Dialogue: 0,0:23:46.94,0:23:50.04,ed-cn,,0,0,0,,善恶架上彩虹 生还者已无应答
Dialogue: 0,0:23:51.14,0:23:53.78,ed-cn,,0,0,0,,如花般绽放笑容 My Red
Dialogue: 0,0:23:53.95,0:24:02.32,ed-cn,,0,0,0,,想要守护之物 离开掌中便无从守护
Dialogue: 0,0:24:02.48,0:24:09.95,ed-cn,,0,0,0,,想要毁灭之物 全都是无法毁灭之物
Dialogue: 0,0:24:11.85,0:24:17.59,ed-cn,,0,0,0,,呻吟不止 疯狂如盛开的大丽花
Dialogue: 0,0:24:17.59,0:24:20.31,ed-cn,,0,0,0,,标尺一经举起 立刻扭曲
Dialogue: 0,0:24:20.31,0:24:23.15,ed-cn,,0,0,0,,反射出对立的正义
Dialogue: 0,0:24:23.15,0:24:28.82,ed-cn,,0,0,0,,叛逆的游击 散落的羽翼
Dialogue: 0,0:24:28.82,0:24:31.80,ed-cn,,0,0,0,,如飞鸟蹬踏的地面一般
Dialogue: 0,0:24:31.80,0:24:36.87,ed-cn,,0,0,0,,你一定也有不愿伤害之物
Dialogue: 0,0:00:01.48,0:00:04.69,biaoti,,0,0,0,,{\fad(480,480)\pos(1725,810)}凶
Dialogue: 0,0:00:04.56,0:00:06.49,Default,,0,0,0,,看见了 我看见了
Dialogue: 0,0:00:06.76,0:00:08.74,Default,,0,0,0,,那就是庆舍主阵的旗帜
Dialogue: 0,0:00:12.62,0:00:13.87,Default,,0,0,0,,左上方来的？
Dialogue: 0,0:00:15.45,0:00:18.88,Default,,0,0,0,,你们有完没完
Dialogue: 0,0:00:21.61,0:00:22.42,Default,,0,0,0,,可恶
Dialogue: 0,0:00:22.90,0:00:24.38,Default,,0,0,0,,被咬上了
Dialogue: 0,0:00:24.66,0:00:26.64,Default,,0,0,0,,还没完 不要放弃
Dialogue: 0,0:00:26.64,0:00:28.63,Default,,0,0,0,,至少要让前锋冲出去
Dialogue: 0,0:00:28.98,0:00:30.13,Default,,0,0,0,,去死
Dialogue: 0,0:00:30.70,0:00:32.66,Default,,0,0,0,,你就是军师吧
Dialogue: 0,0:00:33.72,0:00:34.89,Default,,0,0,0,,河了貂危险了
Dialogue: 0,0:00:45.59,0:00:47.57,Default,,0,0,0,,羌 羌瘣
Dialogue: 0,0:00:48.88,0:00:50.95,Default,,0,0,0,,抱歉 我来迟了
Dialogue: 0,0:00:51.18,0:00:52.95,Default,,0,0,0,,你搞什么啊
Dialogue: 0,0:00:56.18,0:00:57.70,Default,,0,0,0,,我的队在吗
Dialogue: 0,0:00:58.06,0:00:58.62,Default,,0,0,0,,在
Dialogue: 0,0:00:58.62,0:00:59.41,Default,,0,0,0,,这里
Dialogue: 0,0:01:00.00,0:01:02.12,Default,,0,0,0,,河了貂 这里就交给我
Dialogue: 0,0:01:03.61,0:01:05.16,Default,,0,0,0,,你们继续前进
Dialogue: 0,0:01:05.27,0:01:08.36,Default,,0,0,0,,在敌将重整阵型之前冲过去
Dialogue: 0,0:02:43.18,0:02:44.89,Default,,0,0,0,,黑羊来报
Dialogue: 0,0:02:45.44,0:02:47.60,Default,,0,0,0,,出击的庆舍军精锐部队
Dialogue: 0,0:02:47.84,0:02:50.59,Default,,0,0,0,,似乎反遭伏兵袭击
Dialogue: 0,0:02:50.78,0:02:55.32,Default,,0,0,0,,但是 在纪彗军的帮助下 主阵正在重建
Dialogue: 0,0:02:57.34,0:02:58.24,Default,,0,0,0,,庆舍…
Dialogue: 0,0:02:59.56,0:03:02.71,Default,,0,0,0,,不会吧 竟输给了小孩子
Dialogue: 0,0:03:02.96,0:03:04.68,Default,,0,0,0,,他又赢了
Dialogue: 0,0:03:04.91,0:03:07.16,Default,,0,0,0,,我都没见过这样的战术
Dialogue: 0,0:03:07.96,0:03:12.88,Default,,0,0,0,,那小鬼好像是住在那边的武器店当帮工的吧
Dialogue: 0,0:03:13.12,0:03:13.76,Default,,0,0,0,,是啊
Dialogue: 0,0:03:14.04,0:03:18.25,Default,,0,0,0,,他脸上没有一丝表情 真是瘆人
Dialogue: 0,0:03:20.01,0:03:22.43,Default,,0,0,0,,你要买下那个废物？
Dialogue: 0,0:03:22.78,0:03:25.29,Default,,0,0,0,,听说他住在你这里当帮工
Dialogue: 0,0:03:25.51,0:03:26.86,Default,,0,0,0,,我劝你别
Dialogue: 0,0:03:26.99,0:03:31.16,Default,,0,0,0,,他眼看着父母被杀死 内心受了创伤
Dialogue: 0,0:03:31.33,0:03:32.67,Default,,0,0,0,,甚至不会说话
Dialogue: 0,0:03:33.28,0:03:36.68,Default,,0,0,0,,不过 他能在军略大赛上替我赚钱
Dialogue: 0,0:03:36.84,0:03:37.93,Default,,0,0,0,,别想便宜买走…
Dialogue: 0,0:03:37.93,0:03:38.56,Default,,0,0,0,,这个数
Dialogue: 0,0:03:40.31,0:03:42.21,Default,,0,0,0,,巨款啊
Dialogue: 0,0:03:44.45,0:03:45.36,Default,,0,0,0,,他叫什么名字
Dialogue: 0,0:03:48.40,0:03:51.48,Default,,0,0,0,,在敌将重整阵型之前冲过去
Dialogue: 0,0:03:52.26,0:03:55.32,Default,,0,0,0,,可是 你这么点人 怎么抵挡那支敌军
Dialogue: 0,0:03:55.72,0:03:56.59,Default,,0,0,0,,快走
Dialogue: 0,0:03:57.60,0:03:59.64,Default,,0,0,0,,好 你拖住他们
Dialogue: 0,0:04:00.23,0:04:01.66,Default,,0,0,0,,全军重启冲锋…
Dialogue: 0,0:04:02.78,0:04:03.29,Default,,0,0,0,,喂
Dialogue: 0,0:04:05.04,0:04:06.48,Default,,0,0,0,,你之前做什么去了
Dialogue: 0,0:04:08.84,0:04:09.61,Default,,0,0,0,,在睡觉
Dialogue: 0,0:04:12.12,0:04:13.17,Default,,0,0,0,,受伤了吗
Dialogue: 0,0:04:14.09,0:04:15.91,Default,,0,0,0,,看起来还够呛啊
Dialogue: 0,0:04:16.54,0:04:18.45,Default,,0,0,0,,比遍体鳞伤的你们要强
Dialogue: 0,0:04:19.28,0:04:20.13,Default,,0,0,0,,信
Dialogue: 0,0:04:21.06,0:04:23.70,Default,,0,0,0,,快去 不然敌将要跑了
Dialogue: 0,0:04:25.53,0:04:27.70,Default,,0,0,0,,这次我们事后很快要再次见面
Dialogue: 0,0:04:30.91,0:04:33.46,Default,,0,0,0,,就交给你来拖住这里的敌人 副长
Dialogue: 0,0:04:34.07,0:04:35.77,Default,,0,0,0,,队长将重任交给了我们
Dialogue: 0,0:04:40.51,0:04:41.30,Default,,0,0,0,,刘冬…
Dialogue: 0,0:04:44.48,0:04:46.22,Default,,0,0,0,,好 我们冲
Dialogue: 0,0:04:46.66,0:04:50.00,Default,,0,0,0,,那就是敌军主将 庆舍
Dialogue: 0,0:04:50.09,0:04:52.75,Default,,0,0,0,,没什么大不了的 杀了他
Dialogue: 0,0:04:54.33,0:04:55.23,Default,,0,0,0,,庆舍大人
Dialogue: 0,0:04:55.80,0:04:58.11,Default,,0,0,0,,河了貂 前排要接敌了
Dialogue: 0,0:04:58.18,0:04:58.88,Default,,0,0,0,,嗯
Dialogue: 0,0:04:59.24,0:05:01.03,Default,,0,0,0,,给我杀
Dialogue: 0,0:05:03.06,0:05:04.01,Default,,0,0,0,,没用的
Dialogue: 0,0:05:11.67,0:05:13.80,Default,,0,0,0,,那贵大哥 你看…
Dialogue: 0,0:05:14.03,0:05:14.82,Default,,0,0,0,,嗯
Dialogue: 0,0:05:15.76,0:05:17.67,Default,,0,0,0,,力量差距太大了
Dialogue: 0,0:05:18.85,0:05:21.99,Default,,0,0,0,,那就是主将庆舍最后的盾牌吗
Dialogue: 0,0:05:22.88,0:05:24.25,Default,,0,0,0,,这场战争
Dialogue: 0,0:05:25.65,0:05:28.55,Default,,0,0,0,,一方是比肩六将的桓骑
Dialogue: 0,0:05:29.38,0:05:33.25,Default,,0,0,0,,一方是剑指三大天最后一席的我
Dialogue: 0,0:05:34.37,0:05:36.48,Default,,0,0,0,,这是两个豪杰的战斗
Dialogue: 0,0:05:36.99,0:05:39.92,Default,,0,0,0,,就凭你们也想插足？
Dialogue: 0,0:05:41.40,0:05:46.25,Default,,0,0,0,,李牧大人视为威胁的 是你们成长后的实力
Dialogue: 0,0:05:47.08,0:05:48.44,Default,,0,0,0,,并非现在
Dialogue: 0,0:05:49.76,0:05:54.44,Default,,0,0,0,,要来这里 你们还早了五年 飞信队
Dialogue: 0,0:05:56.97,0:05:58.96,Default,,0,0,0,,一点都不早 蠢货
Dialogue: 0,0:05:59.07,0:05:59.84,Default,,0,0,0,,信
Dialogue: 0,0:06:03.48,0:06:05.18,Default,,0,0,0,,你就是队长…
Dialogue: 0,0:06:10.76,0:06:11.50,Default,,0,0,0,,信…
Dialogue: 0,0:06:12.00,0:06:14.37,Default,,0,0,0,,那个人是怪物吗
Dialogue: 0,0:06:14.63,0:06:17.27,Default,,0,0,0,,但是 他一个人能做什么
Dialogue: 0,0:06:17.27,0:06:18.46,Default,,0,0,0,,给我杀
Dialogue: 0,0:06:19.18,0:06:19.90,Default,,0,0,0,,信
Dialogue: 0,0:06:21.94,0:06:23.57,Default,,0,0,0,,我不是一个人
Dialogue: 0,0:06:24.07,0:06:25.64,Default,,0,0,0,,你听好了 庆舍
Dialogue: 0,0:06:26.60,0:06:29.58,Default,,0,0,0,,以前有个很厉害的人 叫王骑
Dialogue: 0,0:06:30.10,0:06:32.37,Default,,0,0,0,,他带头冲锋陷阵时
Dialogue: 0,0:06:32.44,0:06:36.58,Default,,0,0,0,,身后的士兵会化为鬼神 变强十倍
Dialogue: 0,0:06:36.58,0:06:40.55,Default,,0,0,0,,这就是大将军的力量
Dialogue: 0,0:06:40.85,0:06:43.72,Default,,0,0,0,,我现在就让你看看这股力量
Dialogue: 0,0:06:45.65,0:06:48.64,Default,,0,0,0,,伙计们 别在那喘粗气
Dialogue: 0,0:06:49.92,0:06:52.71,Default,,0,0,0,,要是难受 就看着我的后背战斗
Dialogue: 0,0:06:52.92,0:06:55.37,Default,,0,0,0,,就只看着我的后背 追赶我
Dialogue: 0,0:06:55.80,0:06:58.06,Default,,0,0,0,,跟我上 飞信队
Dialogue: 0,0:07:04.68,0:07:06.03,Default,,0,0,0,,一群蠢货
Dialogue: 0,0:07:06.50,0:07:10.28,Default,,0,0,0,,仅靠士气怎么可能颠覆如此大的战力差距
Dialogue: 0,0:07:12.07,0:07:13.87,Default,,0,0,0,,这不是常理能解释的
Dialogue: 0,0:07:15.18,0:07:17.06,Default,,0,0,0,,我也不知道为什么
Dialogue: 0,0:07:17.15,0:07:20.04,Default,,0,0,0,,就是有一股无法解释的力量涌了上来
Dialogue: 0,0:07:20.32,0:07:23.92,Default,,0,0,0,,看着我们队长的后背就会这样
Dialogue: 0,0:07:26.75,0:07:28.49,Default,,0,0,0,,庆舍
Dialogue: 0,0:07:29.79,0:07:30.58,Default,,0,0,0,,不好
Dialogue: 0,0:07:31.29,0:07:34.50,Default,,0,0,0,,别管这女人的队了 我们去帮庆舍大人
Dialogue: 0,0:07:35.40,0:07:36.39,Default,,0,0,0,,刘冬大人
Dialogue: 0,0:07:43.24,0:07:45.15,Default,,0,0,0,,刘 刘冬大人
Dialogue: 0,0:07:45.81,0:07:46.99,Default,,0,0,0,,别想过去
Dialogue: 0,0:07:47.64,0:07:49.14,Default,,0,0,0,,伤口裂开了
Dialogue: 0,0:07:50.69,0:07:51.24,Default,,0,0,0,,什么？
Dialogue: 0,0:07:51.24,0:07:53.59,Default,,0,0,0,,别妨碍我
Dialogue: 0,0:08:00.37,0:08:01.28,Default,,0,0,0,,信
Dialogue: 0,0:08:06.47,0:08:08.57,Default,,0,0,0,,舍弃这个主阵
Dialogue: 0,0:08:09.60,0:08:11.91,Default,,0,0,0,,这样重整会延缓 但也没办法
Dialogue: 0,0:08:12.14,0:08:13.82,Default,,0,0,0,,我们去金毛那里
Dialogue: 0,0:08:14.64,0:08:16.08,Default,,0,0,0,,真的要走吗
Dialogue: 0,0:08:16.25,0:08:19.00,Default,,0,0,0,,飞信队的信应该是目标之一
Dialogue: 0,0:08:20.44,0:08:24.04,Default,,0,0,0,,虽然也可以由我们亲自出手
Dialogue: 0,0:08:24.21,0:08:26.70,Default,,0,0,0,,但那样我恐怕也无法全身而退
Dialogue: 0,0:08:27.44,0:08:31.92,Default,,0,0,0,,只要把周围部队集中过来 他就必死无疑了
Dialogue: 0,0:08:32.75,0:08:35.00,Default,,0,0,0,,这里是我军正中央
Dialogue: 0,0:08:35.29,0:08:37.55,Default,,0,0,0,,他们一个也别想逃
Dialogue: 0,0:08:39.02,0:08:39.61,Default,,0,0,0,,我们走
Dialogue: 0,0:08:39.72,0:08:40.32,Default,,0,0,0,,是
Dialogue: 0,0:08:41.42,0:08:43.16,Default,,0,0,0,,他们离开主阵了
Dialogue: 0,0:08:43.49,0:08:45.48,Default,,0,0,0,,在我们突破之前就逃走了
Dialogue: 0,0:08:46.50,0:08:50.81,Default,,0,0,0,,我们原本必须瞬间破敌 不给他们思考的时间
Dialogue: 0,0:08:51.64,0:08:54.16,Default,,0,0,0,,所以根本没准备战力断敌退路
Dialogue: 0,0:08:54.90,0:08:57.41,Default,,0,0,0,,只能让信冲出重围从后面攻击…
Dialogue: 0,0:08:59.06,0:08:59.89,Default,,0,0,0,,做不到
Dialogue: 0,0:09:06.79,0:09:07.54,Default,,0,0,0,,那贵？
Dialogue: 0,0:09:09.33,0:09:10.69,Default,,0,0,0,,混蛋
Dialogue: 0,0:09:13.23,0:09:14.16,Default,,0,0,0,,庆舍大人
Dialogue: 0,0:09:19.51,0:09:22.08,Default,,0,0,0,,果 果然不行啊 那贵大哥
Dialogue: 0,0:09:22.14,0:09:26.25,Default,,0,0,0,,我们的专长是穿透 而且还只有五骑
Dialogue: 0,0:09:27.41,0:09:28.96,Default,,0,0,0,,果然不行啊
Dialogue: 0,0:09:30.03,0:09:31.98,Default,,0,0,0,,不过 已经很不错了
Dialogue: 0,0:09:34.71,0:09:38.96,Default,,0,0,0,,在一旁看着和在其中去感觉 果然大不相同啊
Dialogue: 0,0:09:39.93,0:09:41.35,Default,,0,0,0,,赵将 庆舍
Dialogue: 0,0:09:41.97,0:09:44.32,Default,,0,0,0,,你的败因并不在你
Dialogue: 0,0:09:45.28,0:09:46.84,Default,,0,0,0,,所有人都被骗了
Dialogue: 0,0:09:47.84,0:09:49.77,Default,,0,0,0,,飞信队及其队长信的实力
Dialogue: 0,0:09:50.68,0:09:53.80,Default,,0,0,0,,超出了所有人的想象
Dialogue: 0,0:09:55.60,0:09:57.17,Default,,0,0,0,,我来插足了
Dialogue: 0,0:09:58.24,0:09:59.24,Default,,0,0,0,,庆舍
Dialogue: 0,0:10:05.38,0:10:06.04,Default,,0,0,0,,冲上去了
Dialogue: 0,0:10:06.04,0:10:07.16,Default,,0,0,0,,队长
Dialogue: 0,0:10:07.16,0:10:08.13,Default,,0,0,0,,信
Dialogue: 0,0:10:08.43,0:10:09.88,Default,,0,0,0,,不 不妙啊
Dialogue: 0,0:10:09.88,0:10:12.46,Default,,0,0,0,,敌军队长杀到庆舍大人跟前了
Dialogue: 0,0:10:12.46,0:10:16.01,Default,,0,0,0,,我知道 但必须先干掉这女人…
Dialogue: 0,0:10:19.34,0:10:20.03,Default,,0,0,0,,可恶
Dialogue: 0,0:10:20.03,0:10:21.05,Default,,0,0,0,,该死的
Dialogue: 0,0:10:24.80,0:10:25.99,Default,,0,0,0,,刘冬大人
Dialogue: 0,0:10:26.32,0:10:27.56,Default,,0,0,0,,副长
Dialogue: 0,0:10:31.03,0:10:31.80,Default,,0,0,0,,信…
Dialogue: 0,0:10:32.52,0:10:33.81,Default,,0,0,0,,混蛋
Dialogue: 0,0:10:36.26,0:10:37.71,Default,,0,0,0,,杂兵就交给我们
Dialogue: 0,0:10:38.01,0:10:41.10,Default,,0,0,0,,敌军主将就交给你了 队长
Dialogue: 0,0:10:41.29,0:10:41.85,Default,,0,0,0,,好
Dialogue: 0,0:11:06.03,0:11:06.63,Default,,0,0,0,,信…
Dialogue: 0,0:11:10.20,0:11:12.09,Default,,0,0,0,,刚才那一击是什么情况
Dialogue: 0,0:11:12.79,0:11:17.22,Default,,0,0,0,,他明明那么瘦小 为什么能把信击飞
Dialogue: 0,0:11:19.92,0:11:20.87,Default,,0,0,0,,我想也是
Dialogue: 0,0:11:22.08,0:11:25.75,Default,,0,0,0,,我们目标成为新六将
Dialogue: 0,0:11:26.40,0:11:30.47,Default,,0,0,0,,而你的目标是赵国三大天
Dialogue: 0,0:11:30.89,0:11:32.87,Default,,0,0,0,,那剑刃自然不可能轻
Dialogue: 0,0:11:34.01,0:11:36.30,Default,,0,0,0,,虽然你一直面无表情
Dialogue: 0,0:11:36.49,0:11:38.97,Default,,0,0,0,,但心里还是一片火热啊
Dialogue: 0,0:11:39.67,0:11:40.88,Default,,0,0,0,,正合我意
Dialogue: 0,0:11:42.24,0:11:43.53,Default,,0,0,0,,干掉你
Dialogue: 0,0:11:48.33,0:11:49.27,Default,,0,0,0,,队长
Dialogue: 0,0:11:49.60,0:11:51.46,Default,,0,0,0,,上啊 队长
Dialogue: 0,0:11:51.67,0:11:53.96,Default,,0,0,0,,庆舍真的是大人物
Dialogue: 0,0:11:55.28,0:12:00.06,Default,,0,0,0,,合纵军之战时 赵军实质上的主将也是庆舍
Dialogue: 0,0:12:01.52,0:12:05.41,Default,,0,0,0,,说他最可能成为第三个三大天也很合理
Dialogue: 0,0:12:05.96,0:12:08.56,Default,,0,0,0,,如果现在能把他击杀
Dialogue: 0,0:12:08.81,0:12:11.67,Default,,0,0,0,,那将对赵国造成沉重打击
Dialogue: 0,0:12:12.66,0:12:16.92,Default,,0,0,0,,还能帮助秦国夺取黑羊这个军事要地
Dialogue: 0,0:12:17.16,0:12:19.28,Default,,0,0,0,,这可是头等武功
Dialogue: 0,0:12:28.35,0:12:30.56,Default,,0,0,0,,好 好强
Dialogue: 0,0:12:30.69,0:12:31.60,Default,,0,0,0,,副长…
Dialogue: 0,0:12:32.38,0:12:35.64,Default,,0,0,0,,那 那家伙是怪物吗
Dialogue: 0,0:12:36.82,0:12:38.65,Default,,0,0,0,,休想…
Dialogue: 0,0:12:38.88,0:12:43.04,Default,,0,0,0,,休想穿过黑羊 侵略者
Dialogue: 0,0:12:44.19,0:12:45.99,Default,,0,0,0,,不是侵略者
Dialogue: 0,0:12:47.27,0:12:48.43,Default,,0,0,0,,我们是…
Dialogue: 0,0:12:49.53,0:12:50.77,Default,,0,0,0,,飞信队
Dialogue: 0,0:12:55.32,0:12:56.26,Default,,0,0,0,,好
Dialogue: 0,0:12:59.87,0:13:02.84,Default,,0,0,0,,不好 右侧来了敌军援军
Dialogue: 0,0:13:03.12,0:13:04.85,Default,,0,0,0,,快一点 队长
Dialogue: 0,0:13:09.44,0:13:10.83,Default,,0,0,0,,上啊 信
Dialogue: 0,0:13:10.83,0:13:12.30,Default,,0,0,0,,休想
Dialogue: 0,0:13:12.30,0:13:13.88,Default,,0,0,0,,别想过去
Dialogue: 0,0:13:14.61,0:13:15.34,Default,,0,0,0,,什么？
Dialogue: 0,0:13:17.22,0:13:18.77,Default,,0,0,0,,庆舍大人
Dialogue: 0,0:13:20.04,0:13:22.76,Default,,0,0,0,,快啊 新的敌人就快到了
Dialogue: 0,0:13:23.71,0:13:26.71,Default,,0,0,0,,吕敏 去把退路准备好
Dialogue: 0,0:13:27.93,0:13:30.59,Default,,0,0,0,,我们根本挡不住那么多人
Dialogue: 0,0:13:31.32,0:13:32.08,Default,,0,0,0,,滚开
Dialogue: 0,0:13:37.08,0:13:38.11,Default,,0,0,0,,奇怪
Dialogue: 0,0:13:39.27,0:13:42.28,Default,,0,0,0,,我很久之前就在关注这个人
Dialogue: 0,0:13:43.77,0:13:48.64,Default,,0,0,0,,和李牧大人一样 注视着他的成长
Dialogue: 0,0:13:49.41,0:13:50.31,Default,,0,0,0,,然而…
Dialogue: 0,0:13:52.51,0:13:53.73,Default,,0,0,0,,庆舍大人
Dialogue: 0,0:13:53.97,0:13:55.81,Default,,0,0,0,,快啊 队长
Dialogue: 0,0:13:56.38,0:13:59.94,Default,,0,0,0,,这个人比我预想中还要…
Dialogue: 0,0:14:01.50,0:14:03.17,Default,,0,0,0,,巨大得多
Dialogue: 0,0:14:03.80,0:14:06.43,Default,,0,0,0,,他不知不觉中成长得如此强大了
Dialogue: 0,0:14:07.58,0:14:08.70,Default,,0,0,0,,该死的
Dialogue: 0,0:14:09.09,0:14:10.70,Default,,0,0,0,,这次是我…
Dialogue: 0,0:14:12.17,0:14:13.80,Default,,0,0,0,,抽到了「凶」
Dialogue: 0,0:14:16.44,0:14:17.48,Default,,0,0,0,,真遗憾…
Dialogue: 0,0:14:19.53,0:14:21.17,Default,,0,0,0,,你的朋友是蜘蛛吗
Dialogue: 0,0:14:23.15,0:14:26.47,Default,,0,0,0,,与我一同去旅行吧 庆舍
Dialogue: 0,0:14:32.09,0:14:35.58,Default,,0,0,0,,我没能报答您的恩情…
Dialogue: 0,0:14:53.36,0:14:54.14,Default,,0,0,0,,赢了…
Dialogue: 0,0:14:57.99,0:15:00.80,Default,,0,0,0,,赵军主将 庆舍
Dialogue: 0,0:15:00.92,0:15:05.13,Default,,0,0,0,,被飞信队的信击杀了
Dialogue: 0,0:15:06.05,0:15:06.82,Default,,0,0,0,,成功了
Dialogue: 0,0:15:07.20,0:15:08.32,Default,,0,0,0,,太好了 信
Dialogue: 0,0:15:08.32,0:15:10.14,Default,,0,0,0,,队长
Dialogue: 0,0:15:10.49,0:15:12.89,Default,,0,0,0,,不过要立刻撤离 快
Dialogue: 0,0:15:13.17,0:15:16.45,Default,,0,0,0,,没时间给你们欢呼了
Dialogue: 0,0:15:17.70,0:15:18.40,Default,,0,0,0,,不好
Dialogue: 0,0:15:18.66,0:15:21.15,Default,,0,0,0,,撤退 进入下方的树海
Dialogue: 0,0:15:21.43,0:15:23.12,Default,,0,0,0,,可恶 怎么回事
Dialogue: 0,0:15:23.12,0:15:24.72,Default,,0,0,0,,庆舍大人被击败了吗
Dialogue: 0,0:15:24.72,0:15:25.83,Default,,0,0,0,,这不可能
Dialogue: 0,0:15:25.83,0:15:28.01,Default,,0,0,0,,总之别让秦兵逃走
Dialogue: 0,0:15:29.49,0:15:32.55,Default,,0,0,0,,你在干什么 信 还不快走
Dialogue: 0,0:15:44.20,0:15:46.38,Default,,0,0,0,,刘冬大人
Dialogue: 0,0:15:52.92,0:15:56.14,Default,,0,0,0,,休想…
Dialogue: 0,0:15:57.01,0:16:01.03,Default,,0,0,0,,休想去…离眼…
Dialogue: 0,0:16:05.04,0:16:06.72,Default,,0,0,0,,我只能口头保证
Dialogue: 0,0:16:07.56,0:16:11.10,Default,,0,0,0,,我不会让离眼发生你所担心的事
Dialogue: 0,0:16:13.76,0:16:17.14,Default,,0,0,0,,刘冬 这个还给你
Dialogue: 0,0:16:36.15,0:16:37.04,Default,,0,0,0,,副长
Dialogue: 0,0:16:38.88,0:16:40.19,Default,,0,0,0,,这边也有敌军来了
Dialogue: 0,0:16:40.66,0:16:42.19,Default,,0,0,0,,是刘冬军
Dialogue: 0,0:16:43.29,0:16:44.57,Default,,0,0,0,,我们撤
Dialogue: 0,0:16:46.40,0:16:47.17,Default,,0,0,0,,不好
Dialogue: 0,0:16:49.69,0:16:51.24,Default,,0,0,0,,必须恢复呼吸
Dialogue: 0,0:16:52.36,0:16:53.37,Default,,0,0,0,,副长
Dialogue: 0,0:16:53.51,0:16:54.03,Default,,0,0,0,,我这就来…
Dialogue: 0,0:16:54.03,0:16:55.20,Default,,0,0,0,,休想
Dialogue: 0,0:16:55.56,0:16:58.18,Default,,0,0,0,,你们一个也别想活命
Dialogue: 0,0:17:00.48,0:17:01.54,Default,,0,0,0,,来不及了
Dialogue: 0,0:17:11.07,0:17:11.93,Default,,0,0,0,,队长
Dialogue: 0,0:17:14.09,0:17:17.47,Default,,0,0,0,,好歹留下逃跑的力气啊 傻瓜
Dialogue: 0,0:17:19.30,0:17:20.28,Default,,0,0,0,,我无言以对
Dialogue: 0,0:17:21.30,0:17:24.31,Default,,0,0,0,,我杀死主将了 羌瘣
Dialogue: 0,0:17:24.62,0:17:25.76,Default,,0,0,0,,站住
Dialogue: 0,0:17:25.76,0:17:26.85,Default,,0,0,0,,看来是了
Dialogue: 0,0:17:26.06,0:17:27.32,Default,,0,0,0,,{\pos(441.6,1067)}别逃
Dialogue: 0,0:17:28.86,0:17:30.69,Default,,0,0,0,,庆舍大人
Dialogue: 0,0:17:32.22,0:17:34.32,Default,,0,0,0,,为什么会这样
Dialogue: 0,0:17:34.49,0:17:35.69,Default,,0,0,0,,该死的
Dialogue: 0,0:17:35.90,0:17:39.30,Default,,0,0,0,,你们别以为能活着回去 飞信队
Dialogue: 0,0:17:40.87,0:17:45.03,Default,,0,0,0,,随后 庆舍军开始了猛烈的追击
Dialogue: 0,0:17:45.93,0:17:51.27,Default,,0,0,0,,不过 视线不佳的树海 极大地帮助了飞信队
Dialogue: 0,0:17:53.01,0:17:54.88,Default,,0,0,0,,保持安静就没事
Dialogue: 0,0:17:55.16,0:17:57.06,Default,,0,0,0,,我有无数种方法甩掉追兵
Dialogue: 0,0:17:57.57,0:17:59.42,Default,,0,0,0,,你去扰乱追兵 去亥
Dialogue: 0,0:17:59.59,0:18:01.23,Default,,0,0,0,,好 包在我身上
Dialogue: 0,0:18:06.75,0:18:09.98,Default,,0,0,0,,正可谓 电光石火般的一击
Dialogue: 0,0:18:10.70,0:18:13.99,Default,,0,0,0,,由于袭击地点位于山丘背面
Dialogue: 0,0:18:14.47,0:18:16.37,Default,,0,0,0,,因此 包括桓骑在内
Dialogue: 0,0:18:16.47,0:18:20.08,Default,,0,0,0,,还无人知晓庆舍战死之事
Dialogue: 0,0:18:21.69,0:18:25.35,Default,,0,0,0,,最先知晓此事的 当然还是赵军将领
Dialogue: 0,0:18:26.19,0:18:28.60,Default,,0,0,0,,山丘右侧的将领 金毛
Dialogue: 0,0:18:29.33,0:18:32.39,Default,,0,0,0,,和山丘左侧的将领 纪彗
Dialogue: 0,0:18:33.62,0:18:35.71,Default,,0,0,0,,你说什么…
Dialogue: 0,0:18:37.63,0:18:39.51,Default,,0,0,0,,你说什么？
Dialogue: 0,0:18:39.83,0:18:42.76,Default,,0,0,0,,详 详情还不知道
Dialogue: 0,0:18:43.01,0:18:45.52,Default,,0,0,0,,总之庆舍大人是确确实实战死了
Dialogue: 0,0:18:45.84,0:18:48.12,Default,,0,0,0,,还 还有一个人…
Dialogue: 0,0:18:49.62,0:18:51.93,Default,,0,0,0,,刘冬大人也战死了
Dialogue: 0,0:18:57.85,0:18:58.83,Default,,0,0,0,,城主？
Dialogue: 0,0:19:04.71,0:19:05.79,Default,,0,0,0,,难道说…
Dialogue: 0,0:19:06.35,0:19:07.87,Default,,0,0,0,,还没完
Dialogue: 0,0:19:08.69,0:19:10.44,Default,,0,0,0,,你去金毛那里
Dialogue: 0,0:19:11.99,0:19:15.55,Default,,0,0,0,,让金毛立刻去丘顶
Dialogue: 0,0:19:15.90,0:19:17.32,Default,,0,0,0,,是
Dialogue: 0,0:19:18.97,0:19:22.39,Default,,0,0,0,,我还不能让这场战争结束
Dialogue: 0,0:19:22.56,0:19:24.10,Default,,0,0,0,,刘冬居然…
Dialogue: 0,0:19:25.04,0:19:25.69,Default,,0,0,0,,马呈
Dialogue: 0,0:19:28.57,0:19:30.04,Default,,0,0,0,,居然把刘冬…
Dialogue: 0,0:19:30.04,0:19:30.72,Default,,0,0,0,,马呈
Dialogue: 0,0:19:31.33,0:19:33.18,Default,,0,0,0,,马呈 现在是紧要关头
Dialogue: 0,0:19:33.18,0:19:36.59,Default,,0,0,0,,把你的愤怒全部发泄在桓骑军身上
Dialogue: 0,0:19:38.42,0:19:41.24,Default,,0,0,0,,左侧山丘就交给你了
Dialogue: 0,0:19:42.84,0:19:43.90,Default,,0,0,0,,那您呢
Dialogue: 0,0:19:45.14,0:19:46.11,Default,,0,0,0,,我要…
Dialogue: 0,0:19:47.41,0:19:50.24,Default,,0,0,0,,去丘顶和金毛谈谈
Dialogue: 0,0:19:52.94,0:19:56.12,Default,,0,0,0,,完了 都完了…
Dialogue: 0,0:19:58.47,0:20:02.08,Default,,0,0,0,,没想到会输在这种地方
Dialogue: 0,0:20:02.73,0:20:04.13,Default,,0,0,0,,庆舍大人…
Dialogue: 0,0:20:06.46,0:20:08.93,Default,,0,0,0,,我知道你想说什么
Dialogue: 0,0:20:09.86,0:20:12.56,Default,,0,0,0,,事已至此 只能尽可能减少伤亡
Dialogue: 0,0:20:12.76,0:20:14.96,Default,,0,0,0,,从黑羊撤退
Dialogue: 0,0:20:15.62,0:20:21.07,Default,,0,0,0,,我 我金毛军会负起责任殿后
Dialogue: 0,0:20:21.65,0:20:23.54,Default,,0,0,0,,你们就先…
Dialogue: 0,0:20:24.77,0:20:28.53,Default,,0,0,0,,不撤退 我们要重整旗鼓 金毛
Dialogue: 0,0:20:29.42,0:20:30.77,Default,,0,0,0,,重整旗鼓？
Dialogue: 0,0:20:31.07,0:20:34.13,Default,,0,0,0,,你 你在说什么 纪彗
Dialogue: 0,0:20:34.46,0:20:37.65,Default,,0,0,0,,主将庆舍大人都战死了啊
Dialogue: 0,0:20:37.65,0:20:40.30,Default,,0,0,0,,但是还没有人知晓这件事
Dialogue: 0,0:20:45.60,0:20:47.03,Default,,0,0,0,,不知幸运还是不幸
Dialogue: 0,0:20:47.25,0:20:50.96,Default,,0,0,0,,庆舍大人死于无人关注的山丘背后
Dialogue: 0,0:20:51.56,0:20:54.00,Default,,0,0,0,,而杀死他的飞信队逃入了树海
Dialogue: 0,0:20:54.52,0:20:57.82,Default,,0,0,0,,敌方也不会立刻把庆舍大人的死讯传开
Dialogue: 0,0:20:58.62,0:21:02.30,Default,,0,0,0,,为防混乱 我也没让此事在赵军内部传开
Dialogue: 0,0:21:02.66,0:21:04.91,Default,,0,0,0,,只要我们不说就行
Dialogue: 0,0:21:06.66,0:21:08.47,Default,,0,0,0,,你难道…
Dialogue: 0,0:21:08.85,0:21:09.72,Default,,0,0,0,,对
Dialogue: 0,0:21:09.90,0:21:13.59,Default,,0,0,0,,我们要隐瞒庆舍大人的死
Dialogue: 0,0:21:14.49,0:21:16.84,Default,,0,0,0,,我们两个继续黑羊之战
Dialogue: 0,0:21:17.15,0:21:20.20,Default,,0,0,0,,这 这种事不可能做得到…
Dialogue: 0,0:21:20.20,0:21:21.34,Default,,0,0,0,,那也必须做
Dialogue: 0,0:21:21.78,0:21:22.45,Default,,0,0,0,,金毛
Dialogue: 0,0:21:23.09,0:21:27.05,Default,,0,0,0,,经过这几天的战斗 你一定也已经知晓
Dialogue: 0,0:21:27.05,0:21:31.08,Default,,0,0,0,,黑羊之复杂 以及秦国为何要来攻打此地
Dialogue: 0,0:21:34.21,0:21:36.72,Default,,0,0,0,,黑羊虽然没有城池
Dialogue: 0,0:21:36.86,0:21:39.83,Default,,0,0,0,,但五座山丘和树海全都是天然要塞
Dialogue: 0,0:21:40.79,0:21:45.19,Default,,0,0,0,,要是这里被敌军占领 被真正建成前线军事基地
Dialogue: 0,0:21:45.67,0:21:47.68,Default,,0,0,0,,就将成为最险恶的侵略要地
Dialogue: 0,0:21:47.77,0:21:50.28,Default,,0,0,0,,赵军别说夺回此地
Dialogue: 0,0:21:50.38,0:21:52.92,Default,,0,0,0,,甚至连敌军人数都无法知晓
Dialogue: 0,0:21:54.66,0:21:59.67,Default,,0,0,0,,那样一来 赵国就只能大幅朝内移动国境
Dialogue: 0,0:22:00.16,0:22:01.89,Default,,0,0,0,,这一带的赵国人民
Dialogue: 0,0:22:02.04,0:22:05.49,Default,,0,0,0,,都将背井离乡 沦为难民
Dialogue: 0,0:22:06.95,0:22:09.62,Default,,0,0,0,,这场战斗就是为了避免此种情况
Dialogue: 0,0:22:10.32,0:22:13.43,Default,,0,0,0,,而并非庆舍大人和桓骑两个人的战斗
Dialogue: 0,0:22:14.29,0:22:17.35,Default,,0,0,0,,我深知你因庆舍大人战死而悲痛不已
Dialogue: 0,0:22:17.92,0:22:19.37,Default,,0,0,0,,但正是此时
Dialogue: 0,0:22:19.56,0:22:23.64,Default,,0,0,0,,你才要履行身为主将副官的职责 金毛
Dialogue: 0,0:22:27.02,0:22:29.27,Default,,0,0,0,,总兵力还是我们更多
Dialogue: 0,0:22:29.53,0:22:32.64,Default,,0,0,0,,拜托了 和我一起战斗吧
Dialogue: 0,0:22:33.28,0:22:34.69,Default,,0,0,0,,要是继续战斗
Dialogue: 0,0:22:34.69,0:22:37.32,Default,,0,0,0,,说不定还会有为庆舍大人报仇的机会…
Dialogue: 0,0:22:37.32,0:22:40.35,Default,,0,0,0,,行了 纪彗 别说了
Dialogue: 0,0:22:43.05,0:22:46.13,Default,,0,0,0,,我效忠多年的庆舍大人
Dialogue: 0,0:22:46.41,0:22:47.94,Default,,0,0,0,,已经回不来了
Dialogue: 0,0:22:50.84,0:22:53.71,Default,,0,0,0,,但是 你说得对
Dialogue: 0,0:22:54.40,0:22:58.08,Default,,0,0,0,,我们还有身为赵国将领的重大职责
Dialogue: 0,0:22:59.27,0:23:00.82,Default,,0,0,0,,我答应你 纪彗
Dialogue: 0,0:23:01.19,0:23:03.76,Default,,0,0,0,,无论如何都不能把黑羊让给秦国
Dialogue: 0,0:23:03.88,0:23:08.70,Default,,0,0,0,,我金毛就故意隐瞒主公之死 战斗到底
Dialogue: 0,0:23:12.55,0:23:13.47,Default,,0,0,0,,金毛…
Dialogue: 0,0:24:50.83,0:24:52.56,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:52.99,0:24:54.61,Default,,0,0,0,,「发自荣耀的咆哮」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

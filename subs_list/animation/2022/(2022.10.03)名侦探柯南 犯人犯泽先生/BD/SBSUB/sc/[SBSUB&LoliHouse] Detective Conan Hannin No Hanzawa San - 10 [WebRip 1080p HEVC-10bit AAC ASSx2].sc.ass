Dialogue: 0,0:06:01.51,0:06:02.93,Note,,0,0,0,,{\fad(0,482)\c&H637697&\3c&HE1E5E9&\4c&HE0E4E6&\pos(792,294)\frz13.45}捶肩券
Dialogue: 0,0:01:31.70,0:01:39.31,DefaultSingle-S,,0,0,0,,		谢谢惠顾
Dialogue: 0,0:01:39.48,0:01:49.10,DefaultSingle-S,,0,0,0,,		谢谢  谢谢  谢谢…
Dialogue: 0,0:01:49.48,0:01:50.63,DefaultSingle-S,,0,0,0,,		打工好累
Dialogue: 0,0:01:50.81,0:01:52.58,DefaultSingle-S,,0,0,0,,		这工作量不是一个人干得过来的
Dialogue: 0,0:01:52.58,0:01:54.80,DefaultSingle-S,,0,0,0,,		他为什么会觉得老鹰能代替人干活啊
Dialogue: 0,0:01:54.94,0:01:57.03,DefaultSingle-S,,0,0,0,,		我突然被卷入案件  先早退了
Dialogue: 0,0:01:57.03,0:01:58.50,DefaultSingle-S,,0,0,0,,		还有拜托给华生喂食
Dialogue: 0,0:01:58.50,0:02:00.39,DefaultSingle-S,,0,0,0,,		可恶的侦探
Dialogue: 0,0:02:00.53,0:02:03.08,DefaultSingle-S,,0,0,0,,		欢迎回来  犯泽先生  有你的包裹
Dialogue: 0,0:02:04.07,0:02:05.86,DefaultSingle-S,,0,0,0,,		大米  罐头  蔬菜  果酱
Dialogue: 0,0:02:05.86,0:02:06.98,DefaultSingle-S,,0,0,0,,		总是要受她帮助
Dialogue: 0,0:02:07.24,0:02:10.08,DefaultSingle-S,,0,0,0,,		我又给你寄了个一样的  你不是喜欢吗
Dialogue: 0,0:02:12.47,0:02:13.06,DefaultSingle-S,,0,0,0,,		喂
Dialogue: 0,0:02:13.06,0:02:15.77,DefaultSingle-S,,0,0,0,,		衣服不用寄了啦  我在这边自己买
Dialogue: 0,0:02:15.77,0:02:17.92,DefaultSingle-S,,0,0,0,,		你不是喜欢这边的衣服吗
Dialogue: 0,0:02:17.92,0:02:19.11,DefaultSingle-S,,0,0,0,,		哪里喜欢了啦
Dialogue: 0,0:02:19.61,0:02:23.31,DefaultSingle-S,,0,0,0,,		对了  我周末去你那边玩啊
Dialogue: 0,0:02:23.52,0:02:28.30,DefaultSingle-S,,0,0,0,,		我想去铃木塔  你能当个导游吗
Dialogue: 0,0:02:28.48,0:02:29.67,DefaultSingle-S,,0,0,0,,		你知道吗
Dialogue: 0,0:02:29.67,0:02:32.87,DefaultSingle-S,,0,0,0,,		铃木塔高635米  和「武藏小」读音一样
Dialogue: 0,0:02:33.44,0:02:34.41,DefaultSingle-S,,0,0,0,,		我要上班
Dialogue: 0,0:02:34.61,0:02:36.69,DefaultSingle-S,,0,0,0,,		他们动不动就会跟我换班
Dialogue: 0,0:02:36.69,0:02:38.83,DefaultSingle-S,,0,0,0,,		你就调一天休息嘛
Dialogue: 0,0:02:38.83,0:02:41.05,DefaultSingle-S,,0,0,0,,		嗯  应该可以
Dialogue: 0,0:02:41.05,0:02:44.32,DefaultSingle-S,,0,0,0,,		东京人很时髦吧  我得穿漂亮点才行
Dialogue: 0,0:02:44.32,0:02:45.47,DefaultSingle-S,,0,0,0,,		穿普通点就好啦
Dialogue: 0,0:02:54.94,0:02:57.57,DefaultSingle-S,,0,0,0,,		儿子啊  你过得还好吗
Dialogue: 0,0:02:57.93,0:02:58.79,DefaultSingle-S,,0,0,0,,		嗯…
Dialogue: 0,0:02:58.79,0:03:00.36,DefaultSingle-S,,0,0,0,,		好好吃饭了没
Dialogue: 0,0:03:00.61,0:03:01.21,DefaultSingle-S,,0,0,0,,		嗯…
Dialogue: 0,0:03:01.21,0:03:03.34,DefaultSingle-S,,0,0,0,,		好像瘦了一点啊
Dialogue: 0,0:03:03.34,0:03:03.76,DefaultSingle-S,,0,0,0,,		嗯…
Dialogue: 0,0:03:03.93,0:03:07.71,DefaultSingle-S,,0,0,0,,		你说要去东京的时候  我可是大吃一惊啊
Dialogue: 0,0:03:07.71,0:03:09.90,DefaultSingle-S,,0,0,0,,		不过看你过得挺好  我就放心了
Dialogue: 0,0:03:09.90,0:03:12.73,DefaultSingle-S,,0,0,0,,		喂  你声音小点  口音太重了
Dialogue: 0,0:03:15.14,0:03:17.67,DefaultSingle-S,,0,0,0,,		你怎么穿着这件啊  我给你寄回去了吧
Dialogue: 0,0:03:17.67,0:03:18.99,DefaultSingle-S,,0,0,0,,		你说什么啊
Dialogue: 0,0:03:18.99,0:03:21.83,DefaultSingle-S,,0,0,0,,		就是你寄回来了  所以我才穿上了啊
Dialogue: 0,0:03:21.83,0:03:23.77,DefaultSingle-S,,0,0,0,,		快换掉  太难为情了
Dialogue: 0,0:03:23.77,0:03:26.16,DefaultSingle-S,,0,0,0,,		为啥啊  多可爱呀
Dialogue: 0,0:03:26.46,0:03:28.37,DefaultSingle-S,,0,0,0,,		我要打工  先走了啊
Dialogue: 0,0:03:28.37,0:03:29.58,DefaultSingle-S,,0,0,0,,		你要打工吗
Dialogue: 0,0:03:29.58,0:03:33.04,DefaultSingle-S,,0,0,0,,		我可是忙着过这边的生活  没时间玩
Dialogue: 0,0:03:33.23,0:03:34.54,DefaultSingle-S,,0,0,0,,		是吗
Dialogue: 0,0:03:34.68,0:03:35.79,DefaultSingle-S,,0,0,0,,		这也没办法啊
Dialogue: 0,0:03:36.17,0:03:37.38,DefaultSingle-S,,0,0,0,,		毕竟是工作
Dialogue: 0,0:03:37.71,0:03:39.79,DefaultSingle-S,,0,0,0,,		在米花町生存很艰难
Dialogue: 0,0:03:40.19,0:03:43.19,DefaultSingle-S,,0,0,0,,		我才不要哭着找父母要钱
Dialogue: 0,0:03:44.66,0:03:45.39,DefaultSingle-S,,0,0,0,,		好
Dialogue: 0,0:03:45.57,0:03:46.35,DefaultSingle-S,,0,0,0,,		早上…
Dialogue: 0,0:03:46.35,0:03:49.47,DefaultSingle-S,,0,0,0,,		咱家儿子受你们照顾了
Dialogue: 0,0:03:49.47,0:03:50.32,DefaultSingle-S,,0,0,0,,		老妈
Dialogue: 0,0:03:50.73,0:03:51.52,DefaultSingle-S,,0,0,0,,		你怎么在这里
Dialogue: 0,0:03:51.52,0:03:52.59,DefaultSingle-S,,0,0,0,,		你来啦
Dialogue: 0,0:03:52.72,0:03:54.85,DefaultSingle-S,,0,0,0,,		他是个温柔的好孩子
Dialogue: 0,0:03:54.85,0:03:56.43,DefaultSingle-S,,0,0,0,,		请和他好好处着呢
Dialogue: 0,0:03:56.43,0:03:57.31,DefaultSingle-S,,0,0,0,,		发音好怪？
Dialogue: 0,0:03:57.31,0:03:58.32,DefaultSingle-S,,0,0,0,,		是暗号吗
Dialogue: 0,0:03:58.53,0:04:00.31,DefaultSingle-S,,0,0,0,,		你来这里干什么啊  老妈
Dialogue: 0,0:04:00.31,0:04:01.99,DefaultSingle-S,,0,0,0,,		来打招呼的呀
Dialogue: 0,0:04:01.99,0:04:04.12,DefaultSingle-S,,0,0,0,,		这个大家一起吃吧
Dialogue: 0,0:04:04.68,0:04:06.68,DefaultSingle-S,,0,0,0,,		您真客气
Dialogue: 0,0:04:07.30,0:04:07.88,DefaultSingle-S,,0,0,0,,		下巴？
Dialogue: 0,0:04:06.71,0:04:09.28,DefaultSingle-S,,0,0,0,,		这里可是东京  没人会吃这玩意
Dialogue: 0,0:04:09.28,0:04:11.12,DefaultSingle-S,,0,0,0,,		飞鱼野烧味道贼棒的
Dialogue: 0,0:04:11.12,0:04:12.33,DefaultSingle-S,,0,0,0,,		好吃是好吃啦
Dialogue: 0,0:04:12.56,0:04:14.96,DefaultSingle-S,,0,0,0,,		你妨碍我工作了  回去啦
Dialogue: 0,0:04:15.45,0:04:18.02,DefaultSingle-S,,0,0,0,,		吓人吓人  我这就走
Dialogue: 0,0:04:20.72,0:04:21.99,DefaultSingle-S,,0,0,0,,		辛苦了
Dialogue: 0,0:04:22.49,0:04:24.09,DefaultSingle-S,,0,0,0,,		该死的侦探
Dialogue: 0,0:04:24.35,0:04:25.63,DefaultSingle-S,,0,0,0,,		什么？有案子？
Dialogue: 0,0:04:25.63,0:04:26.51,DefaultSingle-S,,0,0,0,,		我早退了
Dialogue: 0,0:04:26.74,0:04:28.34,DefaultSingle-S,,0,0,0,,		说走就走
Dialogue: 0,0:04:28.44,0:04:30.52,DefaultSingle-S,,0,0,0,,		这个城市怎么天天都是案件
Dialogue: 0,0:04:30.99,0:04:31.68,DefaultSingle-S,,0,0,0,,		我回来了
Dialogue: 0,0:04:31.68,0:04:34.63,DefaultSingle-S,,0,0,0,,		咱家儿子真是温柔蟹了
Dialogue: 0,0:04:34.63,0:04:35.60,DefaultSingle-S,,0,0,0,,		蟹了？
Dialogue: 0,0:04:41.87,0:04:44.38,DefaultSingle-S,,0,0,0,,		犯泽先生  你母亲真有趣
Dialogue: 0,0:04:44.75,0:04:47.05,DefaultSingle-S,,0,0,0,,		真是有出息蟹了
Dialogue: 0,0:04:47.05,0:04:48.47,DefaultSingle-S,,0,0,0,,		什么什么  蟹了蟹了？
Dialogue: 0,0:04:48.47,0:04:49.88,DefaultSingle-S,,0,0,0,,		蟹蟹蟹？
Dialogue: 0,0:04:50.55,0:04:52.60,DefaultSingle-S,,0,0,0,,		阿姨真会押韵
Dialogue: 0,0:04:53.85,0:04:55.85,DefaultSingle-S,,0,0,0,,		哎呀  大家都是好人啊
Dialogue: 0,0:04:55.85,0:04:56.60,DefaultSingle-S,,0,0,0,,		飞鱼野？
Dialogue: 0,0:04:56.71,0:04:57.53,DefaultSingle-S,,0,0,0,,		啥啊  下巴？
Dialogue: 0,0:04:57.53,0:04:58.32,DefaultSingle-S,,0,0,0,,		不知道
Dialogue: 0,0:04:58.32,0:05:00.85,DefaultSingle-S,,0,0,0,,		好吃  超下酒
Dialogue: 0,0:05:02.39,0:05:04.17,DefaultSingle-S,,0,0,0,,		老妈  别这样啊
Dialogue: 0,0:05:04.36,0:05:06.28,DefaultSingle-S,,0,0,0,,		他们都在取笑你  你不明白吗
Dialogue: 0,0:05:06.28,0:05:07.57,DefaultSingle-S,,0,0,0,,		你快回去
Dialogue: 0,0:05:10.03,0:05:12.53,DefaultSingle-S,,0,0,0,,		我今天就先告辞了
Dialogue: 0,0:05:12.61,0:05:14.52,DefaultSingle-S,,0,0,0,,		咦  阿姨你不住下吗
Dialogue: 0,0:05:14.52,0:05:15.87,DefaultSingle-S,,0,0,0,,		我订了酒店
Dialogue: 0,0:05:16.20,0:05:18.04,DefaultSingle-S,,0,0,0,,		儿子  你明天去铃木塔吗
Dialogue: 0,0:05:18.04,0:05:18.54,DefaultSingle-S,,0,0,0,,		不去
Dialogue: 0,0:05:18.90,0:05:21.88,DefaultSingle-S,,0,0,0,,		是吗  那我去了铃木塔就直接回去了
Dialogue: 0,0:05:22.36,0:05:24.35,DefaultSingle-S,,0,0,0,,		看到你这么精神  我就放心了
Dialogue: 0,0:05:24.35,0:05:25.63,DefaultSingle-S,,0,0,0,,		你可多保重啊
Dialogue: 0,0:05:26.20,0:05:27.75,DefaultSingle-S,,0,0,0,,		也旦旦大家了
Dialogue: 0,0:05:27.75,0:05:29.32,DefaultSingle-S,,0,0,0,,		旦旦  旦旦
Dialogue: 0,0:05:30.61,0:05:31.33,DefaultSingle-S,,0,0,0,,		旦旦？
Dialogue: 0,0:05:31.44,0:05:32.53,DefaultSingle-S,,0,0,0,,		旦旦是啥
Dialogue: 0,0:05:32.53,0:05:33.07,DefaultSingle-S,,0,0,0,,		不知道
Dialogue: 0,0:05:33.07,0:05:34.72,DefaultSingle-S,,0,0,0,,		多多加油之类的？
Dialogue: 0,0:05:34.72,0:05:35.48,DefaultSingle-S,,0,0,0,,		旦旦
Dialogue: 0,0:05:35.81,0:05:38.09,DefaultSingle-S,,0,0,0,,		旦旦是谢谢的意思
Dialogue: 0,0:05:38.19,0:05:38.84,DefaultSingle-S,,0,0,0,,		真的假的
Dialogue: 0,0:05:38.84,0:05:40.02,DefaultSingle-S,,0,0,0,,		都看不出原型了
Dialogue: 0,0:05:45.41,0:05:46.90,DefaultSingle-S,,0,0,0,,		犯泽先生  不好了
Dialogue: 0,0:05:47.07,0:05:48.28,DefaultSingle-S,,0,0,0,,		铃木塔被…
Dialogue: 0,0:05:48.63,0:05:51.63,DefaultSingle-S,,0,0,0,,		说是有炸弹犯把游客关在塔里了
Dialogue: 0,0:05:52.40,0:05:52.99,DefaultSingle-S,,0,0,0,,		老妈
Dialogue: 0,0:05:53.66,0:05:57.16,DefaultSingle-S,,0,0,0,,		不是吧  米花町  老妈是无辜的啊
Dialogue: 0,0:05:57.41,0:05:58.59,DefaultSingle-S,,0,0,0,,		老妈
Dialogue: 0,0:06:06.16,0:06:07.48,DefaultSingle-S,,0,0,0,,		老妈
Dialogue: 0,0:06:09.59,0:06:11.18,DefaultSingle-S,,0,0,0,,		老妈
Dialogue: 0,0:06:11.92,0:06:13.31,DefaultSingle-S,,0,0,0,,		儿子啊
Dialogue: 0,0:06:13.58,0:06:16.26,DefaultSingle-S,,0,0,0,,		米花町还真是可怕啊
Dialogue: 0,0:06:16.43,0:06:18.93,DefaultSingle-S,,0,0,0,,		我在半路买了彩虹棉花糖
Dialogue: 0,0:06:18.93,0:06:22.15,DefaultSingle-S,,0,0,0,,		结果不知啥时候起  铃木塔就不给进了
Dialogue: 0,0:06:22.32,0:06:25.74,DefaultSingle-S,,0,0,0,,		你咋了  担心起我啦？
Dialogue: 0,0:06:25.87,0:06:26.69,DefaultSingle-S,,0,0,0,,		嗯…
Dialogue: 0,0:06:26.91,0:06:29.23,DefaultSingle-S,,0,0,0,,		你果然很温柔
Dialogue: 0,0:06:29.23,0:06:31.15,DefaultSingle-S,,0,0,0,,		我说得没错
Dialogue: 0,0:06:31.96,0:06:33.67,DefaultSingle-S,,0,0,0,,		你今天要打工吗
Dialogue: 0,0:06:34.97,0:06:36.65,DefaultSingle-S,,0,0,0,,		今天也没法去打工了
Dialogue: 0,0:06:36.65,0:06:37.91,DefaultSingle-S,,0,0,0,,		靠你了  兼职领班
Dialogue: 0,0:06:44.59,0:06:46.65,DefaultSingle-S,,0,0,0,,		要不去东都塔？
Dialogue: 0,0:06:46.96,0:06:48.42,DefaultSingle-S,,0,0,0,,		好呀
Dialogue: 0,0:06:48.42,0:06:51.31,DefaultSingle-S,,0,0,0,,		东都塔好像是333米高
Dialogue: 0,0:06:51.31,0:06:52.51,DefaultSingle-S,,0,0,0,,		新闻速报
Dialogue: 0,0:06:52.69,0:06:57.77,DefaultSingle-S,,0,0,0,,		铃木塔中的1600名游客  奇迹般地全部平安获救
Dialogue: 0,0:08:31.89,0:08:34.82,DefaultSingle-S,,0,0,0,,		《犯人犯泽》也只剩两集了
Dialogue: 0,0:08:34.90,0:08:39.30,DefaultSingle-S,,0,0,0,,		我打算好好地嗨一场  但聪明的观众应该已经发现了
Dialogue: 0,0:08:39.30,0:08:42.20,DefaultSingle-S,,0,0,0,,		对  我还不是犯人
Dialogue: 0,0:08:42.26,0:08:43.94,DefaultSingle-S,,0,0,0,,		这样下去还叫什么犯人
Dialogue: 0,0:08:43.94,0:08:45.79,DefaultSingle-S,,0,0,0,,		不就是个全身黑色紧身衣吗
Dialogue: 0,0:08:45.97,0:08:50.27,DefaultSingle-S,,0,0,0,,		会被人嘲笑是个顶着名作名头的抱大腿混蛋
Dialogue: 0,0:08:50.36,0:08:52.53,DefaultSingle-S,,0,0,0,,		所以下集我要急速接近目标
Dialogue: 0,0:08:52.53,0:08:54.42,DefaultSingle-S,,0,0,0,,		标题是「噢！神签」
Dialogue: 0,0:08:54.62,0:08:56.13,DefaultSingle-S,,0,0,0,,		从第11集开始也不晚
Dialogue: 0,0:08:56.13,0:08:58.97,DefaultSingle-S,,0,0,0,,		开始吧  Soul  &  Soul
Dialogue: 0,0:04:04.12,0:04:05.59,Note,,0,0,0,,		注：「飞鱼」和「下巴」日语发音相同
Dialogue: 0,0:04:04.12,0:04:04.68,DefaultSingle-S,,0,0,0,,	{\a6\fs55}	下巴？
Dialogue: 0,0:01:43.42,0:01:46.42,DefaultSingle-S,,0,0,0,,

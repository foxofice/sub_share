Dialogue: 0,0:09:42.29,0:09:44.07,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}使用1个叠放单位{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:09:44.32,0:09:47.31,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将对手1只怪兽的怪兽效果无效{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:09:47.78,0:09:49.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击力减半！
Dialogue: 0,0:09:55.35,0:09:58.49,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}不过是攻击力下降了50而已……。
Dialogue: 0,0:09:58.89,0:10:01.53,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我发动 拉格纳·零的效果！
Dialogue: 0,0:10:02.06,0:10:03.96,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}使用1个超量单位{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:04.45,0:10:06.16,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}对方怪兽的攻击力{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:06.16,0:10:07.49,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}比原本的攻击力
Dialogue: 0,0:10:07.49,0:10:08.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}下降的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:09.26,0:10:11.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}破坏那只怪兽！
Dialogue: 0,0:10:11.71,0:10:12.49,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}什么！？
Dialogue: 0,0:10:13.24,0:10:15.41,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}守卫者·死亡终极！
Dialogue: 0,0:10:20.36,0:10:22.04,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}还没完！速攻魔法
Dialogue: 0,0:10:22.04,0:10:24.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}圣光闪电发动！
Dialogue: 0,0:10:25.32,0:10:26.97,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这张卡在自己场上
Dialogue: 0,0:10:26.97,0:10:29.01,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}有圣光闪电怪兽存在{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:29.13,0:10:31.22,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}对方怪兽被破坏的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:31.86,0:10:32.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}给与对方玩家
Dialogue: 0,0:10:32.87,0:10:34.81,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}1000点伤害！
Dialogue: 0,0:10:40.83,0:10:42.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}怎么样 贝库塔。
Dialogue: 0,0:10:42.35,0:10:43.97,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我们两人的连携。
Dialogue: 0,0:10:46.26,0:10:47.73,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}少开玩笑了。
Dialogue: 0,0:10:48.05,0:10:49.53,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}用拉格纳·零的效果
Dialogue: 0,0:10:49.53,0:10:51.02,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}破坏怪兽的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:51.09,0:10:52.69,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}抽1张卡！
Dialogue: 0,0:10:53.01,0:10:56.66,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后 我盖放一张卡 回合结束…。
Dialogue: 0,0:10:56.58,0:10:57.89,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哦 等等！
Dialogue: 0,0:10:59.14,0:11:01.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}陷阱发动！ 死灵之执行！
Dialogue: 0,0:11:02.17,0:11:02.88,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这张卡
Dialogue: 0,0:11:02.88,0:11:05.24,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}在我的 No.怪兽被破坏的回合的
Dialogue: 0,0:11:05.24,0:11:06.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}结束阶段发动{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:11:07.06,0:11:08.62,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}阶级4以下的暗属性
Dialogue: 0,0:11:08.62,0:11:10.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}恶魔族怪兽执行{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:11:10.84,0:11:13.48,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}以墓地的暗属性怪兽为素材
Dialogue: 0,0:11:13.48,0:11:15.03,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}执行召唤！
Dialogue: 0,0:11:15.80,0:11:18.93,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}此时 所选择的素材的等级全部{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:11:19.35,0:11:22.29,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}变为执行召唤条件所需的等级！
Dialogue: 0,0:11:23.23,0:11:24.85,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我将墓地里的 暗属性
Dialogue: 0,0:11:24.85,0:11:26.68,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}安布拉幽灵2只和{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:11:26.68,0:11:29.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}鬼火·魔·精灵进行叠放！
Dialogue: 0,0:11:30.38,0:11:31.76,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}执行召唤！
Dialogue: 0,0:11:33.12,0:11:35.99,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现身吧 No.43！
Dialogue: 0,0:11:41.30,0:11:44.68,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}妨碍死者安眠的亵渎化身。
Dialogue: 0,0:11:45.32,0:11:48.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}魂魄傀儡鬼 魂·马里奥内特！
Dialogue: 0,0:11:49.69,0:11:52.73,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后 魂·马里奥内特在被召唤的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:11:53.14,0:11:56.35,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}将我的墓地里的1只 No.怪兽装备。
Dialogue: 0,0:11:57.19,0:11:59.73,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我将墓地里的 No.96
Dialogue: 0,0:11:59.73,0:12:02.26,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}装备给魂·马里奥内特！
Dialogue: 0,0:12:06.02,0:12:08.17,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}贝库塔！你到底要干什么！
Dialogue: 0,0:12:08.43,0:12:10.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}库库库！ 再发动永续魔法
Dialogue: 0,0:12:10.90,0:12:14.12,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}堂·千尊王座的效果！
Dialogue: 0,0:12:15.02,0:12:17.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}自己受到伤害的那个回合结束时。
Dialogue: 0,0:12:19.11,0:12:23.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}恢复那个伤害数值的生命值！！
Dialogue: 0,0:12:27.76,0:12:31.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}涌上来了… 涌上来了啊～！！
Dialogue: 0,0:12:37.31,0:12:40.47,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}《纳修… 多谢款待》
Dialogue: 0,0:12:43.29,0:12:46.19,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}在这里发动魂·马里奥内特的效果！
Dialogue: 0,0:12:46.76,0:12:48.36,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}当我的生命值恢复时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:12:48.86,0:12:49.69,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那个数值
Dialogue: 0,0:12:49.69,0:12:53.21,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}魂·马里奥内特的攻击力会提升！
Dialogue: 0,0:12:54.12,0:12:57.02,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后，把恢复的生命值等量的伤害{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:12:57.57,0:12:59.30,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}施加给对手玩家！
Dialogue: 0,0:13:00.28,0:13:03.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我吃到的1000点伤害
Dialogue: 0,0:13:03.10,0:13:05.06,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}原封不动地还给你！
Dialogue: 0,0:13:05.31,0:13:06.06,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉格！
Dialogue: 0,0:13:08.19,0:13:09.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(贝库塔)结果转换！
Dialogue: 0,0:13:16.62,0:13:17.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉格！
Dialogue: 0,0:13:18.87,0:13:20.60,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}没事，这点程度。
Dialogue: 0,0:13:21.22,0:13:22.42,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}对对。
Dialogue: 0,0:13:22.82,0:13:24.08,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}[显示器](贝库塔)
Dialogue: 0,0:13:24.08,0:13:25.69,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这点程度都扛不住可不行啊。
Dialogue: 0,0:13:26.11,0:13:28.35,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}承受的伤害量会恢复生命值{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:13:28.66,0:13:31.07,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}相应地，让自己怪兽的攻击力
Dialogue: 0,0:13:31.07,0:13:31.95,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}提升。
Dialogue: 0,0:13:32.26,0:13:35.83,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}而且，还会对我们其中一人造成同样的伤害。
Dialogue: 0,0:13:36.19,0:13:39.34,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}《然后吸取纳修的能量{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:13:39.43,0:13:42.05,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}让他变弱》
Dialogue: 0,0:13:43.57,0:13:45.13,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}(贝库塔)怎么样！
Dialogue: 0,0:13:45.13,0:13:46.84,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}本大爷可是不死之身啊。
Dialogue: 0,0:13:47.36,0:13:49.81,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}也就是说，如果不一回合解决掉那家伙，
Dialogue: 0,0:13:49.81,0:13:51.66,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我们就没有胜算了吗。
Dialogue: 0,0:13:52.05,0:13:54.76,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就凭你也想赢我？
Dialogue: 0,0:13:55.18,0:13:58.20,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}赢过等同于神的这位贝库塔大人！
Dialogue: 0,0:13:58.74,0:14:01.80,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的回合，抽卡！
Dialogue: 0,0:14:02.10,0:14:04.00,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我用灵魂马里奥内特
Dialogue: 0,0:14:04.00,0:14:05.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}攻击荣耀英雄！
Dialogue: 0,0:14:06.26,0:14:06.99,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}笨蛋！
Dialogue: 0,0:14:15.48,0:14:18.20,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}为什么要自己破坏怪兽！？
Dialogue: 0,0:14:21.41,0:14:24.05,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}灵魂马里奥内特的效果发动！
Dialogue: 0,0:14:27.37,0:14:29.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这家伙只要装备着 No.卡{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:29.74,0:14:30.83,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就不会被破坏！
Dialogue: 0,0:14:31.08,0:14:31.83,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}什么！？
Dialogue: 0,0:14:32.48,0:14:34.07,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}真遗憾啊。
Dialogue: 0,0:14:35.69,0:14:40.64,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}而且我还要发动速攻魔法 自虐的宝牌！
Dialogue: 0,0:14:41.69,0:14:42.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这张卡是 对自己
Dialogue: 0,0:14:42.91,0:14:44.26,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}当伤害发生时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:44.64,0:14:47.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}再追加1000点伤害。
Dialogue: 0,0:14:52.39,0:14:54.52,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}凭借自虐的宝札的进一步效果{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:54.83,0:14:56.89,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我抽1张卡！
Dialogue: 0,0:14:57.23,0:15:00.79,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后 我盖放2张卡 回合结束！
Dialogue: 0,0:15:02.66,0:15:03.46,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就在这一瞬间
Dialogue: 0,0:15:03.46,0:15:06.65,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}咚· thousand的玉座的效果发动！
Dialogue: 0,0:15:14.66,0:15:16.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}接着 魂·马里奥内特的
Dialogue: 0,0:15:16.90,0:15:18.31,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}怪兽效果发动！
Dialogue: 0,0:15:18.69,0:15:21.82,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}又来了我的怪兽攻击力又提升了！
Dialogue: 0,0:15:22.15,0:15:24.19,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后 和恢复的生命值一样
Dialogue: 0,0:15:24.19,0:15:26.79,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你就接下2500的伤害吧！
Dialogue: 0,0:15:29.36,0:15:31.31,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}库库库 这次也是梅拉古！
Dialogue: 0,0:15:31.61,0:15:33.45,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}结果转换！
Dialogue: 0,0:15:38.96,0:15:40.96,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉古！！
Dialogue: 0,0:15:43.90,0:15:45.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}真难看啊。平时
Dialogue: 0,0:15:45.57,0:15:49.00,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}总是高高在上的你 现在却狼狈不堪。
Dialogue: 0,0:15:50.30,0:15:51.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉古……。
Dialogue: 0,0:15:52.78,0:15:55.31,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你这家伙 为什么老是盯着梅拉古！
Dialogue: 0,0:16:01.20,0:16:02.89,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}很好 就是这个气势！
Dialogue: 0,0:16:02.89,0:16:05.03,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就是这个眼神 就是这个眼神！
Dialogue: 0,0:16:05.07,0:16:07.44,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}折磨起来才有价值啊。
Dialogue: 0,0:16:07.74,0:16:09.52,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}贝克塔！
Dialogue: 0,0:16:10.05,0:16:12.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉古 你的生命值是500。
Dialogue: 0,0:16:12.83,0:16:16.53,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就差一点了。这次一定把你送进地狱。
Dialogue: 0,0:16:17.25,0:16:18.23,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这次一定？
Dialogue: 0,0:16:18.75,0:16:22.23,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}啊？ 难道说你还没想起来吗？
Dialogue: 0,0:16:22.93,0:16:23.99,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}想起来……
Dialogue: 0,0:16:25.10,0:16:27.11,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那 我就告诉你吧！
Dialogue: 0,0:16:27.67,0:16:30.46,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现在即将揭晓的冲击真相！
Dialogue: 0,0:16:30.90,0:16:32.61,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}锵锵锵——！
Dialogue: 0,0:16:33.75,0:16:36.11,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉古～ 在巴里安世界
Dialogue: 0,0:16:36.11,0:16:38.28,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}杀死你和纳修的人{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:16:38.28,0:16:40.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就是我！
Dialogue: 0,0:16:50.46,0:16:52.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}((纳修：住手 贝克塔！
Dialogue: 0,0:16:52.33,0:16:52.99,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你输了！
Dialogue: 0,0:16:54.85,0:16:56.70,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}来，把梅拉格放开。
Dialogue: 0,0:16:56.64,0:16:59.56,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那样的话，我至少饶你一命。
Dialogue: 0,0:17:00.18,0:17:03.08,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}纳修，别管我，快对贝库塔！
Dialogue: 0,0:17:03.55,0:17:04.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}（贝库塔）哼，少开玩笑了。
Dialogue: 0,0:17:04.57,0:17:05.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}火大，真火大啊，你们这群家伙！
Dialogue: 0,0:17:05.93,0:17:07.41,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}（贝库塔）哼，少开玩笑了。
Dialogue: 0,0:17:07.41,0:17:08.88,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}火大，真火大啊，你们这群家伙！
Dialogue: 0,0:17:09.55,0:17:13.09,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}既然这样，我就把你妹妹送进地狱去！
Dialogue: 0,0:17:14.00,0:17:17.57,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}陷阱发动！天空的大剑！
Dialogue: 0,0:17:26.24,0:17:28.50,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这东西一旦被吸进去{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:17:28.50,0:17:30.49,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就再也爬不出来的
Dialogue: 0,0:17:30.49,0:17:31.39,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}暗黑漩涡！
Dialogue: 0,0:17:32.30,0:17:34.30,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}住手，贝库塔。
Dialogue: 0,0:17:34.58,0:17:36.31,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}少废话！消失吧！
Dialogue: 0,0:17:36.62,0:17:37.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉格！
Dialogue: 0,0:17:39.30,0:17:41.04,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉格～！！
Dialogue: 0,0:17:41.57,0:17:42.49,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}蠢货。
Dialogue: 0,0:17:44.50,0:17:45.34,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}梅拉格！
Dialogue: 0,0:17:45.47,0:17:46.20,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}纳修！
Dialogue: 0,0:17:47.35,0:17:48.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}身体动不了！
Dialogue: 0,0:17:57.68,0:17:58.92,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这样下去的话……
Dialogue: 0,0:17:59.12,0:17:59.73,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}纳修……
Dialogue: 0,0:18:01.95,0:18:02.77,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}（纳修）那是！？
Dialogue: 0,0:18:08.26,0:18:09.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这、这里是？
Dialogue: 0,0:18:12.49,0:18:15.80,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}（阿比斯）我们来迎接您了我们的王啊。
Dialogue: 0,0:18:16.05,0:18:16.75,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}（纳修）你是？
Dialogue: 0,0:18:17.17,0:18:18.38,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我是阿比斯。
Dialogue: 0,0:18:18.68,0:18:21.42,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}侍奉您、辅佐您之人。
Dialogue: 0,0:18:22.21,0:18:23.38,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}辅佐我？
Dialogue: 0,0:18:24.48,0:18:26.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你们的灵魂将会{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:18:26.47,0:18:29.78,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}在人类世界 寻得新的容器想必会如此。
Dialogue: 0,0:18:30.28,0:18:32.19,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我们要变成人类！？
Dialogue: 0,0:18:32.75,0:18:36.50,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}不过 至今为止的所有记忆 都会失去。
Dialogue: 0,0:18:36.65,0:18:41.10,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后 当王再次与在下相逢之时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:18:41.50,0:18:43.69,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那份记忆……。
Dialogue: 0,0:18:45.30,0:18:47.80,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}明白了，拜托你了，阿比斯。
Dialogue: 0,0:18:54.25,0:18:54.86,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}怎么样了？
Dialogue: 0,0:18:54.86,0:18:56.08,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这些孩子的父母。
Dialogue: 0,0:18:56.64,0:18:59.14,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}不行了，刚刚去世了。
Dialogue: 0,0:18:59.26,0:19:00.05,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这样啊……。
Dialogue: 0,0:19:01.27,0:19:03.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你，把这些孩子送到太平间去。
Dialogue: 0,0:19:04.23,0:19:06.01,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}然后，联系警察。
Dialogue: 0,0:19:06.45,0:19:07.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}是。
Dialogue: 0,0:19:13.91,0:19:14.96,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}怎、怎么了！？
Dialogue: 0,0:19:15.34,0:19:16.09,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}活过来了！
Dialogue: 0,0:19:16.46,0:19:17.72,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}孩子活过来了！
Dialogue: 0,0:19:20.46,0:19:21.48,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}（多尔贝）梅拉格……。
Dialogue: 0,0:19:22.51,0:19:25.81,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我全都想起来了。
Dialogue: 0,0:19:27.81,0:19:29.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我和纳修……。
Dialogue: 0,0:19:30.88,0:19:33.38,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}贝库塔，你为什么要做那种事！
Dialogue: 0,0:19:33.75,0:19:35.81,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}因为我看他不顺眼啊。
Dialogue: 0,0:19:36.96,0:19:38.85,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我从第一次见面的时候起{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:19:39.17,0:19:41.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就看纳修不顺眼啊。
Dialogue: 0,0:19:42.56,0:19:45.60,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那家伙做的每一件事全都让我不爽！
Dialogue: 0,0:19:46.58,0:19:48.50,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我和那家伙 绝对{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:19:48.50,0:19:50.13,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}是水火不容的
Dialogue: 0,0:19:50.13,0:19:51.09,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}命运啊。
Dialogue: 0,0:19:52.24,0:19:55.37,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}不过啊 我一开始也是忍着的。
Dialogue: 0,0:19:55.37,0:19:56.87,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}就算再怎么不爽
Dialogue: 0,0:19:56.87,0:19:58.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}突然就杀掉 也不太好。
Dialogue: 0,0:19:59.34,0:20:01.63,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}所以 就搞了个积分制。
Dialogue: 0,0:20:02.59,0:20:03.90,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}积分制？
Dialogue: 0,0:20:04.46,0:20:07.75,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}纳修每让我火大一次 就1分。
Dialogue: 0,0:20:08.22,0:20:11.92,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}等攒到 1亿分的时候{\fnNoto Sans CJK SC}➡{\fnZCOOL KuaiLe}就宰了他！
Dialogue: 0,0:20:12.92,0:20:14.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}在那之前 都得忍着。
Dialogue: 0,0:20:15.75,0:20:18.23,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}那家伙每说一句话 就1分。
Dialogue: 0,0:20:19.11,0:20:22.32,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}每做一件事就1分 这么算下来的话……
Dialogue: 0,0:20:23.18,0:20:24.67,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}哎呀妈呀 吓死人了！
Dialogue: 0,0:20:25.10,0:20:28.35,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}终于攒够了啊整整1亿点数！
Dialogue: 0,0:20:30.29,0:20:31.13,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}贝库塔。
Dialogue: 0,0:20:32.13,0:20:36.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}不过，本以为已经解决掉的那两个人居然还活着啊。
Dialogue: 0,0:20:36.92,0:20:40.03,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}借用人类的身体转生后的我们……。
Dialogue: 0,0:20:40.94,0:20:44.92,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}作为神代凌牙和璃绪与游马还有他的同伴们相遇{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:20:45.57,0:20:47.02,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}逐渐加深了羁绊。
Dialogue: 0,0:20:50.45,0:20:52.33,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}当取回作为巴利安的记忆
Dialogue: 0,0:20:52.33,0:20:53.91,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}得知那份使命的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:20:54.45,0:20:56.58,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}纳修他，究竟有多痛苦啊！
Dialogue: 0,0:20:57.41,0:20:59.24,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}[显示器](贝库塔)啊啊。
Dialogue: 0,0:20:59.24,0:21:00.48,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}看着真是愉快啊。
Dialogue: 0,0:21:01.20,0:21:04.34,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}贝库塔！！
Dialogue: 0,0:21:14.87,0:21:15.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}你这家伙！
Dialogue: 0,0:21:16.02,0:21:16.68,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}基拉古！
Dialogue: 0,0:21:21.42,0:21:24.85,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}《纳修，把你的力量借给我！》
Dialogue: 0,0:21:25.53,0:21:28.41,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}我的回合 抽卡！
Dialogue: 0,0:21:29.44,0:21:32.69,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}发动升阶魔法 七皇之剑！
Dialogue: 0,0:21:32.99,0:21:34.78,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}这张卡可以将自己场上的
Dialogue: 0,0:21:34.78,0:21:37.27,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}叠放超量怪兽 混沌化{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:21:37.61,0:21:38.78,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}进行升阶！
Dialogue: 0,0:21:38.99,0:21:40.94,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}混沌超量变换！
Dialogue: 0,0:21:45.13,0:21:48.43,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}现身吧 CNo.103！
Dialogue: 0,0:21:50.87,0:21:54.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}连时间都能冻结的无限之力如今 再度苏醒。
Dialogue: 0,0:21:55.31,0:21:58.11,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}神葬零娘 拉格纳·无限！
Dialogue: 0,0:22:00.50,0:22:03.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}贝库塔 这次轮到我把你{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:22:03.93,0:22:07.93,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}让你再也无法活着回去冻成冰块！
Dialogue: 0,0:23:40.71,0:23:43.40,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:43.68,0:23:48.00,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:48.44,0:23:51.09,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:51.48,0:23:54.15,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:54.40,0:23:56.74,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:56.74,0:23:59.01,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:59.36,0:24:01.55,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:24:01.84,0:24:03.70,Default,,0000,0000,0000,,{\fnZCOOL KuaiLe}

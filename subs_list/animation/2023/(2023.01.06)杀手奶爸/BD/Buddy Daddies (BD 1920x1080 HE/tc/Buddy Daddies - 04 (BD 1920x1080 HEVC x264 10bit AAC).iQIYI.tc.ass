Dialogue: 0,0:00:01.16,0:00:03.58,Default,,0,0,0,,爸爸…
Dialogue: 0,0:00:03.58,0:00:05.00,Default,,0,0,0,,美俐也要用
Dialogue: 0,0:00:05.16,0:00:06.95,Default,,0,0,0,,美俐也想用
Dialogue: 0,0:00:06.95,0:00:08.58,Default,,0,0,0,,讓我用嘛
Dialogue: 0,0:00:08.58,0:00:11.20,Default,,0,0,0,,我會好好用的
Dialogue: 0,0:00:11.83,0:00:13.45,Default,,0,0,0,,那你倒進這裡
Dialogue: 0,0:00:14.04,0:00:15.45,Default,,0,0,0,,慢慢倒
Dialogue: 0,0:00:15.79,0:00:18.58,Default,,0,0,0,,慢慢來
Dialogue: 0,0:00:20.45,0:00:22.04,Default,,0,0,0,,對不起
Dialogue: 0,0:00:22.37,0:00:24.37,Default,,0,0,0,,再一次嘛 再一次
Dialogue: 0,0:00:24.37,0:00:26.20,Default,,0,0,0,,呃…好
Dialogue: 0,0:00:40.29,0:00:42.08,Default,,0,0,0,,美俐也想用
Dialogue: 0,0:00:42.79,0:00:43.62,Default,,0,0,0,,喂
Dialogue: 0,0:00:45.41,0:00:47.29,Default,,0,0,0,,等…等等…
Dialogue: 0,0:00:55.33,0:00:56.83,Default,,0,0,0,,美俐也要用
Dialogue: 0,0:00:56.83,0:00:58.20,Default,,0,0,0,,喂 小心
Dialogue: 0,0:01:03.33,0:01:05.20,Default,,0,0,0,,對不起
Dialogue: 0,0:01:12.95,0:01:14.70,Default,,0,0,0,,對不起
Dialogue: 0,0:01:16.20,0:01:18.41,Default,,0,0,0,,對不起
Dialogue: 0,0:01:24.08,0:01:26.41,Default,,0,0,0,,對不起
Dialogue: 0,0:01:28.62,0:01:32.33,Default,,0,0,0,,爸爸 看我
Dialogue: 0,0:01:33.03,0:01:34.20,Default,,0,0,0,,真累人
Dialogue: 0,0:01:34.87,0:01:37.87,Default,,0,0,0,,再這樣下去我們的體力會先透支
Dialogue: 0,0:01:38.20,0:01:40.62,Default,,0,0,0,,再不去接工作 就不妙了
Dialogue: 0,0:01:42.25,0:01:45.50,Default,,0,0,0,,（雙葉托兒所）
Dialogue: 0,0:01:45.91,0:01:47.41,Default,,0,0,0,,托兒所…
Dialogue: 0,0:01:50.45,0:01:53.87,OPEDJP,,0,0,0,,ねえ愛したいこれは真実？
Dialogue: 0,0:01:53.87,0:01:57.37,OPEDJP,,0,0,0,,ただ愛されたいのは不誠実？
Dialogue: 0,0:01:57.37,0:01:59.58,OPEDJP,,0,0,0,,もうどうすればいい
Dialogue: 0,0:01:59.58,0:02:02.25,OPEDJP,,0,0,0,,どうすればいいのか
Dialogue: 0,0:02:05.58,0:02:08.37,OPEDJP,,0,0,0,,街はいつも通り今日も
Dialogue: 0,0:02:08.37,0:02:12.04,OPEDJP,,0,0,0,,惚れた腫れたで色めきたつ
Dialogue: 0,0:02:12.04,0:02:15.54,OPEDJP,,0,0,0,,エキストラは家に帰るだけ
Dialogue: 0,0:02:15.54,0:02:19.04,OPEDJP,,0,0,0,,不貞腐れてやしないさ
Dialogue: 0,0:02:19.04,0:02:22.79,OPEDJP,,0,0,0,,そんな日々を切り裂くように
Dialogue: 0,0:02:22.79,0:02:26.29,OPEDJP,,0,0,0,,突然現れた君は
Dialogue: 0,0:02:26.29,0:02:29.79,OPEDJP,,0,0,0,,痺れるような笑顔で僕の
Dialogue: 0,0:02:29.79,0:02:34.62,OPEDJP,,0,0,0,,心を砕いて見せた
Dialogue: 0,0:02:35.57,0:02:38.82,OPEDJP,,0,0,0,,ねえ愛したいこれは真実？
Dialogue: 0,0:02:38.82,0:02:42.45,OPEDJP,,0,0,0,,ただ愛されたいのは不誠実？
Dialogue: 0,0:02:42.45,0:02:44.75,OPEDJP,,0,0,0,,もうどうすればいい
Dialogue: 0,0:02:44.75,0:02:47.50,OPEDJP,,0,0,0,,どうすればいいのか
Dialogue: 0,0:02:47.50,0:02:49.62,OPEDJP,,0,0,0,,って分からないよ
Dialogue: 0,0:02:49.62,0:02:53.32,OPEDJP,,0,0,0,,その頭の中が分かんない
Dialogue: 0,0:02:53.32,0:02:56.87,OPEDJP,,0,0,0,,でも愛想は良いとかずるいよ
Dialogue: 0,0:02:56.87,0:03:02.00,OPEDJP,,0,0,0,,こうやってまた君のペースに飲まれてく
Dialogue: 0,0:03:04.12,0:03:09.20,OPEDJP,,0,0,0,,そうやってまたほら振り回されてる
Dialogue: 0,0:03:15.00,0:03:19.75,OPEDJP,,0,0,0,,そうやってまたほら振り回されてる
Dialogue: 0,0:01:50.45,0:01:53.87,OPEDCN,,0,0,0,,吶 我想愛你 這是真的嗎?
Dialogue: 0,0:01:53.87,0:01:57.37,OPEDCN,,0,0,0,,只想被愛就不算誠實嗎?
Dialogue: 0,0:01:57.37,0:01:59.58,OPEDCN,,0,0,0,,到底該怎麼辦?
Dialogue: 0,0:01:59.58,0:02:02.25,OPEDCN,,0,0,0,,怎麼辦才好呢?
Dialogue: 0,0:02:05.58,0:02:08.37,OPEDCN,,0,0,0,,今天的城市依舊
Dialogue: 0,0:02:08.37,0:02:12.04,OPEDCN,,0,0,0,,令人神魂顛倒 興奮不已
Dialogue: 0,0:02:12.04,0:02:15.54,OPEDCN,,0,0,0,,臨時演員只是回家了
Dialogue: 0,0:02:15.54,0:02:19.04,OPEDCN,,0,0,0,,絕對不是在彆扭啦
Dialogue: 0,0:02:19.04,0:02:22.79,OPEDCN,,0,0,0,,彷彿劃破這樣的日子一般
Dialogue: 0,0:02:22.79,0:02:26.29,OPEDCN,,0,0,0,,突然出現的你
Dialogue: 0,0:02:26.29,0:02:29.79,OPEDCN,,0,0,0,,帶著令人陶醉的笑容
Dialogue: 0,0:02:29.79,0:02:34.62,OPEDCN,,0,0,0,,讓我明白了心碎的滋味
Dialogue: 0,0:02:35.57,0:02:38.82,OPEDCN,,0,0,0,,吶 我想愛你 這是真的嗎?
Dialogue: 0,0:02:38.82,0:02:42.45,OPEDCN,,0,0,0,,只想被愛就不算誠實嗎?
Dialogue: 0,0:02:42.45,0:02:44.75,OPEDCN,,0,0,0,,到底該怎麼辦?
Dialogue: 0,0:02:44.75,0:02:47.50,OPEDCN,,0,0,0,,怎麼辦才好呢?
Dialogue: 0,0:02:47.50,0:02:49.62,OPEDCN,,0,0,0,,不知道了啦
Dialogue: 0,0:02:49.62,0:02:53.32,OPEDCN,,0,0,0,,我不知道你在想什麼
Dialogue: 0,0:02:53.32,0:02:56.87,OPEDCN,,0,0,0,,你卻如此惹人憐愛 真不公平
Dialogue: 0,0:02:56.87,0:03:02.00,OPEDCN,,0,0,0,,就這樣 我又被你拉走節奏了
Dialogue: 0,0:03:04.12,0:03:09.20,OPEDCN,,0,0,0,,於是你看 我又被任意擺布
Dialogue: 0,0:03:15.00,0:03:19.75,OPEDCN,,0,0,0,,於是你看 我又被任意擺布
Dialogue: 0,0:03:21.25,0:03:24.37,Default,,0,0,0,,托兒所…
Dialogue: 0,0:03:24.37,0:03:26.45,Default,,0,0,0,,什麼是"托兒所"
Dialogue: 0,0:03:26.45,0:03:29.25,Default,,0,0,0,,是個有漂亮姊姊溫柔招待
Dialogue: 0,0:03:29.25,0:03:33.29,Default,,0,0,0,,還有鯛魚和比目魚跳舞的好玩地方
Dialogue: 0,0:03:33.29,0:03:35.37,Default,,0,0,0,,是喔 是這樣嗎?
Dialogue: 0,0:03:36.20,0:03:37.82,Default,,0,0,0,,我想去
Dialogue: 0,0:03:38.00,0:03:40.20,Default,,0,0,0,,鯛魚 比目魚
Dialogue: 0,0:03:40.20,0:03:41.87,Default,,0,0,0,,鮪魚沙拉
Dialogue: 0,0:03:41.87,0:03:44.00,Default,,0,0,0,,原來我們附近就有耶
Dialogue: 0,0:03:44.00,0:03:47.00,Default,,0,0,0,,托兒所或幼稚園等各種設施
Dialogue: 0,0:03:47.00,0:03:49.66,Default,,0,0,0,,托兒所?幼稚園?
Dialogue: 0,0:03:49.66,0:03:51.50,Default,,0,0,0,,名稱不同而已吧
Dialogue: 0,0:03:51.50,0:03:53.32,Default,,0,0,0,,就像鮪魚和青魽魚?
Dialogue: 0,0:03:53.32,0:03:55.75,Default,,0,0,0,,是鰤魚和青魽魚吧
Dialogue: 0,0:03:57.04,0:03:58.91,Default,,0,0,0,,既然有這麼方便的地方
Dialogue: 0,0:03:58.91,0:04:01.45,Default,,0,0,0,,我們多少能輕鬆一點呢
Dialogue: 0,0:04:01.91,0:04:03.83,Default,,0,0,0,,我來聯絡看看吧
Dialogue: 0,0:04:05.08,0:04:06.83,Default,,0,0,0,,啊?不能收?
Dialogue: 0,0:04:06.83,0:04:07.87,Default,,0,0,0,,為什麼?
Dialogue: 0,0:04:08.16,0:04:10.33,Default,,0,0,0,,已經額滿了?為什麼?
Dialogue: 0,0:04:10.79,0:04:12.95,Default,,0,0,0,,要我們去區公所?
Dialogue: 0,0:04:12.95,0:04:14.41,Default,,0,0,0,,為什麼?
Dialogue: 0,0:04:15.04,0:04:16.50,Default,,0,0,0,,什麼意思啊
Dialogue: 0,0:04:16.50,0:04:20.62,Default,,0,0,0,,想上托兒所為何還得先去區公所?
Dialogue: 0,0:04:21.04,0:04:23.79,Default,,0,0,0,,那麼 該拿那傢伙怎麼辦?
Dialogue: 0,0:04:26.41,0:04:29.04,Default,,0,0,0,,我要去托兒所
Dialogue: 0,0:04:29.41,0:04:34.45,Default,,0,0,0,,#04 順其自然
Dialogue: 0,0:04:37.62,0:04:39.79,Default,,0,0,0,,托兒所好大間啊
Dialogue: 0,0:04:39.79,0:04:41.58,Default,,0,0,0,,這裡是區公所
Dialogue: 0,0:04:42.15,0:04:44.40,Default,,0,0,0,,真麻煩啊
Dialogue: 0,0:04:46.29,0:04:48.75,Default,,0,0,0,,請問 我想申請托兒所…
Dialogue: 0,0:04:49.04,0:04:50.62,Default,,0,0,0,,托兒所相關諮詢
Dialogue: 0,0:04:50.62,0:04:54.20,Default,,0,0,0,,由四樓負責托育的課受理
Dialogue: 0,0:04:54.62,0:04:55.54,Default,,0,0,0,,好的
Dialogue: 0,0:05:05.08,0:05:06.16,Default,,0,0,0,,午安
Dialogue: 0,0:05:06.45,0:05:08.87,Default,,0,0,0,,請取號碼牌稍等一下
Dialogue: 0,0:05:09.66,0:05:10.70,Default,,0,0,0,,（受理號碼）
Dialogue: 0,0:05:13.71,0:05:16.21,Default,,0,0,0,,（請持以下號碼的人至窗口）
Dialogue: 0,0:05:27.22,0:05:29.10,Default,,0,0,0,,（請持以下號碼的人至窗口）
Dialogue: 0,0:05:30.79,0:05:31.95,Default,,0,0,0,,要上托兒所
Dialogue: 0,0:05:31.95,0:05:33.62,Default,,0,0,0,,首先您需提出申請
Dialogue: 0,0:05:33.62,0:05:35.54,Default,,0,0,0,,交由我們審查文件
Dialogue: 0,0:05:35.87,0:05:38.20,Default,,0,0,0,,但若孩子滿四歲 正好有幾處空缺
Dialogue: 0,0:05:38.20,0:05:39.54,Default,,0,0,0,,書面審查通過後
Dialogue: 0,0:05:39.54,0:05:41.79,Default,,0,0,0,,立刻就能上托兒所
Dialogue: 0,0:05:41.79,0:05:44.70,Default,,0,0,0,,那麼 這個信封裡放了一式申請書
Dialogue: 0,0:05:44.70,0:05:46.90,Default,,0,0,0,,另外還要提供家長的工作證明
Dialogue: 0,0:05:46.90,0:05:48.50,Default,,0,0,0,,最好是提供有公司用印
Dialogue: 0,0:05:48.50,0:05:50.62,Default,,0,0,0,,詳述您工作內容的文件
Dialogue: 0,0:05:50.62,0:05:52.54,Default,,0,0,0,,自營業則需納稅申報等文件
Dialogue: 0,0:05:52.54,0:05:55.15,Default,,0,0,0,,兩者檢附資料不同 有點繁瑣…
Dialogue: 0,0:05:57.12,0:05:59.65,Default,,0,0,0,,申請文件有夠麻煩
Dialogue: 0,0:05:59.65,0:06:00.62,Default,,0,0,0,,做黑的
Dialogue: 0,0:06:00.62,0:06:04.41,Default,,0,0,0,,哪可能填家庭狀況和就業證明欄啦
Dialogue: 0,0:06:04.62,0:06:06.37,Default,,0,0,0,,不能走後門入學嗎?
Dialogue: 0,0:06:06.37,0:06:07.91,Default,,0,0,0,,我哪知道啊
Dialogue: 0,0:06:08.12,0:06:10.25,Default,,0,0,0,,不行
Dialogue: 0,0:06:15.08,0:06:17.79,Default,,0,0,0,,爸爸好壞 都騙人
Dialogue: 0,0:06:17.79,0:06:20.91,Default,,0,0,0,,明明說要讓我上托兒所的
Dialogue: 0,0:06:20.91,0:06:23.79,Default,,0,0,0,,你真的很愛把女生弄哭耶
Dialogue: 0,0:06:25.04,0:06:26.66,Default,,0,0,0,,知道了啦
Dialogue: 0,0:06:26.91,0:06:29.87,Default,,0,0,0,,我來偽造個文書什麼的總行吧
Dialogue: 0,0:06:29.87,0:06:31.66,Default,,0,0,0,,"偽造"是什麼意思?
Dialogue: 0,0:06:31.66,0:06:33.79,Default,,0,0,0,,做假文件的意思
Dialogue: 0,0:06:33.79,0:06:36.04,Default,,0,0,0,,我來駭入區公所的資料庫
Dialogue: 0,0:06:36.04,0:06:37.75,Default,,0,0,0,,修改戶口名簿好了
Dialogue: 0,0:06:37.75,0:06:39.87,Default,,0,0,0,,避免被查起來會有麻煩
Dialogue: 0,0:06:40.12,0:06:42.12,Default,,0,0,0,,做黑的也派上用場了呢
Dialogue: 0,0:06:42.12,0:06:43.54,Default,,0,0,0,,做黑的?
Dialogue: 0,0:06:43.54,0:06:44.90,Default,,0,0,0,,小孩子不需要知道
Dialogue: 0,0:06:45.12,0:06:48.08,Default,,0,0,0,,一騎爸爸說會送你去念托兒所
Dialogue: 0,0:06:48.83,0:06:50.62,Default,,0,0,0,,太好了
Dialogue: 0,0:07:00.19,0:07:04.20,UP,,0,0,0,,（托育申請書）
Dialogue: 0,0:07:03.83,0:07:06.08,Default,,0,0,0,,總之 在結果出來之前
Dialogue: 0,0:07:04.20,0:07:12.37,UP,,0,0,0,,托兒所…
Dialogue: 0,0:07:06.08,0:07:09.45,Default,,0,0,0,,承辦人建議我們先去參觀
Dialogue: 0,0:07:09.45,0:07:12.37,Default,,0,0,0,,現在去看看附近的托兒所吧
Dialogue: 0,0:07:12.37,0:07:13.79,UP,,0,0,0,,我要去
Dialogue: 0,0:07:14.16,0:07:16.16,Default,,0,0,0,,總覺得有點緊張
Dialogue: 0,0:07:16.91,0:07:18.50,Default,,0,0,0,,你也要一起來
Dialogue: 0,0:07:18.50,0:07:19.79,Default,,0,0,0,,我不要
Dialogue: 0,0:07:19.79,0:07:20.83,Default,,0,0,0,,我們是搭檔吧?
Dialogue: 0,0:07:20.83,0:07:21.62,Default,,0,0,0,,來陪我吧
Dialogue: 0,0:07:21.62,0:07:23.30,Default,,0,0,0,,我不要
Dialogue: 0,0:07:23.30,0:07:25.30,Default,,0,0,0,,（夢星托兒所）
Dialogue: 0,0:07:31.75,0:07:34.95,Default,,0,0,0,,這裡是兩位第一間參觀的啊
Dialogue: 0,0:07:34.95,0:07:37.15,Default,,0,0,0,,孩子有兩位父親?
Dialogue: 0,0:07:37.15,0:07:38.33,Default,,0,0,0,,什麼?
Dialogue: 0,0:07:38.58,0:07:40.12,Default,,0,0,0,,呃 不…
Dialogue: 0,0:07:40.50,0:07:42.00,Default,,0,0,0,,這樣說也對啦
Dialogue: 0,0:07:42.20,0:07:44.37,Default,,0,0,0,,他們都是美俐的爸爸喔
Dialogue: 0,0:07:44.37,0:07:45.33,Default,,0,0,0,,什麼?
Dialogue: 0,0:07:45.33,0:07:48.54,Default,,0,0,0,,一騎爸爸很會做菜
Dialogue: 0,0:07:48.54,0:07:50.83,Default,,0,0,0,,還為了美俐"偽造"東西
Dialogue: 0,0:07:50.83,0:07:53.15,Default,,0,0,0,,把我送進托兒所
Dialogue: 0,0:07:53.15,0:07:54.54,Default,,0,0,0,,是不是啊 爸爸?
Dialogue: 0,0:07:54.54,0:07:56.25,Default,,0,0,0,,對 對啊
Dialogue: 0,0:07:56.90,0:07:58.37,Default,,0,0,0,,零爸爸呢
Dialogue: 0,0:07:58.37,0:08:01.45,Default,,0,0,0,,他很擅長砰砰地開槍
Dialogue: 0,0:08:01.45,0:08:02.62,Default,,0,0,0,,開槍?
Dialogue: 0,0:08:02.62,0:08:04.66,Default,,0,0,0,,遊戲啦 她說的是遊戲
Dialogue: 0,0:08:04.66,0:08:06.50,Default,,0,0,0,,喔 是玩具槍啊
Dialogue: 0,0:08:06.50,0:08:08.00,Default,,0,0,0,,才不是
Dialogue: 0,0:08:08.00,0:08:10.79,Default,,0,0,0,,爸爸他們說過是真槍
Dialogue: 0,0:08:10.79,0:08:13.41,Default,,0,0,0,,爸爸他們雖然有做壞事
Dialogue: 0,0:08:13.41,0:08:16.20,Default,,0,0,0,,但他們說小孩子不需要知道
Dialogue: 0,0:08:16.20,0:08:18.33,Default,,0,0,0,,是不是啊 爸爸?
Dialogue: 0,0:08:18.54,0:08:20.37,Default,,0,0,0,,抱歉 打擾了
Dialogue: 0,0:08:21.70,0:08:24.00,Default,,0,0,0,,美俐 你別講不該說的
Dialogue: 0,0:08:24.00,0:08:26.41,Default,,0,0,0,,對方覺得我們超可疑
Dialogue: 0,0:08:26.75,0:08:28.33,Default,,0,0,0,,看來那間已經沒希望了
Dialogue: 0,0:08:28.33,0:08:29.75,Default,,0,0,0,,討厭啦
Dialogue: 0,0:08:29.75,0:08:30.75,Default,,0,0,0,,聽好
Dialogue: 0,0:08:30.75,0:08:32.87,Default,,0,0,0,,下次別人問你話時
Dialogue: 0,0:08:32.87,0:08:36.40,Default,,0,0,0,,你就回說"就像爸爸說的那樣"
Dialogue: 0,0:08:36.40,0:08:37.65,Default,,0,0,0,,知道了
Dialogue: 0,0:08:37.65,0:08:39.37,Default,,0,0,0,,我會乖乖聽話
Dialogue: 0,0:08:39.90,0:08:41.45,Default,,0,0,0,,你真的有聽懂嗎?
Dialogue: 0,0:08:43.59,0:08:46.34,Default,,0,0,0,,（藍天托兒所）
Dialogue: 0,0:08:49.29,0:08:50.08,Default,,0,0,0,,聽好了
Dialogue: 0,0:08:50.08,0:08:52.58,Default,,0,0,0,,要照練習的回答講喔
Dialogue: 0,0:08:52.58,0:08:54.08,Default,,0,0,0,,美俐會加油的
Dialogue: 0,0:08:54.08,0:08:56.12,Default,,0,0,0,,總算拿到資格能上幼兒園
Dialogue: 0,0:08:56.12,0:08:58.25,Default,,0,0,0,,我們一定要通過面試
Dialogue: 0,0:08:58.25,0:08:59.83,Default,,0,0,0,,好
Dialogue: 0,0:09:05.20,0:09:06.50,Default,,0,0,0,,那麼
Dialogue: 0,0:09:06.50,0:09:09.58,Default,,0,0,0,,可以請教一下姓名和年齡嗎?
Dialogue: 0,0:09:09.58,0:09:10.70,Default,,0,0,0,,我叫海坂美俐
Dialogue: 0,0:09:10.70,0:09:12.20,Default,,0,0,0,,今年四歲
Dialogue: 0,0:09:12.50,0:09:13.45,Default,,0,0,0,,我叫來栖一騎
Dialogue: 0,0:09:13.45,0:09:14.79,Default,,0,0,0,,今年28歲
Dialogue: 0,0:09:14.79,0:09:17.25,Default,,0,0,0,,爸爸可以不用回答
Dialogue: 0,0:09:19.00,0:09:22.45,Default,,0,0,0,,孩子有兩位爸爸…是嗎?
Dialogue: 0,0:09:22.45,0:09:24.41,Default,,0,0,0,,因為有一些原因
Dialogue: 0,0:09:24.41,0:09:26.37,Default,,0,0,0,,就像爸爸說的那樣
Dialogue: 0,0:09:26.58,0:09:28.04,Default,,0,0,0,,這樣啊
Dialogue: 0,0:09:28.58,0:09:31.41,Default,,0,0,0,,三位的姓氏不同呢
Dialogue: 0,0:09:31.41,0:09:33.12,Default,,0,0,0,,因為有一些原因
Dialogue: 0,0:09:33.12,0:09:35.08,Default,,0,0,0,,就像爸爸說的那樣
Dialogue: 0,0:09:35.08,0:09:36.79,Default,,0,0,0,,這樣啊
Dialogue: 0,0:09:37.87,0:09:39.08,Default,,0,0,0,,美俐
Dialogue: 0,0:09:39.91,0:09:43.00,Default,,0,0,0,,有兩個爸爸真令人開心呢
Dialogue: 0,0:09:44.87,0:09:45.91,Default,,0,0,0,,對啊
Dialogue: 0,0:09:45.91,0:09:48.37,Default,,0,0,0,,一騎爸爸和零爸爸啊
Dialogue: 0,0:09:48.37,0:09:50.04,Default,,0,0,0,,他們一直都在一起
Dialogue: 0,0:09:50.04,0:09:51.41,Default,,0,0,0,,感情超好的
Dialogue: 0,0:09:51.41,0:09:53.54,Default,,0,0,0,,爸爸們讓你很驕傲對吧
Dialogue: 0,0:09:53.79,0:09:54.66,Default,,0,0,0,,老師
Dialogue: 0,0:09:54.66,0:09:58.16,Default,,0,0,0,,爸爸他們沒有做壞壞的工作
Dialogue: 0,0:09:58.16,0:09:58.95,Default,,0,0,0,,什麼?
Dialogue: 0,0:09:58.95,0:10:00.37,Default,,0,0,0,,是真的喔
Dialogue: 0,0:10:00.37,0:10:01.91,Default,,0,0,0,,壞壞的工作?
Dialogue: 0,0:10:01.91,0:10:05.50,Default,,0,0,0,,不…不是的 我們的工作很普通
Dialogue: 0,0:10:05.50,0:10:08.41,Default,,0,0,0,,算是城裡的清道夫…應該吧
Dialogue: 0,0:10:08.41,0:10:10.16,Default,,0,0,0,,工作很忙碌嗎?
Dialogue: 0,0:10:10.16,0:10:12.66,Default,,0,0,0,,是啊 托大家的福
Dialogue: 0,0:10:12.66,0:10:15.12,Default,,0,0,0,,現在有開張 但沒營業
Dialogue: 0,0:10:15.12,0:10:16.25,Default,,0,0,0,,閉嘴
Dialogue: 0,0:10:16.25,0:10:18.75,Default,,0,0,0,,身兼工作還要顧小孩
Dialogue: 0,0:10:18.75,0:10:21.08,Default,,0,0,0,,一定很辛苦吧
Dialogue: 0,0:10:21.29,0:10:23.58,Default,,0,0,0,,我們會提供協助
Dialogue: 0,0:10:23.58,0:10:25.62,Default,,0,0,0,,有什麼要求請儘管說
Dialogue: 0,0:10:25.62,0:10:27.70,Default,,0,0,0,,咦?也就是說…
Dialogue: 0,0:10:28.04,0:10:31.87,Default,,0,0,0,,隨時歡迎來我們托兒所喔
Dialogue: 0,0:10:32.08,0:10:34.75,Default,,0,0,0,,還請多多指教囉 美俐
Dialogue: 0,0:10:35.83,0:10:36.87,Default,,0,0,0,,嗯
Dialogue: 0,0:10:38.62,0:10:40.66,Default,,0,0,0,,太好了
Dialogue: 0,0:10:41.95,0:10:43.62,Default,,0,0,0,,乾杯
Dialogue: 0,0:10:47.00,0:10:48.79,Default,,0,0,0,,終於塵埃落定
Dialogue: 0,0:10:49.00,0:10:50.16,Default,,0,0,0,,進行得很順利
Dialogue: 0,0:10:50.16,0:10:51.95,Default,,0,0,0,,公所那邊已經連絡過
Dialogue: 0,0:10:51.95,0:10:54.50,Default,,0,0,0,,托兒所註冊手續也辦完了
Dialogue: 0,0:10:54.50,0:10:58.25,Default,,0,0,0,,他們說接下來只要\N照著這個準備就行了
Dialogue: 0,0:10:59.00,0:11:03.27,UP,,0,0,0,,（托兒所生活須知）
Dialogue: 0,0:11:01.62,0:11:03.66,Default,,0,0,0,,要帶的東西也太多了吧?
Dialogue: 0,0:11:03.66,0:11:06.70,Default,,0,0,0,,用餐圍裙 帽子 更換的衣服
Dialogue: 0,0:11:06.70,0:11:08.79,Default,,0,0,0,,室內鞋 擦手巾
Dialogue: 0,0:11:08.79,0:11:10.41,Default,,0,0,0,,午睡寢具
Dialogue: 0,0:11:10.41,0:11:12.41,Default,,0,0,0,,杯子 牙刷…
Dialogue: 0,0:11:12.41,0:11:14.25,Default,,0,0,0,,訓練褲?
Dialogue: 0,0:11:14.25,0:11:15.75,Default,,0,0,0,,可能要做重訓吧
Dialogue: 0,0:11:15.75,0:11:17.41,Default,,0,0,0,,"罩衫"又是什麼?
Dialogue: 0,0:11:17.41,0:11:18.95,Default,,0,0,0,,是某種點心嗎?
Dialogue: 0,0:11:18.95,0:11:21.37,Default,,0,0,0,,難度也太高了吧
Dialogue: 0,0:11:22.16,0:11:24.66,Default,,0,0,0,,算了 反正去百貨公司
Dialogue: 0,0:11:24.66,0:11:26.08,Default,,0,0,0,,大致都能買齊吧
Dialogue: 0,0:11:32.87,0:11:34.83,Default,,0,0,0,,這是什麼?
Dialogue: 0,0:11:35.08,0:11:38.41,Default,,0,0,0,,加入集體生活 一開始最重要
Dialogue: 0,0:11:38.41,0:11:41.08,Default,,0,0,0,,可不能被其他人給看扁了
Dialogue: 0,0:11:41.33,0:11:42.45,Default,,0,0,0,,是這樣嗎?
Dialogue: 0,0:11:43.00,0:11:45.87,Default,,0,0,0,,身為大少爺的你不懂啦
Dialogue: 0,0:11:45.87,0:11:49.83,Default,,0,0,0,,平民百姓會依物品和服裝將人排名
Dialogue: 0,0:11:49.83,0:11:52.66,Default,,0,0,0,,這方面我可是苦過來的
Dialogue: 0,0:11:54.66,0:11:58.41,Default,,0,0,0,,這種時候穿上名牌亮麗登場
Dialogue: 0,0:11:58.41,0:12:00.16,Default,,0,0,0,,絕對不會錯
Dialogue: 0,0:12:01.20,0:12:02.20,Default,,0,0,0,,我們也要嗎?
Dialogue: 0,0:12:02.20,0:12:03.33,Default,,0,0,0,,當然
Dialogue: 0,0:12:03.33,0:12:05.04,Default,,0,0,0,,他們會連父母的衣著
Dialogue: 0,0:12:05.04,0:12:07.08,Default,,0,0,0,,也會仔細審視呢
Dialogue: 0,0:12:09.70,0:12:10.83,Default,,0,0,0,,好了
Dialogue: 0,0:12:10.83,0:12:13.08,Default,,0,0,0,,這樣就都準備好了
Dialogue: 0,0:12:13.08,0:12:14.87,Default,,0,0,0,,能去幼兒園了?
Dialogue: 0,0:12:14.87,0:12:17.08,Default,,0,0,0,,是啊 明天就可以去了
Dialogue: 0,0:12:17.08,0:12:18.54,Default,,0,0,0,,太好了
Dialogue: 0,0:12:18.54,0:12:21.37,Default,,0,0,0,,謝謝你 一騎爸爸
Dialogue: 0,0:12:21.83,0:12:25.91,Default,,0,0,0,,上面寫說"自備用品請全數寫名字"
Dialogue: 0,0:12:25.91,0:12:27.54,Default,,0,0,0,,什麼?全部?
Dialogue: 0,0:12:27.48,0:12:29.73,UP,,0,0,0,,（自備用品請全部標上姓名）
Dialogue: 0,0:12:27.96,0:12:28.92,Default,,0,0,0,,上面寫的
Dialogue: 0,0:12:31.50,0:12:33.37,Default,,0,0,0,,全部都要…
Dialogue: 0,0:12:36.79,0:12:39.12,Default,,0,0,0,,"被套上須繡姓名"
Dialogue: 0,0:12:39.12,0:12:40.33,Default,,0,0,0,,要怎麼繡?
Dialogue: 0,0:12:40.33,0:12:41.33,Default,,0,0,0,,用針線?
Dialogue: 0,0:12:41.33,0:12:42.58,Default,,0,0,0,,哪有那種東西啊?
Dialogue: 0,0:12:42.58,0:12:44.25,Default,,0,0,0,,"毛巾上須附掛繩"
Dialogue: 0,0:12:44.25,0:12:45.95,Default,,0,0,0,,什麼掛繩啊 這又是哪招
Dialogue: 0,0:12:45.95,0:12:47.25,Default,,0,0,0,,莫名其妙耶
Dialogue: 0,0:12:47.25,0:12:49.08,Default,,0,0,0,,誰要準備啊
Dialogue: 0,0:12:49.08,0:12:52.12,Default,,0,0,0,,你不是說不準備好會被看扁嗎?
Dialogue: 0,0:12:52.83,0:12:53.91,Default,,0,0,0,,這樣可以嗎?
Dialogue: 0,0:12:55.62,0:12:57.37,Default,,0,0,0,,我去買縫紉用具
Dialogue: 0,0:12:58.33,0:12:59.50,Default,,0,0,0,,慢走
Dialogue: 0,0:12:59.80,0:13:02.22,Default,,0,0,0,,（海坂美俐）
Dialogue: 0,0:13:02.62,0:13:04.58,Default,,0,0,0,,美俐也要用
Dialogue: 0,0:13:05.75,0:13:06.87,Default,,0,0,0,,那就…
Dialogue: 0,0:13:08.00,0:13:10.37,Default,,0,0,0,,這給你 隨便寫寫吧
Dialogue: 0,0:13:11.45,0:13:12.41,Default,,0,0,0,,好
Dialogue: 0,0:13:13.62,0:13:15.50,Default,,0,0,0,,我買回來囉
Dialogue: 0,0:13:15.66,0:13:17.95,Default,,0,0,0,,爸爸 歡迎回來
Dialogue: 0,0:13:18.33,0:13:21.04,Default,,0,0,0,,美俐把名字寫好了
Dialogue: 0,0:13:24.70,0:13:26.58,Default,,0,0,0,,等等…你…
Dialogue: 0,0:13:26.58,0:13:28.91,Default,,0,0,0,,你知道這件要多少錢嗎?
Dialogue: 0,0:13:28.91,0:13:30.16,Default,,0,0,0,,我問你?
Dialogue: 0,0:13:31.04,0:13:34.00,Default,,0,0,0,,糟糕 不快弄就沒時間了
Dialogue: 0,0:13:35.41,0:13:36.33,Default,,0,0,0,,好痛
Dialogue: 0,0:13:36.79,0:13:38.54,Default,,0,0,0,,可惡
Dialogue: 0,0:13:38.83,0:13:40.54,Default,,0,0,0,,OK繃…
Dialogue: 0,0:13:41.41,0:13:42.58,Default,,0,0,0,,喂 零
Dialogue: 0,0:13:42.58,0:13:44.00,Default,,0,0,0,,你睡個頭啦
Dialogue: 0,0:13:44.00,0:13:46.25,Default,,0,0,0,,現在到底該怎麼辦啦
Dialogue: 0,0:13:47.41,0:13:50.70,Default,,0,0,0,,趕不及了啦
Dialogue: 0,0:13:59.00,0:14:01.08,Default,,0,0,0,,總算是趕上了
Dialogue: 0,0:14:01.79,0:14:03.33,Default,,0,0,0,,今天是第一天
Dialogue: 0,0:14:03.33,0:14:04.87,Default,,0,0,0,,要提起勁上囉
Dialogue: 0,0:14:04.87,0:14:06.16,Default,,0,0,0,,提起勁
Dialogue: 0,0:14:06.41,0:14:08.33,Default,,0,0,0,,孩子挑食好令人困擾
Dialogue: 0,0:14:08.33,0:14:11.04,Default,,0,0,0,,只好在漢堡排裡加入大量青椒
Dialogue: 0,0:14:13.33,0:14:15.04,Default,,0,0,0,,早安
Dialogue: 0,0:14:15.25,0:14:16.91,Default,,0,0,0,,早安
Dialogue: 0,0:14:16.91,0:14:18.45,Default,,0,0,0,,今後麻煩老師照顧了
Dialogue: 0,0:14:18.45,0:14:21.45,Default,,0,0,0,,杏奈老師 這些人是…
Dialogue: 0,0:14:21.75,0:14:24.04,Default,,0,0,0,,他們是今天開始讀長頸鹿班的
Dialogue: 0,0:14:24.04,0:14:27.12,Default,,0,0,0,,海坂美俐和她的爸爸們
Dialogue: 0,0:14:27.33,0:14:28.25,Default,,0,0,0,,帥氣
Dialogue: 0,0:14:31.08,0:14:32.12,Default,,0,0,0,,（出現兩位型男爸爸?）
Dialogue: 0,0:14:32.12,0:14:33.04,Default,,0,0,0,,（聽說是長頸鹿班的）
Dialogue: 0,0:14:33.04,0:14:33.83,Default,,0,0,0,,（天啊 真令人好奇）
Dialogue: 0,0:14:33.83,0:14:34.62,Default,,0,0,0,,（那身衣服一定很貴）
Dialogue: 0,0:14:34.62,0:14:35.33,Default,,0,0,0,,（是有錢人嗎?）
Dialogue: 0,0:14:35.33,0:14:37.95,Default,,0,0,0,,兩位爸爸真帥氣呢
Dialogue: 0,0:14:37.95,0:14:40.12,Default,,0,0,0,,感覺好像黑手黨
Dialogue: 0,0:14:40.12,0:14:42.16,Default,,0,0,0,,不 我們是殺手
Dialogue: 0,0:14:42.41,0:14:42.95,Default,,0,0,0,,（殺手?）　（聽說是殺手）
Dialogue: 0,0:14:42.95,0:14:43.70,Default,,0,0,0,,（真想被殺♡）
Dialogue: 0,0:14:43.70,0:14:44.41,Default,,0,0,0,,（順便殺了我老公吧）
Dialogue: 0,0:14:44.41,0:14:45.16,Default,,0,0,0,,（還有我老公）
Dialogue: 0,0:14:45.70,0:14:48.83,Default,,0,0,0,,美俐的衣服也很漂亮呢
Dialogue: 0,0:14:50.75,0:14:53.62,Default,,0,0,0,,那麼 我帶你們去教室
Dialogue: 0,0:14:53.62,0:14:55.16,Default,,0,0,0,,這邊請
Dialogue: 0,0:14:56.45,0:14:58.16,Default,,0,0,0,,首先 早上來托兒所後
Dialogue: 0,0:14:58.16,0:15:01.50,Default,,0,0,0,,請用卡嗶一下 記錄有來上學
Dialogue: 0,0:15:01.79,0:15:04.91,Default,,0,0,0,,接著將換掉的衣服放這裡
Dialogue: 0,0:15:04.91,0:15:06.62,Default,,0,0,0,,毛巾掛在這裡
Dialogue: 0,0:15:06.91,0:15:10.12,Default,,0,0,0,,刷牙的杯子放在這裡
Dialogue: 0,0:15:10.41,0:15:12.04,Default,,0,0,0,,根本記不住
Dialogue: 0,0:15:12.33,0:15:16.79,Default,,0,0,0,,也請每天在聯絡簿\N寫上體溫和日記喔
Dialogue: 0,0:15:17.08,0:15:18.41,Default,,0,0,0,,寫好了
Dialogue: 0,0:15:18.70,0:15:20.29,Default,,0,0,0,,謝謝
Dialogue: 0,0:15:22.33,0:15:26.58,UP,,0,0,0,,{\an7\fs55\pos(20,10)}2月6號\N今天開始上托兒所\N昨天熬夜將物品都標上名字\N快累死了\N今天想好好睡一覺
Dialogue: 0,0:15:26.58,0:15:28.87,Default,,0,0,0,,這是爸爸的日記吧?
Dialogue: 0,0:15:28.87,0:15:29.70,Default,,0,0,0,,什麼?
Dialogue: 0,0:15:29.70,0:15:30.75,Default,,0,0,0,,沒關係的
Dialogue: 0,0:15:30.75,0:15:34.04,Default,,0,0,0,,一般是要寫孩子的狀況
Dialogue: 0,0:15:34.04,0:15:39.16,Default,,0,0,0,,但偶爾也有媽媽寫下自己的煩惱啦
Dialogue: 0,0:15:39.75,0:15:41.54,Default,,0,0,0,,你寫了自己的日記?
Dialogue: 0,0:15:41.54,0:15:42.54,Default,,0,0,0,,閉嘴
Dialogue: 0,0:15:42.83,0:15:44.45,Default,,0,0,0,,請問老師
Dialogue: 0,0:15:44.45,0:15:46.00,Default,,0,0,0,,便當要放在哪裡呢?
Dialogue: 0,0:15:46.00,0:15:47.00,Default,,0,0,0,,什麼 好厲害…
Dialogue: 0,0:15:47.00,0:15:49.37,Default,,0,0,0,,是爸爸做給我的
Dialogue: 0,0:15:49.37,0:15:51.70,Default,,0,0,0,,哎呀 這沒什麼啦
Dialogue: 0,0:15:51.70,0:15:53.95,Default,,0,0,0,,做料理是我唯一的專長
Dialogue: 0,0:15:53.95,0:15:57.25,Default,,0,0,0,,不好意思 托兒所是吃營養午餐喔
Dialogue: 0,0:15:58.50,0:16:00.29,Default,,0,0,0,,對不起 美俐
Dialogue: 0,0:16:00.29,0:16:03.33,Default,,0,0,0,,便當要請爸爸拿回去喔
Dialogue: 0,0:16:03.33,0:16:04.62,Default,,0,0,0,,是喔?
Dialogue: 0,0:16:04.62,0:16:06.37,Default,,0,0,0,,虧我整晚熬夜
Dialogue: 0,0:16:06.37,0:16:08.16,Default,,0,0,0,,你明明就睡著了
Dialogue: 0,0:16:08.41,0:16:10.58,Default,,0,0,0,,那麼就請多關照了
Dialogue: 0,0:16:10.58,0:16:13.16,Default,,0,0,0,,好的 我們會照顧她的
Dialogue: 0,0:16:13.16,0:16:16.70,Default,,0,0,0,,爸爸們再見
Dialogue: 0,0:16:18.04,0:16:19.54,Default,,0,0,0,,任務完成
Dialogue: 0,0:16:19.54,0:16:22.20,Default,,0,0,0,,我們久違地找個地方放鬆一下吧
Dialogue: 0,0:16:22.20,0:16:25.37,Default,,0,0,0,,捧個場嘛 零
Dialogue: 0,0:16:25.37,0:16:26.79,Default,,0,0,0,,我想回家玩遊戲…
Dialogue: 0,0:16:35.75,0:16:38.37,Default,,0,0,0,,讓我加入你們
Dialogue: 0,0:16:40.95,0:16:42.00,Default,,0,0,0,,不行
Dialogue: 0,0:16:47.70,0:16:50.37,Default,,0,0,0,,讓我加入你們
Dialogue: 0,0:16:51.45,0:16:53.12,Default,,0,0,0,,會弄髒喔
Dialogue: 0,0:16:53.37,0:16:55.37,Default,,0,0,0,,我們走吧 陽葵
Dialogue: 0,0:17:06.11,0:17:07.32,Default,,0,0,0,,真香
Dialogue: 0,0:17:07.32,0:17:09.95,Default,,0,0,0,,好久沒這麼悠閒了呢
Dialogue: 0,0:17:09.95,0:17:12.66,Default,,0,0,0,,在這偷懶不工作 還真好命呢
Dialogue: 0,0:17:12.66,0:17:13.54,Default,,0,0,0,,不是啦
Dialogue: 0,0:17:13.54,0:17:16.29,Default,,0,0,0,,阿久 接下來我們會好好工作的
Dialogue: 0,0:17:16.29,0:17:18.25,Default,,0,0,0,,拜託再派點案子來嘛
Dialogue: 0,0:17:18.25,0:17:20.04,Default,,0,0,0,,我會考慮
Dialogue: 0,0:17:21.66,0:17:23.45,Default,,0,0,0,,糟糕 該去接她了
Dialogue: 0,0:17:23.45,0:17:25.04,Default,,0,0,0,,再見囉 阿久
Dialogue: 0,0:17:32.08,0:17:33.62,Default,,0,0,0,,爸爸
Dialogue: 0,0:17:33.95,0:17:35.66,Default,,0,0,0,,第一天過得怎麼樣?
Dialogue: 0,0:17:35.66,0:17:37.41,Default,,0,0,0,,開心嗎?
Dialogue: 0,0:17:39.41,0:17:41.70,Default,,0,0,0,,目前還不是很確定
Dialogue: 0,0:17:47.20,0:17:48.37,Default,,0,0,0,,爸爸
Dialogue: 0,0:17:48.66,0:17:50.33,Default,,0,0,0,,今天過得怎麼樣呢?
Dialogue: 0,0:17:51.91,0:17:55.20,Default,,0,0,0,,總覺得跟想像的不一樣
Dialogue: 0,0:17:57.58,0:17:58.70,Default,,0,0,0,,今天呢?
Dialogue: 0,0:17:58.70,0:18:00.45,Default,,0,0,0,,好無聊
Dialogue: 0,0:18:00.75,0:18:01.91,Default,,0,0,0,,美俐…
Dialogue: 0,0:18:14.08,0:18:15.37,Default,,0,0,0,,你好
Dialogue: 0,0:18:17.16,0:18:18.25,Default,,0,0,0,,是老師啊
Dialogue: 0,0:18:18.58,0:18:20.45,Default,,0,0,0,,請問怎麼了嗎?
Dialogue: 0,0:18:21.25,0:18:24.75,Default,,0,0,0,,美俐在托兒所過得怎麼樣呢?
Dialogue: 0,0:18:24.75,0:18:25.95,Default,,0,0,0,,那個…
Dialogue: 0,0:18:26.12,0:18:30.37,Default,,0,0,0,,其實我有在聯絡簿上稍微提到
Dialogue: 0,0:18:30.62,0:18:33.20,Default,,0,0,0,,關於美俐的衣服…
Dialogue: 0,0:18:33.20,0:18:35.95,Default,,0,0,0,,糟糕 我完全沒看
Dialogue: 0,0:18:35.95,0:18:37.58,Default,,0,0,0,,她的衣著
Dialogue: 0,0:18:37.91,0:18:40.95,Default,,0,0,0,,跟大家不一樣 太過顯眼
Dialogue: 0,0:18:40.95,0:18:43.95,Default,,0,0,0,,似乎讓人覺得她很難親近
Dialogue: 0,0:18:47.95,0:18:51.41,Default,,0,0,0,,她有更居家一點的衣服嗎?
Dialogue: 0,0:18:51.41,0:18:53.75,Default,,0,0,0,,就算弄髒也沒關係的衣服
Dialogue: 0,0:18:54.08,0:18:58.50,Default,,0,0,0,,這樣啊 不知道哪裡有賣這種衣服
Dialogue: 0,0:18:59.12,0:19:00.75,Default,,0,0,0,,交給我吧
Dialogue: 0,0:19:02.08,0:19:03.87,Default,,0,0,0,,（虹鱒屋）
Dialogue: 0,0:19:04.25,0:19:05.33,Default,,0,0,0,,這是什麼地方?
Dialogue: 0,0:19:05.33,0:19:07.91,Default,,0,0,0,,聽說是媽媽們愛去的店
Dialogue: 0,0:19:07.91,0:19:09.12,Default,,0,0,0,,這裡嗎?
Dialogue: 0,0:19:09.12,0:19:10.91,Default,,0,0,0,,要買東西了
Dialogue: 0,0:19:15.25,0:19:17.41,Default,,0,0,0,,密密麻麻排到天花板
Dialogue: 0,0:19:17.41,0:19:19.37,Default,,0,0,0,,而且還超便宜
Dialogue: 0,0:19:20.41,0:19:22.33,Default,,0,0,0,,玩具超多的
Dialogue: 0,0:19:22.58,0:19:24.04,Default,,0,0,0,,這裡是樂園嗎?
Dialogue: 0,0:19:24.04,0:19:26.37,Default,,0,0,0,,居然有賣附掛繩的毛巾?
Dialogue: 0,0:19:26.37,0:19:29.00,Default,,0,0,0,,要是早點知道就好了
Dialogue: 0,0:19:29.00,0:19:30.62,Default,,0,0,0,,而且每樣東西都是
Dialogue: 0,0:19:30.62,0:19:32.50,Default,,0,0,0,,398圓
Dialogue: 0,0:19:32.50,0:19:34.29,Default,,0,0,0,,超可愛的
Dialogue: 0,0:19:37.12,0:19:39.45,Default,,0,0,0,,這間店真是棒透了
Dialogue: 0,0:19:39.45,0:19:40.66,Default,,0,0,0,,我要加入會員
Dialogue: 0,0:19:41.37,0:19:44.00,Default,,0,0,0,,我還想買這些
Dialogue: 0,0:19:44.00,0:19:46.45,Default,,0,0,0,,好啊 買吧…
Dialogue: 0,0:19:46.45,0:19:50.37,Default,,0,0,0,,全部買下來也比一套名牌衣服便宜
Dialogue: 0,0:19:50.37,0:19:52.66,Default,,0,0,0,,謝謝爸爸
Dialogue: 0,0:19:54.16,0:19:56.16,Default,,0,0,0,,是大家可以一起騎的車
Dialogue: 0,0:19:56.16,0:19:57.33,Default,,0,0,0,,這不是媽媽腳踏車
Dialogue: 0,0:19:57.33,0:19:58.87,Default,,0,0,0,,而是爸爸腳踏車呢
Dialogue: 0,0:20:02.70,0:20:05.25,Default,,0,0,0,,今天買得好爽
Dialogue: 0,0:20:05.45,0:20:06.45,Default,,0,0,0,,但都要寫名…
Dialogue: 0,0:20:06.45,0:20:07.83,Default,,0,0,0,,別說了
Dialogue: 0,0:20:07.83,0:20:10.58,Default,,0,0,0,,爸爸 我明天可以穿這件衣服嗎?
Dialogue: 0,0:20:10.58,0:20:12.20,Default,,0,0,0,,喔?好啊
Dialogue: 0,0:20:12.20,0:20:13.50,Default,,0,0,0,,儘管弄髒
Dialogue: 0,0:20:13.50,0:20:15.37,Default,,0,0,0,,全身弄滿泥巴回來吧
Dialogue: 0,0:20:16.79,0:20:17.95,Default,,0,0,0,,好
Dialogue: 0,0:20:24.16,0:20:26.04,Default,,0,0,0,,早安
Dialogue: 0,0:20:26.45,0:20:27.66,Default,,0,0,0,,美俐
Dialogue: 0,0:20:27.95,0:20:29.75,Default,,0,0,0,,衣服好可愛
Dialogue: 0,0:20:29.75,0:20:31.04,Default,,0,0,0,,很適合你呢
Dialogue: 0,0:20:39.91,0:20:41.04,Default,,0,0,0,,你那邊可以嗎?
Dialogue: 0,0:20:41.04,0:20:45.25,Default,,0,0,0,,嗯 是不是蓋大一點比較好?
Dialogue: 0,0:20:45.83,0:20:47.33,Default,,0,0,0,,要用這個嗎?
Dialogue: 0,0:20:47.33,0:20:48.75,Default,,0,0,0,,謝謝
Dialogue: 0,0:20:54.00,0:20:55.66,Default,,0,0,0,,美俐 傳球
Dialogue: 0,0:20:55.87,0:20:56.79,Default,,0,0,0,,好
Dialogue: 0,0:21:04.75,0:21:06.45,Default,,0,0,0,,是怎麼辦到的?
Dialogue: 0,0:21:07.54,0:21:09.41,Default,,0,0,0,,美俐的爸爸好厲害啊
Dialogue: 0,0:21:09.41,0:21:10.91,Default,,0,0,0,,真帥氣
Dialogue: 0,0:21:10.91,0:21:11.83,Default,,0,0,0,,對啊
Dialogue: 0,0:21:12.45,0:21:13.33,Default,,0,0,0,,接球
Dialogue: 0,0:21:16.95,0:21:18.66,Default,,0,0,0,,球在那邊
Dialogue: 0,0:21:19.25,0:21:21.16,Default,,0,0,0,,美俐 球要過去喔
Dialogue: 0,0:21:25.45,0:21:26.70,Default,,0,0,0,,我也想踢
Dialogue: 0,0:21:26.70,0:21:28.04,Default,,0,0,0,,也讓我加入吧
Dialogue: 0,0:21:28.04,0:21:28.83,Default,,0,0,0,,好啊
Dialogue: 0,0:21:28.83,0:21:30.41,Default,,0,0,0,,大家一起來踢
Dialogue: 0,0:21:35.75,0:21:37.45,Default,,0,0,0,,爸爸
Dialogue: 0,0:21:44.33,0:21:46.41,Default,,0,0,0,,球在那邊喔
Dialogue: 0,0:21:46.66,0:21:48.20,Default,,0,0,0,,傳過來
Dialogue: 0,0:21:50.62,0:21:51.66,Default,,0,0,0,,美俐
Dialogue: 0,0:21:51.66,0:21:53.37,Default,,0,0,0,,爸爸來接你囉
Dialogue: 0,0:21:53.66,0:21:55.50,Default,,0,0,0,,美俐再見
Dialogue: 0,0:21:55.50,0:21:59.29,Default,,0,0,0,,陽葵 小鳥 再見
Dialogue: 0,0:21:59.95,0:22:02.29,Default,,0,0,0,,在托兒所過得怎麼樣啊?
Dialogue: 0,0:22:02.29,0:22:05.37,Default,,0,0,0,,超級開心的
Dialogue: 0,0:22:09.04,0:22:16.41,OPEDJP,,0,0,0,,変わらない光景予想外の 毎日だけど
Dialogue: 0,0:22:16.41,0:22:18.54,OPEDJP,,0,0,0,,それがいいって
Dialogue: 0,0:22:18.54,0:22:23.58,OPEDJP,,0,0,0,,振り回されたり空回って
Dialogue: 0,0:22:23.58,0:22:28.50,OPEDJP,,0,0,0,,目まぐるしく愛おしい日を
Dialogue: 0,0:22:28.50,0:22:30.79,OPEDJP,,0,0,0,,眠れない夜にそっと
Dialogue: 0,0:22:30.79,0:22:32.79,OPEDJP,,0,0,0,,口ずさむ
Dialogue: 0,0:22:32.79,0:22:37.95,OPEDJP,,0,0,0,,子守唄や呼吸に合わせた手
Dialogue: 0,0:22:37.95,0:22:40.45,OPEDJP,,0,0,0,,ただただ一日でも
Dialogue: 0,0:22:40.45,0:22:42.29,OPEDJP,,0,0,0,,この日々が
Dialogue: 0,0:22:42.29,0:22:47.79,OPEDJP,,0,0,0,,長く長く長く長く続くように
Dialogue: 0,0:22:47.79,0:22:52.66,OPEDJP,,0,0,0,,裸足で駆ける君を追った
Dialogue: 0,0:22:52.66,0:22:57.04,OPEDJP,,0,0,0,,いつか僕を超えて Ah
Dialogue: 0,0:22:57.04,0:23:01.75,OPEDJP,,0,0,0,,明日はどんな一日だろうな
Dialogue: 0,0:23:01.75,0:23:06.50,OPEDJP,,0,0,0,,僕ら一緒に歩いてこうか
Dialogue: 0,0:23:06.50,0:23:11.79,OPEDJP,,0,0,0,,いつもここに帰る場所があって
Dialogue: 0,0:23:11.79,0:23:16.12,OPEDJP,,0,0,0,,悲しみも照らすように
Dialogue: 0,0:23:16.12,0:23:18.45,OPEDJP,,0,0,0,,それでもいいか
Dialogue: 0,0:23:18.45,0:23:20.87,OPEDJP,,0,0,0,,それもありかな
Dialogue: 0,0:23:20.87,0:23:25.87,OPEDJP,,0,0,0,,僕らの愛を分かち合おうか
Dialogue: 0,0:23:25.87,0:23:31.12,OPEDJP,,0,0,0,,予想出来ない未来には希望を
Dialogue: 0,0:23:31.12,0:23:35.95,OPEDJP,,0,0,0,,いつまでも照らして
Dialogue: 0,0:22:09.04,0:22:16.41,OPEDCN,,0,0,0,,不變的風景 每天都出乎意料
Dialogue: 0,0:22:16.41,0:22:18.54,OPEDCN,,0,0,0,,但這樣也不錯
Dialogue: 0,0:22:18.54,0:22:23.58,OPEDCN,,0,0,0,,被折騰一番 白忙一場
Dialogue: 0,0:22:23.58,0:22:28.50,OPEDCN,,0,0,0,,過著眼花撩亂 令人疼惜的一天
Dialogue: 0,0:22:28.50,0:22:30.79,OPEDCN,,0,0,0,,在睡不著的夜裡
Dialogue: 0,0:22:30.79,0:22:32.79,OPEDCN,,0,0,0,,輕輕哼唱著
Dialogue: 0,0:22:32.79,0:22:37.95,OPEDCN,,0,0,0,,手配合著搖籃曲和呼吸拍著
Dialogue: 0,0:22:37.95,0:22:40.45,OPEDCN,,0,0,0,,就算只有一天也好
Dialogue: 0,0:22:40.45,0:22:42.29,OPEDCN,,0,0,0,,希望這樣的日子
Dialogue: 0,0:22:42.29,0:22:47.79,OPEDCN,,0,0,0,,能夠持續長長久久
Dialogue: 0,0:22:47.79,0:22:52.66,OPEDCN,,0,0,0,,追逐著赤腳奔跑的你
Dialogue: 0,0:22:52.66,0:22:57.04,OPEDCN,,0,0,0,,總有一天會超越我 Ah
Dialogue: 0,0:22:57.04,0:23:01.75,OPEDCN,,0,0,0,,明天會是怎樣的一天呢?
Dialogue: 0,0:23:01.75,0:23:06.50,OPEDCN,,0,0,0,,我們會一起走下去嗎?
Dialogue: 0,0:23:06.50,0:23:11.79,OPEDCN,,0,0,0,,在這裡永遠有我的歸處
Dialogue: 0,0:23:11.79,0:23:16.12,OPEDCN,,0,0,0,,希望連同悲傷都照亮
Dialogue: 0,0:23:16.12,0:23:18.45,OPEDCN,,0,0,0,,即便如此也可以嗎?
Dialogue: 0,0:23:18.45,0:23:20.87,OPEDCN,,0,0,0,,這樣可能嗎?
Dialogue: 0,0:23:20.87,0:23:25.87,OPEDCN,,0,0,0,,應該分享我們的愛嗎?
Dialogue: 0,0:23:25.87,0:23:31.12,OPEDCN,,0,0,0,,願在不可預知的未來裡
Dialogue: 0,0:23:31.12,0:23:35.95,OPEDCN,,0,0,0,,永遠閃耀著希望
Dialogue: 0,0:23:39.54,0:23:42.54,Default,,0,0,0,,好了 這是送給你的禮物
Dialogue: 0,0:23:47.50,0:23:50.20,Default,,0,0,0,,接下來這裡就是你的房間了
Dialogue: 0,0:23:53.91,0:23:55.91,Default,,0,0,0,,謝謝爸爸

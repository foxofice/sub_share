Dialogue: 0,0:19:34.69,0:19:36.14,Sign,,0,0,0,,{\an7\fn@DFWaWaW5-A\frz270\fs108\blur3\shad0\bord\c&H974A43&\3c&HF4BE9C&\pos(1868,80)}咿咿咿咿咿
Comment: 0,0:00:00.00,0:00:00.00,Main,,0,0,0,,----------- MAIN -----------
Dialogue: 0,0:00:07.78,0:00:08.62,Main,Neema,0,0,0,,鏘！
Dialogue: 0,0:00:09.24,0:00:10.20,Main,Neema,0,0,0,,鏘！
Dialogue: 0,0:00:10.44,0:00:12.16,Main,Neema,0,0,0,,鏘—！
Dialogue: 0,0:00:16.87,0:00:19.58,Main,Neema,0,0,0,,所有東西都帶上了！
Dialogue: 0,0:00:23.46,0:00:25.32,Main,Mayor,0,0,0,,路上小心
Dialogue: 0,0:00:25.32,0:00:27.49,Main,Dayland,0,0,0,,好的 謝謝您的關心
Dialogue: 0,0:00:27.91,0:00:31.95,Main,Neema,0,0,0,,生日時收到的保護項鍊和配劍…
Dialogue: 0,0:00:31.95,0:00:35.92,Main,Neema,0,0,0,,沒想到這麼快就會派上用場！
Dialogue: 0,0:00:34.49,0:00:36.67,Main,Neema,0,0,0,,{\an8}放進兔子包包裡吧
Dialogue: 0,0:00:39.65,0:00:40.83,Main,Nox,0,0,0,,吱！
Dialogue: 0,0:00:41.92,0:00:42.77,Main,Nox,0,0,0,,吱
Dialogue: 0,0:00:42.77,0:00:43.92,Main,Neema,0,0,0,,諾克斯！
Dialogue: 0,0:00:43.92,0:00:45.01,Main,Nox,0,0,0,,吱
Dialogue: 0,0:00:46.15,0:00:48.53,Main,Neema,0,0,0,,今天就拜託妳偵查了
Dialogue: 0,0:00:48.53,0:00:49.10,Main,Nox,0,0,0,,吱
Dialogue: 0,0:00:49.59,0:00:52.08,Main,Dayland,0,0,0,,我們不知道什麼時候會遇到魔物
Dialogue: 0,0:00:52.42,0:00:54.60,Main,Dayland,0,0,0,,請保持警戒
Dialogue: 0,0:00:54.60,0:00:55.52,Main,All,0,0,0,,- 是！\N- 是！
Dialogue: 0,0:00:55.52,0:00:58.76,Main,Neema,0,0,0,,接著 進軍那片森林吧！
Dialogue: 0,0:00:58.76,0:01:00.32,Main,Nox,0,0,0,,吱！
Dialogue: 0,0:02:36.96,0:02:39.42,Main,Guide,0,0,0,,看見魔物的地方就在這前面了
Dialogue: 0,0:02:39.67,0:02:43.71,Main,Guide,0,0,0,,我在這個地區狩獵數十年
Dialogue: 0,0:02:43.71,0:02:46.39,Main,Guide,0,0,0,,但我從來沒有遇過這種狀況
Dialogue: 0,0:02:46.79,0:02:48.75,Main,Neema,0,0,0,,還是第一次遇到這件事…
Dialogue: 0,0:02:48.75,0:02:50.34,Main,Neema,0,0,0,,這座森林也很大呢
Dialogue: 0,0:02:50.74,0:02:53.32,Main,Neema,0,0,0,,牠在上面幫我們看著 但…
Dialogue: 0,0:02:56.54,0:02:58.95,Main,Dayland,0,0,0,,那麼 我們在這裡休息一下吧
Dialogue: 0,0:02:58.95,0:03:02.13,Main,Guide,0,0,0,,村長有給我們一些便當
Dialogue: 0,0:03:02.13,0:03:04.23,Main,Neema,0,0,0,,好餓喔—！
Dialogue: 0,0:03:05.52,0:03:06.87,Main,Cadence,0,0,0,,請退後！
Dialogue: 0,0:03:21.40,0:03:23.01,Main,Alteran,0,0,0,,只是兔子喔！
Dialogue: 0,0:03:29.37,0:03:32.09,Main,Neema,0,0,0,,兔… 兔子？！ 那團毛球？
Dialogue: 0,0:03:32.39,0:03:33.78,Main,Alteran,0,0,0,,小姐…
Dialogue: 0,0:03:33.78,0:03:35.06,Main,Neema,0,0,0,,還好嗎？
Dialogue: 0,0:03:35.52,0:03:37.70,Main,Neema,0,0,0,,然而牠現在一動也不動
Dialogue: 0,0:03:37.70,0:03:39.01,Main,Neema,0,0,0,,到底發生什麼事？
Dialogue: 0,0:03:39.48,0:03:40.31,Main,Neema,0,0,0,,嗚哇！
Dialogue: 0,0:03:41.18,0:03:44.91,Main,Neema,0,0,0,,牠… 牠跑走了！ 就在我的面前？！
Dialogue: 0,0:03:45.57,0:03:48.21,Main,Cadence,0,0,0,,小姐 我們還是離開吧
Dialogue: 0,0:03:48.21,0:03:49.36,Main,Neema,0,0,0,,嘿欸？
Dialogue: 0,0:03:49.36,0:03:52.87,Main,Cadence,0,0,0,,血腥味會引來兇惡的魔物
Dialogue: 0,0:03:54.59,0:03:57.50,Main,Neema,0,0,0,,兔子… 原來是受傷了
Dialogue: 0,0:03:58.20,0:04:01.30,Main,Alteran,0,0,0,,我們來這裡不是為了討伐魔物
Dialogue: 0,0:04:01.30,0:04:03.74,Main,Alteran,0,0,0,,所以要盡可能避開牠們
Dialogue: 0,0:04:04.60,0:04:05.65,Main,Cadence,0,0,0,,小姐！
Dialogue: 0,0:04:05.94,0:04:06.63,Main,Dayland,0,0,0,,奈瑪！
Dialogue: 0,0:04:07.00,0:04:09.75,Main,Neema,0,0,0,,非常抱歉 我知道我不該這樣…
Dialogue: 0,0:04:09.75,0:04:13.07,Main,Neema,0,0,0,,但如果那個小生物受傷了就不能放任不管
Dialogue: 0,0:04:15.53,0:04:17.57,Main,Neema,0,0,0,,去哪裡了呢…？
Dialogue: 0,0:04:21.92,0:04:23.03,Main,Neema,0,0,0,,在這裡！
Dialogue: 0,0:04:23.74,0:04:24.90,Main,Neema,0,0,0,,快過來 快過來
Dialogue: 0,0:04:35.24,0:04:38.46,Main,Neema,0,0,0,,什麼什麼？ 也太聽話了吧！
Dialogue: 0,0:04:38.46,0:04:40.39,Main,Neema,0,0,0,,好可愛喔！
Dialogue: 0,0:04:40.39,0:04:41.90,Main,Neema,0,0,0,,啊 對了
Dialogue: 0,0:04:41.90,0:04:45.23,Main,Neema,0,0,0,,牠剛才是因為有騎士們才逃走的
Dialogue: 0,0:04:46.03,0:04:48.55,Main,Neema,0,0,0,,抱歉嚇到你了
Dialogue: 0,0:04:49.93,0:04:52.96,Main,Neema,0,0,0,,看來毛茸之力還在
Comment: 0,0:04:49.93,0:04:52.96,Comment,Neema,0,0,0,,{\an5\pos(880,920)\fsp-15}もふなで
Dialogue: 0,0:04:52.96,0:04:54.53,Main,Neema,0,0,0,,太好了
Dialogue: 0,0:04:54.79,0:04:57.95,Main,Neema,0,0,0,,那麼 我們回去治療傷口吧
Dialogue: 0,0:04:58.82,0:05:00.90,Main,Neema,0,0,0,,父親和其他人…
Dialogue: 0,0:05:02.56,0:05:05.02,Main,Neema,0,0,0,,什… 什麼？！
Dialogue: 0,0:05:09.23,0:05:11.03,Main,Alteran,0,0,0,,這… 這是…
Dialogue: 0,0:05:13.44,0:05:14.92,Main,Neema,0,0,0,,疼…
Dialogue: 0,0:05:21.38,0:05:23.83,Main,Neema,0,0,0,,有什麼東西在…?
Dialogue: 0,0:05:26.15,0:05:28.26,Main,Neema,0,0,0,,而且數量超級多！
Dialogue: 0,0:05:31.82,0:05:33.14,Main,Neema,0,0,0,,哥布林？！
Dialogue: 0,0:05:34.56,0:05:36.79,Main,Neema,0,0,0,,這種狀況實在是…
Dialogue: 0,0:05:37.42,0:05:39.69,Main,Neema,0,0,0,,大危機！！！
Dialogue: 0,0:05:42.36,0:05:44.32,Main,Neema,0,0,0,,不要把這小傢伙吃掉！
Dialogue: 0,0:05:47.44,0:05:49.23,Main,Neema,0,0,0,,牠聽懂了？
Dialogue: 0,0:05:49.23,0:05:53.04,Main,Neema,0,0,0,,欸？ 怎麼突然看起來這麼難過？
Dialogue: 0,0:05:53.04,0:05:55.22,Main,Neema,0,0,0,,剛才不是還恐嚇我？
Dialogue: 0,0:05:57.49,0:05:59.39,Main,Neema,0,0,0,,為甚麼要綁架我？
Dialogue: 0,0:05:59.39,0:06:01.12,Main,Neema,0,0,0,,你們想對我做什麼？
Dialogue: 0,0:06:06.50,0:06:09.38,Main,Neema,0,0,0,,怎… 怎麼這麼可愛啊！
Dialogue: 0,0:06:09.81,0:06:11.51,Main,Neema,0,0,0,,不 不 牠們是魔物
Dialogue: 0,0:06:19.21,0:06:22.26,Main,Guide,0,0,0,,有複數哥布林足跡
Dialogue: 0,0:06:22.26,0:06:24.72,Main,Alteran,0,0,0,,大概就是牠們帶走了奈菲蒂瑪小姐
Dialogue: 0,0:06:25.02,0:06:27.70,Main,Cadence,0,0,0,,大概是個相當大的聚落呢
Dialogue: 0,0:06:28.14,0:06:29.52,Main,Dayland,0,0,0,,怎麼會有這樣的事？！
Dialogue: 0,0:06:29.52,0:06:31.91,Main,Dayland,0,0,0,,如果我有跟在旁邊的話…
Dialogue: 0,0:06:37.17,0:06:38.88,Main,Neema,0,0,0,,欸？ 這裡？
Dialogue: 0,0:06:44.21,0:06:45.25,Main,Neema,0,0,0,,人…
Dialogue: 0,0:06:46.25,0:06:48.09,Main,Neema,0,0,0,,人類！
Dialogue: 0,0:06:49.57,0:06:53.12,Main,Pino,0,0,0,,那個… 妳也被綁架了嗎？
Dialogue: 0,0:06:53.12,0:06:54.72,Main,Neema,0,0,0,,是的
Dialogue: 0,0:06:54.72,0:06:56.28,Main,Neema,0,0,0,,兩位也是嗎？
Dialogue: 0,0:06:56.28,0:06:57.89,Main,Nino,0,0,0,,看了還不知道嗎？
Dialogue: 0,0:06:57.89,0:06:59.93,Main,Nino,0,0,0,,所以才在這裡啊
Dialogue: 0,0:07:00.36,0:07:02.89,Main,Neema,0,0,0,,呃 她說的有道理
Dialogue: 0,0:07:03.32,0:07:06.86,Main,Neema,0,0,0,,性格比想像中的還糟糕
Dialogue: 0,0:07:07.11,0:07:09.83,Main,Neema,0,0,0,,我叫奈瑪 請多多指教
Dialogue: 0,0:07:10.09,0:07:13.79,Main,Pino,0,0,0,,我叫皮諾 這是我妹妹妮諾
Dialogue: 0,0:07:14.06,0:07:16.19,Main,Neema,0,0,0,,只有你們在這裡嗎？
Dialogue: 0,0:07:16.19,0:07:18.09,Main,Pino,0,0,0,,這個… 還有其他大人…
Dialogue: 0,0:07:18.09,0:07:19.00,Main,Neema,0,0,0,,大人？
Dialogue: 0,0:07:19.27,0:07:21.32,Main,Pino,0,0,0,,他們是一起被抓來的
Dialogue: 0,0:07:21.32,0:07:24.18,Main,Pino,0,0,0,,但他們被關在其他地方
Dialogue: 0,0:07:24.18,0:07:25.47,Main,Pino,0,0,0,,從此就再也沒見到了
Dialogue: 0,0:07:25.77,0:07:29.84,Main,Neema,0,0,0,,嗯… 如果只有我在的話事情就好辦了 但…
Dialogue: 0,0:07:29.84,0:07:33.88,Main,Neema,0,0,0,,那個 索珥 在密閉空間使用火魔法會不會有危險？
Dialogue: 0,0:07:33.88,0:07:35.48,Main,Neema,0,0,0,,還能呼吸嗎？
Dialogue: 0,0:07:35.95,0:07:37.43,Main,Sol,0,0,0,,怎麼會這麼問？
Dialogue: 0,0:07:37.78,0:07:41.82,Main,Neema,0,0,0,,我被哥布林綁架了 困在洞穴裡
Dialogue: 0,0:07:41.82,0:07:43.36,Main,Sol,0,0,0,,妳又打算—
Dialogue: 0,0:07:43.36,0:07:45.52,Main,Neema,0,0,0,,又不是故意的！
Dialogue: 0,0:07:45.52,0:07:49.08,Main,Neema,0,0,0,,而且我希望和其他人一起逃走
Dialogue: 0,0:07:49.08,0:07:53.41,Main,Neema,0,0,0,,不知道是否可以用你的魔法教訓一下哥布林
Dialogue: 0,0:07:56.05,0:07:58.98,Main,Sol,0,0,0,,如果引進風妳就能呼吸
Dialogue: 0,0:07:58.98,0:08:01.61,Main,Sol,0,0,0,,但吾不可能只攻擊哥布林
Dialogue: 0,0:08:01.61,0:08:04.33,Main,Sol,0,0,0,,除非妳能自己調節魔力…
Dialogue: 0,0:08:04.33,0:08:07.37,Main,Neema,0,0,0,,太困難了啦 我根本沒有魔力好嗎？
Dialogue: 0,0:08:07.37,0:08:08.09,Main,Pino,0,0,0,,奈瑪？
Dialogue: 0,0:08:08.09,0:08:09.79,Main,Neema,0,0,0,,啊 抱歉
Dialogue: 0,0:08:10.25,0:08:13.69,Main,Neema,0,0,0,,果然還是得等爸爸來救我們啊
Dialogue: 0,0:08:17.99,0:08:20.17,Main,Nino,0,0,0,,真的嗎？ 難以置信
Dialogue: 0,0:08:20.43,0:08:24.96,Main,Neema,0,0,0,,我…我也沒辦法！ 會餓就是會餓嘛！
Dialogue: 0,0:08:26.23,0:08:27.98,Main,Neema,0,0,0,,哎呀 哎呀 哎呀！
Dialogue: 0,0:08:27.98,0:08:30.29,Main,Nino,0,0,0,,你…你誤會了！ 這只是…
Dialogue: 0,0:08:31.26,0:08:32.75,Main,Neema,0,0,0,,我懂喔
Dialogue: 0,0:08:32.75,0:08:35.92,Main,Neema,0,0,0,,在深思熟慮時就會餓 對吧？
Dialogue: 0,0:08:35.92,0:08:39.35,Main,Nino,0,0,0,,是…是的！ 我在思考很多事情！
Dialogue: 0,0:08:39.35,0:08:40.26,Main,Neema,0,0,0,,好喔
Dialogue: 0,0:08:40.26,0:08:41.15,Main,Nino,0,0,0,,真的啦！
Dialogue: 0,0:08:41.15,0:08:41.92,Main,Neema,0,0,0,,好喔
Dialogue: 0,0:08:41.92,0:08:43.53,Main,Nino,0,0,0,,真的就是這樣！
Dialogue: 0,0:08:45.50,0:08:48.23,Main,Neema,0,0,0,,還沒吃便當…
Comment: 0,0:08:48.46,0:08:49.16,Main,Neema,0,0,0,,嗯？
Dialogue: 0,0:08:50.62,0:08:51.91,Main,Neema,0,0,0,,我們也許能出去
Dialogue: 0,0:08:52.63,0:08:55.05,Main,Neema,0,0,0,,我要去找一點食物
Dialogue: 0,0:08:55.05,0:08:55.62,Main,Nino,0,0,0,,什麼？
Dialogue: 0,0:08:55.62,0:08:56.63,Main,Neema,0,0,0,,這孩子就拜託了
Dialogue: 0,0:08:56.89,0:08:58.14,Main,Pino,0,0,0,,妳要自己去嗎？
Dialogue: 0,0:08:58.14,0:08:59.38,Main,Nino,0,0,0,,很危險的
Dialogue: 0,0:08:59.38,0:09:02.00,Main,Neema,0,0,0,,對 沒問題的 在這裡等我
Dialogue: 0,0:09:16.71,0:09:19.57,Main,Neema,0,0,0,,抱歉 抱歉！ 我也被嚇到了
Dialogue: 0,0:09:20.74,0:09:23.73,Main,Neema,0,0,0,,那個 我們餓了
Dialogue: 0,0:09:23.73,0:09:25.59,Main,Neema,0,0,0,,有沒有吃的呢？
Dialogue: 0,0:09:31.42,0:09:32.68,Main,Neema,0,0,0,,水果？
Dialogue: 0,0:09:32.68,0:09:34.48,Main,Neema,0,0,0,,我可以吃嗎？
Dialogue: 0,0:09:36.65,0:09:38.62,Main,Neema,0,0,0,,這是可以吃的嗎…
Dialogue: 0,0:09:41.18,0:09:44.52,Main,Neema,0,0,0,,好澀喔—！
Comment: 0,0:09:41.18,0:09:44.52,Main,Neema,0,0,0,,{\an7\pos(893,920)\bord0\p1}m -35 -2 l -35 2 l 35 2 l 35 -2
Comment: 1,0:09:41.18,0:09:44.52,Main,Neema,0,0,0,,{\an5\pos(893,920)}色
Comment: 2,0:09:41.18,0:09:44.52,Main,Neema,0,0,0,,{\an7\pos(893,920)\c&H0000FF&\bord0\shad0\p1}m -35 -2 l -35 2 l 35 2 l 35 -2
Dialogue: 0,0:09:44.52,0:09:47.48,Main,Neema,0,0,0,,這是什麼？舌頭都麻痺了！
Dialogue: 0,0:09:56.05,0:09:58.61,Main,Neema,0,0,0,,這次應該沒問題吧…
Dialogue: 0,0:10:02.89,0:10:05.13,Main,Neema,0,0,0,,好… 好甜！
Dialogue: 0,0:10:05.13,0:10:07.00,Main,Neema,0,0,0,,原來皮是不能吃的啊！
Dialogue: 0,0:10:07.31,0:10:08.65,Main,Neema,0,0,0,,好好吃
Dialogue: 0,0:10:08.65,0:10:11.55,Main,Neema,0,0,0,,這個皮諾和妮諾應該也能吃
Dialogue: 0,0:10:12.01,0:10:13.96,Main,Neema,0,0,0,,我可以多要一點嗎？
Dialogue: 0,0:10:15.67,0:10:17.80,Main,Neema,0,0,0,,這麼多？ 謝謝你！
Dialogue: 0,0:10:19.04,0:10:21.64,Main,Neema,0,0,0,,有沒有什麼去皮的方法呢？
Dialogue: 0,0:10:21.97,0:10:22.76,Main,Neema,0,0,0,,對了！
Dialogue: 0,0:10:22.76,0:10:24.63,Main,Neema,0,0,0,,鏘—！
Dialogue: 0,0:10:35.93,0:10:37.64,Main,Neema,0,0,0,,對 很好！
Dialogue: 0,0:10:38.16,0:10:40.87,Main,Neema,0,0,0,,這樣你們吃它就更方便了
Dialogue: 0,0:10:40.87,0:10:42.11,Main,Neema,0,0,0,,多剝一點吧
Dialogue: 0,0:10:43.08,0:10:45.07,Main,Neema,0,0,0,,然後 不知不覺…
Dialogue: 0,0:10:45.44,0:10:47.97,Main,Neema,0,0,0,,我們變成朋友了
Dialogue: 0,0:10:48.79,0:10:53.18,Main,Neema,0,0,0,,沒想到從神那裡得到的能力也對魔物有用
Dialogue: 0,0:10:53.74,0:10:55.81,Main,Neema,0,0,0,,但有點困擾呢
Dialogue: 0,0:10:55.81,0:10:59.52,Main,Neema,0,0,0,,我不想看到他們被消滅
Dialogue: 0,0:10:59.84,0:11:02.00,Main,Neema,0,0,0,,爸爸一定會來這邊
Dialogue: 0,0:11:02.00,0:11:04.93,Main,Neema,0,0,0,,而且我不覺得他會聽我的意見
Dialogue: 0,0:11:05.77,0:11:09.53,Main,Neema,0,0,0,,那個 為什麼你們會住在這裡？
Dialogue: 0,0:11:12.72,0:11:15.98,Main,Neema,0,0,0,,抱歉 我聽不懂你們在說什麼
Dialogue: 0,0:11:18.05,0:11:19.98,Main,Neema,0,0,0,,那邊似乎很吵雜
Dialogue: 0,0:11:19.98,0:11:21.99,Main,Neema,0,0,0,,爸爸來了嗎…
Dialogue: 0,0:11:28.92,0:11:32.88,Main,Neema,0,0,0,,好… 好大！ 牠是大哥布林嗎？
Dialogue: 0,0:11:33.77,0:11:36.72,Main,Hobgoblin,0,0,0,,為什麼人類的女孩跑出來了？
Dialogue: 0,0:11:36.72,0:11:38.17,Main,Neema,0,0,0,,牠… 牠會說話？！
Dialogue: 0,0:11:38.65,0:11:40.68,Main,Hobgoblin,0,0,0,,你又綁架了一個人？
Dialogue: 0,0:11:41.60,0:11:44.14,Main,Hobgoblin,0,0,0,,我要講幾次你們才會停止這種行為？
Dialogue: 0,0:11:44.14,0:11:45.59,Main,Neema,0,0,0,,等一下！
Dialogue: 0,0:11:45.91,0:11:47.75,Main,Neema,0,0,0,,我想問你一些問題！
Dialogue: 0,0:11:48.59,0:11:52.52,Main,Neema,0,0,0,,首先 你是這群哥布林的首領嗎？
Dialogue: 0,0:11:53.03,0:11:53.86,Main,Hobgoblin,0,0,0,,是
Dialogue: 0,0:11:53.86,0:11:56.22,Main,Neema,0,0,0,,喔 看來可以好好談談！
Dialogue: 0,0:11:56.46,0:12:00.43,Main,Neema,0,0,0,,再來 為什麼他們要綁架像我這樣的孩子？
Dialogue: 0,0:12:00.92,0:12:03.14,Main,Hobgoblin,0,0,0,,這是天性
Dialogue: 0,0:12:03.52,0:12:05.12,Main,Neema,0,0,0,,天性？
Dialogue: 0,0:12:05.46,0:12:08.31,Main,Hobgoblin,0,0,0,,比起說是綁架不如說是保護
Dialogue: 0,0:12:08.31,0:12:10.94,Main,Hobgoblin,0,0,0,,哥布林非常重視孩子
Dialogue: 0,0:12:10.94,0:12:13.09,Main,Hobgoblin,0,0,0,,那怕是人類的孩子
Dialogue: 0,0:12:13.41,0:12:18.41,Main,Neema,0,0,0,,是這樣啊 雖然我並沒有迷路或發生什麼事就是了
Dialogue: 0,0:12:18.41,0:12:20.55,Main,Neema,0,0,0,,那麼就是最後一個問題
Dialogue: 0,0:12:21.03,0:12:23.02,Main,Neema,0,0,0,,為什麼要襲擊人類？
Dialogue: 0,0:12:25.36,0:12:26.43,Main,Hobgoblin,0,0,0,,為了生存
Dialogue: 0,0:12:29.30,0:12:33.84,Main,Hobgoblin,0,0,0,,因為人類到哪都會追殺我們
Dialogue: 0,0:12:35.41,0:12:39.58,Main,Neema,0,0,0,,但我聽說這個森林以前沒有哥布林
Dialogue: 0,0:12:39.58,0:12:43.88,Main,Neema,0,0,0,,是有什麼不得不離開以前的巢穴的理由嗎？
Dialogue: 0,0:12:44.82,0:12:46.87,Main,Hobgoblin,0,0,0,,我們被追趕出森林…
Dialogue: 0,0:12:46.87,0:12:47.80,Main,Hobgoblin,0,0,0,,人類害的
Dialogue: 0,0:12:47.80,0:12:48.75,Main,Neema,0,0,0,,欸？
Dialogue: 0,0:12:49.20,0:12:54.59,Main,Hobgoblin,0,0,0,,不只哥布林有狗頭人 半獸人和食人魔也是
Dialogue: 0,0:12:54.59,0:12:56.70,Main,Neema,0,0,0,,但為什麼要到這麼遠的北方來？
Dialogue: 0,0:12:56.70,0:12:59.85,Main,Hobgoblin,0,0,0,,人類一直在追殺我們
Dialogue: 0,0:12:59.85,0:13:04.69,Main,Hobgoblin,0,0,0,,不願意戰鬥或不能忍受寒冷的物種一一死去
Dialogue: 0,0:13:04.69,0:13:07.38,Main,Hobgoblin,0,0,0,,我們因為軟弱而逃跑
Dialogue: 0,0:13:07.38,0:13:09.69,Main,Hobgoblin,0,0,0,,即便如此仍有很多同伴死去
Dialogue: 0,0:13:11.89,0:13:15.40,Main,Neema,0,0,0,,也就是說 都是人類的錯嗎？
Dialogue: 0,0:13:15.40,0:13:18.17,Main,Neema,0,0,0,,就請爸爸調查一下發生了什麼事吧
Dialogue: 0,0:13:19.17,0:13:21.62,Main,Neema,0,0,0,,但這些傢伙要怎麼辦？
Dialogue: 0,0:13:21.62,0:13:24.15,Main,Neema,0,0,0,,我不能就這樣丟下牠們不管…
Dialogue: 0,0:13:24.82,0:13:26.15,Main,Neema,0,0,0,,怎麼辦…
Dialogue: 0,0:13:27.07,0:13:29.36,Main,Neema,0,0,0,,你們想怎麼辦？
Dialogue: 0,0:13:29.36,0:13:31.75,Main,Neema,0,0,0,,報復人類嗎？
Dialogue: 0,0:13:35.74,0:13:38.62,Main,Hobgoblin,0,0,0,,我們只想要和以前一樣的生活
Dialogue: 0,0:13:38.62,0:13:41.43,Main,Hobgoblin,0,0,0,,狩獵動物和魔物和被狩獵…
Dialogue: 0,0:13:41.43,0:13:43.79,Main,Hobgoblin,0,0,0,,成為森林必要的種族之一
Dialogue: 0,0:13:44.33,0:13:47.61,Main,Neema,0,0,0,,森林必要的… 嗎？
Dialogue: 0,0:13:48.99,0:13:51.66,Main,Neema,0,0,0,,說的好像自己就是獵物
Dialogue: 0,0:13:51.66,0:13:55.55,Main,Neema,0,0,0,,但哥布林本來就不屬於這片森林
Dialogue: 0,0:13:55.55,0:13:58.76,Main,Neema,0,0,0,,所以如果牠們在這裡定居就會破壞生態系統
Dialogue: 0,0:13:59.64,0:14:02.68,Main,Neema,0,0,0,,如果讓牠們和其他流離失所的生物
Dialogue: 0,0:14:02.68,0:14:04.73,Main,Neema,0,0,0,,生活在同一個地方呢…
Dialogue: 0,0:14:05.13,0:14:07.20,Main,Neema,0,0,0,,那個 這樣如何呢？
Dialogue: 0,0:14:08.11,0:14:12.17,Main,Neema,0,0,0,,這樣 這樣 然後這樣…
Dialogue: 0,0:14:12.67,0:14:14.44,Main,Nino,0,0,0,,她出去很久了呢
Dialogue: 0,0:14:14.44,0:14:15.29,Main,Pino,0,0,0,,妳擔心她嗎？
Dialogue: 0,0:14:15.29,0:14:16.97,Main,Nino,0,0,0,,當… 當然沒有！
Dialogue: 0,0:14:18.67,0:14:21.08,Main,Hobgoblin,0,0,0,,嗯 很有趣的提議
Dialogue: 0,0:14:21.41,0:14:22.54,Main,Neema,0,0,0,,對吧？
Dialogue: 0,0:14:23.06,0:14:26.00,Main,Hobgoblin,0,0,0,,所以可以殺死人類吧？
Dialogue: 0,0:14:27.01,0:14:29.66,Main,Neema,0,0,0,,嗯 適者生存
Dialogue: 0,0:14:29.66,0:14:32.64,Main,Neema,0,0,0,,照這樣下去 我不能確保人類能夠生存
Dialogue: 0,0:14:32.64,0:14:34.99,Main,Neema,0,0,0,,但如果簽訂契約書的話應該沒問題
Dialogue: 0,0:14:35.86,0:14:37.85,Main,Hobgoblin,0,0,0,,這個提議不錯
Dialogue: 0,0:14:37.85,0:14:41.22,Main,Neema,0,0,0,,即便如此 你也得撐過今天
Dialogue: 0,0:14:41.22,0:14:41.94,Main,Hobgoblin,0,0,0,,今天？
Dialogue: 0,0:14:41.94,0:14:46.00,Main,Neema,0,0,0,,我父親可能會發動戰爭來找我
Dialogue: 0,0:14:46.00,0:14:48.91,Main,Neema,0,0,0,,如果他來到這裡 我不知道他會怎樣對待你們
Dialogue: 0,0:14:49.18,0:14:51.88,Main,Neema,0,0,0,,在找到住所前可能會先全滅！
Dialogue: 0,0:14:53.03,0:14:57.11,Main,Neema,0,0,0,,所以我們需要訂定一個讓他會聽我們的意見的作戰
Dialogue: 0,0:14:57.11,0:14:58.33,Main,Hobgoblin,0,0,0,,作戰？
Dialogue: 0,0:14:58.63,0:14:59.52,Main,Neema,0,0,0,,對
Dialogue: 0,0:15:03.05,0:15:05.75,Main,Pino,0,0,0,,不慢慢吃的話很不禮貌喔
Dialogue: 0,0:15:06.86,0:15:08.02,Main,Nino,0,0,0,,但是…
Dialogue: 0,0:15:08.02,0:15:11.21,Main,Neema,0,0,0,,還有很多 不用急也沒關係
Dialogue: 0,0:15:11.48,0:15:12.56,Main,Nino,0,0,0,,謝謝
Dialogue: 0,0:15:12.56,0:15:15.18,Main,Nino,0,0,0,,那麼 我們真的能夠離開這裡嗎？
Dialogue: 0,0:15:15.50,0:15:19.32,Main,Neema,0,0,0,,嗯 哥布林也說沒問題
Dialogue: 0,0:15:19.32,0:15:21.97,Main,Neema,0,0,0,,我父親應該就在附近
Dialogue: 0,0:15:21.97,0:15:24.52,Main,Neema,0,0,0,,逃出去以後他會照顧我們的
Dialogue: 0,0:15:24.91,0:15:28.06,Main,Pino,0,0,0,,太好了 可以回家了
Dialogue: 0,0:15:28.06,0:15:30.38,Main,Nino,0,0,0,,但我們為什麼要出去呢？
Dialogue: 0,0:15:30.38,0:15:32.98,Main,Nino,0,0,0,,如果救援快到了 我們不是該在這裡等嗎？
Dialogue: 0,0:15:33.45,0:15:37.74,Main,Neema,0,0,0,,現在你們理解哥布林做這些事情的原因了 對吧？
Dialogue: 0,0:15:37.74,0:15:38.44,Main,Pino,0,0,0,,嗯…
Dialogue: 0,0:15:38.71,0:15:40.91,Main,Neema,0,0,0,,我想救牠們
Dialogue: 0,0:15:43.17,0:15:45.57,Main,Neema,0,0,0,,但如果我父親生氣了
Dialogue: 0,0:15:45.57,0:15:47.85,Main,Neema,0,0,0,,他可不會聽哥布林們的意見
Dialogue: 0,0:15:48.16,0:15:50.80,Main,Nino,0,0,0,,不管怎樣沒人會聽魔物的意見的
Dialogue: 0,0:15:51.10,0:15:55.14,Main,Neema,0,0,0,,因此我想創造一種他們必須聽我們意見的情況
Dialogue: 0,0:15:55.14,0:15:58.13,Main,Neema,0,0,0,,所以我需要你們兩個的幫忙
Dialogue: 0,0:15:59.07,0:16:01.72,Main,Neema,0,0,0,,你們可以當誘餌嗎？
Dialogue: 0,0:16:02.75,0:16:04.19,Main,Pino,0,0,0,,誘餌？
Dialogue: 0,0:16:04.45,0:16:07.48,Main,Neema,0,0,0,,希望你們假裝被哥布林追趕
Dialogue: 0,0:16:07.48,0:16:12.47,Main,Neema,0,0,0,,然後那些被指派保護你們的人就會退出戰鬥
Dialogue: 0,0:16:12.47,0:16:16.65,Main,Neema,0,0,0,,人數比較少的話比較容易對話
Dialogue: 0,0:16:19.08,0:16:20.27,Main,Pino,0,0,0,,做不到
Dialogue: 0,0:16:20.27,0:16:20.92,Main,Neema,0,0,0,,欸？
Dialogue: 0,0:16:20.92,0:16:23.09,Main,Pino,0,0,0,,我不能讓妮諾暴露於危險之中
Dialogue: 0,0:16:24.76,0:16:26.45,Main,Neema,0,0,0,,我會施展保護魔法
Dialogue: 0,0:16:29.38,0:16:30.43,Main,Pino,0,0,0,,不行
Dialogue: 0,0:16:30.43,0:16:32.38,Main,Neema,0,0,0,,這是很強的魔法！
Dialogue: 0,0:16:32.70,0:16:34.27,Main,Pino,0,0,0,,那樣依然不行
Dialogue: 0,0:16:34.27,0:16:37.09,Main,Pino,0,0,0,,我不想讓她再經歷任何可怕的事情
Dialogue: 0,0:16:38.79,0:16:40.29,Main,Nino,0,0,0,,我去
Dialogue: 0,0:16:41.57,0:16:43.47,Main,Nino,0,0,0,,如果我們可以當誘餌
Dialogue: 0,0:16:43.47,0:16:45.28,Main,Nino,0,0,0,,奈瑪的作戰順利進行
Dialogue: 0,0:16:45.28,0:16:46.85,Main,Nino,0,0,0,,大家都能得救 對吧？
Dialogue: 0,0:16:47.27,0:16:48.16,Main,Neema,0,0,0,,對
Dialogue: 0,0:16:48.52,0:16:49.67,Main,Pino,0,0,0,,妮諾…
Dialogue: 0,0:16:51.21,0:16:55.19,Main,Nino,0,0,0,,奈瑪比我們都還小 但她這樣做是為了我們所有人
Dialogue: 0,0:16:56.20,0:16:57.16,Main,Nino,0,0,0,,以及呢…
Dialogue: 0,0:16:58.29,0:17:00.11,Main,Nino,0,0,0,,她說我們很安全的
Dialogue: 0,0:17:00.42,0:17:03.59,Main,Nino,0,0,0,,奈瑪不會騙我們的 所以沒問題的
Dialogue: 0,0:17:05.05,0:17:06.45,Main,Neema,0,0,0,,妮諾！
Dialogue: 0,0:17:06.45,0:17:10.42,Main,Nino,0,0,0,,等下 很噁心 不要黏我！
Dialogue: 0,0:17:12.79,0:17:15.84,Main,Pino,0,0,0,,我知道了 就跟妮諾說的一樣呢
Dialogue: 0,0:17:15.84,0:17:18.39,Main,Pino,0,0,0,,剛才很抱歉 我也會幫忙的 奈瑪
Dialogue: 0,0:17:18.39,0:17:20.84,Main,Neema,0,0,0,,謝謝兩位
Dialogue: 0,0:17:27.84,0:17:30.38,Main,Guide,0,0,0,,哥布林的巢穴就在前方
Dialogue: 0,0:17:30.38,0:17:31.57,Main,Alteran,0,0,0,,走吧？
Dialogue: 0,0:17:31.57,0:17:35.60,Main,Dayland,0,0,0,,嗯 但優先的是要保護奈菲蒂瑪
Dialogue: 0,0:17:35.60,0:17:36.32,Main,Alteran and Cadence,0,0,0,,是！
Dialogue: 0,0:17:36.32,0:17:38.40,Main,Nino,0,0,0,,不要啊—！
Dialogue: 0,0:17:38.40,0:17:40.28,Main,Nino,0,0,0,,不要啊—！
Dialogue: 0,0:17:41.03,0:17:42.15,Main,Atleran,0,0,0,,小孩？
Dialogue: 0,0:17:42.15,0:17:43.88,Main,Cadence,0,0,0,,不是奈菲蒂瑪小姐
Dialogue: 0,0:17:45.22,0:17:46.44,Main,Dayland,0,0,0,,難道…？
Dialogue: 0,0:17:47.07,0:17:48.00,Main,Dayland,0,0,0,,保護他們
Dialogue: 0,0:17:48.76,0:17:49.68,Main,Alteran,0,0,0,,但是…
Dialogue: 0,0:17:49.68,0:17:50.30,Main,Dayland,0,0,0,,沒關係
Dialogue: 0,0:17:50.76,0:17:53.07,Main,Neema,0,0,0,,嗯嗯 非常好
Dialogue: 0,0:17:53.07,0:17:56.25,Main,Neema,0,0,0,,爸爸不可能就這樣拋棄小孩！
Dialogue: 0,0:17:56.59,0:17:58.32,Main,Pino,0,0,0,,{\an8}妮諾 這邊！
Dialogue: 0,0:17:58.32,0:18:00.17,Main,Nino,0,0,0,,{\an8}不要啊—！
Dialogue: 0,0:17:59.20,0:18:01.02,Main,Neema,0,0,0,,索爾的魔法好厲害！
Dialogue: 0,0:18:01.02,0:18:03.23,Main,Neema,0,0,0,,他們的聲音真的聽得很清楚
Dialogue: 0,0:18:03.23,0:18:04.55,Main,Cadence,0,0,0,,兩位！ 過來這邊！
Dialogue: 0,0:18:08.99,0:18:10.77,Main,Neema,0,0,0,,好了 這樣就夠了
Dialogue: 0,0:18:10.77,0:18:12.36,Main,Neema,0,0,0,,各位可以回去巢穴了
Dialogue: 0,0:18:15.20,0:18:16.12,Main,Dayland,0,0,0,,追上去！
Dialogue: 0,0:18:16.12,0:18:16.88,Main,Alteran and Cadence,0,0,0,,是！
Dialogue: 0,0:18:19.91,0:18:22.27,Main,Neema,0,0,0,,很好很好 到現在為止都很順利
Dialogue: 0,0:18:22.64,0:18:25.16,Main,Neema,0,0,0,,現在如果他們覺得還有人在裡面的話
Dialogue: 0,0:18:25.16,0:18:27.24,Main,Neema,0,0,0,,他們就不會隨便攻擊
Dialogue: 0,0:18:27.50,0:18:30.54,Main,Neema,0,0,0,,當面對一個強大且邪惡的大哥布林時
Dialogue: 0,0:18:30.54,0:18:32.97,Main,Neema,0,0,0,,我相信他們會願意談判
Dialogue: 0,0:18:39.11,0:18:41.29,Main,Neema,0,0,0,,嗯 完美的作戰！
Dialogue: 0,0:18:42.48,0:18:43.76,Main,Cadence,0,0,0,,好大…
Dialogue: 0,0:18:44.22,0:18:45.98,Main,Hobgoblin,0,0,0,,我們會放孩子回去的
Dialogue: 0,0:18:45.98,0:18:48.70,Main,Hobgoblin,0,0,0,,人類 離開！
Dialogue: 0,0:18:48.70,0:18:50.23,Main,Dayland,0,0,0,,喔？
Dialogue: 0,0:18:50.52,0:18:53.88,Main,Dayland,0,0,0,,很少能遇到會說話的哥布林
Dialogue: 0,0:18:57.91,0:18:59.36,Main,Neema,0,0,0,,呀—！
Dialogue: 0,0:18:59.79,0:19:02.69,Main,Dayland,0,0,0,,把奈菲蒂瑪還來
Dialogue: 0,0:19:02.69,0:19:05.32,Main,Dayland,0,0,0,,孩子們也差不多該去睡覺了
Dialogue: 0,0:19:07.03,0:19:08.67,Main,Neema,0,0,0,,太可怕了！
Dialogue: 0,0:19:08.67,0:19:10.49,Main,Neema,0,0,0,,這不是我認識的爸爸啊！
Dialogue: 0,0:19:31.02,0:19:32.76,Main,Dayland,0,0,0,,我知道妳在裡面
Dialogue: 0,0:19:32.76,0:19:34.69,Main,Dayland,0,0,0,,奈菲蒂瑪 現在出來！
Dialogue: 0,0:19:36.14,0:19:37.53,Main,Neema,0,0,0,,被看穿了！
Dialogue: 0,0:19:37.53,0:19:40.61,Main,Neema,0,0,0,,這下只能道歉了…
Dialogue: 0,0:19:42.27,0:19:45.59,Main,Neema,0,0,0,,您不會生氣？ 您不會用任何魔法？
Dialogue: 0,0:19:45.87,0:19:50.54,Main,Dayland,0,0,0,,嗯 我保證我不會生氣也不會用魔法
Dialogue: 0,0:19:56.44,0:19:58.00,Main,Neema,0,0,0,,抱歉
Dialogue: 0,0:19:58.55,0:20:01.72,Main,Dayland,0,0,0,,雖然我不知道你為什麼要道歉
Dialogue: 0,0:20:01.72,0:20:04.81,Main,Dayland,0,0,0,,不過你快點到這裡來讓我放心吧
Dialogue: 0,0:20:09.32,0:20:10.93,Main,Neema,0,0,0,,父親
Dialogue: 0,0:20:14.91,0:20:16.32,Main,Alteran,0,0,0,,準備釋放巨大火球
Dialogue: 0,0:20:16.32,0:20:17.51,Main,Cadence,0,0,0,,三發
Dialogue: 0,0:20:18.72,0:20:20.44,Main,Neema,0,0,0,,索珥 保護牠們！
Dialogue: 0,0:20:30.30,0:20:31.66,Main,Neema,0,0,0,,我絕不讓您殺掉牠們！
Dialogue: 0,0:20:32.02,0:20:34.00,Main,Dayland,0,0,0,,為什麼要保護哥布林們？
Dialogue: 0,0:20:34.24,0:20:37.46,Main,Neema,0,0,0,,牠們只是被人類利用了！
Dialogue: 0,0:20:37.88,0:20:38.92,Main,Dayland,0,0,0,,利用？
Dialogue: 0,0:20:38.92,0:20:43.92,Main,Neema,0,0,0,,牠們被人類追趕 不得以才流落到這裡！
Dialogue: 0,0:20:46.64,0:20:50.09,Main,Neema,0,0,0,,拜託了 父親！ 聽聽我要說的話！
Dialogue: 0,0:20:53.01,0:20:56.07,Main,Dayland,0,0,0,,我知道了 如果奈瑪這麼堅持的話
Dialogue: 0,0:20:57.82,0:20:58.84,Main,Neema,0,0,0,,真的？
Dialogue: 0,0:20:58.84,0:20:59.46,Main,Dayland,0,0,0,,是
Dialogue: 0,0:20:59.46,0:21:00.51,Main,Neema,0,0,0,,謝謝！
Dialogue: 0,0:21:02.56,0:21:05.35,Main,Neema,0,0,0,,皮諾 妮諾 你們有受傷嗎？
Dialogue: 0,0:21:05.73,0:21:08.99,Main,Pino,0,0,0,,我們沒事 奈瑪看起來也沒事
Dialogue: 0,0:21:09.25,0:21:11.46,Main,Nino,0,0,0,,妳父親也太恐怖了吧？
Dialogue: 0,0:21:14.71,0:21:15.93,Main,Neema,0,0,0,,諾克斯？
Dialogue: 0,0:21:18.69,0:21:21.19,Main,Neema,0,0,0,,那個叫聲的意思是危險就在附近
Dialogue: 0,0:21:25.08,0:21:27.04,Main,Neema,0,0,0,,那裡似乎有什麼…
Dialogue: 0,0:21:28.02,0:21:31.55,Flashback,Dayland,0,0,0,,最常見的報告是哥布林
Dialogue: 0,0:21:31.55,0:21:34.57,Flashback,Dayland,0,0,0,,還有一些是狗頭人和偶爾出現的…
Dialogue: 0,0:21:35.22,0:21:37.06,Main,Neema,0,0,0,,索珥 給我一點光
Dialogue: 0,0:21:37.06,0:21:38.16,Main,Sol,0,0,0,,明白
Dialogue: 0,0:21:43.30,0:21:44.52,Main,Cadence,0,0,0,,請退後！
Dialogue: 0,0:21:52.05,0:21:52.95,Main,Pino,0,0,0,,妮諾！
Dialogue: 0,0:21:54.17,0:21:55.44,Main,Dayland,0,0,0,,那是…
Dialogue: 0,0:21:57.37,0:21:58.95,Main,Dayland,0,0,0,,冰凍蜘蛛！

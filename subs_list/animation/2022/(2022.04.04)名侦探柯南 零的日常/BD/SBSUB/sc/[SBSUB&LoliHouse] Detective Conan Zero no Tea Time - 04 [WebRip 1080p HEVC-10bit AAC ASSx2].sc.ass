Dialogue: 0,0:00:03.34,0:00:04.90,DefaultSingle-S,,0,0,0,,		好好吃的样子
Dialogue: 0,0:00:05.18,0:00:06.71,DefaultSingle-S,,0,0,0,,		谢谢
Dialogue: 0,0:00:06.85,0:00:08.27,DefaultSingle-S,,0,0,0,,		你看  山岸先生
Dialogue: 0,0:00:08.77,0:00:10.40,DefaultSingle-S,,0,0,0,,	{\an8\fs55}	看起来好好吃
Dialogue: 0,0:00:10.66,0:00:12.05,DefaultSingle-S,,0,0,0,,	{\an8\fs55}	是啊
Dialogue: 0,0:00:09.44,0:00:12.05,DefaultSingle-S,,0,0,0,,		冲野洋子好可爱
Dialogue: 0,0:00:12.73,0:00:17.53,DefaultSingle-S,,0,0,0,,		毛利先生说有很美味的三明治  向我介绍了你们店
Dialogue: 0,0:00:17.95,0:00:20.41,DefaultSingle-S,,0,0,0,,		这是安室先生自创的极品火腿三明治
Dialogue: 0,0:00:20.41,0:00:22.29,DefaultSingle-S,,0,0,0,,		请一定要尝尝
Dialogue: 0,0:00:23.37,0:00:24.87,DefaultSingle-S,,0,0,0,,		你就是安室先生吗
Dialogue: 0,0:00:24.92,0:00:25.50,DefaultSingle-S,,0,0,0,,		是的
Dialogue: 0,0:00:25.79,0:00:27.54,DefaultSingle-S,,0,0,0,,		我听毛利先生说了
Dialogue: 0,0:00:27.84,0:00:30.21,DefaultSingle-S,,0,0,0,,		你是个很优秀的侦探吧
Dialogue: 0,0:00:35.30,0:00:36.22,DefaultSingle-S,,0,0,0,,		安室先生？
Dialogue: 0,0:00:36.84,0:00:40.60,DefaultSingle-S,,0,0,0,,		跟毛利老师相比  我还差得远呢
Dialogue: 0,0:00:40.60,0:00:41.60,DefaultSingle-S,,0,0,0,,		对了
Dialogue: 0,0:00:41.72,0:00:44.94,DefaultSingle-S,,0,0,0,,		能帮我转交一样东西给毛利先生吗
Dialogue: 0,0:00:46.69,0:00:48.02,DefaultSingle-S,,0,0,0,,		咦  不见了
Dialogue: 0,0:00:48.65,0:00:50.11,DefaultSingle-S,,0,0,0,,		又  又来了吗
Dialogue: 0,0:00:50.23,0:00:51.32,DefaultSingle-S,,0,0,0,,		化妆包也不见了
Dialogue: 0,0:00:52.94,0:00:54.03,DefaultSingle-S,,0,0,0,,		又是洋子小姐的…
Dialogue: 0,0:00:54.03,0:00:54.99,DefaultSingle-S,,0,0,0,,		好可怕啊
Dialogue: 0,0:00:54.99,0:00:56.41,DefaultSingle-S,,0,0,0,,		都第三次了吧
Dialogue: 0,0:00:56.70,0:00:58.83,DefaultSingle-S,,0,0,0,,		明明上了锁的
Dialogue: 0,0:01:00.20,0:01:04.16,DefaultSingle-S,,0,0,0,,		最近台里经常有人在后台被偷东西
Dialogue: 0,0:01:04.58,0:01:06.12,DefaultSingle-S,,0,0,0,,		我会转告毛利老师的
Dialogue: 0,0:01:06.46,0:01:09.88,DefaultSingle-S,,0,0,0,,		毕竟是为了你  他一定会帮忙的
Dialogue: 0,0:01:10.92,0:01:13.59,DefaultSingle-S,,0,0,0,,		洋子小姐  「半藏」要开始彩排了
Dialogue: 0,0:01:13.59,0:01:14.26,DefaultSingle-S,,0,0,0,,		好的
Dialogue: 0,0:01:14.88,0:01:16.80,DefaultSingle-S,,0,0,0,,		今天多谢了
Dialogue: 0,0:01:17.05,0:01:18.51,DefaultSingle-S,,0,0,0,,		我会和大家一起享用的
Dialogue: 0,0:02:55.36,0:02:57.61,DefaultSingle-S,,0,0,0,,		后台小偷的事  好担心啊
Dialogue: 0,0:02:57.78,0:03:00.07,DefaultSingle-S,,0,0,0,,		是啊  希望能尽快抓到吧
Dialogue: 0,0:03:01.32,0:03:02.74,DefaultSingle-S,,0,0,0,,		话说回来  小梓小姐
Dialogue: 0,0:03:02.74,0:03:05.58,DefaultSingle-S,,0,0,0,,		这个「半藏」是什么节目啊
Dialogue: 0,0:03:02.74,0:03:05.58,DefaultSingle-S,,0,0,0,,	{\pos(844,984)\fs40}	HANZO
Dialogue: 0,0:03:06.83,0:03:09.29,DefaultSingle-S,,0,0,0,,		安室先生  你居然没看过？
Dialogue: 0,0:03:09.50,0:03:11.96,DefaultSingle-S,,0,0,0,,		「半藏」是以忍者为原型的
Dialogue: 0,0:03:11.96,0:03:14.13,DefaultSingle-S,,0,0,0,,		超人气运动动作节目
Dialogue: 0,0:03:14.54,0:03:18.67,DefaultSingle-S,,0,0,0,,		至今有众多运动员和身体素质一流的人进行挑战
Dialogue: 0,0:03:19.22,0:03:22.34,DefaultSingle-S,,0,0,0,,		却无一人通关
Dialogue: 0,0:03:23.93,0:03:26.22,DefaultSingle-S,,0,0,0,,		紧张刺激  很有趣的
Dialogue: 0,0:03:26.47,0:03:29.81,DefaultSingle-S,,0,0,0,,		洋子小姐在节目中担任解说嘉宾
Dialogue: 0,0:03:30.02,0:03:34.73,DefaultSingle-S,,0,0,0,,		如果出现通关者  也会由她进行颁奖
Dialogue: 0,0:03:35.65,0:03:37.73,DefaultSingle-S,,0,0,0,,		下一期也必须要看
Dialogue: 0,0:03:40.15,0:03:41.70,DefaultSingle-S,,0,0,0,,		那个  安室先生  不好意思
Dialogue: 0,0:03:41.99,0:03:43.66,DefaultSingle-S,,0,0,0,,		我去一趟洗手间
Dialogue: 0,0:03:43.82,0:03:46.16,DefaultSingle-S,,0,0,0,,		好  我在这里等你
Dialogue: 0,0:04:00.67,0:04:01.55,DefaultSingle-S,,0,0,0,,		请问
Dialogue: 0,0:04:02.47,0:04:04.59,DefaultSingle-S,,0,0,0,,		那里是冲野小姐的休息室吧
Dialogue: 0,0:04:05.18,0:04:07.43,DefaultSingle-S,,0,0,0,,		我是「半藏」的工作人员
Dialogue: 0,0:04:07.93,0:04:09.35,DefaultSingle-S,,0,0,0,,		我想也是
Dialogue: 0,0:04:09.35,0:04:11.23,DefaultSingle-S,,0,0,0,,		刚才在这个房间也看到你了
Dialogue: 0,0:04:11.23,0:04:12.85,DefaultSingle-S,,0,0,0,,		告辞  我还有工作
Dialogue: 0,0:04:17.44,0:04:20.57,DefaultSingle-S,,0,0,0,,		咦  地上有东西
Dialogue: 0,0:04:20.65,0:04:21.57,DefaultSingle-S,,0,0,0,,		口红？
Dialogue: 0,0:04:22.40,0:04:24.20,DefaultSingle-S,,0,0,0,,		难道是你的吗
Dialogue: 0,0:04:25.03,0:04:27.83,DefaultSingle-S,,0,0,0,,		我  我是化妆师
Dialogue: 0,0:04:27.83,0:04:29.54,DefaultSingle-S,,0,0,0,,		能把口红还给我…
Dialogue: 0,0:04:29.54,0:04:31.41,DefaultSingle-S,,0,0,0,,		哎呀  我真是的
Dialogue: 0,0:04:34.58,0:04:36.67,DefaultSingle-S,,0,0,0,,		把东西忘在休息室…
Dialogue: 0,0:04:37.96,0:04:40.17,DefaultSingle-S,,0,0,0,,		那是我的化妆包…
Dialogue: 0,0:04:41.21,0:04:42.09,DefaultSingle-S,,0,0,0,,		不是…
Dialogue: 0,0:04:47.64,0:04:48.30,DefaultSingle-S,,0,0,0,,		站住
Dialogue: 0,0:04:54.98,0:04:58.31,DefaultSingle-S,,0,0,0,,		这  这巨大的布景是什么
Dialogue: 0,0:05:02.19,0:05:03.61,DefaultSingle-S,,0,0,0,,		好难缠
Dialogue: 0,0:05:03.74,0:05:07.57,DefaultSingle-S,,0,0,0,,		不过  这魔鬼堡垒可是阻挡了无数挑战者的脚步
Dialogue: 0,0:05:07.74,0:05:09.95,DefaultSingle-S,,0,0,0,,		你能追到何时呢
Dialogue: 0,0:05:10.20,0:05:12.20,DefaultSingle-S,,0,0,0,,		这可是我搭建的布景
Dialogue: 0,0:05:12.37,0:05:13.91,DefaultSingle-S,,0,0,0,,		是我的…庭院
Dialogue: 0,0:05:14.29,0:05:16.04,DefaultSingle-S,,0,0,0,,		心爱的洋子小姐的化妆包
Dialogue: 0,0:05:16.04,0:05:17.54,DefaultSingle-S,,0,0,0,,		岂能被你抢走
Dialogue: 0,0:05:36.23,0:05:40.90,DefaultSingle-S,,0,0,0,,		我竟然搭了这么可怕又险恶的布景
Dialogue: 0,0:06:16.98,0:06:18.69,DefaultSingle-S,,0,0,0,,		犯人在哪里  洋子
Dialogue: 0,0:06:18.69,0:06:20.31,DefaultSingle-S,,0,0,0,,		应该是往这边逃了
Dialogue: 0,0:06:20.31,0:06:23.07,DefaultSingle-S,,0,0,0,,		找  找到了  在布景下的水池里
Dialogue: 0,0:06:23.07,0:06:23.90,DefaultSingle-S,,0,0,0,,		就是你啊
Dialogue: 0,0:06:23.90,0:06:25.23,DefaultSingle-S,,0,0,0,,		你个后台小偷
Dialogue: 0,0:06:25.48,0:06:27.32,DefaultSingle-S,,0,0,0,,		快报警
Dialogue: 0,0:06:29.41,0:06:30.82,DefaultSingle-S,,0,0,0,,		终于到终点了啊
Dialogue: 0,0:06:32.87,0:06:35.04,DefaultSingle-S,,0,0,0,,		我原本是在干什么来着
Dialogue: 0,0:06:35.04,0:06:37.75,DefaultSingle-S,,0,0,0,,		安室先生  我找你半天了
Dialogue: 0,0:06:38.12,0:06:40.92,DefaultSingle-S,,0,0,0,,		你在那种地方做什么啊
Dialogue: 0,0:06:41.00,0:06:42.92,DefaultSingle-S,,0,0,0,,		会被骂的哦
Dialogue: 0,0:06:44.42,0:06:45.55,DefaultSingle-S,,0,0,0,,		也对
Dialogue: 0,0:06:50.80,0:06:53.93,DefaultSingle-S,,0,0,0,,		本期也没有人能通关
Dialogue: 0,0:06:54.18,0:06:56.77,DefaultSingle-S,,0,0,0,,		敬请期待下期「半藏」
Dialogue: 0,0:07:01.60,0:07:05.52,DefaultSingle-S,,0,0,0,,		意面和雪顶苏打  久等了
Dialogue: 0,0:07:06.86,0:07:09.53,DefaultSingle-S,,0,0,0,,		谢谢你  小梓姐姐
Dialogue: 0,0:07:09.53,0:07:10.49,DefaultSingle-S,,0,0,0,,		请用吧
Dialogue: 0,0:07:10.61,0:07:11.24,DefaultSingle-S,,0,0,0,,		嗯
Dialogue: 0,0:07:11.36,0:07:13.16,DefaultSingle-S,,0,0,0,,		我开动了
Dialogue: 0,0:07:19.87,0:07:21.29,DefaultSingle-S,,0,0,0,,		真好吃
Dialogue: 0,0:07:25.71,0:07:28.34,DefaultSingle-S,,0,0,0,,		多谢款待  今天也很美味
Dialogue: 0,0:07:28.76,0:07:31.84,DefaultSingle-S,,0,0,0,,		好了  我们去给小彰买了猫粮回家吧
Dialogue: 0,0:07:33.14,0:07:35.10,DefaultSingle-S,,0,0,0,,		小梓姐姐
Dialogue: 0,0:07:36.68,0:07:40.81,DefaultSingle-S,,0,0,0,,		我和朋友约好下次骑自行车去远一点的地方
Dialogue: 0,0:07:40.81,0:07:42.02,DefaultSingle-S,,0,0,0,,		可是我…
Dialogue: 0,0:07:44.86,0:07:45.77,DefaultSingle-S,,0,0,0,,		我吗
Dialogue: 0,0:07:49.19,0:07:50.11,DefaultSingle-S,,0,0,0,,		安室先生
Dialogue: 0,0:07:56.58,0:07:59.95,DefaultSingle-S,,0,0,0,,		这座公园很适合用来练习自行车
Dialogue: 0,0:08:00.33,0:08:02.71,DefaultSingle-S,,0,0,0,,		为什么是波洛的大哥哥啊
Dialogue: 0,0:08:02.79,0:08:06.46,DefaultSingle-S,,0,0,0,,		我想要小梓姐姐教我的
Dialogue: 0,0:08:06.54,0:08:10.13,DefaultSingle-S,,0,0,0,,		你们都是男生  他肯定要比我教得好
Dialogue: 0,0:08:10.46,0:08:11.59,DefaultSingle-S,,0,0,0,,		切
Dialogue: 0,0:08:11.59,0:08:12.55,DefaultSingle-S,,0,0,0,,		骑一个看看吧
Dialogue: 0,0:08:16.72,0:08:21.60,DefaultSingle-S,,0,0,0,,		这么帅气的大哥哥怎么可能懂我的心情
Dialogue: 0,0:08:25.73,0:08:27.57,DefaultSingle-S,,0,0,0,,		痛痛痛
Dialogue: 0,0:08:31.15,0:08:34.11,DefaultSingle-S,,0,0,0,,		大哥哥肯定也在嘲笑我
Dialogue: 0,0:08:34.11,0:08:35.28,DefaultSingle-S,,0,0,0,,		你没事吧
Dialogue: 0,0:08:36.49,0:08:36.99,DefaultSingle-S,,0,0,0,,		咦
Dialogue: 0,0:08:38.58,0:08:39.74,DefaultSingle-S,,0,0,0,,		他没笑
Dialogue: 0,0:08:40.16,0:08:42.54,DefaultSingle-S,,0,0,0,,		来  再骑一次吧
Dialogue: 0,0:08:46.83,0:08:48.29,DefaultSingle-S,,0,0,0,,		你真努力
Dialogue: 0,0:08:48.42,0:08:49.63,DefaultSingle-S,,0,0,0,,		明天要再来练吗
Dialogue: 0,0:08:49.75,0:08:51.17,DefaultSingle-S,,0,0,0,,		我不练了
Dialogue: 0,0:08:51.21,0:08:53.34,DefaultSingle-S,,0,0,0,,		是吗  真遗憾
Dialogue: 0,0:08:54.05,0:08:56.18,DefaultSingle-S,,0,0,0,,		那就只有一次的贴纸
Dialogue: 0,0:08:57.68,0:08:58.76,DefaultSingle-S,,0,0,0,,		这是…
Dialogue: 0,0:08:58.89,0:09:01.56,DefaultSingle-S,,0,0,0,,		假面超人超级彩虹贴纸
Dialogue: 0,0:09:01.64,0:09:04.19,DefaultSingle-S,,0,0,0,,		波  波洛的大哥哥  你也喜欢吗
Dialogue: 0,0:09:04.19,0:09:04.81,DefaultSingle-S,,0,0,0,,		是啊
Dialogue: 0,0:09:07.27,0:09:08.40,DefaultSingle-S,,0,0,0,,		欢迎光临
Dialogue: 0,0:09:11.57,0:09:14.57,DefaultSingle-S,,0,0,0,,		我  我只是想要贴纸而已
Dialogue: 0,0:09:15.07,0:09:18.20,DefaultSingle-S,,0,0,0,,		我才不是想练习呢
Dialogue: 0,0:09:36.97,0:09:38.80,DefaultSingle-S,,0,0,0,,		好棒
Dialogue: 0,0:09:40.89,0:09:42.39,DefaultSingle-S,,0,0,0,,		那继续练习吧
Dialogue: 0,0:09:42.43,0:09:42.81,DefaultSingle-S,,0,0,0,,		嗯
Dialogue: 0,0:09:45.94,0:09:48.02,DefaultSingle-S,,0,0,0,,		要不要拆掉一个辅助轮试试呢
Dialogue: 0,0:09:51.82,0:09:55.11,DefaultSingle-S,,0,0,0,,		要倒下的时候  就往另一边打方向盘
Dialogue: 0,0:09:59.32,0:10:01.33,DefaultSingle-S,,0,0,0,,		很好  进步了
Dialogue: 0,0:10:01.66,0:10:04.25,DefaultSingle-S,,0,0,0,,		那就把辅助轮都拆掉  跟之前一样骑试试
Dialogue: 0,0:10:05.12,0:10:07.12,DefaultSingle-S,,0,0,0,,		别担心  你可以的
Dialogue: 0,0:10:17.93,0:10:19.47,DefaultSingle-S,,0,0,0,,		痛痛痛
Dialogue: 0,0:10:19.47,0:10:20.47,DefaultSingle-S,,0,0,0,,		没事吧
Dialogue: 0,0:10:25.68,0:10:29.02,DefaultSingle-S,,0,0,0,,		我果然不行
Dialogue: 0,0:10:32.40,0:10:33.90,DefaultSingle-S,,0,0,0,,		你还是害怕自行车吗
Dialogue: 0,0:10:41.53,0:10:45.45,DefaultSingle-S,,0,0,0,,		我在后面扶着  你使劲往前骑吧
Dialogue: 0,0:10:45.87,0:10:46.62,DefaultSingle-S,,0,0,0,,		嗯
Dialogue: 0,0:10:47.04,0:10:47.79,DefaultSingle-S,,0,0,0,,		准备
Dialogue: 0,0:10:48.00,0:10:49.08,DefaultSingle-S,,0,0,0,,		开始
Dialogue: 0,0:10:51.50,0:10:53.46,DefaultSingle-S,,0,0,0,,		波  波洛的大哥哥
Dialogue: 0,0:10:53.46,0:10:55.38,DefaultSingle-S,,0,0,0,,		我  我不行了
Dialogue: 0,0:10:55.38,0:10:57.13,DefaultSingle-S,,0,0,0,,		我扶着呢  你放心
Dialogue: 0,0:11:00.38,0:11:01.43,DefaultSingle-S,,0,0,0,,		很好很好
Dialogue: 0,0:11:02.97,0:11:05.43,DefaultSingle-S,,0,0,0,,		你可千万别放手啊
Dialogue: 0,0:11:08.10,0:11:10.94,DefaultSingle-S,,0,0,0,,		你要是放手  我会倒下去的
Dialogue: 0,0:11:11.10,0:11:14.98,DefaultSingle-S,,0,0,0,,		你放心  我一定不放手
Dialogue: 0,0:11:27.24,0:11:29.62,DefaultSingle-S,,0,0,0,,		很好很好  就是这样
Dialogue: 0,0:11:40.84,0:11:43.43,DefaultSingle-S,,0,0,0,,		你真棒  会骑自行车了
Dialogue: 0,0:11:43.59,0:11:46.68,DefaultSingle-S,,0,0,0,,		因为有你扶着啊
Dialogue: 0,0:11:46.76,0:11:48.47,DefaultSingle-S,,0,0,0,,		你说谁在扶着？
Dialogue: 0,0:11:51.06,0:11:51.69,DefaultSingle-S,,0,0,0,,		很好
Dialogue: 0,0:11:53.19,0:11:54.69,DefaultSingle-S,,0,0,0,,		太好啦

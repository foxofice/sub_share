Dialogue: 0,0:01:11.21,0:01:14.47,Sign,,0,0,0,,{\pos(960,730)\fax-0.1\fn汉仪旗黑 95S\c&HBFC729&\3c&HFFFFFF&}凛 {\c&H6C8197&}蚁生 {\c&H3F5F00&}时光 {\c&H9B411A&}结成队伍
Dialogue: 1,0:00:01.64,0:00:04.98,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:00:06.06,0:00:08.36,CN,,0,0,0,,怎么办
Dialogue: 1,0:00:08.36,0:00:11.32,CN,,0,0,0,,居然要3人组队才能通关
Dialogue: 1,0:00:11.32,0:00:14.99,CN,,0,0,0,,没人会愿意和我组队的吧
Dialogue: 1,0:00:16.03,0:00:20.08,CN,,0,0,0,,作为第三个通关的强者 你一点都不潮啊
Dialogue: 1,0:00:20.08,0:00:21.58,CN,,0,0,0,,潮？
Dialogue: 1,0:00:21.58,0:00:23.16,CN,,0,0,0,,这个长毛在讲什么
Dialogue: 1,0:00:23.16,0:00:27.25,CN,,0,0,0,,哎呀 我在想组队的事该怎么办呢
Dialogue: 1,0:00:27.25,0:00:29.63,CN,,0,0,0,,那当然是排前三的组一队了
Dialogue: 1,0:00:29.63,0:00:32.55,CN,,0,0,0,,这就是最潮最高雅的组合
Dialogue: 1,0:00:32.55,0:00:36.59,CN,,0,0,0,,虽然很感谢他 但这人一定是个变态
Dialogue: 1,0:00:36.59,0:00:39.05,CN,,0,0,0,,有点不想和他组队啊
Dialogue: 1,0:00:41.93,0:00:43.39,CN,,0,0,0,,委婉地拒绝他吧
Dialogue: 1,0:00:43.39,0:00:48.06,CN,,0,0,0,,呃 其实我实力就一般啦
Dialogue: 1,0:00:48.06,0:00:50.69,CN,,0,0,0,,只是碰巧过关了而已
Dialogue: 1,0:00:50.69,0:00:52.69,CN,,0,0,0,,嗯？是这样的吗？
Dialogue: 1,0:00:52.69,0:00:54.90,CN,,0,0,0,,喂 差不多得了
Dialogue: 1,0:00:54.90,0:00:57.78,CN,,0,0,0,,啊 他好像要帮我解围了
Dialogue: 1,0:00:58.16,0:01:01.45,CN,,0,0,0,,赶紧过来 别浪费时间
Dialogue: 1,0:01:01.45,0:01:04.91,CN,,0,0,0,,这人更加有问题啊
Dialogue: 1,0:01:06.21,0:01:08.17,CN,,0,0,0,,请 请多指教
Dialogue: 1,0:01:08.17,0:01:11.21,CN,,0,0,0,,识时务为潮
Dialogue: 0,0:00:01.64,0:00:04.98,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:00:06.06,0:00:08.36,JP,,0,0,0,,あ～どうしよう
Dialogue: 0,0:00:08.36,0:00:11.32,JP,,0,0,0,,３人一組がクリア条件なんて
Dialogue: 0,0:00:11.32,0:00:14.99,JP,,0,0,0,,俺なんかが　誰かと組んでもらえるわけないよ
Dialogue: 0,0:00:16.03,0:00:20.08,JP,,0,0,0,,お前　三番目でクリアしたつわものの割にはオシャじゃない
Dialogue: 0,0:00:20.08,0:00:21.58,JP,,0,0,0,,オシャ？
Dialogue: 0,0:00:21.58,0:00:23.16,JP,,0,0,0,,なに言ってんだ　このロンゲ
Dialogue: 0,0:00:23.16,0:00:27.25,JP,,0,0,0,,あっ　いや　チームどうしようかなって
Dialogue: 0,0:00:27.25,0:00:29.63,JP,,0,0,0,,決まってるだろ　上位３人で組む
Dialogue: 0,0:00:29.63,0:00:32.55,JP,,0,0,0,,それが最高にオシャで気高いかたちだ
Dialogue: 0,0:00:32.55,0:00:36.59,JP,,0,0,0,,ありがたいけど　この人はきっとヘンタイだ
Dialogue: 0,0:00:36.59,0:00:39.05,JP,,0,0,0,,組むのはあんまり嫌だな
Dialogue: 0,0:00:41.93,0:00:43.39,JP,,0,0,0,,柔に断ろ
Dialogue: 0,0:00:43.39,0:00:48.06,JP,,0,0,0,,あっ　いや　でも俺　実はあんましうまくなくて
Dialogue: 0,0:00:48.06,0:00:50.69,JP,,0,0,0,,たまたまクリアしちゃって
Dialogue: 0,0:00:50.69,0:00:52.69,JP,,0,0,0,,ん？そうなのか？
Dialogue: 0,0:00:52.69,0:00:54.90,JP,,0,0,0,,おい　その辺でいいだろ
Dialogue: 0,0:00:54.90,0:00:57.78,JP,,0,0,0,,あ　あの人が助けてくれるぽいや
Dialogue: 0,0:00:58.16,0:01:01.45,JP,,0,0,0,,さっさとこい　時間の無駄だ
Dialogue: 0,0:01:01.45,0:01:04.91,JP,,0,0,0,,もっとやばそうな人じゃんかい
Dialogue: 0,0:01:06.21,0:01:08.17,JP,,0,0,0,,よ　よろしく
Dialogue: 0,0:01:08.17,0:01:11.21,JP,,0,0,0,,聞き分けがいいのはオシャだ
Dialogue: 0,0:01:25.60,0:01:28.52,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#14 前三和蜂乐
Dialogue: 1,0:01:22.64,0:01:25.56,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:01:25.56,0:01:28.85,CN,,0,0,0,,欢迎回来 以后多多指教 蜂乐
Dialogue: 1,0:01:30.11,0:01:32.11,CN,,0,0,0,,洗得真爽
Dialogue: 1,0:01:32.82,0:01:35.36,CN,,0,0,0,,你为什么不穿衣服走来走去啊
Dialogue: 1,0:01:35.36,0:01:38.57,CN,,0,0,0,,嗯？生而为人 回到最自然的状态而已
Dialogue: 1,0:01:38.57,0:01:40.20,CN,,0,0,0,,什么名言？
Dialogue: 1,0:01:40.20,0:01:43.29,CN,,0,0,0,,难得来了个新同伴
Dialogue: 1,0:01:43.29,0:01:45.45,CN,,0,0,0,,没想到又是个怪人
Dialogue: 1,0:01:45.45,0:01:47.04,CN,,0,0,0,,喂 裸族
Dialogue: 1,0:01:47.04,0:01:47.96,CN,,0,0,0,,怎么了
Dialogue: 1,0:01:47.96,0:01:51.21,CN,,0,0,0,,我承认你这种自由的风格 但至少把前面遮住
Dialogue: 1,0:01:51.21,0:01:54.21,CN,,0,0,0,,爷很潮地怒斥你公然猥亵
Dialogue: 1,0:01:54.21,0:01:56.09,CN,,0,0,0,,诶 抱歉
Dialogue: 1,0:01:56.09,0:01:57.88,CN,,0,0,0,,但做裸族很舒服的呀
Dialogue: 1,0:01:57.88,0:01:59.13,CN,,0,0,0,,要不要试试？
Dialogue: 1,0:01:59.13,0:02:00.51,CN,,0,0,0,,爷 脱衣
Dialogue: 1,0:02:02.30,0:02:05.18,CN,,0,0,0,,你们俩在干什么呀
Dialogue: 1,0:02:07.35,0:02:09.39,CN,,0,0,0,,这房间里就没有正常人吗
Dialogue: 1,0:02:09.39,0:02:12.06,CN,,0,0,0,,你也没资格说这话
Dialogue: 0,0:01:22.64,0:01:25.56,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:01:25.56,0:01:28.85,JP,,0,0,0,,おかえり　あらためてよろしくね　蜂楽
Dialogue: 0,0:01:30.11,0:01:32.11,JP,,0,0,0,,いいお湯　いいお湯
Dialogue: 0,0:01:32.82,0:01:35.36,JP,,0,0,0,,ちょっと　まっ　何で裸のまま歩いてんの
Dialogue: 0,0:01:35.36,0:01:38.57,JP,,0,0,0,,え？人間だから生まれたままに戻るのだ
Dialogue: 0,0:01:38.57,0:01:40.20,JP,,0,0,0,,どういう名言？
Dialogue: 0,0:01:40.20,0:01:43.29,JP,,0,0,0,,せっかく新しい仲間が出来たと思ったのに
Dialogue: 0,0:01:43.29,0:01:45.45,JP,,0,0,0,,また変な人だ
Dialogue: 0,0:01:45.45,0:01:47.04,JP,,0,0,0,,おい　裸族
Dialogue: 0,0:01:47.04,0:01:47.96,JP,,0,0,0,,何？
Dialogue: 0,0:01:47.96,0:01:51.21,JP,,0,0,0,,その自由なスタイルは認めるが前ぐらい隠せ
Dialogue: 0,0:01:51.21,0:01:54.21,JP,,0,0,0,,公然わいせつ　オシャでとっちめるぞ
Dialogue: 0,0:01:54.21,0:01:56.09,JP,,0,0,0,,え～ごめん
Dialogue: 0,0:01:56.09,0:01:57.88,JP,,0,0,0,,でも気持ちいいよ　裸族
Dialogue: 0,0:01:57.88,0:01:59.13,JP,,0,0,0,,一緒にやる？
Dialogue: 0,0:01:59.13,0:02:00.51,JP,,0,0,0,,俺 脱衣
Dialogue: 0,0:02:02.30,0:02:05.18,JP,,0,0,0,,もう何やってんの二人とも
Dialogue: 0,0:02:07.35,0:02:09.39,JP,,0,0,0,,変人しかいねえのか　この部屋は
Dialogue: 0,0:02:09.39,0:02:12.06,JP,,0,0,0,,お前に言われたかねえ
Dialogue: 0,0:02:23.16,0:02:26.08,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#15 恋爱中的少女？玲王
Dialogue: 1,0:02:19.87,0:02:23.12,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:02:25.00,0:02:27.21,CN,,0,0,0,,训练好累
Dialogue: 1,0:02:27.21,0:02:28.89,CN,,0,0,0,,辛苦了
Dialogue: 1,0:02:28.89,0:02:29.96,CN,,0,0,0,,咦 玲王呢？
Dialogue: 1,0:02:31.51,0:02:35.03,CN,,0,0,0,,30分钟前他就说去刷牙了
Dialogue: 1,0:02:35.03,0:02:36.88,CN,,0,0,0,,到现在还没回来
Dialogue: 1,0:02:37.40,0:02:40.00,CN,,0,0,0,,喂 在干嘛呢？玲王
Dialogue: 1,0:02:40.00,0:02:41.72,CN,,0,0,0,,没事吧？
Dialogue: 1,0:02:41.72,0:02:47.04,CN,fade,0,0,0,,{\fad(1000,0)}凪会回来 凪不会回来
Dialogue: 1,0:02:47.04,0:02:51.56,CN,,0,0,0,,凪会回来 凪不会回来
Dialogue: 1,0:02:48.74,0:02:49.87,CN,,0,1200,0,,玲王？
Dialogue: 1,0:02:51.56,0:02:58.29,CN,,0,0,0,,凪会回来 凪不会回来
Dialogue: 1,0:02:58.29,0:03:04.80,CN,,0,0,0,,凪会回来 凪不会回来
Dialogue: 1,0:03:04.80,0:03:08.50,CN,,0,0,0,,凪会…回来
Dialogue: 1,0:03:10.48,0:03:14.00,CN,,0,0,0,,就算回来 我也不会像以前那样对待他了
Dialogue: 1,0:03:16.36,0:03:21.00,CN,,0,0,0,,就算回来 也要冷落他
Dialogue: 1,0:03:16.36,0:03:18.64,CN - Top,,0,0,0,,快睡觉吧 国神…
Dialogue: 1,0:03:18.64,0:03:20.66,CN - Top,,0,0,0,,加油啊 玲王
Dialogue: 1,0:03:21.00,0:03:24.07,CN,,0,0,0,,不冷落他
Dialogue: 1,0:03:24.07,0:03:29.48,CN,fade,0,0,0,,{\fad(0,2000)}冷落他 不冷落他
Dialogue: 0,0:02:19.87,0:02:23.12,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:02:25.00,0:02:27.21,JP,,0,0,0,,トレーニング疲れた～
Dialogue: 0,0:02:27.21,0:02:28.89,JP,,0,0,0,,おっつー
Dialogue: 0,0:02:28.89,0:02:29.96,JP,,0,0,0,,あれ？　玲王は？
Dialogue: 0,0:02:31.51,0:02:35.03,JP,,0,0,0,,３０分くらい前に　歯磨きに行くっつって
Dialogue: 0,0:02:35.03,0:02:36.88,JP,,0,0,0,,戻ってきてないけど
Dialogue: 0,0:02:37.40,0:02:40.00,JP,,0,0,0,,おーい　何やってんだ？　玲王
Dialogue: 0,0:02:40.00,0:02:41.72,JP,,0,0,0,,大丈夫か？
Dialogue: 0,0:02:41.72,0:02:47.04,JP,fade,0,0,0,,{\fad(1000,0)}凪は戻ってくる　凪は戻ってこない
Dialogue: 0,0:02:47.04,0:02:51.56,JP,,0,0,0,,凪は戻ってくる　凪は戻ってこない
Dialogue: 0,0:02:48.74,0:02:49.87,JP,,0,1200,0,,玲王…？
Dialogue: 0,0:02:51.56,0:02:58.29,JP,,0,0,0,,凪は戻ってくる　凪は戻ってこない
Dialogue: 0,0:02:58.29,0:03:04.80,JP,,0,0,0,,凪は戻ってくる　凪は戻ってこない
Dialogue: 0,0:03:04.80,0:03:08.50,JP,,0,0,0,,凪は戻って…くる
Dialogue: 0,0:03:10.48,0:03:14.00,JP,,0,0,0,,戻ってきても　今までの俺と思うなよ
Dialogue: 0,0:03:16.36,0:03:21.00,JP,,0,0,0,,戻ってきても　凪に冷たくする
Dialogue: 0,0:03:16.36,0:03:18.64,JP - Top,,0,0,0,,もう…もう寝よう　国神
Dialogue: 0,0:03:18.64,0:03:20.66,JP - Top,,0,0,0,,頑張れ　玲王
Dialogue: 0,0:03:21.00,0:03:24.07,JP,,0,0,0,,凪に冷たくしない
Dialogue: 0,0:03:24.07,0:03:29.48,JP,fade,0,0,0,,{\fad(0,2000)}凪に冷たくする　凪に冷たくしない
Dialogue: 0,0:03:39.40,0:03:42.32,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#16 女仆咖啡厅 国王马狼
Dialogue: 1,0:03:36.16,0:03:39.36,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:03:39.36,0:03:41.86,CN,,0,0,0,,欢迎回来 主人
Dialogue: 1,0:03:42.39,0:03:44.32,CN,,0,0,0,,马狼 马狼 啾
Dialogue: 1,0:03:44.99,0:03:48.06,CN,,0,0,0,,马狼特制 国王爱心蛋包饭
Dialogue: 1,0:03:48.06,0:03:50.58,CN,,0,0,0,,爱意满满哦
Dialogue: 1,0:03:50.58,0:03:54.08,CN,,0,0,0,,马狼 马狼 啾
Dialogue: 1,0:03:54.58,0:03:57.22,CN,,0,0,0,,女仆马狼大概就是这个感觉吧
Dialogue: 1,0:03:57.22,0:03:59.78,CN,,0,0,0,,哇 够呛 要吐了
Dialogue: 1,0:03:59.78,0:04:02.88,CN,,0,0,0,,不准脑补我 臭崽子们
Dialogue: 1,0:04:02.88,0:04:05.28,CN,,0,0,0,,哦 刚才那种的感觉能行
Dialogue: 1,0:04:05.28,0:04:07.22,CN,,0,0,0,,毒舌系女仆咖啡厅
Dialogue: 1,0:04:07.22,0:04:08.81,CN,,0,0,0,,啊 确实
Dialogue: 1,0:04:09.50,0:04:13.76,CN,,0,0,0,,欢迎回来 菜鸟们
Dialogue: 1,0:04:15.76,0:04:17.88,CN,,0,0,0,,这种更有可能火起来
Dialogue: 1,0:04:17.88,0:04:19.62,CN,,0,0,0,,商机啊 商机
Dialogue: 1,0:04:19.62,0:04:20.47,CN,,0,0,0,,确实有商机
Dialogue: 1,0:04:20.47,0:04:23.15,CN,,0,0,0,,没有 踢死你们啊
Dialogue: 0,0:03:36.16,0:03:39.36,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:03:39.36,0:03:41.86,JP,,0,0,0,,お帰りなさいませ　ご主人様
Dialogue: 0,0:03:42.39,0:03:44.32,JP,,0,0,0,,バロ·バロ·キュン
Dialogue: 0,0:03:44.99,0:03:48.06,JP,,0,0,0,,馬狼特製　キング·ラブ·オムライス
Dialogue: 0,0:03:48.06,0:03:50.58,JP,,0,0,0,,ハートましましですぅ
Dialogue: 0,0:03:50.58,0:03:54.08,JP,,0,0,0,,バロ·バロ·キュンですぅ
Dialogue: 0,0:03:54.58,0:03:57.22,JP,,0,0,0,,メイド馬狼って　こういうことだよな
Dialogue: 0,0:03:57.22,0:03:59.78,JP,,0,0,0,,うわ　きっつ　グロじゃんグロ
Dialogue: 0,0:03:59.78,0:04:02.88,JP,,0,0,0,,勝手に想像してんじゃねえ　クソどもが
Dialogue: 0,0:04:02.88,0:04:05.28,JP,,0,0,0,,あっ　今のいいかも
Dialogue: 0,0:04:05.28,0:04:07.22,JP,,0,0,0,,ののしり系メイドカフェとか
Dialogue: 0,0:04:07.22,0:04:08.81,JP,,0,0,0,,あっ　確かに
Dialogue: 0,0:04:09.50,0:04:13.76,JP,,0,0,0,,おかえりなさいませ　ヘタクソども
Dialogue: 0,0:04:15.76,0:04:17.88,JP,,0,0,0,,そっちの方がワンチャンはやるかも
Dialogue: 0,0:04:17.88,0:04:19.62,JP,,0,0,0,,ビジネスチャンス
Dialogue: 0,0:04:19.62,0:04:20.47,JP,,0,0,0,,あるな　これ
Dialogue: 0,0:04:20.47,0:04:23.15,JP,,0,0,0,,ねえよ　蹴り殺すぞ
Dialogue: 0,0:04:34.29,0:04:37.21,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#17 其他的三人组
Dialogue: 0,0:05:13.75,0:05:25.17,Sign,,0,0,0,,{\pos(960,690)\bord3.5\3c&H99411C&}Q: 猜猜鳄间（哥）的表情想说什么!!
Dialogue: 0,0:06:23.19,0:06:25.69,Sign,,0,0,0,,{\pos(960,730)\fax-0.1\fn汉仪旗黑 95S\c&H3FCFC4&\3c&HFFFFFF&}雷市 {\c&H244870&}鳄间 {\c&H5C5D5C&}我牙丸 {\c&H9B411A&}结成队伍
Dialogue: 1,0:04:30.82,0:04:34.25,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:04:34.25,0:04:35.73,CN,,0,0,0,,可恶
Dialogue: 1,0:04:35.73,0:04:38.67,CN,,0,0,0,,通关花了好多时间
Dialogue: 1,0:04:38.67,0:04:40.25,CN,,0,0,0,,要和谁组队呢
Dialogue: 1,0:04:40.60,0:04:41.88,CN,,0,0,0,,哦 雷市
Dialogue: 1,0:04:42.51,0:04:43.69,CN,,0,0,0,,大家都不在了
Dialogue: 1,0:04:44.30,0:04:46.14,CN,,0,0,0,,好像都先走了
Dialogue: 1,0:04:46.14,0:04:49.30,CN,,0,0,0,,像是成早啊 还有成早…
Dialogue: 1,0:04:50.21,0:04:52.56,CN,,0,0,0,,就算在也不会和他组 随便他
Dialogue: 1,0:04:52.56,0:04:54.98,CN,,0,0,0,,话说 只剩你了吗？
Dialogue: 1,0:04:54.98,0:04:58.86,CN,,0,0,0,,凪好像和洁组队了
Dialogue: 1,0:04:58.86,0:05:00.90,CN,,0,0,0,,话说回来…
Dialogue: 1,0:05:00.90,0:05:03.33,CN,,0,0,0,,你好碍眼 鳄间哥哥
Dialogue: 1,0:05:04.05,0:05:06.22,CN,,0,0,0,,有什么事吗？
Dialogue: 1,0:05:06.22,0:05:08.22,CN,,0,0,0,,哦 我懂了
Dialogue: 1,0:05:08.22,0:05:10.96,CN,,0,0,0,,因为之前你弟弟会给你翻译
Dialogue: 1,0:05:10.96,0:05:13.75,CN,,0,0,0,,我试试翻译你想说什么
Dialogue: 1,0:05:14.75,0:05:17.00,CN,,0,0,0,,在哪能吃寿司？
Dialogue: 1,0:05:20.29,0:05:22.55,CN,,0,0,0,,哪里能看武士？
Dialogue: 1,0:05:25.47,0:05:27.76,CN,,0,0,0,,又不是外国游客
Dialogue: 1,0:05:27.76,0:05:31.77,CN,,0,0,0,,像这种叛徒的同伙就别管他了
Dialogue: 1,0:05:31.77,0:05:33.93,CN,,0,0,0,,八成是在发牢骚
Dialogue: 1,0:05:33.93,0:05:36.02,CN,,0,0,0,,不～是
Dialogue: 1,0:05:36.38,0:05:40.19,CN,,0,0,0,,别～走
Dialogue: 1,0:05:40.53,0:05:42.27,CN,,0,0,0,,正常说话了
Dialogue: 1,0:05:42.27,0:05:44.44,CN,,0,0,0,,你们听好了
Dialogue: 1,0:05:44.93,0:05:46.44,CN,,0,0,0,,雷市阵吾
Dialogue: 1,0:05:46.44,0:05:49.37,CN,,0,0,0,,首先 我很喜欢你那种紧追不舍的风格
Dialogue: 1,0:05:49.37,0:05:52.18,CN,,0,0,0,,那不是普通人能做到的水平
Dialogue: 1,0:05:52.18,0:05:55.53,CN,,0,0,0,,粗犷的同时拥有细微的洞察力 以及那份执着的精神
Dialogue: 1,0:05:55.53,0:05:59.18,CN,,0,0,0,,说你是带领他们来到这里的幕后功臣也不为过
Dialogue: 1,0:05:59.18,0:06:00.66,CN,,0,0,0,,然后是我牙丸吟
Dialogue: 1,0:06:00.66,0:06:04.32,CN,,0,0,0,,你那异想天开且独创的踢法是仅此一家的
Dialogue: 1,0:06:04.32,0:06:06.81,CN,,0,0,0,,乍看是一时兴起的行动
Dialogue: 1,0:06:06.81,0:06:11.34,CN,,0,0,0,,实际上是你那柔软富有弹性的身体该采取的最佳方案
Dialogue: 1,0:06:11.34,0:06:13.26,CN,,0,0,0,,你们的表现牢牢地抓住了我的心
Dialogue: 1,0:06:13.89,0:06:16.65,CN,,0,0,0,,我觉得我跟你们很合得来
Dialogue: 1,0:06:16.65,0:06:18.89,CN,,0,0,0,,综上 我们应该组队
Dialogue: 1,0:06:18.89,0:06:21.33,CN,,0,0,0,,诶？是这样吗？
Dialogue: 1,0:06:22.10,0:06:23.19,CN,,0,0,0,,真拿你没办法
Dialogue: 0,0:04:30.82,0:04:34.25,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:04:34.25,0:04:35.73,JP,,0,0,0,,クソッ…
Dialogue: 0,0:04:35.73,0:04:38.67,JP,,0,0,0,,クリアに　だいぶ時間　かかっちまったな
Dialogue: 0,0:04:38.67,0:04:40.25,JP,,0,0,0,,誰と組むか…
Dialogue: 0,0:04:40.60,0:04:41.88,JP,,0,0,0,,おっ　雷市
Dialogue: 0,0:04:42.51,0:04:43.69,JP,,0,0,0,,みんな　いないぞ
Dialogue: 0,0:04:44.30,0:04:46.14,JP,,0,0,0,,先　行ったっぽい
Dialogue: 0,0:04:46.14,0:04:49.30,JP,,0,0,0,,成早とか　成早とか…
Dialogue: 0,0:04:50.21,0:04:52.56,JP,,0,0,0,,いたとしても組むかよ　どうでもいい
Dialogue: 0,0:04:52.56,0:04:54.98,JP,,0,0,0,,ってか　お前しかいねえのかよ？
Dialogue: 0,0:04:54.98,0:04:58.86,JP,,0,0,0,,凪とか潔なら組んでみたいよな
Dialogue: 0,0:04:58.86,0:05:00.90,JP,,0,0,0,,つうかさ…
Dialogue: 0,0:05:00.90,0:05:03.33,JP,,0,0,0,,さっきから目障りだぞ　鰐間兄
Dialogue: 0,0:05:04.05,0:05:06.22,JP,,0,0,0,,なんの用だよ？ああ？
Dialogue: 0,0:05:06.22,0:05:08.22,JP,,0,0,0,,あっ　そっか
Dialogue: 0,0:05:08.22,0:05:10.96,JP,,0,0,0,,弟が通訳してたからな
Dialogue: 0,0:05:10.96,0:05:13.75,JP,,0,0,0,,何　言ってっか　解読してみるべ
Dialogue: 0,0:05:14.75,0:05:17.00,JP,,0,0,0,,すしはどこで食べれますか？
Dialogue: 0,0:05:20.29,0:05:22.55,JP,,0,0,0,,サムライはどこですか？
Dialogue: 0,0:05:25.47,0:05:27.76,JP,,0,0,0,,外国人観光客かよ
Dialogue: 0,0:05:27.76,0:05:31.77,JP,,0,0,0,,つうか　こんな裏切り者の片割れどうでもいいし
Dialogue: 0,0:05:31.77,0:05:33.93,JP,,0,0,0,,どうせまたイチャモンだろ
Dialogue: 0,0:05:33.93,0:05:36.02,JP,,0,0,0,,違～う
Dialogue: 0,0:05:36.38,0:05:40.19,JP,,0,0,0,,待てえ～い
Dialogue: 0,0:05:40.53,0:05:42.27,JP,,0,0,0,,普通にしゃべった
Dialogue: 0,0:05:42.27,0:05:44.44,JP,,0,0,0,,いいか　お前ら
Dialogue: 0,0:05:44.93,0:05:46.44,JP,,0,0,0,,雷市陣吾
Dialogue: 0,0:05:46.44,0:05:49.37,JP,,0,0,0,,まずお前の食らいつくプレースタイルが俺は好きだ
Dialogue: 0,0:05:49.37,0:05:52.18,JP,,0,0,0,,あれは凡人にできるレベルのものではない
Dialogue: 0,0:05:52.18,0:05:55.53,JP,,0,0,0,,その荒々しいさの中に光る洞察力と執念深さは
Dialogue: 0,0:05:55.53,0:05:59.18,JP,,0,0,0,,お前らがここまで来れた影の立役者と言っても過言ではない
Dialogue: 0,0:05:59.18,0:06:00.66,JP,,0,0,0,,そして我牙丸吟
Dialogue: 0,0:06:00.66,0:06:04.32,JP,,0,0,0,,お前の奇想天外かつ独創的なプレーはオンリーワンだ
Dialogue: 0,0:06:04.32,0:06:06.81,JP,,0,0,0,,一見　思いつきでプレーしてるように見えるが
Dialogue: 0,0:06:06.81,0:06:11.34,JP,,0,0,0,,実際はその柔軟なバネの身体能力に裏打ちされた最適な行動であり
Dialogue: 0,0:06:11.34,0:06:13.26,JP,,0,0,0,,俺の心をつかんで離さなかった
Dialogue: 0,0:06:13.89,0:06:16.65,JP,,0,0,0,,そして俺はお前らと合いそうな気がする
Dialogue: 0,0:06:16.65,0:06:18.89,JP,,0,0,0,,よって組むべきである
Dialogue: 0,0:06:18.89,0:06:21.33,JP,,0,0,0,,えっ？そうかな
Dialogue: 0,0:06:22.10,0:06:23.19,JP,,0,0,0,,しかたねえな
Dialogue: 0,0:06:32.74,0:06:35.66,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#18 帝襟安理的蓝色监狱日记！
Dialogue: 0,0:06:39.66,0:06:46.80,Sign,,0,0,0,,{\fad(300,300)\an9\c&H000000&\3c&HE6F3FA&}鸽子的姿势
Dialogue: 0,0:06:44.21,0:06:47.59,Sign,,0,0,0,,{\fad(300,300)\an9\c&H000000&\3c&HE6F3FA&}刚睡醒的绘心先生（笑）
Dialogue: 0,0:06:47.59,0:06:49.72,Sign,,0,0,0,,{\fad(300,300)\an9\c&H000000&\3c&HE6F3FA&}绘心先生只吃泡面 记得烧水

Dialogue: 0,0:00:02.54,0:00:05.21,Default,,0,0,0,,雄英是孕育了許多英雄的名門高校
Dialogue: 0,0:00:05.29,0:00:07.71,Default,,0,0,0,,進入雄英英雄科就讀的我
Dialogue: 0,0:00:08.34,0:00:10.43,Default,,0,0,0,,正朝著夢想努力邁進
Dialogue: 1,0:00:10.88,0:00:14.55,Default2,,0,0,0,,這一切都是為了成為
Dialogue: 0,0:00:10.88,0:00:14.55,Default,,0,0,0,,勇於面對任何困難
Dialogue: 1,0:00:15.30,0:00:18.64,Default2,,0,0,0,,並帶著笑容拯救人們的
Dialogue: 0,0:00:15.30,0:00:18.64,Default,,0,0,0,,最棒的英雄
Comment: 0,0:01:51.11,0:01:53.49,Default,,0,0,0,,（綠谷出久，個性，One For All）
Dialogue: 0,0:01:53.57,0:01:54.95,Default,,0,0,0,,綠谷少年
Dialogue: 0,0:01:55.03,0:01:56.07,Default,,0,0,0,,我啊
Dialogue: 0,0:01:56.61,0:01:58.74,Default,,0,0,0,,實質上已經退休了
Dialogue: 1,0:01:59.37,0:02:02.21,Default2,,0,0,0,,因為這副身體
Dialogue: 0,0:01:59.37,0:02:02.21,Default,,0,0,0,,已經再也沒有辦法戰鬥了
Dialogue: 0,0:02:04.16,0:02:06.83,Default,,0,0,0,,One For All的殘火已經熄滅
Dialogue: 0,0:02:07.08,0:02:07.91,Default,,0,0,0,,如你所見
Dialogue: 0,0:02:08.00,0:02:11.00,Default,,0,0,0,,我連好好維持英雄面貌也辦不到了
Dialogue: 0,0:02:12.13,0:02:13.13,Default,,0,0,0,,即使如此
Dialogue: 0,0:02:13.21,0:02:14.59,Default,,0,0,0,,不管我告誡過你多少次
Dialogue: 0,0:02:14.67,0:02:17.05,Default,,0,0,0,,你卻還是每次都會衝出去
Dialogue: 1,0:02:17.13,0:02:19.97,Default2,,0,0,0,,不管怎麼說
Dialogue: 0,0:02:17.13,0:02:19.97,Default,,0,0,0,,你還是不斷搞壞自己的身體
Dialogue: 0,0:02:20.22,0:02:22.14,Default,,0,0,0,,所以說，這一次…
Dialogue: 0,0:02:24.64,0:02:28.14,Default,,0,0,0,,頭一次看到你毫髮無傷地全身而退
Dialogue: 0,0:02:28.77,0:02:30.52,Default,,0,0,0,,讓我非常高興
Dialogue: 0,0:02:32.57,0:02:36.20,Default,,0,0,0,,接下來我會專心栽培你的
Dialogue: 0,0:02:36.28,0:02:37.74,Default,,0,0,0,,我們就照這個步調
Dialogue: 0,0:02:38.20,0:02:39.70,Default,,0,0,0,,一起加油吧
Dialogue: 0,0:02:40.78,0:02:41.87,Default,,0,0,0,,歐爾…
Dialogue: 0,0:02:41.95,0:02:43.74,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:02:43.83,0:02:45.08,Default,,0,0,0,,我…
Dialogue: 0,0:02:46.00,0:02:47.54,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:02:49.04,0:02:50.29,Default,,0,0,0,,奇怪？
Dialogue: 0,0:02:50.37,0:02:51.66,Default,,0,0,0,,這裡…
Dialogue: 0,0:02:52.25,0:02:54.84,Default,,0,0,0,,對喔，我已經離開家了
Comment: 0,0:02:55.25,0:02:56.84,Default,,0,0,0,,（飯田天哉，個性，引擎）
Dialogue: 0,0:02:58.17,0:02:59.21,Default,,0,0,0,,早安
Dialogue: 0,0:03:01.84,0:03:05.18,Default,,0,0,0,,遭到惡人聯軍二度襲擊的雄英高中
Dialogue: 0,0:03:05.26,0:03:07.05,Default,,0,0,0,,為了保護學生
Dialogue: 0,0:03:07.14,0:03:09.18,Default,,0,0,0,,推行了全體住宿制
Dialogue: 0,0:03:10.98,0:03:12.94,Default,,0,0,0,,從雄英校舍徒步五分鐘
Dialogue: 0,0:03:13.02,0:03:15.06,Default,,0,0,0,,我們就在這一棟落成三天的學生宿舍
Dialogue: 0,0:03:15.15,0:03:16.74,Default,,0,0,0,,華寓聯盟
Dialogue: 0,0:03:17.03,0:03:19.53,Default,,0,0,0,,展開了新生活
Dialogue: 0,0:03:20.70,0:03:22.87,Default,,0,0,0,,以英雄為目標度過每一天
Dialogue: 0,0:03:25.41,0:03:27.50,Default,,0,0,0,,我絕對會成為英雄
Dialogue: 0,0:03:27.58,0:03:30.29,Default,,0,0,0,,因為我從歐爾麥特那裡繼承了力量
Dialogue: 0,0:03:30.92,0:03:32.88,Default,,0,0,0,,One For All
Dialogue: 0,0:03:32.96,0:03:34.84,Default,,0,0,0,,跟歐爾麥特的意志
Dialogue: 0,0:03:40.09,0:03:41.84,Default,,0,0,0,,我昨天也跟你們說過了
Dialogue: 0,0:03:42.43,0:03:44.22,Default,,0,0,0,,英雄科一年A班
Dialogue: 0,0:03:44.30,0:03:46.55,Default,,0,0,0,,眼前的目標就是取得臨時證照
Dialogue: 0,0:03:46.64,0:03:47.72,Default,,0,0,0,,是
Dialogue: 0,0:03:48.43,0:03:50.10,Default,,0,0,0,,這是關乎到人命
Dialogue: 1,0:03:50.18,0:03:53.56,Default2,,0,0,0,,並且要肩負起重大責任的
Dialogue: 0,0:03:50.18,0:03:53.56,Default,,0,0,0,,正式官方證照
Dialogue: 0,0:03:54.06,0:03:55.02,Default,,0,0,0,,當然了
Dialogue: 0,0:03:55.11,0:03:57.32,Default,,0,0,0,,拿到臨時證照的測驗非常嚴苛
Dialogue: 0,0:03:57.82,0:03:59.03,Default,,0,0,0,,雖說是臨時證照
Dialogue: 0,0:03:59.11,0:04:02.07,Default,,0,0,0,,但是每年的合格率就只有一半
Dialogue: 0,0:04:02.15,0:04:04.86,Default,,0,0,0,,臨時證照真的這麼難拿到嗎？
Dialogue: 0,0:04:04.95,0:04:07.45,Default,,0,0,0,,所以從今天開始
Dialogue: 0,0:04:07.54,0:04:09.29,Default,,0,0,0,,你們每個人最起碼…
Dialogue: 0,0:04:11.83,0:04:13.79,Default,,0,0,0,,要開發兩樣必殺技
Dialogue: 0,0:04:13.87,0:04:15.33,Default,,0,0,0,,開發必殺技？
Dialogue: 0,0:04:15.42,0:04:17.59,Default,,0,0,0,,非常有學校氣氛
Dialogue: 0,0:04:17.67,0:04:19.88,Default,,0,0,0,,非常有英雄味的考驗
Dialogue: 0,0:04:21.42,0:04:22.88,Default,,0,0,0,,“必殺”，此二字
Dialogue: 0,0:04:22.97,0:04:26.43,Default,,0,0,0,,意即必勝套路，必勝招式是也
Dialogue: 1,0:04:26.51,0:04:31.31,Default2,,0,0,0,,由你們自身開發的招式、套路
Dialogue: 0,0:04:26.51,0:04:31.31,Default,,0,0,0,,會是他人遠遠不及的
Dialogue: 1,0:04:31.39,0:04:35.23,Default2,,0,0,0,,戰鬥就要看你怎麼
Dialogue: 0,0:04:31.39,0:04:35.23,Default,,0,0,0,,用拿手絕活壓制對手
Dialogue: 0,0:04:35.31,0:04:37.56,Default,,0,0,0,,招式就是自身的象徵
Dialogue: 1,0:04:37.65,0:04:42.11,Default2,,0,0,0,,現在沒有必殺技的職業英雄
Dialogue: 0,0:04:37.65,0:04:42.11,Default,,0,0,0,,已經是瀕臨絕種的動物了
Dialogue: 1,0:04:42.61,0:04:46.28,Default2,,0,0,0,,詳細會在實際演練
Dialogue: 0,0:04:42.61,0:04:46.28,Default,,0,0,0,,按照理論傳授給各位
Dialogue: 0,0:04:46.74,0:04:47.99,Default,,0,0,0,,請各位換上戰鬥服
Dialogue: 0,0:04:48.08,0:04:49.83,Default,,0,0,0,,到伽馬體育館集合
Dialogue: 0,0:04:52.91,0:04:53.87,Default,,0,0,0,,（伽馬體育館）
Dialogue: 0,0:04:53.96,0:04:55.30,Default,,0,0,0,,伽馬體育館
Dialogue: 0,0:04:55.37,0:04:59.00,Default,,0,0,0,,通稱“訓練的廚房園地”
Dialogue: 0,0:04:59.09,0:05:01.01,Default,,0,0,0,,簡稱為TDL
Dialogue: 0,0:05:01.67,0:05:03.92,Default,,0,0,0,,這簡稱不會被告嗎？
Dialogue: 0,0:05:05.84,0:05:07.84,Default,,0,0,0,,這裡是我設計的建築
Dialogue: 1,0:05:08.26,0:05:11.81,Default2,,0,0,0,,可以為每一位學生
Dialogue: 0,0:05:08.26,0:05:11.81,Default,,0,0,0,,量身打造地形或是道具
Dialogue: 0,0:05:12.31,0:05:14.56,Default,,0,0,0,,所謂的“廚房”就是這麼來的
Dialogue: 0,0:05:14.64,0:05:15.98,Default,,0,0,0,,原來是這樣
Dialogue: 0,0:05:16.52,0:05:18.02,Default,,0,0,0,,老師，請容我提出問題
Dialogue: 1,0:05:18.11,0:05:21.41,Default2,,0,0,0,,為什麼取得臨時證照
Dialogue: 0,0:05:18.11,0:05:21.41,Default,,0,0,0,,會需要必殺技呢？
Dialogue: 0,0:05:21.48,0:05:23.11,Default,,0,0,0,,請說明這麼做的用意
Dialogue: 0,0:05:23.19,0:05:26.11,Default,,0,0,0,,我會按部就班解釋，不用著急
Dialogue: 1,0:05:27.20,0:05:31.20,Default2,,0,0,0,,英雄的工作就是要在
Dialogue: 0,0:05:27.20,0:05:31.20,Default,,0,0,0,,事件、事故、天災、人禍
Dialogue: 0,0:05:31.29,0:05:34.50,Default,,0,0,0,,這類麻煩的緊急狀況下拯救民眾
Dialogue: 1,0:05:34.75,0:05:38.96,Default2,,0,0,0,,證照考試當然就是要看考生
Dialogue: 0,0:05:34.75,0:05:38.96,Default,,0,0,0,,適不適合這份工作
Dialogue: 0,0:05:39.34,0:05:41.13,Default,,0,0,0,,情蒐力、判斷力
Dialogue: 0,0:05:41.21,0:05:43.21,Default,,0,0,0,,機動力、戰鬥力
Dialogue: 0,0:05:43.30,0:05:45.89,Default,,0,0,0,,另外也要看溝通能力
Dialogue: 0,0:05:45.97,0:05:48.22,Default,,0,0,0,,魅力跟領導能力等等
Dialogue: 1,0:05:48.30,0:05:51.51,Default2,,0,0,0,,每年不同的測驗內容
Dialogue: 0,0:05:48.30,0:05:51.51,Default,,0,0,0,,都會考驗上述能力
Dialogue: 0,0:05:52.14,0:05:54.10,Default,,0,0,0,,其中戰鬥力尤其重要
Dialogue: 0,0:05:54.18,0:05:55.35,Default,,0,0,0,,對英雄來說
Dialogue: 0,0:05:55.43,0:05:57.68,Default,,0,0,0,,這將會是一直備受各方重視的項目
Dialogue: 0,0:05:58.44,0:06:00.28,Default,,0,0,0,,俗話說得好，有備無患
Dialogue: 0,0:06:00.56,0:06:03.31,Default,,0,0,0,,有沒有必殺技將會大大左右測驗結果
Dialogue: 1,0:06:03.73,0:06:07.53,Default2,,0,0,0,,只要不被環境影響
Dialogue: 0,0:06:03.73,0:06:07.53,Default,,0,0,0,,並穩定地採取行動的話
Dialogue: 0,0:06:07.91,0:06:11.58,Default,,0,0,0,,就會被認定具備極高的戰鬥力
Dialogue: 0,0:06:11.74,0:06:15.24,Default,,0,0,0,,必殺技並非一定要屬於攻擊招式
Dialogue: 0,0:06:15.33,0:06:18.46,Default,,0,0,0,,比方說飯田同學的往復式爆速
Dialogue: 0,0:06:18.54,0:06:20.42,Default,,0,0,0,,瞬間的超高速移動
Dialogue: 0,0:06:20.50,0:06:22.63,Default,,0,0,0,,由於本身就具有相當的威脅性
Dialogue: 0,0:06:22.71,0:06:24.84,Default,,0,0,0,,也足以被稱為必殺技
Dialogue: 0,0:06:25.88,0:06:28.34,Default,,0,0,0,,那也可以算是必殺技嗎？
Dialogue: 0,0:06:28.43,0:06:30.39,Default,,0,0,0,,也就是說要創造出自己認為
Dialogue: 1,0:06:30.47,0:06:34.27,Default2,,0,0,0,,只要使出這一招就對自己有利
Dialogue: 0,0:06:30.47,0:06:34.27,Default,,0,0,0,,可以致勝的招式囉
Dialogue: 0,0:06:34.35,0:06:35.98,Default,,0,0,0,,就是這樣沒錯
Dialogue: 1,0:06:36.06,0:06:39.56,Default2,,0,0,0,,前幾天，大為活躍的森林神威
Dialogue: 0,0:06:36.06,0:06:39.56,Default,,0,0,0,,他的漆樹鎖牢
Dialogue: 0,0:06:39.65,0:06:41.49,Default,,0,0,0,,就是標準的必殺技
Dialogue: 0,0:06:41.56,0:06:44.06,Default,,0,0,0,,在對手出招前，先限制他的行動
Dialogue: 0,0:06:44.27,0:06:46.06,Default,,0,0,0,,被迫中斷的林間集訓
Dialogue: 0,0:06:46.24,0:06:49.16,Default,,0,0,0,,曾要你們進行強化個性的訓練
Dialogue: 0,0:06:49.28,0:06:52.24,Default,,0,0,0,,就是用來創造必殺技的學習過程
Dialogue: 0,0:06:53.20,0:06:54.33,Default,,0,0,0,,也就是說
Dialogue: 0,0:06:54.79,0:06:56.58,Default,,0,0,0,,到下學期開學之前
Dialogue: 0,0:06:56.66,0:06:59.04,Default,,0,0,0,,僅剩十幾天的暑假
Dialogue: 0,0:06:59.12,0:07:00.50,Default,,0,0,0,,你們得繼續強化個性
Dialogue: 0,0:07:00.58,0:07:02.42,Default,,0,0,0,,並創造出必殺技
Dialogue: 0,0:07:03.46,0:07:05.38,Default,,0,0,0,,進行壓縮訓練
Dialogue: 0,0:07:06.00,0:07:06.84,Default,,0,0,0,,此外
Dialogue: 1,0:07:06.92,0:07:09.17,Default2,,0,0,0,,你們也要思考
Dialogue: 0,0:07:06.92,0:07:09.17,Default,,0,0,0,,該怎麼針對強化後的個性
Dialogue: 0,0:07:09.34,0:07:12.55,Default,,0,0,0,,還要根據招式特質，改良戰鬥服
Dialogue: 0,0:07:13.85,0:07:16.39,Default,,0,0,0,,用超越巔峰的精神跨越難關
Dialogue: 0,0:07:16.93,0:07:18.27,Default,,0,0,0,,準備好了嗎？
Dialogue: 0,0:07:18.35,0:07:19.35,Default,,0,0,0,,好了
Dialogue: 0,0:07:19.44,0:07:21.48,Default,,0,0,0,,我開始興奮起來啦
Dialogue: 0,0:07:23.86,0:07:25.11,Default,,0,0,0,,怎麼辦？
Dialogue: 1,0:07:35.08,0:07:38.21,Default2,,0,0,0,,你的動作很明顯在說
Dialogue: 0,0:07:35.08,0:07:38.21,Default,,0,0,0,,有尾巴就該這麼動
Dialogue: 0,0:07:38.45,0:07:40.83,Default,,0,0,0,,從最基礎的周旋動作開始檢視吧
Dialogue: 0,0:07:40.91,0:07:41.87,Default,,0,0,0,,好的
Dialogue: 0,0:07:42.29,0:07:44.33,Default,,0,0,0,,也就是說這招很普通囉
Dialogue: 0,0:07:45.63,0:07:46.97,Default,,0,0,0,,看我的必殺技
Dialogue: 0,0:07:47.05,0:07:48.93,Default,,0,0,0,,從手中噴出酸液
Dialogue: 0,0:07:49.01,0:07:50.39,Default,,0,0,0,,接招
Dialogue: 0,0:07:51.13,0:07:52.21,Default,,0,0,0,,這招怎麼樣？
Dialogue: 0,0:07:52.30,0:07:54.68,Default,,0,0,0,,如果打算朝那個方向發揮的話
Dialogue: 0,0:07:54.76,0:07:56.60,Default,,0,0,0,,試試看用手指
Dialogue: 0,0:07:56.68,0:07:57.97,Default,,0,0,0,,縮小噴射口
Dialogue: 0,0:07:58.06,0:07:58.94,Default,,0,0,0,,對
Dialogue: 0,0:08:00.56,0:08:02.27,Default,,0,0,0,,噴射距離變遠了
Dialogue: 0,0:08:02.64,0:08:05.73,Default,,0,0,0,,重點就放在射程跟瞄準目標上吧
Dialogue: 0,0:08:06.48,0:08:08.65,Default,,0,0,0,,試著同時創造兩樣物品
Dialogue: 0,0:08:08.73,0:08:10.40,Default,,0,0,0,,從簡單的開始就好
Dialogue: 0,0:08:10.49,0:08:11.82,Default,,0,0,0,,好的
Dialogue: 0,0:08:16.99,0:08:18.83,Default,,0,0,0,,大家都有所進展
Dialogue: 0,0:08:19.91,0:08:21.87,Default,,0,0,0,,為什麼站在原地發呆？
Dialogue: 0,0:08:23.12,0:08:25.33,Default,,0,0,0,,那個…關於必殺技
Dialogue: 0,0:08:25.42,0:08:27.88,Default,,0,0,0,,其實我的手臂有個不定時炸彈
Dialogue: 0,0:08:27.96,0:08:29.96,Default,,0,0,0,,所以不能太過逞強
Dialogue: 0,0:08:30.46,0:08:31.54,Default,,0,0,0,,老實說
Dialogue: 0,0:08:31.63,0:08:34.59,Default,,0,0,0,,我完全想不到要創造什麼必殺技
Dialogue: 1,0:08:36.14,0:08:40.85,Default2,,0,0,0,,就某方面來說，你的個性
Dialogue: 0,0:08:36.14,0:08:40.85,Default,,0,0,0,,的確離穩定行動還遠得很
Dialogue: 0,0:08:41.27,0:08:43.56,Default,,0,0,0,,既然你的風格還沒固定
Dialogue: 0,0:08:43.64,0:08:46.06,Default,,0,0,0,,今天就先專心強化自己的個性
Dialogue: 0,0:08:46.77,0:08:47.85,Default,,0,0,0,,好的
Dialogue: 0,0:08:51.28,0:08:53.07,Default,,0,0,0,,大家都很努力嘛
Dialogue: 0,0:08:54.24,0:08:55.32,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:08:55.41,0:08:56.75,Default,,0,0,0,,我雖然…
Dialogue: 0,0:08:57.99,0:09:01.12,Default,,0,0,0,,沒被找來，但今天也沒什麼事要忙
Dialogue: 0,0:09:01.50,0:09:02.54,Default,,0,0,0,,所以就來了
Dialogue: 0,0:09:02.70,0:09:04.99,Default,,0,0,0,,不，請你在家好好休養
Dialogue: 0,0:09:05.08,0:09:06.67,Default,,0,0,0,,得放眼下學期
Dialogue: 0,0:09:07.54,0:09:08.67,Default,,0,0,0,,別這麼冷淡
Dialogue: 0,0:09:08.75,0:09:10.63,Default,,0,0,0,,這堂課在上必殺技吧
Dialogue: 0,0:09:10.80,0:09:13.22,Default,,0,0,0,,我理所當然會想過來看看啊
Dialogue: 0,0:09:13.55,0:09:15.51,Default,,0,0,0,,畢竟我也是位老師嘛
Dialogue: 0,0:09:17.59,0:09:18.84,Default,,0,0,0,,看樣子
Dialogue: 0,0:09:18.97,0:09:20.76,Default,,0,0,0,,綠谷少年非常苦惱
Dialogue: 0,0:09:23.52,0:09:25.40,Default,,0,0,0,,吃我這一招
Dialogue: 0,0:09:28.86,0:09:31.49,Default,,0,0,0,,好久沒這樣使出全力了，真爽快
Dialogue: 0,0:09:31.78,0:09:32.87,Default,,0,0,0,,靈質
Dialogue: 0,0:09:32.94,0:09:33.90,Default,,0,0,0,,這一個掛了
Dialogue: 0,0:09:33.99,0:09:35.58,Default,,0,0,0,,再派一個分身來
Dialogue: 0,0:09:35.95,0:09:37.74,Default,,0,0,0,,他還真厲害耶
Dialogue: 0,0:09:38.95,0:09:41.62,Default,,0,0,0,,看他那樣，肯定會越來越厲害
Dialogue: 0,0:09:45.96,0:09:48.00,Default,,0,0,0,,爆豪同學還真有幹勁
Dialogue: 1,0:09:48.08,0:09:51.38,Default2,,0,0,0,,我看他應該想到不少
Dialogue: 0,0:09:48.08,0:09:51.38,Default,,0,0,0,,必殺技的雛型了吧
Dialogue: 1,0:09:51.46,0:09:54.30,Default2,,0,0,0,,畢竟他從入學開始
Dialogue: 0,0:09:51.46,0:09:54.30,Default,,0,0,0,,就會幫招式取名字啊
Dialogue: 0,0:09:55.42,0:09:56.71,Default,,0,0,0,,專心
Dialogue: 0,0:09:56.80,0:09:57.63,Default,,0,0,0,,好的
Dialogue: 1,0:09:57.72,0:10:00.14,Default2,,0,0,0,,我有一個從小就已經想好的
Dialogue: 0,0:09:57.72,0:10:00.14,Default,,0,0,0,,必殺技名字喔
Dialogue: 0,0:10:00.22,0:10:02.18,Default,,0,0,0,,就叫做葡萄衝刺
Dialogue: 0,0:10:02.26,0:10:04.55,Default,,0,0,0,,應該說大家一定都想過吧
Dialogue: 0,0:10:04.64,0:10:07.10,Default,,0,0,0,,我的招式名稱叫電擊劍
Dialogue: 0,0:10:07.19,0:10:09.65,Default,,0,0,0,,一想到這件事終於可以實現
Dialogue: 0,0:10:09.73,0:10:11.52,Default,,0,0,0,,不自覺地就興奮起來啦
Dialogue: 0,0:10:13.11,0:10:15.86,Default,,0,0,0,,這雙手能使出什麼樣的必殺技？
Dialogue: 0,0:10:18.66,0:10:19.87,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:10:20.24,0:10:21.49,Default,,0,0,0,,給你個建議
Dialogue: 0,0:10:22.53,0:10:25.91,Default,,0,0,0,,你還是一直試圖在模仿我喔
Dialogue: 0,0:10:27.29,0:10:28.92,Default,,0,0,0,,這什麼意思？
Dialogue: 0,0:10:29.54,0:10:30.71,Default,,0,0,0,,切島少年
Dialogue: 0,0:10:30.79,0:10:31.92,Default,,0,0,0,,歐爾麥特
Dialogue: 0,0:10:32.00,0:10:34.46,Default,,0,0,0,,我來到處給大家建議囉
Dialogue: 0,0:10:35.96,0:10:37.17,Default,,0,0,0,,關於你的硬化
Dialogue: 0,0:10:37.26,0:10:38.68,Default,,0,0,0,,與其想些小花招
Dialogue: 0,0:10:38.76,0:10:40.30,Default,,0,0,0,,不如就直接硬碰硬吧
Dialogue: 0,0:10:40.51,0:10:41.51,Default,,0,0,0,,好的
Dialogue: 0,0:10:42.43,0:10:45.81,Default,,0,0,0,,一味告訴學生答案並不能稱為教育
Dialogue: 0,0:10:46.14,0:10:47.85,Default,,0,0,0,,好好思考吧，少年
Dialogue: 0,0:10:48.31,0:10:50.23,Default,,0,0,0,,重點不在於對或者是錯
Dialogue: 0,0:10:50.40,0:10:53.95,Default,,0,0,0,,而是要靠自己去察覺啊
Dialogue: 0,0:10:55.07,0:10:56.15,Default,,0,0,0,,耳郎少女
Dialogue: 0,0:10:56.53,0:10:58.37,Default,,0,0,0,,我來到處給大家建議囉
Dialogue: 0,0:10:58.45,0:11:00.20,Default,,0,0,0,,他怎麼突然這樣？

Dialogue: 0,0:11:01.82,0:11:03.86,Defaultup,,0,0,0,,（《就算超笨也可以當老師簡單教育理論》）

Dialogue: 0,0:11:09.16,0:11:11.12,Default,,0,0,0,,關於戰鬥服要怎麼改良
Dialogue: 0,0:11:11.21,0:11:13.67,Default,,0,0,0,,我想門外漢想破頭也想不到
Dialogue: 0,0:11:14.54,0:11:16.38,Default,,0,0,0,,如果有什麼地方想調整
Dialogue: 0,0:11:16.71,0:11:18.84,Default,,0,0,0,,就走一趟校舍一樓的開發工坊
Dialogue: 0,0:11:18.92,0:11:20.88,Default,,0,0,0,,問問專家吧
Dialogue: 0,0:11:24.47,0:11:27.60,Default,,0,0,0,,你還是一直試圖在模仿我喔
Dialogue: 1,0:11:29.06,0:11:32.77,Default2,,0,0,0,,雖然我還不知道歐爾麥特
Dialogue: 0,0:11:29.06,0:11:32.77,Default,,0,0,0,,說那句話有什麼用意
Dialogue: 0,0:11:33.40,0:11:36.36,Default,,0,0,0,,可是，要是手臂報銷的話就慘了
Dialogue: 0,0:11:37.03,0:11:38.12,Default,,0,0,0,,如果有什麼
Dialogue: 1,0:11:38.19,0:11:41.65,Default2,,0,0,0,,能輔助手臂活動的
Dialogue: 0,0:11:38.19,0:11:41.65,Default,,0,0,0,,像護具的東西就好了
Dialogue: 1,0:11:43.45,0:11:47.08,Default2,,0,0,0,,我得好好鍛鍊身體
Dialogue: 0,0:11:43.45,0:11:47.08,Default,,0,0,0,,提高One For All的容許上限
Dialogue: 0,0:11:47.58,0:11:49.79,Default,,0,0,0,,想出並完成必殺技
Dialogue: 0,0:11:50.62,0:11:52.58,Default,,0,0,0,,為了不要被大家拋在後頭
Dialogue: 0,0:11:52.67,0:11:53.75,Default,,0,0,0,,不對
Dialogue: 0,0:11:54.08,0:11:55.67,Default,,0,0,0,,我得成為頂尖
Dialogue: 0,0:11:57.21,0:11:58.29,Default,,0,0,0,,原來如此
Dialogue: 0,0:11:58.38,0:12:00.59,Default,,0,0,0,,妳要專注讓自己浮起來啊
Dialogue: 0,0:12:01.43,0:12:02.85,Default,,0,0,0,,只要提高機動力
Dialogue: 1,0:12:02.93,0:12:05.98,Default2,,0,0,0,,我就能更活用
Dialogue: 0,0:12:02.93,0:12:05.98,Default,,0,0,0,,在職場體驗學到的格鬥技
Dialogue: 0,0:12:06.05,0:12:07.09,Default,,0,0,0,,飯田同學呢？
Dialogue: 0,0:12:07.18,0:12:10.64,Default,,0,0,0,,我想要減輕往復式爆速的負面影響
Dialogue: 1,0:12:10.73,0:12:14.23,Default2,,0,0,0,,所以才想去開發工坊
Dialogue: 0,0:12:10.73,0:12:14.23,Default,,0,0,0,,請他們幫忙改良散熱器
Dialogue: 0,0:12:16.61,0:12:17.78,Default,,0,0,0,,是笨久同學
Dialogue: 0,0:12:17.86,0:12:19.28,Default,,0,0,0,,難怪剛剛沒看到你
Dialogue: 0,0:12:19.36,0:12:20.65,Default,,0,0,0,,不能在走廊上奔跑
Dialogue: 0,0:12:20.74,0:12:22.70,Default,,0,0,0,,笨久同學也要改良戰鬥服嗎？
Dialogue: 0,0:12:23.16,0:12:24.58,Default,,0,0,0,,麗日同…
Dialogue: 0,0:12:31.83,0:12:34.50,Default,,0,0,0,,好痛，痛死我了
Dialogue: 0,0:12:34.79,0:12:36.04,Default,,0,0,0,,妳也真是的
Dialogue: 1,0:12:36.13,0:12:39.22,Default2,,0,0,0,,不要想到什麼東西
Dialogue: 0,0:12:36.13,0:12:39.22,Default,,0,0,0,,就一股腦地組裝在一起
Dialogue: 1,0:12:40.63,0:12:44.38,Default2,,0,0,0,,正所謂“失敗為發明之母”啊
Dialogue: 0,0:12:40.63,0:12:44.38,Default,,0,0,0,,工程機器人老師
Dialogue: 0,0:12:44.47,0:12:47.14,Default,,0,0,0,,湯瑪斯愛迪生也說過
Dialogue: 1,0:12:48.22,0:12:51.31,Default2,,0,0,0,,“就算做出來的成品機能
Dialogue: 0,0:12:48.22,0:12:51.31,Default,,0,0,0,,不如計畫預期
Dialogue: 0,0:12:51.39,0:12:53.27,Default,,0,0,0,,但是這些歷程也絕對不會白費”
Dialogue: 0,0:12:53.35,0:12:55.90,Default,,0,0,0,,我要跟妳說的，不是這件事啦
Dialogue: 0,0:12:55.98,0:12:57.15,Default,,0,0,0,,一次就好，發目
Dialogue: 0,0:12:57.23,0:12:59.48,Default,,0,0,0,,拜託妳，好好聽我說話
Dialogue: 0,0:13:00.23,0:13:02.61,Default,,0,0,0,,奇怪，你不就是之前那位…
Dialogue: 0,0:13:06.49,0:13:08.24,Default,,0,0,0,,胸…
Dialogue: 0,0:13:08.33,0:13:09.41,Default,,0,0,0,,胸部
Comment: 1,0:13:12.00,0:13:15.00,Default2,,0,0,0,,（綠谷出久，用代代傳承下來的
Comment: 0,0:13:12.00,0:13:15.00,Default,,0,0,0,,超強力量粉碎惡人）
Comment: 1,0:13:15.92,0:13:18.88,Default2,,0,0,0,,（發目明，可以清楚看見
Comment: 0,0:13:15.92,0:13:18.88,Default,,0,0,0,,五公里遠以上的東西）
Dialogue: 0,0:13:19.29,0:13:21.79,Default,,0,0,0,,不好意思，突然就搞了個大爆炸
Dialogue: 0,0:13:21.88,0:13:23.38,Default,,0,0,0,,真是好久不見了呢
Dialogue: 0,0:13:23.47,0:13:24.81,Default,,0,0,0,,英雄科的…
Dialogue: 0,0:13:26.09,0:13:28.34,Default,,0,0,0,,我把你們的名字通通忘光了
Dialogue: 0,0:13:28.43,0:13:30.52,Default,,0,0,0,,我叫做綠谷出久
Dialogue: 0,0:13:30.60,0:13:32.02,Default,,0,0,0,,我叫飯田天哉
Dialogue: 1,0:13:32.10,0:13:35.69,Default2,,0,0,0,,就是在運動會淘汰賽的時候
Dialogue: 0,0:13:32.10,0:13:35.69,Default,,0,0,0,,被妳當成活廣告利用的男人
Dialogue: 0,0:13:35.77,0:13:36.69,Default,,0,0,0,,是這樣嗎？
Dialogue: 0,0:13:36.77,0:13:39.44,Default,,0,0,0,,好了，我還要忙著開發寶貝，失陪啦
Dialogue: 0,0:13:39.52,0:13:41.15,Default,,0,0,0,,等等，那個…
Dialogue: 1,0:13:41.23,0:13:45.53,Default2,,0,0,0,,我想找工程機器人老師
Dialogue: 0,0:13:41.23,0:13:45.53,Default,,0,0,0,,討論怎麼改良戰鬥服
Dialogue: 0,0:13:45.65,0:13:47.53,Default,,0,0,0,,你要改良戰鬥服？
Dialogue: 0,0:13:47.86,0:13:48.86,Default,,0,0,0,,我非常有興趣
Dialogue: 0,0:13:48.95,0:13:49.87,Default,,0,0,0,,發目
Dialogue: 1,0:13:50.78,0:13:53.95,Default2,,0,0,0,,改成住宿制
Dialogue: 0,0:13:50.78,0:13:53.95,Default,,0,0,0,,妳要整天泡在工坊是無所謂
Dialogue: 1,0:13:54.37,0:13:57.92,Default2,,0,0,0,,但妳要再繼續胡鬧
Dialogue: 0,0:13:54.37,0:13:57.92,Default,,0,0,0,,我就要禁止妳出入這裡囉
Dialogue: 0,0:13:59.92,0:14:00.88,Default,,0,0,0,,那個…
Dialogue: 0,0:14:00.96,0:14:02.63,Default,,0,0,0,,我已經聽抹消磁頭說了
Dialogue: 1,0:14:02.71,0:14:05.30,Default2,,0,0,0,,為了配合必殺技
Dialogue: 0,0:14:02.71,0:14:05.30,Default,,0,0,0,,才要改良戰鬥服吧？
Dialogue: 0,0:14:05.38,0:14:06.38,Default,,0,0,0,,請進
Dialogue: 0,0:14:10.60,0:14:12.35,Default,,0,0,0,,這裡好像秘密基地喔
Dialogue: 0,0:14:12.64,0:14:13.52,Default,,0,0,0,,好了
Dialogue: 0,0:14:13.60,0:14:15.48,Default,,0,0,0,,讓我看看你的戰鬥服的說明書
Dialogue: 0,0:14:15.56,0:14:18.27,Default,,0,0,0,,應該就放在包裝盒裡面才對
Dialogue: 0,0:14:18.65,0:14:21.40,Default,,0,0,0,,我本身擁有戰鬥服製作的許可證
Dialogue: 0,0:14:21.48,0:14:23.90,Default,,0,0,0,,看過後能調整的地方我就會動手
Dialogue: 0,0:14:24.36,0:14:26.28,Default,,0,0,0,,如果只是小幅改良或維修
Dialogue: 0,0:14:26.36,0:14:29.45,Default,,0,0,0,,只要跟設計公司報告做了這樣的更動
Dialogue: 0,0:14:29.53,0:14:30.87,Default,,0,0,0,,他們就會幫忙記錄
Dialogue: 0,0:14:30.99,0:14:32.78,Default,,0,0,0,,但如果要大幅改良的話
Dialogue: 1,0:14:32.87,0:14:37.12,Default2,,0,0,0,,就會由我們這邊填寫申請書
Dialogue: 0,0:14:32.87,0:14:37.12,Default,,0,0,0,,再委託設計公司製作
Dialogue: 0,0:14:37.46,0:14:39.46,Default,,0,0,0,,之後，改良好的戰鬥服
Dialogue: 0,0:14:39.54,0:14:41.08,Default,,0,0,0,,會送交國家審查
Dialogue: 0,0:14:41.17,0:14:43.55,Default,,0,0,0,,拿到許可證之後就會寄回這裡
Dialogue: 0,0:14:44.21,0:14:47.30,Default,,0,0,0,,跟我們合作的設計公司是超一流的
Dialogue: 0,0:14:47.42,0:14:50.13,Default,,0,0,0,,所以大概花三天就能回來啦
Dialogue: 0,0:14:50.22,0:14:51.10,Default,,0,0,0,,老師
Dialogue: 1,0:14:51.18,0:14:55.18,Default2,,0,0,0,,我希望可以盡可能地
Dialogue: 0,0:14:51.18,0:14:55.18,Default,,0,0,0,,減輕我手臂韌帶的負擔
Dialogue: 0,0:14:55.27,0:14:57.69,Default,,0,0,0,,不知道辦不辦得到？
Dialogue: 0,0:14:58.23,0:14:59.73,Default,,0,0,0,,綠谷同學
Dialogue: 0,0:14:59.81,0:15:02.44,Default,,0,0,0,,你的戰鬥是使用拳頭或是手指吧
Dialogue: 1,0:15:02.52,0:15:05.98,Default2,,0,0,0,,這點要求只要稍微調整一下
Dialogue: 0,0:15:02.52,0:15:05.98,Default,,0,0,0,,馬上就能搞定
Dialogue: 0,0:15:07.03,0:15:08.45,Default,,0,0,0,,太好了，笨久同學
Dialogue: 0,0:15:14.33,0:15:15.29,Default,,0,0,0,,原來是這樣啊
Dialogue: 0,0:15:15.37,0:15:16.75,Default,,0,0,0,,發目同學
Dialogue: 0,0:15:16.83,0:15:18.08,Default,,0,0,0,,妳這是做什麼？
Dialogue: 0,0:15:18.62,0:15:20.66,Default,,0,0,0,,我正在摸他的身體呀
Dialogue: 0,0:15:21.04,0:15:24.04,Default,,0,0,0,,你身體比外表看起來結實呢
Dialogue: 0,0:15:24.63,0:15:25.92,Default,,0,0,0,,非常好
Dialogue: 0,0:15:26.00,0:15:27.63,Default,,0,0,0,,對於這樣的你
Dialogue: 0,0:15:28.67,0:15:30.34,Default,,0,0,0,,就給你我的壓箱寶貝
Dialogue: 0,0:15:30.43,0:15:31.93,Default,,0,0,0,,動力裝吧
Dialogue: 0,0:15:32.01,0:15:32.84,Default,,0,0,0,,那個…
Dialogue: 1,0:15:32.93,0:15:36.60,Default2,,0,0,0,,這個高科技孩子能感測肌肉收縮
Dialogue: 0,0:15:32.93,0:15:36.60,Default,,0,0,0,,進而輔助活動
Dialogue: 0,0:15:36.68,0:15:39.02,Default,,0,0,0,,是我第49個孩子唷
Dialogue: 0,0:15:39.56,0:15:42.23,Default,,0,0,0,,可是我只要手臂能有東西輔助就好
Dialogue: 0,0:15:42.31,0:15:43.39,Default,,0,0,0,,開始
Dialogue: 0,0:15:43.77,0:15:46.23,Default,,0,0,0,,好厲害，自己動起來了耶
Dialogue: 0,0:15:46.32,0:15:47.36,Default,,0,0,0,,奇怪，等等…
Dialogue: 0,0:15:47.44,0:15:48.94,Default,,0,0,0,,停不下來，等等
Dialogue: 0,0:15:49.03,0:15:50.49,Default,,0,0,0,,好痛…
Dialogue: 1,0:15:50.57,0:15:52.11,Default2,,0,0,0,,-笨久同學
Dialogue: 0,0:15:50.57,0:15:52.11,Default,,0,0,0,,-痛…
Dialogue: 1,0:15:52.20,0:15:53.24,Default2,,0,0,0,,-停下
Dialogue: 0,0:15:52.20,0:15:53.24,Default,,0,0,0,,-痛…
Dialogue: 1,0:15:53.32,0:15:56.49,Default2,,0,0,0,,看來設定可動範圍的程序
Dialogue: 0,0:15:53.32,0:15:56.49,Default,,0,0,0,,出了點問題呢
Dialogue: 0,0:15:56.58,0:15:57.71,Default,,0,0,0,,真對不起
Dialogue: 0,0:15:58.08,0:15:59.41,Default,,0,0,0,,你不要緊吧？
Dialogue: 0,0:15:59.50,0:16:01.13,Default,,0,0,0,,我明明是想讓手臂有個支撐
Dialogue: 0,0:16:01.21,0:16:03.50,Default,,0,0,0,,沒想到腰差點就被扭斷了
Dialogue: 0,0:16:03.63,0:16:06.68,Default,,0,0,0,,看來這套動力裝能用來當捕捉工具呢
Dialogue: 0,0:16:07.00,0:16:08.00,Default,,0,0,0,,那個…
Dialogue: 0,0:16:08.26,0:16:11.18,Default,,0,0,0,,我想請您幫忙強化腳部冷卻機
Dialogue: 0,0:16:11.51,0:16:13.85,Default,,0,0,0,,如果是這樣的話
Dialogue: 0,0:16:13.93,0:16:15.43,Default,,0,0,0,,就用這個寶貝
Dialogue: 1,0:16:16.10,0:16:19.98,Default2,,0,0,0,,能夠將發熱抑制到極限的
Dialogue: 0,0:16:16.10,0:16:19.98,Default,,0,0,0,,超級冷卻電動推進器
Dialogue: 0,0:16:20.06,0:16:21.81,Default,,0,0,0,,是我第36個孩子
Dialogue: 1,0:16:21.89,0:16:24.27,Default2,,0,0,0,,-發目同學，我要的不是推進器
Dialogue: 0,0:16:21.89,0:16:24.27,Default,,0,0,0,,-怎麼樣，很可愛吧？
Dialogue: 1,0:16:24.35,0:16:26.35,Default2,,0,0,0,,-而且為什麼裝在手臂？
Dialogue: 0,0:16:24.35,0:16:26.35,Default,,0,0,0,,-推進器，啟動
Dialogue: 0,0:16:27.86,0:16:30.11,Default,,0,0,0,,飯田同學！
Dialogue: 0,0:16:30.90,0:16:33.32,Default,,0,0,0,,我的個性用到的是腳耶
Dialogue: 0,0:16:34.36,0:16:35.24,Default,,0,0,0,,這我知道
Dialogue: 0,0:16:35.32,0:16:38.07,Default,,0,0,0,,但是呢，我是這麼想的
Dialogue: 0,0:16:38.16,0:16:40.25,Default,,0,0,0,,如果你想要冷卻腳的話
Dialogue: 0,0:16:40.33,0:16:42.87,Default,,0,0,0,,只要改用手臂奔跑不就可以了嗎？
Dialogue: 0,0:16:43.12,0:16:45.46,Default,,0,0,0,,受不了，妳在胡說什麼？
Dialogue: 0,0:16:45.58,0:16:47.50,Default,,0,0,0,,妳也給我收斂一點
Dialogue: 0,0:16:49.71,0:16:52.88,Default,,0,0,0,,你還是一直試圖在模仿我喔
Dialogue: 0,0:16:54.05,0:16:55.01,Default,,0,0,0,,我好像…
Dialogue: 0,0:16:56.51,0:16:57.51,Default,,0,0,0,,真不好意思
Dialogue: 0,0:16:57.60,0:17:00.14,Default,,0,0,0,,她那個人自我中心到有點病態了
Dialogue: 0,0:17:00.22,0:17:02.01,Default,,0,0,0,,這一點我深有體悟
Dialogue: 0,0:17:03.10,0:17:04.10,Default,,0,0,0,,不過呢
Dialogue: 0,0:17:04.27,0:17:06.06,Default,,0,0,0,,如果你們想當上英雄
Dialogue: 0,0:17:06.15,0:17:08.99,Default,,0,0,0,,就可要好好珍惜跟她之間的緣分喔
Dialogue: 0,0:17:10.15,0:17:12.86,Default,,0,0,0,,成為職業英雄後肯定會受她照顧
Dialogue: 0,0:17:13.19,0:17:14.69,Default,,0,0,0,,你們看看那邊
Dialogue: 0,0:17:15.95,0:17:17.45,Default,,0,0,0,,那堆垃圾山
Dialogue: 1,0:17:17.70,0:17:21.29,Default2,,0,0,0,,全部都是發目
Dialogue: 0,0:17:17.70,0:17:21.29,Default,,0,0,0,,她從入學後製作的輔助道具
Dialogue: 1,0:17:21.91,0:17:25.41,Default2,,0,0,0,,學校放假的時候
Dialogue: 0,0:17:21.91,0:17:25.41,Default,,0,0,0,,她也會來這裡玩東西
Dialogue: 0,0:17:25.83,0:17:28.25,Default,,0,0,0,,至今為止我也看過不少後勤科學生
Dialogue: 0,0:17:28.59,0:17:30.59,Default,,0,0,0,,但發目真的非常特別
Dialogue: 0,0:17:31.13,0:17:33.22,Default,,0,0,0,,開學到現在也不過四個多月
Dialogue: 0,0:17:33.30,0:17:34.51,Default,,0,0,0,,就累積這麼多
Dialogue: 0,0:17:38.55,0:17:39.84,Default,,0,0,0,,“所謂的常識
Dialogue: 0,0:17:39.93,0:17:42.73,Default,,0,0,0,,就是在18歲之前學到的偏見”
Dialogue: 0,0:17:43.18,0:17:45.27,Default,,0,0,0,,這是愛因斯坦說過的話
Dialogue: 0,0:17:46.10,0:17:47.98,Default,,0,0,0,,發目她不怕失敗
Dialogue: 0,0:17:48.15,0:17:50.69,Default,,0,0,0,,不斷發揮想像力進行嘗試
Dialogue: 0,0:17:51.07,0:17:53.16,Default,,0,0,0,,能帶來新發明的人
Dialogue: 0,0:17:53.23,0:17:55.15,Default,,0,0,0,,是不會被既定觀念束縛的
Dialogue: 0,0:17:57.78,0:18:00.99,Default,,0,0,0,,你還是一直試圖在模仿我喔
Dialogue: 1,0:18:01.08,0:18:03.83,Default2,,0,0,0,,-總覺得…
Dialogue: 0,0:18:01.08,0:18:03.83,Default,,0,0,0,,-可是對歐爾麥特的憧憬跟責任感
Dialogue: 1,0:18:03.91,0:18:05.54,Default2,,0,0,0,,-好像抓到…
Dialogue: 0,0:18:03.91,0:18:05.54,Default,,0,0,0,,-卻成了你的枷鎖
Dialogue: 1,0:18:05.62,0:18:07.79,Default2,,0,0,0,,-什麼了
Dialogue: 0,0:18:05.62,0:18:07.79,Default,,0,0,0,,-如果你想要冷卻腳的話
Dialogue: 0,0:18:07.87,0:18:10.41,Default,,0,0,0,,只要改用手臂奔跑不就可以了嗎？
Dialogue: 0,0:18:13.38,0:18:14.76,Default,,0,0,0,,我看到雛型了
Dialogue: 0,0:18:15.05,0:18:16.22,Default,,0,0,0,,飯田同學
Dialogue: 0,0:18:16.80,0:18:18.93,Default,,0,0,0,,我可以向你請教一些事情嗎？
Dialogue: 0,0:18:19.30,0:18:20.93,Default,,0,0,0,,雖然不知道你想請教什麼
Dialogue: 0,0:18:21.01,0:18:22.60,Default,,0,0,0,,但是你可能沒察覺到
Dialogue: 0,0:18:22.68,0:18:25.06,Default,,0,0,0,,改良戰鬥服的事完全沒有進展喔
Dialogue: 0,0:18:25.23,0:18:26.44,Default,,0,0,0,,我都忘了
Dialogue: 0,0:18:26.52,0:18:29.61,Default,,0,0,0,,笨久同學，你突然一掃陰霾了耶
Dialogue: 0,0:18:30.27,0:18:31.52,Default,,0,0,0,,是這樣嗎？
Dialogue: 0,0:18:31.65,0:18:33.19,Default,,0,0,0,,對了，麗日同學
Dialogue: 0,0:18:33.27,0:18:34.48,Default,,0,0,0,,妳要改良什麼地方呢？
Dialogue: 0,0:18:34.57,0:18:37.28,Default,,0,0,0,,我希望能夠降低暈眩嘔吐感
Dialogue: 0,0:18:37.45,0:18:39.12,Default,,0,0,0,,是這樣啊
Dialogue: 0,0:18:39.20,0:18:41.41,Default,,0,0,0,,如果是這樣的話，用這個怎麼樣？
Dialogue: 0,0:18:41.49,0:18:43.62,Default,,0,0,0,,那什麼？不會爆炸嗎？
Dialogue: 0,0:18:44.33,0:18:47.00,Default,,0,0,0,,只要這樣使用這個寶貝
Dialogue: 0,0:18:47.37,0:18:48.83,Default,,0,0,0,,冒出黑黑的東西了
Dialogue: 1,0:18:48.92,0:18:50.30,Default2,,0,0,0,,-發目同學
Dialogue: 0,0:18:48.92,0:18:50.30,Default,,0,0,0,,-發目同學
Dialogue: 0,0:18:53.80,0:18:55.26,Default,,0,0,0,,真對不起
Dialogue: 1,0:18:56.30,0:19:00.51,Default2,,0,0,0,,為了鍛鍊出自己的必殺技
Dialogue: 0,0:18:56.30,0:19:00.51,Default,,0,0,0,,大家都不斷地進行訓練
Comment: 0,0:19:03.56,0:19:05.65,Default,,0,0,0,,（瀨呂範太，個性，膠帶）
Dialogue: 0,0:19:13.90,0:19:15.78,Default,,0,0,0,,（抑制中）
Dialogue: 0,0:19:35.09,0:19:37.43,Default,,0,0,0,,相澤老師，有什麼進展嗎？
Dialogue: 0,0:19:37.59,0:19:39.09,Default,,0,0,0,,你怎麼又來了？
Dialogue: 0,0:19:39.17,0:19:40.67,Default,,0,0,0,,就一點一點囉
Dialogue: 0,0:19:43.97,0:19:45.18,Default,,0,0,0,,綠谷
Dialogue: 0,0:19:45.26,0:19:46.97,Default,,0,0,0,,你換戰鬥服了啊？
Dialogue: 0,0:19:48.31,0:19:51.15,Default,,0,0,0,,這是能夠減輕手臂負擔的輔助護具喔
Dialogue: 1,0:19:51.39,0:19:54.44,Default2,,0,0,0,,既然要換
Dialogue: 0,0:19:51.39,0:19:54.44,Default,,0,0,0,,怎麼不乾脆改變整體風格？
Dialogue: 0,0:19:54.52,0:19:55.77,Default,,0,0,0,,這樣很樸素耶
Dialogue: 0,0:19:57.32,0:19:58.40,Default,,0,0,0,,這樣就好了
Dialogue: 0,0:19:59.19,0:20:00.78,Default,,0,0,0,,這是入學禮物
Dialogue: 0,0:20:00.99,0:20:02.95,Default,,0,0,0,,雖然媽好像有點太著急了
Dialogue: 0,0:20:03.70,0:20:06.58,Default,,0,0,0,,我希望盡可能保持原來的設計
Dialogue: 0,0:20:09.04,0:20:11.50,Default,,0,0,0,,纏附吧，黑影
Dialogue: 0,0:20:11.58,0:20:12.71,Default,,0,0,0,,知道了
Dialogue: 0,0:20:14.75,0:20:16.59,Default,,0,0,0,,讓黑影纏附在我身上
Dialogue: 0,0:20:16.67,0:20:20.13,Default,,0,0,0,,可以彌補我身體上跟近身戰的弱點
Dialogue: 0,0:20:20.47,0:20:21.43,Default,,0,0,0,,這招就叫做
Dialogue: 0,0:20:22.38,0:20:24.13,Default,,0,0,0,,深淵闇軀
Dialogue: 0,0:20:24.22,0:20:25.68,Default,,0,0,0,,會不會有點拗口啊？
Dialogue: 0,0:20:25.76,0:20:27.85,Default,,0,0,0,,取好唸的名字也很重要喔
Dialogue: 0,0:20:27.97,0:20:28.93,Default,,0,0,0,,知道了
Dialogue: 0,0:20:29.02,0:20:32.11,Default,,0,0,0,,有些人好不容易才定下要走的風格
Dialogue: 1,0:20:32.60,0:20:36.31,Default2,,0,0,0,,另一方面
Dialogue: 0,0:20:32.60,0:20:36.31,Default,,0,0,0,,也有些人就快練成複數的招式了
Dialogue: 0,0:20:39.90,0:20:42.07,Default,,0,0,0,,不用集中在整片手掌
Dialogue: 0,0:20:42.24,0:20:44.83,Default,,0,0,0,,而是集中在一點後再引爆
Dialogue: 0,0:20:45.87,0:20:47.96,Default,,0,0,0,,穿甲彈
Dialogue: 0,0:20:50.79,0:20:52.21,Default,,0,0,0,,成功了
Dialogue: 0,0:20:52.46,0:20:56.21,Default,,0,0,0,,爆豪少年還是一樣格外有天分呢
Dialogue: 0,0:21:01.05,0:21:02.26,Default,,0,0,0,,上面
Dialogue: 0,0:21:14.23,0:21:18.11,Default,,0,0,0,,爆碎風
Dialogue: 0,0:21:20.65,0:21:23.90,Default,,0,0,0,,基本上歐爾麥特的必殺技是用拳頭
Dialogue: 1,0:21:24.65,0:21:27.90,Default2,,0,0,0,,所以繼承了One For All的我
Dialogue: 0,0:21:24.65,0:21:27.90,Default,,0,0,0,,也就下意識地
Dialogue: 0,0:21:27.99,0:21:30.28,Default,,0,0,0,,認定我也應該用拳頭
Dialogue: 0,0:21:31.16,0:21:32.70,Default,,0,0,0,,其實非常簡單
Dialogue: 0,0:21:33.20,0:21:35.95,Default,,0,0,0,,也因為太過單純，我連想都沒想到
Dialogue: 0,0:21:37.71,0:21:40.42,Default,,0,0,0,,既然手臂有隱憂，就以腳為主
Dialogue: 0,0:21:41.50,0:21:43.59,Default,,0,0,0,,One For All，全覆蓋
Dialogue: 0,0:21:43.67,0:21:45.59,Default,,0,0,0,,射門風格
Dialogue: 0,0:21:48.68,0:21:50.47,Default,,0,0,0,,正確答案
Comment: 0,0:23:21.44,0:23:22.61,Default,,0,0,0,,下集預告
Comment: 0,0:23:22.69,0:23:24.15,Default,,0,0,0,,One For All，全覆蓋
Comment: 0,0:23:24.23,0:23:25.11,Default,,0,0,0,,射門風格
Comment: 0,0:23:25.19,0:23:26.78,Default,,0,0,0,,戰鬥服伽馬
Comment: 0,0:23:26.86,0:23:28.40,Default,,0,0,0,,帶著這兩樣新武器
Comment: 0,0:23:28.49,0:23:30.95,Default,,0,0,0,,我即將挑戰英雄臨時證照測驗
Comment: 0,0:23:31.07,0:23:32.78,Default,,0,0,0,,下ㄧ集，測驗
Comment: 0,0:23:32.87,0:23:33.96,Default,,0,0,0,,更向前邁進吧
Comment: 0,0:23:34.03,0:23:35.45,Default,,0,0,0,,超越巔峰

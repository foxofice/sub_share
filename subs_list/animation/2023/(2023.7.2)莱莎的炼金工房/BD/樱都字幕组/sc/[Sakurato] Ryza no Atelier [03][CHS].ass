Dialogue: 0,0:01:58.85,0:02:03.52,Title,,0,0,0,,{\blur2\fad(350,0)\pos(1469.2,922)\3c&HA27E4F&}#03 记忆中的香味
Dialogue: 0,0:23:56.00,0:24:01.00,Next Title,,0,0,0,,{\bord2\blur2\3c&HF6C057&\pos(960,474)}#04 浸水坑道
Comment: 0,0:00:01.00,0:00:01.00,Default,,0,0,0,,==========Text==========
Dialogue: 0,0:00:03.28,0:00:04.07,Sub-CN,,0,0,0,,莱莎
Dialogue: 0,0:00:05.11,0:00:06.11,Sub-CN,,0,0,0,,这个是?
Dialogue: 0,0:00:07.00,0:00:09.27,Sub-CN,,0,0,0,,之前安佩尔用过的…
Dialogue: 0,0:00:10.30,0:00:11.08,Sub-CN,,0,0,0,,要给我吗
Dialogue: 0,0:00:11.72,0:00:13.68,Sub-CN,,0,0,0,,你也是炼金术师了
Dialogue: 0,0:00:14.15,0:00:16.79,Sub-CN,,0,0,0,,总不能一直空手冒险
Dialogue: 0,0:00:17.21,0:00:19.88,Sub-CN,,0,0,0,,有了它炼金应该也能变得顺利一点
Dialogue: 0,0:00:23.86,0:00:27.40,Sub-CN,,0,0,0,,好喔 我要用它不断地调和了
Dialogue: 0,0:02:06.71,0:02:11.22,Sub-CN,,0,0,0,,不错嘛 接下来要做什么呢
Dialogue: 0,0:02:21.03,0:02:23.41,Sub-CN,,0,0,0,,这次又要去哪啊
Dialogue: 0,0:02:23.50,0:02:25.37,Sub-CN,,0,0,0,,妈…妈妈
Dialogue: 0,0:02:26.75,0:02:28.33,Sub-CN,,0,0,0,,我有点重要的事情
Dialogue: 0,0:02:28.88,0:02:29.96,Sub-CN,,0,0,0,,这样啊
Dialogue: 0,0:02:30.57,0:02:33.67,Sub-CN,,0,0,0,,那么拜托你顺便去帕特先生那边跑个腿
Dialogue: 0,0:02:33.90,0:02:37.34,Sub-CN,,0,0,0,,所以说 我才没有那么多闲工夫啊
Dialogue: 0,0:02:37.34,0:02:38.76,Sub-CN,,0,0,0,,别废话了快去
Dialogue: 0,0:02:39.33,0:02:42.06,Sub-CN,,0,0,0,,不然我就要给阁楼上锁了
Dialogue: 0,0:02:42.06,0:02:43.22,Sub-CN,,0,0,0,,呃…
Dialogue: 0,0:02:47.75,0:02:49.36,Sub-CN,,0,0,0,,你好 莱莎
Dialogue: 0,0:02:49.36,0:02:51.40,Sub-CN,,0,0,0,,啊 科洛蒂娅 你是要外出吗
Dialogue: 0,0:02:51.72,0:02:53.34,Sub-CN,,0,0,0,,嗯 出来散散步
Dialogue: 0,0:02:57.79,0:03:00.86,Sub-CN,,0,0,0,,莱莎也说不赢妈妈呀
Dialogue: 0,0:03:01.25,0:03:03.70,Sub-CN,,0,0,0,,她完全不懂我 好烦人
Dialogue: 0,0:03:04.06,0:03:06.07,Sub-CN,,0,0,0,,做炼金术师开心吗
Dialogue: 0,0:03:06.07,0:03:08.73,Sub-CN,,0,0,0,,嗯 我已经完全痴迷了
Dialogue: 0,0:03:10.17,0:03:15.88,Sub-CN,,0,0,0,,不光是我哦 兰托和塔奥看起来也找到了自己想做的事情
Dialogue: 0,0:03:16.92,0:03:18.59,Sub-CN,,0,0,0,,这样真好呀
Dialogue: 0,0:03:19.32,0:03:19.99,Sub-CN,,0,0,0,,没什么
Dialogue: 0,0:03:20.43,0:03:22.79,Sub-CN,,0,0,0,,那个 要不要来我家
Dialogue: 0,0:03:23.15,0:03:24.81,Sub-CN,,0,0,0,,我有事想和你说
Dialogue: 0,0:03:25.03,0:03:27.37,Sub-CN,,0,0,0,,那等我跑腿结束就过去
Dialogue: 0,0:03:28.68,0:03:31.49,Sub-CN,,0,0,0,,真不好意思 还麻烦你送过来
Dialogue: 0,0:03:31.86,0:03:33.88,Sub-CN,,0,0,0,,我最近有点忙
Dialogue: 0,0:03:34.24,0:03:35.95,Sub-CN,,0,0,0,,我听妈妈说了
Dialogue: 0,0:03:36.28,0:03:39.59,Sub-CN,,0,0,0,,您又要将之前的染坊重新开张了
Dialogue: 0,0:03:39.91,0:03:44.02,Sub-CN,,0,0,0,,啊 有年轻人说想要过来修行
Dialogue: 0,0:03:44.02,0:03:48.37,Sub-CN,,0,0,0,,说起来我之前还给莱莎做过衣服
Dialogue: 0,0:03:48.37,0:03:51.63,Sub-CN,,0,0,0,,用七色葡萄做成的拉森染料
Dialogue: 0,0:03:51.85,0:03:55.71,Sub-CN,,0,0,0,,七色葡萄…难道是这个吗
Dialogue: 0,0:03:56.05,0:04:00.99,Sub-CN,,0,0,0,,因为衣服已经小到穿不了了 妈妈就帮我做成了丝带
Dialogue: 0,0:04:01.32,0:04:05.85,Sub-CN,漏翻,0,0,0,,这样啊 原来这件衣服是您做的啊
Dialogue: 0,0:04:06.36,0:04:10.14,Sub-CN,,0,0,0,,你很珍惜这件衣服呢 谢谢你
Dialogue: 0,0:04:10.57,0:04:14.11,Sub-CN,,0,0,0,,竟然还能穿帕特先生做的衣服啊 好期待
Dialogue: 0,0:04:14.11,0:04:17.59,Sub-CN,,0,0,0,,不过得过段时间了
Dialogue: 0,0:04:17.92,0:04:20.82,Sub-CN,,0,0,0,,布料比我想象的难入手
Dialogue: 0,0:04:21.93,0:04:23.44,Sub-CN,,0,0,0,,这样啊
Dialogue: 0,0:04:24.09,0:04:25.49,Sub-CN,,0,0,0,,诶 布料?
Dialogue: 0,0:04:25.93,0:04:29.33,Sub-CN,,0,0,0,,那个 您需要什么样的布料 需要多少啊
Dialogue: 0,0:04:31.68,0:04:36.17,Sub-CN,,0,0,0,,布料 布料 就用炼金术做吧
Dialogue: 0,0:04:38.79,0:04:45.22,Sub-CN,,0,0,0,,七色葡萄不光是炼金的素材 也能做成染料啊
Dialogue: 0,0:04:46.00,0:04:48.85,Sub-CN,,0,0,0,,有很多我不知道的事情呢
Dialogue: 0,0:04:54.11,0:04:55.49,Sub-CN,,0,0,0,,好好吃
Dialogue: 0,0:04:55.49,0:04:57.69,Sub-CN,,0,0,0,,之前的饼干也很好吃
Dialogue: 0,0:04:57.69,0:04:59.59,Sub-CN,,0,0,0,,真不愧是科洛蒂娅
Dialogue: 0,0:04:59.59,0:05:01.95,Sub-CN,,0,0,0,,我只是喜欢做点心而已
Dialogue: 0,0:05:02.20,0:05:06.44,Sub-CN,,0,0,0,,我完全做不到啊 好羡慕你
Dialogue: 0,0:05:07.33,0:05:09.93,Sub-CN,,0,0,0,,你们才厉害呢
Dialogue: 0,0:05:10.27,0:05:13.17,Sub-CN,,0,0,0,,找到了自己想做的事情 并为之努力
Dialogue: 0,0:05:13.57,0:05:16.88,Sub-CN,,0,0,0,,所以我觉得我也要鼓起勇气
Dialogue: 0,0:05:19.35,0:05:20.55,Sub-CN,,0,0,0,,那个盒子是…
Dialogue: 0,0:05:21.11,0:05:23.00,Sub-CN,,0,0,0,,我们最开始见面的时候你拿着的?
Dialogue: 0,0:05:24.57,0:05:29.27,Sub-CN,,0,0,0,,我想说的是 第一次见面时 我在森林里的原因
Dialogue: 0,0:05:30.18,0:05:32.48,Sub-CN,,0,0,0,,好漂亮 是笛子吗
Dialogue: 0,0:05:32.60,0:05:34.34,Sub-CN,,0,0,0,,叫长笛
Dialogue: 0,0:05:34.92,0:05:40.78,Sub-CN,,0,0,0,,那天其实是我想找一个父亲看不到的地方偷偷练习长笛
Dialogue: 0,0:05:40.78,0:05:44.69,Sub-CN,,0,0,0,,原来如此 然后就被魔物袭击了啊
Dialogue: 0,0:05:45.08,0:05:47.58,Sub-CN,,0,0,0,,但是为什么你要瞒着你父亲呢
Dialogue: 0,0:05:47.58,0:05:49.74,Sub-CN,漏翻,0,0,0,,难道你父亲讨厌音乐吗
Dialogue: 0,0:05:50.03,0:05:52.57,Sub-CN,,0,0,0,,背后是有些原因…
Dialogue: 0,0:05:53.05,0:05:55.88,Sub-CN,,0,0,0,,好啦 我不会强行问的
Dialogue: 0,0:05:56.56,0:05:57.60,Sub-CN,,0,0,0,,谢谢
Dialogue: 0,0:05:57.60,0:06:01.51,Sub-CN,,0,0,0,,然后 我有一个请求
Dialogue: 0,0:06:02.15,0:06:05.30,Sub-CN,,0,0,0,,希望有一天你能听听我的演奏
Dialogue: 0,0:06:06.39,0:06:07.40,Sub-CN,,0,0,0,,有一天?
Dialogue: 0,0:06:08.19,0:06:10.01,Sub-CN,,0,0,0,,现在的话 还不太行
Dialogue: 0,0:06:10.36,0:06:13.98,Sub-CN,,0,0,0,,但是如果让莱莎听的话 我一定可以鼓起勇气的
Dialogue: 0,0:06:14.44,0:06:16.02,Sub-CN,,0,0,0,,好啊 我很乐意
Dialogue: 0,0:06:16.95,0:06:20.19,Sub-CN,,0,0,0,,但是我其实不怎么懂音乐
Dialogue: 0,0:06:20.42,0:06:24.90,Sub-CN,,0,0,0,,那些都不碍事的 你只要听着就好了
Dialogue: 0,0:06:25.12,0:06:27.62,Sub-CN,,0,0,0,,我知道了 我会期待的
Dialogue: 0,0:06:27.88,0:06:28.42,Sub-CN,,0,0,0,,嗯
Dialogue: 0,0:06:31.14,0:06:34.76,Sub-CN,,0,0,0,,在暴露我绕远路之前得赶紧回去
Dialogue: 0,0:06:35.80,0:06:36.47,Sub-CN,,0,0,0,,诶
Dialogue: 0,0:06:38.46,0:06:39.56,Sub-CN,,0,0,0,,芭芭拉女士
Dialogue: 0,0:06:40.09,0:06:41.44,Sub-CN,,0,0,0,,莱莎
Dialogue: 0,0:06:41.44,0:06:42.92,Sub-CN,,0,0,0,,您还好吗
Dialogue: 0,0:06:43.10,0:06:47.80,Sub-CN,,0,0,0,,我想出去买东西 但是脚疼了起来
Dialogue: 0,0:06:49.56,0:06:53.82,Sub-CN,,0,0,0,,对了 如果不嫌弃的话
Dialogue: 0,0:06:54.74,0:06:56.85,Sub-CN,,0,0,0,,是没见过的药呢
Dialogue: 0,0:06:56.85,0:06:58.73,Sub-CN,,0,0,0,,这个很管用哦
Dialogue: 0,0:06:59.80,0:07:02.28,Sub-CN,,0,0,0,,那就拜托你啦
Dialogue: 0,0:07:02.28,0:07:03.02,Sub-CN,,0,0,0,,嗯
Dialogue: 0,0:07:04.05,0:07:06.24,Sub-CN,,0,0,0,,今天那两个人不在呢
Dialogue: 0,0:07:06.24,0:07:08.85,Sub-CN,,0,0,0,,我们也不是一直一起行动的啦
Dialogue: 0,0:07:09.23,0:07:11.20,Sub-CN,,0,0,0,,又不是小孩子
Dialogue: 0,0:07:11.35,0:07:13.91,Sub-CN,,0,0,0,,但是你们的事情已经传开了哦
Dialogue: 0,0:07:13.91,0:07:16.41,Sub-CN,,0,0,0,,说村里有三个坏小鬼
Dialogue: 0,0:07:18.24,0:07:24.09,Sub-CN,,0,0,0,,之前穿过海岸 被魔物袭击了 好像很严重呢
Dialogue: 0,0:07:26.85,0:07:30.41,Sub-CN,,0,0,0,,其实呢 我也去过的
Dialogue: 0,0:07:31.50,0:07:32.90,Sub-CN,,0,0,0,,芭芭拉女士也去过吗
Dialogue: 0,0:07:32.90,0:07:36.24,Sub-CN,,0,0,0,,对 我和巴尔达和帕特
Dialogue: 0,0:07:36.24,0:07:42.88,Sub-CN,,0,0,0,,三个坏小鬼每天都去冒险 去找令人兴奋的事情
Dialogue: 0,0:07:43.42,0:07:48.30,Sub-CN,,0,0,0,,我还以为这个村里尽是脑筋死板的大人呢
Dialogue: 0,0:07:48.63,0:07:50.16,Sub-CN,,0,0,0,,啊 抱歉
Dialogue: 0,0:07:50.16,0:07:54.00,Sub-CN,,0,0,0,,没事啦 孩子们眼中的大人就是那样的
Dialogue: 0,0:07:54.35,0:07:57.71,Sub-CN,,0,0,0,,很久之前 帕特也经常这样抱怨呢
Dialogue: 0,0:07:58.08,0:08:02.11,Sub-CN,,0,0,0,,难道帕特指的是染坊的帕特先生吗
Dialogue: 0,0:08:02.11,0:08:02.88,Sub-CN,,0,0,0,,是啊
Dialogue: 0,0:08:03.00,0:08:05.41,Sub-CN,,0,0,0,,哦 真是太巧了
Dialogue: 0,0:08:05.41,0:08:07.59,Sub-CN,,0,0,0,,我刚去过他那边呢
Dialogue: 0,0:08:07.87,0:08:10.62,Sub-CN,,0,0,0,,我已经好多年没见过他了
Dialogue: 0,0:08:10.62,0:08:12.12,Sub-CN,,0,0,0,,虽然很想去看看他
Dialogue: 0,0:08:12.12,0:08:14.79,Sub-CN,,0,0,0,,但是腿脚变得这么不灵便了
Dialogue: 0,0:08:14.79,0:08:16.33,Sub-CN,,0,0,0,,走不了太远了
Dialogue: 0,0:08:16.96,0:08:17.56,Sub-CN,,0,0,0,,诶
Dialogue: 0,0:08:17.78,0:08:19.80,Sub-CN,,0,0,0,,我的脚好像不那么痛了
Dialogue: 0,0:08:20.58,0:08:22.44,Sub-CN,,0,0,0,,其实呢
Dialogue: 0,0:08:22.72,0:08:25.40,Sub-CN,,0,0,0,,这个药 是我自己做的
Dialogue: 0,0:08:25.40,0:08:28.20,Sub-CN,,0,0,0,,哎呀 真厉害啊
Dialogue: 0,0:08:28.20,0:08:29.90,Sub-CN,,0,0,0,,不不 也没那么厉害啦
Dialogue: 0,0:08:31.36,0:08:33.23,Sub-CN,,0,0,0,,味道闻起来也很香呢
Dialogue: 0,0:08:33.82,0:08:35.41,Sub-CN,,0,0,0,,是不是花香啊?
Dialogue: 0,0:08:35.55,0:08:37.40,Sub-CN,,0,0,0,,诶 您能闻出来么?
Dialogue: 0,0:08:37.40,0:08:40.00,Sub-CN,,0,0,0,,是我从岛外采回来的花
Dialogue: 0,0:08:40.30,0:08:41.59,Sub-CN,,0,0,0,,岛外…
Dialogue: 0,0:08:42.15,0:08:45.02,Sub-CN,,0,0,0,,那 那朵花大概也是这样吧
Dialogue: 0,0:08:45.02,0:08:45.93,Sub-CN,,0,0,0,,那朵花?
Dialogue: 0,0:08:46.47,0:08:49.73,Sub-CN,,0,0,0,,以前 在我结婚时收到的祝贺信上
Dialogue: 0,0:08:49.73,0:08:51.72,Sub-CN,,0,0,0,,附了一朵花
Dialogue: 0,0:08:52.13,0:08:54.77,Sub-CN,,0,0,0,,那朵花是黄色的 喇叭状的
Dialogue: 0,0:08:54.77,0:08:57.18,Sub-CN,,0,0,0,,花的中心是橘色和红色的
Dialogue: 0,0:08:57.61,0:09:00.31,Sub-CN,,0,0,0,,它有着十分迷人的香气
Dialogue: 0,0:09:00.31,0:09:02.90,Sub-CN,,0,0,0,,过去数周还在散发出香气
Dialogue: 0,0:09:04.23,0:09:08.61,Sub-CN,,0,0,0,,即使花香散去 花朵凋零 我还是忘不了那朵花
Dialogue: 0,0:09:08.82,0:09:10.93,Sub-CN,,0,0,0,,虽然我也找遍了全岛
Dialogue: 0,0:09:10.93,0:09:13.20,Sub-CN,,0,0,0,,但还是没能找到同种的花
Dialogue: 0,0:09:13.55,0:09:16.41,Sub-CN,,0,0,0,,您没有直接询问给您寄信的那个人吗?
Dialogue: 0,0:09:16.54,0:09:19.38,Sub-CN,,0,0,0,,信上没有写寄信人啊
Dialogue: 0,0:09:19.38,0:09:20.58,Sub-CN,,0,0,0,,哎呀呀
Dialogue: 0,0:09:20.58,0:09:22.09,Sub-CN,,0,0,0,,哎呀 不好意思
Dialogue: 0,0:09:22.54,0:09:24.63,Sub-CN,,0,0,0,,我好像耽误了你不少时间
Dialogue: 0,0:09:27.10,0:09:28.37,Sub-CN,,0,0,0,,真是惊人啊
Dialogue: 0,0:09:28.37,0:09:29.96,Sub-CN,,0,0,0,,我的脚完全不痛了呢
Dialogue: 0,0:09:29.96,0:09:31.46,Sub-CN,,0,0,0,,太好了
Dialogue: 0,0:09:31.46,0:09:33.19,Sub-CN,,0,0,0,,那么 这个请您收下吧
Dialogue: 0,0:09:33.19,0:09:34.79,Sub-CN,,0,0,0,,真是太高兴了
Dialogue: 0,0:09:34.79,0:09:36.64,Sub-CN,,0,0,0,,谢谢你啊 莱莎
Dialogue: 0,0:09:37.24,0:09:38.65,Sub-CN,,0,0,0,,不用客气
Dialogue: 0,0:09:43.21,0:09:44.33,Sub-CN,,0,0,0,,事情就是如此
Dialogue: 0,0:09:44.71,0:09:47.32,Sub-CN,,0,0,0,,我想要去岛外采花
Dialogue: 0,0:09:47.65,0:09:50.99,Sub-CN,,0,0,0,,我觉得那应该是在小妖精之森见过的花
Dialogue: 0,0:09:55.16,0:09:56.04,Sub-CN,,0,0,0,,我知道了
Dialogue: 0,0:09:56.54,0:09:58.47,Sub-CN,,0,0,0,,不过 鉴于上次发生的事
Dialogue: 0,0:09:58.47,0:10:00.18,Sub-CN,,0,0,0,,这次莉拉也要同行
Dialogue: 0,0:10:00.18,0:10:01.04,Sub-CN,,0,0,0,,太好了
Dialogue: 0,0:10:01.37,0:10:04.79,Sub-CN,,0,0,0,,我什么事都不会做哦 只是负责监督
Dialogue: 0,0:10:05.10,0:10:07.50,Sub-CN,,0,0,0,,我要是也能一起去就好了
Dialogue: 0,0:10:07.98,0:10:10.71,Sub-CN,,0,0,0,,不过应该过不了我父亲那关
Dialogue: 0,0:10:11.31,0:10:12.87,Sub-CN,,0,0,0,,不用勉强哦
Dialogue: 0,0:10:12.87,0:10:14.68,Sub-CN,,0,0,0,,安心交给我们吧
Dialogue: 0,0:10:15.19,0:10:17.42,Sub-CN,,0,0,0,,嗯 大家要加油哦
Dialogue: 0,0:10:24.00,0:10:26.56,Sub-CN,,0,0,0,,又把我给掳过来了
Dialogue: 0,0:10:27.11,0:10:29.15,Sub-CN,,0,0,0,,那么事不宜迟 赶紧开始找吧
Dialogue: 0,0:10:29.45,0:10:32.04,Sub-CN,,0,0,0,,顺便再到稍微远点的地方
Dialogue: 0,0:10:32.42,0:10:35.26,Sub-CN,,0,0,0,,采集一些炼金术用的素材之类的
Dialogue: 0,0:10:35.59,0:10:38.87,Sub-CN,,0,0,0,,不行 达成目的后 马上就回去
Dialogue: 0,0:10:41.49,0:10:42.58,Sub-CN,,0,0,0,,这是个好机会
Dialogue: 0,0:10:43.00,0:10:45.43,Sub-CN,,0,0,0,,接下来我要教导你战士的心得
Dialogue: 0,0:10:45.43,0:10:46.29,Sub-CN,,0,0,0,,是
Dialogue: 0,0:10:46.55,0:10:48.68,Sub-CN,,0,0,0,,要时常保持冷静
Dialogue: 0,0:10:49.18,0:10:51.47,Sub-CN,,0,0,0,,不论遇到什么状况都要切勿大意
Dialogue: 0,0:10:51.92,0:10:54.10,Sub-CN,,0,0,0,,要优先确保退路
Dialogue: 0,0:10:55.89,0:10:57.50,Sub-CN,,0,0,0,,就这些…吗?
Dialogue: 0,0:10:57.88,0:10:58.84,Sub-CN,,0,0,0,,就是这些
Dialogue: 0,0:11:06.39,0:11:09.50,Sub-CN,,0,0,0,,黄色的 喇叭状的…
Dialogue: 0,0:11:14.71,0:11:16.40,Sub-CN,,0,0,0,,这个也不是
Dialogue: 0,0:11:16.60,0:11:19.19,Sub-CN,,0,0,0,,话说 真的就在这附近吗
Dialogue: 0,0:11:19.51,0:11:21.52,Sub-CN,,0,0,0,,会不会是科洛蒂娅搞错了
Dialogue: 0,0:11:21.80,0:11:23.94,Sub-CN,,0,0,0,,别说了 塔奥也帮忙找啊
Dialogue: 0,0:11:23.94,0:11:25.37,Sub-CN,,0,0,0,,好好…
Dialogue: 0,0:11:26.27,0:11:28.39,Sub-CN,,0,0,0,,再稍微往里走一点可以吗
Dialogue: 0,0:11:31.37,0:11:33.13,Sub-CN,,0,0,0,,只能再走一点哦
Dialogue: 0,0:11:35.25,0:11:36.07,Sub-CN,,0,0,0,,门没锁哦
Dialogue: 0,0:11:37.48,0:11:39.30,Sub-CN,,0,0,0,,那个 安佩尔先生
Dialogue: 0,0:11:39.95,0:11:41.19,Sub-CN,,0,0,0,,还有什么事吗
Dialogue: 0,0:11:41.78,0:11:44.10,Sub-CN,,0,0,0,,关于刚才说的花 我有点疑问
Dialogue: 0,0:11:45.28,0:11:47.21,Sub-CN,,0,0,0,,莱莎之前说过
Dialogue: 0,0:11:47.21,0:11:51.01,Sub-CN,,0,0,0,,那种花 似乎可以留香数周
Dialogue: 0,0:11:51.87,0:11:53.80,Sub-CN,,0,0,0,,这就有点奇怪了
Dialogue: 0,0:11:53.80,0:11:57.82,Sub-CN,,0,0,0,,只听特征 我也只能想到一种花
Dialogue: 0,0:11:58.17,0:12:00.84,Sub-CN,,0,0,0,,但这样的话 应该不至于有那么强烈的香气
Dialogue: 0,0:12:01.48,0:12:04.28,Sub-CN,,0,0,0,,我见过的那朵也没有这样的香气
Dialogue: 0,0:12:05.47,0:12:07.58,Sub-CN,,0,0,0,,那 是别的种类的花吗
Dialogue: 0,0:12:08.46,0:12:09.55,Sub-CN,,0,0,0,,可能是吧
Dialogue: 0,0:12:10.02,0:12:13.38,Sub-CN,,0,0,0,,果然我还是跟着一起去比较好吧
Dialogue: 0,0:12:14.84,0:12:16.49,Sub-CN,,0,0,0,,就算不跟去
Dialogue: 0,0:12:16.49,0:12:19.05,Sub-CN,,0,0,0,,应该也有其他可以为莱莎做的事吧
Dialogue: 0,0:12:28.92,0:12:32.07,Sub-CN,,0,0,0,,我感觉自己没有待在这里的意义啊
Dialogue: 0,0:12:32.07,0:12:33.24,Sub-CN,,0,0,0,,我也是
Dialogue: 0,0:12:33.86,0:12:37.32,Sub-CN,,0,0,0,,到底要到什么时候 她才能教我实战的战斗方式啊
Dialogue: 0,0:12:38.71,0:12:41.28,Sub-CN,,0,0,0,,我可是很想马上就变强的啊
Dialogue: 0,0:12:41.43,0:12:43.16,Sub-CN,,0,0,0,,嘘 会被听到的
Dialogue: 0,0:12:43.92,0:12:46.64,Sub-CN,,0,0,0,,莱莎 不要跑太远哦
Dialogue: 0,0:12:47.09,0:12:48.33,Sub-CN,,0,0,0,,我知道啦
Dialogue: 0,0:12:52.52,0:12:54.57,Sub-CN,,0,0,0,,这种地方居然有山羊先生
Dialogue: 0,0:12:55.89,0:12:57.73,Sub-CN,,0,0,0,,它是在叫我跟上去吗
Dialogue: 0,0:13:01.30,0:13:03.03,Sub-CN,,0,0,0,,抱歉 我就离开一会儿
Dialogue: 0,0:13:07.72,0:13:08.89,Sub-CN,,0,0,0,,难道说
Dialogue: 0,0:13:09.83,0:13:12.56,Sub-CN,,0,0,0,,就是这个! 谢谢你 山羊先生
Dialogue: 0,0:13:16.13,0:13:17.46,Sub-CN,,0,0,0,,真是只不可思议的山羊先生
Dialogue: 0,0:13:20.47,0:13:21.78,Sub-CN,,0,0,0,,我去帮您找来了
Dialogue: 0,0:13:22.01,0:13:25.24,Sub-CN,,0,0,0,,附在信上的花应该就是这个吧
Dialogue: 0,0:13:25.24,0:13:26.14,Sub-CN,,0,0,0,,是啊
Dialogue: 0,0:13:30.78,0:13:33.13,Sub-CN,,0,0,0,,我觉得应该是同一种花
Dialogue: 0,0:13:33.13,0:13:34.74,Sub-CN,,0,0,0,,不过香气的话
Dialogue: 0,0:13:34.74,0:13:38.55,Sub-CN,,0,0,0,,我不是很会形容 之前那朵气味要更浓郁
Dialogue: 0,0:13:38.71,0:13:39.70,Sub-CN,,0,0,0,,果然如此
Dialogue: 0,0:13:40.13,0:13:41.82,Sub-CN,,0,0,0,,这样啊
Dialogue: 0,0:13:41.82,0:13:45.58,Sub-CN,,0,0,0,,对不起啊 你好不容易才帮我找到的
Dialogue: 0,0:13:46.33,0:13:50.68,Sub-CN,,0,0,0,,好像还把巴兰茨家的小姐也牵扯进来了 真是不好意思
Dialogue: 0,0:13:50.68,0:13:52.70,Sub-CN,,0,0,0,,不…不会 没关系
Dialogue: 0,0:13:53.08,0:13:54.64,Sub-CN,,0,0,0,,我会再去找的
Dialogue: 0,0:13:54.95,0:13:55.52,Sub-CN,,0,0,0,,对吧
Dialogue: 0,0:13:55.52,0:13:56.15,Sub-CN,,0,0,0,,嗯
Dialogue: 0,0:13:56.38,0:13:59.56,Sub-CN,,0,0,0,,不用了哦 你有这份心意就够了
Dialogue: 0,0:13:59.56,0:14:00.40,Sub-CN,,0,0,0,,但是…
Dialogue: 0,0:14:00.84,0:14:03.00,Sub-CN,,0,0,0,,真的 不用再找了
Dialogue: 0,0:14:03.00,0:14:07.69,Sub-CN,,0,0,0,,因为老人家啊 非常擅长放弃和忘记
Dialogue: 0,0:14:12.73,0:14:14.30,Sub-CN,,0,0,0,,好可惜啊
Dialogue: 0,0:14:15.92,0:14:18.74,Sub-CN,,0,0,0,,那个 其实我早就觉得可能不是…
Dialogue: 0,0:14:18.74,0:14:21.86,Sub-CN,,0,0,0,,明明是同一种花 香味却不同
Dialogue: 0,0:14:21.86,0:14:23.51,Sub-CN,,0,0,0,,你觉得是为什么呢
Dialogue: 0,0:14:24.56,0:14:26.79,Sub-CN,,0,0,0,,虽然芭芭拉女士那样说了
Dialogue: 0,0:14:27.19,0:14:30.89,Sub-CN,,0,0,0,,但我觉得 无论是放弃还是忘记 都太可惜了啊
Dialogue: 0,0:14:31.56,0:14:32.47,Sub-CN,,0,0,0,,莱莎
Dialogue: 0,0:14:32.81,0:14:35.25,Sub-CN,,0,0,0,,就当是上了这艘贼船吧
Dialogue: 0,0:14:42.64,0:14:46.35,Sub-CN,,0,0,0,,我还想着睡一个晚上就会想到什么办法了
Dialogue: 0,0:14:46.35,0:14:48.12,Sub-CN,,0,0,0,,还是不行啊
Dialogue: 0,0:14:48.12,0:14:50.83,Sub-CN,,0,0,0,,莱莎 巴兰茨家的小姐来找你了
Dialogue: 0,0:14:52.36,0:14:53.87,Sub-CN,,0,0,0,,早安 莱莎
Dialogue: 0,0:14:53.87,0:14:55.27,Sub-CN,,0,0,0,,早…早安
Dialogue: 0,0:14:55.81,0:14:56.96,Sub-CN,,0,0,0,,怎么了吗?
Dialogue: 0,0:14:56.96,0:14:57.78,Sub-CN,,0,0,0,,那个…
Dialogue: 0,0:15:03.94,0:15:05.42,Sub-CN,,0,0,0,,那么 我要开始喽
Dialogue: 0,0:15:06.43,0:15:07.56,Sub-CN,,0,0,0,,帕特先…
Dialogue: 0,0:15:08.25,0:15:09.38,Sub-CN,,0,0,0,,果然还是算了吧
Dialogue: 0,0:15:09.38,0:15:11.10,Sub-CN,,0,0,0,,都说了没事的啦
Dialogue: 0,0:15:11.40,0:15:14.99,Sub-CN,,0,0,0,,我们只是来送炼金术做出的布料
Dialogue: 0,0:15:15.38,0:15:18.42,Sub-CN,,0,0,0,,顺便再稍微问一下就好了啦
Dialogue: 0,0:15:18.79,0:15:20.42,Sub-CN,,0,0,0,,但…但是
Dialogue: 0,0:15:20.42,0:15:22.15,Sub-CN,,0,0,0,,你们在吵什么呀
Dialogue: 0,0:15:22.32,0:15:23.92,Sub-CN,,0,0,0,,帕…帕特先生
Dialogue: 0,0:15:24.31,0:15:26.44,Sub-CN,,0,0,0,,不好意思啊 我身上这么脏
Dialogue: 0,0:15:26.85,0:15:29.08,Sub-CN,,0,0,0,,因为我刚才在打扫仓库
Dialogue: 0,0:15:29.58,0:15:31.12,Sub-CN,,0,0,0,,这位小姐是?
Dialogue: 0,0:15:31.12,0:15:32.98,Sub-CN,,0,0,0,,初…初次见面
Dialogue: 0,0:15:33.43,0:15:35.58,Sub-CN,,0,0,0,,我是科洛蒂娅·巴兰茨
Dialogue: 0,0:15:35.58,0:15:39.69,Sub-CN,,0,0,0,,哦 是最近过来的商人家的孩子啊
Dialogue: 0,0:15:41.05,0:15:42.66,Sub-CN,,0,0,0,,材质不错啊
Dialogue: 0,0:15:43.41,0:15:47.01,Sub-CN,,0,0,0,,缝纫的缓急和颜色的浸染都很出色
Dialogue: 0,0:15:47.01,0:15:48.97,Sub-CN,,0,0,0,,真是的 帕特先生
Dialogue: 0,0:15:49.47,0:15:51.06,Sub-CN,,0,0,0,,哎呀 不好意思
Dialogue: 0,0:15:51.06,0:15:53.93,Sub-CN,,0,0,0,,不小心就露出以前的习惯了
Dialogue: 0,0:15:53.93,0:15:56.05,Sub-CN,,0,0,0,,那么 你们今天找我有什么事?
Dialogue: 0,0:15:58.25,0:15:59.15,Sub-CN,,0,0,0,,你看~
Dialogue: 0,0:15:59.63,0:16:01.46,Sub-CN,,0,0,0,,我把布料带过来啦
Dialogue: 0,0:16:03.15,0:16:06.54,Sub-CN,,0,0,0,,对对 我想要的就是这种
Dialogue: 0,0:16:06.54,0:16:08.00,Sub-CN,,0,0,0,,太好了
Dialogue: 0,0:16:08.00,0:16:12.74,Sub-CN,,0,0,0,,不过你是从哪得到这么精美的布料的
Dialogue: 0,0:16:12.96,0:16:16.04,Sub-CN,,0,0,0,,我自己用炼金术做的
Dialogue: 0,0:16:16.04,0:16:19.15,Sub-CN,,0,0,0,,炼金术吗 莱莎你自己做的?
Dialogue: 0,0:16:19.15,0:16:19.90,Sub-CN,,0,0,0,,没错
Dialogue: 0,0:16:20.38,0:16:25.42,Sub-CN,,0,0,0,,虽然我也听说过炼金术的传闻 没想到莱莎你居然…
Dialogue: 0,0:16:25.42,0:16:26.46,Sub-CN,,0,0,0,,嘿嘿
Dialogue: 0,0:16:28.34,0:16:30.76,Sub-CN,,0,0,0,,莱莎 这股香味是
Dialogue: 0,0:16:33.65,0:16:35.72,Sub-CN,,0,0,0,,帕特先生 这味道是?
Dialogue: 0,0:16:38.80,0:16:40.44,Sub-CN,,0,0,0,,这个啊 说的是德尔福玫瑰香吗
Dialogue: 0,0:16:40.78,0:16:42.25,Sub-CN,,0,0,0,,德尔福玫瑰香?
Dialogue: 0,0:16:42.58,0:16:44.74,Sub-CN,,0,0,0,,我一般用来给做好的衣物熏香
Dialogue: 0,0:16:44.74,0:16:47.96,Sub-CN,,0,0,0,,味道很香 还有驱虫功效呢
Dialogue: 0,0:16:47.96,0:16:52.66,Sub-CN,,0,0,0,,那您以前是不是给芭芭拉女士寄过结婚祝贺信
Dialogue: 0,0:16:52.79,0:16:54.05,Sub-CN,,0,0,0,,芭芭拉的结婚祝贺信…
Dialogue: 0,0:16:54.43,0:16:56.64,Sub-CN,,0,0,0,,应该是很久以前的事情了
Dialogue: 0,0:16:57.80,0:17:00.08,Sub-CN,,0,0,0,,大概 有寄过吧
Dialogue: 0,0:17:00.08,0:17:02.70,Sub-CN,,0,0,0,,看吧 我没猜错吧
Dialogue: 0,0:17:02.70,0:17:04.12,Sub-CN,,0,0,0,,太好啦
Dialogue: 0,0:17:04.94,0:17:11.72,Sub-CN,,0,0,0,,那个时候太忙了 不小心忘了落款就把信寄出去了
Dialogue: 0,0:17:12.04,0:17:14.80,Sub-CN,,0,0,0,,不过你居然能知道是我
Dialogue: 0,0:17:14.80,0:17:16.54,Sub-CN,,0,0,0,,关于这个嘛
Dialogue: 0,0:17:16.54,0:17:17.32,Sub-CN,,0,0,0,,那个
Dialogue: 0,0:17:17.67,0:17:21.85,Sub-CN,,0,0,0,,最开始 我们只是打算找信封里附着的那朵花
Dialogue: 0,0:17:22.11,0:17:26.13,Sub-CN,,0,0,0,,我们虽然找到了形态样貌一样的花
Dialogue: 0,0:17:26.13,0:17:27.82,Sub-CN,,0,0,0,,但是只有香味还是对不上
Dialogue: 0,0:17:28.25,0:17:30.28,Sub-CN,,0,0,0,,那会儿我突然想到
Dialogue: 0,0:17:30.28,0:17:34.45,Sub-CN,,0,0,0,,据说裁缝店一般都会给做好的衣物进行特别的熏香
Dialogue: 0,0:17:34.68,0:17:36.21,Sub-CN,,0,0,0,,这你都知道啊
Dialogue: 0,0:17:36.21,0:17:38.34,Sub-CN,,0,0,0,,因为我曾经问过父亲
Dialogue: 0,0:17:38.66,0:17:39.39,Sub-CN,,0,0,0,,哦?
Dialogue: 0,0:17:39.85,0:17:43.55,Sub-CN,,0,0,0,,所以我猜想说不定写信的是一位裁缝师傅
Dialogue: 0,0:17:43.95,0:17:46.59,Sub-CN,,0,0,0,,写信的时候不小心沾上了那股香味
Dialogue: 0,0:17:47.32,0:17:49.46,Sub-CN,,0,0,0,,所以我问了莱莎
Dialogue: 0,0:17:49.86,0:17:53.40,Sub-CN,,0,0,0,,芭芭拉女士她有没有做裁缝的朋友
Dialogue: 0,0:17:54.72,0:17:55.97,Sub-CN,,0,0,0,,原来如此
Dialogue: 0,0:17:56.36,0:18:01.22,Sub-CN,,0,0,0,,于是你们就找上了曾经做裁缝的我
Dialogue: 0,0:18:01.22,0:18:02.77,Sub-CN,,0,0,0,,真是厉害啊
Dialogue: 0,0:18:02.99,0:18:05.47,Sub-CN,,0,0,0,,科洛蒂娅可聪明了
Dialogue: 0,0:18:05.47,0:18:07.71,Sub-CN,,0,0,0,,偶尔灵光乍现啦
Dialogue: 0,0:18:08.22,0:18:12.19,Sub-CN,,0,0,0,,帕特先生 那个香薰可以给我们一些吗
Dialogue: 0,0:18:12.50,0:18:15.19,Sub-CN,,0,0,0,,不好意思啊 已经没有了
Dialogue: 0,0:18:15.72,0:18:17.67,Sub-CN,,0,0,0,,那刚才我们闻到的是
Dialogue: 0,0:18:17.67,0:18:20.59,Sub-CN,,0,0,0,,我之前就一直在仓库给衣物熏香
Dialogue: 0,0:18:20.59,0:18:23.75,Sub-CN,,0,0,0,,可能因此在那边留下的味道吧
Dialogue: 0,0:18:24.99,0:18:27.52,Sub-CN,,0,0,0,,难得你们跑一趟 真是对不住
Dialogue: 0,0:18:27.87,0:18:31.63,Sub-CN,,0,0,0,,不过要是知道了信是帕特先生写的的话
Dialogue: 0,0:18:31.63,0:18:33.59,Sub-CN,,0,0,0,,芭芭拉女士一定会很开心吧
Dialogue: 0,0:18:33.59,0:18:34.22,Sub-CN,,0,0,0,,对
Dialogue: 0,0:18:34.22,0:18:35.60,Sub-CN,,0,0,0,,喂喂
Dialogue: 0,0:18:35.60,0:18:37.20,Sub-CN,,0,0,0,,这事儿都过去这么多年了…
Dialogue: 0,0:18:37.20,0:18:39.33,Sub-CN,,0,0,0,,怪不好意思的 还是别说了
Dialogue: 0,0:18:39.33,0:18:40.47,Sub-CN,,0,0,0,,诶
Dialogue: 0,0:18:40.47,0:18:44.69,Sub-CN,,0,0,0,,而且 芭芭拉她其实应该是知道的吧
Dialogue: 0,0:18:47.78,0:18:52.27,Sub-CN,,0,0,0,,虽然知道了送信人 但是关键的香味还是
Dialogue: 0,0:18:52.67,0:18:53.70,Sub-CN,,0,0,0,,哼哼哼
Dialogue: 0,0:18:54.47,0:18:57.95,Sub-CN,,0,0,0,,你以为我是谁 科洛蒂娅小姐
Dialogue: 0,0:18:57.95,0:19:00.28,Sub-CN,,0,0,0,,没有的话做出来就好了
Dialogue: 0,0:19:00.28,0:19:02.13,Sub-CN,,0,0,0,,毕竟 我可是
Dialogue: 0,0:19:02.13,0:19:04.04,Sub-CN,,0,0,0,,炼金术师
Dialogue: 0,0:19:04.20,0:19:07.00,Sub-CN,,0,0,0,,莱莎 真让人感到可靠
Dialogue: 0,0:19:07.16,0:19:09.01,Sub-CN,,0,0,0,,交给我吧
Dialogue: 0,0:19:11.37,0:19:16.13,Sub-CN,,0,0,0,,你给的书我都看了 可是哪里都没有记载
Dialogue: 0,0:19:16.26,0:19:18.59,Sub-CN,,0,0,0,,拜托了 请告诉我吧 安佩尔先生
Dialogue: 0,0:19:18.88,0:19:20.96,Sub-CN,,0,0,0,,不是说了那只是入门书吗
Dialogue: 0,0:19:21.37,0:19:23.81,Sub-CN,,0,0,0,,而且我也没答应让你们什么都来找我吧
Dialogue: 0,0:19:25.44,0:19:29.56,Sub-CN,,0,0,0,,调和德尔福玫瑰香需要相当的技巧
Dialogue: 0,0:19:30.17,0:19:33.78,Sub-CN,,0,0,0,,而且就连集齐素材都是难事
Dialogue: 0,0:19:33.78,0:19:35.19,Sub-CN,,0,0,0,,怎么这样
Dialogue: 0,0:19:44.48,0:19:46.17,Sub-CN,,0,0,0,,这可是稀有素材
Dialogue: 0,0:19:46.17,0:19:47.54,Sub-CN,,0,0,0,,小心使用吧
Dialogue: 0,0:19:47.64,0:19:48.77,Sub-CN,,0,0,0,,就是说
Dialogue: 0,0:19:49.35,0:19:50.54,Sub-CN,,0,0,0,,仅限这次哦
Dialogue: 0,0:19:50.54,0:19:51.70,Sub-CN,,0,0,0,,谢谢你
Dialogue: 0,0:19:53.54,0:19:57.96,Sub-CN,,0,0,0,,顺着记忆的思绪好好想象出那股香味
Dialogue: 0,0:20:27.18,0:20:28.05,Sub-CN,,0,0,0,,做好了
Dialogue: 0,0:20:28.90,0:20:29.69,Sub-CN,,0,0,0,,莱莎
Dialogue: 0,0:20:42.62,0:20:44.77,Sub-CN,,0,0,0,,安佩尔先生 这个
Dialogue: 0,0:20:46.07,0:20:50.27,Sub-CN,,0,0,0,,嗯 还好你没有浪费稀有素材
Dialogue: 0,0:20:50.41,0:20:52.47,Sub-CN,,0,0,0,,真厉害 莱莎
Dialogue: 0,0:20:52.47,0:20:55.07,Sub-CN,,0,0,0,,是因为有科洛蒂娅帮忙啦
Dialogue: 0,0:21:01.63,0:21:03.57,Sub-CN,,0,0,0,,就是这股香味
Dialogue: 0,0:21:03.96,0:21:06.26,Sub-CN,,0,0,0,,还以为这辈子再也闻不到了
Dialogue: 0,0:21:06.26,0:21:07.42,Sub-CN,,0,0,0,,好开心
Dialogue: 0,0:21:07.86,0:21:10.33,Sub-CN,,0,0,0,,两位真是太感谢了
Dialogue: 0,0:21:10.62,0:21:12.87,Sub-CN,,0,0,0,,您能开心真是太好了
Dialogue: 0,0:21:12.87,0:21:17.11,Sub-CN,,0,0,0,,话说 你们是在哪儿找到这种香味的
Dialogue: 0,0:21:17.11,0:21:18.76,Sub-CN,,0,0,0,,那个
Dialogue: 0,0:21:18.76,0:21:20.47,Sub-CN,,0,0,0,,从某个人那里听说的
Dialogue: 0,0:21:21.18,0:21:22.55,Sub-CN,,0,0,0,,那个某人是?
Dialogue: 0,0:21:22.55,0:21:26.55,Sub-CN,,0,0,0,,那人觉得不好意思让我们别说他的名字
Dialogue: 0,0:21:27.21,0:21:30.77,Sub-CN,,0,0,0,,但是他说 芭芭拉女士一定是知道的
Dialogue: 0,0:21:32.07,0:21:33.05,Sub-CN,,0,0,0,,对啊
Dialogue: 0,0:21:35.76,0:21:39.20,Sub-CN,,0,0,0,,多亏了莱莎的药 我现在感觉走远路也没问题了
Dialogue: 0,0:21:39.71,0:21:43.91,Sub-CN,,0,0,0,,是时候来一场久违的坏小孩三人组的重聚了
Dialogue: 0,0:21:47.28,0:21:49.33,Sub-CN,,0,0,0,,原来他们叫坏小孩三人组
Dialogue: 0,0:21:49.43,0:21:52.76,Sub-CN,,0,0,0,,和现在也是一种缘分吧
Dialogue: 0,0:21:52.76,0:21:55.35,Sub-CN,,0,0,0,,现在可是坏小孩四人组
Dialogue: 0,0:21:55.35,0:21:56.04,Sub-CN,,0,0,0,,诶?
Dialogue: 0,0:21:56.29,0:21:58.23,Sub-CN,,0,0,0,,科洛蒂娅也是我们的一员呢
Dialogue: 0,0:22:00.33,0:22:00.89,Sub-CN,,0,0,0,,嗯!
Dialogue: 0,0:22:02.22,0:22:03.87,Sub-CN,,0,0,0,,那个 莱莎
Dialogue: 0,0:22:04.73,0:22:07.18,Sub-CN,,0,0,0,,炼金术好棒啊
Dialogue: 0,0:22:07.86,0:22:09.09,Sub-CN,,0,0,0,,是啊
Dialogue: 0,0:22:10.32,0:22:13.17,Sub-CN,,0,0,0,,连曾经的回忆都能唤醒
Dialogue: 0,0:22:14.28,0:22:17.78,Sub-CN,,0,0,0,,就算苍老也不变的友情 真好啊
Dialogue: 0,0:22:24.89,0:22:25.61,Sub-CN,,0,0,0,,莱莎
Dialogue: 0,0:22:27.16,0:22:30.39,Sub-CN,,0,0,0,,那个 能听一听吗
Dialogue: 0,0:22:31.13,0:22:33.16,Sub-CN,,0,0,0,,我吹的长笛
Dialogue: 0,0:22:33.91,0:22:34.87,Sub-CN,漏翻,0,0,0,,可以吗
Dialogue: 0,0:22:35.24,0:22:38.09,Sub-CN,,0,0,0,,刚才 你不是说我也是你们的伙伴吗
Dialogue: 0,0:22:38.50,0:22:39.26,Sub-CN,,0,0,0,,所以
Dialogue: 0,0:22:40.07,0:22:42.53,Sub-CN,,0,0,0,,我也必须要鼓起勇气才行
Dialogue: 0,0:22:44.66,0:22:47.43,Sub-CN,,0,0,0,,明白了 那就拜托你了
Dialogue: 0,0:22:58.43,0:23:00.29,Sub-CN,,0,0,0,,多么美妙的笛声
Dialogue: 0,0:23:05.35,0:23:09.03,Sub-CN,,0,0,0,,真是久违的坏小孩三人组重逢啊
Dialogue: 0,0:23:09.19,0:23:14.62,Sub-CN,,0,0,0,,瓦尔特 原来结婚时给我寄那朵花的是帕特啊
Dialogue: 0,0:23:14.62,0:23:16.33,Sub-CN,,0,0,0,,终于搞清楚了
Dialogue: 0,0:23:16.33,0:23:18.96,Sub-CN,,0,0,0,,抱歉 我忘了把名字写上了
Dialogue: 0,0:23:19.34,0:23:22.00,Sub-CN,,0,0,0,,真是的 你老是这么粗心
Dialogue: 0,0:23:22.59,0:23:24.46,Sub-CN,,0,0,0,,不过 谢谢你
Dialogue: 0,0:23:24.99,0:23:25.68,Sub-CN,,0,0,0,,没有
Dialogue: 0,0:23:33.01,0:23:35.68,Sub-CN,,0,0,0,,谢谢你能听我演奏
Dialogue: 0,0:23:35.86,0:23:39.90,Sub-CN,,0,0,0,,非常 非常好听的笛声
Dialogue: 0,0:23:40.77,0:23:41.86,Sub-CN,,0,0,0,,真的吗
Dialogue: 0,0:23:41.96,0:23:42.80,Sub-CN,,0,0,0,,嗯!
Dialogue: 0,0:23:42.80,0:23:46.11,Sub-CN,,0,0,0,,该怎么说呢 总之就是很美妙
Dialogue: 0,0:23:47.53,0:23:49.02,Sub-CN,,0,0,0,,谢谢你 莱莎
Dialogue: 0,0:23:49.53,0:23:51.77,Sub-CN,,0,0,0,,我好开心 真的很开心
Dialogue: 0,0:23:52.44,0:23:54.97,Sub-CN,,0,0,0,,能鼓起勇气 真是太好了

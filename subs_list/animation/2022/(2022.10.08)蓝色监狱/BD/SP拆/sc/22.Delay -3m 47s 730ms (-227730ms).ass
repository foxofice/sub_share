Dialogue: 0,0:00:04.02,0:00:06.95,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#22 蚁生自顾自的潮范对决
Dialogue: 1,0:00:00.30,0:00:03.88,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:00:10.39,0:00:13.69,CN,,0,0,0,,天上天下世间万物
Dialogue: 1,0:00:13.69,0:00:16.94,CN,,0,0,0,,都可以用潮与不潮来区分
Dialogue: 1,0:00:16.94,0:00:19.90,CN,,0,0,0,,就用喝水的动作打个比方
Dialogue: 1,0:00:19.90,0:00:23.50,CN,,0,0,0,,从开瓶盖就要谨记时刻保持潮范
Dialogue: 1,0:00:25.61,0:00:27.03,CN,,0,0,0,,这是何等的潮
Dialogue: 1,0:00:27.03,0:00:29.33,CN,,0,0,0,,喝水后的斜眼 潮
Dialogue: 1,0:00:29.87,0:00:34.16,CN,,0,0,0,,那家伙…难道比爷要更潮吗？
Dialogue: 1,0:00:34.16,0:00:37.63,CN,,0,0,0,,居然一举一动都散发着潮范
Dialogue: 1,0:00:38.67,0:00:40.09,CN,,0,0,0,,大意了吧 糸师凛
Dialogue: 1,0:00:40.09,0:00:42.13,CN,,0,0,0,,这个坐姿一点都不潮
Dialogue: 1,0:00:42.13,0:00:45.97,CN,,0,0,0,,看！爷的华丽必杀—潮范上床
Dialogue: 1,0:00:46.07,0:00:48.03,CN,,0,0,0,,回旋入睡
Dialogue: 1,0:00:50.89,0:00:54.56,CN,,0,0,0,,赢了 今天也能睡个安稳觉
Dialogue: 1,0:00:55.60,0:00:57.76,CN,,0,0,0,,做个潮梦
Dialogue: 0,0:00:00.30,0:00:03.88,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:00:10.39,0:00:13.69,JP,,0,0,0,,それは森羅万象あまねく全てが
Dialogue: 0,0:00:13.69,0:00:16.94,JP,,0,0,0,,オシャかオシャではないかに分けられる
Dialogue: 0,0:00:16.94,0:00:19.90,JP,,0,0,0,,例えばドリンクの飲み方一つでも　そう
Dialogue: 0,0:00:19.90,0:00:23.50,JP,,0,0,0,,キャップの外し方から　常にオシャであることを心掛け…
Dialogue: 0,0:00:25.61,0:00:27.03,JP,,0,0,0,,何というオシャ
Dialogue: 0,0:00:27.03,0:00:29.33,JP,,0,0,0,,アフタードリンク流し目オシャ
Dialogue: 0,0:00:29.87,0:00:34.16,JP,,0,0,0,,あいつ…もしかして俺より上級オシャか？
Dialogue: 0,0:00:34.16,0:00:37.63,JP,,0,0,0,,一挙手一投足がオシャ散らかしてやがるな
Dialogue: 0,0:00:38.67,0:00:40.09,JP,,0,0,0,,油断したな　糸師凛
Dialogue: 0,0:00:40.09,0:00:42.13,JP,,0,0,0,,その座り方はノットオシャ
Dialogue: 0,0:00:42.13,0:00:45.97,JP,,0,0,0,,見よ！　俺の華麗なるベットインオシャ殺法
Dialogue: 0,0:00:46.07,0:00:48.03,JP,,0,0,0,,ローリング·グッナイ
Dialogue: 0,0:00:50.89,0:00:54.56,JP,,0,0,0,,勝ったな　これで今日もぐっすり
Dialogue: 0,0:00:55.60,0:00:57.76,JP,,0,0,0,,オシャすみなさい

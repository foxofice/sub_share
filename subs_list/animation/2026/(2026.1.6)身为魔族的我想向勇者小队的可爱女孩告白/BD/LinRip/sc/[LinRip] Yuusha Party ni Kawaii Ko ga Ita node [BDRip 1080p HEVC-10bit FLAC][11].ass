Dialogue: 0,0:00:05.20,0:00:08.27,Sousei-CN,,0,0,0,,(一个月前)
Dialogue: 0,0:00:10.50,0:00:14.03,Sousei-CN,,0,0,0,,这个 希望队长你能想想办法
Dialogue: 0,0:00:15.15,0:00:17.55,Sousei-CN,,0,0,0,,之前我也看过类似的症状
Dialogue: 0,0:00:17.96,0:00:19.16,Sousei-CN,,0,0,0,,真是的
Dialogue: 0,0:00:19.76,0:00:20.85,Sousei-CN,,0,0,0,,幸福
Dialogue: 0,0:00:22.15,0:00:23.76,Sousei-CN,,0,0,0,,我就知道
Dialogue: 0,0:00:24.15,0:00:25.96,Sousei-CN,,0,0,0,,你们最近没怎么见面吧
Dialogue: 0,0:00:27.65,0:00:28.86,Sousei-CN,,0,0,0,,这样啊
Dialogue: 0,0:00:30.16,0:00:32.49,Sousei-CN,,0,0,0,,我再去接受公会的委托
Dialogue: 0,0:00:32.49,0:00:35.20,Sousei-CN,,0,0,0,,然后邀幸福和赛西莉亚吧
Dialogue: 0,0:00:35.20,0:00:35.95,Sousei-CN,,0,0,0,,不
Dialogue: 0,0:00:36.36,0:00:40.06,Sousei-CN,,0,0,0,,直接邀对方去约会不就好了
Dialogue: 0,0:00:40.45,0:00:42.70,Sousei-CN,,0,0,0,,约 约会
Dialogue: 0,0:00:43.55,0:00:48.26,Sousei-CN,,0,0,0,,我有两个 不敢约心上人去约会的上司
Dialogue: 0,0:00:48.26,0:00:49.77,Sousei-CN,,0,0,0,,真是太不幸了
Dialogue: 0,0:00:50.00,0:00:52.30,Sousei-CN,,0,0,0,,好
Dialogue: 0,0:00:52.76,0:00:58.60,Sousei-CN,,0,0,0,,决定来执行"团体约会" "给渡鸦下一剂猛药"作战
Dialogue: 0,0:01:13.75,0:01:17.30,Sousei-CN,,0,0,0,,《身为魔族的我 想向勇者小队的可爱女孩告白》
Dialogue: 0,0:02:31.70,0:02:33.01,Sousei-CN,,0,0,0,,晴天
Dialogue: 0,0:02:33.45,0:02:35.75,Sousei-CN,,0,0,0,,是个舒服的好天气
Dialogue: 0,0:02:35.75,0:02:38.84,Sousei-CN,,0,0,0,,今天要好好加油 大玩特玩
Dialogue: 0,0:02:39.05,0:02:40.35,Sousei-CN,,0,0,0,,公爵
Dialogue: 0,0:02:40.35,0:02:42.90,Sousei-CN,,0,0,0,,你什么时候跟依蕾奈
Dialogue: 0,0:02:42.90,0:02:46.10,Sousei-CN,,0,0,0,,我跟她说要让团长转换一下心情
Dialogue: 0,0:02:46.10,0:02:50.15,Sousei-CN,,0,0,0,,她就说要帮忙
Dialogue: 0,0:02:46.10,0:02:50.15,Sousei-CN,,0,0,0,,{\an8}好期待喔 想吃点美味的料理
Dialogue: 0,0:02:50.15,0:02:52.85,Sousei-CN,,0,0,0,,那就出发吧
Dialogue: 0,0:02:53.86,0:02:56.10,Sousei-CN,,0,0,0,,今天要去哪呢
Dialogue: 0,0:02:56.50,0:02:58.75,Sousei-CN,,0,0,0,,幸福有想去的地方
Dialogue: 0,0:02:58.75,0:03:00.35,Sousei-CN,,0,0,0,,先去那里吧
Dialogue: 0,0:03:00.70,0:03:01.61,Sousei-CN,,0,0,0,,热烈希望
Dialogue: 0,0:03:01.61,0:03:02.26,Sousei-CN,,0,0,0,,(是哪)
Dialogue: 0,0:03:03.05,0:03:05.30,Sousei-CN,,0,0,0,,去最近刚完工的那个名胜地对吧
Dialogue: 0,0:03:05.30,0:03:06.51,Sousei-CN,,0,0,0,,答对了
Dialogue: 0,0:03:06.91,0:03:10.21,Sousei-CN,,0,0,0,,最近完工的名胜地 该不会是
Dialogue: 0,0:03:13.20,0:03:16.15,Sousei-CN,,0,0,0,,(去蛋糕店吧)
Dialogue: 0,0:03:16.15,0:03:17.27,Sousei-CN,,0,0,0,,拒绝
Dialogue: 0,0:03:18.40,0:03:19.11,Sousei-CN,,0,0,0,,(午餐)
Dialogue: 0,0:03:19.11,0:03:20.38,Sousei-CN,,0,0,0,,时间还早
Dialogue: 0,0:03:28.56,0:03:30.56,Sousei-CN,,0,0,0,,那里一定很多人
Dialogue: 0,0:03:30.56,0:03:33.95,Sousei-CN,,0,0,0,,我们去的话 可能会引起骚动
Dialogue: 0,0:03:33.95,0:03:35.61,Sousei-CN,,0,0,0,,今天还是放弃吧
Dialogue: 0,0:03:36.52,0:03:37.61,Sousei-CN,,0,0,0,,突破
Dialogue: 0,0:03:48.66,0:03:50.55,Sousei-CN,,0,0,0,,好厉害
Dialogue: 0,0:03:50.55,0:03:52.46,Sousei-CN,,0,0,0,,这不是很棒吗
Dialogue: 0,0:03:53.10,0:03:55.00,Sousei-CN,,0,0,0,,命名为讨伐魔王
Dialogue: 0,0:03:55.00,0:03:56.92,Sousei-CN,,0,0,0,,听说是国王陛下打造的
Dialogue: 0,0:03:59.25,0:04:00.54,Sousei-CN,,0,0,0,,一模一样
Dialogue: 0,0:04:00.54,0:04:03.42,Sousei-CN,,0,0,0,,(别看了)
Dialogue: 0,0:04:04.35,0:04:05.85,Sousei-CN,,0,0,0,,不用谦虚
Dialogue: 0,0:04:05.85,0:04:07.95,Sousei-CN,,0,0,0,,我 自豪
Dialogue: 0,0:04:18.41,0:04:20.05,Sousei-CN,,0,0,0,,感觉很不错喔
Dialogue: 0,0:04:20.45,0:04:22.78,Sousei-CN,,0,0,0,,作战成功
Dialogue: 0,0:04:24.06,0:04:25.15,Sousei-CN,,0,0,0,,幸福
Dialogue: 0,0:04:25.15,0:04:26.90,Sousei-CN,,0,0,0,,脸上沾到奶油了
Dialogue: 0,0:04:27.31,0:04:28.32,Sousei-CN,,0,0,0,,团长
Dialogue: 0,0:04:31.76,0:04:33.65,Sousei-CN,,0,0,0,,果然是团长
Dialogue: 0,0:04:33.65,0:04:36.10,Sousei-CN,,0,0,0,,不 可是刚才的声音
Dialogue: 0,0:04:36.10,0:04:37.30,Sousei-CN,,0,0,0,,就是啊
Dialogue: 0,0:04:38.76,0:04:40.15,Sousei-CN,,0,0,0,,原来如此
Dialogue: 0,0:04:40.15,0:04:41.30,Sousei-CN,,0,0,0,,不好意思
Dialogue: 0,0:04:41.30,0:04:44.30,Sousei-CN,,0,0,0,,初次听到渡鸦大人的美声
Dialogue: 0,0:04:44.30,0:04:47.11,Sousei-CN,,0,0,0,,让我稍稍有些惊讶
Dialogue: 0,0:04:51.65,0:04:52.65,Sousei-CN,,0,0,0,,没礼貌
Dialogue: 0,0:04:54.30,0:04:56.90,Sousei-CN,,0,0,0,,副团长 辛苦了
Dialogue: 0,0:04:56.90,0:04:59.05,Sousei-CN,,0,0,0,,今天团长休息
Dialogue: 0,0:04:59.05,0:05:02.02,Sousei-CN,,0,0,0,,请别在意 继续巡逻吧
Dialogue: 0,0:05:02.96,0:05:06.78,Sousei-CN,,0,0,0,,不仅被下属保护 甚至还被柔弱女子保护啊
Dialogue: 0,0:05:08.61,0:05:11.50,Sousei-CN,,0,0,0,,您就好好的享受休假吧
Dialogue: 0,0:05:11.50,0:05:13.20,Sousei-CN,,0,0,0,,渡鸦大人
Dialogue: 0,0:05:19.60,0:05:21.80,Sousei-CN,,0,0,0,,那个 团长
Dialogue: 0,0:05:22.16,0:05:23.41,Sousei-CN,,0,0,0,,渡鸦
Dialogue: 0,0:05:29.60,0:05:31.14,Sousei-CN,,0,0,0,,喂 渡鸦
Dialogue: 0,0:05:31.14,0:05:32.80,Sousei-CN,,0,0,0,,我马上把他带回来
Dialogue: 0,0:05:32.80,0:05:34.31,Sousei-CN,,0,0,0,,我也过去
Dialogue: 0,0:05:37.20,0:05:38.95,Sousei-CN,,0,0,0,,我知道他会很难受
Dialogue: 0,0:05:38.95,0:05:40.61,Sousei-CN,,0,0,0,,但没想到会逃走
Dialogue: 0,0:05:41.15,0:05:45.11,Sousei-CN,,0,0,0,,说到底 本来就有不少骑士 不满团长一直都不说话
Dialogue: 0,0:05:45.31,0:05:48.20,Sousei-CN,,0,0,0,,而召集这些人自成一派的人
Dialogue: 0,0:05:48.20,0:05:49.71,Sousei-CN,,0,0,0,,就是副团长
Dialogue: 0,0:05:50.30,0:05:52.10,Sousei-CN,,0,0,0,,我只是个新加入的成员
Dialogue: 0,0:05:52.51,0:05:54.71,Sousei-CN,,0,0,0,,能帮到团长的事也有限
Dialogue: 0,0:05:55.10,0:05:57.81,Sousei-CN,,0,0,0,,没想到你也挺辛苦的
Dialogue: 0,0:05:59.15,0:06:00.06,Sousei-CN,,0,0,0,,在那里
Dialogue: 0,0:06:03.81,0:06:06.31,Sousei-CN,,0,0,0,,捉迷藏结束了
Dialogue: 0,0:06:06.31,0:06:08.16,Sousei-CN,,0,0,0,,回大家那里去吧
Dialogue: 0,0:06:08.56,0:06:10.85,Sousei-CN,,0,0,0,,这样的我回去又能做什么
Dialogue: 0,0:06:12.36,0:06:15.19,Sousei-CN,,0,0,0,,被人看到逊色的一面就逃走吗
Dialogue: 0,0:06:15.19,0:06:17.90,Sousei-CN,,0,0,0,,你打算永远见不到幸福吗
Dialogue: 0,0:06:17.90,0:06:19.23,Sousei-CN,,0,0,0,,这
Dialogue: 0,0:06:19.60,0:06:23.20,Sousei-CN,,0,0,0,,我本来还以为 你能给幸福带来幸福的
Dialogue: 0,0:06:23.60,0:06:25.00,Sousei-CN,,0,0,0,,我太失望了
Dialogue: 0,0:06:27.00,0:06:30.20,Sousei-CN,,0,0,0,,我都说到这个程度了 你还不回嘴 那就没办法了
Dialogue: 0,0:06:30.60,0:06:32.23,Sousei-CN,,0,0,0,,之后交给队长了
Dialogue: 0,0:06:36.65,0:06:38.31,Sousei-CN,,0,0,0,,你到底是怎么了
Dialogue: 0,0:06:38.70,0:06:40.40,Sousei-CN,,0,0,0,,最近
Dialogue: 0,0:06:40.40,0:06:44.17,Sousei-CN,,0,0,0,,我了解到自己的懦弱与不完美
Dialogue: 0,0:06:44.45,0:06:46.90,Sousei-CN,,0,0,0,,你还记得海边那次的委托吗
Dialogue: 0,0:06:48.00,0:06:49.36,Sousei-CN,,0,0,0,,那时
Dialogue: 0,0:06:49.36,0:06:52.51,Sousei-CN,,0,0,0,,幸福说她有个秘密
Dialogue: 0,0:06:54.10,0:06:56.50,Sousei-CN,,0,0,0,,看她好像害怕什么
Dialogue: 0,0:06:56.90,0:06:59.40,Sousei-CN,,0,0,0,,我想应该是很严重的事吧
Dialogue: 0,0:07:01.15,0:07:05.01,Sousei-CN,,0,0,0,,可是我就只会烦恼
Dialogue: 0,0:07:05.40,0:07:08.44,Sousei-CN,,0,0,0,,真的能接受她的秘密吗
Dialogue: 0,0:07:09.21,0:07:11.10,Sousei-CN,,0,0,0,,声音的事也是
Dialogue: 0,0:07:11.96,0:07:13.70,Sousei-CN,,0,0,0,,我总是只会逃避
Dialogue: 0,0:07:14.26,0:07:16.16,Sousei-CN,,0,0,0,,我也好想象你一样
Dialogue: 0,0:07:16.16,0:07:19.71,Sousei-CN,,0,0,0,,鼓起勇气面对自己喜欢的人
Dialogue: 0,0:07:21.90,0:07:24.81,Sousei-CN,,0,0,0,,你以为我是谁啊
Dialogue: 0,0:07:24.81,0:07:27.20,Sousei-CN,,0,0,0,,我可是跟心上人一起出去时
Dialogue: 0,0:07:27.20,0:07:30.90,Sousei-CN,,0,0,0,,却还害羞到要戴着面具的废柴啦
Dialogue: 0,0:07:30.90,0:07:33.05,Sousei-CN,,0,0,0,,渡鸦 站起来
Dialogue: 0,0:07:33.35,0:07:35.35,Sousei-CN,,0,0,0,,你的双脚是用来装饰的吗
Dialogue: 0,0:07:35.35,0:07:36.90,Sousei-CN,,0,0,0,,不是吧
Dialogue: 0,0:07:36.90,0:07:39.75,Sousei-CN,,0,0,0,,你才不是这么柔弱的人
Dialogue: 0,0:07:39.75,0:07:43.26,Sousei-CN,,0,0,0,,因为我和公爵 还有幸福
Dialogue: 0,0:07:43.26,0:07:45.96,Sousei-CN,,0,0,0,,都相信着你
Dialogue: 0,0:07:47.80,0:07:52.44,Sousei-CN,,0,0,0,,我总是被你这莫名的气势鼓舞着
Dialogue: 0,0:07:56.80,0:07:58.90,Sousei-CN,,0,0,0,,各位 不好意思
Dialogue: 0,0:08:03.06,0:08:06.01,Sousei-CN,,0,0,0,,对不起 善自行动
Dialogue: 0,0:08:07.36,0:08:08.46,Sousei-CN,,0,0,0,,原谅
Dialogue: 0,0:08:12.60,0:08:15.75,Sousei-CN,,0,0,0,,团长的捉迷藏游戏玩完了
Dialogue: 0,0:08:16.16,0:08:18.90,Sousei-CN,,0,0,0,,接下来去购物吧
Dialogue: 0,0:08:18.90,0:08:20.60,Sousei-CN,,0,0,0,,好期待喔
Dialogue: 0,0:08:25.20,0:08:26.21,Sousei-CN,,0,0,0,,幸福
Dialogue: 0,0:08:27.20,0:08:29.11,Sousei-CN,,0,0,0,,虽然我不是很可靠
Dialogue: 0,0:08:29.70,0:08:33.15,Sousei-CN,,0,0,0,,但我会努力 直到有一天妳愿意跟我分享秘密
Dialogue: 0,0:08:34.70,0:08:36.00,Sousei-CN,,0,0,0,,了解
Dialogue: 0,0:08:36.86,0:08:39.45,Sousei-CN,,0,0,0,,(几天后)
Dialogue: 0,0:08:39.45,0:08:40.86,Sousei-CN,,0,0,0,,阳树先生
Dialogue: 0,0:08:42.26,0:08:44.26,Sousei-CN,,0,0,0,,赛西莉亚 怎么了
Dialogue: 0,0:08:44.70,0:08:47.66,Sousei-CN,,0,0,0,,幸福失踪了
Dialogue: 0,0:08:49.36,0:08:53.38,Sousei-CN,,0,0,0,,虽然我让幸福去休长假
Dialogue: 0,0:08:54.35,0:08:56.47,Sousei-CN,,0,0,0,,但她却留下了神秘的留言
Dialogue: 0,0:08:58.56,0:09:01.16,Sousei-CN,,0,0,0,,一如往常的幸福语
Dialogue: 0,0:09:01.85,0:09:03.48,Sousei-CN,,0,0,0,,什么意思
Dialogue: 0,0:09:03.70,0:09:07.25,Sousei-CN,,0,0,0,,(一个月后 接 来 绿森) 一个月后来森林迎接我
Dialogue: 0,0:09:07.81,0:09:09.90,Sousei-CN,,0,0,0,,她说的是哪个森林
Dialogue: 0,0:09:10.30,0:09:13.01,Sousei-CN,,0,0,0,,关于这点 我大概知道在哪里
Dialogue: 0,0:09:14.00,0:09:17.73,Sousei-CN,,0,0,0,,幸福一定有她的想法
Dialogue: 0,0:09:22.55,0:09:24.21,Sousei-CN,,0,0,0,,幸福姐
Dialogue: 0,0:09:25.66,0:09:26.37,Sousei-CN,,0,0,0,,嗨
Dialogue: 0,0:09:27.00,0:09:28.05,Sousei-CN,,0,0,0,,真是的
Dialogue: 0,0:09:28.05,0:09:30.90,Sousei-CN,,0,0,0,,不要让我强化嗅觉来追踪妳啦
Dialogue: 0,0:09:31.29,0:09:32.39,Sousei-CN,,0,0,0,,信任
Dialogue: 0,0:09:32.39,0:09:34.34,Sousei-CN,,0,0,0,,大家都在担心妳喔
Dialogue: 0,0:09:35.05,0:09:38.55,Sousei-CN,,0,0,0,,我 做好觉悟
Dialogue: 0,0:09:39.05,0:09:41.86,Sousei-CN,,0,0,0,,传达 告诉他
Dialogue: 0,0:09:42.76,0:09:44.46,Sousei-CN,,0,0,0,,我的事
Dialogue: 0,0:09:45.46,0:09:46.85,Sousei-CN,,0,0,0,,妳是认真的吗
Dialogue: 0,0:09:47.96,0:09:50.26,Sousei-CN,,0,0,0,,如果渡鸦不能接受的话
Dialogue: 0,0:09:50.26,0:09:52.36,Sousei-CN,,0,0,0,,一切都幻化为泡影喔
Dialogue: 0,0:09:53.70,0:09:54.86,Sousei-CN,,0,0,0,,我知道
Dialogue: 0,0:09:55.10,0:09:58.05,Sousei-CN,,0,0,0,,队长和我们之间的关系
Dialogue: 0,0:09:58.05,0:10:00.16,Sousei-CN,,0,0,0,,也会被彻底调查
Dialogue: 0,0:10:00.16,0:10:01.26,Sousei-CN,,0,0,0,,这样的话
Dialogue: 0,0:10:01.66,0:10:03.76,Sousei-CN,,0,0,0,,不会 添麻烦
Dialogue: 0,0:10:03.76,0:10:06.12,Sousei-CN,,0,0,0,,不算麻烦啦
Dialogue: 0,0:10:06.65,0:10:08.56,Sousei-CN,,0,0,0,,只是我和西克 还有队长
Dialogue: 0,0:10:08.96,0:10:12.16,Sousei-CN,,0,0,0,,都会失去来到密涅瓦后得到的一切
Dialogue: 0,0:10:14.26,0:10:16.45,Sousei-CN,,0,0,0,,不过幸福这么聪明
Dialogue: 0,0:10:17.10,0:10:18.86,Sousei-CN,,0,0,0,,应该懂的吧
Dialogue: 0,0:10:19.40,0:10:21.40,Sousei-CN,,0,0,0,,我无法再说谎
Dialogue: 0,0:10:21.40,0:10:23.35,Sousei-CN,,0,0,0,,想跟他说明白
Dialogue: 0,0:10:29.30,0:10:30.85,Sousei-CN,,0,0,0,,幸福姐加油
Dialogue: 0,0:10:30.85,0:10:32.05,Sousei-CN,,0,0,0,,西克
Dialogue: 0,0:10:32.70,0:10:36.10,Sousei-CN,,0,0,0,,这对幸福姐是很重要的事吧
Dialogue: 0,0:10:36.10,0:10:38.51,Sousei-CN,,0,0,0,,那我就要帮幸福姐加油
Dialogue: 0,0:10:38.90,0:10:41.11,Sousei-CN,,0,0,0,,公爵哥也这么想的吧
Dialogue: 0,0:10:41.45,0:10:42.90,Sousei-CN,,0,0,0,,是啊
Dialogue: 0,0:10:42.90,0:10:45.25,Sousei-CN,,0,0,0,,妳都下定决心了
Dialogue: 0,0:10:45.66,0:10:48.41,Sousei-CN,,0,0,0,,就不用在意我们 放手去做吧
Dialogue: 0,0:10:49.96,0:10:51.26,Sousei-CN,,0,0,0,,谢谢
Dialogue: 0,0:10:51.26,0:10:53.60,Sousei-CN,,0,0,0,,队长也说点什么吧
Dialogue: 0,0:10:54.85,0:10:58.11,Sousei-CN,,0,0,0,,你和公爵都把话说完了
Dialogue: 0,0:10:58.51,0:11:00.21,Sousei-CN,,0,0,0,,我没什么好说的
Dialogue: 0,0:11:00.21,0:11:01.91,Sousei-CN,,0,0,0,,没出息
Dialogue: 0,0:11:02.91,0:11:04.10,Sousei-CN,,0,0,0,,骗你的
Dialogue: 0,0:11:04.10,0:11:07.00,Sousei-CN,,0,0,0,,队长 谢谢
Dialogue: 0,0:11:16.78,0:11:20.74,Sousei-CN,,0,0,0,,渡鸦大人 今天身体如何啊
Dialogue: 0,0:11:21.35,0:11:22.99,Sousei-CN,,0,0,0,,没什么大碍
Dialogue: 0,0:11:24.11,0:11:25.21,Sousei-CN,,0,0,0,,刚才的声音
Dialogue: 0,0:11:25.90,0:11:27.11,Sousei-CN,,0,0,0,,没礼貌耶
Dialogue: 0,0:11:27.86,0:11:30.00,Sousei-CN,,0,0,0,,你为何直呼我的名字
Dialogue: 0,0:11:31.40,0:11:33.20,Sousei-CN,,0,0,0,,不懂礼数的家伙
Dialogue: 0,0:11:33.61,0:11:37.70,Sousei-CN,,0,0,0,,我可不会愚蠢到 让破坏骑士团秩序的人
Dialogue: 0,0:11:38.20,0:11:39.72,Sousei-CN,,0,0,0,,担任副团长之职
Dialogue: 0,0:11:40.65,0:11:44.22,Sousei-CN,,0,0,0,,这是 什么意思 渡鸦大人
Dialogue: 0,0:11:44.86,0:11:46.22,Sousei-CN,,0,0,0,,叫团长
Dialogue: 0,0:11:54.46,0:11:57.50,Sousei-CN,,0,0,0,,失礼了 团 团长大人
Dialogue: 0,0:11:58.44,0:12:00.46,Sousei-CN,,0,0,0,,(这样就好)
Dialogue: 0,0:12:07.99,0:12:11.00,Sousei-CN,,0,0,0,,(一个月后)
Dialogue: 0,0:12:11.66,0:12:16.35,Sousei-CN,,0,0,0,,幸福离开这里 差不多过了一个月
Dialogue: 0,0:12:16.95,0:12:20.01,Sousei-CN,,0,0,0,,幸福果然对渡鸦
Dialogue: 0,0:12:20.25,0:12:23.10,Sousei-CN,,0,0,0,,跟妳想的一样
Dialogue: 0,0:12:23.10,0:12:27.51,Sousei-CN,,0,0,0,,公爵应该已经为渡鸦 带路到幸福那里了
Dialogue: 0,0:12:31.65,0:12:33.60,Sousei-CN,,0,0,0,,阳树 来了啊
Dialogue: 0,0:12:33.60,0:12:35.05,Sousei-CN,,0,0,0,,母亲
Dialogue: 0,0:12:35.05,0:12:38.20,Sousei-CN,,0,0,0,,妳跟他说相亲的事了吗
Dialogue: 0,0:12:38.20,0:12:39.40,Sousei-CN,,0,0,0,,没说
Dialogue: 0,0:12:40.36,0:12:43.90,Sousei-CN,,0,0,0,,阳树先生现在因为朋友的事而苦恼
Dialogue: 0,0:12:43.90,0:12:46.78,Sousei-CN,,0,0,0,,我不想再让他多担心
Dialogue: 0,0:12:47.00,0:12:48.11,Sousei-CN,,0,0,0,,这样好吗
Dialogue: 0,0:12:48.11,0:12:51.44,Sousei-CN,,0,0,0,,对方已经来到密涅瓦了
Dialogue: 0,0:12:51.44,0:12:53.79,Sousei-CN,,0,0,0,,阳树终究是要知道这件事的
Dialogue: 0,0:12:54.00,0:12:57.31,Sousei-CN,,0,0,0,,因为相亲是国王的命令我才接受的
Dialogue: 0,0:12:57.31,0:13:00.55,Sousei-CN,,0,0,0,,见到对方后 我就会立刻拒绝
Dialogue: 0,0:13:02.66,0:13:04.35,Sousei-CN,,0,0,0,,赛西莉亚
Dialogue: 0,0:13:04.35,0:13:08.16,Sousei-CN,,0,0,0,,说真的 妳是怎么看待阳树的
Dialogue: 0,0:13:08.16,0:13:10.76,Sousei-CN,,0,0,0,,这件事跟阳树先生没关系吧
Dialogue: 0,0:13:11.70,0:13:15.56,Sousei-CN,,0,0,0,,总之相亲的事 母亲绝对不能说出去
Dialogue: 0,0:13:17.05,0:13:19.06,Sousei-CN,,0,0,0,,看来妳很在意喔
Dialogue: 0,0:13:19.50,0:13:22.50,Sousei-CN,,0,0,0,,才没有咧 就说了
Dialogue: 0,0:13:22.50,0:13:23.71,Sousei-CN,,0,0,0,,真傻
Dialogue: 0,0:13:24.76,0:13:26.60,Sousei-CN,,0,0,0,,如果真的跟他没关系
Dialogue: 0,0:13:26.60,0:13:30.05,Sousei-CN,,0,0,0,,妳就不会保密相亲的事了
Dialogue: 0,0:13:51.95,0:13:54.36,Sousei-CN,,0,0,0,,这是 幸福的
Dialogue: 0,0:13:55.10,0:13:56.31,Sousei-CN,,0,0,0,,跟我来
Dialogue: 0,0:14:01.40,0:14:03.10,Sousei-CN,,0,0,0,,幸福怎么了
Dialogue: 0,0:14:06.40,0:14:09.90,Sousei-CN,,0,0,0,,阳树 我非得跟你动手
Dialogue: 0,0:14:09.90,0:14:12.76,Sousei-CN,,0,0,0,,我还以为你没问题的
Dialogue: 0,0:14:12.76,0:14:13.62,Sousei-CN,,0,0,0,,我太失望了
Dialogue: 0,0:14:13.80,0:14:15.50,Sousei-CN,,0,0,0,,这是我要说的台词
Dialogue: 0,0:14:16.95,0:14:18.87,Sousei-CN,,0,0,0,,你该不会
Dialogue: 0,0:14:19.05,0:14:20.46,Sousei-CN,,0,0,0,,少说废话
Dialogue: 0,0:14:23.96,0:14:25.55,Sousei-CN,,0,0,0,,快说
Dialogue: 0,0:14:28.90,0:14:31.15,Sousei-CN,,0,0,0,,这是你伤害幸福该得的惩罚
Dialogue: 0,0:14:31.15,0:14:32.11,Sousei-CN,,0,0,0,,觉悟吧
Dialogue: 0,0:14:32.65,0:14:33.39,Sousei-CN,,0,0,0,,慢着
Dialogue: 0,0:14:37.60,0:14:39.61,Sousei-CN,,0,0,0,,我不是跟你说慢着了吗
Dialogue: 0,0:14:49.86,0:14:50.86,Sousei-CN,,0,0,0,,什么
Dialogue: 0,0:14:54.60,0:14:56.54,Sousei-CN,,0,0,0,,比之前更强了
Dialogue: 0,0:15:14.85,0:15:17.31,Sousei-CN,,0,0,0,,这就是你真正的样貌吗
Dialogue: 0,0:15:17.70,0:15:18.70,Sousei-CN,,0,0,0,,阳树
Dialogue: 0,0:15:19.55,0:15:23.15,Sousei-CN,,0,0,0,,渡鸦 幸福怎么了
Dialogue: 0,0:15:24.30,0:15:26.11,Sousei-CN,,0,0,0,,多说无益
Dialogue: 0,0:15:28.65,0:15:30.50,Sousei-CN,,0,0,0,,你给我
Dialogue: 0,0:15:30.50,0:15:31.90,Sousei-CN,,0,0,0,,适可而止
Dialogue: 0,0:15:32.74,0:15:35.26,Sousei-CN,,0,0,0,,无尽深渊
Dialogue: 0,0:15:47.55,0:15:49.76,Sousei-CN,,0,0,0,,渡鸦 你懂了吧
Dialogue: 0,0:15:49.76,0:15:51.26,Sousei-CN,,0,0,0,,你是赢不了我的
Dialogue: 0,0:15:52.76,0:15:54.56,Sousei-CN,,0,0,0,,但我不会放弃的
Dialogue: 0,0:15:54.96,0:15:56.46,Sousei-CN,,0,0,0,,为什么这么拚命
Dialogue: 0,0:15:56.96,0:15:59.27,Sousei-CN,,0,0,0,,你跟幸福到底发生什么事了
Dialogue: 0,0:15:59.75,0:16:01.21,Sousei-CN,,0,0,0,,我跟她说好了
Dialogue: 0,0:16:01.61,0:16:03.20,Sousei-CN,,0,0,0,,她说为了变装成人类
Dialogue: 0,0:16:03.20,0:16:05.90,Sousei-CN,,0,0,0,,身上的羽毛都被阳树拔光
Dialogue: 0,0:16:05.90,0:16:08.28,Sousei-CN,,0,0,0,,所以要我揍你一顿
Dialogue: 0,0:16:12.16,0:16:14.86,Sousei-CN,,0,0,0,,反正就是这样 纳命来
Dialogue: 0,0:16:14.86,0:16:16.36,Sousei-CN,,0,0,0,,开什么玩笑
Dialogue: 0,0:16:16.36,0:16:19.79,Sousei-CN,,0,0,0,,吃下你那一剑 就算是我也可能会死耶
Dialogue: 0,0:16:20.01,0:16:22.45,Sousei-CN,,0,0,0,,那 这样吧
Dialogue: 0,0:16:23.00,0:16:24.55,Sousei-CN,,0,0,0,,我会用刀背的
Dialogue: 0,0:16:24.90,0:16:27.05,Sousei-CN,,0,0,0,,你那把是双刃剑吧
Dialogue: 0,0:16:36.76,0:16:39.15,Sousei-CN,,0,0,0,,幸福
Dialogue: 0,0:16:42.60,0:16:44.05,Sousei-CN,,0,0,0,,登登登
Dialogue: 0,0:16:45.60,0:16:50.06,Sousei-CN,,0,0,0,,要胡闹也要有个限度吧
Dialogue: 0,0:16:53.11,0:16:54.16,Sousei-CN,,0,0,0,,谢罪
Dialogue: 0,0:16:54.55,0:16:55.57,Sousei-CN,,0,0,0,,对不起
Dialogue: 0,0:16:57.21,0:17:01.58,Sousei-CN,,0,0,0,,所以你们两个是怎么聊开的
Dialogue: 0,0:17:02.75,0:17:04.08,Sousei-CN,,0,0,0,,当时
Dialogue: 0,0:17:04.08,0:17:06.81,Sousei-CN,,0,0,0,,公爵带我进入森林里
Dialogue: 0,0:17:06.81,0:17:09.10,Sousei-CN,,0,0,0,,接下来就你一个人过去吧
Dialogue: 0,0:17:12.34,0:17:13.26,Sousei-CN,,0,0,0,,公爵
Dialogue: 0,0:17:14.09,0:17:18.59,Sousei-CN,,0,0,0,,必须要你亲口回复幸福
Dialogue: 0,0:17:22.84,0:17:24.15,Sousei-CN,,0,0,0,,幸福
Dialogue: 0,0:17:27.05,0:17:29.15,Sousei-CN,,0,0,0,,幸福 妳在吗
Dialogue: 0,0:17:30.21,0:17:32.95,Sousei-CN,,0,0,0,,为什么躲起来
Dialogue: 0,0:17:32.95,0:17:35.05,Sousei-CN,,0,0,0,,谢谢 来访
Dialogue: 0,0:17:35.55,0:17:37.85,Sousei-CN,,0,0,0,,为什么找我来这里
Dialogue: 0,0:17:38.56,0:17:39.86,Sousei-CN,,0,0,0,,这里
Dialogue: 0,0:17:40.60,0:17:42.96,Sousei-CN,,0,0,0,,是我的初始之地
Dialogue: 0,0:17:43.35,0:17:44.45,Sousei-CN,,0,0,0,,而且也是
Dialogue: 0,0:17:45.20,0:17:47.61,Sousei-CN,,0,0,0,,我的终结之处
Dialogue: 0,0:17:49.75,0:17:52.01,Sousei-CN,,0,0,0,,充满回忆的地方吗
Dialogue: 0,0:17:53.60,0:17:56.65,Sousei-CN,,0,0,0,,能认识渡鸦 很高兴
Dialogue: 0,0:17:56.65,0:17:58.85,Sousei-CN,,0,0,0,,一起度过很开心
Dialogue: 0,0:17:58.85,0:18:01.15,Sousei-CN,,0,0,0,,可以的话 想一直在一起
Dialogue: 0,0:18:01.15,0:18:01.95,Sousei-CN,,0,0,0,,我也
Dialogue: 0,0:18:01.95,0:18:03.75,Sousei-CN,,0,0,0,,不行 别靠近
Dialogue: 0,0:18:25.86,0:18:27.40,Sousei-CN,,0,0,0,,我很害怕
Dialogue: 0,0:18:27.40,0:18:29.41,Sousei-CN,,0,0,0,,维持假象
Dialogue: 0,0:18:30.20,0:18:36.36,Sousei-CN,,0,0,0,,可是一想到要结束 就
Dialogue: 0,0:18:41.76,0:18:43.05,Sousei-CN,,0,0,0,,对不起
Dialogue: 0,0:18:50.30,0:18:51.51,Sousei-CN,,0,0,0,,渡鸦
Dialogue: 0,0:18:52.75,0:18:55.91,Sousei-CN,,0,0,0,,很抱歉 我都没发现
Dialogue: 0,0:18:56.65,0:18:58.95,Sousei-CN,,0,0,0,,原来妳一直承受着痛苦
Dialogue: 0,0:18:59.65,0:19:01.46,Sousei-CN,,0,0,0,,不 拒绝?
Dialogue: 0,0:19:02.55,0:19:03.81,Sousei-CN,,0,0,0,,不会
Dialogue: 0,0:19:04.20,0:19:06.50,Sousei-CN,,0,0,0,,我喜欢幸福
Dialogue: 0,0:19:06.50,0:19:08.45,Sousei-CN,,0,0,0,,这个理由不行吗
Dialogue: 0,0:19:09.70,0:19:11.20,Sousei-CN,,0,0,0,,我也
Dialogue: 0,0:19:12.70,0:19:13.96,Sousei-CN,,0,0,0,,喜欢
Dialogue: 0,0:19:15.46,0:19:18.46,Sousei-CN,,0,0,0,,那就没问题了
Dialogue: 0,0:19:27.95,0:19:30.90,Sousei-CN,,0,0,0,,好甜
Dialogue: 0,0:19:30.90,0:19:32.45,Sousei-CN,,0,0,0,,甜死了
Dialogue: 0,0:19:32.45,0:19:37.73,Sousei-CN,,0,0,0,,比赛西莉亚家的方糖还甜
Dialogue: 0,0:19:37.73,0:19:41.15,Sousei-CN,,0,0,0,,你们一边迎接完美结局
Dialogue: 0,0:19:41.15,0:19:44.20,Sousei-CN,,0,0,0,,还整了我一顿是吗
Dialogue: 0,0:19:44.20,0:19:46.51,Sousei-CN,,0,0,0,,好 我知道了
Dialogue: 0,0:19:47.06,0:19:50.75,Sousei-CN,,0,0,0,,我就送你们个贺礼吧
Dialogue: 0,0:19:51.00,0:19:52.36,Sousei-CN,,0,0,0,,神圣锁炼
Dialogue: 0,0:19:52.36,0:19:53.95,Sousei-CN,,0,0,0,,你想干嘛
Dialogue: 0,0:19:53.95,0:19:55.04,Sousei-CN,,0,0,0,,解除
Dialogue: 0,0:19:55.04,0:19:57.81,Sousei-CN,,0,0,0,,张开除魔结界啦
Dialogue: 0,0:19:58.20,0:20:00.70,Sousei-CN,,0,0,0,,好了 你们两个慢慢来
Dialogue: 0,0:20:07.10,0:20:08.30,Sousei-CN,,0,0,0,,太好了
Dialogue: 0,0:20:09.16,0:20:12.25,Sousei-CN,,0,0,0,,如果渡鸦他们不行的话
Dialogue: 0,0:20:12.25,0:20:15.26,Sousei-CN,,0,0,0,,以后就很难像这样跟妳喝下午茶了
Dialogue: 0,0:20:16.75,0:20:17.65,Sousei-CN,,0,0,0,,赛西莉亚
Dialogue: 0,0:20:18.00,0:20:19.50,Sousei-CN,,0,0,0,,对不起
Dialogue: 0,0:20:21.25,0:20:25.35,Sousei-CN,,0,0,0,,之后我好像会变得越来越忙
Dialogue: 0,0:20:25.35,0:20:27.60,Sousei-CN,,0,0,0,,可能没什么时间喝下午茶
Dialogue: 0,0:20:27.60,0:20:30.15,Sousei-CN,,0,0,0,,不过只是一小段时期而已
Dialogue: 0,0:20:31.25,0:20:32.76,Sousei-CN,,0,0,0,,别担心
Dialogue: 0,0:20:32.76,0:20:35.06,Sousei-CN,,0,0,0,,我会暂时离开密涅瓦
Dialogue: 0,0:20:35.95,0:20:39.41,Sousei-CN,,0,0,0,,悠贺那家伙拜托我去帮他的忙
Dialogue: 0,0:20:39.86,0:20:42.81,Sousei-CN,,0,0,0,,所以我得去某个地方的矿山
Dialogue: 0,0:20:42.81,0:20:45.00,Sousei-CN,,0,0,0,,这样啊
Dialogue: 0,0:20:47.21,0:20:49.51,Sousei-CN,,0,0,0,,话虽如此
Dialogue: 0,0:20:49.96,0:20:52.75,Sousei-CN,,0,0,0,,但可能也要花两三个礼拜
Dialogue: 0,0:20:53.40,0:20:57.35,Sousei-CN,,0,0,0,,你什么时候跟悠贺先生感情这么好
Dialogue: 0,0:20:59.46,0:21:00.96,Sousei-CN,,0,0,0,,阳树在吗
Dialogue: 0,0:21:02.45,0:21:04.86,Sousei-CN,,0,0,0,,快把阳树交出来
Dialogue: 0,0:21:04.86,0:21:07.01,Sousei-CN,,0,0,0,,逮捕 带走
Dialogue: 0,0:21:07.01,0:21:09.71,Sousei-CN,,0,0,0,,阳树先生又做了什么
Dialogue: 0,0:21:11.35,0:21:14.21,Sousei-CN,,0,0,0,,刚才是他们先整我的
Dialogue: 0,0:21:15.80,0:21:17.20,Sousei-CN,,0,0,0,,谢谢妳的红茶
Dialogue: 0,0:21:21.20,0:21:22.59,Sousei-CN,,0,0,0,,我还会再来的
Dialogue: 0,0:21:25.14,0:21:26.30,Sousei-CN,,0,0,0,,别逃
Dialogue: 0,0:21:26.30,0:21:27.51,Sousei-CN,,0,0,0,,灭杀

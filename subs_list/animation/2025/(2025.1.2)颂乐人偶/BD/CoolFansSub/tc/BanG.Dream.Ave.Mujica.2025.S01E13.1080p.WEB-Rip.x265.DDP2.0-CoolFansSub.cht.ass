Dialogue: 1,0:00:04.28,0:00:05.50,Umiri - JP,,0,0,0,,豊川さん 時間です
Dialogue: 2,0:00:04.28,0:00:05.50,Umiri,,0,0,0,,豐川同學 時間到了
Dialogue: 1,0:00:43.46,0:00:44.34,Umiri - JP,,0,0,0,,享楽ですか
Dialogue: 2,0:00:43.46,0:00:44.34,Umiri,,0,0,0,,享樂嗎
Dialogue: 1,0:16:08.41,0:16:09.27,Umiri - JP,,0,0,0,,新入りかい？
Dialogue: 2,0:16:08.41,0:16:09.27,Umiri,,0,0,0,,新人嗎
Dialogue: 1,0:16:20.10,0:16:22.00,Umiri - JP,,0,0,0,,我々も同じだ ドロリス
Dialogue: 2,0:16:20.10,0:16:22.00,Umiri,,0,0,0,,我們也一樣 Doloris
Dialogue: 1,0:16:22.75,0:16:24.78,Umiri - JP,,0,0,0,,私は恐れの騎士 ティモリス
Dialogue: 2,0:16:22.75,0:16:24.78,Umiri,,0,0,0,,我是恐懼之騎士 Timoris
Dialogue: 1,0:16:40.24,0:16:41.37,Umiri - JP,,0,0,0,,心配しなくていい
Dialogue: 2,0:16:40.24,0:16:41.37,Umiri,,0,0,0,,不用擔心
Dialogue: 1,0:16:41.89,0:16:43.54,Umiri - JP,,0,0,0,,ここにいれば恐ろしいことはない
Dialogue: 2,0:16:41.89,0:16:43.54,Umiri,,0,0,0,,在這裡你沒有什麼好害怕的
Dialogue: 1,0:16:43.54,0:16:45.34,Umiri - JP,,0,0,0,,この私が約束しよう
Dialogue: 2,0:16:43.54,0:16:45.34,Umiri,,0,0,0,,讓我向你保證
Dialogue: 1,0:16:48.94,0:16:50.02,Umiri - JP,,0,0,0,,誰が適当だって
Dialogue: 2,0:16:48.94,0:16:50.02,Umiri,,0,0,0,,誰瞎胡鬧呢
Dialogue: 1,0:17:59.67,0:18:01.06,Umiri - JP,,0,0,0,,誰も私を信じない！
Dialogue: 2,0:17:59.67,0:18:01.06,Umiri,,0,0,0,,誰都不相信我
Dialogue: 1,0:18:01.58,0:18:02.74,Umiri - JP,,0,0,0,,信じてくれない！
Dialogue: 2,0:18:01.58,0:18:02.74,Umiri,,0,0,0,,不肯相信我！
Dialogue: 1,0:18:03.39,0:18:06.04,Umiri - JP,,0,0,0,,こんな恐ろしさ 忘れたいのに…
Dialogue: 2,0:18:03.39,0:18:06.04,Umiri,,0,0,0,,明明想要忘記這種恐懼...
Dialogue: 1,0:18:24.18,0:18:24.73,Umiri - JP,,0,0,0,,恐れでは？
Dialogue: 2,0:18:24.18,0:18:24.73,Umiri,,0,0,0,,恐懼呢
Dialogue: 1,0:19:02.62,0:19:03.28,Umiri - JP,,0,0,0,,まさか…
Dialogue: 2,0:19:02.62,0:19:03.28,Umiri,,0,0,0,,真的假的
Dialogue: 1,0:19:03.80,0:19:09.46,Umiri - JP,,0,0,0,,オブリビオニス？ 忘却の女神よ！
Dialogue: 2,0:19:03.80,0:19:09.46,Umiri,,0,0,0,,Oblivionis 忘卻的女神啊
Dialogue: 1,0:19:09.46,0:19:12.02,Umiri - JP,,0,0,0,,どうか 私をあなたの騎士に あっ…
Dialogue: 2,0:19:09.46,0:19:12.02,Umiri,,0,0,0,,請讓我成為您的騎士
Dialogue: 1,0:00:10.30,0:00:11.22,Saki - JP,,0,0,0,,まいりましょう
Dialogue: 2,0:00:10.30,0:00:11.22,Saki,,0,0,0,,出發吧
Dialogue: 1,0:00:34.00,0:00:36.78,Saki - JP,,0,0,0,,この日 この夜は一度きり
Dialogue: 2,0:00:34.00,0:00:36.78,Saki,,0,0,0,,今日今夜只此一回
Dialogue: 1,0:00:36.84,0:00:38.38,Saki - JP,,0,0,0,,カルペ·ディエム
Dialogue: 2,0:00:36.84,0:00:38.38,Saki,,0,0,0,,Carpe diem（採擷今日）
Dialogue: 1,0:00:39.12,0:00:40.40,Saki - JP,,0,0,0,,今日という花を摘み
Dialogue: 2,0:00:39.12,0:00:40.40,Saki,,0,0,0,,摘下名為今日之花
Dialogue: 1,0:00:40.50,0:00:43.16,Saki - JP,,0,0,0,,今宵 ひと時の享楽に溺れましょう
Dialogue: 2,0:00:40.50,0:00:43.16,Saki,,0,0,0,,在今夜沉溺於一時的享樂吧
Dialogue: 1,0:00:47.72,0:00:51.00,Saki - JP,,0,0,0,,では 楽しみましょう
Dialogue: 2,0:00:47.72,0:00:51.00,Saki,,0,0,0,,那麼 享受吧
Dialogue: 1,0:00:51.28,0:00:53.76,Saki - JP,,0,0,0,,Ａｖｅ Ｍｕｊｉｃａ
Dialogue: 2,0:00:51.28,0:00:53.76,Saki,,0,0,0,,Ave Mujica
Dialogue: 1,0:19:30.62,0:19:32.00,Saki - JP,,0,0,0,, 幾度 繰り返すのです？
Dialogue: 2,0:19:30.62,0:19:32.00,Saki,,0,0,0,,你還要重複多少次？
Dialogue: 1,0:19:33.41,0:19:34.99,Saki - JP,,0,0,0,,幾度 忘却を与えても
Dialogue: 2,0:19:33.41,0:19:34.99,Saki,,0,0,0,,無論予你幾次忘卻
Dialogue: 1,0:19:35.88,0:19:37.69,Saki - JP,,0,0,0,,あなたは楽園に戻ってくる
Dialogue: 2,0:19:35.88,0:19:37.69,Saki,,0,0,0,,你都會回到這片樂園
Dialogue: 1,0:20:02.77,0:20:04.58,Saki - JP,,0,0,0,,あなたは わたくしの騎士ではない
Dialogue: 2,0:20:02.77,0:20:04.58,Saki,,0,0,0,,你並非我的騎士
Dialogue: 1,0:20:25.43,0:20:27.17,Saki - JP,,0,0,0,,ならば 剣を手に
Dialogue: 2,0:20:25.43,0:20:27.17,Saki,,0,0,0,,那就拿起這把劍
Dialogue: 1,0:20:43.33,0:20:44.85,Saki - JP,,0,0,0,,皆が忘れようと
Dialogue: 2,0:20:43.33,0:20:44.85,Saki,,0,0,0,,就算眾人皆忘記
Dialogue: 1,0:20:45.45,0:20:47.95,Saki - JP,,0,0,0,,忘却の神たる わたくしだけは 忘れない
Dialogue: 2,0:20:45.45,0:20:47.95,Saki,,0,0,0,,作為忘卻之神的我也不會忘記
Dialogue: 1,0:20:49.03,0:20:51.57,Saki - JP,,0,0,0,,やがて世界が 終焉を迎える
Dialogue: 2,0:20:49.03,0:20:51.57,Saki,,0,0,0,,世界終將迎來終結
Dialogue: 1,0:20:52.30,0:20:53.41,Saki - JP,,0,0,0,,そのときまで
Dialogue: 2,0:20:52.30,0:20:53.41,Saki,,0,0,0,,但在那之前
Dialogue: 1,0:20:57.33,0:20:59.09,Saki - JP,,0,0,0,,この黄昏の楽園に
Dialogue: 2,0:20:57.33,0:20:59.09,Saki,,0,0,0,,這黃昏時分的樂園
Dialogue: 1,0:20:59.83,0:21:01.72,Saki - JP,,0,0,0,,わたくしは君臨し続ける
Dialogue: 2,0:20:59.83,0:21:01.72,Saki,,0,0,0,,將由我永恆君臨
Dialogue: 1,0:00:12.70,0:00:14.44,Anon - JP,,0,0,0,,やろうよ 円陣！
Dialogue: 2,0:00:12.70,0:00:14.44,Anon,,0,0,0,,排圓陣打氣吧！
Dialogue: 1,0:00:18.06,0:00:19.52,Anon - JP,,0,0,0,,ほら りっきーも！
Dialogue: 2,0:00:18.06,0:00:19.52,Anon,,0,0,0,,快來啦 rikki也來
Dialogue: 1,0:00:20.10,0:00:22.16,Anon - JP,,0,0,0,,頑張るぞ～ マイ～…
Dialogue: 2,0:00:20.10,0:00:22.16,Anon,,0,0,0,,加油囉~ My...
Dialogue: 1,0:00:23.68,0:00:25.54,Anon - JP,,0,0,0,,ええっ？ じゃ ともりん！
Dialogue: 2,0:00:23.68,0:00:25.54,Anon,,0,0,0,,欸？ 那tomorin
Dialogue: 1,0:00:26.42,0:00:28.12,Anon - JP,,0,0,0,,マイ～ ゴ～ね！
Dialogue: 2,0:00:26.42,0:00:28.12,Anon,,0,0,0,,My~GO!!!!! 這樣
Dialogue: 1,0:00:32.32,0:00:33.18,Anon - JP,,0,0,0,,えっ 待って待って
Dialogue: 2,0:00:32.32,0:00:33.18,Anon,,0,0,0,,欸等一下等一下
Dialogue: 1,0:00:54.04,0:00:55.44,Anon - JP,,0,0,0,,もっかい もっかい！
Dialogue: 2,0:00:54.04,0:00:55.44,Anon,,0,0,0,,再來一回 再來一回！
Dialogue: 1,0:00:55.74,0:00:57.28,Anon - JP,,0,0,0,,ゴ～そろってなかった！
Dialogue: 2,0:00:55.74,0:00:57.28,Anon,,0,0,0,,GO!!!!! 沒說到一起
Dialogue: 1,0:00:58.34,0:01:00.38,Anon - JP,,0,0,0,,今度って いつ～
Dialogue: 2,0:00:58.34,0:01:00.38,Anon,,0,0,0,,以後得什麼時候啊
Dialogue: 1,0:06:10.16,0:06:10.78,Anon - JP,,0,0,0,,ともりん
Dialogue: 2,0:06:10.16,0:06:10.78,Anon,,0,0,0,,tomorin
Dialogue: 1,0:26:36.25,0:26:37.45,Anon - JP,,0,0,0,,真ん中～
Dialogue: 2,0:26:36.25,0:26:37.45,Anon,,0,0,0,,正中央！
Dialogue: 1,0:26:41.40,0:26:43.00,Anon - JP,,0,0,0,,あいさつするよ
Dialogue: 2,0:26:41.40,0:26:43.00,Anon,,0,0,0,,來打招呼吧
Dialogue: 1,0:00:14.52,0:00:15.78,Taki - JP,,0,0,0,,もう出番なんだけど
Dialogue: 2,0:00:14.52,0:00:15.78,Taki,,0,0,0,,都該上場了
Dialogue: 1,0:00:22.26,0:00:23.30,Taki - JP,,0,0,0,,やるなら燈でしょう！
Dialogue: 2,0:00:22.26,0:00:23.30,Taki,,0,0,0,,要做也得是燈來吧
Dialogue: 1,0:01:01.00,0:01:02.40,Taki - JP,,0,0,0,,今 食べない！
Dialogue: 2,0:01:01.00,0:01:02.40,Taki,,0,0,0,,現在別吃
Dialogue: 1,0:26:38.18,0:26:39.20,Taki - JP,,0,0,0,,は？
Dialogue: 2,0:26:38.18,0:26:39.20,Taki,,0,0,0,,蛤？
Dialogue: 1,0:00:16.14,0:00:17.40,Soyo - JP,,0,0,0,,やるなら 早くして
Dialogue: 2,0:00:16.14,0:00:17.40,Soyo,,0,0,0,,要做就快點做
Dialogue: 1,0:00:57.32,0:00:58.14,Soyo - JP,,0,0,0,,また今度ね
Dialogue: 2,0:00:57.32,0:00:58.14,Soyo,,0,0,0,,以後再來吧
Dialogue: 1,0:26:40.70,0:26:41.40,Soyo - JP,,0,0,0,,立希ちゃん
Dialogue: 2,0:26:40.70,0:26:41.40,Soyo,,0,0,0,,小立希
Dialogue: 1,0:00:28.62,0:00:32.32,Tomori - JP,,0,0,0,,う… うん えっと… マイ ゴ～！
Dialogue: 2,0:00:28.62,0:00:32.32,Tomori,,0,0,0,,呃...嗯 那個 My GO!!!!!
Dialogue: 1,0:05:20.08,0:05:22.48,Tomori - JP,,0,0,0,,朝 金木犀の匂い
Dialogue: 2,0:05:20.08,0:05:22.48,Tomori,,0,0,0,,清晨 丹桂飄香
Dialogue: 1,0:05:22.52,0:05:25.82,Tomori - JP,,0,0,0,,あのちゃんが 咲いてる場所 見つけてくれて
Dialogue: 2,0:05:22.52,0:05:25.82,Tomori,,0,0,0,,愛音為我找到了它盛開的地方
Dialogue: 1,0:05:26.12,0:05:27.98,Tomori - JP,,0,0,0,,木漏れ日が優しかった
Dialogue: 2,0:05:26.12,0:05:27.98,Tomori,,0,0,0,,樹葉隙間灑下的陽光如此溫柔
Dialogue: 1,0:05:28.90,0:05:32.36,Tomori - JP,,0,0,0,,スタジオで
Dialogue: 2,0:05:28.90,0:05:32.36,Tomori,,0,0,0,,在錄音室
Dialogue: 1,0:05:32.88,0:05:34.36,Tomori - JP,,0,0,0,,ノートを準備してるとき
Dialogue: 2,0:05:32.88,0:05:34.36,Tomori,,0,0,0,,準備筆記的時候
Dialogue: 1,0:05:34.72,0:05:36.60,Tomori - JP,,0,0,0,,背中に立希ちゃんの音…
Dialogue: 2,0:05:34.72,0:05:36.60,Tomori,,0,0,0,,身後傳來的是立希的鼓聲
Dialogue: 1,0:05:38.16,0:05:42.04,Tomori - JP,,0,0,0,,練習前の トントンって 落ち着く音
Dialogue: 2,0:05:38.16,0:05:42.04,Tomori,,0,0,0,,練習前「咚咚」地 讓人平靜的聲音
Dialogue: 1,0:05:43.34,0:05:45.78,Tomori - JP,,0,0,0,,楽奈ちゃんと一緒に 金平糖 食べた
Dialogue: 2,0:05:43.34,0:05:45.78,Tomori,,0,0,0,,和樂奈一起吃了金平糖
Dialogue: 1,0:05:46.82,0:05:49.60,Tomori - JP,,0,0,0,,楽奈ちゃんは 緑色の バリバリかんで
Dialogue: 2,0:05:46.82,0:05:49.60,Tomori,,0,0,0,,樂奈嘎嘣嘎嘣嚼了綠色的糖
Dialogue: 1,0:05:50.40,0:05:51.56,Tomori - JP,,0,0,0,,抹茶味じゃないって
Dialogue: 2,0:05:50.40,0:05:51.56,Tomori,,0,0,0,,說「不是抹茶味的」
Dialogue: 1,0:05:53.56,0:05:56.26,Tomori - JP,,0,0,0,,さっき よろけたとき
Dialogue: 2,0:05:53.56,0:05:56.26,Tomori,,0,0,0,,之前 跌倒摔跤的時候
Dialogue: 1,0:05:56.46,0:05:59.16,Tomori - JP,,0,0,0,,そよちゃんが手を引いてくれた
Dialogue: 2,0:05:56.46,0:05:59.16,Tomori,,0,0,0,,素世牽起來了我的手
Dialogue: 1,0:05:59.62,0:06:00.88,Tomori - JP,,0,0,0,,そよちゃんの手
Dialogue: 2,0:05:59.62,0:06:00.88,Tomori,,0,0,0,,素世的手
Dialogue: 1,0:06:01.14,0:06:03.60,Tomori - JP,,0,0,0,,この前より少し冷たくて
Dialogue: 2,0:06:01.14,0:06:03.60,Tomori,,0,0,0,,比之前稍微涼了一點
Dialogue: 1,0:06:05.44,0:06:07.02,Tomori - JP,,0,0,0,,季節が変わってた
Dialogue: 2,0:06:05.44,0:06:07.02,Tomori,,0,0,0,,季節變了
Dialogue: 1,0:26:54.00,0:26:56.00,Tomori - JP,,0,0,0,,ありがとうございました！
Dialogue: 2,0:26:54.00,0:26:56.00,Tomori,,0,0,0,,謝謝大家
Dialogue: 1,0:00:33.34,0:00:33.68,Rana - JP,,0,0,0,,ゴ～
Dialogue: 2,0:00:33.34,0:00:33.68,Rana,,0,0,0,,GO~
Dialogue: 1,0:01:04.64,0:01:05.56,Rana - JP,,0,0,0,,し～っ
Dialogue: 2,0:01:04.64,0:01:05.56,Rana,,0,0,0,,噓~
Dialogue: 1,0:01:05.56,0:01:07.40,Rana - JP,,0,0,0,,燈 気持ち作ってる
Dialogue: 2,0:01:05.56,0:01:07.40,Rana,,0,0,0,,燈在醞釀情緒
Dialogue: 1,0:01:11.50,0:01:13.18,Rana - JP,,0,0,0,,行くよ りっきー
Dialogue: 2,0:01:11.50,0:01:13.18,Rana,,0,0,0,,走了 rikki
Dialogue: 1,0:05:52.06,0:05:53.04,Rana - JP,,0,0,0,,メロン味だった
Dialogue: 2,0:05:52.06,0:05:53.04,Rana,,0,0,0,,是蜜瓜味的
Dialogue: 1,0:00:44.94,0:00:46.38,Uika - JP,,0,0,0,,悪いことするみたいだね
Dialogue: 2,0:00:44.94,0:00:46.38,Uika,,0,0,0,,感覺像在做壞事呢
Dialogue: 1,0:16:05.42,0:16:07.34,Uika - JP,,0,0,0,,ここがパラディースス？
Dialogue: 2,0:16:05.42,0:16:07.34,Uika,,0,0,0,,這裡就是paradisus（樂園）嗎
Dialogue: 1,0:16:09.73,0:16:12.41,Uika - JP,,0,0,0,,僕は 悲しみの騎士 ドロリス
Dialogue: 2,0:16:09.73,0:16:12.41,Uika,,0,0,0,,我是悲傷之騎士 Doloris
Dialogue: 1,0:16:12.74,0:16:15.74,Uika - JP,,0,0,0,,女神 オブリビオニスに 仕えるために来た
Dialogue: 2,0:16:12.74,0:16:15.74,Uika,,0,0,0,,是為了侍奉女神Oblivionis而來
Dialogue: 1,0:17:16.72,0:17:17.92,Uika - JP,,0,0,0,,そんな…
Dialogue: 2,0:17:16.72,0:17:17.92,Uika,,0,0,0,,怎麼會...
Dialogue: 1,0:18:10.50,0:18:11.36,Uika - JP,,0,0,0,,イヤだ！
Dialogue: 2,0:18:10.50,0:18:11.36,Uika,,0,0,0,,我不要！
Dialogue: 1,0:18:11.67,0:18:13.46,Uika - JP,,0,0,0,,僕は もう耐えられない！
Dialogue: 2,0:18:11.67,0:18:13.46,Uika,,0,0,0,,我已經無法忍受下去了
Dialogue: 1,0:18:13.99,0:18:15.57,Uika - JP,,0,0,0,,罪深い我が身…
Dialogue: 2,0:18:13.99,0:18:15.57,Uika,,0,0,0,,罪孽深重的我...
Dialogue: 1,0:18:16.06,0:18:18.54,Uika - JP,,0,0,0,,存在そのものが罪なんだ！
Dialogue: 2,0:18:16.06,0:18:18.54,Uika,,0,0,0,,存在本身即是罪過！
Dialogue: 1,0:18:18.72,0:18:21.20,Uika - JP,,0,0,0,,全て忘れて救われたい！
Dialogue: 2,0:18:18.72,0:18:21.20,Uika,,0,0,0,,我想忘掉一切 得到救贖！
Dialogue: 1,0:18:22.99,0:18:23.79,Uika - JP,,0,0,0,,ダメだ
Dialogue: 2,0:18:22.99,0:18:23.79,Uika,,0,0,0,,不行
Dialogue: 1,0:18:25.08,0:18:26.27,Uika - JP,,0,0,0,,違う…
Dialogue: 2,0:18:25.08,0:18:26.27,Uika,,0,0,0,,也不對...
Dialogue: 1,0:18:27.75,0:18:33.02,Uika - JP,,0,0,0,,要らない！ 愛でも 恐れでも 死でも 悲しみでもなく！
Dialogue: 2,0:18:27.75,0:18:33.02,Uika,,0,0,0,,我不需要！愛也好恐懼也好死也好 悲傷也不是
Dialogue: 1,0:18:33.09,0:18:38.26,Uika - JP,,0,0,0,,忘却だけが 僕を この苦しみから救ってくれる！
Dialogue: 2,0:18:33.09,0:18:38.26,Uika,,0,0,0,,只有忘卻 才能將我從這種痛苦中拯救
Dialogue: 1,0:18:40.66,0:18:41.68,Uika - JP,,0,0,0,,本当に？
Dialogue: 2,0:18:40.66,0:18:41.68,Uika,,0,0,0,,真的嗎
Dialogue: 1,0:18:42.63,0:18:43.96,Uika - JP,,0,0,0,,ハッ… この声…
Dialogue: 2,0:18:42.63,0:18:43.96,Uika,,0,0,0,,這個聲音...
Dialogue: 1,0:18:44.45,0:18:47.01,Uika - JP,,0,0,0,,忘却だけが この地に来た理由？
Dialogue: 2,0:18:44.45,0:18:47.01,Uika,,0,0,0,,你來此地 只是為了忘卻？
Dialogue: 1,0:18:47.01,0:18:48.26,Uika - JP,,0,0,0,,まただ
Dialogue: 2,0:18:47.01,0:18:48.26,Uika,,0,0,0,,又來了
Dialogue: 1,0:18:48.67,0:18:51.17,Uika - JP,,0,0,0,,いつも聞こえてくる この声！
Dialogue: 2,0:18:48.67,0:18:51.17,Uika,,0,0,0,,總是能聽到的這個聲音！
Dialogue: 1,0:18:51.17,0:18:55.99,Uika - JP,,0,0,0,,ドロリス お前の本当の願いは…
Dialogue: 2,0:18:51.17,0:18:55.99,Uika,,0,0,0,,Doloris 你真正的願望是...
Dialogue: 1,0:19:26.24,0:19:29.15,Uika - JP,,0,0,0,,あっ… 待って！ 僕もあなたの騎士に…
Dialogue: 2,0:19:26.24,0:19:29.15,Uika,,0,0,0,,啊... 等等 也讓我成為您的騎士...
Dialogue: 1,0:19:29.15,0:19:30.62,Uika - JP,,0,0,0,,忘却の福音を…
Dialogue: 2,0:19:29.15,0:19:30.62,Uika,,0,0,0,,賜予我忘卻的福音...
Dialogue: 1,0:19:38.08,0:19:39.44,Uika - JP,,0,0,0,,何を言って…
Dialogue: 2,0:19:38.08,0:19:39.44,Uika,,0,0,0,,您在說什麼...
Dialogue: 1,0:19:40.01,0:19:42.43,Uika - JP,,0,0,0,,ここに来たのは今日が初めてで
Dialogue: 2,0:19:40.01,0:19:42.43,Uika,,0,0,0,,我來到這裡只有今天這第一次
Dialogue: 1,0:19:42.43,0:19:43.80,Uika - JP,,0,0,0,,本当に
Dialogue: 2,0:19:42.43,0:19:43.80,Uika,,0,0,0,,真的嗎
Dialogue: 1,0:19:45.69,0:19:47.91,Uika - JP,,0,0,0,,思い出せ ドロリス
Dialogue: 2,0:19:45.69,0:19:47.91,Uika,,0,0,0,,回想起來 Doloris
Dialogue: 1,0:19:48.30,0:19:50.51,Uika - JP,,0,0,0,,何度 この地を訪れた
Dialogue: 2,0:19:48.30,0:19:50.51,Uika,,0,0,0,,你已經拜訪此地多少回了
Dialogue: 1,0:19:52.06,0:19:55.05,Uika - JP,,0,0,0,,なぜ オブリビオニスの名を 知っている
Dialogue: 2,0:19:52.06,0:19:55.05,Uika,,0,0,0,,為何你知道Oblivionis的名字
Dialogue: 1,0:19:56.24,0:19:59.52,Uika - JP,,0,0,0,,なぜ お前は忘却を求める
Dialogue: 2,0:19:56.24,0:19:59.52,Uika,,0,0,0,,為何你回尋求忘卻
Dialogue: 1,0:20:00.25,0:20:02.04,Uika - JP,,0,0,0,, ただ 会いたくて
Dialogue: 2,0:20:00.25,0:20:02.04,Uika,,0,0,0,,只是想要見面
Dialogue: 1,0:20:11.11,0:20:14.91,Uika - JP,,0,0,0,,あなたを忘れる！ それで そばにいられるなら
Dialogue: 2,0:20:11.11,0:20:14.91,Uika,,0,0,0,,我會忘掉你 然後如果你能讓我在你身旁
Dialogue: 1,0:20:15.12,0:20:16.58,Uika - JP,,0,0,0,,全て忘れます
Dialogue: 2,0:20:15.12,0:20:16.58,Uika,,0,0,0,,我會忘掉一切
Dialogue: 1,0:20:17.20,0:20:21.20,Uika - JP,,0,0,0,,あなたを忘れる この悲しみすら忘れる
Dialogue: 2,0:20:17.20,0:20:21.20,Uika,,0,0,0,,我會忘記你 連同忘記你的悲傷一起
Dialogue: 1,0:16:16.00,0:16:18.33,Nyamu - JP,,0,0,0,,ふ～ん そんな物好き
Dialogue: 2,0:16:16.00,0:16:18.33,Nyamu,,0,0,0,,哼~ 這樣的好事者
Dialogue: 1,0:16:18.33,0:16:20.10,Nyamu - JP,,0,0,0,,俺たち以外にもいたんだ
Dialogue: 2,0:16:18.33,0:16:20.10,Nyamu,,0,0,0,,原來除了我們還存在啊
Dialogue: 1,0:16:25.07,0:16:28.54,Nyamu - JP,,0,0,0,,愛の騎士 アモーリス そんで あっちは…
Dialogue: 2,0:16:25.07,0:16:28.54,Nyamu,,0,0,0,,愛之騎士 Amoris 然後那邊的是
Dialogue: 1,0:16:29.03,0:16:29.94,Nyamu - JP,,0,0,0,,何してんの？
Dialogue: 2,0:16:29.03,0:16:29.94,Nyamu,,0,0,0,,幹什麼呢
Dialogue: 1,0:16:31.58,0:16:32.72,Nyamu - JP,,0,0,0,,だから 何を？
Dialogue: 2,0:16:31.58,0:16:32.72,Nyamu,,0,0,0,,所以 在聽什麼
Dialogue: 1,0:16:36.48,0:16:38.98,Nyamu - JP,,0,0,0,,死の騎士 モーティス 変なヤツ
Dialogue: 2,0:16:36.48,0:16:38.98,Nyamu,,0,0,0,,死亡之騎士 Mortis 奇怪的傢伙
Dialogue: 1,0:16:46.93,0:16:48.82,Nyamu - JP,,0,0,0,,適当なことばっか
Dialogue: 2,0:16:46.93,0:16:48.82,Nyamu,,0,0,0,,光瞎胡鬧
Dialogue: 1,0:16:50.74,0:16:52.72,Nyamu - JP,,0,0,0,,所詮 うたかたの箱庭だろう
Dialogue: 2,0:16:50.74,0:16:52.72,Nyamu,,0,0,0,,此處不過是泡沫般的箱庭吧
Dialogue: 1,0:16:54.55,0:16:56.59,Nyamu - JP,,0,0,0,,世界が壊れるそのときまで
Dialogue: 2,0:16:54.55,0:16:56.59,Nyamu,,0,0,0,,不過是世界崩壞一刻到來之前
Dialogue: 1,0:16:57.00,0:17:00.16,Nyamu - JP,,0,0,0,,楽しく踊って暮らすだけの…
Dialogue: 2,0:16:57.00,0:17:00.16,Nyamu,,0,0,0,,愉快地跳著舞生活著的
Dialogue: 1,0:17:46.57,0:17:48.50,Nyamu - JP,,0,0,0,,世界が壊れる音？
Dialogue: 2,0:17:46.57,0:17:48.50,Nyamu,,0,0,0,,世界崩壞的聲音？
Dialogue: 1,0:17:48.98,0:17:50.40,Nyamu - JP,,0,0,0,,俺には聞こえない
Dialogue: 2,0:17:48.98,0:17:50.40,Nyamu,,0,0,0,,我是聽不到
Dialogue: 1,0:17:51.40,0:17:56.69,Nyamu - JP,,0,0,0,,なんで… なんで あいつには… 羨み 憎んでしまうほどの愛なんて
Dialogue: 2,0:17:51.40,0:17:56.69,Nyamu,,0,0,0,,為何...為何對那傢伙 有著嫉恨交加的愛
Dialogue: 1,0:17:57.06,0:17:58.57,Nyamu - JP,,0,0,0,,忘れさせてくれよ！
Dialogue: 2,0:17:57.06,0:17:58.57,Nyamu,,0,0,0,,讓我忘掉它吧
Dialogue: 1,0:18:21.52,0:18:22.57,Nyamu - JP,,0,0,0,,愛じゃダメ
Dialogue: 2,0:18:21.52,0:18:22.57,Nyamu,,0,0,0,,愛不可以嗎
Dialogue: 1,0:16:30.00,0:16:31.58,Mutsumi - JP,,0,0,0,,聞いてる
Dialogue: 2,0:16:30.00,0:16:31.58,Mutsumi,,0,0,0,,我在聽
Dialogue: 1,0:16:34.44,0:16:36.00,Mutsumi - JP,,0,0,0,,世界が壊れる音
Dialogue: 2,0:16:34.44,0:16:36.00,Mutsumi,,0,0,0,,世界崩壞的聲音
Dialogue: 1,0:17:03.42,0:17:05.51,Mutsumi - JP,,0,0,0,,欺瞞に満ちたパラディースス
Dialogue: 2,0:17:03.42,0:17:05.51,Mutsumi,,0,0,0,,充滿欺瞞的paradisus（樂園）
Dialogue: 1,0:17:10.38,0:17:11.77,Mutsumi - JP,,0,0,0,,オブリビオニスはいない
Dialogue: 2,0:17:10.38,0:17:11.77,Mutsumi,,0,0,0,,Oblivionis不在這裡
Dialogue: 1,0:17:12.49,0:17:13.31,Mutsumi - JP,,0,0,0,,残念だけど
Dialogue: 2,0:17:12.49,0:17:13.31,Mutsumi,,0,0,0,,雖然很遺憾
Dialogue: 1,0:17:14.38,0:17:16.39,Mutsumi - JP,,0,0,0,,ずっと前に消えてしまったって
Dialogue: 2,0:17:14.38,0:17:16.39,Mutsumi,,0,0,0,,據說很早之前就消失了
Dialogue: 1,0:17:18.50,0:17:20.07,Mutsumi - JP,,0,0,0,,僕たちも ずっと願ってる
Dialogue: 2,0:17:18.50,0:17:20.07,Mutsumi,,0,0,0,,我們也在一直祈禱著
Dialogue: 1,0:17:21.25,0:17:23.27,Mutsumi - JP,,0,0,0,,いつか彼女が楽園に戻り
Dialogue: 2,0:17:21.25,0:17:23.27,Mutsumi,,0,0,0,,祈禱她有一天能回到樂園
Dialogue: 1,0:17:24.18,0:17:26.40,Mutsumi - JP,,0,0,0,,忘却を与えてくれる その日を…
Dialogue: 2,0:17:24.18,0:17:26.40,Mutsumi,,0,0,0,,贈與我們忘卻的那一天...
Dialogue: 1,0:17:28.17,0:17:29.22,Mutsumi - JP,,0,0,0,,僕の命は
Dialogue: 2,0:17:28.17,0:17:29.22,Mutsumi,,0,0,0,,我的生命
Dialogue: 1,0:17:29.81,0:17:31.67,Mutsumi - JP,,0,0,0,,たくさんの死の上に立ってる
Dialogue: 2,0:17:29.81,0:17:31.67,Mutsumi,,0,0,0,,立於百萬屍骸之上
Dialogue: 1,0:17:32.67,0:17:33.77,Mutsumi - JP,,0,0,0,,望みもしないのに
Dialogue: 2,0:17:32.67,0:17:33.77,Mutsumi,,0,0,0,,明明不曾期待
Dialogue: 1,0:17:34.67,0:17:36.26,Mutsumi - JP,,0,0,0,,ただ僕が生きるため…
Dialogue: 2,0:17:34.67,0:17:36.26,Mutsumi,,0,0,0,,只是為了我能活著
Dialogue: 1,0:17:37.15,0:17:40.30,Mutsumi - JP,,0,0,0,,昨日も１つ 今日も１つ
Dialogue: 2,0:17:37.15,0:17:40.30,Mutsumi,,0,0,0,,昨天死了一個 今天也死了一個
Dialogue: 1,0:17:41.57,0:17:45.04,Mutsumi - JP,,0,0,0,,全部 忘れてしまいたい
Dialogue: 2,0:17:41.57,0:17:45.04,Mutsumi,,0,0,0,,我想把這些全都忘記
Dialogue: 1,0:18:07.64,0:18:10.29,Mutsumi - JP,,0,0,0,,ただ 願うことしかできない
Dialogue: 2,0:18:07.64,0:18:10.29,Mutsumi,,0,0,0,,但是 我們只能祈禱
Dialogue: 1,0:18:26.27,0:18:27.75,Mutsumi - JP,,0,0,0,,死をあげる
Dialogue: 2,0:18:26.27,0:18:27.75,Mutsumi,,0,0,0,,賜予你死亡

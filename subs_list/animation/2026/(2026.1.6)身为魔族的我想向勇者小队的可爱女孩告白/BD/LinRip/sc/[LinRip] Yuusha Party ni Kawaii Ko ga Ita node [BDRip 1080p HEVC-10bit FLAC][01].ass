Dialogue: 0,0:00:12.01,0:00:14.10,Sousei-JP,,0,0,0,,ここが 魔王の城
Dialogue: 0,0:00:12.01,0:00:14.10,Sousei-CN,,0,0,0,,这里就是 魔王城
Dialogue: 0,0:00:14.50,0:00:16.99,Sousei-JP,,0,0,0,,みんな 覚悟はいいか
Dialogue: 0,0:00:14.50,0:00:16.99,Sousei-CN,,0,0,0,,各位 做好觉悟了吗
Dialogue: 0,0:00:16.99,0:00:22.16,Sousei-JP,,0,0,0,,ええ 魔王や手下たちの能力は すべて調べ上げたわ
Dialogue: 0,0:00:16.99,0:00:22.16,Sousei-CN,,0,0,0,,嗯 魔王和他部下的能力 我已经调查好了
Dialogue: 0,0:00:22.16,0:00:25.06,Sousei-JP,,0,0,0,,ユウガ あなたなら絶対に勝てる
Dialogue: 0,0:00:22.16,0:00:25.06,Sousei-CN,,0,0,0,,悠贺 你的话一定能赢的
Dialogue: 0,0:00:25.06,0:00:28.00,Sousei-JP,,0,0,0,,ああ みんなで魔王を倒そう
Dialogue: 0,0:00:25.06,0:00:28.00,Sousei-CN,,0,0,0,,好 大家一起打倒魔王
Dialogue: 0,0:00:28.72,0:00:30.41,Sousei-JP,,0,0,0,,最善を尽くします
Dialogue: 0,0:00:28.72,0:00:30.41,Sousei-CN,,0,0,0,,我会尽最大的努力
Dialogue: 0,0:00:36.82,0:00:37.71,Sousei-JP,,0,0,0,,行くぞ
Dialogue: 0,0:00:36.82,0:00:37.71,Sousei-CN,,0,0,0,,我们上
Dialogue: 0,0:00:41.71,0:00:43.10,Sousei-JP,,0,0,0,,来たか
Dialogue: 0,0:00:41.71,0:00:43.10,Sousei-CN,,0,0,0,,来了吗
Dialogue: 0,0:00:48.96,0:00:52.96,Sousei-JP,,0,0,0,,貴様らが魔王様を倒しに来た勇者どもか
Dialogue: 0,0:00:48.96,0:00:52.96,Sousei-CN,,0,0,0,,你们就是要来 打倒魔王大人的勇者吗
Dialogue: 0,0:00:52.96,0:00:55.16,Sousei-JP,,0,0,0,,だが残念だったな
Dialogue: 0,0:00:52.96,0:00:55.16,Sousei-CN,,0,0,0,,但是很遗憾
Dialogue: 0,0:00:55.16,0:00:57.92,Sousei-JP,,0,0,0,,私を倒さねば魔王様のところへは
Dialogue: 0,0:00:55.16,0:00:57.92,Sousei-CN,,0,0,0,,在打倒我之前 你们无法前往魔王大人的地方
Dialogue: 0,0:01:01.76,0:01:03.96,Sousei-JP,,0,0,0,,脆弱な魔法だな
Dialogue: 0,0:01:01.76,0:01:03.96,Sousei-CN,,0,0,0,,真是脆弱的魔法
Dialogue: 0,0:01:04.46,0:01:07.72,Sousei-JP,,0,0,0,,勇者パーティの力はそんなものか
Dialogue: 0,0:01:04.46,0:01:07.72,Sousei-CN,,0,0,0,,勇者团队的力量就只有这点程度吗
Dialogue: 0,0:01:13.96,0:01:15.17,Sousei-JP,,0,0,0,,援護します
Dialogue: 0,0:01:13.96,0:01:15.17,Sousei-CN,,0,0,0,,我来掩护各位
Dialogue: 0,0:01:16.01,0:01:17.26,Sousei-JP,,0,0,0,,くらえ
Dialogue: 0,0:01:16.01,0:01:17.26,Sousei-CN,,0,0,0,,吃我这招
Dialogue: 0,0:01:17.26,0:01:19.47,Sousei-JP,,0,0,0,,エクスカリバー
Dialogue: 0,0:01:17.26,0:01:19.47,Sousei-CN,,0,0,0,,王者之剑
Dialogue: 0,0:01:19.72,0:01:21.46,Sousei-JP,,0,0,0,,エンドレスダーク
Dialogue: 0,0:01:19.72,0:01:21.46,Sousei-CN,,0,0,0,,无尽深渊
Dialogue: 0,0:01:31.31,0:01:33.61,Sousei-JP,,0,0,0,,ここまで なのか
Dialogue: 0,0:01:31.31,0:01:33.61,Sousei-CN,,0,0,0,,到此为止了吗
Dialogue: 0,0:01:50.26,0:01:51.26,Sousei-JP,,0,0,0,,やばい
Dialogue: 0,0:01:50.26,0:01:51.26,Sousei-CN,,0,0,0,,糟糕
Dialogue: 0,0:01:52.52,0:01:54.32,Sousei-JP,,0,0,0,,ドストライクだ
Dialogue: 0,0:01:52.52,0:01:54.32,Sousei-CN,,0,0,0,,正中红心
Dialogue: 0,0:01:58.32,0:02:01.21,Sousei-JP,,0,0,0,,始末しますか 隊長
Dialogue: 0,0:01:58.32,0:02:01.21,Sousei-CN,,0,0,0,,要处理他们吗 队长
Dialogue: 0,0:02:01.91,0:02:04.66,Sousei-JP,,0,0,0,,お前ら 隠れてろって言ったろ
Dialogue: 0,0:02:01.91,0:02:04.66,Sousei-CN,,0,0,0,,你们几个 我不是叫你们躲好吗
Dialogue: 0,0:02:04.66,0:02:07.41,Sousei-JP,,0,0,0,,静かになったから 出てきたっす
Dialogue: 0,0:02:04.66,0:02:07.41,Sousei-CN,,0,0,0,,因为外面变安静了 我们才出来的
Dialogue: 0,0:02:07.41,0:02:10.61,Sousei-JP,,0,0,0,,隊長 この人じっと 見てたけど
Dialogue: 0,0:02:07.41,0:02:10.61,Sousei-CN,,0,0,0,,队长 你一直盯着那个人看
Dialogue: 0,0:02:10.61,0:02:11.67,Sousei-JP,,0,0,0,,どうしたの
Dialogue: 0,0:02:10.61,0:02:11.67,Sousei-CN,,0,0,0,,怎么了吗
Dialogue: 0,0:02:12.07,0:02:13.06,Sousei-JP,,0,0,0,,変態
Dialogue: 0,0:02:12.07,0:02:13.06,Sousei-CN,,0,0,0,,变态
Dialogue: 0,0:02:13.06,0:02:16.07,Sousei-JP,,0,0,0,,バカ どうするか考えてただけだ
Dialogue: 0,0:02:13.07,0:02:16.07,Sousei-CN,,0,0,0,,笨蛋 我只是在想接下来该怎么办
Dialogue: 0,0:02:16.41,0:02:19.42,Sousei-JP,,0,0,0,,どうって 殺すんじゃないっすか
Dialogue: 0,0:02:16.41,0:02:19.42,Sousei-CN,,0,0,0,,什么怎么办 不是杀了他们吗
Dialogue: 0,0:02:19.42,0:02:22.83,Sousei-JP,,0,0,0,,いや 全員外に捨ててこい
Dialogue: 0,0:02:19.42,0:02:22.83,Sousei-CN,,0,0,0,,不 全部丢到外面去吧
Dialogue: 0,0:02:23.36,0:02:26.22,Sousei-JP,,0,0,0,,{\an8}ちょっと行った先に 人間の村があったろ
Dialogue: 0,0:02:23.36,0:02:26.22,Sousei-CN,,0,0,0,,{\an8}前面不久处有个人类的村庄吧
Dialogue: 0,0:02:26.22,0:02:27.62,Sousei-JP,,0,0,0,,{\an8}その辺にだ
Dialogue: 0,0:02:26.22,0:02:27.62,Sousei-CN,,0,0,0,,{\an8}就丢到那附近
Dialogue: 0,0:02:27.91,0:02:30.12,Sousei-JP,,0,0,0,,了解っす
Dialogue: 0,0:02:27.91,0:02:30.12,Sousei-CN,,0,0,0,,收到
Dialogue: 0,0:02:30.47,0:02:32.13,Sousei-JP,,0,0,0,,面倒
Dialogue: 0,0:02:30.47,0:02:32.13,Sousei-CN,,0,0,0,,麻烦
Dialogue: 0,0:02:32.46,0:02:36.11,Sousei-JP,,0,0,0,,こんなことしてたら隊長また怒られるよ
Dialogue: 0,0:02:32.46,0:02:36.11,Sousei-CN,,0,0,0,,做这种事 队长又会被骂喔
Dialogue: 0,0:02:36.11,0:02:37.71,Sousei-JP,,0,0,0,,いいから行ってこい
Dialogue: 0,0:02:36.11,0:02:37.71,Sousei-CN,,0,0,0,,别啰唆 快去快回
Dialogue: 0,0:02:37.71,0:02:39.07,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:02:37.71,0:02:39.07,Sousei-CN,,0,0,0,,好
Dialogue: 0,0:02:39.56,0:02:42.80,Sousei-JP,,0,0,0,,さよなら マイエンジェル
Dialogue: 0,0:02:39.56,0:02:42.80,Sousei-CN,,0,0,0,,再见了 我的天使
Dialogue: 0,0:02:42.80,0:02:45.81,pingmu-1,,0,0,0,,(一个月后)
Dialogue: 0,0:02:44.76,0:02:45.81,Sousei-JP,,0,0,0,,{\pos(960,120)}ヨウキよ
Dialogue: 0,0:02:44.76,0:02:45.81,Sousei-CN,,0,0,0,,{\pos(960,80)}阳树
Dialogue: 0,0:02:45.81,0:02:50.46,Sousei-JP,,0,0,0,,あれから勇者一行は性懲りもなく お前に挑んでは敗れ
Dialogue: 0,0:02:45.81,0:02:50.46,Sousei-CN,,0,0,0,,自那以后勇者一行不记教训 不断向你挑战并失败
Dialogue: 0,0:02:50.46,0:02:52.56,Sousei-JP,,0,0,0,,挑んでは敗れ
Dialogue: 0,0:02:50.46,0:02:52.56,Sousei-CN,,0,0,0,,不断挑战并失败
Dialogue: 0,0:02:52.92,0:02:54.76,Sousei-JP,,0,0,0,,今何度目ですか
Dialogue: 0,0:02:52.92,0:02:54.76,Sousei-CN,,0,0,0,,到现在是第几回了
Dialogue: 0,0:02:54.76,0:02:57.32,Sousei-JP,,0,0,0,,１３回です ザエキル様
Dialogue: 0,0:02:54.76,0:02:57.32,Sousei-CN,,0,0,0,,第13回了 札耶奇尔大人
Dialogue: 0,0:02:58.51,0:03:00.96,Sousei-JP,,0,0,0,,お前ごときに倒されるとは
Dialogue: 0,0:02:58.51,0:03:00.96,Sousei-CN,,0,0,0,,连你都打倒不了
Dialogue: 0,0:03:00.96,0:03:04.08,Sousei-JP,,0,0,0,,勇者など恐るるに足りませんねぇ
Dialogue: 0,0:03:00.96,0:03:04.08,Sousei-CN,,0,0,0,,看来勇者根本就不足为惧
Dialogue: 0,0:03:09.96,0:03:11.17,Sousei-JP,,0,0,0,,ヨウキ
Dialogue: 0,0:03:09.96,0:03:11.17,Sousei-CN,,0,0,0,,阳树
Dialogue: 0,0:03:11.17,0:03:14.86,Sousei-JP,,0,0,0,,なぜ勇者どもを殺さない
Dialogue: 0,0:03:11.17,0:03:14.86,Sousei-CN,,0,0,0,,为何不杀了勇者一行人
Dialogue: 0,0:03:14.86,0:03:16.47,Sousei-JP,,0,0,0,,魔王様
Dialogue: 0,0:03:14.86,0:03:16.47,Sousei-CN,,0,0,0,,魔王大人
Dialogue: 0,0:03:16.47,0:03:19.67,Sousei-JP,,0,0,0,,あのような雑魚 殺す価値すらありません
Dialogue: 0,0:03:16.47,0:03:19.67,Sousei-CN,,0,0,0,,那些杂碎没有被杀的价值
Dialogue: 0,0:03:21.11,0:03:23.93,Sousei-JP,,0,0,0,, お前がやらないというなら
Dialogue: 0,0:03:21.11,0:03:23.93,Sousei-CN,,0,0,0,,既然你不愿下手
Dialogue: 0,0:03:24.22,0:03:28.17,Sousei-JP,,0,0,0,,お前の部下たちに相手をさせようか
Dialogue: 0,0:03:24.22,0:03:28.17,Sousei-CN,,0,0,0,,就让你的属下们 去当他们的对手吧
Dialogue: 0,0:03:28.46,0:03:29.71,Sousei-JP,,0,0,0,,ダメだ
Dialogue: 0,0:03:28.46,0:03:29.71,Sousei-CN,,0,0,0,,不行
Dialogue: 0,0:03:29.71,0:03:32.16,Sousei-JP,,0,0,0,,あいつらじゃ勇者たちに敵わない
Dialogue: 0,0:03:29.71,0:03:32.16,Sousei-CN,,0,0,0,,他们不是勇者一行人的对手
Dialogue: 0,0:03:32.16,0:03:33.69,Sousei-JP,,0,0,0,,それに
Dialogue: 0,0:03:32.16,0:03:33.69,Sousei-CN,,0,0,0,,而且
Dialogue: 0,0:03:34.72,0:03:37.82,Sousei-JP,,0,0,0,,いえ 私がやります 魔王様
Dialogue: 0,0:03:34.72,0:03:37.82,Sousei-CN,,0,0,0,,不 还是我来吧 魔王大人
Dialogue: 0,0:03:43.76,0:03:46.36,Sousei-JP,,0,0,0,,次また勇者たちを見逃したら
Dialogue: 0,0:03:43.76,0:03:46.36,Sousei-CN,,0,0,0,,下次再放过勇者他们的话
Dialogue: 0,0:03:46.36,0:03:48.29,Sousei-JP,,0,0,0,,あいつらの命が危ない
Dialogue: 0,0:03:46.36,0:03:48.29,Sousei-CN,,0,0,0,,他们就有生命危险
Dialogue: 0,0:03:49.16,0:03:51.66,Sousei-JP,,0,0,0,,俺がチート級に強いだけで
Dialogue: 0,0:03:49.16,0:03:51.66,Sousei-CN,,0,0,0,,我的力量强是作弊级的
Dialogue: 0,0:03:51.66,0:03:55.91,Sousei-JP,,0,0,0,,あの勇者たちは 魔王を倒すだけの力を持ってる
Dialogue: 0,0:03:51.66,0:03:55.91,Sousei-CN,,0,0,0,,而那些勇者们拥有打倒魔王的力量
Dialogue: 0,0:03:56.71,0:03:59.61,Sousei-JP,,0,0,0,,それに そうこうしてる間にも
Dialogue: 0,0:03:56.71,0:03:59.61,Sousei-CN,,0,0,0,,再继续拖下去
Dialogue: 0,0:03:59.61,0:04:02.68,Sousei-JP,,0,0,0,,世界が魔王に支配されちゃうんだよな
Dialogue: 0,0:03:59.61,0:04:02.68,Sousei-CN,,0,0,0,,世界就要被魔王统治了
Dialogue: 0,0:04:05.51,0:04:07.72,Sousei-JP,,0,0,0,,次でケリをつけるか
Dialogue: 0,0:04:05.51,0:04:07.72,Sousei-CN,,0,0,0,,下次要做个了断
Dialogue: 0,0:04:10.82,0:04:13.31,Sousei-JP,,0,0,0,,今日こそはお前を倒す
Dialogue: 0,0:04:10.82,0:04:13.31,Sousei-CN,,0,0,0,,今天一定要打倒你
Dialogue: 0,0:04:13.31,0:04:14.71,Sousei-JP,,0,0,0,,行くぞ レイヴン
Dialogue: 0,0:04:13.31,0:04:14.71,Sousei-CN,,0,0,0,, 我们上 渡鸦
Dialogue: 0,0:04:30.22,0:04:31.66,Sousei-JP,,0,0,0,,ユウガ 剣士
Dialogue: 0,0:04:30.22,0:04:31.66,Sousei-CN,,0,0,0,,悠贺 剑士
Dialogue: 0,0:04:31.66,0:04:32.67,Sousei-JP,,0,0,0,,回復します
Dialogue: 0,0:04:31.66,0:04:32.67,Sousei-CN,,0,0,0,,我来帮他们恢复
Dialogue: 0,0:04:32.67,0:04:33.87,Sousei-JP,,0,0,0,,ミカナさん
Dialogue: 0,0:04:32.67,0:04:33.87,Sousei-CN,,0,0,0,,米卡娜
Dialogue: 0,0:04:34.79,0:04:35.91,Sousei-JP,,0,0,0,,この
Dialogue: 0,0:04:34.79,0:04:35.91,Sousei-CN,,0,0,0,,可恶
Dialogue: 0,0:04:48.91,0:04:51.06,Sousei-JP,,0,0,0,,なんて 奴なの
Dialogue: 0,0:04:48.91,0:04:51.06,Sousei-CN,,0,0,0,,那家伙 太夸张了吧
Dialogue: 0,0:05:03.36,0:05:05.86,Sousei-JP,,0,0,0,,何度戦っても無駄だ
Dialogue: 0,0:05:03.36,0:05:05.86,Sousei-CN,,0,0,0,,不管来挑战几次都没用
Dialogue: 0,0:05:05.86,0:05:09.06,Sousei-JP,,0,0,0,,また漆黒の闇へ落とされたいか
Dialogue: 0,0:05:05.86,0:05:09.06,Sousei-CN,,0,0,0,,你们想再次被扔进 那漆黑之中吗
Dialogue: 0,0:05:10.26,0:05:11.76,Sousei-JP,,0,0,0,,セシリア 援護を
Dialogue: 0,0:05:10.26,0:05:11.76,Sousei-CN,,0,0,0,,赛西莉亚 援助我们
Dialogue: 0,0:05:11.76,0:05:12.56,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:05:11.76,0:05:12.56,Sousei-CN,,0,0,0,,是
Dialogue: 0,0:05:14.86,0:05:16.41,Sousei-JP,,0,0,0,,受けてみろ
Dialogue: 0,0:05:14.86,0:05:16.41,Sousei-CN,,0,0,0,,吃我这招
Dialogue: 0,0:05:16.41,0:05:20.42,Sousei-JP,,0,0,0,,聖剣 エクスカリバー
Dialogue: 0,0:05:16.41,0:05:20.42,Sousei-CN,,0,0,0,,圣剑 王者之剑
Dialogue: 0,0:05:31.16,0:05:33.11,Sousei-JP,,0,0,0,,なあ 勇者よ
Dialogue: 0,0:05:31.16,0:05:33.11,Sousei-CN,,0,0,0,,呐 勇者啊
Dialogue: 0,0:05:33.72,0:05:36.52,Sousei-JP,,0,0,0,,貴様は気づいているのではないか
Dialogue: 0,0:05:33.72,0:05:36.52,Sousei-CN,,0,0,0,,你应该已经注意到了吧
Dialogue: 0,0:05:37.41,0:05:39.77,Sousei-JP,,0,0,0,,私には勝てないと
Dialogue: 0,0:05:37.41,0:05:39.77,Sousei-CN,,0,0,0,,你是赢不了我的
Dialogue: 0,0:05:42.46,0:05:43.71,Sousei-JP,,0,0,0,,だからどうした
Dialogue: 0,0:05:42.46,0:05:43.71,Sousei-CN,,0,0,0,,那又怎样
Dialogue: 0,0:05:43.71,0:05:46.74,Sousei-JP,,0,0,0,,僕たちは魔王を倒さなきゃいけないんだ
Dialogue: 0,0:05:43.71,0:05:46.74,Sousei-CN,,0,0,0,,我们必须打倒魔王
Dialogue: 0,0:05:47.76,0:05:49.01,Sousei-JP,,0,0,0,, では
Dialogue: 0,0:05:47.76,0:05:49.01,Sousei-CN,,0,0,0,,那么
Dialogue: 0,0:05:52.76,0:05:55.02,Sousei-JP,,0,0,0,,その僧侶を置いていけ
Dialogue: 0,0:05:52.76,0:05:55.02,Sousei-CN,,0,0,0,,留下那位僧侣
Dialogue: 0,0:05:55.02,0:05:57.96,Sousei-JP,,0,0,0,,そうすれば 他の３人は通してやろう
Dialogue: 0,0:05:55.02,0:05:57.96,Sousei-CN,,0,0,0,,那样的话 我就让剩下三人过去
Dialogue: 0,0:05:59.21,0:06:01.72,Sousei-JP,,0,0,0,,この先に進みたいんだろう
Dialogue: 0,0:05:59.21,0:06:01.72,Sousei-CN,,0,0,0,,你们想继续前进吧
Dialogue: 0,0:06:01.96,0:06:03.01,Sousei-JP,,0,0,0,,断る
Dialogue: 0,0:06:01.96,0:06:03.01,Sousei-CN,,0,0,0,,我拒绝
Dialogue: 0,0:06:03.01,0:06:04.27,Sousei-JP,,0,0,0,,ユウガ
Dialogue: 0,0:06:03.02,0:06:04.27,Sousei-CN,,0,0,0,,悠贺
Dialogue: 0,0:06:04.27,0:06:06.01,Sousei-JP,,0,0,0,,取引に応じましょう
Dialogue: 0,0:06:04.27,0:06:06.01,Sousei-CN,,0,0,0,,接受这份交易吧
Dialogue: 0,0:06:06.01,0:06:08.22,Sousei-JP,,0,0,0,,私たちじゃあいつに勝てないわ
Dialogue: 0,0:06:06.01,0:06:08.22,Sousei-CN,,0,0,0,,我们根本赢不了那家伙
Dialogue: 0,0:06:08.22,0:06:09.77,Sousei-JP,,0,0,0,,そんな
Dialogue: 0,0:06:08.22,0:06:09.77,Sousei-CN,,0,0,0,,怎么这样
Dialogue: 0,0:06:10.92,0:06:11.56,Sousei-JP,,0,0,0,,ダメだ
Dialogue: 0,0:06:10.92,0:06:11.56,Sousei-CN,,0,0,0,,不行
Dialogue: 0,0:06:11.99,0:06:13.51,Sousei-JP,,0,0,0,,冷静になって
Dialogue: 0,0:06:11.99,0:06:13.51,Sousei-CN,,0,0,0,,你冷静想想
Dialogue: 0,0:06:13.51,0:06:16.91,Sousei-JP,,0,0,0,,あいつは何度も私たちを殺すチャンスがあったのに
Dialogue: 0,0:06:13.51,0:06:16.91,Sousei-CN,,0,0,0,,那家伙明明有好几次机会能杀了我们
Dialogue: 0,0:06:16.91,0:06:18.61,Sousei-JP,,0,0,0,, それをしなかったのよ
Dialogue: 0,0:06:16.91,0:06:18.61,Sousei-CN,,0,0,0,,但他都没有那样做
Dialogue: 0,0:06:18.61,0:06:19.46,Sousei-JP,,0,0,0,,だからって
Dialogue: 0,0:06:18.61,0:06:19.46,Sousei-CN,,0,0,0,,那又怎样
Dialogue: 0,0:06:19.46,0:06:21.68,Sousei-JP,,0,0,0,,今回も無事とは限らないじゃないか
Dialogue: 0,0:06:19.46,0:06:21.68,Sousei-CN,,0,0,0,,谁能保证这次也会没事
Dialogue: 0,0:06:23.72,0:06:25.47,Sousei-JP,,0,0,0,,僧侶ひとりより
Dialogue: 0,0:06:23.72,0:06:25.47,Sousei-CN,,0,0,0,,比起僧侣一个人
Dialogue: 0,0:06:25.47,0:06:28.70,Sousei-JP,,0,0,0,,世界を救うほうが 大事でしょ
Dialogue: 0,0:06:25.47,0:06:28.70,Sousei-CN,,0,0,0,,拯救世界要 更重要吧
Dialogue: 0,0:06:31.51,0:06:32.81,Sousei-JP,,0,0,0,,行ってください
Dialogue: 0,0:06:31.51,0:06:32.81,Sousei-CN,,0,0,0,,你们快前进吧
Dialogue: 0,0:06:38.16,0:06:40.04,Sousei-JP,,0,0,0,,私なら大丈夫です
Dialogue: 0,0:06:38.16,0:06:40.04,Sousei-CN,,0,0,0,,我不会有事的
Dialogue: 0,0:06:40.26,0:06:42.07,Sousei-JP,,0,0,0,,セシリア
Dialogue: 0,0:06:40.26,0:06:42.07,Sousei-CN,,0,0,0,,赛西莉亚
Dialogue: 0,0:06:44.06,0:06:45.82,Sousei-JP,,0,0,0,,魔王を倒したら
Dialogue: 0,0:06:44.06,0:06:45.82,Sousei-CN,,0,0,0,,等我们打倒魔王
Dialogue: 0,0:06:45.82,0:06:47.47,Sousei-JP,,0,0,0,,すぐここに戻る
Dialogue: 0,0:06:45.82,0:06:47.47,Sousei-CN,,0,0,0,,就立刻回来这里
Dialogue: 0,0:06:48.86,0:06:50.66,Sousei-JP,,0,0,0,,では行くがいい
Dialogue: 0,0:06:48.86,0:06:50.66,Sousei-CN,,0,0,0,,那就过去吧
Dialogue: 0,0:06:52.21,0:06:54.18,Sousei-JP,,0,0,0,,絶対戻ってくるから
Dialogue: 0,0:06:52.21,0:06:54.18,Sousei-CN,,0,0,0,,我一定会回来的
Dialogue: 0,0:06:58.02,0:07:00.56,Sousei-JP,,0,0,0,,なぜ私だけを残したのです
Dialogue: 0,0:06:58.02,0:07:00.56,Sousei-CN,,0,0,0,,为什么只留下我一人
Dialogue: 0,0:07:00.77,0:07:02.07,Sousei-JP,,0,0,0,,それは…
Dialogue: 0,0:07:00.77,0:07:02.07,Sousei-CN,,0,0,0,,那是因为…
Dialogue: 0,0:07:04.06,0:07:08.32,Sousei-JP,,0,0,0,,私の力では あなたに傷ひとつ付けられないでしょう
Dialogue: 0,0:07:04.06,0:07:08.32,Sousei-CN,,0,0,0,,我的力量 无法对你造成任何伤害
Dialogue: 0,0:07:08.32,0:07:10.56,Sousei-JP,,0,0,0,,でも最期まであがいてみせます
Dialogue: 0,0:07:08.32,0:07:10.56,Sousei-CN,,0,0,0,,但我会抵抗到最后
Dialogue: 0,0:07:10.56,0:07:12.32,Sousei-JP,,0,0,0,,ホーリーレーザー
Dialogue: 0,0:07:10.56,0:07:12.32,Sousei-CN,,0,0,0,,神圣光束
Dialogue: 0,0:07:12.82,0:07:14.61,Sousei-JP,,0,0,0,,あ ちょ タンマ
Dialogue: 0,0:07:12.82,0:07:14.61,Sousei-CN,,0,0,0,,慢着 暂停
Dialogue: 0,0:07:18.51,0:07:20.62,Sousei-JP,,0,0,0,,話を聞いてくれ
Dialogue: 0,0:07:18.51,0:07:20.62,Sousei-CN,,0,0,0,,请听我说
Dialogue: 0,0:07:20.81,0:07:24.22,Sousei-JP,,0,0,0,,あの 俺はヨウキって言うんだけど
Dialogue: 0,0:07:20.81,0:07:24.22,Sousei-CN,,0,0,0,,那个 我的名字叫阳树
Dialogue: 0,0:07:24.62,0:07:27.71,Sousei-JP,,0,0,0,,殺す相手に名乗っても仕方ないでしょう
Dialogue: 0,0:07:24.62,0:07:27.71,Sousei-CN,,0,0,0,,对你要杀死的对象 报上名号也没意义吧
Dialogue: 0,0:07:27.71,0:07:28.76,Sousei-JP,,0,0,0,,違う
Dialogue: 0,0:07:27.71,0:07:28.76,Sousei-CN,,0,0,0,,不是的
Dialogue: 0,0:07:28.76,0:07:32.17,Sousei-JP,,0,0,0,,殺すつもりなら 初めて会った時にそうしてる
Dialogue: 0,0:07:28.76,0:07:32.17,Sousei-CN,,0,0,0,,如果我要杀死你们的话 打从一开始我就会动手了
Dialogue: 0,0:07:33.36,0:07:35.67,Sousei-JP,,0,0,0,,話とは 何ですか
Dialogue: 0,0:07:33.36,0:07:35.67,Sousei-CN,,0,0,0,,你要说什么
Dialogue: 0,0:07:38.81,0:07:41.06,Sousei-JP,,0,0,0,,君に一目惚れしました
Dialogue: 0,0:07:38.81,0:07:41.06,Sousei-CN,,0,0,0,,我对你一见钟情了
Dialogue: 0,0:07:41.06,0:07:44.31,Sousei-JP,,0,0,0,,俺と付き合ってください
Dialogue: 0,0:07:41.06,0:07:44.31,Sousei-CN,,0,0,0,,请和我交往吧
Dialogue: 0,0:07:51.57,0:07:54.32,Sousei-JP,,0,0,0,,あの えっと
Dialogue: 0,0:07:51.57,0:07:54.32,Sousei-CN,,0,0,0,,那个 呃
Dialogue: 0,0:07:55.86,0:07:56.92,Sousei-JP,,0,0,0,,ごめんなさい
Dialogue: 0,0:07:55.86,0:07:56.92,Sousei-CN,,0,0,0,,对不起
Dialogue: 0,0:07:58.61,0:08:00.76,Sousei-JP,,0,0,0,,もうダメだ 死のう
Dialogue: 0,0:07:58.61,0:08:00.76,Sousei-CN,,0,0,0,,不行了 我想死了
Dialogue: 0,0:08:00.76,0:08:03.83,Sousei-JP,,0,0,0,,あ あの 大丈夫ですか
Dialogue: 0,0:08:00.76,0:08:03.83,Sousei-CN,,0,0,0,,请问 你没事吧
Dialogue: 0,0:08:04.66,0:08:07.76,Sousei-JP,,0,0,0,,油断を誘おうとしても騙されませんよ
Dialogue: 0,0:08:04.66,0:08:07.76,Sousei-CN,,0,0,0,,就算想让我大意 我也不会被骗的
Dialogue: 0,0:08:07.76,0:08:09.37,Sousei-JP,,0,0,0,,ホーリー
Dialogue: 0,0:08:07.76,0:08:09.37,Sousei-CN,,0,0,0,,神圣
Dialogue: 0,0:08:12.76,0:08:14.77,Sousei-JP,,0,0,0,,なぜ抵抗しないんですか
Dialogue: 0,0:08:12.76,0:08:14.77,Sousei-CN,,0,0,0,,你为什么不抵抗
Dialogue: 0,0:08:15.36,0:08:18.92,Sousei-JP,,0,0,0,,君にフラれたからもう思い残すことはない
Dialogue: 0,0:08:15.36,0:08:18.92,Sousei-CN,,0,0,0,,被你拒绝后 我已经没有任何留恋了
Dialogue: 0,0:08:18.92,0:08:20.36,Sousei-JP,,0,0,0,,ふざけないでください
Dialogue: 0,0:08:18.92,0:08:20.36,Sousei-CN,,0,0,0,,请不要跟我开玩笑
Dialogue: 0,0:08:20.36,0:08:21.93,Sousei-JP,,0,0,0,,本心だよ
Dialogue: 0,0:08:20.36,0:08:21.93,Sousei-CN,,0,0,0,,我是认真的
Dialogue: 0,0:08:22.42,0:08:24.01,Sousei-JP,,0,0,0,,生きていたって
Dialogue: 0,0:08:22.42,0:08:24.01,Sousei-CN,,0,0,0,,就算活着
Dialogue: 0,0:08:24.01,0:08:26.44,Sousei-JP,,0,0,0,,ずっとこの部屋にいることしかできない
Dialogue: 0,0:08:24.01,0:08:26.44,Sousei-CN,,0,0,0,,也只能一直待在这个房间里
Dialogue: 0,0:08:27.01,0:08:31.94,Sousei-JP,,0,0,0,,外に出られるのは 人間の街や村を襲撃する時だけ
Dialogue: 0,0:08:27.01,0:08:31.94,Sousei-CN,,0,0,0,,只有袭击人类城镇村庄时 才能到外面去
Dialogue: 0,0:08:32.41,0:08:35.21,Sousei-JP,,0,0,0,,だけど 俺はそんな事したくない
Dialogue: 0,0:08:32.41,0:08:35.21,Sousei-CN,,0,0,0,,可是 我不想做那些事
Dialogue: 0,0:08:35.21,0:08:38.70,Sousei-JP,,0,0,0,,嘘です 魔族はみな残酷で
Dialogue: 0,0:08:35.21,0:08:38.70,Sousei-CN,,0,0,0,,骗人 魔族都很残忍
Dialogue: 0,0:08:39.30,0:08:42.00,Sousei-JP,,0,0,0,,魔王も人間を滅ぼそうと しているじゃないですか
Dialogue: 0,0:08:39.30,0:08:42.00,Sousei-CN,,0,0,0,,魔王也想灭掉人类不是吗
Dialogue: 0,0:08:44.31,0:08:47.06,Sousei-JP,,0,0,0,,俺は魔族の姿をしてるけど
Dialogue: 0,0:08:44.31,0:08:47.06,Sousei-CN,,0,0,0,,虽然我的外表是魔族的样貌
Dialogue: 0,0:08:47.06,0:08:49.71,Sousei-JP,,0,0,0,,別の世界から転生してきたんだ
Dialogue: 0,0:08:47.06,0:08:49.71,Sousei-CN,,0,0,0,,但其实我是从别的世界转生而来的
Dialogue: 0,0:08:49.97,0:08:52.62,Sousei-JP,,0,0,0,,転生？ どういうことですか
Dialogue: 0,0:08:49.97,0:08:52.62,Sousei-CN,,0,0,0,,转生? 那是什么意思
Dialogue: 0,0:08:52.62,0:08:56.17,Sousei-JP,,0,0,0,,要は 中身は人間ってことかな
Dialogue: 0,0:08:52.62,0:08:56.17,Sousei-CN,,0,0,0,,简单来说 内在算是人类
Dialogue: 0,0:08:56.17,0:08:58.71,Sousei-JP,,0,0,0,,あなたが 人
Dialogue: 0,0:08:56.17,0:08:58.71,Sousei-CN,,0,0,0,,你是 人类
Dialogue: 0,0:08:58.71,0:09:02.01,Sousei-JP,,0,0,0,,では なぜ魔王に従っているのです
Dialogue: 0,0:08:58.71,0:09:02.01,Sousei-CN,,0,0,0,,那么 为什么跟随魔王
Dialogue: 0,0:09:02.01,0:09:03.66,Sousei-JP,,0,0,0,,あなたほどの実力なら
Dialogue: 0,0:09:02.01,0:09:03.66,Sousei-CN,,0,0,0,,有这么强的实力的话
Dialogue: 0,0:09:03.66,0:09:05.60,Sousei-JP,,0,0,0,,倒すことも出来たさ
Dialogue: 0,0:09:03.66,0:09:05.60,Sousei-CN,,0,0,0,,早就打倒魔王了
Dialogue: 0,0:09:06.01,0:09:08.86,Sousei-JP,,0,0,0,,けど 魔王を倒したら
Dialogue: 0,0:09:06.01,0:09:08.86,Sousei-CN,,0,0,0,,可是打倒魔王后
Dialogue: 0,0:09:08.86,0:09:12.42,Sousei-JP,,0,0,0,,きっと俺が次の魔王として担ぎ上げられる
Dialogue: 0,0:09:08.86,0:09:12.42,Sousei-CN,,0,0,0,,我就一定得背负下任魔王的重担
Dialogue: 0,0:09:12.42,0:09:14.32,Sousei-JP,,0,0,0,,そんなのごめんだよ
Dialogue: 0,0:09:12.42,0:09:14.32,Sousei-CN,,0,0,0,,我不想那样
Dialogue: 0,0:09:15.21,0:09:18.87,Sousei-JP,,0,0,0,,結果 何も出来ずに 引きこもるだけの毎日でさ
Dialogue: 0,0:09:15.21,0:09:18.87,Sousei-CN,,0,0,0,,所以我什么都没去做 每天窝在魔王城里
Dialogue: 0,0:09:19.32,0:09:23.96,Sousei-JP,,0,0,0,,そんな人生なら いい加減終わりにしてもいいかとも思った
Dialogue: 0,0:09:19.32,0:09:23.96,Sousei-CN,,0,0,0,,这种人生 我想差不多结束了也没有关系
Dialogue: 0,0:09:27.06,0:09:29.38,Sousei-JP,,0,0,0,,そんな時に 君が現れて
Dialogue: 0,0:09:27.06,0:09:29.38,Sousei-CN,,0,0,0,,就在那个时候 你出现在我眼前
Dialogue: 0,0:09:29.96,0:09:31.38,Sousei-JP,,0,0,0,,一目惚れした
Dialogue: 0,0:09:29.97,0:09:31.38,Sousei-CN,,0,0,0,,我就对你一见钟情了
Dialogue: 0,0:09:32.41,0:09:33.62,Sousei-JP,,0,0,0,,この１か月
Dialogue: 0,0:09:32.41,0:09:33.62,Sousei-CN,,0,0,0,,这一个月
Dialogue: 0,0:09:33.97,0:09:35.77,Sousei-JP,,0,0,0,,短い間だったけど
Dialogue: 0,0:09:33.97,0:09:35.77,Sousei-CN,,0,0,0,,虽然时间不长
Dialogue: 0,0:09:36.16,0:09:39.66,Sousei-JP,,0,0,0,,魔族になって初めて生きてる感じがしたよ
Dialogue: 0,0:09:36.16,0:09:39.66,Sousei-CN,,0,0,0,,但是我变成魔族后 初次有活着的感觉
Dialogue: 0,0:09:42.26,0:09:43.91,Sousei-JP,,0,0,0,,だからもういいんだ
Dialogue: 0,0:09:42.26,0:09:43.91,Sousei-CN,,0,0,0,,所以已经无所谓了
Dialogue: 0,0:09:43.91,0:09:45.56,Sousei-JP,,0,0,0,,いい訳ありません
Dialogue: 0,0:09:43.91,0:09:45.56,Sousei-CN,,0,0,0,,怎么可以无所谓
Dialogue: 0,0:09:46.67,0:09:48.76,Sousei-JP,,0,0,0,,あなたには力がある
Dialogue: 0,0:09:46.67,0:09:48.76,Sousei-CN,,0,0,0,,你有很强大的力量
Dialogue: 0,0:09:48.76,0:09:51.01,Sousei-JP,,0,0,0,,人の心があるというのなら
Dialogue: 0,0:09:48.76,0:09:51.01,Sousei-CN,,0,0,0,,若你真保持着人心
Dialogue: 0,0:09:51.01,0:09:53.57,Sousei-JP,,0,0,0,,その力を人々のためにふるってください
Dialogue: 0,0:09:51.01,0:09:53.57,Sousei-CN,,0,0,0,,就为人们发挥你的力量吧
Dialogue: 0,0:09:55.32,0:09:57.57,Sousei-JP,,0,0,0,,今からでも遅くありません
Dialogue: 0,0:09:55.32,0:09:57.57,Sousei-CN,,0,0,0,,现在还来得及
Dialogue: 0,0:09:59.02,0:10:01.58,Sousei-JP,,0,0,0,,私と外の世界に出ましょう
Dialogue: 0,0:09:59.02,0:10:01.58,Sousei-CN,,0,0,0,,跟我一起到外面的世界吧
Dialogue: 0,0:10:07.96,0:10:11.46,pingmu-1,,0,0,0,,{\fad(500,0)}(克拉利涅斯王国)
Dialogue: 0,0:10:11.91,0:10:14.22,Sousei-JP,,0,0,0,,勇者ユウガと仲間たちよ
Dialogue: 0,0:10:11.91,0:10:14.22,Sousei-CN,,0,0,0,,勇者悠贺以及其同伴
Dialogue: 0,0:10:14.46,0:10:19.37,Sousei-JP,,0,0,0,,人々を虐げ 世界を滅ぼさんとする 魔王を倒し
Dialogue: 0,0:10:14.46,0:10:19.37,Sousei-CN,,0,0,0,,你们打倒了虐杀人类 毁灭世界的魔王
Dialogue: 0,0:10:19.37,0:10:20.97,Sousei-JP,,0,0,0,,よくぞ戻ってきた
Dialogue: 0,0:10:19.37,0:10:20.97,Sousei-CN,,0,0,0,,并且平安归来
Dialogue: 0,0:10:21.37,0:10:23.46,Sousei-JP,,0,0,0,,クラリネス王国国王
Dialogue: 0,0:10:21.37,0:10:23.46,Sousei-CN,,0,0,0,,我以克拉利涅斯王国国王
Dialogue: 0,0:10:24.06,0:10:27.10,Sousei-JP,,0,0,0,,ダーツ・オルタ・クラリネスの名において宣言する
Dialogue: 0,0:10:24.06,0:10:27.10,Sousei-CN,,0,0,0,,达兹・奥尔达・克拉利涅斯之名宣布
Dialogue: 0,0:10:28.01,0:10:31.61,Sousei-JP,,0,0,0,,戦争を終結させた英雄たちの帰還を祝し
Dialogue: 0,0:10:28.01,0:10:31.61,Sousei-CN,,0,0,0,,庆祝终结战争的英雄们凯旋
Dialogue: 0,0:10:31.61,0:10:33.32,Sousei-JP,,0,0,0,,本日から３日間
Dialogue: 0,0:10:31.61,0:10:33.32,Sousei-CN,,0,0,0,,从今天起连续三天
Dialogue: 0,0:10:33.32,0:10:36.36,Sousei-JP,,0,0,0,,我が国の戦勝記念日とする
Dialogue: 0,0:10:33.32,0:10:36.36,Sousei-CN,,0,0,0,,做为我国的胜利纪念日
Dialogue: 0,0:10:38.01,0:10:39.41,Sousei-JP,,0,0,0,,皆の者
Dialogue: 0,0:10:38.01,0:10:39.41,Sousei-CN,,0,0,0,,全国人民啊
Dialogue: 0,0:10:39.81,0:10:43.37,Sousei-JP,,0,0,0,,存分に勇者たちの偉業を称えよ
Dialogue: 0,0:10:39.81,0:10:43.37,Sousei-CN,,0,0,0,,让我们一起歌颂 勇者们的丰功伟业吧
Dialogue: 0,0:10:49.26,0:10:52.81,Sousei-JP,,0,0,0,,セシリアが住んでる王都はもうすぐか
Dialogue: 0,0:10:49.26,0:10:52.81,Sousei-CN,,0,0,0,,就快到赛西莉亚居住的王都了
Dialogue: 0,0:10:52.81,0:10:54.21,Sousei-JP,,0,0,0,,さて
Dialogue: 0,0:10:52.81,0:10:54.21,Sousei-CN,,0,0,0,,接下来
Dialogue: 0,0:10:56.66,0:10:58.88,Sousei-JP,,0,0,0,,痛って
Dialogue: 0,0:10:56.66,0:10:58.88,Sousei-CN,,0,0,0,,痛死了
Dialogue: 0,0:11:02.51,0:11:04.66,Sousei-JP,,0,0,0,,勇者様
Dialogue: 0,0:11:02.51,0:11:04.66,Sousei-CN,,0,0,0,,勇者大人
Dialogue: 0,0:11:04.66,0:11:07.10,Sousei-JP,,0,0,0,,お帰り
Dialogue: 0,0:11:04.66,0:11:07.10,Sousei-CN,,0,0,0,,欢迎回来
Dialogue: 0,0:11:07.56,0:11:09.36,Sousei-JP,,0,0,0,,ユウガ やったわね
Dialogue: 0,0:11:07.56,0:11:09.36,Sousei-CN,,0,0,0,,悠贺 太好了
Dialogue: 0,0:11:09.36,0:11:13.22,Sousei-JP,,0,0,0,,ああ ただ世界を救えたは何より
Dialogue: 0,0:11:09.36,0:11:13.22,Sousei-CN,,0,0,0,,是啊 但之所以能拯救世界
Dialogue: 0,0:11:13.61,0:11:15.57,Sousei-JP,,0,0,0,,セシリアのおかげだ
Dialogue: 0,0:11:13.61,0:11:15.57,Sousei-CN,,0,0,0,,都多亏了赛西莉亚
Dialogue: 0,0:11:15.57,0:11:18.36,Sousei-JP,,0,0,0,,君が無事で本当によかった
Dialogue: 0,0:11:15.57,0:11:18.36,Sousei-CN,,0,0,0,,真的很高兴你能平安无事
Dialogue: 0,0:11:18.36,0:11:19.60,Sousei-JP,,0,0,0,,は はい
Dialogue: 0,0:11:18.37,0:11:19.60,Sousei-CN,,0,0,0,,是 是啊
Dialogue: 0,0:11:28.36,0:11:30.62,Sousei-JP,,0,0,0,,受付はと
Dialogue: 0,0:11:28.36,0:11:30.62,Sousei-CN,,0,0,0,,报到处在
Dialogue: 0,0:11:32.31,0:11:34.16,Sousei-JP,,0,0,0,,すみませ～ん
Dialogue: 0,0:11:32.31,0:11:34.16,Sousei-CN,,0,0,0,,不好意思
Dialogue: 0,0:11:35.13,0:11:38.47,Sousei-JP,,0,0,0,,冒険者ギルドに登録したいんですけど
Dialogue: 0,0:11:35.13,0:11:38.47,Sousei-CN,,0,0,0,,我想在冒险家公会里注册
Dialogue: 0,0:11:40.31,0:11:42.12,Sousei-JP,,0,0,0,,っと どうすんだっけ
Dialogue: 0,0:11:40.31,0:11:42.12,Sousei-CN,,0,0,0,,怎么办好呢
Dialogue: 0,0:11:42.61,0:11:44.51,Sousei-JP,,0,0,0,,大丈夫か この人
Dialogue: 0,0:11:42.61,0:11:44.51,Sousei-CN,,0,0,0,,这个人没问题吧
Dialogue: 0,0:11:45.21,0:11:46.11,Sousei-JP,,0,0,0,,あったわ
Dialogue: 0,0:11:45.21,0:11:46.11,Sousei-CN,,0,0,0,,找到了
Dialogue: 0,0:11:47.06,0:11:48.66,Sousei-JP,,0,0,0,,これに記入しろ
Dialogue: 0,0:11:47.06,0:11:48.66,Sousei-CN,,0,0,0,,在这里填上资料
Dialogue: 0,0:11:48.66,0:11:50.26,Sousei-JP,,0,0,0,,名前 年齢
Dialogue: 0,0:11:48.66,0:11:50.26,Sousei-CN,,0,0,0,,名字 年龄
Dialogue: 0,0:11:50.26,0:11:53.02,Sousei-JP,,0,0,0,,死んでも自己責任の同意だ
Dialogue: 0,0:11:50.26,0:11:53.02,Sousei-CN,,0,0,0,,还有死亡责任同意书
Dialogue: 0,0:11:53.02,0:11:54.10,Sousei-JP,,0,0,0,,ほい
Dialogue: 0,0:11:53.02,0:11:54.10,Sousei-CN,,0,0,0,,好了
Dialogue: 0,0:11:55.51,0:11:58.81,Sousei-JP,,0,0,0,,ヨウキ ２１歳か
Dialogue: 0,0:11:55.51,0:11:58.81,Sousei-CN,,0,0,0,,阳树 21岁啊
Dialogue: 0,0:11:58.81,0:12:03.01,Sousei-JP,,0,0,0,,よし んじゃあ これがギルドカードな
Dialogue: 0,0:11:58.81,0:12:03.01,Sousei-CN,,0,0,0,,好 这是你的公会卡
Dialogue: 0,0:12:03.01,0:12:05.41,Sousei-JP,,0,0,0,,最初はＦランクから始まって
Dialogue: 0,0:12:03.01,0:12:05.41,Sousei-CN,,0,0,0,,一开始从F等级开始
Dialogue: 0,0:12:05.41,0:12:07.33,Sousei-JP,,0,0,0,,最高はＳランクだ
Dialogue: 0,0:12:05.41,0:12:07.33,Sousei-CN,,0,0,0,,最高等级为S等级
Dialogue: 0,0:12:08.26,0:12:10.56,Sousei-JP,,0,0,0,,依頼をこなして実績を積めば
Dialogue: 0,0:12:08.26,0:12:10.56,Sousei-CN,,0,0,0,,完成委托 累积实绩
Dialogue: 0,0:12:10.56,0:12:12.41,Sousei-JP,,0,0,0,,次のランクに上がる
Dialogue: 0,0:12:10.56,0:12:12.41,Sousei-CN,,0,0,0,,就能升到下个等级
Dialogue: 0,0:12:12.41,0:12:17.34,Sousei-JP,,0,0,0,,まあ大抵はＦからＥに上がるのにも ひと月くらいはかかるがな
Dialogue: 0,0:12:12.41,0:12:17.34,Sousei-CN,,0,0,0,,但要从F升到E 通常要花一个月的时间吧
Dialogue: 0,0:12:17.91,0:12:19.67,Sousei-JP,,0,0,0,,説明しゅうりょ
Dialogue: 0,0:12:17.91,0:12:19.67,Sousei-CN,,0,0,0,,说明完毕
Dialogue: 0,0:12:21.02,0:12:23.67,Sousei-JP,,0,0,0,,再発行がめんどくせえから失くすなよ
Dialogue: 0,0:12:21.02,0:12:23.67,Sousei-CN,,0,0,0,,因为重发很麻烦 所以别弄丢
Dialogue: 0,0:12:24.06,0:12:26.35,Sousei-JP,,0,0,0,,特にこの３日間はな
Dialogue: 0,0:12:24.06,0:12:26.35,Sousei-CN,,0,0,0,,尤其是这三天
Dialogue: 0,0:12:26.52,0:12:27.62,Sousei-JP,,0,0,0,,３日？
Dialogue: 0,0:12:26.52,0:12:27.62,Sousei-CN,,0,0,0,,这三天?
Dialogue: 0,0:12:28.01,0:12:32.10,Sousei-JP,,0,0,0,,他の職員たちが 祭りで休みを取っちまってるし
Dialogue: 0,0:12:28.01,0:12:32.10,Sousei-CN,,0,0,0,,其他工作人员 都请假去过这三天祭典
Dialogue: 0,0:12:32.56,0:12:35.46,Sousei-JP,,0,0,0,,俺は手続きなんかやりたくねえ
Dialogue: 0,0:12:32.56,0:12:35.46,Sousei-CN,,0,0,0,,我才不想处理这些手续
Dialogue: 0,0:12:35.46,0:12:37.62,Sousei-JP,,0,0,0,,どこまで面倒臭がり屋なんだよ
Dialogue: 0,0:12:35.46,0:12:37.62,Sousei-CN,,0,0,0,,这家伙到底是有多怕麻烦
Dialogue: 0,0:12:39.06,0:12:40.66,Sousei-JP,,0,0,0,,俺はクレイマン
Dialogue: 0,0:12:39.06,0:12:40.66,Sousei-CN,,0,0,0,,我是克雷曼
Dialogue: 0,0:12:40.66,0:12:42.11,Sousei-JP,,0,0,0,,まあ頑張れや
Dialogue: 0,0:12:40.66,0:12:42.11,Sousei-CN,,0,0,0,,反正你就多加油
Dialogue: 0,0:12:43.87,0:12:45.86,Sousei-JP,,0,0,0,,ああ よろしく
Dialogue: 0,0:12:43.87,0:12:45.86,Sousei-CN,,0,0,0,,好 请多指教
Dialogue: 0,0:12:48.06,0:12:50.86,Sousei-JP,,0,0,0,,初日から結構稼げたなぁ
Dialogue: 0,0:12:48.06,0:12:50.86,Sousei-CN,,0,0,0,,第一天就赚了不少
Dialogue: 0,0:12:51.32,0:12:54.22,Sousei-JP,,0,0,0,,ランクを上げて もっと金を稼ごう
Dialogue: 0,0:12:51.32,0:12:54.22,Sousei-CN,,0,0,0,,尽快提升等级赚钱
Dialogue: 0,0:12:54.22,0:12:57.63,Sousei-JP,,0,0,0,,そして まっとうな生活が できるようになったら
Dialogue: 0,0:12:54.22,0:12:57.63,Sousei-CN,,0,0,0,,然后过上安稳的生活后
Dialogue: 0,0:12:58.31,0:13:01.22,Sousei-JP,,0,0,0,,またセシリアに告白しよう
Dialogue: 0,0:12:58.31,0:13:01.22,Sousei-CN,,0,0,0,,再去跟赛西莉亚告白吧
Dialogue: 0,0:13:03.13,0:13:07.64,Sousei-JP,,0,0,0,,この恋 絶対に成就させてみせるぞ
Dialogue: 0,0:13:03.13,0:13:07.64,Sousei-CN,,0,0,0,,这份恋情 我绝对要让它成功
Dialogue: 0,0:13:18.11,0:13:19.71,Sousei-JP,,0,0,0,,おい知ってるか
Dialogue: 0,0:13:18.11,0:13:19.71,Sousei-CN,,0,0,0,,喂 你知道吗
Dialogue: 0,0:13:19.71,0:13:23.51,Sousei-JP,,0,0,0,,とんでもない速さで ランクを上げてる奴がいるって噂
Dialogue: 0,0:13:19.71,0:13:23.51,Sousei-CN,,0,0,0,,听说有个等级升很快的家伙
Dialogue: 0,0:13:23.51,0:13:25.15,Sousei-JP,,0,0,0,,何よそれ
Dialogue: 0,0:13:23.51,0:13:25.15,Sousei-CN,,0,0,0,,那是什么啊
Dialogue: 0,0:13:26.36,0:13:27.92,Sousei-JP,,0,0,0,,よう クレイマン
Dialogue: 0,0:13:26.36,0:13:27.92,Sousei-CN,,0,0,0,,哟 克雷曼
Dialogue: 0,0:13:28.32,0:13:29.92,Sousei-JP,,0,0,0,,この依頼引き受けるよ
Dialogue: 0,0:13:28.32,0:13:29.92,Sousei-CN,,0,0,0,,我要接受这些委托
Dialogue: 0,0:13:31.11,0:13:33.11,Sousei-JP,,0,0,0,,なんで俺んとこ来るんだよ
Dialogue: 0,0:13:31.11,0:13:33.11,Sousei-CN,,0,0,0,,你为什么要来我这里
Dialogue: 0,0:13:33.11,0:13:35.62,Sousei-JP,,0,0,0,,あっちにお姉さんがいるだろうが
Dialogue: 0,0:13:33.11,0:13:35.62,Sousei-CN,,0,0,0,,旁边不是有个大姐姐在吗
Dialogue: 0,0:13:35.62,0:13:38.12,Sousei-JP,,0,0,0,,なんかこっちに慣れちゃってさ
Dialogue: 0,0:13:35.62,0:13:38.12,Sousei-CN,,0,0,0,,总感觉这边更习惯嘛
Dialogue: 0,0:13:38.12,0:13:39.63,Sousei-JP,,0,0,0,,意外と仕事早いし
Dialogue: 0,0:13:38.12,0:13:39.63,Sousei-CN,,0,0,0,,而且你的工作效率意外的快
Dialogue: 0,0:13:41.32,0:13:44.08,Sousei-JP,,0,0,0,,んな事より お前 何者だ
Dialogue: 0,0:13:41.32,0:13:44.08,Sousei-CN,,0,0,0,,比起那个 你到底是什么人
Dialogue: 0,0:13:45.72,0:13:48.59,Sousei-JP,,0,0,0,,ごく普通の新米冒険者だよ
Dialogue: 0,0:13:45.72,0:13:48.59,Sousei-CN,,0,0,0,,就是普通的新人冒险家啊
Dialogue: 0,0:13:48.82,0:13:50.01,Sousei-JP,,0,0,0,,バカ言うな
Dialogue: 0,0:13:48.82,0:13:50.01,Sousei-CN,,0,0,0,,少说蠢话了
Dialogue: 0,0:13:50.30,0:13:54.32,Sousei-JP,,0,0,0,,たった１週間で ＦランクからＤランクにあがるヤツは
Dialogue: 0,0:13:50.30,0:13:54.32,Sousei-CN,,0,0,0,,只花一星期就从F升到D的家伙
Dialogue: 0,0:13:54.72,0:13:56.56,Sousei-JP,,0,0,0,,「普通」って言わねぇんだよ
Dialogue: 0,0:13:54.72,0:13:56.56,Sousei-CN,,0,0,0,,一点都不「普通」
Dialogue: 0,0:13:57.02,0:13:59.56,Sousei-JP,,0,0,0,,まずい 頑張りすぎたか
Dialogue: 0,0:13:57.02,0:13:59.56,Sousei-CN,,0,0,0,,糟糕 我太努力了吗
Dialogue: 0,0:14:01.26,0:14:02.46,Sousei-JP,,0,0,0,,まあいい
Dialogue: 0,0:14:01.26,0:14:02.46,Sousei-CN,,0,0,0,,算了
Dialogue: 0,0:14:02.46,0:14:05.81,Sousei-JP,,0,0,0,,調べたところ 不正をしてる訳じゃないみたいだからな
Dialogue: 0,0:14:02.46,0:14:05.81,Sousei-CN,,0,0,0,,经过我的调查 你似乎没有作弊
Dialogue: 0,0:14:07.91,0:14:09.36,Sousei-JP,,0,0,0,,ったく
Dialogue: 0,0:14:07.91,0:14:09.36,Sousei-CN,,0,0,0,,真是的
Dialogue: 0,0:14:09.36,0:14:11.56,Sousei-JP,,0,0,0,,受付は俺の仕事じゃねえっつの
Dialogue: 0,0:14:09.36,0:14:11.56,Sousei-CN,,0,0,0,,我本来就不是负责这个工作的
Dialogue: 0,0:14:11.56,0:14:14.22,Sousei-JP,,0,0,0,,その依頼 取りやめていただけますか
Dialogue: 0,0:14:11.56,0:14:14.22,Sousei-CN,,0,0,0,,那些委托 能否取消掉呢
Dialogue: 0,0:14:21.34,0:14:23.11,Sousei-JP,,0,0,0,,令嬢じゃねか
Dialogue: 0,0:14:21.34,0:14:23.11,Sousei-CN,,0,0,0,,这不是大小姐吗
Dialogue: 0,0:14:23.52,0:14:24.97,Sousei-JP,,0,0,0,,なんでこんなところに
Dialogue: 0,0:14:23.52,0:14:24.97,Sousei-CN,,0,0,0,,您怎么在这里
Dialogue: 0,0:14:27.16,0:14:28.71,Sousei-JP,,0,0,0,,知り合いか
Dialogue: 0,0:14:27.16,0:14:28.71,Sousei-CN,,0,0,0,,他们认识吗
Dialogue: 0,0:14:29.12,0:14:30.92,Sousei-JP,,0,0,0,,ひ ひさしぶり
Dialogue: 0,0:14:29.12,0:14:30.92,Sousei-CN,,0,0,0,,好 好久不见
Dialogue: 0,0:14:31.67,0:14:33.56,Sousei-JP,,0,0,0,,あなたにお話があります
Dialogue: 0,0:14:31.67,0:14:33.56,Sousei-CN,,0,0,0,,我有话想跟你说
Dialogue: 0,0:14:33.97,0:14:36.48,Sousei-JP,,0,0,0,,一緒に私の家まで来てください
Dialogue: 0,0:14:33.97,0:14:36.48,Sousei-CN,,0,0,0,,请先到我家里来吧
Dialogue: 0,0:14:39.86,0:14:41.76,Sousei-JP,,0,0,0,,君の家?
Dialogue: 0,0:14:39.86,0:14:41.76,Sousei-CN,,0,0,0,,你家?
Dialogue: 0,0:14:46.42,0:14:49.17,Sousei-JP,,0,0,0,,セシリアお嬢様のお帰りだ
Dialogue: 0,0:14:46.42,0:14:49.17,Sousei-CN,,0,0,0,,赛西莉亚大小姐回来了
Dialogue: 0,0:14:51.41,0:14:52.36,Sousei-JP,,0,0,0,,誰だっ
Dialogue: 0,0:14:51.41,0:14:52.36,Sousei-CN,,0,0,0,,谁啊
Dialogue: 0,0:14:55.56,0:14:56.16,Sousei-JP,,0,0,0,,ちょ
Dialogue: 0,0:14:55.56,0:14:56.16,Sousei-CN,,0,0,0,,别
Dialogue: 0,0:14:56.16,0:14:57.81,Sousei-JP,,0,0,0,,でっか
Dialogue: 0,0:14:56.16,0:14:57.81,Sousei-CN,,0,0,0,,好大喔
Dialogue: 0,0:14:57.81,0:14:59.12,Sousei-JP,,0,0,0,,おい お前
Dialogue: 0,0:14:57.81,0:14:59.12,Sousei-CN,,0,0,0,,喂 臭小子
Dialogue: 0,0:14:59.96,0:15:01.26,Sousei-JP,,0,0,0,,何者だ
Dialogue: 0,0:14:59.96,0:15:01.26,Sousei-CN,,0,0,0,,你是谁
Dialogue: 0,0:15:01.66,0:15:04.22,Sousei-JP,,0,0,0,,なぜアクアレイン家の車に乗っている
Dialogue: 0,0:15:01.66,0:15:04.22,Sousei-CN,,0,0,0,,为何乘坐阿克亚雷茵家的车
Dialogue: 0,0:15:04.22,0:15:05.88,Sousei-JP,,0,0,0,,おいバカよせ
Dialogue: 0,0:15:04.22,0:15:05.88,Sousei-CN,,0,0,0,,笨蛋 别冲动
Dialogue: 0,0:15:06.16,0:15:09.26,Sousei-JP,,0,0,0,,いや なんでって言われても
Dialogue: 0,0:15:06.16,0:15:09.26,Sousei-CN,,0,0,0,,不 你问我我也
Dialogue: 0,0:15:09.26,0:15:11.01,Sousei-JP,,0,0,0,,何をやっているのですか
Dialogue: 0,0:15:09.26,0:15:11.01,Sousei-CN,,0,0,0,,你们在做什么
Dialogue: 0,0:15:11.01,0:15:12.71,Sousei-JP,,0,0,0,,彼は私の友人です
Dialogue: 0,0:15:11.01,0:15:12.71,Sousei-CN,,0,0,0,,他是我朋友
Dialogue: 0,0:15:12.71,0:15:14.56,Sousei-JP,,0,0,0,,失礼しました
Dialogue: 0,0:15:12.71,0:15:14.56,Sousei-CN,,0,0,0,,真是不好意思
Dialogue: 0,0:15:14.56,0:15:16.72,Sousei-JP,,0,0,0,,{\pos(960,120)}ほら もういいだろ
Dialogue: 0,0:15:14.56,0:15:16.72,Sousei-CN,,0,0,0,,{\pos(960,80)}好了 别闹了
Dialogue: 0,0:15:14.56,0:15:16.72,Sousei-JP,,0,0,0,,男友達なんて そんなウソだ
Dialogue: 0,0:15:14.56,0:15:16.72,Sousei-CN,,0,0,0,,大小姐有男性朋友什么的
Dialogue: 0,0:15:16.72,0:15:18.22,Sousei-JP,,0,0,0,,そんなウソだ
Dialogue: 0,0:15:16.72,0:15:18.22,Sousei-CN,,0,0,0,,我不相信
Dialogue: 0,0:15:18.62,0:15:20.73,Sousei-JP,,0,0,0,,友人 か
Dialogue: 0,0:15:18.62,0:15:20.73,Sousei-CN,,0,0,0,,朋友 啊
Dialogue: 0,0:15:22.21,0:15:23.48,Sousei-JP,,0,0,0,,すみません
Dialogue: 0,0:15:22.21,0:15:23.48,Sousei-CN,,0,0,0,,不好意思
Dialogue: 0,0:15:23.66,0:15:27.73,Sousei-JP,,0,0,0,,本当はもっと早く 会いに来る予定だったのですが
Dialogue: 0,0:15:23.66,0:15:27.73,Sousei-CN,,0,0,0,,我原本打算更早之前跟你见面的
Dialogue: 0,0:15:28.22,0:15:30.12,Sousei-JP,,0,0,0,,気にしなくていいよ
Dialogue: 0,0:15:28.22,0:15:30.12,Sousei-CN,,0,0,0,,别在意
Dialogue: 0,0:15:30.12,0:15:32.99,Sousei-JP,,0,0,0,,俺も冒険者生活を満喫してたから
Dialogue: 0,0:15:30.12,0:15:32.99,Sousei-CN,,0,0,0,,我也很享受冒险家的生活
Dialogue: 0,0:15:34.01,0:15:36.46,Sousei-JP,,0,0,0,,よく俺のこと見つけられたね
Dialogue: 0,0:15:34.01,0:15:36.46,Sousei-CN,,0,0,0,,不过你居然找得到我
Dialogue: 0,0:15:36.46,0:15:38.25,Sousei-JP,,0,0,0,,噂になっているんですよ
Dialogue: 0,0:15:36.46,0:15:38.25,Sousei-CN,,0,0,0,,你的事已经出现传闻了
Dialogue: 0,0:15:38.87,0:15:43.46,Sousei-JP,,0,0,0,,新人冒険者が 瞬く間にＤランクに昇格したって
Dialogue: 0,0:15:38.87,0:15:43.46,Sousei-CN,,0,0,0,,新人冒险家瞬间升等到D等级
Dialogue: 0,0:15:45.21,0:15:49.51,Sousei-JP,,0,0,0,,それであなたの行方を知れたのは よかったのですが
Dialogue: 0,0:15:45.21,0:15:49.51,Sousei-CN,,0,0,0,,虽然很高兴知道你的下落
Dialogue: 0,0:15:50.66,0:15:52.13,Sousei-JP,,0,0,0,,何か問題が
Dialogue: 0,0:15:50.66,0:15:52.13,Sousei-CN,,0,0,0,,有什么问题吗
Dialogue: 0,0:15:53.61,0:15:54.52,Sousei-JP,,0,0,0,,お願いです
Dialogue: 0,0:15:53.61,0:15:54.52,Sousei-CN,,0,0,0,,我想拜托你
Dialogue: 0,0:15:55.28,0:15:59.14,Sousei-JP,,0,0,0,,冒険者ギルドをやめてもらえませんか
Dialogue: 0,0:15:55.28,0:15:59.14,Sousei-CN,,0,0,0,,能否退出冒险家公会呢
Dialogue: 0,0:16:00.52,0:16:03.87,Sousei-JP,,0,0,0,,すみません いきなりこんなことを
Dialogue: 0,0:16:00.52,0:16:03.87,Sousei-CN,,0,0,0,,对不起 突然提出这种事
Dialogue: 0,0:16:03.87,0:16:06.14,Sousei-JP,,0,0,0,,どういう訳か教えてくれる
Dialogue: 0,0:16:03.87,0:16:06.14,Sousei-CN,,0,0,0,,能告诉我什么原因吗
Dialogue: 0,0:16:06.42,0:16:07.61,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:16:06.42,0:16:07.61,Sousei-CN,,0,0,0,,好的
Dialogue: 0,0:16:07.61,0:16:11.86,Sousei-JP,,0,0,0,,ご存じの通り 魔王は勇者によって倒されました
Dialogue: 0,0:16:07.61,0:16:11.86,Sousei-CN,,0,0,0,,我想你已经知道 魔王已经被勇者打倒了
Dialogue: 0,0:16:11.86,0:16:15.06,Sousei-JP,,0,0,0,,ですが 全ての脅威が去った訳ではありません
Dialogue: 0,0:16:11.86,0:16:15.06,Sousei-CN,,0,0,0,,然而这并不代表威胁已消失
Dialogue: 0,0:16:15.06,0:16:19.56,Sousei-JP,,0,0,0,,まあ 魔族や魔物が いなくなる訳ではないもんなぁ
Dialogue: 0,0:16:15.06,0:16:19.56,Sousei-CN,,0,0,0,,毕竟魔族和魔物还在嘛
Dialogue: 0,0:16:19.56,0:16:21.16,Sousei-JP,,0,0,0,,それもありますが
Dialogue: 0,0:16:19.56,0:16:21.16,Sousei-CN,,0,0,0,,这也是原因之一
Dialogue: 0,0:16:21.16,0:16:26.21,Sousei-JP,,0,0,0,,今度は人間の国同士で 覇権争いが始まるかもしれません
Dialogue: 0,0:16:21.16,0:16:26.21,Sousei-CN,,0,0,0,,但接下来可能是 人类国家之间的战争吧
Dialogue: 0,0:16:26.21,0:16:28.91,Sousei-JP,,0,0,0,,その兆候がすでに現れています
Dialogue: 0,0:16:26.21,0:16:28.91,Sousei-CN,,0,0,0,,而且已经开始出现征兆了
Dialogue: 0,0:16:28.91,0:16:30.11,Sousei-JP,,0,0,0,,兆候
Dialogue: 0,0:16:28.91,0:16:30.11,Sousei-CN,,0,0,0,,征兆
Dialogue: 0,0:16:31.11,0:16:36.18,Sousei-JP,,0,0,0,,我が国の勇者に 各国からの縁談が 山のように来ています
Dialogue: 0,0:16:31.11,0:16:36.18,Sousei-CN,,0,0,0,,有许多国家派人 来和我国的勇者联姻
Dialogue: 0,0:16:36.18,0:16:37.61,Sousei-JP,,0,0,0,,勇者くん
Dialogue: 0,0:16:36.18,0:16:37.61,Sousei-CN,,0,0,0,,勇者啊
Dialogue: 0,0:16:37.61,0:16:40.16,Sousei-JP,,0,0,0,,元々イケメンでモテそうだしな
Dialogue: 0,0:16:37.61,0:16:40.16,Sousei-CN,,0,0,0,,他本来就又帅又受欢迎嘛
Dialogue: 0,0:16:40.16,0:16:41.93,Sousei-JP,,0,0,0,,そうではありません
Dialogue: 0,0:16:40.16,0:16:41.93,Sousei-CN,,0,0,0,,不是这样的
Dialogue: 0,0:16:42.62,0:16:47.07,Sousei-JP,,0,0,0,,地位 お金 婚姻と あらゆる手を使って
Dialogue: 0,0:16:42.62,0:16:47.07,Sousei-CN,,0,0,0,,各国使用 地位 金钱 婚姻等手段
Dialogue: 0,0:16:47.07,0:16:50.44,Sousei-JP,,0,0,0,,各国が戦力と人材を集めているのです
Dialogue: 0,0:16:47.07,0:16:50.44,Sousei-CN,,0,0,0,,来聚集有能人士及战力
Dialogue: 0,0:16:50.66,0:16:54.20,Sousei-JP,,0,0,0,,戦争の手駒にするってことか
Dialogue: 0,0:16:50.66,0:16:54.20,Sousei-CN,,0,0,0,,用来当战争的棋子吗
Dialogue: 0,0:16:54.91,0:17:00.95,Sousei-JP,,0,0,0,,あなたは通常ではありえない速度で 冒険者のランクを上げています
Dialogue: 0,0:16:54.91,0:17:00.95,Sousei-CN,,0,0,0,,你以非寻常的速度 提升冒险者等级
Dialogue: 0,0:17:01.41,0:17:06.71,Sousei-JP,,0,0,0,,その強さなら 国に数人もいない Ｓランクにもなれるでしょう
Dialogue: 0,0:17:01.41,0:17:06.71,Sousei-CN,,0,0,0,,如此强大的能力 不久就会升到国内少有的S级吧
Dialogue: 0,0:17:07.71,0:17:11.86,Sousei-JP,,0,0,0,,しかし そうなれば 各国から目を付けられてしまう
Dialogue: 0,0:17:07.71,0:17:11.86,Sousei-CN,,0,0,0,,如此一来 你便会被各国盯上
Dialogue: 0,0:17:11.86,0:17:16.47,Sousei-JP,,0,0,0,,もしあなたがスカウトされ 不意に魔族の力を晒してしまったら
Dialogue: 0,0:17:11.86,0:17:16.47,Sousei-CN,,0,0,0,,若你被看上 又不小心暴露魔族的力量
Dialogue: 0,0:17:16.66,0:17:20.01,Sousei-JP,,0,0,0,,その国で世界征服の道具にされるか
Dialogue: 0,0:17:16.66,0:17:20.01,Sousei-CN,,0,0,0,,你可能会被那个国家 当成征服世界的道具
Dialogue: 0,0:17:20.01,0:17:21.37,Sousei-JP,,0,0,0,,もしくは
Dialogue: 0,0:17:20.01,0:17:21.37,Sousei-CN,,0,0,0,,又或是
Dialogue: 0,0:17:21.37,0:17:25.26,Sousei-JP,,0,0,0,,敵視されて俺の異世界生活は終わりか
Dialogue: 0,0:17:21.37,0:17:25.26,Sousei-CN,,0,0,0,,被视为敌人 我的异世界生活就此结束
Dialogue: 0,0:17:25.92,0:17:29.41,Sousei-JP,,0,0,0,,ですから 当分はあまり目立たないでほしいのです
Dialogue: 0,0:17:25.92,0:17:29.41,Sousei-CN,,0,0,0,,所以我希望你能低调
Dialogue: 0,0:17:30.22,0:17:32.23,Sousei-JP,,0,0,0,,でも生活もあるし
Dialogue: 0,0:17:30.22,0:17:32.23,Sousei-CN,,0,0,0,,可是我还得过生活
Dialogue: 0,0:17:32.23,0:17:35.16,Sousei-JP,,0,0,0,,私があなたを個人的に雇い
Dialogue: 0,0:17:32.23,0:17:35.16,Sousei-CN,,0,0,0,,我以个人的名义雇用你
Dialogue: 0,0:17:35.16,0:17:38.06,Sousei-JP,,0,0,0,,報酬を支払えればよいのですが
Dialogue: 0,0:17:35.16,0:17:38.06,Sousei-CN,,0,0,0,,并给予你酬劳
Dialogue: 0,0:17:38.06,0:17:41.22,Sousei-JP,,0,0,0,,Ｓランクを雇えるほどの財産はありません
Dialogue: 0,0:17:38.06,0:17:41.22,Sousei-CN,,0,0,0,,虽然我没这么多钱 能雇用S等级冒险家
Dialogue: 0,0:17:42.27,0:17:43.37,Sousei-JP,,0,0,0,,その代わり
Dialogue: 0,0:17:42.27,0:17:43.37,Sousei-CN,,0,0,0,,但相对的
Dialogue: 0,0:17:43.37,0:17:46.27,Sousei-JP,,0,0,0,,私に出来る事なら何でも致します
Dialogue: 0,0:17:43.37,0:17:46.27,Sousei-CN,,0,0,0,,只要是我能做的事 我都愿意做
Dialogue: 0,0:17:46.27,0:17:48.96,Sousei-JP,,0,0,0,,ですから この通りです
Dialogue: 0,0:17:46.27,0:17:48.96,Sousei-CN,,0,0,0,,所以拜托你
Dialogue: 0,0:17:48.96,0:17:50.77,Sousei-JP,,0,0,0,,この国の平穏のために
Dialogue: 0,0:17:48.96,0:17:50.77,Sousei-CN,,0,0,0,,为了这个国家的和平
Dialogue: 0,0:17:50.77,0:17:53.36,Sousei-JP,,0,0,0,,どうか お願いします
Dialogue: 0,0:17:50.77,0:17:53.36,Sousei-CN,,0,0,0,,请你接受我的请求
Dialogue: 0,0:17:57.41,0:17:59.96,Sousei-JP,,0,0,0,,俺なんかに頭を下げるな
Dialogue: 0,0:17:57.41,0:17:59.96,Sousei-CN,,0,0,0,,不要对我低头
Dialogue: 0,0:18:00.76,0:18:03.52,Sousei-JP,,0,0,0,,俺が他国のスカウトを受ける
Dialogue: 0,0:18:00.76,0:18:03.52,Sousei-CN,,0,0,0,,你觉得我会接受别国的挖角吗
Dialogue: 0,0:18:03.52,0:18:05.56,Sousei-JP,,0,0,0,,笑止千万
Dialogue: 0,0:18:03.52,0:18:05.56,Sousei-CN,,0,0,0,,可笑至极
Dialogue: 0,0:18:05.56,0:18:09.21,Sousei-JP,,0,0,0,,どんな美人令嬢が婚約を申し込んでこようが
Dialogue: 0,0:18:05.56,0:18:09.21,Sousei-CN,,0,0,0,,不管找多少美女来跟我联姻
Dialogue: 0,0:18:09.21,0:18:10.77,Sousei-JP,,0,0,0,,そんなものは論外
Dialogue: 0,0:18:09.21,0:18:10.77,Sousei-CN,,0,0,0,,对我来说都没用
Dialogue: 0,0:18:11.10,0:18:12.32,Sousei-JP,,0,0,0,,何故なら
Dialogue: 0,0:18:11.10,0:18:12.32,Sousei-CN,,0,0,0,,因为
Dialogue: 0,0:18:13.21,0:18:17.03,Sousei-JP,,0,0,0,,俺は今 君しか眼中にないからな
Dialogue: 0,0:18:13.21,0:18:17.03,Sousei-CN,,0,0,0,,我现在眼中只有你
Dialogue: 0,0:18:23.46,0:18:26.04,Sousei-JP,,0,0,0,,しまった つい前世からの癖が
Dialogue: 0,0:18:23.46,0:18:26.04,Sousei-CN,,0,0,0,,糟糕 前世的坏毛病又
Dialogue: 0,0:18:26.31,0:18:30.30,Sousei-JP,,0,0,0,,ごめんなさい 不要な心配だったようですね
Dialogue: 0,0:18:26.31,0:18:30.30,Sousei-CN,,0,0,0,,抱歉 看来是我杞人忧天了
Dialogue: 0,0:18:30.30,0:18:31.81,Sousei-JP,,0,0,0,,わかりました
Dialogue: 0,0:18:30.30,0:18:31.81,Sousei-CN,,0,0,0,,我知道了
Dialogue: 0,0:18:31.81,0:18:34.80,Sousei-JP,,0,0,0,,冒険者ギルドのほうは 続けてもらって結構です
Dialogue: 0,0:18:31.81,0:18:34.80,Sousei-CN,,0,0,0,,你继续留在冒险家公会也没有关系
Dialogue: 0,0:18:34.80,0:18:38.55,Sousei-JP,,0,0,0,,まあでも なるべく目立たないように気を付けるよ
Dialogue: 0,0:18:34.80,0:18:38.55,Sousei-CN,,0,0,0,,不过我会尽量低调点
Dialogue: 0,0:18:40.42,0:18:42.80,Sousei-JP,,0,0,0,,セシリア 少しいいかしら
Dialogue: 0,0:18:40.42,0:18:42.80,Sousei-CN,,0,0,0,,赛西莉亚 能打扰一下吗
Dialogue: 0,0:18:43.76,0:18:47.46,Sousei-JP,,0,0,0,,はじめまして 私はセリア・アクアレイン
Dialogue: 0,0:18:43.76,0:18:47.46,Sousei-CN,,0,0,0,,幸会 我是赛莉亚・阿克亚雷茵
Dialogue: 0,0:18:47.46,0:18:49.31,Sousei-JP,,0,0,0,,セシリアの母よ
Dialogue: 0,0:18:47.46,0:18:49.31,Sousei-CN,,0,0,0,,是赛西莉亚的母亲
Dialogue: 0,0:18:49.31,0:18:52.31,Sousei-JP,,0,0,0,,よ よろしくお願いします
Dialogue: 0,0:18:49.31,0:18:52.31,Sousei-CN,,0,0,0,,请 请多指教
Dialogue: 0,0:18:52.31,0:18:53.57,Sousei-JP,,0,0,0,,ヨウキです
Dialogue: 0,0:18:52.31,0:18:53.57,Sousei-CN,,0,0,0,,我是阳树
Dialogue: 0,0:18:53.76,0:18:57.97,Sousei-JP,,0,0,0,,さっきは うちの門番が失礼な態度をとって ごめんなさいね
Dialogue: 0,0:18:53.76,0:18:57.97,Sousei-CN,,0,0,0,,对不起 方才我们家的守卫太失礼了
Dialogue: 0,0:18:57.97,0:19:01.22,Sousei-JP,,0,0,0,,いえ 謝ってもらうほどのことじゃありません
Dialogue: 0,0:18:57.97,0:19:01.22,Sousei-CN,,0,0,0,,没关系 不需要为这点小事道歉
Dialogue: 0,0:19:01.22,0:19:03.58,Sousei-JP,,0,0,0,,そう言ってもらえると助かるわ
Dialogue: 0,0:19:01.22,0:19:03.58,Sousei-CN,,0,0,0,,很高兴你这么说
Dialogue: 0,0:19:04.21,0:19:05.66,Sousei-JP,,0,0,0,,でも安心して
Dialogue: 0,0:19:04.21,0:19:05.66,Sousei-CN,,0,0,0,,不过你放心
Dialogue: 0,0:19:05.66,0:19:09.22,Sousei-JP,,0,0,0,,このメイド長に こってりと絞ってもらうから
Dialogue: 0,0:19:05.66,0:19:09.22,Sousei-CN,,0,0,0,,我的女仆长会好好地教育他们的
Dialogue: 0,0:19:09.22,0:19:10.56,Sousei-JP,,0,0,0,,ねぇ ソフィア
Dialogue: 0,0:19:09.22,0:19:10.56,Sousei-CN,,0,0,0,,对吧 苏菲雅
Dialogue: 0,0:19:10.56,0:19:12.29,Sousei-JP,,0,0,0,,はい 奥様
Dialogue: 0,0:19:10.56,0:19:12.29,Sousei-CN,,0,0,0,,是的 夫人
Dialogue: 0,0:19:12.29,0:19:16.47,Sousei-JP,,0,0,0,,メイドに叱られるくらいで 反省するとは思えないけど
Dialogue: 0,0:19:12.29,0:19:16.47,Sousei-CN,,0,0,0,,我不认为他们被女仆骂过后 会好好反省
Dialogue: 0,0:19:16.47,0:19:18.66,Sousei-JP,,0,0,0,,骨は何本までにいたしますか
Dialogue: 0,0:19:16.47,0:19:18.66,Sousei-CN,,0,0,0,,请问要弄断多少根骨头好呢
Dialogue: 0,0:19:19.81,0:19:20.55,Sousei-JP,,0,0,0,,骨?
Dialogue: 0,0:19:19.81,0:19:20.55,Sousei-CN,,0,0,0,,骨头?
Dialogue: 0,0:19:20.76,0:19:22.16,Sousei-JP,,0,0,0,,任せるわ
Dialogue: 0,0:19:20.76,0:19:22.16,Sousei-CN,,0,0,0,,全权交给你
Dialogue: 0,0:19:22.16,0:19:23.56,Sousei-JP,,0,0,0,,かしこまりました
Dialogue: 0,0:19:22.16,0:19:23.56,Sousei-CN,,0,0,0,,遵命
Dialogue: 0,0:19:23.56,0:19:25.51,Sousei-JP,,0,0,0,,お お母様
Dialogue: 0,0:19:23.56,0:19:25.51,Sousei-CN,,0,0,0,,母 母亲
Dialogue: 0,0:19:25.51,0:19:27.56,Sousei-JP,,0,0,0,,ご用件はそれだけですか
Dialogue: 0,0:19:25.51,0:19:27.56,Sousei-CN,,0,0,0,,请问您要说的就是这件事吗
Dialogue: 0,0:19:27.56,0:19:31.86,Sousei-JP,,0,0,0,,あらごめんなさい それじゃあ本題に入りましょうか
Dialogue: 0,0:19:27.56,0:19:31.86,Sousei-CN,,0,0,0,,不好意思 那我们就进入正题吧
Dialogue: 0,0:19:31.86,0:19:34.27,Sousei-JP,,0,0,0,,ソフィア 外してちょうだい
Dialogue: 0,0:19:31.86,0:19:34.27,Sousei-CN,,0,0,0,,苏菲雅 你先离席吧
Dialogue: 0,0:19:34.27,0:19:35.16,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:19:34.27,0:19:35.16,Sousei-CN,,0,0,0,,是
Dialogue: 0,0:19:37.06,0:19:38.62,Sousei-JP,,0,0,0,,失礼いたします
Dialogue: 0,0:19:37.06,0:19:38.62,Sousei-CN,,0,0,0,,我先告辞了
Dialogue: 0,0:19:40.26,0:19:43.36,Sousei-JP,,0,0,0,,セシリア あの話はしたのかしら
Dialogue: 0,0:19:40.26,0:19:43.36,Sousei-CN,,0,0,0,,赛西莉亚 那件事说了吗
Dialogue: 0,0:19:43.82,0:19:45.33,Sousei-JP,,0,0,0,,必要ありません
Dialogue: 0,0:19:43.82,0:19:45.33,Sousei-CN,,0,0,0,,没必要说吧
Dialogue: 0,0:19:45.56,0:19:47.01,Sousei-JP,,0,0,0,,あの話とは
Dialogue: 0,0:19:45.56,0:19:47.01,Sousei-CN,,0,0,0,,什么事
Dialogue: 0,0:19:47.01,0:19:50.72,Sousei-JP,,0,0,0,,あのね セシリアに 大量の縁談が来ているの
Dialogue: 0,0:19:47.01,0:19:50.72,Sousei-CN,,0,0,0,,那个啊 有很多人来跟赛西莉亚提亲
Dialogue: 0,0:19:50.72,0:19:51.83,Sousei-JP,,0,0,0,,なんですと
Dialogue: 0,0:19:50.72,0:19:51.83,Sousei-CN,,0,0,0,,什么
Dialogue: 0,0:19:52.06,0:19:55.42,Sousei-JP,,0,0,0,,しかも 勇者様からの申し込みも
Dialogue: 0,0:19:52.06,0:19:55.42,Sousei-CN,,0,0,0,,而且勇者大人也来提亲了
Dialogue: 0,0:19:52.06,0:19:55.12,Sousei-JP,,0,0,0,,{\pos(960,120)}アッハッハッ とりあえず
Dialogue: 0,0:19:52.06,0:19:55.12,Sousei-CN,,0,0,0,,{\pos(960,80)}啊哈哈哈哈 总之
Dialogue: 0,0:19:55.42,0:19:56.81,Sousei-JP,,0,0,0,,お母様
Dialogue: 0,0:19:55.42,0:19:56.81,Sousei-CN,,0,0,0,,母亲
Dialogue: 0,0:19:56.81,0:20:00.09,Sousei-JP,,0,0,0,,勇者様ったら セシリアのことが好きみたいね
Dialogue: 0,0:19:56.81,0:20:00.09,Sousei-CN,,0,0,0,,勇者大人似乎很喜欢你呢
Dialogue: 0,0:19:55.12,0:19:57.58,Sousei-JP,,0,0,0,,{\pos(960,120)}僕の妻になってよ セシリア
Dialogue: 0,0:19:55.12,0:19:57.58,Sousei-CN,,0,0,0,,{\pos(960,80)}成为我的妻子吧 赛西莉亚
Dialogue: 0,0:20:00.46,0:20:02.52,Sousei-JP,,0,0,0,,勇者くん何なの
Dialogue: 0,0:20:00.46,0:20:02.52,Sousei-CN,,0,0,0,,勇者是怎样啊
Dialogue: 0,0:20:02.52,0:20:05.16,Sousei-JP,,0,0,0,,どうせ王女様とかにも 言い寄られてんだろ
Dialogue: 0,0:20:02.52,0:20:05.16,Sousei-CN,,0,0,0,,不是被很多王女追求了吗
Dialogue: 0,0:20:05.16,0:20:06.61,Sousei-JP,,0,0,0,,そんなにモテるんだから
Dialogue: 0,0:20:05.16,0:20:06.61,Sousei-CN,,0,0,0,,反正他都已经这么受欢迎了
Dialogue: 0,0:20:06.61,0:20:10.31,Sousei-JP,,0,0,0,,俺の恋路を 邪魔しなくてもいいじゃんかあああ
Dialogue: 0,0:20:06.61,0:20:10.31,Sousei-CN,,0,0,0,,没必要来妨碍我的恋情啊啊啊
Dialogue: 0,0:20:08.12,0:20:10.31,Sousei-JP,,0,0,0,,{\pos(960,120)}落ち着いてください
Dialogue: 0,0:20:08.12,0:20:10.31,Sousei-CN,,0,0,0,,{\pos(960,80)}请冷静一点
Dialogue: 0,0:20:10.31,0:20:11.26,Sousei-JP,,0,0,0,,つい本音が
Dialogue: 0,0:20:10.31,0:20:11.26,Sousei-CN,,0,0,0,,不小心说出真心话了
Dialogue: 0,0:20:11.26,0:20:14.86,Sousei-JP,,0,0,0,,勇者様に限らず 縁談は全て断りましたから
Dialogue: 0,0:20:11.27,0:20:14.86,Sousei-CN,,0,0,0,,所有提亲 包括勇者大人的 我都拒绝了
Dialogue: 0,0:20:15.27,0:20:16.12,Sousei-JP,,0,0,0,,ホント
Dialogue: 0,0:20:15.27,0:20:16.12,Sousei-CN,,0,0,0,,真的吗
Dialogue: 0,0:20:16.12,0:20:17.36,Sousei-JP,,0,0,0,,本当です
Dialogue: 0,0:20:16.12,0:20:17.36,Sousei-CN,,0,0,0,,真的
Dialogue: 0,0:20:17.36,0:20:20.36,Sousei-JP,,0,0,0,,お母様も変な話をしないでください
Dialogue: 0,0:20:17.36,0:20:20.36,Sousei-CN,,0,0,0,,请母亲也别说些奇怪的话
Dialogue: 0,0:20:20.76,0:20:23.61,Sousei-JP,,0,0,0,,あなたもセシリアのことが好きなのね
Dialogue: 0,0:20:20.76,0:20:23.61,Sousei-CN,,0,0,0,,你也喜欢赛西莉亚啊
Dialogue: 0,0:20:25.22,0:20:27.02,Sousei-JP,,0,0,0,, バレましたか
Dialogue: 0,0:20:25.22,0:20:27.02,Sousei-CN,,0,0,0,,被发现啦
Dialogue: 0,0:20:27.86,0:20:29.37,Sousei-JP,,0,0,0,,それじゃあ
Dialogue: 0,0:20:27.86,0:20:29.37,Sousei-CN,,0,0,0,,那么
Dialogue: 0,0:20:29.37,0:20:32.62,Sousei-JP,,0,0,0,, あなた セシリアと結婚しない
Dialogue: 0,0:20:29.37,0:20:32.62,Sousei-CN,,0,0,0,,你要不要跟赛西莉亚结婚啊
Dialogue: 0,0:20:33.56,0:20:34.91,Sousei-JP,,0,0,0,,お母様
Dialogue: 0,0:20:33.56,0:20:34.91,Sousei-CN,,0,0,0,,母亲
Dialogue: 0,0:20:34.91,0:20:37.13,Sousei-JP,,0,0,0,,あの それってどういう
Dialogue: 0,0:20:34.91,0:20:37.13,Sousei-CN,,0,0,0,,请问 您的意思是
Dialogue: 0,0:20:37.32,0:20:40.38,Sousei-JP,,0,0,0,,するかしないかで答えて
Dialogue: 0,0:20:37.32,0:20:40.38,Sousei-CN,,0,0,0,,回答我 要还是不要
Dialogue: 0,0:20:47.92,0:20:49.22,Sousei-JP,,0,0,0,,ごめんなさい
Dialogue: 0,0:20:47.92,0:20:49.22,Sousei-CN,,0,0,0,,对不起
Dialogue: 0,0:20:50.14,0:20:54.64,Sousei-JP,,0,0,0,,俺 一度セシリアに告白して 断られているんです
Dialogue: 0,0:20:50.14,0:20:54.64,Sousei-CN,,0,0,0,,我曾和她告白 却被拒绝了
Dialogue: 0,0:20:54.96,0:20:59.65,Sousei-JP,,0,0,0,,断られているんです まっとうな生活ができるようになったら
Dialogue: 0,0:20:54.96,0:20:59.65,Sousei-CN,,0,0,0,,我打算以冒险家的身分 努力过上正常生活后
Dialogue: 0,0:20:59.86,0:21:02.46,Sousei-JP,,0,0,0,,もう一度告白しようと決めていて
Dialogue: 0,0:20:59.86,0:21:02.46,Sousei-CN,,0,0,0,,再跟她告白一次
Dialogue: 0,0:21:02.96,0:21:04.15,Sousei-JP,,0,0,0,,えっと
Dialogue: 0,0:21:02.96,0:21:04.15,Sousei-CN,,0,0,0,,呃
Dialogue: 0,0:21:04.15,0:21:05.36,Sousei-JP,,0,0,0,,もういいわ
Dialogue: 0,0:21:04.15,0:21:05.36,Sousei-CN,,0,0,0,,够了
Dialogue: 0,0:21:05.96,0:21:09.66,Sousei-JP,,0,0,0,,母親であるこの私の進言を断ると言うのね
Dialogue: 0,0:21:05.96,0:21:09.66,Sousei-CN,,0,0,0,,没想到你居然拒绝了 身为母亲我的意见
Dialogue: 0,0:21:09.66,0:21:12.36,Sousei-JP,,0,0,0,,気分を害したなら謝ります
Dialogue: 0,0:21:09.66,0:21:12.36,Sousei-CN,,0,0,0,,如果让您感到不愉快 我愿意向您道歉
Dialogue: 0,0:21:12.36,0:21:15.10,Sousei-JP,,0,0,0,,でもこういう事は本人の意思も尊重して
Dialogue: 0,0:21:12.36,0:21:15.10,Sousei-CN,,0,0,0,,可是我认为结婚这种事 需要尊重当事人的意见
Dialogue: 0,0:21:14.52,0:21:15.72,Sousei-JP,,0,0,0,,{\pos(960,120)}合格よ
Dialogue: 0,0:21:14.52,0:21:15.72,Sousei-CN,,0,0,0,,{\pos(960,80)}你合格了
Dialogue: 0,0:21:18.66,0:21:22.36,Sousei-JP,,0,0,0,,大事な娘を簡単にあげる訳ないでしょ
Dialogue: 0,0:21:18.66,0:21:22.36,Sousei-CN,,0,0,0,,我怎么可能轻易地 把宝贝女儿嫁出去呢
Dialogue: 0,0:21:22.36,0:21:24.17,Sousei-JP,,0,0,0,,罠だったんですか
Dialogue: 0,0:21:22.36,0:21:24.17,Sousei-CN,,0,0,0,,原来是陷阱啊
Dialogue: 0,0:21:24.67,0:21:25.66,Sousei-JP,,0,0,0,,まあね
Dialogue: 0,0:21:24.67,0:21:25.66,Sousei-CN,,0,0,0,,算是吧
Dialogue: 0,0:21:25.66,0:21:28.68,Sousei-JP,,0,0,0,,娘に変な虫が付いてたら嫌だもの
Dialogue: 0,0:21:25.66,0:21:28.68,Sousei-CN,,0,0,0,,我也不希望有怪虫子缠着女儿
Dialogue: 0,0:21:28.86,0:21:30.76,Sousei-JP,,0,0,0,,ヨウキくんだったかしら
Dialogue: 0,0:21:28.86,0:21:30.76,Sousei-CN,,0,0,0,,你叫阳树是吗
Dialogue: 0,0:21:31.16,0:21:33.26,Sousei-JP,,0,0,0,,セシリアと仲良くしてね
Dialogue: 0,0:21:31.16,0:21:33.26,Sousei-CN,,0,0,0,,请和赛西莉亚好好相处吧
Dialogue: 0,0:21:33.26,0:21:35.44,Sousei-JP,,0,0,0,,あなたなら歓迎するわ
Dialogue: 0,0:21:33.26,0:21:35.44,Sousei-CN,,0,0,0,,如果是你 我倒是很欢迎
Dialogue: 0,0:21:35.76,0:21:38.07,Sousei-JP,,0,0,0,,あ ありがとうございます
Dialogue: 0,0:21:35.76,0:21:38.07,Sousei-CN,,0,0,0,,谢 谢谢您
Dialogue: 0,0:21:40.31,0:21:43.44,Sousei-JP,,0,0,0,, お母様は あなたのことが気に入ったようですね
Dialogue: 0,0:21:40.31,0:21:43.44,Sousei-CN,,0,0,0,,我母亲好像挺喜欢你的
Dialogue: 0,0:21:43.62,0:21:44.62,Sousei-JP,,0,0,0,,あれで?
Dialogue: 0,0:21:43.62,0:21:44.62,Sousei-CN,,0,0,0,,那样算喜欢?
Dialogue: 0,0:21:44.62,0:21:45.51,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:21:44.62,0:21:45.51,Sousei-CN,,0,0,0,,算啊
Dialogue: 0,0:21:45.51,0:21:47.20,Sousei-JP,,0,0,0,,だったらいいんだけど
Dialogue: 0,0:21:45.51,0:21:47.20,Sousei-CN,,0,0,0,,如果是这样就好了
Dialogue: 0,0:21:47.20,0:21:49.12,Sousei-JP,,0,0,0,,そんなに気になりますか
Dialogue: 0,0:21:47.20,0:21:49.12,Sousei-CN,,0,0,0,,你这么在意吗
Dialogue: 0,0:21:49.12,0:21:51.46,Sousei-JP,,0,0,0,,いやいや そりゃあ セシ
Dialogue: 0,0:21:49.12,0:21:51.46,Sousei-CN,,0,0,0,,毕竟她是赛
Dialogue: 0,0:21:51.46,0:21:53.20,Sousei-JP,,0,0,0,,君のご家族だしさ
Dialogue: 0,0:21:51.46,0:21:53.20,Sousei-CN,,0,0,0,,是你的家人嘛
Dialogue: 0,0:21:57.66,0:22:00.26,Sousei-JP,,0,0,0,,あの お願いがあるんだけど
Dialogue: 0,0:21:57.66,0:22:00.26,Sousei-CN,,0,0,0,,我有个请求
Dialogue: 0,0:22:00.26,0:22:02.46,Sousei-JP,,0,0,0,,はい 何ですか
Dialogue: 0,0:22:00.26,0:22:02.46,Sousei-CN,,0,0,0,,什么请求
Dialogue: 0,0:22:02.62,0:22:06.07,Sousei-JP,,0,0,0,,君のこと セシリアって呼んでいいかな
Dialogue: 0,0:22:02.62,0:22:06.07,Sousei-CN,,0,0,0,,我能直接叫你赛西莉亚吗
Dialogue: 0,0:22:07.71,0:22:10.17,Sousei-JP,,0,0,0,,ご ごめん 変なこと
Dialogue: 0,0:22:07.71,0:22:10.17,Sousei-CN,,0,0,0,,抱 抱歉 问了奇怪的问题
Dialogue: 0,0:22:10.17,0:22:11.26,Sousei-JP,,0,0,0,,いいですよ
Dialogue: 0,0:22:10.17,0:22:11.26,Sousei-CN,,0,0,0,,可以哦
Dialogue: 0,0:22:12.36,0:22:15.98,Sousei-JP,,0,0,0,,じゃあ 私も ヨウキさんって呼びますね
Dialogue: 0,0:22:12.36,0:22:15.98,Sousei-CN,,0,0,0,,那我就叫你阳树先生吧
Dialogue: 0,0:22:19.77,0:22:24.99,Sousei-JP,,0,0,0,,いよっしゃあ
Dialogue: 0,0:22:19.77,0:22:24.99,Sousei-CN,,0,0,0,,好耶

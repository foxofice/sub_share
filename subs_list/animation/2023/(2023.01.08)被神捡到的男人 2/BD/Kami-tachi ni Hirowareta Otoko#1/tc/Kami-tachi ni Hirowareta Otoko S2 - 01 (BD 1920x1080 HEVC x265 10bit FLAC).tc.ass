Dialogue: 0,0:00:11.03,0:00:13.57,UP,,0,0,0,,（龍馬·竹林）
Dialogue: 0,0:00:11.76,0:00:13.19,Default,,0,0,0,,我遲到了啊
Dialogue: 0,0:00:14.53,0:00:17.45,Default,,0,0,0,,給艾莉亞莉亞·賈米爾小姐
Dialogue: 0,0:00:15.59,0:00:17.45,UP,,0,0,0,,大排長龍
Dialogue: 0,0:00:18.53,0:00:20.20,Default,,0,0,0,,妳過得好嗎
Dialogue: 0,0:00:18.95,0:00:20.20,UP,,0,0,0,,歡迎光臨
Dialogue: 0,0:00:20.20,0:00:21.80,UP,,0,0,0,,哎呀 店長
Dialogue: 0,0:00:21.07,0:00:23.88,Default,,0,0,0,,我離開賈米爾的各位 自立門戶
Dialogue: 0,0:00:22.05,0:00:24.14,UP,,0,0,0,,不好意思讓你們久等了
Dialogue: 0,0:00:24.11,0:00:26.53,Default,,0,0,0,,開始在這座基姆爾鎮生活
Dialogue: 0,0:00:24.14,0:00:25.61,UP,,0,0,0,,沒關係
Dialogue: 0,0:00:26.71,0:00:28.16,Default,,0,0,0,,已經過了一段時間
Dialogue: 0,0:00:26.71,0:00:28.68,UP,,0,0,0,,（Bamboo Forest店員兼保鑣 黎琳）
Dialogue: 0,0:00:26.84,0:00:28.17,UP,,0,0,0,,老闆 早安
Dialogue: 0,0:00:29.13,0:00:31.64,UP,,0,0,0,,（Bamboo Forest店員兼保鑣 費伊）
Dialogue: 0,0:00:29.36,0:00:31.64,Default,,0,0,0,,我在這裡的生活很順遂
Dialogue: 0,0:00:29.38,0:00:31.48,UP,,0,0,0,,老闆 早安
Dialogue: 0,0:00:32.07,0:00:33.74,Default,,0,0,0,,大家早
Dialogue: 0,0:00:33.74,0:00:35.70,Default,,0,0,0,,我遲到了
Dialogue: 0,0:00:35.70,0:00:37.11,Default,,0,0,0,,真少見呢
Dialogue: 0,0:00:37.11,0:00:39.99,Default,,0,0,0,,我一直埋頭研究史萊姆
Dialogue: 0,0:00:39.99,0:00:43.20,Default,,0,0,0,,不知不覺就搞到這麼晚
Dialogue: 0,0:00:47.32,0:00:51.49,UP,,0,0,0,,（Bamboo Forest店員 珍）
Dialogue: 0,0:00:47.57,0:00:48.34,Default,,0,0,0,,好的
Dialogue: 0,0:00:48.45,0:00:51.49,Default,,0,0,0,,您要洗的衣物 我收下了
Dialogue: 0,0:00:51.49,0:00:54.70,UP,,0,0,0,,（Bamboo Forest店員 菲娜）
Dialogue: 0,0:00:52.06,0:00:54.42,Default,,0,0,0,,下一位客人 請過來
Dialogue: 0,0:00:55.99,0:00:57.41,Default,,0,0,0,,變得好乾淨
Dialogue: 0,0:00:57.41,0:00:58.12,Default,,0,0,0,,是啊
Dialogue: 0,0:00:58.12,0:01:01.67,UP,,0,0,0,,（Bamboo Forest店員 瑪利亞）
Dialogue: 0,0:00:58.41,0:01:01.31,Default,,0,0,0,,沒有Bamboo Forest洗不掉的污漬
Dialogue: 0,0:01:01.91,0:01:04.11,Default,,0,0,0,,店長 早安
Dialogue: 0,0:01:04.11,0:01:05.70,Default,,0,0,0,,大家早
Dialogue: 0,0:01:05.70,0:01:06.95,Default,,0,0,0,,還忙得過來嗎
Dialogue: 0,0:01:06.95,0:01:07.86,Default,,0,0,0,,可以
Dialogue: 0,0:01:07.86,0:01:09.41,Default,,0,0,0,,交給我們吧
Dialogue: 0,0:01:09.41,0:01:10.99,Default,,0,0,0,,謝謝妳們
Dialogue: 0,0:01:14.07,0:01:15.41,Default,,0,0,0,,早安
Dialogue: 0,0:01:16.32,0:01:18.93,Default,,0,0,0,,店長 早安
Dialogue: 0,0:01:18.93,0:01:22.85,UP,,0,0,0,,（Bamboo Forest廚師 謝爾瑪）
Dialogue: 0,0:01:19.29,0:01:22.55,Default,,0,0,0,,今天也請多多指教
Dialogue: 0,0:01:27.36,0:01:30.20,Default,,0,0,0,,大家都很努力在工作
Dialogue: 0,0:01:28.01,0:01:29.91,UP,,0,0,0,,卡爾菈小姐 卡爾姆先生
Dialogue: 0,0:01:30.20,0:01:31.11,UP,,0,0,0,,早安
Dialogue: 0,0:01:31.11,0:01:32.74,Default,,0,0,0,,為了報答他們的努力
Dialogue: 0,0:01:31.36,0:01:34.20,UP,,0,0,0,,（Bamboo Forest營運助理 卡爾菈）
Dialogue: 0,0:01:31.53,0:01:32.49,UP,,0,0,0,,店長
Dialogue: 0,0:01:32.74,0:01:34.03,Default,,0,0,0,,我想以店長的身分
Dialogue: 0,0:01:32.74,0:01:34.03,UP,,0,0,0,,早安
Dialogue: 0,0:01:34.03,0:01:37.29,Default,,0,0,0,,打造能讓員工舒適工作的環境
Dialogue: 0,0:01:34.70,0:01:37.29,UP,,0,0,0,,（Bamboo Forest營運助理 卡爾姆）
Dialogue: 0,0:01:34.87,0:01:37.29,UP,,0,0,0,,今天也請多多指教
Dialogue: 0,0:01:37.99,0:01:39.49,Default,,0,0,0,,大家早啊
Dialogue: 0,0:01:40.53,0:01:42.74,Default,,0,0,0,,今天也好好努力工作吧
Dialogue: 0,0:01:42.74,0:01:43.74,Default,,0,0,0,,是
Dialogue: 0,0:01:50.35,0:01:53.00,OPJP,,0,0,0,,Let's walk! Let's walk!
Dialogue: 0,0:01:53.56,0:01:54.95,OPJP,,0,0,0,,Let's walk the road
Dialogue: 0,0:01:54.95,0:01:56.55,OPJP,,0,0,0,,立ち止まらず
Dialogue: 0,0:01:56.72,0:01:59.29,OPJP,,0,0,0,,Let's walk! Let's walk!
Dialogue: 0,0:01:59.81,0:02:01.26,OPJP,,0,0,0,,Let's walk the road
Dialogue: 0,0:02:01.26,0:02:03.07,OPJP,,0,0,0,,歩きだすよ
Dialogue: 0,0:02:16.65,0:02:22.39,OPJP,,0,0,0,,今はもう前に進んでゆくだけさ
Dialogue: 0,0:02:22.39,0:02:26.64,OPJP,,0,0,0,,絶対振り向いたりしないんだから
Dialogue: 0,0:02:29.23,0:02:32.12,OPJP,,0,0,0,,離れていてもずっと
Dialogue: 0,0:02:32.40,0:02:36.23,OPJP,,0,0,0,,いつだって浮かぶ君のスマイル
Dialogue: 0,0:02:36.50,0:02:40.42,OPJP,,0,0,0,,すぐそばにいる様
Dialogue: 0,0:02:41.34,0:02:44.20,OPJP,,0,0,0,,Everyone has a mission
Dialogue: 0,0:02:44.25,0:02:46.89,OPJP,,0,0,0,,この命を
Dialogue: 0,0:02:47.05,0:02:50.42,OPJP,,0,0,0,,全うするために
Dialogue: 0,0:02:50.52,0:02:53.67,OPJP,,0,0,0,,生まれてきたんだ
Dialogue: 0,0:02:53.97,0:02:56.82,OPJP,,0,0,0,,Everyone has a mission
Dialogue: 0,0:02:56.97,0:03:03.40,OPJP,,0,0,0,,この命が続いてゆく限り
Dialogue: 0,0:03:03.40,0:03:04.58,OPJP,,0,0,0,,Time to go!
Dialogue: 0,0:03:04.79,0:03:07.24,OPJP,,0,0,0,,I got to go, way to go!
Dialogue: 0,0:03:09.15,0:03:11.11,OPJP,,0,0,0,,Way to go!
Dialogue: 0,0:01:50.35,0:01:53.00,OPCN,,0,0,0,,走吧！走吧！
Dialogue: 0,0:01:53.56,0:01:54.95,OPCN,,0,0,0,,順著這條路走下去
Dialogue: 0,0:01:54.95,0:01:56.55,OPCN,,0,0,0,,不要停下
Dialogue: 0,0:01:56.72,0:01:59.29,OPCN,,0,0,0,,走吧！走吧！
Dialogue: 0,0:01:59.81,0:02:01.26,OPCN,,0,0,0,,順著這條路走下去
Dialogue: 0,0:02:01.26,0:02:03.07,OPCN,,0,0,0,,出發吧
Dialogue: 0,0:02:16.65,0:02:22.39,OPCN,,0,0,0,,現在除了前進沒有別的選擇
Dialogue: 0,0:02:22.39,0:02:26.64,OPCN,,0,0,0,,絕對不會再掉頭返回了
Dialogue: 0,0:02:29.23,0:02:32.12,OPCN,,0,0,0,,即使彼此相隔得再遙遠
Dialogue: 0,0:02:32.40,0:02:36.23,OPCN,,0,0,0,,也永遠能回想起你的微笑
Dialogue: 0,0:02:36.50,0:02:40.42,OPCN,,0,0,0,,就好像你未曾離開一樣
Dialogue: 0,0:02:41.34,0:02:44.20,OPCN,,0,0,0,,人人都有使命
Dialogue: 0,0:02:44.25,0:02:46.89,OPCN,,0,0,0,,為了讓人生
Dialogue: 0,0:02:47.05,0:02:50.42,OPCN,,0,0,0,,變得充實起來
Dialogue: 0,0:02:50.52,0:02:53.67,OPCN,,0,0,0,,一路走到這裡
Dialogue: 0,0:02:53.97,0:02:56.82,OPCN,,0,0,0,,人人都有使命
Dialogue: 0,0:02:56.97,0:03:03.40,OPCN,,0,0,0,,只要人生還沒結束
Dialogue: 0,0:03:03.40,0:03:04.58,OPCN,,0,0,0,,該走了！
Dialogue: 0,0:03:04.79,0:03:07.24,OPCN,,0,0,0,,我該走了 上路吧！
Dialogue: 0,0:03:09.15,0:03:11.11,OPCN,,0,0,0,,上路吧！
Dialogue: 0,0:03:13.97,0:03:18.97,Default,,0,0,0,,第1集 龍馬和新計劃
Dialogue: 0,0:03:22.57,0:03:24.57,Default,,0,0,0,,所以說 我希望店長
Dialogue: 0,0:03:25.16,0:03:29.20,Default,,0,0,0,,以後就跟今天差不多的時間\N來上班就行了
Dialogue: 0,0:03:29.74,0:03:31.24,Default,,0,0,0,,為什麼啊
Dialogue: 0,0:03:31.24,0:03:34.32,Default,,0,0,0,,你們總是從一大早就很忙
Dialogue: 0,0:03:34.32,0:03:36.95,Default,,0,0,0,,如果店長在開店前來
Dialogue: 0,0:03:36.95,0:03:41.24,Default,,0,0,0,,一定會自己做好開店準備
Dialogue: 0,0:03:41.24,0:03:44.11,Default,,0,0,0,,這樣下面的人就沒事做了
Dialogue: 0,0:03:44.57,0:03:46.78,Default,,0,0,0,,我們還有新人要培訓
Dialogue: 0,0:03:47.49,0:03:48.61,Default,,0,0,0,,店長也趁這個機會
Dialogue: 0,0:03:48.61,0:03:50.78,Default,,0,0,0,,習慣使喚下面的人
Dialogue: 0,0:03:50.78,0:03:54.03,Default,,0,0,0,,把工作交給部下處理吧
Dialogue: 0,0:03:54.03,0:03:57.20,Default,,0,0,0,,原來我搶了大家的工作啊
Dialogue: 0,0:03:57.20,0:03:58.74,Default,,0,0,0,,知道了
Dialogue: 0,0:03:58.74,0:04:00.95,Default,,0,0,0,,就這麼辦吧
Dialogue: 0,0:04:01.41,0:04:04.61,Default,,0,0,0,,然後我還有一個建議
Dialogue: 0,0:04:04.61,0:04:05.70,Default,,0,0,0,,請說
Dialogue: 0,0:04:05.70,0:04:07.66,Default,,0,0,0,,關於二號店的事…
Dialogue: 0,0:04:13.99,0:04:15.61,Default,,0,0,0,,發生了什麼事
Dialogue: 0,0:04:15.61,0:04:17.57,Default,,0,0,0,,稍等一下喔
Dialogue: 0,0:04:17.57,0:04:19.24,Default,,0,0,0,,我馬上就綁好
Dialogue: 0,0:04:20.45,0:04:22.86,Default,,0,0,0,,他們做了什麼
Dialogue: 0,0:04:22.86,0:04:26.41,Default,,0,0,0,,是跑來抱怨污漬沒洗乾淨的流氓
Dialogue: 0,0:04:27.36,0:04:30.45,Default,,0,0,0,,可是我剛剛聽到爆笑聲
Dialogue: 0,0:04:30.45,0:04:31.61,Default,,0,0,0,,那是因為…
Dialogue: 0,0:04:32.45,0:04:36.07,Default,,0,0,0,,混帳 根本完全沒洗乾淨嘛
Dialogue: 0,0:04:36.07,0:04:37.53,Default,,0,0,0,,妳們看
Dialogue: 0,0:04:37.53,0:04:39.32,Default,,0,0,0,,這些污漬…
Dialogue: 0,0:04:40.16,0:04:41.78,Default,,0,0,0,,好乾淨
Dialogue: 0,0:04:41.78,0:04:42.86,Default,,0,0,0,,你這傢伙
Dialogue: 0,0:04:42.86,0:04:45.82,Default,,0,0,0,,我不是叫你要弄上\N絕對洗不掉的污漬嗎
Dialogue: 0,0:04:45.82,0:04:47.61,Default,,0,0,0,,我有弄啊
Dialogue: 0,0:04:49.24,0:04:50.53,Default,,0,0,0,,真蠢
Dialogue: 0,0:04:50.53,0:04:51.61,Default,,0,0,0,,什麼
Dialogue: 0,0:04:51.61,0:04:53.16,Default,,0,0,0,,你罵誰蠢啊
Dialogue: 0,0:04:56.82,0:04:58.74,Default,,0,0,0,,我把他們送去交給警備隊
Dialogue: 0,0:04:58.74,0:04:59.70,UP,,0,0,0,,可惡
Dialogue: 0,0:04:58.74,0:05:01.32,Default,,0,0,0,,事情就是這樣
Dialogue: 0,0:04:59.70,0:05:01.32,UP,,0,0,0,,給我記住
Dialogue: 0,0:05:01.32,0:05:02.41,Default,,0,0,0,,這樣啊
Dialogue: 0,0:05:02.41,0:05:04.20,Default,,0,0,0,,真是傷腦筋
Dialogue: 0,0:05:04.20,0:05:08.20,Default,,0,0,0,,所以我才會說\N沒有Bamboo Forest洗不掉的污漬
Dialogue: 0,0:05:09.32,0:05:13.41,Default,,0,0,0,,店裡的防盜措施\N也必須重新思考才行
Dialogue: 0,0:05:14.07,0:05:15.70,Default,,0,0,0,,玻璃…
Dialogue: 0,0:05:17.57,0:05:18.70,Default,,0,0,0,,卡爾菈小姐
Dialogue: 0,0:05:18.70,0:05:20.03,Default,,0,0,0,,什麼事
Dialogue: 0,0:05:20.03,0:05:22.95,Default,,0,0,0,,我有一件想嘗試的事情
Dialogue: 0,0:05:22.95,0:05:24.49,Default,,0,0,0,,所以要回去廢棄坑道
Dialogue: 0,0:05:31.78,0:05:32.78,Default,,0,0,0,,首先
Dialogue: 0,0:05:32.78,0:05:36.07,Default,,0,0,0,,讓黏液史萊姆吐出硬化黏液
Dialogue: 0,0:05:41.70,0:05:44.11,Default,,0,0,0,,用分離魔法陣去除水分
Dialogue: 0,0:05:48.28,0:05:50.61,Default,,0,0,0,,然後再加入硬化黏液
Dialogue: 0,0:05:53.03,0:05:55.95,Default,,0,0,0,,用混合魔法陣混合後
Dialogue: 0,0:06:01.41,0:06:03.45,Default,,0,0,0,,再用分離魔法陣去除水分
Dialogue: 0,0:06:06.66,0:06:08.82,Default,,0,0,0,,只要這樣反覆做好幾遍
Dialogue: 0,0:06:08.82,0:06:11.99,Default,,0,0,0,,就能讓黏液史萊姆的\N硬化黏液逐漸濃縮
Dialogue: 0,0:06:17.95,0:06:19.99,Default,,0,0,0,,把它變成板狀
Dialogue: 0,0:06:29.61,0:06:32.16,Default,,0,0,0,,用強化魔法敲擊也不會碎裂
Dialogue: 0,0:06:32.16,0:06:33.49,Default,,0,0,0,,也沒有模糊之處
Dialogue: 0,0:06:33.49,0:06:35.99,Default,,0,0,0,,當成窗戶玻璃來用完全沒問題
Dialogue: 0,0:06:36.57,0:06:39.61,Default,,0,0,0,,如此堅固也很適合防盜
Dialogue: 0,0:06:39.61,0:06:42.53,Default,,0,0,0,,這樣就能保護員工和客人了
Dialogue: 0,0:06:43.41,0:06:47.20,Default,,0,0,0,,各位 我想多做一些這個
Dialogue: 0,0:06:47.20,0:06:48.70,Default,,0,0,0,,能麻煩你們嗎
Dialogue: 0,0:06:55.45,0:06:57.74,Default,,0,0,0,,這樣子應該就夠了吧
Dialogue: 0,0:07:04.16,0:07:06.28,Default,,0,0,0,,今天就這樣先去睡吧
Dialogue: 0,0:07:08.82,0:07:11.20,Default,,0,0,0,,我沒看過這個史萊姆
Dialogue: 0,0:07:12.95,0:07:14.20,Default,,0,0,0,,鑑定
Dialogue: 0,0:07:17.11,0:07:19.61,Default,,0,0,0,,藥物史萊姆
Dialogue: 0,0:07:19.61,0:07:22.41,Default,,0,0,0,,我不記得有跟它訂下契約
Dialogue: 0,0:07:22.41,0:07:24.32,Default,,0,0,0,,難道是進化變成的嗎
Dialogue: 0,0:07:25.20,0:07:27.16,Default,,0,0,0,,技能裡有槍術
Dialogue: 0,0:07:27.78,0:07:28.70,Default,,0,0,0,,也就是說
Dialogue: 0,0:07:28.70,0:07:30.82,Default,,0,0,0,,它原本是毒物史萊姆嗎
Dialogue: 0,0:07:31.61,0:07:35.24,Default,,0,0,0,,可是為什麼毒物史萊姆\N會變成藥物史萊姆
Dialogue: 0,0:07:39.49,0:07:43.11,Default,,0,0,0,,昨天我不小心弄掉了解毒劑的瓶子
Dialogue: 0,0:07:47.11,0:07:48.07,Default,,0,0,0,,糟了
Dialogue: 0,0:07:48.07,0:07:49.49,Default,,0,0,0,,抹布…
Dialogue: 0,0:07:57.49,0:07:58.36,Default,,0,0,0,,奇怪
Dialogue: 0,0:08:00.41,0:08:04.41,Default,,0,0,0,,我一直以為是清潔史萊姆\N幫忙打掃乾淨的
Dialogue: 0,0:08:05.20,0:08:06.91,Default,,0,0,0,,難道是…
Dialogue: 0,0:08:09.70,0:08:11.78,Default,,0,0,0,,牠們在喝解毒劑
Dialogue: 0,0:08:11.78,0:08:14.32,Default,,0,0,0,,毒物史萊姆進化之後
Dialogue: 0,0:08:14.32,0:08:16.41,Default,,0,0,0,,果然會變成藥物史萊姆啊
Dialogue: 0,0:08:19.16,0:08:20.45,Default,,0,0,0,,趁這段時間…
Dialogue: 0,0:08:23.70,0:08:26.36,Default,,0,0,0,,讓我看看你會做哪些藥物吧
Dialogue: 0,0:08:33.82,0:08:35.32,Default,,0,0,0,,種類真多呢
Dialogue: 0,0:08:35.86,0:08:37.24,Default,,0,0,0,,鑑定
Dialogue: 0,0:08:38.95,0:08:40.66,Default,,0,0,0,,傷藥
Dialogue: 0,0:08:40.66,0:08:42.16,Default,,0,0,0,,止血劑
Dialogue: 0,0:08:42.16,0:08:43.45,Default,,0,0,0,,解毒劑
Dialogue: 0,0:08:43.45,0:08:45.49,Default,,0,0,0,,速效性毒藥
Dialogue: 0,0:08:45.49,0:08:47.49,Default,,0,0,0,,遲效性毒藥
Dialogue: 0,0:08:47.49,0:08:49.78,Default,,0,0,0,,速效性麻醉毒藥
Dialogue: 0,0:08:49.78,0:08:52.16,Default,,0,0,0,,遲效性麻醉毒藥
Dialogue: 0,0:08:52.16,0:08:53.95,Default,,0,0,0,,抗菌藥
Dialogue: 0,0:08:55.49,0:08:56.99,Default,,0,0,0,,種類好廣泛
Dialogue: 0,0:08:57.36,0:08:58.70,Default,,0,0,0,,果然不論是毒藥或藥物
Dialogue: 0,0:08:58.70,0:09:00.86,Default,,0,0,0,,都可以變成液體藥物嗎
Dialogue: 0,0:09:01.49,0:09:03.78,Default,,0,0,0,,這個抗菌藥是什麼
Dialogue: 0,0:09:07.70,0:09:10.49,Default,,0,0,0,,具有強烈抗菌效果的液體
Dialogue: 0,0:09:10.49,0:09:13.24,Default,,0,0,0,,可以消滅細菌和病毒
Dialogue: 0,0:09:13.24,0:09:15.49,Default,,0,0,0,,對人體無害
Dialogue: 0,0:09:15.49,0:09:17.41,Default,,0,0,0,,是消毒藥啊
Dialogue: 0,0:09:17.41,0:09:19.66,Default,,0,0,0,,這個也許能派上用場
Dialogue: 0,0:09:20.20,0:09:21.57,Default,,0,0,0,,我想…
Dialogue: 0,0:09:21.57,0:09:22.78,Default,,0,0,0,,把自己能做的事情
Dialogue: 0,0:09:22.78,0:09:24.61,Default,,0,0,0,,一件一件慢慢完成
Dialogue: 0,0:09:25.53,0:09:27.74,Default,,0,0,0,,別讓邀請我一起同行的
Dialogue: 0,0:09:27.74,0:09:31.74,Default,,0,0,0,,賈米爾公爵家的人們替我操心
Dialogue: 0,0:09:33.11,0:09:34.70,Default,,0,0,0,,對了
Dialogue: 0,0:09:34.70,0:09:36.74,Default,,0,0,0,,最近因為太倉促了
Dialogue: 0,0:09:36.74,0:09:39.74,Default,,0,0,0,,都沒跟眾神們打招呼
Dialogue: 0,0:09:39.74,0:09:41.82,Default,,0,0,0,,明天去一趟教會吧
Dialogue: 0,0:09:43.86,0:09:48.11,Default,,0,0,0,,他又在做有趣的事了
Dialogue: 0,0:09:50.32,0:09:53.10,Default,,0,0,0,,接下來也請多多指教
Dialogue: 0,0:09:55.24,0:09:58.74,Default,,0,0,0,,我每天都在想龍馬先生喔
Dialogue: 0,0:10:02.24,0:10:03.53,Default,,0,0,0,,歡迎光臨
Dialogue: 0,0:10:03.53,0:10:05.82,Default,,0,0,0,,你今天來這裡有什麼事
Dialogue: 0,0:10:05.82,0:10:07.07,Default,,0,0,0,,我是來祈禱的
Dialogue: 0,0:10:07.07,0:10:08.61,Default,,0,0,0,,原來如此
Dialogue: 0,0:10:08.61,0:10:10.74,Default,,0,0,0,,那麼請進吧
Dialogue: 0,0:10:10.74,0:10:12.49,Default,,0,0,0,,謝謝妳
Dialogue: 0,0:10:22.49,0:10:23.78,Default,,0,0,0,,奇怪
Dialogue: 0,0:10:23.78,0:10:26.86,Default,,0,0,0,,我還以為會像平常那樣\N前往神的世界
Dialogue: 0,0:10:26.86,0:10:28.28,Default,,0,0,0,,結果什麼都沒發生
Dialogue: 0,0:10:28.28,0:10:29.24,Default,,0,0,0,,也是啦
Dialogue: 0,0:10:29.24,0:10:31.82,Default,,0,0,0,,每次都去得成才奇怪吧
Dialogue: 0,0:10:38.41,0:10:39.82,Default,,0,0,0,,這裡是…
Dialogue: 0,0:10:39.82,0:10:41.57,Default,,0,0,0,,跟往常一樣啊
Dialogue: 0,0:10:41.57,0:10:43.99,Default,,0,0,0,,不過比往常延遲了一些
Dialogue: 0,0:10:43.99,0:10:45.32,Default,,0,0,0,,抱歉啦
Dialogue: 0,0:10:45.32,0:10:47.70,Default,,0,0,0,,因為我很少使用這股力量
Dialogue: 0,0:10:47.70,0:10:49.28,Default,,0,0,0,,所以花了一點時間
Dialogue: 0,0:10:51.41,0:10:53.78,Default,,0,0,0,,是第一次見到的對象
Dialogue: 0,0:10:53.78,0:10:56.07,Default,,0,0,0,,既然他在這個空間就代表…
Dialogue: 0,0:10:56.78,0:10:59.11,Default,,0,0,0,,初次見面您好
Dialogue: 0,0:10:59.11,0:11:02.36,Default,,0,0,0,,因為我開始獨自在這個城鎮生活
Dialogue: 0,0:11:02.36,0:11:04.45,Default,,0,0,0,,所以前來打聲招呼
Dialogue: 0,0:11:04.45,0:11:05.16,Default,,0,0,0,,你好
Dialogue: 0,0:11:05.16,0:11:08.32,Default,,0,0,0,,我是技術與職人之神 鐵昆
Dialogue: 0,0:11:08.32,0:11:09.82,Default,,0,0,0,,你就這麼叫我吧
Dialogue: 0,0:11:09.82,0:11:12.70,Default,,0,0,0,,另外 跟我講話用不著客氣
Dialogue: 0,0:11:12.70,0:11:16.32,Default,,0,0,0,,只要我想 也能窺看你的內心
Dialogue: 0,0:11:16.32,0:11:18.41,Default,,0,0,0,,在我面前掩飾根本沒有意義
Dialogue: 0,0:11:18.41,0:11:20.82,Default,,0,0,0,,我也不喜歡拘泥形式
Dialogue: 0,0:11:20.82,0:11:22.36,Default,,0,0,0,,你坐吧
Dialogue: 0,0:11:23.36,0:11:24.49,Default,,0,0,0,,那我就隨意一點
Dialogue: 0,0:11:25.03,0:11:26.32,Default,,0,0,0,,初次見面你好
Dialogue: 0,0:11:26.32,0:11:28.45,Default,,0,0,0,,我是竹林龍馬
Dialogue: 0,0:11:29.36,0:11:30.66,Default,,0,0,0,,那些…
Dialogue: 0,0:11:32.07,0:11:33.78,Default,,0,0,0,,是我做的
Dialogue: 0,0:11:33.78,0:11:34.78,Default,,0,0,0,,對
Dialogue: 0,0:11:34.78,0:11:37.16,Default,,0,0,0,,因為我想仔細地看看
Dialogue: 0,0:11:37.16,0:11:39.99,Default,,0,0,0,,所以就自己仿造了
Dialogue: 0,0:11:39.99,0:11:41.95,Default,,0,0,0,,是類似複製品的東西啊
Dialogue: 0,0:11:41.95,0:11:44.86,Default,,0,0,0,,你是從地球來的人類吧
Dialogue: 0,0:11:44.86,0:11:45.95,Default,,0,0,0,,對
Dialogue: 0,0:11:47.20,0:11:50.95,Default,,0,0,0,,我原本在俗稱的黑心企業上班
Dialogue: 0,0:11:50.95,0:11:53.32,Default,,0,0,0,,因為在睡覺時打噴嚏的關係
Dialogue: 0,0:11:53.32,0:11:55.99,Default,,0,0,0,,轉眼間就死了
Dialogue: 0,0:11:55.99,0:11:58.07,Default,,0,0,0,,之後被眾神們帶走
Dialogue: 0,0:11:58.07,0:11:59.66,Default,,0,0,0,,變成少年的模樣
Dialogue: 0,0:11:59.66,0:12:02.03,Default,,0,0,0,,轉生到這個世界
Dialogue: 0,0:12:02.82,0:12:05.20,Default,,0,0,0,,聽說是這樣
Dialogue: 0,0:12:05.20,0:12:08.78,Default,,0,0,0,,不過 我只聽過你的事蹟
Dialogue: 0,0:12:08.78,0:12:11.82,Default,,0,0,0,,對異世界的技術深感興趣
Dialogue: 0,0:12:11.82,0:12:14.20,Default,,0,0,0,,你說的技術是指做人偶嗎
Dialogue: 0,0:12:14.20,0:12:15.74,Default,,0,0,0,,以不同的文化
Dialogue: 0,0:12:15.74,0:12:18.16,Default,,0,0,0,,未知的技術手法做出的東西
Dialogue: 0,0:12:18.16,0:12:21.61,Default,,0,0,0,,讓我這個技術與職人之神\N產生了興趣
Dialogue: 0,0:12:21.61,0:12:24.32,Default,,0,0,0,,但是因為我是技術之神
Dialogue: 0,0:12:24.32,0:12:28.53,Default,,0,0,0,,對這個世界的技術無所不知
Dialogue: 0,0:12:28.95,0:12:32.91,Default,,0,0,0,,也就是說你對異世界的技術\N還有不了解的地方
Dialogue: 0,0:12:32.91,0:12:33.99,Default,,0,0,0,,所以覺得很稀奇
Dialogue: 0,0:12:33.99,0:12:35.49,Default,,0,0,0,,就是這樣
Dialogue: 0,0:12:35.49,0:12:37.20,Default,,0,0,0,,而且這個人偶
Dialogue: 0,0:12:37.20,0:12:41.49,Default,,0,0,0,,以作品而言\N一看就知道作工很精細
Dialogue: 0,0:12:41.49,0:12:43.53,Default,,0,0,0,,這好像不是你的本行
Dialogue: 0,0:12:43.53,0:12:46.95,Default,,0,0,0,,但你應該長時間都在做這件事吧
Dialogue: 0,0:12:47.66,0:12:50.41,Default,,0,0,0,,因為我的興趣是做手工藝
Dialogue: 0,0:12:50.41,0:12:52.24,Default,,0,0,0,,以現實層面來說
Dialogue: 0,0:12:52.24,0:12:53.70,Default,,0,0,0,,也有很多價格不錯
Dialogue: 0,0:12:53.70,0:12:56.57,Default,,0,0,0,,以及提出高額報酬的委託
Dialogue: 0,0:12:56.57,0:12:57.95,Default,,0,0,0,,既然收了人家的錢
Dialogue: 0,0:12:57.95,0:12:59.20,Default,,0,0,0,,自然不能偷工減料
Dialogue: 0,0:12:59.20,0:13:01.99,Default,,0,0,0,,沒錯 這是當然的
Dialogue: 0,0:13:01.99,0:13:05.49,Default,,0,0,0,,但世界上有很多人不是這樣
Dialogue: 0,0:13:05.49,0:13:06.99,Default,,0,0,0,,作為職人之神
Dialogue: 0,0:13:06.99,0:13:10.20,Default,,0,0,0,,我不討厭做事細心的人
Dialogue: 0,0:13:10.20,0:13:11.74,Default,,0,0,0,,原來如此
Dialogue: 0,0:13:11.74,0:13:14.78,Default,,0,0,0,,對了 今天只有你在這裡嗎
Dialogue: 0,0:13:14.78,0:13:15.66,Default,,0,0,0,,對
Dialogue: 0,0:13:15.66,0:13:19.24,Default,,0,0,0,,因為其他人都各自跑去偷閒了
Dialogue: 0,0:13:19.86,0:13:23.99,Default,,0,0,0,,戰爭之神 魔法之神 大地之神
Dialogue: 0,0:13:23.99,0:13:26.61,Default,,0,0,0,,在你眼中 他們也許都是潔白的神
Dialogue: 0,0:13:26.61,0:13:29.61,Default,,0,0,0,,但他們各自都有喜歡的去處
Dialogue: 0,0:13:29.61,0:13:31.16,Default,,0,0,0,,他們會在那裡
Dialogue: 0,0:13:31.16,0:13:33.78,Default,,0,0,0,,建造你們人類所說的家居住
Dialogue: 0,0:13:34.32,0:13:36.78,Default,,0,0,0,,原來如此 我都不知道
Dialogue: 0,0:13:37.41,0:13:41.11,Default,,0,0,0,,也就是說 這裡是你家囉
Dialogue: 0,0:13:41.11,0:13:44.03,Default,,0,0,0,,不是 我沒有家
Dialogue: 0,0:13:44.03,0:13:47.03,Default,,0,0,0,,因為我是技術與職人之神
Dialogue: 0,0:13:47.03,0:13:49.91,Default,,0,0,0,,世界各地都有技術與職人
Dialogue: 0,0:13:49.91,0:13:52.07,Default,,0,0,0,,他們存在於各個地方
Dialogue: 0,0:13:52.07,0:13:54.61,Default,,0,0,0,,我會不時到各地去看看
Dialogue: 0,0:13:54.61,0:13:58.07,Default,,0,0,0,,這裡也跟你們生活的世界相連
Dialogue: 0,0:13:58.95,0:14:02.74,Default,,0,0,0,,詳細的解說 你就去問別人吧
Dialogue: 0,0:14:02.74,0:14:05.16,Default,,0,0,0,,因為我沒辦法好好解說
Dialogue: 0,0:14:05.16,0:14:07.41,Default,,0,0,0,,換作是費諾貝利亞
Dialogue: 0,0:14:07.41,0:14:09.57,Default,,0,0,0,,也許就能夠好好解說了
Dialogue: 0,0:14:10.11,0:14:11.86,Default,,0,0,0,,費諾貝利亞
Dialogue: 0,0:14:11.86,0:14:13.70,Default,,0,0,0,,我沒聽過這個名字
Dialogue: 0,0:14:13.70,0:14:16.32,Default,,0,0,0,,是喔 你不認識他嗎
Dialogue: 0,0:14:16.32,0:14:17.74,Default,,0,0,0,,他是魔法之神
Dialogue: 0,0:14:18.61,0:14:22.03,Default,,0,0,0,,魔法與學問之神 費諾貝利亞
Dialogue: 0,0:14:22.03,0:14:23.86,Default,,0,0,0,,雖然他整天關在自己的領域
Dialogue: 0,0:14:23.86,0:14:27.11,Default,,0,0,0,,不知道在做些什麼
Dialogue: 0,0:14:27.11,0:14:31.49,Default,,0,0,0,,但他的知識最淵博 也很會解說
Dialogue: 0,0:14:31.49,0:14:33.99,Default,,0,0,0,,不過他是連同樣是神的我
Dialogue: 0,0:14:33.99,0:14:36.99,Default,,0,0,0,,都很難見到的傢伙
Dialogue: 0,0:14:37.45,0:14:38.95,Default,,0,0,0,,我也不知道你有生之年
Dialogue: 0,0:14:38.95,0:14:41.95,Default,,0,0,0,,有沒有機會見到他
Dialogue: 0,0:14:41.95,0:14:44.61,Default,,0,0,0,,有好多各式各樣的神呢
Dialogue: 0,0:14:44.61,0:14:45.82,Default,,0,0,0,,是啊
Dialogue: 0,0:14:46.57,0:14:48.70,Default,,0,0,0,,時間好像到了
Dialogue: 0,0:14:48.70,0:14:51.28,Default,,0,0,0,,我還想再跟你聊一下呢
Dialogue: 0,0:14:51.28,0:14:52.53,Default,,0,0,0,,我會再來的
Dialogue: 0,0:14:52.53,0:14:55.49,Default,,0,0,0,,好 我會等你來的
Dialogue: 0,0:15:03.99,0:15:05.41,Default,,0,0,0,,謝謝妳
Dialogue: 0,0:15:05.41,0:15:06.82,Default,,0,0,0,,這是我該說的
Dialogue: 0,0:15:06.82,0:15:09.61,Default,,0,0,0,,謝謝你捐款給我們
Dialogue: 0,0:15:09.61,0:15:11.36,Default,,0,0,0,,哪裡 我會再來的
Dialogue: 0,0:15:11.95,0:15:14.70,Default,,0,0,0,,差不多可以去店裡了吧
Dialogue: 0,0:15:18.66,0:15:21.28,Default,,0,0,0,,我今天稍微晚點來上班
Dialogue: 0,0:15:21.28,0:15:23.28,Default,,0,0,0,,沒有出什麼問題吧
Dialogue: 0,0:15:23.28,0:15:25.16,Default,,0,0,0,,完全沒有喔
Dialogue: 0,0:15:25.16,0:15:29.20,Default,,0,0,0,,新人們工作也上手了許多
Dialogue: 0,0:15:29.20,0:15:30.66,Default,,0,0,0,,這樣啊
Dialogue: 0,0:15:30.66,0:15:31.82,Default,,0,0,0,,真是太好了
Dialogue: 0,0:15:31.82,0:15:33.20,Default,,0,0,0,,然後呢 老闆
Dialogue: 0,0:15:33.20,0:15:36.16,Default,,0,0,0,,聽說你有事找我們
Dialogue: 0,0:15:37.53,0:15:41.41,Default,,0,0,0,,對 其實是關於這家店的窗戶
Dialogue: 0,0:15:41.41,0:15:44.66,Default,,0,0,0,,那個 只要把它打破闖入
Dialogue: 0,0:15:44.66,0:15:46.91,Default,,0,0,0,,輕輕鬆鬆就能進來了吧
Dialogue: 0,0:15:46.91,0:15:47.91,Default,,0,0,0,,是啊
Dialogue: 0,0:15:47.91,0:15:49.82,Default,,0,0,0,,只要準備一把槌子或斧頭
Dialogue: 0,0:15:49.82,0:15:51.28,Default,,0,0,0,,輕鬆就能闖入
Dialogue: 0,0:15:51.28,0:15:53.91,Default,,0,0,0,,我們有嚴加戒備這個部分
Dialogue: 0,0:15:53.91,0:15:56.20,Default,,0,0,0,,一直以來謝謝你們了
Dialogue: 0,0:15:56.20,0:15:58.78,Default,,0,0,0,,因此我想了一個辦法
Dialogue: 0,0:15:58.78,0:16:01.03,Default,,0,0,0,,只要讓窗戶不會被破壞
Dialogue: 0,0:16:01.03,0:16:03.20,Default,,0,0,0,,也許就能減輕勞力負擔
Dialogue: 0,0:16:05.74,0:16:09.61,Default,,0,0,0,,這是我想用來代替窗戶玻璃的東西
Dialogue: 0,0:16:09.61,0:16:11.57,Default,,0,0,0,,相當堅固喔
Dialogue: 0,0:16:16.28,0:16:17.16,Default,,0,0,0,,老闆
Dialogue: 0,0:16:17.16,0:16:20.16,Default,,0,0,0,,我也可以試著敲擊它嗎
Dialogue: 0,0:16:20.82,0:16:22.82,Default,,0,0,0,,當然可以 請吧
Dialogue: 0,0:16:22.82,0:16:24.24,Default,,0,0,0,,我還有其他備品
Dialogue: 0,0:16:24.24,0:16:25.74,Default,,0,0,0,,就算弄壞了也沒關係
Dialogue: 0,0:16:25.74,0:16:27.45,Default,,0,0,0,,我幫妳拿著吧
Dialogue: 0,0:16:33.86,0:16:34.82,Default,,0,0,0,,我要上囉
Dialogue: 0,0:16:37.49,0:16:38.66,Default,,0,0,0,,好厲害
Dialogue: 0,0:16:38.66,0:16:40.41,Default,,0,0,0,,完全不會壞呢
Dialogue: 0,0:16:40.41,0:16:42.74,Default,,0,0,0,,那是店長做的嗎
Dialogue: 0,0:16:43.07,0:16:43.91,Default,,0,0,0,,對
Dialogue: 0,0:16:43.91,0:16:46.99,Default,,0,0,0,,這也許能成為熱賣的商品
Dialogue: 0,0:16:48.41,0:16:53.11,Default,,0,0,0,,很抱歉 我不打算販賣這個
Dialogue: 0,0:16:53.11,0:16:55.20,Default,,0,0,0,,因為生產量很少
Dialogue: 0,0:16:55.41,0:16:56.99,Default,,0,0,0,,這樣啊
Dialogue: 0,0:16:56.99,0:16:58.86,Default,,0,0,0,,恕我多嘴了
Dialogue: 0,0:16:58.86,0:16:59.74,Default,,0,0,0,,黎琳
Dialogue: 0,0:16:59.74,0:17:02.36,Default,,0,0,0,,妳用強化魔法試著攻擊看看
Dialogue: 0,0:17:02.36,0:17:03.95,Default,,0,0,0,,對喔
Dialogue: 0,0:17:12.41,0:17:14.57,Default,,0,0,0,,的確很堅固
Dialogue: 0,0:17:14.57,0:17:16.49,Default,,0,0,0,,只要把它裝在一樓的窗戶
Dialogue: 0,0:17:16.49,0:17:19.95,Default,,0,0,0,,入侵者一定很難闖進來
Dialogue: 0,0:17:20.53,0:17:24.07,Default,,0,0,0,,但是 如果我們被逼入絕境
Dialogue: 0,0:17:24.07,0:17:27.61,Default,,0,0,0,,也沒辦法迅速打破窗戶逃走耶
Dialogue: 0,0:17:27.61,0:17:31.16,Default,,0,0,0,,對喔 的確有這項缺點
Dialogue: 0,0:17:31.16,0:17:32.74,Default,,0,0,0,,我都沒注意到
Dialogue: 0,0:17:32.74,0:17:35.03,Default,,0,0,0,,不過用來防止敵人闖入
Dialogue: 0,0:17:35.03,0:17:36.70,Default,,0,0,0,,這是很棒的東西
Dialogue: 0,0:17:36.70,0:17:38.16,Default,,0,0,0,,我們就換掉幾扇窗戶
Dialogue: 0,0:17:38.16,0:17:40.41,Default,,0,0,0,,減少能讓人偷偷潛入的地方
Dialogue: 0,0:17:40.41,0:17:42.20,Default,,0,0,0,,這也是一個辦法
Dialogue: 0,0:17:42.20,0:17:43.82,Default,,0,0,0,,只要一開始就知道缺點
Dialogue: 0,0:17:43.82,0:17:45.45,Default,,0,0,0,,總會有辦法應付
Dialogue: 0,0:17:45.45,0:17:46.78,Default,,0,0,0,,我懂了
Dialogue: 0,0:17:46.78,0:17:49.82,Default,,0,0,0,,那麼店裡的窗戶就換成它
Dialogue: 0,0:17:49.82,0:17:50.86,Default,,0,0,0,,這樣可以嗎
Dialogue: 0,0:17:50.86,0:17:52.32,Default,,0,0,0,,麻煩你了
Dialogue: 0,0:17:53.16,0:17:55.66,Default,,0,0,0,,那我馬上來換
Dialogue: 0,0:17:55.66,0:17:56.61,Default,,0,0,0,,店長
Dialogue: 0,0:17:56.61,0:18:01.16,Default,,0,0,0,,你等一下不是與摩根商會的\N賽爾吉先生有約嗎
Dialogue: 0,0:18:01.74,0:18:03.11,Default,,0,0,0,,我都忘了
Dialogue: 0,0:18:03.11,0:18:05.24,Default,,0,0,0,,這件事就交給我們做吧
Dialogue: 0,0:18:06.28,0:18:08.20,Default,,0,0,0,,不好意思 麻煩你們了
Dialogue: 0,0:18:08.86,0:18:12.32,Default,,0,0,0,,店長 我昨天本來想跟你說件事
Dialogue: 0,0:18:12.32,0:18:13.36,Default,,0,0,0,,什麼事
Dialogue: 0,0:18:13.36,0:18:16.45,Default,,0,0,0,,在別的城鎮成立二號店的建議
Dialogue: 0,0:18:16.99,0:18:18.11,Default,,0,0,0,,這件事啊
Dialogue: 0,0:18:18.11,0:18:20.99,Default,,0,0,0,,我覺得有點太快了
Dialogue: 0,0:18:20.99,0:18:22.74,Default,,0,0,0,,會嗎
Dialogue: 0,0:18:22.74,0:18:24.78,Default,,0,0,0,,反正店裡的人手變多了
Dialogue: 0,0:18:24.78,0:18:28.07,Default,,0,0,0,,能否請你重新考慮看看呢
Dialogue: 0,0:18:28.07,0:18:29.49,Default,,0,0,0,,知道了
Dialogue: 0,0:18:29.49,0:18:30.91,Default,,0,0,0,,我會考慮看看
Dialogue: 0,0:18:33.32,0:18:37.53,Default,,0,0,0,,我才剛在這座基姆爾鎮\N成立自己的店
Dialogue: 0,0:18:37.53,0:18:39.95,Default,,0,0,0,,現在就要去別的城鎮開另一家店
Dialogue: 0,0:18:39.95,0:18:42.28,Default,,0,0,0,,我覺得有點太快了
Dialogue: 0,0:18:43.41,0:18:45.24,Default,,0,0,0,,我想好好重視
Dialogue: 0,0:18:45.24,0:18:48.61,Default,,0,0,0,,在這座城鎮建立的人脈
Dialogue: 0,0:18:48.99,0:18:52.57,Default,,0,0,0,,歡迎光臨 龍馬先生
Dialogue: 0,0:18:52.57,0:18:54.07,Default,,0,0,0,,你好 賽爾吉先生
Dialogue: 0,0:18:54.78,0:18:57.20,Default,,0,0,0,,我今天是來買私人用的物品
Dialogue: 0,0:18:57.20,0:18:58.86,Default,,0,0,0,,這樣啊
Dialogue: 0,0:18:58.86,0:19:00.66,Default,,0,0,0,,你想買什麼
Dialogue: 0,0:19:00.66,0:19:04.49,Default,,0,0,0,,我想大量採購用來裝藥的藥瓶
Dialogue: 0,0:19:04.49,0:19:06.82,Default,,0,0,0,,大量採購嗎
Dialogue: 0,0:19:06.82,0:19:08.11,Default,,0,0,0,,對
Dialogue: 0,0:19:08.11,0:19:09.66,Default,,0,0,0,,因為我多了空閒時間
Dialogue: 0,0:19:09.66,0:19:11.82,Default,,0,0,0,,所以想來做些藥物
Dialogue: 0,0:19:11.82,0:19:13.49,Default,,0,0,0,,因為從事冒險者這一行
Dialogue: 0,0:19:13.49,0:19:15.32,Default,,0,0,0,,時常有受傷的危險
Dialogue: 0,0:19:15.32,0:19:16.82,Default,,0,0,0,,所以我想防範未然
Dialogue: 0,0:19:17.74,0:19:19.36,Default,,0,0,0,,原來如此
Dialogue: 0,0:19:19.36,0:19:22.95,Default,,0,0,0,,不過要是你想大量採購藥瓶
Dialogue: 0,0:19:22.95,0:19:26.20,Default,,0,0,0,,可以到商業公會登記為藥商
Dialogue: 0,0:19:26.20,0:19:29.61,Default,,0,0,0,,透過商業公會向中盤商購買
Dialogue: 0,0:19:29.61,0:19:31.66,Default,,0,0,0,,價格會便宜很多喔
Dialogue: 0,0:19:33.24,0:19:35.11,Default,,0,0,0,,原來如此
Dialogue: 0,0:19:35.11,0:19:38.61,Default,,0,0,0,,你是為了買藥瓶才來這裡的嗎
Dialogue: 0,0:19:39.16,0:19:40.28,Default,,0,0,0,,對
Dialogue: 0,0:19:40.28,0:19:43.78,Default,,0,0,0,,賽爾吉先生建議我來這裡會比較好
Dialogue: 0,0:19:43.78,0:19:47.32,Default,,0,0,0,,那麼你的技術怎麼樣呢
Dialogue: 0,0:19:47.32,0:19:49.41,Default,,0,0,0,,對喔
Dialogue: 0,0:19:51.24,0:19:53.03,Default,,0,0,0,,這是解毒藥
Dialogue: 0,0:19:53.03,0:19:54.95,Default,,0,0,0,,這是消毒藥
Dialogue: 0,0:19:54.95,0:19:56.24,Default,,0,0,0,,這樣啊
Dialogue: 0,0:19:58.99,0:20:01.70,Default,,0,0,0,,你還滿厲害的嘛
Dialogue: 0,0:20:01.70,0:20:04.03,Default,,0,0,0,,既然能做出這樣的藥物
Dialogue: 0,0:20:04.03,0:20:07.03,Default,,0,0,0,,應該也有能力當藥商吧
Dialogue: 0,0:20:07.03,0:20:09.66,Default,,0,0,0,,我目前沒有這個打算
Dialogue: 0,0:20:09.66,0:20:11.91,Default,,0,0,0,,也對 以你的立場來看
Dialogue: 0,0:20:11.91,0:20:15.11,Default,,0,0,0,,成立二號店才是當務之急吧
Dialogue: 0,0:20:15.82,0:20:16.95,Default,,0,0,0,,怎麼了
Dialogue: 0,0:20:16.95,0:20:18.28,Default,,0,0,0,,沒什麼
Dialogue: 0,0:20:18.28,0:20:20.24,Default,,0,0,0,,在店裡工作的卡爾菈小姐
Dialogue: 0,0:20:20.24,0:20:22.32,Default,,0,0,0,,也跟我說了這件事
Dialogue: 0,0:20:22.32,0:20:24.74,Default,,0,0,0,,但我覺得還太早了
Dialogue: 0,0:20:24.74,0:20:27.20,Default,,0,0,0,,如果是你 我想就算開了二號店
Dialogue: 0,0:20:27.20,0:20:29.57,Default,,0,0,0,,也會經營得很順利
Dialogue: 0,0:20:29.57,0:20:31.03,Default,,0,0,0,,真的嗎
Dialogue: 0,0:20:32.07,0:20:35.95,Default,,0,0,0,,如果是因為開二號店的錢不夠
Dialogue: 0,0:20:35.95,0:20:39.74,Default,,0,0,0,,把賣藥當作副業也不錯吧
Dialogue: 0,0:20:39.74,0:20:42.99,Default,,0,0,0,,不然就由我全部買下來
Dialogue: 0,0:20:43.66,0:20:44.41,Default,,0,0,0,,全部
Dialogue: 0,0:20:44.41,0:20:47.66,Default,,0,0,0,,因為我對你有很多期待
Dialogue: 0,0:20:55.03,0:20:58.66,Default,,0,0,0,,開二號店果然還是太早了
Dialogue: 0,0:21:01.03,0:21:02.49,Default,,0,0,0,,利穆爾鳥
Dialogue: 0,0:21:02.49,0:21:04.07,Default,,0,0,0,,是艾莉亞寄來的信
Dialogue: 0,0:21:08.53,0:21:09.57,Default,,0,0,0,,龍馬先生
Dialogue: 0,0:21:09.57,0:21:11.70,Default,,0,0,0,,謝謝你寫信給我
Dialogue: 0,0:21:13.11,0:21:15.66,Default,,0,0,0,,我剛結束漫長的旅程
Dialogue: 0,0:21:15.66,0:21:18.41,Default,,0,0,0,,回到家裡 暫時告一個段落
Dialogue: 0,0:21:19.28,0:21:21.78,Default,,0,0,0,,我的家人也都過得很好
Dialogue: 0,0:21:22.36,0:21:25.11,Default,,0,0,0,,你交給我的史萊姆們
Dialogue: 0,0:21:25.11,0:21:26.95,Default,,0,0,0,,也過得很好喔
Dialogue: 0,0:21:31.78,0:21:34.57,Default,,0,0,0,,聽到你努力工作的消息
Dialogue: 0,0:21:34.57,0:21:37.99,Default,,0,0,0,,我也覺得自己必須努力
Dialogue: 0,0:21:41.32,0:21:44.49,Default,,0,0,0,,我接下來該怎麼努力呢
Dialogue: 0,0:21:45.45,0:21:48.70,Default,,0,0,0,,在別的城鎮成立二號店的建議
Dialogue: 0,0:21:49.24,0:21:51.99,Default,,0,0,0,,如果是你 我想就算開了二號店
Dialogue: 0,0:21:51.99,0:21:54.20,Default,,0,0,0,,也會經營得很順利
Dialogue: 0,0:21:57.36,0:21:58.70,Default,,0,0,0,,二號店啊
Dialogue: 0,0:22:02.86,0:22:05.07,Default,,0,0,0,,艾莉亞
Dialogue: 0,0:22:05.07,0:22:07.86,Default,,0,0,0,,看來我也要忙起來了
Dialogue: 0,0:22:21.20,0:22:24.49,EDJP,,0,0,0,,センサーライト音沙汰なくて
Dialogue: 0,0:22:24.72,0:22:30.72,EDJP,,0,0,0,,この部屋にわたしがいないみたいだ
Dialogue: 0,0:22:31.21,0:22:33.75,EDJP,,0,0,0,,＃にフィグジャムをつけたら
Dialogue: 0,0:22:33.75,0:22:35.90,EDJP,,0,0,0,,バスタブに泡をたてて
Dialogue: 0,0:22:35.90,0:22:42.96,EDJP,,0,0,0,,よみがえるの 明日のため…Undead!!
Dialogue: 0,0:22:50.87,0:22:53.35,EDJP,,0,0,0,,なくはないの あなたとなら
Dialogue: 0,0:22:53.35,0:22:56.04,EDJP,,0,0,0,,巡り巡る 機械と水
Dialogue: 0,0:22:56.04,0:22:59.72,EDJP,,0,0,0,,ドラム式の宇宙をそっと 見つめて
Dialogue: 0,0:23:00.20,0:23:05.03,EDJP,,0,0,0,,口説きたいな Ah死ぬまで
Dialogue: 0,0:23:05.03,0:23:10.12,EDJP,,0,0,0,,弧を描いた solarの果て
Dialogue: 0,0:23:10.12,0:23:12.91,EDJP,,0,0,0,,愛は少しくたびれて
Dialogue: 0,0:23:12.91,0:23:15.42,EDJP,,0,0,0,,遠ざかりつつあるわ
Dialogue: 0,0:23:15.42,0:23:18.19,EDJP,,0,0,0,,n時発の小惑星で行くの
Dialogue: 0,0:23:18.19,0:23:22.19,EDJP,,0,0,0,,あなた 夢抱いて
Dialogue: 0,0:23:22.35,0:23:29.92,EDJP,,0,0,0,,抱いて 抱いて 抱いて
Dialogue: 0,0:23:29.92,0:23:34.75,EDJP,,0,0,0,,抱いて 抱いて
Dialogue: 0,0:22:21.20,0:22:24.49,EDCN,,0,0,0,,探測光線 未發出聲音
Dialogue: 0,0:22:24.72,0:22:30.72,EDCN,,0,0,0,,似乎我並不在這間房內
Dialogue: 0,0:22:31.21,0:22:33.75,EDCN,,0,0,0,,在#後面輸入FigJam
Dialogue: 0,0:22:33.75,0:22:35.90,EDCN,,0,0,0,,浴缸裡充滿了泡沫
Dialogue: 0,0:22:35.90,0:22:42.96,EDCN,,0,0,0,,為了明天再一次醒來……Undead!!
Dialogue: 0,0:22:50.87,0:22:53.35,EDCN,,0,0,0,,若與你同在 便完美無缺
Dialogue: 0,0:22:53.35,0:22:56.04,EDCN,,0,0,0,,循環著循環著 機器和水
Dialogue: 0,0:22:56.04,0:22:59.72,EDCN,,0,0,0,,悄悄地凝望 滾筒式的宇宙
Dialogue: 0,0:23:00.20,0:23:05.03,EDCN,,0,0,0,,我想要述懷 Ah 到死之前
Dialogue: 0,0:23:05.03,0:23:10.12,EDCN,,0,0,0,,劃一道弧線 至太陽系盡頭
Dialogue: 0,0:23:10.12,0:23:12.91,EDCN,,0,0,0,,愛也是略顯疲態
Dialogue: 0,0:23:12.91,0:23:15.42,EDCN,,0,0,0,,越來越遠了啊
Dialogue: 0,0:23:15.42,0:23:18.19,EDCN,,0,0,0,,坐上n時發的小行星出發了
Dialogue: 0,0:23:18.19,0:23:22.19,EDCN,,0,0,0,,而你 懷著夢
Dialogue: 0,0:23:22.35,0:23:29.92,EDCN,,0,0,0,,懷著夢 懷著夢 懷著夢
Dialogue: 0,0:23:29.92,0:23:34.75,EDCN,,0,0,0,,懷著夢 懷著夢

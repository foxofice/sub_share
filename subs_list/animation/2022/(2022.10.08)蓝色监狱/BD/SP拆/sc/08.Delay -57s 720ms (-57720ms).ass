Dialogue: 0,0:00:04.03,0:00:06.95,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#8 送上门的玲王老婆
Dialogue: 1,0:00:01.02,0:00:03.98,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:00:03.98,0:00:07.65,CN,,900,0,0,,玲王 足球的规则是怎样的？
Dialogue: 1,0:00:07.65,0:00:11.58,CN,,0,0,0,,简而言之 你接到我的传球 然后射门得分就行了
Dialogue: 1,0:00:12.29,0:00:15.00,CN,,0,0,0,,凪 想要哪种钉鞋？
Dialogue: 1,0:00:16.17,0:00:19.01,CN,,0,0,0,,好麻烦 随便吧
Dialogue: 1,0:00:19.01,0:00:21.34,CN,,0,0,0,,练习好累
Dialogue: 1,0:00:22.55,0:00:24.05,CN,,0,0,0,,那休息一下
Dialogue: 1,0:00:24.05,0:00:26.01,CN,,0,0,0,,我背你 来
Dialogue: 1,0:00:26.21,0:00:28.72,CN,,0,0,0,,肌肉好痛
Dialogue: 1,0:00:28.72,0:00:29.78,CN,,0,0,0,,这附近？
Dialogue: 1,0:00:29.78,0:00:31.75,CN,,0,0,0,,再往下一点
Dialogue: 1,0:00:31.75,0:00:33.66,CN,,0,0,0,,应该是成长期的肌肉痛吧
Dialogue: 1,0:00:34.16,0:00:36.21,CN,,0,0,0,,明天能来练习吗？
Dialogue: 1,0:00:37.98,0:00:40.65,CN,,0,0,0,,足球果然很麻烦
Dialogue: 1,0:00:40.65,0:00:43.40,CN,,0,0,0,,放学后我来接你
Dialogue: 1,0:00:44.57,0:00:46.44,CN,,0,0,0,,好麻烦
Dialogue: 0,0:00:01.02,0:00:03.98,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:00:03.98,0:00:07.65,JP,,900,0,0,,ねえ　玲王　サッカーって　どんなルールだっけ？
Dialogue: 0,0:00:07.65,0:00:11.58,JP,,0,0,0,,とりあえず　俺からのパスでゴール入れりゃいいよ　お前は
Dialogue: 0,0:00:12.29,0:00:15.00,JP,,0,0,0,,おい　凪　どっちのスパイクがいい？
Dialogue: 0,0:00:16.17,0:00:19.01,JP,,0,0,0,,面倒くさいから何でもいい
Dialogue: 0,0:00:19.01,0:00:21.34,JP,,0,0,0,,練習疲れた
Dialogue: 0,0:00:22.55,0:00:24.05,JP,,0,0,0,,んじゃ休憩
Dialogue: 0,0:00:24.05,0:00:26.01,JP,,0,0,0,,おぶってやるから　こっちこい
Dialogue: 0,0:00:26.21,0:00:28.72,JP,,0,0,0,,筋肉痛いてぇ
Dialogue: 0,0:00:28.72,0:00:29.78,JP,,0,0,0,,この辺か？
Dialogue: 0,0:00:29.78,0:00:31.75,JP,,0,0,0,,もうちょい下
Dialogue: 0,0:00:31.75,0:00:33.66,JP,,0,0,0,,成長痛だな
Dialogue: 0,0:00:34.16,0:00:36.21,JP,,0,0,0,,明日も練習来れるか？
Dialogue: 0,0:00:37.98,0:00:40.65,JP,,0,0,0,,やっぱサッカーは面倒くさい
Dialogue: 0,0:00:40.65,0:00:43.40,JP,,0,0,0,,授業終わったら迎えに行くからな
Dialogue: 0,0:00:44.57,0:00:46.44,JP,,0,0,0,,面倒くさい

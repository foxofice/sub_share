Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥吶
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:01:02.78,0:01:05.54,Layzner,,0,0,0,,诞生的秘密一定要保护
Dialogue: 0,0:01:07.10,0:01:10.06,Layzner,,0,0,0,,杀死玖 玖丽亚
Dialogue: 0,0:01:47.70,0:01:48.70,Layzner,,0,0,0,,警告
Dialogue: 0,0:01:49.22,0:01:50.70,Layzner,,0,0,0,,不要接近我
Dialogue: 0,0:01:50.82,0:01:52.90,Layzner,,0,0,0,,再接触我的话
Dialogue: 0,0:01:52.98,0:01:55.02,Layzner,,0,0,0,,我会以自己的意志
Dialogue: 0,0:01:55.14,0:01:57.62,Layzner,,0,0,0,,做重大的决定
Dialogue: 0,0:01:57.78,0:01:59.02,Layzner,,0,0,0,,弗隆 是我
Dialogue: 0,0:02:00.22,0:02:02.58,Layzner,,0,0,0,,阿尔巴特洛·纳尔·英二·飞鸟吗
Dialogue: 0,0:02:03.22,0:02:04.58,Layzner,,0,0,0,,弗隆 听我说
Dialogue: 0,0:02:04.94,0:02:06.86,Layzner,,0,0,0,,必须要新的身体
Dialogue: 0,0:02:07.34,0:02:10.66,Layzner,,0,0,0,,英二 作为我的信赖者
Dialogue: 0,0:02:11.34,0:02:13.46,Layzner,,0,0,0,,希望你能正确地回答我
Dialogue: 0,0:02:13.98,0:02:17.18,Layzner,,0,0,0,,当我知道无法保护自己时
Dialogue: 0,0:02:18.06,0:02:20.42,Layzner,,0,0,0,,为了不被第三者利用
Dialogue: 0,0:02:21.06,0:02:24.46,Layzner,,0,0,0,,我自己一定要破坏自己的机能
Dialogue: 0,0:02:24.46,0:02:27.50,Layzner,,0,0,0,,终止隐藏着的使命
Dialogue: 0,0:02:27.62,0:02:28.54,Layzner,,0,0,0,,等等 弗隆
Dialogue: 0,0:02:29.18,0:02:32.26,Layzner,,0,0,0,,为了你自己 还有你隐藏的使命
Dialogue: 0,0:02:32.54,0:02:34.50,Layzner,,0,0,0,,希望你能转移到那台新雷兹纳
Dialogue: 0,0:02:38.34,0:02:40.98,Layzner,,0,0,0,,弗隆 当先祖古拉特斯人真正的心
Dialogue: 0,0:02:41.22,0:02:44.02,Layzner,,0,0,0,,和地球人做的新身体结合之时
Dialogue: 0,0:02:44.90,0:02:47.14,Layzner,,0,0,0,,你真正的使命便会完成
Dialogue: 0,0:02:47.62,0:02:49.46,Layzner,,0,0,0,,即是说 你和我
Dialogue: 0,0:02:49.90,0:02:51.82,Layzner,,0,0,0,,承担着相同的命运
Dialogue: 0,0:02:55.34,0:02:57.02,Layzner,,0,0,0,,驾乘着撒卡尔的鲁凯恩
Dialogue: 0,0:02:57.38,0:02:59.70,Layzner,,0,0,0,,受到其破坏性打击的雷兹纳
Dialogue: 0,0:03:00.98,0:03:02.94,Layzner,,0,0,0,,因为身上隐藏的秘密
Dialogue: 0,0:03:04.14,0:03:06.58,Layzner,,0,0,0,,讽刺的被鲁凯恩保护
Dialogue: 0,0:03:07.10,0:03:08.78,Layzner,,0,0,0,,逃出了被卡露拉小队消灭的危机
Dialogue: 0,0:03:17.42,0:03:19.58,Layzner,,0,0,0,,弗隆 有什么感想
Dialogue: 0,0:03:19.98,0:03:22.06,Layzner,,0,0,0,,阿尔巴特洛·纳尔·英二·飞鸟
Dialogue: 0,0:03:22.86,0:03:28.06,Layzner,,0,0,0,,我 等待新身体的完成
Dialogue: 0,0:03:34.26,0:03:40.18,Layzner,,0,0,0,,ACT-III 刻印2000
Dialogue: 0,0:03:41.30,0:03:42.18,Layzner,,0,0,0,,父亲
Dialogue: 0,0:03:43.42,0:03:44.82,Layzner,,0,0,0,,我有事要问你
Dialogue: 0,0:03:46.50,0:03:50.78,Layzner,,0,0,0,,为何要派卡露拉队插手我和雷兹纳的战斗
Dialogue: 0,0:03:51.94,0:03:52.66,Layzner,,0,0,0,,为什么
Dialogue: 0,0:03:54.70,0:03:56.10,Layzner,,0,0,0,,请告诉我原因
Dialogue: 0,0:04:01.54,0:04:03.66,Layzner,,0,0,0,,还是说这是卡露拉的意思
Dialogue: 0,0:04:03.90,0:04:04.42,Layzner,,0,0,0,,我
Dialogue: 0,0:04:05.94,0:04:07.38,Layzner,,0,0,0,,我不是在问你
Dialogue: 0,0:04:08.42,0:04:10.58,Layzner,,0,0,0,,还有一点 你把玖丽亚怎么了
Dialogue: 0,0:04:11.14,0:04:13.78,Layzner,,0,0,0,,我查清楚是爸爸捉走了她
Dialogue: 0,0:04:14.50,0:04:16.46,Layzner,,0,0,0,,这个原因也请告诉我
Dialogue: 0,0:04:18.82,0:04:20.34,Layzner,,0,0,0,,父亲
Dialogue: 0,0:04:35.62,0:04:36.50,Layzner,,0,0,0,,鲁凯恩
Dialogue: 0,0:04:44.94,0:04:47.26,Layzner,,0,0,0,,一切都是为了你
Dialogue: 0,0:04:48.66,0:04:53.82,Layzner,,0,0,0,,你认为古拉特斯人是远比地球人优秀的人种
Dialogue: 0,0:04:53.94,0:04:56.14,Layzner,,0,0,0,,这是事实
Dialogue: 0,0:04:56.90,0:04:59.14,Layzner,,0,0,0,,优秀的人领导
Dialogue: 0,0:04:59.30,0:05:01.46,Layzner,,0,0,0,,对于领导的服从
Dialogue: 0,0:05:01.82,0:05:04.22,Layzner,,0,0,0,,这是你支配的原理吗
Dialogue: 0,0:05:04.58,0:05:05.98,Layzner,,0,0,0,,正是如此
Dialogue: 0,0:05:14.10,0:05:15.90,Layzner,,0,0,0,,果然是这样 爸爸
Dialogue: 0,0:05:19.18,0:05:22.02,Layzner,,0,0,0,,玖丽亚 告鲁凯恩吧
Dialogue: 0,0:05:22.58,0:05:24.98,Layzner,,0,0,0,,鲁凯恩大人 你错了
Dialogue: 0,0:05:25.82,0:05:28.06,Layzner,,0,0,0,,古拉特斯人和地球人是同等的
Dialogue: 0,0:05:29.50,0:05:31.94,Layzner,,0,0,0,,原本古拉特斯人和地球人
Dialogue: 0,0:05:32.14,0:05:34.78,Layzner,,0,0,0,,就是同一条根发展出来的种族
Dialogue: 0,0:05:36.30,0:05:39.00,Layzner,,0,0,0,,一出现就说些奇怪的话
Dialogue: 0,0:05:39.02,0:05:40.78,Layzner,,0,0,0,,不 我没有说谎
Dialogue: 0,0:05:41.06,0:05:43.58,Layzner,,0,0,0,,古拉特斯和地球的祖先是一样的
Dialogue: 0,0:05:43.58,0:05:44.54,Layzner,,0,0,0,,住嘴 玖丽亚
Dialogue: 0,0:05:45.46,0:05:48.46,Layzner,,0,0,0,,爸爸 你要让她说疯话到何时
Dialogue: 0,0:05:49.58,0:05:51.02,Layzner,,0,0,0,,请听我说 鲁凯恩大人
Dialogue: 0,0:05:51.38,0:05:53.82,Layzner,,0,0,0,,你爸爸带走我
Dialogue: 0,0:05:53.98,0:05:56.06,Layzner,,0,0,0,,还有插手你和雷兹纳的战斗
Dialogue: 0,0:05:55.38,0:05:55.62,Layzner,,0,0,0,,父亲
Dialogue: 0,0:05:56.18,0:05:58.94,Layzner,,0,0,0,,都是因为害怕这秘密被你听到
Dialogue: 0,0:06:00.26,0:06:03.54,Layzner,,0,0,0,,害怕你知道这个秘密后受到打击
Dialogue: 0,0:06:03.70,0:06:05.18,Layzner,,0,0,0,,太无礼了 玖丽亚
Dialogue: 0,0:06:05.54,0:06:07.18,Layzner,,0,0,0,,让你说话便得寸进尺
Dialogue: 0,0:06:07.34,0:06:09.58,Layzner,,0,0,0,,害怕我受打击
Dialogue: 0,0:06:09.58,0:06:11.54,Layzner,,0,0,0,,简直胡说八道
Dialogue: 0,0:06:11.62,0:06:14.94,Layzner,,0,0,0,,爸爸 还要放任她胡说八道吗
Dialogue: 0,0:06:16.42,0:06:17.42,Layzner,,0,0,0,,鲁凯恩啊
Dialogue: 0,0:06:17.78,0:06:20.18,Layzner,,0,0,0,,玖丽亚所说的都是事实
Dialogue: 0,0:06:20.90,0:06:21.50,Layzner,,0,0,0,,没有说谎
Dialogue: 0,0:06:21.78,0:06:22.54,Layzner,,0,0,0,,父亲
Dialogue: 0,0:06:23.54,0:06:25.86,Layzner,,0,0,0,,这是身为古拉特斯权利中央的人
Dialogue: 0,0:06:26.02,0:06:28.38,Layzner,,0,0,0,,终究会知道的秘密
Dialogue: 0,0:06:30.10,0:06:32.70,Layzner,,0,0,0,,你一定要明白支配的原理
Dialogue: 0,0:06:33.86,0:06:37.82,Layzner,,0,0,0,,支配是从承认自己的罪恶出发的
Dialogue: 0,0:06:38.50,0:06:44.50,Layzner,,0,0,0,,你要明白 为了维持支配 百万人都要流血
Dialogue: 0,0:06:45.10,0:06:48.02,Layzner,,0,0,0,,所以为了血不会白流
Dialogue: 0,0:06:48.50,0:06:50.98,Layzner,,0,0,0,,支配者一定要是优秀的
Dialogue: 0,0:06:50.98,0:06:53.38,Layzner,,0,0,0,,优秀具体是什么含义
Dialogue: 0,0:06:54.18,0:06:55.78,Layzner,,0,0,0,,知识还是肉体呢
Dialogue: 0,0:06:55.94,0:06:57.66,Layzner,,0,0,0,,家势还是名望呢
Dialogue: 0,0:06:57.86,0:06:59.10,Layzner,,0,0,0,,很危险
Dialogue: 0,0:06:59.78,0:07:01.86,Layzner,,0,0,0,,而且这样的价值观极易变化
Dialogue: 0,0:07:02.18,0:07:03.90,Layzner,,0,0,0,,支配就是力量
Dialogue: 0,0:07:04.26,0:07:05.78,Layzner,,0,0,0,,压倒他人的力量
Dialogue: 0,0:07:06.18,0:07:08.02,Layzner,,0,0,0,,力量也就是恶
Dialogue: 0,0:07:10.46,0:07:14.18,Layzner,,0,0,0,,首先承认自己是恶是必要的
Dialogue: 0,0:07:14.78,0:07:16.38,Layzner,,0,0,0,,清楚这一切
Dialogue: 0,0:07:16.54,0:07:19.94,Layzner,,0,0,0,,仍然能做到理所当然地君临天下也是必要的
Dialogue: 0,0:07:23.62,0:07:28.14,Layzner,,0,0,0,,果然作为占领军司令仍然还是未成熟
Dialogue: 0,0:07:28.54,0:07:29.06,Layzner,,0,0,0,,鲁凯恩
Dialogue: 0,0:07:30.02,0:07:31.74,Layzner,,0,0,0,,这是父亲的想法
Dialogue: 0,0:07:32.54,0:07:33.62,Layzner,,0,0,0,,以我的角度来看
Dialogue: 0,0:07:33.82,0:07:37.54,Layzner,,0,0,0,,绝对是应该由优秀的人来支配
Dialogue: 0,0:07:40.54,0:07:40.54,Layzner,,0,0,0,,只是支配的话蠢材也做得到
Dialogue: 0,0:07:40.70,0:07:42.82,Layzner,,0,0,0,,不 只有优秀的人才可以
Dialogue: 0,0:07:42.94,0:07:44.26,Layzner,,0,0,0,,还没明白吗 鲁凯恩
Dialogue: 0,0:07:44.66,0:07:46.46,Layzner,,0,0,0,,父亲才是不明白
Dialogue: 0,0:07:46.82,0:07:49.38,Layzner,,0,0,0,,父亲是想从支配的高处逃避
Dialogue: 0,0:07:50.50,0:07:52.14,Layzner,,0,0,0,,你说得太多了 鲁凯恩
Dialogue: 0,0:07:52.74,0:07:53.38,Layzner,,0,0,0,,退下吧
Dialogue: 0,0:07:54.02,0:07:55.30,Layzner,,0,0,0,,等等 父亲
Dialogue: 0,0:08:02.42,0:08:04.10,Layzner,,0,0,0,,你太幼稚了
Dialogue: 0,0:08:04.98,0:08:06.46,Layzner,,0,0,0,,太卑鄙了 父亲
Dialogue: 0,0:08:06.82,0:08:09.58,Layzner,,0,0,0,,就算我违背父亲的意思
Dialogue: 0,0:08:12.50,0:08:14.98,Layzner,,0,0,0,,这便是父亲的支配理论吗
Dialogue: 0,0:08:15.42,0:08:18.66,Layzner,,0,0,0,,鲁凯恩 我要罢免你
Dialogue: 0,0:08:19.18,0:08:19.98,Layzner,,0,0,0,,父亲
Dialogue: 0,0:08:22.90,0:08:23.70,Layzner,,0,0,0,,父亲
Dialogue: 0,0:08:25.86,0:08:26.54,Layzner,,0,0,0,,退下
Dialogue: 0,0:10:09.34,0:10:11.34,Layzner,,0,0,0,,为了古拉特斯的支配和你的
Dialogue: 0,0:10:14.02,0:10:15.98,Layzner,,0,0,0,,为了你自己
Dialogue: 0,0:10:16.98,0:10:24.46,Layzner,,0,0,0,,我 死的真相 要保密
Dialogue: 0,0:10:34.06,0:10:35.74,Layzner,,0,0,0,,父亲
Dialogue: 0,0:10:41.62,0:10:43.54,Layzner,,0,0,0,,古拉特斯诞生的秘密
Dialogue: 0,0:10:43.54,0:10:45.30,Layzner,,0,0,0,,一定要保护住
Dialogue: 0,0:10:48.22,0:10:51.82,Layzner,,0,0,0,,杀死 玖丽亚
Dialogue: 0,0:10:55.10,0:10:55.82,Layzner,,0,0,0,,父亲
Dialogue: 0,0:10:58.18,0:10:59.06,Layzner,,0,0,0,,父亲
Dialogue: 0,0:11:22.06,0:11:23.50,Layzner,,0,0,0,,诸位士兵
Dialogue: 0,0:11:24.42,0:11:27.02,Layzner,,0,0,0,,我在这里继承亡父的遗志
Dialogue: 0,0:11:27.54,0:11:29.46,Layzner,,0,0,0,,立誓为古拉特斯和地球人
Dialogue: 0,0:11:29.46,0:11:33.06,Layzner,,0,0,0,,建设理想国家而努力
Dialogue: 0,0:11:33.78,0:11:34.34,Layzner,,0,0,0,,罗安·德米特里希 过来
Dialogue: 0,0:11:36.02,0:11:36.38,Layzner,,0,0,0,,是
Dialogue: 0,0:11:41.54,0:11:42.18,Layzner,,0,0,0,,诸位士兵
Dialogue: 0,0:11:42.82,0:11:43.62,Layzner,,0,0,0,,介绍一下
Dialogue: 0,0:11:44.54,0:11:48.26,Layzner,,0,0,0,,罗安·德米特里希 此人以后就是我的右手
Dialogue: 0,0:11:49.14,0:11:52.34,Layzner,,0,0,0,,虽是地球人 但是个优秀的人
Dialogue: 0,0:11:53.70,0:11:54.86,Layzner,,0,0,0,,今后
Dialogue: 0,0:11:55.34,0:11:57.98,Layzner,,0,0,0,,只要是优秀的人 就算是地球人
Dialogue: 0,0:11:58.50,0:11:59.94,Layzner,,0,0,0,,我都会无条件重用
Dialogue: 0,0:12:02.14,0:12:07.06,Layzner,,0,0,0,,我认为这样才能开始建立理想的国家
Dialogue: 0,0:12:22.38,0:12:24.46,Layzner,,0,0,0,,罗安·德米特里希 上前一步
Dialogue: 0,0:12:24.58,0:12:25.06,Layzner,,0,0,0,,是
Dialogue: 0,0:12:32.98,0:12:33.38,Layzner,,0,0,0,,陛下
Dialogue: 0,0:12:34.02,0:12:36.22,Layzner,,0,0,0,,很合身 罗安·德米特里希
Dialogue: 0,0:12:39.82,0:12:40.38,Layzner,,0,0,0,,罗安
Dialogue: 0,0:12:45.10,0:12:46.50,Layzner,,0,0,0,,如你们所见 诸君
Dialogue: 0,0:12:47.94,0:12:49.10,Layzner,,0,0,0,,我的理想
Dialogue: 0,0:12:49.54,0:12:51.98,Layzner,,0,0,0,,会以这样的形式实现
Dialogue: 0,0:12:54.38,0:12:55.86,Layzner,,0,0,0,,那么 罗安·德米特里希
Dialogue: 0,0:12:56.42,0:13:00.82,Layzner,,0,0,0,,在地球是否有一种认为火可以净化一切的信仰
Dialogue: 0,0:13:02.42,0:13:03.02,Layzner,,0,0,0,,是
Dialogue: 0,0:13:04.30,0:13:06.58,Layzner,,0,0,0,,诸君 现在正是这时候
Dialogue: 0,0:13:07.26,0:13:10.70,Layzner,,0,0,0,,陈旧的东西  罪恶的东西全都要被火一起净化消灭
Dialogue: 0,0:13:11.46,0:13:15.62,Layzner,,0,0,0,,遵从陛下的希望 新都市的计划已准备就绪
Dialogue: 0,0:13:16.98,0:13:17.78,Layzner,,0,0,0,,陈旧的东西
Dialogue: 0,0:13:18.10,0:13:19.10,Layzner,,0,0,0,,罪恶的东西
Dialogue: 0,0:13:19.66,0:13:24.94,Layzner,,0,0,0,,为了新的理想的诞生 接受火的洗礼吧
Dialogue: 0,0:13:58.06,0:13:59.90,Layzner,,0,0,0,,地球文化的彻底破坏
Dialogue: 0,0:14:01.02,0:14:05.66,Layzner,,0,0,0,,以建立古拉特斯人和地球人的理想国家为目标
Dialogue: 0,0:14:06.22,0:14:08.10,Layzner,,0,0,0,,这是鲁凯恩的新政策
Dialogue: 0,0:14:09.70,0:14:11.78,Layzner,,0,0,0,,没了古雷斯库的拘束
Dialogue: 0,0:14:12.50,0:14:14.86,Layzner,,0,0,0,,鲁凯恩踏上了独裁者之路
Dialogue: 0,0:14:16.42,0:14:19.98,Layzner,,0,0,0,,因为害怕本星的干涉
Dialogue: 0,0:14:20.50,0:14:22.18,Layzner,,0,0,0,,鲁凯恩破坏了卫星站
Dialogue: 0,0:14:22.86,0:14:26.34,Layzner,,0,0,0,,亲手断绝了和古拉特斯本星的联系
Dialogue: 0,0:14:30.70,0:14:33.10,Layzner,,0,0,0,,他太年轻了 不能任由他胡来
Dialogue: 0,0:14:33.22,0:14:36.42,Layzner,,0,0,0,,这样下去我们会变成这第三行星的孤儿
Dialogue: 0,0:14:38.26,0:14:41.78,Layzner,,0,0,0,,因为鲁凯恩的暴走而得救 我们的地下组织
Dialogue: 0,0:14:41.86,0:14:45.66,Layzner,,0,0,0,,地球制SPT的开发也进入了最终阶段
Dialogue: 0,0:14:46.62,0:14:49.86,Layzner,,0,0,0,,可是 这时发生了意想不到的事
Dialogue: 0,0:14:50.98,0:14:54.70,Layzner,,0,0,0,,伊丽莎白博士 陷入了强烈的自我矛盾中
Dialogue: 0,0:14:58.62,0:15:02.06,Layzner,,0,0,0,,众所周知的和平主义者的伊丽莎白博士
Dialogue: 0,0:15:02.82,0:15:04.78,Layzner,,0,0,0,,本意是为了解救地球人
Dialogue: 0,0:15:05.62,0:15:08.62,Layzner,,0,0,0,,现在却为制造出了兵器而烦恼
Dialogue: 0,0:15:09.62,0:15:13.22,Layzner,,0,0,0,,终于到了生产线开动的那一天
Dialogue: 0,0:15:13.78,0:15:17.34,Layzner,,0,0,0,,她的心 被撕碎了
Dialogue: 0,0:15:37.02,0:15:43.18,Layzner,,0,0,0,,无法接受理想和现实的反差呢
Dialogue: 0,0:15:46.70,0:15:50.22,Layzner,,0,0,0,,我是我觉得博士的心很正常
Dialogue: 0,0:15:50.98,0:15:53.46,Layzner,,0,0,0,,也许是我们变了
Dialogue: 0,0:15:54.14,0:15:55.78,Layzner,,0,0,0,,英二 你怎么想
Dialogue: 0,0:15:57.14,0:15:57.58,Layzner,,0,0,0,,我
Dialogue: 0,0:16:01.34,0:16:03.70,Layzner,,0,0,0,,不 这样下去不行的
Dialogue: 0,0:16:06.62,0:16:08.62,Layzner,,0,0,0,,看 还是只有战斗吧
Dialogue: 0,0:16:15.34,0:16:18.82,Layzner,,0,0,0,,阻碍我实现理想的人 做好死的觉悟吧
Dialogue: 0,0:16:23.78,0:16:34.50,Layzner,,0,0,0,,因为那帮没理想的蠢材的挑拨
Dialogue: 0,0:16:35.22,0:16:40.34,Layzner,,0,0,0,,本星派出了新司令官乘坐的舰队正向地球出发
Dialogue: 0,0:16:41.90,0:16:44.14,Layzner,,0,0,0,,由优秀的人进行优秀的领导
Dialogue: 0,0:16:45.30,0:16:47.18,Layzner,,0,0,0,,还有人们对领导的服从
Dialogue: 0,0:16:48.10,0:16:50.70,Layzner,,0,0,0,,我的理想国家的建设
Dialogue: 0,0:16:51.30,0:16:53.54,Layzner,,0,0,0,,可能就这样像梦一样结束
Dialogue: 0,0:16:57.38,0:16:59.22,Layzner,,0,0,0,,不是吗 玖丽亚
Dialogue: 0,0:17:03.66,0:17:05.34,Layzner,,0,0,0,,杀死玖丽亚
Dialogue: 0,0:17:18.10,0:17:19.82,Layzner,,0,0,0,,支配就是力量
Dialogue: 0,0:17:20.62,0:17:22.58,Layzner,,0,0,0,,压倒他人的力量
Dialogue: 0,0:17:23.78,0:17:26.18,Layzner,,0,0,0,,力量便是罪恶
Dialogue: 0,0:17:26.30,0:17:27.02,Layzner,,0,0,0,,父亲
Dialogue: 0,0:17:36.34,0:17:38.18,Layzner,,0,0,0,,父亲 是你不对
Dialogue: 0,0:17:40.34,0:17:41.30,Layzner,,0,0,0,,自我年幼
Dialogue: 0,0:17:41.66,0:17:45.58,Layzner,,0,0,0,,一直叫我要以身为古拉特斯人为荣的是父亲
Dialogue: 0,0:17:46.26,0:17:47.02,Layzner,,0,0,0,,是你
Dialogue: 0,0:17:48.90,0:17:51.98,Layzner,,0,0,0,,难道不是你吗
Dialogue: 0,0:17:52.54,0:17:58.82,Layzner,,0,0,0,,我死的真相 要保密
Dialogue: 0,0:18:03.34,0:18:05.02,Layzner,,0,0,0,,玖丽亚 祈祷吧
Dialogue: 0,0:18:07.38,0:18:09.02,Layzner,,0,0,0,,为父亲祈祷吧
Dialogue: 0,0:18:09.54,0:18:10.46,Layzner,,0,0,0,,鲁凯恩大人
Dialogue: 0,0:18:11.46,0:18:13.78,Layzner,,0,0,0,,祈祷 祈祷啊
Dialogue: 0,0:18:14.30,0:18:15.30,Layzner,,0,0,0,,祈祷啊
Dialogue: 0,0:18:16.94,0:18:19.34,Layzner,,0,0,0,,玖丽亚 祈祷啊
Dialogue: 0,0:18:21.10,0:18:22.86,Layzner,,0,0,0,,为我父亲祈祷
Dialogue: 0,0:18:27.26,0:18:29.98,Layzner,,0,0,0,,如果你是圣女的话 就为父亲
Dialogue: 0,0:18:34.78,0:18:36.42,Layzner,,0,0,0,,还有我
Dialogue: 0,0:18:37.54,0:18:38.30,Layzner,,0,0,0,,祈祷吧
Dialogue: 0,0:18:40.66,0:18:42.86,Layzner,,0,0,0,,为了使更优秀的人得到保护
Dialogue: 0,0:18:48.30,0:18:49.38,Layzner,,0,0,0,,我的父亲
Dialogue: 0,0:18:49.98,0:18:52.26,Layzner,,0,0,0,,为了那个到了天国的可怜那人
Dialogue: 0,0:18:54.02,0:18:54.94,Layzner,,0,0,0,,祈祷吧
Dialogue: 0,0:19:07.34,0:19:11.02,Layzner,,0,0,0,,亚瑟 你带我来这地方到底有什么事
Dialogue: 0,0:19:14.54,0:19:15.10,Layzner,,0,0,0,,亚瑟
Dialogue: 0,0:19:16.18,0:19:18.74,Layzner,,0,0,0,,亚瑟 没事的话我走了
Dialogue: 0,0:19:20.14,0:19:20.94,Layzner,,0,0,0,,我很忙的
Dialogue: 0,0:19:21.54,0:19:22.22,Layzner,,0,0,0,,等等 罗安
Dialogue: 0,0:19:26.54,0:19:28.54,Layzner,,0,0,0,,今天要听你的真心话
Dialogue: 0,0:19:29.02,0:19:29.66,Layzner,,0,0,0,,真心话
Dialogue: 0,0:19:30.98,0:19:32.58,Layzner,,0,0,0,,那是什么意思 亚瑟
Dialogue: 0,0:19:33.74,0:19:34.74,Layzner,,0,0,0,,很痛苦吧
Dialogue: 0,0:19:35.38,0:19:35.86,Layzner,,0,0,0,,痛苦
Dialogue: 0,0:19:36.90,0:19:39.78,Layzner,,0,0,0,,你装作听从鲁凯恩
Dialogue: 0,0:19:40.14,0:19:40.86,Layzner,,0,0,0,,等待时机
Dialogue: 0,0:19:43.58,0:19:46.62,Layzner,,0,0,0,,你可以对我说出你的苦恼
Dialogue: 0,0:19:46.78,0:19:48.22,Layzner,,0,0,0,,怎么一回事 亚瑟
Dialogue: 0,0:19:48.98,0:19:51.10,Layzner,,0,0,0,,就算是你 乱说话也会招惹是非
Dialogue: 0,0:19:51.70,0:19:53.30,Layzner,,0,0,0,,你知道我的立场吧
Dialogue: 0,0:19:53.86,0:19:55.54,Layzner,,0,0,0,,那么罗安 你真的
Dialogue: 0,0:20:00.62,0:20:04.18,Layzner,,0,0,0,,又来了 罗安 别演戏了
Dialogue: 0,0:20:04.58,0:20:08.10,Layzner,,0,0,0,,说说真心话啊 你其实是地球军的间谍吧
Dialogue: 0,0:20:09.66,0:20:10.66,Layzner,,0,0,0,,我是明白的
Dialogue: 0,0:20:11.46,0:20:13.26,Layzner,,0,0,0,,很辛苦吧 所以
Dialogue: 0,0:20:13.66,0:20:15.50,Layzner,,0,0,0,,对我可以敞开心扉啊
Dialogue: 0,0:20:15.82,0:20:17.62,Layzner,,0,0,0,,重要的事是指这件事吗
Dialogue: 0,0:20:18.18,0:20:19.18,Layzner,,0,0,0,,是的
Dialogue: 0,0:20:19.34,0:20:21.66,Layzner,,0,0,0,,亚瑟 你真是天真
Dialogue: 0,0:20:22.02,0:20:26.02,Layzner,,0,0,0,,我忠告你 想长命的话便对古雷特斯忠心
Dialogue: 0,0:20:26.14,0:20:27.02,Layzner,,0,0,0,,什么
Dialogue: 0,0:20:28.06,0:20:32.06,Layzner,,0,0,0,,不 又来了 你真是小心
Dialogue: 0,0:20:32.34,0:20:33.74,Layzner,,0,0,0,,你真是个笨蛋
Dialogue: 0,0:20:35.82,0:20:37.06,Layzner,,0,0,0,,话就是这些吗
Dialogue: 0,0:20:38.14,0:20:41.42,Layzner,,0,0,0,,看在以往的份上 这次的事我就当没听过
Dialogue: 0,0:20:47.14,0:20:49.26,Layzner,,0,0,0,,等等 罗安 我看错你了
Dialogue: 0,0:20:49.58,0:20:51.38,Layzner,,0,0,0,,竟要这样出卖自己给古拉特斯吗
Dialogue: 0,0:20:51.78,0:20:54.26,Layzner,,0,0,0,,想和鲁凯恩一起支配这星球吗
Dialogue: 0,0:20:54.82,0:20:55.86,Layzner,,0,0,0,,背叛者
Dialogue: 0,0:20:56.66,0:20:57.98,Layzner,,0,0,0,,人类是脆弱的
Dialogue: 0,0:20:58.62,0:21:02.26,Layzner,,0,0,0,,就算是敌人 但能得到对方的看重
Dialogue: 0,0:21:02.62,0:21:03.54,Layzner,,0,0,0,,骗人 罗安
Dialogue: 0,0:21:04.18,0:21:07.58,Layzner,,0,0,0,,不是被看重 是因为害怕被司令官识破吧
Dialogue: 0,0:21:07.74,0:21:08.94,Layzner,,0,0,0,,所以你就说出来啊
Dialogue: 0,0:21:09.06,0:21:10.98,Layzner,,0,0,0,,你看得到现实吧
Dialogue: 0,0:21:11.50,0:21:15.02,Layzner,,0,0,0,,果然只有优秀的人 才能活到最后
Dialogue: 0,0:21:15.90,0:21:19.74,Layzner,,0,0,0,,因为这身制服 你得到了多少好处
Dialogue: 0,0:21:19.74,0:21:21.26,Layzner,,0,0,0,,自己想想吧
Dialogue: 0,0:21:21.82,0:21:23.34,Layzner,,0,0,0,,可是
Dialogue: 0,0:21:24.30,0:21:26.46,Layzner,,0,0,0,,罗安 我相信你的
Dialogue: 0,0:21:26.58,0:21:28.26,Layzner,,0,0,0,,相信你
Dialogue: 0,0:21:42.42,0:21:43.22,Layzner,,0,0,0,,去哪里
Dialogue: 0,0:21:43.82,0:21:45.22,Layzner,,0,0,0,,看来分别的时候到了
Dialogue: 0,0:21:45.82,0:21:47.26,Layzner,,0,0,0,,我一定要回去
Dialogue: 0,0:21:52.74,0:21:55.42,Layzner,,0,0,0,,等待 你是我的人质
Dialogue: 0,0:21:55.86,0:21:57.18,Layzner,,0,0,0,,不能让你胡来
Dialogue: 0,0:21:57.70,0:21:59.22,Layzner,,0,0,0,,请随便
Dialogue: 0,0:21:59.66,0:22:01.78,Layzner,,0,0,0,,你以为可以平安离开这个房间吗
Dialogue: 0,0:22:02.30,0:22:02.30,Layzner,,0,0,0,,鲁凯恩大人 一切随你心意
Dialogue: 0,0:22:05.34,0:22:06.22,Layzner,,0,0,0,,等等 玖丽亚
Dialogue: 0,0:22:26.42,0:22:27.22,Layzner,,0,0,0,,司令官陛下
Dialogue: 0,0:22:27.62,0:22:29.82,Layzner,,0,0,0,,收到库斯科圣女逃走的联络
Dialogue: 0,0:22:30.46,0:22:31.90,Layzner,,0,0,0,,让她去吧
Dialogue: 0,0:22:48.22,0:22:53.78,Layzner,,0,0,0,,没用的 都是没用的 做出这些兵器有什么用
Dialogue: 0,0:22:54.12,0:22:54.98,Layzner,,0,0,0,,请住手
Dialogue: 0,0:22:56.82,0:22:58.38,Layzner,,0,0,0,,我再也不要了
Dialogue: 0,0:22:58.82,0:23:00.54,Layzner,,0,0,0,,为何一定要互相厮杀
Dialogue: 0,0:23:04.26,0:23:06.02,Layzner,,0,0,0,,住手 伊丽莎白博士 住手
Dialogue: 0,0:23:06.02,0:23:08.94,Layzner,,0,0,0,,无论这么做也赢不了古拉特斯的
Dialogue: 0,0:23:09.10,0:23:10.14,Layzner,,0,0,0,,停手
Dialogue: 0,0:23:10.14,0:23:12.34,Layzner,,0,0,0,,放开我 放开我 大卫
Dialogue: 0,0:23:12.34,0:23:13.10,Layzner,,0,0,0,,博士
Dialogue: 0,0:23:13.46,0:23:14.22,Layzner,,0,0,0,,还给我
Dialogue: 0,0:23:15.46,0:23:16.22,Layzner,,0,0,0,,振作啊
Dialogue: 0,0:23:16.22,0:23:18.66,Layzner,,0,0,0,,让我毁了它 让我毁了它
Dialogue: 0,0:23:19.10,0:23:22.06,Layzner,,0,0,0,,求求你 大卫 无论怎样做
Dialogue: 0,0:23:22.22,0:23:24.90,Layzner,,0,0,0,,无论怎样做也没用的
Dialogue: 0,0:23:36.10,0:23:37.98,Layzner,,0,0,0,,现在已经不能停止
Dialogue: 0,0:23:38.50,0:23:40.38,Layzner,,0,0,0,,就算知道不会成为战力
Dialogue: 0,0:23:41.14,0:23:44.14,Layzner,,0,0,0,,也会成为地球人的尊严之战
Dialogue: 0,0:23:47.14,0:23:49.14,Layzner,,0,0,0,,光荣和骄傲有何区别
Dialogue: 0,0:23:49.86,0:23:53.02,Layzner,,0,0,0,,以前在这地球上 理想的对立
Dialogue: 0,0:23:53.14,0:23:54.70,Layzner,,0,0,0,,被称为大国的光荣
Dialogue: 0,0:23:55.34,0:23:59.10,Layzner,,0,0,0,,我们不是在为自己的利益而战
Dialogue: 0,0:23:59.42,0:24:02.46,Layzner,,0,0,0,,地球正在被侵略被占领被支配啊
Dialogue: 0,0:24:02.62,0:24:04.70,Layzner,,0,0,0,,可是任何战斗都会夺人性命
Dialogue: 0,0:24:05.26,0:24:10.06,Layzner,,0,0,0,,明知会败北 互相夺取性命有意义吗
Dialogue: 0,0:24:10.22,0:24:14.34,Layzner,,0,0,0,,人类以外 任何动物都不会做这种无意义的事
Dialogue: 0,0:24:14.66,0:24:17.42,Layzner,,0,0,0,,我们不是动物 我们有心
Dialogue: 0,0:24:17.54,0:24:19.38,Layzner,,0,0,0,,分辨黑白的心
Dialogue: 0,0:24:19.78,0:24:21.30,Layzner,,0,0,0,,不是黑和白
Dialogue: 0,0:24:21.54,0:24:23.50,Layzner,,0,0,0,,就是说古拉特斯和地球
Dialogue: 0,0:24:23.62,0:24:26.70,Layzner,,0,0,0,,不互相残杀 就没有其他办法吗
Dialogue: 0,0:24:30.00,0:24:30.66,Layzner,,0,0,0,,妈的
Dialogue: 0,0:24:53.42,0:24:54.82,Layzner,,0,0,0,,怎么了 英二
Dialogue: 0,0:24:55.26,0:24:56.66,Layzner,,0,0,0,,大家的意见出来了吗
Dialogue: 0,0:24:57.90,0:25:01.30,Layzner,,0,0,0,,只是明白了战斗的无意义 姐姐
Dialogue: 0,0:25:01.50,0:25:02.02,Layzner,,0,0,0,,是吗
Dialogue: 0,0:25:05.14,0:25:06.50,Layzner,,0,0,0,,英二 去吧
Dialogue: 0,0:25:07.30,0:25:10.46,Layzner,,0,0,0,,库斯科 带我去那里吧
Dialogue: 0,0:25:12.26,0:25:14.18,Layzner,,0,0,0,,制止贪心的人的力量
Dialogue: 0,0:25:14.54,0:25:17.10,Layzner,,0,0,0,,借助先人们的伟大智慧
Dialogue: 0,0:25:30.82,0:25:30.86,Layzner,,0,0,0,,发现正体不明的机影
Dialogue: 0,0:25:30.98,0:25:34.02,Layzner,,0,0,0,,突破了纽约的警戒网 正向西南飞行中
Dialogue: 0,0:25:34.14,0:25:35.30,Layzner,,0,0,0,,赶快分析不明机影
Dialogue: 0,0:25:35.30,0:25:36.46,Layzner,,0,0,0,,现在分析中
Dialogue: 0,0:25:36.82,0:25:38.42,Layzner,,0,0,0,,还发现了不明机体群
Dialogue: 0,0:25:38.74,0:25:41.82,Layzner,,0,0,0,,行进方向应该是跟在刚才的机影后面
Dialogue: 0,0:25:43.26,0:25:46.70,Layzner,,0,0,0,,分析完成 不明机认定是地球制SPT
Dialogue: 0,0:25:48.94,0:25:49.74,Layzner,,0,0,0,,玖丽亚吗
Dialogue: 0,0:25:50.34,0:25:52.22,Layzner,,0,0,0,,终于有所行动了
Dialogue: 0,0:25:55.78,0:25:57.98,Layzner,,0,0,0,,英二 听到了吗 英二
Dialogue: 0,0:25:58.42,0:25:59.26,Layzner,,0,0,0,,回答我
Dialogue: 0,0:26:00.02,0:26:01.34,Layzner,,0,0,0,,说清楚吧
Dialogue: 0,0:26:01.94,0:26:04.10,Layzner,,0,0,0,,到底打算去哪里 做什么
Dialogue: 0,0:26:04.82,0:26:08.54,Layzner,,0,0,0,,英二 让我向大家说明吧
Dialogue: 0,0:26:12.02,0:26:15.26,Layzner,,0,0,0,,那是难以置信的故事
Dialogue: 0,0:26:16.70,0:26:19.38,Layzner,,0,0,0,,大约距四万年前
Dialogue: 0,0:26:20.06,0:26:23.78,Layzner,,0,0,0,,古拉特斯人失去了生命之种的活力
Dialogue: 0,0:26:24.10,0:26:26.26,Layzner,,0,0,0,,受到灭亡的威胁
Dialogue: 0,0:26:28.14,0:26:30.50,Layzner,,0,0,0,,于是 古拉特斯的指导者们
Dialogue: 0,0:26:30.98,0:26:32.90,Layzner,,0,0,0,,为了寻找掌握着古拉特斯再生的关键
Dialogue: 0,0:26:33.38,0:26:35.90,Layzner,,0,0,0,,更加强壮的同类生命体
Dialogue: 0,0:26:36.50,0:26:38.86,Layzner,,0,0,0,,派出了探索队到宇宙
Dialogue: 0,0:27:09.26,0:27:09.86,Layzner,,0,0,0,,之后
Dialogue: 0,0:27:10.42,0:27:11.78,Layzner,,0,0,0,,其中一艘
Dialogue: 0,0:27:12.26,0:27:14.22,Layzner,,0,0,0,,在太阳系第三行星
Dialogue: 0,0:27:14.78,0:27:17.86,Layzner,,0,0,0,,发现了在寻找的同类生命体
Dialogue: 0,0:27:28.46,0:27:31.18,Layzner,,0,0,0,,那就是我们的祖先
Dialogue: 0,0:27:31.66,0:27:32.50,Layzner,,0,0,0,,地球人
Dialogue: 0,0:27:33.70,0:27:35.46,Layzner,,0,0,0,,古拉特斯星人的计划
Dialogue: 0,0:27:35.98,0:27:37.26,Layzner,,0,0,0,,是从我们的祖先
Dialogue: 0,0:27:37.62,0:27:39.74,Layzner,,0,0,0,,采取他们的生命核
Dialogue: 0,0:27:40.82,0:27:43.30,Layzner,,0,0,0,,把它移植到自己的生命核
Dialogue: 0,0:27:43.78,0:27:45.74,Layzner,,0,0,0,,得到新的生命
Dialogue: 0,0:27:51.70,0:27:53.62,Layzner,,0,0,0,,完成生命核的采集后
Dialogue: 0,0:27:54.22,0:27:56.66,Layzner,,0,0,0,,四万年前的有智慧来访者
Dialogue: 0,0:27:57.30,0:28:00.66,Layzner,,0,0,0,,为了防止这两大种族在遥远的未来
Dialogue: 0,0:28:01.06,0:28:04.62,Layzner,,0,0,0,,成长期相遇的危险
Dialogue: 0,0:28:05.34,0:28:07.34,Layzner,,0,0,0,,留下了安全装置
Dialogue: 0,0:28:08.22,0:28:12.02,Layzner,,0,0,0,,那即是在库斯科遗迹的岩石之中
Dialogue: 0,0:28:13.26,0:28:17.30,Layzner,,0,0,0,,英二的姐姐叫它做古拉特斯的刻印
Dialogue: 0,0:28:23.18,0:28:27.70,Layzner,,0,0,0,,我到现在为止仍然认为人与人尽量相互理解
Dialogue: 0,0:28:27.86,0:28:29.94,Layzner,,0,0,0,,才是最好的方法
Dialogue: 0,0:28:30.70,0:28:35.02,Layzner,,0,0,0,,如果可以的话 我不想使用这古拉特斯的刻印
Dialogue: 0,0:28:36.58,0:28:41.34,Layzner,,0,0,0,,我已经下了决心遵从先人的指示
Dialogue: 0,0:28:41.62,0:28:43.90,Layzner,,0,0,0,,为了不再让古拉特斯人无谓流血
Dialogue: 0,0:28:44.50,0:28:47.94,Layzner,,0,0,0,,为了不再让地球人做绝望的战斗
Dialogue: 0,0:28:54.00,0:28:55.10,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:28:58.06,0:29:00.94,Layzner,,0,0,0,,请在我准备好前保护这里
Dialogue: 0,0:29:20.46,0:29:21.30,Layzner,,0,0,0,,真冷呢
Dialogue: 0,0:29:35.66,0:29:36.66,Layzner,,0,0,0,,那两人
Dialogue: 0,0:30:09.50,0:30:10.02,Layzner,,0,0,0,,安娜
Dialogue: 0,0:31:20.66,0:31:22.54,Layzner,,0,0,0,,敌人SPT接近三号范围
Dialogue: 0,0:31:22.54,0:31:24.78,Layzner,,0,0,0,,MF-GS-54C 钢斯迪多
Dialogue: 0,0:31:24.78,0:31:26.66,Layzner,,0,0,0,,搭载武器 飞弹发射器4门
Dialogue: 0,0:31:26.66,0:31:29.34,Layzner,,0,0,0,,火焰喷射器1门 脚步导弹发射器2门
Dialogue: 0,0:31:29.38,0:31:31.34,Layzner,,0,0,0,,敌人SPT进入一号范围
Dialogue: 0,0:31:31.50,0:31:32.06,Layzner,,0,0,0,,来了
Dialogue: 0,0:31:58.62,0:32:02.10,Layzner,,0,0,0,,警告讯息 后方17地点有SPT接近
Dialogue: 0,0:32:02.14,0:32:03.22,Layzner,,0,0,0,,热源反应
Dialogue: 0,0:32:18.82,0:32:20.30,Layzner,,0,0,0,,大卫 这里交给我
Dialogue: 0,0:32:20.42,0:32:21.82,Layzner,,0,0,0,,拜托了 去吧 西蒙妮
Dialogue: 0,0:32:21.98,0:32:22.70,Layzner,,0,0,0,,OK
Dialogue: 0,0:32:44.02,0:32:45.26,Layzner,,0,0,0,,混蛋
Dialogue: 0,0:33:07.46,0:33:10.50,Layzner,,0,0,0,,怎可以输给古拉特斯的铁皮人偶
Dialogue: 0,0:33:29.38,0:33:30.82,Layzner,,0,0,0,,不可原谅
Dialogue: 0,0:33:35.30,0:33:36.06,Layzner,,0,0,0,,畜牲
Dialogue: 0,0:33:56.14,0:33:57.88,Layzner,,0,0,0,,大卫 上面的交给我
Dialogue: 0,0:33:57.90,0:33:58.74,Layzner,,0,0,0,,英二
Dialogue: 0,0:34:28.70,0:34:32.06,Layzner,,0,0,0,,1999年12月31日
Dialogue: 0,0:34:32.82,0:34:35.38,Layzner,,0,0,0,,被古拉特斯军压倒性军力牵制的解放前线
Dialogue: 0,0:34:35.90,0:34:38.54,Layzner,,0,0,0,,后退到刻印的所在地 库斯科遗迹
Dialogue: 0,0:34:38.90,0:34:41.38,Layzner,,0,0,0,,迎接最后的对决
Dialogue: 0,0:34:53.02,0:34:54.58,Layzner,,0,0,0,,第一阶段作战完成
Dialogue: 0,0:34:54.58,0:34:57.18,Layzner,,0,0,0,,遗迹附近的反乱组织完全被包围了
Dialogue: 0,0:34:57.58,0:34:58.78,Layzner,,0,0,0,,请指示下一步
Dialogue: 0,0:35:02.02,0:35:04.30,Layzner,,0,0,0,,这场战斗我刚才看到了
Dialogue: 0,0:35:04.98,0:35:09.02,Layzner,,0,0,0,,各部队下一个指示之前停止攻击 采取守势
Dialogue: 0,0:35:09.38,0:35:12.26,Layzner,,0,0,0,,α区所罗姆科队后退到第三线
Dialogue: 0,0:35:12.70,0:35:17.18,Layzner,,0,0,0,,β区刚斯迪多队目标为中心后退到2号范围防卫线
Dialogue: 0,0:35:17.54,0:35:19.14,Layzner,,0,0,0,,以第一战斗配置等候命令
Dialogue: 0,0:35:19.46,0:35:20.62,Layzner,,0,0,0,,罗安·德米特里希
Dialogue: 0,0:35:20.78,0:35:21.18,Layzner,,0,0,0,,是
Dialogue: 0,0:35:21.66,0:35:23.02,Layzner,,0,0,0,,后面的事交给你
Dialogue: 0,0:35:23.78,0:35:26.42,Layzner,,0,0,0,,我去休息等你好消息
Dialogue: 0,0:35:29.02,0:35:30.78,Layzner,,0,0,0,,怎么了 罗安·德米特里希
Dialogue: 0,0:35:32.54,0:35:34.62,Layzner,,0,0,0,,在那里可不能指挥作战
Dialogue: 0,0:35:35.06,0:35:37.14,Layzner,,0,0,0,,指挥官的座位在那边
Dialogue: 0,0:35:42.62,0:35:43.22,Layzner,,0,0,0,,陛下
Dialogue: 0,0:35:43.94,0:35:46.46,Layzner,,0,0,0,,被挑选的人是不用犹豫的
Dialogue: 0,0:35:47.26,0:35:49.58,Layzner,,0,0,0,,只要不负我望便可以了
Dialogue: 0,0:36:10.38,0:36:11.06,Layzner,,0,0,0,,罗安
Dialogue: 0,0:36:20.98,0:36:23.18,Layzner,,0,0,0,,英二 这装扮是什么意思
Dialogue: 0,0:36:24.74,0:36:28.10,Layzner,,0,0,0,,为了护卫古拉特斯的刻印 我要去宇宙
Dialogue: 0,0:36:28.26,0:36:28.74,Layzner,,0,0,0,,宇宙
Dialogue: 0,0:36:29.34,0:36:31.78,Layzner,,0,0,0,,你会回来的吧 英二
Dialogue: 0,0:37:05.42,0:37:06.50,Layzner,,0,0,0,,英二
Dialogue: 0,0:37:43.58,0:37:44.02,Layzner,,0,0,0,,那是
Dialogue: 0,0:37:55.86,0:37:58.82,Layzner,,0,0,0,,敌人根据地有不明物体上升中
Dialogue: 0,0:37:58.98,0:38:01.34,Layzner,,0,0,0,,推定为预想的最大目标
Dialogue: 0,0:38:01.74,0:38:03.22,Layzner,,0,0,0,,请求批准总攻击
Dialogue: 0,0:38:03.58,0:38:05.50,Layzner,,0,0,0,,飞行物体中还有雷兹纳随行
Dialogue: 0,0:38:05.70,0:38:09.02,Layzner,,0,0,0,,这点证明是最大攻击目标不会错
Dialogue: 0,0:38:09.18,0:38:10.74,Layzner,,0,0,0,,攻击目标速度增加
Dialogue: 0,0:38:11.06,0:38:12.22,Layzner,,0,0,0,,请求攻击许可
Dialogue: 0,0:38:12.38,0:38:17.26,Layzner,,0,0,0,,飞行物体上升速度到达33%的光速 马上就突破大气圈了
Dialogue: 0,0:38:26.54,0:38:27.90,Layzner,,0,0,0,,司令部
Dialogue: 0,0:38:28.14,0:38:29.78,Layzner,,0,0,0,,请批准总攻击
Dialogue: 0,0:38:31.62,0:38:33.78,Layzner,,0,0,0,,司令 请下攻击命令
Dialogue: 0,0:38:34.58,0:38:35.30,Layzner,,0,0,0,,司令
Dialogue: 0,0:38:36.82,0:38:40.06,Layzner,,0,0,0,,错过机会的话 目标有逃脱的可能
Dialogue: 0,0:38:42.34,0:38:43.18,Layzner,,0,0,0,,司令
Dialogue: 0,0:38:49.30,0:38:51.66,Layzner,,0,0,0,,向全军发出撤退命令
Dialogue: 0,0:38:53.62,0:38:54.50,Layzner,,0,0,0,,是
Dialogue: 0,0:38:54.82,0:38:56.42,Layzner,,0,0,0,,你这家伙
Dialogue: 0,0:39:04.10,0:39:08.98,Layzner,,0,0,0,,听好 现在这里已经成为地球解放战线指挥部管理室
Dialogue: 0,0:39:09.98,0:39:10.98,Layzner,,0,0,0,,是那家伙
Dialogue: 0,0:39:17.98,0:39:18.86,Layzner,,0,0,0,,进攻
Dialogue: 0,0:39:56.06,0:40:00.38,Layzner,,0,0,0,,纵使杀了父亲也无法保护我的理想
Dialogue: 0,0:40:00.74,0:40:04.38,Layzner,,0,0,0,,想不到会以这样的方式被粉碎
Dialogue: 0,0:40:08.06,0:40:08.54,Layzner,,0,0,0,,陛下
Dialogue: 0,0:40:10.06,0:40:11.06,Layzner,,0,0,0,,请你明白
Dialogue: 0,0:40:11.62,0:40:12.98,Layzner,,0,0,0,,我是地球人
Dialogue: 0,0:40:35.82,0:40:37.06,Layzner,,0,0,0,,罗安·德米特里希
Dialogue: 0,0:40:37.66,0:40:39.38,Layzner,,0,0,0,,虽然没有说过
Dialogue: 0,0:40:39.54,0:40:43.10,Layzner,,0,0,0,,但我把无尽的梦想寄托在你们身上是事实
Dialogue: 0,0:40:43.62,0:40:45.30,Layzner,,0,0,0,,在我回来之前
Dialogue: 0,0:40:45.70,0:40:47.90,Layzner,,0,0,0,,暂时留下你的性命
Dialogue: 0,0:41:02.60,0:41:03.62,Layzner,,0,0,0,,罗安啊·迪米特里希
Dialogue: 0,0:41:04.08,0:41:06.02,Layzner,,0,0,0,,我一定会回来 一定
Dialogue: 0,0:41:33.10,0:41:38.02,Layzner,,0,0,0,,果然 地球人和古拉特斯人相遇得太早
Dialogue: 0,0:41:39.02,0:41:43.74,Layzner,,0,0,0,,我们人类在这庞大宇宙中还只是小孩子
Dialogue: 0,0:41:45.14,0:41:47.90,Layzner,,0,0,0,,这刻印中留下的先祖古拉特斯人的智慧中
Dialogue: 0,0:41:48.22,0:41:50.14,Layzner,,0,0,0,,我们必须要好好学习
Dialogue: 0,0:42:02.62,0:42:05.46,Layzner,,0,0,0,,离别的时候到了 英二 离开吧
Dialogue: 0,0:42:05.86,0:42:07.02,Layzner,,0,0,0,,你在说什么 姐姐
Dialogue: 0,0:42:07.46,0:42:08.26,Layzner,,0,0,0,,快出来
Dialogue: 0,0:42:08.26,0:42:12.02,Layzner,,0,0,0,,情报讯息 SPT一机在1号范围确认
Dialogue: 0,0:42:12.02,0:42:14.34,Layzner,,0,0,0,,接近2号范围 侵入一号范围
Dialogue: 0,0:42:21.34,0:42:22.02,Layzner,,0,0,0,,鲁凯恩
Dialogue: 0,0:42:25.70,0:42:28.54,Layzner,,0,0,0,,英二 玖丽亚在里面吧
Dialogue: 0,0:42:28.62,0:42:29.58,Layzner,,0,0,0,,是又怎样
Dialogue: 0,0:42:30.34,0:42:32.22,Layzner,,0,0,0,,我不会让你碰姐姐一根手指的
Dialogue: 0,0:42:32.78,0:42:34.10,Layzner,,0,0,0,,你有什么企图
Dialogue: 0,0:42:34.62,0:42:35.78,Layzner,,0,0,0,,打算做什么
Dialogue: 0,0:42:35.94,0:42:37.78,Layzner,,0,0,0,,没必要告诉你
Dialogue: 0,0:42:37.90,0:42:39.66,Layzner,,0,0,0,,那便用拳头来决定吧
Dialogue: 0,0:42:39.94,0:42:43.18,Layzner,,0,0,0,,你打败我的话 一切便如你所愿
Dialogue: 0,0:42:45.50,0:42:46.02,Layzner,,0,0,0,,决一胜负吧
Dialogue: 0,0:42:52.00,0:42:53.82,Layzner,,0,0,0,,雷 V-MAX发动
Dialogue: 0,0:42:53.86,0:42:54.46,Layzner,,0,0,0,,Ready
Dialogue: 0,0:43:54.34,0:43:56.82,Layzner,,0,0,0,,回答我 英二 你想干什么
Dialogue: 0,0:44:20.18,0:44:20.90,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:44:21.86,0:44:22.50,Layzner,,0,0,0,,玖丽亚
Dialogue: 0,0:44:23.38,0:44:24.90,Layzner,,0,0,0,,那么 这里是
Dialogue: 0,0:44:25.62,0:44:26.78,Layzner,,0,0,0,,刻印之中
Dialogue: 0,0:44:27.46,0:44:28.98,Layzner,,0,0,0,,你想做什么
Dialogue: 0,0:44:29.86,0:44:32.18,Layzner,,0,0,0,,停止这愚蠢的战斗
Dialogue: 0,0:44:32.64,0:44:34.02,Layzner,,0,0,0,,说什么疯话
Dialogue: 0,0:44:34.54,0:44:36.70,Layzner,,0,0,0,,鲁凯恩 不许对姐姐出手
Dialogue: 0,0:44:37.10,0:44:38.30,Layzner,,0,0,0,,不然别怪我不客气
Dialogue: 0,0:44:38.90,0:44:40.58,Layzner,,0,0,0,,英二 不必担心
Dialogue: 0,0:44:40.94,0:44:43.30,Layzner,,0,0,0,,这里任何人也不能动武
Dialogue: 0,0:44:44.66,0:44:46.34,Layzner,,0,0,0,,就算是鲁凯恩大人
Dialogue: 0,0:44:47.30,0:44:50.74,Layzner,,0,0,0,,移动这个的话 古拉特斯星和地球间的空间会扭曲
Dialogue: 0,0:44:50.86,0:44:51.74,Layzner,,0,0,0,,而被封锁
Dialogue: 0,0:44:52.30,0:44:53.22,Layzner,,0,0,0,,什么
Dialogue: 0,0:44:53.98,0:44:56.98,Layzner,,0,0,0,,是 如果想不流血结束战争
Dialogue: 0,0:44:57.34,0:44:58.70,Layzner,,0,0,0,,只有这方法
Dialogue: 0,0:44:59.30,0:45:00.22,Layzner,,0,0,0,,住手 玖丽亚
Dialogue: 0,0:45:00.54,0:45:01.82,Layzner,,0,0,0,,不可以发动
Dialogue: 0,0:45:01.98,0:45:01.98,Layzner,,0,0,0,,停手 这是我的命令
Dialogue: 0,0:45:04.50,0:45:07.90,Layzner,,0,0,0,,不 鲁凯恩大人 正如你所说
Dialogue: 0,0:45:07.90,0:45:10.10,Layzner,,0,0,0,,我只是遵循优秀的人的指示
Dialogue: 0,0:45:10.26,0:45:12.06,Layzner,,0,0,0,,这世上真正优秀的人
Dialogue: 0,0:45:12.14,0:45:15.14,Layzner,,0,0,0,,玖丽亚 不听我命令的话我就开枪
Dialogue: 0,0:45:15.26,0:45:18.10,Layzner,,0,0,0,,就算杀了你 我也要破坏这刻印
Dialogue: 0,0:45:18.30,0:45:20.62,Layzner,,0,0,0,,在那之前我会打倒你
Dialogue: 0,0:45:20.98,0:45:22.86,Layzner,,0,0,0,,英二 别害怕
Dialogue: 0,0:45:23.18,0:45:24.78,Layzner,,0,0,0,,他不会动手的
Dialogue: 0,0:45:25.34,0:45:27.88,Layzner,,0,0,0,,鲁凯恩大人 请随便吧
Dialogue: 0,0:45:28.54,0:45:30.50,Layzner,,0,0,0,,您只会发现自己的无能
Dialogue: 0,0:45:30.70,0:45:31.70,Layzner,,0,0,0,,说什么
Dialogue: 0,0:45:32.10,0:45:34.14,Layzner,,0,0,0,,我会照父亲的遗言杀了你
Dialogue: 0,0:45:44.00,0:45:46.46,Layzner,,0,0,0,,怎么了 怎么一回事 这是
Dialogue: 0,0:45:50.14,0:45:52.74,Layzner,,0,0,0,,这里任何武器都没有效力
Dialogue: 0,0:45:54.14,0:45:54.82,Layzner,,0,0,0,,不可能
Dialogue: 0,0:45:56.22,0:45:57.86,Layzner,,0,0,0,,这种荒谬的事情
Dialogue: 0,0:46:08.78,0:46:10.10,Layzner,,0,0,0,,怎能让你得逞
Dialogue: 0,0:46:25.46,0:46:26.14,Layzner,,0,0,0,,我不会让你妨碍我
Dialogue: 0,0:46:26.30,0:46:28.62,Layzner,,0,0,0,,我的梦想 我的理想
Dialogue: 0,0:46:29.46,0:46:30.74,Layzner,,0,0,0,,被你这家伙
Dialogue: 0,0:46:32.18,0:46:34.18,Layzner,,0,0,0,,被你这个杂种
Dialogue: 0,0:46:41.06,0:46:43.64,Layzner,,0,0,0,,我不会让你胡作非为的
Dialogue: 0,0:46:43.90,0:46:46.78,Layzner,,0,0,0,,就在这里用这双手做真正地了断吧
Dialogue: 0,0:46:47.06,0:46:47.86,Layzner,,0,0,0,,混账小子
Dialogue: 0,0:46:47.98,0:46:49.46,Layzner,,0,0,0,,请等一下 鲁凯恩大人
Dialogue: 0,0:46:50.02,0:46:51.26,Layzner,,0,0,0,,冷静点
Dialogue: 0,0:46:51.78,0:46:52.82,Layzner,,0,0,0,,那时候
Dialogue: 0,0:46:53.26,0:46:56.22,Layzner,,0,0,0,,我不该对你仁慈
Dialogue: 0,0:46:59.26,0:47:01.86,Layzner,,0,0,0,,英二 你回地球吧
Dialogue: 0,0:47:02.70,0:47:06.62,Layzner,,0,0,0,,我和鲁凯恩大人留在这里 发动刻印
Dialogue: 0,0:47:08.62,0:47:09.74,Layzner,,0,0,0,,你说什么
Dialogue: 0,0:47:10.00,0:47:11.10,Layzner,,0,0,0,,一起回地球吧
Dialogue: 0,0:47:11.62,0:47:12.38,Layzner,,0,0,0,,不
Dialogue: 0,0:47:13.26,0:47:15.18,Layzner,,0,0,0,,我不会回地球
Dialogue: 0,0:47:16.38,0:47:17.86,Layzner,,0,0,0,,宇宙被封锁的话
Dialogue: 0,0:47:18.14,0:47:19.50,Layzner,,0,0,0,,今后数百年
Dialogue: 0,0:47:20.22,0:47:21.70,Layzner,,0,0,0,,或者数千年
Dialogue: 0,0:47:22.78,0:47:25.50,Layzner,,0,0,0,,很多的古拉特斯人会失去本可以返回的故乡
Dialogue: 0,0:47:26.62,0:47:27.14,Layzner,,0,0,0,,英二
Dialogue: 0,0:47:27.94,0:47:29.62,Layzner,,0,0,0,,弄成这样的是我啊
Dialogue: 0,0:47:30.26,0:47:31.14,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:47:36.94,0:47:39.06,Layzner,,0,0,0,,今后的英二不再需要愤怒
Dialogue: 0,0:47:40.18,0:47:41.50,Layzner,,0,0,0,,张开拳头吧
Dialogue: 0,0:47:42.24,0:47:43.58,Layzner,,0,0,0,,不要战斗了
Dialogue: 0,0:47:53.46,0:47:56.26,Layzner,,0,0,0,,我不要 姐姐 一起回去吧 姐姐
Dialogue: 0,0:47:56.54,0:47:57.30,Layzner,,0,0,0,,刻印啊
Dialogue: 0,0:47:57.82,0:48:00.52,Layzner,,0,0,0,,把这生命体和那物体送出外面
Dialogue: 0,0:48:03.54,0:48:03.98,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:48:16.10,0:48:17.26,Layzner,,0,0,0,,鲁凯恩大人
Dialogue: 0,0:48:17.62,0:48:20.38,Layzner,,0,0,0,,我现在为你祈祷
Dialogue: 0,0:49:20.18,0:49:22.22,Layzner,,0,0,0,,宇宙正在发生异变
Dialogue: 0,0:49:39.06,0:49:41.06,Layzner,,0,0,0,,看来古拉特斯的刻印发动了
Dialogue: 0,0:49:41.46,0:49:43.10,Layzner,,0,0,0,,宇宙被封闭了
Dialogue: 0,0:49:43.22,0:49:45.26,Layzner,,0,0,0,,可是 终于结束了
Dialogue: 0,0:50:00.42,0:50:01.06,Layzner,,0,0,0,,英二
Dialogue: 0,0:50:03.94,0:50:04.58,Layzner,,0,0,0,,英二
Dialogue: 0,0:50:06.70,0:50:07.42,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:50:20.86,0:50:23.10,Layzner,,0,0,0,,英二 回地球吧
Dialogue: 0,0:50:24.54,0:50:28.18,Layzner,,0,0,0,,回地球 协助留下的古拉特斯人
Dialogue: 0,0:50:29.06,0:50:31.90,Layzner,,0,0,0,,只有英二你才能做到
Dialogue: 0,0:50:32.22,0:50:33.82,Layzner,,0,0,0,,古拉特斯人和地球人
Dialogue: 0,0:50:33.98,0:50:35.78,Layzner,,0,0,0,,拥有两种血统的英二
Dialogue: 0,0:50:35.90,0:50:36.82,Layzner,,0,0,0,,如果是你的话
Dialogue: 0,0:50:39.70,0:50:41.58,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:50:51.18,0:50:51.78,Layzner,,0,0,0,,地球
Dialogue: 0,0:50:55.54,0:50:57.46,Layzner,,0,0,0,,这是何等美丽的光芒
Dialogue: 0,0:50:59.66,0:51:00.14,Layzner,,0,0,0,,对了
Dialogue: 0,0:51:01.38,0:51:03.58,Layzner,,0,0,0,,我在地球有必须要做的事
Dialogue: 0,0:51:08.70,0:51:11.02,Layzner,,0,0,0,,雷 雷
Dialogue: 0,0:51:14.74,0:51:17.54,Layzner,,0,0,0,,雷 听得到吗 雷
Dialogue: 0,0:51:18.78,0:51:19.30,Layzner,,0,0,0,,雷
Dialogue: 0,0:51:20.34,0:51:20.66,Layzner,,0,0,0,,雷
Dialogue: 0,0:51:24.94,0:51:26.50,Layzner,,0,0,0,,雷 听得到吗
Dialogue: 0,0:51:27.18,0:51:28.70,Layzner,,0,0,0,,是我 英二
Dialogue: 0,0:51:29.10,0:51:29.58,Layzner,,0,0,0,,雷
Dialogue: 0,0:51:34.02,0:51:35.70,Layzner,,0,0,0,,前方位置12
Dialogue: 0,0:51:36.02,0:51:37.82,Layzner,,0,0,0,,生命反应确认
Dialogue: 0,0:52:12.70,0:52:13.34,Layzner,,0,0,0,,雷兹纳
Dialogue: 0,0:52:33.90,0:52:36.54,Layzner,,0,0,0,,目标 第三行星 地球
Dialogue: 0,0:52:36.54,0:52:36.98,Layzner,,0,0,0,,ready
Dialogue: 0,0:53:31.62,0:53:36.46,Layzner,,0,0,0,,那边 看那边 是雷兹纳
Dialogue: 0,0:53:48.10,0:53:48.94,Layzner,,0,0,0,,是雷兹纳
Dialogue: 0,0:53:49.10,0:53:50.74,Layzner,,0,0,0,,安娜 他回来了
Dialogue: 0,0:53:51.74,0:53:53.50,Layzner,,0,0,0,,英二回来了
Dialogue: 0,0:54:00.42,0:54:05.38,Layzner,,0,0,0,,英二
Dialogue: 0,0:54:12.20,0:54:16.42,Layzner,,0,0,0,,英二
Dialogue: 0,0:54:56.34,0:54:56.94,Layzner,,0,0,0,,安娜
Dialogue: 0,0:54:57.62,0:54:58.50,Layzner,,0,0,0,,英二
Dialogue: 0,0:55:13.54,0:55:14.58,Layzner,,0,0,0,,安娜
Dialogue: 0,0:55:00.29,0:55:05.30,LayznerTopMusic,,0,0,0,,dakishimete, kinou yori
Dialogue: 0,0:55:00.29,0:55:05.30,LayznerMusic,,0,0,0,,抱紧我
Dialogue: 0,0:55:05.30,0:55:10.61,LayznerTopMusic,,0,0,0,,aishitai hito tidak iru
Dialogue: 0,0:55:05.30,0:55:10.75,LayznerMusic,,0,0,0,,比昨天更爱你
Dialogue: 0,0:55:11.18,0:55:19.61,LayznerTopMusic,,0,0,0,,toki ha hitoshizuku nigai namida

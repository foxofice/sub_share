Dialogue: 0,0:00:05.01,0:00:07.94,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#7 大小姐的发型
Dialogue: 1,0:00:01.63,0:00:04.97,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:00:10.85,0:00:14.06,CN,,0,0,0,,不行 总感觉哪里不对
Dialogue: 1,0:00:14.44,0:00:16.98,CN,,0,0,0,,给 要不要试试发带
Dialogue: 1,0:00:16.98,0:00:19.61,CN,,0,0,0,,哦 谢谢 这个不错
Dialogue: 1,0:00:19.61,0:00:21.36,CN,,0,0,0,,挺上道的嘛 国神
Dialogue: 1,0:00:21.78,0:00:24.95,CN,,0,0,0,,我家里有姐姐妹妹
Dialogue: 1,0:00:24.95,0:00:26.78,CN,,0,0,0,,少女心还是懂一点的
Dialogue: 1,0:00:27.20,0:00:29.33,CN,,0,0,0,,说谁少女呢
Dialogue: 1,0:00:30.29,0:00:33.62,CN,,0,0,0,,不过 时尚不单纯是一种感觉
Dialogue: 1,0:00:33.62,0:00:36.58,CN,,0,0,0,,还关乎到能否提起干劲
Dialogue: 1,0:00:37.29,0:00:39.38,CN,,0,0,0,,挺不错的啊 新的千切
Dialogue: 1,0:00:42.01,0:00:43.05,CN,,0,0,0,,总感觉不对
Dialogue: 1,0:00:43.55,0:00:48.60,CN,,0,0,0,,那个 大小姐… 大家都在等你开会呢
Dialogue: 0,0:00:01.63,0:00:04.97,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:00:10.85,0:00:14.06,JP,,0,0,0,,駄目だ　なんか違うんだよな
Dialogue: 0,0:00:14.44,0:00:16.98,JP,,0,0,0,,ほい　ヘアバンとか使ってみっか？
Dialogue: 0,0:00:16.98,0:00:19.61,JP,,0,0,0,,おお～サンキュー　いいなそれ
Dialogue: 0,0:00:19.61,0:00:21.36,JP,,0,0,0,,気ぃきくじゃん　国神
Dialogue: 0,0:00:21.78,0:00:24.95,JP,,0,0,0,,俺んち　姉ちゃんと妹いるからな
Dialogue: 0,0:00:24.95,0:00:26.78,JP,,0,0,0,,乙女心はちょっとはわかる
Dialogue: 0,0:00:27.20,0:00:29.33,JP,,0,0,0,,だれが乙女だっつの
Dialogue: 0,0:00:30.29,0:00:33.62,JP,,0,0,0,,まぁ　でも　ファッションって気のせいだけじゃなくて
Dialogue: 0,0:00:33.62,0:00:36.58,JP,,0,0,0,,テンション上がるかどうか　大事だもんな
Dialogue: 0,0:00:37.29,0:00:39.38,JP,,0,0,0,,いいんじゃなね　ニュー千切
Dialogue: 0,0:00:42.01,0:00:43.05,JP,,0,0,0,,なんか違う
Dialogue: 0,0:00:43.55,0:00:48.60,JP,,0,0,0,,あの…お嬢様　みんなずっとミーティング待つんですが

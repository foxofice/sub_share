Dialogue: 0,0:02:01.33,0:02:03.93,DefaultSingle-T,,0,0,0,,		怎麼了  退步了嗎  風見
Dialogue: 0,0:02:04.49,0:02:07.75,DefaultSingle-T,,0,0,0,,		你再手下留情一點嘛  降谷先生
Dialogue: 0,0:02:08.28,0:02:10.83,DefaultSingle-T,,0,0,0,,		如果你擊敗手下留情的我也高興得起來
Dialogue: 0,0:02:10.83,0:02:11.70,DefaultSingle-T,,0,0,0,,		那我就這麼辦
Dialogue: 0,0:02:12.73,0:02:13.47,DefaultSingle-T,,0,0,0,,		不…
Dialogue: 0,0:02:14.27,0:02:16.52,DefaultSingle-T,,0,0,0,,		不過  非要說的話
Dialogue: 0,0:02:19.09,0:02:22.40,DefaultSingle-T,,0,0,0,,		我單手和你打也是可以的
Dialogue: 0,0:02:29.78,0:02:32.14,DefaultSingle-T,,0,0,0,,		所有人  彙報情況
Dialogue: 0,0:02:32.82,0:02:34.37,DefaultSingle-T,,0,0,0,,		這邊沒有異常
Dialogue: 0,0:02:34.73,0:02:35.51,DefaultSingle-T,,0,0,0,,		沒有異常
Dialogue: 0,0:02:36.50,0:02:39.22,DefaultSingle-T,,0,0,0,,		收到  繼續警戒
Dialogue: 0,0:02:44.58,0:02:45.47,DefaultSingle-T,,0,0,0,,		降谷先生
Dialogue: 0,0:02:48.05,0:02:48.96,DefaultSingle-T,,0,0,0,,		安室先生
Dialogue: 0,0:02:49.88,0:02:50.98,DefaultSingle-T,,0,0,0,,		要掉了哦
Dialogue: 0,0:02:52.14,0:02:53.28,DefaultSingle-T,,0,0,0,,		謝謝
Dialogue: 0,0:02:54.12,0:02:55.81,DefaultSingle-T,,0,0,0,,		安室先生  你知道嗎
Dialogue: 0,0:02:56.10,0:02:59.49,DefaultSingle-T,,0,0,0,,		香蕉是可以徒手分成兩截的
Dialogue: 0,0:02:59.66,0:03:01.04,DefaultSingle-T,,0,0,0,,		徒手嗎
Dialogue: 0,0:03:01.25,0:03:03.94,DefaultSingle-T,,0,0,0,,		像這樣往兩邊拉
Dialogue: 0,0:03:04.98,0:03:05.65,DefaultSingle-T,,0,0,0,,		你看
Dialogue: 0,0:03:06.77,0:03:07.82,DefaultSingle-T,,0,0,0,,		真有趣
Dialogue: 0,0:03:07.97,0:03:11.28,DefaultSingle-T,,0,0,0,,		太好啦  說出你不知道的事了
Dialogue: 0,0:03:11.69,0:03:13.38,DefaultSingle-T,,0,0,0,,		要不要吃一半呢
Dialogue: 0,0:03:14.76,0:03:17.35,DefaultSingle-T,,0,0,0,,		話說回來  看遊行的觀眾好多
Dialogue: 0,0:03:17.92,0:03:22.79,DefaultSingle-T,,0,0,0,,		你要去前面看看嗎  我幫你提東西
Dialogue: 0,0:03:23.24,0:03:25.54,DefaultSingle-T,,0,0,0,,		我從這裡也能看到
Dialogue: 0,0:03:25.62,0:03:27.99,DefaultSingle-T,,0,0,0,,		真的嗎  謝謝你
Dialogue: 0,0:03:28.16,0:03:30.00,DefaultSingle-T,,0,0,0,,		那我去了  馬上回來
Dialogue: 0,0:03:37.44,0:03:38.99,DefaultSingle-T,,0,0,0,,		有人搶劫
Dialogue: 0,0:03:39.70,0:03:40.41,DefaultSingle-T,,0,0,0,,		怎麼了
Dialogue: 0,0:03:41.00,0:03:41.65,DefaultSingle-T,,0,0,0,,		站住
Dialogue: 0,0:03:44.65,0:03:46.16,DefaultSingle-T,,0,0,0,,		別  別過來
Dialogue: 0,0:03:46.39,0:03:48.88,DefaultSingle-T,,0,0,0,,		不然我殺了這嬰兒
Dialogue: 0,0:03:52.28,0:03:53.95,DefaultSingle-T,,0,0,0,,		給我讓開
Dialogue: 0,0:04:02.17,0:04:04.30,DefaultSingle-T,,0,0,0,,		別擋道  滾開
Dialogue: 0,0:04:23.77,0:04:25.40,DefaultSingle-T,,0,0,0,,		您的孩子真堅強
Dialogue: 0,0:04:25.49,0:04:27.37,DefaultSingle-T,,0,0,0,,		遇到這麼可怕的事還在笑
Dialogue: 0,0:04:27.65,0:04:29.80,DefaultSingle-T,,0,0,0,,		非  非常感謝
Dialogue: 0,0:04:34.61,0:04:36.61,DefaultSingle-T,,0,0,0,,		安室先生  你沒事吧
Dialogue: 0,0:04:37.14,0:04:38.24,DefaultSingle-T,,0,0,0,,		小梓小姐
Dialogue: 0,0:04:38.89,0:04:43.32,DefaultSingle-T,,0,0,0,,		這人不知是搶劫還是綁架  犯了挺多事的
Dialogue: 0,0:04:43.79,0:04:46.45,DefaultSingle-T,,0,0,0,,		是  是你制服他的嗎
Dialogue: 0,0:04:46.88,0:04:50.48,DefaultSingle-T,,0,0,0,,		不不不  他是踩到香蕉皮滑倒了吧
Dialogue: 0,0:04:50.86,0:04:52.85,DefaultSingle-T,,0,0,0,,		不會吧  這不是漫畫的情節嗎
Dialogue: 0,0:04:53.91,0:04:56.00,DefaultSingle-T,,0,0,0,,		現行犯逮捕  重複一遍  現行犯逮捕
Dialogue: 0,0:04:56.90,0:04:58.61,DefaultSingle-T,,0,0,0,,		遊行繼續進行
Dialogue: 0,0:04:59.00,0:05:00.85,DefaultSingle-T,,0,0,0,,		繼續加強警戒
Dialogue: 0,0:05:01.78,0:05:04.10,DefaultSingle-T,,0,0,0,,		我單手和你打也是可以的
Dialogue: 0,0:05:05.36,0:05:06.46,DefaultSingle-T,,0,0,0,,		降谷先生
Dialogue: 0,0:05:07.73,0:05:10.02,DefaultSingle-T,,0,0,0,,		你這人就像漫畫角色一樣
Dialogue: 0,0:05:15.37,0:05:17.71,DefaultSingle-T,,0,0,0,,		我想給它打疫苗
Dialogue: 0,0:05:21.09,0:05:23.58,DefaultSingle-T,,0,0,0,,		請填寫問診表
Dialogue: 0,0:05:24.16,0:05:25.08,DefaultSingle-T,,0,0,0,,		名字…
Dialogue: 0,0:05:25.43,0:05:28.20,DefaultSingle-T,,0,0,0,,		小高巧克力  本田小栗
Dialogue: 0,0:05:28.36,0:05:30.05,DefaultSingle-T,,0,0,0,,		請到診療室來
Dialogue: 0,0:05:32.42,0:05:33.78,DefaultSingle-T,,0,0,0,,		您怎麼了
Dialogue: 0,0:05:33.88,0:05:37.54,DefaultSingle-T,,0,0,0,,		我才剛開始養  還沒有取名字
Dialogue: 0,0:05:37.59,0:05:41.11,DefaultSingle-T,,0,0,0,,		那這次只填寫飼主的名字就行
Dialogue: 0,0:05:41.78,0:05:44.17,DefaultSingle-T,,0,0,0,,		主人會給你取什麼名字呢
Dialogue: 0,0:05:45.84,0:05:47.76,DefaultSingle-T,,0,0,0,,		安室透先生  請進
Dialogue: 0,0:05:48.93,0:05:49.87,DefaultSingle-T,,0,0,0,,		拜託了
Dialogue: 0,0:05:52.39,0:05:52.93,DefaultSingle-T,,0,0,0,,		喂
Dialogue: 0,0:05:53.35,0:05:54.24,DefaultSingle-T,,0,0,0,,		你去哪裡
Dialogue: 0,0:05:54.98,0:05:56.16,DefaultSingle-T,,0,0,0,,		喂  別亂跑
Dialogue: 0,0:05:57.94,0:05:59.86,DefaultSingle-T,,0,0,0,,		回家之後放心了？
Dialogue: 0,0:06:01.05,0:06:02.29,DefaultSingle-T,,0,0,0,,		你真努力
Dialogue: 0,0:06:02.42,0:06:05.04,DefaultSingle-T,,0,0,0,,		別怕  我不會給你打針的
Dialogue: 0,0:06:09.02,0:06:10.01,DefaultSingle-T,,0,0,0,,		痛痛痛
Dialogue: 0,0:06:17.39,0:06:18.89,DefaultSingle-T,,0,0,0,,		這不是給你用的
Dialogue: 0,0:06:20.44,0:06:22.40,DefaultSingle-T,,0,0,0,,		別亂跑  很危險的
Dialogue: 0,0:06:27.65,0:06:29.16,DefaultSingle-T,,0,0,0,,		你看吧
Dialogue: 0,0:06:30.82,0:06:31.91,DefaultSingle-T,,0,0,0,,		真是的
Dialogue: 0,0:06:43.54,0:06:45.92,DefaultSingle-T,,0,0,0,,		這是吉他  聲音很好聽吧
Dialogue: 0,0:06:46.71,0:06:49.55,DefaultSingle-T,,0,0,0,,		我想和朋友一起演奏才學的
Dialogue: 0,0:07:05.11,0:07:05.98,DefaultSingle-T,,0,0,0,,		你喜歡嗎
Dialogue: 0,0:07:07.23,0:07:11.28,DefaultSingle-T,,0,0,0,,		那我就把我學會的第一首曲子彈給你聽吧
Dialogue: 0,0:07:12.20,0:07:13.91,DefaultSingle-T,,0,0,0,,		G大調《故鄉》
Dialogue: 0,0:07:17.66,0:07:26.17,DefaultSingle-J,,0,0,0,,	{\a6\fs50}	兎追ひし彼の山
Dialogue: 0,0:07:26.55,0:07:35.05,DefaultSingle-J,,0,0,0,,	{\a6\fs50}	小鮒釣りし彼の川
Dialogue: 0,0:07:35.39,0:07:44.27,DefaultSingle-J,,0,0,0,,	{\a6\fs50}	夢は今も巡りて
Dialogue: 0,0:07:44.27,0:07:53.11,DefaultSingle-J,,0,0,0,,	{\a6\fs50}	忘れ難き故郷
Dialogue: 0,0:07:17.66,0:07:26.17,DefaultSingle-T,,0,0,0,,		青山幽幽  逐兔其中
Dialogue: 0,0:07:26.55,0:07:35.05,DefaultSingle-T,,0,0,0,,		碧水淌淌  垂釣其上
Dialogue: 0,0:07:35.39,0:07:44.27,DefaultSingle-T,,0,0,0,,		如今依舊  魂牽夢縈
Dialogue: 0,0:07:44.27,0:07:53.11,DefaultSingle-T,,0,0,0,,		難以忘懷  故鄉之景
Dialogue: 0,0:08:03.12,0:08:04.29,DefaultSingle-T,,0,0,0,,		睡著了
Dialogue: 0,0:08:06.54,0:08:08.92,DefaultSingle-T,,0,0,0,,		它應該是喜歡這個音階吧
Dialogue: 0,0:08:09.34,0:08:15.26,DefaultSingle-T,,0,0,0,,		和狼相近的犬種  會通過吠聲進行交流
Dialogue: 0,0:08:15.55,0:08:19.56,DefaultSingle-T,,0,0,0,,		因此經常會對鳴笛或門鈴等特定聲音產生反應
Dialogue: 0,0:08:19.89,0:08:24.31,DefaultSingle-T,,0,0,0,,		它聽到特定的音階就會吠叫  或許也是這個原因
Dialogue: 0,0:08:25.77,0:08:29.15,DefaultSingle-T,,0,0,0,,		魂牽夢縈
Dialogue: 0,0:08:30.99,0:08:34.11,DefaultSingle-T,,0,0,0,,		三絃五品…四品
Dialogue: 0,0:08:36.12,0:08:38.74,DefaultSingle-T,,0,0,0,,		它喜歡的聲音是哆和西的排列
Dialogue: 0,0:08:39.37,0:08:41.08,DefaultSingle-T,,0,0,0,,		安室哆西  請進
Dialogue: 0,0:08:42.62,0:08:45.58,DefaultSingle-T,,0,0,0,,		不不不  安室哆西實在不好聽
Dialogue: 0,0:08:46.00,0:08:50.30,DefaultSingle-T,,0,0,0,,		哆來咪的英語寫法是CDEFGABC
Dialogue: 0,0:08:50.55,0:08:52.26,DefaultSingle-T,,0,0,0,,		安室CB…
Dialogue: 0,0:08:52.88,0:08:54.05,DefaultSingle-T,,0,0,0,,		好怪啊
Dialogue: 0,0:08:55.18,0:08:58.30,DefaultSingle-T,,0,0,0,,		日本的音階名是「ハニホヘトイロハ」
Dialogue: 0,0:08:55.18,0:08:58.30,DefaultSingle-T,,0,0,0,,	{\fs50\pos(1170,996)}	ha ni hu he to i ro ha
Dialogue: 0,0:08:58.89,0:09:02.10,DefaultSingle-T,,0,0,0,,		哆是ha  西是ro
Dialogue: 0,0:09:03.14,0:09:03.77,DefaultSingle-T,,0,0,0,,		嗯
Dialogue: 0,0:09:04.94,0:09:07.94,DefaultSingle-T,,0,0,0,,		想好了  你就叫這個名字吧
Dialogue: 0,0:09:14.20,0:09:17.53,DefaultSingle-T,,0,0,0,,		沒事的  第一次都堅持過來了
Dialogue: 0,0:09:17.91,0:09:19.62,DefaultSingle-T,,0,0,0,,		第二次一定更輕鬆
Dialogue: 0,0:09:20.20,0:09:22.29,DefaultSingle-T,,0,0,0,,		馬上就要叫你了哦
Dialogue: 0,0:09:24.71,0:09:27.04,DefaultSingle-T,,0,0,0,,		安室…哈羅
Dialogue: 0,0:11:10.90,0:11:12.02,DefaultSingle-T,,0,0,0,,		花瓣雨
Dialogue: 0,0:11:15.90,0:11:16.90,DefaultSingle-T,,0,0,0,,		失敗了
Dialogue: 0,0:11:17.61,0:11:19.49,DefaultSingle-T,,0,0,0,,		你小時候沒這麼玩過嗎
Dialogue: 0,0:11:19.95,0:11:21.74,DefaultSingle-T,,0,0,0,,		櫻花花瓣的魔法
Dialogue: 0,0:11:21.99,0:11:25.87,DefaultSingle-T,,0,0,0,,		在空中抓住三片花瓣  願望就能實現
Dialogue: 0,0:11:26.45,0:11:29.20,DefaultSingle-T,,0,0,0,,		你會許什麼願呢
Dialogue: 0,0:11:30.71,0:11:32.63,DefaultSingle-T,,0,0,0,,		還有酒嗎
Dialogue: 0,0:11:34.21,0:11:36.42,DefaultSingle-T,,0,0,0,,		我去把車上備用的酒拿來
Dialogue: 0,0:11:37.80,0:11:39.21,DefaultSingle-T,,0,0,0,,		麻煩你了  安室先生
Dialogue: 0,0:11:47.64,0:11:50.31,DefaultSingle-T,,0,0,0,,		和許多人共享時間
Dialogue: 0,0:11:51.06,0:11:53.73,DefaultSingle-T,,0,0,0,,		偶爾這樣也不錯
Dialogue: 0,0:12:26.76,0:12:29.56,DefaultSingle-T,,0,0,0,,		五片花瓣組成一朵櫻花
Dialogue: 0,0:12:31.98,0:12:35.15,DefaultSingle-T,,0,0,0,,		實現願望的魔法…嗎
Comment: 0,0:03:51.67,0:03:54.67,Note,,0,0,0,,
Dialogue: 0,0:05:20.09,0:05:23.59,Note-T,,0,0,0,,		{\c&H3A464E&\3c&HCCD0D1&\4c&HA3A4A2&}杯戶寵物醫院

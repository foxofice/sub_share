Dialogue: 0,0:16:02.29,0:16:03.36,CureSky,NTP,0,0,0,,天空！
Dialogue: 0,0:16:02.29,0:16:03.36,CureSky,NTP,0,0,0,,{\fs50}Sky！
Dialogue: 0,0:06:38.73,0:06:38.73,Default,NTP,0,0,0,,
Dialogue: 0,0:16:11.60,0:16:13.02,CureSky,NTP,0,0,0,,閃耀起步！
Dialogue: 0,0:16:11.60,0:16:13.02,CureSky,NTP,0,0,0,,{\fs50\pos(995,970)}HOP
Dialogue: 0,0:16:19.57,0:16:21.08,CureSky,NTP,0,0,0,,爽朗飛奔！
Dialogue: 0,0:16:19.57,0:16:21.08,CureSky,NTP,0,0,0,,{\fs50\pos(995,970)}STEP
Dialogue: 0,0:16:27.26,0:16:28.98,CureSky,NTP,0,0,0,,暢快躍起！
Dialogue: 0,0:16:27.26,0:16:28.98,CureSky,NTP,0,0,0,,{\fs50\pos(995,970)}JUMP
Dialogue: 0,0:06:38.73,0:06:38.73,Default,NTP,0,0,0,,
Dialogue: 0,0:16:49.47,0:16:51.73,CureSky,NTP,0,0,0,,廣闊無限的藍天！
Dialogue: 0,0:16:53.01,0:16:54.38,CureSky,NTP,0,0,0,,Cure Sky！
Dialogue: 0,0:16:53.01,0:16:54.38,CureSky,NTP,0,0,0,,{\fs50}天空愈衛！
Dialogue: 0,0:07:21.60,0:07:21.60,Default,NTP,0,0,0,,
Dialogue: 0,0:16:58.29,0:17:01.22,CurePri,NTP,0,0,0,,遼闊拂遠的柔光！
Dialogue: 0,0:17:01.91,0:17:03.35,CurePri,NTP,0,0,0,,Cure Prism！
Dialogue: 0,0:17:01.91,0:17:03.35,CurePri,NTP,0,0,0,,{\fs50}稜鏡愈衛！
Dialogue: 0,0:07:22.20,0:07:22.20,Default,NTP,0,0,0,,
Dialogue: 0,0:17:07.07,0:17:09.14,CureWin,NTP,0,0,0,,高闊凌雲的勇氣！
Dialogue: 0,0:17:10.05,0:17:11.55,CureWin,NTP,0,0,0,,Cure Wing！
Dialogue: 0,0:17:10.05,0:17:11.55,CureWin,NTP,0,0,0,,{\fs50}飛翼愈衛！
Dialogue: 0,0:07:23.30,0:07:23.30,Default,NTP,0,0,0,,
Dialogue: 0,0:17:15.49,0:17:17.74,CureBut,NTP,0,0,0,,壯闊飛揚的神彩！
Dialogue: 0,0:17:15.49,0:17:17.74,CureBut,NTP,0,0,0,,{\fs50\pos(1095,970)}Wonderful
Dialogue: 0,0:17:18.39,0:17:19.94,CureBut,NTP,0,0,0,,Cure Butterfly！
Dialogue: 0,0:17:18.39,0:17:19.94,CureBut,NTP,0,0,0,,{\fs50}蝴蝶愈衛！
Dialogue: 0,0:07:24.10,0:07:24.10,Default,NTP,0,0,0,,
Dialogue: 0,0:17:24.63,0:17:26.67,CureMaj,NTP,0,0,0,,崇高降世的神秘！
Dialogue: 0,0:17:27.48,0:17:28.85,CureMaj,NTP,0,0,0,,Cure Majesty！
Dialogue: 0,0:17:27.48,0:17:28.85,CureMaj,NTP,0,0,0,,{\fs50}威愛愈衛！
Dialogue: 0,0:03:07.72,0:03:07.72,Default,NTP,0,0,0,,
Dialogue: 0,0:17:32.47,0:17:33.23,CureSky,NTP,0,0,0,,準備...
Dialogue: 0,0:17:32.47,0:17:33.23,CureSky,NTP,0,0,0,,{\fs50}Ready...
Dialogue: 0,0:17:33.62,0:17:34.65,CurePri,NTP,0,0,0,,沖！
Dialogue: 0,0:17:33.62,0:17:34.65,CurePri,NTP,0,0,0,,{\fs50}Go！

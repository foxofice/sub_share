Dialogue: 0,0:17:02.79,0:17:04.29,PZ,,0,0,0,,{\an9\fn华康新综艺 Std W7\fs40\c&H1A1E28&\pos(342.667,864)}巨大\N态度差距
Dialogue: 0,0:00:00.00,0:00:00.00,PZ,,0,0,0,,
Dialogue: 0,0:23:36.52,0:23:40.10,PZ,,0,0,0,,{\fad(522,0)\an4\fn汉仪正圆-85S\bord3\c&HBCBE80&\3c&HFFFFFF&\pos(1598.4,844.8)}堀的被炉
Dialogue: 0,0:00:00.00,0:00:00.00,PZ,,0,0,0,,
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,Staff
Dialogue: 0,0:00:00.02,0:00:06.02,Staff,,0,0,0,,{\fad(700,700)\an8\bord2\b1\blur2\fs55}本字幕由{\3c&H9B5AE4&}桜{\c\3c\4c}都字幕组制作  仅供交流试看之用  请于下载后24小时内删除\N{\fs50}翻译:{\3c&H436996&}牧こはら hi August1ne{\c\3c\4c}  校对:{\3c&H436996&}小恐龙{\c\3c\4c}  时轴:{\3c&H436996&}吃货的天空{\c\3c\4c}  压制:{\3c&H436996&}象郡{\c\3c\4c}
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,Sub-CH
Dialogue: 0,0:00:02.86,0:00:05.51,Sub-CH,,0,0,0,,今天天公作美
Dialogue: 0,0:00:05.51,0:00:08.95,Sub-CH,,0,0,0,,是举办体育祭的极好日子
Dialogue: 0,0:00:08.95,0:00:14.86,Sub-CH,,0,0,0,,请大家堂堂正正地竞争  尽情享受吧
Dialogue: 0,0:00:14.86,0:00:18.37,Sub-CH,,0,0,0,,感谢校长的致辞
Dialogue: 0,0:00:18.80,0:00:21.19,Sub-CH,,0,0,0,,接下来  请选手宣誓
Dialogue: 0,0:00:28.88,0:00:34.38,Sub-CH,,0,0,0,,宣誓  我们片桐全体在校生
Dialogue: 0,0:00:34.38,0:00:37.43,Sub-CH,,0,0,0,,学生会长面色苍白啊
Dialogue: 0,0:00:37.43,0:00:39.27,Sub-CH,,0,0,0,,头发还是红色
Dialogue: 0,0:00:39.27,0:00:41.39,Sub-CH,,0,0,0,,好鲜明的对比
Dialogue: 0,0:00:41.39,0:00:44.39,Sub-CH,,0,0,0,,会长乖乖地来学校了啊
Dialogue: 0,0:00:45.65,0:00:48.40,Sub-CH,,0,0,0,,今天挺凉快的  真是太好了呢
Dialogue: 0,0:00:48.81,0:00:50.64,Sub-CH,,0,0,0,,有好几个人都穿着长袖
Dialogue: 0,0:00:51.08,0:00:52.90,Sub-CH,,0,0,0,,啊  的确
Dialogue: 0,0:00:53.54,0:00:55.02,Sub-CH,,0,0,0,,仙石说了
Dialogue: 0,0:00:55.02,0:00:58.08,Sub-CH,,0,0,0,,宫村君突然有了干劲  是叛徒
Dialogue: 0,0:01:02.31,0:01:06.13,Sub-CH,,0,0,0,,一直以来都不知道要为了什么而努力
Dialogue: 0,0:01:06.13,0:01:08.66,Sub-CH,,0,0,0,,老实说挺无趣的
Dialogue: 0,0:01:09.27,0:01:12.67,Sub-CH,,0,0,0,,但是  必须要赢过堀同学才行呢
Dialogue: 0,0:01:12.67,0:01:14.00,Sub-CH,,0,0,0,,今年
Dialogue: 0,0:01:14.42,0:01:18.72,Sub-CH,,0,0,0,,那么  片桐体育祭现在正式开幕
Dialogue: 0,0:02:52.80,0:02:56.03,Sub-CH,,0,0,0,,一开始就进入激烈竞争的东西军
Dialogue: 0,0:02:56.03,0:02:59.78,Sub-CH,,0,0,0,,二年级女生的跨栏跑  真是让人捏把汗呢
Dialogue: 0,0:03:00.20,0:03:01.98,Sub-CH,,0,0,0,,您怎么看  中峰老师
Dialogue: 0,0:03:01.98,0:03:03.29,Sub-CH,,0,0,0,,叹为观止
Dialogue: 0,0:03:03.29,0:03:04.30,Sub-CH,,0,0,0,,就是这样
Dialogue: 0,0:03:04.30,0:03:06.54,Sub-CH,,0,0,0,,二年级生们辛苦了
Dialogue: 0,0:03:07.03,0:03:10.16,Sub-CH,,0,0,0,,跨栏  接下来轮到三年级了吧
Dialogue: 0,0:03:10.16,0:03:11.17,Sub-CH,,0,0,0,,是的吧
Dialogue: 0,0:03:11.17,0:03:12.96,Sub-CH,,0,0,0,,樱  我们上吧
Dialogue: 0,0:03:13.61,0:03:15.58,Sub-CH,,0,0,0,,礼美  注意不要受伤哦
Dialogue: 0,0:03:15.58,0:03:17.00,Sub-CH,,0,0,0,,是~
Dialogue: 0,0:03:18.67,0:03:22.06,Sub-CH,,0,0,0,,仙石同学  一起参加二人三脚吧
Dialogue: 0,0:03:22.06,0:03:24.25,Sub-CH,,0,0,0,,我还没找到队友呢
Dialogue: 0,0:03:24.25,0:03:26.43,Sub-CH,,0,0,0,,仙石  来参加倒柱竞赛
Dialogue: 0,0:03:26.43,0:03:27.93,Sub-CH,,0,0,0,,人数不够
Dialogue: 0,0:03:27.93,0:03:29.92,Sub-CH,,0,0,0,,我想变成贝类
Dialogue: 0,0:03:29.92,0:03:32.94,Sub-CH,,0,0,0,,下一个项目  三年级女生跨栏
Dialogue: 0,0:03:34.41,0:03:36.03,Sub-CH,,0,0,0,,那  我去去就来
Dialogue: 0,0:03:36.03,0:03:37.94,Sub-CH,,0,0,0,,加油  堀
Dialogue: 0,0:03:42.30,0:03:44.76,Sub-CH,,0,0,0,,我们在同一组呢
Dialogue: 0,0:03:44.76,0:03:47.29,Sub-CH,,0,0,0,,堀看起来跑得很快
Dialogue: 0,0:03:47.29,0:03:49.33,Sub-CH,,0,0,0,,并没有啦
Dialogue: 0,0:03:49.33,0:03:52.74,Sub-CH,,0,0,0,,绝对跑很快  这下不妙了
Dialogue: 0,0:03:51.40,0:03:54.08,Sub-CH,,0,0,0,,{\an8}挡在我面前的人  全部扫除
Dialogue: 0,0:03:54.08,0:03:55.42,Sub-CH,,0,0,0,,加油啊
Dialogue: 0,0:03:55.42,0:03:56.59,Sub-CH,,0,0,0,,加油
Dialogue: 0,0:03:56.59,0:03:58.34,Sub-CH,,0,0,0,,上啊  西军
Dialogue: 0,0:03:58.34,0:04:02.68,Sub-CH,,0,0,0,,堀同学  宫村在为礼美加油哦
Dialogue: 0,0:04:02.68,0:04:05.66,Sub-CH,,0,0,0,,并不是为绫崎  是在为整个西军加油吧
Dialogue: 0,0:04:05.66,0:04:07.10,Sub-CH,,0,0,0,,下一组跑者  请上前
Dialogue: 0,0:04:09.57,0:04:12.29,Sub-CH,,0,0,0,,为了宫村君  礼美就再加把劲吧
Dialogue: 0,0:04:12.29,0:04:14.85,Sub-CH,,0,0,0,,所以说并不是特意为绫崎…
Dialogue: 0,0:04:13.26,0:04:14.85,Sub-CH,,0,0,0,,{\an8}各就各位
Dialogue: 0,0:04:14.85,0:04:18.11,Sub-CH,,0,0,0,,如果礼美赢了的话  宫村君就归礼美了哦
Dialogue: 0,0:04:18.11,0:04:19.36,Sub-CH,,0,0,0,,京京
Dialogue: 0,0:04:19.36,0:04:21.10,Sub-CH,,0,0,0,,嗯?  京…  哈?!
Dialogue: 0,0:04:21.10,0:04:22.36,Sub-CH,,0,0,0,,预备
Dialogue: 0,0:04:23.69,0:04:24.72,Sub-CH,,0,0,0,,等…
Dialogue: 0,0:04:25.46,0:04:26.86,Sub-CH,,0,0,0,,绫崎跑得好快
Dialogue: 0,0:04:26.86,0:04:27.80,Sub-CH,,0,0,0,,黑马吗
Dialogue: 0,0:04:27.80,0:04:30.25,Sub-CH,,0,0,0,,西军5组的绫崎领先!
Dialogue: 0,0:04:32.87,0:04:37.22,Sub-CH,,0,0,0,,{\an8}刚刚的行为会浪费时间  并且看着好疼
Dialogue: 0,0:04:34.83,0:04:36.72,Sub-CH,,0,0,0,,这一下  好大的声音啊
Dialogue: 0,0:04:36.72,0:04:38.25,Sub-CH,,0,0,0,,话说  直接踢飞了啊
Dialogue: 0,0:04:38.25,0:04:39.63,Sub-CH,,0,0,0,,太强了
Dialogue: 0,0:04:42.00,0:04:44.34,Sub-CH,,0,0,0,,都怪绫崎同学说了奇怪的话
Dialogue: 0,0:04:44.34,0:04:45.64,Sub-CH,,0,0,0,,可恶
Dialogue: 0,0:04:45.64,0:04:48.35,Sub-CH,,0,0,0,,东军则暂时落后
Dialogue: 0,0:04:48.35,0:04:50.27,Sub-CH,,0,0,0,,不用你说我也知道
Dialogue: 0,0:04:50.82,0:04:54.02,Sub-CH,,0,0,0,,东军最后一位的女生气魄好惊人啊
Dialogue: 0,0:04:54.02,0:04:56.39,Sub-CH,,0,0,0,,嗯  那是我们班的
Dialogue: 0,0:04:57.49,0:05:00.78,Sub-CH,,0,0,0,,第一名  西军!  第二名  西军!
Dialogue: 0,0:05:01.68,0:05:04.90,Sub-CH,,0,0,0,,自己才对宫村说过不要放水…
Dialogue: 0,0:05:05.78,0:05:08.23,Sub-CH,,0,0,0,,我好逊
Dialogue: 0,0:05:16.91,0:05:18.90,Sub-CH,,0,0,0,,堀同学  加油!
Dialogue: 0,0:05:27.43,0:05:30.28,Sub-CH,,0,0,0,,不要给敌军加油啦
Dialogue: 0,0:05:30.28,0:05:32.82,Sub-CH,,0,0,0,,东军  就算是最后一名也要加油
Dialogue: 0,0:05:32.82,0:05:34.72,Sub-CH,,0,0,0,,什么鬼  好快
Dialogue: 0,0:05:34.72,0:05:36.94,Sub-CH,,0,0,0,,东军  好快  突然变得好快
Dialogue: 0,0:05:39.86,0:05:41.08,Sub-CH,,0,0,0,,京京
Dialogue: 0,0:05:42.24,0:05:44.57,Sub-CH,,0,0,0,,不要再叫京京了啦
Dialogue: 0,0:05:44.57,0:05:47.99,Sub-CH,,0,0,0,,堀和宫村看起来很恩爱
Dialogue: 0,0:05:47.99,0:05:51.12,Sub-CH,,0,0,0,,礼美抢不走宫村了啊
Dialogue: 0,0:05:51.12,0:05:52.38,Sub-CH,,0,0,0,,这家伙…
Dialogue: 0,0:05:53.45,0:05:56.81,Sub-CH,,0,0,0,,开玩笑啦  礼美已经有仙石君了
Dialogue: 0,0:05:56.81,0:05:59.82,Sub-CH,,0,0,0,,那样简单就动摇的堀好可爱
Dialogue: 0,0:06:00.46,0:06:02.13,Sub-CH,,0,0,0,,我说啊
Dialogue: 0,0:06:02.13,0:06:03.71,Sub-CH,,0,0,0,,堀同学  你在这儿啊
Dialogue: 0,0:06:04.36,0:06:06.08,Sub-CH,,0,0,0,,啊  你们正在谈话吗
Dialogue: 0,0:06:06.08,0:06:08.29,Sub-CH,,0,0,0,,没关系  礼美这就回去
Dialogue: 0,0:06:08.29,0:06:10.63,Sub-CH,,0,0,0,,顺便也把这个还回去了
Dialogue: 0,0:06:10.63,0:06:12.47,Sub-CH,,0,0,0,,啊  谢谢
Dialogue: 0,0:06:12.79,0:06:14.45,Sub-CH,,0,0,0,,腿没事吧?
Dialogue: 0,0:06:14.96,0:06:16.55,Sub-CH,,0,0,0,,跨栏辛苦了
Dialogue: 0,0:06:16.55,0:06:18.02,Sub-CH,,0,0,0,,虽然是最后一名呢
Dialogue: 0,0:06:18.02,0:06:20.91,Sub-CH,,0,0,0,,练习的时候明明状态那么好
Dialogue: 0,0:06:20.91,0:06:23.33,Sub-CH,,0,0,0,,为什么刚才没跑好呢
Dialogue: 0,0:06:23.33,0:06:26.11,Sub-CH,,0,0,0,,都怪你!
Dialogue: 0,0:06:26.11,0:06:28.96,Sub-CH,,0,0,0,,那  后半程又变快了呢
Dialogue: 0,0:06:28.96,0:06:30.80,Sub-CH,,0,0,0,,那也怪你!
Dialogue: 0,0:06:31.87,0:06:33.02,Sub-CH,,0,0,0,,不讲道理
Dialogue: 0,0:06:33.02,0:06:35.00,Sub-CH,,0,0,0,,下一个项目要开始了  我回去了
Dialogue: 0,0:06:35.00,0:06:37.03,Sub-CH,,0,0,0,,宫村也快点回去
Dialogue: 0,0:06:37.03,0:06:38.03,Sub-CH,,0,0,0,,好
Dialogue: 0,0:06:38.03,0:06:39.25,Sub-CH,,0,0,0,,还有
Dialogue: 0,0:06:39.87,0:06:42.04,Sub-CH,,0,0,0,,谢谢你替我加油
Dialogue: 0,0:06:43.43,0:06:44.72,Sub-CH,,0,0,0,,我很开心
Dialogue: 0,0:06:51.51,0:06:53.76,Sub-CH,,0,0,0,,宫村  看那边
Dialogue: 0,0:06:56.02,0:06:58.48,Sub-CH,,0,0,0,,泽田也是西军啊
Dialogue: 0,0:06:58.48,0:07:01.47,Sub-CH,,0,0,0,,泽田拉得到拔河的绳子吗
Dialogue: 0,0:07:02.77,0:07:05.40,Sub-CH,,0,0,0,,堀~学~姐~!
Dialogue: 0,0:07:05.40,0:07:07.31,Sub-CH,,0,0,0,,请看着我
Dialogue: 0,0:07:07.31,0:07:09.37,Sub-CH,,0,0,0,,泽田同学是敌军吧
Dialogue: 0,0:07:09.37,0:07:10.66,Sub-CH,,0,0,0,,应该是
Dialogue: 0,0:07:10.66,0:07:12.08,Sub-CH,,0,0,0,,泽田加油
Dialogue: 0,0:07:12.08,0:07:14.16,Sub-CH,,0,0,0,,泽田学妹加油
Dialogue: 0,0:07:22.70,0:07:25.83,Sub-CH,,0,0,0,,我还以为自己喊太大声惹她不高兴了
Dialogue: 0,0:07:25.83,0:07:28.55,Sub-CH,,0,0,0,,被人加油  没有人会感到不开心的
Dialogue: 0,0:07:29.37,0:07:31.18,Sub-CH,,0,0,0,,宫村也是吧
Dialogue: 0,0:07:31.80,0:07:37.66,Sub-CH,,0,0,0,,体育祭上不管是加油还是被加油  我都没怎么有过呢
Dialogue: 0,0:07:37.68,0:07:41.96,Sub-CH,,0,0,0,,比起敌军  更希望你能为自己人加油呢
Dialogue: 0,0:07:41.96,0:07:45.32,Sub-CH,,0,0,0,,那个是一时冲动  抱歉
Dialogue: 0,0:07:45.32,0:07:49.82,Sub-CH,,0,0,0,,那  接下来就拜托你在障碍物竞走时帮我加油了
Dialogue: 0,0:07:50.42,0:07:54.07,Sub-CH,,0,0,0,,要完全压倒对方加油声程度的  拜托你了
Dialogue: 0,0:07:58.71,0:08:01.72,Sub-CH,,0,0,0,,堀学姐  我输了
Dialogue: 0,0:08:01.72,0:08:03.85,Sub-CH,,0,0,0,,这也是在所难免的事
Dialogue: 0,0:08:03.85,0:08:06.59,Sub-CH,,0,0,0,,东队有很多运动社团
Dialogue: 0,0:08:06.59,0:08:10.74,Sub-CH,,0,0,0,,我还想让堀学姐看我表演呢
Dialogue: 0,0:08:10.74,0:08:13.34,Sub-CH,,0,0,0,,话说这里是东队大本营啊
Dialogue: 0,0:08:16.00,0:08:17.79,Sub-CH,,0,0,0,,马上石川同学就要上场了
Dialogue: 0,0:08:17.79,0:08:19.48,Sub-CH,,0,0,0,,让我们尽力为他加油吧
Dialogue: 0,0:08:22.48,0:08:25.03,Sub-CH,,0,0,0,,井浦  必须赢啊
Dialogue: 0,0:08:25.03,0:08:26.90,Sub-CH,,0,0,0,,第一名  你要争取第一名
Dialogue: 0,0:08:26.90,0:08:29.02,Sub-CH,,0,0,0,,男生们  加油
Dialogue: 0,0:08:29.02,0:08:32.03,Sub-CH,,0,0,0,,石川  加…加油
Dialogue: 0,0:08:32.51,0:08:34.74,Sub-CH,,0,0,0,,我觉得西队比较好
Dialogue: 0,0:08:34.74,0:08:36.64,Sub-CH,,0,0,0,,不然输了就好像要被杀掉了
Dialogue: 0,0:08:36.64,0:08:37.59,Sub-CH,,0,0,0,,仙石呢
Dialogue: 0,0:08:37.59,0:08:41.04,Sub-CH,,0,0,0,,他说他只参加全员的项目
Dialogue: 0,0:08:41.39,0:08:42.54,Sub-CH,,0,0,0,,各就各位
Dialogue: 0,0:08:44.81,0:08:46.09,Sub-CH,,0,0,0,,预备
Dialogue: 0,0:08:47.09,0:08:50.09,Sub-CH,,0,0,0,,男子障碍跑开始了
Dialogue: 0,0:08:50.09,0:08:51.97,Sub-CH,,0,0,0,,第一个是平衡木
Dialogue: 0,0:08:51.97,0:08:53.21,Sub-CH,,0,0,0,,两队齐头并进
Dialogue: 0,0:08:53.21,0:08:54.97,Sub-CH,,0,0,0,,不相上下
Dialogue: 0,0:08:54.97,0:08:55.53,Sub-CH,,0,0,0,,石…
Dialogue: 0,0:08:55.53,0:08:57.71,Sub-CH,,0,0,0,,石川同学  加油
Dialogue: 0,0:08:57.71,0:08:58.43,Sub-CH,,0,0,0,,石…
Dialogue: 0,0:08:58.43,0:09:01.23,Sub-CH,,0,0,0,,石川同学  你在干什么啊
Dialogue: 0,0:09:01.98,0:09:03.73,Sub-CH,,0,0,0,,预备…
Dialogue: 0,0:09:03.73,0:09:06.23,Sub-CH,,0,0,0,,石川同学  加油
Dialogue: 0,0:09:06.23,0:09:08.73,Sub-CH,,0,0,0,,再来一次  预备…
Dialogue: 0,0:09:08.73,0:09:11.86,Sub-CH,,0,0,0,,冲啊  石川
Dialogue: 0,0:09:11.86,0:09:14.86,Sub-CH,,0,0,0,,真羡慕你啊  有女生为你加油
Dialogue: 0,0:09:11.86,0:09:14.86,Sub-CH,,0,0,0,,{\an8}冲啊  石川
Dialogue: 0,0:09:14.86,0:09:18.37,Sub-CH,,0,0,0,,不  里面混了一个大声的男生
Dialogue: 0,0:09:19.55,0:09:20.87,Sub-CH,,0,0,0,,你不是
Dialogue: 0,0:09:21.93,0:09:23.66,Sub-CH,,0,0,0,,可以发出这么大的声音了吗
Dialogue: 0,0:09:24.62,0:09:27.22,Sub-CH,,0,0,0,,到底哪个队伍能获得胜利呢
Dialogue: 0,0:09:27.22,0:09:29.51,Sub-CH,,0,0,0,,加油
Dialogue: 0,0:09:30.37,0:09:32.09,Sub-CH,,0,0,0,,竟然同时到达
Dialogue: 0,0:09:32.09,0:09:35.93,Sub-CH,,0,0,0,,不过对于井浦来说已经尽力了
Dialogue: 0,0:09:35.93,0:09:37.94,Sub-CH,,0,0,0,,吉川同学让我转达你
Dialogue: 0,0:09:37.94,0:09:39.40,Sub-CH,,0,0,0,,我也夸夸你吧
Dialogue: 0,0:09:39.40,0:09:40.60,Sub-CH,,0,0,0,,谢谢你
Dialogue: 0,0:09:41.03,0:09:42.59,Sub-CH,,0,0,0,,吉川同学们呢
Dialogue: 0,0:09:42.59,0:09:43.94,Sub-CH,,0,0,0,,在做准备
Dialogue: 0,0:09:43.94,0:09:46.10,Sub-CH,,0,0,0,,因为接下来是三年级的啦啦队比赛
Dialogue: 0,0:09:46.10,0:09:47.04,Sub-CH,,0,0,0,,好
Dialogue: 0,0:09:47.04,0:09:50.00,Sub-CH,,0,0,0,,现在是男生们期盼已久的啦啦队比赛
Dialogue: 0,0:09:50.00,0:09:52.66,Sub-CH,,0,0,0,,首先从东队的三年级女生开始
Dialogue: 0,0:09:53.64,0:09:55.49,Sub-CH,,0,0,0,,大家上啊
Dialogue: 0,0:09:55.49,0:09:56.79,Sub-CH,,0,0,0,,预备…
Dialogue: 0,0:09:56.79,0:09:59.68,Sub-CH,,0,0,0,,EAST
Dialogue: 0,0:09:59.68,0:10:02.74,Sub-CH,,0,0,0,,加油  东队
Dialogue: 0,0:10:02.74,0:10:04.78,Sub-CH,,0,0,0,,学姐好帅啊
Dialogue: 0,0:10:04.78,0:10:06.61,Sub-CH,,0,0,0,,最棒了
Dialogue: 0,0:10:06.61,0:10:08.53,Sub-CH,,0,0,0,,这不是我所知的那种啦啦队
Dialogue: 0,0:10:08.53,0:10:10.75,Sub-CH,,0,0,0,,我也没见过这种的
Dialogue: 0,0:10:10.75,0:10:14.76,Sub-CH,,0,0,0,,在旁边看着的男友们会是什么心情呢
Dialogue: 0,0:10:15.30,0:10:16.79,Sub-CH,,0,0,0,,目光呆滞了
Dialogue: 0,0:10:16.79,0:10:18.13,Sub-CH,,0,0,0,,果然吗
Dialogue: 0,0:10:18.13,0:10:20.27,Sub-CH,,0,0,0,,不要胆怯  西队
Dialogue: 0,0:10:20.27,0:10:22.14,Sub-CH,,0,0,0,,准备好了吗
Dialogue: 0,0:10:22.14,0:10:23.63,Sub-CH,,0,0,0,,好了
Dialogue: 0,0:10:23.63,0:10:25.38,Sub-CH,,0,0,0,,GO  GO  WEST
Dialogue: 0,0:10:25.38,0:10:26.79,Sub-CH,,0,0,0,,WIN  WIN  WEST
Dialogue: 0,0:10:26.79,0:10:28.32,Sub-CH,,0,0,0,,冠军我们就收下了
Dialogue: 0,0:10:28.32,0:10:30.65,Sub-CH,,0,0,0,,冲啊  西队
Dialogue: 0,0:10:31.63,0:10:33.83,Sub-CH,,0,0,0,,女生们喜欢东队
Dialogue: 0,0:10:33.83,0:10:35.73,Sub-CH,,0,0,0,,男生们喜欢西队
Dialogue: 0,0:10:35.73,0:10:37.60,Sub-CH,,0,0,0,,礼美也太可爱了吧
Dialogue: 0,0:10:37.60,0:10:39.56,Sub-CH,,0,0,0,,你有在听吗  仙石同学
Dialogue: 0,0:10:39.56,0:10:42.17,Sub-CH,,0,0,0,,右  右  左  正上方
Dialogue: 0,0:10:42.17,0:10:44.41,Sub-CH,,0,0,0,,在这个时候向左上
Dialogue: 0,0:10:44.41,0:10:47.66,Sub-CH,,0,0,0,,加油  西队
Dialogue: 0,0:10:50.85,0:10:52.03,Sub-CH,,0,0,0,,做到了
Dialogue: 0,0:10:53.97,0:10:55.55,Sub-CH,,0,0,0,,好好玩
Dialogue: 0,0:10:55.55,0:10:57.56,Sub-CH,,0,0,0,,三年级啦啦队员们辛苦了
Dialogue: 0,0:10:57.56,0:10:59.30,Sub-CH,,0,0,0,,真是好热啊
Dialogue: 0,0:10:59.30,0:11:00.22,Sub-CH,,0,0,0,,辛苦了
Dialogue: 0,0:11:00.22,0:11:01.72,Sub-CH,,0,0,0,,堀同学  太好了呢
Dialogue: 0,0:11:01.72,0:11:02.80,Sub-CH,,0,0,0,,谢谢你们
Dialogue: 0,0:11:02.80,0:11:04.43,Sub-CH,,0,0,0,,吉川同学
Dialogue: 0,0:11:04.43,0:11:06.63,Sub-CH,,0,0,0,,河野同学  辛苦了
Dialogue: 0,0:11:06.63,0:11:08.92,Sub-CH,,0,0,0,,西队表现的超级好
Dialogue: 0,0:11:08.92,0:11:10.69,Sub-CH,,0,0,0,,真的吗
Dialogue: 0,0:11:11.12,0:11:12.41,Sub-CH,,0,0,0,,谢谢你
Dialogue: 0,0:11:12.94,0:11:15.80,Sub-CH,,0,0,0,,谢谢你陪我练习
Dialogue: 0,0:11:15.80,0:11:18.70,Sub-CH,,0,0,0,,我还没有好好和你道谢
Dialogue: 0,0:11:18.70,0:11:21.03,Sub-CH,,0,0,0,,虽然已经过了好久
Dialogue: 0,0:11:22.07,0:11:24.02,Sub-CH,,0,0,0,,河野同学好正经啊
Dialogue: 0,0:11:24.02,0:11:25.83,Sub-CH,,0,0,0,,也不是啦
Dialogue: 0,0:11:26.59,0:11:30.74,Sub-CH,,0,0,0,,不知道石川同学有没有看我呢
Dialogue: 0,0:11:35.09,0:11:37.83,Sub-CH,,0,0,0,,在表演之前不就知道了吗
Dialogue: 0,0:11:37.83,0:11:41.66,Sub-CH,,0,0,0,,但我还是想看她穿啦啦队服
Dialogue: 0,0:11:42.84,0:11:45.60,Sub-CH,,0,0,0,,宫村同学  现在方便吗
Dialogue: 0,0:11:47.92,0:11:49.00,Sub-CH,,0,0,0,,让我替补吗
Dialogue: 0,0:11:49.00,0:11:52.60,Sub-CH,,0,0,0,,对  有一个男生因为感冒缺席了
Dialogue: 0,0:11:52.60,0:11:54.73,Sub-CH,,0,0,0,,所以你能来替一下吗
Dialogue: 0,0:11:55.15,0:11:58.83,Sub-CH,,0,0,0,,我记得你好像没怎么参加个人项目
Dialogue: 0,0:11:58.83,0:12:01.49,Sub-CH,,0,0,0,,是的  但是
Dialogue: 0,0:12:02.39,0:12:04.23,Sub-CH,,0,0,0,,让我参加真的可以吗
Dialogue: 0,0:12:04.74,0:12:07.99,Sub-CH,,0,0,0,,真是的  是我在拜托你哦
Dialogue: 0,0:12:10.69,0:12:13.43,Sub-CH,,0,0,0,,说得对  我马上去集合
Dialogue: 0,0:12:13.43,0:12:16.00,Sub-CH,,0,0,0,,谢谢你  请加油哦
Dialogue: 0,0:12:19.79,0:12:21.73,Sub-CH,,0,0,0,,听说宫村是第三名
Dialogue: 0,0:12:21.73,0:12:23.51,Sub-CH,,0,0,0,,也太弱了吧
Dialogue: 0,0:12:24.27,0:12:27.59,Sub-CH,,0,0,0,,让擅长运动的人参加不就好了
Dialogue: 0,0:12:27.59,0:12:28.86,Sub-CH,,0,0,0,,全部
Dialogue: 0,0:12:30.51,0:12:31.77,Sub-CH,,0,0,0,,我很开心
Dialogue: 0,0:12:31.77,0:12:33.58,Sub-CH,,0,0,0,,加油哦
Dialogue: 0,0:12:33.58,0:12:36.77,Sub-CH,,0,0,0,,被人加油  没有人会感到不开心的
Dialogue: 0,0:12:37.60,0:12:38.82,Sub-CH,,0,0,0,,总感觉…
Dialogue: 0,0:12:40.28,0:12:45.01,Sub-CH,,0,0,0,,运动会比自己想象的还要…
Dialogue: 0,0:12:46.03,0:12:48.89,Sub-CH,,0,0,0,,接下来的借物赛跑
Dialogue: 0,0:12:48.89,0:12:50.79,Sub-CH,,0,0,0,,是唯一的男女混合项目
Dialogue: 0,0:12:50.79,0:12:55.33,Sub-CH,,0,0,0,,请借到信封里写的东西再去终点
Dialogue: 0,0:12:53.04,0:12:55.33,Sub-CH,,0,0,0,,{\an8}眼镜  戴眼镜的人
Dialogue: 0,0:12:55.33,0:12:56.79,Sub-CH,,0,0,0,,马尾辫的女生
Dialogue: 0,0:12:56.79,0:12:59.44,Sub-CH,,0,0,0,,这样的话我们就是第一名了
Dialogue: 0,0:12:59.44,0:13:00.75,Sub-CH,,0,0,0,,太好了
Dialogue: 0,0:13:00.75,0:13:03.80,Sub-CH,,0,0,0,,干脆和老师一起到达人生的终点吧
Dialogue: 0,0:13:05.30,0:13:09.08,Sub-CH,,0,0,0,,对了  吉川  你要借的是什么
Dialogue: 0,0:13:10.02,0:13:12.06,Sub-CH,,0,0,0,,最年轻的老师
Dialogue: 0,0:13:12.81,0:13:14.42,Sub-CH,,0,0,0,,东队到达终点
Dialogue: 0,0:13:14.42,0:13:16.73,Sub-CH,,0,0,0,,由纪最先到达吗
Dialogue: 0,0:13:16.73,0:13:18.31,Sub-CH,,0,0,0,,这下轮到我了
Dialogue: 0,0:13:19.70,0:13:21.57,Sub-CH,,0,0,0,,一定要拿个第一
Dialogue: 0,0:13:24.07,0:13:26.82,Sub-CH,,0,0,0,,对不起  我选别的信封好了
Dialogue: 0,0:13:26.82,0:13:27.79,Sub-CH,,0,0,0,,我也是…
Dialogue: 0,0:13:28.70,0:13:29.70,Sub-CH,,0,0,0,,堀同学
Dialogue: 0,0:13:30.95,0:13:33.64,Sub-CH,,0,0,0,,宫村  为什么你也在
Dialogue: 0,0:13:33.64,0:13:36.58,Sub-CH,,0,0,0,,有人缺席了  突然被叫来参加了
Dialogue: 0,0:13:36.58,0:13:38.52,Sub-CH,,0,0,0,,堀  快一点
Dialogue: 0,0:13:38.52,0:13:40.67,Sub-CH,,0,0,0,,不妙  慢别人一步了
Dialogue: 0,0:13:46.90,0:13:49.50,Sub-CH,,0,0,0,,真是的  宫村同学到底在干什么啊
Dialogue: 0,0:13:49.50,0:13:52.24,Sub-CH,,0,0,0,,他和堀同学好像都吓了一跳
Dialogue: 0,0:13:52.24,0:13:53.75,Sub-CH,,0,0,0,,宫村  跑起来啊
Dialogue: 0,0:13:53.75,0:13:55.73,Sub-CH,,0,0,0,,小京加油
Dialogue: 0,0:13:57.91,0:14:00.16,Sub-CH,,0,0,0,,为什么你在这里啊  仙石
Dialogue: 0,0:14:00.16,0:14:02.04,Sub-CH,,0,0,0,,真的好险
Dialogue: 0,0:14:02.04,0:14:06.15,Sub-CH,,0,0,0,,差点就要被拉去凑人头参赛了
Dialogue: 0,0:14:06.15,0:14:06.80,Sub-CH,,0,0,0,,所以就逃到这边了
Dialogue: 0,0:14:06.80,0:14:08.62,Sub-CH,,0,0,0,,这爽朗的笑容
Dialogue: 0,0:14:09.99,0:14:12.57,Sub-CH,,0,0,0,,怎么…怎么了
Dialogue: 0,0:14:12.57,0:14:16.11,Sub-CH,,0,0,0,,这难道是东西两队要借的东西重了吗
Dialogue: 0,0:14:16.11,0:14:17.65,Sub-CH,,0,0,0,,怎么会有这种事
Dialogue: 0,0:14:17.65,0:14:19.89,Sub-CH,,0,0,0,,宫村  这是我要借的东西
Dialogue: 0,0:14:19.89,0:14:21.50,Sub-CH,,0,0,0,,现在也是我要借的
Dialogue: 0,0:14:21.50,0:14:23.65,Sub-CH,,0,0,0,,等下啊  肩膀要断了
Dialogue: 0,0:14:23.65,0:14:24.54,Sub-CH,,0,0,0,,加油
Dialogue: 0,0:14:24.54,0:14:26.42,Sub-CH,,0,0,0,,仙石同学加油
Dialogue: 0,0:14:26.42,0:14:28.38,Sub-CH,,0,0,0,,不要为我加油啊
Dialogue: 0,0:14:28.38,0:14:31.39,Sub-CH,,0,0,0,,不要啊
Dialogue: 0,0:14:31.39,0:14:34.60,Sub-CH,,0,0,0,,就在刚才  最后的选手到达终点了
Dialogue: 0,0:14:34.60,0:14:36.09,Sub-CH,,0,0,0,,同时到达
Dialogue: 0,0:14:37.02,0:14:39.49,Sub-CH,,0,0,0,,他们似乎借来了学生会长
Dialogue: 0,0:14:39.49,0:14:41.88,Sub-CH,,0,0,0,,不要选我啊
Dialogue: 0,0:14:42.25,0:14:47.03,Sub-CH,,0,0,0,,话说你们两个的信封里写了什么
Dialogue: 0,0:14:51.28,0:14:53.04,Sub-CH,,0,0,0,,小京就算了
Dialogue: 0,0:14:53.04,0:14:54.04,Sub-CH,,0,0,0,,宫村同学
Dialogue: 0,0:14:54.04,0:14:55.85,Sub-CH,,0,0,0,,还有很多其他选项啊
Dialogue: 0,0:14:55.85,0:14:59.08,Sub-CH,,0,0,0,,我觉得还是要找尽可能瘦的男生
Dialogue: 0,0:14:59.08,0:15:01.79,Sub-CH,,0,0,0,,你这个叛徒
Dialogue: 0,0:15:02.69,0:15:06.30,Sub-CH,,0,0,0,,三年级男生的骑马比赛就要开始了
Dialogue: 0,0:15:06.74,0:15:10.05,Sub-CH,,0,0,0,,请男生们开始准备
Dialogue: 0,0:15:10.05,0:15:12.05,Sub-CH,,0,0,0,,肯定是上面啊
Dialogue: 0,0:15:12.05,0:15:14.06,Sub-CH,,0,0,0,,当然是上面啊
Dialogue: 0,0:15:16.14,0:15:18.78,Sub-CH,,0,0,0,,体重吗  是体重的原因吗
Dialogue: 0,0:15:18.78,0:15:20.92,Sub-CH,,0,0,0,,你们在下面的话会骨折吧
Dialogue: 0,0:15:20.92,0:15:23.31,Sub-CH,,0,0,0,,我们又不是树枝
Dialogue: 0,0:15:23.31,0:15:24.27,Sub-CH,,0,0,0,,仙石同学
Dialogue: 0,0:15:24.27,0:15:26.00,Sub-CH,,0,0,0,,既然要参加就要朝着胜利前进哦
Dialogue: 0,0:15:26.00,0:15:26.72,Sub-CH,,0,0,0,,是啊
Dialogue: 0,0:15:31.95,0:15:33.87,Sub-CH,,0,0,0,,这时候你要喊「喔」
Dialogue: 0,0:15:33.87,0:15:36.20,Sub-CH,,0,0,0,,好  首先就对仙石下手
Dialogue: 0,0:15:36.20,0:15:37.50,Sub-CH,,0,0,0,,我知道了
Dialogue: 0,0:15:39.58,0:15:41.39,Sub-CH,,0,0,0,,柳同学也在上面吗
Dialogue: 0,0:15:39.58,0:15:41.39,Sub-CH,,0,0,0,,{\an8}哦  还行啊
Dialogue: 0,0:15:41.39,0:15:42.61,Sub-CH,,0,0,0,,{\an8}谢谢你们
Dialogue: 0,0:15:41.39,0:15:44.96,Sub-CH,,0,0,0,,没什么斗志的人都在上面啊
Dialogue: 0,0:15:51.84,0:15:54.20,Sub-CH,,0,0,0,,突然有干劲了
Dialogue: 0,0:15:54.20,0:15:55.02,Sub-CH,,0,0,0,,真的吗
Dialogue: 0,0:15:55.02,0:15:55.72,Sub-CH,,0,0,0,,终于有了吗
Dialogue: 0,0:15:55.72,0:15:58.63,Sub-CH,,0,0,0,,在上面看到的景色真棒
Dialogue: 0,0:15:58.63,0:16:02.23,Sub-CH,,0,0,0,,仙石同学好像变成了不知道哪里的大将军一样
Dialogue: 0,0:16:02.23,0:16:05.73,Sub-CH,,0,0,0,,怎么感觉仙石干劲满满啊
Dialogue: 0,0:16:05.73,0:16:07.57,Sub-CH,,0,0,0,,我们也要加油哦
Dialogue: 0,0:16:07.57,0:16:08.48,Sub-CH,,0,0,0,,嗯…嗯
Dialogue: 0,0:16:08.48,0:16:11.61,Sub-CH,,0,0,0,,仙石  绝对要砍下一分啊
Dialogue: 0,0:16:11.61,0:16:12.86,Sub-CH,,0,0,0,,上啊上啊
Dialogue: 0,0:16:12.86,0:16:18.13,Sub-CH,,0,0,0,,{\an8}要是输了可饶不了你啊  给我冲
Dialogue: 0,0:16:12.86,0:16:15.23,Sub-CH,,0,0,0,,堀给仙石加油吗
Dialogue: 0,0:16:15.23,0:16:17.99,Sub-CH,,0,0,0,,那是当然了  毕竟他们是一个队的
Dialogue: 0,0:16:17.99,0:16:20.37,Sub-CH,,0,0,0,,但是  你不觉得有点不甘心吗
Dialogue: 0,0:16:21.87,0:16:24.03,Sub-CH,,0,0,0,,我说  有什么作战计划吗
Dialogue: 0,0:16:24.03,0:16:26.50,Sub-CH,,0,0,0,,对哦  仙石头脑很灵光
Dialogue: 0,0:16:27.68,0:16:29.77,Sub-CH,,0,0,0,,那么  这样…如何?
Dialogue: 0,0:16:32.51,0:16:36.64,Sub-CH,,0,0,0,,这种时候  应该为在上面骑的人加油吗
Dialogue: 0,0:16:36.64,0:16:38.50,Sub-CH,,0,0,0,,虽然大家都在努力
Dialogue: 0,0:16:38.50,0:16:41.96,Sub-CH,,0,0,0,,但好像输赢主要还是取决于在上面的那个人的努力吧
Dialogue: 0,0:16:41.96,0:16:44.88,Sub-CH,,0,0,0,,对啊  骑马战还挺难的呢
Dialogue: 0,0:16:45.27,0:16:47.27,Sub-CH,,0,0,0,,宫村同学!
Dialogue: 0,0:16:47.27,0:16:49.16,Sub-CH,,0,0,0,,宫村同学  加油!
Dialogue: 0,0:16:49.16,0:16:50.53,Sub-CH,,0,0,0,,加油!
Dialogue: 0,0:16:50.53,0:16:52.36,Sub-CH,,0,0,0,,{\an8}加油!
Dialogue: 0,0:16:50.53,0:16:53.53,Sub-CH,,0,0,0,,为什么只给宫村一个人加油
Dialogue: 0,0:16:53.53,0:16:54.73,Sub-CH,,0,0,0,,仙石同学
Dialogue: 0,0:16:54.73,0:16:58.03,Sub-CH,,0,0,0,,绫崎同学只给宫村一个人加油  你不会不甘心吗
Dialogue: 0,0:16:58.03,0:17:00.65,Sub-CH,,0,0,0,,我们又不是一个队的  理所当然啊
Dialogue: 0,0:17:00.65,0:17:02.66,Sub-CH,,0,0,0,,你究竟在说些什么呢  井浦同学
Dialogue: 0,0:17:02.66,0:17:03.76,Sub-CH,,0,0,0,,对不起
Dialogue: 0,0:17:04.63,0:17:07.29,Sub-CH,,0,0,0,,那么两军各就各位
Dialogue: 0,0:17:07.29,0:17:11.30,Sub-CH,,0,0,0,,究竟哪一边能取得最后的胜利呢
Dialogue: 0,0:17:11.30,0:17:12.86,Sub-CH,,0,0,0,,准备!
Dialogue: 0,0:17:13.87,0:17:15.30,Sub-CH,,0,0,0,,看招
Dialogue: 0,0:17:21.31,0:17:23.40,Sub-CH,,0,0,0,,咦  是在这附近吗
Dialogue: 0,0:17:23.78,0:17:26.31,Sub-CH,,0,0,0,,西军的家伙靠着感觉在进攻啊
Dialogue: 0,0:17:27.31,0:17:29.98,Sub-CH,,0,0,0,,喂  柳  睁开眼睛啊
Dialogue: 0,0:17:29.98,0:17:31.78,Sub-CH,,0,0,0,,不是  我忘记带眼镜了
Dialogue: 0,0:17:31.78,0:17:34.40,Sub-CH,,0,0,0,,柳  出乎意料地能干啊
Dialogue: 0,0:17:36.71,0:17:37.68,Sub-CH,,0,0,0,,会长
Dialogue: 0,0:17:39.08,0:17:43.04,Sub-CH,,0,0,0,,这一分  就由我收下了!
Dialogue: 0,0:17:46.84,0:17:49.82,Sub-CH,,0,0,0,,西军的回避能力  迅如疾风啊
Dialogue: 0,0:17:49.82,0:17:52.16,Sub-CH,,0,0,0,,不不不  刚才那几下谁都能躲过吧
Dialogue: 0,0:17:52.16,0:17:54.88,Sub-CH,,0,0,0,,宫村  要一鼓作气上了哦
Dialogue: 0,0:17:59.62,0:18:02.15,Sub-CH,,0,0,0,,为什么仙石突然来劲了啊
Dialogue: 0,0:18:02.15,0:18:04.57,Sub-CH,,0,0,0,,好像是将军之魂被点燃了
Dialogue: 0,0:18:05.36,0:18:06.88,Sub-CH,,0,0,0,,这样啊  不是很懂
Dialogue: 0,0:18:07.85,0:18:10.69,Sub-CH,,0,0,0,,仙石!  你磨磨蹭蹭地在干什么呢!
Dialogue: 0,0:18:10.69,0:18:12.23,Sub-CH,,0,0,0,,就是就是!
Dialogue: 0,0:18:12.23,0:18:13.72,Sub-CH,,0,0,0,,连着头一起扯下来
Dialogue: 0,0:18:13.72,0:18:15.24,Sub-CH,,0,0,0,,这样的话宫村会死的
Dialogue: 0,0:18:16.24,0:18:19.44,Sub-CH,,0,0,0,,果然会长很擅长闪躲呢
Dialogue: 0,0:18:19.44,0:18:20.49,Sub-CH,,0,0,0,,宫村
Dialogue: 0,0:18:20.49,0:18:22.35,Sub-CH,,0,0,0,,能一口气抢过来吗
Dialogue: 0,0:18:22.35,0:18:24.25,Sub-CH,,0,0,0,,我们也快到极限了
Dialogue: 0,0:18:24.25,0:18:25.70,Sub-CH,,0,0,0,,石川同学
Dialogue: 0,0:18:25.70,0:18:29.00,Sub-CH,,0,0,0,,对啊  下面支撑的人很累的
Dialogue: 0,0:18:29.00,0:18:30.48,Sub-CH,,0,0,0,,怎么了  石川
Dialogue: 0,0:18:30.48,0:18:32.44,Sub-CH,,0,0,0,,我的鼻尖痒死了
Dialogue: 0,0:18:32.44,0:18:34.26,Sub-CH,,0,0,0,,真的吗  其实我也是
Dialogue: 0,0:18:34.80,0:18:36.97,Sub-CH,,0,0,0,,再这样下去会演变成消耗战
Dialogue: 0,0:18:38.26,0:18:39.26,Sub-CH,,0,0,0,,好!
Dialogue: 0,0:18:45.06,0:18:46.72,Sub-CH,,0,0,0,,怎…怎么回事
Dialogue: 0,0:18:49.90,0:18:51.24,Sub-CH,,0,0,0,,会长啊
Dialogue: 0,0:18:52.37,0:18:53.78,Sub-CH,,0,0,0,,从刚才开始
Dialogue: 0,0:18:55.89,0:18:58.83,Sub-CH,,0,0,0,,就坐在你肩膀上的女孩子
Dialogue: 0,0:19:01.97,0:19:03.12,Sub-CH,,0,0,0,,是什么
Dialogue: 0,0:19:11.65,0:19:17.67,Sub-CH,,0,0,0,,西…西军把最后的东军也击败了
Dialogue: 0,0:19:18.12,0:19:22.34,Sub-CH,,0,0,0,,刚才明显是仙石自己把身子转过去的吧
Dialogue: 0,0:19:22.34,0:19:23.27,Sub-CH,,0,0,0,,嗯
Dialogue: 0,0:19:24.16,0:19:26.24,Sub-CH,,0,0,0,,干得好啊  宫村
Dialogue: 0,0:19:26.24,0:19:27.06,Sub-CH,,0,0,0,,真是的
Dialogue: 0,0:19:27.39,0:19:29.52,Sub-CH,,0,0,0,,不过  就这样吧
Dialogue: 0,0:19:30.54,0:19:32.32,Sub-CH,,0,0,0,,不能就这样算了啊  堀
Dialogue: 0,0:19:32.32,0:19:34.13,Sub-CH,,0,0,0,,分差拉大了
Dialogue: 0,0:19:43.32,0:19:44.83,Sub-CH,,0,0,0,,好啦礼美
Dialogue: 0,0:19:44.83,0:19:46.61,Sub-CH,,0,0,0,,一起把椅子搬走吧
Dialogue: 0,0:19:46.61,0:19:49.44,Sub-CH,,0,0,0,,明明下午的时候我们还是优势
Dialogue: 0,0:19:50.02,0:19:52.71,Sub-CH,,0,0,0,,让仙石同学赢了不也挺好嘛
Dialogue: 0,0:19:55.30,0:19:59.09,Sub-CH,,0,0,0,,但是  小樱你不是练了好久啦啦队的加油嘛
Dialogue: 0,0:20:03.84,0:20:05.63,Sub-CH,,0,0,0,,不至于的啦
Dialogue: 0,0:20:06.10,0:20:08.64,Sub-CH,,0,0,0,,明明小樱是最可爱的
Dialogue: 0,0:20:08.64,0:20:10.92,Sub-CH,,0,0,0,,明明小樱是最可爱的
Dialogue: 0,0:20:10.92,0:20:12.34,Sub-CH,,0,0,0,,好了好了知道了
Dialogue: 0,0:20:15.36,0:20:19.07,Sub-CH,,0,0,0,,我就说感觉有点痛  原来都晒红了啊
Dialogue: 0,0:20:21.86,0:20:24.64,Sub-CH,,0,0,0,,感觉会被近藤嘲笑
Dialogue: 0,0:20:27.12,0:20:29.37,Sub-CH,,0,0,0,,咦…堀同学
Dialogue: 0,0:20:30.60,0:20:31.67,Sub-CH,,0,0,0,,宫村?
Dialogue: 0,0:20:32.53,0:20:35.97,Sub-CH,,0,0,0,,你这么着急  是有什么事…吗
Dialogue: 0,0:20:36.75,0:20:39.16,Sub-CH,,0,0,0,,为…为什么要穿啦啦队的衣服
Dialogue: 0,0:20:39.16,0:20:40.79,Sub-CH,,0,0,0,,体育节都结束了啊
Dialogue: 0,0:20:40.79,0:20:42.20,Sub-CH,,0,0,0,,啊  你说这个?
Dialogue: 0,0:20:42.20,0:20:44.88,Sub-CH,,0,0,0,,女生说要一起拍张合照
Dialogue: 0,0:20:45.43,0:20:47.55,Sub-CH,,0,0,0,,我在加油的时候穿的是男子立领制服
Dialogue: 0,0:20:47.55,0:20:51.02,Sub-CH,,0,0,0,,想着集合能穿一下女生的  就换来了
Dialogue: 0,0:20:51.02,0:20:53.40,Sub-CH,,0,0,0,,男子立领制服和你很搭呢
Dialogue: 0,0:20:53.40,0:20:54.52,Sub-CH,,0,0,0,,真的吗
Dialogue: 0,0:20:54.52,0:20:58.15,Sub-CH,,0,0,0,,毕竟  也算是多亏了我才能赢的吧  对吧
Dialogue: 0,0:20:58.15,0:21:00.61,Sub-CH,,0,0,0,,多亏了晒伤才能看到这个模样的堀同学
Dialogue: 0,0:21:04.80,0:21:06.88,Sub-CH,,0,0,0,,体育节之前也
Dialogue: 0,0:21:06.88,0:21:08.83,Sub-CH,,0,0,0,,更久以前也
Dialogue: 0,0:21:09.33,0:21:12.83,Sub-CH,,0,0,0,,一直为我加油鼓劲的这位啦啦队女孩
Dialogue: 0,0:21:09.65,0:21:10.88,Sub-CH,,0,0,0,,{\an8}脸好红啊
Dialogue: 0,0:21:10.88,0:21:12.16,Sub-CH,,0,0,0,,{\an8}晒的
Dialogue: 0,0:21:14.06,0:21:16.83,Sub-CH,,0,0,0,,今日格外耀眼
Dialogue: 0,0:21:16.83,0:21:18.57,Sub-CH,,0,0,0,,可爱吗
Dialogue: 0,0:21:18.57,0:21:19.93,Sub-CH,,0,0,0,,开玩笑的啦
Dialogue: 0,0:21:19.93,0:21:21.80,Sub-CH,,0,0,0,,刚才是在模仿绫崎同学
Dialogue: 0,0:21:21.80,0:21:23.59,Sub-CH,,0,0,0,,可爱哦
Dialogue: 0,0:21:23.59,0:21:25.76,Sub-CH,,0,0,0,,超可爱的
Dialogue: 0,0:21:32.85,0:21:34.35,Sub-CH,,0,0,0,,笨蛋
Dialogue: 0,0:21:34.35,0:21:36.86,Sub-CH,,0,0,0,,笨蛋  笨蛋
Dialogue: 0,0:21:41.85,0:21:43.99,Sub-CH,,0,0,0,,没准今天是…
Dialogue: 0,0:21:43.99,0:21:45.24,Sub-CH,,0,0,0,,疼疼疼…
Dialogue: 0,0:21:45.24,0:21:50.33,Sub-CH,,0,0,0,,对我来说  第一次也是最后一次真正的体育祭
Dialogue: 0,0:21:57.33,0:21:59.48,Sub-CH,,0,0,0,,真开心啊
Dialogue: 0,0:22:03.88,0:22:07.87,Sub-CH,,0,0,0,,结束之后  我禁不住这么感叹到
Comment: 0,0:00:00.00,0:00:00.00,Sub-CH,,0,0,0,,END

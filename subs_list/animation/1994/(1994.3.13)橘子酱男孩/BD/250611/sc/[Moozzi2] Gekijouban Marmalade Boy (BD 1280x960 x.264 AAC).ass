Dialogue: 0,0:00:10.00,0:00:16.00,005,,0,0,0,,{\fs100.625\an8}本字幕由冷番補完字幕組製作\N{\fs60.375}翻譯：archan 校對:zhang 時軸:宇君
Dialogue: 0,0:00:34.10,0:00:34.95,日文,,0,0,0,,光希
Dialogue: 0,0:00:34.10,0:00:34.95,中文,,0,0,0,,光希
Dialogue: 0,0:00:45.05,0:00:47.38,日文,,0,0,0,,寝てんの? 光希
Dialogue: 0,0:00:45.05,0:00:47.38,中文,,0,0,0,,睡了嗎 光希
Dialogue: 0,0:01:58.69,0:02:01.11,日文,,0,0,0,,な…なんだのよ　今の!
Dialogue: 0,0:01:58.69,0:02:01.11,中文,,0,0,0,,剛才的是什麼
Dialogue: 0,0:02:01.93,0:02:05.42,日文,,0,0,0,,遊とは、遊とはまだあって間もないのに
Dialogue: 0,0:02:01.93,0:02:05.42,中文,,0,0,0,,和游見面才幾天
Dialogue: 0,0:02:05.42,0:02:07.07,日文,,0,0,0,,ど…どうして
Dialogue: 0,0:02:05.42,0:02:07.07,中文,,0,0,0,,為什麼
Dialogue: 0,0:03:51.00,0:03:54.28,日文,,0,0,0,,光希のやつ 今頃パンニングってるだろうな
Dialogue: 0,0:03:51.00,0:03:54.28,中文,,0,0,0,,光希現在應該很震驚吧
Dialogue: 0,0:03:55.44,0:03:59.25,日文,,0,0,0,,だけど俺にとってはすごく自然なことだったんだ
Dialogue: 0,0:03:55.44,0:03:59.25,中文,,0,0,0,,但對我來說再自然不過了
Dialogue: 0,0:04:00.47,0:04:01.63,日文,,0,0,0,,一週間前の
Dialogue: 0,0:04:00.47,0:04:01.63,中文,,0,0,0,,從一週前
Dialogue: 0,0:04:02.58,0:04:03.41,日文,,0,0,0,,あの日から
Dialogue: 0,0:04:02.58,0:04:03.41,中文,,0,0,0,,那天開始
Dialogue: 0,0:04:03.77,0:04:04.97,日文,,0,0,0,,おいおい　待てよ
Dialogue: 0,0:04:03.77,0:04:04.97,中文,,0,0,0,,喂喂 等下
Dialogue: 0,0:04:07.14,0:04:10.29,日文,,0,0,0,,俺たち 離婚しようと思うの
Dialogue: 0,0:04:07.14,0:04:10.29,中文,,0,0,0,,我們打算離婚
Dialogue: 0,0:04:12.21,0:04:16.05,日文,,0,0,0,,ほら 俺たちこの前ハワイ旅行に行っただろう
Dialogue: 0,0:04:12.21,0:04:16.05,中文,,0,0,0,,你看 我們之前不是去了夏威夷旅行嗎
Dialogue: 0,0:04:16.12,0:04:19.03,日文,,0,0,0,,そこでね 小石川さんに出会ったのよ
Dialogue: 0,0:04:16.12,0:04:19.03,中文,,0,0,0,,然後在那裡遇到了小石川一家
Dialogue: 0,0:04:19.41,0:04:20.34,日文,,0,0,0,,小石川
Dialogue: 0,0:04:19.41,0:04:20.34,中文,,0,0,0,,小石川
Dialogue: 0,0:04:21.06,0:04:23.09,日文,,0,0,0,,同じツアーだったご夫妻でね
Dialogue: 0,0:04:21.06,0:04:23.09,中文,,0,0,0,,是一起旅行的夫婦
Dialogue: 0,0:04:23.38,0:04:26.16,日文,,0,0,0,,同年代なんですっかり息統合してさ
Dialogue: 0,0:04:23.38,0:04:26.16,中文,,0,0,0,,我們年齡差不多聊得很投機
Dialogue: 0,0:04:26.75,0:04:31.38,日文,,0,0,0,,一緒に行動しているうちに 私は小石川仁さんと
Dialogue: 0,0:04:26.75,0:04:31.38,中文,,0,0,0,,一起旅遊的時候 我和小石川仁
Dialogue: 0,0:04:31.76,0:04:36.24,日文,,0,0,0,,俺は奥さんの留美さんと 恋に落ちてしまったんだ
Dialogue: 0,0:04:31.76,0:04:36.24,中文,,0,0,0,,我和他妻子留美墜入愛河了
Dialogue: 0,0:04:37.63,0:04:40.90,日文,,0,0,0,,で 4人でいろいろ話し合った結果
Dialogue: 0,0:04:37.63,0:04:40.90,中文,,0,0,0,,四個人商量的結果是
Dialogue: 0,0:04:41.33,0:04:45.25,日文,,0,0,0,,パートナーを交換して再婚しようってことになったんだ
Dialogue: 0,0:04:41.33,0:04:45.25,中文,,0,0,0,,交換配偶再婚
Dialogue: 0,0:04:46.50,0:04:50.13,日文,,0,0,0,,私たちの間に 愛情がなくなったわけじゃないのよ
Dialogue: 0,0:04:46.50,0:04:50.13,中文,,0,0,0,,我們之間不是沒有愛情了
Dialogue: 0,0:04:50.75,0:04:52.98,日文,,0,0,0,,今でもお互い 大好きなの
Dialogue: 0,0:04:50.75,0:04:52.98,中文,,0,0,0,,現在也很喜歡對方
Dialogue: 0,0:04:53.08,0:04:57.11,日文,,0,0,0,,でもそれって もう恋愛じゃなく 家族愛なんだよな
Dialogue: 0,0:04:53.08,0:04:57.11,中文,,0,0,0,,但是這不是戀人之愛而是家人之愛
Dialogue: 0,0:04:58.16,0:05:01.09,日文,,0,0,0,,私たちね 小石川夫妻に出会って
Dialogue: 0,0:04:58.16,0:05:01.09,中文,,0,0,0,,我們啊 想珍視遇見小石川夫婦
Dialogue: 0,0:05:01.09,0:05:04.02,日文,,0,0,0,,久々に感じたときめきを大切にしたいの
Dialogue: 0,0:05:01.09,0:05:04.02,中文,,0,0,0,,而體驗到的這份難得的悸動
Dialogue: 0,0:05:04.66,0:05:07.40,日文,,0,0,0,,だからお願い 許して
Dialogue: 0,0:05:04.66,0:05:07.40,中文,,0,0,0,,所以拜託了 原諒我們
Dialogue: 0,0:05:07.87,0:05:08.65,日文,,0,0,0,,ね
Dialogue: 0,0:05:07.87,0:05:08.65,中文,,0,0,0,,好嗎
Dialogue: 0,0:05:09.66,0:05:10.86,日文,,0,0,0,,いいんじゃない
Dialogue: 0,0:05:09.66,0:05:10.86,中文,,0,0,0,,這不挺好的
Dialogue: 0,0:05:11.31,0:05:13.10,日文,,0,0,0,,俺は別に構わねえけど
Dialogue: 0,0:05:11.31,0:05:13.10,中文,,0,0,0,,我沒關係
Dialogue: 0,0:05:14.78,0:05:15.88,日文,,0,0,0,,やったー
Dialogue: 0,0:05:14.78,0:05:15.88,中文,,0,0,0,,太好了
Dialogue: 0,0:05:16.36,0:05:17.43,日文,,0,0,0,,バンザイー
Dialogue: 0,0:05:16.36,0:05:17.43,中文,,0,0,0,,萬歲
Dialogue: 0,0:05:18.05,0:05:19.01,日文,,0,0,0,,やったー
Dialogue: 0,0:05:18.05,0:05:19.01,中文,,0,0,0,,太好了
Dialogue: 0,0:05:19.01,0:05:19.93,日文,,0,0,0,,良かった
Dialogue: 0,0:05:19.01,0:05:19.93,中文,,0,0,0,,太好了
Dialogue: 0,0:05:19.93,0:05:21.29,日文,,0,0,0,,やったやった
Dialogue: 0,0:05:19.93,0:05:21.29,中文,,0,0,0,,太好了太好了
Dialogue: 0,0:05:21.72,0:05:23.42,日文,,0,0,0,,バンザイー
Dialogue: 0,0:05:21.72,0:05:23.42,中文,,0,0,0,,萬歲
Dialogue: 0,0:06:05.67,0:06:10.34,日文,,0,0,0,,あのね 小石川さんには遊と同い年の女の子がいるのよ
Dialogue: 0,0:06:05.67,0:06:10.34,中文,,0,0,0,,那個啊 小石川一家有個和你同歲的女孩子
Dialogue: 0,0:06:11.54,0:06:12.97,日文,,0,0,0,,光希ちゃんっていう
Dialogue: 0,0:06:11.54,0:06:12.97,中文,,0,0,0,,名字叫光希
Dialogue: 0,0:06:13.21,0:06:15.28,日文,,0,0,0,,きっと仲良く暮らしていけるわ
Dialogue: 0,0:06:13.21,0:06:15.28,中文,,0,0,0,,肯定能生活得很融洽
Dialogue: 0,0:06:16.63,0:06:18.19,日文,,0,0,0,,仲良く暮らすって
Dialogue: 0,0:06:16.63,0:06:18.19,中文,,0,0,0,,生活得很融洽
Dialogue: 0,0:06:18.59,0:06:22.73,日文,,0,0,0,,ああ　広い家を借りて 6人一緒に暮らすんだ
Dialogue: 0,0:06:18.59,0:06:22.73,中文,,0,0,0,,我們打算租一間大房子6個人一起住
Dialogue: 0,0:06:24.29,0:06:27.09,日文,,0,0,0,,つまり夫婦関係は変化するけど
Dialogue: 0,0:06:24.29,0:06:27.09,中文,,0,0,0,,也就是說雖然夫妻關係變了
Dialogue: 0,0:06:27.21,0:06:29.07,日文,,0,0,0,,親子関係は変わらないの
Dialogue: 0,0:06:27.21,0:06:29.07,中文,,0,0,0,,但是親子關係不會變
Dialogue: 0,0:06:29.21,0:06:30.29,日文,,0,0,0,,ああ　今まで通り
Dialogue: 0,0:06:29.21,0:06:30.29,中文,,0,0,0,,嗯 和以前一樣
Dialogue: 0,0:06:30.29,0:06:33.31,日文,,0,0,0,,俺と千弥子両親だと思ってくれればいいんだ
Dialogue: 0,0:06:30.29,0:06:33.31,中文,,0,0,0,,你認我和千彌子是你的父母就好了
Dialogue: 0,0:06:33.75,0:06:35.24,日文,,0,0,0,,遊も光希ちゃんも
Dialogue: 0,0:06:33.75,0:06:35.24,中文,,0,0,0,,你和光希
Dialogue: 0,0:06:35.37,0:06:38.61,日文,,0,0,0,,戸籍の上では父親に引き取られることにすれば
Dialogue: 0,0:06:35.37,0:06:38.61,中文,,0,0,0,,戶籍上跟隨父親的話
Dialogue: 0,0:06:38.61,0:06:40.35,日文,,0,0,0,,苗字も変わらないし
Dialogue: 0,0:06:38.61,0:06:40.35,中文,,0,0,0,,姓也不會變
Dialogue: 0,0:06:40.56,0:06:42.55,日文,,0,0,0,,ね?いいアイデアでしょ?
Dialogue: 0,0:06:40.56,0:06:42.55,中文,,0,0,0,,很棒的點子吧？
Dialogue: 0,0:06:42.55,0:06:43.58,日文,,0,0,0,,ああ　そうそう
Dialogue: 0,0:06:42.55,0:06:43.58,中文,,0,0,0,,啊 對了對了
Dialogue: 0,0:06:43.97,0:06:46.49,日文,,0,0,0,,近々 小石川夫妻と光希ちゃんと一緒に
Dialogue: 0,0:06:43.97,0:06:46.49,中文,,0,0,0,,最近我們想小石川夫婦還有光希
Dialogue: 0,0:06:46.74,0:06:48.92,日文,,0,0,0,,食事でもしようと思っているんだ
Dialogue: 0,0:06:46.74,0:06:48.92,中文,,0,0,0,,一起去吃個飯
Dialogue: 0,0:06:49.04,0:06:50.95,日文,,0,0,0,,今から楽しみだわ
Dialogue: 0,0:06:49.04,0:06:50.95,中文,,0,0,0,,真期待啊
Dialogue: 0,0:07:14.71,0:07:16.84,日文,,0,0,0,,あら　遊出かけるの
Dialogue: 0,0:07:14.71,0:07:16.84,中文,,0,0,0,,哎呀 你要出門嗎
Dialogue: 0,0:07:16.84,0:07:21.41,日文,,0,0,0,,今日は久しぶりに3人でドライブでも行こうと思ってたんだがな
Dialogue: 0,0:07:16.84,0:07:21.41,中文,,0,0,0,,難得今天想三個人出去兜風
Dialogue: 0,0:07:21.78,0:07:22.57,日文,,0,0,0,,ごめん
Dialogue: 0,0:07:21.78,0:07:22.57,中文,,0,0,0,,對不起
Dialogue: 0,0:07:22.76,0:07:23.87,日文,,0,0,0,,今日バイトなんだ
Dialogue: 0,0:07:22.76,0:07:23.87,中文,,0,0,0,,今天有兼職
Dialogue: 0,0:07:25.05,0:07:26.33,日文,,0,0,0,,ちょっとがっかり
Dialogue: 0,0:07:25.05,0:07:26.33,中文,,0,0,0,,有點失望
Dialogue: 0,0:07:27.69,0:07:29.03,日文,,0,0,0,,ほんと ごめん
Dialogue: 0,0:07:27.69,0:07:29.03,中文,,0,0,0,,真的對不起
Dialogue: 0,0:07:30.33,0:07:31.66,日文,,0,0,0,,行ってらっしゃい
Dialogue: 0,0:07:30.33,0:07:31.66,中文,,0,0,0,,路上小心
Dialogue: 0,0:07:31.75,0:07:33.42,日文,,0,0,0,,車に気をつけろよ
Dialogue: 0,0:07:31.75,0:07:33.42,中文,,0,0,0,,路上小心車
Dialogue: 0,0:07:35.98,0:07:38.26,日文,,0,0,0,,たく ガキじゃないぜ俺は
Dialogue: 0,0:07:35.98,0:07:38.26,中文,,0,0,0,,真的是 我又不是小孩子了
Dialogue: 0,0:07:40.03,0:07:41.02,日文,,0,0,0,,行ってきます
Dialogue: 0,0:07:40.03,0:07:41.02,中文,,0,0,0,,我走了
Dialogue: 0,0:07:42.38,0:07:43.91,日文,,0,0,0,,転んだら起きろよ
Dialogue: 0,0:07:42.38,0:07:43.91,中文,,0,0,0,,摔倒了就爬起來
Dialogue: 0,0:08:30.68,0:08:31.92,日文,,0,0,0,,それからさぁ
Dialogue: 0,0:08:30.68,0:08:31.92,中文,,0,0,0,,之後啊
Dialogue: 0,0:10:49.99,0:10:52.81,日文,,0,0,0,,いた!　あそこに怪人がいるぞ!
Dialogue: 0,0:10:49.99,0:10:52.81,中文,,0,0,0,,找到了 那裡有怪人
Dialogue: 0,0:10:58.84,0:10:59.93,日文,,0,0,0,,ガストマン!
Dialogue: 0,0:10:58.84,0:10:59.93,中文,,0,0,0,,超人加斯特！
Dialogue: 0,0:11:01.04,0:11:02.94,日文,,0,0,0,,食らえ!タオル怪人!
Dialogue: 0,0:11:01.04,0:11:02.94,中文,,0,0,0,,吃我一招 毛巾怪人！
Dialogue: 0,0:11:04.30,0:11:06.76,日文,,0,0,0,,ビームトルネード
Dialogue: 0,0:11:04.30,0:11:06.76,中文,,0,0,0,,龍捲風射線
Dialogue: 0,0:11:08.56,0:11:09.56,日文,,0,0,0,,なに
Dialogue: 0,0:11:08.56,0:11:09.56,中文,,0,0,0,,什麼
Dialogue: 0,0:11:10.65,0:11:14.74,日文,,0,0,0,,気をつけろガストマン　怪人は女に変身したぞ
Dialogue: 0,0:11:10.65,0:11:14.74,中文,,0,0,0,,超人加斯特小心 怪人變身成女人了
Dialogue: 0,0:11:16.93,0:11:18.77,日文,,0,0,0,,サンキュー ガストアルファ
Dialogue: 0,0:11:16.93,0:11:18.77,中文,,0,0,0,,謝了 加斯特阿爾法
Dialogue: 0,0:11:19.26,0:11:22.60,日文,,0,0,0,,ガストベータ オメガ ゼータ　気をつけろ
Dialogue: 0,0:11:19.26,0:11:22.60,中文,,0,0,0,,加斯特貝塔 歐米伽 澤塔小心
Dialogue: 0,0:11:24.06,0:11:25.22,日文,,0,0,0,,怪人って
Dialogue: 0,0:11:24.06,0:11:25.22,中文,,0,0,0,,怪人
Dialogue: 0,0:11:25.45,0:11:26.77,日文,,0,0,0,,あのね
Dialogue: 0,0:11:25.45,0:11:26.77,中文,,0,0,0,,我說啊
Dialogue: 0,0:11:29.12,0:11:33.14,日文,,0,0,0,,いいかみんな 力を合わせてタオル怪人をやっつけるんだ
Dialogue: 0,0:11:29.12,0:11:33.14,中文,,0,0,0,,大家聽好了 我們要合力打倒毛巾怪人
Dialogue: 0,0:11:39.72,0:11:42.78,日文,,0,0,0,,スプリング ウィンドタイム!
Dialogue: 0,0:11:39.72,0:11:42.78,中文,,0,0,0,,春風時間！
Dialogue: 0,0:11:45.23,0:11:46.55,日文,,0,0,0,,な…なんなの
Dialogue: 0,0:11:45.23,0:11:46.55,中文,,0,0,0,,幹什麼啊
Dialogue: 0,0:11:57.45,0:12:00.22,日文,,0,0,0,,やった
Dialogue: 0,0:11:57.45,0:12:00.22,中文,,0,0,0,,成功了
Dialogue: 0,0:12:06.75,0:12:09.84,日文,,0,0,0,,よくも見破ったなあ　ガストマン
Dialogue: 0,0:12:06.75,0:12:09.84,中文,,0,0,0,,居然被你們看穿了 超人加斯特
Dialogue: 0,0:12:10.19,0:12:16.00,日文,,0,0,0,,だが　このくらいで倒れるタオル怪人ではないわ
Dialogue: 0,0:12:10.19,0:12:16.00,中文,,0,0,0,,但是 我不是這麼輕易就能打倒的怪人
Dialogue: 0,0:12:16.57,0:12:18.17,日文,,0,0,0,,タオル怪人は
Dialogue: 0,0:12:16.57,0:12:18.17,中文,,0,0,0,,毛巾怪人
Dialogue: 0,0:12:18.46,0:12:21.81,日文,,0,0,0,,このタオルで子供たちをのり巻きみたいに
Dialogue: 0,0:12:18.46,0:12:21.81,中文,,0,0,0,,要用這條毛巾把小孩子
Dialogue: 0,0:12:21.81,0:12:24.99,日文,,0,0,0,,くるぐる巻きにしてしまうのだ
Dialogue: 0,0:12:21.81,0:12:24.85,中文,,0,0,0,,像海苔卷一樣捲起來
Dialogue: 0,0:12:26.50,0:12:28.47,日文,,0,0,0,,そんなもの怖くないや
Dialogue: 0,0:12:26.50,0:12:28.47,中文,,0,0,0,,我不會怕那種東西的
Dialogue: 0,0:12:38.87,0:12:41.78,日文,,0,0,0,,ならば行くぞ
Dialogue: 0,0:12:38.87,0:12:41.78,中文,,0,0,0,,那就上啊
Dialogue: 0,0:12:43.98,0:12:47.14,日文,,0,0,0,,お前たち逃げるな 俺たちはガストマンなんだぞ!
Dialogue: 0,0:12:43.98,0:12:47.14,中文,,0,0,0,,你們別跑啊 我們可是超人加斯特啊！
Dialogue: 0,0:12:49.10,0:12:51.41,日文,,0,0,0,,よし　追いかけちゃおっと!
Dialogue: 0,0:12:49.10,0:12:51.41,中文,,0,0,0,,好！要趕緊追上去！
Dialogue: 0,0:12:55.81,0:12:58.10,日文,,0,0,0,,待てー!
Dialogue: 0,0:12:55.81,0:12:58.10,中文,,0,0,0,,等下！
Dialogue: 0,0:13:01.55,0:13:03.06,日文,,0,0,0,,ちょっと待って!
Dialogue: 0,0:13:01.55,0:13:03.06,中文,,0,0,0,,等下！
Dialogue: 0,0:13:03.16,0:13:06.39,日文,,0,0,0,,待ってよ! タオル怪人
Dialogue: 0,0:13:03.16,0:13:06.39,中文,,0,0,0,,等一下 毛巾怪人
Dialogue: 0,0:13:06.86,0:13:08.61,日文,,0,0,0,,待て待て待て
Dialogue: 0,0:13:06.86,0:13:08.61,中文,,0,0,0,,等下等下等下
Dialogue: 0,0:13:11.19,0:13:13.30,日文,,0,0,0,,おかしすぎる　あいつら
Dialogue: 0,0:13:11.19,0:13:13.30,中文,,0,0,0,,那些人太好笑了
Dialogue: 0,0:13:56.61,0:13:57.39,日文,,0,0,0,,いらっしゃい
Dialogue: 0,0:13:56.61,0:13:57.39,中文,,0,0,0,,歡迎光臨
Dialogue: 0,0:13:58.88,0:13:59.64,日文,,0,0,0,,おす
Dialogue: 0,0:13:58.88,0:13:59.64,中文,,0,0,0,,好啊
Dialogue: 0,0:13:59.64,0:14:00.54,日文,,0,0,0,,遊
Dialogue: 0,0:13:59.64,0:14:00.54,中文,,0,0,0,,游
Dialogue: 0,0:14:01.29,0:14:03.73,日文,,0,0,0,,どうしたんだ 今日は休みだろ
Dialogue: 0,0:14:01.29,0:14:03.73,中文,,0,0,0,,怎麼想著過來了 今天休息吧
Dialogue: 0,0:14:03.85,0:14:06.08,日文,,0,0,0,,いや ちょっとそばまで来たから
Dialogue: 0,0:14:03.85,0:14:06.08,中文,,0,0,0,,正好來到在附近
Dialogue: 0,0:14:06.17,0:14:09.00,日文,,0,0,0,,木島さんがちゃんと働いてるか確認にね
Dialogue: 0,0:14:06.17,0:14:09.00,中文,,0,0,0,,就來確認你有沒有認真工作
Dialogue: 0,0:14:09.67,0:14:10.62,日文,,0,0,0,,こいつ
Dialogue: 0,0:14:09.67,0:14:10.62,中文,,0,0,0,,你這傢伙
Dialogue: 0,0:14:17.81,0:14:19.76,日文,,0,0,0,,店長 コーヒー入れてよ
Dialogue: 0,0:14:17.81,0:14:19.76,中文,,0,0,0,,店長 給我泡杯咖啡吧
Dialogue: 0,0:14:25.15,0:14:26.02,日文,,0,0,0,,ほらよ
Dialogue: 0,0:14:25.15,0:14:26.02,中文,,0,0,0,,來了
Dialogue: 0,0:14:26.41,0:14:27.27,日文,,0,0,0,,サンキュー
Dialogue: 0,0:14:26.41,0:14:27.27,中文,,0,0,0,,謝謝
Dialogue: 0,0:14:31.39,0:14:32.84,日文,,0,0,0,,なんかあったのか
Dialogue: 0,0:14:31.39,0:14:32.84,中文,,0,0,0,,發生什麼了嗎
Dialogue: 0,0:14:35.10,0:14:38.56,日文,,0,0,0,,いえ お前が 俺のコーヒーを飲みたい っていう時は
Dialogue: 0,0:14:35.10,0:14:38.56,中文,,0,0,0,,你想喝我的咖啡的時候
Dialogue: 0,0:14:38.72,0:14:40.49,日文,,0,0,0,,必ずなんかあるんだよな
Dialogue: 0,0:14:38.72,0:14:40.49,中文,,0,0,0,,肯定發生了什麼
Dialogue: 0,0:14:41.16,0:14:43.45,日文,,0,0,0,,心配事とか悩みとか
Dialogue: 0,0:14:41.16,0:14:43.45,中文,,0,0,0,,是操心事 還是煩惱
Dialogue: 0,0:14:43.77,0:14:44.85,日文,,0,0,0,,まさか
Dialogue: 0,0:14:43.77,0:14:44.85,中文,,0,0,0,,哪有
Dialogue: 0,0:14:45.13,0:14:46.28,日文,,0,0,0,,何もねえよ
Dialogue: 0,0:14:45.13,0:14:46.28,中文,,0,0,0,,什麼都沒有
Dialogue: 0,0:15:16.43,0:15:17.44,日文,,0,0,0,,どうした
Dialogue: 0,0:15:16.43,0:15:17.44,中文,,0,0,0,,怎麼了
Dialogue: 0,0:15:19.65,0:15:21.64,日文,,0,0,0,,ごめん 店長 ちょっと
Dialogue: 0,0:15:19.65,0:15:21.64,中文,,0,0,0,,對不起 店長 我有點事
Dialogue: 0,0:15:48.60,0:15:51.64,日文,,0,0,0,,茗子 ごめん!
Dialogue: 0,0:15:48.60,0:15:51.64,中文,,0,0,0,,茗子 對不起
Dialogue: 0,0:15:55.88,0:15:58.39,日文,,0,0,0,,もう光希ったら大幅遅刻よ
Dialogue: 0,0:15:55.88,0:15:58.39,中文,,0,0,0,,真是的 光希你遲到得太狠了吧
Dialogue: 0,0:15:59.36,0:16:00.47,日文,,0,0,0,,ミキか
Dialogue: 0,0:15:59.36,0:16:00.47,中文,,0,0,0,,光希嗎
Dialogue: 0,0:16:00.97,0:16:03.65,日文,,0,0,0,,ごめん 茗子許して
Dialogue: 0,0:16:00.97,0:16:03.65,中文,,0,0,0,,對不起 原諒我
Dialogue: 0,0:16:04.17,0:16:07.76,日文,,0,0,0,,チョコトッピングとブルーベリー ダブルでおごるからさ
Dialogue: 0,0:16:04.17,0:16:07.76,中文,,0,0,0,,請你巧克力點綴藍莓雙層冰淇淋
Dialogue: 0,0:16:08.14,0:16:09.48,日文,,0,0,0,,ね…ね
Dialogue: 0,0:16:08.14,0:16:09.48,中文,,0,0,0,,好嗎
Dialogue: 0,0:16:11.40,0:16:13.51,日文,,0,0,0,,オッケー　許してあげる
Dialogue: 0,0:16:11.40,0:16:13.51,中文,,0,0,0,,OK 原諒你
Dialogue: 0,0:16:19.37,0:16:22.57,日文,,0,0,0,,やっと見つけたぞ タオル怪人
Dialogue: 0,0:16:19.37,0:16:22.57,中文,,0,0,0,,終於找到你了 毛巾怪人
Dialogue: 0,0:16:24.92,0:16:26.78,日文,,0,0,0,,逃げるとは卑怯だぞ
Dialogue: 0,0:16:24.92,0:16:26.78,中文,,0,0,0,,逃跑是可恥的
Dialogue: 0,0:16:26.92,0:16:29.09,日文,,0,0,0,,に…　逃げたわけじゃないよ
Dialogue: 0,0:16:26.92,0:16:29.09,中文,,0,0,0,,我不是逃跑
Dialogue: 0,0:16:29.45,0:16:32.04,日文,,0,0,0,,用があるから もう終わりって言ったでしょ?
Dialogue: 0,0:16:29.45,0:16:32.04,中文,,0,0,0,,我說過我還有事就到此結束的吧？
Dialogue: 0,0:16:32.30,0:16:34.72,日文,,0,0,0,,だからもうタオル怪人じゃ…
Dialogue: 0,0:16:32.30,0:16:34.72,中文,,0,0,0,,所以已經不是毛巾怪人了
Dialogue: 0,0:16:34.78,0:16:37.69,日文,,0,0,0,,じゃあタオル怪人小石川でいいや!
Dialogue: 0,0:16:34.78,0:16:37.69,中文,,0,0,0,,那你就是毛巾怪人小石川了
Dialogue: 0,0:16:39.34,0:16:42.77,日文,,0,0,0,,遊ぼうよ!　タオル怪人小石川!
Dialogue: 0,0:16:39.34,0:16:42.77,中文,,0,0,0,,來玩吧 毛巾怪人小石川
Dialogue: 0,0:16:42.77,0:16:47.23,日文,,0,0,0,,あのね 結局残るわけね タオル怪人は
Dialogue: 0,0:16:42.77,0:16:47.23,中文,,0,0,0,,我說啊 結果毛巾怪人還是保留下來了啊
Dialogue: 0,0:16:47.42,0:16:48.58,日文,,0,0,0,,ね
Dialogue: 0,0:16:47.42,0:16:48.58,中文,,0,0,0,,好嘛
Dialogue: 0,0:16:50.44,0:16:52.33,日文,,0,0,0,,誰?　この子たち
Dialogue: 0,0:16:50.44,0:16:52.33,中文,,0,0,0,,這些孩子是誰
Dialogue: 0,0:17:00.94,0:17:02.80,日文,,0,0,0,,ガストマン アルファ!
Dialogue: 0,0:17:00.94,0:17:02.80,中文,,0,0,0,,超人加斯特 阿爾法
Dialogue: 0,0:17:04.80,0:17:06.37,日文,,0,0,0,,ガストマン ベータ
Dialogue: 0,0:17:04.80,0:17:06.37,中文,,0,0,0,,超人加斯特 貝塔
Dialogue: 0,0:17:08.65,0:17:10.38,日文,,0,0,0,,ガストマン オメガ
Dialogue: 0,0:17:08.65,0:17:10.38,中文,,0,0,0,,超人加斯特 歐米伽
Dialogue: 0,0:17:12.46,0:17:13.99,日文,,0,0,0,,ガストマン ゼータ
Dialogue: 0,0:17:12.46,0:17:13.99,中文,,0,0,0,,超人加斯特 澤塔
Dialogue: 0,0:17:16.34,0:17:17.82,日文,,0,0,0,,ガストマン
Dialogue: 0,0:17:16.34,0:17:17.82,中文,,0,0,0,,超人加斯特
Dialogue: 0,0:17:19.47,0:17:24.27,日文,,0,0,0,,5人そろって ガストマンブラザーズ
Dialogue: 0,0:17:19.47,0:17:24.27,中文,,0,0,0,,五個人合起來就是超人加斯特兄弟
Dialogue: 0,0:17:26.28,0:17:27.67,日文,,0,0,0,,す、すごい…
Dialogue: 0,0:17:26.28,0:17:27.67,中文,,0,0,0,,好厲害…
Dialogue: 0,0:17:29.94,0:17:32.17,日文,,0,0,0,,は…早くやろうよ
Dialogue: 0,0:17:29.94,0:17:32.17,中文,,0,0,0,,快點來嘛
Dialogue: 0,0:17:33.76,0:17:34.97,日文,,0,0,0,,ちょっと待てよ
Dialogue: 0,0:17:33.76,0:17:34.97,中文,,0,0,0,,等下
Dialogue: 0,0:17:35.61,0:17:36.81,日文,,0,0,0,,ほら いいじゃないの
Dialogue: 0,0:17:35.61,0:17:36.81,中文,,0,0,0,,你看 這不就好了嗎
Dialogue: 0,0:17:38.59,0:17:41.16,日文,,0,0,0,,もう 光希ったら大幅遅刻よ
Dialogue: 0,0:17:38.59,0:17:41.16,中文,,0,0,0,,真是的 光希你遲到得太狠了吧
Dialogue: 0,0:17:41.40,0:17:44.46,日文,,0,0,0,,じゃあ　カオル怪人小石川でいいや!
Dialogue: 0,0:17:41.40,0:17:44.46,中文,,0,0,0,,那你就是毛巾怪人小石川了！
Dialogue: 0,0:17:44.79,0:17:49.19,日文,,0,0,0,,あのね 小石川さんには、遊と同い年の女の子がいるのよ
Dialogue: 0,0:17:44.79,0:17:49.19,中文,,0,0,0,,那個啊 小石川一家有個和你同歲的女孩子
Dialogue: 0,0:17:49.27,0:17:50.51,日文,,0,0,0,,光希ちゃんっていう
Dialogue: 0,0:17:49.27,0:17:50.51,中文,,0,0,0,,名字叫光希
Dialogue: 0,0:17:50.51,0:17:51.94,日文,,0,0,0,,早く早く
Dialogue: 0,0:17:50.51,0:17:51.94,中文,,0,0,0,,快點快點
Dialogue: 0,0:17:55.56,0:17:59.82,日文,,0,0,0,,ミキ　小石川　小石川ミキ
Dialogue: 0,0:17:55.56,0:17:59.82,中文,,0,0,0,,光希 小石川 小石川光希
Dialogue: 0,0:18:00.90,0:18:01.73,日文,,0,0,0,,まさか
Dialogue: 0,0:18:00.90,0:18:01.73,中文,,0,0,0,,不會吧
Dialogue: 0,0:18:10.11,0:18:11.24,日文,,0,0,0,,早く早く
Dialogue: 0,0:18:10.11,0:18:11.24,中文,,0,0,0,,快點快點
Dialogue: 0,0:21:15.09,0:21:17.28,日文,,0,0,0,,Is he your friend？
Dialogue: 0,0:21:15.09,0:21:17.28,中文,,0,0,0,,他是你的朋友嗎？
Dialogue: 0,0:21:18.56,0:21:19.81,日文,,0,0,0,,フレンド？
Dialogue: 0,0:21:18.56,0:21:19.81,中文,,0,0,0,,朋友？
Dialogue: 0,0:21:20.01,0:21:23.05,日文,,0,0,0,,Yes,he is looking at you for a long time
Dialogue: 0,0:21:20.01,0:21:23.05,中文,,0,0,0,,是的 他看你很久了
Dialogue: 0,0:21:26.73,0:21:27.98,日文,,0,0,0,,Where is he?
Dialogue: 0,0:21:26.73,0:21:27.98,中文,,0,0,0,,他在哪兒？
Dialogue: 0,0:21:28.42,0:21:32.52,日文,,0,0,0,,Well, I saw him over there. So handsome boy.
Dialogue: 0,0:21:28.42,0:21:32.52,中文,,0,0,0,,我看見他在那裡 一個英俊的男孩
Dialogue: 0,0:21:33.20,0:21:36.60,日文,,0,0,0,,すごくハンサムな男の子が光希のこと見てたんだって
Dialogue: 0,0:21:33.20,0:21:36.60,中文,,0,0,0,,他說一個很英俊的男孩子在看你
Dialogue: 0,0:22:05.43,0:22:09.24,日文,,0,0,0,,遊 今日の夕方小石川さんとお食事するの
Dialogue: 0,0:22:05.43,0:22:09.24,中文,,0,0,0,,游 今天傍晚要和小石川一家一起吃飯
Dialogue: 0,0:22:09.24,0:22:10.45,日文,,0,0,0,,忘れないでね
Dialogue: 0,0:22:09.24,0:22:10.45,中文,,0,0,0,,別忘了
Dialogue: 0,0:22:11.55,0:22:13.42,日文,,0,0,0,,大丈夫 忘れないよ
Dialogue: 0,0:22:11.55,0:22:13.42,中文,,0,0,0,,沒事的 我不會忘的
Dialogue: 0,0:22:16.24,0:22:17.57,日文,,0,0,0,,じゃあ　行ってきます
Dialogue: 0,0:22:16.24,0:22:17.57,中文,,0,0,0,,那我走了
Dialogue: 0,0:22:18.55,0:22:19.89,日文,,0,0,0,,行ってらっしゃい
Dialogue: 0,0:22:18.55,0:22:19.89,中文,,0,0,0,,路上小心
Dialogue: 0,0:22:41.52,0:22:43.48,日文,,0,0,0,,やべえ　遅刻だ
Dialogue: 0,0:22:41.52,0:22:43.48,中文,,0,0,0,,不好 遲到了
Dialogue: 0,0:22:55.88,0:22:56.82,日文,,0,0,0,,いらっしゃいませ
Dialogue: 0,0:22:55.88,0:22:56.82,中文,,0,0,0,,歡飲光臨
Dialogue: 0,0:23:04.20,0:23:05.44,日文,,0,0,0,,こちらでございます
Dialogue: 0,0:23:04.20,0:23:05.44,中文,,0,0,0,,請往這邊走
Dialogue: 0,0:23:05.72,0:23:07.96,日文,,0,0,0,,先ほどから皆様お待ちかねて
Dialogue: 0,0:23:05.72,0:23:07.96,中文,,0,0,0,,其他人已等候多時
Dialogue: 0,0:23:48.82,0:23:49.99,日文,,0,0,0,,あのリストバンドは
Dialogue: 0,0:23:48.82,0:23:49.99,中文,,0,0,0,,那個腕帶
Dialogue: 0,0:23:51.17,0:23:52.78,日文,,0,0,0,,実はまだ返していない
Dialogue: 0,0:23:51.17,0:23:52.78,中文,,0,0,0,,我其實還沒有物歸原主
Dialogue: 0,0:23:54.19,0:23:56.86,日文,,0,0,0,,でもいつか返せる時が来るだろう
Dialogue: 0,0:23:54.19,0:23:56.86,中文,,0,0,0,,但是總有一天會有機會還回去的
Dialogue: 0,0:23:58.24,0:24:00.20,日文,,0,0,0,,いつか きっと
Dialogue: 0,0:23:58.24,0:24:00.20,中文,,0,0,0,,總有一天 一定
Dialogue: 0,0:18:22.53,0:18:37.06,插曲,,0,0,0,,聞こえますか届きますか　あなたへのメロディー\N能聽到嗎  能傳達到嗎  給你的旋律
Dialogue: 0,0:18:37.28,0:18:39.52,插曲,,0,0,0,,抱きしめて\N緊緊相擁
Dialogue: 0,0:18:44.74,0:18:57.14,插曲,,0,0,0,,誰かのもとへと　急いでる人波\N趕往某人身邊   這急促的人潮
Dialogue: 0,0:18:59.24,0:19:06.08,插曲,,0,0,0,,夕焼け見上げたら　なぜか\N為什麼仰望晚霞
Dialogue: 0,0:19:06.79,0:19:12.50,插曲,,0,0,0,,1人ぼっちを感じたの\N感到孤單一人
Dialogue: 0,0:19:14.12,0:19:17.68,插曲,,0,0,0,,きっと私を見つけて\N你一定會找到我
Dialogue: 0,0:19:17.96,0:19:28.60,插曲,,0,0,0,,誰より暖かい　その手に包んで心ごと\N我會用最溫暖的手捧著這份心情
Dialogue: 0,0:19:28.69,0:19:36.34,插曲,,0,0,0,,あなたの瞳の中で　微笑むその瞬間を\N在你眼中微笑的那一瞬間
Dialogue: 0,0:19:36.40,0:19:42.49,插曲,,0,0,0,,生まれる前から　ずっと待っているの\N我在出生前就一直等待著
Dialogue: 0,0:19:43.99,0:19:59.04,插曲,,0,0,0,,せつないほど高鳴ってる　この胸のメロディー\N高吟悲傷  這胸中的旋律
Dialogue: 0,0:19:59.14,0:20:01.04,插曲,,0,0,0,,抱きしめて\N緊緊擁抱
Dialogue: 0,0:20:08.63,0:20:12.29,插曲,,0,0,0,,きっと私を見つけて\N你一定會找到我
Dialogue: 0,0:20:12.52,0:20:23.14,插曲,,0,0,0,,どんなに遠くても　奇跡を重ねて出逢いたい\N無論距離多麼遙遠，我都想與你邂逅
Dialogue: 0,0:20:23.25,0:20:30.89,插曲,,0,0,0,,淋しい季節の中から　どこかへ連れていって\N從寂寞的季節裡 你會帶我去哪裡
Dialogue: 0,0:20:30.98,0:20:36.83,插曲,,0,0,0,,あなたに会うまで佇んでいるの\N我會一直佇立著直到遇見你
Dialogue: 0,0:20:38.82,0:20:53.04,插曲,,0,0,0,,聞こえますか届きますか　あなたへのメロディー\N能聽到嗎  能傳達到嗎  給你的旋律
Dialogue: 0,0:20:53.68,0:20:55.91,插曲,,0,0,0,,抱きしめて\N緊緊相擁
Dialogue: 0,0:24:51.51,0:25:01.19,ED_JP,,0,0,0,,心が洗われる光を見つけた
Dialogue: 0,0:25:01.81,0:25:11.57,ED_JP,,0,0,0,,目覚めていく空にあなたが輝くの
Dialogue: 0,0:25:11.92,0:25:21.35,ED_JP,,0,0,0,,どんなに遠く離れていても
Dialogue: 0,0:25:22.23,0:25:31.98,ED_JP,,0,0,0,,同じ夜明けを迎えているのね
Dialogue: 0,0:25:32.83,0:25:37.45,ED_JP,,0,0,0,,まぶしくきらめくの
Dialogue: 0,0:25:37.71,0:25:42.61,ED_JP,,0,0,0,,思い出を結ぶ糸
Dialogue: 0,0:25:43.21,0:25:47.82,ED_JP,,0,0,0,,未来の未来にも
Dialogue: 0,0:25:48.07,0:25:52.93,ED_JP,,0,0,0,,神様がいてくれる
Dialogue: 0,0:25:53.20,0:25:59.21,ED_JP,,0,0,0,,神様がいてくれる
Dialogue: 0,0:24:51.51,0:25:01.19,ED_CN,,0,0,0,,找到了洗淨心靈的光芒
Dialogue: 0,0:25:01.81,0:25:11.57,ED_CN,,0,0,0,,醒來吧  你在天空閃耀
Dialogue: 0,0:25:11.92,0:25:21.35,ED_CN,,0,0,0,,無論我們相隔多遠
Dialogue: 0,0:25:22.23,0:25:31.98,ED_CN,,0,0,0,,都會迎來同一個黎明
Dialogue: 0,0:25:32.83,0:25:37.45,ED_CN,,0,0,0,,光芒閃耀的
Dialogue: 0,0:25:37.71,0:25:42.61,ED_CN,,0,0,0,,回憶編成結
Dialogue: 0,0:25:43.21,0:25:47.82,ED_CN,,0,0,0,,在未來會有
Dialogue: 0,0:25:48.07,0:25:52.93,ED_CN,,0,0,0,,神明相隨
Dialogue: 0,0:25:53.20,0:25:59.21,ED_CN,,0,0,0,,神明相隨
Dialogue: 0,0:02:14.33,0:02:21.54,番名,,0,0,0,,{\c&H1114AC&\3c&H3BD3F0&\t([0,500],\fs250)\pos(640,350)}橘子醬男孩
Dialogue: 0,0:02:21.54,0:02:24.75,OP_CN,,0,0,0,,但是我很在意
Dialogue: 0,0:02:24.75,0:02:26.84,OP_CN,,0,0,0,,比昨天更加在意
Dialogue: 0,0:02:28.13,0:02:35.10,OP_CN,,0,0,0,,這中斷了的夢 讓我更加好奇二人的未來
Dialogue: 0,0:02:41.35,0:02:46.69,OP_CN,,0,0,0,,神啊 把時間停下吧
Dialogue: 0,0:02:47.11,0:02:53.28,OP_CN,,0,0,0,,教科書…制服…頭髮還沒乾
Dialogue: 0,0:02:54.53,0:03:00.08,OP_CN,,0,0,0,,啊 幫幫我吧 絲帶定不下來
Dialogue: 0,0:03:00.62,0:03:06.79,OP_CN,,0,0,0,,都是因為夢到那個傢伙啊
Dialogue: 0,0:03:07.67,0:03:11.55,OP_CN,,0,0,0,,吃到快要燒焦的吐司
Dialogue: 0,0:03:14.22,0:03:19.10,OP_CN,,0,0,0,,不知為何突然心跳加速
Dialogue: 0,0:03:20.85,0:03:25.86,OP_CN,,0,0,0,,又甜又苦的橘子果醬
Dialogue: 0,0:03:25.86,0:03:28.40,OP_CN,,0,0,0,,所以很在意
Dialogue: 0,0:03:28.86,0:03:30.99,OP_CN,,0,0,0,,這樣的心情是為何？
Dialogue: 0,0:03:32.36,0:03:39.16,OP_CN,,0,0,0,,現在最想看到他的笑容
Dialogue: 0,0:02:21.54,0:02:24.75,OP_JP,,0,0,0,,だけど気になる
Dialogue: 0,0:02:24.75,0:02:26.84,OP_JP,,0,0,0,,昨日よりもずっと
Dialogue: 0,0:02:28.13,0:02:35.10,OP_JP,,0,0,0,,途切れた夢 ２人の続きが知りたい
Dialogue: 0,0:02:41.35,0:02:46.69,OP_JP,,0,0,0,,Ah 神様 時間を止めてよ
Dialogue: 0,0:02:47.11,0:02:53.28,OP_JP,,0,0,0,,教科書…制服…まだ髪乾かない
Dialogue: 0,0:02:54.53,0:03:00.08,OP_JP,,0,0,0,,Ah 助けて リボンが決まらない
Dialogue: 0,0:03:00.62,0:03:06.79,OP_JP,,0,0,0,,アイツの夢みたせいよ
Dialogue: 0,0:03:07.67,0:03:11.55,OP_JP,,0,0,0,,焦げかけのトーストかじったら
Dialogue: 0,0:03:14.22,0:03:19.10,OP_JP,,0,0,0,,なぜか不意に胸がときめいた
Dialogue: 0,0:03:20.85,0:03:25.86,OP_JP,,0,0,0,,甘くて苦いママレード
Dialogue: 0,0:03:25.86,0:03:28.40,OP_JP,,0,0,0,,だから気になる
Dialogue: 0,0:03:28.86,0:03:30.99,OP_JP,,0,0,0,,こんな気持ちはなぜ？
Dialogue: 0,0:03:32.36,0:03:39.16,OP_JP,,0,0,0,,今一番 アイツの笑顔に会いたい
Dialogue: 0,0:02:10.18,0:02:10.18,罗马音,-----code行-----,0,0,0,,

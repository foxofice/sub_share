Dialogue: 0,0:04:44.22,0:04:45.52,DefaultSingle-S,,0,0,0,,{\pos(506,80)\c&H467F5F&}承接{\c&H4E31EC&}遗物整理工作  {\c&HD3CF67&}收购遗物！
Dialogue: 0,0:01:31.86,0:01:33.17,DefaultSingle-S,,0,0,0,,		这是这个月的房租
Dialogue: 0,0:01:33.51,0:01:34.04,DefaultSingle-S,,0,0,0,,		好的
Dialogue: 0,0:01:35.50,0:01:36.10,DefaultSingle-S,,0,0,0,,		没有错
Dialogue: 0,0:01:36.10,0:01:37.80,DefaultSingle-S,,0,0,0,,		刚才有一瞬间超可怕
Dialogue: 0,0:01:48.26,0:01:48.93,DefaultSingle-S,,0,0,0,,		好
Dialogue: 0,0:01:49.23,0:01:51.69,DefaultSingle-S,,0,0,0,,		开始打工之后生活终于稳定了下来
Dialogue: 0,0:01:51.90,0:01:53.79,DefaultSingle-S,,0,0,0,,		房租  电费  燃气费  伙食费
Dialogue: 0,0:01:53.79,0:01:55.86,DefaultSingle-S,,0,0,0,,		全部扣完之后还有点闲钱
Dialogue: 0,0:01:56.00,0:01:59.91,DefaultSingle-S,,0,0,0,,		要用这笔钱买什么样的凶器呢
Dialogue: 0,0:02:00.11,0:02:01.95,DefaultSingle-S,,0,0,0,,		咦  犯泽先生  你要出门吗
Dialogue: 0,0:02:02.47,0:02:04.82,DefaultSingle-S,,0,0,0,,		我们正要开看球派对呢
Dialogue: 0,0:02:06.51,0:02:07.86,DefaultSingle-S,,0,0,0,,		今天就不了
Dialogue: 0,0:02:07.99,0:02:09.53,DefaultSingle-S,,0,0,0,,		我要出去买点东西
Dialogue: 0,0:02:13.56,0:02:16.09,DefaultSingle-S,,0,0,0,,		犯泽先生好土啊
Dialogue: 0,0:02:16.09,0:02:17.43,DefaultSingle-S,,0,0,0,,		我懂
Dialogue: 0,0:02:18.40,0:02:21.51,DefaultSingle-S,,0,0,0,,		浑身散发着乡土气息
Dialogue: 0,0:02:21.51,0:02:22.95,DefaultSingle-S,,0,0,0,,		不过这点也挺可爱
Dialogue: 0,0:02:22.95,0:02:25.14,DefaultSingle-S,,0,0,0,,		所以才会被骗啊
Dialogue: 0,0:02:25.14,0:02:26.35,DefaultSingle-S,,0,0,0,,		也对
Dialogue: 0,0:02:26.55,0:02:27.99,DefaultSingle-S,,0,0,0,,		还「HAPPY FACTORY」呢
Dialogue: 0,0:02:27.99,0:02:29.80,DefaultSingle-S,,0,0,0,,		快乐出货吗
Dialogue: 0,0:02:33.15,0:02:35.19,DefaultSingle-S,,0,0,0,,		你们惹毛我了
Dialogue: 0,0:02:35.40,0:02:36.88,DefaultSingle-S,,0,0,0,,		我要报复你们
Dialogue: 0,0:02:37.12,0:02:38.45,DefaultSingle-S,,0,0,0,,		就用这笔钱…
Dialogue: 0,0:02:38.45,0:02:42.12,DefaultSingle-S,,0,0,0,,		去买时髦的衣服回来打你们的脸
Dialogue: 0,0:02:44.21,0:02:45.33,DefaultSingle-S,,0,0,0,,		所有人都很时髦
Dialogue: 0,0:02:45.73,0:02:47.34,DefaultSingle-S,,0,0,0,,		我确实不时髦
Dialogue: 0,0:02:47.45,0:02:48.46,DefaultSingle-S,,0,0,0,,		大概
Dialogue: 0,0:02:48.60,0:02:50.46,DefaultSingle-S,,0,0,0,,		虽然不想承认  但或许确实是这样
Dialogue: 0,0:02:50.54,0:02:53.06,DefaultSingle-S,,0,0,0,,		这件衣服是我妈在商场里买的
Dialogue: 0,0:02:53.24,0:02:55.47,DefaultSingle-S,,0,0,0,,		这件怎么样  合身吗
Dialogue: 0,0:02:55.47,0:02:58.16,DefaultSingle-S,,0,0,0,,		对了  我都没怎么自己买过衣服
Dialogue: 0,0:02:58.27,0:03:01.48,DefaultSingle-S,,0,0,0,,		我的衣服全都是从学生时代穿到现在的T恤
Dialogue: 0,0:03:01.48,0:03:04.69,DefaultSingle-S,,0,0,0,,		毕竟我为了攒钱来东京  一直节衣缩食
Dialogue: 0,0:03:04.69,0:03:05.86,DefaultSingle-S,,0,0,0,,		难道我…
Dialogue: 0,0:03:05.86,0:03:06.60,DefaultSingle-S,,0,0,0,,		好土
Dialogue: 0,0:03:08.69,0:03:11.25,DefaultSingle-S,,0,0,0,,		阿聪  超搞笑
Dialogue: 0,0:03:12.81,0:03:14.76,DefaultSingle-S,,0,0,0,,		他们应该不是在笑我吧
Dialogue: 0,0:03:15.00,0:03:16.53,DefaultSingle-S,,0,0,0,,		笑死了
Dialogue: 0,0:03:16.53,0:03:18.28,DefaultSingle-S,,0,0,0,,		好怪啊
Dialogue: 0,0:03:18.85,0:03:20.82,DefaultSingle-S,,0,0,0,,		这哪里顾得上杀那个男人
Dialogue: 0,0:03:20.82,0:03:23.62,DefaultSingle-S,,0,0,0,,		我都要不敢出门了
Dialogue: 0,0:03:28.60,0:03:30.47,DefaultSingle-S,,0,0,0,,		好时髦  每件都好时髦
Dialogue: 0,0:03:30.47,0:03:31.50,DefaultSingle-S,,0,0,0,,		欢迎光临
Dialogue: 0,0:03:31.65,0:03:34.14,DefaultSingle-S,,0,0,0,,		现在夏装正在打折
Dialogue: 0,0:03:34.14,0:03:35.22,DefaultSingle-S,,0,0,0,,		跟着我不放
Dialogue: 0,0:03:35.62,0:03:36.67,DefaultSingle-S,,0,0,0,,		这是什么
Dialogue: 0,0:03:37.30,0:03:38.15,DefaultSingle-S,,0,0,0,,		这个时髦吗
Dialogue: 0,0:03:38.15,0:03:40.30,DefaultSingle-S,,0,0,0,,		感觉洗衣机一搅就会变成布片
Dialogue: 0,0:03:40.30,0:03:42.48,DefaultSingle-S,,0,0,0,,		你喜欢这种的吗
Dialogue: 0,0:03:42.66,0:03:43.34,DefaultSingle-S,,0,0,0,,		不是…
Dialogue: 0,0:03:43.64,0:03:47.45,DefaultSingle-S,,0,0,0,,		这种破烂系再配上破洞牛仔裤
Dialogue: 0,0:03:47.45,0:03:49.95,DefaultSingle-S,,0,0,0,,		可是当下流行的叛逆风
Dialogue: 0,0:03:49.95,0:03:52.56,DefaultSingle-S,,0,0,0,,		去试衣间试试吧  这边请
Dialogue: 0,0:03:58.14,0:04:00.15,DefaultSingle-S,,0,0,0,,		服装店真是太可怕了
Dialogue: 0,0:04:00.49,0:04:02.32,DefaultSingle-S,,0,0,0,,		差点就买了一套
Dialogue: 0,0:04:02.53,0:04:05.68,DefaultSingle-S,,0,0,0,,		不过  破洞牛仔裤还挺不错的
Dialogue: 0,0:04:05.68,0:04:07.29,DefaultSingle-S,,0,0,0,,		感觉好帅啊
Dialogue: 0,0:04:07.29,0:04:08.75,DefaultSingle-S,,0,0,0,,		散发着狂野气息
Dialogue: 0,0:04:08.75,0:04:10.39,DefaultSingle-S,,0,0,0,,		和什么衣服都很搭
Dialogue: 0,0:04:10.39,0:04:13.22,DefaultSingle-S,,0,0,0,,		说不定也能把现在这件衣服衬得时髦
Dialogue: 0,0:04:14.66,0:04:15.38,DefaultSingle-S,,0,0,0,,		旧衣店
Dialogue: 0,0:04:15.59,0:04:18.04,DefaultSingle-S,,0,0,0,,		对了  我在都市传说里听过
Dialogue: 0,0:04:18.33,0:04:20.38,DefaultSingle-S,,0,0,0,,		旧衣服等于时髦
Dialogue: 0,0:04:20.59,0:04:23.25,DefaultSingle-S,,0,0,0,,		不跟风的独创性  就是它了
Dialogue: 0,0:04:24.20,0:04:25.34,DefaultSingle-S,,0,0,0,,		欢迎
Dialogue: 0,0:04:25.64,0:04:27.27,DefaultSingle-S,,0,0,0,,		你想要什么样的
Dialogue: 0,0:04:27.43,0:04:28.32,DefaultSingle-S,,0,0,0,,		嗯…
Dialogue: 0,0:04:28.56,0:04:31.61,DefaultSingle-S,,0,0,0,,		有没有破洞牛仔裤啊
Dialogue: 0,0:04:31.61,0:04:33.90,DefaultSingle-S,,0,0,0,,		我这有很多不错的
Dialogue: 0,0:04:33.90,0:04:35.74,DefaultSingle-S,,0,0,0,,		我们店可是转卖这个的
Dialogue: 0,0:04:35.74,0:04:36.50,DefaultSingle-S,,0,0,0,,		是吗
Dialogue: 0,0:04:36.50,0:04:38.25,DefaultSingle-S,,0,0,0,,		这条怎么样
Dialogue: 0,0:04:38.57,0:04:40.40,DefaultSingle-S,,0,0,0,,		破洞
Dialogue: 0,0:04:40.40,0:04:42.77,DefaultSingle-S,,0,0,0,,		还有这种的
Dialogue: 0,0:04:42.77,0:04:43.74,DefaultSingle-S,,0,0,0,,		旧衣服是…
Dialogue: 0,0:04:53.94,0:04:54.79,DefaultSingle-S,,0,0,0,,		不明白
Dialogue: 0,0:04:55.02,0:04:56.50,DefaultSingle-S,,0,0,0,,		时髦到底是什么啊
Dialogue: 0,0:04:56.76,0:04:58.12,DefaultSingle-S,,0,0,0,,		那个人很时髦吗
Dialogue: 0,0:04:58.27,0:04:59.65,DefaultSingle-S,,0,0,0,,		那个人呢  那个人呢
Dialogue: 0,0:04:59.65,0:05:01.28,DefaultSingle-S,,0,0,0,,		简直莫名其妙
Dialogue: 0,0:05:01.36,0:05:03.78,DefaultSingle-S,,0,0,0,,		我果然是时髦不起来了
Dialogue: 0,0:05:04.03,0:05:06.45,DefaultSingle-S,,0,0,0,,		只能老实买凶器了吗
Dialogue: 0,0:05:13.41,0:05:14.16,DefaultSingle-S,,0,0,0,,		就是这个
Dialogue: 0,0:05:14.41,0:05:15.41,DefaultSingle-S,,0,0,0,,		不好意思
Dialogue: 0,0:05:15.46,0:05:16.71,DefaultSingle-S,,0,0,0,,		请问有没有黑衣服
Dialogue: 0,0:05:16.71,0:05:17.33,DefaultSingle-S,,0,0,0,,		黑色？
Dialogue: 0,0:05:17.33,0:05:19.25,DefaultSingle-S,,0,0,0,,		我们店不卖黑衣服
Dialogue: 0,0:05:19.25,0:05:20.13,DefaultSingle-S,,0,0,0,,		没有黑色？
Dialogue: 0,0:05:20.80,0:05:21.96,DefaultSingle-S,,0,0,0,,		黑色没有
Dialogue: 0,0:05:21.96,0:05:23.09,DefaultSingle-S,,0,0,0,,		没有
Dialogue: 0,0:05:23.09,0:05:24.13,DefaultSingle-S,,0,0,0,,		对不起
Dialogue: 0,0:05:24.34,0:05:25.97,DefaultSingle-S,,0,0,0,,		骗人的吧  为什么没有黑色
Dialogue: 0,0:05:25.97,0:05:27.76,DefaultSingle-S,,0,0,0,,		你不知道吗
Dialogue: 0,0:05:27.93,0:05:32.85,DefaultSingle-S,,0,0,0,,		米花町有个都市传说  穿黑色的衣服会被诅咒
Dialogue: 0,0:05:32.85,0:05:33.60,DefaultSingle-S,,0,0,0,,		被诅咒？
Dialogue: 0,0:05:33.72,0:05:36.23,DefaultSingle-S,,0,0,0,,		只有上身或者下身穿黑色倒还好
Dialogue: 0,0:05:36.23,0:05:37.85,DefaultSingle-S,,0,0,0,,		但如果穿一身黑
Dialogue: 0,0:05:37.85,0:05:43.57,DefaultSingle-S,,0,0,0,,		就会总是感觉被人盯着  或者被人追赶
Dialogue: 0,0:05:43.57,0:05:47.57,DefaultSingle-S,,0,0,0,,		你一定想要的话  店里的隐藏库存里有
Dialogue: 0,0:05:47.57,0:05:49.57,DefaultSingle-S,,0,0,0,,		但我可是提醒过你了啊
Dialogue: 0,0:05:49.57,0:05:51.28,DefaultSingle-S,,0,0,0,,		我来米花町都几个月了
Dialogue: 0,0:05:51.28,0:05:53.41,DefaultSingle-S,,0,0,0,,		这种被诅咒的都市传说…
Dialogue: 0,0:05:53.41,0:05:55.33,DefaultSingle-S,,0,0,0,,		哪里吓得到我
Dialogue: 0,0:05:55.50,0:05:56.66,DefaultSingle-S,,0,0,0,,		请给我时髦
Dialogue: 0,0:05:56.91,0:05:57.67,DefaultSingle-S,,0,0,0,,		我回来了
Dialogue: 0,0:05:57.83,0:05:59.17,DefaultSingle-S,,0,0,0,,		欢迎回来  犯泽先生
Dialogue: 0,0:05:59.17,0:06:01.34,DefaultSingle-S,,0,0,0,,		咦  你的气质和之前不一样啊
Dialogue: 0,0:06:01.34,0:06:03.21,DefaultSingle-S,,0,0,0,,		真不错  超合身
Dialogue: 0,0:06:03.21,0:06:04.67,DefaultSingle-S,,0,0,0,,		像脱胎换骨了一样
Dialogue: 0,0:06:04.67,0:06:05.13,DefaultSingle-S,,0,0,0,,		是吗
Dialogue: 0,0:06:05.26,0:06:07.09,DefaultSingle-S,,0,0,0,,		你从哪里找到黑衣服的啊
Dialogue: 0,0:06:07.09,0:06:08.93,DefaultSingle-S,,0,0,0,,		天哪  帅爆了
Dialogue: 0,0:06:11.26,0:06:12.93,DefaultSingle-S,,0,0,0,,		我出去走走
Dialogue: 0,0:06:13.60,0:06:14.97,DefaultSingle-S,,0,0,0,,		他真有勇气啊
Dialogue: 0,0:06:16.02,0:06:17.73,DefaultSingle-S,,0,0,0,,		感觉大家都在看我
Dialogue: 0,0:06:17.94,0:06:19.23,DefaultSingle-S,,0,0,0,,		这就是诅咒吗
Dialogue: 0,0:06:19.23,0:06:21.98,DefaultSingle-S,,0,0,0,,		过于时髦  吸引了所有人的关注
Dialogue: 0,0:06:21.98,0:06:24.44,DefaultSingle-S,,0,0,0,,		谢谢你  路过的帅哥
Dialogue: 0,0:06:25.86,0:06:27.90,DefaultSingle-S,,0,0,0,,		好像有人在看我
Dialogue: 0,0:06:33.20,0:06:35.04,DefaultSingle-S,,0,0,0,,		被尾随了
Dialogue: 0,0:06:36.70,0:06:37.91,DefaultSingle-S,,0,0,0,,		你没事吧
Dialogue: 0,0:06:38.21,0:06:40.58,DefaultSingle-S,,0,0,0,,		那个  有人在追我
Dialogue: 0,0:06:40.58,0:06:42.38,DefaultSingle-S,,0,0,0,,		还用异常尖锐的眼神盯着我
Dialogue: 0,0:06:43.75,0:06:44.67,DefaultSingle-S,,0,0,0,,		你说的是…
Dialogue: 0,0:06:45.09,0:06:46.59,DefaultSingle-S,,0,0,0,,		这种眼神吗
Dialogue: 0,0:06:51.59,0:06:52.47,DefaultSingle-S,,0,0,0,,		欢迎回来
Dialogue: 0,0:06:52.47,0:06:52.93,DefaultSingle-S,,0,0,0,,		咦
Dialogue: 0,0:06:54.18,0:06:54.93,DefaultSingle-S,,0,0,0,,		再见
Dialogue: 0,0:06:56.10,0:06:57.77,DefaultSingle-S,,0,0,0,,		是这种眼神吗
Dialogue: 0,0:06:58.73,0:06:59.69,DefaultSingle-S,,0,0,0,,		再见
Dialogue: 0,0:08:31.94,0:08:33.74,DefaultSingle-S,,0,0,0,,		俗话说久居则安
Dialogue: 0,0:08:33.74,0:08:37.53,DefaultSingle-S,,0,0,0,,		但我的故乡岛根县出云市和米花町有着天差地别
Dialogue: 0,0:08:37.66,0:08:40.16,DefaultSingle-S,,0,0,0,,		我还想偶尔介绍一下我在出云的日常
Dialogue: 0,0:08:40.16,0:08:41.91,DefaultSingle-S,,0,0,0,,		但出云的生活过于平淡
Dialogue: 0,0:08:41.91,0:08:44.08,DefaultSingle-S,,0,0,0,,		甚至都凑不满这本就很短的正片时长
Dialogue: 0,0:08:44.08,0:08:47.38,DefaultSingle-S,,0,0,0,,		等第二季确定了之后再给大家介绍
Dialogue: 0,0:08:47.46,0:08:50.09,DefaultSingle-S,,0,0,0,,		总之请看下集「异次元的来访者」
Dialogue: 0,0:08:50.09,0:08:52.09,DefaultSingle-S,,0,0,0,,		是个讲述父母之爱的好故事
Dialogue: 0,0:08:52.09,0:08:53.47,DefaultSingle-S,,0,0,0,,		看完之后请联系父母
Dialogue: 0,0:08:53.47,0:08:56.93,DefaultSingle-S,,0,0,0,,		表达感恩之情  然后让他们购买全套原作漫画
Dialogue: 0,0:08:56.93,0:08:58.89,DefaultSingle-S,,0,0,0,,		这可是和犯泽先生的约定哦
Dialogue: 0,0:02:26.55,0:02:27.99,DefaultSingle-S,,0,0,0,,	{\fs50}	快乐工厂
Dialogue: 0,0:01:42.37,0:01:43.42,DefaultSingle-S,,0,0,0,,

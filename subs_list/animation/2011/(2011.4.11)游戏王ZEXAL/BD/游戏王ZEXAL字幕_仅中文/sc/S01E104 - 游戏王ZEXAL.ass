Dialogue: 0,0:00:01.18,0:00:02.86,Default,,0,0,0,,{\fnZCOOL KuaiLe}＜游马：寻找遗迹的 No.卡
Dialogue: 0,0:00:02.86,0:00:05.77,Default,,0,0,0,,{\fnZCOOL KuaiLe}我们沉入了湖中{\fnNoto Sans CJK SC}➡{\fnZCOOL KuaiLe} 在竞技场与阿里特重逢了。
Dialogue: 0,0:00:06.64,0:00:07.29,Default,,0,0,0,,{\fnZCOOL KuaiLe}比我们更早
Dialogue: 0,0:00:07.29,0:00:09.08,Default,,0,0,0,,{\fnZCOOL KuaiLe}拿到遗迹 No.卡的阿里特{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:09.56,0:00:10.68,Default,,0,0,0,,{\fnZCOOL KuaiLe}不知为何洗脑了戈什
Dialogue: 0,0:00:10.68,0:00:12.12,Default,,0,0,0,,{\fnZCOOL KuaiLe}向我们发起了组队决斗。
Dialogue: 0,0:00:12.72,0:00:14.62,Default,,0,0,0,,{\fnZCOOL KuaiLe}阿里特 你到底是怎么了啊！＞
Dialogue: 0,0:00:15.66,0:00:18.17,Default,,0,0,0,,{\fnZCOOL KuaiLe}(阿里特)我一定要 把你打趴下！
Dialogue: 0,0:00:18.65,0:00:20.09,Default,,0,0,0,,{\fnZCOOL KuaiLe}不管用什么手段！
Dialogue: 0,0:00:23.72,0:00:25.31,Default,,0,0,0,,{\fnZCOOL KuaiLe}(璃绪)这是什么怪物效果啊…
Dialogue: 0,0:00:25.63,0:00:26.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}(凌牙)啊啊…
Dialogue: 0,0:00:26.65,0:00:27.17,Default,,0,0,0,,{\fnZCOOL KuaiLe}阿里特…
Dialogue: 0,0:00:27.76,0:00:28.76,Default,,0,0,0,,{\fnZCOOL KuaiLe}(星光体)小心点 游马。
Dialogue: 0,0:00:29.37,0:00:31.71,Default,,0,0,0,,{\fnZCOOL KuaiLe}狮心是 将自己受到的伤害{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:32.06,0:00:32.48,Default,,0,0,0,,{\fnZCOOL KuaiLe}原封不动
Dialogue: 0,0:00:32.48,0:00:34.43,Default,,0,0,0,,{\fnZCOOL KuaiLe}给予对方玩家的效果的 No.卡。
Dialogue: 0,0:00:35.47,0:00:37.80,Default,,0,0,0,,{\fnZCOOL KuaiLe}虽然强力 但相应的风险也很大。
Dialogue: 0,0:00:38.48,0:00:40.60,Default,,0,0,0,,{\fnZCOOL KuaiLe}所以 自己不使用{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:41.06,0:00:43.09,Default,,0,0,0,,{\fnZCOOL KuaiLe}而是洗脑戈什让别人用的吗！
Dialogue: 0,0:00:46.39,0:00:48.28,Default,,0,0,0,,{\fnZCOOL KuaiLe}（多洛华）怎么回事？这光芒是！
Dialogue: 0,0:00:49.39,0:00:53.35,Default,,0,0,0,,{\fnZCOOL KuaiLe}这是 很久以前填满这座竞技场的{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:00:53.78,0:00:56.48,Default,,0,0,0,,{\fnZCOOL KuaiLe}跨越时空的人们的意念！
Dialogue: 0,0:00:58.64,0:01:01.48,Default,,0,0,0,,{\fnZCOOL KuaiLe}（戈什）我就到此为止了。
Dialogue: 0,0:01:02.13,0:01:04.40,Default,,0,0,0,,{\fnZCOOL KuaiLe}可恶！戈什 我一定会
Dialogue: 0,0:01:04.40,0:01:06.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}把你变回原样的！
Dialogue: 0,0:01:07.15,0:01:09.24,Default,,0,0,0,,{\fnZCOOL KuaiLe}我的回合 抽卡！
Dialogue: 0,0:01:10.29,0:01:13.16,Default,,0,0,0,,{\fnZCOOL KuaiLe}我用希望皇攻击艾利特的里侧守备怪兽！
Dialogue: 0,0:01:16.18,0:01:17.15,Default,,0,0,0,,{\fnZCOOL KuaiLe}太天真了 游马！
Dialogue: 0,0:01:18.26,0:01:20.72,Default,,0,0,0,,{\fnZCOOL KuaiLe}我发动复仇守护者的效果！
Dialogue: 0,0:01:21.17,0:01:23.37,Default,,0,0,0,,{\fnZCOOL KuaiLe}里侧守备表示的这家伙被攻击的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:01:23.95,0:01:26.97,Default,,0,0,0,,{\fnZCOOL KuaiLe}可以将那个攻击对象变更为别的怪兽！
Dialogue: 0,0:01:27.92,0:01:31.22,Default,,0,0,0,,{\fnZCOOL KuaiLe}我将希望皇的攻击对象变更为狮心！
Dialogue: 0,0:01:32.02,0:01:33.24,Default,,0,0,0,,{\fnZCOOL KuaiLe}而且攻击过来的
Dialogue: 0,0:01:33.24,0:01:35.33,Default,,0,0,0,,{\fnZCOOL KuaiLe}如果攻击的是怪兽卡的话{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:01:35.82,0:01:38.91,Default,,0,0,0,,{\fnZCOOL KuaiLe}那些超量素材全部送去墓地！
Dialogue: 0,0:01:39.94,0:01:41.55,Default,,0,0,0,,{\fnZCOOL KuaiLe}希望皇的超量素材！？
Dialogue: 0,0:01:42.01,0:01:42.99,Default,,0,0,0,,{\fnZCOOL KuaiLe}不妙啊 游马！
Dialogue: 0,0:01:43.44,0:01:46.22,Default,,0,0,0,,{\fnZCOOL KuaiLe}没错 这样一来你们就完蛋了！
Dialogue: 0,0:01:46.80,0:01:47.82,Default,,0,0,0,,{\fnZCOOL KuaiLe}上吧 大家伙！
Dialogue: 0,0:01:49.58,0:01:51.31,Default,,0,0,0,,{\fnZCOOL KuaiLe}(轰鸣)狮心效果发动！
Dialogue: 0,0:01:51.86,0:01:53.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}这只怪兽不会被战斗破坏{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:01:54.44,0:01:56.16,Default,,0,0,0,,{\fnZCOOL KuaiLe}而且 我受到的伤害
Dialogue: 0,0:01:56.16,0:01:57.81,Default,,0,0,0,,{\fnZCOOL KuaiLe}也会给予对方玩家！
Dialogue: 0,0:01:58.92,0:02:00.51,Default,,0,0,0,,{\fnZCOOL KuaiLe}燃烧反击！
Dialogue: 0,0:02:04.16,0:02:06.30,Default,,0,0,0,,{\fnZCOOL KuaiLe}(快斗)这样双方都受到2400伤害！
Dialogue: 0,0:02:06.91,0:02:08.29,Default,,0,0,0,,{\fnZCOOL KuaiLe}想打双杀吗！
Dialogue: 0,0:01:58.85,0:02:02.23,Default,,0,0,0,,{\fnZCOOL KuaiLe}再见啦 游马 星光体！
Dialogue: 0,0:03:50.38,0:03:52.52,Default,,0,0,0,,{\fnZCOOL KuaiLe}陷阱发动！ 幻蝶之护！
Dialogue: 0,0:03:52.91,0:03:53.72,Default,,0,0,0,,{\fnZCOOL KuaiLe}我方玩家
Dialogue: 0,0:03:53.72,0:03:55.79,Default,,0,0,0,,{\fnZCOOL KuaiLe}在战斗中受到的伤害减半！
Dialogue: 0,0:03:55.76,0:03:56.24,Default,,0,0,0,,{\fnZCOOL KuaiLe}抽卡！
Dialogue: 0,0:04:07.53,0:04:08.33,Default,,0,0,0,,{\fnZCOOL KuaiLe}高修！
Dialogue: 0,0:04:10.43,0:04:12.12,Default,,0,0,0,,{\fnZCOOL KuaiLe}对不住了高修，这样一来
Dialogue: 0,0:04:12.12,0:04:14.22,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马和德罗瓦就相当有利了。
Dialogue: 0,0:04:15.81,0:04:16.30,Default,,0,0,0,,{\fnZCOOL KuaiLe}高修！
Dialogue: 0,0:04:16.59,0:04:17.12,Default,,0,0,0,,{\fnZCOOL KuaiLe}(有栖)还没完！
Dialogue: 0,0:04:17.74,0:04:20.51,Default,,0,0,0,,{\fnZCOOL KuaiLe}狮心还有另一个效果。
Dialogue: 0,0:04:21.18,0:04:22.34,Default,,0,0,0,,{\fnZCOOL KuaiLe}当玩家的生命值
Dialogue: 0,0:04:22.34,0:04:24.41,Default,,0,0,0,,{\fnZCOOL KuaiLe}因战斗伤害变为零时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:04:24.97,0:04:27.69,Default,,0,0,0,,{\fnZCOOL KuaiLe}通过使用一个超量单元
Dialogue: 0,0:04:27.69,0:04:30.40,Default,,0,0,0,,{\fnZCOOL KuaiLe}将归零的生命值变为100！
Dialogue: 0,0:04:31.30,0:04:33.78,Default,,0,0,0,,{\fnZCOOL KuaiLe}狮心 救援冲击！
Dialogue: 0,0:04:41.95,0:04:43.01,Default,,0,0,0,,{\fnZCOOL KuaiLe}(德罗瓦)高… 高修！
Dialogue: 0,0:04:43.89,0:04:44.88,Default,,0,0,0,,{\fnZCOOL KuaiLe}这 No.卡
Dialogue: 0,0:04:44.88,0:04:46.80,Default,,0,0,0,,{\fnZCOOL KuaiLe}只要还有超量单元{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:04:47.25,0:04:48.85,Default,,0,0,0,,{\fnZCOOL KuaiLe}哪怕让玩家复活过来
Dialogue: 0,0:04:48.85,0:04:50.20,Default,,0,0,0,,{\fnZCOOL KuaiLe}也要继续战斗吗！？
Dialogue: 0,0:04:50.52,0:04:52.90,Default,,0,0,0,,{\fnZCOOL KuaiLe}(有栖)没错。不过使用的一方
Dialogue: 0,0:04:52.90,0:04:54.85,Default,,0,0,0,,{\fnZCOOL KuaiLe}会变得破破烂烂就是了。
Dialogue: 0,0:04:55.33,0:04:56.97,Default,,0,0,0,,{\fnZCOOL KuaiLe}有栖… 你这家伙！
Dialogue: 0,0:04:58.80,0:05:01.37,Default,,0,0,0,,{\fnZCOOL KuaiLe}幻蝶守护的另一个效果发动！
Dialogue: 0,0:05:01.94,0:05:03.14,Default,,0,0,0,,{\fnZCOOL KuaiLe}战斗结束时
Dialogue: 0,0:05:03.14,0:05:05.54,Default,,0,0,0,,{\fnZCOOL KuaiLe}将对方1只怪兽变为守备表示！
Dialogue: 0,0:05:08.42,0:05:10.23,Default,,0,0,0,,{\fnZCOOL KuaiLe}原来如此。狮心
Dialogue: 0,0:05:10.23,0:05:11.95,Default,,0,0,0,,{\fnZCOOL KuaiLe}无效破坏的效果{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:05:12.22,0:05:13.62,Default,,0,0,0,,{\fnZCOOL KuaiLe}仅限攻击表示时！
Dialogue: 0,0:05:14.47,0:05:16.42,Default,,0,0,0,,{\fnZCOOL KuaiLe}只要变成守备表示就能破坏掉！
Dialogue: 0,0:05:17.39,0:05:19.78,Default,,0,0,0,,{\fnZCOOL KuaiLe}我盖放1张卡，回合结束！
Dialogue: 0,0:05:20.51,0:05:22.66,Default,,0,0,0,,{\fnZCOOL KuaiLe}刚修！你要被那种小鬼
Dialogue: 0,0:05:22.66,0:05:23.97,Default,,0,0,0,,{\fnZCOOL KuaiLe}摆布到什么时候！
Dialogue: 0,0:05:25.53,0:05:26.40,Default,,0,0,0,,{\fnZCOOL KuaiLe}小鬼！？
Dialogue: 0,0:05:26.82,0:05:28.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}（多洛瓦）刚修……你那副样子是怎么回事！？
Dialogue: 0,0:05:29.58,0:05:31.33,Default,,0,0,0,,{\fnZCOOL KuaiLe}你现在所进行的决斗
Dialogue: 0,0:05:31.33,0:05:32.80,Default,,0,0,0,,{\fnZCOOL KuaiLe}连一丝热度都没有！
Dialogue: 0,0:05:33.52,0:05:35.20,Default,,0,0,0,,{\fnZCOOL KuaiLe}你已经忘了吗？
Dialogue: 0,0:05:35.20,0:05:36.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}你的梦想！
Dialogue: 0,0:05:37.16,0:05:40.32,Default,,0,0,0,,{\fnZCOOL KuaiLe}你与我的梦想……回答我，刚修！
Dialogue: 0,0:05:42.59,0:05:45.65,Default,,0,0,0,,{\fnZCOOL KuaiLe}没用的。你的声音传不到。
Dialogue: 0,0:05:50.17,0:05:51.68,Default,,0,0,0,,{\fnZCOOL KuaiLe}我的回合！哈！！
Dialogue: 0,0:05:52.54,0:05:53.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}抽卡！
Dialogue: 0,0:05:53.80,0:05:54.02,Default,,0,0,0,,{\fnZCOOL KuaiLe}我
Dialogue: 0,0:05:54.02,0:05:57.02,Default,,0,0,0,,{\fnZCOOL KuaiLe}召唤燃烧拳击手 兔子拳手！
Dialogue: 0,0:06:00.53,0:06:02.89,Default,,0,0,0,,{\fnZCOOL KuaiLe}我将等级3的援护守卫和
Dialogue: 0,0:06:02.89,0:06:05.05,Default,,0,0,0,,{\fnZCOOL KuaiLe}兔子拳手 进行叠放！
Dialogue: 0,0:06:05.84,0:06:06.99,Default,,0,0,0,,{\fnZCOOL KuaiLe}用2只怪兽
Dialogue: 0,0:06:06.99,0:06:08.96,Default,,0,0,0,,{\fnZCOOL KuaiLe}构建叠放网络！
Dialogue: 0,0:06:09.29,0:06:10.62,Default,,0,0,0,,{\fnZCOOL KuaiLe}超量召唤！
Dialogue: 0,0:06:11.60,0:06:16.38,Default,,0,0,0,,{\fnZCOOL KuaiLe}一切皆随我意身披黑色权威 入场吧！
Dialogue: 0,0:06:19.90,0:06:23.17,Default,,0,0,0,,{\fnZCOOL KuaiLe}(有栖)燃烧拳击手 首席辅导员！
Dialogue: 0,0:06:24.37,0:06:27.38,Default,,0,0,0,,{\fnZCOOL KuaiLe}然后用 首席辅导员 攻击霍普。
Dialogue: 0,0:06:29.66,0:06:32.12,Default,,0,0,0,,{\fnZCOOL KuaiLe}用攻击力零的怪兽来攻击！？
Dialogue: 0,0:06:32.69,0:06:34.08,Default,,0,0,0,,{\fnZCOOL KuaiLe}别大意 游马！
Dialogue: 0,0:06:34.77,0:06:37.66,Default,,0,0,0,,{\fnZCOOL KuaiLe}在这个瞬间首席辅导员的效果 发动。
Dialogue: 0,0:06:38.24,0:06:40.03,Default,,0,0,0,,{\fnZCOOL KuaiLe}这只怪兽 进行战斗时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:06:40.41,0:06:42.65,Default,,0,0,0,,{\fnZCOOL KuaiLe}场上的 所有怪兽
Dialogue: 0,0:06:42.65,0:06:43.85,Default,,0,0,0,,{\fnZCOOL KuaiLe}变为攻击表示。
Dialogue: 0,0:06:45.57,0:06:48.16,Default,,0,0,0,,{\fnZCOOL KuaiLe}强制战斗姿态！
Dialogue: 0,0:06:58.14,0:07:00.93,Default,,0,0,0,,{\fnZCOOL KuaiLe}作弊委员的进一步效果 发动！
Dialogue: 0,0:07:01.62,0:07:03.63,Default,,0,0,0,,{\fnZCOOL KuaiLe}当场上存在己方怪兽时
Dialogue: 0,0:07:03.63,0:07:05.90,Default,,0,0,0,,{\fnZCOOL KuaiLe}正在战斗中的作弊委员{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:07:06.21,0:07:09.18,Default,,0,0,0,,{\fnZCOOL KuaiLe}自己场上的怪兽和被替换！
Dialogue: 0,0:07:11.62,0:07:13.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}怪兽被替换了！
Dialogue: 0,0:07:13.87,0:07:15.34,Default,,0,0,0,,{\fnZCOOL KuaiLe}我们的生命值是400。
Dialogue: 0,0:07:15.86,0:07:18.83,Default,,0,0,0,,{\fnZCOOL KuaiLe}若受到狮心效果影响这次一定……
Dialogue: 0,0:07:19.64,0:07:22.18,Default,,0,0,0,,{\fnZCOOL KuaiLe}没错 这次一定做个了断！
Dialogue: 0,0:07:22.96,0:07:23.79,Default,,0,0,0,,{\fnZCOOL KuaiLe}（抽卡）陷阱 发动！
Dialogue: 0,0:07:24.99,0:07:26.04,Default,,0,0,0,,{\fnZCOOL KuaiLe}幻蝶的雄姿。
Dialogue: 0,0:07:26.73,0:07:28.66,Default,,0,0,0,,{\fnZCOOL KuaiLe}对方怪兽攻击过来时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:07:28.92,0:07:30.29,Default,,0,0,0,,{\fnZCOOL KuaiLe}这张卡可以
Dialogue: 0,0:07:30.29,0:07:31.74,Default,,0,0,0,,{\fnZCOOL KuaiLe}自己场上的{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:07:32.01,0:07:35.26,Default,,0,0,0,,{\fnZCOOL KuaiLe}将攻击表示的冠有幻蝶之名的怪兽可以更改。
Dialogue: 0,0:07:39.12,0:07:40.27,Default,,0,0,0,,{\fnZCOOL KuaiLe}来吧 豪修！
Dialogue: 0,0:07:40.80,0:07:42.86,Default,,0,0,0,,{\fnZCOOL KuaiLe}多洛华…你这么做的话，你自己会！
Dialogue: 0,0:07:43.50,0:07:45.63,Default,,0,0,0,,{\fnZCOOL KuaiLe}狮心怪物的效果发动！
Dialogue: 0,0:07:46.17,0:07:47.93,Default,,0,0,0,,{\fnZCOOL KuaiLe}燃烧十字反击！
Dialogue: 0,0:08:02.26,0:08:02.92,Default,,0,0,0,,{\fnZCOOL KuaiLe}德罗瓦！
Dialogue: 0,0:08:04.90,0:08:06.59,Default,,0,0,0,,{\fnZCOOL KuaiLe}我没事。
Dialogue: 0,0:08:06.88,0:08:08.04,Default,,0,0,0,,{\fnZCOOL KuaiLe}比起这个，戈修呢？
Dialogue: 0,0:08:09.46,0:08:12.38,Default,,0,0,0,,{\fnZCOOL KuaiLe}还没完！狮心效果 发动。
Dialogue: 0,0:08:13.29,0:08:16.01,Default,,0,0,0,,{\fnZCOOL KuaiLe}将一张超量单元 使用，
Dialogue: 0,0:08:16.01,0:08:17.41,Default,,0,0,0,,{\fnZCOOL KuaiLe}救赎冲击！
Dialogue: 0,0:08:26.37,0:08:27.76,Default,,0,0,0,,{\fnZCOOL KuaiLe}戈… 戈修！
Dialogue: 0,0:08:31.01,0:08:31.70,Default,,0,0,0,,{\fnZCOOL KuaiLe}这样 就好。
Dialogue: 0,0:08:32.53,0:08:33.76,Default,,0,0,0,,{\fnZCOOL KuaiLe}阿里特… 你这家伙！
Dialogue: 0,0:08:34.28,0:08:34.91,Default,,0,0,0,,{\fnZCOOL KuaiLe}戈修…。
Dialogue: 0,0:08:38.48,0:08:40.36,Default,,0,0,0,,{\fnZCOOL KuaiLe}这就是 你现在的气势吗。
Dialogue: 0,0:08:41.10,0:08:42.94,Default,,0,0,0,,{\fnZCOOL KuaiLe}用那种死鱼眼一样的决斗{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:08:43.36,0:08:46.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}成为孩子们的希望之星你觉得你能做到吗！？
Dialogue: 0,0:08:46.81,0:08:50.12,Default,,0,0,0,,{\fnZCOOL KuaiLe}所以 我不是说了你的声音传不到吗！
Dialogue: 0,0:08:50.82,0:08:53.23,Default,,0,0,0,,{\fnZCOOL KuaiLe}盖放１张 卡 回合结束。
Dialogue: 0,0:08:54.42,0:08:55.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}我的回合 抽卡！
Dialogue: 0,0:08:56.92,0:08:59.92,Default,,0,0,0,,{\fnZCOOL KuaiLe}我 召唤幻蝶刺客 摩尔芙。
Dialogue: 0,0:09:04.06,0:09:07.58,Default,,0,0,0,,{\fnZCOOL KuaiLe}再特殊召唤 幻蝶的刺客 欧欧尔莉。
Dialogue: 0,0:09:09.04,0:09:10.69,Default,,0,0,0,,{\fnZCOOL KuaiLe}自己场上 以攻击表示
Dialogue: 0,0:09:10.69,0:09:12.14,Default,,0,0,0,,{\fnZCOOL KuaiLe}有怪兽被召唤时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:09:12.66,0:09:14.88,Default,,0,0,0,,{\fnZCOOL KuaiLe}从手牌可以特殊召唤。
Dialogue: 0,0:09:16.68,0:09:17.02,Default,,0,0,0,,{\fnZCOOL KuaiLe}我将
Dialogue: 0,0:09:17.02,0:09:21.41,Default,,0,0,0,,{\fnZCOOL KuaiLe}等级4的 幻蝶刺客 摩尔芙 欧欧尔莉 叠放！
Dialogue: 0,0:09:22.16,0:09:23.18,Default,,0,0,0,,{\fnZCOOL KuaiLe}用3只怪兽
Dialogue: 0,0:09:23.18,0:09:24.93,Default,,0,0,0,,{\fnZCOOL KuaiLe}构建叠放网络。
Dialogue: 0,0:09:25.29,0:09:26.50,Default,,0,0,0,,{\fnZCOOL KuaiLe}超量召唤！
Dialogue: 0,0:09:27.64,0:09:31.05,Default,,0,0,0,,{\fnZCOOL KuaiLe}舞于黑暗的 美丽死亡化身……
Dialogue: 0,0:09:31.61,0:09:33.57,Default,,0,0,0,,{\fnZCOOL KuaiLe}夜蝶刺客！
Dialogue: 0,0:09:36.49,0:09:38.42,Default,,0,0,0,,{\fnZCOOL KuaiLe}攻击力 2600！？
Dialogue: 0,0:09:39.10,0:09:41.84,Default,,0,0,0,,{\fnZCOOL KuaiLe}但是 就算攻击力再高{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:09:42.29,0:09:44.85,Default,,0,0,0,,{\fnZCOOL KuaiLe}对手是狮心的话反而 会变得不利。
Dialogue: 0,0:09:45.74,0:09:46.67,Default,,0,0,0,,{\fnZCOOL KuaiLe}再 从手牌
Dialogue: 0,0:09:46.67,0:09:49.79,Default,,0,0,0,,{\fnZCOOL KuaiLe}发动魔法卡 叠放捕获。
Dialogue: 0,0:09:51.04,0:09:52.85,Default,,0,0,0,,{\fnZCOOL KuaiLe}这张卡 可以夺取对手怪兽的
Dialogue: 0,0:09:52.85,0:09:54.34,Default,,0,0,0,,{\fnZCOOL KuaiLe}1个叠放单位{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:09:54.85,0:09:56.45,Default,,0,0,0,,{\fnZCOOL KuaiLe}成为自己怪兽世界的
Dialogue: 0,0:09:56.45,0:09:57.78,Default,,0,0,0,,{\fnZCOOL KuaiLe}超量单位。
Dialogue: 0,0:09:58.52,0:09:59.54,Default,,0,0,0,,{\fnZCOOL KuaiLe}好耶！
Dialogue: 0,0:09:59.82,0:10:00.67,Default,,0,0,0,,{\fnZCOOL KuaiLe}只要狮心队的
Dialogue: 0,0:10:00.67,0:10:02.20,Default,,0,0,0,,{\fnZCOOL KuaiLe}超量单位没了{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:02.48,0:10:03.96,Default,,0,0,0,,{\fnZCOOL KuaiLe}救援冲击就没法用了。
Dialogue: 0,0:10:04.40,0:10:05.32,Default,,0,0,0,,{\fnZCOOL KuaiLe}《等着我，豪舒。
Dialogue: 0,0:10:05.96,0:10:08.11,Default,,0,0,0,,{\fnZCOOL KuaiLe}我会把你从那家伙的咒缚中解放出来》
Dialogue: 0,0:10:10.56,0:10:11.28,Default,,0,0,0,,{\fnZCOOL KuaiLe}蠢货。
Dialogue: 0,0:10:12.06,0:10:14.76,Default,,0,0,0,,{\fnZCOOL KuaiLe}陷阱发动 世界·战斗·连锁！
Dialogue: 0,0:10:15.36,0:10:16.94,Default,,0,0,0,,{\fnZCOOL KuaiLe}这张卡在双方场上
Dialogue: 0,0:10:16.94,0:10:18.64,Default,,0,0,0,,{\fnZCOOL KuaiLe}都有怪兽世界的情况下{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:19.10,0:10:21.67,Default,,0,0,0,,{\fnZCOOL KuaiLe}将以怪兽世界为对象发动的
Dialogue: 0,0:10:21.67,0:10:24.40,Default,,0,0,0,,{\fnZCOOL KuaiLe}魔法、陷阱无效并破坏。
Dialogue: 0,0:10:26.38,0:10:27.57,Default,,0,0,0,,{\fnZCOOL KuaiLe}（抽卡）超量单位！
Dialogue: 0,0:10:28.88,0:10:31.49,Default,,0,0,0,,{\fnZCOOL KuaiLe}并且，这个效果{\fnNoto Sans CJK SC}➡{\fnZCOOL KuaiLe}在未进行战斗的
Dialogue: 0,0:10:31.49,0:10:33.09,Default,,0,0,0,,{\fnZCOOL KuaiLe}对方回合发动时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:33.46,0:10:35.14,Default,,0,0,0,,{\fnZCOOL KuaiLe}将对方的怪兽世界与
Dialogue: 0,0:10:35.14,0:10:37.16,Default,,0,0,0,,{\fnZCOOL KuaiLe}我方的怪兽世界1体{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:10:37.48,0:10:39.82,Default,,0,0,0,,{\fnZCOOL KuaiLe}可以强制进行战斗。
Dialogue: 0,0:10:40.24,0:10:41.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}什么！？
Dialogue: 0,0:10:41.40,0:10:44.49,Default,,0,0,0,,{\fnZCOOL KuaiLe}先拿你开刀，把你砸个稀巴烂。抽卡！
Dialogue: 0,0:10:44.95,0:10:46.92,Default,,0,0,0,,{\fnZCOOL KuaiLe}糟了，再这样被狮子之心
Dialogue: 0,0:10:46.92,0:10:48.24,Default,,0,0,0,,{\fnZCOOL KuaiLe}的效果打中的话……
Dialogue: 0,0:10:48.59,0:10:49.16,Default,,0,0,0,,{\fnZCOOL KuaiLe}抽卡！
Dialogue: 0,0:10:50.33,0:10:54.08,Default,,0,0,0,,{\fnZCOOL KuaiLe}《凭现在的我，已经没有能逆转这个局面的手段了。
Dialogue: 0,0:10:55.11,0:10:56.75,Default,,0,0,0,,{\fnZCOOL KuaiLe}虽然不甘心，但看来只能到此为止了》
Dialogue: 0,0:11:01.07,0:11:01.60,Default,,0,0,0,,{\fnZCOOL KuaiLe}《后攻……》
Dialogue: 0,0:11:03.34,0:11:05.26,Default,,0,0,0,,{\fnZCOOL KuaiLe}上吧，狮子之心
Dialogue: 0,0:11:05.26,0:11:08.30,Default,,0,0,0,,{\fnZCOOL KuaiLe}攻击骑士蝶·刺客！
Dialogue: 0,0:11:10.95,0:11:13.60,Default,,0,0,0,,{\fnZCOOL KuaiLe}骑士蝶·刺客的效果发动！
Dialogue: 0,0:11:14.78,0:11:16.41,Default,,0,0,0,,{\fnZCOOL KuaiLe}使用1个超量单元{\fnNoto Sans CJK SC}→
Dialogue: 0,0:11:16.86,0:11:18.12,Default,,0,0,0,,{\fnZCOOL KuaiLe}场上每有1个
Dialogue: 0,0:11:18.12,0:11:19.57,Default,,0,0,0,,{\fnZCOOL KuaiLe}超量单元{\fnNoto Sans CJK SC}→
Dialogue: 0,0:11:19.95,0:11:22.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}攻击力就提升400点。
Dialogue: 0,0:11:23.32,0:11:25.05,Default,,0,0,0,,{\fnZCOOL KuaiLe}超量单元一共有5个。
Dialogue: 0,0:11:25.05,0:11:26.77,Default,,0,0,0,,{\fnZCOOL KuaiLe}因此提升2000点。
Dialogue: 0,0:11:27.48,0:11:29.05,Default,,0,0,0,,{\fnZCOOL KuaiLe}蠢货。鬼迷心窍了吗。
Dialogue: 0,0:11:29.82,0:11:31.52,Default,,0,0,0,,{\fnZCOOL KuaiLe}攻击力4600！？
Dialogue: 0,0:11:32.14,0:11:34.96,Default,,0,0,0,,{\fnZCOOL KuaiLe}明明伤害也会反弹到自己身上为什么？
Dialogue: 0,0:11:36.33,0:11:39.94,Default,,0,0,0,,{\fnZCOOL KuaiLe}那4600并不只是攻击力的数值。
Dialogue: 0,0:11:40.34,0:11:40.69,Default,,0,0,0,,{\fnZCOOL KuaiLe}哎？
Dialogue: 0,0:11:41.76,0:11:44.24,Default,,0,0,0,,{\fnZCOOL KuaiLe}那可以说是对游城所怀有的
Dialogue: 0,0:11:44.24,0:11:45.90,Default,,0,0,0,,{\fnZCOOL KuaiLe}多罗瓦的思念之强。
Dialogue: 0,0:11:46.86,0:11:49.08,Default,,0,0,0,,{\fnZCOOL KuaiLe}多罗瓦现在正将自己所拥有的一切
Dialogue: 0,0:11:49.08,0:11:50.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}全部砸出去{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:11:50.74,0:11:53.47,Default,,0,0,0,,{\fnZCOOL KuaiLe}试图将被洗脑的游城的心给夺回来。
Dialogue: 0,0:11:54.32,0:11:55.26,Default,,0,0,0,,{\fnZCOOL KuaiLe}上啊～！
Dialogue: 0,0:11:55.64,0:11:58.04,Default,,0,0,0,,{\fnZCOOL KuaiLe}把我现在的一切都砸向游城{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:11:58.64,0:12:02.43,Default,,0,0,0,,{\fnZCOOL KuaiLe}唤醒那家伙作为决斗者的灵魂！
Dialogue: 0,0:12:03.12,0:12:04.09,Default,,0,0,0,,{\fnZCOOL KuaiLe}游城！！
Dialogue: 0,0:12:04.38,0:12:09.42,Default,,0,0,0,,{\fnZCOOL KuaiLe}接住我的……全部吧！！
Dialogue: 0,0:12:14.20,0:12:15.00,Default,,0,0,0,,{\fnZCOOL KuaiLe}多洛华！！
Dialogue: 0,0:12:20.97,0:12:22.97,Default,,0,0,0,,{\fnZCOOL KuaiLe}喂 多洛华！ 振作点。
Dialogue: 0,0:12:23.73,0:12:25.53,Default,,0,0,0,,{\fnZCOOL KuaiLe}抱歉 游马。
Dialogue: 0,0:12:25.79,0:12:27.58,Default,,0,0,0,,{\fnZCOOL KuaiLe}你在说什么啊 多洛华！
Dialogue: 0,0:12:28.34,0:12:29.87,Default,,0,0,0,,{\fnZCOOL KuaiLe}我只能到此为止了。
Dialogue: 0,0:12:30.48,0:12:32.11,Default,,0,0,0,,{\fnZCOOL KuaiLe}但是我的怪兽
Dialogue: 0,0:12:32.11,0:12:34.12,Default,,0,0,0,,{\fnZCOOL KuaiLe}还留在场上。
Dialogue: 0,0:12:35.36,0:12:38.82,Default,,0,0,0,,{\fnZCOOL KuaiLe}我把夜蝶刺客托付给你。
Dialogue: 0,0:12:39.21,0:12:39.71,Default,,0,0,0,,{\fnZCOOL KuaiLe}多洛华？
Dialogue: 0,0:12:40.60,0:12:42.27,Default,,0,0,0,,{\fnZCOOL KuaiLe}然后 拜托你搞定哥修。
Dialogue: 0,0:12:42.97,0:12:45.48,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马 是你的话一定……。
Dialogue: 0,0:12:46.43,0:12:48.65,Default,,0,0,0,,{\fnZCOOL KuaiLe}喂 多洛华。多洛华！！
Dialogue: 0,0:12:50.66,0:12:52.62,Default,,0,0,0,,{\fnZCOOL KuaiLe}发动狮心效果。
Dialogue: 0,0:12:52.99,0:12:55.37,Default,,0,0,0,,{\fnZCOOL KuaiLe}使用一个超量素材
Dialogue: 0,0:12:55.37,0:12:56.85,Default,,0,0,0,,{\fnZCOOL KuaiLe}救援冲击！
Dialogue: 0,0:12:59.15,0:12:59.97,Default,,0,0,0,,{\fnZCOOL KuaiLe}哥修！
Dialogue: 0,0:13:00.68,0:13:03.20,Default,,0,0,0,,{\fnZCOOL KuaiLe}喂 大块头 赶紧给我起来！
Dialogue: 0,0:13:03.93,0:13:05.54,Default,,0,0,0,,{\fnZCOOL KuaiLe}你 你这家伙！！
Dialogue: 0,0:13:07.64,0:13:10.02,Default,,0,0,0,,{\fnZCOOL KuaiLe}而且我还要发动陷阱。
Dialogue: 0,0:13:10.02,0:13:13.02,Default,,0,0,0,,{\fnZCOOL KuaiLe}No.超量增幅！
Dialogue: 0,0:13:13.75,0:13:14.45,Default,,0,0,0,,{\fnZCOOL KuaiLe}这张卡是
Dialogue: 0,0:13:14.45,0:13:16.42,Default,,0,0,0,,{\fnZCOOL KuaiLe}场上的1只「No.」怪兽{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:13:16.69,0:13:19.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}当它失去所有超量素材时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:13:19.36,0:13:20.23,Default,,0,0,0,,{\fnZCOOL KuaiLe}从手牌将2张
Dialogue: 0,0:13:20.23,0:13:22.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}作为那只「No.」怪兽的超量素材！
Dialogue: 0,0:13:23.41,0:13:26.65,Default,,0,0,0,,{\fnZCOOL KuaiLe}来吧 这次一定要给游马致命一击！
Dialogue: 0,0:13:27.36,0:13:28.03,Default,,0,0,0,,{\fnZCOOL KuaiLe}唔呃……
Dialogue: 0,0:13:29.57,0:13:31.76,Default,,0,0,0,,{\fnZCOOL KuaiLe}我的回合。抽卡！
Dialogue: 0,0:13:33.27,0:13:35.78,Default,,0,0,0,,{\fnZCOOL KuaiLe}《哦 抽到了「巴利安之力」吗。
Dialogue: 0,0:13:36.42,0:13:39.45,Default,,0,0,0,,{\fnZCOOL KuaiLe}嘛 照这个局势也用不着那张卡了》
Dialogue: 0,0:13:39.69,0:13:41.15,Default,,0,0,0,,{\fnZCOOL KuaiLe}啧 不妙啊。
Dialogue: 0,0:13:41.69,0:13:44.53,Default,,0,0,0,,{\fnZCOOL KuaiLe}再这样下去 要是被用出「狮心」的效果的话……
Dialogue: 0,0:13:45.10,0:13:46.49,Default,,0,0,0,,{\fnZCOOL KuaiLe}(阿里特)来吧 你在磨蹭什么。
Dialogue: 0,0:13:46.89,0:13:48.40,Default,,0,0,0,,{\fnZCOOL KuaiLe}赶紧用「狮心」
Dialogue: 0,0:13:48.40,0:13:50.54,Default,,0,0,0,,{\fnZCOOL KuaiLe}把游马和阿斯特拉尔葬送掉！
Dialogue: 0,0:13:54.44,0:13:57.87,Default,,0,0,0,,{\fnZCOOL KuaiLe}我发动装备魔法「棍棒挑战」！
Dialogue: 0,0:13:59.45,0:14:00.08,Default,,0,0,0,,{\fnZCOOL KuaiLe}(3人)啊！
Dialogue: 0,0:14:00.83,0:14:02.71,Default,,0,0,0,,{\fnZCOOL KuaiLe}(哥什)这张卡是 将自己怪兽
Dialogue: 0,0:14:02.71,0:14:04.02,Default,,0,0,0,,{\fnZCOOL KuaiLe}超量素材{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:04.34,0:14:06.34,Default,,0,0,0,,{\fnZCOOL KuaiLe}全部送去墓地来装备{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:06.89,0:14:09.11,Default,,0,0,0,,{\fnZCOOL KuaiLe}每送去墓地一个超量素材{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:09.31,0:14:11.32,Default,,0,0,0,,{\fnZCOOL KuaiLe}攻击力上升600点。
Dialogue: 0,0:14:12.51,0:14:15.47,Default,,0,0,0,,{\fnZCOOL KuaiLe}并且战斗造成的伤害翻倍。
Dialogue: 0,0:14:16.05,0:14:17.92,Default,,0,0,0,,{\fnZCOOL KuaiLe}你 你这家伙 到底想干什么？
Dialogue: 0,0:14:18.26,0:14:20.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}但是装备了这张卡的怪兽
Dialogue: 0,0:14:20.13,0:14:22.00,Default,,0,0,0,,{\fnZCOOL KuaiLe}在下个自己的回合会被破坏。
Dialogue: 0,0:14:23.29,0:14:26.02,Default,,0,0,0,,{\fnZCOOL KuaiLe}为什么 要给狮心提升攻击力啊。
Dialogue: 0,0:14:26.43,0:14:28.87,Default,,0,0,0,,{\fnZCOOL KuaiLe}并且 发动装备魔法 英雄礼赞
Dialogue: 0,0:14:28.87,0:14:30.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}装备给狮心。
Dialogue: 0,0:14:30.97,0:14:33.66,Default,,0,0,0,,{\fnZCOOL KuaiLe}这张卡在自己的生命值比对方低的情况下{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:14:34.04,0:14:36.34,Default,,0,0,0,,{\fnZCOOL KuaiLe}装备怪兽的攻击力翻倍。
Dialogue: 0,0:14:37.54,0:14:40.32,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马的生命值是400。戈什是100。
Dialogue: 0,0:14:40.49,0:14:41.28,Default,,0,0,0,,{\fnZCOOL KuaiLe}也就是说……
Dialogue: 0,0:14:47.38,0:14:49.34,Default,,0,0,0,,{\fnZCOOL KuaiLe}已经超过了霍普的攻击力。
Dialogue: 0,0:14:50.75,0:14:51.25,Default,,0,0,0,,{\fnZCOOL KuaiLe}戈什。
Dialogue: 0,0:15:00.37,0:15:02.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}是吗，原来是这么回事。
Dialogue: 0,0:15:02.76,0:15:04.37,Default,,0,0,0,,{\fnZCOOL KuaiLe}戈什，总算
Dialogue: 0,0:15:04.37,0:15:05.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}开始有点状态了嘛。
Dialogue: 0,0:15:08.94,0:15:11.49,Default,,0,0,0,,{\fnZCOOL KuaiLe}用狮子心攻击霍普。
Dialogue: 0,0:15:15.60,0:15:18.96,Default,,0,0,0,,{\fnZCOOL KuaiLe}然后因为杖之挑战的效果{\fnNoto Sans CJK SC}➡{\fnZCOOL KuaiLe} 伤害会变成2倍。
Dialogue: 0,0:15:19.87,0:15:23.07,Default,,0,0,0,,{\fnZCOOL KuaiLe}我盖放1张卡，回合结束。
Dialogue: 0,0:15:25.01,0:15:26.65,Default,,0,0,0,,{\fnZCOOL KuaiLe}不可能，为什么那家伙……
Dialogue: 0,0:15:26.85,0:15:27.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}就是这样啊，戈什。
Dialogue: 0,0:15:29.52,0:15:33.57,Default,,0,0,0,,{\fnZCOOL KuaiLe}炽热的正面较量那就是你的战斗方式！
Dialogue: 0,0:15:33.89,0:15:35.94,Default,,0,0,0,,{\fnZCOOL KuaiLe}难道说，洗脑解除了？
Dialogue: 0,0:15:36.11,0:15:36.67,Default,,0,0,0,,{\fnZCOOL KuaiLe}不对。
Dialogue: 0,0:15:36.91,0:15:37.22,Default,,0,0,0,,{\fnZCOOL KuaiLe}哎？
Dialogue: 0,0:15:37.74,0:15:40.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}戈什的意识仍然处于被洗脑的状态。
Dialogue: 0,0:15:40.66,0:15:43.07,Default,,0,0,0,,{\fnZCOOL KuaiLe}但是德罗瓦的全力一击
Dialogue: 0,0:15:43.48,0:15:45.59,Default,,0,0,0,,{\fnZCOOL KuaiLe}撼动了被束缚的那家伙的灵魂{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:15:46.13,0:15:47.45,Default,,0,0,0,,{\fnZCOOL KuaiLe}并刻入了细胞之中。
Dialogue: 0,0:15:47.90,0:15:50.19,Default,,0,0,0,,{\fnZCOOL KuaiLe}唤醒了作为决斗者的本能。
Dialogue: 0,0:15:50.81,0:15:53.88,Default,,0,0,0,,{\fnZCOOL KuaiLe}这才是 这个姿态才是真正的决斗者！
Dialogue: 0,0:15:55.95,0:15:56.85,Default,,0,0,0,,{\fnZCOOL KuaiLe}来吧 戈休！
Dialogue: 0,0:15:57.15,0:15:59.38,Default,,0,0,0,,{\fnZCOOL KuaiLe}你的全部本事我都接下了。
Dialogue: 0,0:16:00.48,0:16:02.90,Default,,0,0,0,,{\fnZCOOL KuaiLe}我的回合 抽卡！
Dialogue: 0,0:16:03.47,0:16:05.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}多洛瓦 我不会让你的心意白费！
Dialogue: 0,0:16:06.48,0:16:09.87,Default,,0,0,0,,{\fnZCOOL KuaiLe}我发动魔法卡 超量变换。
Dialogue: 0,0:16:10.66,0:16:13.53,Default,,0,0,0,,{\fnZCOOL KuaiLe}这张卡是通过将自己场上的怪兽超量
Dialogue: 0,0:16:13.53,0:16:14.77,Default,,0,0,0,,{\fnZCOOL KuaiLe}1只送去墓地{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:16:15.40,0:16:18.35,Default,,0,0,0,,{\fnZCOOL KuaiLe}将与它相同阶级的怪兽特殊召唤。
Dialogue: 0,0:16:19.40,0:16:22.61,Default,,0,0,0,,{\fnZCOOL KuaiLe}现身吧 英雄冠军 圣剑士。
Dialogue: 0,0:16:26.25,0:16:28.87,Default,,0,0,0,,{\fnZCOOL KuaiLe}并且 超量变换会成为特殊召唤出的
Dialogue: 0,0:16:28.87,0:16:30.92,Default,,0,0,0,,{\fnZCOOL KuaiLe}怪兽的超量单位。
Dialogue: 0,0:16:31.81,0:16:34.70,Default,,0,0,0,,{\fnZCOOL KuaiLe}戈休 这家伙是作为炽热决斗的证明{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:16:35.41,0:16:37.92,Default,,0,0,0,,{\fnZCOOL KuaiLe}这是你托付给我的怪兽。
Dialogue: 0,0:16:39.78,0:16:43.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}我用 艾克斯卡利巴 攻击 狮心。
Dialogue: 0,0:16:43.46,0:16:45.72,Default,,0,0,0,,{\fnZCOOL KuaiLe}同时 发动怪兽效果！
Dialogue: 0,0:16:46.24,0:16:48.03,Default,,0,0,0,,{\fnZCOOL KuaiLe}使用超量单位
Dialogue: 0,0:16:48.03,0:16:50.35,Default,,0,0,0,,{\fnZCOOL KuaiLe}这回合攻击力变成２倍。
Dialogue: 0,0:16:51.42,0:16:52.64,Default,,0,0,0,,{\fnZCOOL KuaiLe}想得美！
Dialogue: 0,0:16:53.44,0:16:55.63,Default,,0,0,0,,{\fnZCOOL KuaiLe}陷阱发动 巴特拉兹呐喊。
Dialogue: 0,0:16:56.49,0:16:58.76,Default,,0,0,0,,{\fnZCOOL KuaiLe}对方怪兽的攻击力提升时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:16:59.36,0:17:01.96,Default,,0,0,0,,{\fnZCOOL KuaiLe}我的怪兽攻击力变成２倍。
Dialogue: 0,0:17:03.55,0:17:07.10,Default,,0,0,0,,{\fnZCOOL KuaiLe}好啊 好啊越来越热血沸腾了！
Dialogue: 0,0:17:07.28,0:17:07.69,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马。
Dialogue: 0,0:17:07.90,0:17:08.36,Default,,0,0,0,,{\fnZCOOL KuaiLe}哦！
Dialogue: 0,0:17:09.30,0:17:11.69,Default,,0,0,0,,{\fnZCOOL KuaiLe}陷阱发动 灵魂一击。
Dialogue: 0,0:17:12.14,0:17:12.74,Default,,0,0,0,,{\fnZCOOL KuaiLe}这张卡
Dialogue: 0,0:17:12.74,0:17:14.70,Default,,0,0,0,,{\fnZCOOL KuaiLe}在自己生命值 2000以下时{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:17:15.05,0:17:16.61,Default,,0,0,0,,{\fnZCOOL KuaiLe}支付自己一半生命值{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:17:17.16,0:17:19.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}战斗期间支付了多少生命值点数{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:17:20.58,0:17:23.15,Default,,0,0,0,,{\fnZCOOL KuaiLe}就提升1只怪兽的攻击力！
Dialogue: 0,0:17:23.58,0:17:25.36,Default,,0,0,0,,{\fnZCOOL KuaiLe}哼 没用的。那样的话
Dialogue: 0,0:17:25.36,0:17:27.60,Default,,0,0,0,,{\fnZCOOL KuaiLe}攻击力只能提升100而已。
Dialogue: 0,0:17:29.66,0:17:31.89,Default,,0,0,0,,{\fnZCOOL KuaiLe}怎 怎么了 狮子心。
Dialogue: 0,0:17:33.26,0:17:34.47,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马真正的目标是
Dialogue: 0,0:17:34.47,0:17:37.16,Default,,0,0,0,,{\fnZCOOL KuaiLe}把自己的生命值变成和戈什一样的100。
Dialogue: 0,0:17:38.72,0:17:39.17,Default,,0,0,0,,{\fnZCOOL KuaiLe}什么？
Dialogue: 0,0:17:40.13,0:17:42.38,Default,,0,0,0,,{\fnZCOOL KuaiLe}装备魔法 英雄成长的效果是{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:17:42.75,0:17:44.68,Default,,0,0,0,,{\fnZCOOL KuaiLe}生命值相同时不会发动。
Dialogue: 0,0:17:45.44,0:17:48.40,Default,,0,0,0,,{\fnZCOOL KuaiLe}狮子心的攻击力因  stick·challenge
Dialogue: 0,0:17:48.40,0:17:49.68,Default,,0,0,0,,{\fnZCOOL KuaiLe}而提升到1300{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:17:50.22,0:17:52.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}再因英雄成长 变成其2倍。
Dialogue: 0,0:17:52.62,0:17:55.09,Default,,0,0,0,,{\fnZCOOL KuaiLe}用蝴蝶斩再变成其2倍。
Dialogue: 0,0:17:55.68,0:17:57.36,Default,,0,0,0,,{\fnZCOOL KuaiLe}但是 英雄成长的
Dialogue: 0,0:17:57.36,0:17:59.62,Default,,0,0,0,,{\fnZCOOL KuaiLe}效果消失后 变成了2600。
Dialogue: 0,0:18:00.05,0:18:01.16,Default,,0,0,0,,{\fnZCOOL KuaiLe}怎… 怎么会…。
Dialogue: 0,0:18:03.16,0:18:06.69,Default,,0,0,0,,{\fnZCOOL KuaiLe}上啊！！用Excalibur 给他致命一击！
Dialogue: 0,0:18:08.71,0:18:10.64,Default,,0,0,0,,{\fnZCOOL KuaiLe}来吧 游马！！
Dialogue: 0,0:18:11.72,0:18:12.68,Default,,0,0,0,,{\fnZCOOL KuaiLe}开什么玩笑！
Dialogue: 0,0:18:12.68,0:18:15.09,Default,,0,0,0,,{\fnZCOOL KuaiLe}发动「啦啦队女孩」的效果！
Dialogue: 0,0:18:15.78,0:18:17.61,Default,,0,0,0,,{\fnZCOOL KuaiLe}除了这只怪兽以外在战斗的时候{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:18:18.01,0:18:20.09,Default,,0,0,0,,{\fnZCOOL KuaiLe}将超级计量单位全部使用的话{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:18:20.57,0:18:22.73,Default,,0,0,0,,{\fnZCOOL KuaiLe}对方的手牌中如果有魔法卡的话{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:18:23.05,0:18:25.73,Default,,0,0,0,,{\fnZCOOL KuaiLe}结束战斗并将其发动！
Dialogue: 0,0:18:26.28,0:18:27.26,Default,,0,0,0,,{\fnZCOOL KuaiLe}来吧，戈什。
Dialogue: 0,0:18:27.26,0:18:29.75,Default,,0,0,0,,{\fnZCOOL KuaiLe}使用那张卡！「壁垒之力」！
Dialogue: 0,0:18:30.32,0:18:31.44,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马，就是现在！
Dialogue: 0,0:18:31.77,0:18:32.35,Default,,0,0,0,,{\fnZCOOL KuaiLe}哦！
Dialogue: 0,0:18:32.99,0:18:35.66,Default,,0,0,0,,{\fnZCOOL KuaiLe}发动陷阱！「超级计量标记」！
Dialogue: 0,0:18:37.69,0:18:39.44,Default,,0,0,0,,{\fnZCOOL KuaiLe}这张卡在战斗时
Dialogue: 0,0:18:39.80,0:18:42.00,Default,,0,0,0,,{\fnZCOOL KuaiLe}怪兽额外卡组{\fnNoto Sans CJK SC}➡{\fnZCOOL KuaiLe} 将超级计量单位
Dialogue: 0,0:18:42.00,0:18:43.08,Default,,0,0,0,,{\fnZCOOL KuaiLe}全部用完的情况下{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:18:43.70,0:18:46.24,Default,,0,0,0,,{\fnZCOOL KuaiLe}将发动的效果无效并破坏。
Dialogue: 0,0:18:46.98,0:18:48.82,Default,,0,0,0,,{\fnZCOOL KuaiLe}然后 将那只怪兽的过量单位
Dialogue: 0,0:18:48.82,0:18:50.30,Default,,0,0,0,,{\fnZCOOL KuaiLe}给予控制它的玩家{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:18:50.64,0:18:54.45,Default,,0,0,0,,{\fnZCOOL KuaiLe}战斗中怪兽的攻击力{\fnNoto Sans CJK SC}➡{\fnZCOOL KuaiLe} 合计造成伤害！
Dialogue: 0,0:18:54.67,0:18:58.13,Default,,0,0,0,,{\fnZCOOL KuaiLe}哦… 我受到6700的伤害！？
Dialogue: 0,0:18:58.45,0:18:59.48,Default,,0,0,0,,{\fnZCOOL KuaiLe}接招吧 有栖…
Dialogue: 0,0:19:00.05,0:19:02.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}我和戈修炽热的灵魂！！
Dialogue: 0,0:19:18.46,0:19:18.88,Default,,0,0,0,,{\fnZCOOL KuaiLe}《这…
Dialogue: 0,0:19:21.82,0:19:22.82,Default,,0,0,0,,{\fnZCOOL KuaiLe}这段记忆是…》
Dialogue: 0,0:19:42.40,0:19:44.57,Default,,0,0,0,,{\fnZCOOL KuaiLe}真是的… 让人捏了把汗啊。
Dialogue: 0,0:19:45.58,0:19:46.30,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马…。
Dialogue: 0,0:19:47.82,0:19:49.50,Default,,0,0,0,,{\fnZCOOL KuaiLe}(有栖)怎… 怎么了…。
Dialogue: 0,0:19:51.30,0:19:53.42,Default,,0,0,0,,{\fnZCOOL KuaiLe}到底怎么回事啊！！ 刚才那个！
Dialogue: 0,0:19:57.14,0:19:57.73,Default,,0,0,0,,{\fnZCOOL KuaiLe}有栖…。
Dialogue: 0,0:20:01.22,0:20:02.76,Default,,0,0,0,,{\fnZCOOL KuaiLe}戈… 戈修！
Dialogue: 0,0:20:06.22,0:20:06.97,Default,,0,0,0,,{\fnZCOOL KuaiLe}戈修！
Dialogue: 0,0:20:06.97,0:20:08.87,Default,,0,0,0,,{\fnZCOOL KuaiLe}喂 振作点。 喂！
Dialogue: 0,0:20:11.40,0:20:13.47,Default,,0,0,0,,{\fnZCOOL KuaiLe}我 到底做了什么…
Dialogue: 0,0:20:18.51,0:20:20.17,Default,,0,0,0,,{\fnZCOOL KuaiLe}啊啊… 有啊…。
Dialogue: 0,0:20:20.91,0:20:23.37,Default,,0,0,0,,{\fnZCOOL KuaiLe}老爸 这次也守护着我啊。
Dialogue: 0,0:20:25.10,0:20:28.28,Default,,0,0,0,,{\fnZCOOL KuaiLe}(轰)游马 你也太见外了吧。
Dialogue: 0,0:20:29.18,0:20:30.84,Default,,0,0,0,,{\fnZCOOL KuaiLe}既然在跟巴利安干架
Dialogue: 0,0:20:30.84,0:20:32.11,Default,,0,0,0,,{\fnZCOOL KuaiLe}为啥不跟我说啊。
Dialogue: 0,0:20:32.52,0:20:35.58,Default,,0,0,0,,{\fnZCOOL KuaiLe}要揍扁那群家伙的话我也来助你一臂之力。
Dialogue: 0,0:20:35.74,0:20:36.52,Default,,0,0,0,,{\fnZCOOL KuaiLe}笨蛋！
Dialogue: 0,0:20:37.16,0:20:39.02,Default,,0,0,0,,{\fnZCOOL KuaiLe}你还有和德罗瓦的梦想吧！
Dialogue: 0,0:20:39.90,0:20:42.00,Default,,0,0,0,,{\fnZCOOL KuaiLe}成为孩子们的希望之星的梦想。
Dialogue: 0,0:20:43.05,0:20:44.36,Default,,0,0,0,,{\fnZCOOL KuaiLe}对吧？轰。
Dialogue: 0,0:20:45.23,0:20:46.03,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马…
Dialogue: 0,0:20:48.98,0:20:49.96,Default,,0,0,0,,{\fnZCOOL KuaiLe}是啊。
Dialogue: 0,0:20:53.32,0:21:05.17,Default,,0,0,0,,{\fnZCOOL KuaiLe}{\fnNoto Sans CJK SC}≪{\fnZCOOL KuaiLe}轰！轰！
Dialogue: 0,0:20:54.53,0:20:57.73,Default,,0,0,0,,{\fnZCOOL KuaiLe}[麦克风]成功了！轰·星人！
Dialogue: 0,0:20:58.18,0:21:00.61,Default,,0,0,0,,{\fnZCOOL KuaiLe}[麦克风]斯巴达城
Dialogue: 0,0:21:00.61,0:21:03.03,Default,,0,0,0,,{\fnZCOOL KuaiLe}新的冠军诞生了！
Dialogue: 0,0:21:05.49,0:21:07.73,Default,,0,0,0,,{\fnZCOOL KuaiLe}轰·星人 好棒！
Dialogue: 0,0:21:07.96,0:21:09.27,Default,,0,0,0,,{\fnZCOOL KuaiLe}轰·星人
Dialogue: 0,0:21:09.27,0:21:11.15,Default,,0,0,0,,{\fnZCOOL KuaiLe}我也努力的话能变强吗？
Dialogue: 0,0:21:11.64,0:21:12.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}嗯。
Dialogue: 0,0:21:13.76,0:21:15.06,Default,,0,0,0,,{\fnZCOOL KuaiLe}当然，能变强的。
Dialogue: 0,0:21:16.29,0:21:18.91,Default,,0,0,0,,{\fnZCOOL KuaiLe}(高修)就像天上闪耀的星星一样。
Dialogue: 0,0:21:21.62,0:21:23.12,Default,,0,0,0,,{\fnZCOOL KuaiLe}(小鸟)真是的！为什么
Dialogue: 0,0:21:23.12,0:21:24.56,Default,,0,0,0,,{\fnZCOOL KuaiLe}不叫我起来啊！！
Dialogue: 0,0:21:24.81,0:21:26.46,Default,,0,0,0,,{\fnZCOOL KuaiLe}居然只把我一个人丢下！
Dialogue: 0,0:21:27.16,0:21:29.61,Default,,0,0,0,,{\fnZCOOL KuaiLe}对不起。觉得叫醒你也不太好……
Dialogue: 0,0:21:29.94,0:21:31.16,Default,,0,0,0,,{\fnZCOOL KuaiLe}可是，就算这样……
Dialogue: 0,0:21:31.42,0:21:32.60,Default,,0,0,0,,{\fnZCOOL KuaiLe}(轨道7)就为这点事
Dialogue: 0,0:21:32.60,0:21:33.88,Default,,0,0,0,,{\fnZCOOL KuaiLe}还抱怨，真是太奢侈了。
Dialogue: 0,0:21:33.93,0:21:35.78,Default,,0,0,0,,{\fnZCOOL KuaiLe}俺可是……
Dialogue: 0,0:21:39.55,0:21:39.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}游马。
Dialogue: 0,0:21:42.44,0:21:44.27,Default,,0,0,0,,{\fnZCOOL KuaiLe}你是在想阿斯特拉尔的事吗。
Dialogue: 0,0:21:45.39,0:21:46.75,Default,,0,0,0,,{\fnZCOOL KuaiLe}昨天的决斗你应该明白了吧？
Dialogue: 0,0:21:47.70,0:21:48.98,Default,,0,0,0,,{\fnZCOOL KuaiLe}果然，他是巴利安。
Dialogue: 0,0:21:49.45,0:21:52.60,Default,,0,0,0,,{\fnZCOOL KuaiLe}很遗憾，和我们是无法相容的存在。
Dialogue: 0,0:21:53.63,0:21:56.72,Default,,0,0,0,,{\fnZCOOL KuaiLe}《阿斯特拉尔……为什么你会{\fnNoto Sans CJK SC}➡{\fnZCOOL KuaiLe}变成那副样子
Dialogue: 0,0:21:56.72,0:21:57.66,Default,,0,0,0,,{\fnZCOOL KuaiLe}我搞不懂。
Dialogue: 0,0:21:58.54,0:22:00.09,Default,,0,0,0,,{\fnZCOOL KuaiLe}但是，我相信。
Dialogue: 0,0:22:01.09,0:22:03.04,Default,,0,0,0,,{\fnZCOOL KuaiLe}就像那时候一样和你来一场货真价实{\fnNoto Sans CJK SC}➡
Dialogue: 0,0:22:03.68,0:22:05.77,Default,,0,0,0,,{\fnZCOOL KuaiLe}彼此碰撞炽热信念的决斗
Dialogue: 0,0:22:05.77,0:22:07.79,Default,,0,0,0,,{\fnZCOOL KuaiLe}的那一天 一定会再次…到来》
Dialogue: 0,0:23:41.37,0:23:43.24,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:43.74,0:23:46.56,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:47.53,0:23:49.42,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:50.01,0:23:52.04,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:52.35,0:23:54.18,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:54.51,0:23:55.74,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:55.95,0:23:57.49,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:23:57.76,0:23:59.15,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:24:00.05,0:24:01.64,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:24:02.09,0:24:03.52,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:24:04.04,0:24:05.29,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:24:06.21,0:24:07.58,Default,,0,0,0,,{\fnZCOOL KuaiLe}
Dialogue: 0,0:24:07.58,0:24:09.58,Default,,0,0,0,,{\fnZCOOL KuaiLe}END


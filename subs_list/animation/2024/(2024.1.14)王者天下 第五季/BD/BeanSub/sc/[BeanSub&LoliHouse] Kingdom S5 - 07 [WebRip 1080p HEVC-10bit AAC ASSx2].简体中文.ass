Dialogue: 0,0:01:32.00,0:01:40.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕组制作 仅供学习交流 禁止用于商业用途
Comment: 0,0:00:01.00,0:00:01.05,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:00:22.23,0:00:28.66,op-jp,,0,0,0,,滴る汗と日差しで閉じた目
Dialogue: 0,0:00:28.66,0:00:34.91,op-jp,,0,0,0,,映し出したのはあなたとの約束
Dialogue: 0,0:00:34.91,0:00:41.55,op-jp,,0,0,0,,意志を紡いだ導火線に火をつけたら
Dialogue: 0,0:00:41.55,0:00:47.30,op-jp,,0,0,0,,今より強く高く翔べる
Dialogue: 0,0:00:47.30,0:00:54.03,op-jp,,0,0,0,,恐れを知って哀を知って進むなら
Dialogue: 0,0:00:54.03,0:01:01.50,op-jp,,0,0,0,,己の全て捧げ旗を上げろ
Dialogue: 0,0:01:01.50,0:01:07.07,op-jp,,0,0,0,,掠れた声を何度も張りあげてよ
Dialogue: 0,0:01:07.07,0:01:11.95,op-jp,,0,0,0,,希望を決意を抱いて
Dialogue: 0,0:00:22.23,0:00:28.66,op-cn,,0,0,0,,汗水滚落 烈日当头 我闭上双眼
Dialogue: 0,0:00:28.66,0:00:34.91,op-cn,,0,0,0,,眼中映出 与你的约定
Dialogue: 0,0:00:34.91,0:00:41.55,op-cn,,0,0,0,,点燃以意志织成的导火线
Dialogue: 0,0:00:41.55,0:00:47.30,op-cn,,0,0,0,,向着更高更强 振翅高飞
Dialogue: 0,0:00:47.30,0:00:54.03,op-cn,,0,0,0,,知晓恐惧 知晓哀伤 前进不息
Dialogue: 0,0:00:54.03,0:01:01.50,op-cn,,0,0,0,,献出一切 高举旗帜
Dialogue: 0,0:01:01.50,0:01:07.07,op-cn,,0,0,0,,无数次发出嘶吼
Dialogue: 0,0:01:07.07,0:01:11.95,op-cn,,0,0,0,,心怀希望 坚定决心
Comment: 0,0:23:15.96,0:23:15.96,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:27.05,0:23:30.00,ed-jp,,0,0,1,,なぁ坊やどうした？ここは戦場だぜ
Dialogue: 0,0:23:30.00,0:23:32.83,ed-jp,,0,0,1,,たぎる憎悪のラリー　背馳の成長過程
Dialogue: 0,0:23:32.83,0:23:35.64,ed-jp,,0,0,1,,加減も知らず殺気立ったままの剣に
Dialogue: 0,0:23:35.64,0:23:38.81,ed-jp,,0,0,1,,発汗する体　カルマか咎　如何に？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-jp,,0,0,1,,恒　現実は不調和な旋律さ
Dialogue: 0,0:23:41.28,0:23:44.29,ed-jp,,0,0,1,,冷血なステンレス製の心臓持つ演説者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-jp,,0,0,1,,何回目の明滅　また凱旋するテンペスタ
Dialogue: 0,0:23:46.94,0:23:50.04,ed-jp,,0,0,1,,アーチかける善悪　もう応答しない生存者
Dialogue: 0,0:23:51.14,0:23:53.78,ed-jp,,0,0,0,,花のよう　咲うＭｙ　Ｒｅｄ
Dialogue: 0,0:23:53.95,0:24:02.32,ed-jp,,0,0,0,,守りたいものだって　この掌離れれば
Dialogue: 0,0:24:02.48,0:24:09.95,ed-jp,,0,0,0,,壊したいものなんて　壊せないものだけ
Dialogue: 0,0:24:11.85,0:24:17.59,ed-jp,,0,0,0,,唸る　その狂気が　花咲かすダリア
Dialogue: 0,0:24:17.59,0:24:20.31,ed-jp,,0,0,0,,振りかざす度　歪んだ定規
Dialogue: 0,0:24:20.31,0:24:23.15,ed-jp,,0,0,0,,反射する対照的な正義
Dialogue: 0,0:24:23.15,0:24:28.82,ed-jp,,0,0,0,,裏切りのゲリラ　散らす羽たちが
Dialogue: 0,0:24:28.82,0:24:31.80,ed-jp,,0,0,0,,飛ぶ鳥の蹴った地面のようさ
Dialogue: 0,0:24:31.80,0:24:36.87,ed-jp,,0,0,0,,君にもあるんでしょう？キズツケタクナイモノ
Dialogue: 0,0:23:27.05,0:23:30.00,ed-cn,,0,0,0,,怎么了小弟弟？这里可是战场
Dialogue: 0,0:23:30.00,0:23:32.83,ed-cn,,0,0,0,,是憎恶翻腾的拉力赛 与成长背道而驰
Dialogue: 0,0:23:32.83,0:23:35.64,ed-cn,,0,0,0,,不知轻重 利剑杀气腾腾
Dialogue: 0,0:23:35.64,0:23:38.81,ed-cn,,0,0,0,,汗流浃背 是业是罪 如何判定？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-cn,,0,0,0,,现实永远是不和谐旋律
Dialogue: 0,0:23:41.28,0:23:44.29,ed-cn,,0,0,0,,拥有钢铁心脏的冷血演讲者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-cn,,0,0,0,,第几次电闪雷鸣 暴风雨再次凯旋
Dialogue: 0,0:23:46.94,0:23:50.04,ed-cn,,0,0,0,,善恶架上彩虹 生还者已无应答
Dialogue: 0,0:23:51.14,0:23:53.78,ed-cn,,0,0,0,,如花般绽放笑容 My Red
Dialogue: 0,0:23:53.95,0:24:02.32,ed-cn,,0,0,0,,想要守护之物 离开掌中便无从守护
Dialogue: 0,0:24:02.48,0:24:09.95,ed-cn,,0,0,0,,想要毁灭之物 全都是无法毁灭之物
Dialogue: 0,0:24:11.85,0:24:17.59,ed-cn,,0,0,0,,呻吟不止 疯狂如盛开的大丽花
Dialogue: 0,0:24:17.59,0:24:20.31,ed-cn,,0,0,0,,标尺一经举起 立刻扭曲
Dialogue: 0,0:24:20.31,0:24:23.15,ed-cn,,0,0,0,,反射出对立的正义
Dialogue: 0,0:24:23.15,0:24:28.82,ed-cn,,0,0,0,,叛逆的游击 散落的羽翼
Dialogue: 0,0:24:28.82,0:24:31.80,ed-cn,,0,0,0,,如飞鸟蹬踏的地面一般
Dialogue: 0,0:24:31.80,0:24:36.87,ed-cn,,0,0,0,,你一定也有不愿伤害之物
Dialogue: 0,0:01:34.49,0:01:37.70,biaoti,,0,0,0,,{\fad(480,480)}离眼的悲剧
Dialogue: 0,0:01:34.16,0:01:38.99,Default,,0,0,0,,应该是15年前的事了
Dialogue: 0,0:01:39.56,0:01:41.39,Default,,0,0,0,,纪彗大人他们
Dialogue: 0,0:01:42.04,0:01:47.39,Default,,0,0,0,,眼看着包括时任城主在内的几乎所有离眼成年人
Dialogue: 0,0:01:48.24,0:01:51.38,Default,,0,0,0,,被全部杀死
Dialogue: 0,0:01:52.76,0:01:57.64,Default,,0,0,0,,那个时候 离眼一带尚未统一
Dialogue: 0,0:01:58.00,0:01:59.77,Default,,0,0,0,,当时的离眼城
Dialogue: 0,0:02:00.22,0:02:04.41,Default,,0,0,0,,还是前一任纪昌在担任城主
Dialogue: 0,0:02:05.98,0:02:08.06,Default,,0,0,0,,当时那一带
Dialogue: 0,0:02:08.26,0:02:13.95,Default,,0,0,0,,离眼和暗何两座城 在争夺地区霸权
Dialogue: 0,0:02:14.45,0:02:19.07,Default,,0,0,0,,王都邯郸似乎将其视为小规模冲突
Dialogue: 0,0:02:19.07,0:02:22.11,Default,,0,0,0,,但实际却是激烈的战争
Dialogue: 0,0:02:22.68,0:02:25.93,Default,,0,0,0,,暗何的唐寒 以暴力压迫治理城池
Dialogue: 0,0:02:26.40,0:02:29.56,Default,,0,0,0,,而离眼的纪昌 因仁德亲善颇得民心
Dialogue: 0,0:02:29.56,0:02:32.66,Default,,0,0,0,,城池上下一心
Dialogue: 0,0:02:33.32,0:02:36.90,Default,,0,0,0,,暗何的兵力比离眼多一倍有余
Dialogue: 0,0:02:37.06,0:02:42.63,Default,,0,0,0,,但纪昌骁勇善战 其亲信猛将云集
Dialogue: 0,0:02:43.07,0:02:47.11,Default,,0,0,0,,军队训练有素
Dialogue: 0,0:02:47.11,0:02:49.53,Default,,0,0,0,,使得离眼与暗何势均力敌
Dialogue: 0,0:02:49.84,0:02:53.76,Default,,0,0,0,,年轻将领 纪彗 刘冬 马呈也锋芒渐露
Dialogue: 0,0:02:53.88,0:02:57.20,Default,,0,0,0,,离眼开始逐渐占据优势
Dialogue: 0,0:02:57.95,0:03:00.32,Default,,0,0,0,,竟然这就快结束了
Dialogue: 0,0:03:00.39,0:03:02.58,Default,,0,0,0,,看来派援军是多此一举了
Dialogue: 0,0:03:03.06,0:03:05.64,Default,,0,0,0,,虽然我们本就很看好他们
Dialogue: 0,0:03:06.02,0:03:10.09,Default,,0,0,0,,看来那三人非同寻常啊 城主
Dialogue: 0,0:03:10.55,0:03:11.24,Default,,0,0,0,,是啊
Dialogue: 0,0:03:11.54,0:03:14.09,Default,,0,0,0,,身为父亲 我实在欣慰之至
Dialogue: 0,0:03:14.66,0:03:18.97,Default,,0,0,0,,纪昌是刘冬和马呈的养父
Dialogue: 0,0:03:19.48,0:03:22.42,Default,,0,0,0,,二人似乎是纪昌已故心腹之子
Dialogue: 0,0:03:22.99,0:03:27.59,Default,,0,0,0,,所以此二人与纪彗情同手足
Dialogue: 0,0:03:28.38,0:03:31.36,Default,,0,0,0,,面对声势渐盛的离眼
Dialogue: 0,0:03:31.46,0:03:34.11,Default,,0,0,0,,暗何发起了决战
Dialogue: 0,0:03:34.60,0:03:39.05,Default,,0,0,0,,那就是这一带有名的「旦虎之战」
Dialogue: 0,0:03:39.42,0:03:41.54,Default,,0,0,0,,离眼举全军迎战
Dialogue: 0,0:03:41.54,0:03:45.71,Default,,0,0,0,,而暗何军凭借财力召集周边军队
Dialogue: 0,0:03:45.71,0:03:47.87,Default,,0,0,0,,其兵力为离眼的五倍
Dialogue: 0,0:03:48.68,0:03:51.29,Default,,0,0,0,,听说那是一场激烈异常的战斗
Dialogue: 0,0:03:52.11,0:03:55.71,Default,,0,0,0,,刘冬和马呈也在激战中身受重伤
Dialogue: 0,0:03:56.23,0:03:57.72,Default,,0,0,0,,不过最后
Dialogue: 0,0:03:59.76,0:04:02.58,Default,,0,0,0,,纪彗冲破五倍的敌军
Dialogue: 0,0:04:02.58,0:04:05.64,Default,,0,0,0,,亲手击杀暗何城主唐寒
Dialogue: 0,0:04:05.94,0:04:08.47,Default,,0,0,0,,离眼取得了战斗的胜利
Dialogue: 0,0:04:09.36,0:04:13.40,Default,,0,0,0,,如果这是真的 那赵将纪彗一定本领高强
Dialogue: 0,0:04:13.98,0:04:17.51,Default,,0,0,0,,那时一定也有许多人欣喜地以为
Dialogue: 0,0:04:17.51,0:04:21.41,Default,,0,0,0,,纪昌的统治范围将就此扩大
Dialogue: 0,0:04:22.04,0:04:22.89,Default,,0,0,0,,然而
Dialogue: 0,0:04:23.08,0:04:26.68,Default,,0,0,0,,离眼与暗何那长久的恩怨
Dialogue: 0,0:04:26.68,0:04:29.96,Default,,0,0,0,,并没有因旦虎之战而终结
Dialogue: 0,0:04:31.32,0:04:35.84,Default,,0,0,0,,就在纪彗军追击唐寒残部时
Dialogue: 0,0:04:35.84,0:04:40.22,Default,,0,0,0,,防守空虚的离眼城被攻陷了
Dialogue: 0,0:04:40.80,0:04:44.85,Default,,0,0,0,,攻城者是唐寒之子 唐钓
Dialogue: 0,0:04:45.51,0:04:51.62,Default,,0,0,0,,唐钓生性懦弱 未参加旦虎之战而留在了暗何城
Dialogue: 0,0:04:51.70,0:04:55.86,Default,,0,0,0,,他带领城内为数不多的卫兵 发起了奇袭
Dialogue: 0,0:04:56.35,0:05:00.99,Default,,0,0,0,,他虽不成器 似乎却还是有为父报仇的孝心
Dialogue: 0,0:05:01.43,0:05:06.87,Default,,0,0,0,,当时的离眼守军 只有从旦虎归来的重伤兵
Dialogue: 0,0:05:07.06,0:05:10.82,Default,,0,0,0,,马呈和刘冬也在城内
Dialogue: 0,0:05:07.54,0:05:09.49,zhu,,0,0,0,,该死的
Dialogue: 0,0:05:09.49,0:05:10.82,zhu,,0,0,0,,刘冬
Dialogue: 0,0:05:10.82,0:05:14.35,Default,,0,0,0,,但二人一定也无计可施
Dialogue: 0,0:05:15.00,0:05:17.41,Default,,0,0,0,,总而言之 离眼陷落
Dialogue: 0,0:05:17.48,0:05:23.00,Default,,0,0,0,,城内的老弱妇孺全都成了人质
Dialogue: 0,0:05:23.99,0:05:27.99,Default,,0,0,0,,而唐钓以人质为筹码
Dialogue: 0,0:05:28.28,0:05:32.60,Default,,0,0,0,,逼迫纪昌与其手下将士投降
Dialogue: 0,0:05:33.24,0:05:34.72,Default,,0,0,0,,不可以 父亲
Dialogue: 0,0:05:34.82,0:05:36.53,Default,,0,0,0,,去了一定会被杀
Dialogue: 0,0:05:36.85,0:05:38.25,Default,,0,0,0,,对方太卑鄙了
Dialogue: 0,0:05:38.76,0:05:42.36,Default,,0,0,0,,唐钓答应了放过未成年者
Dialogue: 0,0:05:42.76,0:05:44.28,Default,,0,0,0,,一定不会再作让步
Dialogue: 0,0:05:44.72,0:05:45.74,Default,,0,0,0,,父亲
Dialogue: 0,0:05:46.18,0:05:47.28,Default,,0,0,0,,城主大人
Dialogue: 0,0:05:47.85,0:05:51.22,Default,,0,0,0,,岳印 你为何不劝阻我父亲
Dialogue: 0,0:05:51.49,0:05:54.14,Default,,0,0,0,,要是去了 你们也会性命不保
Dialogue: 0,0:05:54.56,0:05:55.67,Default,,0,0,0,,赫公 你也是
Dialogue: 0,0:05:56.33,0:06:00.36,Default,,0,0,0,,要是不去 我们留在城内的孩子就会被杀
Dialogue: 0,0:06:03.28,0:06:04.14,Default,,0,0,0,,彗
Dialogue: 0,0:06:05.19,0:06:09.28,Default,,0,0,0,,唐钓企图以妇孺为人质 换取武将之首级
Dialogue: 0,0:06:09.28,0:06:12.93,Default,,0,0,0,,我们是故意应允了这一卑劣之举
Dialogue: 0,0:06:14.11,0:06:19.50,Default,,0,0,0,,我们虽是绝不逊于中央的强大武将
Dialogue: 0,0:06:20.22,0:06:24.32,Default,,0,0,0,,但我不仅是武将 更是离眼城主
Dialogue: 0,0:06:24.88,0:06:28.47,Default,,0,0,0,,而我的亲信们 亦是离眼的成年人
Dialogue: 0,0:06:29.64,0:06:34.21,Default,,0,0,0,,父母为孩子豁出性命是理所当然
Dialogue: 0,0:06:34.85,0:06:37.96,Default,,0,0,0,,而虽有些过早
Dialogue: 0,0:06:38.46,0:06:40.96,Default,,0,0,0,,这一职责就由你继承了
Dialogue: 0,0:06:41.38,0:06:42.53,Default,,0,0,0,,吾儿啊
Dialogue: 0,0:06:45.22,0:06:48.22,Default,,0,0,0,,随后双方开始了人质交换
Dialogue: 0,0:06:48.51,0:06:49.76,Default,,0,0,0,,城主大人
Dialogue: 0,0:06:49.76,0:06:51.18,Default,,0,0,0,,纪昌大人
Dialogue: 0,0:06:51.59,0:06:53.52,Default,,0,0,0,,怎么会这样
Dialogue: 0,0:06:53.52,0:06:54.81,Default,,0,0,0,,之后就拜托大家了
Dialogue: 0,0:06:55.04,0:06:58.36,Default,,0,0,0,,我这老骨头活着也无益啊
Dialogue: 0,0:06:58.77,0:07:02.08,Default,,0,0,0,,这不是为了你们 是为了孩子们
Dialogue: 0,0:07:03.47,0:07:04.40,Default,,0,0,0,,城主
Dialogue: 0,0:07:05.03,0:07:06.50,Default,,0,0,0,,请恕罪
Dialogue: 0,0:07:06.60,0:07:09.02,Default,,0,0,0,,我明明就在城内…
Dialogue: 0,0:07:09.42,0:07:11.54,Default,,0,0,0,,{\pos(1332.8,1067)}却成了这样…
Dialogue: 0,0:07:09.31,0:07:11.54,Default,,0,0,0,,{\pos(536,1067)}不 都怪我
Dialogue: 0,0:07:11.61,0:07:13.92,Default,,0,0,0,,{\pos(536,1067)}我竟会成了人质
Dialogue: 0,0:07:11.84,0:07:13.06,Default,,0,0,0,,{\pos(1332.8,1067)}请恕罪
Dialogue: 0,0:07:15.04,0:07:17.09,Default,,0,0,0,,城主请恕罪
Dialogue: 0,0:07:19.49,0:07:20.20,Default,,0,0,0,,没关系
Dialogue: 0,0:07:20.64,0:07:24.13,Default,,0,0,0,,感谢上天 你们还活着
Dialogue: 0,0:07:24.77,0:07:25.51,Default,,0,0,0,,刘冬
Dialogue: 0,0:07:27.16,0:07:28.01,Default,,0,0,0,,马呈
Dialogue: 0,0:07:29.90,0:07:31.45,Default,,0,0,0,,彗就拜托你们照顾了
Dialogue: 0,0:07:34.42,0:07:35.28,Default,,0,0,0,,对了
Dialogue: 0,0:07:36.38,0:07:37.79,Default,,0,0,0,,这个还给你们
Dialogue: 0,0:07:38.56,0:07:40.84,Default,,0,0,0,,也象征着你们的独当一面
Dialogue: 0,0:07:43.03,0:07:47.20,Default,,0,0,0,,我名为善满 奉王都邯郸之命而来
Dialogue: 0,0:07:47.63,0:07:52.41,Default,,0,0,0,,此次人质交换 将在朝廷见证之下进行
Dialogue: 0,0:07:52.80,0:07:53.60,Default,,0,0,0,,这意味着
Dialogue: 0,0:07:53.68,0:07:55.08,Default,,0,0,0,,交换完成后
Dialogue: 0,0:07:55.27,0:08:01.46,Default,,0,0,0,,暗何不得以任何方式 加害离眼残兵及老弱妇孺
Dialogue: 0,0:08:01.84,0:08:05.79,Default,,0,0,0,,若违背约定 则视为与朝廷为敌
Dialogue: 0,0:08:05.79,0:08:09.42,Default,,0,0,0,,我善满军将以武力给予制裁
Dialogue: 0,0:08:09.56,0:08:10.72,Default,,0,0,0,,明白了吗
Dialogue: 0,0:08:12.00,0:08:15.72,Default,,0,0,0,,邯郸若是更早派兵前来仲裁就好了
Dialogue: 0,0:08:17.74,0:08:18.63,Default,,0,0,0,,是吗
Dialogue: 0,0:08:19.76,0:08:22.60,Default,,0,0,0,,他就是在旦虎击杀了唐寒的纪彗啊
Dialogue: 0,0:08:23.73,0:08:25.44,Default,,0,0,0,,都绑上去
Dialogue: 0,0:08:32.37,0:08:38.96,Default,,0,0,0,,唐钓 谢谢你答应放过我儿子等人
Dialogue: 0,0:08:40.72,0:08:42.19,Default,,0,0,0,,你别误会了
Dialogue: 0,0:08:42.69,0:08:45.21,Default,,0,0,0,,这是为了让他们尝尝同样的痛苦
Dialogue: 0,0:08:46.59,0:08:47.60,Default,,0,0,0,,是吗
Dialogue: 0,0:08:47.98,0:08:49.65,Default,,0,0,0,,该死 该死的
Dialogue: 0,0:08:50.13,0:08:51.67,Default,,0,0,0,,点火
Dialogue: 0,0:08:55.04,0:08:55.76,Default,,0,0,0,,纪昌大人
Dialogue: 0,0:08:55.76,0:08:56.82,Default,,0,0,0,,父亲
Dialogue: 0,0:08:56.82,0:08:58.98,Default,,0,0,0,,城主大人
Dialogue: 0,0:08:59.69,0:09:02.94,Default,,0,0,0,,彗就是离眼的新城主
Dialogue: 0,0:09:03.97,0:09:07.17,Default,,0,0,0,,他就是年轻的父亲 众人要辅佐他
Dialogue: 0,0:09:07.78,0:09:08.53,Default,,0,0,0,,是
Dialogue: 0,0:09:08.79,0:09:10.12,Default,,0,0,0,,城主
Dialogue: 0,0:09:10.12,0:09:11.78,Default,,0,0,0,,遵命
Dialogue: 0,0:09:14.06,0:09:15.13,Default,,0,0,0,,彗
Dialogue: 0,0:09:17.19,0:09:19.92,Default,,0,0,0,,保护好离眼的子民
Dialogue: 0,0:09:20.61,0:09:23.13,Default,,0,0,0,,托付给你了 吾儿
Dialogue: 0,0:09:25.69,0:09:27.88,Default,,0,0,0,,是 定不辱使命
Dialogue: 0,0:09:33.29,0:09:37.34,Default,,0,0,0,,所以纪彗之名才没有外传啊
Dialogue: 0,0:09:37.85,0:09:38.60,Default,,0,0,0,,对
Dialogue: 0,0:09:39.31,0:09:41.31,Default,,0,0,0,,那场处刑
Dialogue: 0,0:09:41.46,0:09:44.98,Default,,0,0,0,,几乎杀死了所有作为离眼主心骨的成年人
Dialogue: 0,0:09:45.34,0:09:50.45,Default,,0,0,0,,而纪彗大人仅用五年就复兴了离眼
Dialogue: 0,0:09:50.61,0:09:56.62,Default,,0,0,0,,又用三年击败暗何 成了这一带的盟主
Dialogue: 0,0:09:57.56,0:10:01.75,Default,,0,0,0,,他为政以德 治下无人有怨言
Dialogue: 0,0:10:03.48,0:10:06.45,Default,,0,0,0,,那个人偶又是什么
Dialogue: 0,0:10:07.10,0:10:12.01,Default,,0,0,0,,这是「守护儿」 是离眼自古以来的习俗
Dialogue: 0,0:10:12.59,0:10:18.82,Default,,0,0,0,,由孩子送给即将上前线的父亲 充当护身符
Dialogue: 0,0:10:19.95,0:10:23.20,Default,,0,0,0,,砍伤我的刘冬拿着三个
Dialogue: 0,0:10:23.84,0:10:25.33,Default,,0,0,0,,所以他有三个孩子？
Dialogue: 0,0:10:25.82,0:10:27.90,Default,,0,0,0,,这我就不知道了
Dialogue: 0,0:10:29.04,0:10:31.99,Default,,0,0,0,,等等 你是被刘冬砍伤的？
Dialogue: 0,0:10:33.62,0:10:34.76,Default,,0,0,0,,也罢
Dialogue: 0,0:10:35.56,0:10:38.48,Default,,0,0,0,,总而言之 纪彗军很强
Dialogue: 0,0:10:38.83,0:10:42.85,Default,,0,0,0,,纪昌时期就战胜了五倍于己的暗何军
Dialogue: 0,0:10:43.20,0:10:46.30,Default,,0,0,0,,而听说他们现在要远强于过去
Dialogue: 0,0:10:47.03,0:10:51.43,Default,,0,0,0,,而且为阻止敌人穿过黑羊 他们士气也很高
Dialogue: 0,0:10:52.19,0:10:52.87,Default,,0,0,0,,怎么样
Dialogue: 0,0:10:53.25,0:10:57.12,Default,,0,0,0,,是不是觉得还是留在这里别回部队更好了
Dialogue: 0,0:10:57.70,0:10:58.49,Default,,0,0,0,,恰恰相反
Dialogue: 0,0:11:00.16,0:11:03.21,Default,,0,0,0,,既然是强敌 那我就更要回到同伴身边
Dialogue: 0,0:11:04.72,0:11:06.20,Default,,0,0,0,,不论是怎样的对手
Dialogue: 0,0:11:07.46,0:11:09.35,Default,,0,0,0,,我们都不能输
Dialogue: 0,0:11:11.35,0:11:15.63,Default,,0,0,0,,黑羊第三天的夜晚 在近乎瘆人的安静中渐深
Dialogue: 0,0:11:18.35,0:11:19.16,Default,,0,0,0,,夜过之后
Dialogue: 0,0:11:20.01,0:11:23.88,Default,,0,0,0,,第四天的朝阳 就像昭示着最激烈的战斗一般
Dialogue: 0,0:11:24.03,0:11:26.22,Default,,0,0,0,,如血般鲜红
Dialogue: 0,0:11:33.63,0:11:34.51,Default,,0,0,0,,什么？
Dialogue: 0,0:11:35.14,0:11:37.97,Default,,0,0,0,,要我们就这样坚守在原地？
Dialogue: 0,0:11:38.54,0:11:39.39,Default,,0,0,0,,怎么了？
Dialogue: 0,0:11:39.84,0:11:43.35,Default,,0,0,0,,好像桓骑将军的传令兵一大早就来了
Dialogue: 0,0:11:44.74,0:11:45.71,Default,,0,0,0,,我告诉你
Dialogue: 0,0:11:45.89,0:11:49.01,Default,,0,0,0,,都怪你老大白费了昨天的大好机会
Dialogue: 0,0:11:49.09,0:11:51.44,Default,,0,0,0,,这次是我们陷入绝境了
Dialogue: 0,0:11:51.85,0:11:54.79,Default,,0,0,0,,被我们甩掉的马呈军趁着夜晚追了上来
Dialogue: 0,0:11:54.79,0:11:56.70,Default,,0,0,0,,来到我们背后了
Dialogue: 0,0:11:57.21,0:11:58.18,Default,,0,0,0,,再说了
Dialogue: 0,0:11:58.18,0:12:00.88,Default,,0,0,0,,桓骑昨天为什么没行动
Dialogue: 0,0:12:01.65,0:12:03.04,Default,,0,0,0,,不许直呼头儿的名字
Dialogue: 0,0:12:03.48,0:12:04.60,Default,,0,0,0,,等一下 信
Dialogue: 0,0:12:06.10,0:12:08.21,Default,,0,0,0,,不需要他下令
Dialogue: 0,0:12:08.58,0:12:12.24,Default,,0,0,0,,我本就打算在原地能撑多久是多久
Dialogue: 0,0:12:12.76,0:12:13.67,Default,,0,0,0,,理由是…
Dialogue: 0,0:12:14.48,0:12:18.92,Default,,0,0,0,,和昨天一样 只要我们飞信队留在这里
Dialogue: 0,0:12:19.40,0:12:22.00,Default,,0,0,0,,战局就对桓骑军有利
Dialogue: 0,0:12:22.80,0:12:23.59,Default,,0,0,0,,但是
Dialogue: 0,0:12:23.73,0:12:27.89,Default,,0,0,0,,我们背后的敌人可不会放着我们不管
Dialogue: 0,0:12:28.23,0:12:29.39,Default,,0,0,0,,没错
Dialogue: 0,0:12:29.91,0:12:33.32,Default,,0,0,0,,关于这个 头儿让我带话给你们
Dialogue: 0,0:12:33.58,0:12:34.53,Default,,0,0,0,,什么话
Dialogue: 0,0:12:34.98,0:12:36.53,Default,,0,0,0,,他说会派遣援军
Dialogue: 0,0:12:37.53,0:12:38.15,Default,,0,0,0,,援军？
Dialogue: 0,0:12:40.47,0:12:42.00,Default,,0,0,0,,这话可信吗
Dialogue: 0,0:12:42.43,0:12:43.66,Default,,0,0,0,,不知道
Dialogue: 0,0:12:47.92,0:12:48.96,Default,,0,0,0,,好吧
Dialogue: 0,0:12:49.56,0:12:52.92,Default,,0,0,0,,飞信队会在这里撑到撑不住为止
Dialogue: 0,0:12:53.42,0:12:55.81,Default,,0,0,0,,但我估计最多撑到中午
Dialogue: 0,0:12:56.20,0:13:00.30,Default,,0,0,0,,你转告桓骑将军 要派援军就在中午之前
Dialogue: 0,0:13:01.29,0:13:02.38,Default,,0,0,0,,知道了
Dialogue: 0,0:13:07.52,0:13:10.35,Default,,0,0,0,,头儿 要开始了
Dialogue: 0,0:13:14.27,0:13:15.68,Default,,0,0,0,,好了
Dialogue: 0,0:13:17.84,0:13:18.94,Default,,0,0,0,,挡住他们
Dialogue: 0,0:13:19.02,0:13:20.60,Default,,0,0,0,,给我冲
Dialogue: 0,0:13:23.31,0:13:24.63,Default,,0,0,0,,宰了他们
Dialogue: 0,0:13:24.63,0:13:25.41,Default,,0,0,0,,要来了
Dialogue: 0,0:13:26.24,0:13:29.23,Default,,0,0,0,,把昨天的仇加倍奉还
Dialogue: 0,0:13:30.76,0:13:32.75,Default,,0,0,0,,不要贸然接近马呈
Dialogue: 0,0:13:33.17,0:13:36.59,Default,,0,0,0,,把弓箭手集中起来 放箭把他逼退
Dialogue: 0,0:13:38.32,0:13:39.20,Default,,0,0,0,,我们上
Dialogue: 0,0:13:41.76,0:13:42.34,Default,,0,0,0,,貂
Dialogue: 0,0:13:42.86,0:13:45.84,Default,,0,0,0,,我们不去后面真的没问题吗
Dialogue: 0,0:13:46.01,0:13:46.94,Default,,0,0,0,,没问题
Dialogue: 0,0:13:47.11,0:13:51.19,Default,,0,0,0,,我们昨天先到这里 事先占据了所有有利地形
Dialogue: 0,0:13:51.35,0:13:53.35,Default,,0,0,0,,没这么容易被攻破
Dialogue: 0,0:13:53.95,0:13:55.90,Default,,0,0,0,,重点是前面
Dialogue: 0,0:13:56.17,0:14:00.44,Default,,0,0,0,,必须做好准备 桓骑将军一下令就攻上山丘
Dialogue: 0,0:14:02.53,0:14:05.67,Default,,0,0,0,,桓骑他今天真的会下令吗
Dialogue: 0,0:14:06.35,0:14:08.73,Default,,0,0,0,,话说援军连影都没有啊
Dialogue: 0,0:14:20.02,0:14:20.50,Default,,0,0,0,,大姐头
Dialogue: 0,0:14:20.50,0:14:21.33,Default,,0,0,0,,闭嘴
Dialogue: 0,0:14:26.03,0:14:28.25,Default,,0,0,0,,敌军没有要出动的迹象
Dialogue: 0,0:14:28.81,0:14:30.74,Default,,0,0,0,,说不定桓骑今天也…
Dialogue: 0,0:14:33.35,0:14:35.21,Default,,0,0,0,,真是这样也好
Dialogue: 0,0:14:36.28,0:14:41.01,Default,,0,0,0,,刘冬和马呈追上飞信队 使其威胁减半了
Dialogue: 0,0:14:42.24,0:14:45.17,Default,,0,0,0,,只要他们消灭或赶走飞信队
Dialogue: 0,0:14:45.56,0:14:49.24,Default,,0,0,0,,我们就能集中攻击前方的敌人了
Dialogue: 0,0:14:51.04,0:14:53.50,Default,,0,0,0,,虽然不知道你有何意图
Dialogue: 0,0:14:54.26,0:14:57.47,Default,,0,0,0,,你就继续保持不动吧 桓骑
Dialogue: 0,0:15:07.12,0:15:09.85,Default,,0,0,0,,河了貂 渕副长那里危险了
Dialogue: 0,0:15:10.30,0:15:13.10,Default,,0,0,0,,楚水副长的预备兵也耗尽了
Dialogue: 0,0:15:13.44,0:15:14.60,Default,,0,0,0,,我知道
Dialogue: 0,0:15:15.00,0:15:17.86,Default,,0,0,0,,田有去支援渕叔 沛浪去支援楚水
Dialogue: 0,0:15:18.06,0:15:19.31,Default,,0,0,0,,好
Dialogue: 0,0:15:19.81,0:15:21.69,Default,,0,0,0,,可恶 可恶
Dialogue: 0,0:15:22.09,0:15:24.88,Default,,0,0,0,,桓骑那家伙又打算不动吗
Dialogue: 0,0:15:25.97,0:15:28.83,Default,,0,0,0,,截至此时 除飞信队之外
Dialogue: 0,0:15:28.93,0:15:32.51,Default,,0,0,0,,其他战场全都和前一天一样 战况胶着
Dialogue: 0,0:15:39.97,0:15:40.60,Default,,0,0,0,,但是
Dialogue: 0,0:15:44.50,0:15:45.64,Default,,0,0,0,,该死的
Dialogue: 0,0:15:49.09,0:15:50.34,Default,,0,0,0,,该死的
Dialogue: 0,0:15:52.73,0:15:57.26,Default,,0,0,0,,你竟如此执着地不想让我捕捉到动向吗 桓骑
Dialogue: 0,0:16:03.50,0:16:05.81,Default,,0,0,0,,那好啊 桓骑
Dialogue: 0,0:16:07.03,0:16:12.07,Default,,0,0,0,,既然你不动 那我就趁现在砍下你一条手臂
Dialogue: 0,0:16:12.18,0:16:14.75,Default,,0,0,0,,让你真的无法动弹
Dialogue: 0,0:16:15.68,0:16:16.55,Default,,0,0,0,,阳央
Dialogue: 0,0:16:16.70,0:16:17.16,Default,,0,0,0,,在
Dialogue: 0,0:16:18.19,0:16:23.34,Default,,0,0,0,,你那碍眼的右翼 就像抵在我胸前的尖钉
Dialogue: 0,0:16:23.83,0:16:26.52,Default,,0,0,0,,我要去把那飞信队赶尽杀绝
Dialogue: 0,0:16:31.03,0:16:32.70,Default,,0,0,0,,庆舍大人出动了？
Dialogue: 0,0:16:33.15,0:16:34.64,Default,,0,0,0,,敌 敌袭
Dialogue: 0,0:16:34.76,0:16:36.01,Default,,0,0,0,,人数好多
Dialogue: 0,0:16:36.01,0:16:37.35,Default,,0,0,0,,要 要来了
Dialogue: 0,0:16:41.34,0:16:42.73,Default,,0,0,0,,敌袭
Dialogue: 0,0:16:41.69,0:16:42.52,Default,,0,0,0,,{\pos(1352,1067)}是前面
Dialogue: 0,0:16:44.30,0:16:45.32,Default,,0,0,0,,毁灭吧
Dialogue: 0,0:16:47.48,0:16:48.95,Default,,0,0,0,,飞信队
Dialogue: 0,0:16:54.19,0:16:56.29,Default,,0,0,0,,河了貂 危险 快退后
Dialogue: 0,0:16:56.29,0:16:57.29,Default,,0,0,0,,等等
Dialogue: 0,0:16:57.98,0:17:00.93,Default,,0,0,0,,这是想把我们一分为二 糟糕了
Dialogue: 0,0:17:01.59,0:17:05.95,Default,,0,0,0,,而且后方的楚水和渕叔他们正在和马呈军交战
Dialogue: 0,0:17:07.16,0:17:09.03,Default,,0,0,0,,要是前方的敌人攻至我军后方
Dialogue: 0,0:17:09.10,0:17:11.56,Default,,0,0,0,,整支部队就会瞬间瓦解
Dialogue: 0,0:17:12.14,0:17:14.65,Default,,0,0,0,,全力挡住前方攻来的敌军
Dialogue: 0,0:17:14.65,0:17:16.52,Default,,0,0,0,,不能让他们攻至后方
Dialogue: 0,0:17:16.67,0:17:18.36,Default,,0,0,0,,不 不行啊 河了貂
Dialogue: 0,0:17:18.36,0:17:19.92,Default,,0,0,0,,这里也很危险
Dialogue: 0,0:17:19.92,0:17:21.14,Default,,0,0,0,,要 要来了
Dialogue: 0,0:17:21.82,0:17:22.65,Default,,0,0,0,,信
Dialogue: 0,0:17:23.02,0:17:23.98,Default,,0,0,0,,我去了
Dialogue: 0,0:17:24.39,0:17:25.19,Default,,0,0,0,,信
Dialogue: 0,0:17:29.86,0:17:31.41,Default,,0,0,0,,我吕 岳雷
Dialogue: 0,0:17:31.62,0:17:32.87,Default,,0,0,0,,别高兴太早
Dialogue: 0,0:17:33.24,0:17:36.87,Default,,0,0,0,,仅凭我们撑不了太久
Dialogue: 0,0:17:42.67,0:17:44.02,Default,,0,0,0,,敌军不仅人数多
Dialogue: 0,0:17:44.13,0:17:46.83,Default,,0,0,0,,而且每个人都很强
Dialogue: 0,0:17:54.48,0:17:55.96,Default,,0,0,0,,那个人是谁
Dialogue: 0,0:17:56.78,0:17:57.75,Default,,0,0,0,,庆字…
Dialogue: 0,0:17:59.08,0:18:02.46,Default,,0,0,0,,难道他就是赵军主将？
Dialogue: 0,0:18:03.08,0:18:05.81,Default,,0,0,0,,那个手持长刀的年轻男子就是信
Dialogue: 0,0:18:08.65,0:18:12.57,Default,,0,0,0,,李牧大人指名将桓骑与他列为目标
Dialogue: 0,0:18:13.56,0:18:15.83,Default,,0,0,0,,定要取他首级
Dialogue: 0,0:18:18.28,0:18:19.85,Default,,0,0,0,,终 终于…
Dialogue: 0,0:18:20.94,0:18:24.62,Default,,0,0,0,,李牧终于还是把信视为威胁了吗
Dialogue: 0,0:18:26.90,0:18:27.73,Default,,0,0,0,,李牧…
Dialogue: 0,0:18:28.97,0:18:31.48,Default,,0,0,0,,我甚至嫌你太慢 混蛋
Dialogue: 0,0:18:32.43,0:18:34.40,Default,,0,0,0,,怕你不成
Dialogue: 0,0:18:34.51,0:18:36.85,Default,,0,0,0,,有本事就来取啊
Dialogue: 0,0:18:37.96,0:18:39.35,Default,,0,0,0,,河了貂
Dialogue: 0,0:18:39.67,0:18:40.76,Default,,0,0,0,,我知道
Dialogue: 0,0:18:40.98,0:18:42.65,Default,,0,0,0,,我们撤离这里
Dialogue: 0,0:18:42.65,0:18:44.87,Default,,0,0,0,,我去后方指挥撤退
Dialogue: 0,0:18:45.45,0:18:47.99,Default,,0,0,0,,你们想办法争取时间
Dialogue: 0,0:18:49.28,0:18:50.53,Default,,0,0,0,,快点啊
Dialogue: 0,0:18:51.80,0:18:52.53,Default,,0,0,0,,刘冬大人
Dialogue: 0,0:18:52.92,0:18:55.35,Default,,0,0,0,,山上下来一支骑兵 正攻击飞信队前方
Dialogue: 0,0:18:55.47,0:18:57.03,Default,,0,0,0,,纪彗大人终于行动了？
Dialogue: 0,0:18:57.71,0:18:58.55,Default,,0,0,0,,不对
Dialogue: 0,0:18:58.66,0:19:01.95,Default,,0,0,0,,那是山丘后方的庆舍大人的精锐部队
Dialogue: 0,0:19:02.87,0:19:05.04,Default,,0,0,0,,而且几乎全部出动了
Dialogue: 0,0:19:05.46,0:19:09.71,Default,,0,0,0,,主将庆舍打算一举消灭飞信队
Dialogue: 0,0:19:10.31,0:19:11.21,Default,,0,0,0,,配合友军
Dialogue: 0,0:19:11.80,0:19:14.16,Default,,0,0,0,,后方部队朝两侧展开
Dialogue: 0,0:19:14.16,0:19:15.72,Default,,0,0,0,,将敌军彻底包围
Dialogue: 0,0:19:16.44,0:19:17.63,Default,,0,0,0,,也去告诉马呈
Dialogue: 0,0:19:17.76,0:19:18.31,Default,,0,0,0,,是
Dialogue: 0,0:19:18.52,0:19:20.10,Default,,0,0,0,,不要放跑一个人
Dialogue: 0,0:19:20.24,0:19:21.34,Default,,0,0,0,,是
Dialogue: 0,0:19:23.25,0:19:26.35,Default,,0,0,0,,居然还有 庆舍大人的骑兵好多啊
Dialogue: 0,0:19:26.55,0:19:29.86,Default,,0,0,0,,和第一天一样 每次出动都置敌于死地
Dialogue: 0,0:19:31.49,0:19:34.92,Default,,0,0,0,,城主 这下飞信队就不堪一击了
Dialogue: 0,0:19:36.00,0:19:38.20,Default,,0,0,0,,确实不堪一击
Dialogue: 0,0:19:38.52,0:19:42.52,Default,,0,0,0,,庆舍大人出动了几乎整个主力部队
Dialogue: 0,0:19:42.94,0:19:46.08,Default,,0,0,0,,刘冬和马呈也加以配合 正在展开包围网
Dialogue: 0,0:19:47.04,0:19:49.31,Default,,0,0,0,,从上方看就很清楚
Dialogue: 0,0:19:49.81,0:19:52.37,Default,,0,0,0,,飞信队没有一条活路
Dialogue: 0,0:19:54.11,0:19:56.77,Default,,0,0,0,,但是为什么 总觉得有点不对劲
Dialogue: 0,0:19:58.05,0:20:00.16,Default,,0,0,0,,不是飞信队
Dialogue: 0,0:20:01.14,0:20:02.56,Default,,0,0,0,,而是庆舍大人
Dialogue: 0,0:20:03.61,0:20:07.37,Default,,0,0,0,,不 这次突袭毫无疑问是上策
Dialogue: 0,0:20:07.72,0:20:11.51,Default,,0,0,0,,因为桓骑军会因此而失去右翼
Dialogue: 0,0:20:13.00,0:20:16.79,Default,,0,0,0,,但是 总觉得有些不对劲
Dialogue: 0,0:20:18.33,0:20:19.83,Default,,0,0,0,,其实此时
Dialogue: 0,0:20:20.07,0:20:22.83,Default,,0,0,0,,因庆舍出动而心有不安者
Dialogue: 0,0:20:22.94,0:20:25.28,Default,,0,0,0,,除纪彗外还有一人
Dialogue: 0,0:20:26.22,0:20:29.79,Default,,0,0,0,,那就是长年跟随庆舍左右的金毛
Dialogue: 0,0:20:30.62,0:20:32.88,Default,,0,0,0,,山丘另一侧的探子来报
Dialogue: 0,0:20:33.34,0:20:36.30,Default,,0,0,0,,庆舍大人的精锐部队正在攻击飞信队
Dialogue: 0,0:20:36.45,0:20:39.76,Default,,0,0,0,,飞信队似乎已经陷入绝境
Dialogue: 0,0:20:41.39,0:20:42.55,Default,,0,0,0,,那是当然
Dialogue: 0,0:20:42.69,0:20:46.02,Default,,0,0,0,,居然贸然闯入我军腹地 一群蠢货
Dialogue: 0,0:20:46.74,0:20:50.99,Default,,0,0,0,,怎么回事 桓骑应该没有动静才对啊
Dialogue: 0,0:20:51.97,0:20:54.00,Default,,0,0,0,,您怎么了 副将
Dialogue: 0,0:20:54.21,0:20:57.88,Default,,0,0,0,,和第一天一样 庆舍大人亲自出马
Dialogue: 0,0:20:58.10,0:21:00.41,Default,,0,0,0,,这场战斗 庆舍大人状态绝佳啊
Dialogue: 0,0:21:00.50,0:21:01.20,Default,,0,0,0,,是啊
Dialogue: 0,0:21:01.78,0:21:02.85,Default,,0,0,0,,蠢货
Dialogue: 0,0:21:04.11,0:21:05.88,Default,,0,0,0,,这和第一天完全不同
Dialogue: 0,0:21:06.94,0:21:11.60,Default,,0,0,0,,第一天是桓骑军左翼进入了「网」中
Dialogue: 0,0:21:11.60,0:21:12.60,Default,,0,0,0,,他才前去猎杀
Dialogue: 0,0:21:13.48,0:21:18.17,Default,,0,0,0,,但是 这次或许与猎杀桓骑的网无关
Dialogue: 0,0:21:18.79,0:21:21.46,Default,,0,0,0,,而是为了除去碍眼的飞信队而出动
Dialogue: 0,0:21:22.89,0:21:27.64,Default,,0,0,0,,在旁人看来 飞信队或许也是误入网中的猎物
Dialogue: 0,0:21:29.00,0:21:31.69,Default,,0,0,0,,但在我看来 这是庆舍大人的焦躁之举
Dialogue: 0,0:21:32.60,0:21:36.23,Default,,0,0,0,,是因未能感受到桓骑的气息 而发起的报复
Dialogue: 0,0:21:38.26,0:21:42.35,Default,,0,0,0,,桓骑面对昨天的最好机会都没有行动
Dialogue: 0,0:21:42.80,0:21:46.47,Default,,0,0,0,,他一直销声匿迹 定是激怒了庆舍大人
Dialogue: 0,0:21:47.92,0:21:52.48,Default,,0,0,0,,我跟随庆舍大人多年 还是第一次见到他这样
Dialogue: 0,0:22:01.27,0:22:04.91,Default,,0,0,0,,我想到了一件令人发毛的事
Dialogue: 0,0:22:06.19,0:22:08.60,Default,,0,0,0,,看到庆舍大人亲自出马
Dialogue: 0,0:22:09.37,0:22:13.87,Default,,0,0,0,,桓骑此刻会不会露出了笑容
Dialogue: 0,0:22:16.14,0:22:18.88,Default,,0,0,0,,被俘的敌兵说
Dialogue: 0,0:22:19.04,0:22:23.96,Default,,0,0,0,,庆舍是「沉默的猎人」 很擅于「等待」
Dialogue: 0,0:22:24.75,0:22:28.65,Default,,0,0,0,,每一场战斗中 都会悄悄设下陷阱
Dialogue: 0,0:22:28.94,0:22:31.69,Default,,0,0,0,,等敌人先行动 再将其猎杀
Dialogue: 0,0:22:32.36,0:22:38.07,Default,,0,0,0,,所以他每次都能把敌人玩弄于股掌 将其击败
Dialogue: 0,0:22:39.78,0:22:41.13,Default,,0,0,0,,还挺可怕
Dialogue: 0,0:22:42.04,0:22:44.96,Default,,0,0,0,,但越是这样的人
Dialogue: 0,0:22:45.08,0:22:49.16,Default,,0,0,0,,越是会被我玩弄于股掌丢掉性命
Dialogue: 0,0:22:49.36,0:22:51.08,Default,,0,0,0,,把屎拉裤裆里
Dialogue: 0,0:22:51.08,0:22:52.29,Default,,0,0,0,,对吧 俚玉
Dialogue: 0,0:22:52.48,0:22:53.52,Default,,0,0,0,,是啊
Dialogue: 0,0:22:54.68,0:22:55.94,Default,,0,0,0,,屎拉裤裆
Dialogue: 0,0:22:56.93,0:22:58.90,Default,,0,0,0,,沉默的猎人？
Dialogue: 0,0:22:59.98,0:23:04.57,Default,,0,0,0,,这么快就红着眼出动了 小喽啰
Dialogue: 0,0:23:10.83,0:23:11.61,Default,,0,0,0,,泽诺？
Dialogue: 0,0:23:12.50,0:23:15.68,Default,,0,0,0,,借个道 黑樱
Dialogue: 0,0:24:49.92,0:24:51.60,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:51.96,0:24:53.72,Default,,0,0,0,,「皆在一瞬间」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

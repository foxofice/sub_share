Dialogue: 0,0:00:13.87,0:00:15.54,TEXT-JP,,0,0,0,,光
Dialogue: 0,0:00:15.54,0:00:17.62,TEXT-JP,,0,0,0,,おい　おったか
Dialogue: 0,0:00:23.50,0:00:25.34,TEXT-JP,,0,0,0,,光
Dialogue: 0,0:00:25.88,0:00:27.55,TEXT-JP,,0,0,0,,あかん
Dialogue: 0,0:00:33.05,0:00:37.18,TEXT-JP,,0,0,0,,このまま捜すのは無理や　一旦戻ろう
Dialogue: 0,0:00:37.98,0:00:39.06,TEXT-JP,,0,0,0,,ああ
Dialogue: 0,0:00:43.23,0:00:44.90,TEXT-JP,,0,0,0,,よしき…
Dialogue: 0,0:00:47.86,0:00:48.74,TEXT-JP,,0,0,0,,光
Dialogue: 0,0:00:53.91,0:00:55.99,TEXT-JP,,0,0,0,,光　光
Dialogue: 0,0:00:59.58,0:01:00.50,TEXT-JP,,0,0,0,,クソッ
Dialogue: 0,0:01:06.13,0:01:08.05,TEXT-JP,,0,0,0,,ウヌキ様
Dialogue: 0,0:01:10.88,0:01:15.76,TEXT-JP,,0,0,0,,誰でもええから　そばに…
Dialogue: 0,0:01:15.76,0:01:17.72,TEXT-JP,,0,0,0,,光
Dialogue: 0,0:01:42.29,0:01:45.13,TEXT-JP,,0,0,0,,おばあちゃん　アイス買うてええか
Dialogue: 0,0:01:47.00,0:01:48.25,TEXT-JP,,0,0,0,,涼しい
Dialogue: 0,0:01:48.25,0:01:49.96,TEXT-JP,,0,0,0,,って　アイス少なっ
Dialogue: 0,0:01:49.96,0:01:52.01,TEXT-JP,,0,0,0,,何が「アイスあります」や
Dialogue: 0,0:01:53.80,0:01:55.43,TEXT-JP,,0,0,0,,パピッコしかないやん
Dialogue: 0,0:01:58.18,0:02:01.43,TEXT-JP,,0,21,0,,しかも　キソキソのアイスって　なんなん
Dialogue: 0,0:02:03.10,0:02:07.23,TEXT-JP,,0,0,0,,ハラセンめ　この炎天下でマラソンさせよって
Dialogue: 0,0:02:07.23,0:02:10.03,TEXT-JP,,0,0,0,,普通にゴーモンやったな
Dialogue: 0,0:02:10.49,0:02:11.44,TEXT-JP,,0,0,0,,光
Dialogue: 0,0:02:12.15,0:02:14.20,TEXT-JP,,0,0,0,,拷問のイントネーションちゃうで
Dialogue: 0,0:02:15.20,0:02:17.28,TEXT-JP,,0,0,0,,それじゃ　サーモンと一緒やん
Dialogue: 0,0:02:17.28,0:02:19.16,TEXT-JP,,0,0,0,,肛門のイントネーションや
Dialogue: 0,0:02:19.62,0:02:24.17,TEXT-JP,,0,0,0,,そかそか　ゴウモン…拷問な
Dialogue: 0,0:02:24.17,0:02:25.17,TEXT-JP,,0,0,0,,気いつけよ
Dialogue: 0,0:02:27.71,0:02:32.01,TEXT-JP,,0,0,0,,お前さ　ほんまにあの山で1週間も行方不明だったん
Dialogue: 0,0:02:32.55,0:02:33.88,TEXT-JP,,0,0,0,,覚えてないんか
Dialogue: 0,0:02:35.68,0:02:36.59,TEXT-JP,,0,0,0,,全然
Dialogue: 0,0:02:38.76,0:02:41.77,TEXT-JP,,0,0,0,,半年たっても思い出されやんな
Dialogue: 0,0:02:41.77,0:02:44.85,TEXT-JP,,0,0,0,,ほんなんさ　いつまで言うとるん
Dialogue: 0,0:02:44.85,0:02:48.15,TEXT-JP,,0,16,0,,どんだけみんな心配したと思っとるん
Dialogue: 0,0:02:51.19,0:02:53.24,TEXT-JP,,22,0,0,,俺がおらんくてさみしかった？
Dialogue: 0,0:02:54.99,0:02:57.12,TEXT-JP,,0,0,0,,いや　別に
Dialogue: 0,0:02:57.12,0:02:59.49,TEXT-JP,,0,0,0,,ウソや　泣いたはず
Dialogue: 0,0:02:59.49,0:03:01.37,TEXT-JP,,0,0,0,,「一人にせんでよお　光」
Dialogue: 0,0:03:01.37,0:03:02.95,TEXT-JP,,0,0,0,,調子乗んなや
Dialogue: 0,0:03:02.95,0:03:04.83,TEXT-JP,,0,0,0,,あっ　また
Dialogue: 0,0:03:04.83,0:03:07.38,TEXT-JP,,0,0,0,,俺よりデカいからって　すぐ　それするんに
Dialogue: 0,0:03:18.39,0:03:20.93,TEXT-JP,,0,0,0,,なあ　変なこと聞いてもええか
Dialogue: 0,0:03:21.76,0:03:24.39,TEXT-JP,,0,0,0,,何　愛の告白でもする気なん
Dialogue: 0,0:03:24.39,0:03:25.35,TEXT-JP,,0,0,0,,ちゃうわ
Dialogue: 0,0:03:26.27,0:03:31.27,TEXT-JP,,0,0,0,,いや　これはな　今に始まったことやなくて
Dialogue: 0,0:03:31.77,0:03:35.19,TEXT-JP,,0,0,0,,お前がさ　行方不明なって帰ってきてから
Dialogue: 0,0:03:35.19,0:03:37.41,TEXT-JP,,0,0,0,,ずっと思っとったことなんやけど
Dialogue: 0,0:03:44.29,0:03:46.79,TEXT-JP,,0,0,0,,お前　やっぱ
Dialogue: 0,0:03:47.37,0:03:49.04,TEXT-JP,,0,0,0,,光ちゃうやろ
Dialogue: 0,0:04:03.47,0:04:04.64,TEXT-JP,,0,0,0,,なんでや
Dialogue: 0,0:04:06.27,0:04:09.52,TEXT-JP,,0,0,0,,完璧に模倣したはずやのに
Dialogue: 0,0:04:23.16,0:04:24.37,TEXT-JP,,0,0,0,,お願い
Dialogue: 0,0:04:25.41,0:04:26.83,TEXT-JP,,0,0,0,,誰にも言わんといて
Dialogue: 0,0:04:27.62,0:04:30.08,TEXT-JP,,0,0,0,,初めて人として生きたんや
Dialogue: 0,0:04:30.08,0:04:33.88,TEXT-JP,,0,0,0,,学校もアイスも　全部初めてで楽しかった
Dialogue: 0,0:04:34.38,0:04:36.80,TEXT-JP,,0,0,0,,体も人格も借り物やけど
Dialogue: 0,0:04:38.26,0:04:40.76,TEXT-JP,,0,0,0,,お前のこと　大好きやねん
Dialogue: 0,0:04:41.26,0:04:43.10,TEXT-JP,,0,0,0,,やから頼む
Dialogue: 0,0:04:43.81,0:04:47.60,TEXT-JP,,0,0,0,,お前を…殺したない
Dialogue: 0,0:05:01.91,0:05:04.70,TEXT-JP,,0,0,0,,どちらにせよ　光はもうおらんのや
Dialogue: 0,0:05:06.62,0:05:12.17,TEXT-JP,,0,0,0,,それやったら　ニセモンでも　そばにいてほしい
Dialogue: 0,0:05:17.00,0:05:18.05,TEXT-JP,,0,0,0,,分かった
Dialogue: 0,0:05:19.05,0:05:22.93,TEXT-JP,,0,0,0,,ヒカル　よろしくな
Dialogue: 0,0:05:27.64,0:05:30.94,TEXT-JP,,0,0,0,,お前さ　希望ヶ山高出たらどないする
Dialogue: 0,0:05:32.06,0:05:34.36,TEXT-JP,,0,0,0,,あんま考えとらんな
Dialogue: 0,0:05:34.36,0:05:37.78,TEXT-JP,,0,0,0,,多分　爺さんのシイタケ継ぐんちゃうかな
Dialogue: 0,0:05:38.53,0:05:40.24,TEXT-JP,,0,0,0,,よしきこそどないするん
Dialogue: 0,0:05:40.70,0:05:42.82,TEXT-JP,,17,0,0,,俺もまだよく考えとらんよ
Dialogue: 0,0:05:43.61,0:05:45.78,TEXT-JP,,16,0,0,,頭ええんやからさ
Dialogue: 0,0:05:45.78,0:05:49.50,TEXT-JP,,0,0,0,,こんな村出て　東京の大学行ったらええに
Dialogue: 0,0:05:49.50,0:05:53.50,TEXT-JP,,0,0,0,,何　もしかして俺と離れたくないん
Dialogue: 0,0:05:53.50,0:05:55.13,TEXT-JP,,0,0,0,,キモ
Dialogue: 0,0:05:53.96,0:05:55.50,TEXT-JP-U,,0,0,0,,死んでくれへんかな
Dialogue: 0,0:05:56.29,0:05:59.38,TEXT-JP,,0,0,0,,よしきが東京で1人暮らししたらさ
Dialogue: 0,0:05:59.38,0:06:01.51,TEXT-JP,,0,0,0,,かわええ彼女作っても
Dialogue: 0,0:06:01.51,0:06:03.72,TEXT-JP,,0,0,0,,連れ込めんくらい入り浸ったろけ
Dialogue: 0,0:06:03.72,0:06:05.51,TEXT-JP,,0,0,0,,彼女なんて出来へんから
Dialogue: 0,0:06:06.35,0:06:08.01,TEXT-JP,,0,0,0,,なんなん
Dialogue: 0,0:06:08.01,0:06:10.85,TEXT-JP,,0,0,0,,いっつもこういう話題になると不機嫌なるな
Dialogue: 0,0:06:12.39,0:06:14.90,TEXT-JP,,0,0,0,,彼女くらい出来るやろが
Dialogue: 0,0:06:15.94,0:06:16.98,TEXT-JP,,0,0,0,,光
Dialogue: 0,0:06:17.44,0:06:19.57,TEXT-JP,,0,16,0,,よしきやん　どしたん
Dialogue: 0,0:06:19.57,0:06:21.24,TEXT-JP,,0,0,0,,週末なんやけどさ
Dialogue: 0,0:06:23.49,0:06:26.82,TEXT-JP,,0,0,0,,その日はダメやねん　山　行くから
Dialogue: 0,0:06:26.82,0:06:29.16,TEXT-JP,,0,0,0,,山　なんでや
Dialogue: 0,0:06:29.16,0:06:31.20,TEXT-JP,,0,0,0,,それはやな…
Dialogue: 0,0:06:31.20,0:06:33.46,TEXT-JP,,0,0,0,,ひみつ～
Dialogue: 0,0:06:42.01,0:06:46.51,TEXT-JP-U,,0,0,0,,よしき　起きな　ご飯出来たよ
Dialogue: 0,0:06:42.51,0:06:47.01,TEXT-JP,,0,0,0,,夢や　「生きとる」ころの
Dialogue: 0,0:06:49.85,0:06:54.81,TEXT-JP,,0,0,0,,最後に見た顔がハラセンのモノマネとか　しょうもな
Dialogue: 0,0:07:08.99,0:07:12.70,TEXT-JP,,0,0,0,,よしき　ご飯だっつうの
Dialogue: 0,0:07:17.21,0:07:18.83,TEXT-JP,,0,0,0,,たくさん採れたから
Dialogue: 0,0:07:18.83,0:07:20.34,TEXT-JP,,0,0,0,,本当　助かります
Dialogue: 0,0:07:20.34,0:07:22.13,TEXT-JP,,18,0,0,,あっ　よしき　おはよう
Dialogue: 0,0:07:22.13,0:07:26.30,TEXT-JP,,0,0,0,,昨日は遅くまで何しとったん　ずっと電気ついとったよ
Dialogue: 0,0:07:29.10,0:07:30.55,TEXT-JP,,0,0,0,,いただきます
Dialogue: 0,0:07:31.35,0:07:32.77,TEXT-JP-U,,0,0,0,,おはようございます
Dialogue: 0,0:07:32.77,0:07:35.56,TEXT-JP-U,,0,0,0,,本日の全国の天気をお伝えします
Dialogue: 0,0:07:35.56,0:07:37.14,TEXT-JP-U,,0,0,0,,例年と比べこの夏は
Dialogue: 0,0:07:37.14,0:07:40.23,TEXT-JP-U,,0,0,0,,全国的に気温の高い日が続きそうです
Dialogue: 0,0:07:44.07,0:07:48.20,TEXT-JP-U,,0,0,0,,日本海から東北付近に延び　北海道には低気圧が近づきます
Dialogue: 0,0:07:52.70,0:07:58.21,TEXT-JP-U,,0,0,0,,一方　東日本　西日本では…高気圧の影響で　強い日差しが照り付けます
Dialogue: 0,0:07:40.23,0:07:42.07,TEXT-JP,,0,0,0,,かおるはまだ寝とんのか
Dialogue: 0,0:07:48.20,0:07:50.45,TEXT-JP,,17,0,0,,光君来ちゃったよ
Dialogue: 0,0:07:50.45,0:07:51.99,TEXT-JP,,21,0,0,,今行く
Dialogue: 0,0:07:58.21,0:08:02.21,TEXT-JP,,0,0,0,,前髪もはよ切らんとウザこいなあ
Dialogue: 0,0:08:03.88,0:08:06.47,TEXT-JP,,18,0,0,,あ　よしき　おはよう
Dialogue: 0,0:08:07.22,0:08:10.47,TEXT-JP,,0,0,0,,きょ…　今日の朝な　おかやんがな
Dialogue: 0,0:08:10.47,0:08:12.89,TEXT-JP,,0,0,0,,アホか　時間ないんや
Dialogue: 0,0:08:13.72,0:08:17.10,TEXT-JP,,0,0,0,,はよ行かな　遅れんで
Dialogue: 0,0:08:18.98,0:08:22.69,TEXT-JP,,0,0,0,,うん　ハラセンに怒られたないしな
Dialogue: 0,0:08:22.69,0:08:23.86,TEXT-JP,,0,0,0,,これでええ
Dialogue: 0,0:08:25.74,0:08:28.03,TEXT-JP,,0,0,0,,おかやんがな　スイカ買ってきてん
Dialogue: 0,0:08:28.03,0:08:29.74,TEXT-JP,,0,0,0,,ほんでさ　スイカ食ったんよ
Dialogue: 0,0:08:29.74,0:08:31.16,TEXT-JP,,0,0,0,,あれうまいなあ
Dialogue: 0,0:08:31.16,0:08:33.24,TEXT-JP,,0,0,0,,お前が何者やろうと
Dialogue: 0,0:08:33.62,0:08:37.33,TEXT-JP,,0,0,0,,そばにおらんよりは　ずっと…
Dialogue: 0,0:08:43.71,0:08:44.67,TEXT-JP,,0,0,0,,はい
Dialogue: 0,0:08:44.67,0:08:46.51,TEXT-JP,,0,0,0,,ああ　どうも
Dialogue: 0,0:08:46.51,0:08:50.47,TEXT-JP,,0,0,0,,会社から派遣されてきた田中です
Dialogue: 0,0:08:51.68,0:08:57.64,TEXT-JP,,0,0,0,,静かに夢を見てごらん
Dialogue: 0,0:08:58.31,0:09:03.98,TEXT-JP,,0,0,0,,ひそかに探し求めてごらん
Dialogue: 0,0:09:03.98,0:09:10.53,TEXT-JP,,16,0,0,,過ぎ去った明かりは　戻らなくとも
Dialogue: 0,0:09:10.53,0:09:15.66,TEXT-JP,,0,0,0,,この胸を躍らせる未来こそ…
Dialogue: 0,0:09:18.41,0:09:21.75,TEXT-JP,,0,0,0,,怪しいのは…
Dialogue: 0,0:09:23.67,0:09:25.46,TEXT-JP,,0,0,0,,そこっすね
Dialogue: 0,0:09:27.67,0:09:31.93,TEXT-JP-U,,0,0,0,,悲しさよ　友よ
Dialogue: 0,0:09:31.93,0:09:37.39,TEXT-JP-U,,0,0,0,,赫うこの日々の影
Dialogue: 0,0:09:38.31,0:09:41.06,TEXT-JP-U,,0,0,0,,追いかけ　回る
Dialogue: 0,0:09:34.55,0:09:35.93,TEXT-JP,,0,0,0,,ママ…
Dialogue: 0,0:09:41.06,0:09:44.86,TEXT-JP-U,,0,0,0,,幸せよ　友よ
Dialogue: 0,0:09:44.02,0:09:46.94,TEXT-JP,,0,0,0,,果てしなく伸びしろを感じるな
Dialogue: 0,0:09:44.86,0:09:50.61,TEXT-JP-U,,0,0,0,,彷徨う心を開いて…
Dialogue: 0,0:09:51.45,0:09:55.03,TEXT-JP-U,,0,0,0,,忘れず追い続け…
Dialogue: 0,0:09:57.49,0:10:01.00,TEXT-JP,,0,0,0,,だりい　なんで合唱なん
Dialogue: 0,0:10:01.41,0:10:03.42,TEXT-JP,,0,0,0,,去年　文化祭　のうなったやん
Dialogue: 0,0:10:03.42,0:10:05.00,TEXT-JP,,0,0,0,,その代わりやって
Dialogue: 0,0:10:05.00,0:10:06.75,TEXT-JP,,0,0,0,,ええ
Dialogue: 0,0:10:07.34,0:10:09.00,TEXT-JP,,0,0,0,,俺は好きやで　歌うの
Dialogue: 0,0:10:09.00,0:10:12.26,TEXT-JP,,0,0,0,,いや全然歌っとらんやん　プリントばっか見とって
Dialogue: 0,0:10:12.26,0:10:15.18,TEXT-JP,,0,0,0,,歌詞の意味が気になってん
Dialogue: 0,0:10:15.18,0:10:17.18,TEXT-JP,,0,0,0,,あれ　どこ行くん
Dialogue: 0,0:10:17.47,0:10:20.31,TEXT-JP,,0,0,0,,次　理科やのうて　自習になったで
Dialogue: 0,0:10:20.31,0:10:22.52,TEXT-JP,,0,0,0,,教室で映画鑑賞やって
Dialogue: 0,0:10:22.52,0:10:23.56,TEXT-JP,,0,0,0,,映画
Dialogue: 0,0:10:23.56,0:10:25.48,TEXT-JP,,0,0,0,,え　また
Dialogue: 0,0:10:24.19,0:10:25.48,TEXT-JP-U,,16,0,0,,何度目だよ
Dialogue: 0,0:10:25.48,0:10:27.19,TEXT-JP,,0,0,0,,ね
Dialogue: 0,0:10:28.23,0:10:33.32,TEXT-JP,,0,0,0,,いやあ　1ミリもアレに関係している部分はありませんでしたね
Dialogue: 0,0:10:33.32,0:10:35.99,TEXT-JP,,0,0,0,,そうですか　残念です
Dialogue: 0,0:10:35.99,0:10:39.37,TEXT-JP,,0,17,0,,にしたって　この会社も懲りないですよね
Dialogue: 0,0:10:40.16,0:10:42.54,TEXT-JP,,0,0,0,,何百年も探し回って
Dialogue: 0,0:10:46.58,0:10:49.34,TEXT-JP,,0,0,0,,よく形骸化しねえよな
Dialogue: 0,0:10:51.42,0:10:53.67,TEXT-JP,,0,0,0,,会社の愚痴は控えてください
Dialogue: 0,0:10:53.67,0:10:56.43,TEXT-JP,,0,0,0,,どこから上に漏れるか分かりません
Dialogue: 0,0:10:56.43,0:10:58.22,TEXT-JP,,0,0,0,,あ　はいはい
Dialogue: 0,0:10:58.22,0:11:02.77,TEXT-JP,,0,0,0,,いや　仕事は真面目にやってるんでね　大丈夫ですよ
Dialogue: 0,0:11:08.11,0:11:12.53,TEXT-JP,,0,0,0,,まあ　簡単にアレは見つからねえか
Dialogue: 0,0:11:17.28,0:11:19.49,TEXT-JP,,0,16,0,,きゃっ　何をするのです
Dialogue: 0,0:11:19.49,0:11:22.08,TEXT-JP,,0,0,0,,うるさい　女の分際で何を
Dialogue: 0,0:11:22.62,0:11:24.62,TEXT-JP-U,,0,0,0,,お前の代わりはいくらでも…
Dialogue: 0,0:11:23.70,0:11:24.91,TEXT-JP,,0,0,0,,つまらん
Dialogue: 0,0:11:27.96,0:11:29.08,TEXT-JP,,0,0,0,,泣いとる
Dialogue: 0,0:11:30.46,0:11:32.17,TEXT-JP,,0,0,0,,かわいそすぎる
Dialogue: 0,0:11:32.88,0:11:34.88,TEXT-JP,,0,0,0,,え　なんで泣いとんの
Dialogue: 0,0:11:34.88,0:11:36.34,TEXT-JP,,0,0,0,,見るの5回目やし
Dialogue: 0,0:11:37.09,0:11:40.14,TEXT-JP,,0,0,0,,いやな　もちろん記憶にはあんねん
Dialogue: 0,0:11:41.14,0:11:43.89,TEXT-JP,,0,0,0,,でも　俺は初めて見たやつやから
Dialogue: 0,0:11:45.39,0:11:47.73,TEXT-JP,,0,0,0,,またの　あっつ
Dialogue: 0,0:11:47.73,0:11:49.77,TEXT-JP,,0,0,0,,部活だる
Dialogue: 0,0:11:49.77,0:11:52.27,TEXT-JP,,0,0,0,,あれ　鍵どこ行ったん
Dialogue: 0,0:11:52.27,0:11:54.53,TEXT-JP,,0,0,0,,カバンの中と違うん
Dialogue: 0,0:11:54.99,0:11:57.03,TEXT-JP,,17,0,0,,ちゃんと自主練してる？
Dialogue: 0,0:11:57.03,0:11:59.03,TEXT-JP,,0,0,0,,どこや
Dialogue: 0,0:11:59.62,0:12:00.74,TEXT-JP,,0,0,0,,はよ帰ろ
Dialogue: 0,0:12:00.74,0:12:02.58,TEXT-JP,,0,0,0,,わっ　ちょ…
Dialogue: 0,0:12:03.58,0:12:04.79,TEXT-JP,,0,0,0,,あった
Dialogue: 0,0:12:04.79,0:12:07.29,TEXT-JP,,0,30,0,,「古典B」の間に挟まっとった
Dialogue: 0,0:12:09.42,0:12:10.42,TEXT-JP,,0,0,0,,じゃ　いくよ
Dialogue: 0,0:12:10.42,0:12:11.29,TEXT-JP,,0,0,0,,オッケー
Dialogue: 0,0:12:11.75,0:12:14.55,TEXT-JP,,0,0,0,,よかったやん　はよ帰ろ
Dialogue: 0,0:14:01.82,0:14:04.87,TEXT-JP,,0,0,0,,これ　俺らがたまに食っとったやつよな
Dialogue: 0,0:14:04.87,0:14:05.82,TEXT-JP,,0,0,0,,そうやで
Dialogue: 0,0:14:13.08,0:14:15.13,TEXT-JP,,0,0,0,,うめえ　あかん　サクサク
Dialogue: 0,0:14:15.13,0:14:17.46,TEXT-JP,,0,0,0,,いやまあ　知っとる味なんやけど
Dialogue: 0,0:14:19.96,0:14:21.30,TEXT-JP,,16,0,0,,声デッカ
Dialogue: 0,0:14:21.30,0:14:23.01,TEXT-JP,,0,0,0,,にしても　不思議やな
Dialogue: 0,0:14:23.01,0:14:25.64,TEXT-JP,,0,0,0,,記憶あんのに新鮮やねんな
Dialogue: 0,0:14:25.64,0:14:27.97,TEXT-JP,,0,0,0,,持っとる記憶は全く同じなんやけど
Dialogue: 0,0:14:27.97,0:14:29.85,TEXT-JP,,0,0,0,,実感湧かんねん
Dialogue: 0,0:14:29.85,0:14:32.56,TEXT-JP,,0,0,0,,もともと生きてたことないしな
Dialogue: 0,0:14:32.56,0:14:35.35,TEXT-JP,,0,0,0,,こんなはっきり自我持ったん　初めて
Dialogue: 0,0:14:36.98,0:14:38.48,TEXT-JP,,20,0,0,,幽霊なんか？
Dialogue: 0,0:14:39.40,0:14:40.69,TEXT-JP,,0,0,0,,どうなんやろ
Dialogue: 0,0:14:40.69,0:14:42.15,TEXT-JP,,0,0,0,,幽霊
Dialogue: 0,0:14:43.24,0:14:45.45,TEXT-JP,,0,0,0,,あんましっくりきいひんな
Dialogue: 0,0:14:45.45,0:14:47.74,TEXT-JP,,0,0,0,,はちゃめちゃにバケモンなんは　確かやけど
Dialogue: 0,0:14:50.04,0:14:50.66,TEXT-JP,,0,0,0,,ニャー
Dialogue: 0,0:14:50.66,0:14:51.87,TEXT-JP,,0,0,0,,メンチ兄貴やん
Dialogue: 0,0:14:51.87,0:14:54.00,TEXT-JP,,0,0,0,,こいつ肉屋から餌もらって
Dialogue: 0,0:14:54.00,0:14:55.75,TEXT-JP,,16,0,0,,また肥えたんとちゃう
Dialogue: 0,0:14:55.75,0:14:57.13,TEXT-JP,,0,0,0,,ああ　ほんまや
Dialogue: 0,0:15:04.63,0:15:07.18,TEXT-JP,,0,0,0,,あの猫　はよ動けたんか
Dialogue: 0,0:15:09.47,0:15:12.39,TEXT-JP,,0,0,0,,町ん方で　ほかに行きたいとこないん
Dialogue: 0,0:15:12.39,0:15:14.77,TEXT-JP,,0,0,0,,えっ　つきおうてくれるん
Dialogue: 0,0:15:15.39,0:15:17.52,TEXT-JP,,0,0,0,,なんかさ　その…
Dialogue: 0,0:15:17.52,0:15:21.36,TEXT-JP,,0,0,0,,よしきは相変わらず優しいな　俺なんかに
Dialogue: 0,0:15:22.99,0:15:24.57,TEXT-JP,,17,0,0,,優しいんとちゃうよ
Dialogue: 0,0:15:24.57,0:15:28.66,TEXT-JP,,0,0,0,,自分に甘いヤツほど他人を許すんよ
Dialogue: 0,0:15:28.66,0:15:30.41,TEXT-JP,,0,0,0,,よう分からんけど
Dialogue: 0,0:15:30.41,0:15:33.66,TEXT-JP,,0,0,0,,俺にとって　優しいことには変わらんやん
Dialogue: 0,0:15:42.17,0:15:45.05,TEXT-JP,,0,0,0,,中のあんこが変わったんよね　粒あんに
Dialogue: 0,0:15:45.05,0:15:47.05,TEXT-JP,,0,0,0,,そしたら…　ねえ
Dialogue: 0,0:15:52.93,0:15:55.31,TEXT-JP,,0,0,0,,次は　どこ行くん
Dialogue: 0,0:16:04.49,0:16:06.86,TEXT-JP,,0,0,0,,おお　トンボさん
Dialogue: 0,0:16:06.86,0:16:09.62,TEXT-JP,,0,0,0,,ナツアカネや　赤トンボ
Dialogue: 0,0:16:09.62,0:16:11.62,TEXT-JP,,0,0,0,,まだ　そんな赤ないけどな
Dialogue: 0,0:16:11.62,0:16:14.62,TEXT-JP,,0,0,0,,赤トンボか　夏やのに
Dialogue: 0,0:16:14.62,0:16:17.50,TEXT-JP,,0,0,0,,秋の風物詩なんは　アキアカネな
Dialogue: 0,0:16:17.50,0:16:20.08,TEXT-JP,,0,0,0,,これは　ナツアカネやから
Dialogue: 0,0:16:20.08,0:16:21.25,TEXT-JP,,0,0,0,,何が　ちゃうん
Dialogue: 0,0:16:22.96,0:16:24.92,TEXT-JP,,0,0,0,,説明すんの　めんどいわ
Dialogue: 0,0:16:24.92,0:16:26.76,TEXT-JP,,0,0,0,,ナツアカネとアキアカネは
Dialogue: 0,0:16:26.76,0:16:29.51,TEXT-JP,,16,0,0,,見た目は　ほぼ同じやけど　別の種類なんよ
Dialogue: 0,0:16:30.22,0:16:32.89,TEXT-JP,,0,0,0,,へえ　さすがエーミール
Dialogue: 0,0:16:33.76,0:16:35.68,TEXT-JP,,0,0,0,,こいつは　一体なんなん
Dialogue: 0,0:16:35.68,0:16:39.65,TEXT-JP,,0,0,0,,見た目は光と同じでも　光やないナニカ…
Dialogue: 0,0:16:39.65,0:16:43.57,TEXT-JP,,0,0,0,,あっ　待ってや
Dialogue: 0,0:16:43.57,0:16:44.78,TEXT-JP,,0,0,0,,どしたん
Dialogue: 0,0:16:45.69,0:16:47.28,TEXT-JP,,16,0,0,,狂っとる
Dialogue: 0,0:16:47.28,0:16:51.37,TEXT-JP,,0,0,0,,それを受け入れとる俺も　怖い　怖い　怖い
Dialogue: 0,0:16:51.37,0:16:54.20,TEXT-JP,,0,0,0,,普通になんやねんあれ　勘弁してくれ
Dialogue: 0,0:16:54.20,0:16:56.12,TEXT-JP,,0,0,0,,俺　きっしょ　俺　きっしょ　もう意味分からん
Dialogue: 0,0:16:56.12,0:16:59.46,TEXT-JP,,0,0,0,,ニセモンでも　そばにいてほしい
Dialogue: 0,0:17:00.62,0:17:01.88,TEXT-JP,,0,0,0,,おっ　そうや
Dialogue: 0,0:17:01.88,0:17:03.88,TEXT-JP,,0,0,0,,今度よしきんちでさ
Dialogue: 0,0:17:03.88,0:17:06.88,TEXT-JP,,0,42,0,,「マスターマスター」の続き　読ましてや
Dialogue: 0,0:17:09.26,0:17:10.88,TEXT-JP,,0,0,0,,ああ　ええよ
Dialogue: 0,0:17:12.39,0:17:13.89,TEXT-JP,,0,0,0,,どこまで読んだん
Dialogue: 0,0:17:14.18,0:17:16.14,TEXT-JP,,0,0,0,,ロンが島出た
Dialogue: 0,0:17:16.14,0:17:18.77,TEXT-JP,,0,0,0,,ゼロに等しいレベルで序盤やな
Dialogue: 0,0:17:18.77,0:17:21.90,TEXT-JP,,0,0,0,,ええよ　今度うち来て読めば
Dialogue: 0,0:17:21.90,0:17:23.56,TEXT-JP,,0,0,0,,あっでも3巻だけないで
Dialogue: 0,0:17:24.94,0:17:27.44,TEXT-JP,,0,0,0,,それはなんとかなるからええねん
Dialogue: 0,0:17:27.44,0:17:31.15,TEXT-JP,,0,0,0,,なんで1巻が11冊あるんかが気になっとったんやけど
Dialogue: 0,0:17:36.87,0:17:39.45,TEXT-JP,,0,0,0,,なんでや…　あっ…
Dialogue: 0,0:17:39.45,0:17:44.50,TEXT-JP,,0,0,0,,ノウヌキ様が山から下りてきとるやないか
Dialogue: 0,0:17:45.00,0:17:47.55,TEXT-JP,,19,0,0,,なんや　モギモギ様？
Dialogue: 0,0:17:47.55,0:17:49.30,TEXT-JP,,0,0,0,,かまうな　かまうな
Dialogue: 0,0:17:49.30,0:17:52.18,TEXT-JP,,0,0,0,,こういうの　ホントに嫌やねん
Dialogue: 0,0:17:52.18,0:17:53.68,TEXT-JP,,17,0,0,,怖っ
Dialogue: 0,0:17:55.64,0:17:58.68,TEXT-JP,,0,0,0,,来るな　去ね
Dialogue: 0,0:18:03.35,0:18:05.48,TEXT-JP,,0,0,0,,行くで　ヒカル
Dialogue: 0,0:18:06.27,0:18:07.07,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:18:13.24,0:18:17.95,TEXT-JP,,0,0,0,,なあ　光はやっぱり死んでもうてるん
Dialogue: 0,0:18:20.25,0:18:21.46,TEXT-JP,,0,0,0,,うん
Dialogue: 0,0:18:21.46,0:18:25.04,TEXT-JP,,0,0,0,,この体　脈も体温もあるけどな
Dialogue: 0,0:18:25.63,0:18:27.17,TEXT-JP,,0,0,0,,もう死んどるんよ
Dialogue: 0,0:18:27.17,0:18:29.09,TEXT-JP,,0,0,0,,それは　お前が…
Dialogue: 0,0:18:29.09,0:18:30.30,TEXT-JP,,20,0,0,,それはちゃう
Dialogue: 0,0:18:30.92,0:18:33.59,TEXT-JP,,0,0,0,,俺が遭遇したときにはもう虫の息やったもん
Dialogue: 0,0:18:33.59,0:18:35.09,TEXT-JP,,0,0,0,,間違いないよ
Dialogue: 0,0:18:36.80,0:18:41.10,TEXT-JP,,0,0,0,,俺が覚えとるんは　ずっと山の中さまよっとって
Dialogue: 0,0:18:41.10,0:18:43.85,TEXT-JP,,0,0,0,,とにかく長い時間そうしてて
Dialogue: 0,0:18:43.85,0:18:46.19,TEXT-JP,,0,0,0,,もうなんも感じんくてさ
Dialogue: 0,0:18:46.19,0:18:48.69,TEXT-JP,,0,0,0,,ずっと機械みたいな感じやってん
Dialogue: 0,0:18:48.69,0:18:52.69,TEXT-JP,,0,0,0,,そしたら　光が死にかけてて…
Dialogue: 0,0:18:53.15,0:18:56.95,TEXT-JP,,0,0,0,,で　気付いたらこうなっとった
Dialogue: 0,0:19:02.54,0:19:04.75,TEXT-JP,,0,0,0,,よしき　また明日
Dialogue: 0,0:19:07.58,0:19:10.80,TEXT-JP,,0,0,0,,お前　俺のこと好きか
Dialogue: 0,0:19:10.80,0:19:12.42,TEXT-JP,,0,0,0,,えっ　何
Dialogue: 0,0:19:23.43,0:19:24.52,TEXT-JP,,0,0,0,,好きや
Dialogue: 0,0:19:26.10,0:19:27.65,TEXT-JP,,16,0,0,,めっちゃ好き
Dialogue: 0,0:19:31.98,0:19:36.74,TEXT-JP,,0,0,0,,前はそんなこと　ひと言も言わんかったな
Dialogue: 0,0:19:39.57,0:19:44.04,TEXT-JP,,0,0,0,,やったら　もう勝手におらんくならんといてね
Dialogue: 0,0:20:01.72,0:20:03.22,TEXT-JP,,0,0,0,,1学期も終わりだっつうのに
Dialogue: 0,0:20:03.22,0:20:04.73,TEXT-JP,,16,0,0,,今日も学校行かなかったのよ
Dialogue: 0,0:20:06.23,0:20:07.98,TEXT-JP,,0,0,0,,大丈夫だと思ってんの
Dialogue: 0,0:20:07.98,0:20:11.23,TEXT-JP,,0,0,0,,母親から見て大丈夫なら　大丈夫なんやないの
Dialogue: 0,0:20:12.73,0:20:14.48,TEXT-JP,,0,0,0,,だから　そういうことじゃなくて
Dialogue: 0,0:20:14.48,0:20:16.74,TEXT-JP,,0,0,0,,かおるのこと　ちゃんと考えてんの
Dialogue: 0,0:20:21.24,0:20:23.24,TEXT-JP,,0,0,0,,来るな　来るな
Dialogue: 0,0:20:23.58,0:20:27.04,TEXT-JP-U,,0,0,0,,松浦さん　宅配便です
Dialogue: 0,0:20:25.37,0:20:28.25,TEXT-JP,,0,0,0,,あ…　開けんぞ
Dialogue: 0,0:20:28.25,0:20:30.71,TEXT-JP,,0,0,0,,考えとるよ　親なんやから
Dialogue: 0,0:20:31.25,0:20:32.96,TEXT-JP,,0,0,0,,松浦さん
Dialogue: 0,0:20:33.75,0:20:36.80,TEXT-JP,,0,18,0,,自分のことばっかで　子供のことなんて考えてないじゃん
Dialogue: 0,0:20:36.80,0:20:39.26,TEXT-JP,,0,0,0,,仕事してればいいってもんじゃないからね
Dialogue: 0,0:20:39.26,0:20:42.72,TEXT-JP,,0,0,0,,松浦さん　松浦さん
Dialogue: 0,0:20:43.22,0:20:45.77,TEXT-JP,,0,0,0,,あれ　留守なんかな
Dialogue: 0,0:20:49.69,0:20:53.65,TEXT-JP,,0,0,0,,こ…　こんな夜中に来るわけがあ…　あ…　あるか
Dialogue: 0,0:20:53.65,0:20:55.57,TEXT-JP,,0,0,0,,いるんですよね
Dialogue: 0,0:20:56.28,0:20:58.15,TEXT-JP,,0,0,0,,松浦さん
Dialogue: 0,0:20:58.74,0:21:03.03,TEXT-JP,,0,0,0,,松浦さん　松浦さん
Dialogue: 0,0:21:03.03,0:21:04.53,TEXT-JP,,0,0,0,,い…　いい…
Dialogue: 0,0:21:04.53,0:21:09.92,TEXT-JP,,0,0,0,,入れへんぞ
Dialogue: 0,0:21:07.83,0:21:09.29,TEXT-JP-U,,0,0,0,,松浦さん
Dialogue: 0,0:21:16.59,0:21:18.22,TEXT-JP,,0,0,0,,松浦さん
Dialogue: 0,0:21:21.51,0:21:23.60,TEXT-JP,,0,0,0,,もう入ってますよ
Dialogue: 0,0:21:36.69,0:21:38.94,TEXT-JP,,0,0,0,,おやすみ　光
Dialogue: 0,0:21:57.05,0:21:58.34,TEXT-JP,,0,0,0,,母です…
Dialogue: 0,0:21:58.92,0:22:01.30,TEXT-JP,,0,0,0,,私の母で間違いないです
Dialogue: 0,0:22:02.22,0:22:03.34,TEXT-JP,,0,0,0,,なんで…
Dialogue: 0,0:22:04.89,0:22:07.68,TEXT-JP,,0,0,0,,次は…俺や
Dialogue: 0,0:22:10.64,0:22:13.73,TEXT-JP,,0,0,0,,ノウヌキ様が…来る
Dialogue: 0,0:22:13.73,0:22:17.73,TEXT-JP,,0,0,0,,やっぱり忌堂の儀式は失敗しとったか
Dialogue: 0,0:22:17.73,0:22:20.32,TEXT-JP,,0,0,0,,どうする　武田よ
Dialogue: 0,0:22:22.49,0:22:24.07,TEXT-JP,,0,0,0,,分かりました
Dialogue: 0,0:22:24.07,0:22:26.74,TEXT-JP,,0,0,0,,じゃあ　朝イチでそちらに向かいます
Dialogue: 0,0:22:26.74,0:22:29.37,TEXT-JP,,0,0,0,,できる限りのことはしてみますよ
Dialogue: 0,0:22:29.37,0:22:30.54,TEXT-JP,,0,0,0,,武田さん
Dialogue: 0,0:22:33.79,0:22:37.59,TEXT-JP,,0,0,0,,クビタチは陰気臭いから行きたくねえんだけどなあ
Dialogue: 0,0:22:39.50,0:22:42.67,TEXT-JP,,0,0,0,,もっとも　アレは
Dialogue: 0,0:22:42.67,0:22:44.76,TEXT-JP,,0,0,0,,村人たちが思ってるほど
Dialogue: 0,0:22:44.76,0:22:47.43,TEXT-JP,,0,0,0,,簡単なもんじゃねえんですけど
Dialogue: 1,0:00:13.87,0:00:15.54,TEXT-CN,,0,0,0,,光
Dialogue: 1,0:00:15.54,0:00:17.62,TEXT-CN,,0,0,0,,喂 找到了吗
Dialogue: 1,0:00:23.50,0:00:25.34,TEXT-CN,,0,0,0,,光
Dialogue: 1,0:00:25.88,0:00:27.55,TEXT-CN,,0,0,0,,不行
Dialogue: 1,0:00:33.05,0:00:37.18,TEXT-CN,,0,0,0,,不能再这么找下去了 先回去吧
Dialogue: 1,0:00:37.98,0:00:39.06,TEXT-CN,,0,0,0,,好
Dialogue: 1,0:00:43.23,0:00:44.90,TEXT-CN,,0,0,0,,佳纪
Dialogue: 1,0:00:47.86,0:00:48.74,TEXT-CN,,0,0,0,,光
Dialogue: 1,0:00:53.91,0:00:55.99,TEXT-CN,,0,0,0,,光 光
Dialogue: 1,0:00:59.58,0:01:00.50,TEXT-CN,,0,0,0,,可恶
Dialogue: 1,0:01:06.13,0:01:08.05,TEXT-CN,,0,0,0,,除大人
Dialogue: 1,0:01:10.88,0:01:15.76,TEXT-CN,,16,0,0,,不管你是谁 陪在他身边吧…
Dialogue: 1,0:01:15.76,0:01:17.72,TEXT-CN,,0,0,0,,光
Dialogue: 1,0:01:42.29,0:01:45.13,TEXT-CN,,0,0,0,,奶奶 我买个冰淇淋
Dialogue: 1,0:01:47.00,0:01:48.25,TEXT-CN,,0,0,0,,好凉快
Dialogue: 1,0:01:48.25,0:01:49.96,TEXT-CN,,0,0,0,,话说 冰淇淋好少
Dialogue: 1,0:01:49.96,0:01:52.01,TEXT-CN,,35,0,0,,说什么「冰淇淋有售」
Dialogue: 1,0:01:53.80,0:01:55.43,TEXT-CN,,0,0,0,,明明只有棒冰
Dialogue: 1,0:01:58.18,0:02:01.43,TEXT-CN,,0,0,0,,而且「晾晾的冰淇淋」是什么鬼啦
Dialogue: 1,0:02:03.10,0:02:07.23,TEXT-CN,,0,0,0,,讨厌的原老 这么热的天居然叫我们跑马拉松
Dialogue: 1,0:02:07.23,0:02:10.03,TEXT-CN,,0,0,0,,根本就是遮磨人
Dialogue: 1,0:02:10.49,0:02:11.44,TEXT-CN,,0,0,0,,光
Dialogue: 1,0:02:12.15,0:02:14.20,TEXT-CN,,0,29,0,,「折磨」的音调不对
Dialogue: 1,0:02:15.20,0:02:17.28,TEXT-CN,,16,0,0,,你说成和「鲑鱼」一个音调了
Dialogue: 1,0:02:17.28,0:02:19.16,TEXT-CN,,0,0,0,,应该是「肛门」的音调
Dialogue: 1,0:02:19.62,0:02:24.17,TEXT-CN,,0,0,0,,这样啊 「折磨」…这么念是吧
Dialogue: 1,0:02:24.17,0:02:25.17,TEXT-CN,,0,0,0,,我会注意的
Dialogue: 1,0:02:27.71,0:02:32.01,TEXT-CN,,0,0,0,,我说你啊 在那座山上失踪了整整一周
Dialogue: 1,0:02:32.55,0:02:33.88,TEXT-CN,,0,0,0,,真的不记得了吗
Dialogue: 1,0:02:35.68,0:02:36.59,TEXT-CN,,0,0,0,,完全不记得
Dialogue: 1,0:02:38.76,0:02:41.77,TEXT-CN,,0,0,0,,也是 毕竟半年过去了你也没想起来
Dialogue: 1,0:02:41.77,0:02:44.85,TEXT-CN,,0,0,0,,你怎么还在说这件事啊
Dialogue: 1,0:02:44.85,0:02:48.15,TEXT-CN,,0,0,0,,你知道大家当时有多担心你吗
Dialogue: 1,0:02:51.19,0:02:53.24,TEXT-CN,,0,0,0,,没了我很孤单吗
Dialogue: 1,0:02:54.99,0:02:57.12,TEXT-CN,,0,0,0,,那倒没有
Dialogue: 1,0:02:57.12,0:02:59.49,TEXT-CN,,16,0,0,,骗人 你肯定哭了
Dialogue: 1,0:02:59.49,0:03:01.37,TEXT-CN,,0,0,0,,「别留下我一个人啊 光」
Dialogue: 1,0:03:01.37,0:03:02.95,TEXT-CN,,0,0,0,,别蹬鼻子上脸的
Dialogue: 1,0:03:02.95,0:03:04.83,TEXT-CN,,0,0,0,,又来
Dialogue: 1,0:03:04.83,0:03:07.38,TEXT-CN,,0,0,0,,你就是仗着比我高 动不动就来这套
Dialogue: 1,0:03:18.39,0:03:20.93,TEXT-CN,,0,0,0,,我能问你一个有点奇怪的问题吗
Dialogue: 1,0:03:21.76,0:03:24.39,TEXT-CN,,0,0,0,,干嘛 你要向我深情表白吗
Dialogue: 1,0:03:24.39,0:03:25.35,TEXT-CN,,0,0,0,,才不是
Dialogue: 1,0:03:26.27,0:03:31.27,TEXT-CN,,0,0,0,,怎么说呢 我不是一时突发奇想
Dialogue: 1,0:03:31.77,0:03:35.19,TEXT-CN,,0,0,0,,从你失踪又回来之后
Dialogue: 1,0:03:35.19,0:03:37.41,TEXT-CN,,0,0,0,,我就一直在想这件事了
Dialogue: 1,0:03:44.29,0:03:46.79,TEXT-CN,,0,0,0,,其实你
Dialogue: 1,0:03:47.37,0:03:49.04,TEXT-CN,,0,0,0,,不是光吧
Dialogue: 1,0:04:03.47,0:04:04.64,TEXT-CN,,0,0,0,,为什么
Dialogue: 1,0:04:06.27,0:04:09.52,TEXT-CN,,0,0,0,,我应该模仿得很完美啊
Dialogue: 1,0:04:23.16,0:04:24.37,TEXT-CN,,0,0,0,,求你了
Dialogue: 1,0:04:25.41,0:04:26.83,TEXT-CN,,0,0,0,,别告诉任何人
Dialogue: 1,0:04:27.62,0:04:30.08,TEXT-CN,,0,0,0,,我第一次做人
Dialogue: 1,0:04:30.08,0:04:33.88,TEXT-CN,,0,0,0,,上学 吃棒冰都是第一次 真的很开心
Dialogue: 1,0:04:34.38,0:04:36.80,TEXT-CN,,0,0,0,,虽然身体和人格都是借来的
Dialogue: 1,0:04:38.26,0:04:40.76,TEXT-CN,,0,0,0,,但是我好喜欢你
Dialogue: 1,0:04:41.26,0:04:43.10,TEXT-CN,,0,0,0,,所以拜托
Dialogue: 1,0:04:43.81,0:04:47.60,TEXT-CN,,0,0,0,,我不想杀你
Dialogue: 1,0:05:01.91,0:05:04.70,TEXT-CN,,0,0,0,,不管怎样 光已经不在了
Dialogue: 1,0:05:06.62,0:05:12.17,TEXT-CN,,0,0,0,,既然如此 哪怕是个冒牌货 我也希望它陪在我身边
Dialogue: 1,0:05:17.00,0:05:18.05,TEXT-CN,,0,0,0,,我知道了
Dialogue: 1,0:05:19.05,0:05:22.93,TEXT-CN,,0,0,0,,光 请多关照
Dialogue: 1,0:05:27.64,0:05:30.94,TEXT-CN,,16,0,0,,你从希望之山高中毕业之后 打算做什么
Dialogue: 1,0:05:32.06,0:05:34.36,TEXT-CN,,0,0,0,,我没怎么考虑过
Dialogue: 1,0:05:34.36,0:05:37.78,TEXT-CN,,0,0,0,,大概会接手爷爷的香菇店吧
Dialogue: 1,0:05:38.53,0:05:40.24,TEXT-CN,,0,0,0,,倒是你 打算怎么办
Dialogue: 1,0:05:40.70,0:05:42.82,TEXT-CN,,0,0,0,,我也还没仔细想过
Dialogue: 1,0:05:43.61,0:05:45.78,TEXT-CN,,0,0,0,,你这么聪明
Dialogue: 1,0:05:45.78,0:05:49.50,TEXT-CN,,0,0,0,,离开这个小村庄 去东京上大学不好吗
Dialogue: 1,0:05:49.50,0:05:53.50,TEXT-CN,,0,0,0,,怎么 难不成你是不想和我分开吗
Dialogue: 1,0:05:53.50,0:05:55.13,TEXT-CN,,0,0,0,,好恶心
Dialogue: 1,0:05:53.96,0:05:55.50,TEXT-CN-U,,0,0,0,,去死吧你
Dialogue: 1,0:05:56.29,0:05:59.38,TEXT-CN,,0,0,0,,要是你在东京一个人住
Dialogue: 1,0:05:59.38,0:06:01.51,TEXT-CN,,0,0,0,,我就赖在你家
Dialogue: 1,0:06:01.51,0:06:03.72,TEXT-CN,,0,0,0,,让你交到漂亮女朋友都带不回去
Dialogue: 1,0:06:03.72,0:06:05.51,TEXT-CN,,0,0,0,,我交不到女朋友的
Dialogue: 1,0:06:06.35,0:06:08.01,TEXT-CN,,0,0,0,,干嘛啊
Dialogue: 1,0:06:08.01,0:06:10.85,TEXT-CN,,0,0,0,,每次聊到这个 你就不开心
Dialogue: 1,0:06:12.39,0:06:14.90,TEXT-CN,,0,0,0,,女朋友而已 总会交到的
Dialogue: 1,0:06:15.94,0:06:16.98,TEXT-CN,,0,0,0,,光
Dialogue: 1,0:06:17.44,0:06:19.57,TEXT-CN,,17,0,0,,佳纪啊 怎么了
Dialogue: 1,0:06:19.57,0:06:21.24,TEXT-CN,,0,0,0,,你这周末有空吗
Dialogue: 1,0:06:23.49,0:06:26.82,TEXT-CN,,0,0,0,,那天我没空 我要去山上
Dialogue: 1,0:06:26.82,0:06:29.16,TEXT-CN,,0,0,0,,上山吗 为什么
Dialogue: 1,0:06:29.16,0:06:31.20,TEXT-CN,,0,0,0,,那个嘛
Dialogue: 1,0:06:31.20,0:06:33.46,TEXT-CN,,0,0,0,,保密
Dialogue: 1,0:06:42.01,0:06:46.51,TEXT-CN-U,,16,0,0,,佳纪 快起床 饭已经做好了
Dialogue: 1,0:06:42.51,0:06:47.01,TEXT-CN,,0,0,0,,是梦啊 是他还「活着」的时候
Dialogue: 1,0:06:49.85,0:06:54.81,TEXT-CN,,0,0,0,,见他的最后一面居然是在学原老说话 真无语
Dialogue: 1,0:07:08.99,0:07:12.70,TEXT-CN,,0,0,0,,佳纪 还不快来吃饭
Dialogue: 1,0:07:17.21,0:07:18.83,TEXT-CN,,0,0,0,,采了很多 分你家一点
Dialogue: 1,0:07:18.83,0:07:20.34,TEXT-CN,,0,0,0,,真是太谢谢了
Dialogue: 1,0:07:20.34,0:07:22.13,TEXT-CN,,0,0,0,,佳纪 早上好
Dialogue: 1,0:07:22.13,0:07:26.30,TEXT-CN,,0,0,0,,昨晚熬夜干什么去啦 灯一直开着呢
Dialogue: 1,0:07:29.10,0:07:30.55,TEXT-CN,,0,0,0,,我开动了
Dialogue: 1,0:07:31.35,0:07:32.77,TEXT-CN-U,,0,0,0,,早上好
Dialogue: 1,0:07:32.77,0:07:35.56,TEXT-CN-U,,0,0,0,,现在为大家播报今天全国的天气情况
Dialogue: 1,0:07:35.56,0:07:37.14,TEXT-CN-U,,0,0,0,,和往年相比 今年夏天
Dialogue: 1,0:07:37.14,0:07:40.23,TEXT-CN-U,,0,0,0,,全国预计将持续高温
Dialogue: 1,0:07:44.07,0:07:48.20,TEXT-CN-U,,0,0,0,,从日本海到东北地区 北海道地区有低气压逼近
Dialogue: 1,0:07:52.70,0:07:58.21,TEXT-CN-U,,0,0,0,,同时 日本东部与西部预计受到低气压影响 将出现强日照天气
Dialogue: 1,0:07:40.23,0:07:42.07,TEXT-CN,,0,0,0,,薰还在睡觉吗
Dialogue: 1,0:07:48.20,0:07:50.45,TEXT-CN,,0,0,0,,小光来找你啦
Dialogue: 1,0:07:50.45,0:07:51.99,TEXT-CN,,0,0,0,,我这就去
Dialogue: 1,0:07:58.21,0:08:02.21,TEXT-CN,,0,0,0,,刘海该剪了 要挡眼睛啦
Dialogue: 1,0:08:03.88,0:08:06.47,TEXT-CN,,0,0,0,,佳纪 早上好
Dialogue: 1,0:08:07.22,0:08:10.47,TEXT-CN,,16,0,0,,今…今天早上 我妈她…
Dialogue: 1,0:08:10.47,0:08:12.89,TEXT-CN,,16,0,0,,傻瓜 没时间了
Dialogue: 1,0:08:13.72,0:08:17.10,TEXT-CN,,16,0,0,,快走吧 要迟到了
Dialogue: 1,0:08:18.98,0:08:22.69,TEXT-CN,,0,0,0,,嗯 我也不想被原老批评
Dialogue: 1,0:08:22.69,0:08:23.86,TEXT-CN,,0,0,0,,这样就好
Dialogue: 1,0:08:25.74,0:08:28.03,TEXT-CN,,0,0,0,,我妈她买了西瓜回来
Dialogue: 1,0:08:28.03,0:08:29.74,TEXT-CN,,0,0,0,,于是我就吃了西瓜
Dialogue: 1,0:08:29.74,0:08:31.16,TEXT-CN,,0,0,0,,西瓜真好吃啊
Dialogue: 1,0:08:31.16,0:08:33.24,TEXT-CN,,0,0,0,,不管你到底是谁
Dialogue: 1,0:08:33.62,0:08:37.33,TEXT-CN,,0,0,0,,总比不在我身边要好得多
Dialogue: 1,0:08:43.71,0:08:44.67,TEXT-CN,,0,0,0,,你好
Dialogue: 1,0:08:44.67,0:08:46.51,TEXT-CN,,0,0,0,,您好
Dialogue: 1,0:08:46.51,0:08:50.47,TEXT-CN,,0,0,0,,我是公司派遣过来的 我叫田中
Dialogue: 1,0:08:51.68,0:08:57.64,TEXT-CN,,0,0,0,,静静地怀揣梦想
Dialogue: 1,0:08:58.31,0:09:03.98,TEXT-CN,,0,0,0,,悄悄地将梦探寻
Dialogue: 1,0:09:03.98,0:09:10.53,TEXT-CN,,0,0,0,,即便消逝的光芒一去不返
Dialogue: 1,0:09:10.53,0:09:15.66,TEXT-CN,,0,0,0,,令人心潮澎湃的未来仍在等待
Dialogue: 1,0:09:18.41,0:09:21.75,TEXT-CN,,16,0,0,,有问题的…
Dialogue: 1,0:09:23.67,0:09:25.46,TEXT-CN,,0,0,0,,就是那里吧
Dialogue: 1,0:09:27.67,0:09:31.93,TEXT-CN-U,,0,0,0,,朋友啊 那些哀伤
Dialogue: 1,0:09:31.93,0:09:37.39,TEXT-CN-U,,0,0,0,,是光彩斑斓的今日之影
Dialogue: 1,0:09:38.31,0:09:41.06,TEXT-CN-U,,0,0,0,,四处寻觅 茫然若失
Dialogue: 1,0:09:34.55,0:09:35.93,TEXT-CN,,0,0,0,,妈妈
Dialogue: 1,0:09:41.06,0:09:44.86,TEXT-CN-U,,0,0,0,,朋友啊 那些幸福
Dialogue: 1,0:09:44.02,0:09:46.94,TEXT-CN,,0,0,0,,感觉还有很大进步空间啊
Dialogue: 1,0:09:44.86,0:09:50.61,TEXT-CN-U,,0,0,0,,叩响了迷茫的心扉
Dialogue: 1,0:09:51.45,0:09:55.03,TEXT-CN-U,,0,0,0,,铭记于心 不懈…
Dialogue: 1,0:09:57.49,0:10:01.00,TEXT-CN,,0,0,0,,真没劲 为什么要搞合唱啊
Dialogue: 1,0:10:01.41,0:10:03.42,TEXT-CN,,0,0,0,,去年的文化节不是没办成吗
Dialogue: 1,0:10:03.42,0:10:05.00,TEXT-CN,,16,0,0,,说是合唱就算补办了
Dialogue: 1,0:10:05.00,0:10:06.75,TEXT-CN,,16,0,0,,什么
Dialogue: 1,0:10:07.34,0:10:09.00,TEXT-CN,,0,0,0,,我还挺喜欢唱歌的
Dialogue: 1,0:10:09.00,0:10:12.26,TEXT-CN,,0,0,0,,你不是光盯着歌词 完全没唱吗
Dialogue: 1,0:10:12.26,0:10:15.18,TEXT-CN,,0,0,0,,我想知道歌词什么意思嘛
Dialogue: 1,0:10:15.18,0:10:17.18,TEXT-CN,,0,0,0,,咦 你们要去哪里
Dialogue: 1,0:10:17.47,0:10:20.31,TEXT-CN,,0,0,0,,下节课不上理科 改成自习了
Dialogue: 1,0:10:20.31,0:10:22.52,TEXT-CN,,0,0,0,,说是要在教室看电影
Dialogue: 1,0:10:22.52,0:10:23.56,TEXT-CN,,0,0,0,,电影
Dialogue: 1,0:10:23.56,0:10:25.48,TEXT-CN,,0,0,0,,又来
Dialogue: 1,0:10:24.19,0:10:25.48,TEXT-CN-U,,16,0,0,,都第几回了
Dialogue: 1,0:10:25.48,0:10:27.19,TEXT-CN,,0,0,0,,就是说嘛
Dialogue: 1,0:10:28.23,0:10:33.32,TEXT-CN,,0,0,0,,哎呀 结果这次的事也跟那个东西毫不沾边
Dialogue: 1,0:10:33.32,0:10:35.99,TEXT-CN,,0,0,0,,是吗 真遗憾
Dialogue: 1,0:10:35.99,0:10:39.37,TEXT-CN,,0,0,0,,不过我们公司也真是不长记性
Dialogue: 1,0:10:40.16,0:10:42.54,TEXT-CN,,0,0,0,,到处找了几百年
Dialogue: 1,0:10:46.58,0:10:49.34,TEXT-CN,,0,0,0,,竟然还能维持住 没变成走个过场
Dialogue: 1,0:10:51.42,0:10:53.67,TEXT-CN,,0,0,0,,不要发公司的牢骚
Dialogue: 1,0:10:53.67,0:10:56.43,TEXT-CN,,0,0,0,,说不定会被传到上层的耳朵里
Dialogue: 1,0:10:56.43,0:10:58.22,TEXT-CN,,16,0,0,,知道了知道了
Dialogue: 1,0:10:58.22,0:11:02.77,TEXT-CN,,0,0,0,,工作我还是有在认真做的 不用担心
Dialogue: 1,0:11:08.11,0:11:12.53,TEXT-CN,,0,0,0,,算了 那个东西哪有那么容易找到
Dialogue: 1,0:11:17.28,0:11:19.49,TEXT-CN,,16,0,0,,你要干什么
Dialogue: 1,0:11:19.49,0:11:22.08,TEXT-CN,,0,0,0,,你一个女人 多什么嘴
Dialogue: 1,0:11:22.62,0:11:24.62,TEXT-CN-U,,0,0,0,,多的是可以代替你的…
Dialogue: 1,0:11:23.70,0:11:24.91,TEXT-CN,,0,0,0,,真无聊
Dialogue: 1,0:11:27.96,0:11:29.08,TEXT-CN,,16,0,0,,他哭了
Dialogue: 1,0:11:30.46,0:11:32.17,TEXT-CN,,16,0,0,,太可怜了
Dialogue: 1,0:11:32.88,0:11:34.88,TEXT-CN,,16,0,0,,你怎么哭了
Dialogue: 1,0:11:34.88,0:11:36.34,TEXT-CN,,0,0,0,,这不是看第5遍了吗
Dialogue: 1,0:11:37.09,0:11:40.14,TEXT-CN,,0,0,0,,虽然我有看过的记忆
Dialogue: 1,0:11:41.14,0:11:43.89,TEXT-CN,,0,0,0,,可是对我来说 还是第一次看啊
Dialogue: 1,0:11:45.39,0:11:47.73,TEXT-CN,,0,0,0,,再见啦 好热啊
Dialogue: 1,0:11:47.73,0:11:49.77,TEXT-CN,,0,0,0,,社团活动真没劲
Dialogue: 1,0:11:49.77,0:11:52.27,TEXT-CN,,0,0,0,,咦 钥匙呢
Dialogue: 1,0:11:52.27,0:11:54.53,TEXT-CN,,0,0,0,,没在包里吗
Dialogue: 1,0:11:54.99,0:11:57.03,TEXT-CN,,0,0,0,,自主练习还在好好练吗
Dialogue: 1,0:11:57.03,0:11:59.03,TEXT-CN,,0,0,0,,在哪啊
Dialogue: 1,0:11:59.62,0:12:00.74,TEXT-CN,,0,0,0,,快点回去吧
Dialogue: 1,0:12:00.74,0:12:02.58,TEXT-CN,,0,0,0,,哇 等下…
Dialogue: 1,0:12:03.58,0:12:04.79,TEXT-CN,,16,0,0,,找到了
Dialogue: 1,0:12:04.79,0:12:07.29,TEXT-CN,,16,0,0,,夹在「古典B」课本里面了
Dialogue: 1,0:12:09.42,0:12:10.42,TEXT-CN,,0,0,0,,那开始吧
Dialogue: 1,0:12:10.42,0:12:11.29,TEXT-CN,,0,0,0,,OK
Dialogue: 1,0:12:11.75,0:12:14.55,TEXT-CN,,0,0,0,,找到就好 快回去吧
Dialogue: 1,0:14:01.82,0:14:04.87,TEXT-CN,,0,0,0,,这个是我们以前偶尔会吃的那个吧
Dialogue: 1,0:14:04.87,0:14:05.82,TEXT-CN,,0,0,0,,是啊
Dialogue: 1,0:14:13.08,0:14:15.13,TEXT-CN,,0,0,0,,好好吃 好酥脆
Dialogue: 1,0:14:15.13,0:14:17.46,TEXT-CN,,0,0,0,,虽说早就知道是这味道
Dialogue: 1,0:14:19.96,0:14:21.30,TEXT-CN,,0,0,0,,太大声了吧
Dialogue: 1,0:14:21.30,0:14:23.01,TEXT-CN,,0,0,0,,不过真奇怪啊
Dialogue: 1,0:14:23.01,0:14:25.64,TEXT-CN,,0,0,0,,明明有记忆 还会感觉很新鲜吗
Dialogue: 1,0:14:25.64,0:14:27.97,TEXT-CN,,0,0,0,,虽然跟记忆里完全一样
Dialogue: 1,0:14:27.97,0:14:29.85,TEXT-CN,,0,0,0,,可之前并没有实感
Dialogue: 1,0:14:29.85,0:14:32.56,TEXT-CN,,0,0,0,,毕竟我根本就没活过嘛
Dialogue: 1,0:14:32.56,0:14:35.35,TEXT-CN,,0,0,0,,这样清晰地感受到自己存在 还是第一次
Dialogue: 1,0:14:36.98,0:14:38.48,TEXT-CN,,0,0,0,,你是幽灵吗
Dialogue: 1,0:14:39.40,0:14:40.69,TEXT-CN,,0,0,0,,怎么说呢
Dialogue: 1,0:14:40.69,0:14:42.15,TEXT-CN,,0,0,0,,幽灵
Dialogue: 1,0:14:43.24,0:14:45.45,TEXT-CN,,0,0,0,,这么说也不太贴切吧
Dialogue: 1,0:14:45.45,0:14:47.74,TEXT-CN,,0,0,0,,总之肯定是怪物之类的啦
Dialogue: 1,0:14:50.04,0:14:50.66,TEXT-CN,,0,0,0,,喵
Dialogue: 1,0:14:50.66,0:14:51.87,TEXT-CN,,0,0,0,,这不是肉饼哥嘛
Dialogue: 1,0:14:51.87,0:14:54.00,TEXT-CN,,0,0,0,,这家伙从肉铺讨吃的
Dialogue: 1,0:14:54.00,0:14:55.75,TEXT-CN,,0,0,0,,又胖了吧
Dialogue: 1,0:14:55.75,0:14:57.13,TEXT-CN,,0,0,0,,嗯 还真是
Dialogue: 1,0:15:04.63,0:15:07.18,TEXT-CN,,0,0,0,,那只猫跑这么快的吗
Dialogue: 1,0:15:09.47,0:15:12.39,TEXT-CN,,0,0,0,,镇上你还有别的想去的地方吗
Dialogue: 1,0:15:12.39,0:15:14.77,TEXT-CN,,0,0,0,,你要陪我一起去吗
Dialogue: 1,0:15:15.39,0:15:17.52,TEXT-CN,,16,0,0,,那个 怎么说呢…
Dialogue: 1,0:15:17.52,0:15:21.36,TEXT-CN,,0,0,0,,你对我这种人还是像以前一样体贴啊
Dialogue: 1,0:15:22.99,0:15:24.57,TEXT-CN,,0,0,0,,这不是体贴
Dialogue: 1,0:15:24.57,0:15:28.66,TEXT-CN,,0,0,0,,越纵容自己的人 越宽容别人
Dialogue: 1,0:15:28.66,0:15:30.41,TEXT-CN,,0,0,0,,虽然不太懂
Dialogue: 1,0:15:30.41,0:15:33.66,TEXT-CN,,0,0,0,,但对我来说 这依旧是你的体贴之处
Dialogue: 1,0:15:42.17,0:15:45.05,TEXT-CN,,0,0,0,,馅料换成豆粒馅了吧
Dialogue: 1,0:15:45.05,0:15:47.05,TEXT-CN,,17,0,0,,所以…
Dialogue: 1,0:15:52.93,0:15:55.31,TEXT-CN,,0,0,0,,接下来去哪
Dialogue: 1,0:16:04.49,0:16:06.86,TEXT-CN,,0,0,0,,哦哦 是蜻蜓啊
Dialogue: 1,0:16:06.86,0:16:09.62,TEXT-CN,,0,0,0,,是夏赤蜻 红蜻蜓
Dialogue: 1,0:16:09.62,0:16:11.62,TEXT-CN,,0,0,0,,虽然还不是很红
Dialogue: 1,0:16:11.62,0:16:14.62,TEXT-CN,,0,0,0,,是红蜻蜓啊 现在可是夏天啊
Dialogue: 1,0:16:14.62,0:16:17.50,TEXT-CN,,0,0,0,,象征秋天的是秋赤蜻
Dialogue: 1,0:16:17.50,0:16:20.08,TEXT-CN,,0,0,0,,这是夏赤蜻
Dialogue: 1,0:16:20.08,0:16:21.25,TEXT-CN,,0,0,0,,有什么不一样啊
Dialogue: 1,0:16:22.96,0:16:24.92,TEXT-CN,,0,0,0,,解释起来好麻烦
Dialogue: 1,0:16:24.92,0:16:26.76,TEXT-CN,,0,0,0,,夏赤蜻和秋赤蜻
Dialogue: 1,0:16:26.76,0:16:29.51,TEXT-CN,,0,0,0,,长得差不多 但其实是两种昆虫
Dialogue: 1,0:16:30.22,0:16:32.89,TEXT-CN,,0,0,0,,不愧是埃米尔
Dialogue: 1,0:16:33.76,0:16:35.68,TEXT-CN,,16,0,0,,这家伙到底是什么
Dialogue: 1,0:16:35.68,0:16:39.65,TEXT-CN,,0,0,0,,外表与光别无二致 却并非光的某种东西
Dialogue: 1,0:16:39.65,0:16:43.57,TEXT-CN,,0,0,0,,啊 等等
Dialogue: 1,0:16:43.57,0:16:44.78,TEXT-CN,,0,0,0,,怎么了
Dialogue: 1,0:16:45.69,0:16:47.28,TEXT-CN,,16,0,0,,太疯狂了
Dialogue: 1,0:16:47.28,0:16:51.37,TEXT-CN,,0,0,0,,我能接受现状也真是疯了 好可怕 好可怕 好可怕
Dialogue: 1,0:16:51.37,0:16:54.20,TEXT-CN,,0,0,0,,到底是什么东西啊 饶了我吧
Dialogue: 1,0:16:54.20,0:16:56.12,TEXT-CN,,0,0,0,,我好恶心 我好恶心 完全搞不懂
Dialogue: 1,0:16:56.12,0:16:59.46,TEXT-CN,,0,0,0,,就算这个光是冒牌货 我也想他陪在我身边
Dialogue: 1,0:17:00.62,0:17:01.88,TEXT-CN,,0,0,0,,啊 对了
Dialogue: 1,0:17:01.88,0:17:03.88,TEXT-CN,,0,0,0,,下次我去你家
Dialogue: 1,0:17:03.88,0:17:06.88,TEXT-CN,,0,0,0,,接着看「Master Master」吧
Dialogue: 1,0:17:09.26,0:17:10.88,TEXT-CN,,0,0,0,,嗯 好啊
Dialogue: 1,0:17:12.39,0:17:13.89,TEXT-CN,,0,0,0,,你看到哪里了来着
Dialogue: 1,0:17:14.18,0:17:16.14,TEXT-CN,,0,0,0,,罗恩离开岛了
Dialogue: 1,0:17:16.14,0:17:18.77,TEXT-CN,,0,0,0,,那相当于才看到开头嘛
Dialogue: 1,0:17:18.77,0:17:21.90,TEXT-CN,,0,0,0,,可以啊 那下次来我家看吧
Dialogue: 1,0:17:21.90,0:17:23.56,TEXT-CN,,0,0,0,,啊 不过我缺第三卷
Dialogue: 1,0:17:24.94,0:17:27.44,TEXT-CN,,0,0,0,,总能看懂啦 没关系
Dialogue: 1,0:17:27.44,0:17:31.15,TEXT-CN,,0,0,0,,但我很好奇 为啥第一卷有11本啊
Dialogue: 1,0:17:36.87,0:17:39.45,TEXT-CN,,16,0,0,,为啥…啊…
Dialogue: 1,0:17:39.45,0:17:44.50,TEXT-CN,,0,0,0,,除脑大人从山上下来了
Dialogue: 1,0:17:45.00,0:17:47.55,TEXT-CN,,0,0,0,,她说什么呢 什么大人啊
Dialogue: 1,0:17:47.55,0:17:49.30,TEXT-CN,,0,0,0,,别管她 别管她
Dialogue: 1,0:17:49.30,0:17:52.18,TEXT-CN,,0,0,0,,最讨厌这样的
Dialogue: 1,0:17:52.18,0:17:53.68,TEXT-CN,,0,0,0,,真吓人
Dialogue: 1,0:17:55.64,0:17:58.68,TEXT-CN,,0,0,0,,别过来 滚开
Dialogue: 1,0:18:03.35,0:18:05.48,TEXT-CN,,0,0,0,,走吧 光
Dialogue: 1,0:18:06.27,0:18:07.07,TEXT-CN,,0,0,0,,嗯
Dialogue: 1,0:18:13.24,0:18:17.95,TEXT-CN,,0,0,0,,光确实已经死了 对吧
Dialogue: 1,0:18:20.25,0:18:21.46,TEXT-CN,,0,0,0,,嗯
Dialogue: 1,0:18:21.46,0:18:25.04,TEXT-CN,,0,0,0,,这个身体 虽然有脉搏有体温
Dialogue: 1,0:18:25.63,0:18:27.17,TEXT-CN,,16,0,0,,但已经死了
Dialogue: 1,0:18:27.17,0:18:29.09,TEXT-CN,,16,0,0,,那是你…
Dialogue: 1,0:18:29.09,0:18:30.30,TEXT-CN,,0,0,0,,不是的
Dialogue: 1,0:18:30.92,0:18:33.59,TEXT-CN,,0,0,0,,我遇见他时 他已经奄奄一息了
Dialogue: 1,0:18:33.59,0:18:35.09,TEXT-CN,,0,0,0,,真的
Dialogue: 1,0:18:36.80,0:18:41.10,TEXT-CN,,0,0,0,,我记得我一直在山里徘徊
Dialogue: 1,0:18:41.10,0:18:43.85,TEXT-CN,,0,0,0,,总之徘徊了很久
Dialogue: 1,0:18:43.85,0:18:46.19,TEXT-CN,,0,0,0,,已经什么都感觉不到了
Dialogue: 1,0:18:46.19,0:18:48.69,TEXT-CN,,0,0,0,,感觉一直就像一台机器一样
Dialogue: 1,0:18:48.69,0:18:52.69,TEXT-CN,,0,0,0,,然后我就遇到快要死掉的光…
Dialogue: 1,0:18:53.15,0:18:56.95,TEXT-CN,,16,0,0,,等我回过神来 就变成这样了
Dialogue: 1,0:19:02.54,0:19:04.75,TEXT-CN,,0,0,0,,佳纪 明天见
Dialogue: 1,0:19:07.58,0:19:10.80,TEXT-CN,,0,0,0,,你…喜欢我吗
Dialogue: 1,0:19:10.80,0:19:12.42,TEXT-CN,,16,0,0,,什么
Dialogue: 1,0:19:23.43,0:19:24.52,TEXT-CN,,0,0,0,,喜欢啊
Dialogue: 1,0:19:26.10,0:19:27.65,TEXT-CN,,0,0,0,,超级喜欢
Dialogue: 1,0:19:31.98,0:19:36.74,TEXT-CN,,0,0,0,,你以前 可从没有这样说过
Dialogue: 1,0:19:39.57,0:19:44.04,TEXT-CN,,0,0,0,,既然这样 就别再随便消失了
Dialogue: 1,0:20:01.72,0:20:03.22,TEXT-CN,,16,0,0,,第一学期马上都要结束了
Dialogue: 1,0:20:03.22,0:20:04.73,TEXT-CN,,0,0,0,,她今天又没去学校
Dialogue: 1,0:20:06.23,0:20:07.98,TEXT-CN,,0,0,0,,你觉得这样没问题吗
Dialogue: 1,0:20:07.98,0:20:11.23,TEXT-CN,,0,0,0,,当妈的觉得没问题 就没问题吧
Dialogue: 1,0:20:12.73,0:20:14.48,TEXT-CN,,0,0,0,,根本不是这回事
Dialogue: 1,0:20:14.48,0:20:16.74,TEXT-CN,,0,0,0,,你有好好考虑过薰的事吗
Dialogue: 1,0:20:21.24,0:20:23.24,TEXT-CN,,0,0,0,,别过来 别过来
Dialogue: 1,0:20:23.58,0:20:27.04,TEXT-CN-U,,16,0,0,,松浦女士 快递到了
Dialogue: 1,0:20:25.37,0:20:28.25,TEXT-CN,,0,0,0,,我不…不会开门的
Dialogue: 1,0:20:28.25,0:20:30.71,TEXT-CN,,0,0,0,,有啊 毕竟我是她爸啊
Dialogue: 1,0:20:31.25,0:20:32.96,TEXT-CN,,0,0,0,,松浦女士
Dialogue: 1,0:20:33.75,0:20:36.80,TEXT-CN,,0,0,0,,你只顾自己 根本没考虑孩子的事吧
Dialogue: 1,0:20:36.80,0:20:39.26,TEXT-CN,,0,0,0,,你以为光工作挣钱就够了吗
Dialogue: 1,0:20:39.26,0:20:42.72,TEXT-CN,,0,0,0,,松浦女士 松浦女士
Dialogue: 1,0:20:43.22,0:20:45.77,TEXT-CN,,0,0,0,,咦 不在家吗
Dialogue: 1,0:20:49.69,0:20:53.65,TEXT-CN,,0,0,0,,大…大半夜的 怎么可能有…有快递
Dialogue: 1,0:20:53.65,0:20:55.57,TEXT-CN,,0,0,0,,您在家的吧
Dialogue: 1,0:20:56.28,0:20:58.15,TEXT-CN,,0,0,0,,松浦女士
Dialogue: 1,0:20:58.74,0:21:03.03,TEXT-CN,,0,0,0,,松浦女士 松浦女士
Dialogue: 1,0:21:03.03,0:21:04.53,TEXT-CN,,0,0,0,,不 不要
Dialogue: 1,0:21:04.53,0:21:09.92,TEXT-CN,,0,0,0,,不会让你进来的
Dialogue: 1,0:21:07.83,0:21:09.29,TEXT-CN-U,,0,0,0,,松浦女士
Dialogue: 1,0:21:16.59,0:21:18.22,TEXT-CN,,0,0,0,,松浦女士
Dialogue: 1,0:21:21.51,0:21:23.60,TEXT-CN,,0,0,0,,我已经进来了
Dialogue: 1,0:21:36.69,0:21:38.94,TEXT-CN,,0,0,0,,晚安 光
Dialogue: 1,0:21:57.05,0:21:58.34,TEXT-CN,,0,0,0,,是我母亲
Dialogue: 1,0:21:58.92,0:22:01.30,TEXT-CN,,0,0,0,,是我母亲没错
Dialogue: 1,0:22:02.22,0:22:03.34,TEXT-CN,,0,0,0,,为什么
Dialogue: 1,0:22:04.89,0:22:07.68,TEXT-CN,,0,0,0,,下一个 就轮到我了
Dialogue: 1,0:22:10.64,0:22:13.73,TEXT-CN,,0,0,0,,除脑大人…要来了
Dialogue: 1,0:22:13.73,0:22:17.73,TEXT-CN,,16,0,0,,果然 忌堂的仪式失败了
Dialogue: 1,0:22:17.73,0:22:20.32,TEXT-CN,,0,0,0,,怎么办 武田
Dialogue: 1,0:22:22.49,0:22:24.07,TEXT-CN,,0,0,0,,明白了
Dialogue: 1,0:22:24.07,0:22:26.74,TEXT-CN,,0,0,0,,那明天一早我就过去
Dialogue: 1,0:22:26.74,0:22:29.37,TEXT-CN,,0,0,0,,我会尽力而为
Dialogue: 1,0:22:29.37,0:22:30.54,TEXT-CN,,0,0,0,,武田先生
Dialogue: 1,0:22:33.79,0:22:37.59,TEXT-CN,,0,0,0,,首断村阴森森的 真不想去啊
Dialogue: 1,0:22:39.50,0:22:42.67,TEXT-CN,,0,0,0,,不过那东西
Dialogue: 1,0:22:42.67,0:22:44.76,TEXT-CN,,0,0,0,,可不像村民们想的
Dialogue: 1,0:22:44.76,0:22:47.43,TEXT-CN,,0,0,0,,那么简单呢
Dialogue: 1,0:02:03.10,0:02:07.23,NOTES,,0,0,0,,「原老」：动画《我们这一家》中，教学认真严厉的原老师被学生起的昵称
Dialogue: 1,0:16:30.22,0:16:32.89,NOTES,,0,0,0,,「埃米尔」：黑塞短篇「少年时的回忆」中熟识昆虫的少年。日译版因收录于日本教材而广为人知。

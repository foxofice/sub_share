Dialogue: 0,0:01:31.86,0:01:35.99,Title,,0,0,0,,{\blur2\fad(350,523)\3c&HDAAA69&\pos(1498.902,922)}#10 追上讨伐队
Dialogue: 0,0:23:55.91,0:24:00.92,Next Title,,0,0,0,,{\bord2\blur2\3c&HE7AF6F&\pos(960,474)}#11 古城决战
Comment: 0,0:00:01.00,0:00:01.00,staff,Sub,0,0,0,,
Dialogue: 0,0:01:35.46,0:01:38.31,Sub-CN,,0,0,0,,你在做新的炸弹吗 莱莎
Dialogue: 0,0:01:38.72,0:01:41.81,Sub-CN,,0,0,0,,其实我陷入了瓶颈
Dialogue: 0,0:01:42.57,0:01:46.32,Sub-CN,,0,0,0,,而且现在能给我建议的安佩尔先生也不在
Dialogue: 0,0:01:47.95,0:01:50.79,Sub-CN,,0,0,0,,万幸 似乎是没有出现死者
Dialogue: 0,0:01:51.19,0:01:52.70,Sub-CN,,0,0,0,,我们这边也确认过了
Dialogue: 0,0:01:53.03,0:01:55.85,Sub-CN,,0,0,0,,但是 既然实际出现了伤者
Dialogue: 0,0:01:55.85,0:01:58.20,Sub-CN,,0,0,0,,海道这边的往来应该先中止吧
Dialogue: 0,0:01:58.69,0:02:02.21,Sub-CN,,0,0,0,,也没办法避免对村民的生活造成负面影响
Dialogue: 0,0:02:02.78,0:02:07.11,Sub-CN,,0,0,0,,最低限度的运输可以派出保镖来守卫
Dialogue: 0,0:02:07.73,0:02:13.40,Sub-CN,,0,0,0,,确实可以 但是龙还在附近徘徊的话 这也只是权宜之计
Dialogue: 0,0:02:15.28,0:02:19.73,Sub-CN,,0,0,0,,感觉似乎需要跟莫里茨先生再商量一下
Dialogue: 0,0:02:20.08,0:02:22.09,Sub-CN,,0,0,0,,果然事态变严重了呢
Dialogue: 0,0:02:26.12,0:02:27.75,Sub-CN,,0,0,0,,这可是村庄的危机
Dialogue: 0,0:02:28.17,0:02:30.96,Sub-CN,,0,0,0,,才没有时间用那种悠闲的方法解决
Dialogue: 0,0:02:32.53,0:02:34.60,Sub-CN,,0,0,0,,你们是不是搞错了什么
Dialogue: 0,0:02:36.18,0:02:37.89,Sub-CN,,0,0,0,,吵起来了呢
Dialogue: 0,0:02:36.59,0:02:41.47,Sub-CN-UP,,0,0,0,,对抗的是龙的话 就不能轻举妄动
Dialogue: 0,0:02:41.84,0:02:45.31,Sub-CN,,0,0,0,,我们明白您儿子受伤导致的急迫心情
Dialogue: 0,0:02:45.31,0:02:46.94,Sub-CN,,0,0,0,,可是希望您能冷静一点
Dialogue: 0,0:02:47.26,0:02:48.94,Sub-CN,,0,0,0,,我的那个儿子
Dialogue: 0,0:02:49.40,0:02:52.04,Sub-CN,,0,0,0,,作为勇敢的布伦嫩家族的一员
Dialogue: 0,0:02:52.04,0:02:54.92,Sub-CN,,0,0,0,,说是要去讨伐龙
Dialogue: 0,0:02:55.87,0:02:57.13,Sub-CN,,0,0,0,,说什么傻话
Dialogue: 0,0:02:57.13,0:03:00.45,Sub-CN,,0,0,0,,古城的龙可是应被敬仰的本岛的守护兽
Dialogue: 0,0:03:00.45,0:03:02.45,Sub-CN,,0,0,0,,讨伐什么的不可再提
Dialogue: 0,0:03:02.85,0:03:05.70,Sub-CN,,0,0,0,,像之前那样一直待在岛上就可以
Dialogue: 0,0:03:06.68,0:03:09.21,Sub-CN,,0,0,0,,真是丝毫不现实啊
Dialogue: 0,0:03:09.75,0:03:11.08,Sub-CN,,0,0,0,,就我来说
Dialogue: 0,0:03:11.08,0:03:13.31,Sub-CN,,0,0,0,,为了保护岛内安宁
Dialogue: 0,0:03:13.31,0:03:16.62,Sub-CN,,0,0,0,,不管那龙是守护兽还是恶魔
Dialogue: 0,0:03:16.62,0:03:18.29,Sub-CN,,0,0,0,,也都应该被讨伐
Dialogue: 0,0:03:18.29,0:03:20.13,Sub-CN,,0,0,0,,莫里茨阁下
Dialogue: 0,0:03:20.13,0:03:23.48,Sub-CN,,0,0,0,,那不是应该现在凭气势就决定的事情吧
Dialogue: 0,0:03:23.48,0:03:26.47,Sub-CN,,0,0,0,,吵死了 这可是我决定的事情
Dialogue: 0,0:03:26.89,0:03:29.08,Sub-CN,,0,0,0,,我要派遣讨伐龙的队伍
Dialogue: 0,0:03:29.08,0:03:31.32,Sub-CN,,0,0,0,,讨伐龙?
Dialogue: 0,0:03:31.80,0:03:34.64,Sub-CN,,0,0,0,,总感觉变成了不得了的事情
Dialogue: 0,0:03:35.88,0:03:37.49,Sub-CN,,0,0,0,,是我推动他这样做的
Dialogue: 0,0:03:38.67,0:03:40.41,Sub-CN,,0,0,0,,博斯
Dialogue: 0,0:03:41.44,0:03:43.68,Sub-CN,,0,0,0,,那个时候只是我大意了而已
Dialogue: 0,0:03:44.19,0:03:47.00,Sub-CN,,0,0,0,,这次我一定要收拾掉它
Dialogue: 0,0:03:48.11,0:03:49.10,Sub-CN,,0,0,0,,走了郎巴
Dialogue: 0,0:03:49.75,0:03:51.21,Sub-CN,,0,0,0,,啊 是
Dialogue: 0,0:03:51.92,0:03:52.89,Sub-CN,,0,0,0,,你们定好了吧
Dialogue: 0,0:03:53.55,0:03:55.30,Sub-CN,,0,0,0,,哦哦博斯
Dialogue: 0,0:03:55.71,0:03:59.22,Sub-CN,,0,0,0,,当然也会让我加入讨伐龙的队伍吧
Dialogue: 0,0:03:59.60,0:04:01.51,Sub-CN,,0,0,0,,这 这样啊
Dialogue: 0,0:04:02.73,0:04:04.31,Sub-CN,,0,0,0,,你是认真的吗 博斯
Dialogue: 0,0:04:04.65,0:04:05.64,Sub-CN,,0,0,0,,当然了
Dialogue: 0,0:04:07.06,0:04:07.90,Sub-CN,,0,0,0,,给我看好了
Dialogue: 0,0:04:19.82,0:04:21.61,Sub-CN,,0,0,0,,讨伐龙的队伍
Dialogue: 0,0:04:22.85,0:04:25.31,Sub-CN,,0,0,0,,博斯也加入了啊
Dialogue: 0,0:04:26.01,0:04:27.13,Sub-CN,,0,0,0,,那家伙…
Dialogue: 0,0:04:27.13,0:04:28.33,Sub-CN,,0,0,0,,就知道乱来
Dialogue: 0,0:04:29.85,0:04:33.69,Sub-CN,,0,0,0,,如果安佩尔先生和莉拉小姐在就好了
Dialogue: 0,0:04:51.90,0:04:53.77,Sub-CN,,0,0,0,,竟然要跟那个打架
Dialogue: 0,0:04:54.13,0:04:58.38,Sub-CN,,0,0,0,,阿佳特姐姐没问题吧 还有博斯
Dialogue: 0,0:04:59.40,0:05:00.57,Sub-CN,,0,0,0,,还有郎巴
Dialogue: 0,0:05:02.97,0:05:06.39,Sub-CN,,0,0,0,,干脆我也申请加入讨伐队吧
Dialogue: 0,0:05:08.55,0:05:11.02,Sub-CN,,0,0,0,,也只会被嘲笑吧
Dialogue: 0,0:05:12.35,0:05:15.60,Sub-CN,,0,0,0,,至少得等那个新炸弹做好…
Dialogue: 0,0:05:28.06,0:05:31.90,Sub-CN,,0,0,0,,要让我加入了讨伐龙的队伍吗
Dialogue: 0,0:05:32.37,0:05:36.83,Sub-CN,,0,0,0,,对 你是这个岛上首屈一指的战士
Dialogue: 0,0:05:36.83,0:05:39.07,Sub-CN,,0,0,0,,在外面战斗的经验也很丰富
Dialogue: 0,0:05:39.44,0:05:40.67,Sub-CN,,0,0,0,,正是在这种时刻…
Dialogue: 0,0:05:41.02,0:05:44.40,Sub-CN,,0,0,0,,我还想着大早上的你们到底是过来做什么的
Dialogue: 0,0:05:49.33,0:05:54.71,Sub-CN,,0,0,0,,根据我的战斗经验来说
Dialogue: 0,0:05:55.80,0:05:59.53,Sub-CN,,0,0,0,,去参加那种东西是笨蛋才做的事情
Dialogue: 0,0:05:59.53,0:06:03.62,Sub-CN,,0,0,0,,别管就好了 到那个东西不知道消失在哪里的为止
Dialogue: 0,0:06:04.09,0:06:07.60,Sub-CN,,0,0,0,,阿佳特 你跟这种家伙说什么都没有用的
Dialogue: 0,0:06:07.60,0:06:08.52,Sub-CN,,0,0,0,,我们撤吧
Dialogue: 0,0:06:10.11,0:06:13.23,Sub-CN,,0,0,0,,人家明明在亲切的告诫你
Dialogue: 0,0:06:12.58,0:06:13.23,Sub-CN-UP,,0,0,0,,老爹
Dialogue: 0,0:06:13.67,0:06:14.81,Sub-CN,,0,0,0,,你明明是个战士
Dialogue: 0,0:06:15.23,0:06:17.76,Sub-CN,,0,0,0,,却连参加战斗的力量都没有了吗
Dialogue: 0,0:06:17.76,0:06:23.30,Sub-CN,,0,0,0,,什么啊 小鸡仔还想堂堂正正的来说什么是战士吗
Dialogue: 0,0:06:28.83,0:06:31.69,Sub-CN,,0,0,0,,连生命的本质都不知道的小鬼
Dialogue: 0,0:06:36.79,0:06:39.20,Sub-CN,,0,0,0,,你看 果然不行吧
Dialogue: 0,0:06:39.75,0:06:41.89,Sub-CN,,0,0,0,,阿佳特 我们回去做准备吧
Dialogue: 0,0:07:03.95,0:07:04.79,Sub-CN,,0,0,0,,老爹
Dialogue: 0,0:07:06.43,0:07:08.99,Sub-CN,,0,0,0,,如果你不战斗的话 就把剑借给我
Dialogue: 0,0:07:09.37,0:07:11.51,Sub-CN,,0,0,0,,我需要更锋利的剑
Dialogue: 0,0:07:18.16,0:07:20.35,Sub-CN,,0,0,0,,你要用它战斗吗
Dialogue: 0,0:07:20.72,0:07:24.61,Sub-CN,,0,0,0,,像你这样的小鸡仔 要跟龙战斗
Dialogue: 0,0:07:32.40,0:07:34.41,Sub-CN,,0,0,0,,我可不想把剑借给你去参加什么小孩的游戏
Dialogue: 0,0:07:44.15,0:07:45.71,Sub-CN,漏翻,0,0,0,,加油哦
Dialogue: 0,0:07:44.80,0:07:46.20,Sub-CN-UP,,0,0,0,,小心一点
Dialogue: 0,0:07:46.93,0:07:48.96,Sub-CN-UP,,0,0,0,,不要大意啊
Dialogue: 0,0:07:48.96,0:07:50.46,Sub-CN-UP,,0,0,0,,爸爸 加油
Dialogue: 0,0:07:57.37,0:07:58.40,Sub-CN,,0,0,0,,我们出发了
Dialogue: 0,0:08:00.31,0:08:01.20,Sub-CN,,0,0,0,,拜托你们了
Dialogue: 0,0:08:05.13,0:08:05.81,Sub-CN,,0,0,0,,父亲
Dialogue: 0,0:08:06.41,0:08:09.75,Sub-CN,,0,0,0,,我会向大家证明布伦嫩家男子的勇敢和强壮
Dialogue: 0,0:08:10.61,0:08:11.41,Sub-CN,,0,0,0,,好
Dialogue: 0,0:08:13.32,0:08:16.80,Sub-CN,,0,0,0,,郎巴 博斯就拜托你了
Dialogue: 0,0:08:17.87,0:08:20.13,Sub-CN,,0,0,0,,请…请交给我吧
Dialogue: 0,0:08:20.97,0:08:22.16,Sub-CN,,0,0,0,,出发了
Dialogue: 0,0:08:33.83,0:08:35.52,Sub-CN,,0,0,0,,是斥候的痕迹
Dialogue: 0,0:08:36.07,0:08:37.01,Sub-CN,,0,0,0,,抓到线索了吗
Dialogue: 0,0:08:37.69,0:08:40.50,Sub-CN,,0,0,0,,不过它真是来到了相当深处的地方呢
Dialogue: 0,0:08:41.19,0:08:42.57,Sub-CN,,0,0,0,,没办法
Dialogue: 0,0:08:42.93,0:08:45.00,Sub-CN,,0,0,0,,必须尽可能解决掉斥候
Dialogue: 0,0:08:45.59,0:08:47.49,Sub-CN,,0,0,0,,减少被带回去的情报
Dialogue: 0,0:08:47.98,0:08:49.45,Sub-CN,,0,0,0,,如果来到这里的
Dialogue: 0,0:08:49.91,0:08:53.03,Sub-CN,,0,0,0,,只有莱莎他们遭遇的那一只就好了
Dialogue: 0,0:08:54.97,0:08:55.78,Sub-CN,,0,0,0,,走吧
Dialogue: 0,0:09:05.33,0:09:07.50,Sub-CN,,0,0,0,,讨伐队出发了呢
Dialogue: 0,0:09:08.16,0:09:08.91,Sub-CN,,0,0,0,,是啊
Dialogue: 0,0:09:11.09,0:09:13.59,Sub-CN,,0,0,0,,讨伐队会从街道北上
Dialogue: 0,0:09:13.93,0:09:16.12,Sub-CN,,0,0,0,,从火山旁进入山中
Dialogue: 0,0:09:16.61,0:09:19.89,Sub-CN,,0,0,0,,明天的傍晚应该就能到达古城了
Dialogue: 0,0:09:20.67,0:09:24.04,Sub-CN,,0,0,0,,还特地绕到魏斯伯格火山啊
Dialogue: 0,0:09:24.69,0:09:26.71,Sub-CN,,0,0,0,,因为古城在断崖上
Dialogue: 0,0:09:27.08,0:09:30.72,Sub-CN,,0,0,0,,所以只能从层山叠嶂的火山侧进入了
Dialogue: 0,0:09:31.11,0:09:32.90,Sub-CN,,0,0,0,,兰托 你对地形很了解啊
Dialogue: 0,0:09:33.49,0:09:35.60,Sub-CN,,0,0,0,,虽然莉拉小姐讲得很随便
Dialogue: 0,0:09:36.01,0:09:38.41,Sub-CN,,0,0,0,,但她也把那附近的地形都教给我了
Dialogue: 0,0:09:42.69,0:09:44.62,Sub-CN,,0,0,0,,博斯真的没问题吗
Dialogue: 0,0:09:50.83,0:09:55.01,Sub-CN,,0,0,0,,果然大家都很担心博斯呢
Dialogue: 0,0:09:57.03,0:09:59.03,Sub-CN,,0,0,0,,你们以前关系很好的吧
Dialogue: 0,0:09:59.61,0:10:01.24,Sub-CN,,0,0,0,,为什么现在变成了这样
Dialogue: 0,0:10:04.19,0:10:06.37,Sub-CN,,0,0,0,,以前是以前啊
Dialogue: 0,0:10:06.75,0:10:07.79,Sub-CN,,0,0,0,,现在…
Dialogue: 0,0:10:09.01,0:10:13.58,Sub-CN,,0,0,0,,那家伙也绝不肯认同我们
Dialogue: 0,0:10:14.24,0:10:15.58,Sub-CN,,0,0,0,,即便如此
Dialogue: 0,0:10:16.92,0:10:18.20,Sub-CN,,0,0,0,,你们还是想去帮他们?
Dialogue: 0,0:10:18.74,0:10:20.93,Sub-CN,,0,0,0,,我…我做不到的
Dialogue: 0,0:10:20.93,0:10:23.20,Sub-CN,,0,0,0,,去那种有龙等着的城堡什么的
Dialogue: 0,0:10:23.89,0:10:25.11,Sub-CN,,0,0,0,,是啊
Dialogue: 0,0:10:26.59,0:10:29.29,Sub-CN,,0,0,0,,但是 真的没有办法了吗
Dialogue: 0,0:10:32.43,0:10:35.04,Sub-CN,,0,0,0,,现在没有安佩尔先生和莉拉小姐的提点
Dialogue: 0,0:10:36.27,0:10:38.28,Sub-CN,,0,0,0,,而且还是我们第一次去古城
Dialogue: 0,0:10:38.64,0:10:40.08,Sub-CN,,0,0,0,,龙也非常可怕
Dialogue: 0,0:10:42.23,0:10:42.98,Sub-CN,,0,0,0,,但是
Dialogue: 0,0:11:33.15,0:11:34.89,Sub-CN,,0,0,0,,我们去帮助博斯他们吧
Dialogue: 0,0:11:36.16,0:11:38.11,Sub-CN,,0,0,0,,用我们现在拥有的力量
Dialogue: 0,0:11:41.17,0:11:42.99,Sub-CN,,0,0,0,,莱莎 那是…
Dialogue: 0,0:11:43.44,0:11:45.86,Sub-CN,,0,0,0,,我赶制出来了哦
Dialogue: 0,0:11:46.52,0:11:48.52,Sub-CN,,0,0,0,,可以打败龙的秘密武器
Dialogue: 0,0:11:49.12,0:11:53.61,Sub-CN,,0,0,0,,莱莎 你能用炼金术做出攀登悬崖的道具吗?
Dialogue: 0,0:11:53.61,0:11:54.36,Sub-CN,,0,0,0,,攀登悬崖?
Dialogue: 0,0:11:54.91,0:11:57.19,Sub-CN,,0,0,0,,如果是那个的话
Dialogue: 0,0:11:58.36,0:12:00.45,Sub-CN,,0,0,0,,应该可以哦
Dialogue: 0,0:12:01.46,0:12:02.67,Sub-CN,,0,0,0,,难道说
Dialogue: 0,0:12:03.05,0:12:03.70,Sub-CN,,0,0,0,,没错
Dialogue: 0,0:12:04.18,0:12:06.77,Sub-CN,,0,0,0,,我们穿过小妖精之森 向北出发
Dialogue: 0,0:12:06.77,0:12:09.52,Sub-CN,,0,0,0,,然后爬上悬崖 进入古城
Dialogue: 0,0:12:11.00,0:12:11.88,Sub-CN,,0,0,0,,我知道了
Dialogue: 0,0:12:12.27,0:12:14.64,Sub-CN,,0,0,0,,我就相信莉拉小姐弟子的判断吧
Dialogue: 0,0:12:15.43,0:12:17.88,Sub-CN,,0,0,0,,我也是…因为安佩尔先生的教导
Dialogue: 0,0:12:18.29,0:12:22.41,Sub-CN,,0,0,0,,才知道自己也能跟你们一起冒险并派上用场
Dialogue: 0,0:12:23.19,0:12:25.49,Sub-CN,,0,0,0,,也就是说 你也会来吧
Dialogue: 0,0:12:29.63,0:12:32.81,Sub-CN,,0,0,0,,那么 今晚就好好准备一下
Dialogue: 0,0:12:33.29,0:12:36.94,Sub-CN,,0,0,0,,明天一早 在秘密码头集合吧
Dialogue: 0,0:12:37.38,0:12:38.10,Sub-CN,,0,0,0,,好
Dialogue: 0,0:12:38.72,0:12:39.72,Sub-CN,,0,0,0,,嗯
Dialogue: 0,0:12:43.31,0:12:44.88,Sub-CN,,0,0,0,,那个 科洛蒂娅
Dialogue: 0,0:12:44.88,0:12:45.88,Sub-CN,,0,0,0,,没事的
Dialogue: 0,0:12:48.01,0:12:49.08,Sub-CN,,0,0,0,,一定会没事的
Dialogue: 0,0:13:02.95,0:13:03.77,Sub-CN,,0,0,0,,父亲
Dialogue: 0,0:13:04.60,0:13:09.20,Sub-CN,,0,0,0,,我要跟莱莎他们一起去帮助讨伐队
Dialogue: 0,0:13:12.04,0:13:14.15,Sub-CN,,0,0,0,,我就知道你要这么说
Dialogue: 0,0:13:15.03,0:13:17.17,Sub-CN,,0,0,0,,但是 我不可能同意你去
Dialogue: 0,0:13:18.33,0:13:21.45,Sub-CN,,0,0,0,,你跟着一起去 又能做什么呢?
Dialogue: 0,0:13:22.28,0:13:25.71,Sub-CN,,0,0,0,,我已经习惯了野外赶路 也一直在练习射箭
Dialogue: 0,0:13:26.25,0:13:27.89,Sub-CN,,0,0,0,,父亲不是也看到了吗
Dialogue: 0,0:13:28.39,0:13:31.46,Sub-CN,,0,0,0,,那种临阵磨枪的箭术 是不可能帮上忙的
Dialogue: 0,0:13:32.16,0:13:33.72,Sub-CN,,0,0,0,,才不是什么临阵磨枪
Dialogue: 0,0:13:38.47,0:13:40.58,Sub-CN,,0,0,0,,我知道了 父亲
Dialogue: 0,0:13:42.70,0:13:44.12,Sub-CN,,0,0,0,,我今天就先休息了
Dialogue: 0,0:13:44.53,0:13:46.01,Sub-CN,,0,0,0,,好…好的
Dialogue: 0,0:14:06.29,0:14:07.48,Sub-CN,,0,0,0,,我要…
Dialogue: 0,0:14:07.85,0:14:10.58,Sub-CN,,0,0,0,,我们要去和龙战斗吗
Dialogue: 0,0:14:11.39,0:14:13.12,Sub-CN,,0,0,0,,我能做到的
Dialogue: 0,0:14:13.71,0:14:16.41,Sub-CN,,0,0,0,,明明只有阅读古代文字而已啊
Dialogue: 0,0:14:17.65,0:14:18.39,Sub-CN,,0,0,0,,文字
Dialogue: 0,0:14:19.45,0:14:20.82,Sub-CN,,0,0,0,,说起来…
Dialogue: 0,0:14:41.80,0:14:44.52,Sub-CN,,0,0,0,,果然是「翼」和「栖木」吗
Dialogue: 0,0:14:45.43,0:14:49.30,Sub-CN,,0,0,0,,按照安佩尔先生所说 龙会听从指令
Dialogue: 0,0:15:01.39,0:15:03.54,Sub-CN,,0,0,0,,简直跟童话故事一样
Dialogue: 0,0:15:21.25,0:15:22.37,Sub-CN,,0,0,0,,你这孩子
Dialogue: 0,0:15:22.89,0:15:25.77,Sub-CN,,0,0,0,,直到讨伐队出发之前
Dialogue: 0,0:15:26.16,0:15:29.59,Sub-CN,,0,0,0,,我都在担心你会不会也报名去讨伐龙呢
Dialogue: 0,0:15:29.96,0:15:33.01,Sub-CN,,0,0,0,,我…我怎么会干那种事呢
Dialogue: 0,0:15:33.01,0:15:35.01,Sub-CN,,0,0,0,,即使是我 也不会跟那种…
Dialogue: 0,0:15:41.72,0:15:43.42,Sub-CN,,0,0,0,,那种可怕的家伙
Dialogue: 0,0:15:44.07,0:15:46.62,Sub-CN,,0,0,0,,我怎么会想再去找它呢
Dialogue: 0,0:15:47.68,0:15:48.82,Sub-CN,,0,0,0,,这样吗
Dialogue: 0,0:15:49.70,0:15:51.25,Sub-CN,,0,0,0,,说的也是
Dialogue: 0,0:15:54.20,0:15:56.71,Sub-CN,,0,0,0,,真是的 那种怪物
Dialogue: 0,0:15:57.32,0:16:00.94,Sub-CN,,0,0,0,,再去找它什么的 别开玩笑了
Dialogue: 0,0:16:00.94,0:16:03.28,Sub-CN,,0,0,0,,这孩子突然是怎么了
Dialogue: 0,0:16:04.07,0:16:05.86,Sub-CN,,0,0,0,,慢慢吃 莱莎
Dialogue: 0,0:16:06.77,0:16:08.55,Sub-CN,,0,0,0,,别噎着了
Dialogue: 0,0:16:08.93,0:16:10.61,Sub-CN,,0,0,0,,知道啦
Dialogue: 0,0:16:18.11,0:16:18.81,Sub-CN,,0,0,0,,老爸
Dialogue: 0,0:16:20.94,0:16:23.82,Sub-CN,,0,0,0,,干嘛突然吵吵嚷嚷的
Dialogue: 0,0:16:23.82,0:16:25.75,Sub-CN,,0,0,0,,我要去和龙战斗
Dialogue: 0,0:16:27.69,0:16:31.06,Sub-CN,,0,0,0,,所以拜托了 请借给我更锐利的剑
Dialogue: 0,0:16:42.15,0:16:43.22,Sub-CN,,0,0,0,,既然这样
Dialogue: 0,0:16:43.75,0:16:47.50,Sub-CN,,0,0,0,,我就用这钝刀把龙锤烂
Dialogue: 0,0:17:04.65,0:17:06.22,Sub-CN,,0,0,0,,爸…爸爸
Dialogue: 0,0:17:06.75,0:17:08.22,Sub-CN,,0,0,0,,早安 莱莎
Dialogue: 0,0:17:08.67,0:17:11.64,Sub-CN,,0,0,0,,你…你平时也是起这么早来着
Dialogue: 0,0:17:12.01,0:17:13.31,Sub-CN,,0,0,0,,一直都是噢
Dialogue: 0,0:17:19.79,0:17:22.10,Sub-CN,,0,0,0,,是想要去帮博斯他们吗
Dialogue: 0,0:17:25.88,0:17:27.25,Sub-CN,,0,0,0,,爸爸 我…
Dialogue: 0,0:17:27.25,0:17:29.00,Sub-CN,,0,0,0,,那个确实很厉害
Dialogue: 0,0:17:29.77,0:17:30.41,Sub-CN,,0,0,0,,诶
Dialogue: 0,0:17:30.73,0:17:33.97,Sub-CN,,0,0,0,,用那样强烈的火柱把石材粉碎
Dialogue: 0,0:17:33.97,0:17:37.13,Sub-CN,,0,0,0,,但是碎渣却一点都没有飞溅出来
Dialogue: 0,0:17:39.47,0:17:41.75,Sub-CN,,0,0,0,,你当时也在啊
Dialogue: 0,0:17:42.82,0:17:46.72,Sub-CN,,0,0,0,,那个就是你在钻研的炼金术对吧
Dialogue: 0,0:17:50.43,0:17:52.71,Sub-CN,,0,0,0,,你是觉得那样能把龙焚尽 对吗
Dialogue: 0,0:17:54.24,0:17:58.15,Sub-CN,,0,0,0,,我做出了比那更强力的道具
Dialogue: 0,0:17:58.15,0:17:59.89,Sub-CN,,0,0,0,,就算是龙也能一击必杀哟
Dialogue: 0,0:17:59.89,0:18:02.71,Sub-CN,,0,0,0,,哈哈 那听起来很靠谱呢
Dialogue: 0,0:18:04.47,0:18:05.58,Sub-CN,,0,0,0,,加油啊
Dialogue: 0,0:18:07.24,0:18:08.28,Sub-CN,,0,0,0,,爸爸
Dialogue: 0,0:18:09.69,0:18:13.92,Sub-CN,,0,0,0,,但是你要承诺
Dialogue: 0,0:18:13.92,0:18:15.11,Sub-CN,,0,0,0,,不能受伤 也不能让同伴因此受伤
Dialogue: 0,0:18:16.09,0:18:18.30,Sub-CN,,0,0,0,,如果你违背了承诺
Dialogue: 0,0:18:18.88,0:18:19.99,Sub-CN,,0,0,0,,违背了会怎样…
Dialogue: 0,0:18:21.04,0:18:25.95,Sub-CN,,0,0,0,,那我们应该会一起被妈妈狠狠责骂吧
Dialogue: 0,0:18:30.37,0:18:31.84,Sub-CN,,0,0,0,,那为了不让咱们被骂
Dialogue: 0,0:18:31.84,0:18:33.37,Sub-CN,,0,0,0,,我一定全力以赴
Dialogue: 0,0:18:34.26,0:18:35.55,Sub-CN,,0,0,0,,那我出发了
Dialogue: 0,0:18:43.91,0:18:46.43,Sub-CN,,0,0,0,,最近那孩子变得开朗起来了
Dialogue: 0,0:18:47.48,0:18:49.23,Sub-CN,,0,0,0,,一定会没事的
Dialogue: 0,0:19:12.63,0:19:13.78,Sub-CN,,0,0,0,,这个是…
Dialogue: 0,0:19:17.59,0:19:18.80,Sub-CN,,0,0,0,,好刀…
Dialogue: 0,0:19:19.61,0:19:22.21,Sub-CN,,0,0,0,,这把钝刀根本比不了
Dialogue: 0,0:19:22.94,0:19:24.52,Sub-CN,,0,0,0,,为什么会出现在这儿
Dialogue: 0,0:19:27.09,0:19:27.89,Sub-CN,,0,0,0,,不会是
Dialogue: 0,0:19:32.91,0:19:34.96,Sub-CN,,0,0,0,,谢了 老爸
Dialogue: 0,0:19:41.29,0:19:42.31,Sub-CN,,0,0,0,,走吧
Dialogue: 0,0:19:55.69,0:19:57.38,Sub-CN,,0,0,0,,都早上了吗
Dialogue: 0,0:20:25.03,0:20:26.85,Sub-CN,,0,0,0,,请好好看着我 父亲大人
Dialogue: 0,0:20:52.61,0:20:53.66,Sub-CN,,0,0,0,,我出发了
Dialogue: 0,0:21:07.39,0:21:09.28,Sub-CN,,0,0,0,,果然还是觉得她会来 是吗
Dialogue: 0,0:21:09.88,0:21:10.86,Sub-CN,,0,0,0,,大概是的
Dialogue: 0,0:21:15.46,0:21:17.17,Sub-CN,,0,0,0,,早上好 大家
Dialogue: 0,0:21:32.09,0:21:33.47,Sub-CN,,0,0,0,,早安 科洛蒂娅
Dialogue: 0,0:21:34.37,0:21:35.02,Sub-CN,,0,0,0,,一起出发吧
Dialogue: 0,0:21:44.48,0:21:46.50,Sub-CN,,0,0,0,,嗯! 走吧
Dialogue: 0,0:21:48.59,0:21:52.30,Sub-CN,,0,0,0,,和科洛蒂娅的第一次冒险就是龙的讨伐吗
Dialogue: 0,0:21:52.84,0:21:56.58,Sub-CN,,0,0,0,,虽然我说这话不太合适 是不是有点太难了
Dialogue: 0,0:21:56.92,0:22:00.97,Sub-CN,,0,0,0,,有什么关系 有科洛蒂娅我们也更安心点
Dialogue: 0,0:22:00.97,0:22:03.97,Sub-CN,,0,0,0,,那就拜托了 塔奥 兰托
Dialogue: 0,0:22:09.85,0:22:13.41,Sub-CN,,0,0,0,,那么 我们出发追上讨伐队吧

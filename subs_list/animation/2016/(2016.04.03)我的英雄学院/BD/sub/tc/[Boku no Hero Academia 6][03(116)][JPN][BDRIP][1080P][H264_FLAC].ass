Dialogue: 0,0:00:01.50,0:00:03.87,Default,,0,0,0,,全體英雄出動
Dialogue: 0,0:00:03.87,0:00:07.17,Default,,0,0,0,,展開了掃蕩敵人的作戰行動
Dialogue: 0,0:00:07.17,0:00:09.38,Default,,0,0,0,,警察將英雄們分成了兩個小隊
Dialogue: 1,0:00:09.38,0:00:10.63,Default2,,0,0,0,,(安德瓦小隊)
Dialogue: 0,0:00:09.38,0:00:10.63,Default,,0,0,0,,(Edgeshot小隊)
Dialogue: 1,0:00:10.63,0:00:16.39,Default2,,0,0,0,,目的是一網打盡超常解放戰線
Dialogue: 0,0:00:10.63,0:00:16.39,Default,,0,0,0,,並且能夠同時抓住殼木球大
Dialogue: 0,0:00:16.39,0:00:19.01,Default,,0,0,0,,兩邊分頭發動作戰
Dialogue: 0,0:00:22.48,0:00:26.35,Default,,0,0,0,,那些被你們玩弄之後丟棄的人之中
Dialogue: 0,0:00:26.35,0:00:28.48,Default,,0,0,0,,有很多人都這麼說…
Dialogue: 0,0:00:30.69,0:00:33.53,Default,,0,0,0,,這次輪到我們掠奪了
Dialogue: 1,0:00:41.20,0:00:45.12,Default2,,0,0,0,,殼木把一群腦無當作肉盾
Dialogue: 0,0:00:41.20,0:00:45.12,Default,,0,0,0,,並策劃逃亡
Dialogue: 1,0:00:46.54,0:00:51.67,Default2,,0,0,0,,在安德瓦小隊漸漸瓦解
Dialogue: 0,0:00:46.54,0:00:51.67,Default,,0,0,0,,敵人防衛線時 幾乎在同一時刻
Dialogue: 1,0:00:53.13,0:00:57.22,Default2,,0,0,0,,Edgeshot小隊
Dialogue: 0,0:00:53.13,0:00:57.22,Default,,0,0,0,,逼近超常解放戰線的巢穴
Dialogue: 0,0:00:57.22,0:01:00.97,Default,,0,0,0,,並開始對群訝山莊發動奇襲
Dialogue: 0,0:01:01.89,0:01:03.93,Default,,0,0,0,,一個人都別放過
Dialogue: 0,0:01:06.31,0:01:09.44,Default,,0,0,0,,人再多也不代表什麼
Dialogue: 0,0:01:10.82,0:01:14.69,Default,,0,0,0,,壓制放電 雷網
Dialogue: 0,0:01:20.74,0:01:23.37,Default,,0,0,0,,什麼…
Dialogue: 0,0:01:23.37,0:01:25.96,Default,,0,0,0,,我的電擊被吸收了
Dialogue: 1,0:01:26.58,0:01:30.59,Default2,,0,0,0,,很好
Dialogue: 0,0:01:26.58,0:01:30.59,Default,,0,0,0,,我成功讓一個幹部的能力失效了
Dialogue: 0,0:01:31.59,0:01:35.05,Default,,0,0,0,,為了不要讓那些後衛們擔心
Dialogue: 0,0:01:35.05,0:01:38.34,Default,,0,0,0,,各位 我們快點解決他們吧
Dialogue: 0,0:01:38.34,0:01:40.64,Default,,0,0,0,,帶電 你超級棒
Dialogue: 0,0:01:42.31,0:01:44.10,Default,,0,0,0,,感謝讚美
Dialogue: 1,0:03:15.77,0:03:18.94,Default2,,0,0,0,,Edgeshot小隊前鋒
Dialogue: 0,0:03:15.77,0:03:18.94,Default,,0,0,0,,對山莊發動攻擊了
Dialogue: 1,0:03:18.94,0:03:21.95,Default2,,0,0,0,,會有三個分隊
Dialogue: 0,0:03:18.94,0:03:21.95,Default,,0,0,0,,封鎖講堂通往一樓的出口
Dialogue: 0,0:03:23.28,0:03:26.16,Default,,0,0,0,,(群訝山莊 北出口)
Dialogue: 0,0:03:26.16,0:03:28.04,Default,,0,0,0,,(同時 南東入口)
Dialogue: 0,0:03:28.04,0:03:30.37,Default,,0,0,0,,(同時 西入口)
Dialogue: 0,0:03:31.66,0:03:33.92,Default,,0,0,0,,目前已經封鎖完畢
Dialogue: 1,0:03:33.92,0:03:37.80,Default2,,0,0,0,,通往的一樓出口被縮減到只剩
Dialogue: 0,0:03:33.92,0:03:37.80,Default,,0,0,0,,山莊本館館內了
Dialogue: 0,0:03:38.50,0:03:43.34,Default,,0,0,0,,(群訝山莊 地下禮堂)
Dialogue: 0,0:03:45.60,0:03:48.97,Default,,0,0,0,,Mr.懷疑論者他們怎麼都還沒來
Dialogue: 0,0:03:48.97,0:03:51.18,Default,,0,0,0,,會議開始前就會來了吧
Dialogue: 0,0:03:51.18,0:03:52.52,Default,,0,0,0,,Re‧迪斯楚
Dialogue: 0,0:03:53.19,0:03:54.77,Default,,0,0,0,,Re‧迪斯楚
Dialogue: 0,0:03:54.77,0:03:58.07,Default,,0,0,0,,我聽見了 有什麼事嗎
Dialogue: 1,0:03:58.07,0:04:01.78,Default2,,0,0,0,,今天有一場重要的會議
Dialogue: 0,0:03:58.07,0:04:01.78,Default,,0,0,0,,其他不必要的事就…
Dialogue: 0,0:04:01.78,0:04:03.61,Default,,0,0,0,,英雄來襲了
Dialogue: 1,0:04:06.62,0:04:10.70,Default2,,0,0,0,,人數很多…多到根本數不清的人
Dialogue: 0,0:04:06.62,0:04:10.70,Default,,0,0,0,,全湧了過來
Dialogue: 1,0:04:10.70,0:04:14.83,Default2,,0,0,0,,山莊目前半毀
Dialogue: 0,0:04:10.70,0:04:14.83,Default,,0,0,0,,往一樓的聯外通道都被封鎖
Dialogue: 1,0:04:14.83,0:04:18.50,Default2,,0,0,0,,現在我們…
Dialogue: 0,0:04:14.83,0:04:18.50,Default,,0,0,0,,我們被他們團團包圍了
Dialogue: 0,0:04:27.26,0:04:29.10,Default,,0,0,0,,看他的個性…
Dialogue: 0,0:04:29.10,0:04:31.98,Default,,0,0,0,,他應該就是帶電吧
Dialogue: 0,0:04:31.98,0:04:36.19,Default,,0,0,0,,不過你到底能撐到幾百萬伏特呢
Dialogue: 0,0:04:39.15,0:04:41.82,Default,,0,0,0,,忍術…千枚穿刺
Dialogue: 0,0:04:46.65,0:04:49.40,Default,,0,0,0,,我在你們的肺上開了一個小洞
Dialogue: 0,0:04:49.40,0:04:51.90,Default,,0,0,0,,要是敢亂動的話 就有可能會送命
Dialogue: 0,0:04:51.90,0:04:54.40,Default,,0,0,0,,但只要乖乖待著 很快就會好了
Dialogue: 0,0:05:06.18,0:05:08.64,Default,,0,0,0,,就乖乖地好好睡一覺吧
Dialogue: 0,0:05:12.14,0:05:13.85,Default,,0,0,0,,先制必縛
Dialogue: 0,0:05:15.27,0:05:17.02,Default,,0,0,0,,漆樹鎖牢
Dialogue: 0,0:05:17.02,0:05:18.56,Default,,0,0,0,,場面太混亂了
Dialogue: 1,0:05:18.56,0:05:21.44,Default2,,0,0,0,,可惡 說什麼都要儘量多帶
Dialogue: 0,0:05:18.56,0:05:21.44,Default,,0,0,0,,幾隻走狗上路
Dialogue: 0,0:05:21.44,0:05:23.74,Default,,0,0,0,,地、地面怎麼
Dialogue: 0,0:05:26.36,0:05:27.86,Default,,0,0,0,,做得好 泥巴俠
Dialogue: 0,0:05:27.86,0:05:29.49,Default,,0,0,0,,是真的嗎
Dialogue: 0,0:05:30.41,0:05:32.15,Default,,0,0,0,,這算什麼…
Dialogue: 0,0:05:34.70,0:05:36.15,Default,,0,0,0,,是香菇
Dialogue: 0,0:05:38.37,0:05:39.46,Default,,0,0,0,,大範圍鎮壓
Dialogue: 0,0:05:39.46,0:05:42.25,Default,,0,0,0,,就交給施蘑姬跟泥巴俠吧菇菇
Dialogue: 0,0:05:42.25,0:05:44.13,Default,,0,0,0,,你們兩個都很厲害
Dialogue: 0,0:05:44.13,0:05:45.80,Default,,0,0,0,,接下來就交給你們了
Dialogue: 0,0:05:45.80,0:05:48.89,Default,,0,0,0,,我們其他人會盡全力擊垮敵人中樞
Dialogue: 0,0:05:57.19,0:05:59.65,Default,,0,0,0,,現在是什麼情況
Dialogue: 0,0:06:06.57,0:06:10.62,Default,,0,0,0,,(One's Justice)
Dialogue: 0,0:06:10.62,0:06:15.41,Default,,0,0,0,,我是用暗號把襲擊日期傳遞出去的
Dialogue: 0,0:06:15.41,0:06:17.66,Default,,0,0,0,,真的是累死我了
Dialogue: 1,0:06:19.75,0:06:23.29,Default2,,0,0,0,,總而言之
Dialogue: 0,0:06:19.75,0:06:23.29,Default,,0,0,0,,這次作戰最大的威脅 就是數量
Dialogue: 0,0:06:23.29,0:06:24.00,Default,,0,0,0,,喂
Dialogue: 1,0:06:24.00,0:06:28.47,Default2,,0,0,0,,所以我不想給擁有兩倍的你
Dialogue: 0,0:06:24.00,0:06:28.47,Default,,0,0,0,,任何一點空間
Dialogue: 1,0:06:28.47,0:06:31.89,Default2,,0,0,0,,-我在叫你耶 聽到沒
Dialogue: 0,0:06:28.47,0:06:31.89,Default,,0,0,0,,-因此有必要時刻盯緊你
Dialogue: 0,0:06:32.85,0:06:35.72,Default,,0,0,0,,"在會議開始前複習一下解放思想"
Dialogue: 0,0:06:35.72,0:06:37.14,Default,,0,0,0,,(一定要知道 解放軍的成立過程)
Dialogue: 0,0:06:38.14,0:06:40.31,Default,,0,0,0,,這個理由很自由對吧
Dialogue: 0,0:06:40.31,0:06:42.19,Default,,0,0,0,,霍克斯…
Dialogue: 0,0:06:42.19,0:06:44.73,Default,,0,0,0,,請你不要抵抗
Dialogue: 1,0:06:44.73,0:06:48.65,Default2,,0,0,0,,我要直接逮捕你
Dialogue: 0,0:06:44.73,0:06:48.65,Default,,0,0,0,,然後把你交給警察
Dialogue: 0,0:06:53.24,0:06:55.99,Default,,0,0,0,,先…先等一下…
Dialogue: 0,0:07:04.09,0:07:06.67,Default,,0,0,0,,那傢伙殺死了磁姊啊
Dialogue: 0,0:07:06.67,0:07:11.09,Default,,0,0,0,,不只這樣 他還炸掉了Mr.壓縮的手
Dialogue: 0,0:07:11.09,0:07:12.89,Default,,0,0,0,,怎麼每次…
Dialogue: 0,0:07:12.89,0:07:14.97,Default,,0,0,0,,讓我負起責任吧
Dialogue: 0,0:07:16.18,0:07:18.68,Default,,0,0,0,,每次都是這樣…
Dialogue: 0,0:07:20.43,0:07:21.89,Default,,0,0,0,,那傢伙…
Dialogue: 0,0:07:21.89,0:07:24.86,Default,,0,0,0,,都是我沒想太多帶他過去
Dialogue: 0,0:07:24.86,0:07:28.40,Default,,0,0,0,,所以才會…
Dialogue: 0,0:07:29.94,0:07:32.45,Default,,0,0,0,,我怎麼又犯了
Dialogue: 1,0:07:32.45,0:07:37.40,Default2,,0,0,0,,你明明是英雄
Dialogue: 0,0:07:32.45,0:07:37.40,Default,,0,0,0,,怎麼這麼瞭解解放軍 為什麼
Dialogue: 0,0:07:37.40,0:07:40.00,Default,,0,0,0,,因為對他們很有共鳴啊
Dialogue: 0,0:07:40.00,0:07:42.25,Default,,0,0,0,,我想要自由地翱翔
Dialogue: 0,0:07:42.25,0:07:44.42,Default,,0,0,0,,所以那裡不是我的容身之處
Dialogue: 1,0:07:45.54,0:07:51.05,Default2,,0,0,0,,因為我覺得如果…我不相信你…
Dialogue: 0,0:07:45.54,0:07:51.05,Default,,0,0,0,,你就太可憐了 所以我才會…
Dialogue: 0,0:07:51.05,0:07:53.89,Default,,0,0,0,,人生毀了的人該怎麼辦才好
Dialogue: 0,0:07:53.89,0:07:56.01,Default,,0,0,0,,取得別人的信賴囉
Dialogue: 0,0:07:56.01,0:07:57.51,Default,,0,0,0,,誰的
Dialogue: 0,0:07:57.51,0:07:59.72,Default,,0,0,0,,夥伴的
Dialogue: 1,0:07:59.72,0:08:05.90,Default2,,0,0,0,,別擔心 跟你相似的人其實…
Dialogue: 0,0:07:59.72,0:08:05.90,Default,,0,0,0,,出乎意料的多呢
Dialogue: 0,0:08:07.06,0:08:09.48,Default,,0,0,0,,我覺得如果沒有人願意相信你的話
Dialogue: 0,0:08:09.48,0:08:12.15,Default,,0,0,0,,你就太可憐了啊
Dialogue: 0,0:08:12.15,0:08:14.28,Default,,0,0,0,,我是這樣想的…
Dialogue: 0,0:08:15.45,0:08:17.12,Default,,0,0,0,,謝謝你
Dialogue: 0,0:08:19.12,0:08:21.83,Default,,0,0,0,,你只是運氣不好而已
Dialogue: 0,0:08:24.50,0:08:27.08,Default,,0,0,0,,我是不是做錯了什麼事
Dialogue: 0,0:08:27.08,0:08:30.13,Default,,0,0,0,,我想想,如果真的哪裡做錯了…
Dialogue: 0,0:08:30.13,0:08:32.91,Default,,0,0,0,,應該是你沒帶好運就被生下來了吧
Dialogue: 0,0:08:33.92,0:08:36.84,Default,,0,0,0,,所以好好贖罪 重新做人吧
Dialogue: 1,0:08:36.84,0:08:41.05,Default2,,0,0,0,,想要幫助夥伴的人
Dialogue: 0,0:08:36.84,0:08:41.05,Default,,0,0,0,,絕對不會是壞人
Dialogue: 0,0:08:41.05,0:08:43.35,Default,,0,0,0,,對吧霍克斯
Dialogue: 0,0:08:43.35,0:08:46.02,Default,,0,0,0,,讓我們一起自由翱翔吧
Dialogue: 0,0:08:47.06,0:08:50.19,Default,,0,0,0,,我也會幫你重新做人的
Dialogue: 0,0:08:50.19,0:08:53.44,Default,,0,0,0,,因為…你是一個好人
Dialogue: 0,0:08:55.74,0:08:57.41,Default,,0,0,0,,吵死人了
Dialogue: 0,0:08:57.41,0:08:59.45,Default,,0,0,0,,這就是英雄嗎
Dialogue: 0,0:08:59.45,0:09:00.87,Default,,0,0,0,,別說了
Dialogue: 0,0:09:00.87,0:09:03.66,Default,,0,0,0,,什麼叫重新做人啊 你說啊
Dialogue: 0,0:09:03.66,0:09:04.96,Default,,0,0,0,,分倍河原
Dialogue: 0,0:09:04.96,0:09:06.00,Default,,0,0,0,,反正我…
Dialogue: 1,0:09:07.33,0:09:10.71,Default2,,0,0,0,,早就已經不在乎
Dialogue: 0,0:09:07.33,0:09:10.71,Default,,0,0,0,,自己會變成什麼樣子了
Dialogue: 0,0:09:10.71,0:09:13.88,Default,,0,0,0,,我根本不想要跟你打啊 分倍河原
Dialogue: 0,0:09:13.88,0:09:16.76,Default,,0,0,0,,這關我什麼屁事啊
Dialogue: 0,0:09:21.31,0:09:24.06,Default,,0,0,0,,我只想把自己的…靈魂
Dialogue: 0,0:09:26.02,0:09:30.48,Default,,0,0,0,,為了大家…為了夥伴的幸褔奉獻出去
Dialogue: 0,0:09:36.53,0:09:39.41,Default,,0,0,0,,同學 你叫月讀對吧
Dialogue: 0,0:09:39.41,0:09:41.20,Default,,0,0,0,,你過來我這邊
Dialogue: 0,0:09:41.20,0:09:42.45,Default,,0,0,0,,遵命
Dialogue: 1,0:09:43.87,0:09:48.21,Default2,,0,0,0,,根據情報
Dialogue: 0,0:09:43.87,0:09:48.21,Default,,0,0,0,,現在地底那邊聚集了非常多敵人
Dialogue: 1,0:09:48.21,0:09:52.88,Default2,,0,0,0,,外面有好幾條路能通往地下
Dialogue: 0,0:09:48.21,0:09:52.88,Default,,0,0,0,,但都先被英雄摧毀掉了
Dialogue: 0,0:09:53.55,0:09:56.88,Default,,0,0,0,,目前只剩房子裡的五條聯外通道了
Dialogue: 0,0:09:56.88,0:09:59.97,Default,,0,0,0,,但是通道入口在水泥人的射程外
Dialogue: 0,0:09:59.97,0:10:01.93,Default,,0,0,0,,所以得靠我們來封鎖
Dialogue: 0,0:10:01.93,0:10:04.18,Default,,0,0,0,,沒錯 你是好個孩子
Dialogue: 0,0:10:06.31,0:10:07.94,Default,,0,0,0,,我們上
Dialogue: 0,0:10:07.94,0:10:09.90,Default,,0,0,0,,為什麼他們會知道有這條通道
Dialogue: 0,0:10:09.90,0:10:11.61,Default,,0,0,0,,守住啊 死守這裡
Dialogue: 0,0:10:11.61,0:10:13.90,Default,,0,0,0,,交給你了 食日者
Dialogue: 0,0:10:14.69,0:10:15.82,Default,,0,0,0,,知道了
Dialogue: 0,0:10:15.82,0:10:17.45,Default,,0,0,0,,混合大夥…
Dialogue: 0,0:10:18.86,0:10:20.91,Default,,0,0,0,,合成獸 半人馬
Dialogue: 0,0:10:23.16,0:10:26.20,Default,,0,0,0,,不好意思 請你們稍微安分一點
Dialogue: 0,0:10:26.20,0:10:28.79,Default,,0,0,0,,很帥喔 再說一次吧
Dialogue: 0,0:10:28.79,0:10:30.17,Default,,0,0,0,,別這樣
Dialogue: 0,0:10:31.96,0:10:34.13,Default,,0,0,0,,你就放膽去做吧
Dialogue: 0,0:10:34.13,0:10:35.50,Default,,0,0,0,,真的可以嗎
Dialogue: 0,0:10:35.50,0:10:37.63,Default,,0,0,0,,當然 讓我們見識一下
Dialogue: 1,0:10:37.63,0:10:43.18,Default2,,0,0,0,,能夠在一瞬間封住這條超長通道的
Dialogue: 0,0:10:37.63,0:10:43.18,Default,,0,0,0,,最強力量吧
Dialogue: 0,0:10:43.18,0:10:44.72,Default,,0,0,0,,黑影
Dialogue: 0,0:10:47.48,0:10:49.44,Default,,0,0,0,,終焉
Dialogue: 0,0:10:54.82,0:10:55.94,Default,,0,0,0,,請您快點後退
Dialogue: 0,0:10:55.94,0:10:57.19,Default,,0,0,0,,Re‧迪斯楚
Dialogue: 0,0:11:02.41,0:11:03.99,Default,,0,0,0,,被他擋下來了
Dialogue: 0,0:11:11.71,0:11:13.83,Default,,0,0,0,,什麼 隱藏通道被…
Dialogue: 0,0:11:16.67,0:11:18.71,Default,,0,0,0,,好厲害啊
Dialogue: 0,0:11:18.71,0:11:20.17,Default,,0,0,0,,踏陰…
Dialogue: 0,0:11:21.18,0:11:24.47,Default,,0,0,0,,下面 有很不妙的東西…
Dialogue: 0,0:11:24.47,0:11:27.93,Default,,0,0,0,,是啊 想不到有人可以跟終焉抗衡
Dialogue: 0,0:11:27.93,0:11:30.18,Default,,0,0,0,,不對 我不是說那傢伙
Dialogue: 0,0:11:31.14,0:11:34.44,Default,,0,0,0,,那個東西…是怪物…
Dialogue: 0,0:11:35.31,0:11:36.27,Default,,0,0,0,,怪物嗎
Dialogue: 0,0:11:36.27,0:11:37.90,Default,,0,0,0,,你不用在意
Dialogue: 0,0:11:37.90,0:11:41.53,Default,,0,0,0,,根據情報 那個東西應該不會動
Dialogue: 0,0:11:41.53,0:11:45.20,Default,,0,0,0,,沒有敵方老大的命令 他是不會動的
Dialogue: 0,0:11:45.20,0:11:49.66,Default,,0,0,0,,然後 那個老大目前好像正在休眠
Dialogue: 0,0:11:49.66,0:11:51.37,Default,,0,0,0,,怎麼會知道這麼多
Dialogue: 0,0:11:51.37,0:11:53.79,Default,,0,0,0,,這些情報也太過詳細了吧
Dialogue: 0,0:11:53.79,0:11:56.67,Default,,0,0,0,,好像是霍克斯調查後掌握到的
Dialogue: 0,0:11:56.67,0:11:57.88,Default,,0,0,0,,霍克斯嗎…
Dialogue: 0,0:11:57.88,0:12:00.46,Default,,0,0,0,,我們回頭吧 進到我的肚子裡
Dialogue: 0,0:12:00.46,0:12:01.88,Default,,0,0,0,,肚子
Dialogue: 0,0:12:05.22,0:12:08.14,Default,,0,0,0,,想不到我還得充當計程車
Dialogue: 0,0:12:08.14,0:12:10.35,Default,,0,0,0,,霍克斯現在在哪裡
Dialogue: 0,0:12:10.35,0:12:12.73,Default,,0,0,0,,詳情我也不是很清楚
Dialogue: 0,0:12:12.73,0:12:14.19,Default,,0,0,0,,我猜他現在…
Dialogue: 0,0:12:14.19,0:12:16.98,Default,,0,0,0,,應該在某個混亂的戰場吧
Dialogue: 0,0:12:19.11,0:12:21.99,Default,,0,0,0,,雖然我從沒想過要栽培後輩啦
Dialogue: 1,0:12:22.99,0:12:26.57,Default2,,0,0,0,,盡力彌補自己在近戰的缺點
Dialogue: 0,0:12:22.99,0:12:26.57,Default,,0,0,0,,是很不錯…
Dialogue: 1,0:12:26.57,0:12:29.74,Default2,,0,0,0,,只是你最好也不要忘記發展
Dialogue: 0,0:12:26.57,0:12:29.74,Default,,0,0,0,,自己擅長的東西
Dialogue: 0,0:12:31.12,0:12:33.87,Default,,0,0,0,,我按照你的指點盡情發展了
Dialogue: 0,0:12:33.87,0:12:36.67,Default,,0,0,0,,以後我會成為更強的英雄
Dialogue: 0,0:12:37.84,0:12:39.42,Default,,0,0,0,,霍克斯師父
Dialogue: 0,0:12:40.34,0:12:43.13,Default,,0,0,0,,如果你現在也在這裡…
Dialogue: 0,0:12:43.13,0:12:46.55,Default,,0,0,0,,那我很希望 能讓你見識看看
Dialogue: 0,0:12:47.80,0:12:50.81,Default,,0,0,0,,這次我一定要負起責任
Dialogue: 0,0:12:53.81,0:12:56.81,Default,,0,0,0,,去死吧 英雄
Dialogue: 0,0:13:05.57,0:13:08.28,Default,,0,0,0,,這次我一定要負起責任
Dialogue: 0,0:13:10.53,0:13:13.25,Default,,0,0,0,,去死吧 英雄
Dialogue: 0,0:13:21.46,0:13:25.05,Default,,0,0,0,,產生的速度的確快到令人嘆為觀止
Dialogue: 1,0:13:25.05,0:13:29.30,Default2,,0,0,0,,但隨著不斷加倍增生
Dialogue: 0,0:13:25.05,0:13:29.30,Default,,0,0,0,,每一個個體的耐久力都會下降
Dialogue: 1,0:13:29.30,0:13:34.31,Default2,,0,0,0,,用同樣的大覆羽攻擊
Dialogue: 0,0:13:29.30,0:13:34.31,Default,,0,0,0,,有些會分解 有些則不會
Dialogue: 0,0:13:36.56,0:13:38.73,Default,,0,0,0,,速度太快了…
Dialogue: 0,0:13:38.73,0:13:40.56,Default,,0,0,0,,根本看不見…
Dialogue: 1,0:13:40.56,0:13:45.24,Default2,,0,0,0,,都到了這個地步
Dialogue: 0,0:13:40.56,0:13:45.24,Default,,0,0,0,,我就不會讓自己因為交情壞了事
Dialogue: 1,0:13:45.24,0:13:48.91,Default2,,0,0,0,,如果你肯乖乖跟我走
Dialogue: 0,0:13:45.24,0:13:48.91,Default,,0,0,0,,那麼還有挽救的餘地
Dialogue: 0,0:13:50.62,0:13:53.12,Default,,0,0,0,,畢竟我的確很喜歡你
Dialogue: 0,0:13:54.54,0:13:57.16,Default,,0,0,0,,我的夥伴只有他們幾個
Dialogue: 0,0:13:57.16,0:13:59.63,Default,,0,0,0,,根本沒有你介入的空間
Dialogue: 0,0:14:03.46,0:14:07.97,Default,,0,0,0,,沒用的 你這廢物 廢物混蛋
Dialogue: 0,0:14:07.97,0:14:10.64,Default,,0,0,0,,你知道為什麼我會發展出…
Dialogue: 0,0:14:12.43,0:14:14.43,Default,,0,0,0,,高速擊退敵人的方式嗎
Dialogue: 1,0:14:15.27,0:14:21.36,Default2,,0,0,0,,因為不肯放棄的人對英雄來說
Dialogue: 0,0:14:15.27,0:14:21.36,Default,,0,0,0,,是最讓人畏懼的對手
Dialogue: 1,0:14:22.61,0:14:26.99,Default2,,0,0,0,,以我過往的經驗
Dialogue: 0,0:14:22.61,0:14:26.99,Default,,0,0,0,,意志堅定的人是不會昏倒的
Dialogue: 0,0:14:26.99,0:14:28.49,Default,,0,0,0,,你少囉…嗦…
Dialogue: 0,0:14:32.53,0:14:33.83,Default,,0,0,0,,所以…
Dialogue: 1,0:14:36.66,0:14:40.92,Default2,,0,0,0,,要是雙方都不肯放棄…
Dialogue: 0,0:14:36.66,0:14:40.92,Default,,0,0,0,,就只能痛下殺手了
Dialogue: 0,0:14:42.75,0:14:47.88,Default,,0,0,0,,你們這些人…根本就不是什麼英雄
Dialogue: 0,0:14:47.88,0:14:50.01,Default,,0,0,0,,每一次都是這樣…
Dialogue: 0,0:14:50.01,0:14:51.64,Default,,0,0,0,,你們每個人都一樣
Dialogue: 0,0:14:51.64,0:14:54.31,Default,,0,0,0,,不被社會接受的人就會被你們拋棄
Dialogue: 0,0:14:55.35,0:14:57.14,Default,,0,0,0,,你一定不知道吧…
Dialogue: 1,0:14:57.14,0:15:03.48,Default2,,0,0,0,,渡我妹妹她…
Dialogue: 0,0:14:57.14,0:15:03.48,Default,,0,0,0,,曾經用手帕溫柔地把我包起來
Dialogue: 0,0:15:03.48,0:15:06.28,Default,,0,0,0,,喂 你知道嗎…
Dialogue: 0,0:15:06.28,0:15:08.19,Default,,0,0,0,,這次是第二次了喔
Dialogue: 0,0:15:08.19,0:15:10.70,Default,,0,0,0,,我已經是第二次…
Dialogue: 0,0:15:10.70,0:15:14.70,Default,,0,0,0,,這次我又…害到大家了…
Dialogue: 0,0:15:15.87,0:15:20.46,Default,,0,0,0,,渡我妹妹…不會再幫我包起來了吧
Dialogue: 0,0:15:22.88,0:15:26.75,Default,,0,0,0,,不過也沒關係 我只是…
Dialogue: 0,0:15:26.75,0:15:30.51,Default,,0,0,0,,在守護大家的幸褔而已
Dialogue: 0,0:15:30.51,0:15:32.93,Default,,0,0,0,,我會幫你轉告給他們的
Dialogue: 0,0:15:39.22,0:15:43.56,Default,,0,0,0,,不用你轉達 我全都聽到了
Dialogue: 0,0:15:43.56,0:15:46.48,Default,,0,0,0,,你沒察覺到我來了 對吧
Dialogue: 0,0:15:46.48,0:15:48.28,Default,,0,0,0,,英雄 結果你還是因為交情
Dialogue: 0,0:15:48.28,0:15:50.65,Default,,0,0,0,,壞事了嘛
Dialogue: 0,0:15:50.65,0:15:52.74,Default,,0,0,0,,荼…荼毘…
Dialogue: 0,0:15:53.36,0:15:57.08,Default,,0,0,0,,TWICE 你沒做錯任何事
Dialogue: 0,0:15:57.08,0:15:59.62,Default,,0,0,0,,有錯的一直都是那些英雄
Dialogue: 0,0:16:00.50,0:16:02.25,Default,,0,0,0,,我沒說錯吧
Dialogue: 0,0:16:04.67,0:16:06.17,Default,,0,0,0,,不會吧
Dialogue: 0,0:16:08.00,0:16:11.72,Default,,0,0,0,,不過呢 看來你的武器少掉很多了
Dialogue: 0,0:16:13.34,0:16:15.84,Default,,0,0,0,,你差點連自己的同伴都燒掉了
Dialogue: 0,0:16:16.85,0:16:18.72,Default,,0,0,0,,不用擔心
Dialogue: 1,0:16:18.72,0:16:23.48,Default2,,0,0,0,,英雄就是會在千鈞一髮的
Dialogue: 0,0:16:18.72,0:16:23.48,Default,,0,0,0,,時候救人的人啊
Dialogue: 0,0:16:23.48,0:16:26.15,Default,,0,0,0,,你還挺會酸人的嘛
Dialogue: 1,0:16:26.15,0:16:30.28,Default2,,0,0,0,,剛才你以一副看穿我背叛的氣勢
Dialogue: 0,0:16:26.15,0:16:30.28,Default,,0,0,0,,衝進來…
Dialogue: 0,0:16:30.28,0:16:32.24,Default,,0,0,0,,是我哪裡穿幫了嗎
Dialogue: 0,0:16:32.24,0:16:34.45,Default,,0,0,0,,沒什麼穿不穿幫的
Dialogue: 0,0:16:34.45,0:16:37.41,Default,,0,0,0,,應該說打從我一開始就不相信你
Dialogue: 0,0:16:38.53,0:16:40.49,Default,,0,0,0,,為了取得你們的信任
Dialogue: 0,0:16:40.49,0:16:42.96,Default,,0,0,0,,我還不惜鋌而走險呢
Dialogue: 0,0:16:43.91,0:16:46.38,Default,,0,0,0,,這一點我倒是得跟你道謝
Dialogue: 0,0:16:46.38,0:16:48.13,Default,,0,0,0,,是嗎
Dialogue: 0,0:16:48.13,0:16:50.50,Default,,0,0,0,,羽毛燒焦後威力會減弱
Dialogue: 0,0:16:50.50,0:16:53.76,Default,,0,0,0,,他的個性剋我 這裡又很狹窄
Dialogue: 0,0:16:53.76,0:16:56.01,Default,,0,0,0,,根本劣勢大滿貫
Dialogue: 0,0:16:56.01,0:16:59.05,Default,,0,0,0,,先以達成目的為優先吧
Dialogue: 0,0:16:59.05,0:17:00.93,Default,,0,0,0,,我削弱分倍河原的戰力了
Dialogue: 1,0:17:00.93,0:17:03.93,Default2,,0,0,0,,剛才避開內臟
Dialogue: 0,0:17:00.93,0:17:03.93,Default,,0,0,0,,斬斷了他的肌肉跟骨頭
Dialogue: 0,0:17:03.93,0:17:06.48,Default,,0,0,0,,傷成這樣 他沒辦法再繼續掙扎
Dialogue: 0,0:17:06.48,0:17:08.31,Default,,0,0,0,,把他一起帶走
Dialogue: 0,0:17:11.03,0:17:12.31,Default,,0,0,0,,都叫你不要亂動了
Dialogue: 0,0:17:12.31,0:17:14.65,Default,,0,0,0,,荼毘燒了他
Dialogue: 0,0:17:19.95,0:17:22.20,Default,,0,0,0,,好燙 好冰啊
Dialogue: 1,0:17:22.20,0:17:26.32,Default2,,0,0,0,,只要靠你一個人
Dialogue: 0,0:17:22.20,0:17:26.32,Default,,0,0,0,,我們就能驅散那些英雄
Dialogue: 0,0:17:26.32,0:17:29.96,Default,,0,0,0,,大鬧一場吧 大家都在等著你呢
Dialogue: 0,0:17:29.96,0:17:31.09,Default,,0,0,0,,好…
Dialogue: 0,0:17:32.17,0:17:33.84,Default,,0,0,0,,好
Dialogue: 0,0:17:44.39,0:17:45.89,Default,,0,0,0,,難道說
Dialogue: 1,0:17:45.89,0:17:49.52,Default2,,0,0,0,,他跟著火焰一起到了外面…
Dialogue: 0,0:17:45.89,0:17:49.52,Default,,0,0,0,,然後再繞過來這邊
Dialogue: 0,0:17:50.19,0:17:51.82,Default,,0,0,0,,快過頭了…
Dialogue: 0,0:17:52.90,0:17:54.69,Default,,0,0,0,,給我閃邊去
Dialogue: 0,0:17:55.24,0:17:56.99,Default,,0,0,0,,鷹見啟悟
Dialogue: 0,0:18:01.37,0:18:03.62,Default,,0,0,0,,他怎麼會知道我的名字
Dialogue: 0,0:18:03.62,0:18:05.91,Default,,0,0,0,,這傢伙…是什麼人
Dialogue: 1,0:18:16.22,0:18:20.34,Default2,,0,0,0,,只要靠你一個人
Dialogue: 0,0:18:16.22,0:18:20.34,Default,,0,0,0,,我們就能驅散那些英雄
Dialogue: 0,0:18:21.05,0:18:24.22,Default,,0,0,0,,我得保護大家才行
Dialogue: 0,0:18:25.47,0:18:28.56,Default,,0,0,0,,要保護大家 TWICE
Dialogue: 0,0:18:28.56,0:18:31.94,Default,,0,0,0,,我要保護 那些同伴…
Dialogue: 0,0:18:33.11,0:18:35.53,Default,,0,0,0,,回報他們接納我的恩情
Dialogue: 0,0:18:37.28,0:18:40.70,Default,,0,0,0,,不能在最後恩將仇報…
Dialogue: 0,0:19:02.89,0:19:04.22,Default,,0,0,0,,渡我妹妹
Dialogue: 0,0:19:04.22,0:19:06.97,Default,,0,0,0,,迫壓紘 渡我被身子 已被捕獲
Dialogue: 0,0:19:06.97,0:19:08.10,Default,,0,0,0,,準備吞掉他們
Dialogue: 0,0:19:08.10,0:19:11.48,Default,,0,0,0,,渡我妹妹消除氣息的技術不管用…
Dialogue: 0,0:19:11.48,0:19:13.23,Default,,0,0,0,,這個噁心的東西是感測類的嗎
Dialogue: 0,0:19:13.23,0:19:15.40,Default,,0,0,0,,討厭快點放開我
Dialogue: 1,0:19:15.40,0:19:19.19,Default2,,0,0,0,,不管是出於什麼理由
Dialogue: 0,0:19:15.40,0:19:19.19,Default,,0,0,0,,只要你們與社會為敵…
Dialogue: 0,0:19:19.19,0:19:21.53,Default,,0,0,0,,我們英雄就絕不會坐視不管
Dialogue: 0,0:19:21.53,0:19:24.07,Default,,0,0,0,,這次真的結束了敵人聯軍
Dialogue: 0,0:19:25.37,0:19:26.70,Default,,0,0,0,,阿仁
Dialogue: 0,0:19:27.87,0:19:31.62,Default,,0,0,0,,放手…
Dialogue: 0,0:19:31.62,0:19:32.62,Default,,0,0,0,,好耶
Dialogue: 0,0:19:32.62,0:19:33.83,Default,,0,0,0,,我們贏定了
Dialogue: 0,0:19:33.83,0:19:35.46,Default,,0,0,0,,瘋狂增加吧 TWICE
Dialogue: 1,0:19:35.46,0:19:38.55,Default2,,0,0,0,,渡我妹妹我們快點下樓
Dialogue: 0,0:19:35.46,0:19:38.55,Default,,0,0,0,,逃到地下去吧
Dialogue: 0,0:19:41.05,0:19:43.26,Default,,0,0,0,,抱歉 壓縮
Dialogue: 0,0:19:45.64,0:19:47.60,Default,,0,0,0,,我沒辦法增加了
Dialogue: 1,0:19:47.60,0:19:51.73,Default2,,0,0,0,,現在光是維持這個型態
Dialogue: 0,0:19:47.60,0:19:51.73,Default,,0,0,0,,就費盡力氣了
Dialogue: 0,0:19:53.10,0:19:56.15,Default,,0,0,0,,就像憋著不大便一樣
Dialogue: 1,0:19:56.15,0:19:59.90,Default2,,0,0,0,,因為我被推下來…
Dialogue: 0,0:19:56.15,0:19:59.90,Default,,0,0,0,,從水泥上滾下來了
Dialogue: 0,0:20:02.40,0:20:04.62,Default,,0,0,0,,我對不起你們…
Dialogue: 0,0:20:05.70,0:20:07.53,Default,,0,0,0,,這次我又害了大家
Dialogue: 0,0:20:08.83,0:20:11.25,Default,,0,0,0,,我被霍克斯設計了
Dialogue: 0,0:20:11.25,0:20:13.12,Default,,0,0,0,,這次又犯錯了
Dialogue: 0,0:20:14.46,0:20:15.88,Default,,0,0,0,,對不起
Dialogue: 0,0:20:17.25,0:20:18.63,Default,,0,0,0,,渡我妹妹…
Dialogue: 0,0:20:24.22,0:20:27.51,Default,,0,0,0,,妳可愛的臉又受傷了
Dialogue: 0,0:20:29.93,0:20:32.52,Default,,0,0,0,,這條手帕… 還給妳
Dialogue: 0,0:20:40.53,0:20:43.20,Default,,0,0,0,,只要包起來就是一個了對吧
Dialogue: 0,0:20:47.78,0:20:50.08,Default,,0,0,0,,我人生一路走來的確是一直…
Dialogue: 0,0:20:51.33,0:20:55.75,Default,,0,0,0,,墮落再墮落…被人欺騙…
Dialogue: 0,0:20:55.75,0:20:58.46,Default,,0,0,0,,不僅失去夥伴
Dialogue: 0,0:20:58.46,0:21:01.17,Default,,0,0,0,,又被再一次被人欺騙
Dialogue: 0,0:21:02.17,0:21:06.59,Default,,0,0,0,,看起來一定很可悲 又毫無意義吧
Dialogue: 0,0:21:09.10,0:21:10.43,Default,,0,0,0,,我…
Dialogue: 0,0:21:12.39,0:21:14.52,Default,,0,0,0,,已經…沒辦法增加了…
Dialogue: 0,0:21:15.44,0:21:18.40,Default,,0,0,0,,為了尋求自我 四處漂泊
Dialogue: 0,0:21:18.40,0:21:23.40,Default,,0,0,0,,對不起 直到最後…都真的…
Dialogue: 1,0:21:23.40,0:21:27.03,Default2,,0,0,0,,很幸運地認識了
Dialogue: 0,0:21:23.40,0:21:27.03,Default,,0,0,0,,比自己更珍貴的夥伴
Dialogue: 0,0:21:27.03,0:21:28.45,Default,,0,0,0,,阿仁…
Dialogue: 0,0:21:30.03,0:21:32.62,Default,,0,0,0,,真的很謝謝你救了我
Dialogue: 0,0:21:32.62,0:21:35.83,Default,,0,0,0,,有比這個更美好的人生嗎
Dialogue: 0,0:21:36.96,0:21:39.25,Default,,0,0,0,,去死吧 霍克斯
Dialogue: 1,0:21:39.25,0:21:43.46,Default2,,0,0,0,,什麼"運氣不好"啊
Dialogue: 0,0:21:39.25,0:21:43.46,Default,,0,0,0,,少在那邊自以為是了
Dialogue: 1,0:21:43.46,0:21:47.80,Default2,,0,0,0,,能夠待在這裡
Dialogue: 0,0:21:43.46,0:21:47.80,Default,,0,0,0,,我真的覺得很幸福
Dialogue: 0,0:23:20.85,0:23:22.65,Default,,0,0,0,,下集預告
Dialogue: 0,0:23:22.65,0:23:26.32,Default,,0,0,0,,盛怒的荼毘對霍克斯發動猛攻
Dialogue: 0,0:23:26.32,0:23:28.24,Default,,0,0,0,,另一方面 在蛇腔醫院那邊
Dialogue: 1,0:23:28.24,0:23:33.24,Default2,,0,0,0,,被釋放出來的最新型腦無
Dialogue: 0,0:23:28.24,0:23:33.24,Default,,0,0,0,,對英雄們伸出了獠牙
Dialogue: 1,0:23:33.24,0:23:38.45,Default2,,0,0,0,,究竟有沒有方法可以戰勝
Dialogue: 0,0:23:33.24,0:23:38.45,Default,,0,0,0,,利用超再生能力復活的高端呢
Dialogue: 0,0:23:38.45,0:23:40.71,Default,,0,0,0,,下一集 繼承
Dialogue: 1,0:23:40.71,0:23:44.88,Default2,,0,0,0,,王牌就是 擁有能抹消個性的個性
Dialogue: 0,0:23:40.71,0:23:44.88,Default,,0,0,0,,抹消磁頭
Dialogue: 0,0:23:44.88,0:23:47.00,Default,,0,0,0,,也就是相澤老師了
Dialogue: 0,0:23:47.00,0:23:50.05,Default,,0,0,0,,更向前邁進吧 Plus Ultra

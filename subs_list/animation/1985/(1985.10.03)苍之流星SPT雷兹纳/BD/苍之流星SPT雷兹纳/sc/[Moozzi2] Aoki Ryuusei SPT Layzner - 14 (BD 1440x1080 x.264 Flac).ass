Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:02.50,0:01:03.54,Layzner,David,0,0,0,,英二
Dialogue: 0,0:01:04.08,0:01:06.58,Layzner,David,0,0,0,,为什么你要投降
Dialogue: 0,0:01:06.58,0:01:07.83,Layzner,Elizabeth,0,0,0,,大卫
Dialogue: 0,0:01:07.83,0:01:10.21,Layzner,David,0,0,0,,你不战斗的话 我来
Dialogue: 0,0:01:41.75,0:01:42.61,Layzner,Carks,0,0,0,,快一点
Dialogue: 0,0:01:42.61,0:01:43.45,Layzner,Eiji,0,0,0,,少佐
Dialogue: 0,0:01:43.45,0:01:45.91,Layzner,Eiji,0,0,0,,命运不也让我们连在一起了吗
Dialogue: 0,0:01:47.50,0:01:49.95,Layzner,Carks,0,0,0,,快走啊 不要管我 快走
Dialogue: 0,0:01:49.95,0:01:51.96,Layzner,Carks,0,0,0,,大家 地球就拜托你们了
Dialogue: 0,0:02:09.40,0:02:14.40,Layzner,,0,0,0,,第十四话 被外星人捉了
Dialogue: 0,0:02:15.24,0:02:18.67,Layzner,Anna,0,0,0,,虽然我们从即将爆炸的苏联舰中逃出
Dialogue: 0,0:02:18.67,0:02:25.51,Layzner,Anna,0,0,0,,但是 想到牺牲自己让我们逃出来的丹尼少佐
Dialogue: 0,0:02:25.51,0:02:29.25,Layzner,Anna,0,0,0,,一切都只能祈祷
Dialogue: 0,0:02:30.02,0:02:33.21,Layzner,Arthur,0,0,0,,他们追来了
Dialogue: 0,0:02:34.19,0:02:35.58,Layzner,Eiji,0,0,0,,等一下 我出击就好了
Dialogue: 0,0:02:35.58,0:02:36.69,Layzner,David,0,0,0,,我们呢
Dialogue: 0,0:02:36.69,0:02:40.16,Layzner,Eiji,0,0,0,,刚刚逃出来的时候贝布鲁和布鲁迪的能源已用尽
Dialogue: 0,0:02:40.56,0:02:42.34,Layzner,Eiji,0,0,0,,能动的只剩下我的雷兹纳
Dialogue: 0,0:02:42.34,0:02:43.56,Layzner,David,0,0,0,,那么
Dialogue: 0,0:02:43.56,0:02:46.90,Layzner,Eiji,0,0,0,,总之我会全力以赴 剩下的拜托你们了
Dialogue: 0,0:02:48.17,0:02:49.00,Layzner,David,0,0,0,,英二
Dialogue: 0,0:02:49.61,0:02:50.60,Layzner,Elizabeth,0,0,0,,等一下
Dialogue: 0,0:02:52.98,0:02:57.32,Layzner,Arthur,0,0,0,,没有能源的意思是说这航天飞机不能发射武器咯
Dialogue: 0,0:02:57.32,0:02:58.95,Layzner,David,0,0,0,,没错
Dialogue: 0,0:02:58.95,0:02:59.81,Layzner,Arthur,0,0,0,,那么
Dialogue: 0,0:02:59.81,0:03:01.61,Layzner,Roanne,0,0,0,,说不定我们逃不掉了
Dialogue: 0,0:03:10.94,0:03:14.49,Layzner,Gale,0,0,0,,那航天飞机的能源应该快用尽了
Dialogue: 0,0:03:14.49,0:03:16.88,Layzner,Gale,0,0,0,,可以推测太空船503可动率吗
Dialogue: 0,0:03:16.88,0:03:18.14,Layzner,Com,0,0,0,,可以
Dialogue: 0,0:03:18.14,0:03:21.34,Layzner,Com,0,0,0,,已经消耗98%以上的能源
Dialogue: 0,0:03:21.34,0:03:23.94,Layzner,Com,0,0,0,,能量剩余量已到了极限
Dialogue: 0,0:03:23.94,0:03:24.68,Layzner,Gale,0,0,0,,果然没错
Dialogue: 0,0:03:26.17,0:03:28.23,Layzner,Gale,0,0,0,,还有三十秒就能跟他们接触
Dialogue: 0,0:03:36.57,0:03:37.90,Layzner,Gale,0,0,0,,全员排开队形
Dialogue: 0,0:03:40.05,0:03:40.94,Layzner,Callea,0,0,0,,出现了
Dialogue: 0,0:03:40.94,0:03:42.68,Layzner,Callea,0,0,0,,今天一定要分出胜负
Dialogue: 0,0:03:47.82,0:03:48.67,Layzner,Gale,0,0,0,,卡露拉少尉
Dialogue: 0,0:03:57.23,0:03:59.65,Layzner,Gale,0,0,0,,等一下 少尉 还不要攻击
Dialogue: 0,0:04:07.28,0:04:08.83,Layzner,Callea,0,0,0,,就这点本事打得赢我吗
Dialogue: 0,0:04:11.90,0:04:12.75,Layzner,Eiji,0,0,0,,不好了
Dialogue: 0,0:04:27.78,0:04:29.58,Layzner,Callea,0,0,0,,好 这就是你的末日了
Dialogue: 0,0:04:29.58,0:04:30.58,Layzner,Gale,0,0,0,,少尉
Dialogue: 0,0:04:37.84,0:04:40.05,Layzner,Callea,0,0,0,,中尉
Dialogue: 0,0:04:40.05,0:04:42.51,Layzner,Gale,0,0,0,,没听到我叫你不要攻击吗
Dialogue: 0,0:04:42.51,0:04:43.53,Layzner,Callea,0,0,0,,可是
Dialogue: 0,0:04:43.53,0:04:46.45,Layzner,Gale,0,0,0,,全员去包围航天飞机 照队形待命
Dialogue: 0,0:04:52.95,0:04:54.91,Layzner,Arthur,0,0,0,,我们被包围了吗
Dialogue: 0,0:05:00.34,0:05:02.51,Layzner,Eiji,0,0,0,,他们想干什么
Dialogue: 0,0:05:02.51,0:05:04.60,Layzner,Gale,0,0,0,,英二 听得到吗
Dialogue: 0,0:05:04.60,0:05:06.13,Layzner,Gale,0,0,0,,听到请回答
Dialogue: 0,0:05:06.13,0:05:07.00,Layzner,Eiji,0,0,0,,前辈
Dialogue: 0,0:05:07.00,0:05:08.20,Layzner,Gale,0,0,0,,听得到吗
Dialogue: 0,0:05:08.20,0:05:08.89,Layzner,Eiji,0,0,0,,听得到
Dialogue: 0,0:05:08.89,0:05:12.45,Layzner,Gale,0,0,0,,英二 我就直接说了 你投降吧
Dialogue: 0,0:05:14.61,0:05:18.12,Layzner,Gale,0,0,0,,我知道你们的太空船已经没有能源了
Dialogue: 0,0:05:18.12,0:05:20.44,Layzner,Gale,0,0,0,,不要再做无谓的反抗了 快投降
Dialogue: 0,0:05:20.44,0:05:21.52,Layzner,David,0,0,0,,不要开玩笑
Dialogue: 0,0:05:21.52,0:05:23.55,Layzner,David,0,0,0,,谁会投降
Dialogue: 0,0:05:23.55,0:05:26.00,Layzner,David,0,0,0,,我们才不会听你的
Dialogue: 0,0:05:26.00,0:05:28.51,Layzner,Gale,0,0,0,,闭嘴 我在跟英二说话
Dialogue: 0,0:05:35.03,0:05:36.83,Layzner,Gale,0,0,0,,回答我
Dialogue: 0,0:05:36.83,0:05:40.67,Layzner,Gale,0,0,0,,现在我们枪口下的不是只有你而已
Dialogue: 0,0:05:40.71,0:05:43.42,Layzner,Eiji,0,0,0,,前辈 请答应我
Dialogue: 0,0:05:43.42,0:05:47.10,Layzner,Eiji,0,0,0,,不要对太空船里的地球人下手 请答应我
Dialogue: 0,0:05:47.13,0:05:50.14,Layzner,Gale,0,0,0,,不用担心 我会妥善处置的
Dialogue: 0,0:05:55.64,0:05:58.48,Layzner,Eiji,0,0,0,,我知道了 我投降
Dialogue: 0,0:05:59.69,0:06:01.61,Layzner,Gale,0,0,0,,好 会航天飞机去
Dialogue: 0,0:06:03.61,0:06:05.00,Layzner,Callea,0,0,0,,中尉
Dialogue: 0,0:06:23.92,0:06:24.96,Layzner,David,0,0,0,,英二
Dialogue: 0,0:06:25.40,0:06:27.86,Layzner,David,0,0,0,,你为什么投降
Dialogue: 0,0:06:27.86,0:06:29.43,Layzner,Elizabeth,0,0,0,,大卫
Dialogue: 0,0:06:29.43,0:06:32.94,Layzner,David,0,0,0,,我们就快能看到地球了
Dialogue: 0,0:06:35.68,0:06:38.96,Layzner,David,0,0,0,,你不战斗的话 我上 走开
Dialogue: 0,0:06:42.82,0:06:45.28,Layzner,Eiji,0,0,0,,在这里要听我的
Dialogue: 0,0:06:48.56,0:06:50.20,Layzner,David,0,0,0,,英二 你这家伙
Dialogue: 0,0:06:50.20,0:06:52.09,Layzner,Elizabeth,0,0,0,,大卫 住手
Dialogue: 0,0:06:52.09,0:06:53.66,Layzner,Simone,0,0,0,,我投降了
Dialogue: 0,0:06:54.75,0:06:57.63,Layzner,Simone,0,0,0,,人生有时也要举白旗的
Dialogue: 0,0:06:57.63,0:07:02.97,Layzner,Simone,0,0,0,,不过那白旗 只是为了要反抗的一种手段
Dialogue: 0,0:07:11.12,0:07:13.76,Layzner,David,0,0,0,,那是 莎 莎 莎士比亚说的吗
Dialogue: 0,0:07:13.76,0:07:16.68,Layzner,Simone,0,0,0,,不是 是我爹经常说的
Dialogue: 0,0:07:16.68,0:07:19.48,Layzner,Simone,0,0,0,,每次我输给对手时他都会这么说
Dialogue: 0,0:07:19.48,0:07:23.20,Layzner,David,0,0,0,,是这样啊 可是现在的情况正好一样不是吗
Dialogue: 0,0:07:24.06,0:07:25.60,Layzner,,0,0,0,,可恶
Dialogue: 0,0:07:28.04,0:07:31.87,Layzner,Anna,0,0,0,,现在不投降的话大家就无法得救了
Dialogue: 0,0:07:31.87,0:07:34.83,Layzner,Anna,0,0,0,,其实大卫也知道
Dialogue: 0,0:07:34.83,0:07:42.35,Layzner,Anna,0,0,0,,但好不容易逃到这才要投降真的很令人难受
Dialogue: 0,0:07:34.83,0:07:42.35,Layzner,Anna,0,0,0,,虽然知道这道理
Dialogue: 0,0:07:42.79,0:07:45.98,Layzner,Anna,0,0,0,,还差一点就到地球了
Dialogue: 0,0:07:46.59,0:07:47.71,Layzner,Anna,0,0,0,,所以
Dialogue: 0,0:09:04.50,0:09:07.25,Layzner,Gale,0,0,0,,你说没有让他们活下去的必要是吗
Dialogue: 0,0:09:07.25,0:09:11.76,Layzner,Callea,0,0,0,,和反叛者全都消灭了
Dialogue: 0,0:09:07.25,0:09:11.76,Layzner,Callea,0,0,0,,是的 陛下下令要把那些残存的地球人
Dialogue: 0,0:09:11.76,0:09:15.01,Layzner,Gale,0,0,0,,把他们当俘虏也就等于把他们都消灭了
Dialogue: 0,0:09:15.01,0:09:18.21,Layzner,Gale,0,0,0,,没必要杀没有反抗意识的人
Dialogue: 0,0:09:18.21,0:09:20.45,Layzner,Gale,0,0,0,,陛下的话里还有这一层意思
Dialogue: 0,0:09:20.45,0:09:22.00,Layzner,Callea,0,0,0,,是吗
Dialogue: 0,0:09:22.00,0:09:23.45,Layzner,Gale,0,0,0,,不是吗
Dialogue: 0,0:09:23.45,0:09:26.90,Layzner,Callea,0,0,0,,不 我想要不要再询问陛下的命令
Dialogue: 0,0:09:26.90,0:09:28.78,Layzner,Gale,0,0,0,,你觉得他们怎么样
Dialogue: 0,0:09:28.78,0:09:31.00,Layzner,Callea,0,0,0,,就是背叛者跟地球人
Dialogue: 0,0:09:31.00,0:09:35.68,Layzner,Gale,0,0,0,,只有这样而已吗 我觉得他们跟我们一样都是人类
Dialogue: 0,0:09:35.68,0:09:36.97,Layzner,Gale,0,0,0,,你不觉得吗
Dialogue: 0,0:09:36.97,0:09:39.05,Layzner,Callea,0,0,0,,我不懂您的意思
Dialogue: 0,0:09:39.05,0:09:40.98,Layzner,Gale,0,0,0,,算了 这里拜托你了
Dialogue: 0,0:09:40.98,0:09:42.06,Layzner,Callea,0,0,0,,是
Dialogue: 0,0:09:46.13,0:09:47.37,Layzner,Soldier,0,0,0,,进去
Dialogue: 0,0:09:56.01,0:09:57.22,Layzner,Soldier,0,0,0,,你留下来
Dialogue: 0,0:09:58.85,0:10:00.67,Layzner,Soldier,0,0,0,,中尉 人带来了
Dialogue: 0,0:10:00.67,0:10:02.39,Layzner,Gale,0,0,0,,好
Dialogue: 0,0:10:08.02,0:10:09.52,Layzner,Gale,0,0,0,,你变壮了
Dialogue: 0,0:10:09.52,0:10:10.69,Layzner,Gale,0,0,0,,坐吧
Dialogue: 0,0:10:11.85,0:10:13.36,Layzner,Gale,0,0,0,,你怎么了 先坐吧
Dialogue: 0,0:10:14.23,0:10:16.27,Layzner,Gale,0,0,0,,怎么变得这么冷淡
Dialogue: 0,0:10:16.27,0:10:18.41,Layzner,Eiji,0,0,0,,我是俘虏 怎么能嬉皮笑脸呢
Dialogue: 0,0:10:19.57,0:10:24.05,Layzner,Gale,0,0,0,,好讽刺啊 没想到我们会彼此战斗
Dialogue: 0,0:10:26.30,0:10:27.91,Layzner,Arthur,0,0,0,,不过我真的吓一跳
Dialogue: 0,0:10:27.96,0:10:32.52,Layzner,Arthur,0,0,0,,虽然现在才想到但外星人竟长得跟我们一样耶
Dialogue: 0,0:10:32.52,0:10:34.68,Layzner,Simone,0,0,0,,因为进化的过程一样嘛
Dialogue: 0,0:10:34.68,0:10:36.23,Layzner,Elizabeth,0,0,0,,说不定是那样
Dialogue: 0,0:10:36.54,0:10:39.13,Layzner,Arthur,0,0,0,,不过我们会怎么样呢
Dialogue: 0,0:10:39.13,0:10:41.40,Layzner,David,0,0,0,,现在不是为了反击才一时投降的吗
Dialogue: 0,0:10:41.40,0:10:42.80,Layzner,Arthur,0,0,0,,是啊
Dialogue: 0,0:10:43.18,0:10:45.78,Layzner,Roanne,0,0,0,,所以我们要快想反击的方法对吧
Dialogue: 0,0:10:45.78,0:10:47.98,Layzner,Simone,0,0,0,,没错
Dialogue: 0,0:10:51.48,0:10:55.35,Layzner,Gale,0,0,0,,你的爸爸被要求对背叛负责而被捕
Dialogue: 0,0:10:56.43,0:10:58.63,Layzner,Gale,0,0,0,,你的妈妈和玖丽现在被软禁
Dialogue: 0,0:10:59.85,0:11:02.20,Layzner,Gale,0,0,0,,你好冷静 你已有这种觉悟了吗
Dialogue: 0,0:11:02.41,0:11:04.85,Layzner,Eiji,0,0,0,,是的 我早就料到会这样了
Dialogue: 0,0:11:04.85,0:11:06.19,Layzner,Gale,0,0,0,,为什么
Dialogue: 0,0:11:06.19,0:11:09.26,Layzner,Gale,0,0,0,,为什么要这样包庇地球
Dialogue: 0,0:11:09.26,0:11:12.74,Layzner,Gale,0,0,0,,虽说你体内有一半地球人的血
Dialogue: 0,0:11:12.74,0:11:16.23,Layzner,Gale,0,0,0,,但你不是在古拉特斯长的的古拉特斯人吗
Dialogue: 0,0:11:16.23,0:11:20.20,Layzner,Eiji,0,0,0,,地球 对我来说和古拉特斯一样都是我的故乡
Dialogue: 0,0:11:20.20,0:11:21.35,Layzner,Eiji,0,0,0,,不只是我
Dialogue: 0,0:11:21.35,0:11:23.47,Layzner,Eiji,0,0,0,,还有几亿地球人生活在地球上
Dialogue: 0,0:11:23.87,0:11:25.37,Layzner,Eiji,0,0,0,,你有看到他们吧
Dialogue: 0,0:11:25.37,0:11:27.88,Layzner,Eiji,0,0,0,,他们跟我们一样也是人
Dialogue: 0,0:11:27.88,0:11:30.99,Layzner,Eiji,0,0,0,,他们也以自己的星球为荣而一直活下去
Dialogue: 0,0:11:30.99,0:11:32.89,Layzner,Eiji,0,0,0,,我也是
Dialogue: 0,0:11:32.89,0:11:36.89,Layzner,Eiji,0,0,0,,我爱着蔚蓝又美丽的地球就像爱着古拉特斯一样
Dialogue: 0,0:11:36.89,0:11:40.32,Layzner,Gale,0,0,0,,蔚蓝而美丽 你有看过吗
Dialogue: 0,0:11:40.33,0:11:43.80,Layzner,Eiji,0,0,0,,不用看也知道 我听爸爸说了好多次
Dialogue: 0,0:11:43.80,0:11:47.15,Layzner,Eiji,0,0,0,,那景象已真实地烙在我心里
Dialogue: 0,0:11:47.15,0:11:51.49,Layzner,Gale,0,0,0,,如果照你所说人类以自己的美丽的地球为荣的话
Dialogue: 0,0:11:51.87,0:11:54.67,Layzner,Gale,0,0,0,,那为什么还要彼此征服呢
Dialogue: 0,0:11:54.67,0:11:58.12,Layzner,Eiji,0,0,0,,那是他们目前的组织有问题
Dialogue: 0,0:11:58.12,0:12:00.49,Layzner,Eiji,0,0,0,,人民并不想要战争
Dialogue: 0,0:12:00.49,0:12:02.39,Layzner,Gale,0,0,0,,你怎么知道
Dialogue: 0,0:12:02.39,0:12:04.56,Layzner,Gale,0,0,0,,是跟你在一起的那些人说的吗
Dialogue: 0,0:12:04.56,0:12:05.37,Layzner,Eiji,0,0,0,,是的
Dialogue: 0,0:12:05.77,0:12:10.65,Layzner,Gale,0,0,0,,我们只想改变目前人类的组织
Dialogue: 0,0:12:10.65,0:12:13.32,Layzner,Gale,0,0,0,,并没有要毁灭地球的意思
Dialogue: 0,0:12:13.32,0:12:17.16,Layzner,Eiji,0,0,0,,古拉特斯明明就想让地球爆发末日战争
Dialogue: 0,0:12:17.16,0:12:21.10,Layzner,Eiji,0,0,0,,如果真的爆发的话地球上的大自然和环境全部都会被破坏的
Dialogue: 0,0:12:21.10,0:12:26.74,Layzner,Gale,0,0,0,,不这样的话现在的地球是不可能改变的
Dialogue: 0,0:12:26.74,0:12:33.07,Layzner,Gale,0,0,0,,这是古拉特斯的中央电脑经过长时间计算得出的结果
Dialogue: 0,0:12:33.07,0:12:35.53,Layzner,Eiji,0,0,0,,那计算是错的
Dialogue: 0,0:12:35.53,0:12:36.67,Layzner,Gale,0,0,0,,没错
Dialogue: 0,0:12:44.02,0:12:46.05,Layzner,Callea,0,0,0,,那食物要运到哪里
Dialogue: 0,0:12:46.05,0:12:47.30,Layzner,Soldier,0,0,0,,俘虏那里
Dialogue: 0,0:12:47.30,0:12:49.24,Layzner,Callea,0,0,0,,什么 是谁的命令
Dialogue: 0,0:12:49.24,0:12:50.34,Layzner,Soldier,0,0,0,,是凯利中尉
Dialogue: 0,0:12:51.51,0:12:52.32,Layzner,Soldier,0,0,0,,是
Dialogue: 0,0:12:53.91,0:12:57.66,Layzner,Callea,0,0,0,,他还是想让他们活下去是吗 笨蛋
Dialogue: 0,0:13:10.24,0:13:12.53,Layzner,Simone,0,0,0,,猫粮都比这好吃
Dialogue: 0,0:13:12.53,0:13:13.68,Layzner,Arthur,0,0,0,,他去好久啊
Dialogue: 0,0:13:13.68,0:13:14.99,Layzner,David,0,0,0,,你说英二吗
Dialogue: 0,0:13:14.99,0:13:17.03,Layzner,Arthur,0,0,0,,没错 他该不会被怎么样了吧
Dialogue: 0,0:13:17.03,0:13:18.38,Layzner,Simone,0,0,0,,不要讲这种不吉利的话
Dialogue: 0,0:13:18.38,0:13:19.27,Layzner,Arthur,0,0,0,,可是
Dialogue: 0,0:13:19.27,0:13:20.56,Layzner,Elizabeth,0,0,0,,不用担心
Dialogue: 0,0:13:20.56,0:13:23.61,Layzner,Roanne,0,0,0,,对啊 他的食物也被送来了
Dialogue: 0,0:13:24.80,0:13:25.47,Layzner,Simone,0,0,0,,对啊
Dialogue: 0,0:13:26.41,0:13:28.15,Layzner,David,0,0,0,,说曹操曹操到
Dialogue: 0,0:13:28.15,0:13:29.61,Layzner,Simone,0,0,0,,他们有没有对你怎么样
Dialogue: 0,0:13:29.61,0:13:30.83,Layzner,Simone,0,0,0,,没事吗
Dialogue: 0,0:13:30.83,0:13:32.79,Layzner,Eiji,0,0,0,,他们没对我怎么样
Dialogue: 0,0:13:33.53,0:13:34.79,Layzner,Simone,0,0,0,,饿了吧
Dialogue: 0,0:13:34.79,0:13:37.74,Layzner,Simone,0,0,0,,这有食物 虽然不太好吃
Dialogue: 0,0:13:37.74,0:13:39.02,Layzner,Eiji,0,0,0,,谢谢
Dialogue: 0,0:13:39.41,0:13:42.20,Layzner,Simone,0,0,0,,为了身体还是吃一点比较好
Dialogue: 0,0:13:42.20,0:13:45.83,Layzner,Arthur,0,0,0,,切 刚才明明就说那东西像猫粮似的
Dialogue: 0,0:13:48.99,0:13:49.81,Layzner,,0,0,0,,对了
Dialogue: 0,0:13:49.81,0:13:52.01,Layzner,Elizabeth,0,0,0,,怎么了 吓我一跳
Dialogue: 0,0:13:52.01,0:13:54.31,Layzner,Arthur,0,0,0,,我想到怎么逃出去的方法了
Dialogue: 0,0:13:54.31,0:13:56.21,Layzner,David,0,0,0,,你？
Dialogue: 0,0:13:56.21,0:13:58.61,Layzner,Arthur,0,0,0,,你的意思是说我想不出方法是吗
Dialogue: 0,0:13:58.61,0:13:59.99,Layzner,Roanne,0,0,0,,看你还蛮自信的嘛
Dialogue: 0,0:14:02.01,0:14:04.36,Layzner,Callea,0,0,0,,我知道 我会照你的命令做的
Dialogue: 0,0:14:04.36,0:14:06.85,Layzner,Zool,0,0,0,,可是为什么是你来报告的
Dialogue: 0,0:14:06.85,0:14:08.47,Layzner,Zool,0,0,0,,凯利中尉怎么了
Dialogue: 0,0:14:08.93,0:14:13.52,Layzner,Callea,0,0,0,,中尉他因为在忙着审问俘虏所以我替他报告
Dialogue: 0,0:14:13.52,0:14:16.48,Layzner,Callea,0,0,0,,在处理俘虏方面中尉和副官您的意思一样
Dialogue: 0,0:14:16.48,0:14:18.81,Layzner,Gale,0,0,0,,是祖鲁副官吗 少尉 怎么了
Dialogue: 0,0:14:19.42,0:14:22.43,Layzner,Callea,0,0,0,,我现在替您报告俘虏的事
Dialogue: 0,0:14:22.43,0:14:23.71,Layzner,Gale,0,0,0,,替我
Dialogue: 0,0:14:23.71,0:14:25.43,Layzner,Zool,0,0,0,,凯利中尉 你做的很好
Dialogue: 0,0:14:25.43,0:14:26.89,Layzner,Gale,0,0,0,,是 谢谢您
Dialogue: 0,0:14:26.89,0:14:32.14,Layzner,Zool,0,0,0,,就在你那里处理吧
Dialogue: 0,0:14:26.89,0:14:32.14,Layzner,Zool,0,0,0,,关于处理俘虏的方法我刚才听少尉说了
Dialogue: 0,0:14:32.14,0:14:33.53,Layzner,Gale,0,0,0,,处理的意思是指
Dialogue: 0,0:14:33.53,0:14:34.37,Layzner,Zool,0,0,0,,处死
Dialogue: 0,0:14:34.37,0:14:36.26,Layzner,Gale,0,0,0,,你说是说处死吗
Dialogue: 0,0:14:36.26,0:14:39.61,Layzner,Zool,0,0,0,,怎么了 你不也想这么做的吗
Dialogue: 0,0:14:39.61,0:14:40.88,Layzner,,0,0,0,,我
Dialogue: 0,0:14:42.61,0:14:45.16,Layzner,Gale,0,0,0,,这是古雷斯库陛下的意思吗
Dialogue: 0,0:14:45.16,0:14:49.32,Layzner,Zool,0,0,0,,当然 要照作战计划进行 俘虏的事没办法了
Dialogue: 0,0:14:49.37,0:14:53.33,Layzner,Gale,0,0,0,,可是这些俘虏里大都是非战斗人员的女性
Dialogue: 0,0:14:53.33,0:14:57.86,Layzner,Zool,0,0,0,,所以怎样 你对古雷斯科陛下的命令有意见吗
Dialogue: 0,0:14:57.86,0:15:03.31,Layzner,Zool,0,0,0,,还是跟背叛者他家的关系让你又心软了呢
Dialogue: 0,0:15:03.31,0:15:05.13,Layzner,Gale,0,0,0,,不 我没这么想
Dialogue: 0,0:15:05.13,0:15:06.06,Layzner,Zool,0,0,0,,没错
Dialogue: 0,0:15:06.06,0:15:10.83,Layzner,Zool,0,0,0,,之所以会把追击队交给你就是要试试你的
Dialogue: 0,0:15:10.83,0:15:14.22,Layzner,Zool,0,0,0,,总之 把俘虏处死 就这样
Dialogue: 0,0:15:19.79,0:15:21.53,Layzner,Gale,0,0,0,,这是怎么回事
Dialogue: 0,0:15:21.53,0:15:23.47,Layzner,Callea,0,0,0,,我没别的意思 我
Dialogue: 0,0:15:23.47,0:15:26.97,Layzner,Callea,0,0,0,,我只是看中尉你太忙了所以才帮你报告的
Dialogue: 0,0:15:26.97,0:15:28.69,Layzner,Gale,0,0,0,,你也赞成把他们处死吗
Dialogue: 0,0:15:29.43,0:15:33.51,Layzner,Callea,0,0,0,,我不敢有个人的意思 我只是听命行事
Dialogue: 0,0:15:33.91,0:15:37.29,Layzner,Callea,0,0,0,,中尉你不会无视陛下的命令吧
Dialogue: 0,0:15:37.29,0:15:40.45,Layzner,Callea,0,0,0,,这样的话连中尉你都会被当背叛者的
Dialogue: 0,0:15:40.45,0:15:43.39,Layzner,Callea,0,0,0,,所以请你下死刑的命令吧 中尉
Dialogue: 0,0:15:43.39,0:15:44.41,Layzner,Gale,0,0,0,,住嘴
Dialogue: 0,0:15:44.41,0:15:45.78,Layzner,Gale,0,0,0,,下去吧
Dialogue: 0,0:15:45.78,0:15:46.58,Layzner,Callea,0,0,0,,是
Dialogue: 0,0:15:56.75,0:15:58.74,Layzner,David,0,0,0,,开门 拜托
Dialogue: 0,0:15:59.66,0:16:02.70,Layzner,David,0,0,0,,我的同伴很难过 帮忙想想办法吧
Dialogue: 0,0:16:02.70,0:16:04.89,Layzner,David,0,0,0,,你们看 他肚子痛
Dialogue: 0,0:16:04.89,0:16:07.75,Layzner,Arthur,0,0,0,,好痛 救我
Dialogue: 0,0:16:09.17,0:16:10.97,Layzner,David,0,0,0,,拜托你们
Dialogue: 0,0:16:13.74,0:16:15.86,Layzner,David,0,0,0,,等一下 帮帮忙吧
Dialogue: 0,0:16:15.86,0:16:17.48,Layzner,David,0,0,0,,我的同伴这么难过
Dialogue: 0,0:16:17.48,0:16:19.14,Layzner,David,0,0,0,,你们难道这么无动于衷吗
Dialogue: 0,0:16:19.14,0:16:22.50,Layzner,David,0,0,0,,可恶 至少给个药嘛
Dialogue: 0,0:16:22.50,0:16:24.04,Layzner,Roanne,0,0,0,,算了啦
Dialogue: 0,0:16:24.04,0:16:26.94,Layzner,Arthur,0,0,0,,我快要死了
Dialogue: 0,0:16:27.19,0:16:28.50,Layzner,David,0,0,0,,笨蛋
Dialogue: 0,0:16:28.50,0:16:30.40,Layzner,David,0,0,0,,什么一定会成功的
Dialogue: 0,0:16:30.40,0:16:32.30,Layzner,Arthur,0,0,0,,不行吗
Dialogue: 0,0:16:32.30,0:16:34.60,Layzner,David,0,0,0,,这样一定不可能成功的
Dialogue: 0,0:16:34.60,0:16:38.39,Layzner,Arthur,0,0,0,,好奇怪 电视上这样都会成功的
Dialogue: 0,0:16:38.39,0:16:41.28,Layzner,Simone,0,0,0,,结果害我们空欢喜一场
Dialogue: 0,0:16:41.28,0:16:44.35,Layzner,Roanne,0,0,0,,对啊 还害我想说一定会功
Dialogue: 0,0:16:44.35,0:16:47.37,Layzner,Elizabeth,0,0,0,,没办法 一定还有别的机会的
Dialogue: 0,0:16:51.72,0:16:56.32,Layzner,Gale,0,0,0,,玖丽亚 如果你失去弟弟了 你还会原谅我吗
Dialogue: 0,0:17:06.52,0:17:08.48,Layzner,Callea,0,0,0,,打开 把他们带走
Dialogue: 0,0:17:08.48,0:17:09.20,Layzner,Soldiers,0,0,0,,是
Dialogue: 0,0:17:09.90,0:17:11.14,Layzner,Callea,0,0,0,,都给我出来
Dialogue: 0,0:17:11.78,0:17:12.78,Layzner,Soldier,0,0,0,,快一点
Dialogue: 0,0:17:15.88,0:17:17.08,Layzner,Soldier,0,0,0,,快走
Dialogue: 0,0:17:17.08,0:17:18.69,Layzner,David,0,0,0,,要带我们去哪
Dialogue: 0,0:17:18.69,0:17:21.02,Layzner,Callea,0,0,0,,一个很远的地方 去了就知道了
Dialogue: 0,0:17:21.02,0:17:22.50,Layzner,Eiji,0,0,0,,很远的地方
Dialogue: 0,0:17:37.43,0:17:38.82,Layzner,Callea,0,0,0,,所有人都给我进去
Dialogue: 0,0:17:38.82,0:17:39.91,Layzner,Simone,0,0,0,,英二 这是哪里
Dialogue: 0,0:17:39.91,0:17:40.90,Layzner,Eiji,0,0,0,,这是密闭室
Dialogue: 0,0:17:40.90,0:17:42.20,Layzner,Simone,0,0,0,,密闭室
Dialogue: 0,0:17:42.20,0:17:44.57,Layzner,Elizabeth,0,0,0,,你要把我们运到哪里
Dialogue: 0,0:17:47.10,0:17:49.71,Layzner,Arthur,0,0,0,,不会要把我们丢到太空中吧
Dialogue: 0,0:17:49.71,0:17:51.61,Layzner,Simone,0,0,0,,你想杀了我们是吗
Dialogue: 0,0:17:51.61,0:17:53.31,Layzner,Callea,0,0,0,,不要啰嗦了 快进去
Dialogue: 0,0:17:53.31,0:17:55.11,Layzner,Eiji,0,0,0,,这是凯利中尉的命令吗
Dialogue: 0,0:17:55.51,0:17:58.30,Layzner,Callea,0,0,0,,不是中尉 是古雷斯库陛下的命令
Dialogue: 0,0:17:58.30,0:17:59.91,Layzner,David,0,0,0,,别开玩笑了
Dialogue: 0,0:18:00.33,0:18:02.77,Layzner,David,0,0,0,,怎么能让你们任意把我们丢到太空
Dialogue: 0,0:18:02.77,0:18:04.92,Layzner,David,0,0,0,,要杀就在这杀了我们
Dialogue: 0,0:18:04.92,0:18:06.44,Layzner,Callea,0,0,0,,你给我进去
Dialogue: 0,0:18:06.44,0:18:07.97,Layzner,David,0,0,0,,要杀就在这杀了我
Dialogue: 0,0:18:07.97,0:18:08.76,Layzner,Eiji,0,0,0,,大卫
Dialogue: 0,0:18:12.69,0:18:17.43,Layzner,Callea,0,0,0,,我们的船不想被你们地球人的血玷污
Dialogue: 0,0:18:17.43,0:18:18.35,Layzner,David,0,0,0,,吵死了
Dialogue: 0,0:18:18.35,0:18:19.81,Layzner,David,0,0,0,,是你下不了手对吧
Dialogue: 0,0:18:20.55,0:18:21.82,Layzner,Callea,0,0,0,,这样的话 我就杀了你
Dialogue: 0,0:18:48.01,0:18:50.19,Layzner,David,0,0,0,,快住手 你想杀了我们吗
Dialogue: 0,0:18:53.57,0:18:54.62,Layzner,Soldier,0,0,0,,可恶
Dialogue: 0,0:18:55.76,0:18:56.68,Layzner,Eiji,0,0,0,,不要动
Dialogue: 0,0:18:57.59,0:18:59.10,Layzner,Eiji,0,0,0,,把枪丢掉
Dialogue: 0,0:18:59.10,0:19:02.90,Layzner,Callea,0,0,0,,没事的 他不敢动手 快射死他们
Dialogue: 0,0:19:06.18,0:19:07.40,Layzner,Eiji,0,0,0,,把枪丢掉
Dialogue: 0,0:19:11.06,0:19:12.65,Layzner,Eiji,0,0,0,,大家 到这来
Dialogue: 0,0:19:15.01,0:19:16.62,Layzner,David,0,0,0,,不要一直抓着枪啦
Dialogue: 0,0:19:20.82,0:19:22.29,Layzner,Eiji,0,0,0,,站在那里不要动
Dialogue: 0,0:19:25.20,0:19:27.20,Layzner,Callea,0,0,0,,怎么会有这种事
Dialogue: 0,0:19:27.25,0:19:29.17,Layzner,Gale,0,0,0,,什么 你说他们要逃走
Dialogue: 0,0:19:40.05,0:19:42.72,Layzner,Solider,0,0,0,,找到了 在这
Dialogue: 0,0:19:46.02,0:19:48.42,Layzner,Eiji,0,0,0,,快去航天飞机那 去补充能源
Dialogue: 0,0:19:48.42,0:19:49.73,Layzner,David,0,0,0,,知道了
Dialogue: 0,0:19:58.44,0:19:59.28,Layzner,Eiji,0,0,0,,前辈
Dialogue: 0,0:20:00.04,0:20:02.36,Layzner,Callea,0,0,0,,中尉 对不起
Dialogue: 0,0:20:02.36,0:20:05.43,Layzner,Callea,0,0,0,,把我也杀了吧 这样背叛者就
Dialogue: 0,0:20:05.66,0:20:07.13,Layzner,Gale,0,0,0,,大家把枪放下
Dialogue: 0,0:20:07.95,0:20:09.12,Layzner,Callea,0,0,0,,中尉
Dialogue: 0,0:20:10.20,0:20:14.36,Layzner,Gale,0,0,0,,英二 我一直不对你下手
Dialogue: 0,0:20:14.36,0:20:17.98,Layzner,Gale,0,0,0,,并不是因为我爱你姐姐
Dialogue: 0,0:20:17.98,0:20:19.68,Layzner,Gale,0,0,0,,是因为我喜欢你
Dialogue: 0,0:20:19.68,0:20:24.15,Layzner,Gale,0,0,0,,我只是相信我应该能开辟一条道路救你出来
Dialogue: 0,0:20:24.83,0:20:27.20,Layzner,Eiji,0,0,0,,对不起 可是我
Dialogue: 0,0:20:27.20,0:20:29.20,Layzner,Gale,0,0,0,,你想说你不会改变心意是吗
Dialogue: 0,0:20:29.20,0:20:30.06,Layzner,Eiji,0,0,0,,对
Dialogue: 0,0:20:30.06,0:20:34.17,Layzner,Eiji,0,0,0,,不管前辈你怎么说我都要去地球
Dialogue: 0,0:20:34.17,0:20:35.25,Layzner,Eiji,0,0,0,,那是我背负的使命
Dialogue: 0,0:20:50.57,0:20:52.45,Layzner,David,0,0,0,,英二 准备好了
Dialogue: 0,0:20:52.45,0:20:53.38,Layzner,Eiji,0,0,0,,知道了
Dialogue: 0,0:20:53.38,0:20:54.37,Layzner,David,0,0,0,,怎么办
Dialogue: 0,0:20:54.37,0:20:55.60,Layzner,Eiji,0,0,0,,给我帽子
Dialogue: 0,0:20:56.56,0:20:57.32,Layzner,David,0,0,0,,丢过来
Dialogue: 0,0:20:59.83,0:21:00.75,Layzner,Gale,0,0,0,,英二
Dialogue: 0,0:21:01.65,0:21:03.39,Layzner,Gale,0,0,0,,你会后悔的
Dialogue: 0,0:21:03.39,0:21:04.68,Layzner,Eiji,0,0,0,,也许你说的没错
Dialogue: 0,0:21:10.85,0:21:13.82,Layzner,Gale,0,0,0,,回舰桥 全员戒备待命
Dialogue: 0,0:21:13.82,0:21:14.32,Layzner,Soldier,0,0,0,,是
Dialogue: 0,0:21:17.86,0:21:20.67,Layzner,Eiji,0,0,0,,伊丽莎白博士 这边也准备好了
Dialogue: 0,0:21:20.67,0:21:21.14,Layzner,Elizabeth,0,0,0,,好了吗
Dialogue: 0,0:21:21.14,0:21:21.67,Layzner,Roanne,0,0,0,,是
Dialogue: 0,0:21:25.53,0:21:26.24,Layzner,Eiji,0,0,0,,你给我出去
Dialogue: 0,0:21:26.61,0:21:29.45,Layzner,David,0,0,0,,英二 不捉她当人质吗
Dialogue: 0,0:21:29.45,0:21:31.37,Layzner,Eiji,0,0,0,,我们要拿她来争取时间
Dialogue: 0,0:21:31.37,0:21:32.83,Layzner,David,0,0,0,,争取时间
Dialogue: 0,0:21:32.83,0:21:34.12,Layzner,Eiji,0,0,0,,快
Dialogue: 0,0:21:53.17,0:21:55.98,Layzner,Gale,0,0,0,,把卡露拉少尉回收 并追击地球人
Dialogue: 0,0:21:56.59,0:22:02.06,Layzner,Gale,0,0,0,,英二 我们之间的关系已经完全破裂了
Dialogue: 0,0:22:08.57,0:22:11.47,Layzner,Simone,0,0,0,,都完了 你还想演到什么时候
Dialogue: 0,0:22:11.47,0:22:14.88,Layzner,Arthur,0,0,0,,不 这次我的肚子 真的 好痛
Dialogue: 0,0:22:14.91,0:22:18.72,Layzner,Roanne,0,0,0,,弄假成真是吗 你一定太紧张了
Dialogue: 0,0:22:18.75,0:22:23.50,Layzner,David,0,0,0,,哦 拿着枪到处乱射的你也有纤细的一面啊
Dialogue: 0,0:22:23.50,0:22:25.31,Layzner,Arthur,0,0,0,,不是你想的那样啦
Dialogue: 0,0:22:25.31,0:22:26.14,Layzner,Arthur,0,0,0,,好痛
Dialogue: 0,0:22:31.55,0:22:40.31,Layzner,Anna,0,0,0,,可英二的脸上却浮现出异样的苦恼
Dialogue: 0,0:22:31.55,0:22:40.31,Layzner,Anna,0,0,0,,我们又幸运的活下来了
Dialogue: 0,0:22:41.22,0:22:48.99,Layzner,Anna,0,0,0,,就是他跟那个叫前辈的人两人切不断的深厚情谊
Dialogue: 0,0:23:54.02,0:23:57.05,Layzner,Gale,0,0,0,,我知道你一定不会原谅手上沾满你弟弟鲜血的我
Dialogue: 0,0:23:57.05,0:23:58.28,Layzner,Gale,0,0,0,,再见了 英二
Dialogue: 0,0:23:58.28,0:24:00.15,Layzner,Eiji,0,0,0,,再见了 凯利前辈
Dialogue: 0,0:24:04.08,0:24:08.50,Layzner,David,0,0,0,,下一集 变成苍之流星

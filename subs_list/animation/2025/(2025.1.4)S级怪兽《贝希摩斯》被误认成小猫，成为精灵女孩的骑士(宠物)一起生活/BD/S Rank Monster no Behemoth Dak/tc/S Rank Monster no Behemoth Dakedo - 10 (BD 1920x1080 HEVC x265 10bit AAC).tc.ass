Dialogue: 0,0:13:59.10,0:14:00.69,System,,0,0,0,,{\fad(420,0)\fs77\blur1\c&H3B3D53&\3c&H363755&\pos(964,945)}貝希摩斯 第三型態
Dialogue: 0,0:23:24.96,0:23:39.98,TitleNext,,0,0,80,,{\bord9\blur3\3c&HFFFFFF&}賢者之石與魯米魯斯的秘密
Dialogue: 1,0:23:24.96,0:23:39.98,TitleNext,,0,0,80,,賢者之石與魯米魯斯的秘密
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------PREV-------------------
Dialogue: 0,0:00:07.87,0:00:09.33,Default,,0,0,0,,完成了喵
Dialogue: 0,0:00:10.70,0:00:14.09,Default,,0,0,0,,獲得衍生技能啦
Dialogue: 0,0:00:14.79,0:00:16.58,Default,,0,0,0,,恭喜你們學會技能
Dialogue: 0,0:00:16.88,0:00:20.13,Default,,0,0,0,,我準備了珍藏的點心當作獎勵哦
Dialogue: 0,0:00:20.38,0:00:21.90,Default,,980,0,0,,太棒了
Dialogue: 0,0:00:20.38,0:00:21.90,Default,,0,240,0,,太棒了
Dialogue: 0,0:00:25.01,0:00:26.66,Default,,0,0,0,,我離開一下
Dialogue: 0,0:00:28.21,0:00:31.87,Default,,0,0,0,,斯媞拉她們成功學到新技能了
Dialogue: 0,0:00:32.81,0:00:34.30,Default,,0,0,0,,不過主人她…
Dialogue: 0,0:00:34.85,0:00:36.60,Default,,0,0,0,,麻煩再來一次
Dialogue: 0,0:00:36.86,0:00:38.36,Default,,0,0,0,,很可惜
Dialogue: 0,0:00:39.88,0:00:41.99,Default,,0,0,0,,似乎沒有那個時間了
Dialogue: 0,0:00:45.58,0:00:48.68,Default,,0,0,0,,所有人都在不同地方復活了嗎
Dialogue: 0,0:00:48.99,0:00:51.04,Default,,0,0,0,,預言中提到的兩處
Dialogue: 0,0:00:51.04,0:00:53.66,Default,,0,0,0,,已經由賽德里克跟帝國軍帶隊前往了
Dialogue: 0,0:00:54.33,0:00:55.78,Default,,0,0,0,,剩下兩個地方…
Dialogue: 0,0:00:55.96,0:00:58.08,Default,,0,0,0,,首先是阿爾弗斯王國
Dialogue: 0,0:00:59.50,0:01:00.36,Default,,0,0,0,,亞理莎
Dialogue: 0,0:01:00.64,0:01:03.09,Default,,0,0,0,,抱歉對不再戰鬥的你提這個 但…
Dialogue: 0,0:01:03.40,0:01:04.46,Default,,0,0,0,,我知道了
Dialogue: 0,0:01:05.10,0:01:06.85,Default,,0,0,0,,阿爾弗斯是我的故鄉
Dialogue: 0,0:01:06.85,0:01:08.14,Default,,0,0,0,,就由我過去吧
Dialogue: 0,0:01:09.42,0:01:10.45,Default,,0,0,0,,最後是
Dialogue: 0,0:01:11.55,0:01:13.21,Default,,0,0,0,,迷宮都市琉因
Dialogue: 0,0:01:13.39,0:01:14.42,Default,,0,0,0,,怎麼會
Dialogue: 0,0:01:15.52,0:01:17.77,Default,,0,0,0,,怎麼偏偏是琉因喵
Dialogue: 0,0:01:17.77,0:01:20.33,Default,,0,0,0,,房子才剛買啊
Dialogue: 0,0:01:26.19,0:01:27.32,Default,,0,0,0,,去保護好…
Dialogue: 0,0:01:27.78,0:01:29.38,Default,,0,0,0,,我們的城鎮吧
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------TEXT-------------------
Dialogue: 0,0:03:15.89,0:03:16.89,Default,,0,0,0,,抱歉啊
Dialogue: 0,0:03:17.44,0:03:20.10,Default,,0,0,0,,又要借助你們的力量了
Dialogue: 0,0:03:20.90,0:03:23.03,Default,,0,0,0,,我很樂意與您同行
Dialogue: 0,0:03:23.52,0:03:27.28,Default,,0,0,0,,賽德里克隊長前去討伐魔族而不在的期間
Dialogue: 0,0:03:27.28,0:03:29.16,Default,,0,0,0,,城鎮就由我等來保護
Dialogue: 0,0:03:29.16,0:03:31.16,Default,,0,0,0,,好久不見了
Dialogue: 0,0:03:31.16,0:03:34.29,Default,,0,0,0,,我們還真是有緣呢 愛莉亞
Dialogue: 0,0:03:34.53,0:03:36.81,Default,,0,0,0,,凱妮小姐 瑪麗耶塔小姐
Dialogue: 0,0:03:37.21,0:03:39.04,Default,,0,0,0,,要再請你們多多指教了
Dialogue: 0,0:03:54.53,0:03:57.43,Default,,0,0,0,,能來試試我的新武器啦
Dialogue: 0,0:03:57.93,0:04:00.69,Default,,0,0,0,,能當成是神器的實戰練習呢
Dialogue: 0,0:04:03.44,0:04:05.61,Default,,0,0,0,,要小心啊 主人
Dialogue: 0,0:04:07.32,0:04:08.03,Default,,0,0,0,,好的
Dialogue: 0,0:04:20.16,0:04:21.54,Default,,0,0,0,,好猛啊
Dialogue: 0,0:04:21.54,0:04:23.92,Default,,0,0,0,,沒用高速行動速度就那麼快
Dialogue: 0,0:04:23.92,0:04:27.25,Default,,0,0,0,,而且還兼具立體機動性
Dialogue: 0,0:04:45.15,0:04:47.64,Default,,0,0,0,,將大盾吸收的衝擊
Dialogue: 0,0:04:47.64,0:04:49.14,Default,,0,0,0,,通過大劍釋放出來嗎
Dialogue: 0,0:04:52.15,0:04:54.60,Default,,0,0,0,,「樹枝揮擊」
Dialogue: 0,0:05:01.45,0:05:03.34,Default,,0,0,0,,「妖精子彈」
Dialogue: 0,0:05:07.53,0:05:09.86,Default,,0,0,0,,釋放出的魔力跟以前天差地遠
Dialogue: 0,0:05:09.86,0:05:12.02,Default,,0,0,0,,她們已經把神器運用自如了啊
Dialogue: 0,0:05:15.97,0:05:18.85,Default,,0,0,0,,吾感覺沒有任何貢獻
Dialogue: 0,0:05:21.22,0:05:24.65,Default,,0,0,0,,大家的武器跟戰鬥風格都很相襯呀
Dialogue: 0,0:05:24.98,0:05:28.21,Default,,0,0,0,,正因為是一起旅行過的伙伴吧
Dialogue: 0,0:05:28.73,0:05:30.62,Default,,0,0,0,,不愧是芭爾坎小姐
Dialogue: 0,0:05:30.62,0:05:33.15,Default,,0,0,0,,神器工匠的手藝真了不起
Dialogue: 0,0:05:43.46,0:05:45.67,Default,,0,0,0,,敵人數量變多了
Dialogue: 0,0:05:53.76,0:05:56.77,Default,,0,0,0,,這一層居然會有巨魔變異體
Dialogue: 0,0:05:56.77,0:05:59.93,Default,,0,0,0,,朱里烏斯殿下您現在體力消耗得很快
Dialogue: 0,0:05:59.93,0:06:03.02,Default,,0,0,0,,請您將力量留下來對付魔族吧
Dialogue: 0,0:06:03.15,0:06:04.56,Default,,0,0,0,,這裡就交給我們
Dialogue: 0,0:06:04.77,0:06:07.45,Default,,0,0,0,,朱里烏斯殿下 請趕緊前進吧
Dialogue: 0,0:06:07.45,0:06:08.44,Default,,0,0,0,,交給你們了
Dialogue: 0,0:06:08.44,0:06:10.03,Default,,0,0,0,,大家 請一定要平安無事
Dialogue: 0,0:06:21.60,0:06:23.12,Default,,0,0,0,,大家停下來
Dialogue: 0,0:06:26.12,0:06:29.69,Default,,0,0,0,,這前面有股不祥的氣息
Dialogue: 0,0:06:31.34,0:06:34.30,Default,,0,0,0,,令人想全力逃離的邪氣
Dialogue: 0,0:06:35.47,0:06:37.88,Default,,0,0,0,,各位 準備好了嗎
Dialogue: 0,0:06:41.56,0:06:42.96,Default,,0,0,0,,「獅子王的加護」
Dialogue: 0,0:06:48.56,0:06:51.07,Default,,0,0,0,,球球 謝謝你
Dialogue: 0,0:07:02.95,0:07:05.21,Default,,0,0,0,,那股神聖的波動
Dialogue: 0,0:07:05.21,0:07:06.83,Default,,0,0,0,,是勇者登場了嗎
Dialogue: 0,0:07:07.83,0:07:10.00,Default,,0,0,0,,你這傢伙就是四魔族了吧
Dialogue: 0,0:07:10.71,0:07:12.09,Default,,0,0,0,,正是
Dialogue: 0,0:07:12.45,0:07:14.46,Default,,0,0,0,,我的名字是瓦沙克
Dialogue: 0,0:07:19.50,0:07:22.14,Default,,0,0,0,,侍奉魔王瑪蒙之魔族啊
Dialogue: 0,0:07:23.76,0:07:25.72,Default,,0,0,0,,我要將你討伐
Dialogue: 0,0:07:31.26,0:07:31.98,Default,,0,0,0,,出來吧
Dialogue: 0,0:07:32.29,0:07:34.86,Default,,0,0,0,,獨眼巨人 雙頭犬
Dialogue: 0,0:07:48.50,0:07:51.74,Default,,0,0,0,,將那些人撕成肉塊
Dialogue: 0,0:07:52.00,0:07:54.25,Default,,0,0,0,,他們是勇者 所以很好吃哦
Dialogue: 0,0:07:54.88,0:07:57.50,Default,,0,0,0,,我要吃 勇者
Dialogue: 0,0:07:57.50,0:07:59.88,Default,,0,0,0,,能如此幸福實在感激不盡
Dialogue: 0,0:07:59.88,0:08:03.39,Default,,0,0,0,,我一定會回應您的期待
Dialogue: 0,0:08:11.85,0:08:13.94,Default,,0,0,0,,打算轉移到魔界去嗎
Dialogue: 0,0:08:14.52,0:08:17.03,Default,,0,0,0,,再會了 勇者一行人啊
Dialogue: 0,0:08:17.82,0:08:18.99,Default,,0,0,0,,休想逃跑
Dialogue: 0,0:08:19.28,0:08:21.78,Default,,0,0,0,,鳴響吧 「王者之劍」
Dialogue: 0,0:08:27.70,0:08:29.70,Default,,0,0,0,,瓦沙克由我來解決
Dialogue: 0,0:08:30.18,0:08:32.42,Default,,0,0,0,,愛莉亞你跟球球對付雙頭犬
Dialogue: 0,0:08:32.42,0:08:33.17,Default,,0,0,0,,好的
Dialogue: 0,0:08:33.50,0:08:36.17,Default,,0,0,0,,獨眼巨人就拜託芭爾坎你們處理了
Dialogue: 0,0:08:37.80,0:08:38.67,Default,,0,0,0,,包在我們身上
Dialogue: 0,0:08:38.67,0:08:39.78,Default,,0,0,0,,好的
Dialogue: 0,0:08:40.55,0:08:41.43,Default,,0,0,0,,我要上了
Dialogue: 0,0:08:42.43,0:08:43.80,Default,,0,0,0,,「高速行動」
Dialogue: 0,0:08:44.05,0:08:45.90,Default,,0,0,0,,「地獄爪擊」
Dialogue: 0,0:08:47.55,0:08:50.07,Default,,0,0,0,,「神聖劍刃」
Dialogue: 0,0:08:54.94,0:08:56.44,Default,,0,0,0,,「水波咆哮」
Dialogue: 0,0:09:00.82,0:09:02.47,Default,,0,0,0,,竟敢弄傷本大爺
Dialogue: 0,0:09:02.70,0:09:04.28,Default,,0,0,0,,不可原諒
Dialogue: 0,0:09:07.33,0:09:09.08,Default,,0,0,0,,這招是衍生技能
Dialogue: 0,0:09:09.08,0:09:10.97,Default,,0,0,0,,「龍之力」
Dialogue: 0,0:09:21.46,0:09:22.84,Default,,0,0,0,,我們也要
Dialogue: 0,0:09:22.84,0:09:24.85,Default,,0,0,0,,使出衍生技能囉
Dialogue: 0,0:09:25.14,0:09:27.95,Default,,0,0,0,,「世界樹射擊」
Dialogue: 0,0:09:38.22,0:09:41.22,Default,,0,0,0,,好痛 好痛啊
Dialogue: 0,0:09:45.16,0:09:47.34,Default,,0,0,0,,好弱 太弱了
Dialogue: 0,0:09:48.28,0:09:50.37,Default,,0,0,0,,竟然連魔神黃昏的英雄
Dialogue: 0,0:09:50.37,0:09:52.42,Default,,0,0,0,,也衰弱到這種地步
Dialogue: 0,0:09:56.37,0:09:58.59,Default,,0,0,0,,我才不會讓你們魔族…
Dialogue: 0,0:10:00.28,0:10:02.64,Default,,0,0,0,,為所欲為
Dialogue: 0,0:10:10.63,0:10:11.97,Default,,0,0,0,,「以太飛彈」
Dialogue: 0,0:10:13.52,0:10:15.27,Default,,0,0,0,,「神聖劍刃」
Dialogue: 0,0:10:21.35,0:10:22.70,Default,,0,0,0,,還是打不倒嗎
Dialogue: 0,0:10:33.41,0:10:35.19,Default,,0,0,0,,「地獄槍術」
Dialogue: 0,0:10:37.29,0:10:39.29,Default,,0,0,0,,這兩個傢伙還真頑強
Dialogue: 0,0:10:39.88,0:10:41.12,Default,,0,0,0,,不妙
Dialogue: 0,0:10:41.12,0:10:42.48,Default,,0,0,0,,再這樣拖下去
Dialogue: 0,0:10:42.48,0:10:44.20,Default,,0,0,0,,朱里烏斯殿下的體力會…
Dialogue: 0,0:10:54.68,0:10:55.81,Default,,0,0,0,,可笑
Dialogue: 0,0:10:59.48,0:11:00.40,Default,,0,0,0,,殿下
Dialogue: 0,0:11:04.11,0:11:06.40,Default,,0,0,0,,根本不需要我出手
Dialogue: 0,0:11:06.74,0:11:08.61,Default,,0,0,0,,後續就交給你們收拾了
Dialogue: 0,0:11:08.61,0:11:10.85,Default,,0,0,0,,獨眼巨人 雙頭犬
Dialogue: 0,0:11:11.18,0:11:14.29,Default,,0,0,0,,我也授予你們魔王大人的加護吧
Dialogue: 0,0:11:19.62,0:11:22.42,Default,,0,0,0,,這裡請交給我們
Dialogue: 0,0:11:22.42,0:11:25.13,Default,,0,0,0,,請您趕緊前往魔界
Dialogue: 0,0:11:31.47,0:11:33.85,Default,,0,0,0,,那兩個體力深不見底的傢伙身上
Dialogue: 0,0:11:34.22,0:11:36.10,Default,,0,0,0,,加上了增益效果
Dialogue: 0,0:11:38.10,0:11:41.15,Default,,0,0,0,,可靠的朱里烏斯殿下也變成那樣…
Dialogue: 0,0:11:42.86,0:11:44.61,Default,,0,0,0,,大家也面露疲倦
Dialogue: 0,0:11:45.61,0:11:46.69,Default,,0,0,0,,主人也…
Dialogue: 0,0:11:49.65,0:11:51.52,Default,,0,0,0,,「地獄之針」
Dialogue: 0,0:11:57.41,0:11:58.46,Default,,0,0,0,,主人
Dialogue: 0,0:11:59.00,0:12:01.64,Default,,0,0,0,,事到如今…沒其它辦法了
Dialogue: 0,0:12:33.16,0:12:35.66,Default,,0,0,0,,這股氣息好像在哪裡…
Dialogue: 0,0:12:45.08,0:12:47.09,Default,,0,0,0,,結果復活的四魔族
Dialogue: 0,0:12:47.30,0:12:49.67,Default,,0,0,0,,是你啊 利維
Dialogue: 0,0:12:52.08,0:12:54.85,Default,,0,0,0,,好久不見了 亞理莎
Dialogue: 0,0:12:55.35,0:12:58.06,Default,,0,0,0,,這次要怎麼殺了你呢
Dialogue: 0,0:13:00.10,0:13:03.19,Default,,0,0,0,,當初人家被你殘忍地殺害
Dialogue: 0,0:13:03.19,0:13:06.36,Default,,0,0,0,,但可別以為現在的人家跟那時候一樣
Dialogue: 0,0:13:09.07,0:13:12.20,Default,,0,0,0,,人家因為魔王瑪蒙大人的加護
Dialogue: 0,0:13:12.20,0:13:14.45,Default,,0,0,0,,大幅強化了
Dialogue: 0,0:13:16.50,0:13:18.49,Default,,0,0,0,,就算是你
Dialogue: 0,0:13:18.49,0:13:21.00,Default,,0,0,0,,想打倒現在的人家也是…
Dialogue: 0,0:13:21.45,0:13:22.52,Default,,0,0,0,,不可能
Dialogue: 0,0:13:28.88,0:13:30.55,Default,,0,0,0,,我跟你一樣
Dialogue: 0,0:13:33.93,0:13:37.43,Default,,0,0,0,,也得到了主人賜予的加護
Dialogue: 0,0:13:38.96,0:13:40.47,Default,,0,0,0,,如果是這種程度
Dialogue: 0,0:13:40.96,0:13:43.27,Default,,0,0,0,,賽德里克大人那邊應該也不會有問題吧
Dialogue: 0,0:13:44.02,0:13:46.90,Default,,0,0,0,,雖然有點擔心愛莉亞他們
Dialogue: 0,0:13:47.56,0:13:49.32,Default,,0,0,0,,但有那個球球在的話…
Dialogue: 0,0:14:01.08,0:14:03.40,Default,,0,0,0,,那就是第三型態
Dialogue: 0,0:14:04.08,0:14:05.29,Default,,0,0,0,,難道說
Dialogue: 0,0:14:16.30,0:14:18.92,Default,,0,0,0,,這是聖獸嗎
Dialogue: 0,0:14:19.90,0:14:22.56,Default,,0,0,0,,那對溫柔的金色瞳孔
Dialogue: 0,0:14:23.56,0:14:26.08,Default,,0,0,0,,你是球球嗎
Dialogue: 0,0:14:27.10,0:14:28.38,Default,,0,0,0,,吾本來做好了心理準備
Dialogue: 0,0:14:28.38,0:14:30.74,Default,,0,0,0,,真實身份是貝希摩斯的事會曝光
Dialogue: 0,0:14:31.86,0:14:34.65,Default,,0,0,0,,但看來大家似乎把這個第三型態
Dialogue: 0,0:14:34.65,0:14:36.91,Default,,0,0,0,,誤認為是那所謂的聖獸了
Dialogue: 0,0:14:37.45,0:14:39.66,Default,,0,0,0,,這傢伙很危險
Dialogue: 0,0:14:39.95,0:14:41.57,Default,,0,0,0,,那頭野獸
Dialogue: 0,0:14:41.57,0:14:43.58,Default,,0,0,0,,我等無法戰勝它
Dialogue: 0,0:14:44.58,0:14:48.59,Default,,0,0,0,,瓦沙克大人 請您恕罪
Dialogue: 0,0:14:53.09,0:14:53.84,Default,,0,0,0,,怎麼了?
Dialogue: 0,0:14:55.72,0:14:58.34,Default,,0,0,0,,「獻祭槍術」
Dialogue: 0,0:14:59.68,0:15:03.64,Default,,0,0,0,,我等要拉著野獸陪葬
Dialogue: 0,0:15:04.27,0:15:05.52,Default,,0,0,0,,陪葬?
Dialogue: 0,0:15:11.11,0:15:13.11,Default,,0,0,0,,這傢伙也想做什麼嗎
Dialogue: 0,0:15:14.36,0:15:17.32,Default,,0,0,0,,你們全部…都燒成灰吧
Dialogue: 0,0:15:18.74,0:15:20.49,Default,,0,0,0,,球球 危險
Dialogue: 0,0:15:20.49,0:15:22.37,Default,,0,0,0,,「地獄火球」
Dialogue: 0,0:15:22.62,0:15:24.39,Default,,0,0,0,,「火焰咆哮」
Dialogue: 0,0:15:31.88,0:15:36.26,Default,,0,0,0,,那是以生命為代價來確保能殺害對手
Dialogue: 0,0:15:36.63,0:15:39.43,Default,,0,0,0,,無法迴避的必殺技能喵
Dialogue: 0,0:15:39.76,0:15:41.14,Default,,0,0,0,,必殺…
Dialogue: 0,0:15:46.41,0:15:48.52,Default,,0,0,0,,吾不能被那招擊中
Dialogue: 0,0:15:48.52,0:15:50.52,Default,,0,0,0,,但現在無法離開這裡…
Dialogue: 0,0:15:50.52,0:15:52.77,Default,,0,0,0,,這下就結束了
Dialogue: 0,0:15:57.27,0:15:59.53,Default,,0,0,0,,別想打倒球球
Dialogue: 0,0:16:01.03,0:16:04.16,Default,,0,0,0,,那種攻擊用神器也擋不住的喵
Dialogue: 0,0:16:04.28,0:16:05.33,Default,,0,0,0,,斯媞拉
Dialogue: 0,0:16:07.16,0:16:10.25,Default,,0,0,0,,這件事只有我才能辦到
Dialogue: 0,0:16:11.54,0:16:13.42,Default,,0,0,0,,我是強者?
Dialogue: 0,0:16:13.79,0:16:14.59,Default,,0,0,0,,沒錯
Dialogue: 0,0:16:14.88,0:16:16.65,Default,,0,0,0,,你可以不經思考
Dialogue: 0,0:16:16.65,0:16:19.36,Default,,0,0,0,,就站在遇到困難的人前面
Dialogue: 0,0:16:19.36,0:16:22.45,Default,,0,0,0,,這是只有強者才具備的精神
Dialogue: 0,0:16:30.56,0:16:33.19,Default,,0,0,0,,這件事只有強者才能辦到
Dialogue: 0,0:16:33.81,0:16:37.49,Default,,0,0,0,,「龍之{\fsp6}力·{\r}完全解放」
Dialogue: 0,0:16:42.49,0:16:43.32,Default,,0,0,0,,芭爾坎
Dialogue: 0,0:16:44.29,0:16:46.64,Default,,0,0,0,,謝謝你給我神器
Dialogue: 0,0:16:47.54,0:16:48.54,Default,,0,0,0,,莉莉 菲莉
Dialogue: 0,0:16:48.96,0:16:52.08,Default,,0,0,0,,你們要學會自己把頭髮洗乾淨啊
Dialogue: 0,0:16:53.17,0:16:54.00,Default,,0,0,0,,愛莉亞
Dialogue: 0,0:16:56.33,0:16:58.59,Default,,0,0,0,,球球就拜託你了
Dialogue: 0,0:16:58.84,0:17:00.66,Default,,0,0,0,,斯媞…拉?
Dialogue: 0,0:17:04.65,0:17:05.34,Default,,0,0,0,,球球
Dialogue: 0,0:17:06.26,0:17:09.77,Default,,0,0,0,,不管對方是魔族還是魔王 你都一定能打倒的
Dialogue: 0,0:17:10.27,0:17:11.89,Default,,0,0,0,,後面就交給你了
Dialogue: 0,0:17:11.89,0:17:13.39,Default,,0,0,0,,斯媞拉 你打算送死嗎
Dialogue: 0,0:17:13.39,0:17:14.11,Default,,0,0,0,,住手
Dialogue: 0,0:17:14.98,0:17:17.52,Default,,0,0,0,,我原本在陰暗迷宮的底層
Dialogue: 0,0:17:18.15,0:17:19.73,Default,,0,0,0,,獨自生活
Dialogue: 0,0:17:19.73,0:17:21.24,Default,,0,0,0,,並遭到球球殺害
Dialogue: 0,0:17:22.07,0:17:23.66,Default,,0,0,0,,能以人類的身份
Dialogue: 0,0:17:24.20,0:17:26.12,Default,,0,0,0,,待在球球身邊
Dialogue: 0,0:17:27.03,0:17:29.58,Default,,0,0,0,,跟大家待在一起
Dialogue: 0,0:17:31.25,0:17:33.75,Default,,0,0,0,,我覺得非常幸福
Dialogue: 0,0:17:38.25,0:17:39.40,Default,,0,0,0,,斯媞拉…
Dialogue: 0,0:17:46.42,0:17:50.22,Default,,0,0,0,,愛莉亞 你是為了什麼而戰?
Dialogue: 0,0:17:52.14,0:17:53.31,Default,,0,0,0,,我才不會…
Dialogue: 0,0:17:56.90,0:17:59.03,Default,,0,0,0,,才不會讓伙伴犧牲
Dialogue: 0,0:18:03.74,0:18:06.53,Default,,0,0,0,,「斷鋼聖劍」
Dialogue: 0,0:18:10.03,0:18:10.91,Default,,0,0,0,,這是…
Dialogue: 0,0:18:19.34,0:18:21.05,Default,,0,0,0,,就是現在
Dialogue: 0,0:18:29.85,0:18:31.12,Default,,0,0,0,,消失了…
Dialogue: 0,0:18:35.44,0:18:36.68,Default,,0,0,0,,好厲害喵
Dialogue: 0,0:18:36.68,0:18:38.65,Default,,0,0,0,,用那招技能一擊就解決了
Dialogue: 0,0:18:39.06,0:18:41.42,Default,,0,0,0,,愛莉亞好強喲
Dialogue: 0,0:18:41.81,0:18:43.32,Default,,0,0,0,,球球也很厲害呢
Dialogue: 0,0:18:44.44,0:18:45.72,Default,,0,0,0,,真了不起
Dialogue: 0,0:18:50.47,0:18:53.54,Default,,0,0,0,,竟然能在這種緊要關頭學會衍生技能
Dialogue: 0,0:18:54.16,0:18:57.64,Default,,0,0,0,,多虧主人 總算是跨越難關了
Dialogue: 0,0:19:00.79,0:19:04.01,Default,,0,0,0,,這種體內魔力在躁動的感覺
Dialogue: 0,0:19:04.48,0:19:05.47,Default,,0,0,0,,難道說…
Dialogue: 0,0:19:06.30,0:19:07.51,Default,,0,0,0,,聖獸它…
Dialogue: 0,0:19:13.06,0:19:14.02,Default,,0,0,0,,球球
Dialogue: 0,0:19:14.31,0:19:16.18,Default,,0,0,0,,變回平常的球球了喵
Dialogue: 0,0:19:22.57,0:19:24.11,Default,,0,0,0,,愛莉亞你怎麼了?
Dialogue: 0,0:19:29.24,0:19:30.99,Default,,0,0,0,,沒什麼好哭的
Dialogue: 0,0:19:30.99,0:19:33.12,Default,,0,0,0,,我還活蹦亂跳的啊
Dialogue: 0,0:19:34.37,0:19:37.09,Default,,0,0,0,,朱里烏斯殿下 您沒事嗎
Dialogue: 0,0:19:51.14,0:19:55.52,Default,,0,0,0,,獨眼巨人跟雙頭犬的連繫中斷了
Dialogue: 0,0:20:00.21,0:20:04.27,Default,,0,0,0,,沒想到會被那種程度的傢伙打倒
Dialogue: 0,0:20:06.36,0:20:07.28,Default,,0,0,0,,也罷
Dialogue: 0,0:20:07.73,0:20:10.74,Default,,0,0,0,,馬上就要迎來我等魔族的時代了
Dialogue: 0,0:20:11.19,0:20:16.37,Default,,0,0,0,,你們就盡情享受人類的餘暉吧
Dialogue: 0,0:20:21.47,0:20:23.38,Default,,0,0,0,,多虧亞理莎的奮戰
Dialogue: 0,0:20:23.99,0:20:26.07,Default,,0,0,0,,阿爾弗斯王國的四魔族
Dialogue: 0,0:20:26.07,0:20:27.71,Default,,0,0,0,,利維已經遭到討伐了
Dialogue: 0,0:20:28.01,0:20:31.26,Default,,0,0,0,,不過根據別西卜接下來的預言
Dialogue: 0,0:20:31.51,0:20:33.64,Default,,0,0,0,,瓦沙克將會在精靈村…
Dialogue: 0,0:20:34.22,0:20:37.09,Default,,0,0,0,,在魯米魯斯率領大軍現身
Dialogue: 0,0:20:37.09,0:20:38.39,Default,,0,0,0,,在魯米魯斯…
Dialogue: 0,0:20:38.76,0:20:41.77,Default,,0,0,0,,我想愛莉亞你也知道為什麼吧
Dialogue: 0,0:20:42.90,0:20:44.78,Default,,0,0,0,,是因為賢者之石嗎
Dialogue: 0,0:20:45.52,0:20:46.63,Default,,0,0,0,,賢者之石
Dialogue: 0,0:20:46.63,0:20:47.78,Default,,0,0,0,,你不知道吧
Dialogue: 0,0:20:48.66,0:20:49.74,Default,,0,0,0,,在我的故鄉
Dialogue: 0,0:20:49.74,0:20:53.20,Default,,0,0,0,,大家都說那是蘊含龐大特殊魔力的石頭
Dialogue: 0,0:20:53.46,0:20:58.77,Default,,0,0,0,,魔族似乎打算 將那股魔力使用在讓魔王復活上
Dialogue: 0,0:20:58.91,0:21:02.83,Default,,0,0,0,,這次會變成是守護賢者之石的防衛戰
Dialogue: 0,0:21:02.83,0:21:05.29,Default,,0,0,0,,戰力是越多越好
Dialogue: 0,0:21:06.29,0:21:08.18,Default,,0,0,0,,我也要一起戰鬥
Dialogue: 0,0:21:08.41,0:21:09.48,Default,,0,0,0,,我要為了故鄉
Dialogue: 0,0:21:09.48,0:21:11.42,Default,,0,0,0,,以及為了人們而戰
Dialogue: 0,0:21:11.97,0:21:14.68,Default,,0,0,0,,我可不允許讓魔王復活
Dialogue: 0,0:21:14.68,0:21:16.30,Default,,0,0,0,,我也是
Dialogue: 0,0:21:17.26,0:21:20.52,Default,,0,0,0,,我也要送瓦沙克上次的「謝禮」
Dialogue: 0,0:21:20.98,0:21:22.40,Default,,0,0,0,,我會加油喵
Dialogue: 0,0:21:22.89,0:21:26.06,Default,,0,0,0,,這將會是一場賭上世界命運的戰鬥吧
Dialogue: 0,0:21:26.54,0:21:29.40,Default,,0,0,0,,不過吾絕對會守護好主人
Dialogue: 0,0:21:33.19,0:21:34.24,Default,,0,0,0,,大家
Dialogue: 0,0:21:36.12,0:21:38.08,Default,,0,0,0,,你有一群好伙伴呢
Dialogue: 0,0:21:39.12,0:21:41.50,Default,,0,0,0,,走吧 去魯米魯斯村
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------NEXT-------------------
Dialogue: 0,0:23:25.73,0:23:27.17,Default,,0,0,0,,人家的名字是利維
Dialogue: 0,0:23:27.17,0:23:29.35,Default,,0,0,0,,是侍奉魔王瑪蒙大人的四魔族
Dialogue: 0,0:23:29.35,0:23:31.11,Default,,0,0,0,,其中美麗的一點紅
Dialogue: 0,0:23:31.44,0:23:32.38,Default,,0,0,0,,不記得了?
Dialogue: 0,0:23:32.38,0:23:34.53,Default,,0,0,0,,獨眼巨人跟雙頭犬倒是還記得?
Dialogue: 0,0:23:34.53,0:23:35.60,Default,,0,0,0,,不對 人家明明有出場啊
Dialogue: 0,0:23:35.60,0:23:37.30,Default,,0,0,0,,都讓你見識到那種模樣了
Dialogue: 0,0:23:37.30,0:23:39.49,Default,,0,0,0,,亞理莎你這家{\fsp8}伙!{\r}
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------FX-------------------

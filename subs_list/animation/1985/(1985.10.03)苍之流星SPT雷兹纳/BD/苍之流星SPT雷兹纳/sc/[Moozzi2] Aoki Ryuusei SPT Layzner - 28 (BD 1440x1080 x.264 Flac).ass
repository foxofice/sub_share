Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerTopMusic,,0,0,0,,dakishimete, kinou yori
Dialogue: 0,0:22:56.79,0:23:01.80,LayznerMusic,,0,0,0,,抱紧我
Dialogue: 0,0:23:01.80,0:23:07.11,LayznerTopMusic,,0,0,0,,aishitai hito tidak iru
Dialogue: 0,0:23:01.80,0:23:07.25,LayznerMusic,,0,0,0,,比昨天更爱你
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerTopMusic,,0,0,0,,toki ha hitoshizuku nigai namida
Dialogue: 0,0:23:07.68,0:23:16.11,LayznerMusic,,0,0,0,,时间是一滴 苦涩的泪
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerTopMusic,,0,0,0,,kizutsuita pururougu
Dialogue: 0,0:23:16.11,0:23:20.96,LayznerMusic,,0,0,0,,受伤的序曲
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerTopMusic,,0,0,0,,yasashisa e tsuzukuno yo
Dialogue: 0,0:23:21.08,0:23:26.87,LayznerMusic,,0,0,0,,继续着温柔
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerTopMusic,,0,0,0,,mayowanai futari dake no
Dialogue: 0,0:23:27.28,0:23:34.13,LayznerMusic,,0,0,0,,只为这不再迷惘的两人
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerTopMusic,,0,0,0,,LA ROSE ROUGE
Dialogue: 0,0:23:35.36,0:23:38.87,LayznerMusic,,0,0,0,,献上一曲野玫瑰之歌
Dialogue: 0,0:01:01.43,0:01:06.90,Layzner,,0,0,0,,听受到压迫的人民说 有个被称为救世主 天神再世的女孩子
Dialogue: 0,0:01:07.05,0:01:08.27,Layzner,,0,0,0,,快别干这样丢人的事了
Dialogue: 0,0:01:08.27,0:01:09.14,Layzner,,0,0,0,,那家伙是
Dialogue: 0,0:01:09.14,0:01:09.71,Layzner,,0,0,0,,那是
Dialogue: 0,0:01:59.80,0:02:05.01,Layzner,,0,0,0,,三年前的那一天 遭到压倒性的古拉特斯的力量蹂躏
Dialogue: 0,0:02:05.36,0:02:07.95,Layzner,,0,0,0,,地球上70%的都市被摧毁
Dialogue: 0,0:02:07.95,0:02:11.23,Layzner,,0,0,0,,失去了三分之一的人口
Dialogue: 0,0:02:12.30,0:02:16.65,Layzner,,0,0,0,,然后 古拉特斯在这破坏的基础上
Dialogue: 0,0:02:16.65,0:02:23.14,Layzner,,0,0,0,,实行恐怖统治 如神般君临了整个地球‘
Dialogue: 0,0:02:23.20,0:02:28.16,Layzner,,0,0,0,,库斯科的圣女
Dialogue: 0,0:02:40.19,0:02:40.93,Layzner,,0,0,0,,给我搜
Dialogue: 0,0:02:40.97,0:02:41.31,Layzner,,0,0,0,,是
Dialogue: 0,0:02:45.93,0:02:46.97,Layzner,,0,0,0,,可恶
Dialogue: 0,0:02:47.52,0:02:48.27,Layzner,,0,0,0,,不在
Dialogue: 0,0:02:49.44,0:02:50.57,Layzner,,0,0,0,,空无一人
Dialogue: 0,0:03:02.66,0:03:04.16,Layzner,,0,0,0,,安娜 抓紧点
Dialogue: 0,0:03:12.42,0:03:14.26,Layzner,,0,0,0,,锈掉了吗
Dialogue: 0,0:03:27.18,0:03:28.72,Layzner,,0,0,0,,已经没事了
Dialogue: 0,0:03:28.93,0:03:30.39,Layzner,,0,0,0,,谢谢你 大卫
Dialogue: 0,0:03:30.56,0:03:33.02,Layzner,,0,0,0,,说不定明天就轮到你救我了 道什么谢啊
Dialogue: 0,0:03:33.06,0:03:34.06,Layzner,,0,0,0,,直接开就行了吗
Dialogue: 0,0:03:34.15,0:03:37.09,Layzner,,0,0,0,,啊 我带你们去新的地下据点
Dialogue: 0,0:03:37.72,0:03:39.16,Layzner,,0,0,0,,你们先在那里避一避吧
Dialogue: 0,0:03:39.74,0:03:42.52,Layzner,,0,0,0,,我还以为我们躲在那里绝对没危险
Dialogue: 0,0:03:43.41,0:03:45.92,Layzner,,0,0,0,,是地球人去告密的吗
Dialogue: 0,0:03:46.70,0:03:47.79,Layzner,,0,0,0,,肯定是了
Dialogue: 0,0:03:48.27,0:03:51.21,Layzner,,0,0,0,,但是通知我矫正队要行动的也是地球人
Dialogue: 0,0:03:51.83,0:03:55.32,Layzner,,0,0,0,,地球人要生存下去只有这两条路了
Dialogue: 0,0:03:55.32,0:03:57.42,Layzner,,0,0,0,,真是讨厌的时代
Dialogue: 0,0:04:14.45,0:04:15.02,Layzner,,0,0,0,,就是这里了
Dialogue: 0,0:04:15.46,0:04:16.74,Layzner,,0,0,0,,暂时这里应该是安全的
Dialogue: 0,0:04:17.23,0:04:18.57,Layzner,,0,0,0,,必要的东西都备着了
Dialogue: 0,0:04:23.20,0:04:24.11,Layzner,,0,0,0,,安娜
Dialogue: 0,0:04:24.36,0:04:26.20,Layzner,,0,0,0,,马修
Dialogue: 0,0:04:27.95,0:04:29.16,Layzner,,0,0,0,,多乌啊
Dialogue: 0,0:04:31.20,0:04:34.54,Layzner,,0,0,0,,马修 你一声不响就不见了我好担心啊
Dialogue: 0,0:04:34.82,0:04:36.33,Layzner,,0,0,0,,我忘了跟你说了啊
Dialogue: 0,0:04:36.62,0:04:38.92,Layzner,,0,0,0,,我负责准备安娜的下一个隐藏地点啊
Dialogue: 0,0:04:39.09,0:04:43.67,Layzner,,0,0,0,,安娜我会好好保护的 不用担心
Dialogue: 0,0:04:43.92,0:04:46.72,Layzner,,0,0,0,,给 你的精神也用在这上面吧
Dialogue: 0,0:04:47.26,0:04:49.22,Layzner,,0,0,0,,马修 好好干吧
Dialogue: 0,0:04:49.85,0:04:51.35,Layzner,,0,0,0,,总之先进去吧
Dialogue: 0,0:04:54.48,0:04:55.23,Layzner,,0,0,0,,进来吧
Dialogue: 0,0:04:59.19,0:05:02.15,Layzner,,0,0,0,,大抵的东西都有了 要是需要什么尽管说
Dialogue: 0,0:05:02.32,0:05:03.36,Layzner,,0,0,0,,帮大忙了
Dialogue: 0,0:05:04.99,0:05:08.16,Layzner,,0,0,0,,马修 火都生好了 挺有心的嘛
Dialogue: 0,0:05:08.70,0:05:09.49,Layzner,,0,0,0,,是吧
Dialogue: 0,0:05:09.74,0:05:11.37,Layzner,,0,0,0,,英二 看什么呢
Dialogue: 0,0:05:12.64,0:05:17.83,Layzner,,0,0,0,,没什么 只是在想着画框里本来是什么画
Dialogue: 0,0:05:18.96,0:05:22.50,Layzner,,0,0,0,,天知道啊 去问抄走的矫正队吧
Dialogue: 0,0:05:25.76,0:05:29.39,Layzner,,0,0,0,,对了 差点忘了 刚才库莱斯来过
Dialogue: 0,0:05:29.43,0:05:31.51,Layzner,,0,0,0,,库莱斯吗 他说什么了
Dialogue: 0,0:05:31.60,0:05:34.52,Layzner,,0,0,0,,说是新的地下报纸编好了叫我给你
Dialogue: 0,0:05:34.77,0:05:38.06,Layzner,,0,0,0,,听说是库斯科的圣女队正向纽约来
Dialogue: 0,0:05:38.10,0:05:39.52,Layzner,,0,0,0,,库斯科的圣女队
Dialogue: 0,0:05:39.61,0:05:42.65,Layzner,,0,0,0,,好厉害 传闻是真的啊
Dialogue: 0,0:05:42.69,0:05:43.23,Layzner,,0,0,0,,啊
Dialogue: 0,0:05:43.32,0:05:45.57,Layzner,,0,0,0,,库斯科的圣女队是什么
Dialogue: 0,0:05:45.78,0:05:51.24,Layzner,,0,0,0,,听受到压迫的人民说 有个被称为救世主 天神再世的女孩子
Dialogue: 0,0:05:51.41,0:05:52.49,Layzner,,0,0,0,,天神再世
Dialogue: 0,0:05:52.62,0:05:57.00,Layzner,,0,0,0,,因为传闻是从南美的库斯科传开的 我们才这么称呼的
Dialogue: 0,0:05:57.46,0:06:00.71,Layzner,,0,0,0,,有传闻说她和她的随从正向纽约来
Dialogue: 0,0:06:00.88,0:06:02.84,Layzner,,0,0,0,,这里说传闻已经被证实了
Dialogue: 0,0:06:03.20,0:06:05.59,Layzner,,0,0,0,,简单来说就是无抵抗主义者
Dialogue: 0,0:06:05.96,0:06:06.80,Layzner,,0,0,0,,无抵抗主义
Dialogue: 0,0:06:07.05,0:06:09.22,Layzner,,0,0,0,,因为她批判古雷斯库的政策
Dialogue: 0,0:06:09.22,0:06:12.53,Layzner,,0,0,0,,提倡古拉特斯人和地球人
Dialogue: 0,0:06:12.53,0:06:14.85,Layzner,,0,0,0,,消除歧视和平共存
Dialogue: 0,0:06:14.93,0:06:16.00,Layzner,,0,0,0,,所以支持者很多
Dialogue: 0,0:06:16.23,0:06:19.77,Layzner,,0,0,0,,不持有武器 批判古雷斯库
Dialogue: 0,0:06:20.48,0:06:27.74,Layzner,,0,0,0,,所以才厉害啊 据说古雷特斯的一部分士兵也对她的理念起了共鸣
Dialogue: 0,0:06:28.40,0:06:31.45,Layzner,,0,0,0,,那个女孩子真名叫什么啊
Dialogue: 0,0:06:32.91,0:06:37.20,Layzner,,0,0,0,,哎 不知道呢 只知道叫库斯科的圣女 也没有见过
Dialogue: 0,0:06:37.29,0:06:38.66,Layzner,,0,0,0,,照片的话这里登了
Dialogue: 0,0:06:38.91,0:06:39.87,Layzner,,0,0,0,,让我看看
Dialogue: 0,0:06:47.88,0:06:49.34,Layzner,,0,0,0,,让我出去一下
Dialogue: 0,0:06:50.80,0:06:52.26,Layzner,,0,0,0,,突然这是怎么了
Dialogue: 0,0:06:55.81,0:06:57.90,Layzner,,0,0,0,,等一下啊 到底是怎么了 
Dialogue: 0,0:06:58.68,0:07:01.06,Layzner,,0,0,0,,我要亲眼看看库斯科的圣女
Dialogue: 0,0:07:01.23,0:07:02.65,Layzner,,0,0,0,,库斯科的圣女
Dialogue: 0,0:07:02.81,0:07:03.31,Layzner,,0,0,0,,是啊
Dialogue: 0,0:07:04.15,0:07:05.94,Layzner,,0,0,0,,等一下 我也一起去
Dialogue: 0,0:07:11.28,0:07:15.08,Layzner,,0,0,0,,库斯科的圣女的传闻 我也听过
Dialogue: 0,0:07:15.33,0:07:19.79,Layzner,,0,0,0,,那个库斯科的圣女和信奉者正向这里来吗
Dialogue: 0,0:07:19.87,0:07:20.29,Layzner,,0,0,0,,是
Dialogue: 0,0:07:20.46,0:07:21.50,Layzner,,0,0,0,,为了什么
Dialogue: 0,0:07:21.71,0:07:24.84,Layzner,,0,0,0,,恐怕是想向古雷斯库大人直诉吧
Dialogue: 0,0:07:24.86,0:07:27.80,Layzner,,0,0,0,,地球人和我们必须共存
Dialogue: 0,0:07:27.80,0:07:29.59,Layzner,,0,0,0,,就为了这种鬼话吗
Dialogue: 0,0:07:29.72,0:07:33.59,Layzner,,0,0,0,,恕属下直言 古拉特斯士兵中也有其支持者
Dialogue: 0,0:07:33.64,0:07:36.81,Layzner,,0,0,0,,闭嘴 这个城市现在就如
Dialogue: 0,0:07:37.35,0:07:39.84,Layzner,,0,0,0,,我们的圣地一般
Dialogue: 0,0:07:39.84,0:07:42.56,Layzner,,0,0,0,,不能让那种蛊惑人心之辈踏入一步
Dialogue: 0,0:07:43.06,0:07:44.10,Layzner,,0,0,0,,出动 基乌拉
Dialogue: 0,0:07:44.15,0:07:44.81,Layzner,,0,0,0,,是
Dialogue: 0,0:09:02.02,0:09:03.68,Layzner,,0,0,0,,不许再前进一步 
Dialogue: 0,0:09:03.81,0:09:05.39,Layzner,,0,0,0,,立刻给我回去
Dialogue: 0,0:09:05.73,0:09:08.65,Layzner,,0,0,0,,再敢前进一步 就射杀所有人
Dialogue: 0,0:09:08.86,0:09:10.32,Layzner,,0,0,0,,对方可是空手啊
Dialogue: 0,0:09:16.76,0:09:20.43,Layzner,,0,0,0,,能到达这里 这样的事应该不止遇到一次两次了
Dialogue: 0,0:09:21.13,0:09:22.24,Layzner,,0,0,0,,暂时观察情况吧
Dialogue: 0,0:09:22.33,0:09:24.08,Layzner,,0,0,0,,这里可是那些家伙的心脏要地啊
Dialogue: 0,0:09:24.29,0:09:25.08,Layzner,,0,0,0,,听我的吧
Dialogue: 0,0:09:38.72,0:09:40.47,Layzner,,0,0,0,,你没听到吗
Dialogue: 0,0:10:00.32,0:10:01.33,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:10:10.01,0:10:11.58,Layzner,,0,0,0,,你真的想归西吗
Dialogue: 0,0:10:12.49,0:10:13.87,Layzner,,0,0,0,,我会把你打成蜂窝的
Dialogue: 0,0:10:15.34,0:10:17.30,Layzner,,0,0,0,,站住 给我站住
Dialogue: 0,0:10:26.39,0:10:28.69,Layzner,,0,0,0,,开枪 不管了 杀了她
Dialogue: 0,0:10:35.23,0:10:39.24,Layzner,,0,0,0,,开枪啊 你傻愣着干什么 她不是什么天神 不过是个地球女人
Dialogue: 0,0:10:54.34,0:10:58.44,Layzner,,0,0,0,,你们这些家伙 不听我命令吗 就这么个女人都不敢杀吗
Dialogue: 0,0:10:58.83,0:11:00.51,Layzner,,0,0,0,,那女人到底是什么东西
Dialogue: 0,0:11:00.80,0:11:03.10,Layzner,,0,0,0,,喂 你小子怎么了 回答我
Dialogue: 0,0:11:03.47,0:11:06.22,Layzner,,0,0,0,,你怎么了 喂 听到了吗
Dialogue: 0,0:11:07.68,0:11:08.72,Layzner,,0,0,0,,哎 给我
Dialogue: 0,0:11:09.36,0:11:10.35,Layzner,,0,0,0,,让开
Dialogue: 0,0:11:10.85,0:11:14.64,Layzner,,0,0,0,,给我站住 我会开枪的 我会开枪的啊
Dialogue: 0,0:11:33.00,0:11:34.96,Layzner,,0,0,0,,难以置信
Dialogue: 0,0:11:55.36,0:12:00.74,Layzner,,0,0,0,,蛊惑人心的所谓圣女 我要亲自揭穿她的真面目
Dialogue: 0,0:12:10.45,0:12:11.32,Layzner,,0,0,0,,传死鬼队来
Dialogue: 0,0:13:11.64,0:13:15.10,Layzner,,0,0,0,,库斯科的圣女 你为何事而来
Dialogue: 0,0:13:15.52,0:13:18.99,Layzner,,0,0,0,,为了见古雷斯库阁下 请让开路
Dialogue: 0,0:13:19.11,0:13:22.44,Layzner,,0,0,0,,这座城市归我统治 不能让你随意通行
Dialogue: 0,0:13:26.53,0:13:31.29,Layzner,,0,0,0,,圣女什么的故事编的不错 不过我可没这么好骗
Dialogue: 0,0:13:31.37,0:13:34.54,Layzner,,0,0,0,,我就证明你不过是普通的女人
Dialogue: 0,0:13:47.97,0:13:49.47,Layzner,,0,0,0,,那家伙是
Dialogue: 0,0:13:55.02,0:13:59.15,Layzner,,0,0,0,,所谓的圣女啊 在我们的枪口下证明你的奇迹吧
Dialogue: 0,0:13:59.98,0:14:04.74,Layzner,,0,0,0,,阁下 小的
Dialogue: 0,0:14:08.24,0:14:17.82,Layzner,,0,0,0,,小的有个请求 与其要杀 请赏给小的吧 求您了
Dialogue: 0,0:14:18.17,0:14:20.25,Layzner,,0,0,0,,死鬼要圣女何用
Dialogue: 0,0:14:20.33,0:14:23.55,Layzner,,0,0,0,,小的与那女人仇深似海
Dialogue: 0,0:14:25.26,0:14:28.01,Layzner,,0,0,0,,当初把老子整的好惨
Dialogue: 0,0:14:28.89,0:14:33.22,Layzner,,0,0,0,,把圣女赐给死鬼吗 这也挺有意思的
Dialogue: 0,0:14:34.56,0:14:36.10,Layzner,,0,0,0,,退下 肮脏鼠辈
Dialogue: 0,0:14:36.27,0:14:41.69,Layzner,,0,0,0,,肮脏鼠辈 哈哈哈 当年那女人也是这么说的
Dialogue: 0,0:14:44.80,0:14:45.83,Layzner,,0,0,0,,快停下
Dialogue: 0,0:14:45.99,0:14:46.83,Layzner,,0,0,0,,滚开
Dialogue: 0,0:14:47.99,0:14:48.83,Layzner,,0,0,0,,停下
Dialogue: 0,0:14:54.99,0:14:56.08,Layzner,,0,0,0,,烦死了
Dialogue: 0,0:15:01.40,0:15:03.00,Layzner,,0,0,0,,呦 好久不见了啊
Dialogue: 0,0:15:05.40,0:15:07.00,Layzner,,0,0,0,,难道说 你是
Dialogue: 0,0:15:08.40,0:15:10.88,Layzner,,0,0,0,,你还记得真是光荣啊
Dialogue: 0,0:15:13.80,0:15:14.60,Layzner,,0,0,0,,那家伙是
Dialogue: 0,0:15:15.51,0:15:16.68,Layzner,,0,0,0,,你没事吧 
Dialogue: 0,0:15:16.85,0:15:18.02,Layzner,,0,0,0,,你退下吧
Dialogue: 0,0:15:19.94,0:15:24.32,Layzner,,0,0,0,,我这就把你这圣女整得连女人都当不了
Dialogue: 0,0:15:25.90,0:15:29.86,Layzner,,0,0,0,,摆出这种表情 别小看老子啊
Dialogue: 0,0:15:31.66,0:15:37.71,Layzner,,0,0,0,,真是眼福啊 原来如此 圣女大人吗
Dialogue: 0,0:15:39.79,0:15:44.62,Layzner,,0,0,0,,这样的话 肯定跟普通的女人不一样吧
Dialogue: 0,0:15:50.30,0:15:51.18,Layzner,,0,0,0,,住手
Dialogue: 0,0:15:53.09,0:15:55.22,Layzner,,0,0,0,,你小子是
Dialogue: 0,0:16:20.04,0:16:21.50,Layzner,,0,0,0,,去死吧
Dialogue: 0,0:16:32.22,0:16:35.84,Layzner,,0,0,0,,可恶 好痛啊
Dialogue: 0,0:16:36.01,0:16:37.64,Layzner,,0,0,0,,你还活着啊 古斯特罗 
Dialogue: 0,0:16:37.72,0:16:43.35,Layzner,,0,0,0,,还活着 是这样吗 你看这身体哪里还有活人的样子
Dialogue: 0,0:16:45.69,0:16:51.07,Layzner,,0,0,0,,英二 背叛古拉特斯之人 你以为今天还能全身而退吗 
Dialogue: 0,0:16:52.95,0:16:56.99,Layzner,,0,0,0,,鲁·凯恩 我不敢相信你是跟这种家伙一样的人
Dialogue: 0,0:16:57.16,0:16:58.33,Layzner,,0,0,0,,什么
Dialogue: 0,0:16:58.58,0:16:59.62,Layzner,,0,0,0,,你想说什么
Dialogue: 0,0:17:00.79,0:17:01.69,Layzner,,0,0,0,,打个赌吧
Dialogue: 0,0:17:03.33,0:17:05.75,Layzner,,0,0,0,,我想跟他单挑
Dialogue: 0,0:17:06.71,0:17:09.42,Layzner,,0,0,0,,跟死鬼单挑吗 要是死鬼赢了呢
Dialogue: 0,0:17:09.55,0:17:11.88,Layzner,,0,0,0,,我跟这个人都随你处置
Dialogue: 0,0:17:12.09,0:17:13.34,Layzner,,0,0,0,,要是你赢了呢
Dialogue: 0,0:17:13.92,0:17:17.39,Layzner,,0,0,0,,今后不许你动她们一根毫毛 就是这样
Dialogue: 0,0:17:25.73,0:17:30.69,Layzner,,0,0,0,,好吧 但是不许使用火器 而且必须在我能观赏到的地方进行
Dialogue: 0,0:17:32.23,0:17:33.57,Layzner,,0,0,0,,这对双方都好吧
Dialogue: 0,0:17:33.74,0:17:34.65,Layzner,,0,0,0,,明白了
Dialogue: 0,0:17:38.16,0:17:39.87,Layzner,,0,0,0,,来吧 古斯特罗 决一胜负
Dialogue: 0,0:17:41.33,0:17:43.29,Layzner,,0,0,0,,我忍不住了
Dialogue: 0,0:17:48.96,0:17:51.75,Layzner,,0,0,0,,雷 正面最右边的SPT就是对手
Dialogue: 0,0:17:53.42,0:17:54.67,Layzner,,0,0,0,,目标启动 
Dialogue: 0,0:17:54.72,0:17:56.88,Layzner,,0,0,0,,激光枪回收到背部
Dialogue: 0,0:17:56.88,0:17:58.72,Layzner,,0,0,0,,显示敌方SPT武器
Dialogue: 0,0:17:58.76,0:18:00.55,Layzner,,0,0,0,,双手装备针型突击铁拳
Dialogue: 0,0:18:00.60,0:18:02.47,Layzner,,0,0,0,,左手装备金属破坏爪
Dialogue: 0,0:18:02.51,0:18:04.64,Layzner,,0,0,0,,目前无法推测出力
Dialogue: 0,0:18:04.77,0:18:06.56,Layzner,,0,0,0,,目标开始移动
Dialogue: 0,0:18:06.89,0:18:08.56,Layzner,,0,0,0,,周围人群的避难状况如何
Dialogue: 0,0:18:08.60,0:18:11.98,Layzner,,0,0,0,,显示状况 目标急速接近
Dialogue: 0,0:18:14.15,0:18:16.03,Layzner,,0,0,0,,还是老样子那么天真啊
Dialogue: 0,0:18:19.95,0:18:21.00,Layzner,,0,0,0,,死吧
Dialogue: 0,0:18:39.43,0:18:41.47,Layzner,,0,0,0,,我要好好回敬你一下啊
Dialogue: 0,0:18:43.22,0:18:45.47,Layzner,,0,0,0,,把你骨头一根根打断
Dialogue: 0,0:19:00.28,0:19:03.20,Layzner,,0,0,0,,关节驱动部分大破 继续维持现状很危险
Dialogue: 0,0:19:03.31,0:19:05.63,Layzner,,0,0,0,,处理不同啊 出力
Dialogue: 0,0:19:06.12,0:19:07.87,Layzner,,0,0,0,,我捏死你
Dialogue: 0,0:19:07.87,0:19:08.41,Layzner,,0,0,0,,可恶
Dialogue: 0,0:19:18.76,0:19:19.63,Layzner,,0,0,0,,干掉了吗 
Dialogue: 0,0:19:19.68,0:19:22.14,Layzner,,0,0,0,,第775发现能量反应
Dialogue: 0,0:19:41.66,0:19:43.91,Layzner,,0,0,0,,老子用激光锯锯死你
Dialogue: 0,0:19:44.03,0:19:45.08,Layzner,,0,0,0,,卑鄙小人
Dialogue: 0,0:19:46.83,0:19:48.54,Layzner,,0,0,0,,我不会开枪的
Dialogue: 0,0:20:02.80,0:20:04.30,Layzner,,0,0,0,,你跑不了的
Dialogue: 0,0:20:11.69,0:20:13.60,Layzner,,0,0,0,,得想办法接近他
Dialogue: 0,0:20:15.15,0:20:17.20,Layzner,,0,0,0,,再跑圣女就归我了 
Dialogue: 0,0:20:43.13,0:20:45.44,Layzner,,0,0,0,,雷 切断拳击的能源供给
Dialogue: 0,0:20:45.59,0:20:46.35,Layzner,,0,0,0,,Ready!
Dialogue: 0,0:21:19.63,0:21:24.09,Layzner,,0,0,0,,可恶 老子杀了你
Dialogue: 0,0:21:30.01,0:21:33.35,Layzner,,0,0,0,,快别干这样丢人的事了 净给我丢脸
Dialogue: 0,0:21:35.52,0:21:36.98,Layzner,,0,0,0,,请 请饶了我
Dialogue: 0,0:21:48.33,0:21:50.08,Layzner,,0,0,0,,请饶命
Dialogue: 0,0:21:51.91,0:21:53.04,Layzner,,0,0,0,,收队
Dialogue: 0,0:22:10.39,0:22:11.01,Layzner,,0,0,0,,英二
Dialogue: 0,0:22:12.60,0:22:13.47,Layzner,,0,0,0,,姐姐
Dialogue: 0,0:22:13.64,0:22:18.85,Layzner,,0,0,0,,一切都过去了 我有必须履行的责任
Dialogue: 0,0:22:21.94,0:22:23.98,Layzner,,0,0,0,,只要人们还希望如此
Dialogue: 0,0:22:24.78,0:22:25.69,Layzner,,0,0,0,,再会吧
Dialogue: 0,0:22:32.53,0:22:33.50,Layzner,,0,0,0,,英二
Dialogue: 0,0:22:35.54,0:22:37.79,Layzner,,0,0,0,,你认识她吗
Dialogue: 0,0:22:38.96,0:22:43.75,Layzner,,0,0,0,,圣女的真名叫阿尔巴特罗·米鲁·玖丽亚·飞鸟
Dialogue: 0,0:22:44.34,0:22:50.26,Layzner,,0,0,0,,我们知道她是英二的姐姐那是很久之后的事了
Dialogue: 0,0:23:54.07,0:23:54.75,Layzner,,0,0,0,,罗安
Dialogue: 0,0:23:55.08,0:23:57.21,Layzner,,0,0,0,,我是古拉特斯忠实的仆人
Dialogue: 0,0:23:57.49,0:23:59.05,Layzner,,0,0,0,,我很生气
Dialogue: 0,0:24:00.96,0:24:03.79,Layzner,,0,0,0,,英二 你真的来了啊
Dialogue: 0,0:24:03.79,0:24:08.27,Layzner,,0,0,0,,此回 再会 迷之招待状

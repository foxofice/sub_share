Dialogue: 0,0:00:11.41,0:00:13.73,日语,,0,0,0,,艦長 我々も加勢に…
Dialogue: 0,0:00:13.73,0:00:15.59,日语,,0,0,0,,ムダだと 分かっているだろう
Dialogue: 0,0:00:16.21,0:00:18.13,日语,,0,0,0,,我々の通常兵器では
Dialogue: 0,0:00:18.13,0:00:20.57,日语,,0,0,0,,あれらにダメージを 与えることはできない
Dialogue: 0,0:00:22.13,0:00:24.89,日语,,0,0,0,,私たちは託すしかないのだ
Dialogue: 0,0:00:24.89,0:00:26.71,日语,,0,0,0,,彼ら ハンターに
Dialogue: 0,0:00:43.47,0:00:44.97,日语,,0,0,0,,各自攻撃！
Dialogue: 0,0:00:44.97,0:00:47.79,日语,,0,0,0,,ここが突破されれば 戦線が崩れるぞ！
Dialogue: 0,0:00:49.53,0:00:50.45,日语,,0,0,0,,引くな！
Dialogue: 0,0:01:04.01,0:01:05.67,日语,,0,0,0,,ダ… ダメだ
Dialogue: 0,0:01:05.67,0:01:08.35,日语,,0,0,0,,俺たちのランクじゃ こいつらに勝てない
Dialogue: 0,0:01:09.89,0:01:10.99,日语,,0,0,0,,クソッ もう
Dialogue: 0,0:01:11.31,0:01:13.59,日语,,0,0,0,,意識が…
Dialogue: 0,0:01:24.25,0:01:25.73,日语,,0,0,0,,回復魔法？
Dialogue: 0,0:01:27.95,0:01:29.27,日语,,0,0,0,,すごい
Dialogue: 0,0:01:29.27,0:01:30.61,日语,,0,0,0,,傷が一瞬で…
Dialogue: 0,0:01:31.55,0:01:33.17,日语,,0,0,0,,あっ 危ない！
Dialogue: 0,0:01:33.49,0:01:34.97,日语,,0,0,0,,美濃部(みのべ)君 伏せて！
Dialogue: 0,0:01:37.03,0:01:38.19,日语,,0,0,0,,大虎(たいが)さん！
Dialogue: 0,0:01:38.19,0:01:39.23,日语,,0,0,0,,おう！
Dialogue: 0,0:01:51.25,0:01:52.69,日语,,0,0,0,,Ｓ級だ
Dialogue: 0,0:01:52.69,0:01:54.69,日语,,0,0,0,,Ｓ級ハンターが来てくれた
Dialogue: 0,0:01:54.69,0:01:56.83,日语,,0,0,0,,突っ走り過ぎだよ 美濃部君
Dialogue: 0,0:01:57.25,0:01:58.61,日语,,0,0,0,,すみません
Dialogue: 0,0:01:58.61,0:02:00.45,日语,,0,0,0,,一人でも多く助けたくて
Dialogue: 0,0:02:00.45,0:02:01.51,日语,,0,0,0,,それに…
Dialogue: 0,0:02:01.51,0:02:04.55,日语,,0,0,0,,２人が守ってくれるって 信じてますから
Dialogue: 0,0:02:12.69,0:02:15.61,日语,,0,0,0,,ボス… ではなさそうですね
Dialogue: 0,0:02:15.61,0:02:17.89,日语,,0,0,0,,この群れのリーダーってとこだろう
Dialogue: 0,0:02:18.67,0:02:20.59,日语,,0,0,0,,剛(ごう) 負傷者を頼む
Dialogue: 0,0:02:21.11,0:02:23.23,日语,,0,0,0,,任せてくださいよ 大虎さん
Dialogue: 0,0:02:23.53,0:02:25.49,日语,,0,0,0,,いくぞ 颯樹！
Dialogue: 0,0:02:25.49,0:02:26.43,日语,,0,0,0,,了解！
Dialogue: 0,0:02:47.73,0:02:48.89,日语,,0,0,0,,うおりゃあ！
Dialogue: 0,0:02:56.81,0:02:58.19,日语,,0,0,0,,ひゅう～ バカ力(ぢから)
Dialogue: 0,0:02:58.19,0:02:59.25,日语,,0,0,0,,ああ？
Dialogue: 0,0:03:02.15,0:03:04.25,日语,,0,0,0,,リーダーでも なかったみたいですね
Dialogue: 0,0:03:04.61,0:03:06.31,日语,,0,0,0,,面白(おもしれ)え
Dialogue: 0,0:03:19.15,0:03:22.37,日语,,0,0,0,,どうやら向こう 間に合ったようですね
Dialogue: 0,0:03:25.71,0:03:26.77,日语,,0,0,0,,さて
Dialogue: 0,0:03:26.77,0:03:28.57,日语,,0,0,0,,こちらも始めましょうか
Dialogue: 0,0:03:29.25,0:03:31.33,日语,,0,0,0,,最上代表 いつでも
Dialogue: 0,0:03:31.33,0:03:32.19,日语,,0,0,0,,ええ
Dialogue: 0,0:03:46.03,0:03:48.13,日语,,0,0,0,,攻撃開始！
Dialogue: 0,0:03:53.89,0:03:55.99,日语,,0,0,0,,今から十数年前
Dialogue: 0,0:03:55.99,0:04:01.25,日语,,0,0,0,,突如として ゲートと呼ばれる異次元とこちらの世界を 結ぶ通路が出現した
Dialogue: 0,0:04:02.15,0:04:03.81,日语,,0,0,0,,ゲートの奥には
Dialogue: 0,0:04:03.81,0:04:07.19,日语,,0,0,0,,異形の怪物 モンスターが存在し
Dialogue: 0,0:04:07.19,0:04:09.53,日语,,0,0,0,,通常兵器の効かない モンスターと
Dialogue: 0,0:04:09.53,0:04:13.07,日语,,0,0,0,,闘うことのできる 能力に覚醒した者たちを
Dialogue: 0,0:04:13.71,0:04:15.31,日语,,0,0,0,,ハンターと呼んだ
Dialogue: 0,0:04:15.81,0:04:19.03,日语,,0,0,0,,ハンターは体内に有する 魔力量によって
Dialogue: 0,0:04:19.03,0:04:26.47,日语,,0,0,0,,Ｓ級 Ａ級 Ｂ級 Ｃ級 Ｄ級 Ｅ級に ランク分けされる
Dialogue: 0,0:04:27.51,0:04:32.49,日语,,0,0,0,,しかし 一度 覚醒した者は本人が どれだけ 努力しようとも
Dialogue: 0,0:04:33.09,0:04:35.96,日语,,0,0,0,,その能力が 成長することはない
Dialogue: 0,0:04:59.63,0:05:01.81,日语,,0,0,0,,今日のレイドも頑張ってください
Dialogue: 0,0:05:01.81,0:05:02.83,日语,,0,0,0,,サンキュ
Dialogue: 0,0:05:03.77,0:05:05.73,日语,,0,0,0,,お～い 真島さん！
Dialogue: 0,0:05:06.21,0:05:07.45,日语,,0,0,0,,お久っ
Dialogue: 0,0:05:07.45,0:05:08.37,日语,,0,0,0,,あれ？
Dialogue: 0,0:05:08.67,0:05:10.83,日语,,0,0,0,,久我さんじゃん どうしたの
Dialogue: 0,0:05:10.83,0:05:13.31,日语,,0,0,0,,もうハンターなんか御免だ って言ってたくせに
Dialogue: 0,0:05:14.77,0:05:17.03,日语,,0,0,0,,エヘヘッ 嫁が２人目 妊娠してさ
Dialogue: 0,0:05:17.03,0:05:18.17,日语,,0,0,0,,あ～
Dialogue: 0,0:05:18.17,0:05:21.31,日语,,0,0,0,,レイドなら うまくすりゃ がっぽり稼げるもんな
Dialogue: 0,0:05:22.23,0:05:23.65,日语,,0,0,0,,ハア… でも 不安だよ
Dialogue: 0,0:05:23.65,0:05:26.67,日语,,0,0,0,,かなりのブランクだから 体がついてくるのやら
Dialogue: 0,0:05:26.67,0:05:28.43,日语,,0,0,0,,ただでさえ弱いのに
Dialogue: 0,0:05:28.43,0:05:30.85,日语,,0,0,0,,あれ？　水篠(みずしの)君じゃん
Dialogue: 0,0:05:30.85,0:05:32.83,日语,,0,0,0,,水篠君 おっす～
Dialogue: 0,0:05:32.83,0:05:34.75,日语,,0,0,0,,寒いのにお疲れさま
Dialogue: 0,0:05:36.87,0:05:38.93,日语,,0,0,0,,今日も よろしくお願いします
Dialogue: 0,0:05:38.93,0:05:41.09,日语,,0,0,0,,お～い 水篠君
Dialogue: 0,0:05:41.09,0:05:42.87,日语,,0,0,0,,メシはちゃんと食ってきたか？
Dialogue: 0,0:05:43.25,0:05:45.83,日语,,0,0,0,,はい しっかり食べてきました
Dialogue: 0,0:05:46.65,0:05:48.83,日语,,0,0,0,,誰 あれ？　強いの？
Dialogue: 0,0:05:48.83,0:05:50.63,日语,,0,0,0,,みんな挨拶しちゃってさ
Dialogue: 0,0:05:51.77,0:05:53.43,日语,,0,0,0,,ククッ 逆だよ 逆
Dialogue: 0,0:05:53.43,0:05:55.59,日语,,0,0,0,,久我さんが辞めたあとに入ってきたんだけど
Dialogue: 0,0:05:55.59,0:05:59.67,日语,,0,0,0,,あの にいちゃんは 別名“人類最弱兵器”なんだ
Dialogue: 0,0:06:00.03,0:06:02.55,日语,,0,0,0,,最弱？　最強じゃなくて？
Dialogue: 0,0:06:02.55,0:06:03.47,日语,,0,0,0,,ああ
Dialogue: 0,0:06:03.47,0:06:06.55,日语,,0,0,0,,Ｅ級ゲートでケガして 入院するくらいだからな
Dialogue: 0,0:06:06.97,0:06:09.53,日语,,0,0,0,,ハンターの中で 一番弱いんじゃないか？
Dialogue: 0,0:06:09.53,0:06:12.21,日语,,0,0,0,,一番弱い？　そこまでなのか
Dialogue: 0,0:06:12.21,0:06:16.15,日语,,0,0,0,,だから あの おにいちゃんが 呼ばれたレイドは 低級だと思えばいい
Dialogue: 0,0:06:16.15,0:06:17.75,日语,,0,0,0,,なるほどな～
Dialogue: 0,0:06:17.75,0:06:19.17,日语,,0,0,0,,聞こえたら困るから
Dialogue: 0,0:06:19.17,0:06:21.35,日语,,0,0,0,,説明はここまでにするとして…
Dialogue: 0,0:06:22.29,0:06:24.81,日语,,0,0,0,,全部聞こえてましたから
Dialogue: 0,0:06:24.81,0:06:25.91,日语,,0,0,0,,まあ
Dialogue: 0,0:06:25.91,0:06:28.93,日语,,0,0,0,,ホントのことだから 言い返すこともできないけど
Dialogue: 0,0:06:28.93,0:06:31.65,日语,,0,0,0,,やだ 水篠さん またケガしてる
Dialogue: 0,0:06:32.31,0:06:33.49,日语,,0,0,0,,観月さん
Dialogue: 0,0:06:33.49,0:06:35.15,日语,,0,0,0,,また一緒になりましたね
Dialogue: 0,0:06:35.83,0:06:38.95,日语,,0,0,0,,そんなことより なんですか？　その顔の傷
Dialogue: 0,0:06:38.95,0:06:41.89,日语,,0,0,0,,まあ いつもみたいに… ね？
Dialogue: 0,0:06:43.09,0:06:45.37,日语,,0,0,0,,ホント 気をつけてくださいよ
Dialogue: 0,0:06:46.57,0:06:48.87,日语,,0,0,0,,入院まで したらしいじゃないですか
Dialogue: 0,0:06:48.87,0:06:51.35,日语,,0,0,0,,Ｅ級ダンジョンで俺だけケガして…
Dialogue: 0,0:06:51.35,0:06:53.65,日语,,0,0,0,,えっ？　それじゃ ヒーラーに…
Dialogue: 0,0:06:54.21,0:06:59.15,日语,,0,0,0,,{\fs55}ほかの人たちはランクが高かったから ヒーラーを 最初から呼んでなかったんです
Dialogue: 0,0:06:59.15,0:07:00.45,日语,,0,0,0,,何それ！
Dialogue: 0,0:07:00.45,0:07:02.65,日语,,0,0,0,,自分たちが平気だからって ひどい
Dialogue: 0,0:07:02.65,0:07:05.51,日语,,0,0,0,,いいんです 俺が弱すぎるだけですし
Dialogue: 0,0:07:06.05,0:07:08.31,日语,,0,0,0,,観月さんだって よくご存じでしょう？
Dialogue: 0,0:07:08.69,0:07:10.05,日语,,0,0,0,,もう慣れてますから
Dialogue: 0,0:07:12.37,0:07:14.33,日语,,0,0,0,,もう中に入るみたいですね
Dialogue: 0,0:07:14.33,0:07:15.71,日语,,0,0,0,,行きましょう
Dialogue: 0,0:07:16.69,0:07:17.89,日语,,0,0,0,,僭越(せんえつ)ながら
Dialogue: 0,0:07:17.89,0:07:20.89,日语,,0,0,0,,今回のレイドでリーダーを務めさせていただきます
Dialogue: 0,0:07:20.89,0:07:22.49,日语,,0,0,0,,馬渕 勲(いさお)です
Dialogue: 0,0:07:22.49,0:07:24.15,日语,,0,0,0,,よろしくお願いします
Dialogue: 0,0:07:24.15,0:07:25.97,日语,,0,0,0,,まっ 当然だよな
Dialogue: 0,0:07:25.97,0:07:29.07,日语,,0,0,0,,この中で 一番の実力者が馬渕さんだ
Dialogue: 0,0:07:29.07,0:07:30.99,日语,,0,0,0,,安心して任せられる
Dialogue: 0,0:07:31.47,0:07:33.83,日语,,0,0,0,,よろしくお願いします 馬渕さん
Dialogue: 0,0:07:33.83,0:07:34.95,日语,,0,0,0,,うん
Dialogue: 0,0:07:34.95,0:07:37.13,日语,,0,0,0,,さあ 準備はいいですか？
Dialogue: 0,0:07:37.13,0:07:38.39,日语,,0,0,0,,潜りましょう
Dialogue: 0,0:07:43.67,0:07:44.77,日语,,0,0,0,,水篠君
Dialogue: 0,0:07:46.19,0:07:49.11,日语,,0,0,0,,俺らの後ろで ケガしないように粘ってろよ
Dialogue: 0,0:07:50.17,0:07:51.17,日语,,0,0,0,,はい
Dialogue: 0,0:07:51.17,0:07:53.33,日语,,0,0,0,,それじゃ 頑張りましょうね
Dialogue: 0,0:07:56.47,0:07:59.29,日语,,0,0,0,,ほんの少ししか魔力の込められてないナイフ
Dialogue: 0,0:08:00.05,0:08:03.03,日语,,0,0,0,,俺の収入じゃ これを買うのが 精いっぱいだったけど
Dialogue: 0,0:08:03.65,0:08:05.09,日语,,0,0,0,,ないよりマシ
Dialogue: 0,0:08:08.29,0:08:10.07,日语,,0,0,0,,今日こそは やってやるぞ
Dialogue: 0,0:08:19.39,0:08:21.65,日语,,0,0,0,,お疲れさまでした 後藤(ごとう)会長
Dialogue: 0,0:08:22.47,0:08:24.43,日语,,0,0,0,,政府との会談は いかがでしたか？
Dialogue: 0,0:08:25.15,0:08:27.91,日语,,0,0,0,,彼らの言うことは いつも同じだよ
Dialogue: 0,0:08:27.91,0:08:29.83,日语,,0,0,0,,ダンジョンブレイクは困る
Dialogue: 0,0:08:29.83,0:08:33.99,日语,,0,0,0,,しかし ダンジョンから得られる物資の安定的な供給は求める
Dialogue: 0,0:08:35.69,0:08:38.99,日语,,0,0,0,,彼らの要求は 何も間違ってはいない
Dialogue: 0,0:08:38.99,0:08:44.47,日语,,0,0,0,,{\fs50}我々ハンターは ダンジョンで得られる物資を売りそれを生業(なりわい)にしている人間だ
Dialogue: 0,0:08:49.55,0:08:52.73,日语,,0,0,0,,倒したモンスターから出てくる結晶体
Dialogue: 0,0:08:52.73,0:08:54.31,日语,,0,0,0,,この魔法石は
Dialogue: 0,0:08:54.75,0:08:55.75,日语,,0,0,0,,カネになる
Dialogue: 0,0:09:02.33,0:09:03.39,日语,,0,0,0,,やった
Dialogue: 0,0:09:03.87,0:09:05.57,日语,,0,0,0,,ようやく１個目
Dialogue: 0,0:09:05.57,0:09:06.61,日语,,0,0,0,,水篠さん！
Dialogue: 0,0:09:21.31,0:09:22.45,日语,,0,0,0,,水篠さん！
Dialogue: 0,0:09:22.45,0:09:24.01,日语,,0,0,0,,観月ちゃんは下がって！
Dialogue: 0,0:09:24.01,0:09:25.29,日语,,0,0,0,,うりゃあ！
Dialogue: 0,0:09:29.01,0:09:30.67,日语,,0,0,0,,俺は次のモンスターにいく
Dialogue: 0,0:09:31.17,0:09:32.91,日语,,0,0,0,,観月ちゃんは水篠君を
Dialogue: 0,0:09:32.91,0:09:34.37,日语,,0,0,0,,は… はい！
Dialogue: 0,0:09:36.39,0:09:38.23,日语,,0,0,0,,もう大丈夫ですからね
Dialogue: 0,0:09:38.23,0:09:40.07,日语,,0,0,0,,私が必ず治します
Dialogue: 0,0:09:56.67,0:10:00.67,日语,,0,0,0,,ランクの高いモンスターから出てきた魔法石は
Dialogue: 0,0:10:00.67,0:10:06.35,日语,,0,0,0,,{\fs55}モンスターを倒すためのより強力な武器や防具に 生まれ変わらせることも可能だ
Dialogue: 0,0:10:06.93,0:10:11.53,日语,,0,0,0,,ダンジョンから採掘されるマナ鉱石も同様の使い方ができるが
Dialogue: 0,0:10:11.53,0:10:14.31,日语,,0,0,0,,魔法石に比べて効果は低い
Dialogue: 0,0:10:14.31,0:10:16.99,日语,,0,0,0,,しかし 政府の求める使い道は…
Dialogue: 0,0:10:17.69,0:10:20.19,日语,,0,0,0,,新しいエネルギー源としてだ
Dialogue: 0,0:10:21.27,0:10:23.19,日语,,0,0,0,,原子力よりも安全で
Dialogue: 0,0:10:23.19,0:10:26.45,日语,,0,0,0,,水力 風力 地熱よりも効率が良く
Dialogue: 0,0:10:26.45,0:10:29.17,日语,,0,0,0,,火力のように 大気を汚すこともない
Dialogue: 0,0:10:30.07,0:10:32.33,日语,,0,0,0,,理想的なクリーンエネルギー
Dialogue: 0,0:10:32.79,0:10:37.57,日语,,0,0,0,,政府もマナ鉱石や魔法石による 発電方式を推進している
Dialogue: 0,0:10:37.57,0:10:40.43,日语,,0,0,0,,ハンターしか 得ることのできない希少資源
Dialogue: 0,0:10:41.21,0:10:44.79,日语,,0,0,0,,だからこそ ハンターの担う役目は 大きいのだ
Dialogue: 0,0:10:52.11,0:10:53.37,日语,,0,0,0,,-やった～ -やった
Dialogue: 0,0:10:53.37,0:10:55.13,日语,,0,0,0,,ダンジョンボスを倒した！
Dialogue: 0,0:10:55.13,0:10:56.63,日语,,0,0,0,,-よし -さすが馬渕さん！
Dialogue: 0,0:10:57.07,0:10:58.57,日语,,0,0,0,,-やりましたね！ -YES！
Dialogue: 0,0:10:59.65,0:11:00.79,日语,,0,0,0,,水篠さん…
Dialogue: 0,0:11:00.79,0:11:04.21,日语,,0,0,0,,まさか 意地張ってハンターを 続けてるんじゃないですよね？
Dialogue: 0,0:11:04.97,0:11:08.33,日语,,0,0,0,,このままだと いつか ホントに大ごとになっちゃいますよ
Dialogue: 0,0:11:08.73,0:11:10.13,日语,,0,0,0,,おなかだけじゃなくて
Dialogue: 0,0:11:10.13,0:11:12.37,日语,,0,0,0,,体中 こんなにケガして
Dialogue: 0,0:11:12.37,0:11:13.41,日语,,0,0,0,,すみません
Dialogue: 0,0:11:13.41,0:11:15.83,日语,,0,0,0,,謝ってほしくて言ってるんじゃありません！
Dialogue: 0,0:11:15.83,0:11:17.53,日语,,0,0,0,,心配なんです
Dialogue: 0,0:11:23.27,0:11:26.15,日语,,0,0,0,,みんな 戦利品の回収 できたか？
Dialogue: 0,0:11:26.15,0:11:28.69,日语,,0,0,0,,ある程度は回収できたけどよ
Dialogue: 0,0:11:28.69,0:11:31.43,日语,,0,0,0,,ここは マナ鉱石の鉱脈も少なくて
Dialogue: 0,0:11:31.43,0:11:34.25,日语,,0,0,0,,収入的には全然 物足りないな
Dialogue: 0,0:11:35.23,0:11:36.81,日语,,0,0,0,,終わっちゃったか…
Dialogue: 0,0:11:37.81,0:11:41.51,日语,,0,0,0,,俺が手にしたのは このＥ級の魔法石１個のみ
Dialogue: 0,0:11:42.49,0:11:44.83,日语,,0,0,0,,死にかけたのに 割に合わないな
Dialogue: 0,0:11:46.69,0:11:48.57,日语,,0,0,0,,お～い！
Dialogue: 0,0:11:48.57,0:11:50.29,日语,,0,0,0,,こっち来てくれ！
Dialogue: 0,0:11:50.97,0:11:51.85,日语,,0,0,0,,洞窟？
Dialogue: 0,0:11:51.85,0:11:53.05,日语,,0,0,0,,地下道？
Dialogue: 0,0:11:53.05,0:11:55.93,日语,,0,0,0,,ずっと奥まで続いてるみたいだ
Dialogue: 0,0:11:55.93,0:11:57.95,日语,,0,0,0,,二重ダンジョンか
Dialogue: 0,0:11:57.95,0:11:59.93,日语,,0,0,0,,話には聞いていたが…
Dialogue: 0,0:11:59.93,0:12:03.99,日语,,0,0,0,,ダンジョンボスを倒したのに ダンジョンの閉じる気配がないから…
Dialogue: 0,0:12:03.99,0:12:06.67,日语,,0,0,0,,うん おかしいなって思ってた
Dialogue: 0,0:12:06.67,0:12:07.87,日语,,0,0,0,,ってことは…
Dialogue: 0,0:12:07.87,0:12:08.99,日语,,0,0,0,,ああ
Dialogue: 0,0:12:08.99,0:12:11.23,日语,,0,0,0,,この奥に まだ獲物がいるってことだ
Dialogue: 0,0:12:11.69,0:12:13.35,日语,,0,0,0,,みんな 聞いてくれ！
Dialogue: 0,0:12:13.79,0:12:16.19,日语,,0,0,0,,こういう不測の事態が起きた場合
Dialogue: 0,0:12:16.19,0:12:19.37,日语,,0,0,0,,ハンター協会の指示を仰ぐのが通例になっている
Dialogue: 0,0:12:19.73,0:12:21.77,日语,,0,0,0,,ちょっと待ってくれよ 馬渕さん
Dialogue: 0,0:12:21.77,0:12:25.21,日语,,0,0,0,,それって あとから来るヤツが おいしいとこ 持ってくってこと？
Dialogue: 0,0:12:25.67,0:12:29.25,日语,,0,0,0,,同じＤ級ダンジョンなんだし 問題ないでしょ
Dialogue: 0,0:12:29.25,0:12:31.35,日语,,0,0,0,,こいつは２人目が生まれるんだ
Dialogue: 0,0:12:31.35,0:12:33.09,日语,,0,0,0,,マナ鉱石も少なかった
Dialogue: 0,0:12:33.65,0:12:36.53,日语,,0,0,0,,少しは融通してくれても… ねえ？
Dialogue: 0,0:12:36.53,0:12:37.83,日语,,0,0,0,,ダメっすか？
Dialogue: 0,0:12:37.83,0:12:39.71,日语,,0,0,0,,気持ちは理解できる
Dialogue: 0,0:12:39.71,0:12:41.99,日语,,0,0,0,,だが 危険を伴うことも事実だ
Dialogue: 0,0:12:42.69,0:12:44.13,日语,,0,0,0,,多数決を採ろう
Dialogue: 0,0:12:44.13,0:12:45.19,日语,,0,0,0,,俺は ちょっと
Dialogue: 0,0:12:45.19,0:12:46.21,日语,,0,0,0,,行きましょう
Dialogue: 0,0:12:46.21,0:12:47.55,日语,,0,0,0,,反対で～す
Dialogue: 0,0:12:47.55,0:12:48.45,日语,,0,0,0,,反対
Dialogue: 0,0:12:48.45,0:12:49.83,日语,,0,0,0,,行ってみよっかな
Dialogue: 0,0:12:49.83,0:12:50.55,日语,,0,0,0,,俺も
Dialogue: 0,0:12:50.55,0:12:51.35,日语,,0,0,0,,うん
Dialogue: 0,0:12:51.35,0:12:52.63,日语,,0,0,0,,やめておきましょう
Dialogue: 0,0:12:53.11,0:12:54.29,日语,,0,0,0,,俺は行く
Dialogue: 0,0:12:54.29,0:12:55.35,日语,,0,0,0,,当然
Dialogue: 0,0:12:55.35,0:12:58.29,日语,,0,0,0,,すみませんが 行きたくありません
Dialogue: 0,0:12:58.29,0:12:59.37,日语,,0,0,0,,ふむ…
Dialogue: 0,0:12:59.37,0:13:01.83,日语,,0,0,0,,これで賛成６ 反対６か
Dialogue: 0,0:13:02.37,0:13:03.93,日语,,0,0,0,,残るは水篠君だけだが
Dialogue: 0,0:13:03.93,0:13:05.17,日语,,0,0,0,,君はどうする？
Dialogue: 0,0:13:05.17,0:13:06.69,日语,,0,0,0,,お… 俺は…
Dialogue: 0,0:13:08.11,0:13:12.27,日语,,0,0,0,,俺にとって Ｄ級ダンジョンでも 危険だってことは 百も承知してる
Dialogue: 0,0:13:13.13,0:13:14.07,日语,,0,0,0,,だけど…
Dialogue: 0,0:13:14.65,0:13:16.13,日语,,0,0,0,,父さんが失踪して
Dialogue: 0,0:13:16.13,0:13:18.51,日语,,0,0,0,,家族の中で働けるのは俺だけ
Dialogue: 0,0:13:19.15,0:13:20.83,日语,,0,0,0,,母さんの治療費がいる
Dialogue: 0,0:13:20.83,0:13:23.01,日语,,0,0,0,,大学受験を控えた妹もいる
Dialogue: 0,0:13:23.85,0:13:26.59,日语,,0,0,0,,俺にはカネがいるんだ！
Dialogue: 0,0:13:27.79,0:13:28.81,日语,,0,0,0,,行きます！
Dialogue: 0,0:13:35.81,0:13:39.05,日语,,0,0,0,,では その黒い水晶に 片手で触れてください
Dialogue: 0,0:13:45.77,0:13:47.71,日语,,0,0,0,,次の方 どうぞ
Dialogue: 0,0:13:51.25,0:13:52.99,日语,,0,0,0,,あなた Ｃ級ですか
Dialogue: 0,0:13:52.99,0:13:54.59,日语,,0,0,0,,ぜひ うちのギルドに
Dialogue: 0,0:13:54.59,0:13:57.81,日语,,0,0,0,,わたくしどもの契約条件は こちらになっています
Dialogue: 0,0:13:57.81,0:14:01.47,日语,,0,0,0,,労働条件はこちら 契約料は年間契約で…
Dialogue: 0,0:14:02.91,0:14:08.79,日语,,0,0,0,,はい Ｂ級１人 Ｃ級２人から契約の内諾を取り付けることができました
Dialogue: 0,0:14:08.79,0:14:11.21,日语,,0,0,0,,今のところ順調です 最上代表
Dialogue: 0,0:14:11.21,0:14:13.11,日语,,0,0,0,,それは すばらしい
Dialogue: 0,0:14:13.11,0:14:14.81,日语,,0,0,0,,老若男女を問わず
Dialogue: 0,0:14:14.81,0:14:18.07,日语,,0,0,0,,有望そうな方には 声をかけてください
Dialogue: 0,0:14:18.07,0:14:23.35,日语,,0,0,0,,{\fs50}もっとも うちの 向坂(こうさか)雫(しずく)を超える人材はそうそう現れると思えませんが
Dialogue: 0,0:14:25.49,0:14:27.21,日语,,0,0,0,,誰か 捕まえて！
Dialogue: 0,0:14:27.21,0:14:28.47,日语,,0,0,0,,どけどけ～！
Dialogue: 0,0:14:32.95,0:14:35.27,日语,,0,0,0,,どけよ！ 吹っ飛ばされてえのか！
Dialogue: 0,0:14:57.27,0:14:58.63,日语,,0,0,0,,あ… あの！
Dialogue: 0,0:14:58.63,0:14:59.47,日语,,0,0,0,,はい
Dialogue: 0,0:14:59.89,0:15:00.99,日语,,0,0,0,,ありがとうございます
Dialogue: 0,0:15:00.99,0:15:02.47,日语,,0,0,0,,-向坂 雫！ -ありがとうございます！
Dialogue: 0,0:15:02.47,0:15:03.51,日语,,0,0,0,,向坂 雫！
Dialogue: 0,0:15:03.51,0:15:04.91,日语,,0,0,0,,Ｓ級ハンターの！
Dialogue: 0,0:15:04.91,0:15:06.63,日语,,0,0,0,,-スゲえ！ -本物だ
Dialogue: 0,0:15:06.63,0:15:07.65,日语,,0,0,0,,かわいい！
Dialogue: 0,0:15:07.65,0:15:09.07,日语,,0,0,0,,- ファンなんです  - あ… あの
Dialogue: 0,0:15:09.07,0:15:10.33,日语,,0,0,0,,-握手して下さい -えつと…
Dialogue: 0,0:15:16.57,0:15:17.69,日语,,0,0,0,,スッゲえ
Dialogue: 0,0:15:17.69,0:15:19.39,日语,,0,0,0,,さすがＳ級ハンター
Dialogue: 0,0:15:22.39,0:15:24.87,日语,,0,0,0,,洞窟に入って どれくらい歩いた？
Dialogue: 0,0:15:24.87,0:15:26.75,日语,,0,0,0,,40分くらいかな
Dialogue: 0,0:15:26.75,0:15:29.67,日语,,0,0,0,,ボスを倒すと１時間後にゲートが封鎖されるから
Dialogue: 0,0:15:29.67,0:15:31.33,日语,,0,0,0,,20分 余裕があるな
Dialogue: 0,0:15:31.91,0:15:34.01,日语,,0,0,0,,あの すみません…
Dialogue: 0,0:15:34.01,0:15:35.61,日语,,0,0,0,,何がですか？
Dialogue: 0,0:15:35.61,0:15:39.71,日语,,0,0,0,,俺が賛成したせいで ボスを探しに行くことになっちゃったから
Dialogue: 0,0:15:39.71,0:15:41.73,日语,,0,0,0,,私なら大丈夫なので
Dialogue: 0,0:15:41.73,0:15:43.31,日语,,0,0,0,,気にしないでください
Dialogue: 0,0:15:43.31,0:15:45.63,日语,,0,0,0,,ホントに大丈夫ですか？
Dialogue: 0,0:15:46.27,0:15:48.03,日语,,0,0,0,,ホントに大丈夫
Dialogue: 0,0:15:48.03,0:15:49.83,日语,,0,0,0,,…なわけないでしょ！
Dialogue: 0,0:15:49.83,0:15:51.47,日语,,0,0,0,,もう忘れたんですか？
Dialogue: 0,0:15:51.47,0:15:55.59,日语,,0,0,0,,水篠さん さっき もう少し上を 刺されてたら死んでたんですよ？
Dialogue: 0,0:15:55.59,0:15:59.15,日语,,0,0,0,,腕と脚だって 私が かろうじて治療したっていうのに
Dialogue: 0,0:15:59.15,0:16:00.83,日语,,0,0,0,,正気じゃないわ！
Dialogue: 0,0:16:00.83,0:16:02.69,日语,,0,0,0,,頭でも ぶつけたんじゃないですか
Dialogue: 0,0:16:02.69,0:16:03.91,日语,,0,0,0,,そうなんでしょ！
Dialogue: 0,0:16:04.35,0:16:05.79,日语,,0,0,0,,すみません…
Dialogue: 0,0:16:06.29,0:16:07.35,日语,,0,0,0,,確かに
Dialogue: 0,0:16:07.35,0:16:11.19,日语,,0,0,0,,Ｂ級ヒーラーの 観月さんのおかげで いつも命拾いしてきたんだよな
Dialogue: 0,0:16:11.61,0:16:13.83,日语,,0,0,0,,ホントに反省してます？
Dialogue: 0,0:16:13.83,0:16:14.77,日语,,0,0,0,,はい
Dialogue: 0,0:16:16.49,0:16:21.13,日语,,0,0,0,,それなら 今度 おわびに何か ごちそうになっちゃおっかな？
Dialogue: 0,0:16:21.13,0:16:22.13,日语,,0,0,0,,へっ？
Dialogue: 0,0:16:22.13,0:16:25.53,日语,,0,0,0,,何よ 私と食事に行くのは嫌なんですか？
Dialogue: 0,0:16:25.53,0:16:27.67,日语,,0,0,0,,いい… いえ そんな まさか！
Dialogue: 0,0:16:27.67,0:16:28.69,日语,,0,0,0,,着いたぞ
Dialogue: 0,0:16:28.69,0:16:29.99,日语,,0,0,0,,ボスの部屋だ！
Dialogue: 0,0:16:32.89,0:16:35.83,日语,,0,0,0,,扉のある部屋って また珍しいな
Dialogue: 0,0:16:35.83,0:16:37.49,日语,,0,0,0,,なんか ヤバそう
Dialogue: 0,0:16:37.49,0:16:38.37,日语,,0,0,0,,うん
Dialogue: 0,0:16:38.85,0:16:40.01,日语,,0,0,0,,俺は行くぞ
Dialogue: 0,0:16:40.01,0:16:41.95,日语,,0,0,0,,ここまで来て 手ぶらで帰れるか
Dialogue: 0,0:16:41.95,0:16:43.77,日语,,0,0,0,,おう 俺も行く
Dialogue: 0,0:16:44.47,0:16:46.71,日语,,0,0,0,,チーム全員で先に進む
Dialogue: 0,0:16:46.71,0:16:49.59,日语,,0,0,0,,そう決めたはずですよね？馬渕リーダー
Dialogue: 0,0:16:50.43,0:16:52.01,日语,,0,0,0,,ああ そうだ
Dialogue: 0,0:16:55.97,0:16:58.37,日语,,0,0,0,,新たな覚醒者の皆さん 
Dialogue: 0,0:16:58.37,0:17:01.67,日语,,0,0,0,,ハンター協会会長 後藤清臣(きよおみ)です
Dialogue: 0,0:17:01.67,0:17:03.27,日语,,0,0,0,,皆さんの中には
Dialogue: 0,0:17:03.27,0:17:08.85,日语,,0,0,0,,{\fs50}今後 ハンターになられる方も あえて その道を選ばれない方も いらっしゃるでしょう
Dialogue: 0,0:17:08.85,0:17:11.27,日语,,0,0,0,,ゲートが出現してから十数年
Dialogue: 0,0:17:11.27,0:17:14.19,日语,,0,0,0,,いまだ ダンジョンの中は 不明なことが多い
Dialogue: 0,0:17:14.19,0:17:16.69,日语,,0,0,0,,ハンターは命懸けの職業です
Dialogue: 0,0:17:16.69,0:17:18.59,日语,,0,0,0,,レイドに慣れてきたとしても
Dialogue: 0,0:17:18.59,0:17:20.61,日语,,0,0,0,,決して 油断してはいけない
Dialogue: 0,0:17:20.61,0:17:23.45,日语,,0,0,0,,おごってはいけない 軽んじてはいけない
Dialogue: 0,0:17:23.45,0:17:25.73,日语,,0,0,0,,生き延びるためには たった ひとつ
Dialogue: 0,0:17:25.73,0:17:27.83,日语,,0,0,0,,臆病でいてください
Dialogue: 0,0:17:36.17,0:17:37.63,日语,,0,0,0,,おっ 火がついた
Dialogue: 0,0:17:38.13,0:17:39.37,日语,,0,0,0,,雰囲気ある～
Dialogue: 0,0:17:39.37,0:17:41.61,日语,,0,0,0,,こんなダンジョン 初めてだ
Dialogue: 0,0:17:50.77,0:17:52.75,日语,,0,0,0,,なんだ？　この石像
Dialogue: 0,0:17:52.75,0:17:54.49,日语,,0,0,0,,随分 古そうですが
Dialogue: 0,0:17:54.83,0:17:56.45,日语,,0,0,0,,楽器持ってるのもいる
Dialogue: 0,0:18:02.75,0:18:04.71,日语,,0,0,0,,これだけ ひときわ大きい
Dialogue: 0,0:18:05.37,0:18:06.95,日语,,0,0,0,,マジでデカいな
Dialogue: 0,0:18:06.95,0:18:07.97,日语,,0,0,0,,なんだ？
Dialogue: 0,0:18:07.97,0:18:09.45,日语,,0,0,0,,なんか 不気味
Dialogue: 0,0:18:09.97,0:18:12.55,日语,,0,0,0,,っていうか モンスター いなくね？
Dialogue: 0,0:18:12.55,0:18:13.53,日语,,0,0,0,,確かに
Dialogue: 0,0:18:13.53,0:18:15.21,日语,,0,0,0,,１匹も見当たらない
Dialogue: 0,0:18:16.97,0:18:17.85,日语,,0,0,0,,なんだ
Dialogue: 0,0:18:17.85,0:18:19.23,日语,,0,0,0,,魔法陣？
Dialogue: 0,0:18:19.23,0:18:22.05,日语,,0,0,0,,馬渕さん ここに なんか書かれてます！
Dialogue: 0,0:18:22.83,0:18:24.17,日语,,0,0,0,,古代文字か
Dialogue: 0,0:18:24.17,0:18:25.33,日语,,0,0,0,,どれどれ…
Dialogue: 0,0:18:26.01,0:18:28.67,日语,,0,0,0,,“カルテノン神殿の掟(おきて)”
Dialogue: 0,0:18:28.67,0:18:31.65,日语,,0,0,0,,“１つ目 神を敬せよ”
Dialogue: 0,0:18:31.65,0:18:34.77,日语,,0,0,0,,-み… 水篠さん… -“２つ目 神を讃(たた)えよ”
Dialogue: 0,0:18:35.39,0:18:37.63,日语,,0,0,0,,“３つ目 神を信仰せよ”
Dialogue: 0,0:18:37.63,0:18:41.89,日语,,0,0,0,,今 あの大きな石像 目が動きました
Dialogue: 0,0:18:42.39,0:18:44.65,日语,,0,0,0,,私たちのことを見てたんです
Dialogue: 0,0:18:45.13,0:18:46.11,日语,,0,0,0,,えっ？
Dialogue: 0,0:18:46.11,0:18:49.33,日语,,0,0,0,,-まさか… 見間違いじゃ… -“この掟を守れぬ者は”
Dialogue: 0,0:18:50.13,0:18:51.85,日语,,0,0,0,,“生きては帰れん”？
Dialogue: 0,0:18:56.55,0:18:58.47,日语,,0,0,0,,おい 扉が閉まったぞ！
Dialogue: 0,0:18:58.47,0:19:00.29,日语,,0,0,0,,えっ… なんで！
Dialogue: 0,0:19:00.29,0:19:03.03,日语,,0,0,0,,まさか私たち 閉じ込められたんじゃ…
Dialogue: 0,0:19:04.31,0:19:06.03,日语,,0,0,0,,だから嫌だったんだよ！
Dialogue: 0,0:19:06.03,0:19:08.63,日语,,0,0,0,,ナメてかかるから こんなことになるんだ！
Dialogue: 0,0:19:08.63,0:19:11.17,日语,,0,0,0,,最初から来るべきじゃなかっただろ
Dialogue: 0,0:19:11.17,0:19:12.35,日语,,0,0,0,,俺は帰る！
Dialogue: 0,0:19:12.35,0:19:15.33,日语,,0,0,0,,宝だろうとなんだろうと 全部 くれてやるよ
Dialogue: 0,0:19:15.79,0:19:16.91,日语,,0,0,0,,あ～ばよ
Dialogue: 0,0:19:18.21,0:19:19.97,日语,,0,0,0,,そこから離れろ！
Dialogue: 0,0:19:36.81,0:19:38.47,日语,,0,0,0,,いやああ！
Dialogue: 0,0:19:38.47,0:19:39.15,日语,,0,0,0,,ウソだろ
Dialogue: 0,0:19:39.15,0:19:40.69,日语,,0,0,0,,動いたぞ！
Dialogue: 0,0:19:40.69,0:19:43.29,日语,,0,0,0,,まさか あれと戦うのか？
Dialogue: 0,0:19:44.85,0:19:47.37,日语,,0,0,0,,今殺された人のランクは？
Dialogue: 0,0:19:47.37,0:19:48.23,日语,,0,0,0,,Ｄ級？
Dialogue: 0,0:19:48.93,0:19:52.19,日语,,0,0,0,,少なくともＥ級の俺より 強いに決まってる
Dialogue: 0,0:19:53.57,0:19:56.15,日语,,0,0,0,,それなのに 一瞬で？
Dialogue: 0,0:19:56.65,0:19:57.89,日语,,0,0,0,,おかしいだろ
Dialogue: 0,0:19:57.89,0:19:59.77,日语,,0,0,0,,ここはＤ級ダンジョンなんだ
Dialogue: 0,0:19:59.77,0:20:01.87,日语,,0,0,0,,こんな怪物がいるなんて 聞いてない！
Dialogue: 0,0:20:02.19,0:20:04.19,日语,,0,0,0,,石像が動くということは
Dialogue: 0,0:20:04.43,0:20:05.49,日语,,0,0,0,,まさか…
Dialogue: 0,0:20:19.39,0:20:23.31,日语,,0,0,0,,俺は今までに 何度も死の瀬戸際に立たされてきた
Dialogue: 0,0:20:23.93,0:20:27.63,日语,,0,0,0,,人生初のレイドで みんなと はぐれて 遭難してしまったり
Dialogue: 0,0:20:28.03,0:20:31.39,日语,,0,0,0,,Ｅ級モンスターにやられて 数週間 入院したこともある
Dialogue: 0,0:20:31.91,0:20:34.85,日语,,0,0,0,,迷宮に閉じ込められて 餓死しかけたこともあった
Dialogue: 0,0:20:35.49,0:20:37.39,日语,,0,0,0,,いくらランクの低い ダンジョンであっても
Dialogue: 0,0:20:37.87,0:20:39.93,日语,,0,0,0,,俺にとっては常に命懸けだ
Dialogue: 0,0:20:41.05,0:20:45.17,日语,,0,0,0,,ハンターたちは普通 魔法石から得た金で武装する
Dialogue: 0,0:20:45.17,0:20:47.25,日语,,0,0,0,,より強いモンスターを倒し
Dialogue: 0,0:20:47.25,0:20:49.39,日语,,0,0,0,,より多くの報酬を得るために
Dialogue: 0,0:20:50.01,0:20:52.81,日语,,0,0,0,,でも 俺には安物のナイフがせいぜい
Dialogue: 0,0:20:52.81,0:20:55.51,日语,,0,0,0,,それが壊れれば 素手で立ち向かうしかなくなる
Dialogue: 0,0:20:57.61,0:20:59.55,日语,,0,0,0,,この靴も もうダメか
Dialogue: 0,0:21:00.57,0:21:03.81,日语,,0,0,0,,そうして一日 また一日…
Dialogue: 0,0:21:06.61,0:21:08.55,日语,,0,0,0,,バカにされる日々を耐え
Dialogue: 0,0:21:08.55,0:21:11.31,日语,,0,0,0,,命を懸けてまで 割に合わない仕事をしてきた
Dialogue: 0,0:21:12.05,0:21:14.43,日语,,0,0,0,,それでも生き延びるため 隙をうかがい
Dialogue: 0,0:21:14.43,0:21:16.91,日语,,0,0,0,,注意深く周りを観察しながら
Dialogue: 0,0:21:17.91,0:21:19.03,日语,,0,0,0,,だからなのか
Dialogue: 0,0:21:19.67,0:21:20.61,日语,,0,0,0,,よく分かる
Dialogue: 0,0:21:21.09,0:21:22.61,日语,,0,0,0,,みんな伏せて！
Dialogue: 0,0:21:37.79,0:21:38.99,日语,,0,0,0,,ふざけんなよ！
Dialogue: 0,0:21:38.99,0:21:39.81,日语,,0,0,0,,聞いてねえぞ
Dialogue: 0,0:21:39.81,0:21:40.93,日语,,0,0,0,,なんなの 一体！
Dialogue: 0,0:21:40.93,0:21:42.13,日语,,0,0,0,,俺が知るか！
Dialogue: 0,0:21:42.13,0:21:43.33,日语,,0,0,0,,大丈夫か？
Dialogue: 0,0:21:43.33,0:21:44.29,日语,,0,0,0,,ああ
Dialogue: 0,0:21:44.29,0:21:45.55,日语,,0,0,0,,真島さんは？
Dialogue: 0,0:21:45.55,0:21:46.57,日语,,0,0,0,,大丈夫だ
Dialogue: 0,0:21:47.01,0:21:49.53,日语,,0,0,0,,もう嫌… もう嫌…
Dialogue: 0,0:21:49.99,0:21:52.29,日语,,0,0,0,,何が起きてるんだ
Dialogue: 0,0:21:53.21,0:21:55.13,日语,,0,0,0,,一体 どうしてこんなことに…
Dialogue: 0,0:21:55.85,0:21:57.11,日语,,0,0,0,,閉じ込められた
Dialogue: 0,0:21:57.11,0:21:58.47,日语,,0,0,0,,逃げられない
Dialogue: 0,0:21:58.47,0:22:00.77,日语,,0,0,0,,死ぬ 死ぬ…
Dialogue: 0,0:22:04.17,0:22:05.43,日语,,0,0,0,,殺される！
Dialogue: 0,0:00:11.41,0:00:13.73,单语中字,,0,0,0,,舰长 我们也进行支援吧
Dialogue: 0,0:00:13.73,0:00:15.59,单语中字,,0,0,0,,你也明白这是没用的吧
Dialogue: 0,0:00:16.21,0:00:18.13,单语中字,,0,0,0,,我们的常规兵器
Dialogue: 0,0:00:18.13,0:00:20.57,单语中字,,0,0,0,,是无法对那些东西造成伤害的
Dialogue: 0,0:00:22.13,0:00:24.89,单语中字,,0,0,0,,我们只能将这一切
Dialogue: 0,0:00:24.89,0:00:26.71,单语中字,,0,0,0,,托付给那群猎人了
Dialogue: 0,0:00:43.47,0:00:44.97,单语中字,,0,0,0,,各自应战
Dialogue: 0,0:00:44.97,0:00:47.79,单语中字,,0,0,0,,这里要是被突破 战线将会瓦解的
Dialogue: 0,0:00:49.53,0:00:50.45,单语中字,,0,0,0,,别后退
Dialogue: 0,0:01:04.01,0:01:05.67,单语中字,,0,0,0,,不…不行
Dialogue: 0,0:01:05.67,0:01:08.35,单语中字,,0,0,0,,这不是我们这种级别能够应付的对手
Dialogue: 0,0:01:09.89,0:01:10.99,单语中字,,0,0,0,,可恶…
Dialogue: 0,0:01:11.31,0:01:13.59,单语中字,,0,0,0,,要失去意识了…
Dialogue: 0,0:01:24.25,0:01:25.73,单语中字,,0,0,0,,回复魔法
Dialogue: 0,0:01:27.95,0:01:29.27,单语中字,,0,0,0,,好厉害
Dialogue: 0,0:01:29.27,0:01:30.61,单语中字,,0,0,0,,伤口在瞬间便…
Dialogue: 0,0:01:31.55,0:01:33.17,单语中字,,0,0,0,,危…危险
Dialogue: 0,0:01:33.49,0:01:34.97,单语中字,,0,0,0,,美浓部 趴下
Dialogue: 0,0:01:37.03,0:01:38.19,单语中字,,0,0,0,,大虎
Dialogue: 0,0:01:38.19,0:01:39.23,单语中字,,0,0,0,,好
Dialogue: 0,0:01:51.25,0:01:52.69,单语中字,,0,0,0,,是S级
Dialogue: 0,0:01:52.69,0:01:54.69,单语中字,,0,0,0,,S级猎人来了
Dialogue: 0,0:01:54.69,0:01:56.83,单语中字,,0,0,0,,你冲得太前面了 美浓部
Dialogue: 0,0:01:57.25,0:01:58.61,单语中字,,0,0,0,,抱歉
Dialogue: 0,0:01:58.61,0:02:00.45,单语中字,,0,0,0,,我想尽力去救人
Dialogue: 0,0:02:00.45,0:02:01.51,单语中字,,0,0,0,,而且
Dialogue: 0,0:02:01.51,0:02:04.55,单语中字,,0,0,0,,我相信你们两位 一定会保护我的
Dialogue: 0,0:02:12.69,0:02:15.61,单语中字,,0,0,0,,看起来它并不是BOSS
Dialogue: 0,0:02:15.61,0:02:17.89,单语中字,,0,0,0,,应该是这群怪物的头头吧
Dialogue: 0,0:02:18.67,0:02:20.59,单语中字,,0,0,0,,刚 伤患就交给你了
Dialogue: 0,0:02:21.11,0:02:23.23,单语中字,,0,0,0,,交给我吧 大虎
Dialogue: 0,0:02:23.53,0:02:25.49,单语中字,,0,0,0,,我们上 飒树
Dialogue: 0,0:02:25.49,0:02:26.43,单语中字,,0,0,0,,了解
Dialogue: 0,0:02:47.73,0:02:48.89,单语中字,,0,0,0,,看招
Dialogue: 0,0:02:56.81,0:02:58.19,单语中字,,0,0,0,,你这个怪力男
Dialogue: 0,0:02:58.19,0:02:59.25,单语中字,,0,0,0,,什么
Dialogue: 0,0:03:02.15,0:03:04.25,单语中字,,0,0,0,,看来也不是头头呢
Dialogue: 0,0:03:04.61,0:03:06.31,单语中字,,0,0,0,,有意思
Dialogue: 0,0:03:19.15,0:03:22.37,单语中字,,0,0,0,,看来他们似乎赶上了
Dialogue: 0,0:03:25.71,0:03:26.77,单语中字,,0,0,0,,那么
Dialogue: 0,0:03:26.77,0:03:28.57,单语中字,,0,0,0,,我们也开始吧
Dialogue: 0,0:03:29.25,0:03:31.33,单语中字,,0,0,0,,最上代表 我们准备好了
Dialogue: 0,0:03:31.33,0:03:32.19,单语中字,,0,0,0,,好
Dialogue: 0,0:03:46.03,0:03:48.13,单语中字,,0,0,0,,开始进攻
Dialogue: 0,0:03:53.89,0:03:55.99,单语中字,,0,0,0,,距今十多年前
Dialogue: 0,0:03:55.99,0:04:01.25,单语中字,,0,0,0,,世界上突然出现能够连接异次元与这个世界的"传送门"
Dialogue: 0,0:04:02.15,0:04:03.81,单语中字,,0,0,0,,传送门内
Dialogue: 0,0:04:03.81,0:04:07.19,单语中字,,0,0,0,,有着各种异形怪物与魔兽
Dialogue: 0,0:04:07.19,0:04:09.53,单语中字,,0,0,0,,而觉醒了特殊能力
Dialogue: 0,0:04:09.53,0:04:13.07,单语中字,,0,0,0,,能与常规兵器无法对抗的魔兽一战的觉醒者
Dialogue: 0,0:04:13.71,0:04:15.31,单语中字,,0,0,0,,人们将其称之为"猎人"
Dialogue: 0,0:04:15.81,0:04:19.03,单语中字,,0,0,0,,猎人以本身具备的魔力量做为分类
Dialogue: 0,0:04:19.03,0:04:26.47,单语中字,,0,0,0,,分为S A B C D E级
Dialogue: 0,0:04:27.51,0:04:32.49,单语中字,,0,0,0,,然而 一旦觉醒 无论该觉醒者如何努力
Dialogue: 0,0:04:33.09,0:04:35.96,单语中字,,0,0,0,,其本身能力将不会再有所成长
Dialogue: 0,0:04:59.63,0:05:01.81,单语中字,,0,0,0,,今天的突击任务也请加油
Dialogue: 0,0:05:01.81,0:05:02.83,单语中字,,0,0,0,,谢啦
Dialogue: 0,0:05:03.77,0:05:05.73,单语中字,,0,0,0,,喂 真岛先生
Dialogue: 0,0:05:06.21,0:05:07.45,单语中字,,0,0,0,,好久不见了
Dialogue: 0,0:05:07.45,0:05:08.37,单语中字,,0,0,0,,咦
Dialogue: 0,0:05:08.67,0:05:10.83,单语中字,,0,0,0,,这不是久我先生吗 你怎么来了
Dialogue: 0,0:05:10.83,0:05:13.31,单语中字,,0,0,0,,你不是说不干猎人了吗
Dialogue: 0,0:05:14.77,0:05:17.03,单语中字,,0,0,0,,因为我老婆怀了第二胎嘛
Dialogue: 0,0:05:17.03,0:05:18.17,单语中字,,0,0,0,,原来如此
Dialogue: 0,0:05:18.17,0:05:21.31,单语中字,,0,0,0,,毕竟顺利完成突击任务的话 就能捞上一大笔钱嘛
Dialogue: 0,0:05:22.23,0:05:23.65,单语中字,,0,0,0,,不过我很担心啊
Dialogue: 0,0:05:23.65,0:05:26.67,单语中字,,0,0,0,,这么久没出任务 不知道身体能不能跟上大家
Dialogue: 0,0:05:26.67,0:05:28.43,单语中字,,0,0,0,,况且我的实力本就不怎么样了
Dialogue: 0,0:05:28.43,0:05:30.85,单语中字,,0,0,0,,咦 这不是水篠吗
Dialogue: 0,0:05:30.85,0:05:32.83,单语中字,,0,0,0,,水篠 早啊
Dialogue: 0,0:05:32.83,0:05:34.75,单语中字,,0,0,0,,天气这么冷 辛苦你了
Dialogue: 0,0:05:36.87,0:05:38.93,单语中字,,0,0,0,,今天也请多指教了
Dialogue: 0,0:05:38.93,0:05:41.09,单语中字,,0,0,0,,喂 水篠
Dialogue: 0,0:05:41.09,0:05:42.87,单语中字,,0,0,0,,你有好好吃饭吗
Dialogue: 0,0:05:43.25,0:05:45.83,单语中字,,0,0,0,,是 我有好好吃饭
Dialogue: 0,0:05:46.65,0:05:48.83,单语中字,,0,0,0,,他是谁啊 很强吗
Dialogue: 0,0:05:48.83,0:05:50.63,单语中字,,0,0,0,,为什么大家都向他打招呼
Dialogue: 0,0:05:51.77,0:05:53.43,单语中字,,0,0,0,,是正好相反
Dialogue: 0,0:05:53.43,0:05:55.59,单语中字,,0,0,0,,他是在你退出后加入的
Dialogue: 0,0:05:55.59,0:05:59.67,单语中字,,0,0,0,,那个小子还有另一个绰号 就是"人类最弱兵器"
Dialogue: 0,0:06:00.03,0:06:02.55,单语中字,,0,0,0,,最弱 不是最强兵器吗
Dialogue: 0,0:06:02.55,0:06:03.47,单语中字,,0,0,0,,是最弱
Dialogue: 0,0:06:03.47,0:06:06.55,单语中字,,0,0,0,,毕竟他就连在E级地下城 都能搞到受伤住院呢
Dialogue: 0,0:06:06.97,0:06:09.53,单语中字,,0,0,0,,他大概是猎人中最弱的一个吧
Dialogue: 0,0:06:09.53,0:06:12.21,单语中字,,0,0,0,,真的假的 居然弱成这样啊
Dialogue: 0,0:06:12.21,0:06:16.15,单语中字,,0,0,0,,所以会呼叫那小子来 就代表这个突击任务难度很低
Dialogue: 0,0:06:16.15,0:06:17.75,单语中字,,0,0,0,,原来如此
Dialogue: 0,0:06:17.75,0:06:19.17,单语中字,,0,0,0,,被他听到就不好了
Dialogue: 0,0:06:19.17,0:06:21.35,单语中字,,0,0,0,,这个话题就到此为止吧
Dialogue: 0,0:06:22.29,0:06:24.81,单语中字,,0,0,0,,我全都听到了啦
Dialogue: 0,0:06:24.81,0:06:25.91,单语中字,,0,0,0,,不过
Dialogue: 0,0:06:25.91,0:06:28.93,单语中字,,0,0,0,,他说的也是事实 所以我也无法反驳
Dialogue: 0,0:06:28.93,0:06:31.65,单语中字,,0,0,0,,水篠 你怎么又受伤了
Dialogue: 0,0:06:32.31,0:06:33.49,单语中字,,0,0,0,,是观月啊
Dialogue: 0,0:06:33.49,0:06:35.15,单语中字,,0,0,0,,我们又要一起出任务了
Dialogue: 0,0:06:35.83,0:06:38.95,单语中字,,0,0,0,,比起这种事 你脸上的伤是怎么回事
Dialogue: 0,0:06:38.95,0:06:41.89,单语中字,,0,0,0,,那个…就是老样子嘛
Dialogue: 0,0:06:43.09,0:06:45.37,单语中字,,0,0,0,,你小心一点啦
Dialogue: 0,0:06:46.57,0:06:48.87,单语中字,,0,0,0,,我还听说你搞到住院呢
Dialogue: 0,0:06:48.87,0:06:51.35,单语中字,,0,0,0,,我是E级地下城里唯一受伤的人
Dialogue: 0,0:06:51.35,0:06:53.65,单语中字,,0,0,0,,咦 队伍里没有治疗师吗
Dialogue: 0,0:06:54.21,0:06:59.15,单语中字,,0,0,0,,因为其他人都是高等猎人 所以一开始就没找治疗师加入
Dialogue: 0,0:06:59.15,0:07:00.45,单语中字,,0,0,0,,什么嘛
Dialogue: 0,0:07:00.45,0:07:02.65,单语中字,,0,0,0,,自己不需要 就能不顾其他人的死活吗
Dialogue: 0,0:07:02.65,0:07:05.51,单语中字,,0,0,0,,没关系的 是我自己太弱了
Dialogue: 0,0:07:06.05,0:07:08.31,单语中字,,0,0,0,,观月你也应该很清楚吧
Dialogue: 0,0:07:08.69,0:07:10.05,单语中字,,0,0,0,,我已经习惯了
Dialogue: 0,0:07:12.37,0:07:14.33,单语中字,,0,0,0,,好像要进去了
Dialogue: 0,0:07:14.33,0:07:15.71,单语中字,,0,0,0,,我们走吧
Dialogue: 0,0:07:16.69,0:07:17.89,单语中字,,0,0,0,,恕我毛遂自荐
Dialogue: 0,0:07:17.89,0:07:20.89,单语中字,,0,0,0,,由我来担任此次突击任务的队长吧
Dialogue: 0,0:07:20.89,0:07:22.49,单语中字,,0,0,0,,我叫马渕勋
Dialogue: 0,0:07:22.49,0:07:24.15,单语中字,,0,0,0,,请大家多多指教
Dialogue: 0,0:07:24.15,0:07:25.97,单语中字,,0,0,0,,这是当然的了
Dialogue: 0,0:07:25.97,0:07:29.07,单语中字,,0,0,0,,毕竟马渕先生是我们之中最高等的猎人
Dialogue: 0,0:07:29.07,0:07:30.99,单语中字,,0,0,0,,给你带队我就放心了
Dialogue: 0,0:07:31.47,0:07:33.83,单语中字,,0,0,0,,请多指教 马渕先生
Dialogue: 0,0:07:33.83,0:07:34.95,单语中字,,0,0,0,,好
Dialogue: 0,0:07:34.95,0:07:37.13,单语中字,,0,0,0,,那么大家都准备好了吗
Dialogue: 0,0:07:37.13,0:07:38.39,单语中字,,0,0,0,,我们进去吧
Dialogue: 0,0:07:43.67,0:07:44.77,单语中字,,0,0,0,,水篠
Dialogue: 0,0:07:46.19,0:07:49.11,单语中字,,0,0,0,,要紧跟着我们 别掉队受伤哦
Dialogue: 0,0:07:50.17,0:07:51.17,单语中字,,0,0,0,,好的
Dialogue: 0,0:07:51.17,0:07:53.33,单语中字,,0,0,0,,那就加油吧
Dialogue: 0,0:07:56.47,0:07:59.29,单语中字,,0,0,0,,只有少量魔力的小刀
Dialogue: 0,0:08:00.05,0:08:03.03,单语中字,,0,0,0,,凭我的收入 顶多只能弄到这把刀
Dialogue: 0,0:08:03.65,0:08:05.09,单语中字,,0,0,0,,但总比没有好
Dialogue: 0,0:08:08.29,0:08:10.07,单语中字,,0,0,0,,今天我一定要好好表现
Dialogue: 0,0:08:19.39,0:08:21.65,单语中字,,0,0,0,,您辛苦了 后藤会长
Dialogue: 0,0:08:22.47,0:08:24.43,单语中字,,0,0,0,,跟政府的会谈结果如何呢
Dialogue: 0,0:08:25.15,0:08:27.91,单语中字,,0,0,0,,他们说的话都是千篇一律
Dialogue: 0,0:08:27.91,0:08:29.83,单语中字,,0,0,0,,既要我们不能让"解除封印"发生
Dialogue: 0,0:08:29.83,0:08:33.99,单语中字,,0,0,0,,又要求我们稳定提供 从地下城内获得的物资
Dialogue: 0,0:08:35.69,0:08:38.99,单语中字,,0,0,0,,他们的要求本身并没有什么问题
Dialogue: 0,0:08:38.99,0:08:44.47,单语中字,,0,0,0,,转卖从地下城获取的物资 是我们猎人的维生方式
Dialogue: 0,0:08:49.55,0:08:52.73,单语中字,,0,0,0,,从打倒的魔兽里得到的结晶体
Dialogue: 0,0:08:52.73,0:08:54.31,单语中字,,0,0,0,,也就是魔法石
Dialogue: 0,0:08:54.75,0:08:55.75,单语中字,,0,0,0,,可以转卖为金钱
Dialogue: 0,0:09:02.33,0:09:03.39,单语中字,,0,0,0,,成功了…
Dialogue: 0,0:09:03.87,0:09:05.57,单语中字,,0,0,0,,终于拿到第一个…
Dialogue: 0,0:09:05.57,0:09:06.61,单语中字,,0,0,0,,水篠
Dialogue: 0,0:09:21.31,0:09:22.45,单语中字,,0,0,0,,水篠
Dialogue: 0,0:09:22.45,0:09:24.01,单语中字,,0,0,0,,观月你退后
Dialogue: 0,0:09:24.01,0:09:25.29,单语中字,,0,0,0,,看招
Dialogue: 0,0:09:29.01,0:09:30.67,单语中字,,0,0,0,,我去处理下一个魔兽
Dialogue: 0,0:09:31.17,0:09:32.91,单语中字,,0,0,0,,观月你来治疗水篠
Dialogue: 0,0:09:32.91,0:09:34.37,单语中字,,0,0,0,,好…好的
Dialogue: 0,0:09:36.39,0:09:38.23,单语中字,,0,0,0,,没事的
Dialogue: 0,0:09:38.23,0:09:40.07,单语中字,,0,0,0,,我一定会治好你的
Dialogue: 0,0:09:56.67,0:10:00.67,单语中字,,0,0,0,,从高等魔兽身上得到的魔法石
Dialogue: 0,0:10:00.67,0:10:06.35,单语中字,,0,0,0,,可以转换成更加强力的武器防具 用以击倒更强的魔兽
Dialogue: 0,0:10:06.93,0:10:11.53,单语中字,,0,0,0,,虽然从地下城采集的玛那石 也能这样转卖
Dialogue: 0,0:10:11.53,0:10:14.31,单语中字,,0,0,0,,但效果还是比不上魔法石
Dialogue: 0,0:10:14.31,0:10:16.99,单语中字,,0,0,0,,但是政府所要求的用途是…
Dialogue: 0,0:10:17.69,0:10:20.19,单语中字,,0,0,0,,要用来当作新型能源
Dialogue: 0,0:10:21.27,0:10:23.19,单语中字,,0,0,0,,比核能发电还要安全
Dialogue: 0,0:10:23.19,0:10:26.45,单语中字,,0,0,0,,比水力 风力 地热发电 还要来得有效率
Dialogue: 0,0:10:26.45,0:10:29.17,单语中字,,0,0,0,,比火力发电更不会造成空气污染
Dialogue: 0,0:10:30.07,0:10:32.33,单语中字,,0,0,0,,是最理想的绿色能源
Dialogue: 0,0:10:32.79,0:10:37.57,单语中字,,0,0,0,,政府现在正在研究 利用魔法石与玛那石的发电方式
Dialogue: 0,0:10:37.57,0:10:40.43,单语中字,,0,0,0,,只能透过猎人加以获取的稀少资源
Dialogue: 0,0:10:41.21,0:10:44.79,单语中字,,0,0,0,,所以猎人所扮演的角色尤其重要
Dialogue: 0,0:10:52.11,0:10:53.37,单语中字,,0,0,0,,-太好了 -成功了
Dialogue: 0,0:10:53.37,0:10:55.13,单语中字,,0,0,0,,打倒地下城BOSS了
Dialogue: 0,0:10:55.13,0:10:56.63,单语中字,,0,0,0,,-好耶  真不愧是马渕先生
Dialogue: 0,0:10:57.07,0:10:58.57,单语中字,,0,0,0,,-成功了呢 -好耶
Dialogue: 0,0:10:59.65,0:11:00.79,单语中字,,0,0,0,,水篠
Dialogue: 0,0:11:00.79,0:11:04.21,单语中字,,0,0,0,,你该不会是因为赌气 才执着于猎人这个工作吧
Dialogue: 0,0:11:04.97,0:11:08.33,单语中字,,0,0,0,,再这样下去 你总有一天会出事的
Dialogue: 0,0:11:08.73,0:11:10.13,单语中字,,0,0,0,,不只是肚子
Dialogue: 0,0:11:10.13,0:11:12.37,单语中字,,0,0,0,,全身上下都受这种重伤
Dialogue: 0,0:11:12.37,0:11:13.41,单语中字,,0,0,0,,抱歉…
Dialogue: 0,0:11:13.41,0:11:15.83,单语中字,,0,0,0,,我不是要你道歉
Dialogue: 0,0:11:15.83,0:11:17.53,单语中字,,0,0,0,,我是在担心你啊
Dialogue: 0,0:11:23.27,0:11:26.15,单语中字,,0,0,0,,各位 战利品都拿好了吗
Dialogue: 0,0:11:26.15,0:11:28.69,单语中字,,0,0,0,,拿得差不多了
Dialogue: 0,0:11:28.69,0:11:31.43,单语中字,,0,0,0,,这里玛那石的矿脉太少了
Dialogue: 0,0:11:31.43,0:11:34.25,单语中字,,0,0,0,,这样根本赚不到多少钱啊
Dialogue: 0,0:11:35.23,0:11:36.81,单语中字,,0,0,0,,结束了吗…
Dialogue: 0,0:11:37.81,0:11:41.51,单语中字,,0,0,0,,我的战利品 就只有这么一个E级魔法石
Dialogue: 0,0:11:42.49,0:11:44.83,单语中字,,0,0,0,,这样拼死拼活也太不划算了吧
Dialogue: 0,0:11:46.69,0:11:48.57,单语中字,,0,0,0,,喂
Dialogue: 0,0:11:48.57,0:11:50.29,单语中字,,0,0,0,,大家来这里一下
Dialogue: 0,0:11:50.97,0:11:51.85,单语中字,,0,0,0,,是洞窟吗
Dialogue: 0,0:11:51.85,0:11:53.05,单语中字,,0,0,0,,还是地道
Dialogue: 0,0:11:53.05,0:11:55.93,单语中字,,0,0,0,,感觉会直达洞穴深处啊
Dialogue: 0,0:11:55.93,0:11:57.95,单语中字,,0,0,0,,双重地下城吗
Dialogue: 0,0:11:57.95,0:11:59.93,单语中字,,0,0,0,,我是有听说过…
Dialogue: 0,0:11:59.93,0:12:03.99,单语中字,,0,0,0,,毕竟已经打倒了BOSS 地下城却没有关闭的迹象
Dialogue: 0,0:12:03.99,0:12:06.67,单语中字,,0,0,0,,是啊 我也觉得很怪
Dialogue: 0,0:12:06.67,0:12:07.87,单语中字,,0,0,0,,也就是说…
Dialogue: 0,0:12:07.87,0:12:08.99,单语中字,,0,0,0,,是啊
Dialogue: 0,0:12:08.99,0:12:11.23,单语中字,,0,0,0,,这个洞穴深处还有更多猎物
Dialogue: 0,0:12:11.69,0:12:13.35,单语中字,,0,0,0,,大家听我说
Dialogue: 0,0:12:13.79,0:12:16.19,单语中字,,0,0,0,,通常要是遇到这样的状况
Dialogue: 0,0:12:16.19,0:12:19.37,单语中字,,0,0,0,,照惯例都要向猎人协会报告
Dialogue: 0,0:12:19.73,0:12:21.77,单语中字,,0,0,0,,等一下 马渕先生
Dialogue: 0,0:12:21.77,0:12:25.21,单语中字,,0,0,0,,这样不就要把猎物 拱手让给后来的猎人了吗
Dialogue: 0,0:12:25.67,0:12:29.25,单语中字,,0,0,0,,同样都是D级地下城 没问题啦
Dialogue: 0,0:12:29.25,0:12:31.35,单语中字,,0,0,0,,他老婆都要生第二个了
Dialogue: 0,0:12:31.35,0:12:33.09,单语中字,,0,0,0,,而且这里的玛那石又这么少
Dialogue: 0,0:12:33.65,0:12:36.53,单语中字,,0,0,0,,稍微通融一下应该没关系吧
Dialogue: 0,0:12:36.53,0:12:37.83,单语中字,,0,0,0,,真的不行吗
Dialogue: 0,0:12:37.83,0:12:39.71,单语中字,,0,0,0,,我能体会你们的心情
Dialogue: 0,0:12:39.71,0:12:41.99,单语中字,,0,0,0,,但有未知危险也是事实
Dialogue: 0,0:12:42.69,0:12:44.13,单语中字,,0,0,0,,我们投票表决吧
Dialogue: 0,0:12:44.13,0:12:45.19,单语中字,,0,0,0,,我有点不想去
Dialogue: 0,0:12:45.19,0:12:46.21,单语中字,,0,0,0,,我们上吧
Dialogue: 0,0:12:46.21,0:12:47.55,单语中字,,0,0,0,,我反对
Dialogue: 0,0:12:47.55,0:12:48.45,单语中字,,0,0,0,,反对
Dialogue: 0,0:12:48.45,0:12:49.83,单语中字,,0,0,0,,下去看看吧
Dialogue: 0,0:12:49.83,0:12:50.55,单语中字,,0,0,0,,我也去
Dialogue: 0,0:12:50.55,0:12:51.35,单语中字,,0,0,0,,一样
Dialogue: 0,0:12:51.35,0:12:52.63,单语中字,,0,0,0,,我们回去吧
Dialogue: 0,0:12:53.11,0:12:54.29,单语中字,,0,0,0,,我要去
Dialogue: 0,0:12:54.29,0:12:55.35,单语中字,,0,0,0,,当然要去了
Dialogue: 0,0:12:55.35,0:12:58.29,单语中字,,0,0,0,,抱歉…我不想去
Dialogue: 0,0:12:58.29,0:12:59.37,单语中字,,0,0,0,,嗯…
Dialogue: 0,0:12:59.37,0:13:01.83,单语中字,,0,0,0,,这样就是赞成6票 反对6票
Dialogue: 0,0:13:02.37,0:13:03.93,单语中字,,0,0,0,,那就剩下水篠了
Dialogue: 0,0:13:03.93,0:13:05.17,单语中字,,0,0,0,,你怎么想
Dialogue: 0,0:13:05.17,0:13:06.69,单语中字,,0,0,0,,我…
Dialogue: 0,0:13:08.11,0:13:12.27,单语中字,,0,0,0,,我也明白D级地下城有多危险
Dialogue: 0,0:13:13.13,0:13:14.07,单语中字,,0,0,0,,但是…
Dialogue: 0,0:13:14.65,0:13:16.13,单语中字,,0,0,0,,爸爸下落不明
Dialogue: 0,0:13:16.13,0:13:18.51,单语中字,,0,0,0,,家里能赚钱的人只有我一个
Dialogue: 0,0:13:19.15,0:13:20.83,单语中字,,0,0,0,,还有妈妈的医药费
Dialogue: 0,0:13:20.83,0:13:23.01,单语中字,,0,0,0,,跟一个准备考大学的妹妹
Dialogue: 0,0:13:23.85,0:13:26.59,单语中字,,0,0,0,,我需要钱
Dialogue: 0,0:13:27.79,0:13:28.81,单语中字,,0,0,0,,我要去
Dialogue: 0,0:13:35.81,0:13:39.05,单语中字,,0,0,0,,那么请把手放在那个黑色水晶上
Dialogue: 0,0:13:45.77,0:13:47.71,单语中字,,0,0,0,,下一位请进
Dialogue: 0,0:13:51.25,0:13:52.99,单语中字,,0,0,0,,你是C级吗
Dialogue: 0,0:13:52.99,0:13:54.59,单语中字,,0,0,0,,那么请务必加入我们公会
Dialogue: 0,0:13:54.59,0:13:57.81,单语中字,,0,0,0,,这里是本公会的签约条件
Dialogue: 0,0:13:57.81,0:14:01.49,单语中字,,0,0,0,,这里是劳动条件 合同费用按年度签约计费…
Dialogue: 0,0:14:02.91,0:14:08.79,单语中字,,0,0,0,,是的 已有一位B级 两位C级 答应要跟我们签约
Dialogue: 0,0:14:08.79,0:14:11.21,单语中字,,0,0,0,,现在一切顺利 最上代表
Dialogue: 0,0:14:11.21,0:14:13.11,单语中字,,0,0,0,,非常好
Dialogue: 0,0:14:13.11,0:14:14.81,单语中字,,0,0,0,,不论男女老少
Dialogue: 0,0:14:14.81,0:14:18.07,单语中字,,0,0,0,,请向所有有能者招募吧
Dialogue: 0,0:14:18.07,0:14:23.35,单语中字,,0,0,0,,不过我想应该不会有人才 能够超越本公会的向坂雫才是
Dialogue: 0,0:14:25.49,0:14:27.21,单语中字,,0,0,0,,快来人抓住他们啊
Dialogue: 0,0:14:27.21,0:14:28.47,单语中字,,0,0,0,,让开…
Dialogue: 0,0:14:32.95,0:14:35.27,单语中字,,0,0,0,,让开 你想被撞死吗
Dialogue: 0,0:14:57.27,0:14:58.63,单语中字,,0,0,0,,那…那个
Dialogue: 0,0:14:58.63,0:14:59.47,单语中字,,0,0,0,,还给你
Dialogue: 0,0:14:59.89,0:15:00.99,单语中字,,0,0,0,,谢谢你
Dialogue: 0,0:15:00.99,0:15:02.47,单语中字,,0,0,0,,-是向坂雫 -谢谢你
Dialogue: 0,0:15:02.47,0:15:03.51,单语中字,,0,0,0,,向坂雫
Dialogue: 0,0:15:03.51,0:15:04.91,单语中字,,0,0,0,,是那个S级猎人吗
Dialogue: 0,0:15:04.91,0:15:06.63,单语中字,,0,0,0,,-太猛了  -是本人啊
Dialogue: 0,0:15:06.63,0:15:07.65,单语中字,,0,0,0,,好可爱
Dialogue: 0,0:15:07.65,0:15:09.07,单语中字,,0,0,0,,-我是你的粉丝  -那…那个
Dialogue: 0,0:15:09.07,0:15:10.33,单语中字,,0,0,0,,-请跟我握手  -我…
Dialogue: 0,0:15:16.57,0:15:17.69,单语中字,,0,0,0,,太强了
Dialogue: 0,0:15:17.69,0:15:19.39,单语中字,,0,0,0,,真不愧是S级猎人
Dialogue: 0,0:15:22.39,0:15:24.87,单语中字,,0,0,0,,我们进入洞穴后走多久了啊
Dialogue: 0,0:15:24.87,0:15:26.75,单语中字,,0,0,0,,差不多有40分钟了吧
Dialogue: 0,0:15:26.75,0:15:29.67,单语中字,,0,0,0,,传送门在打倒BOSS的一小时后会关闭
Dialogue: 0,0:15:29.67,0:15:31.33,单语中字,,0,0,0,,所以我们还有20分钟的时间
Dialogue: 0,0:15:31.91,0:15:34.01,单语中字,,0,0,0,,那个…抱歉
Dialogue: 0,0:15:34.01,0:15:35.61,单语中字,,0,0,0,,你在道什么歉
Dialogue: 0,0:15:35.61,0:15:39.71,单语中字,,0,0,0,,因为我投下的赞成票 让你也被迫一起进来…
Dialogue: 0,0:15:39.71,0:15:41.73,单语中字,,0,0,0,,我没关系的
Dialogue: 0,0:15:41.73,0:15:43.31,单语中字,,0,0,0,,请不用在意
Dialogue: 0,0:15:43.31,0:15:45.63,单语中字,,0,0,0,,你真的没关系吗
Dialogue: 0,0:15:46.27,0:15:48.03,单语中字,,0,0,0,,我怎么可能…
Dialogue: 0,0:15:48.03,0:15:49.83,单语中字,,0,0,0,,会没关系啦
Dialogue: 0,0:15:49.83,0:15:51.47,单语中字,,0,0,0,,你是不是忘记了
Dialogue: 0,0:15:51.47,0:15:55.59,单语中字,,0,0,0,,水篠 刚刚你要是再被刺上面一点 你就直接死了耶
Dialogue: 0,0:15:55.59,0:15:59.15,单语中字,,0,0,0,,还有你的手脚 我好不容易才帮你治好的
Dialogue: 0,0:15:59.15,0:16:00.83,单语中字,,0,0,0,,你是不是疯了啊
Dialogue: 0,0:16:00.83,0:16:02.69,单语中字,,0,0,0,,还是说你撞坏脑子了
Dialogue: 0,0:16:02.69,0:16:03.91,单语中字,,0,0,0,,你说啊
Dialogue: 0,0:16:04.35,0:16:05.79,单语中字,,0,0,0,,抱歉…
Dialogue: 0,0:16:06.29,0:16:07.35,单语中字,,0,0,0,,的确
Dialogue: 0,0:16:07.35,0:16:11.19,单语中字,,0,0,0,,多亏有观月这个B级治疗师 我才能每次都捡回一条命
Dialogue: 0,0:16:11.61,0:16:13.83,单语中字,,0,0,0,,你真的有在反省吗
Dialogue: 0,0:16:13.83,0:16:14.77,单语中字,,0,0,0,,有…
Dialogue: 0,0:16:16.49,0:16:21.13,单语中字,,0,0,0,,这样的话 为了聊表你的歉意 下次请我吃饭吧
Dialogue: 0,0:16:21.13,0:16:22.13,单语中字,,0,0,0,,咦
Dialogue: 0,0:16:22.13,0:16:25.53,单语中字,,0,0,0,,怎么 你不喜欢跟我吃饭吗
Dialogue: 0,0:16:25.53,0:16:27.67,单语中字,,0,0,0,,不…不是的 怎么会呢
Dialogue: 0,0:16:27.67,0:16:28.69,单语中字,,0,0,0,,我们到了
Dialogue: 0,0:16:28.69,0:16:29.99,单语中字,,0,0,0,,是BOSS房
Dialogue: 0,0:16:32.89,0:16:35.83,单语中字,,0,0,0,,这种有门的房间很少见呢
Dialogue: 0,0:16:35.83,0:16:37.49,单语中字,,0,0,0,,感觉有点诡异
Dialogue: 0,0:16:37.49,0:16:38.37,单语中字,,0,0,0,,是啊
Dialogue: 0,0:16:38.85,0:16:40.01,单语中字,,0,0,0,,我要进去
Dialogue: 0,0:16:40.01,0:16:41.95,单语中字,,0,0,0,,来都来了 怎么能空手而回
Dialogue: 0,0:16:41.95,0:16:43.77,单语中字,,0,0,0,,就是啊 我也去
Dialogue: 0,0:16:44.47,0:16:46.71,单语中字,,0,0,0,,队上所有人一起前进
Dialogue: 0,0:16:46.71,0:16:49.59,单语中字,,0,0,0,,没错吧 马渕队长
Dialogue: 0,0:16:50.43,0:16:52.01,单语中字,,0,0,0,,是的 没错
Dialogue: 0,0:16:55.97,0:16:58.37,单语中字,,0,0,0,,各位觉醒者的诸位
Dialogue: 0,0:16:58.37,0:17:01.67,单语中字,,0,0,0,,我是猎人协会会长 后藤清臣
Dialogue: 0,0:17:01.67,0:17:03.27,单语中字,,0,0,0,,想必在各位之中
Dialogue: 0,0:17:03.27,0:17:08.85,单语中字,,0,0,0,,今后会有人从事猎人行业 以及不这么做的人
Dialogue: 0,0:17:08.85,0:17:11.27,单语中字,,0,0,0,,传送门出现至今已十余年
Dialogue: 0,0:17:11.27,0:17:14.19,单语中字,,0,0,0,,在地下城中依然有很多未解之谜
Dialogue: 0,0:17:14.19,0:17:16.69,单语中字,,0,0,0,,猎人是个赌命的行业
Dialogue: 0,0:17:16.69,0:17:18.59,单语中字,,0,0,0,,即便已经习惯了突击任务的召集
Dialogue: 0,0:17:18.59,0:17:20.61,单语中字,,0,0,0,,也绝不可掉以轻心
Dialogue: 0,0:17:20.61,0:17:23.45,单语中字,,0,0,0,,不可骄傲 不可藐视
Dialogue: 0,0:17:23.45,0:17:25.73,单语中字,,0,0,0,,想要活下去就只有一个重点
Dialogue: 0,0:17:25.73,0:17:27.83,单语中字,,0,0,0,,那就是请变得胆小
Dialogue: 0,0:17:36.17,0:17:37.63,单语中字,,0,0,0,,哦 火点起来了
Dialogue: 0,0:17:38.13,0:17:39.37,单语中字,,0,0,0,,气氛不错嘛
Dialogue: 0,0:17:39.37,0:17:41.61,单语中字,,0,0,0,,我还是第一次来这种地下城
Dialogue: 0,0:17:50.77,0:17:52.75,单语中字,,0,0,0,,这些石像是怎么回事
Dialogue: 0,0:17:52.75,0:17:54.49,单语中字,,0,0,0,,感觉年代很久远
Dialogue: 0,0:17:54.83,0:17:56.45,单语中字,,0,0,0,,还有些石像拿着乐器呢
Dialogue: 0,0:18:02.75,0:18:04.71,单语中字,,0,0,0,,只有这座石像特别大
Dialogue: 0,0:18:05.37,0:18:06.95,单语中字,,0,0,0,,真的很大呢
Dialogue: 0,0:18:06.95,0:18:07.97,单语中字,,0,0,0,,这是什么
Dialogue: 0,0:18:07.97,0:18:09.45,单语中字,,0,0,0,,感觉好诡异
Dialogue: 0,0:18:09.97,0:18:12.55,单语中字,,0,0,0,,话说回来 魔兽呢
Dialogue: 0,0:18:12.55,0:18:13.53,单语中字,,0,0,0,,的确
Dialogue: 0,0:18:13.53,0:18:15.21,单语中字,,0,0,0,,一只都没有呢
Dialogue: 0,0:18:16.97,0:18:17.85,单语中字,,0,0,0,,这是什么
Dialogue: 0,0:18:17.85,0:18:19.23,单语中字,,0,0,0,,魔法阵吗
Dialogue: 0,0:18:19.23,0:18:22.05,单语中字,,0,0,0,,马渕先生 这里好像写了些什么耶
Dialogue: 0,0:18:22.83,0:18:24.17,单语中字,,0,0,0,,是古代文字吗
Dialogue: 0,0:18:24.17,0:18:25.33,单语中字,,0,0,0,,我看看…
Dialogue: 0,0:18:26.01,0:18:28.67,单语中字,,0,0,0,,凯勒德帕神殿的戒律
Dialogue: 0,0:18:28.67,0:18:31.65,单语中字,,0,0,0,,一 敬拜神
Dialogue: 0,0:18:31.65,0:18:34.77,单语中字,,0,0,0,,-水…水篠 -二 赞美神
Dialogue: 0,0:18:35.39,0:18:37.63,单语中字,,0,0,0,,三 证明你的信仰
Dialogue: 0,0:18:37.63,0:18:41.89,单语中字,,0,0,0,,刚刚那个大石像的眼睛动了
Dialogue: 0,0:18:42.39,0:18:44.65,单语中字,,0,0,0,,它刚刚在看我们…
Dialogue: 0,0:18:45.13,0:18:46.11,单语中字,,0,0,0,,咦
Dialogue: 0,0:18:46.11,0:18:49.33,单语中字,,0,0,0,,-怎么可能 你看错了吧 -凡不遵守戒律者
Dialogue: 0,0:18:50.13,0:18:51.85,单语中字,,0,0,0,,将无法活着离开此地
Dialogue: 0,0:18:56.55,0:18:58.47,单语中字,,0,0,0,,喂 门关上了
Dialogue: 0,0:18:58.47,0:19:00.29,单语中字,,0,0,0,,咦 为什么
Dialogue: 0,0:19:00.29,0:19:03.03,单语中字,,0,0,0,,我们该不会被困住了吧
Dialogue: 0,0:19:04.31,0:19:06.03,单语中字,,0,0,0,,所以我才说不想来啊
Dialogue: 0,0:19:06.03,0:19:08.63,单语中字,,0,0,0,,你们就是因为太小看地下城 才会变成这样的
Dialogue: 0,0:19:08.63,0:19:11.17,单语中字,,0,0,0,,我们打从一开始就不该来到这里
Dialogue: 0,0:19:11.17,0:19:12.35,单语中字,,0,0,0,,我要回去了
Dialogue: 0,0:19:12.35,0:19:15.33,单语中字,,0,0,0,,管他宝物还是什么鬼的 全都让给你们
Dialogue: 0,0:19:15.79,0:19:16.91,单语中字,,0,0,0,,再见了
Dialogue: 0,0:19:18.21,0:19:19.97,单语中字,,0,0,0,,快离开那里
Dialogue: 0,0:19:36.81,0:19:38.47,单语中字,,0,0,0,,不要
Dialogue: 0,0:19:38.47,0:19:39.15,单语中字,,0,0,0,,不会吧
Dialogue: 0,0:19:39.15,0:19:40.69,单语中字,,0,0,0,,它动了
Dialogue: 0,0:19:40.69,0:19:43.29,单语中字,,0,0,0,,该不会是要我们跟它打吧
Dialogue: 0,0:19:44.85,0:19:47.37,单语中字,,0,0,0,,刚刚被杀的人是哪一级的
Dialogue: 0,0:19:47.37,0:19:48.23,单语中字,,0,0,0,,是D级吗
Dialogue: 0,0:19:48.93,0:19:52.19,单语中字,,0,0,0,,至少绝对比我这个E级还要强吧
Dialogue: 0,0:19:53.57,0:19:56.15,单语中字,,0,0,0,,但他却在瞬间被杀了…
Dialogue: 0,0:19:56.65,0:19:57.89,单语中字,,0,0,0,,太奇怪了吧
Dialogue: 0,0:19:57.89,0:19:59.77,单语中字,,0,0,0,,这里不是D级地下城吗
Dialogue: 0,0:19:59.77,0:20:01.87,单语中字,,0,0,0,,怎么可能会有这种怪物
Dialogue: 0,0:20:02.19,0:20:04.19,单语中字,,0,0,0,,如果石像会动的话…
Dialogue: 0,0:20:04.43,0:20:05.49,单语中字,,0,0,0,,难不成…
Dialogue: 0,0:20:19.39,0:20:23.31,单语中字,,0,0,0,,我至今经历了不少生死关头
Dialogue: 0,0:20:23.93,0:20:27.63,单语中字,,0,0,0,,在初次的突击任务中 跟队伍走散而遇难
Dialogue: 0,0:20:28.03,0:20:31.39,单语中字,,0,0,0,,被E级魔兽打伤 住院好几个星期
Dialogue: 0,0:20:31.91,0:20:34.85,单语中字,,0,0,0,,也曾被关在迷宫中差点饿死
Dialogue: 0,0:20:35.49,0:20:37.39,单语中字,,0,0,0,,就算是低级地下城
Dialogue: 0,0:20:37.87,0:20:39.93,单语中字,,0,0,0,,对我来说也是需要赌命的任务
Dialogue: 0,0:20:41.05,0:20:45.17,单语中字,,0,0,0,,猎人通常会用得到的魔法石 来武装自己
Dialogue: 0,0:20:45.17,0:20:47.25,单语中字,,0,0,0,,得以去打倒更强的魔兽
Dialogue: 0,0:20:47.25,0:20:49.39,单语中字,,0,0,0,,以求获取更高的报酬
Dialogue: 0,0:20:50.01,0:20:52.81,单语中字,,0,0,0,,然而 我顶多就只有一把便宜小刀
Dialogue: 0,0:20:52.81,0:20:55.51,单语中字,,0,0,0,,如果损毁 就只能赤手空拳面对魔兽
Dialogue: 0,0:20:57.61,0:20:59.55,单语中字,,0,0,0,,这双鞋子也不行了吗…
Dialogue: 0,0:21:00.57,0:21:03.81,单语中字,,0,0,0,,就这样日复一日…
Dialogue: 0,0:21:06.61,0:21:08.55,单语中字,,0,0,0,,忍受着他人对我的嘲笑
Dialogue: 0,0:21:08.55,0:21:11.31,单语中字,,0,0,0,,做着这个没什么赚头的赌命工作
Dialogue: 0,0:21:12.05,0:21:14.43,单语中字,,0,0,0,,即便如此 为了活下去 我必须不断寻找破绽
Dialogue: 0,0:21:14.43,0:21:16.91,单语中字,,0,0,0,,用心观察周围的所有一切
Dialogue: 0,0:21:17.91,0:21:19.03,单语中字,,0,0,0,,可能就是因为这样
Dialogue: 0,0:21:19.67,0:21:20.61,单语中字,,0,0,0,,所以我很了解…
Dialogue: 0,0:21:21.09,0:21:22.61,单语中字,,0,0,0,,大家快趴下
Dialogue: 0,0:21:37.79,0:21:38.99,单语中字,,0,0,0,,开什么玩笑
Dialogue: 0,0:21:38.99,0:21:39.81,单语中字,,0,0,0,,我没听说有这个啊
Dialogue: 0,0:21:39.81,0:21:40.93,单语中字,,0,0,0,,到底发生什么事了
Dialogue: 0,0:21:40.93,0:21:42.13,单语中字,,0,0,0,,你问我 我问谁啊
Dialogue: 0,0:21:42.13,0:21:43.33,单语中字,,0,0,0,,没事吧
Dialogue: 0,0:21:43.33,0:21:44.29,单语中字,,0,0,0,,没事
Dialogue: 0,0:21:44.29,0:21:45.55,单语中字,,0,0,0,,真岛先生呢
Dialogue: 0,0:21:45.55,0:21:46.57,单语中字,,0,0,0,,我也没事
Dialogue: 0,0:21:47.01,0:21:49.53,单语中字,,0,0,0,,不要…不要…
Dialogue: 0,0:21:49.99,0:21:52.29,单语中字,,0,0,0,,发生什么事了…
Dialogue: 0,0:21:53.21,0:21:55.13,单语中字,,0,0,0,,为什么事情会变成这样…
Dialogue: 0,0:21:55.85,0:21:57.11,单语中字,,0,0,0,,我们被困住了
Dialogue: 0,0:21:57.11,0:21:58.47,单语中字,,0,0,0,,无路可逃
Dialogue: 0,0:21:58.47,0:22:00.77,单语中字,,0,0,0,,要死了…要死了…
Dialogue: 0,0:22:04.17,0:22:05.43,单语中字,,0,0,0,,会被杀掉
Dialogue: 0,0:22:11.92,0:22:13.89,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}刻骨铭心的记忆 我回忆起
Dialogue: 0,0:22:13.89,0:22:15.68,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}那位背弃诺言的小男孩
Dialogue: 0,0:22:16.00,0:22:18.14,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}如今我四处屠杀
Dialogue: 0,0:22:18.14,0:22:20.27,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}我还得还清账单
Dialogue: 0,0:22:20.27,0:22:22.48,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}明星之路一步登天
Dialogue: 0,0:22:22.48,0:22:24.64,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}其标准也不会无故提高
Dialogue: 0,0:22:24.64,0:22:26.62,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}虚伪的正义
Dialogue: 0,0:22:26.62,0:22:29.04,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}如同无人能够触发的警报
Dialogue: 0,0:22:29.04,0:22:31.33,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}失败之感
Dialogue: 0,0:22:31.33,0:22:33.34,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}莫要将喜怒哀乐一扫而净
Dialogue: 0,0:22:33.34,0:22:36.00,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}发出声音吧
Dialogue: 0,0:22:36.91,0:22:37.98,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}让我们一往无前
Dialogue: 0,0:22:37.98,0:22:39.72,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}所以 付诸一切吧
Dialogue: 0,0:22:39.72,0:22:40.74,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}你要达成
Dialogue: 0,0:22:40.74,0:22:42.40,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}前所未有之高度
Dialogue: 0,0:22:42.40,0:22:43.87,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}所以 付诸一切吧
Dialogue: 0,0:22:43.87,0:22:44.98,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}你要达成
Dialogue: 0,0:22:44.98,0:22:46.37,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}前所未有之高度
Dialogue: 0,0:22:46.37,0:22:48.42,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}你是否将独自行动
Dialogue: 0,0:22:48.42,0:22:49.79,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}你又会得到什么
Dialogue: 0,0:22:49.79,0:22:50.74,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}请宣誓
Dialogue: 0,0:22:50.74,0:22:52.91,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}请你绝不能忘记Solo
Dialogue: 0,0:22:52.91,0:22:54.80,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}你要再创佳绩
Dialogue: 0,0:22:54.80,0:22:56.65,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)} 伸出双手 迎接成功
Dialogue: 0,0:22:56.65,0:22:58.70,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}伸出双手 我接着你
Dialogue: 0,0:22:58.70,0:23:00.85,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}冲破一切 伸出双手
Dialogue: 0,0:23:00.85,0:23:03.34,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}站起来吧 迎接成功
Dialogue: 0,0:23:03.34,0:23:05.20,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}伸出双手 迎接成功
Dialogue: 0,0:23:05.20,0:23:07.32,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}伸出双手 我接着你
Dialogue: 0,0:23:07.32,0:23:09.39,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}伸出双手 迎接成功
Dialogue: 0,0:23:09.39,0:23:12.37,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}为此付出全部努力
Dialogue: 0,0:23:13.98,0:23:16.27,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}游戏结束 但他们令他超越自我
Dialogue: 0,0:23:16.27,0:23:18.42,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}沟里那鼻子流着血的小孩
Dialogue: 0,0:23:18.42,0:23:20.53,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}如今出现他未曾读过的报刊封面
Dialogue: 0,0:23:20.53,0:23:21.57,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}头条新闻
Dialogue: 0,0:23:21.57,0:23:22.48,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}头条新闻
Dialogue: 0,0:23:22.48,0:23:24.72,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}身材健实 可他并未骄傲
Dialogue: 0,0:23:24.72,0:23:26.90,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}本土男孩 从零崛起
Dialogue: 0,0:23:26.90,0:23:29.07,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}每场战斗 我们都会目睹他能量的提升
Dialogue: 0,0:23:29.07,0:23:29.97,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}不断增长
Dialogue: 0,0:23:29.97,0:23:31.10,ED - CN - Vertical,,0,0,0,,{\pos(1840,540)}想赢就去拼
Dialogue: 0,0:22:11.92,0:22:13.89,ED - JP - Vertical,,0,0,0,,{\pos(80,540)}Can't remember to forget
Dialogue: 0,0:22:13.89,0:22:15.68,ED - JP - Vertical,,0,0,0,,{\pos(80,540)}Little boy who lost the bet
Dialogue: 0,0:22:16.00,0:22:18.14,ED - JP - Vertical,,0,0,0,,{\pos(80,540)}Now I'm racking up the kills
Dialogue: 0,0:22:18.14,0:22:20.27,ED - JP - Vertical,,0,0,0,,{\pos(80,540)}I got to pay the bills, the bills
Dialogue: 0,0:22:20.27,0:22:22.48,ED - JP - Vertical,,0,0,0,,{\pos(80,540)}Short cut to be a star
Dialogue: 0,0:22:22.48,0:22:24.64,ED - JP - Vertical,,0,0,0,,{\pos(80,540)}Wasn't born to raise the bar
Dialogue: 0,0:22:24.64,0:22:26.62,ED - JP - Vertical,,0,0,0,,{\pos(80,540)}誤魔化しの正義は

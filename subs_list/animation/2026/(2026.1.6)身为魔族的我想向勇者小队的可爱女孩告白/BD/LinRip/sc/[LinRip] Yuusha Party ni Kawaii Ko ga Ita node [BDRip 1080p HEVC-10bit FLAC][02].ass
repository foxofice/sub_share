Dialogue: 0,0:00:31.82,0:00:33.38,Sousei-JP,,0,0,0,,サンダーボルト
Dialogue: 0,0:00:31.82,0:00:33.38,Sousei-CN,,0,0,0,,天雷爆击
Dialogue: 0,0:00:37.82,0:00:40.02,Sousei-JP,,0,0,0,,コカトリスの羽根を持ち帰ったら
Dialogue: 0,0:00:37.82,0:00:40.02,Sousei-CN,,0,0,0,,把鸡蛇的羽毛带回去后
Dialogue: 0,0:00:40.30,0:00:42.14,Sousei-JP,,0,0,0,,依頼達成だな
Dialogue: 0,0:00:40.30,0:00:42.14,Sousei-CN,,0,0,0,,就完成委托了
Dialogue: 0,0:00:42.54,0:00:45.74,Sousei-JP,,0,0,0,,クレイマンのやつ １週間は かかるって言ってたけど
Dialogue: 0,0:00:42.54,0:00:45.74,Sousei-CN,,0,0,0,,克雷曼那家伙说需要花一个礼拜
Dialogue: 0,0:00:46.44,0:00:47.66,Sousei-JP,,0,0,0,,日帰りで余裕じゃん
Dialogue: 0,0:00:46.44,0:00:47.66,Sousei-CN,,0,0,0,,其实当日来回就足够了
Dialogue: 0,0:00:56.76,0:00:58.56,Sousei-JP,,0,0,0,,シーク 俺だ
Dialogue: 0,0:00:56.76,0:00:58.56,Sousei-CN,,0,0,0,,西克 是我
Dialogue: 0,0:01:00.54,0:01:01.30,Sousei-JP,,0,0,0,,隊長
Dialogue: 0,0:01:00.54,0:01:01.30,Sousei-CN,,0,0,0,,队长
Dialogue: 0,0:01:01.94,0:01:03.56,Sousei-JP,,0,0,0,,よう 元気そうだな
Dialogue: 0,0:01:01.94,0:01:03.56,Sousei-CN,,0,0,0,,哟 你看起来很有精神嘛
Dialogue: 0,0:01:05.00,0:01:06.16,Sousei-JP,,0,0,0,,隊長だ
Dialogue: 0,0:01:05.00,0:01:06.16,Sousei-CN,,0,0,0,,是队长耶
Dialogue: 0,0:01:06.68,0:01:09.79,Sousei-JP,,0,0,0,,魔族を狩りにきた 冒険者かと思ったよ
Dialogue: 0,0:01:06.68,0:01:09.79,Sousei-CN,,0,0,0,,我还以为是来狩猎魔族的冒险家
Dialogue: 0,0:01:10.12,0:01:10.76,Sousei-JP,,0,0,0,,隊長?
Dialogue: 0,0:01:10.12,0:01:10.76,Sousei-CN,,0,0,0,,队长?
Dialogue: 0,0:01:12.10,0:01:12.62,Sousei-JP,,0,0,0,,生きてた
Dialogue: 0,0:01:12.10,0:01:12.62,Sousei-CN,,0,0,0,,还活着
Dialogue: 0,0:01:13.84,0:01:15.55,Sousei-JP,,0,0,0,,ハピネス デューク
Dialogue: 0,0:01:13.84,0:01:15.55,Sousei-CN,,0,0,0,,幸福 公爵
Dialogue: 0,0:01:15.74,0:01:17.14,Sousei-JP,,0,0,0,,お前らも無事だったんだな
Dialogue: 0,0:01:15.74,0:01:17.14,Sousei-CN,,0,0,0,,你们也平安无事啊
Dialogue: 0,0:01:17.62,0:01:19.18,Sousei-JP,,0,0,0,,隊長
Dialogue: 0,0:01:17.62,0:01:19.18,Sousei-CN,,0,0,0,,队长
Dialogue: 0,0:01:18.28,0:01:19.18,Sousei-JP,,0,0,0,,{\an8}はい
Dialogue: 0,0:01:18.28,0:01:19.18,Sousei-CN,,0,0,0,,{\an8}是
Dialogue: 0,0:01:19.18,0:01:21.01,Sousei-JP,,0,0,0,,今まで どこにいたんすか
Dialogue: 0,0:01:19.18,0:01:21.01,Sousei-CN,,0,0,0,,迄今为止你都到哪里去了
Dialogue: 0,0:01:21.01,0:01:21.67,Sousei-JP,,0,0,0,,{\an8}えっ ミネル
Dialogue: 0,0:01:21.01,0:01:21.67,Sousei-CN,,0,0,0,,{\an8}欸 在王都
Dialogue: 0,0:01:21.58,0:01:22.86,Sousei-JP,,0,0,0,,突然 いなくなるし
Dialogue: 0,0:01:21.58,0:01:22.86,Sousei-CN,,0,0,0,,你突然不见人影
Dialogue: 0,0:01:22.86,0:01:24.52,Sousei-JP,,0,0,0,,魔王様は倒されるしで
Dialogue: 0,0:01:22.86,0:01:24.52,Sousei-CN,,0,0,0,,魔王大人又被打倒了
Dialogue: 0,0:01:24.52,0:01:26.36,Sousei-JP,,0,0,0,,心配してたっすよ
Dialogue: 0,0:01:24.52,0:01:26.36,Sousei-CN,,0,0,0,,我们很担心
Dialogue: 0,0:01:26.36,0:01:27.70,Sousei-JP,,0,0,0,,{\an8}あっ それは訳がある
Dialogue: 0,0:01:26.36,0:01:27.70,Sousei-CN,,0,0,0,,{\an8}啊 那个是有原因的
Dialogue: 0,0:01:26.36,0:01:28.86,Sousei-JP,,0,0,0,,そんな 人間みたいな姿になって
Dialogue: 0,0:01:26.36,0:01:28.86,Sousei-CN,,0,0,0,,还有你怎么变得像人类一样
Dialogue: 0,0:01:28.86,0:01:31.01,Sousei-JP,,0,0,0,,角と翼は どうしたんすか
Dialogue: 0,0:01:28.86,0:01:31.01,Sousei-CN,,0,0,0,,你的角和翅膀到哪去了
Dialogue: 0,0:01:31.01,0:01:33.06,Sousei-JP,,0,0,0,,今 話すから 落ち着け
Dialogue: 0,0:01:31.01,0:01:33.06,Sousei-CN,,0,0,0,,我现在就解释 你先冷静
Dialogue: 0,0:01:35.36,0:01:39.66,Sousei-JP,,0,0,0,,隊長いなくなって デューク兄 心配してたもんね
Dialogue: 0,0:01:35.36,0:01:39.66,Sousei-CN,,0,0,0,,队长突然不见 公爵哥很担心嘛
Dialogue: 0,0:01:39.66,0:01:41.84,Sousei-JP,,0,0,0,,余計なこと 言わなくていいっす
Dialogue: 0,0:01:39.66,0:01:41.84,Sousei-CN,,0,0,0,,你不用说这些多余的事
Dialogue: 0,0:01:42.36,0:01:43.00,Sousei-JP,,0,0,0,,隊長
Dialogue: 0,0:01:42.36,0:01:43.00,Sousei-CN,,0,0,0,,队长
Dialogue: 0,0:01:43.86,0:01:44.60,Sousei-JP,,0,0,0,,説明
Dialogue: 0,0:01:43.86,0:01:44.60,Sousei-CN,,0,0,0,,解释
Dialogue: 0,0:01:48.62,0:01:50.16,Sousei-JP,,0,0,0,,隊長こと ヨウキは
Dialogue: 0,0:01:48.62,0:01:50.16,Sousei-CN,,0,0,0,,我队长阳树
Dialogue: 0,0:01:50.16,0:01:53.21,Sousei-JP,,0,0,0,,勇者パーティーの僧侶に告白して
Dialogue: 0,0:01:50.16,0:01:53.21,Sousei-CN,,0,0,0,,和勇者团队的僧侣告白
Dialogue: 0,0:01:53.84,0:01:54.52,Sousei-JP,,0,0,0,,フラれて
Dialogue: 0,0:01:53.84,0:01:54.52,Sousei-CN,,0,0,0,,然后被拒绝
Dialogue: 0,0:01:55.62,0:01:57.80,Sousei-JP,,0,0,0,,今は人間として 冒険者やってる
Dialogue: 0,0:01:55.62,0:01:57.80,Sousei-CN,,0,0,0,,现在以人类的身分在当冒险家
Dialogue: 0,0:01:58.62,0:01:59.45,Sousei-JP,,0,0,0,,魔族の
Dialogue: 0,0:01:58.62,0:01:59.45,Sousei-CN,,0,0,0,,魔族的
Dialogue: 0,0:01:59.45,0:02:00.62,Sousei-JP,,0,0,0,,隊長が
Dialogue: 0,0:01:59.45,0:02:00.62,Sousei-CN,,0,0,0,,队长
Dialogue: 0,0:02:00.62,0:02:01.34,Sousei-JP,,0,0,0,,人間
Dialogue: 0,0:02:00.62,0:02:01.34,Sousei-CN,,0,0,0,,当人类
Dialogue: 0,0:02:02.70,0:02:05.38,Sousei-JP,,0,0,0,,俺はもう 人間のヨウキとして生活しているんだ
Dialogue: 0,0:02:02.70,0:02:05.38,Sousei-CN,,0,0,0,,我现在以人类阳树的身分生活
Dialogue: 0,0:02:06.30,0:02:07.54,Sousei-JP,,0,0,0,,お前たちも好きに生きろ
Dialogue: 0,0:02:06.30,0:02:07.54,Sousei-CN,,0,0,0,,你们也去过自己喜欢的生活吧
Dialogue: 0,0:02:08.32,0:02:08.64,Sousei-JP,,0,0,0,,いいな
Dialogue: 0,0:02:08.32,0:02:08.64,Sousei-CN,,0,0,0,,可以吗
Dialogue: 0,0:02:10.54,0:02:11.00,Sousei-JP,,0,0,0,,嫌っす
Dialogue: 0,0:02:10.54,0:02:11.00,Sousei-CN,,0,0,0,,不要
Dialogue: 0,0:02:12.18,0:02:12.61,Sousei-JP,,0,0,0,,いや
Dialogue: 0,0:02:12.18,0:02:12.61,Sousei-CN,,0,0,0,,不要
Dialogue: 0,0:02:12.61,0:02:13.92,Sousei-JP,,0,0,0,,僕も やだ
Dialogue: 0,0:02:12.61,0:02:13.92,Sousei-CN,,0,0,0,,我也不要
Dialogue: 0,0:02:13.92,0:02:15.97,Sousei-JP,,0,0,0,,隊長に ついていくっす
Dialogue: 0,0:02:13.92,0:02:15.97,Sousei-CN,,0,0,0,,我要追随队长
Dialogue: 0,0:02:16.52,0:02:19.57,Sousei-JP,,0,0,0,,隊長が惚れた人間に ちゃんと会ってみたいっすし
Dialogue: 0,0:02:16.52,0:02:19.57,Sousei-CN,,0,0,0,,我也想看看队长喜欢上的人类
Dialogue: 0,0:02:19.57,0:02:23.01,Sousei-JP,,0,0,0,,無理だって 人間の世界なんだぞ
Dialogue: 0,0:02:19.57,0:02:23.01,Sousei-CN,,0,0,0,,不行的啊 那可是人类的世界
Dialogue: 0,0:02:23.01,0:02:24.99,Sousei-JP,,0,0,0,,正体も隠さなきゃいけないし
Dialogue: 0,0:02:23.01,0:02:24.99,Sousei-CN,,0,0,0,,必须隐藏自己的身分才行
Dialogue: 0,0:02:25.17,0:02:27.71,Sousei-JP,,0,0,0,,隊長にできるなら俺たちだって
Dialogue: 0,0:02:25.17,0:02:27.71,Sousei-CN,,0,0,0,,队长可以 我们当然也可以
Dialogue: 0,0:02:27.71,0:02:29.16,Sousei-JP,,0,0,0,,大丈夫だよ
Dialogue: 0,0:02:27.71,0:02:29.16,Sousei-CN,,0,0,0,,没问题啦
Dialogue: 0,0:02:29.16,0:02:30.50,Sousei-JP,,0,0,0,,余裕
Dialogue: 0,0:02:29.16,0:02:30.50,Sousei-CN,,0,0,0,,轻而易举
Dialogue: 0,0:02:32.76,0:02:34.61,Sousei-JP,,0,0,0,,そこまで言うんなら お前ら
Dialogue: 0,0:02:32.76,0:02:34.61,Sousei-CN,,0,0,0,,既然你们都这么说了
Dialogue: 0,0:02:34.61,0:02:38.57,Sousei-JP,,0,0,0,,覚悟はできてるんだろうな
Dialogue: 0,0:02:34.61,0:02:38.57,Sousei-CN,,0,0,0,,那做好觉悟了吧
Dialogue: 0,0:04:11.16,0:04:13.11,Sousei-JP,,0,0,0,,最低ですね
Dialogue: 0,0:04:11.16,0:04:13.11,Sousei-CN,,0,0,0,,你真的很糟糕
Dialogue: 0,0:04:13.11,0:04:14.98,Sousei-JP,,0,0,0,,女の子に なんてことを
Dialogue: 0,0:04:13.11,0:04:14.98,Sousei-CN,,0,0,0,,看你对女孩子做了什么
Dialogue: 0,0:04:15.37,0:04:17.82,Sousei-JP,,0,0,0,,いくら人に変装するためとはいえ
Dialogue: 0,0:04:15.37,0:04:17.82,Sousei-CN,,0,0,0,,就算要变装成人类
Dialogue: 0,0:04:17.82,0:04:20.71,Sousei-JP,,0,0,0,,ハーピーの羽をすべて 抜いてしまうなんて
Dialogue: 0,0:04:17.82,0:04:20.71,Sousei-CN,,0,0,0,,把哈比的羽毛全部拔光什么的
Dialogue: 0,0:04:20.71,0:04:22.27,Sousei-JP,,0,0,0,,おっしゃるとおりです
Dialogue: 0,0:04:20.71,0:04:22.27,Sousei-CN,,0,0,0,,您说得没错
Dialogue: 0,0:04:22.27,0:04:23.77,Sousei-JP,,0,0,0,,俺が バカでした
Dialogue: 0,0:04:22.27,0:04:23.77,Sousei-CN,,0,0,0,,是我太蠢了
Dialogue: 0,0:04:23.77,0:04:25.49,Sousei-JP,,0,0,0,,反省してください
Dialogue: 0,0:04:23.77,0:04:25.49,Sousei-CN,,0,0,0,,请好好反省
Dialogue: 0,0:04:27.22,0:04:28.48,Sousei-JP,,0,0,0,,優しい
Dialogue: 0,0:04:27.22,0:04:28.48,Sousei-CN,,0,0,0,,好温柔
Dialogue: 0,0:04:32.77,0:04:36.25,Sousei-JP,,0,0,0,,皆さん ヨウキさんの元部下というお話ですが
Dialogue: 0,0:04:32.77,0:04:36.25,Sousei-CN,,0,0,0,,我听说大家原本都是阳树先生的部下
Dialogue: 0,0:04:36.42,0:04:38.32,Sousei-JP,,0,0,0,,魔族には見えませんね
Dialogue: 0,0:04:36.42,0:04:38.32,Sousei-CN,,0,0,0,,但看不出来都是魔族
Dialogue: 0,0:04:36.88,0:04:38.32,Sousei-JP,,0,0,0,,{\an8}待って待って
Dialogue: 0,0:04:36.88,0:04:38.32,Sousei-CN,,0,0,0,,{\an8}等等 别跑
Dialogue: 0,0:04:38.32,0:04:39.56,Sousei-JP,,0,0,0,,本当っすよ
Dialogue: 0,0:04:38.32,0:04:39.56,Sousei-CN,,0,0,0,,是真的
Dialogue: 0,0:04:39.56,0:04:40.96,Sousei-JP,,0,0,0,,俺がデュラハン
Dialogue: 0,0:04:39.56,0:04:40.96,Sousei-CN,,0,0,0,,我是无头骑士
Dialogue: 0,0:04:40.96,0:04:42.42,Sousei-JP,,0,0,0,,ハピネスがハーピーで
Dialogue: 0,0:04:40.96,0:04:42.42,Sousei-CN,,0,0,0,,幸福是哈比
Dialogue: 0,0:04:42.42,0:04:44.00,Sousei-JP,,0,0,0,,シークがピクシーっす
Dialogue: 0,0:04:42.42,0:04:44.00,Sousei-CN,,0,0,0,,西克是皮克西
Dialogue: 0,0:04:44.27,0:04:46.36,Sousei-JP,,0,0,0,,首を外してお見せしたいっすけど
Dialogue: 0,0:04:44.27,0:04:46.36,Sousei-CN,,0,0,0,,虽然我很想把头拿下来给你看
Dialogue: 0,0:04:46.77,0:04:49.07,Sousei-JP,,0,0,0,,鎧と兜をくっつけちゃいましたからね
Dialogue: 0,0:04:46.77,0:04:49.07,Sousei-CN,,0,0,0,,但铠甲和头盔已经连在一起了
Dialogue: 0,0:04:49.46,0:04:50.92,Sousei-JP,,0,0,0,,そうなんですか
Dialogue: 0,0:04:49.46,0:04:50.92,Sousei-CN,,0,0,0,,这样啊
Dialogue: 0,0:04:50.92,0:04:54.61,Sousei-JP,,0,0,0,,デューク お前はおしゃべりでデュラハンっぽくないんだよ
Dialogue: 0,0:04:50.92,0:04:54.61,Sousei-CN,,0,0,0,,公爵 你话太多就不像无头骑士了
Dialogue: 0,0:04:54.61,0:04:56.01,Sousei-JP,,0,0,0,,昔は無口だったろ
Dialogue: 0,0:04:54.61,0:04:56.01,Sousei-CN,,0,0,0,,你以前不是话很少吗
Dialogue: 0,0:04:56.26,0:04:58.27,Sousei-JP,,0,0,0,,それは 隊長のせいっすよ
Dialogue: 0,0:04:56.26,0:04:58.27,Sousei-CN,,0,0,0,,还不都是队长的错
Dialogue: 0,0:04:59.06,0:05:02.32,Sousei-JP,,0,0,0,,最初は 隊長のこと嫌いだったんすけどね
Dialogue: 0,0:04:59.06,0:05:02.32,Sousei-CN,,0,0,0,,一开始 我很讨厌队长
Dialogue: 0,0:05:02.32,0:05:03.53,Sousei-JP,,0,0,0,,どうしてです
Dialogue: 0,0:05:02.32,0:05:03.53,Sousei-CN,,0,0,0,,这是为什么呢
Dialogue: 0,0:05:05.03,0:05:08.62,Sousei-JP,,0,0,0,,隊長は引きこもりで有名だったっすからね
Dialogue: 0,0:05:05.03,0:05:08.62,Sousei-CN,,0,0,0,,因为队长是个有名的家里蹲
Dialogue: 0,0:05:08.62,0:05:10.40,Sousei-JP,,0,0,0,,上官のザエキル様から
Dialogue: 0,0:05:08.62,0:05:10.40,Sousei-CN,,0,0,0,,就算上司札耶奇尔
Dialogue: 0,0:05:10.74,0:05:14.04,Sousei-JP,,0,0,0,,出撃して人間を襲えって命じられた時も
Dialogue: 0,0:05:10.74,0:05:14.04,Sousei-CN,,0,0,0,,命令他去袭击人类
Dialogue: 0,0:05:14.82,0:05:16.87,Sousei-JP,,0,0,0,,この部屋から出たほうがいい
Dialogue: 0,0:05:14.82,0:05:16.87,Sousei-CN,,0,0,0,,你最好快点离开这个房间
Dialogue: 0,0:05:17.29,0:05:20.87,Sousei-JP,,0,0,0,,俺が俺でなくなる前にな
Dialogue: 0,0:05:17.29,0:05:20.87,Sousei-CN,,0,0,0,,趁我还保持着自我之前
Dialogue: 0,0:05:20.87,0:05:22.66,Sousei-JP,,0,0,0,,ザエキル様いわく
Dialogue: 0,0:05:20.87,0:05:22.66,Sousei-CN,,0,0,0,,札耶奇尔大人说
Dialogue: 0,0:05:22.66,0:05:25.05,Sousei-JP,,0,0,0,,「ヨウキと話すと疲れる」って
Dialogue: 0,0:05:22.66,0:05:25.05,Sousei-CN,,0,0,0,,「和阳树说话太累了」
Dialogue: 0,0:05:26.16,0:05:29.30,Sousei-JP,,0,0,0,,それ以降ほっとかれたらしいっす
Dialogue: 0,0:05:26.16,0:05:29.30,Sousei-CN,,0,0,0,,那之后就没管他了
Dialogue: 0,0:05:30.06,0:05:32.62,Sousei-JP,,0,0,0,,そんなの 魔族としてありえないっすから
Dialogue: 0,0:05:30.06,0:05:32.62,Sousei-CN,,0,0,0,,但那根本就不是魔族该有的样子
Dialogue: 0,0:05:32.62,0:05:35.81,Sousei-JP,,0,0,0,,俺が力づくで隊長を正してやろうとしたっす
Dialogue: 0,0:05:32.62,0:05:35.81,Sousei-CN,,0,0,0,,所以我打算靠力量 去矫正队长的态度
Dialogue: 0,0:05:36.16,0:05:40.80,Sousei-JP,,0,0,0,,でも 返り討ちにされて いろいろ吹き込まれて
Dialogue: 0,0:05:36.16,0:05:40.80,Sousei-CN,,0,0,0,,可我反被教训 还被灌输了不少观念
Dialogue: 0,0:05:42.51,0:05:44.32,Sousei-JP,,0,0,0,,今の俺になったっす
Dialogue: 0,0:05:42.51,0:05:44.32,Sousei-CN,,0,0,0,,变成现在的我了
Dialogue: 0,0:05:44.58,0:05:48.26,Sousei-JP,,0,0,0,,今は ヨウキさんのことずいぶん 慕っているんですね
Dialogue: 0,0:05:44.58,0:05:48.26,Sousei-CN,,0,0,0,,你现在很爱戴阳树先生吧
Dialogue: 0,0:05:48.26,0:05:49.92,Sousei-JP,,0,0,0,,否定はしないっす
Dialogue: 0,0:05:48.26,0:05:49.92,Sousei-CN,,0,0,0,,我不否认这点
Dialogue: 0,0:05:49.92,0:05:51.00,Sousei-JP,,0,0,0,,ハピネスや シークも
Dialogue: 0,0:05:49.92,0:05:51.00,Sousei-CN,,0,0,0,,幸福和西克也
Dialogue: 0,0:05:51.74,0:05:52.06,Sousei-JP,,0,0,0,,あれ
Dialogue: 0,0:05:51.74,0:05:52.06,Sousei-CN,,0,0,0,,咦
Dialogue: 0,0:05:52.86,0:05:54.08,Sousei-JP,,0,0,0,,２人 どこ行った
Dialogue: 0,0:05:52.86,0:05:54.08,Sousei-CN,,0,0,0,,他们到哪去了
Dialogue: 0,0:05:54.08,0:05:56.75,Sousei-JP,,0,0,0,,まさか 屋敷のほうっすかね
Dialogue: 0,0:05:54.08,0:05:56.75,Sousei-CN,,0,0,0,,该不会跑去宅邸那里了吧
Dialogue: 0,0:05:56.75,0:05:58.02,Sousei-JP,,0,0,0,,あいつら
Dialogue: 0,0:05:56.75,0:05:58.02,Sousei-CN,,0,0,0,,他们两个
Dialogue: 0,0:05:58.02,0:06:01.02,Sousei-JP,,0,0,0,,セシリア以外に正体が バレたら まずいこと
Dialogue: 0,0:05:58.02,0:06:01.02,Sousei-CN,,0,0,0,,万一被赛西莉亚以外的人 发现真实身分就麻烦了
Dialogue: 0,0:06:01.02,0:06:02.75,Sousei-JP,,0,0,0,,わかってるよな
Dialogue: 0,0:06:01.02,0:06:02.75,Sousei-CN,,0,0,0,,他们应该知道吧
Dialogue: 0,0:06:03.91,0:06:07.12,Sousei-JP,,0,0,0,,ハピネス シーク
Dialogue: 0,0:06:03.91,0:06:07.12,Sousei-CN,,0,0,0,,幸福 西克
Dialogue: 0,0:06:07.12,0:06:08.76,Sousei-JP,,0,0,0,,どこ行ったっすか
Dialogue: 0,0:06:07.12,0:06:08.76,Sousei-CN,,0,0,0,,你们在哪里
Dialogue: 0,0:06:16.31,0:06:17.47,Sousei-JP,,0,0,0,,シーク
Dialogue: 0,0:06:16.31,0:06:17.47,Sousei-CN,,0,0,0,,西克
Dialogue: 0,0:06:17.47,0:06:20.67,Sousei-JP,,0,0,0,,あら この子はヨウキくんのお知り合い
Dialogue: 0,0:06:17.47,0:06:20.67,Sousei-CN,,0,0,0,,哎呀 这孩子是阳树认识的人吗
Dialogue: 0,0:06:21.67,0:06:22.82,Sousei-JP,,0,0,0,,友達です
Dialogue: 0,0:06:21.67,0:06:22.82,Sousei-CN,,0,0,0,,他是我朋友
Dialogue: 0,0:06:22.82,0:06:23.91,Sousei-JP,,0,0,0,,そうだったのね
Dialogue: 0,0:06:22.82,0:06:23.91,Sousei-CN,,0,0,0,,这样啊
Dialogue: 0,0:06:23.91,0:06:25.90,Sousei-JP,,0,0,0,,すみません そいつ
Dialogue: 0,0:06:23.91,0:06:25.90,Sousei-CN,,0,0,0,,对不起 他
Dialogue: 0,0:06:25.90,0:06:28.27,Sousei-JP,,0,0,0,,迷惑かけたりしませんでしたか
Dialogue: 0,0:06:25.90,0:06:28.27,Sousei-CN,,0,0,0,,有没有给您添麻烦呢
Dialogue: 0,0:06:28.72,0:06:32.42,Sousei-JP,,0,0,0,,大丈夫よ 私 子どもは好きだから
Dialogue: 0,0:06:28.72,0:06:32.42,Sousei-CN,,0,0,0,,放心吧 我很喜欢小孩子
Dialogue: 0,0:06:32.42,0:06:36.66,Sousei-JP,,0,0,0,,さっきまで 庭を走り回ってたから相手をしてたんだけど
Dialogue: 0,0:06:32.42,0:06:36.66,Sousei-CN,,0,0,0,,刚才他在庭院里跑来跑去 所以我就陪他玩了一下
Dialogue: 0,0:06:36.66,0:06:38.62,Sousei-JP,,0,0,0,,遊び疲れて 寝ちゃったわ
Dialogue: 0,0:06:36.66,0:06:38.62,Sousei-CN,,0,0,0,,看样子他是玩累睡着了
Dialogue: 0,0:06:39.01,0:06:43.40,Sousei-JP,,0,0,0,,お母様 シークくんと一緒に 女の子がいませんでしたか
Dialogue: 0,0:06:39.01,0:06:43.40,Sousei-CN,,0,0,0,,母亲 您有没有看见 和西克在一起的女孩子
Dialogue: 0,0:06:43.92,0:06:45.38,Sousei-JP,,0,0,0,,えぇ その子なら
Dialogue: 0,0:06:43.92,0:06:45.38,Sousei-CN,,0,0,0,,那位女孩子啊
Dialogue: 0,0:06:45.61,0:06:48.08,Sousei-JP,,0,0,0,,ソフィアが連れていったけど
Dialogue: 0,0:06:45.61,0:06:48.08,Sousei-CN,,0,0,0,,被苏菲雅带走了
Dialogue: 0,0:06:50.16,0:06:52.39,Sousei-JP,,0,0,0,,あなた 筋がいいですね
Dialogue: 0,0:06:50.16,0:06:52.39,Sousei-CN,,0,0,0,,你很有天分呢
Dialogue: 0,0:06:52.67,0:06:54.92,Sousei-JP,,0,0,0,,その角度を忘れないように
Dialogue: 0,0:06:52.67,0:06:54.92,Sousei-CN,,0,0,0,,记住这个角度 别忘了
Dialogue: 0,0:06:56.17,0:06:57.36,Sousei-JP,,0,0,0,,承知
Dialogue: 0,0:06:56.17,0:06:57.36,Sousei-CN,,0,0,0,,好的
Dialogue: 0,0:06:57.97,0:06:59.22,Sousei-JP,,0,0,0,,ソフィアさん
Dialogue: 0,0:06:57.97,0:06:59.22,Sousei-CN,,0,0,0,,苏菲雅
Dialogue: 0,0:06:59.61,0:07:01.52,Sousei-JP,,0,0,0,,お嬢様に ヨウキ様
Dialogue: 0,0:06:59.61,0:07:01.52,Sousei-CN,,0,0,0,,大小姐 阳树先生
Dialogue: 0,0:07:01.72,0:07:03.77,Sousei-JP,,0,0,0,,新人メイドのハピネスです
Dialogue: 0,0:07:01.72,0:07:03.77,Sousei-CN,,0,0,0,,这位是新来的女仆幸福
Dialogue: 0,0:07:03.77,0:07:05.66,Sousei-JP,,0,0,0,,以後 お見知りおきを
Dialogue: 0,0:07:03.77,0:07:05.66,Sousei-CN,,0,0,0,,以后还请多指教
Dialogue: 0,0:07:06.17,0:07:06.78,Sousei-JP,,0,0,0,,よろ
Dialogue: 0,0:07:06.17,0:07:06.78,Sousei-CN,,0,0,0,,指教
Dialogue: 0,0:07:06.96,0:07:09.52,Sousei-JP,,0,0,0,,幸福 你为什么打扮成女仆
Dialogue: 0,0:07:06.96,0:07:09.52,Sousei-CN,,0,0,0,,幸福 你为什么打扮成女仆
Dialogue: 0,0:07:09.52,0:07:13.66,Sousei-JP,,0,0,0,,ソフィアさん その方は ヨウキさんのご友人ですよ
Dialogue: 0,0:07:09.52,0:07:13.66,Sousei-CN,,0,0,0,,苏菲雅 她是阳树先生的朋友
Dialogue: 0,0:07:13.66,0:07:15.17,Sousei-JP,,0,0,0,,そうなのですか
Dialogue: 0,0:07:13.66,0:07:15.17,Sousei-CN,,0,0,0,,是这样吗
Dialogue: 0,0:07:16.17,0:07:17.24,Sousei-JP,,0,0,0,,事実
Dialogue: 0,0:07:16.17,0:07:17.24,Sousei-CN,,0,0,0,,是事实
Dialogue: 0,0:07:17.47,0:07:19.51,Sousei-JP,,0,0,0,,申し訳ございません
Dialogue: 0,0:07:17.47,0:07:19.51,Sousei-CN,,0,0,0,,非常抱歉
Dialogue: 0,0:07:19.51,0:07:22.82,Sousei-JP,,0,0,0,,てっきり 今日 来る予定の新人かと
Dialogue: 0,0:07:19.51,0:07:22.82,Sousei-CN,,0,0,0,,我以为她是今天预计来报到的新人
Dialogue: 0,0:07:22.82,0:07:25.75,Sousei-JP,,0,0,0,,いえ こちらこそお騒がせしました
Dialogue: 0,0:07:22.82,0:07:25.75,Sousei-CN,,0,0,0,,不 我才抱歉 给你添麻烦了
Dialogue: 0,0:07:26.11,0:07:28.72,Sousei-JP,,0,0,0,,ほら ハピネスも着替えた 着替えた
Dialogue: 0,0:07:26.11,0:07:28.72,Sousei-CN,,0,0,0,,好了 幸福你也赶快去换衣服吧
Dialogue: 0,0:07:29.96,0:07:30.86,Sousei-JP,,0,0,0,,拒绝
Dialogue: 0,0:07:29.96,0:07:30.86,Sousei-CN,,0,0,0,,拒绝
Dialogue: 0,0:07:32.72,0:07:35.01,Sousei-JP,,0,0,0,,就職 熱望
Dialogue: 0,0:07:32.72,0:07:35.01,Sousei-CN,,0,0,0,,就职 渴望
Dialogue: 0,0:07:35.92,0:07:38.02,Sousei-JP,,0,0,0,,お前メイドになりたいのか
Dialogue: 0,0:07:35.92,0:07:38.02,Sousei-CN,,0,0,0,,你想当女仆吗
Dialogue: 0,0:07:41.66,0:07:44.77,Sousei-JP,,0,0,0,,使用人宿舎の案内がまだでしたね
Dialogue: 0,0:07:41.66,0:07:44.77,Sousei-CN,,0,0,0,,我还没带你去看仆人的宿舍吧
Dialogue: 0,0:07:49.72,0:07:52.57,Sousei-JP,,0,0,0,,それじゃあ ハピネスも頑張るっすよ
Dialogue: 0,0:07:49.72,0:07:52.57,Sousei-CN,,0,0,0,,那么幸福你加油喔
Dialogue: 0,0:07:52.57,0:07:56.03,Sousei-JP,,0,0,0,,いいなこのお屋敷で暮らすんだ
Dialogue: 0,0:07:52.57,0:07:56.03,Sousei-CN,,0,0,0,,好好喔 你可以住在这栋房子里
Dialogue: 0,0:07:56.26,0:07:57.27,Sousei-JP,,0,0,0,,努力
Dialogue: 0,0:07:56.26,0:07:57.27,Sousei-CN,,0,0,0,,努力
Dialogue: 0,0:07:57.27,0:07:59.79,Sousei-JP,,0,0,0,,また いつでも遊びにいらっしゃい
Dialogue: 0,0:07:57.27,0:07:59.79,Sousei-CN,,0,0,0,,欢迎随时来玩喔
Dialogue: 0,0:07:59.79,0:08:00.96,Sousei-JP,,0,0,0,,やった
Dialogue: 0,0:07:59.79,0:08:00.96,Sousei-CN,,0,0,0,,好耶
Dialogue: 0,0:08:00.96,0:08:02.41,Sousei-JP,,0,0,0,,ヨウキくん
Dialogue: 0,0:08:00.96,0:08:02.41,Sousei-CN,,0,0,0,,阳树
Dialogue: 0,0:08:00.96,0:08:04.12,Sousei-JP,,0,0,0,,{\an8}またソフィアさんの甘い飲みたい
Dialogue: 0,0:08:00.96,0:08:04.12,Sousei-CN,,0,0,0,,{\an8}我想再喝苏菲雅泡的甜甜的茶
Dialogue: 0,0:08:02.41,0:08:03.20,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:08:02.41,0:08:03.20,Sousei-CN,,0,0,0,,是
Dialogue: 0,0:08:04.17,0:08:07.37,Sousei-JP,,0,0,0,,あの子ね 僧侶の仕事に加えて
Dialogue: 0,0:08:04.17,0:08:07.37,Sousei-CN,,0,0,0,,我女儿 除了僧侣的工作
Dialogue: 0,0:08:04.17,0:08:07.37,Sousei-CN,,0,0,0,,{\an8}西克 你客气点
Dialogue: 0,0:08:07.37,0:08:10.66,Sousei-JP,,0,0,0,,勇者パーティーとして 偉い方とのおつきあいもあるから
Dialogue: 0,0:08:07.37,0:08:10.66,Sousei-CN,,0,0,0,,还得以勇者团队成员身分 和重要人物交流
Dialogue: 0,0:08:10.66,0:08:13.01,Sousei-JP,,0,0,0,,最近 ろくに休んでないの
Dialogue: 0,0:08:10.66,0:08:13.01,Sousei-CN,,0,0,0,,最近都没什么休息
Dialogue: 0,0:08:10.66,0:08:13.01,Sousei-CN,,0,0,0,,{\an8}没关系 我也经常喝好几杯呢
Dialogue: 0,0:08:13.01,0:08:15.87,Sousei-JP,,0,0,0,,明日１日 お休みを取らせるから
Dialogue: 0,0:08:13.01,0:08:15.87,Sousei-CN,,0,0,0,,明天我会让她休假一天
Dialogue: 0,0:08:13.01,0:08:15.87,Sousei-CN,,0,0,0,,{\an8}大小姐还是少喝点好
Dialogue: 0,0:08:15.87,0:08:18.36,Sousei-JP,,0,0,0,,一緒に遊んであげてほしいのよ
Dialogue: 0,0:08:15.87,0:08:18.36,Sousei-CN,,0,0,0,,希望你能陪陪她
Dialogue: 0,0:08:15.87,0:08:18.36,Sousei-CN,,0,0,0,,{\an8}为什么
Dialogue: 0,0:08:22.96,0:08:26.37,Sousei-JP,,0,0,0,,これって 親公認のデートってことだよな
Dialogue: 0,0:08:22.96,0:08:26.37,Sousei-CN,,0,0,0,,这算是被父母公认的约会吧
Dialogue: 0,0:08:37.42,0:08:40.32,Sousei-JP,,0,0,0,,ヨウキさん お待たせしました
Dialogue: 0,0:08:37.42,0:08:40.32,Sousei-CN,,0,0,0,,阳树先生 让你久等了
Dialogue: 0,0:08:40.83,0:08:42.96,Sousei-JP,,0,0,0,,いつもと違う格好
Dialogue: 0,0:08:40.83,0:08:42.96,Sousei-CN,,0,0,0,,跟平常的打扮不一样
Dialogue: 0,0:08:42.96,0:08:44.25,Sousei-JP,,0,0,0,,すごく いい
Dialogue: 0,0:08:42.96,0:08:44.25,Sousei-CN,,0,0,0,,非常好看
Dialogue: 0,0:08:44.86,0:08:46.01,Sousei-JP,,0,0,0,,ヨウキさん?
Dialogue: 0,0:08:44.86,0:08:46.01,Sousei-CN,,0,0,0,,阳树先生?
Dialogue: 0,0:08:46.61,0:08:49.75,Sousei-JP,,0,0,0,,えっと 眼鏡 似合ってるね
Dialogue: 0,0:08:46.61,0:08:49.75,Sousei-CN,,0,0,0,,那个 眼镜 很适合你
Dialogue: 0,0:08:49.96,0:08:51.86,Sousei-JP,,0,0,0,,これは 変装用です
Dialogue: 0,0:08:49.96,0:08:51.86,Sousei-CN,,0,0,0,,这是变装用的眼镜
Dialogue: 0,0:08:51.86,0:08:55.47,Sousei-JP,,0,0,0,,勇者パーティーの一員だとバレると大変ですから
Dialogue: 0,0:08:51.86,0:08:55.47,Sousei-CN,,0,0,0,,万一被发现 我是勇者团队的成员就麻烦了
Dialogue: 0,0:08:55.86,0:08:59.42,Sousei-JP,,0,0,0,,なるほど 有名人は 大変だな
Dialogue: 0,0:08:55.86,0:08:59.42,Sousei-CN,,0,0,0,,原来如此 名人还真辛苦
Dialogue: 0,0:08:59.42,0:09:02.66,Sousei-JP,,0,0,0,,すみません ヨウキさんまでつきあわせてしまって
Dialogue: 0,0:08:59.42,0:09:02.66,Sousei-CN,,0,0,0,,不好意思 还让你陪我
Dialogue: 0,0:09:02.66,0:09:03.62,Sousei-JP,,0,0,0,,全然
Dialogue: 0,0:09:02.66,0:09:03.62,Sousei-CN,,0,0,0,,怎么会
Dialogue: 0,0:09:03.62,0:09:07.02,Sousei-JP,,0,0,0,,今日はいい休みになるよう 協力するよ
Dialogue: 0,0:09:03.62,0:09:07.02,Sousei-CN,,0,0,0,,我会协助你 让你今天好好地休假
Dialogue: 0,0:09:08.36,0:09:10.97,Sousei-JP,,0,0,0,,それじゃ期待しちゃいますね
Dialogue: 0,0:09:08.36,0:09:10.97,Sousei-CN,,0,0,0,,那我就好好期待了
Dialogue: 0,0:09:19.76,0:09:22.66,Sousei-JP,,0,0,0,,新作のケーキですよ ヨウキさん
Dialogue: 0,0:09:19.76,0:09:22.66,Sousei-CN,,0,0,0,,是新出的蛋糕 阳树先生
Dialogue: 0,0:09:25.47,0:09:30.00,Sousei-JP,,0,0,0,,見てくださいかわいいケーキが いっぱいですね
Dialogue: 0,0:09:25.47,0:09:30.00,Sousei-CN,,0,0,0,,你看 有好多可爱的蛋糕
Dialogue: 0,0:09:30.36,0:09:32.37,Sousei-JP,,0,0,0,,あとで ここでお茶しましょう
Dialogue: 0,0:09:30.36,0:09:32.37,Sousei-CN,,0,0,0,,之后我们在这里喝下午茶吧
Dialogue: 0,0:09:32.37,0:09:32.76,Sousei-JP,,0,0,0,,うん
Dialogue: 0,0:09:32.37,0:09:32.76,Sousei-CN,,0,0,0,,嗯
Dialogue: 0,0:09:35.52,0:09:36.76,Sousei-JP,,0,0,0,,きれい
Dialogue: 0,0:09:35.52,0:09:36.76,Sousei-CN,,0,0,0,,好漂亮
Dialogue: 0,0:09:38.12,0:09:40.87,Sousei-JP,,0,0,0,,君のほうが きれいだよ
Dialogue: 0,0:09:38.12,0:09:40.87,Sousei-CN,,0,0,0,,你更漂亮哦
Dialogue: 0,0:09:50.87,0:09:52.18,Sousei-JP,,0,0,0,,かわいいですね
Dialogue: 0,0:09:50.87,0:09:52.18,Sousei-CN,,0,0,0,,很可爱吧
Dialogue: 0,0:09:52.77,0:09:55.37,Sousei-JP,,0,0,0,,はい かわいいです
Dialogue: 0,0:09:52.77,0:09:55.37,Sousei-CN,,0,0,0,,对 很可爱
Dialogue: 0,0:09:55.37,0:09:56.74,Sousei-JP,,0,0,0,,ヨウキさん?
Dialogue: 0,0:09:55.37,0:09:56.74,Sousei-CN,,0,0,0,,阳树先生?
Dialogue: 0,0:10:01.56,0:10:03.02,Sousei-JP,,0,0,0,,どうですか
Dialogue: 0,0:10:01.56,0:10:03.02,Sousei-CN,,0,0,0,,怎么样
Dialogue: 0,0:10:03.02,0:10:04.51,Sousei-JP,,0,0,0,,最高
Dialogue: 0,0:10:03.02,0:10:04.51,Sousei-CN,,0,0,0,,很棒
Dialogue: 0,0:10:04.92,0:10:09.46,Sousei-JP,,0,0,0,,今日は ヨウキさんのおかげで日ごろの疲れが飛んでいくようです
Dialogue: 0,0:10:04.92,0:10:09.46,Sousei-CN,,0,0,0,,多亏今天有阳树先生 让我平常累积的疲劳都消失了
Dialogue: 0,0:10:09.46,0:10:10.32,Sousei-JP,,0,0,0,,本当
Dialogue: 0,0:10:09.46,0:10:10.32,Sousei-CN,,0,0,0,,真的吗
Dialogue: 0,0:10:10.32,0:10:11.06,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:10:10.32,0:10:11.06,Sousei-CN,,0,0,0,,真的
Dialogue: 0,0:10:11.06,0:10:12.07,Sousei-JP,,0,0,0,,よし
Dialogue: 0,0:10:11.06,0:10:12.07,Sousei-CN,,0,0,0,,好耶
Dialogue: 0,0:10:16.16,0:10:17.84,Sousei-JP,,0,0,0,,アクセサリーか
Dialogue: 0,0:10:16.16,0:10:17.84,Sousei-CN,,0,0,0,,首饰啊
Dialogue: 0,0:10:18.27,0:10:19.36,Sousei-JP,,0,0,0,,入ってみる
Dialogue: 0,0:10:18.27,0:10:19.36,Sousei-CN,,0,0,0,,要进去看看吗
Dialogue: 0,0:10:19.36,0:10:20.27,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:10:19.36,0:10:20.27,Sousei-CN,,0,0,0,,好
Dialogue: 0,0:10:21.22,0:10:23.37,Sousei-JP,,0,0,0,,あれ セシリア
Dialogue: 0,0:10:21.22,0:10:23.37,Sousei-CN,,0,0,0,,咦 赛西莉亚
Dialogue: 0,0:10:23.77,0:10:26.06,Sousei-JP,,0,0,0,,は～い セシリ
Dialogue: 0,0:10:23.77,0:10:26.06,Sousei-CN,,0,0,0,,嗨 赛西莉
Dialogue: 0,0:10:26.06,0:10:27.56,Sousei-JP,,0,0,0,,バカユウガ
Dialogue: 0,0:10:26.06,0:10:27.56,Sousei-CN,,0,0,0,,笨蛋悠贺
Dialogue: 0,0:10:27.56,0:10:30.71,Sousei-JP,,0,0,0,,名前 呼んだら 周りの人に バレるでしょ
Dialogue: 0,0:10:27.56,0:10:30.71,Sousei-CN,,0,0,0,,叫出名字的话 不就被周围的人发现了吗
Dialogue: 0,0:10:30.71,0:10:33.57,Sousei-JP,,0,0,0,,勇者様 ミカナさん
Dialogue: 0,0:10:30.71,0:10:33.57,Sousei-CN,,0,0,0,,勇者大人 米卡娜
Dialogue: 0,0:10:33.57,0:10:35.76,Sousei-JP,,0,0,0,,いや ごめん ごめん
Dialogue: 0,0:10:33.57,0:10:35.76,Sousei-CN,,0,0,0,,抱歉抱歉
Dialogue: 0,0:10:35.76,0:10:37.57,Sousei-JP,,0,0,0,,セシリアは どうして ここに
Dialogue: 0,0:10:35.76,0:10:37.57,Sousei-CN,,0,0,0,,赛西莉亚你怎么会在这里
Dialogue: 0,0:10:37.57,0:10:41.28,Sousei-JP,,0,0,0,,僕たちは 久しぶりに休みをとって遊びにきてるんだけど
Dialogue: 0,0:10:37.57,0:10:41.28,Sousei-CN,,0,0,0,,我们是因为好久没休假 所以就出来玩了
Dialogue: 0,0:10:41.47,0:10:44.21,Sousei-JP,,0,0,0,,よかったらセシリアも一緒にどう
Dialogue: 0,0:10:41.47,0:10:44.21,Sousei-CN,,0,0,0,,方便的话 你要不要一起啊
Dialogue: 0,0:10:44.21,0:10:47.29,Sousei-JP,,0,0,0,,おいおい まさか俺のこと見えてない
Dialogue: 0,0:10:44.21,0:10:47.29,Sousei-CN,,0,0,0,,先生 你该不会没看见我吧
Dialogue: 0,0:10:47.29,0:10:50.91,Sousei-JP,,0,0,0,,すみません 今日は友人がいますので
Dialogue: 0,0:10:47.29,0:10:50.91,Sousei-CN,,0,0,0,,不好意思 今天我和朋友在一起
Dialogue: 0,0:10:50.91,0:10:52.04,Sousei-JP,,0,0,0,,友人
Dialogue: 0,0:10:50.91,0:10:52.04,Sousei-CN,,0,0,0,,朋友
Dialogue: 0,0:10:55.05,0:10:57.51,Sousei-JP,,0,0,0,,君 どこかで会ったかな
Dialogue: 0,0:10:55.05,0:10:57.51,Sousei-CN,,0,0,0,,我好像在哪见过你
Dialogue: 0,0:10:58.27,0:11:00.27,Sousei-JP,,0,0,0,,き 気のせいじゃないか
Dialogue: 0,0:10:58.27,0:11:00.27,Sousei-CN,,0,0,0,,你 你看错了吧
Dialogue: 0,0:11:02.30,0:11:05.32,Sousei-JP,,0,0,0,,まぁ いいや 彼も一緒に遊ぼうよ
Dialogue: 0,0:11:02.30,0:11:05.32,Sousei-CN,,0,0,0,,算了 他也跟我们一起去玩吧
Dialogue: 0,0:11:05.71,0:11:07.66,Sousei-JP,,0,0,0,,このお店に 入るところだったよね
Dialogue: 0,0:11:05.71,0:11:07.66,Sousei-CN,,0,0,0,,你想进这间店对吧
Dialogue: 0,0:11:07.66,0:11:08.71,Sousei-JP,,0,0,0,,行こう
Dialogue: 0,0:11:07.66,0:11:08.71,Sousei-CN,,0,0,0,,走吧
Dialogue: 0,0:11:08.71,0:11:10.12,Sousei-JP,,0,0,0,,あの
Dialogue: 0,0:11:08.71,0:11:10.12,Sousei-CN,,0,0,0,,那个
Dialogue: 0,0:11:08.71,0:11:10.12,Sousei-JP,,0,0,0,,{\an8}ちょっ
Dialogue: 0,0:11:08.71,0:11:10.12,Sousei-CN,,0,0,0,,{\an8}喂
Dialogue: 0,0:11:11.11,0:11:12.17,Sousei-JP,,0,0,0,,まったく
Dialogue: 0,0:11:11.11,0:11:12.17,Sousei-CN,,0,0,0,,真是的
Dialogue: 0,0:11:12.17,0:11:15.52,Sousei-JP,,0,0,0,,ユウガと久々のデートだったのにとんだ災難よ
Dialogue: 0,0:11:12.17,0:11:15.52,Sousei-CN,,0,0,0,,好不容易和悠贺约会 却遭了这种无妄之灾
Dialogue: 0,0:11:15.91,0:11:18.03,Sousei-JP,,0,0,0,,そこの冴えない顔の一般人
Dialogue: 0,0:11:15.91,0:11:18.03,Sousei-CN,,0,0,0,,站在那里意志消沉的普通人
Dialogue: 0,0:11:19.32,0:11:21.62,Sousei-JP,,0,0,0,,僧侶と うまくいくといいわね
Dialogue: 0,0:11:19.32,0:11:21.62,Sousei-CN,,0,0,0,,希望你能和僧侣进展顺利
Dialogue: 0,0:11:22.52,0:11:24.81,Sousei-JP,,0,0,0,,そっちも デートだったんでしょ
Dialogue: 0,0:11:22.52,0:11:24.81,Sousei-CN,,0,0,0,,你不是也在约会吗
Dialogue: 0,0:11:24.81,0:11:27.16,Sousei-JP,,0,0,0,,少なくとも 俺は そのつもり
Dialogue: 0,0:11:24.81,0:11:27.16,Sousei-CN,,0,0,0,,至少我是这么想的
Dialogue: 0,0:11:27.16,0:11:29.00,Sousei-JP,,0,0,0,,せいぜい 頑張ってちょうだい
Dialogue: 0,0:11:27.16,0:11:29.42,Sousei-CN,,0,0,0,,那就好好加油吧
Dialogue: 0,0:11:29.42,0:11:33.77,Sousei-JP,,0,0,0,,そうすれば ユウガも僧侶を諦めてくれるかもしれないから
Dialogue: 0,0:11:29.42,0:11:33.77,Sousei-CN,,0,0,0,,这样或许悠贺就会放弃僧侣
Dialogue: 0,0:11:35.12,0:11:37.00,Sousei-JP,,0,0,0,,案外 いいやつなのか
Dialogue: 0,0:11:35.12,0:11:37.00,Sousei-CN,,0,0,0,,没想到她人还挺好的
Dialogue: 0,0:11:37.00,0:11:40.67,Sousei-JP,,0,0,0,,まっ あんたの冴えない顔じゃ期待できないけど
Dialogue: 0,0:11:37.00,0:11:40.67,Sousei-CN,,0,0,0,,不过我对你那寒酸长相 不期待就是了
Dialogue: 0,0:11:41.72,0:11:44.26,Sousei-JP,,0,0,0,,やっぱり 性格悪い
Dialogue: 0,0:11:41.72,0:11:44.26,Sousei-CN,,0,0,0,,果然性格很糟糕
Dialogue: 0,0:11:45.92,0:11:50.07,Sousei-JP,,0,0,0,,勇者くんは セシリアに結婚を断られたって聞いたけど
Dialogue: 0,0:11:45.92,0:11:50.07,Sousei-CN,,0,0,0,,我听说勇者的求婚已经被赛西莉亚拒绝了
Dialogue: 0,0:11:45.92,0:11:50.07,Sousei-CN,,0,0,0,,{\an8}你有带钱包吧
Dialogue: 0,0:11:50.07,0:11:51.69,Sousei-JP,,0,0,0,,まだ 気があるってことか
Dialogue: 0,0:11:50.07,0:11:51.69,Sousei-CN,,0,0,0,,难道他还没放弃吗
Dialogue: 0,0:11:52.46,0:11:55.15,Sousei-JP,,0,0,0,,イケメン勇者だからって負けてたまるか
Dialogue: 0,0:11:52.46,0:11:55.15,Sousei-CN,,0,0,0,,我才不会输给帅哥勇者呢
Dialogue: 0,0:11:59.12,0:12:00.32,Sousei-JP,,0,0,0,,いいの 見つかった
Dialogue: 0,0:11:59.12,0:12:00.32,Sousei-CN,,0,0,0,,看到喜欢的了吗
Dialogue: 0,0:12:00.32,0:12:01.56,Sousei-JP,,0,0,0,,ヨウキさん
Dialogue: 0,0:12:00.32,0:12:01.56,Sousei-CN,,0,0,0,,阳树先生
Dialogue: 0,0:12:01.56,0:12:03.78,Sousei-JP,,0,0,0,,すみません置いていってしまって
Dialogue: 0,0:12:01.56,0:12:03.78,Sousei-CN,,0,0,0,,不好意思 把你丢在一旁
Dialogue: 0,0:12:03.96,0:12:06.46,Sousei-JP,,0,0,0,,せっかくだし 何か プレゼントするよ
Dialogue: 0,0:12:03.96,0:12:06.46,Sousei-CN,,0,0,0,,机会难得 让我送个礼物给你吧
Dialogue: 0,0:12:06.92,0:12:09.02,Sousei-JP,,0,0,0,,でも いいんですか
Dialogue: 0,0:12:06.92,0:12:09.02,Sousei-CN,,0,0,0,,这样好吗
Dialogue: 0,0:12:09.02,0:12:11.72,Sousei-JP,,0,0,0,,いいの いいの この前のお礼だから
Dialogue: 0,0:12:09.02,0:12:11.72,Sousei-CN,,0,0,0,,当然好 也算是为之前的事给你的谢礼
Dialogue: 0,0:12:12.11,0:12:15.07,Sousei-JP,,0,0,0,,では ここは お言葉に甘えますね
Dialogue: 0,0:12:12.11,0:12:15.07,Sousei-CN,,0,0,0,,那么我就恭敬不如从命了
Dialogue: 0,0:12:15.92,0:12:17.42,Sousei-JP,,0,0,0,,いいね
Dialogue: 0,0:12:15.92,0:12:17.42,Sousei-CN,,0,0,0,,不错耶
Dialogue: 0,0:12:17.42,0:12:20.22,Sousei-JP,,0,0,0,,僕も ミカナとセシリアに 何か選ぶよ
Dialogue: 0,0:12:17.42,0:12:20.22,Sousei-CN,,0,0,0,,我也来帮米卡娜和赛西莉亚选礼物吧
Dialogue: 0,0:12:20.22,0:12:22.12,Sousei-JP,,0,0,0,,どれにしようかな
Dialogue: 0,0:12:20.22,0:12:22.12,Sousei-CN,,0,0,0,,选哪个好呢
Dialogue: 0,0:12:22.12,0:12:23.76,Sousei-JP,,0,0,0,,俺に張り合ってるのか
Dialogue: 0,0:12:22.12,0:12:23.76,Sousei-CN,,0,0,0,,他是在跟我争吗
Dialogue: 0,0:12:27.10,0:12:27.68,Sousei-JP,,0,0,0,,セシリア
Dialogue: 0,0:12:27.10,0:12:27.68,Sousei-CN,,0,0,0,,赛西莉亚
Dialogue: 0,0:12:28.20,0:12:28.58,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:12:28.20,0:12:28.58,Sousei-CN,,0,0,0,,在
Dialogue: 0,0:12:29.70,0:12:30.42,Sousei-JP,,0,0,0,,これ いいかも
Dialogue: 0,0:12:29.70,0:12:30.42,Sousei-CN,,0,0,0,,我觉得这个不错
Dialogue: 0,0:12:32.26,0:12:35.35,Sousei-JP,,0,0,0,,きれい すごく ステキです
Dialogue: 0,0:12:32.26,0:12:35.35,Sousei-CN,,0,0,0,,好漂亮 很好看
Dialogue: 0,0:12:35.54,0:12:36.87,Sousei-JP,,0,0,0,,セシリア
Dialogue: 0,0:12:35.54,0:12:36.87,Sousei-CN,,0,0,0,,赛西莉亚
Dialogue: 0,0:12:36.87,0:12:39.61,Sousei-JP,,0,0,0,,僕が選んだ この髪飾りは どう
Dialogue: 0,0:12:36.87,0:12:39.61,Sousei-CN,,0,0,0,,你觉得我选的发饰怎么样
Dialogue: 0,0:12:39.61,0:12:42.57,Sousei-JP,,0,0,0,,この店で いちばん高価なんだって
Dialogue: 0,0:12:39.61,0:12:42.57,Sousei-CN,,0,0,0,,是这间店里最贵的饰品喔
Dialogue: 0,0:12:42.86,0:12:45.57,Sousei-JP,,0,0,0,,高けりゃいいってもんじゃないだろ
Dialogue: 0,0:12:42.86,0:12:45.57,Sousei-CN,,0,0,0,,东西不是越贵越好好吗
Dialogue: 0,0:12:45.57,0:12:48.28,Sousei-JP,,0,0,0,,さぁ 僕がつけてあげるよ
Dialogue: 0,0:12:45.57,0:12:48.28,Sousei-CN,,0,0,0,,来 我帮你戴上吧
Dialogue: 0,0:12:50.62,0:12:51.16,Sousei-JP,,0,0,0,,って おい
Dialogue: 0,0:12:50.62,0:12:51.16,Sousei-CN,,0,0,0,,喂
Dialogue: 0,0:12:51.54,0:12:52.20,Sousei-JP,,0,0,0,,バカ
Dialogue: 0,0:12:51.54,0:12:52.20,Sousei-CN,,0,0,0,,笨蛋
Dialogue: 0,0:12:52.56,0:12:54.90,Sousei-JP,,0,0,0,,あれ セシリア様じゃないか
Dialogue: 0,0:12:52.56,0:12:54.90,Sousei-CN,,0,0,0,,咦 那不是赛西莉亚大人吗
Dialogue: 0,0:12:55.41,0:12:57.57,Sousei-JP,,0,0,0,,横にいるのは 勇者様よ
Dialogue: 0,0:12:55.41,0:12:57.57,Sousei-CN,,0,0,0,,旁边的是勇者大人
Dialogue: 0,0:12:57.57,0:12:59.52,Sousei-JP,,0,0,0,,ミカナ様もいるじゃない
Dialogue: 0,0:12:57.57,0:12:59.52,Sousei-CN,,0,0,0,,米卡娜大人也在
Dialogue: 0,0:12:59.52,0:13:01.71,Sousei-JP,,0,0,0,,それと 誰だ あいつ
Dialogue: 0,0:12:59.52,0:13:01.71,Sousei-CN,,0,0,0,,还有 那个人是谁啊
Dialogue: 0,0:13:02.48,0:13:03.12,Sousei-JP,,0,0,0,,勇者様
Dialogue: 0,0:13:02.48,0:13:03.12,Sousei-CN,,0,0,0,,勇者大人
Dialogue: 0,0:13:03.12,0:13:04.36,Sousei-JP,,0,0,0,,セシリア様
Dialogue: 0,0:13:03.12,0:13:04.36,Sousei-CN,,0,0,0,,赛西莉亚大人
Dialogue: 0,0:13:04.36,0:13:05.66,Sousei-JP,,0,0,0,,ユウガのバカ
Dialogue: 0,0:13:04.36,0:13:05.66,Sousei-CN,,0,0,0,,悠贺大笨蛋
Dialogue: 0,0:13:04.36,0:13:05.66,Sousei-CN,,0,0,0,,{\an8}米卡娜大人
Dialogue: 0,0:13:05.66,0:13:07.80,Sousei-JP,,0,0,0,,とりあえず お店を出ましょう
Dialogue: 0,0:13:05.66,0:13:07.80,Sousei-CN,,0,0,0,,总之我们先离开这间店吧
Dialogue: 0,0:13:12.57,0:13:13.97,Sousei-JP,,0,0,0,,ったく
Dialogue: 0,0:13:12.57,0:13:13.97,Sousei-CN,,0,0,0,,真是的
Dialogue: 0,0:13:23.00,0:13:25.98,Sousei-JP,,0,0,0,,セシリア 早く見つけないと
Dialogue: 0,0:13:23.00,0:13:25.98,Sousei-CN,,0,0,0,,我得快点找到赛西莉亚才行
Dialogue: 0,0:13:27.06,0:13:29.20,Sousei-JP,,0,0,0,,レイヴン様
Dialogue: 0,0:13:27.06,0:13:29.20,Sousei-CN,,0,0,0,,渡鸦大人
Dialogue: 0,0:13:29.62,0:13:33.45,Sousei-JP,,0,0,0,,どっかで 見たことあるような気がするな あのイケメン
Dialogue: 0,0:13:29.62,0:13:33.45,Sousei-CN,,0,0,0,,好像在哪见过啊 那位帅哥
Dialogue: 0,0:13:33.66,0:13:35.06,Sousei-JP,,0,0,0,,知らないのか
Dialogue: 0,0:13:33.66,0:13:35.06,Sousei-CN,,0,0,0,,你不知道吗
Dialogue: 0,0:13:35.06,0:13:37.50,Sousei-JP,,0,0,0,,元勇者パーティーの剣士であり
Dialogue: 0,0:13:35.06,0:13:37.50,Sousei-CN,,0,0,0,,他是之前勇者团队的剑士
Dialogue: 0,0:13:37.50,0:13:41.46,Sousei-JP,,0,0,0,,今は 騎士団長に就任されているレイヴン様だよ
Dialogue: 0,0:13:37.50,0:13:41.46,Sousei-CN,,0,0,0,,现在是骑士团团长的渡鸦大人
Dialogue: 0,0:13:43.26,0:13:45.77,Sousei-JP,,0,0,0,,あの無口な剣士くんか
Dialogue: 0,0:13:43.26,0:13:45.77,Sousei-CN,,0,0,0,,是那位话不多的剑士啊
Dialogue: 0,0:13:48.21,0:13:51.43,Sousei-JP,,0,0,0,,なんか こっちも困ってるみたいだな
Dialogue: 0,0:13:48.21,0:13:51.43,Sousei-CN,,0,0,0,,他看起来好像也很困扰的样子
Dialogue: 0,0:13:52.56,0:13:55.31,Sousei-JP,,0,0,0,,あっちに勇者様がいるぞ
Dialogue: 0,0:13:52.56,0:13:55.31,Sousei-CN,,0,0,0,,那边有勇者大人在
Dialogue: 0,0:13:55.31,0:13:58.02,Sousei-JP,,0,0,0,,勇者様
Dialogue: 0,0:13:55.31,0:13:58.02,Sousei-CN,,0,0,0,,勇者大人
Dialogue: 0,0:13:59.08,0:14:01.21,Sousei-JP,,0,0,0,,おい 今のうちに逃げるぞ
Dialogue: 0,0:13:59.08,0:14:01.21,Sousei-CN,,0,0,0,,喂 趁现在快逃吧
Dialogue: 0,0:14:03.05,0:14:04.94,Sousei-JP,,0,0,0,,ここまで来れば 大丈夫だろ
Dialogue: 0,0:14:03.05,0:14:04.94,Sousei-CN,,0,0,0,,到这里应该没问题了吧
Dialogue: 0,0:14:07.16,0:14:09.47,Sousei-JP,,0,0,0,,感謝の言葉はなしか
Dialogue: 0,0:14:07.16,0:14:09.47,Sousei-CN,,0,0,0,,没有说什么感谢的话啊
Dialogue: 0,0:14:09.47,0:14:10.41,Sousei-JP,,0,0,0,,再见
Dialogue: 0,0:14:09.47,0:14:10.41,Sousei-CN,,0,0,0,,じゃあな
Dialogue: 0,0:14:10.82,0:14:12.64,Sousei-JP,,0,0,0,,今度からは変装して歩けよ
Dialogue: 0,0:14:10.82,0:14:12.64,Sousei-CN,,0,0,0,,下次记得变装一下再出门
Dialogue: 0,0:14:13.24,0:14:14.46,Sousei-JP,,0,0,0,,ま 待って
Dialogue: 0,0:14:13.24,0:14:14.46,Sousei-CN,,0,0,0,,等 等一下
Dialogue: 0,0:14:16.10,0:14:17.94,Sousei-JP,,0,0,0,,今 話しかけたのって
Dialogue: 0,0:14:16.10,0:14:17.94,Sousei-CN,,0,0,0,,你刚才在跟我说话吗
Dialogue: 0,0:14:19.38,0:14:22.64,Sousei-JP,,0,0,0,,まさか その声が原因で話さなかったりするのか
Dialogue: 0,0:14:19.38,0:14:22.64,Sousei-CN,,0,0,0,,该不会是因为声音的关系 你才不怎么开口说话吧
Dialogue: 0,0:14:23.90,0:14:24.20,Sousei-JP,,0,0,0,,あぁ
Dialogue: 0,0:14:23.90,0:14:24.20,Sousei-CN,,0,0,0,,嗯
Dialogue: 0,0:14:25.62,0:14:28.47,Sousei-JP,,0,0,0,,お前は バカにしないのか
Dialogue: 0,0:14:25.62,0:14:28.47,Sousei-CN,,0,0,0,,你不会嘲笑我吗
Dialogue: 0,0:14:28.98,0:14:31.14,Sousei-JP,,0,0,0,,男らしく ないだろ
Dialogue: 0,0:14:28.98,0:14:31.14,Sousei-CN,,0,0,0,,一点都不 男子汉吧
Dialogue: 0,0:14:32.26,0:14:34.94,Sousei-JP,,0,0,0,,誰にだって触れられたくないことはあるよ
Dialogue: 0,0:14:32.26,0:14:34.94,Sousei-CN,,0,0,0,,每个人都有不想被碰触的事
Dialogue: 0,0:14:35.56,0:14:37.85,Sousei-JP,,0,0,0,,俺の正体が魔族だってこととか
Dialogue: 0,0:14:35.56,0:14:37.85,Sousei-CN,,0,0,0,,就像我的真实身分是魔族之类的
Dialogue: 0,0:14:38.60,0:14:40.04,Sousei-JP,,0,0,0,,お前は 変わってるな
Dialogue: 0,0:14:38.60,0:14:40.04,Sousei-CN,,0,0,0,,你好特别
Dialogue: 0,0:14:40.68,0:14:42.26,Sousei-JP,,0,0,0,,笑うやつが ほとんどなのに
Dialogue: 0,0:14:40.68,0:14:42.26,Sousei-CN,,0,0,0,,大家通常都会嘲笑我
Dialogue: 0,0:14:43.52,0:14:44.61,Sousei-JP,,0,0,0,,笑わないよ
Dialogue: 0,0:14:43.52,0:14:44.61,Sousei-CN,,0,0,0,,没什么好笑的
Dialogue: 0,0:14:44.61,0:14:46.12,Sousei-JP,,0,0,0,,それとも 笑ってほしいのか
Dialogue: 0,0:14:44.61,0:14:46.12,Sousei-CN,,0,0,0,,还是你希望我嘲笑你
Dialogue: 0,0:14:48.01,0:14:48.48,Sousei-JP,,0,0,0,,いや
Dialogue: 0,0:14:48.01,0:14:48.48,Sousei-CN,,0,0,0,,不
Dialogue: 0,0:14:50.06,0:14:51.86,Sousei-JP,,0,0,0,,じゃ 俺は このへんで
Dialogue: 0,0:14:50.06,0:14:51.86,Sousei-CN,,0,0,0,,那我先走了
Dialogue: 0,0:14:51.86,0:14:53.99,Sousei-JP,,0,0,0,,ま 待ってくれ
Dialogue: 0,0:14:51.86,0:14:53.99,Sousei-CN,,0,0,0,,等 等一下
Dialogue: 0,0:14:54.36,0:14:59.25,Sousei-JP,,0,0,0,,あの 俺と その と 友達になってくれないか
Dialogue: 0,0:14:54.36,0:14:59.25,Sousei-CN,,0,0,0,,那个可以请你 和我当朋友吗
Dialogue: 0,0:15:01.21,0:15:03.75,Sousei-JP,,0,0,0,,いや 迷惑ならいいんだ
Dialogue: 0,0:15:01.21,0:15:03.75,Sousei-CN,,0,0,0,,不 如果你觉得很困扰的话就算了
Dialogue: 0,0:15:03.75,0:15:06.26,Sousei-JP,,0,0,0,,その 声のこと笑わなかったのは
Dialogue: 0,0:15:03.75,0:15:06.26,Sousei-CN,,0,0,0,,因为不会嘲笑我声音的人
Dialogue: 0,0:15:06.26,0:15:08.51,Sousei-JP,,0,0,0,,母さんと従兄弟くらいだったからつい
Dialogue: 0,0:15:06.26,0:15:08.51,Sousei-CN,,0,0,0,,只有我母亲和表兄弟 所以就
Dialogue: 0,0:15:09.51,0:15:11.46,Sousei-JP,,0,0,0,,いいよ 俺は ヨウキ
Dialogue: 0,0:15:09.51,0:15:11.46,Sousei-CN,,0,0,0,,好啊 我是阳树
Dialogue: 0,0:15:11.46,0:15:12.96,Sousei-JP,,0,0,0,,これから よろしくな
Dialogue: 0,0:15:11.46,0:15:12.96,Sousei-CN,,0,0,0,,以后还请多指教
Dialogue: 0,0:15:13.76,0:15:15.96,Sousei-JP,,0,0,0,,本当か ありがとう
Dialogue: 0,0:15:13.76,0:15:15.96,Sousei-CN,,0,0,0,,真的吗 谢谢你
Dialogue: 0,0:15:15.96,0:15:17.31,Sousei-JP,,0,0,0,,俺は レイヴンだ
Dialogue: 0,0:15:15.96,0:15:17.31,Sousei-CN,,0,0,0,,我是渡鸦
Dialogue: 0,0:15:17.31,0:15:18.76,Sousei-JP,,0,0,0,,こちらこそ よろしく
Dialogue: 0,0:15:17.31,0:15:18.76,Sousei-CN,,0,0,0,,我才要请你多指教
Dialogue: 0,0:15:19.51,0:15:22.98,Sousei-JP,,0,0,0,,ヤバい こんなことしてる場合じゃない
Dialogue: 0,0:15:19.51,0:15:22.98,Sousei-CN,,0,0,0,,糟糕 我没空在这里闲晃了
Dialogue: 0,0:15:23.42,0:15:25.36,Sousei-JP,,0,0,0,,ごめん またな
Dialogue: 0,0:15:23.42,0:15:25.36,Sousei-CN,,0,0,0,,抱歉 再见
Dialogue: 0,0:15:29.46,0:15:32.20,Sousei-JP,,0,0,0,,セシリア どこ行ったんだ
Dialogue: 0,0:15:29.46,0:15:32.20,Sousei-CN,,0,0,0,,赛西莉亚 她到哪去了
Dialogue: 0,0:15:33.56,0:15:35.35,Sousei-JP,,0,0,0,,初デートだったのに
Dialogue: 0,0:15:33.56,0:15:35.35,Sousei-CN,,0,0,0,,明明是第一次约会
Dialogue: 0,0:15:38.06,0:15:41.61,Sousei-JP,,0,0,0,,ヨウキさん もう帰ってしまったんでしょうか
Dialogue: 0,0:15:38.06,0:15:41.61,Sousei-CN,,0,0,0,,阳树先生已经回去了吗
Dialogue: 0,0:15:42.86,0:15:44.53,Sousei-JP,,0,0,0,,痛いよ
Dialogue: 0,0:15:42.86,0:15:44.53,Sousei-CN,,0,0,0,,好痛
Dialogue: 0,0:15:45.01,0:15:47.56,Sousei-JP,,0,0,0,,お母さん
Dialogue: 0,0:15:45.01,0:15:47.56,Sousei-CN,,0,0,0,,妈妈
Dialogue: 0,0:15:47.96,0:15:49.76,Sousei-JP,,0,0,0,,どうしましたか
Dialogue: 0,0:15:47.96,0:15:49.76,Sousei-CN,,0,0,0,,怎么了吗
Dialogue: 0,0:15:50.36,0:15:52.97,Sousei-JP,,0,0,0,,まずは 痛いの治しましょうね
Dialogue: 0,0:15:50.36,0:15:52.97,Sousei-CN,,0,0,0,,我先帮你治好痛痛的地方吧
Dialogue: 0,0:15:55.76,0:15:58.16,Sousei-JP,,0,0,0,,お母さんが一緒だったのですか
Dialogue: 0,0:15:55.76,0:15:58.16,Sousei-CN,,0,0,0,,你妈妈跟你在一起吗
Dialogue: 0,0:15:58.66,0:16:00.42,Sousei-JP,,0,0,0,,いなくなっちゃった
Dialogue: 0,0:15:58.66,0:16:00.42,Sousei-CN,,0,0,0,,妈妈不见了
Dialogue: 0,0:16:01.96,0:16:04.07,Sousei-JP,,0,0,0,,だ 大丈夫ですよ
Dialogue: 0,0:16:01.96,0:16:04.07,Sousei-CN,,0,0,0,,没 没有关系的
Dialogue: 0,0:16:08.61,0:16:11.36,Sousei-JP,,0,0,0,,泣きやむのだ そこのお子様よ
Dialogue: 0,0:16:08.61,0:16:11.36,Sousei-CN,,0,0,0,,那边的小孩子 不要哭了
Dialogue: 0,0:16:12.12,0:16:14.28,Sousei-JP,,0,0,0,,この 冒険者 ヨウキ様が
Dialogue: 0,0:16:12.12,0:16:14.28,Sousei-CN,,0,0,0,,我冒险家阳树大人
Dialogue: 0,0:16:14.46,0:16:18.52,Sousei-JP,,0,0,0,,草の根分けてでも お前の母親を見つけてやろう
Dialogue: 0,0:16:14.46,0:16:18.52,Sousei-CN,,0,0,0,,会不惜一切代价 帮你找到你母亲的
Dialogue: 0,0:16:23.41,0:16:24.56,Sousei-JP,,0,0,0,,ヨウキさん
Dialogue: 0,0:16:23.41,0:16:24.56,Sousei-CN,,0,0,0,,阳树先生
Dialogue: 0,0:16:24.56,0:16:25.17,Sousei-JP,,0,0,0,,はい
Dialogue: 0,0:16:24.56,0:16:25.17,Sousei-CN,,0,0,0,,是
Dialogue: 0,0:16:25.42,0:16:28.17,Sousei-JP,,0,0,0,,何やってるんですか あなたは
Dialogue: 0,0:16:25.42,0:16:28.17,Sousei-CN,,0,0,0,,你在干什么啊
Dialogue: 0,0:16:28.36,0:16:30.45,Sousei-JP,,0,0,0,,いや これは 厨二ではなく
Dialogue: 0,0:16:28.36,0:16:30.45,Sousei-CN,,0,0,0,,不 我不是在耍中二
Dialogue: 0,0:16:30.45,0:16:32.87,Sousei-JP,,0,0,0,,子ども向けの鉄板といいますか
Dialogue: 0,0:16:30.45,0:16:32.87,Sousei-CN,,0,0,0,,该说这是哄小孩的一种招式吗
Dialogue: 0,0:16:34.89,0:16:37.31,Sousei-JP,,0,0,0,,お兄ちゃん 怒られてる
Dialogue: 0,0:16:34.89,0:16:37.31,Sousei-CN,,0,0,0,,大哥哥被骂了
Dialogue: 0,0:16:42.06,0:16:44.71,Sousei-JP,,0,0,0,,この子のお母さん 探してま～す
Dialogue: 0,0:16:42.06,0:16:44.71,Sousei-CN,,0,0,0,,我们在找这位小朋友的妈妈
Dialogue: 0,0:16:44.71,0:16:47.36,Sousei-JP,,0,0,0,,お母様はいらっしゃいませんか
Dialogue: 0,0:16:44.71,0:16:47.36,Sousei-CN,,0,0,0,,这位小朋友的妈妈在吗
Dialogue: 0,0:16:47.52,0:16:51.52,Sousei-JP,,0,0,0,,なぁ セシリアだけ 先に帰ったほうがいいんじゃないか
Dialogue: 0,0:16:47.52,0:16:51.52,Sousei-CN,,0,0,0,,赛西莉亚 你要不要先回去
Dialogue: 0,0:16:51.91,0:16:53.57,Sousei-JP,,0,0,0,,あんまり 目立つと また
Dialogue: 0,0:16:51.91,0:16:53.57,Sousei-CN,,0,0,0,,太引人注目的话又会
Dialogue: 0,0:16:54.16,0:16:55.24,Sousei-JP,,0,0,0,,大丈夫です
Dialogue: 0,0:16:54.16,0:16:55.24,Sousei-CN,,0,0,0,,没关系
Dialogue: 0,0:16:56.16,0:16:58.00,Sousei-JP,,0,0,0,,その時は その時です
Dialogue: 0,0:16:56.16,0:16:58.00,Sousei-CN,,0,0,0,,到时候再想办法
Dialogue: 0,0:16:59.71,0:17:01.88,Sousei-JP,,0,0,0,,この子のお母さん いませんか
Dialogue: 0,0:16:59.71,0:17:01.88,Sousei-CN,,0,0,0,,这位小朋友的妈妈在吗
Dialogue: 0,0:17:02.76,0:17:04.76,Sousei-JP,,0,0,0,,お母さ～ん
Dialogue: 0,0:17:02.76,0:17:04.76,Sousei-CN,,0,0,0,,妈妈
Dialogue: 0,0:17:09.38,0:17:11.80,Sousei-JP,,0,0,0,,セシリア どこだ
Dialogue: 0,0:17:09.38,0:17:11.80,Sousei-CN,,0,0,0,,赛西莉亚 在哪里
Dialogue: 0,0:17:11.80,0:17:14.09,Sousei-JP,,0,0,0,,ユウガ もう 帰りましょう
Dialogue: 0,0:17:11.80,0:17:14.09,Sousei-CN,,0,0,0,,悠贺 我们回去吧
Dialogue: 0,0:17:14.09,0:17:16.91,Sousei-JP,,0,0,0,,また 正体がバレたら 大騒ぎよ
Dialogue: 0,0:17:14.09,0:17:16.91,Sousei-CN,,0,0,0,,真实身分被发现的话 又要引起骚动了
Dialogue: 0,0:17:16.91,0:17:19.96,Sousei-JP,,0,0,0,,僧侶も きっと今ごろ 家に帰ってるわ
Dialogue: 0,0:17:16.91,0:17:19.96,Sousei-CN,,0,0,0,,僧侣八成也已经回去了
Dialogue: 0,0:17:19.96,0:17:21.35,Sousei-JP,,0,0,0,,また そうやって
Dialogue: 0,0:17:19.96,0:17:21.35,Sousei-CN,,0,0,0,,你又这么说
Dialogue: 0,0:17:21.54,0:17:25.46,Sousei-JP,,0,0,0,,僕は ミカナと違って セシリアが心配なんだ
Dialogue: 0,0:17:21.54,0:17:25.46,Sousei-CN,,0,0,0,,我和你不一样 我很担心赛西莉亚
Dialogue: 0,0:17:31.34,0:17:31.93,Sousei-JP,,0,0,0,,何よ
Dialogue: 0,0:17:31.34,0:17:31.93,Sousei-CN,,0,0,0,,什么嘛
Dialogue: 0,0:17:39.86,0:17:41.97,Sousei-JP,,0,0,0,,見つかったよ ミカナ
Dialogue: 0,0:17:39.86,0:17:41.97,Sousei-CN,,0,0,0,,我找到了 米卡娜
Dialogue: 0,0:17:44.31,0:17:45.61,Sousei-JP,,0,0,0,,ミカナ
Dialogue: 0,0:17:44.31,0:17:45.61,Sousei-CN,,0,0,0,,米卡娜
Dialogue: 0,0:17:46.96,0:17:49.95,Sousei-CN,,0,0,0,,{\pos(960,1075)\bord5}隔天
Dialogue: 0,0:17:47.66,0:17:49.71,Sousei-JP,,0,0,0,,{\an8}セシリアが倒れた？
Dialogue: 0,0:17:47.66,0:17:49.71,Sousei-CN,,0,0,0,,{\an8}赛西莉亚病倒了？
Dialogue: 0,0:17:50.12,0:17:51.41,Sousei-JP,,0,0,0,,そうなのよ
Dialogue: 0,0:17:50.12,0:17:51.41,Sousei-CN,,0,0,0,,是啊
Dialogue: 0,0:17:51.41,0:17:53.81,Sousei-JP,,0,0,0,,日ごろの疲れが
Dialogue: 0,0:17:51.41,0:17:53.81,Sousei-CN,,0,0,0,,平常操劳过度
Dialogue: 0,0:17:53.81,0:17:56.97,Sousei-JP,,0,0,0,,昨日の騒動で限界を超えたみたいね
Dialogue: 0,0:17:53.81,0:17:56.97,Sousei-CN,,0,0,0,,再加上昨天的骚动 似乎让她到了极限
Dialogue: 0,0:17:56.97,0:17:59.51,Sousei-JP,,0,0,0,,そんな 俺のせいで
Dialogue: 0,0:17:56.97,0:17:59.51,Sousei-CN,,0,0,0,,怎么会 都是我不好
Dialogue: 0,0:17:59.51,0:18:00.72,Sousei-JP,,0,0,0,,軽い風邪だし
Dialogue: 0,0:17:59.51,0:18:00.72,Sousei-CN,,0,0,0,,但也只是轻微的感冒
Dialogue: 0,0:18:00.98,0:18:02.86,Sousei-JP,,0,0,0,,あなたのせいではないわ
Dialogue: 0,0:18:00.98,0:18:02.86,Sousei-CN,,0,0,0,,所以不是你的错
Dialogue: 0,0:18:02.86,0:18:05.66,Sousei-JP,,0,0,0,,ただ 勇者くんには ちょっと ね
Dialogue: 0,0:18:02.86,0:18:05.66,Sousei-CN,,0,0,0,,可是勇者就有点 那样
Dialogue: 0,0:18:06.66,0:18:09.25,Sousei-JP,,0,0,0,,セシリアを騒動に巻きこんだあげく
Dialogue: 0,0:18:06.66,0:18:09.25,Sousei-CN,,0,0,0,,不仅把赛西莉亚牵扯进骚动中
Dialogue: 0,0:18:09.25,0:18:11.06,Sousei-JP,,0,0,0,,どこから聞きつけたのか
Dialogue: 0,0:18:09.25,0:18:11.06,Sousei-CN,,0,0,0,,还不知从哪得知赛西莉亚病倒
Dialogue: 0,0:18:11.06,0:18:13.31,Sousei-JP,,0,0,0,,看病したいと押しかけてきたのよ
Dialogue: 0,0:18:11.06,0:18:13.31,Sousei-CN,,0,0,0,,坚持要来探病
Dialogue: 0,0:18:14.46,0:18:18.06,Sousei-JP,,0,0,0,,ソフィアが撃退して なんとか 帰ってもらったわ
Dialogue: 0,0:18:14.46,0:18:18.06,Sousei-CN,,0,0,0,,苏菲雅击退他 好不容易才让他离开
Dialogue: 0,0:18:18.06,0:18:19.06,Sousei-JP,,0,0,0,,ねぇ
Dialogue: 0,0:18:18.06,0:18:19.06,Sousei-CN,,0,0,0,,对吧
Dialogue: 0,0:18:19.06,0:18:20.05,Sousei-JP,,0,0,0,,ねぇ
Dialogue: 0,0:18:19.06,0:18:20.05,Sousei-CN,,0,0,0,,是的
Dialogue: 0,0:18:20.05,0:18:22.99,Sousei-JP,,0,0,0,,お嬢様の前で騒がれては 困りますから
Dialogue: 0,0:18:20.05,0:18:22.99,Sousei-CN,,0,0,0,,不能让他到大小姐面前吵闹 会很麻烦
Dialogue: 0,0:18:23.21,0:18:26.00,Sousei-JP,,0,0,0,,ソフィアさん いったい 何者
Dialogue: 0,0:18:23.21,0:18:26.00,Sousei-CN,,0,0,0,,苏菲雅小姐 到底是何方神圣
Dialogue: 0,0:18:26.66,0:18:30.25,Sousei-JP,,0,0,0,,あなたはセシリアのために頑張ってくれたんですってね
Dialogue: 0,0:18:26.66,0:18:30.25,Sousei-CN,,0,0,0,,你很为赛西莉亚着想吧
Dialogue: 0,0:18:30.46,0:18:32.37,Sousei-JP,,0,0,0,,よかったら 会ってあげて
Dialogue: 0,0:18:30.46,0:18:32.37,Sousei-CN,,0,0,0,,方便的话 去见见她吧
Dialogue: 0,0:18:34.91,0:18:37.91,Sousei-JP,,0,0,0,,お嬢様 ヨウキ様がお見舞いに
Dialogue: 0,0:18:34.91,0:18:37.91,Sousei-CN,,0,0,0,,大小姐 阳树先生来看你了
Dialogue: 0,0:18:38.31,0:18:39.26,Sousei-JP,,0,0,0,, ヨウ ヨウキさん？
Dialogue: 0,0:18:38.31,0:18:39.26,Sousei-CN,,0,0,0,,阳 阳树先生?
Dialogue: 0,0:18:39.26,0:18:41.46,Sousei-JP,,0,0,0,,ちょちょっと待ってくださいね
Dialogue: 0,0:18:39.26,0:18:41.46,Sousei-CN,,0,0,0,,先 先等一下
Dialogue: 0,0:18:41.46,0:18:43.26,Sousei-JP,,0,0,0,,まだ開けないでください
Dialogue: 0,0:18:41.46,0:18:43.26,Sousei-CN,,0,0,0,,先别开门
Dialogue: 0,0:18:43.26,0:18:46.70,Sousei-JP,,0,0,0,,ご安心を クマのぬいぐるみは しまっておきましたので
Dialogue: 0,0:18:43.26,0:18:46.70,Sousei-CN,,0,0,0,,请放心 我已经将熊玩偶收起来了
Dialogue: 0,0:18:47.20,0:18:48.18,Sousei-JP,,0,0,0,,ソフィアさん
Dialogue: 0,0:18:47.20,0:18:48.18,Sousei-CN,,0,0,0,,苏菲雅
Dialogue: 0,0:18:48.55,0:18:49.72,Sousei-JP,,0,0,0,,では どうぞ
Dialogue: 0,0:18:48.55,0:18:49.72,Sousei-CN,,0,0,0,,那么请进吧
Dialogue: 0,0:18:51.16,0:18:52.65,Sousei-JP,,0,0,0,,おじゃまします
Dialogue: 0,0:18:51.16,0:18:52.65,Sousei-CN,,0,0,0,,打扰了
Dialogue: 0,0:18:54.85,0:18:57.11,Sousei-JP,,0,0,0,,ここが セシリアの部屋
Dialogue: 0,0:18:54.85,0:18:57.11,Sousei-CN,,0,0,0,,这里就是赛西莉亚的房间
Dialogue: 0,0:18:57.11,0:18:58.21,Sousei-JP,,0,0,0,,ヨウキさん
Dialogue: 0,0:18:57.11,0:18:58.21,Sousei-CN,,0,0,0,,阳树先生
Dialogue: 0,0:19:02.32,0:19:04.41,Sousei-JP,,0,0,0,,こんな格好で すみません
Dialogue: 0,0:19:02.32,0:19:04.41,Sousei-CN,,0,0,0,,抱歉 这副模样见你
Dialogue: 0,0:19:05.46,0:19:06.91,Sousei-JP,,0,0,0,,俺こそ ごめん
Dialogue: 0,0:19:05.46,0:19:06.91,Sousei-CN,,0,0,0,,我才要跟你道歉
Dialogue: 0,0:19:06.91,0:19:09.41,Sousei-JP,,0,0,0,,せっかくの休みだったのに
Dialogue: 0,0:19:06.91,0:19:09.41,Sousei-CN,,0,0,0,,明明是你好不容易的休假
Dialogue: 0,0:19:09.41,0:19:11.71,Sousei-JP,,0,0,0,,ヨウキさんは 悪くありませんよ
Dialogue: 0,0:19:09.41,0:19:11.71,Sousei-CN,,0,0,0,,不是阳树先生的错
Dialogue: 0,0:19:11.71,0:19:15.36,Sousei-JP,,0,0,0,,いや セシリアが疲れてるのは知ってたのにさ
Dialogue: 0,0:19:11.71,0:19:15.36,Sousei-CN,,0,0,0,,不 我明知道你已经很累了
Dialogue: 0,0:19:15.36,0:19:18.42,Sousei-JP,,0,0,0,,あちこち連れまわしちゃったのは俺のミスだ
Dialogue: 0,0:19:15.36,0:19:18.42,Sousei-CN,,0,0,0,,却还带你到处走动 是我不好
Dialogue: 0,0:19:20.16,0:19:23.67,Sousei-JP,,0,0,0,,じゃあ ヨウキさんが悪いことにしておきましょう
Dialogue: 0,0:19:20.16,0:19:23.67,Sousei-CN,,0,0,0,,那就当作是你的错吧
Dialogue: 0,0:19:24.93,0:19:28.66,Sousei-JP,,0,0,0,,ヨウキさんのせいで私の休みがムダになったんです
Dialogue: 0,0:19:24.93,0:19:28.66,Sousei-CN,,0,0,0,,阳树先生害我的休假泡汤了
Dialogue: 0,0:19:28.66,0:19:29.76,Sousei-JP,,0,0,0,,だから 
Dialogue: 0,0:19:28.66,0:19:29.76,Sousei-CN,,0,0,0,,所以
Dialogue: 0,0:19:31.11,0:19:33.92,Sousei-JP,,0,0,0,,次の休みも つきあってくださいね
Dialogue: 0,0:19:31.11,0:19:33.92,Sousei-CN,,0,0,0,,下次休假时 也要陪我喔
Dialogue: 0,0:19:35.86,0:19:36.93,Sousei-JP,,0,0,0,,それは つまり
Dialogue: 0,0:19:35.86,0:19:36.93,Sousei-CN,,0,0,0,,也就是说
Dialogue: 0,0:19:37.26,0:19:39.36,Sousei-JP,,0,0,0,,次のデートの約束
Dialogue: 0,0:19:37.26,0:19:39.36,Sousei-CN,,0,0,0,,这是下次约会的约定啰
Dialogue: 0,0:19:41.21,0:19:42.61,Sousei-JP,,0,0,0,,任せておけ
Dialogue: 0,0:19:41.21,0:19:42.61,Sousei-CN,,0,0,0,,包在我身上
Dialogue: 0,0:19:42.61,0:19:45.66,Sousei-JP,,0,0,0,,昨日は失敗したが次は そうはいかん
Dialogue: 0,0:19:42.61,0:19:45.66,Sousei-CN,,0,0,0,,虽然昨天失败了 但下次不会了
Dialogue: 0,0:19:45.82,0:19:49.11,Sousei-JP,,0,0,0,,その彩られし 繭の中で安息を貪り
Dialogue: 0,0:19:45.82,0:19:49.11,Sousei-CN,,0,0,0,,你就在那彩色之茧中 贪图那美妙的安眠
Dialogue: 0,0:19:49.11,0:19:50.95,Sousei-JP,,0,0,0,,復活の刻を夢見ながら
Dialogue: 0,0:19:49.11,0:19:50.95,Sousei-CN,,0,0,0,,做着复活时刻的梦境
Dialogue: 0,0:19:50.95,0:19:54.51,Sousei-JP,,0,0,0,,二度目の行脚を 期待して待つがいい
Dialogue: 0,0:19:50.95,0:19:54.51,Sousei-CN,,0,0,0,,期待下次出游的时候吧
Dialogue: 0,0:20:02.66,0:20:03.80,Sousei-JP,,0,0,0,,すみません
Dialogue: 0,0:20:02.66,0:20:03.80,Sousei-CN,,0,0,0,,对不起
Dialogue: 0,0:20:04.71,0:20:06.41,Sousei-JP,,0,0,0,,だ 大丈夫か セシリア
Dialogue: 0,0:20:04.71,0:20:06.41,Sousei-CN,,0,0,0,, 还 还好吗 赛西莉亚 
Dialogue: 0,0:20:07.66,0:20:10.06,Sousei-JP,,0,0,0,,大声を出さないでください
Dialogue: 0,0:20:07.66,0:20:10.06,Sousei-CN,,0,0,0,,不要这么大声
Dialogue: 0,0:20:10.06,0:20:12.62,Sousei-JP,,0,0,0,,お嬢様のお体に障ります
Dialogue: 0,0:20:10.06,0:20:12.62,Sousei-CN,,0,0,0,,会影响大小姐休息的
Dialogue: 0,0:20:13.11,0:20:15.76,Sousei-JP,,0,0,0,,それじゃ お大事に セシリア
Dialogue: 0,0:20:13.11,0:20:15.76,Sousei-CN,,0,0,0,,那么 赛西莉亚 保重
Dialogue: 0,0:20:15.76,0:20:16.96,Sousei-JP,,0,0,0,,ヨ ヨウキさん
Dialogue: 0,0:20:15.76,0:20:16.96,Sousei-CN,,0,0,0,,阳 阳树先生
Dialogue: 0,0:20:18.46,0:20:22.11,Sousei-JP,,0,0,0,,本日は お越しくださりありがとうございました
Dialogue: 0,0:20:18.46,0:20:22.11,Sousei-CN,,0,0,0,,非常感谢您今天的莅临
Dialogue: 0,0:20:23.01,0:20:24.61,Sousei-JP,,0,0,0,,失礼しました
Dialogue: 0,0:20:23.01,0:20:24.61,Sousei-CN,,0,0,0,,打扰了
Dialogue: 0,0:20:24.85,0:20:27.21,Sousei-JP,,0,0,0,,隊長 無力
Dialogue: 0,0:20:24.85,0:20:27.21,Sousei-CN,,0,0,0,,队长 无力
Dialogue: 0,0:20:28.81,0:20:29.91,Sousei-JP,,0,0,0,,うるせぇ
Dialogue: 0,0:20:28.81,0:20:29.91,Sousei-CN,,0,0,0,,啰唆
Dialogue: 0,0:20:31.31,0:20:33.96,Sousei-JP,,0,0,0,,とんでもない腕力だったな
Dialogue: 0,0:20:31.31,0:20:33.96,Sousei-CN,,0,0,0,,力气真是大得吓人
Dialogue: 0,0:20:35.61,0:20:36.56,Sousei-JP,,0,0,0,,レイヴン
Dialogue: 0,0:20:35.61,0:20:36.56,Sousei-CN,,0,0,0,,渡鸦
Dialogue: 0,0:20:36.56,0:20:39.05,Sousei-JP,,0,0,0,,ヨウキ どうして ここに 
Dialogue: 0,0:20:36.56,0:20:39.05,Sousei-CN,,0,0,0,,阳树 为什么会在这里
Dialogue: 0,0:20:39.05,0:20:41.35,Sousei-JP,,0,0,0,,セリアさんに呼ばれてさ
Dialogue: 0,0:20:39.05,0:20:41.35,Sousei-CN,,0,0,0,,赛莉亚找我来的
Dialogue: 0,0:20:41.35,0:20:42.46,Sousei-JP,,0,0,0,,そっちは
Dialogue: 0,0:20:41.35,0:20:42.46,Sousei-CN,,0,0,0,,你呢
Dialogue: 0,0:20:42.46,0:20:43.56,Sousei-JP,,0,0,0,,えっと
Dialogue: 0,0:20:42.46,0:20:43.56,Sousei-CN,,0,0,0,,呃
Dialogue: 0,0:20:44.46,0:20:46.22,Sousei-JP,,0,0,0,,あぁ 話しにくいならいいけどさ
Dialogue: 0,0:20:44.46,0:20:46.22,Sousei-CN,,0,0,0,,不好开口的话 不说也没关系
Dialogue: 0,0:20:46.22,0:20:49.16,Sousei-JP,,0,0,0,,いや 相談に乗ってくれるか
Dialogue: 0,0:20:46.22,0:20:49.16,Sousei-CN,,0,0,0,,不 我能找你商量吗
Dialogue: 0,0:20:49.56,0:20:50.68,Sousei-JP,,0,0,0,,俺でよければ
Dialogue: 0,0:20:49.56,0:20:50.68,Sousei-CN,,0,0,0,,如果你不嫌弃我的话
Dialogue: 0,0:20:50.96,0:20:55.94,Sousei-JP,,0,0,0,,あの 実は気になってる人が いるんだ
Dialogue: 0,0:20:50.96,0:20:55.94,Sousei-CN,,0,0,0,,其实我有在意的人
Dialogue: 0,0:20:57.21,0:20:59.44,Sousei-JP,,0,0,0,,没想到是恋爱烦恼
Dialogue: 0,0:20:57.21,0:20:59.44,Sousei-CN,,0,0,0,,没想到是恋爱烦恼
Dialogue: 0,0:20:59.76,0:21:02.86,Sousei-JP,,0,0,0,,この声に自信がないって話をしたよな
Dialogue: 0,0:20:59.76,0:21:02.86,Sousei-CN,,0,0,0,,我跟你说过 这个声音让我很没自信
Dialogue: 0,0:21:03.71,0:21:06.19,Sousei-JP,,0,0,0,,彼女は バカにするどころか
Dialogue: 0,0:21:03.71,0:21:06.19,Sousei-CN,,0,0,0,,她不仅没嘲笑我
Dialogue: 0,0:21:06.75,0:21:09.91,Sousei-JP,,0,0,0,,良い声 うらやましい って言ったんだ
Dialogue: 0,0:21:06.75,0:21:09.91,Sousei-CN,,0,0,0,,还说 真好听 好羡慕 
Dialogue: 0,0:21:09.91,0:21:11.55,Sousei-JP,,0,0,0,,いい人じゃないか
Dialogue: 0,0:21:09.91,0:21:11.55,Sousei-CN,,0,0,0,,对方人很好啊
Dialogue: 0,0:21:11.55,0:21:14.41,Sousei-JP,,0,0,0,,そうなんだ 本当に いい子で
Dialogue: 0,0:21:11.55,0:21:14.41,Sousei-CN,,0,0,0,,就是啊 是个很好的人
Dialogue: 0,0:21:14.41,0:21:16.76,Sousei-JP,,0,0,0,,それで好きになっちゃったわけか
Dialogue: 0,0:21:14.41,0:21:16.76,Sousei-CN,,0,0,0,,所以你就喜欢上对方啦
Dialogue: 0,0:21:19.45,0:21:21.56,Sousei-JP,,0,0,0,,俺は どうしたらいい
Dialogue: 0,0:21:19.45,0:21:21.56,Sousei-CN,,0,0,0,,我该怎么办才好
Dialogue: 0,0:21:21.56,0:21:24.50,Sousei-JP,,0,0,0,,自信がないんだ俺なんかが
Dialogue: 0,0:21:21.56,0:21:24.50,Sousei-CN,,0,0,0,,我没什么自信 像我这样
Dialogue: 0,0:21:24.50,0:21:27.46,Sousei-JP,,0,0,0,,まるで 思春期の中学生のようだ
Dialogue: 0,0:21:24.50,0:21:27.46,Sousei-CN,,0,0,0,,简直就像是青春期的国中生
Dialogue: 0,0:21:27.46,0:21:29.36,Sousei-JP,,0,0,0,,こんなに イケメンなのに 
Dialogue: 0,0:21:27.46,0:21:29.36,Sousei-CN,,0,0,0,,明明就长得很帅
Dialogue: 0,0:21:31.02,0:21:31.85,Sousei-JP,,0,0,0,,レイヴン
Dialogue: 0,0:21:31.02,0:21:31.85,Sousei-CN,,0,0,0,,渡鸦
Dialogue: 0,0:21:32.36,0:21:35.10,Sousei-JP,,0,0,0,,お前は 自分のことをわかっていないのか
Dialogue: 0,0:21:32.36,0:21:35.10,Sousei-CN,,0,0,0,,你还不了解自己吗
Dialogue: 0,0:21:35.55,0:21:37.56,Sousei-JP,,0,0,0,,顔はイケメン 背も高い
Dialogue: 0,0:21:35.55,0:21:37.56,Sousei-CN,,0,0,0,,长得帅 身材高挑
Dialogue: 0,0:21:37.56,0:21:41.10,Sousei-JP,,0,0,0,,おまけに 世界を救った勇者パーティーの一人だろ
Dialogue: 0,0:21:37.56,0:21:41.10,Sousei-CN,,0,0,0,,而且还是拯救世界的勇者团队成员
Dialogue: 0,0:21:41.40,0:21:46.51,Sousei-JP,,0,0,0,,それに 声を褒められたんならもはや不安要素なんてない はずだ
Dialogue: 0,0:21:41.40,0:21:46.51,Sousei-CN,,0,0,0,,人家都夸奖你的声音了 就没有什么让你不安的因素了
Dialogue: 0,0:21:46.51,0:21:47.55,Sousei-JP,,0,0,0,,お前はすごい
Dialogue: 0,0:21:46.51,0:21:47.55,Sousei-CN,,0,0,0,,你很厉害
Dialogue: 0,0:21:47.55,0:21:48.91,Sousei-JP,,0,0,0,,行動を起こせ
Dialogue: 0,0:21:47.55,0:21:48.91,Sousei-CN,,0,0,0,,付出行动吧
Dialogue: 0,0:21:48.91,0:21:51.12,Sousei-JP,,0,0,0,,お前なら 大丈夫だ
Dialogue: 0,0:21:48.91,0:21:51.12,Sousei-CN,,0,0,0,,你一定没问题的
Dialogue: 0,0:21:51.46,0:21:53.16,Sousei-JP,,0,0,0,,自分を信じろ
Dialogue: 0,0:21:51.46,0:21:53.16,Sousei-CN,,0,0,0,,要相信自己
Dialogue: 0,0:21:54.75,0:21:57.12,Sousei-JP,,0,0,0,,しまったまた 厨二モードに 
Dialogue: 0,0:21:54.75,0:21:57.12,Sousei-CN,,0,0,0,,糟糕 我又开启中二模式了
Dialogue: 0,0:21:58.01,0:22:00.86,Sousei-JP,,0,0,0,,そうか そうだよな
Dialogue: 0,0:21:58.01,0:22:00.86,Sousei-CN,,0,0,0,,这样啊 说得也是
Dialogue: 0,0:22:00.86,0:22:03.56,Sousei-JP,,0,0,0,,ありがとう おかげで 勇気が出た
Dialogue: 0,0:22:00.86,0:22:03.56,Sousei-CN,,0,0,0,,谢谢你 让我有勇气了
Dialogue: 0,0:22:03.96,0:22:05.88,Sousei-JP,,0,0,0,,彼女に告白してみるよ
Dialogue: 0,0:22:03.96,0:22:05.88,Sousei-CN,,0,0,0,,我会试着和她告白的
Dialogue: 0,0:22:07.11,0:22:08.13,Sousei-JP,,0,0,0,,頑張れよ
Dialogue: 0,0:22:07.11,0:22:08.13,Sousei-CN,,0,0,0,,加油喔
Dialogue: 0,0:22:10.41,0:22:12.47,Sousei-JP,,0,0,0,,じゃあ 行ってくる
Dialogue: 0,0:22:10.41,0:22:12.47,Sousei-CN,,0,0,0,,那 我过去了
Dialogue: 0,0:22:13.96,0:22:16.84,Sousei-JP,,0,0,0,,そういや なんで レイヴンは ここに
Dialogue: 0,0:22:13.96,0:22:16.84,Sousei-CN,,0,0,0,,话说回来 为什么渡鸦会在这里
Dialogue: 0,0:22:17.66,0:22:20.86,Sousei-JP,,0,0,0,,まさか レイヴンの好きな相手は
Dialogue: 0,0:22:17.66,0:22:20.86,Sousei-CN,,0,0,0,,难道渡鸦喜欢的人是
Dialogue: 0,0:22:21.40,0:22:22.66,Sousei-JP,,0,0,0,,セシリア 
Dialogue: 0,0:22:21.40,0:22:22.66,Sousei-CN,,0,0,0,,赛西莉亚

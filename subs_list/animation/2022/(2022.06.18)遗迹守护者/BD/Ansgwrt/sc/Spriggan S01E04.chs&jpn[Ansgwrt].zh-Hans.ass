Dialogue: 1,0:05:01.22,0:05:01.26,OPEN,,0,0,0,fx,{\an2\pos(970,1050)\clip(404,1018,1515,1056)\1c&HFF00FF&\1a&H48&\bord0\blur0.8}And the truth will take your breath away
Dialogue: 5,0:05:01.02,0:05:01.06,OPEN,,0,0,0,fx,{\an7\pos(847,1031)\1c&HFF00FF&\1a&H18&\bord0\shad0\p1}m 0 0 l 406 0 l 406 3 l 0 3
Dialogue: 5,0:05:01.06,0:05:01.10,OPEN,,0,0,0,fx,{\an7\pos(1092,1046)\1c&HFFFF00&\1a&H18&\bord0\shad0\p1}m 0 0 l 170 0 l 170 4 l 0 4
Dialogue: 5,0:05:01.10,0:05:01.14,OPEN,,0,0,0,fx,{\an7\pos(744,1005)\1c&HFF00FF&\1a&H18&\bord0\shad0\p1}m 0 0 l 237 0 l 237 3 l 0 3
Dialogue: 5,0:05:01.14,0:05:01.18,OPEN,,0,0,0,fx,{\an7\pos(709,1046)\1c&H00FFFF&\1a&H18&\bord0\shad0\p1}m 0 0 l 446 0 l 446 4 l 0 4
Dialogue: 5,0:05:01.18,0:05:01.22,OPEN,,0,0,0,fx,{\an7\pos(818,992)\1c&HFFFFFF&\1a&H18&\bord0\shad0\p1}m 0 0 l 390 0 l 390 5 l 0 5
Dialogue: 5,0:05:01.22,0:05:01.26,OPEN,,0,0,0,fx,{\an7\pos(796,993)\1c&HFFFFFF&\1a&H18&\bord0\shad0\p1}m 0 0 l 438 0 l 438 2 l 0 2
Dialogue: 0,0:05:03.16,0:05:06.94,Title,,0,0,0,,{\fad(1000,0)\fs120\pos(960,762)}狂 战 士
Dialogue: 0,0:05:10.98,0:05:13.77,TEXT-CN,,0,0,0,,真是太好了 毛瑟博士
Dialogue: 0,0:05:14.40,0:05:19.65,TEXT-CN,,0,0,0,,这下子或许就能证明 我们所提倡的宇宙考古学说了呢
Dialogue: 0,0:05:19.74,0:05:20.74,TEXT-CN,,0,0,0,,是啊
Dialogue: 0,0:05:20.82,0:05:24.37,TEXT-CN,,0,0,0,,未曾记载于人类历史中的超古代文明
Dialogue: 0,0:05:24.45,0:05:29.83,TEXT-CN,,0,0,0,,远比现代更加发达的科技 以及当时所打造的时代错误遗物
Dialogue: 0,0:05:29.91,0:05:33.25,TEXT-CN,,0,0,0,,现在都将由我们唤醒
Dialogue: 0,0:05:40.34,0:05:43.51,TEXT-CN,,0,0,0,,虽然不得不依靠军方的支援 让我感到不快
Dialogue: 0,0:05:43.59,0:05:46.80,TEXT-CN,,0,0,0,,但改写历史的日子也近了
Dialogue: 0,0:05:50.85,0:05:53.64,TEXT-CN,,0,0,0,,天蝎号已确认目标时代错误遗物
Dialogue: 0,0:05:54.35,0:05:57.98,TEXT-CN,,0,0,0,,推测敌方将利用大型运输机移送目标
Dialogue: 0,0:05:58.48,0:06:03.20,TEXT-CN,,0,0,0,,目前布拉沃部队正于地点1-4 与敌方势力交战
Dialogue: 0,0:06:03.74,0:06:05.95,TEXT-CN,,0,0,0,,距离航空基地仍有600单位
Dialogue: 0,0:06:08.53,0:06:11.66,TEXT-CN,,0,0,0,,敌方势力顽强抵抗 阿尔法部队 布拉沃部队
Dialogue: 0,0:06:11.75,0:06:15.92,TEXT-CN,,0,0,0,,以及查理部队皆难以逼近基地设施
Dialogue: 0,0:06:19.30,0:06:21.38,TEXT-CN,,0,0,0,,布拉沃队长呼叫希尔拉19
Dialogue: 0,0:06:21.46,0:06:24.22,TEXT-CN,,0,0,0,,我们受到敌方激烈抵抗 无法接近目标
Dialogue: 0,0:06:24.80,0:06:26.80,TEXT-CN,,0,0,0,,计划从“贝罗兹”改为“斯菲拉”
Dialogue: 0,0:06:26.89,0:06:29.72,TEXT-CN,,0,0,0,,希尔拉19 你走路径C突破警戒线
Dialogue: 0,0:06:29.81,0:06:32.23,TEXT-CN,,0,0,0,,尽速前往敌方设施
Dialogue: 0,0:06:32.31,0:06:36.40,TEXT-CN,,0,0,0,,要是有这么简单 我现在就不用这么辛苦了
Dialogue: 0,0:06:38.23,0:06:39.40,TEXT-CN,,0,0,0,,可恶
Dialogue: 0,0:06:39.48,0:06:42.11,TEXT-CN,,0,0,0,,那些家伙竟然连狙击手都派出来了
Dialogue: 0,0:06:42.19,0:06:47.74,TEXT-CN,,0,0,0,,就算穿了强化肌肉装甲服 若随便乱动 脑袋就等着吃子弹
Dialogue: 0,0:06:49.83,0:06:50.99,TEXT-CN,,0,0,0,,可恶
Dialogue: 0,0:06:51.08,0:06:54.37,TEXT-CN,,0,0,0,,我现在可不能在这里浪费时间啊
Dialogue: 0,0:07:46.97,0:07:49.34,TEXT-CN,,0,0,0,,放弃红 黄两观测站
Dialogue: 0,0:07:49.43,0:07:52.22,TEXT-CN,,0,0,0,,将前哨线往西南退后300单位
Dialogue: 0,0:07:52.31,0:07:53.18,TEXT-CN,,0,0,0,,去回收观测仪…
Dialogue: 0,0:07:53.26,0:07:54.47,TEXT-CN,,0,0,0,,太可怕了
Dialogue: 0,0:07:54.56,0:07:57.52,TEXT-CN,,0,0,0,,他竟然能一个人突破我们的阵型
Dialogue: 0,0:07:57.60,0:08:00.10,TEXT-CN,,0,0,0,,队长 那个少年兵是…
Dialogue: 0,0:08:00.19,0:08:04.40,TEXT-CN,,0,0,0,,没错 他就是阿卡姆的 S级特工御神苗优
Dialogue: 0,0:08:04.48,0:08:05.40,TEXT-CN,,0,0,0,,御神苗？
Dialogue: 0,0:08:05.49,0:08:07.03,TEXT-CN,,0,0,0,,就是那小子？
Dialogue: 0,0:08:07.11,0:08:10.41,TEXT-CN,,0,0,0,,我可没听说史普利根会插手啊
Dialogue: 0,0:08:10.49,0:08:13.53,TEXT-CN,,0,0,0,,那个货柜里面到底装了什么？
Dialogue: 0,0:08:14.37,0:08:17.00,TEXT-CN,,0,0,0,,我也不清楚详情
Dialogue: 0,0:08:17.50,0:08:21.54,TEXT-CN,,0,0,0,,但是英国秘密情报局似乎与此事有关
Dialogue: 0,0:08:21.63,0:08:22.88,TEXT-CN,,0,0,0,,军情六处吗？
Dialogue: 0,0:08:23.96,0:08:29.43,TEXT-CN,,0,0,0,,阿卡姆表面上 是为了保护全世界的遗迹而活动
Dialogue: 0,0:08:30.05,0:08:36.27,TEXT-CN,,0,0,0,,但听说他们其实是靠着财团支援 发掘超出现代科技的时代错误遗物
Dialogue: 0,0:08:36.35,0:08:38.43,TEXT-CN,,0,0,0,,并且加以封印
Dialogue: 0,0:08:39.39,0:08:42.65,TEXT-CN,,0,0,0,,既然他们派了史普利根过来
Dialogue: 0,0:08:42.73,0:08:46.40,TEXT-CN,,0,0,0,,那就可能是超古代 文明的遗物 又或者是…
Dialogue: 0,0:08:46.90,0:08:48.28,TEXT-CN,,0,0,0,,该死
Dialogue: 0,0:08:48.36,0:08:51.45,TEXT-CN,,0,0,0,,上头那群王八蛋 竟然叫我们搬这么麻烦的东西
Dialogue: 0,0:08:52.07,0:08:53.74,TEXT-CN,,0,0,0,,司令部传来了通知
Dialogue: 0,0:08:53.82,0:08:57.79,TEXT-CN,,0,0,0,,亚特拉斯将照原定时刻 于4点30分离开基地
Dialogue: 0,0:08:59.41,0:09:02.38,TEXT-CN,,0,0,0,,快撤离伤员 重新编制队伍
Dialogue: 0,0:09:02.46,0:09:06.75,TEXT-CN,,0,0,0,,我们要与基地守卫合作 把史普利根逼到K地点
Dialogue: 0,0:09:06.84,0:09:09.92,TEXT-CN,,0,0,0,,只要有敌人敢靠近跑道 一律铲除
Dialogue: 0,0:09:10.01,0:09:13.80,TEXT-CN,,0,0,0,,赌上特种空勤团的名誉 一定要把他们送上西天
Dialogue: 0,0:09:13.89,0:09:14.97,TEXT-CN,,0,0,0,,遵命 长官
Dialogue: 0,0:09:21.27,0:09:23.31,TEXT-CN,,0,0,0,,天使21呼叫希尔拉19
Dialogue: 0,0:09:23.81,0:09:27.11,TEXT-CN,,0,0,0,,侦测到载运目标的运输机 产生热源反应
Dialogue: 0,0:09:27.19,0:09:30.36,TEXT-CN,,0,0,0,,他们打算把东西运回英国本土
Dialogue: 0,0:09:31.03,0:09:34.12,TEXT-CN,,0,0,0,,立刻阻止运输机起飞 并夺回目标物
Dialogue: 0,0:09:34.20,0:09:36.58,TEXT-CN,,0,0,0,,再重复一次 夺回目标物
Dialogue: 0,0:09:36.66,0:09:38.33,TEXT-CN,,0,0,0,,我知道啦
Dialogue: 0,0:09:47.13,0:09:48.30,TEXT-CN,,0,0,0,,这混帐
Dialogue: 0,0:09:48.38,0:09:50.34,TEXT-CN,,0,0,0,,集中火力
Dialogue: 0,0:09:50.42,0:09:52.47,TEXT-CN,,0,0,0,,第二班 从侧面包夹他
Dialogue: 0,0:10:01.85,0:10:05.44,TEXT-CN,,0,0,0,,可恶 不要一直破坏自然环境啦
Dialogue: 0,0:10:07.48,0:10:08.44,TEXT-CN,,0,0,0,,糟糕
Dialogue: 0,0:10:08.52,0:10:09.82,TEXT-CN,,0,0,0,,开火
Dialogue: 0,0:10:22.41,0:10:23.19,TEXT-CN,,0,0,0,,很好
Dialogue: 0,0:10:23.19,0:10:24.00,TEXT-CN,,0,0,0,,成功了
Dialogue: 0,0:10:34.68,0:10:35.72,TEXT-CN,,0,0,0,,什么？
Dialogue: 0,0:11:02.29,0:11:07.29,TEXT-CN,,0,0,0,,难道你还想再让我杀更多人吗？
Dialogue: 0,0:11:10.84,0:11:11.80,TEXT-CN,,0,0,0,,快滚
Dialogue: 0,0:11:13.05,0:11:15.72,TEXT-CN,,0,0,0,,在我还没改变主意之前快给我滚
Dialogue: 0,0:11:26.85,0:11:29.98,TEXT-CN,,0,0,0,,亚特拉斯01呼叫塔台
Dialogue: 0,0:11:30.06,0:11:32.48,TEXT-CN,,0,0,0,,请求准许进入跑道
Dialogue: 0,0:11:32.57,0:11:37.99,TEXT-CN,,0,0,0,,亚特拉斯01 准许经由A3滑行道进入12号跑道
Dialogue: 0,0:11:38.07,0:11:41.99,TEXT-CN,,0,0,0,,跑道上风向为150度 风速九节
Dialogue: 0,0:11:42.83,0:11:43.79,TEXT-CN,,0,0,0,,该死的
Dialogue: 0,0:12:14.28,0:12:18.61,TEXT-CN,,0,0,0,,运输机已于跑道西北端 进入起飞前最终确认
Dialogue: 0,0:12:18.70,0:12:23.28,TEXT-CN,,0,0,0,,希尔拉19 立刻潜入该机内夺取目标物
Dialogue: 0,0:12:23.37,0:12:24.87,TEXT-CN,,0,0,0,,已经来不及了
Dialogue: 0,0:12:25.87,0:12:27.96,TEXT-CN,,0,0,0,,我要想办法阻止它起飞
Dialogue: 0,0:12:53.52,0:12:57.03,TEXT-CN,,0,0,0,,给我停下来
Dialogue: 0,0:13:20.97,0:13:22.93,TEXT-CN,,0,0,0,,希尔拉19呼叫天使21
Dialogue: 0,0:13:23.47,0:13:25.39,TEXT-CN,,0,0,0,,没成功夺取目标物
Dialogue: 0,0:13:25.47,0:13:28.06,TEXT-CN,,0,0,0,,快派架直升机过来 我要追上去
Dialogue: 0,0:13:28.14,0:13:28.97,TEXT-CN,,0,0,0,,了解
Dialogue: 0,0:13:29.06,0:13:31.10,TEXT-CN,,0,0,0,,LZ为地点4-0
Dialogue: 0,0:13:31.19,0:13:33.48,TEXT-CN,,0,0,0,,15分钟内将会前去迎接
Dialogue: 0,0:13:34.98,0:13:35.90,TEXT-CN,,0,0,0,,可恶
Dialogue: 0,0:13:49.95,0:13:51.50,TEXT-CN,,0,0,0,,别开玩笑了
Dialogue: 0,0:13:51.58,0:13:55.00,TEXT-CN,,0,0,0,,那个时代错误遗物 是我们发掘出来的
Dialogue: 0,0:13:55.08,0:13:59.13,TEXT-CN,,0,0,0,,不能现在才改口 要我们让渡给军方啊 中校
Dialogue: 0,0:13:59.76,0:14:02.72,TEXT-CN,,0,0,0,,我知道你的心情 毛瑟博士
Dialogue: 0,0:14:03.30,0:14:05.84,TEXT-CN,,0,0,0,,但我们反倒算是你的恩人
Dialogue: 0,0:14:05.93,0:14:07.64,TEXT-CN,,0,0,0,,你说恩人？
Dialogue: 0,0:14:07.72,0:14:12.77,TEXT-CN,,0,0,0,,那个物件早已成了 各国瞩目的重要事项
Dialogue: 0,0:14:12.85,0:14:17.69,TEXT-CN,,0,0,0,,若不是有我们先回收 现在想必已被阿卡姆夺走
Dialogue: 0,0:14:18.77,0:14:21.07,TEXT-CN,,0,0,0,,那时博士的安危想必也不保了
Dialogue: 0,0:14:21.90,0:14:28.28,TEXT-CN,,0,0,0,,说到底 你们到了这个时间点 还想要发表你们提倡的宇宙考古学说
Dialogue: 0,0:14:28.37,0:14:30.41,TEXT-CN,,0,0,0,,你觉得我们会允许吗？
Dialogue: 0,0:14:32.00,0:14:35.92,TEXT-CN,,0,0,0,,我们可不能让国民 因为多余的情报而陷入混乱啊
Dialogue: 0,0:14:36.42,0:14:41.17,TEXT-CN,,0,0,0,,我看你们只是想利用那个 时代错误遗物去做军火生意吧
Dialogue: 0,0:14:41.26,0:14:44.01,TEXT-CN,,0,0,0,,这群不懂东西价值的蠢材
Dialogue: 0,0:14:45.01,0:14:50.14,TEXT-CN,,0,0,0,,别忘了 是那群蠢材提供设施
Dialogue: 0,0:14:52.10,0:14:55.77,TEXT-CN,,0,0,0,,中校 已准备好分析物件了
Dialogue: 0,0:14:55.85,0:14:57.06,TEXT-CN,,0,0,0,,辛苦了
Dialogue: 0,0:14:57.69,0:15:00.02,TEXT-CN,,0,0,0,,那么我们走吧 博士
Dialogue: 0,0:15:07.57,0:15:10.45,TEXT-CN,,0,0,0,,铁丝网上果不其然通了高压电
Dialogue: 0,0:15:11.24,0:15:15.33,TEXT-CN,,0,0,0,,里面还到处都是红外线激光警报系统
Dialogue: 0,0:15:15.41,0:15:19.59,TEXT-CN,,0,0,0,,真是的 竟然浪费钱 搞了这么多毫无意义的玩意儿
Dialogue: 0,0:15:20.75,0:15:23.80,TEXT-CN,,0,0,0,,首先得想想该怎么潜进去才行
Dialogue: 0,0:15:32.22,0:15:34.73,TEXT-CN,,0,0,0,,玛丽亚·克莱门蒂中校是吗？
Dialogue: 0,0:15:34.81,0:15:37.39,TEXT-CN,,0,0,0,,以首席成绩毕业于麻省理工学院
Dialogue: 0,0:15:37.48,0:15:39.86,TEXT-CN,,0,0,0,,甚至年仅20岁就取得了博士学位
Dialogue: 0,0:15:39.94,0:15:42.02,TEXT-CN,,0,0,0,,这么一个机械工学的超级天才
Dialogue: 0,0:15:42.11,0:15:45.69,TEXT-CN,,0,0,0,,没想到现在竟然沦落成了 毫无价值的军方技术士官啊
Dialogue: 0,0:15:46.20,0:15:50.99,TEXT-CN,,0,0,0,,我是为了保卫国家的 和平与安全才做研究的
Dialogue: 0,0:15:51.08,0:15:55.37,TEXT-CN,,0,0,0,,更何况 也没有其他赞助商 开得出比军方更好的条件
Dialogue: 0,0:15:56.08,0:15:59.21,TEXT-CN,,0,0,0,,克莱门蒂中校 这是至目前为止的分析报告
Dialogue: 0,0:15:59.88,0:16:04.34,TEXT-CN,,0,0,0,,外壳材质的维氏硬度试算值 达到碳化硅的四倍以上
Dialogue: 0,0:16:04.42,0:16:06.88,TEXT-CN,,0,0,0,,而且无法以任何手段扫描内部结构
Dialogue: 0,0:16:07.51,0:16:09.51,TEXT-CN,,0,0,0,,是一种未知的金属
Dialogue: 0,0:16:09.59,0:16:11.85,TEXT-CN,,0,0,0,,硬度相当于钻石呢
Dialogue: 0,0:16:12.51,0:16:16.02,TEXT-CN,,0,0,0,,但那仍是某种合金 这是不争的事实
Dialogue: 0,0:16:16.93,0:16:20.31,TEXT-CN,,0,0,0,,照预定计划施加电压 测试它的电阻值吧
Dialogue: 0,0:16:20.40,0:16:22.40,TEXT-CN,,0,0,0,,什么？快住手
Dialogue: 0,0:16:22.48,0:16:26.61,TEXT-CN,,0,0,0,,那可是足以改写 至今现代考古学说的新发现啊
Dialogue: 0,0:16:26.69,0:16:27.53,TEXT-CN,,0,0,0,,要是把它弄坏了…
Dialogue: 0,0:16:27.61,0:16:32.57,TEXT-CN,,0,0,0,,我们的任务是 尽快弄清楚那东西的真面目
Dialogue: 0,0:16:33.53,0:16:37.41,TEXT-CN,,0,0,0,,如果这点程度的实验会使它受损 对你来说也没有价值吧？
Dialogue: 0,0:16:37.50,0:16:41.38,TEXT-CN,,0,0,0,,开什么玩笑？ 我不准你们再胡作非为了
Dialogue: 0,0:16:41.46,0:16:43.17,TEXT-CN,,0,0,0,,快把那东西还给我
Dialogue: 0,0:16:45.67,0:16:49.26,TEXT-CN,,0,0,0,,这是来自国防调查局的最优先命令
Dialogue: 0,0:16:49.34,0:16:52.43,TEXT-CN,,0,0,0,,我们不会听从博士你的任何一句意见
Dialogue: 0,0:16:53.60,0:16:57.35,TEXT-CN,,0,0,0,,如果你希望自己可以在场 应该知道该怎么做吧？
Dialogue: 0,0:16:57.43,0:16:59.52,TEXT-CN,,0,0,0,,你这家伙…
Dialogue: 0,0:17:00.69,0:17:02.23,TEXT-CN,,0,0,0,,开始通电
Dialogue: 0,0:17:02.77,0:17:04.81,Screen,,0,0,0,,{\fs46\pos(342,210.667)\frx2\fry4\frz2.965\c&HA27336&\bord0}电子{\c&HA27336&\1a&H1E&}信{\c&HA27336&\1a&H32&}号{\c&HA27336&\1a&H3C&}分{\c&HA27336&\1a&H46&}布
Dialogue: 0,0:17:06.98,0:17:09.24,TEXT-CN,,0,0,0,,电阻值尚无变动
Dialogue: 0,0:17:09.32,0:17:10.49,TEXT-CN,,0,0,0,,提高电压
Dialogue: 0,0:17:18.83,0:17:19.87,TEXT-CN,,0,0,0,,怎么了？
Dialogue: 0,0:17:19.96,0:17:20.87,TEXT-CN,,0,0,0,,发生什么事了？
Dialogue: 0,0:17:20.96,0:17:23.83,TEXT-CN,,0,0,0,,我不知道 电阻值忽然降到零了
Dialogue: 0,0:17:33.84,0:17:35.39,TEXT-CN,,0,0,0,,现在怎样了？我看不到物件
Dialogue: 0,0:17:35.47,0:17:37.26,TEXT-CN,,0,0,0,,先确认有没有污染物质
Dialogue: 0,0:17:37.35,0:17:38.56,TEXT-CN,,0,0,0,,喂 你们看
Dialogue: 0,0:17:53.66,0:17:55.20,TEXT-CN,,0,0,0,,那是什么东西？
Dialogue: 0,0:17:55.28,0:17:56.74,TEXT-CN,,0,0,0,,原来那是生物？
Dialogue: 0,0:17:56.83,0:17:58.49,TEXT-CN,,0,0,0,,不 不对
Dialogue: 0,0:18:00.58,0:18:01.75,TEXT-CN,,0,0,0,,这是…
Dialogue: 0,0:18:03.75,0:18:05.29,TEXT-CN,,0,0,0,,一具机器人
Dialogue: 0,0:18:08.21,0:18:09.55,TEXT-CN,,0,0,0,,真让人惊讶
Dialogue: 0,0:18:10.46,0:18:12.63,TEXT-CN,,0,0,0,,这下可不得了了
Dialogue: 0,0:18:12.72,0:18:14.55,TEXT-CN,,0,0,0,,各位 你们看到了吗？
Dialogue: 0,0:18:14.64,0:18:16.55,TEXT-CN,,0,0,0,,我们长久以来的梦想
Dialogue: 0,0:18:16.64,0:18:21.48,TEXT-CN,,0,0,0,,旧时代的科技 现在就在我们眼前苏醒了
Dialogue: 0,0:18:21.56,0:18:24.98,TEXT-CN,,0,0,0,,它的动力是什么？能源是什么？
Dialogue: 0,0:18:25.06,0:18:28.98,TEXT-CN,,0,0,0,,很好 现在有一大堆事情 等着给我们调查了
Dialogue: 0,0:18:35.07,0:18:37.57,TEXT-CN,,0,0,0,,整座设施停电了？
Dialogue: 0,0:18:37.66,0:18:38.87,TEXT-CN,,0,0,0,,可恶
Dialogue: 0,0:18:40.45,0:18:42.25,TEXT-CN,,0,0,0,,不能再磨蹭下去了
Dialogue: 0,0:19:26.50,0:19:28.79,TEXT-CN,,0,0,0,,还真是死伤惨重
Dialogue: 0,0:19:29.38,0:19:31.71,TEXT-CN,,0,0,0,,每个士兵身上都没有出血
Dialogue: 0,0:19:31.80,0:19:34.42,TEXT-CN,,0,0,0,,伤口全都被烧到碳化了
Dialogue: 0,0:19:35.17,0:19:38.55,TEXT-CN,,0,0,0,,这群蠢蛋十之八九是启动了那东西
Dialogue: 0,0:19:51.23,0:19:54.90,TEXT-CN,,0,0,0,,是个中校啊 看来你逃得还算够快嘛
Dialogue: 0,0:19:54.99,0:19:57.24,TEXT-CN,,0,0,0,,你是史普利根
Dialogue: 0,0:19:57.32,0:19:59.28,TEXT-CN,,0,0,0,,没错 你猜对了
Dialogue: 0,0:19:59.36,0:20:01.91,TEXT-CN,,0,0,0,,不过我现在可没空陪你玩
Dialogue: 0,0:20:02.70,0:20:03.79,TEXT-CN,,0,0,0,,那东西在哪里？
Dialogue: 0,0:20:05.00,0:20:09.00,TEXT-CN,,0,0,0,,那东西一旦动了起来 要是不快点收拾它 事情就糟糕了
Dialogue: 0,0:20:14.80,0:20:15.92,TEXT-CN,,0,0,0,,快逃 动作快
Dialogue: 0,0:20:16.01,0:20:16.92,TEXT-CN,,0,0,0,,我知道
Dialogue: 0,0:20:56.76,0:21:03.35,TEXT-CN,,0,0,0,,可恶 它的激光竟然超过了 强化肌肉装甲服能承受的温度？
Dialogue: 0,0:21:03.43,0:21:05.06,TEXT-CN,,0,0,0,,现在到底怎么样了？
Dialogue: 0,0:21:05.14,0:21:06.22,TEXT-CN,,0,0,0,,解决它了吗？
Dialogue: 0,0:21:06.31,0:21:07.64,TEXT-CN,,0,0,0,,怎么可能？
Dialogue: 0,0:21:08.31,0:21:09.23,TEXT-CN,,0,0,0,,你看好
Dialogue: 0,0:21:14.65,0:21:15.61,TEXT-CN,,0,0,0,,懂了没？
Dialogue: 0,0:21:15.69,0:21:19.57,TEXT-CN,,0,0,0,,你们的武器对它完全不起作用
Dialogue: 0,0:21:19.65,0:21:22.03,TEXT-CN,,0,0,0,,如果懂了就赶快给我逃出这基地
Dialogue: 0,0:21:22.11,0:21:23.62,TEXT-CN,,0,0,0,,不然所有人都会被杀死
Dialogue: 0,0:21:24.41,0:21:28.41,TEXT-CN,,0,0,0,,你难道打算自己一个人 对付那怪物吗？
Dialogue: 0,0:21:28.50,0:21:31.58,TEXT-CN,,0,0,0,,这还用说吗？所以我才会来啊
Dialogue: 0,0:21:34.42,0:21:35.71,TEXT-CN,,0,0,0,,一个傻小子
Dialogue: 0,0:21:35.79,0:21:38.26,TEXT-CN,,0,0,0,,尽管用你的小命引开它 然后赴死吧
Dialogue: 0,0:21:38.88,0:21:42.30,TEXT-CN,,0,0,0,,我们会趁这时候整顿好战力毁了它
Dialogue: 0,0:21:42.38,0:21:43.89,TEXT-CN,,0,0,0,,喂喂？
Dialogue: 0,0:21:43.97,0:21:46.47,TEXT-CN,,0,0,0,,有那种空闲时间 还不如快逃
Dialogue: 0,0:21:50.14,0:21:51.39,TEXT-CN,,0,0,0,,你快走
Dialogue: 0,0:21:59.99,0:22:03.32,TEXT-CN,,0,0,0,,我这把奥力哈钢刀和你的装甲
Dialogue: 0,0:22:03.41,0:22:05.32,TEXT-CN,,0,0,0,,到底是哪个比较硬呢？
Dialogue: 0,0:22:06.41,0:22:07.91,TEXT-CN,,0,0,0,,来比比看啊
Dialogue: 0,0:22:14.71,0:22:15.96,TEXT-CN,,0,0,0,,刺进去了
Dialogue: 0,0:22:21.30,0:22:22.42,TEXT-CN,,0,0,0,,我的刀
Dialogue: 0,0:22:29.60,0:22:31.06,TEXT-CN,,0,0,0,,该死
Dialogue: 0,0:22:44.91,0:22:46.07,TEXT-CN,,0,0,0,,给我…
Dialogue: 0,0:22:46.91,0:22:47.82,TEXT-CN,,0,0,0,,下地狱吧
Dialogue: 0,0:22:58.42,0:23:00.92,TEXT-CN,,0,0,0,,这下它应该有好一阵子动不了了
Dialogue: 0,0:23:05.55,0:23:07.30,TEXT-CN,,0,0,0,,真的假的？
Dialogue: 0,0:23:15.60,0:23:17.27,TEXT-CN,,0,0,0,,目标位于C区
Dialogue: 0,0:23:17.35,0:23:18.65,TEXT-CN,,0,0,0,,动作快 包围它
Dialogue: 0,0:23:23.40,0:23:24.57,TEXT-CN,,0,0,0,,这是什么？

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：金时银时铜时 内嵌：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:01:01.31,0:01:04.08,Layzner,,0,0,0,,别开枪 所属是哪里 叫什么名字
Dialogue: 0,0:01:04.40,0:01:05.40,Layzner,,0,0,0,,我从古拉特斯星来
Dialogue: 0,0:01:07.09,0:01:10.58,Layzner,,0,0,0,,我叫英二 地球遇到危险了
Dialogue: 0,0:02:09.67,0:02:14.43,Layzner,,0,0,0,,这里是隶属美国航天部队火星基地宇宙火焰129号
Dialogue: 0,0:02:14.64,0:02:17.09,Layzner,,0,0,0,,请104号航天飞机回话
Dialogue: 0,0:02:17.32,0:02:19.02,Layzner,,0,0,0,,这里是104号航天飞机 请说
Dialogue: 0,0:02:19.37,0:02:22.50,Layzner,,0,0,0,,一九九六年十月的那一天
Dialogue: 0,0:02:23.16,0:02:28.54,Layzner,,0,0,0,,在前往联合国火星基地的途中我们最先遇到的是
Dialogue: 0,0:02:29.34,0:02:31.14,Layzner,,0,0,0,,美国的战机
Dialogue: 0,0:02:32.76,0:02:33.67,Layzner,,0,0,0,,接着
Dialogue: 0,0:02:33.68,0:02:36.67,Layzner,,0,0,0,,我们地球上的两大强国间的军备竞争
Dialogue: 0,0:02:36.81,0:02:42.11,Layzner,,0,0,0,,从月球再到火星
Dialogue: 0,0:02:42.32,0:02:48.76,Layzner,,0,0,0,,连宇宙中都可以感受到紧张的气氛
Dialogue: 0,0:02:48.76,0:02:53.77,Layzner,,0,0,0,,第二十五话 穿越宇宙
Dialogue: 0,0:02:59.28,0:03:03.90,Layzner,,0,0,0,,联合国火星观测基地
Dialogue: 0,0:03:04.81,0:03:06.02,Layzner,,0,0,0,,打开开关
Dialogue: 0,0:03:06.02,0:03:07.04,Layzner,,0,0,0,,打开开关
Dialogue: 0,0:03:09.25,0:03:09.87,Layzner,,0,0,0,,准时到达
Dialogue: 0,0:03:10.32,0:03:15.56,Layzner,,0,0,0,,直接面对这种完全再现地球紧张气氛的环境
Dialogue: 0,0:03:15.96,0:03:17.47,Layzner,,0,0,0,,当时的我
Dialogue: 0,0:03:18.68,0:03:20.64,Layzner,,0,0,0,,总感到很不安
Dialogue: 0,0:03:22.06,0:03:25.96,Layzner,,0,0,0,,我们是联合国航天局主办的宇宙文化俱乐部
Dialogue: 0,0:03:26.82,0:03:30.45,Layzner,,0,0,0,,也就是火星体验学校的第一期学员
Dialogue: 0,0:03:32.01,0:03:34.36,Layzner,,0,0,0,,我为的名字叫 安娜·斯蒂芬妮
Dialogue: 0,0:03:35.22,0:03:36.04,Layzner,,0,0,0,,14岁
Dialogue: 0,0:03:39.29,0:03:43.53,Layzner,,0,0,0,,宇宙文化俱乐部首发人员16名全部到达
Dialogue: 0,0:03:44.29,0:03:47.50,Layzner,,0,0,0,,欢迎欢迎 我是基地副队长利布雷
Dialogue: 0,0:03:48.38,0:03:53.23,Layzner,,0,0,0,,我是伊丽莎白 联合国航天局派遣首发人员的领队
Dialogue: 0,0:03:53.52,0:03:54.12,Layzner,,0,0,0,,辛苦了
Dialogue: 0,0:03:54.39,0:03:55.60,Layzner,,0,0,0,,这是成员名单
Dialogue: 0,0:03:56.11,0:03:58.85,Layzner,,0,0,0,,我是这里的队长朱布葛连巴
Dialogue: 0,0:03:59.36,0:04:00.89,Layzner,,0,0,0,,非常欢迎各位的到来
Dialogue: 0,0:04:02.07,0:04:07.74,Layzner,,0,0,0,,毋庸置疑 今后的宇宙属于在座的各位年轻人
Dialogue: 0,0:04:08.74,0:04:11.25,Layzner,,0,0,0,,到这里来的路上 大家可能已经看到了
Dialogue: 0,0:04:11.25,0:04:17.17,Layzner,,0,0,0,,目前的现状是优先发展军备 这实在是让人痛心疾首
Dialogue: 0,0:04:18.30,0:04:20.08,Layzner,,0,0,0,,这是不允许出现的情况
Dialogue: 0,0:04:21.10,0:04:25.91,Layzner,,0,0,0,,我们必须一直体现出和他们不同的价值观
Dialogue: 0,0:04:26.82,0:04:29.70,Layzner,,0,0,0,,我们会更加努力 同时也期待你们的表现
Dialogue: 0,0:04:30.88,0:04:33.40,Layzner,,0,0,0,,虽然只有
Dialogue: 0,0:04:33.40,0:04:34.59,Layzner,,0,0,0,,短短
Dialogue: 0,0:04:34.80,0:04:36.74,Layzner,,0,0,0,,半年的时间
Dialogue: 0,0:04:36.95,0:04:41.66,Layzner,,0,0,0,,能学习到一些适应未来时代的世界观和方法论
Dialogue: 0,0:04:36.95,0:04:41.66,Layzner,,0,0,0,,希望你们能通过在宇宙中的生活
Dialogue: 0,0:04:43.08,0:04:47.83,Layzner,,0,0,0,,我们成立宇宙文化俱乐部的目的只有这一点
Dialogue: 0,0:04:48.40,0:04:52.32,Layzner,,0,0,0,,人类在踏上火星之前 需要数千年
Dialogue: 0,0:04:48.64,0:04:51.25,Layzner,,0,0,0,,是
Dialogue: 0,0:04:52.62,0:04:57.00,Layzner,,0,0,0,,不 是数万年的岁月
Dialogue: 0,0:04:53.15,0:04:53.92,Layzner,,0,0,0,,啊 知道了 马上报告
Dialogue: 0,0:04:58.92,0:04:59.40,Layzner,,0,0,0,,什么
Dialogue: 0,0:04:59.68,0:05:01.24,Layzner,,0,0,0,,还是确认不了吗
Dialogue: 0,0:05:01.24,0:05:02.29,Layzner,,0,0,0,,无法确认
Dialogue: 0,0:05:03.77,0:05:04.55,Layzner,,0,0,0,,嗯
Dialogue: 0,0:05:04.82,0:05:05.84,Layzner,,0,0,0,,这是什么
Dialogue: 0,0:05:06.00,0:05:08.87,Layzner,,0,0,0,,这是第2转播卫星捕捉到的画面
Dialogue: 0,0:05:09.04,0:05:10.00,Layzner,,0,0,0,,很近啊
Dialogue: 0,0:05:10.49,0:05:12.13,Layzner,,0,0,0,,看不清楚 放大点
Dialogue: 0,0:05:12.13,0:05:12.61,Layzner,,0,0,0,,是
Dialogue: 0,0:05:15.43,0:05:16.30,Layzner,,0,0,0,,遭到破坏
Dialogue: 0,0:05:17.28,0:05:20.56,Layzner,,0,0,0,,飞行物出现热能反应 可能发射了激光弹
Dialogue: 0,0:05:20.88,0:05:21.48,Layzner,,0,0,0,,队长
Dialogue: 0,0:05:23.84,0:05:24.54,Layzner,,0,0,0,,怎么了
Dialogue: 0,0:05:27.32,0:05:29.12,Layzner,,0,0,0,,快让孩子们避难
Dialogue: 0,0:05:29.46,0:05:30.24,Layzner,,0,0,0,,发生了什么事了
Dialogue: 0,0:05:30.24,0:05:30.92,Layzner,,0,0,0,,快点
Dialogue: 0,0:05:32.28,0:05:34.51,Layzner,,0,0,0,,大卫 朱诺 快回来
Dialogue: 0,0:05:35.32,0:05:36.20,Layzner,,0,0,0,,你们
Dialogue: 0,0:05:36.47,0:05:37.22,Layzner,,0,0,0,,我去叫他们
Dialogue: 0,0:05:37.52,0:05:38.22,Layzner,,0,0,0,,快回来
Dialogue: 0,0:05:44.80,0:05:46.06,Layzner,,0,0,0,,你们快回去
Dialogue: 0,0:06:26.62,0:06:28.55,Layzner,,0,0,0,,什么 那是什么
Dialogue: 0,0:06:37.32,0:06:38.52,Layzner,,0,0,0,,你们在干什么
Dialogue: 0,0:06:39.58,0:06:41.45,Layzner,,0,0,0,,穿上太空服 快点
Dialogue: 0,0:06:49.31,0:06:51.65,Layzner,,0,0,0,,是新型的机器人吗
Dialogue: 0,0:06:48.27,0:06:51.65,Layzner,,0,0,0,,这里是联合国火星基地 请回答
Dialogue: 0,0:06:51.65,0:06:53.44,Layzner,,0,0,0,,没见过这么大的
Dialogue: 0,0:06:54.40,0:06:58.18,Layzner,,0,0,0,,如果是新机型实战演习的话 也不知道是哪个国家的
Dialogue: 0,0:06:58.56,0:07:00.21,Layzner,,0,0,0,,稍后再查
Dialogue: 0,0:07:00.22,0:07:03.21,Layzner,,0,0,0,, 先让大家去避难 实在不行就逃离这里
Dialogue: 0,0:07:03.40,0:07:04.18,Layzner,,0,0,0,,明白了
Dialogue: 0,0:07:11.11,0:07:13.18,Layzner,,0,0,0,,那肯定是宇宙战用的
Dialogue: 0,0:07:13.47,0:07:14.71,Layzner,,0,0,0,,是超级厉害的秘密武器啊
Dialogue: 0,0:07:15.41,0:07:17.08,Layzner,,0,0,0,,刚来就有这样棒的体验
Dialogue: 0,0:07:17.21,0:07:18.44,Layzner,,0,0,0,,等 等下
Dialogue: 0,0:07:40.18,0:07:42.80,Layzner,,0,0,0,,准备逃离 快点 快点
Dialogue: 0,0:07:43.54,0:07:45.28,Layzner,,0,0,0,,你们带上安全盔
Dialogue: 0,0:07:45.65,0:07:46.37,Layzner,,0,0,0,,是
Dialogue: 0,0:08:01.92,0:08:03.78,Layzner,,0,0,0,,主雷达被破坏了
Dialogue: 0,0:08:03.78,0:08:05.50,Layzner,,0,0,0,,二号和三号雷达也不能用了
Dialogue: 0,0:08:05.52,0:08:06.42,Layzner,,0,0,0,,怎么回事
Dialogue: 0,0:08:06.89,0:08:08.70,Layzner,,0,0,0,,六号也被破坏了
Dialogue: 0,0:08:09.92,0:08:13.81,Layzner,,0,0,0,,我是基地负责人朱布葛连巴 报上你们的国籍和所属
Dialogue: 0,0:08:14.70,0:08:20.20,Layzner,,0,0,0,,你们应该知道会有什么后果
Dialogue: 0,0:08:14.70,0:08:20.20,Layzner,,0,0,0,,在我们的领土上进行军事活动
Dialogue: 0,0:08:21.00,0:08:23.23,Layzner,,0,0,0,,决不允许你们再这样胡作非为
Dialogue: 0,0:08:23.62,0:08:24.92,Layzner,,0,0,0,,马上给我离开
Dialogue: 0,0:08:40.35,0:08:41.80,Layzner,,0,0,0,,是苏联军队
Dialogue: 0,0:09:14.76,0:09:17.00,Layzner,,0,0,0,,被干掉了 苏联战机
Dialogue: 0,0:09:18.10,0:09:19.55,Layzner,,0,0,0,,就是说那是美国军的
Dialogue: 0,0:09:20.34,0:09:22.72,Layzner,,0,0,0,,那被追的是哪边的
Dialogue: 0,0:09:26.14,0:09:27.72,Layzner,,0,0,0,,用力
Dialogue: 0,0:09:33.64,0:09:34.52,Layzner,,0,0,0,,动不了
Dialogue: 0,0:09:34.52,0:09:36.26,Layzner,,0,0,0,,里面 去里面
Dialogue: 0,0:09:38.15,0:09:38.60,Layzner,,0,0,0,,快点
Dialogue: 0,0:09:38.60,0:09:39.84,Layzner,,0,0,0,,是
Dialogue: 0,0:09:56.56,0:09:59.16,Layzner,,0,0,0,,英二 你在干什么
Dialogue: 0,0:09:59.70,0:10:01.32,Layzner,,0,0,0,,为什么要保护地球人的基地
Dialogue: 0,0:10:04.99,0:10:10.63,Layzner,,0,0,0,,听着英二 你的祖国是克多拉 你是古拉特斯人
Dialogue: 0,0:10:11.25,0:10:13.94,Layzner,,0,0,0,,我也只把你当成古拉特斯人
Dialogue: 0,0:10:14.64,0:10:16.92,Layzner,,0,0,0,,你疯了 为什么要站在地球人一边
Dialogue: 0,0:10:18.24,0:10:20.76,Layzner,,0,0,0,,把你养大的是古拉特斯
Dialogue: 0,0:10:21.52,0:10:26.33,Layzner,,0,0,0,,是用古拉特斯的阳光 土地 还有空气把你养大的
Dialogue: 0,0:10:26.54,0:10:29.82,Layzner,,0,0,0,,就算这样 我又一半地球人血统
Dialogue: 0,0:10:29.82,0:10:31.24,Layzner,,0,0,0,,我的父亲是地球人
Dialogue: 0,0:10:35.22,0:10:38.44,Layzner,,0,0,0,,醒醒吧英二 睁大眼睛看清楚
Dialogue: 0,0:10:40.80,0:10:44.44,Layzner,,0,0,0,,地球人的太空开拓计划只会成为动乱的根源
Dialogue: 0,0:10:45.28,0:10:49.46,Layzner,,0,0,0,,他们现在就就带着动乱的野心 在火星上建立了基地
Dialogue: 0,0:10:49.68,0:10:53.39,Layzner,,0,0,0,,就算这样 为什么要消灭地球人
Dialogue: 0,0:10:53.57,0:10:55.98,Layzner,,0,0,0,,我现在没空和你争辩
Dialogue: 0,0:10:55.98,0:10:57.07,Layzner,,0,0,0,,闪开
Dialogue: 0,0:10:59.40,0:11:02.04,Layzner,,0,0,0,,我要消灭所有幸存的地球人
Dialogue: 0,0:11:02.04,0:11:05.84,Layzner,,0,0,0,,不行 基地里有和我一样的地球人
Dialogue: 0,0:11:06.40,0:11:09.07,Layzner,,0,0,0,,把基地和地球人一起毁掉
Dialogue: 0,0:11:10.30,0:11:11.36,Layzner,,0,0,0,,别开枪
Dialogue: 0,0:11:12.92,0:11:14.21,Layzner,,0,0,0,,请不要开枪
Dialogue: 0,0:11:19.96,0:11:23.13,Layzner,,0,0,0,,没有用的 你就认命吧
Dialogue: 0,0:11:38.89,0:11:41.64,Layzner,,0,0,0,,妈妈 救救我
Dialogue: 0,0:11:49.00,0:11:52.49,Layzner,,0,0,0,,凯利前辈 求求你 要杀他们的话就请先杀了我吧
Dialogue: 0,0:11:52.55,0:11:56.07,Layzner,,0,0,0,,要杀他们的话就请先杀了我吧
Dialogue: 0,0:11:56.32,0:12:01.50,Layzner,,0,0,0,,请你好好看看 我的体内也和他们一样流着红色的血
Dialogue: 0,0:12:01.90,0:12:03.68,Layzner,,0,0,0,,求求你
Dialogue: 0,0:12:10.58,0:12:12.98,Layzner,,0,0,0,,停止 攻击
Dialogue: 0,0:12:17.01,0:12:19.88,Layzner,,0,0,0,,非常感谢
Dialogue: 0,0:12:20.36,0:12:28.06,Layzner,,0,0,0,,下次遇到你我可就不会手下留情了
Dialogue: 0,0:12:20.36,0:12:28.06,Layzner,,0,0,0,,英二 今后我们各走各的路吧
Dialogue: 0,0:12:28.62,0:12:29.20,Layzner,,0,0,0,,祝你好运
Dialogue: 0,0:12:29.20,0:12:29.98,Layzner,,0,0,0,,什么
Dialogue: 0,0:12:29.98,0:12:30.70,Layzner,,0,0,0,,回去
Dialogue: 0,0:12:34.59,0:12:38.72,Layzner,,0,0,0,,这就是我们和他第一次相遇
Dialogue: 0,0:12:49.92,0:12:53.39,Layzner,,0,0,0,,你说什么 他们的目的是挑起主基地冲突
Dialogue: 0,0:12:57.84,0:12:59.78,Layzner,,0,0,0,,我就是来告诉你们这件事的
Dialogue: 0,0:13:01.50,0:13:05.99,Layzner,,0,0,0,,你是说他们要挑起第三次世界大战 然后把地球变成殖民地
Dialogue: 0,0:13:06.18,0:13:09.77,Layzner,,0,0,0,,对了 听说这家伙来的时候 苏联战斗机被消灭了
Dialogue: 0,0:13:10.96,0:13:16.49,Layzner,,0,0,0,,那之后美国的战斗机也被卷进来了 要是哪一方产生了误会
Dialogue: 0,0:13:17.01,0:13:21.18,Layzner,,0,0,0,,怎么会 应该和主基地联系过了啊
Dialogue: 0,0:13:21.74,0:13:26.90,Layzner,,0,0,0,,不 不知道 因为这次状况很危险
Dialogue: 0,0:13:27.38,0:13:28.60,Layzner,,0,0,0,, 不会吧
Dialogue: 0,0:13:28.94,0:13:30.28,Layzner,,0,0,0,,喂 比尔
Dialogue: 0,0:13:43.96,0:13:44.59,Layzner,,0,0,0,,啊
Dialogue: 0,0:14:12.68,0:14:17.39,Layzner,,0,0,0,,如各位所见 第四行星演习作战获得圆满成功
Dialogue: 0,0:14:17.39,0:14:19.81,Layzner,,0,0,0,,两处军事基地被全部消灭
Dialogue: 0,0:14:21.80,0:14:28.94,Layzner,,0,0,0,,各位 我们的最终目标是 将第三行星地球纳入我们古拉特斯的版图
Dialogue: 0,0:14:29.13,0:14:34.23,Layzner,,0,0,0,,近期地球上两大强国将会维持军事力量的平衡
Dialogue: 0,0:14:34.37,0:14:37.21,Layzner,,0,0,0,,如果同时攻击两国
Dialogue: 0,0:14:37.21,0:14:42.27,Layzner,,0,0,0,, 世界肯定会立即陷入地球人所说的第三次世界大战
Dialogue: 0,0:14:47.54,0:14:48.64,Layzner,,0,0,0,,各位
Dialogue: 0,0:14:49.82,0:14:53.00,Layzner,,0,0,0,,地球人已经不是一两百年前的猴子
Dialogue: 0,0:14:53.00,0:14:54.83,Layzner,,0,0,0,,他们的科技水平虽然还不成熟
Dialogue: 0,0:14:54.83,0:14:58.47,Layzner,,0,0,0,,但是已经能够进入其他星球 实力不容忽视
Dialogue: 0,0:14:59.68,0:15:04.06,Layzner,,0,0,0,,不过 他们的科技的目的在于军事
Dialogue: 0,0:15:04.60,0:15:10.11,Layzner,,0,0,0,,已经具备可以毁灭地球上全人类数次的
Dialogue: 0,0:15:10.11,0:15:12.28,Layzner,,0,0,0,,武器
Dialogue: 0,0:15:13.06,0:15:16.68,Layzner,,0,0,0,,我们必须想办法
Dialogue: 0,0:15:16.68,0:15:20.64,Layzner,,0,0,0,,让他们互相使用这种邪恶的力量
Dialogue: 0,0:15:21.46,0:15:25.02,Layzner,,0,0,0,,很快人类数量会减少到三分之一
Dialogue: 0,0:15:25.02,0:15:27.60,Layzner,,0,0,0,,科技水平也会退步一个世纪
Dialogue: 0,0:15:28.08,0:15:34.00,Layzner,,0,0,0,,到那时 古拉特斯将成为地球人的领主
Dialogue: 0,0:15:35.82,0:15:40.64,Layzner,,0,0,0,,两小时后本舰开始向下一目标移动 我讲完了
Dialogue: 0,0:15:41.26,0:15:43.43,Layzner,,0,0,0,,所有人返回各自单位进行准备
Dialogue: 0,0:15:44.06,0:15:44.84,Layzner,,0,0,0,,是
Dialogue: 0,0:15:54.18,0:15:57.20,Layzner,,0,0,0,,来到火星已经过了两天多
Dialogue: 0,0:15:58.50,0:16:06.30,Layzner,,0,0,0,,停在远方红色天空上的 一艘美国太空部队运输舰成了我们的希望
Dialogue: 0,0:16:09.10,0:16:12.02,Layzner,,0,0,0,,我是达尼 敌机有五架 进入临战状态
Dialogue: 0,0:16:12.02,0:16:14.30,Layzner,,0,0,0,,了解 以临战状态待命
Dialogue: 0,0:16:14.79,0:16:16.80,Layzner,,0,0,0,,对地炮和大炮准备
Dialogue: 0,0:16:16.93,0:16:17.88,Layzner,,0,0,0,,大炮准备
Dialogue: 0,0:16:18.14,0:16:19.84,Layzner,,0,0,0,,导弹发射准备完成
Dialogue: 0,0:16:19.94,0:16:21.84,Layzner,,0,0,0,,还不行 敌人没有动
Dialogue: 0,0:16:22.14,0:16:23.97,Layzner,,0,0,0,,我这里随时都可以
Dialogue: 0,0:16:25.72,0:16:26.78,Layzner,,0,0,0,,到底在干嘛
Dialogue: 0,0:16:31.12,0:16:33.08,Layzner,,0,0,0,,敌人开始行动 小心
Dialogue: 0,0:16:39.70,0:16:40.43,Layzner,,0,0,0,,开始攻击
Dialogue: 0,0:16:49.58,0:16:53.02,Layzner,,0,0,0,,别慌 受伤部位半径12到14
Dialogue: 0,0:16:53.02,0:16:53.67,Layzner,,0,0,0,,关闭
Dialogue: 0,0:16:53.67,0:16:55.02,Layzner,,0,0,0,,基里 你要去哪儿
Dialogue: 0,0:16:55.15,0:16:56.95,Layzner,,0,0,0,,激光炮出现问题
Dialogue: 0,0:16:56.95,0:16:58.15,Layzner,,0,0,0,,走 危险
Dialogue: 0,0:17:38.72,0:17:41.15,Layzner,,0,0,0,,第七区封闭 第八区封闭
Dialogue: 0,0:18:09.30,0:18:10.89,Layzner,,0,0,0,,史密斯
Dialogue: 0,0:18:12.83,0:18:14.59,Layzner,,0,0,0,,莫加
Dialogue: 0,0:18:22.15,0:18:25.24,Layzner,,0,0,0,,停止攻击 会爆炸的
Dialogue: 0,0:18:25.24,0:18:27.69,Layzner,,0,0,0,,是SPT 三架战机飞过来了
Dialogue: 0,0:18:35.32,0:18:39.22,Layzner,,0,0,0,,大卫 罗安 不要靠近太空船 会被爆炸伤害到的
Dialogue: 0,0:18:39.60,0:18:40.94,Layzner,,0,0,0,,少佐和乘员在哪
Dialogue: 0,0:18:40.94,0:18:42.91,Layzner,,0,0,0,,达尼少佐 达尼少佐 能听到吗
Dialogue: 0,0:18:43.62,0:18:46.20,Layzner,,0,0,0,,达尼少佐 达尼少佐
Dialogue: 0,0:18:52.40,0:18:53.66,Layzner,,0,0,0,,可恶
Dialogue: 0,0:18:55.02,0:18:56.04,Layzner,,0,0,0,,他们来了
Dialogue: 0,0:19:01.41,0:19:02.17,Layzner,,0,0,0,,后退
Dialogue: 0,0:19:18.54,0:19:20.57,Layzner,,0,0,0,,作战完成 马上返回
Dialogue: 0,0:19:20.57,0:19:23.42,Layzner,,0,0,0,,那三机怎么办 而且好像有一个人逃离了
Dialogue: 0,0:19:23.42,0:19:25.22,Layzner,,0,0,0,,不能再追了 撤
Dialogue: 0,0:19:40.52,0:19:43.28,Layzner,,0,0,0,,没错 和我们同一轨道
Dialogue: 0,0:19:43.89,0:19:46.92,Layzner,,0,0,0,,离启动还有30秒 轨道无变化
Dialogue: 0,0:19:47.36,0:19:50.86,Layzner,,0,0,0,,要离开火星的话需要消耗燃料的95%
Dialogue: 0,0:19:50.86,0:19:53.22,Layzner,,0,0,0,,如果对接失败 不仅无法返回
Dialogue: 0,0:19:53.59,0:19:56.38,Layzner,,0,0,0,,还有可能从太阳系失速
Dialogue: 0,0:19:53.96,0:19:57.36,Layzner,,0,0,0,,还有36秒
Dialogue: 0,0:19:57.37,0:20:01.36,Layzner,,0,0,0,,二次连射 还有15秒 离启动还有20秒
Dialogue: 0,0:20:01.36,0:20:03.42,Layzner,,0,0,0,,接触区域102
Dialogue: 0,0:20:03.42,0:20:07.30,Layzner,,0,0,0,,警报信息 第三区SPT五机侵入
Dialogue: 0,0:20:13.29,0:20:17.35,Layzner,,0,0,0,,离启动还有15秒 点火噪声持续
Dialogue: 0,0:20:24.12,0:20:24.92,Layzner,,0,0,0,,11.
Dialogue: 0,0:20:25.18,0:20:25.90,Layzner,,0,0,0,,10.
Dialogue: 0,0:20:28.41,0:20:30.83,Layzner,,0,0,0,,07, 06, 05.
Dialogue: 0,0:20:32.88,0:20:36.19,Layzner,,0,0,0,,03, 02, 01, 00.
Dialogue: 0,0:20:45.82,0:20:47.21,Layzner,,0,0,0,,中尉 敌机上升
Dialogue: 0,0:20:47.88,0:20:49.11,Layzner,,0,0,0,,准备攻击
Dialogue: 0,0:20:56.90,0:21:00.10,Layzner,,0,0,0,,预测对接需要时间三十秒
Dialogue: 0,0:21:00.10,0:21:01.58,Layzner,,0,0,0,,LCM 加满
Dialogue: 0,0:21:01.71,0:21:04.05,Layzner,,0,0,0,,九格以上效果无法扩大
Dialogue: 0,0:21:04.05,0:21:06.88,Layzner,,0,0,0,,我知道 待会再运行 能量扩大
Dialogue: 0,0:21:15.04,0:21:16.33,Layzner,,0,0,0,,开火 击落他
Dialogue: 0,0:21:22.64,0:21:26.96,Layzner,,0,0,0,,离对接还有二十秒 还有十八秒
Dialogue: 0,0:21:31.58,0:21:33.87,Layzner,,0,0,0,,开火 别让他们逃离火星
Dialogue: 0,0:21:36.32,0:21:38.26,Layzner,,0,0,0,,离对接还有9秒
Dialogue: 0,0:21:39.36,0:21:40.24,Layzner,,0,0,0,,7
Dialogue: 0,0:21:41.43,0:21:42.80,Layzner,,0,0,0,,5
Dialogue: 0,0:21:43.44,0:21:44.54,Layzner,,0,0,0,,开火开火
Dialogue: 0,0:22:00.90,0:22:02.00,Layzner,,0,0,0,,可恶
Dialogue: 0,0:22:04.94,0:22:06.44,Layzner,,0,0,0,,LCM散布
Dialogue: 0,0:22:06.44,0:22:07.09,Layzner,,0,0,0,,完成
Dialogue: 0,0:22:20.38,0:22:21.17,Layzner,,0,0,0,,中尉
Dialogue: 0,0:22:21.17,0:22:23.56,Layzner,,0,0,0,,全机返回母舰 乘母舰追击
Dialogue: 0,0:22:25.84,0:22:28.61,Layzner,,0,0,0,,艾尔巴特罗·纳鲁·飞鸟英二
Dialogue: 0,0:22:29.58,0:22:34.24,Layzner,,0,0,0,,地球和古拉特斯星诞生的命运之子
Dialogue: 0,0:22:36.74,0:22:40.08,Layzner,,0,0,0,,他和我们一起逃离了火星
Dialogue: 0,0:22:41.32,0:22:45.68,Layzner,,0,0,0,,同时
Dialogue: 0,0:22:46.21,0:22:49.33,Layzner,,0,0,0,,这也是古拉特斯和地球之间漫长战争的开始
Dialogue: 0,0:23:54.65,0:23:56.91,Layzner,,0,0,0,,你是说丢下同伴不管吗
Dialogue: 0,0:24:03.72,0:24:08.19,Layzner,,0,0,0,,下集 时光流逝
Dialogue: 0,0:22:55.81,0:23:01.10,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.45,0:23:05.86,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:07.78,0:23:13.24,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.42,0:23:19.20,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.46,0:23:25.21,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.47,0:23:32.42,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.27,0:23:39.10,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:39.73,0:23:44.77,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.20,0:23:02.00,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.00,0:23:06.42,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.30,0:23:13.63,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:13.63,0:23:19.85,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:19.85,0:23:26.06,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.06,0:23:33.03,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:33.86,0:23:39.70,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.33,0:23:45.12,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:45.62,0:23:50.55,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...

Dialogue: 0,0:00:02.88,0:00:05.98,Default,,0,0,0,,银河帝国与自由行星同盟
Dialogue: 0,0:00:05.98,0:00:08.79,Default,,0,0,0,,在银河系宇宙空间中
Dialogue: 0,0:00:08.79,0:00:12.17,Default,,0,0,0,,可以直接往来的安全航行宙域
Dialogue: 0,0:00:12.17,0:00:13.90,Default,,0,0,0,,只有两处
Dialogue: 0,0:00:14.89,0:00:17.11,Default,,0,0,0,,一处是伊谢尔伦回廊
Dialogue: 0,0:00:16.57,0:00:21.24,Basic_Sign2,,0,0,0,,{\fad(475,0)\blur1\pos(960,858)}费沙自治领
Dialogue: 0,0:00:17.48,0:00:20.43,Default,,0,0,0,,另一处是费沙回廊
Dialogue: 0,0:00:21.92,0:00:25.72,Default,,0,0,0,,以这条回廊为领土的费沙是个奇妙的国家
Dialogue: 0,0:00:26.50,0:00:29.42,Default,,0,0,0,,准确来说它连国家都不是 而是自治领
Dialogue: 0,0:00:30.59,0:00:35.16,Default,,0,0,0,,形式上 它是银河帝国的一个地方行政单位
Dialogue: 0,0:00:35.16,0:00:37.30,Default,,0,0,0,,却保持着几乎完全的独立
Dialogue: 0,0:00:38.02,0:00:42.48,Default,,0,0,0,,通过独占帝国与同盟间非常规的贸易
Dialogue: 0,0:00:42.94,0:00:46.75,Default,,0,0,0,,单论经济实力 它甚至凌驾于两国之上
Dialogue: 0,0:00:47.52,0:00:51.02,Basic_Sign2,,0,0,0,,{\b1\fscx90\blur1\pos(984,862)}瓦伦丁•卡乌夫纪念商科大学
Dialogue: 0,0:00:48.04,0:00:50.81,Default,,0,0,0,,这一特殊状况能够成立
Dialogue: 0,0:00:51.18,0:00:55.02,Default,,0,0,0,,源于初代自治领主 出身于地球的大商人
Dialogue: 0,0:00:55.02,0:00:58.83,Default,,0,0,0,,利奥波德·拉普近乎异常的热情
Dialogue: 0,0:00:58.83,0:01:01.29,Default,,0,0,0,,及其在政治 资金方面做的工作
Dialogue: 0,0:01:02.70,0:01:04.03,Default,,0,0,0,,自那以后
Dialogue: 0,0:01:04.35,0:01:10.91,Default,,0,0,0,,费沙便是银河系中人员 物资 金钱 信息的流通中心
Dialogue: 0,0:01:12.41,0:01:16.32,Default,,0,0,0,,寻求一夜暴富的独立商人们的经济活动
Dialogue: 0,0:01:16.71,0:01:21.93,Default,,0,0,0,,加上企业对帝国和同盟进行的投资
Dialogue: 0,0:01:21.93,0:01:23.58,Default,,0,0,0,,造就了这个巨大的经济圈
Dialogue: 0,0:01:24.26,0:01:27.78,Default,,0,0,0,,如果说伊谢尔伦回廊是军事最前线
Dialogue: 0,0:01:28.35,0:01:33.50,Default,,0,0,0,,那费沙就是经济战和信息战的最前线
Dialogue: 0,0:01:30.86,0:01:35.00,Basic_Sign,,0,0,0,,{\fad(500,0)\u1\blur1\pos(1494,643)}费沙自治领主\N{\u0}安德烈•鲁宾斯基
Dialogue: 0,0:01:35.01,0:01:40.48,OPCN,,0,0,0,,你是否感觉 自己身处童话
Dialogue: 0,0:01:41.13,0:01:47.75,OPCN,,0,0,0,,在伸出的手掌之上
Dialogue: 0,0:01:47.75,0:01:54.36,OPCN,,0,0,0,,被拨弄的未来做着恒久的梦
Dialogue: 0,0:01:54.36,0:02:00.93,OPCN,,0,0,0,,知晓吐露的话语背后的真意
Dialogue: 0,0:02:01.49,0:02:11.82,OPCN,,0,0,0,,无秩序的开绽 剥去锈蚀的风景
Dialogue: 0,0:02:12.92,0:02:16.33,OPCN,,0,0,0,,满身灰尘地留在明澈的天空下
Dialogue: 0,0:02:16.33,0:02:19.37,OPCN,,0,0,0,,心跳一下接着一下
Dialogue: 0,0:02:19.37,0:02:25.94,OPCN,,0,0,0,,碎裂散落的祈祷在悄悄眨着眼
Dialogue: 0,0:02:25.94,0:02:29.29,OPCN,,0,0,0,,满身灰尘地留在无云的天空下
Dialogue: 0,0:02:29.29,0:02:32.17,OPCN,,0,0,0,,人生如一瞬的耀眼光芒
Dialogue: 0,0:02:32.17,0:02:39.37,OPCN,,0,0,0,,循规蹈矩也找不出的答案
Dialogue: 0,0:01:35.01,0:01:40.48,OPEN,,0,0,0,,Don’t you see yourself in a kind of fairy tale?
Dialogue: 0,0:01:41.13,0:01:47.75,OPEN,,0,0,0,,差し出された掌の上で
Dialogue: 0,0:01:47.75,0:01:54.36,OPEN,,0,0,0,,踊らされてく未来は　永久の夢をみて
Dialogue: 0,0:01:54.36,0:02:00.93,OPEN,,0,0,0,,吐き出された言葉の裏を知る
Dialogue: 0,0:02:01.49,0:02:11.82,OPEN,,0,0,0,,無秩序な綻びが　錆びついた景色を剥ぐ
Dialogue: 0,0:02:12.92,0:02:16.33,OPEN,,0,0,0,,Left in the dust under the airy sky
Dialogue: 0,0:02:16.33,0:02:19.37,OPEN,,0,0,0,,刻まれていく鼓動
Dialogue: 0,0:02:19.37,0:02:25.94,OPEN,,0,0,0,,砕けて散った祈りは人知れず瞬く
Dialogue: 0,0:02:25.94,0:02:29.29,OPEN,,0,0,0,,Left in the dust under the open sky
Dialogue: 0,0:02:29.29,0:02:32.17,OPEN,,0,0,0,,Life is a flash blinding bright
Dialogue: 0,0:02:32.17,0:02:39.37,OPEN,,0,0,0,,ル一ルをなぞっても見出せない答え
Dialogue: 0,0:03:00.07,0:03:04.95,title,,0,0,0,,{\fad(550,0)\be0}银河英雄传说 \N全新命题
Dialogue: 0,0:03:05.78,0:03:09.54,Default,,0,0,0,,在费沙 信息比宝石更有价值
Dialogue: 0,0:03:10.57,0:03:15.40,Default,,0,0,0,,就连独立商人聚集的德拉库尔酒馆里的传闻
Dialogue: 0,0:03:15.71,0:03:19.72,Default,,0,0,0,,说不定都是等待打磨的原钻
Dialogue: 0,0:03:20.65,0:03:23.78,Default,,0,0,0,,帝国的那个罗严克拉姆新政权
Dialogue: 0,0:03:23.78,0:03:25.21,Default,,0,0,0,,成果一个接着一个
Dialogue: 0,0:03:25.98,0:03:27.76,Default,,0,0,0,,听说一些贵族为温饱发愁
Dialogue: 0,0:03:27.76,0:03:32.37,Default,,0,0,0,,正在不断变卖宝石 不动产这类值钱的东西
Dialogue: 0,0:03:32.74,0:03:34.51,Default,,0,0,0,,一旦政权发生变革
Dialogue: 0,0:03:34.51,0:03:37.33,Default,,0,0,0,,特权阶级一夜间就会成为复仇的对象
Dialogue: 0,0:03:37.75,0:03:39.50,Default,,0,0,0,,说起来也的确可怜
Dialogue: 0,0:03:40.03,0:03:43.52,Default,,0,0,0,,可怜的是被持续压榨了500年的民众
Dialogue: 0,0:03:44.23,0:03:47.60,Default,,0,0,0,,就算贵族们今后苦个500年
Dialogue: 0,0:03:47.96,0:03:49.64,Default,,0,0,0,,我也一点不同情
Dialogue: 0,0:03:50.27,0:03:51.61,Default,,0,0,0,,好吧好吧
Dialogue: 0,0:03:52.31,0:03:55.03,Default,,0,0,0,,话说回来 我找自治领主府的官差
Dialogue: 0,0:03:55.03,0:03:56.74,Default,,0,0,0,,打听到一个奇妙的传闻
Dialogue: 0,0:03:56.74,0:03:57.66,Default,,0,0,0,,什么传闻？
Dialogue: 0,0:03:57.66,0:04:00.94,Default,,0,0,0,,我们的自治领主 鲁宾斯基先生那里
Dialogue: 0,0:04:00.94,0:04:02.91,Default,,0,0,0,,有个可疑的和尚频繁出入
Dialogue: 0,0:04:03.48,0:04:07.27,Default,,0,0,0,,和尚跟黑狐 凑在一起够恶心的啊
Dialogue: 0,0:04:08.03,0:04:12.03,title,,0,0,0,,第三十集 一根细丝
Dialogue: 0,0:04:25.51,0:04:26.62,Default,,0,0,0,,终于到我了啊
Dialogue: 0,0:04:30.37,0:04:31.68,Default,,0,0,0,,让您久等了
Dialogue: 0,0:04:32.39,0:04:34.51,Default,,0,0,0,,领主这就见您
Dialogue: 0,0:04:35.30,0:04:36.42,Default,,0,0,0,,这边请
Dialogue: 0,0:04:38.63,0:04:41.58,Default,,0,0,0,,话说 下一个该我…
Dialogue: 0,0:04:48.90,0:04:53.03,Default,,0,0,0,,德古斯比主教阁下 感谢您专程前来
Dialogue: 0,0:04:54.64,0:04:56.70,Default,,0,0,0,,这是阿西尼博雅产的红茶
Dialogue: 0,0:04:57.03,0:04:59.17,Default,,0,0,0,,不知是否合您口味
Dialogue: 0,0:05:00.28,0:05:02.55,Default,,0,0,0,,你所言当真？
Dialogue: 0,0:05:01.32,0:05:03.55,Basic_Sign2,,0,0,0,,{\fad(450,0)\u1\blur1\pos(392,479)}地球教主教 \N{\u0}德古斯比
Dialogue: 0,0:05:03.64,0:05:07.49,Default,,0,0,0,,千真万确 费沙将一改过去的方针
Dialogue: 0,0:05:07.85,0:05:11.96,Default,,0,0,0,,加大对帝国的协助以及金援的比重
Dialogue: 0,0:05:12.38,0:05:15.95,Default,,0,0,0,,这样一来 帝国和同盟间的势力平衡会被打破
Dialogue: 0,0:05:16.74,0:05:21.07,Default,,0,0,0,,费沙的国家方针应是不偏袒任何一方才对
Dialogue: 0,0:05:22.52,0:05:26.77,Default,,0,0,0,,不弱至受人欺辱 不强至使人畏怖
Dialogue: 0,0:05:27.43,0:05:30.57,Default,,0,0,0,,历代自治领主 均是凭藉财富和计谋
Dialogue: 0,0:05:30.57,0:05:32.93,Default,,0,0,0,,巧妙地使帝国和同盟并存
Dialogue: 0,0:05:33.29,0:05:35.67,Default,,0,0,0,,维持费沙独立至今
Dialogue: 0,0:05:36.37,0:05:39.85,Default,,0,0,0,,然而 是时候更新这一体制了
Dialogue: 0,0:05:40.43,0:05:45.17,Default,,0,0,0,,此话怎讲 你偏向帝国的目的何在
Dialogue: 0,0:05:47.26,0:05:50.32,Default,,0,0,0,,为了让莱因哈特·冯·罗严克拉姆公爵
Dialogue: 0,0:05:50.73,0:05:53.31,Default,,0,0,0,,统一整个银河系宇宙
Dialogue: 0,0:05:58.01,0:06:01.42,Default,,0,0,0,,先让他篡夺高登巴姆王朝
Dialogue: 0,0:06:01.42,0:06:06.05,Default,,0,0,0,,再除掉头顶至尊王冠的莱因哈特皇帝
Dialogue: 0,0:06:06.34,0:06:09.59,Default,,0,0,0,,由我们费沙掌握新王朝的实权
Dialogue: 0,0:06:12.05,0:06:14.37,Default,,0,0,0,,这是不是想得太美了
Dialogue: 0,0:06:15.06,0:06:18.13,Default,,0,0,0,,金发小子应该没这么好对付
Dialogue: 0,0:06:18.55,0:06:20.62,Default,,0,0,0,,还有奥贝斯坦这个谋略家
Dialogue: 0,0:06:20.62,0:06:23.62,Default,,0,0,0,,参谋总部帷幄重重 深不可测
Dialogue: 0,0:06:24.51,0:06:28.19,Default,,0,0,0,,我不认为我们能轻易得偿所愿
Dialogue: 0,0:06:28.97,0:06:31.73,Default,,0,0,0,,您对当今情势真是了如指掌
Dialogue: 0,0:06:32.09,0:06:34.62,Default,,0,0,0,,但是 机会总会有
Dialogue: 0,0:06:34.62,0:06:36.18,Default,,0,0,0,,没有也可以自己制造
Dialogue: 0,0:06:37.40,0:06:40.54,Default,,0,0,0,,那么 该怎么处理自由行星同盟？
Dialogue: 0,0:06:40.98,0:06:45.44,Default,,0,0,0,,地球教徒已经打入同盟的权贵之间甚深
Dialogue: 0,0:06:45.87,0:06:48.93,Default,,0,0,0,,岂能让苦心安排的棋子白白送死
Dialogue: 0,0:06:49.58,0:06:51.12,Default,,0,0,0,,并非白白送死
Dialogue: 0,0:06:51.47,0:06:56.34,Default,,0,0,0,,可以把他们当成腐蚀剂 从内部毁灭同盟
Dialogue: 0,0:06:57.03,0:06:58.90,Default,,0,0,0,,国家腐烂并非从根基
Dialogue: 0,0:06:58.90,0:07:00.69,Default,,0,0,0,,而是从顶层开始
Dialogue: 0,0:07:01.08,0:07:03.14,Default,,0,0,0,,无一例外
Dialogue: 0,0:07:06.35,0:07:09.40,Default,,0,0,0,,费沙自称是自治领
Dialogue: 0,0:07:09.40,0:07:11.05,Default,,0,0,0,,本质却是个国家
Dialogue: 0,0:07:11.83,0:07:14.56,Default,,0,0,0,,不会也从顶层开始腐烂吧
Dialogue: 0,0:07:17.03,0:07:18.38,Default,,0,0,0,,您真是说话不饶人
Dialogue: 0,0:07:18.76,0:07:22.12,Default,,0,0,0,,身为执政者的责任 我自会铭记于心
Dialogue: 0,0:07:23.18,0:07:24.03,Default,,0,0,0,,对了
Dialogue: 0,0:07:24.87,0:07:26.85,Default,,0,0,0,,严肃的话题就谈到这里吧
Dialogue: 0,0:07:26.85,0:07:29.03,Default,,0,0,0,,我为您准备了盛宴
Dialogue: 0,0:07:29.49,0:07:30.48,Default,,0,0,0,,不必了
Dialogue: 0,0:07:46.76,0:07:49.73,Default,,0,0,0,,哄主教开心一定很费心神吧 先生
Dialogue: 0,0:07:49.19,0:07:51.57,Basic_Sign2,,0,0,0,,{\fad(500,0)\u1\blur1\pos(1448,502)}费沙自治领主 助理 \N{\u0\fsp1}鲁伯特•凯塞林
Dialogue: 0,0:07:50.94,0:07:56.03,Default,,0,0,0,,唉 真不知这些教条主义者活着有什么乐趣
Dialogue: 0,0:07:56.97,0:07:58.34,Default,,0,0,0,,早在几千年前
Dialogue: 0,0:07:58.34,0:08:01.15,Default,,0,0,0,,宗教就洗脑当时的最高领导人
Dialogue: 0,0:08:01.42,0:08:07.14,Default,,0,0,0,,彻底压迫并灭绝其他宗教 长期统治国家和文明
Dialogue: 0,0:08:07.14,0:08:10.33,Default,,0,0,0,,真是一种绝无仅有 高效之极的侵略
Dialogue: 0,0:08:10.97,0:08:14.20,Default,,0,0,0,,我本想让地球教重现这一切
Dialogue: 0,0:08:14.66,0:08:16.52,Default,,0,0,0,,没想到这帮狂信徒食古不化
Dialogue: 0,0:08:16.52,0:08:18.89,Default,,0,0,0,,跟不上状况的变化啊
Dialogue: 0,0:08:19.43,0:08:20.79,Default,,0,0,0,,听说我的上一任
Dialogue: 0,0:08:21.14,0:08:23.99,Default,,0,0,0,,似乎很庆幸不必跟他们打交道
Dialogue: 0,0:08:24.39,0:08:28.22,Default,,0,0,0,,博尔德克更适合在奥丁当驻地特派员
Dialogue: 0,0:08:28.87,0:08:32.37,Default,,0,0,0,,走向新生的「新银河帝国」发生的一切
Dialogue: 0,0:08:32.37,0:08:34.49,Default,,0,0,0,,他都要逐一向我汇报
Dialogue: 0,0:08:35.77,0:08:39.68,Default,,0,0,0,,先生 您的确可以助推帝国建立新政权
Dialogue: 0,0:08:39.91,0:08:42.37,Basic_Sign2,,0,0,0,,{\fad(500,0)\fscx90\blur1\pos(404,458)}地球教  总大主教
Dialogue: 0,0:08:39.93,0:08:43.33,Default,,0,0,0,,但您也说了 地球教的最终目的
Dialogue: 0,0:08:43.67,0:08:45.54,Default,,0,0,0,,是靠宗教统治全人类
Dialogue: 0,0:08:45.86,0:08:47.91,Default,,0,0,0,,实现政教合一的神权政治
Dialogue: 0,0:08:48.79,0:08:51.43,Default,,0,0,0,,您应该不会容许他们做到这个地步吧
Dialogue: 0,0:08:52.87,0:08:54.12,Default,,0,0,0,,上一任自治领主
Dialogue: 0,0:08:54.47,0:08:57.16,Default,,0,0,0,,一旦表现出想要摆脱地球束缚的迹象
Dialogue: 0,0:08:57.16,0:08:58.36,Default,,0,0,0,,就立刻身死
Dialogue: 0,0:08:58.91,0:09:02.00,Default,,0,0,0,,还望您不要重蹈覆辙
Dialogue: 0,0:09:08.02,0:09:10.52,Basic_Sign2,,0,0,0,,{\fsp1\blur1\pos(1016,862)}费沙  伊兹麦尔地区
Dialogue: 0,0:09:12.76,0:09:16.40,Default,,0,0,0,,感谢您抽空见我 雷姆夏德伯爵先生
Dialogue: 0,0:09:16.91,0:09:17.90,Default,,0,0,0,,哪里
Dialogue: 0,0:09:18.53,0:09:23.12,Basic_Sign2,,0,0,0,,{\fad(500,550)\u1\pos(588,740)}原帝国高级特派员 \N{\u0}雷姆夏德伯爵  约翰
Dialogue: 0,0:09:18.44,0:09:21.98,Default,,0,0,0,,我怎么可能拒绝自治领主代理人的会面请求
Dialogue: 0,0:09:22.17,0:09:23.27,Default,,0,0,0,,不敢当
Dialogue: 0,0:09:24.81,0:09:25.84,Default,,0,0,0,,那么 先生…
Dialogue: 0,0:09:26.31,0:09:31.18,Default,,0,0,0,,恕我失礼 您当下的处境想必极为困难
Dialogue: 0,0:09:31.85,0:09:32.78,Default,,0,0,0,,没错吧
Dialogue: 0,0:09:35.88,0:09:37.96,Default,,0,0,0,,不用您提醒
Dialogue: 0,0:09:38.53,0:09:41.50,Default,,0,0,0,,我担任帝国高级特派员这一要职
Dialogue: 0,0:09:41.94,0:09:45.04,Default,,0,0,0,,如今不可能宣誓效忠金发小子
Dialogue: 0,0:09:45.41,0:09:48.83,Default,,0,0,0,,正因如此 我才在自治领接受流亡生活
Dialogue: 0,0:09:48.83,0:09:51.03,Default,,0,0,0,,落得无所事事的田地
Dialogue: 0,0:09:51.37,0:09:53.49,Default,,0,0,0,,请别这么说
Dialogue: 0,0:09:54.08,0:09:56.07,Default,,0,0,0,,其实我此次前来
Dialogue: 0,0:09:56.36,0:09:59.61,Default,,0,0,0,,正是为了罗严克拉姆新政权的事情
Dialogue: 0,0:10:00.05,0:10:00.95,Default,,0,0,0,,这是何意？
Dialogue: 0,0:10:01.49,0:10:04.79,Default,,0,0,0,,我们领主有一个计划供您参考
Dialogue: 0,0:10:05.41,0:10:07.01,Default,,0,0,0,,还望您垂听
Dialogue: 0,0:10:14.09,0:10:16.48,Default,,0,0,0,,这份提案真是大胆
Dialogue: 0,0:10:17.93,0:10:19.49,Default,,0,0,0,,同时也很诱人
Dialogue: 0,0:10:19.98,0:10:21.27,Default,,0,0,0,,谢谢夸奖
Dialogue: 0,0:10:21.66,0:10:24.13,Default,,0,0,0,,但是 我有一事费解
Dialogue: 0,0:10:24.92,0:10:29.87,Default,,0,0,0,,此事于我是求之不得 但于费沙又有什么好处？
Dialogue: 0,0:10:30.78,0:10:34.91,Default,,0,0,0,,罗严克拉姆公爵目前在帝国社会推动的改革
Dialogue: 0,0:10:35.25,0:10:38.52,Default,,0,0,0,,太过激进且独断了
Dialogue: 0,0:10:39.15,0:10:41.87,Default,,0,0,0,,我们费沙在帝国的部分权益
Dialogue: 0,0:10:41.87,0:10:44.22,Default,,0,0,0,,也已经逐渐受到了侵犯
Dialogue: 0,0:10:45.32,0:10:46.87,Default,,0,0,0,,改革不要紧
Dialogue: 0,0:10:46.87,0:10:49.80,Default,,0,0,0,,但方向不能对我们不利
Dialogue: 0,0:10:50.27,0:10:52.22,Default,,0,0,0,,这就是我们的立场
Dialogue: 0,0:10:52.91,0:10:55.36,Default,,0,0,0,,当然 待到计划成功
Dialogue: 0,0:10:55.36,0:10:59.34,Default,,0,0,0,,将高登巴姆王朝从可恨的篡位者手中解救出来之时
Dialogue: 0,0:10:59.97,0:11:02.56,Default,,0,0,0,,费沙自会收取相应的报酬
Dialogue: 0,0:11:02.97,0:11:06.41,Default,,0,0,0,,而拯救国家的伟人之名归您所有
Dialogue: 0,0:11:08.63,0:11:11.73,Default,,0,0,0,,这桩生意对我们双方都有益 不是吗
Dialogue: 0,0:11:13.30,0:11:15.01,Default,,0,0,0,,就连国家的存亡
Dialogue: 0,0:11:15.30,0:11:19.02,Default,,0,0,0,,也被你们费沙人拿来当交易的筹码啊
Dialogue: 0,0:11:19.02,0:11:20.74,Default,,0,0,0,,真是胆气豪壮
Dialogue: 0,0:11:21.57,0:11:27.09,Default,,0,0,0,,这样啊 若是我们帝国能够恢复这等活力和霸气…
Dialogue: 0,0:11:31.45,0:11:33.14,Default,,0,0,0,,去同盟特派员办事处
Dialogue: 0,0:11:33.47,0:11:34.61,Default,,0,0,0,,遵命
Dialogue: 0,0:11:36.76,0:11:40.57,Default,,0,0,0,,智者知难 愚者不知势不可为
Dialogue: 0,0:11:41.49,0:11:42.93,Default,,0,0,0,,他应该不算无能
Dialogue: 0,0:11:43.46,0:11:46.13,Default,,0,0,0,,但是要想摆脱「帝国不灭」的思想
Dialogue: 0,0:11:46.13,0:11:47.64,Default,,0,0,0,,似乎并不容易
Dialogue: 0,0:11:55.71,0:11:58.71,Basic_Sign2,,0,0,0,,{\blur1\pos(952,858)}自由行星同盟 特派员办事处
Dialogue: 0,0:11:59.22,0:12:01.97,Default,,0,0,0,,费沙持有的同盟国债
Dialogue: 0,0:11:59.57,0:12:04.61,Basic_Sign2,,0,0,0,,{\fad(500,400)\u1\fscx90\blur1\pos(1590,346)}自由行星同盟  特派员\N{\u0\fscx}亨斯洛
Dialogue: 0,0:12:01.97,0:12:04.74,Default,,0,0,0,,目前已经超过了5000亿第纳尔
Dialogue: 0,0:12:06.11,0:12:08.37,Default,,0,0,0,,考虑到贵国财政恶化
Dialogue: 0,0:12:08.73,0:12:13.41,Default,,0,0,0,,我们不得不暂缓购入新发行的同盟国债
Dialogue: 0,0:12:13.73,0:12:14.88,Default,,0,0,0,,这 这怎么行
Dialogue: 0,0:12:15.31,0:12:18.22,Default,,0,0,0,,这样一来 我国的财政会崩溃的
Dialogue: 0,0:12:18.65,0:12:20.25,Default,,0,0,0,,还望您重新考虑
Dialogue: 0,0:12:21.85,0:12:22.92,Default,,0,0,0,,这个嘛
Dialogue: 0,0:12:23.23,0:12:27.68,Default,,0,0,0,,我个人倒是乐意跟我们领主交涉
Dialogue: 0,0:12:27.68,0:12:30.63,Default,,0,0,0,,请他继续购入贵国的国债
Dialogue: 0,0:12:31.25,0:12:32.69,Default,,0,0,0,,请您务必美言几句
Dialogue: 0,0:12:32.69,0:12:33.76,Default,,0,0,0,,但前提是
Dialogue: 0,0:12:34.57,0:12:38.03,Default,,0,0,0,,贵国必须是稳定的民主国家
Dialogue: 0,0:12:39.06,0:12:41.67,Default,,0,0,0,,请问这是什么意思
Dialogue: 0,0:12:44.54,0:12:47.27,Default,,0,0,0,,去年贵国发生过政变风波
Dialogue: 0,0:12:47.81,0:12:50.70,Default,,0,0,0,,碰到那种事 我们很难办啊
Dialogue: 0,0:12:51.26,0:12:55.55,Default,,0,0,0,,费沙投入的巨额资本会蒙受损失
Dialogue: 0,0:12:55.55,0:12:57.87,Default,,0,0,0,,所…所言极是
Dialogue: 0,0:12:58.29,0:12:59.43,Default,,0,0,0,,所幸
Dialogue: 0,0:12:59.43,0:13:04.41,Default,,0,0,0,,杨威利提督成功阻止了政变的阴谋
Dialogue: 0,0:13:04.78,0:13:06.28,Default,,0,0,0,,实在是出色之极
Dialogue: 0,0:13:06.71,0:13:09.49,Default,,0,0,0,,提督的才能 名声 实力
Dialogue: 0,0:13:09.89,0:13:12.64,Default,,0,0,0,,如今在同盟军中已无人能及
Dialogue: 0,0:13:13.48,0:13:16.38,Default,,0,0,0,,正是 他确实是位了不起的名将
Dialogue: 0,0:13:17.56,0:13:18.98,Default,,0,0,0,,那么 特派员阁下
Dialogue: 0,0:13:19.30,0:13:24.42,Default,,0,0,0,,这位杨提督能顺从当前政权到何时
Dialogue: 0,0:13:25.09,0:13:27.35,Default,,0,0,0,,您考虑过吗
Dialogue: 0,0:13:28.51,0:13:29.83,Default,,0,0,0,,难 难不成…
Dialogue: 0,0:13:30.47,0:13:34.14,Default,,0,0,0,,助理先生认为杨提督会背弃同盟政府吗
Dialogue: 0,0:13:36.41,0:13:38.57,Default,,0,0,0,,之前镇压政变的时候
Dialogue: 0,0:13:38.86,0:13:42.59,Default,,0,0,0,,杨提督摧毁了保护首都星海尼森的攻击卫星
Dialogue: 0,0:13:42.95,0:13:45.27,Default,,0,0,0,,「阿耳忒弥斯的项链」
Dialogue: 0,0:13:54.44,0:13:59.37,Default,,0,0,0,,可是 真有必要毁掉全部12颗卫星吗
Dialogue: 0,0:14:00.07,0:14:01.65,Default,,0,0,0,,您这么一说…
Dialogue: 0,0:14:02.38,0:14:05.03,Default,,0,0,0,,那是杨提督
Dialogue: 0,0:14:05.03,0:14:08.30,Default,,0,0,0,,为自己日后攻陷海尼森清除障碍…
Dialogue: 0,0:14:09.03,0:14:10.98,Default,,0,0,0,,这样想也并无不可吧
Dialogue: 0,0:14:10.98,0:14:12.33,Default,,0,0,0,,确 确实…
Dialogue: 0,0:14:12.78,0:14:17.38,Default,,0,0,0,,政府内也有人担心他的舰队兵力比重过大
Dialogue: 0,0:14:18.03,0:14:19.08,Default,,0,0,0,,如此一来
Dialogue: 0,0:14:20.86,0:14:24.54,Default,,0,0,0,,我认为最好听杨提督解释一下
Dialogue: 0,0:14:31.41,0:14:33.23,Default,,0,0,0,,关于这两人 已经报告完毕
Dialogue: 0,0:14:33.93,0:14:36.28,Default,,0,0,0,,你好像心怀不满啊 凯塞林
Dialogue: 0,0:14:36.74,0:14:39.05,Default,,0,0,0,,雷姆夏德伯爵和同盟的特派员
Dialogue: 0,0:14:39.32,0:14:41.91,Default,,0,0,0,,都那么容易就被控制了 属实无趣
Dialogue: 0,0:14:42.54,0:14:46.29,Default,,0,0,0,,既然要谈判 我更想来一场针锋相对的谈判
Dialogue: 0,0:14:46.59,0:14:47.77,Default,,0,0,0,,何必奢求
Dialogue: 0,0:14:48.91,0:14:52.05,Default,,0,0,0,,你早晚会盼着对上好对付的对手
Dialogue: 0,0:14:52.65,0:14:53.35,Default,,0,0,0,,是…
Dialogue: 0,0:14:53.88,0:14:54.87,Default,,0,0,0,,其他呢
Dialogue: 0,0:14:55.25,0:14:57.06,Default,,0,0,0,,有些琐事
Dialogue: 0,0:14:57.81,0:15:00.79,Default,,0,0,0,,驻自由行星同盟的特派员办事处
Dialogue: 0,0:15:01.10,0:15:04.38,Default,,0,0,0,,对一个叫鲍里斯·高尼夫的男人颇有微词
Dialogue: 0,0:15:10.54,0:15:14.37,Default,,0,0,0,,说他明显欠缺协作性和勤奋精神
Dialogue: 0,0:15:15.34,0:15:16.14,Default,,0,0,0,,哦？
Dialogue: 0,0:15:16.57,0:15:20.72,Default,,0,0,0,,用公务员的身份束缚那种独立商人
Dialogue: 0,0:15:21.14,0:15:24.75,Default,,0,0,0,,或许是在让游牧民种田吧
Dialogue: 0,0:15:25.83,0:15:27.71,Default,,0,0,0,,你不觉得这是适材适所吗
Dialogue: 0,0:15:28.13,0:15:32.42,Default,,0,0,0,,当然了 您必定是经过深思熟虑才如此安排的
Dialogue: 0,0:15:32.82,0:15:35.87,Default,,0,0,0,,这个男人或许是该任其自由发挥
Dialogue: 0,0:15:36.43,0:15:38.98,Default,,0,0,0,,但有些棋子即使现在看来没用
Dialogue: 0,0:15:38.98,0:15:41.97,Default,,0,0,0,,日后却有可能派上用场
Dialogue: 0,0:15:42.51,0:15:46.41,Default,,0,0,0,,等地层积聚石油需要几亿年时间
Dialogue: 0,0:15:46.86,0:15:49.70,Default,,0,0,0,,但人只要等上半个世纪自然会出结果
Dialogue: 0,0:15:49.70,0:15:50.98,Default,,0,0,0,,不必心急
Dialogue: 0,0:15:53.10,0:15:56.11,Default,,0,0,0,,鲍里斯·高尼夫就这么处置也没问题
Dialogue: 0,0:15:56.71,0:15:59.04,Default,,0,0,0,,但此次计划需要的人
Dialogue: 0,0:15:59.40,0:16:02.06,Default,,0,0,0,,必须遵照我们的意志行动才行
Dialogue: 0,0:16:02.99,0:16:04.91,Default,,0,0,0,,我觉得相当困难
Dialogue: 0,0:16:05.21,0:16:08.08,Default,,0,0,0,,怎么会 想任意摆布一个人
Dialogue: 0,0:16:08.08,0:16:10.48,Default,,0,0,0,,只要让状况更加单纯就行了
Dialogue: 0,0:16:10.98,0:16:12.20,Default,,0,0,0,,此话怎讲
Dialogue: 0,0:16:12.94,0:16:16.46,Default,,0,0,0,,剥夺其自由 减少其可选项
Dialogue: 0,0:16:18.73,0:16:23.07,Default,,0,0,0,,一流当权者的目的是「借权力有所作为」
Dialogue: 0,0:16:23.65,0:16:28.06,Default,,0,0,0,,但二流当权者的目的在于「维持住权力」
Dialogue: 0,0:16:28.64,0:16:31.57,Default,,0,0,0,,同盟的当权者属于哪一类不言而喻
Dialogue: 0,0:16:32.22,0:16:34.45,Default,,0,0,0,,就拿同盟军的杨威利来说
Dialogue: 0,0:16:34.45,0:16:39.04,Default,,0,0,0,,他正站在同盟和帝国间的一根细钢丝上
Dialogue: 0,0:16:39.52,0:16:42.40,Default,,0,0,0,,费沙只要把这根钢丝磨得更细就好
Dialogue: 0,0:16:43.34,0:16:46.62,Default,,0,0,0,,他早晚得从两条路中选择一条
Dialogue: 0,0:16:47.41,0:16:49.61,Default,,0,0,0,,是被本国的当权者清洗掉
Dialogue: 0,0:16:50.05,0:16:52.95,Default,,0,0,0,,还是扳倒他们 取而代之
Dialogue: 0,0:16:53.67,0:16:58.62,Default,,0,0,0,,也有可能 他在那之前就在战争中输给罗严克拉姆公爵
Dialogue: 0,0:16:59.10,0:17:00.28,Default,,0,0,0,,反过来也有可能
Dialogue: 0,0:17:00.85,0:17:03.10,Default,,0,0,0,,届时您要如何应对？
Dialogue: 0,0:17:04.59,0:17:07.35,Default,,0,0,0,,助理 貌似我说得太多了
Dialogue: 0,0:17:07.35,0:17:09.33,Default,,0,0,0,,你也问得太多了啊
Dialogue: 0,0:17:11.15,0:17:14.55,Default,,0,0,0,,我们现在除了聊哲学 还有很多事要做
Dialogue: 0,0:17:15.62,0:17:18.71,Default,,0,0,0,,盟主可以逼着雷姆夏德伯爵来当
Dialogue: 0,0:17:18.71,0:17:21.57,Default,,0,0,0,,但执行部队的领导好像还没定下来吧
Dialogue: 0,0:17:22.16,0:17:26.95,Default,,0,0,0,,抱歉 我会在近期定下人选 向您报告
Dialogue: 0,0:17:33.28,0:17:37.95,Basic_Sign2,,0,0,0,,{\fad(500,0)\blur1\pos(964,870)}阿西尼博雅溪谷
Dialogue: 0,0:17:48.17,0:17:51.59,Basic_Sign2,,0,0,0,,{\fad(450,550)\blur1\u1\pos(1390,397)}原银河帝国军 上校\N{\u0}雷欧波特•休马哈
Dialogue: 0,0:17:48.10,0:17:51.56,Default,,0,0,0,,雷欧波特·休马哈原帝国军上校
Dialogue: 0,0:17:52.38,0:17:54.49,Default,,0,0,0,,在利普休达特战役中
Dialogue: 0,0:17:54.49,0:17:57.48,Default,,0,0,0,,于菲列格尔男爵的舰队担任参谋
Dialogue: 0,0:17:58.35,0:18:00.22,Default,,0,0,0,,当时众部下劝谏男爵不该鲁莽续战
Dialogue: 0,0:18:00.22,0:18:02.74,Default,,0,0,0,,致其情绪失控 被众人枪杀
Dialogue: 0,0:18:03.58,0:18:06.75,Default,,0,0,0,,休马哈带着他们流亡费沙
Dialogue: 0,0:18:06.75,0:18:10.14,Default,,0,0,0,,卖掉了搭乘的战列舰和武器 换取资金
Dialogue: 0,0:18:10.45,0:18:14.53,Default,,0,0,0,,过着经营农场的安稳生活
Dialogue: 0,0:18:16.03,0:18:18.67,Default,,0,0,0,,请您别来打扰我们了
Dialogue: 0,0:18:19.17,0:18:22.32,Default,,0,0,0,,银河帝国和高登巴姆王朝会怎么样
Dialogue: 0,0:18:22.32,0:18:23.66,Default,,0,0,0,,跟我们都没有关系
Dialogue: 0,0:18:24.01,0:18:27.25,Default,,0,0,0,,如今光是跟战友们建立新生活就够我忙的了
Dialogue: 0,0:18:27.81,0:18:29.77,Default,,0,0,0,,至于我已经舍弃的过去 就别再…
Dialogue: 0,0:18:30.34,0:18:32.70,Default,,0,0,0,,您大可舍弃过去
Dialogue: 0,0:18:33.14,0:18:36.86,Default,,0,0,0,,但您不能拉着未来一起陪葬
Dialogue: 0,0:18:36.86,0:18:38.15,Default,,0,0,0,,休马哈上校
Dialogue: 0,0:18:41.63,0:18:43.32,Default,,0,0,0,,这茶园真不错啊
Dialogue: 0,0:18:44.12,0:18:46.69,Default,,0,0,0,,将贫瘠的土地开拓到这个地步
Dialogue: 0,0:18:46.69,0:18:49.02,Default,,0,0,0,,究竟耗费了多少汗水啊
Dialogue: 0,0:18:49.65,0:18:50.91,Default,,0,0,0,,然而可悲的是
Dialogue: 0,0:18:51.27,0:18:53.96,Default,,0,0,0,,作物只有拿到市场上卖才有意义
Dialogue: 0,0:18:54.37,0:18:56.62,Default,,0,0,0,,聪明如您 应该明白吧
Dialogue: 0,0:18:57.20,0:18:59.80,Default,,0,0,0,,这就是费沙的做派吗
Dialogue: 0,0:18:59.80,0:19:01.56,Default,,0,0,0,,您大可鄙视我们
Dialogue: 0,0:19:01.88,0:19:04.59,Default,,0,0,0,,但是 输家鄙视赢家
Dialogue: 0,0:19:04.59,0:19:07.32,Default,,0,0,0,,我认为这是天底下最无意义的事
Dialogue: 0,0:19:07.91,0:19:10.30,Default,,0,0,0,,人在获胜的时候的确会这么想
Dialogue: 0,0:19:12.04,0:19:14.76,Default,,0,0,0,,您得协助我们的计划
Dialogue: 0,0:19:15.07,0:19:16.17,Default,,0,0,0,,跟我走吧
Dialogue: 0,0:19:23.23,0:19:24.51,Default,,0,0,0,,太精彩了
Dialogue: 0,0:19:24.99,0:19:29.02,Default,,0,0,0,,这计划正适合我们这些高登巴姆王朝的正统
Dialogue: 0,0:19:30.69,0:19:35.90,Basic_Sign2,,0,0,0,,{\fad(500,550)\blur1\pos(508,865)}蓝德斯堡伯爵 阿弗雷德
Dialogue: 0,0:19:30.58,0:19:32.68,Default,,0,0,0,,我们愿意奉雷姆夏德伯爵为盟主
Dialogue: 0,0:19:32.68,0:19:35.97,Default,,0,0,0,,向全宇宙证明我们对帝国的忠心
Dialogue: 0,0:19:36.68,0:19:38.12,Default,,0,0,0,,多么激动人心
Dialogue: 0,0:19:38.39,0:19:39.22,Default,,0,0,0,,助理先生
Dialogue: 0,0:19:39.22,0:19:43.23,Default,,0,0,0,,我阿弗雷德 甘愿舍却身家性命参与计划
Dialogue: 0,0:19:43.70,0:19:46.66,Default,,0,0,0,,谢谢您 蓝德斯堡伯爵
Dialogue: 0,0:19:48.61,0:19:51.56,Default,,0,0,0,,这位是本计划实施部队的指挥
Dialogue: 0,0:19:51.56,0:19:53.41,Default,,0,0,0,,雷欧波特·休马哈上校
Dialogue: 0,0:19:54.47,0:19:55.98,Default,,0,0,0,,拜托你了 上校
Dialogue: 0,0:19:56.66,0:19:57.37,Default,,0,0,0,,嗯…
Dialogue: 0,0:19:58.20,0:20:00.52,Default,,0,0,0,,伯爵 休马哈上校他
Dialogue: 0,0:20:00.82,0:20:02.23,Default,,0,0,0,,曾经在利普休达特战役中
Dialogue: 0,0:20:02.50,0:20:05.78,Default,,0,0,0,,以贵族联合军成员的身份战斗过
Dialogue: 0,0:20:06.64,0:20:08.42,Default,,0,0,0,,什么 是这样啊
Dialogue: 0,0:20:08.42,0:20:10.14,Default,,0,0,0,,我不记得见过你
Dialogue: 0,0:20:10.14,0:20:11.95,Default,,0,0,0,,但既然如此 你我便是战友
Dialogue: 0,0:20:11.95,0:20:14.09,Default,,0,0,0,,而今后更是同志了啊
Dialogue: 0,0:20:15.12,0:20:16.82,Default,,0,0,0,,还请多多关照了
Dialogue: 0,0:20:18.06,0:20:19.99,Default,,0,0,0,,上校 期待你的表现
Dialogue: 0,0:20:36.00,0:20:39.17,Default,,0,0,0,,自治领主鲁宾斯基最近用的那个助理
Dialogue: 0,0:20:39.53,0:20:40.69,Default,,0,0,0,,你对他有了解吗
Dialogue: 0,0:20:41.17,0:20:43.18,Default,,0,0,0,,是一个叫鲁伯特·凯塞林的
Dialogue: 0,0:20:43.60,0:20:46.05,Default,,0,0,0,,不清楚 没什么特别的评价
Dialogue: 0,0:20:48.77,0:20:51.73,Default,,0,0,0,,我可以请你喝酒
Dialogue: 0,0:20:52.93,0:20:55.69,Default,,0,0,0,,我要是知道 早就伸手掏你钱包了
Dialogue: 0,0:20:59.97,0:21:01.30,Default,,0,0,0,,你就好好努力吧
Dialogue: 0,0:21:07.44,0:21:10.90,Default,,0,0,0,,想打听鲁伯特消息的人 就是你吗
Dialogue: 0,0:21:14.21,0:21:15.35,Default,,0,0,0,,我来告诉你
Dialogue: 0,0:21:16.02,0:21:17.23,Default,,0,0,0,,你知道什么
Dialogue: 0,0:21:17.95,0:21:20.79,Default,,0,0,0,,决定买到宝石重量的因素只有一个
Dialogue: 0,0:21:21.16,0:21:22.19,Default,,0,0,0,,看你能出多少了
Dialogue: 0,0:21:22.85,0:21:24.16,Default,,0,0,0,,我们后门见
Dialogue: 0,0:22:13.70,0:22:16.87,Default,,0,0,0,,自数日前失去音讯的尼利兹·海克…
Dialogue: 0,0:22:17.62,0:22:20.39,Default,,0,0,0,,据报告 在费沙「意外死亡」了
Dialogue: 0,0:22:21.90,0:22:24.17,Default,,0,0,0,,看来墙比想象中厚啊
Dialogue: 0,0:22:25.84,0:22:27.82,Default,,0,0,0,,绝不能让他们想象到
Dialogue: 0,0:22:28.52,0:22:34.17,Default,,0,0,0,,费沙与新银河帝国一起瓜分宇宙的未来
Dialogue: 0,0:22:34.70,0:22:36.71,Default,,0,0,0,,不是划分国界的统治
Dialogue: 0,0:22:37.17,0:22:39.81,Default,,0,0,0,,而是由帝国掌握政治和军事的控制权
Dialogue: 0,0:22:40.29,0:22:42.71,Default,,0,0,0,,由费沙掌握经济控制权
Dialogue: 0,0:22:43.30,0:22:47.76,Default,,0,0,0,,而同盟则埋进土里 成为这一体系的肥料
Dialogue: 0,0:22:50.54,0:22:52.32,Default,,0,0,0,,不能让人发觉
Dialogue: 0,0:22:51.18,0:22:55.81,Basic_Sign2,,0,0,0,,{\fad(500,0)\i1\blur1\pos(760,791)}自动驾驶汽车造成事故  一人死亡
Dialogue: 0,0:22:53.34,0:22:57.04,Default,,0,0,0,,自由行星同盟的敌人不是银河帝国
Dialogue: 0,0:22:57.54,0:23:00.84,Default,,0,0,0,,而是高登巴姆王朝这一事实
Dialogue: 0,0:23:01.80,0:23:05.66,Default,,0,0,0,,当双方意识到高登巴姆王朝是共同的敌人时
Dialogue: 0,0:23:06.12,0:23:08.99,Default,,0,0,0,,就会发现罗严克拉姆新政权和同盟
Dialogue: 0,0:23:09.38,0:23:12.00,Default,,0,0,0,,有可能共存的事实
Dialogue: 0,0:23:13.05,0:23:16.88,Default,,0,0,0,,不用永远 再来几年就够了
Dialogue: 0,0:23:17.85,0:23:22.52,Default,,0,0,0,,只有当战火平息 人类才会意识到
Dialogue: 0,0:23:23.54,0:23:27.78,Default,,0,0,0,,究竟是谁在统治银河
Dialogue: 0,0:23:35.93,0:23:37.24,title,,0,0,0,,一根细丝
Dialogue: 0,0:23:37.24,0:23:43.77,EDCN,,0,0,0,,温柔渐渐融化
Dialogue: 0,0:23:43.77,0:23:49.81,EDCN,,0,0,0,,在杯中盘桓
Dialogue: 0,0:23:49.81,0:23:55.03,EDCN,,0,0,0,,一味旋转却抓不住
Dialogue: 0,0:23:55.42,0:24:02.41,EDCN,,0,0,0,,因为有答案 即将溢出
Dialogue: 0,0:24:02.97,0:24:09.59,EDCN,,0,0,0,,夜空中的寒星啊
Dialogue: 0,0:24:09.59,0:24:16.03,EDCN,,0,0,0,,请将这些苦痛照耀 拥抱
Dialogue: 0,0:24:16.03,0:24:23.82,EDCN,,0,0,0,,这份无边满溢的悲伤
Dialogue: 0,0:24:23.82,0:24:28.99,EDCN,,0,0,0,,也定会改换形貌 亘古闪耀
Dialogue: 0,0:24:29.19,0:24:35.63,EDCN,,0,0,0,,你是我唯一 我终于明白
Dialogue: 0,0:24:35.63,0:24:42.44,EDCN,,0,0,0,,我们正要起步 你却已离开
Dialogue: 0,0:24:42.44,0:24:49.03,EDCN,,0,0,0,,你是我唯一 我终于明白
Dialogue: 0,0:24:49.03,0:24:56.52,EDCN,,0,0,0,,我们正要起步 你却已离开
Dialogue: 0,0:23:37.24,0:23:43.77,EDJP,,0,0,0,,優しさには見えている
Dialogue: 0,0:23:43.77,0:23:49.81,EDJP,,0,0,0,,グラスの中でずっと
Dialogue: 0,0:23:49.81,0:23:55.03,EDJP,,0,0,0,,転がすだけで掴めずに
Dialogue: 0,0:23:55.42,0:24:02.41,EDJP,,0,0,0,,こぼれそうな　答えがあるから
Dialogue: 0,0:24:02.97,0:24:09.59,EDJP,,0,0,0,,夜空の冷たい星よ
Dialogue: 0,0:24:09.59,0:24:16.03,EDJP,,0,0,0,,この痛みたちを照らし抱いて
Dialogue: 0,0:24:16.03,0:24:23.82,EDJP,,0,0,0,,止め処なく溢れる悲しさも
Dialogue: 0,0:24:23.82,0:24:28.99,EDJP,,0,0,0,,形を変え輝いていくだろう
Dialogue: 0,0:24:29.19,0:24:35.63,EDJP,,0,0,0,,You're the only one, I descry
Dialogue: 0,0:24:35.63,0:24:42.44,EDJP,,0,0,0,,We've only just begun to stand by
Dialogue: 0,0:24:42.44,0:24:49.03,EDJP,,0,0,0,,You're the only one, I descry
Dialogue: 0,0:24:49.03,0:24:56.52,EDJP,,0,0,0,,We've only just begun to stand by
Dialogue: 0,0:25:01.03,0:25:10.91,title,,0,0,0,,第三十一集 所失
Dialogue: 0,0:25:02.62,0:25:05.85,Default,,0,0,0,,{\pos(964,1054)}下集 所失

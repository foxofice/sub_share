Dialogue: 0,0:03:31.36,0:03:36.36,Default,,0,0,0,,{\fad(520,520)\shad0\3c&H305F9B&\blur6\b1\fn方正中粗雅宋_GBK\fs55\pos(1544,1076)}商人與蠻橫無理的神
Dialogue: 0,0:23:45.03,0:23:50.03,Default,,0,0,0,,{\1c&H425B72&\fsp4\b1\fn方正中粗雅宋_GBK\bord0\shad0\pos(960,914)}神的天平與草原魔法師
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,MAIN
Dialogue: 0,0:00:14.76,0:00:15.49,Default,,0,0,0,,怎麼了
Dialogue: 0,0:00:15.86,0:00:18.49,Default,,0,0,0,,空氣在微微顫抖
Dialogue: 0,0:00:23.19,0:00:25.55,Default,,0,0,0,,上面應該是市場附近
Dialogue: 0,0:00:26.07,0:00:27.36,Default,,0,0,0,,所以才會顫抖吧
Dialogue: 0,0:00:27.36,0:00:30.36,Default,,0,0,0,,不 不一樣
Dialogue: 0,0:00:31.37,0:00:34.06,Default,,0,0,0,,這是…水？
Dialogue: 0,0:00:35.68,0:00:38.49,Default,,0,0,0,,水花飛濺的聲音？
Dialogue: 0,0:00:41.89,0:00:43.44,Default,,0,0,0,,是追兵？哪邊來的？
Dialogue: 0,0:00:44.87,0:00:45.75,Default,,0,0,0,,前邊來的
Dialogue: 0,0:00:46.08,0:00:47.55,Default,,0,0,0,,不妙 快往後退
Dialogue: 0,0:00:53.90,0:00:55.45,Default,,0,0,0,,這裡只有一條路嗎
Dialogue: 0,0:00:55.96,0:00:58.03,Default,,0,0,0,,我們剛剛走的方向是的
Dialogue: 0,0:00:58.49,0:01:00.12,Default,,0,0,0,,但回頭路可是個大迷宮
Dialogue: 0,0:01:00.65,0:01:04.46,Default,,0,0,0,,哪怕是咱 也沒有自信說不會在這裡迷路
Dialogue: 0,0:01:08.13,0:01:08.81,Default,,0,0,0,,怎麼了
Dialogue: 0,0:01:09.05,0:01:10.52,Default,,0,0,0,,用跑的也會被追上的
Dialogue: 0,0:01:11.18,0:01:13.63,Default,,0,0,0,,他們放狗了
Dialogue: 0,0:01:16.05,0:01:18.43,Default,,0,0,0,,這幫狗聽著就很傻氣
Dialogue: 0,0:01:18.78,0:01:21.51,Default,,0,0,0,,汝快把耳朵堵上吧
Dialogue: 0,0:01:36.90,0:01:37.69,Default,,0,0,0,,什麼情況
Dialogue: 0,0:01:50.26,0:01:53.01,Default,,0,0,0,,好想吃蘋果啊
Dialogue: 0,0:01:54.82,0:01:56.68,Default,,0,0,0,,出去了想吃多少都行
Dialogue: 0,0:03:30.34,0:03:31.15,Default,,0,0,0,,話說回來
Dialogue: 0,0:03:31.43,0:03:32.73,Default,,0,800,0,,他們怎麼發現的
Dialogue: 0,0:03:33.16,0:03:37.14,Default,,0,600,0,,估計只是四處搜查的時候恰好找來了地下吧
Dialogue: 0,0:03:37.14,0:03:38.39,Default,,0,0,0,,真的嗎
Dialogue: 0,0:03:38.39,0:03:40.37,Default,,0,0,0,,如果真知道我們在下面
Dialogue: 0,0:03:41.45,0:03:42.91,Default,,0,0,0,,我們早被前後夾擊了
Dialogue: 0,0:03:45.72,0:03:47.79,Default,,0,0,0,,米隆商行已經出賣了你們
Dialogue: 0,0:03:47.79,0:03:49.54,Default,,0,0,0,,再怎麼逃都是沒用的
Dialogue: 0,0:03:51.13,0:03:54.07,Default,,0,0,0,,我們似乎被賣了呀
Dialogue: 0,0:03:54.57,0:03:56.60,Default,,0,0,0,,估計賣了個不錯的價錢
Dialogue: 0,0:03:56.87,0:04:00.16,Default,,0,0,0,,畢竟只要能抓住妳 就能毀掉米隆商行
Dialogue: 0,0:04:00.16,0:04:03.47,Default,,0,0,0,,是嗎 那看來價錢確實很高
Dialogue: 0,0:04:03.47,0:04:05.67,Default,,0,0,0,,他們只是想嚇唬我們而已
Dialogue: 0,0:04:06.49,0:04:07.10,Default,,0,0,0,,走吧
Dialogue: 0,0:04:09.96,0:04:10.81,Default,,0,0,0,,慢著
Dialogue: 0,0:04:13.27,0:04:14.25,Default,,0,0,0,,找到了
Dialogue: 0,0:04:16.82,0:04:18.28,Default,,0,0,0,,在那邊 快追上去
Dialogue: 0,0:04:18.69,0:04:21.27,Default,,0,0,0,,你跟好了 我去繞後
Dialogue: 0,0:04:21.27,0:04:22.15,Default,,0,0,0,,好
Dialogue: 0,0:04:22.52,0:04:24.01,Default,,0,0,0,,那邊傳來了腳步聲
Dialogue: 0,0:04:24.01,0:04:24.95,Default,,0,0,0,,把他們逼進死路
Dialogue: 0,0:04:25.29,0:04:26.97,Default,,0,0,0,,這邊還沒看見人呢
Dialogue: 0,0:04:26.97,0:04:28.39,Default,,0,0,0,,小路全都盯好了
Dialogue: 0,0:04:30.12,0:04:31.57,Default,,0,0,0,,汝記得路嗎
Dialogue: 0,0:04:31.57,0:04:33.99,Default,,0,0,0,,嗯 記得 接下來左轉
Dialogue: 0,0:04:46.95,0:04:47.83,Default,,0,0,0,,趕緊走吧
Dialogue: 0,0:04:56.37,0:04:57.32,Default,,0,0,0,,羅倫斯
Dialogue: 0,0:04:57.89,0:05:01.07,Default,,0,0,0,,神啊 寬恕我的罪行吧
Dialogue: 0,0:05:07.95,0:05:11.86,Default,,0,0,0,,悔罪之前 你應該先懺悔自己平時沒有積德
Dialogue: 0,0:05:19.86,0:05:20.88,Default,,0,0,0,,羅倫斯
Dialogue: 0,0:05:21.64,0:05:24.26,Default,,0,0,0,,沒關係 我記得路
Dialogue: 0,0:05:29.27,0:05:31.08,Upper,,0,600,0,,可惡 人呢
Dialogue: 0,0:05:29.99,0:05:31.08,Upper,,600,0,0,,喂 都過來看看
Dialogue: 0,0:05:31.08,0:05:32.92,Default,,0,0,0,,肯定留下了傷口
Dialogue: 0,0:05:32.92,0:05:34.31,Default,,0,0,0,,{\fad(0,1200)}趕緊追上去
Dialogue: 0,0:05:36.76,0:05:37.69,Default,,0,0,0,,羅倫斯
Dialogue: 0,0:05:39.11,0:05:40.25,Default,,0,0,0,,汝還好嗎
Dialogue: 0,0:05:40.87,0:05:41.95,Default,,0,0,0,,羅倫斯
Dialogue: 0,0:05:44.12,0:05:45.20,Default,,0,0,0,,太好了
Dialogue: 0,0:05:45.66,0:05:48.54,Default,,0,0,0,,咱一直在叫汝的名字 汝卻沒點反應
Dialogue: 0,0:05:50.24,0:05:53.06,Default,,0,0,0,,沒事 我只是有點睏而已
Dialogue: 0,0:05:53.61,0:05:56.29,Default,,0,0,0,,再堅持一下 馬上就要到了
Dialogue: 0,0:05:56.29,0:05:57.64,Default,,0,0,0,,到哪裡
Dialogue: 0,0:05:57.64,0:05:59.13,Default,,0,0,0,,汝沒聽見嗎
Dialogue: 0,0:05:59.42,0:06:01.10,Default,,0,0,0,,那邊能聞到陽光的味道
Dialogue: 0,0:06:01.10,0:06:03.85,Default,,0,0,0,,汝不是說有個地方能到地面上去嗎
Dialogue: 0,0:06:03.85,0:06:06.43,Default,,0,0,0,,嗯 我都給忘了
Dialogue: 0,0:06:08.08,0:06:08.72,Default,,0,0,0,,這是？
Dialogue: 0,0:06:08.72,0:06:12.06,Default,,0,0,0,,汝都沒感覺的嗎
Dialogue: 0,0:06:15.48,0:06:16.56,Default,,0,0,0,,堅持一下
Dialogue: 0,0:06:17.05,0:06:18.44,Default,,0,0,0,,再堅持一下就好了
Dialogue: 0,0:06:21.37,0:06:22.28,Default,,0,0,0,,沒
Dialogue: 0,0:06:23.05,0:06:25.41,Default,,0,0,0,,我有印象的 別擔心
Dialogue: 0,0:06:32.28,0:06:33.13,Default,,0,0,0,,這邊走
Dialogue: 0,0:06:37.19,0:06:41.77,Default,,0,0,0,,這條路走到底右轉 應該就能逃到地面上去
Dialogue: 0,0:06:55.46,0:06:56.78,Default,,0,0,0,,怎麼會
Dialogue: 0,0:06:57.40,0:06:58.99,Default,,0,0,0,,是口老井啊
Dialogue: 0,0:06:59.93,0:07:03.24,Default,,0,0,0,,對不起 咱沒想到竟然是這樣
Dialogue: 0,0:07:03.24,0:07:04.18,Default,,0,0,0,,找到了
Dialogue: 0,0:07:08.08,0:07:09.13,Default,,0,0,0,,妳待在後頭吧
Dialogue: 0,0:07:10.55,0:07:12.82,Default,,0,0,0,,怎麼可能 汝應付不來的吧
Dialogue: 0,0:07:12.82,0:07:13.66,Default,,0,0,0,,沒事
Dialogue: 0,0:07:16.27,0:07:17.63,Default,,0,0,0,,我還能打
Dialogue: 0,0:07:18.21,0:07:21.21,Default,,0,0,0,,騙人 哪怕不是咱的耳朵也聽得出來汝在騙人
Dialogue: 0,0:07:22.18,0:07:22.95,Default,,0,0,0,,慢著
Dialogue: 0,0:07:26.96,0:07:30.97,Default,,0,0,0,,聽到匯報上來的長相特徵時 我就在猜了
Dialogue: 0,0:07:31.71,0:07:34.78,Default,,0,0,0,,沒想到竟然真的是你啊 羅倫斯
Dialogue: 0,0:07:35.40,0:07:36.98,Default,,0,0,0,,我也很驚訝
Dialogue: 0,0:07:37.32,0:07:40.94,Default,,0,0,0,,沒想到你居然開始操盤這麼重大的交易了
Dialogue: 0,0:07:40.94,0:07:43.48,Default,,0,0,0,,你也變厲害了啊 葉勒
Dialogue: 0,0:07:45.99,0:07:49.45,Default,,0,0,0,,梅迪歐商行的後台是亞倫多伯爵
Dialogue: 0,0:07:50.15,0:07:51.53,Default,,0,0,0,,作為小麥的主要產地
Dialogue: 0,0:07:51.53,0:07:55.29,Default,,0,0,0,,你們可以在交易時收取指定的銀幣
Dialogue: 0,0:07:55.61,0:07:58.75,Default,,0,0,0,,不僅如此 如果能撤銷小麥的關稅
Dialogue: 0,0:07:58.75,0:08:03.50,Default,,0,0,0,,顯然將給伯爵 梅迪歐商行和村子帶來巨大好處
Dialogue: 0,0:08:03.99,0:08:07.17,Default,,0,0,0,,你認識來往村裡的商人
Dialogue: 0,0:08:07.17,0:08:09.30,Default,,0,0,0,,村長也將交易都交給了你
Dialogue: 0,0:08:09.72,0:08:14.22,Default,,0,0,0,,最後 小麥交易大多集中於豐收節後
Dialogue: 0,0:08:14.50,0:08:18.02,Default,,0,0,0,,家常話可以回頭再聊 時間不多了
Dialogue: 0,0:08:18.25,0:08:19.88,Default,,0,0,0,,太見外了吧 葉勒
Dialogue: 0,0:08:20.28,0:08:24.69,Default,,0,0,0,,你特意跑來這裡 不就是為了見一見之前從沒信過的狼神嗎
Dialogue: 0,0:08:24.69,0:08:27.40,Default,,0,0,0,,沒想到棲息於麥田之中
Dialogue: 0,0:08:27.77,0:08:34.09,Default,,0,0,0,,能自由掌控豐歉的狼 居然成了你的旅伴
Dialogue: 0,0:08:34.93,0:08:36.54,Default,,0,0,0,,快把她交出來
Dialogue: 0,0:08:36.86,0:08:41.17,Default,,0,0,0,,我們要把她交給教會 與舊時代說再見
Dialogue: 0,0:08:41.56,0:08:45.42,Default,,0,0,0,,只要有她在手上 我們就能摧毀米隆商行
Dialogue: 0,0:08:47.43,0:08:49.99,Default,,0,0,0,,到時候如果能取消關稅
Dialogue: 0,0:08:49.99,0:08:53.01,Default,,0,0,0,,村裡的小麥必定會成為一棵搖錢樹
Dialogue: 0,0:08:53.01,0:08:55.27,Default,,0,0,0,,村裡人都能過上富足的生活
Dialogue: 0,0:08:56.12,0:08:57.02,Default,,0,0,0,,羅倫斯
Dialogue: 0,0:08:57.02,0:09:00.52,Default,,0,0,0,,買賣我們小麥的商人也一樣
Dialogue: 0,0:09:00.87,0:09:05.45,Default,,0,0,0,,當年在沉重的關稅之下 你依然收購了我們的小麥
Dialogue: 0,0:09:05.45,0:09:07.90,Default,,0,0,0,,村裡人都很感激你
Dialogue: 0,0:09:08.23,0:09:12.41,Default,,0,0,0,,要讓大家認可你的優先購買權很簡單
Dialogue: 0,0:09:12.81,0:09:15.95,Default,,0,0,0,,何況我們也是老交情了
Dialogue: 0,0:09:16.24,0:09:19.50,Default,,0,0,0,,到時候你很快就能實現開店的夢想
Dialogue: 0,0:09:19.86,0:09:24.00,Default,,0,0,0,,到時候我們甚至能一起去做更大的生意
Dialogue: 0,0:09:24.36,0:09:26.42,Default,,0,0,0,,是你教會了我如何做生意
Dialogue: 0,0:09:26.88,0:09:30.33,Default,,0,0,0,,現在我希望能幫助你成為成功的生意人
Dialogue: 0,0:09:31.00,0:09:32.41,Default,,0,0,0,,來吧 羅倫斯
Dialogue: 0,0:09:32.89,0:09:36.28,Default,,0,0,0,,身為商人 個中利益你應該算得很清楚吧
Dialogue: 0,0:09:39.32,0:09:41.44,Default,,0,0,0,,利益得失我當然算得清
Dialogue: 0,0:09:43.68,0:09:44.65,Default,,0,0,0,,羅倫斯
Dialogue: 0,0:09:44.65,0:09:45.67,Default,,0,0,0,,但是
Dialogue: 0,0:09:46.21,0:09:50.26,Default,,0,0,0,,商人首要的底線應該是遵守合約
Dialogue: 0,0:09:51.21,0:09:56.70,Default,,0,0,0,,機緣巧合下 我撿到的這個奇怪女孩想要回歸北方
Dialogue: 0,0:09:57.17,0:10:01.08,Default,,0,0,0,,我與她立下了一同旅行的約定
Dialogue: 0,0:10:01.65,0:10:04.39,Default,,0,0,0,,我可不想違反約定
Dialogue: 0,0:10:08.21,0:10:11.76,Default,,0,0,0,,那我也只能選擇執行自己的合約了
Dialogue: 0,0:10:12.04,0:10:13.09,Default,,0,0,0,,真遺憾
Dialogue: 0,0:10:13.45,0:10:16.25,Default,,0,0,0,,看來你我的緣分就到此為止了 羅倫斯
Dialogue: 0,0:10:16.53,0:10:19.31,Default,,0,0,0,,對旅行商人來說 離別乃是家常便飯
Dialogue: 0,0:10:21.58,0:10:23.31,Default,,0,0,0,,男的殺了也沒關係
Dialogue: 0,0:10:23.83,0:10:25.90,Default,,0,0,0,,女的一定要抓活口
Dialogue: 0,0:10:37.89,0:10:38.62,Default,,0,0,0,,赫蘿
Dialogue: 0,0:10:42.36,0:10:43.30,Default,,0,0,0,,我的短劍
Dialogue: 0,0:10:45.26,0:10:46.15,Default,,0,0,0,,夠了
Dialogue: 0,0:10:47.59,0:10:49.46,Default,,0,0,0,,可能有點疼
Dialogue: 0,0:10:49.77,0:10:51.09,Default,,0,0,0,,汝忍一下
Dialogue: 0,0:11:02.52,0:11:03.85,Default,,0,0,0,,她在吸血
Dialogue: 0,0:11:13.59,0:11:14.47,Default,,0,0,0,,別害怕
Dialogue: 0,0:11:14.84,0:11:17.57,Default,,0,0,0,,她不過是個惡魔附身的臭丫頭罷了…
Dialogue: 0,0:11:23.54,0:11:26.86,Default,,0,0,0,,汝別再看了
Dialogue: 0,0:13:14.04,0:13:16.07,Default,,0,0,0,,神從來都是這樣的
Dialogue: 0,0:13:16.64,0:13:19.74,Default,,0,0,0,,從來 從來都這樣蠻橫無理
Dialogue: 0,0:13:22.44,0:13:23.37,Default,,0,0,0,,赫蘿
Dialogue: 0,0:13:29.19,0:13:30.39,Default,,0,0,0,,住手 赫蘿
Dialogue: 0,0:14:05.59,0:14:06.28,Default,,0,0,0,,等等
Dialogue: 0,0:14:07.53,0:14:08.24,Default,,0,0,0,,赫蘿
Dialogue: 0,0:14:15.73,0:14:18.80,Default,,0,0,0,,妳以為妳撐破的衣服很便宜嗎
Dialogue: 0,0:14:18.80,0:14:21.72,Default,,0,0,0,,我管妳是不是神 這筆錢妳都必須賠我
Dialogue: 0,0:14:21.72,0:14:25.97,Default,,0,0,0,,妳賺來的70枚銀幣根本買不起那套衣服
Dialogue: 0,0:14:25.97,0:14:29.85,Default,,0,0,0,,妳以為我到底賺了多少年的錢才湊出來那麼一套的啊
Dialogue: 0,0:14:32.41,0:14:37.40,Default,,0,0,0,,我一定會找妳追債的 哪怕一路追到北方森林
Dialogue: 0,0:14:45.53,0:14:46.26,Default,,0,0,0,,赫蘿
Dialogue: 0,0:14:50.62,0:14:51.63,Default,,0,0,0,,赫蘿
Dialogue: 0,0:15:09.93,0:15:11.40,Default,,0,0,0,,您醒了
Dialogue: 0,0:15:12.26,0:15:14.28,Default,,0,0,0,,傷口怎麼樣了？
Dialogue: 0,0:15:14.60,0:15:16.73,Default,,0,0,0,,託您的福 沒事了
Dialogue: 0,0:15:16.73,0:15:20.30,Default,,0,0,0,,都怪我們安排不夠妥當 害您遇上了危險
Dialogue: 0,0:15:20.30,0:15:22.07,Default,,0,0,0,,非常抱歉
Dialogue: 0,0:15:22.07,0:15:26.82,Default,,0,0,0,,哪裡 畢竟最初的起因就是我的伙伴
Dialogue: 0,0:15:29.56,0:15:32.33,Default,,0,0,0,,這次我們運氣好 沒有被教會發現
Dialogue: 0,0:15:32.33,0:15:36.36,Default,,0,0,0,,還好整場衝突都是在地下通道內發生的
Dialogue: 0,0:15:36.36,0:15:39.79,Default,,0,0,0,,如果城裡的人見到了她的那副模樣
Dialogue: 0,0:15:39.79,0:15:43.23,Default,,0,0,0,,支行的人和總行的人怕不是都要上火刑架
Dialogue: 0,0:15:43.23,0:15:44.42,Default,,0,0,0,,您見到了她的模樣？
Dialogue: 0,0:15:44.86,0:15:45.80,Default,,0,0,0,,見到了
Dialogue: 0,0:15:46.67,0:15:49.14,Default,,0,0,0,,我的手下向我匯報說
Dialogue: 0,0:15:49.51,0:15:53.45,Default,,0,0,0,,有一匹巨狼護著您 不許他人靠近
Dialogue: 0,0:15:53.91,0:15:59.56,Default,,0,0,0,,等我到場之後 狼突然化身成了您的伙伴
Dialogue: 0,0:16:01.86,0:16:02.95,Default,,0,0,0,,是赫蘿保護了我…
Dialogue: 0,0:16:03.83,0:16:05.69,Default,,0,0,0,,那她現在在哪裡？
Dialogue: 0,0:16:06.54,0:16:09.95,Default,,0,0,0,,把您送來這裡之後
Dialogue: 0,0:16:14.72,0:16:17.40,Default,,0,0,0,,她沒有說自己要去哪裡 直接走掉了
Dialogue: 0,0:16:20.29,0:16:21.11,Default,,0,0,0,,什麼時候的事
Dialogue: 0,0:16:21.11,0:16:23.46,Default,,0,0,0,,恰好一天之前
Dialogue: 0,0:16:24.09,0:16:25.47,Default,,0,0,0,,這樣啊
Dialogue: 0,0:16:31.64,0:16:34.63,Default,,0,0,0,,那麼 交易那邊一切順利嗎
Dialogue: 0,0:16:34.92,0:16:41.23,Default,,0,0,0,,嗯 我們已經從王室手中談來了梅迪歐商行最渴望的特權
Dialogue: 0,0:16:41.23,0:16:45.11,Default,,0,0,0,,您的伙伴不會再因此遭到檢舉了
Dialogue: 0,0:16:45.11,0:16:46.61,Default,,0,0,0,,那就好
Dialogue: 0,0:16:46.61,0:16:52.04,Default,,0,0,0,,我們收集的銀幣一共307,212枚
Dialogue: 0,0:16:52.33,0:16:56.41,Default,,0,0,0,,國王似乎計劃大幅貶值銀幣
Dialogue: 0,0:16:56.41,0:17:01.66,Default,,0,0,0,,他當場支付了相當於35萬枚銀幣的其他貨幣
Dialogue: 0,0:17:01.66,0:17:03.13,Default,,0,0,0,,35萬枚
Dialogue: 0,0:17:03.13,0:17:10.05,Default,,0,0,0,,根據我們之間的合同 您的分成是我們利潤的五分
Dialogue: 0,0:17:10.05,0:17:11.75,Default,,0,0,0,,沒錯吧
Dialogue: 0,0:17:12.12,0:17:12.80,Default,,0,0,0,,嗯
Dialogue: 0,0:17:13.17,0:17:14.54,Default,,0,0,0,,請您檢視詳單
Dialogue: 0,0:17:15.08,0:17:15.75,Default,,0,0,0,,好的
Dialogue: 0,0:17:17.16,0:17:17.93,Default,,0,0,0,,這是…
Dialogue: 0,0:17:17.93,0:17:22.65,Default,,0,0,0,,120枚銀幣 這就是我們利潤的五分
Dialogue: 0,0:17:23.14,0:17:25.73,Default,,0,0,0,,只有這麼一點嗎
Dialogue: 0,0:17:26.00,0:17:30.99,Default,,0,0,0,,貨幣的運輸費 運輸過程中的關稅
Dialogue: 0,0:17:30.99,0:17:35.28,Default,,0,0,0,,再加上合同本身的合同手續費
Dialogue: 0,0:17:36.43,0:17:38.39,Default,,0,0,0,,竟然收取不合法的手續費
Dialogue: 0,0:17:38.64,0:17:41.90,Default,,0,0,0,,我猜應該是御用商人給國王出的鬼點子
Dialogue: 0,0:17:42.27,0:17:44.08,Default,,0,0,0,,既然要交付特權
Dialogue: 0,0:17:44.41,0:17:48.44,Default,,0,0,0,,那麼至少得在收購銀幣的時候挽回一點損失
Dialogue: 0,0:17:49.31,0:17:52.36,Default,,0,0,0,,我們的最終利潤是2400枚銀幣
Dialogue: 0,0:17:52.36,0:17:55.61,Default,,0,0,0,,變成這樣的結果我們也很遺憾
Dialogue: 0,0:17:55.61,0:17:59.05,Default,,0,0,0,,做生意總會遇上各種各樣的意外
Dialogue: 0,0:17:59.75,0:18:05.44,Default,,0,0,0,,但是 也並不是所有的意外都會帶來負面結果
Dialogue: 0,0:18:07.24,0:18:08.21,Default,,0,0,0,,請過目
Dialogue: 0,0:18:11.26,0:18:11.95,Default,,0,0,0,,這是
Dialogue: 0,0:18:12.22,0:18:16.07,Default,,0,0,0,,梅迪歐商行似乎特別想要這份特權
Dialogue: 0,0:18:16.39,0:18:21.16,Default,,0,0,0,,而且 他們還收集了不少未來即將貶值的銀幣
Dialogue: 0,0:18:21.16,0:18:24.12,Default,,0,0,0,,這和負債沒有什麼區別
Dialogue: 0,0:18:24.69,0:18:29.80,Default,,0,0,0,,所以才特別想要做一筆穩賺不虧的生意
Dialogue: 0,0:18:30.15,0:18:33.34,Default,,0,0,0,,對方給出的價格高到我們根本不想提價
Dialogue: 0,0:18:33.88,0:18:35.42,Default,,0,0,0,,竟然分我1000枚
Dialogue: 0,0:18:36.05,0:18:37.02,Default,,0,0,0,,真的可以嗎
Dialogue: 0,0:18:37.02,0:18:38.89,Default,,0,0,0,,嗯 一點小錢罷了
Dialogue: 0,0:18:39.37,0:18:41.83,Default,,0,0,0,,用銀幣支付可以嗎
Dialogue: 0,0:18:41.83,0:18:45.73,Default,,0,0,0,,如果想換成什麼商品的話 我可以給您安排
Dialogue: 0,0:18:48.68,0:18:49.69,Default,,0,0,0,,胡椒
Dialogue: 0,0:18:50.28,0:18:51.89,Default,,0,0,0,,有胡椒嗎
Dialogue: 0,0:18:51.89,0:18:53.65,Default,,0,0,0,,重量輕 也不佔地方
Dialogue: 0,0:18:54.05,0:18:55.02,Default,,0,0,0,,胡椒？
Dialogue: 0,0:18:55.45,0:18:57.05,Default,,0,0,0,,馬上就要入冬了
Dialogue: 0,0:18:57.05,0:18:59.48,Default,,0,0,0,,肉類消費會增加 胡椒價格也會上漲
Dialogue: 0,0:19:01.36,0:19:02.41,Default,,0,0,0,,怎麼了
Dialogue: 0,0:19:02.41,0:19:07.37,Default,,0,0,0,,不好意思 我突然想起了最近讀過的戲曲劇本
Dialogue: 0,0:19:07.60,0:19:08.54,Default,,0,0,0,,戲曲？
Dialogue: 0,0:19:09.35,0:19:10.17,Default,,0,0,0,,嗯
Dialogue: 0,0:19:11.05,0:19:16.39,Default,,0,0,0,,那是一齣宗教戲 內容是教會向商行說教做生意應當講究節制
Dialogue: 0,0:19:16.66,0:19:20.89,Default,,0,0,0,,戲裡有個惡魔出現在了富裕的商人面前 對他說
Dialogue: 0,0:19:21.35,0:19:23.85,Default,,0,0,0,,「把這裡最好吃的人帶過來
Dialogue: 0,0:19:24.08,0:19:26.40,Default,,0,0,0,,不然我就要吃掉你」
Dialogue: 0,0:19:26.82,0:19:28.82,Default,,0,0,0,,商人貪生怕死
Dialogue: 0,0:19:28.82,0:19:32.71,Default,,0,0,0,,於是交出了青枝綠葉的女傭和大腹便便的男僕
Dialogue: 0,0:19:32.71,0:19:35.45,Default,,0,0,0,,然而惡魔卻搖了搖頭
Dialogue: 0,0:19:35.81,0:19:38.32,Default,,0,0,0,,商人滿城尋找好吃的人
Dialogue: 0,0:19:38.32,0:19:42.63,Default,,0,0,0,,最終他找到了一個滿身蜂蜜與牛奶香的男孩
Dialogue: 0,0:19:43.00,0:19:46.07,Default,,0,0,0,,他立刻將男孩送到了惡魔面前
Dialogue: 0,0:19:46.07,0:19:48.04,Default,,0,0,0,,然而男孩卻對惡魔這樣說
Dialogue: 0,0:19:48.66,0:19:51.17,Default,,0,0,0,,「最好吃的人就在你的眼前」
Dialogue: 0,0:19:51.72,0:19:55.96,Default,,0,0,0,,「這個人天天都扛著香辛料賺錢
Dialogue: 0,0:19:56.41,0:20:00.69,Default,,0,0,0,,他那肥滿的靈魂早就被醃入味了」
Dialogue: 0,0:20:02.57,0:20:04.39,Default,,0,0,0,,抱歉 入戲了
Dialogue: 0,0:20:05.50,0:20:10.19,Default,,0,0,0,,因為我忍不住想像了一下您未來靠胡椒賺錢的模樣
Dialogue: 0,0:20:11.18,0:20:14.17,Default,,0,0,0,,好想趕緊用香辛料把我這身體醃入味啊
Dialogue: 0,0:20:14.17,0:20:15.92,Default,,0,0,0,,我很期待
Dialogue: 0,0:20:15.92,0:20:22.37,Default,,0,0,0,,我行也很願意與您這樣的商人構築長遠的合作關係
Dialogue: 0,0:20:24.55,0:20:25.77,Default,,0,0,0,,謝謝您
Dialogue: 0,0:20:26.28,0:20:28.63,Default,,0,0,0,,我這就為您安排胡椒
Dialogue: 0,0:20:28.96,0:20:31.13,Default,,0,0,0,,接下來我還有工作 就先告辭了
Dialogue: 0,0:20:35.82,0:20:39.68,Default,,0,0,0,,羅倫斯先生 這裡有一份給您的賬單
Dialogue: 0,0:20:43.19,0:20:44.85,Default,,0,0,0,,140枚銀幣？
Dialogue: 0,0:20:45.79,0:20:47.73,Default,,0,0,0,,我不記得自己做了這樣的交易
Dialogue: 0,0:20:56.46,0:20:57.77,Default,,0,0,0,,卸貨場在哪裡
Dialogue: 0,0:20:58.12,0:21:01.64,Default,,600,0,0,,走廊盡頭左轉…
Dialogue: 0,0:21:00.42,0:21:01.17,Default,,0,500,0,,謝謝
Dialogue: 0,0:21:05.21,0:21:06.45,Default,,0,0,0,,女用斗篷
Dialogue: 0,0:21:07.51,0:21:08.54,Default,,0,0,0,,絲綢腰巾
Dialogue: 0,0:21:09.36,0:21:10.65,Default,,0,0,0,,旅行用鞋
Dialogue: 0,0:21:11.35,0:21:12.53,Default,,0,0,0,,玳瑁甲做的梳子
Dialogue: 0,0:21:18.52,0:21:19.69,Default,,0,0,0,,抱歉 過一下
Dialogue: 0,0:21:21.58,0:21:22.59,Default,,0,0,0,,以及
Dialogue: 0,0:21:22.59,0:21:23.85,Default,,500,0,0,,大量的蘋果
Dialogue: 0,0:21:23.03,0:21:25.96,Default,,0,600,0,,一共40枚銀幣…
Dialogue: 0,0:21:25.96,0:21:26.65,Default,,0,0,0,,赫蘿
Dialogue: 0,0:21:37.05,0:21:40.57,Default,,0,0,0,,咱可不想被人追債追到北方森林
Dialogue: 0,0:21:56.63,0:21:59.34,Default,,0,0,0,,還完債之後 咱再回家
Dialogue: 0,0:22:00.69,0:22:01.84,Default,,0,0,0,,應該的
Dialogue: 0,0:22:08.23,0:22:11.08,Default,,0,0,0,,狼與香辛料啊

Comment: 0,0:00:00.00,0:00:00.00,text-jp,,0,0,0,,//------------------TEXTJP-------------------
Dialogue: 0,0:01:45.86,0:01:47.94,text-jp,,0,0,0,,俺は お前を尊敬してるんだ
Dialogue: 0,0:01:48.27,0:01:50.74,text-jp,,0,0,0,,全てにおいて 報われてほしいと思う！
Dialogue: 0,0:01:51.44,0:01:54.20,text-jp,,0,0,0,,妹にとっては 将来と同じくらい
Dialogue: 0,0:01:54.91,0:01:56.70,text-jp,,0,0,0,,この試合が大切なんです！
Dialogue: 0,0:01:57.45,0:01:58.41,text-jp,,0,0,0,,お願いします！
Dialogue: 0,0:01:59.16,0:02:00.08,text-jp,,0,0,0,,言ったろ
Dialogue: 0,0:02:00.91,0:02:02.33,text-jp,,0,0,0,,もうウソはつくなって
Dialogue: 0,0:02:04.17,0:02:05.42,text-jp,,0,0,0,,悲しい時は
Dialogue: 0,0:02:06.33,0:02:06.96,text-jp,,0,0,0,,泣け
Dialogue: 0,0:02:11.01,0:02:13.63,text-jp,,0,0,0,,うまくなりたいよ！
Dialogue: 0,0:02:14.38,0:02:16.76,text-jp,,0,0,0,,強くなりたいよ！
Dialogue: 0,0:02:33.28,0:02:34.61,text-jp,,0,0,0,,ん～…
Dialogue: 0,0:02:34.99,0:02:37.37,text-jp,,0,0,0,,いや 絶対 あれは 入ってたわ
Dialogue: 0,0:02:37.70,0:02:40.66,text-jp,,0,0,0,,何日も前のことを よく怒れますね
Dialogue: 0,0:02:40.66,0:02:42.75,text-jp,,0,0,0,,だって 私 見たんだもん
Dialogue: 0,0:02:42.75,0:02:44.37,text-jp,,0,0,0,,絶対 入ってた
Dialogue: 0,0:02:44.37,0:02:48.84,text-jp,,0,0,0,,白線のギリギリ内側を 南の打ったスマッシュがビシッて！
Dialogue: 0,0:02:49.42,0:02:51.38,text-jp,,0,0,0,,うやむやには できないわよ！
Dialogue: 0,0:02:51.38,0:02:53.67,text-jp,,0,0,0,,あの誤審から 流れがおかしくなった
Dialogue: 0,0:02:54.09,0:02:56.13,text-jp,,0,0,0,,つまり 南は勝ってたのよ！
Dialogue: 0,0:02:56.43,0:02:58.09,text-jp,,0,0,0,,確かに 押してたし
Dialogue: 0,0:02:58.09,0:02:59.68,text-jp,,0,0,0,,負けちゃうとはね～
Dialogue: 0,0:02:59.68,0:03:00.60,text-jp,,0,0,0,,あの南が
Dialogue: 0,0:03:00.85,0:03:03.02,text-jp,,0,0,0,,ねえ 新もこっち派でしょ！
Dialogue: 0,0:03:03.60,0:03:05.44,text-jp,,0,0,0,,結果は 問題じゃないだろ
Dialogue: 0,0:03:05.77,0:03:07.73,text-jp,,0,0,0,,俺たちにとって大事なのは
Dialogue: 0,0:03:07.73,0:03:09.86,text-jp,,0,0,0,,南に後悔が残らなかったか
Dialogue: 0,0:03:10.06,0:03:11.02,text-jp,,0,0,0,,それだけだ
Dialogue: 0,0:03:11.32,0:03:12.65,text-jp,,0,0,0,,さすが 新
Dialogue: 0,0:03:12.65,0:03:13.82,text-jp,,0,0,0,,いいこと言う！
Dialogue: 0,0:03:13.82,0:03:15.78,text-jp,,0,0,0,,発言が おやじくさいのよ
Dialogue: 0,0:03:15.78,0:03:16.82,text-jp,,0,0,0,,達観ぶって
Dialogue: 0,0:03:16.82,0:03:17.49,text-jp,,0,0,0,,ああっ？
Dialogue: 0,0:03:17.82,0:03:19.95,text-jp,,0,0,0,,おやじくさいって どういう意味だよ！
Dialogue: 0,0:03:19.95,0:03:22.49,text-jp,,0,0,0,,そのままの意味だけど
Dialogue: 0,0:03:23.79,0:03:25.12,text-jp,,0,0,0,,あっ 南！
Dialogue: 0,0:03:25.12,0:03:26.50,text-jp,,0,0,0,,あなたも思うでしょ？
Dialogue: 0,0:03:26.50,0:03:28.54,text-jp,,0,0,0,,あのスマッシュは 入ってたって！
Dialogue: 0,0:03:29.33,0:03:31.54,text-jp,,0,0,0,,まあ どっちでもいいかなー
Dialogue: 0,0:03:32.80,0:03:35.59,text-jp,,0,0,0,,何でよ あなたの試合でしょ！
Dialogue: 0,0:03:35.59,0:03:38.43,text-jp,,0,0,0,,インターハイじゃ ヒューマンエラーは付きものだし
Dialogue: 0,0:03:38.93,0:03:41.30,text-jp,,0,0,0,,その後 崩れちゃった 私の甘さだよ
Dialogue: 0,0:03:42.10,0:03:44.10,text-jp,,0,0,0,,ケガの悪化も見られなかったし
Dialogue: 0,0:03:44.52,0:03:48.31,text-jp,,0,0,0,,そもそも 大事な時に ケガなんかした私が悪いのは確か
Dialogue: 0,0:03:48.81,0:03:51.36,text-jp,,0,0,0,,私的には かなり満足してるんだ
Dialogue: 0,0:03:51.86,0:03:53.27,text-jp,,0,0,0,,ホント みんなのおかげ
Dialogue: 0,0:03:53.27,0:03:54.15,text-jp,,0,0,0,,ありがとう！
Dialogue: 0,0:03:54.44,0:03:56.53,text-jp,,0,0,0,,これで怒ってたらチンピラですね
Dialogue: 0,0:03:56.78,0:03:59.03,text-jp,,0,0,0,,ただのクレーマーになっちゃうわね
Dialogue: 0,0:04:00.32,0:04:01.49,text-jp,,0,0,0,,何よ！
Dialogue: 0,0:04:01.49,0:04:05.12,text-jp,,0,0,0,,妹に勝ってほしいと思うのは そんなにいけないわけ？
Dialogue: 0,0:04:05.12,0:04:07.21,text-jp,,0,0,0,,そんなこと ひと言も言ってません
Dialogue: 0,0:04:08.67,0:04:10.33,text-jp,,0,0,0,,ちゃんと あったまったか？
Dialogue: 0,0:04:11.08,0:04:12.42,text-jp,,0,0,0,,体は 冷やすなよ
Dialogue: 0,0:04:13.13,0:04:14.38,text-jp,,0,0,0,,治りが遅くなるぞ
Dialogue: 0,0:04:14.92,0:04:16.46,text-jp,,0,0,0,,う… うん
Dialogue: 0,0:04:18.13,0:04:18.84,text-jp,,0,0,0,,うん…
Dialogue: 0,0:04:20.05,0:04:21.97,text-jp,,0,0,0,,う～ん… ダメ 納得いかない！
Dialogue: 0,0:04:22.51,0:04:24.72,text-jp,,0,0,0,,今 ここで 再現します！
Dialogue: 0,0:04:24.72,0:04:26.22,text-jp,,0,0,0,,成り下がりましたね
Dialogue: 0,0:04:26.22,0:04:28.18,text-jp,,0,0,0,,モンスターペアレントね
Dialogue: 0,0:04:28.81,0:04:30.90,text-jp,,0,0,0,,ここを白線としたら
Dialogue: 0,0:04:31.23,0:04:32.15,text-jp,,0,0,0,,こう！ ここ！
Dialogue: 0,0:04:32.15,0:04:33.48,text-jp,,0,0,0,,ほら
Dialogue: 0,0:04:33.48,0:04:35.23,text-jp,,0,0,0,,１ミリ 残ってるでしょ！
Dialogue: 0,0:04:36.15,0:04:37.03,text-jp,,0,0,0,,というか 力が強すぎでは？
Dialogue: 0,0:04:37.03,0:04:38.19,text-jp,,0,0,0,,というか 力が強すぎでは？
Dialogue: 0,0:04:38.19,0:04:39.90,text-jp,,0,0,0,,すごいショットね
Dialogue: 0,0:04:41.32,0:04:44.24,text-jp,,0,0,0,,ああーっ もう 納得いかない！
Dialogue: 0,0:04:44.24,0:04:45.74,text-jp,,0,0,0,,まあまあ…
Dialogue: 0,0:04:45.74,0:04:47.62,text-jp,,0,0,0,,ってか 志苑は どこなのよ！
Dialogue: 0,0:04:47.62,0:04:48.41,text-jp,,0,0,0,,裕ちゃんとデートだそうです
Dialogue: 0,0:04:48.41,0:04:49.54,text-jp,,0,0,0,,裕ちゃんとデートだそうです
Dialogue: 0,0:04:49.54,0:04:52.33,text-jp,,0,0,0,,あのクソリア充～！
Dialogue: 0,0:04:52.58,0:04:55.88,text-jp,,0,0,0,,というか 今日の謳華は どうしちゃったんでしょう
Dialogue: 0,0:04:55.88,0:04:57.21,text-jp,,0,0,0,,ご乱心ですね
Dialogue: 0,0:04:57.59,0:04:59.72,text-jp,,0,0,0,,謳華にも そんな日はあるわよ
Dialogue: 0,0:05:00.26,0:05:02.34,text-jp,,0,0,0,,うぐっ そういうことじゃ…
Dialogue: 0,0:05:04.30,0:05:05.51,text-jp,,0,0,0,,あっ 南！
Dialogue: 0,0:05:06.06,0:05:06.76,text-jp,,0,0,0,,危な…
Dialogue: 0,0:05:08.47,0:05:09.31,text-jp,,0,0,0,,えっ？
Dialogue: 0,0:05:13.40,0:05:14.73,text-jp,,0,0,0,,ナイスキャッチ
Dialogue: 0,0:05:14.73,0:05:15.90,text-jp,,0,0,0,,さすが 新
Dialogue: 0,0:05:15.90,0:05:17.61,text-jp,,0,0,0,,わっ ごめん 南
Dialogue: 0,0:05:17.61,0:05:18.99,text-jp,,0,0,0,,気をつけろよ
Dialogue: 0,0:05:19.40,0:05:21.82,text-jp,,0,0,0,,インターハイ 無理させたのは 俺たちなんだから
Dialogue: 0,0:05:22.24,0:05:24.74,text-jp,,0,0,0,,フン！ 新に当たればよかったのに
Dialogue: 0,0:05:24.74,0:05:26.70,text-jp,,0,0,0,,はっ？ 何でだよ！
Dialogue: 0,0:05:27.74,0:05:29.16,text-jp,,0,0,0,,平気か？ 南
Dialogue: 0,0:05:30.37,0:05:31.16,text-jp,,0,0,0,,うん…
Dialogue: 0,0:05:39.30,0:05:40.17,text-jp,,0,0,0,,好き
Dialogue: 0,0:05:40.47,0:05:43.63,text-jp,,0,0,0,,私は お兄ちゃんのこと 男の人として好きなの！
Dialogue: 0,0:05:51.52,0:05:54.65,text-jp,,0,0,0,,そんなことも あるのかな…
Dialogue: 0,0:05:55.81,0:05:58.86,text-jp,,0,0,0,,悔しかったら 反論してみなさいよ！
Dialogue: 0,0:05:58.86,0:06:00.11,text-jp,,0,0,0,,このこの！
Dialogue: 0,0:06:09.12,0:06:12.16,text-jp,,0,0,0,,私 新お兄ちゃんと 結婚したい！
Dialogue: 0,0:06:12.75,0:06:15.08,text-jp,,0,0,0,,逆に何かあんのか？ 変なこと
Dialogue: 0,0:06:18.50,0:06:19.05,text-jp,,0,0,0,,はい
Dialogue: 0,0:06:21.21,0:06:22.09,text-jp,,0,0,0,,えっ？
Dialogue: 0,0:06:28.10,0:06:30.18,text-jp,,0,0,0,,ちょっと 話があるんだけど
Dialogue: 0,0:06:38.15,0:06:39.77,text-jp,,0,0,0,,よし 完成
Dialogue: 0,0:06:40.07,0:06:41.57,text-jp,,0,0,0,,さあ 次 次
Dialogue: 0,0:06:45.78,0:06:47.62,text-jp,,0,0,0,,ねえ ベルゼクル
Dialogue: 0,0:06:49.66,0:06:52.29,text-jp,,0,0,0,,そういうことがあっても いいのかな？
Dialogue: 0,0:06:52.79,0:06:54.33,text-jp,,0,0,0,,何が あってもいいんだ？
Dialogue: 0,0:06:55.04,0:06:56.50,text-jp,,0,0,0,,なっ… 何でもない
Dialogue: 0,0:06:56.50,0:06:57.54,text-jp,,0,0,0,,おやすみ！
Dialogue: 0,0:06:58.50,0:06:59.75,text-jp,,0,0,0,,おやすみって…
Dialogue: 0,0:07:00.17,0:07:01.46,text-jp,,0,0,0,,まだ９時だぞ？
Dialogue: 0,0:07:02.88,0:07:05.47,text-jp,,0,0,0,,相変わらず かわいい部屋ね
Dialogue: 0,0:07:06.26,0:07:08.59,text-jp,,0,0,0,,いろんなものが ちゃんと配置されてる
Dialogue: 0,0:07:08.93,0:07:11.72,text-jp,,0,0,0,,ことのは 昔から 家具のセンスもいいし
Dialogue: 0,0:07:12.43,0:07:14.73,text-jp,,0,0,0,,おっ アイドル雑誌
Dialogue: 0,0:07:14.98,0:07:17.19,text-jp,,0,0,0,,韓流から 宝塚まで
Dialogue: 0,0:07:17.19,0:07:19.44,text-jp,,0,0,0,,ことの 昔から好きだったもんね
Dialogue: 0,0:07:19.44,0:07:20.65,text-jp,,0,0,0,,うっ… うん
Dialogue: 0,0:07:20.98,0:07:24.53,text-jp,,0,0,0,,あっ このボーカルユニット 最近 来てるよね
Dialogue: 0,0:07:25.28,0:07:26.45,text-jp,,0,0,0,,あ… あの…
Dialogue: 0,0:07:27.49,0:07:28.74,text-jp,,0,0,0,,話って…
Dialogue: 0,0:07:30.83,0:07:32.29,text-jp,,0,0,0,,例の話？
Dialogue: 0,0:07:32.29,0:07:34.50,text-jp,,0,0,0,,ほら この間 言ってた
Dialogue: 0,0:07:34.50,0:07:36.50,text-jp,,0,0,0,,“新のことが…”ってやつ
Dialogue: 0,0:07:38.08,0:07:40.38,text-jp,,0,0,0,,何か 追い込まれてるみたいだったし
Dialogue: 0,0:07:40.92,0:07:43.59,text-jp,,0,0,0,,どうして 突然 あんなこと言ったのかなって
Dialogue: 0,0:07:45.38,0:07:48.51,text-jp,,0,0,0,,別に ただの気まぐれだなんて 言う気はないけど
Dialogue: 0,0:07:48.93,0:07:50.39,text-jp,,0,0,0,,もし 本気なら
Dialogue: 0,0:07:50.80,0:07:53.26,text-jp,,0,0,0,,どこまでかは 聞いておかなきゃって思って
Dialogue: 0,0:07:54.14,0:07:56.23,text-jp,,0,0,0,,私は 一応 真ん中だけど
Dialogue: 0,0:07:56.56,0:07:58.81,text-jp,,0,0,0,,あなたのお姉ちゃんでも あるわけだし
Dialogue: 0,0:07:59.31,0:08:01.31,text-jp,,0,0,0,,中間管理職的な？
Dialogue: 0,0:08:02.32,0:08:04.82,text-jp,,0,0,0,,何か 困ったことがあるなら 相談に…
Dialogue: 0,0:08:04.82,0:08:05.99,text-jp,,0,0,0,,知ってるの
Dialogue: 0,0:08:05.99,0:08:06.69,text-jp,,0,0,0,,え？
Dialogue: 0,0:08:07.49,0:08:08.86,text-jp,,0,0,0,,私 知ってるの
Dialogue: 0,0:08:09.41,0:08:11.49,text-jp,,0,0,0,,謳華ちゃんが 新お兄ちゃんに…
Dialogue: 0,0:08:12.07,0:08:13.66,text-jp,,0,0,0,,好きって言ったこと
Dialogue: 0,0:08:13.91,0:08:14.87,text-jp,,0,0,0,,ええっ！
Dialogue: 0,0:08:15.41,0:08:17.12,text-jp,,0,0,0,,私 見ちゃったの
Dialogue: 0,0:08:17.12,0:08:19.96,text-jp,,0,0,0,,万里ちゃんと南ちゃんが トークルームで話してるの
Dialogue: 0,0:08:20.37,0:08:23.71,text-jp,,0,0,0,,ウィズミーで謳華ちゃんが 新お兄ちゃんに好きって伝えてるの
Dialogue: 0,0:08:23.71,0:08:25.17,text-jp,,0,0,0,,南ちゃん 見たって！
Dialogue: 0,0:08:25.30,0:08:25.92,text-jp,,0,0,0,,なっ…
Dialogue: 0,0:08:26.55,0:08:30.38,text-jp,,0,0,0,,それに 私 この前の ゲームルームでのことも見ちゃった
Dialogue: 0,0:08:30.76,0:08:33.60,text-jp,,0,0,0,,２人 まるで恋人みたいに 手をつないで…
Dialogue: 0,0:08:36.68,0:08:38.14,text-jp,,0,0,0,,なっ 何で？
Dialogue: 0,0:08:38.14,0:08:39.64,text-jp,,0,0,0,,あの時 誰も…
Dialogue: 0,0:08:39.64,0:08:41.48,text-jp,,0,0,0,,そっ それは あの…
Dialogue: 0,0:08:41.48,0:08:44.52,text-jp,,0,0,0,,えっと その日は 考え事をしに…
Dialogue: 0,0:08:44.94,0:08:46.57,text-jp,,0,0,0,,クローゼットに えっと…
Dialogue: 0,0:08:47.28,0:08:48.78,text-jp,,0,0,0,,あっ… クローゼットの妖精？
Dialogue: 0,0:08:49.61,0:08:51.99,text-jp,,0,0,0,,だから その… 私…
Dialogue: 0,0:08:52.95,0:08:54.20,text-jp,,0,0,0,,なるほど
Dialogue: 0,0:08:54.20,0:08:56.62,text-jp,,0,0,0,,それで追い込まれて あんなこと…
Dialogue: 0,0:08:56.99,0:08:58.66,text-jp,,0,0,0,,ちょっ ちょっと待って
Dialogue: 0,0:08:58.66,0:09:00.00,text-jp,,0,0,0,,それは勘違いよ
Dialogue: 0,0:09:00.37,0:09:03.46,text-jp,,0,0,0,,ウィズミーでのあれは あくまで 双子としてって話で…
Dialogue: 0,0:09:05.09,0:09:07.13,text-jp,,0,0,0,,新も そのつもりでいると思うけど
Dialogue: 0,0:09:08.01,0:09:09.59,text-jp,,0,0,0,,かっ 勘違い？
Dialogue: 0,0:09:10.05,0:09:12.93,text-jp,,0,0,0,,ゲームルームでのことだって ただの事故
Dialogue: 0,0:09:12.93,0:09:14.72,text-jp,,0,0,0,,見てたのなら 分かるでしょ？
Dialogue: 0,0:09:15.43,0:09:19.18,text-jp,,0,0,0,,その時 私 告白まがいの話を した覚えはないけど？
Dialogue: 0,0:09:19.73,0:09:21.52,text-jp,,0,0,0,,ほっ… 本当に？
Dialogue: 0,0:09:21.52,0:09:23.23,text-jp,,0,0,0,,本当に 全部 勘違い？
Dialogue: 0,0:09:23.23,0:09:25.23,text-jp,,0,0,0,,２人は あくまで 兄弟姉妹で
Dialogue: 0,0:09:25.23,0:09:28.57,text-jp,,0,0,0,,謳華ちゃんは 新お兄ちゃんのことを 好きじゃないってこと？
Dialogue: 0,0:09:28.57,0:09:29.15,text-jp,,0,0,0,,ちょ… ちょっと…
Dialogue: 0,0:09:35.66,0:09:36.58,text-jp,,0,0,0,,そうよ！
Dialogue: 0,0:09:39.91,0:09:41.12,text-jp,,0,0,0,,よかった…
Dialogue: 0,0:09:41.96,0:09:43.42,text-jp,,0,0,0,,勘違いして ごめんね
Dialogue: 0,0:09:43.42,0:09:44.58,text-jp,,0,0,0,,謳華ちゃん！
Dialogue: 0,0:09:46.67,0:09:47.71,text-jp,,0,0,0,,別に…
Dialogue: 0,0:10:07.15,0:10:08.77,text-jp,,0,0,0,,お風呂 入ろ
Dialogue: 0,0:10:14.57,0:10:16.12,text-jp,,0,0,0,,お願い このとおり！
Dialogue: 0,0:10:16.53,0:10:18.03,text-jp,,0,0,0,,と言われましても
Dialogue: 0,0:10:18.03,0:10:21.04,text-jp,,0,0,0,,私は これから 勉強の予定がありますので
Dialogue: 0,0:10:21.37,0:10:23.62,text-jp,,0,0,0,,私も 模試 近いし
Dialogue: 0,0:10:23.62,0:10:24.54,text-jp,,0,0,0,,ごめん
Dialogue: 0,0:10:26.63,0:10:29.17,text-jp,,0,0,0,,志苑も 南も まだ帰ってきてないし
Dialogue: 0,0:10:29.59,0:10:32.26,text-jp,,0,0,0,,ことのは 図書館に 寄ってくるって言ってたし…
Dialogue: 0,0:10:32.80,0:10:33.92,text-jp,,0,0,0,,ただいま
Dialogue: 0,0:10:34.88,0:10:36.55,text-jp,,0,0,0,,ハァ… 暑い
Dialogue: 0,0:10:37.22,0:10:38.76,text-jp,,0,0,0,,さっさとシャワーでも…
Dialogue: 0,0:10:39.60,0:10:41.52,text-jp,,0,0,0,,新 いいところに！
Dialogue: 0,0:10:44.06,0:10:45.60,text-jp,,0,0,0,,えっ… 何？
Dialogue: 0,0:10:48.31,0:10:51.03,text-jp,,0,0,0,,ここが 万里の通う看護大学か
Dialogue: 0,0:10:51.40,0:10:52.44,text-jp,,0,0,0,,初めて来た
Dialogue: 0,0:10:56.99,0:10:58.20,text-jp,,0,0,0,,というか
Dialogue: 0,0:10:58.20,0:11:02.12,text-jp,,0,0,0,,コソコソ 警備員の目を盗んで 潜り込むとは 思わなかった
Dialogue: 0,0:11:02.83,0:11:04.79,text-jp,,0,0,0,,しかたないでしょ
Dialogue: 0,0:11:04.79,0:11:08.75,text-jp,,0,0,0,,この時間だと 部外者を 中に入れる手続きなんて 取れないし
Dialogue: 0,0:11:09.00,0:11:10.67,text-jp,,0,0,0,,１人で来れば よかったじゃん
Dialogue: 0,0:11:11.05,0:11:12.71,text-jp,,0,0,0,,それができたらしてる！
Dialogue: 0,0:11:13.30,0:11:15.47,text-jp,,0,0,0,,大学の友達に頼むとか
Dialogue: 0,0:11:15.47,0:11:17.39,text-jp,,0,0,0,,みんな 予定あるって！
Dialogue: 0,0:11:17.39,0:11:20.39,text-jp,,0,0,0,,もう！ そんなに お姉ちゃんのことが嫌いなの？
Dialogue: 0,0:11:20.39,0:11:22.81,text-jp,,0,0,0,,分かった 悪かったって
Dialogue: 0,0:11:27.19,0:11:28.44,text-jp,,0,0,0,,忘れ物ねえ…
Dialogue: 0,0:11:28.69,0:11:30.52,text-jp,,0,0,0,,そうなの つい うっかり
Dialogue: 0,0:11:31.15,0:11:33.11,text-jp,,0,0,0,,まあ 万里の気持ちも分かるよ
Dialogue: 0,0:11:33.48,0:11:35.24,text-jp,,0,0,0,,夜の校舎って不気味だよな
Dialogue: 0,0:11:36.24,0:11:37.78,text-jp,,0,0,0,,何か出そうっつーか
Dialogue: 0,0:11:38.16,0:11:40.45,text-jp,,0,0,0,,特に医療関係だとなおさら
Dialogue: 0,0:11:40.45,0:11:42.12,text-jp,,0,0,0,,ちょっ やめてよ！
Dialogue: 0,0:11:42.12,0:11:44.79,text-jp,,0,0,0,,私がお化け苦手って知ってから
Dialogue: 0,0:11:44.79,0:11:48.00,text-jp,,0,0,0,,みんな “実習室で何々を見た”とか
Dialogue: 0,0:11:48.00,0:11:50.96,text-jp,,0,0,0,,“どこどこの病院では こんなウワサが…”とか
Dialogue: 0,0:11:50.96,0:11:53.05,text-jp,,0,0,0,,学校の七不思議とか
Dialogue: 0,0:11:53.05,0:11:55.13,text-jp,,0,0,0,,もうホントやめてほしい
Dialogue: 0,0:11:55.13,0:11:57.55,text-jp,,0,0,0,,実習とか行けなくなっちゃう…
Dialogue: 0,0:11:57.55,0:12:00.97,text-jp,,0,0,0,,そういう話には事欠かないな 病院って
Dialogue: 0,0:12:02.35,0:12:04.06,text-jp,,0,0,0,,けど そんなに苦手なら
Dialogue: 0,0:12:04.06,0:12:04.39,text-jp,,0,0,0,,けど そんなに苦手なら
Dialogue: 0,0:12:04.39,0:12:06.77,text-jp,,0,0,0,,何で看護大学 選んだんだ？
Dialogue: 0,0:12:06.77,0:12:07.06,text-jp,,0,0,0,,そっち系の話が付きものだって 分かってただろ
Dialogue: 0,0:12:07.06,0:12:09.73,text-jp,,0,0,0,,そっち系の話が付きものだって 分かってただろ
Dialogue: 0,0:12:10.35,0:12:12.65,text-jp,,0,0,0,,それは そうなんだけど…
Dialogue: 0,0:12:14.15,0:12:15.15,text-jp,,0,0,0,,ん？ 言いにくいのか？
Dialogue: 0,0:12:16.32,0:12:17.11,text-jp,,0,0,0,,まあ いいや
Dialogue: 0,0:12:17.61,0:12:19.57,text-jp,,0,0,0,,それで 忘れ物って何なんだ？
Dialogue: 0,0:12:19.95,0:12:21.78,text-jp,,0,0,0,,さっさと拾って帰ろうぜ
Dialogue: 0,0:12:21.78,0:12:23.87,text-jp,,0,0,0,,あっ ちょっ… ちょっと待ってよ
Dialogue: 0,0:12:23.87,0:12:25.58,text-jp,,0,0,0,,置いてかないで！
Dialogue: 0,0:12:32.33,0:12:34.55,text-jp,,0,0,0,,ダメ 気分が乗らない！
Dialogue: 0,0:12:35.21,0:12:37.26,text-jp,,0,0,0,,こういう時は 休憩 休憩
Dialogue: 0,0:12:37.72,0:12:39.51,text-jp,,0,0,0,,気分転換
Dialogue: 0,0:12:40.51,0:12:43.39,text-jp,,0,0,0,,何か面白い動画 ないかな
Dialogue: 0,0:12:58.24,0:13:00.03,text-jp,,0,0,0,,か… 風だよ 風
Dialogue: 0,0:13:00.03,0:13:01.78,text-jp,,0,0,0,,風で窓が鳴っただけ
Dialogue: 0,0:13:01.78,0:13:03.87,text-jp,,0,0,0,,わ… 分かってるけど…
Dialogue: 0,0:13:05.03,0:13:06.08,text-jp,,0,0,0,,っていうか…
Dialogue: 0,0:13:06.66,0:13:08.70,text-jp,,0,0,0,,この感触は ヤバい！
Dialogue: 0,0:13:09.62,0:13:12.79,text-jp,,0,0,0,,ちょ… ちょっと歩きづらいから 離れてくれないか
Dialogue: 0,0:13:13.13,0:13:14.42,text-jp,,0,0,0,,やだやだ！
Dialogue: 0,0:13:14.42,0:13:16.46,text-jp,,0,0,0,,何でそんな意地悪 言うの？
Dialogue: 0,0:13:18.26,0:13:20.80,text-jp,,0,0,0,,ぐっ… ダメだ これ以上は 逆効果
Dialogue: 0,0:13:21.18,0:13:23.51,text-jp,,0,0,0,,わ… 分かったから 行くぞ！
Dialogue: 0,0:13:23.51,0:13:24.93,text-jp,,0,0,0,,や～だ～！
Dialogue: 0,0:13:31.02,0:13:32.52,text-jp,,0,0,0,,ねえ 新
Dialogue: 0,0:13:32.52,0:13:33.31,text-jp,,0,0,0,,ん？
Dialogue: 0,0:13:33.31,0:13:35.56,text-jp,,0,0,0,,何か話してよ 怖いから
Dialogue: 0,0:13:35.90,0:13:37.32,text-jp,,0,0,0,,話って どんな？
Dialogue: 0,0:13:37.32,0:13:39.03,text-jp,,0,0,0,,何でもいいから
Dialogue: 0,0:13:39.03,0:13:40.57,text-jp,,0,0,0,,と言われてもな…
Dialogue: 0,0:13:41.11,0:13:42.61,text-jp,,0,0,0,,じゃあ 歌 歌って 歌
Dialogue: 0,0:13:42.61,0:13:44.41,text-jp,,0,0,0,,明るい曲
Dialogue: 0,0:13:44.66,0:13:47.16,text-jp,,0,0,0,,あのなあ 何のために こうやって…
Dialogue: 0,0:13:47.49,0:13:48.49,text-jp,,0,0,0,,だって…
Dialogue: 0,0:13:49.41,0:13:50.79,text-jp,,0,0,0,,もう決めた
Dialogue: 0,0:13:50.79,0:13:53.37,text-jp,,0,0,0,,私 もう二度と学校に 忘れ物しな… んむっ
Dialogue: 0,0:14:01.47,0:14:02.72,text-jp,,0,0,0,,シッ！
Dialogue: 0,0:14:03.09,0:14:03.97,text-jp,,0,0,0,,静かに
Dialogue: 0,0:14:04.55,0:14:05.55,text-jp,,0,0,0,,誰か来る
Dialogue: 0,0:14:34.71,0:14:35.75,text-jp,,0,0,0,,フゥ… ビビった
Dialogue: 0,0:14:36.17,0:14:37.46,text-jp,,0,0,0,,あれ？ でも待てよ
Dialogue: 0,0:14:37.79,0:14:39.38,text-jp,,0,0,0,,万里は 在校生だし
Dialogue: 0,0:14:39.38,0:14:42.80,text-jp,,0,0,0,,忘れ物を取りに来たって言えば 別に怒られることでも…
Dialogue: 0,0:14:43.30,0:14:45.18,text-jp,,0,0,0,,だったら 何で隠れたんだ？
Dialogue: 0,0:14:45.55,0:14:46.39,text-jp,,0,0,0,,ねえ…
Dialogue: 0,0:14:48.51,0:14:50.81,text-jp,,0,0,0,,そろそろ 離してくれる？
Dialogue: 0,0:14:50.81,0:14:51.68,text-jp,,0,0,0,,あっ
Dialogue: 0,0:14:53.43,0:14:54.85,text-jp,,0,0,0,,わ… わりい
Dialogue: 0,0:14:59.82,0:15:02.69,text-jp,,0,0,0,,子供のころ 当たり前のように じゃれ合ってたのに
Dialogue: 0,0:15:03.24,0:15:04.61,text-jp,,0,0,0,,何年もたって…
Dialogue: 0,0:15:05.61,0:15:07.45,text-jp,,0,0,0,,想像以上に細くて
Dialogue: 0,0:15:08.28,0:15:10.37,text-jp,,0,0,0,,あんなに 柔らかい…
Dialogue: 0,0:15:11.58,0:15:12.83,text-jp,,0,0,0,,ねえ 新？
Dialogue: 0,0:15:13.54,0:15:14.50,text-jp,,0,0,0,,どうかした？
Dialogue: 0,0:15:15.41,0:15:16.33,text-jp,,0,0,0,,行こう
Dialogue: 0,0:15:16.75,0:15:18.38,text-jp,,0,0,0,,お… おう
Dialogue: 0,0:15:22.38,0:15:23.21,text-jp,,0,0,0,,ここは？
Dialogue: 0,0:15:23.55,0:15:26.72,text-jp,,0,0,0,,私の入ってるサークルの 部屋みたいなものよ
Dialogue: 0,0:15:27.22,0:15:28.84,text-jp,,0,0,0,,サークル 入ってたのか
Dialogue: 0,0:15:29.30,0:15:31.01,text-jp,,0,0,0,,言ってなかった？
Dialogue: 0,0:15:31.35,0:15:32.31,text-jp,,0,0,0,,お… おい
Dialogue: 0,0:15:32.60,0:15:33.93,text-jp,,0,0,0,,大丈夫
Dialogue: 0,0:15:33.93,0:15:36.60,text-jp,,0,0,0,,ここは 建物の中でも端の方だし
Dialogue: 0,0:15:36.98,0:15:39.81,text-jp,,0,0,0,,警備員さんも さっき回って帰ったところだし
Dialogue: 0,0:15:40.73,0:15:42.65,text-jp,,0,0,0,,コソコソして来た意味が…
Dialogue: 0,0:15:44.15,0:15:45.82,text-jp,,0,0,0,,サークルって聞くと
Dialogue: 0,0:15:45.82,0:15:48.20,text-jp,,0,0,0,,浮ついてたり チャラいイメージあるけど
Dialogue: 0,0:15:48.70,0:15:50.28,text-jp,,0,0,0,,そんな雰囲気ないな
Dialogue: 0,0:15:50.95,0:15:52.62,text-jp,,0,0,0,,キレイに片づけられてるし…
Dialogue: 0,0:15:53.41,0:15:54.95,text-jp,,0,0,0,,あーっ よかった
Dialogue: 0,0:15:54.95,0:15:55.75,text-jp,,0,0,0,,あった！
Dialogue: 0,0:15:58.54,0:15:59.58,text-jp,,0,0,0,,人形？
Dialogue: 0,0:16:00.50,0:16:02.59,text-jp,,0,0,0,,この子だけ完成してなくて
Dialogue: 0,0:16:02.59,0:16:05.01,text-jp,,0,0,0,,今晩中に仕上げようと思ってたの
Dialogue: 0,0:16:05.51,0:16:08.34,text-jp,,0,0,0,,けど 課題とかいろいろあって 忘れちゃってて
Dialogue: 0,0:16:08.72,0:16:09.93,text-jp,,0,0,0,,よかった
Dialogue: 0,0:16:10.55,0:16:12.18,text-jp,,0,0,0,,でも 何で人形？
Dialogue: 0,0:16:12.64,0:16:13.85,text-jp,,0,0,0,,そんな趣味あったか？
Dialogue: 0,0:16:14.35,0:16:17.35,text-jp,,0,0,0,,私 この大学に入ってすぐのころ
Dialogue: 0,0:16:17.94,0:16:22.82,text-jp,,0,0,0,,授業の一環で 実習先になる大きな病院へ 見学に行ったことがあるの
Dialogue: 0,0:16:24.53,0:16:26.24,text-jp,,0,0,0,,そこの小児科には
Dialogue: 0,0:16:26.24,0:16:29.45,text-jp,,0,0,0,,長期入院している子供たちが 何人もいて
Dialogue: 0,0:16:30.41,0:16:32.57,text-jp,,0,0,0,,明るく過ごしている子もいれば
Dialogue: 0,0:16:32.57,0:16:34.70,text-jp,,0,0,0,,さみしそうにしている子もいた
Dialogue: 0,0:16:35.79,0:16:40.46,text-jp,,0,0,0,,そして そんな子たちに 看護師さんでも 親御さんでもないのに
Dialogue: 0,0:16:40.46,0:16:42.75,text-jp,,0,0,0,,分け隔てなく接している人も
Dialogue: 0,0:16:43.79,0:16:47.55,text-jp,,0,0,0,,それが この大学の ボランティアサークルの人たち
Dialogue: 0,0:16:52.18,0:16:53.64,text-jp,,0,0,0,,えっ じゃあ…
Dialogue: 0,0:16:54.64,0:16:55.47,text-jp,,0,0,0,,そう
Dialogue: 0,0:16:56.35,0:16:59.44,text-jp,,0,0,0,,この部屋を使ってる 私が入ったサークル
Dialogue: 0,0:17:00.69,0:17:04.90,text-jp,,0,0,0,,病院での活動を見て すぐ ここへ来て 話を聞いたの
Dialogue: 0,0:17:05.61,0:17:06.98,text-jp,,0,0,0,,いろんな病院の小児科を回って
Dialogue: 0,0:17:06.98,0:17:07.23,text-jp,,0,0,0,,いろんな病院の小児科を回って
Dialogue: 0,0:17:07.23,0:17:09.24,text-jp,,0,0,0,,慰問してるって聞いて
Dialogue: 0,0:17:09.24,0:17:11.20,text-jp,,0,0,0,,即 入会を決めた
Dialogue: 0,0:17:11.95,0:17:16.20,text-jp,,0,0,0,,この人形は あした慰問する病院で プレゼントするものなの
Dialogue: 0,0:17:17.41,0:17:19.16,text-jp,,0,0,0,,１つでも足りなかったら
Dialogue: 0,0:17:19.50,0:17:23.17,text-jp,,0,0,0,,それだけ 悲しい思いをする子が いるかもしれないって思って
Dialogue: 0,0:17:23.63,0:17:24.71,text-jp,,0,0,0,,焦っちゃった
Dialogue: 0,0:17:25.21,0:17:26.75,text-jp,,0,0,0,,そうだったのか
Dialogue: 0,0:17:27.46,0:17:28.38,text-jp,,0,0,0,,新
Dialogue: 0,0:17:28.67,0:17:31.93,text-jp,,0,0,0,,何で私が看護大学を 選んだのかって聞いたよね
Dialogue: 0,0:17:31.93,0:17:33.01,text-jp,,0,0,0,,ん… ああ
Dialogue: 0,0:17:33.89,0:17:36.51,text-jp,,0,0,0,,私は みんなより 少しだけ上だから
Dialogue: 0,0:17:36.81,0:17:42.19,text-jp,,0,0,0,,よく お父さんと一緒に お母さんの 入院している病院へ お見舞いに行ってたわ
Dialogue: 0,0:17:43.69,0:17:44.73,text-jp,,0,0,0,,でも
Dialogue: 0,0:17:44.73,0:17:47.61,text-jp,,0,0,0,,お母さんを残して 帰っちゃうことが悲しくて
Dialogue: 0,0:17:48.40,0:17:51.11,text-jp,,0,0,0,,ずっと一緒にいられないことが さみしくて…
Dialogue: 0,0:17:52.70,0:17:55.62,text-jp,,0,0,0,,よく病院の隅で１人で泣いてた
Dialogue: 0,0:17:57.58,0:17:59.12,text-jp,,0,0,0,,でも そんな時
Dialogue: 0,0:17:59.12,0:18:02.50,text-jp,,0,0,0,,その病院の看護師さんが 声をかけて
Dialogue: 0,0:18:02.50,0:18:04.00,text-jp,,0,0,0,,優しくしてくれた
Dialogue: 0,0:18:11.42,0:18:14.13,text-jp,,0,0,0,,そんな看護師さんの姿に憧れて
Dialogue: 0,0:18:14.13,0:18:16.43,text-jp,,0,0,0,,私は 看護大学を選んだ
Dialogue: 0,0:18:17.30,0:18:18.43,text-jp,,0,0,0,,だから これは
Dialogue: 0,0:18:18.89,0:18:20.89,text-jp,,0,0,0,,私の夢の第一歩
Dialogue: 0,0:18:26.86,0:18:29.48,text-jp,,0,0,0,,それなら 早めに言ってくれれば よかっただろ
Dialogue: 0,0:18:29.78,0:18:33.03,text-jp,,0,0,0,,忘れ物の中身も 理由も 志望動機も
Dialogue: 0,0:18:34.49,0:18:38.37,text-jp,,0,0,0,,アハハ… この子たちの方は 焦りすぎちゃってて 少しパニクってたから
Dialogue: 0,0:18:38.66,0:18:39.54,text-jp,,0,0,0,,ごめん
Dialogue: 0,0:18:40.54,0:18:42.08,text-jp,,0,0,0,,志望動機の方は
Dialogue: 0,0:18:42.45,0:18:44.41,text-jp,,0,0,0,,夢の根っこの部分だからかな
Dialogue: 0,0:18:44.96,0:18:46.92,text-jp,,0,0,0,,話すのが恥ずかしかったのかも
Dialogue: 0,0:18:47.46,0:18:48.96,text-jp,,0,0,0,,きょうだいだから 特に
Dialogue: 0,0:18:49.46,0:18:51.55,text-jp,,0,0,0,,まあ 分からなくもないけどな
Dialogue: 0,0:18:52.01,0:18:53.80,text-jp,,0,0,0,,でも いいこともあったでしょ？
Dialogue: 0,0:18:54.68,0:18:57.89,text-jp,,0,0,0,,腕に押しつけられた 柔らか～い感触…
Dialogue: 0,0:18:59.35,0:19:01.85,text-jp,,0,0,0,,廊下で押し倒されそうになった時は
Dialogue: 0,0:19:01.85,0:19:04.56,text-jp,,0,0,0,,正直 やりすぎたかなって思ったわ
Dialogue: 0,0:19:04.81,0:19:07.27,text-jp,,0,0,0,,刺激が強すぎたかなって
Dialogue: 0,0:19:09.15,0:19:09.98,text-jp,,0,0,0,,ん？ あら？
Dialogue: 0,0:19:12.90,0:19:13.90,text-jp,,0,0,0,,待って！
Dialogue: 0,0:19:13.90,0:19:14.78,text-jp,,0,0,0,,冗談
Dialogue: 0,0:19:14.78,0:19:16.99,text-jp,,0,0,0,,ホントに置いてかないで！
Dialogue: 0,0:19:40.89,0:19:43.85,text-jp,,0,0,0,,では この間の模試の結果を返します
Dialogue: 0,0:19:44.35,0:19:46.81,text-jp,,0,0,0,,出席番号順に 取りに来てください
Dialogue: 0,0:19:47.39,0:19:48.31,text-jp,,0,0,0,,だりい
Dialogue: 0,0:19:48.31,0:19:49.69,text-jp,,0,0,0,,見たくねえ～！
Dialogue: 0,0:19:50.23,0:19:51.57,text-jp,,0,0,0,,うわ マジか…
Dialogue: 0,0:19:51.57,0:19:52.77,text-jp,,0,0,0,,おっ やった！
Dialogue: 0,0:19:52.77,0:19:53.53,text-jp,,0,0,0,,上がってた？
Dialogue: 0,0:19:53.53,0:19:54.69,text-jp,,0,0,0,,Ｂ判定！
Dialogue: 0,0:19:55.19,0:19:56.15,text-jp,,0,0,0,,謳華
Dialogue: 0,0:19:56.57,0:19:57.24,text-jp,,0,0,0,,ん？
Dialogue: 0,0:19:57.53,0:19:59.11,text-jp,,0,0,0,,どうだった？ 結果
Dialogue: 0,0:19:59.53,0:20:00.57,text-jp,,0,0,0,,ああ…
Dialogue: 0,0:20:01.12,0:20:02.83,text-jp,,0,0,0,,まあ ぼちぼち
Dialogue: 0,0:20:02.83,0:20:05.29,text-jp,,0,0,0,,え～ じゃあ またＡ判定か
Dialogue: 0,0:20:05.29,0:20:08.08,text-jp,,0,0,0,,いいなあ ホント 勉強できて
Dialogue: 0,0:20:10.17,0:20:13.38,text-jp,,0,0,0,,成績優秀 運動神経抜群！
Dialogue: 0,0:20:13.38,0:20:15.88,text-jp,,0,0,0,,しかも あの紫雲寺家の三女！
Dialogue: 0,0:20:15.88,0:20:18.63,text-jp,,0,0,0,,来年の生徒会長候補 筆頭
Dialogue: 0,0:20:18.63,0:20:21.39,text-jp,,0,0,0,,スペック １個 分けてほしい！
Dialogue: 0,0:20:41.78,0:20:42.53,text-jp,,0,0,0,,ん？
Dialogue: 0,0:20:46.16,0:20:47.04,text-jp,,0,0,0,,謳華
Dialogue: 0,0:20:47.91,0:20:49.54,text-jp,,0,0,0,,やたら でかい荷物だな
Dialogue: 0,0:20:49.87,0:20:50.92,text-jp,,0,0,0,,どっか行くのか？
Dialogue: 0,0:20:52.63,0:20:53.38,text-jp,,0,0,0,,山梨
Dialogue: 0,0:20:54.00,0:20:54.59,text-jp,,0,0,0,,えっ？
Dialogue: 0,0:20:55.34,0:20:55.92,text-jp,,0,0,0,,はあ？
Dialogue: 0,0:20:56.30,0:20:57.42,text-jp,,0,0,0,,山梨？
Dialogue: 0,0:20:57.42,0:20:58.63,text-jp,,0,0,0,,山梨 行くの？
Dialogue: 0,0:20:58.63,0:20:59.38,text-jp,,0,0,0,,何で？
Dialogue: 0,0:20:59.76,0:21:01.22,text-jp,,0,0,0,,いいでしょ 別に
Dialogue: 0,0:21:03.01,0:21:03.64,text-jp,,0,0,0,,じゃあ
Dialogue: 0,0:21:04.01,0:21:04.97,text-jp,,0,0,0,,いってきます
Dialogue: 0,0:21:11.27,0:21:12.90,text-jp,,0,0,0,,急に山梨？
Dialogue: 0,0:21:13.27,0:21:15.02,text-jp,,0,0,0,,どういう風の吹き回しだ
Dialogue: 0,0:21:15.65,0:21:17.73,text-jp,,0,0,0,,親戚とか いなかったよな…
Dialogue: 0,0:21:18.90,0:21:22.61,text-jp,,0,0,0,,まあ 今日 土曜日で 月曜も祝日の３連休だし
Dialogue: 0,0:21:23.03,0:21:25.24,text-jp,,0,0,0,,別に悪いってことはねえけど…
Dialogue: 0,0:21:26.99,0:21:28.75,text-jp,,0,0,0,,ここんとこ いろいろあったから
Dialogue: 0,0:21:28.75,0:21:31.96,text-jp,,0,0,0,,１人で考える時間が 欲しいってことかな…
Dialogue: 0,0:21:34.79,0:21:36.00,text-jp,,0,0,0,,まあ いいか
Dialogue: 0,0:21:51.02,0:21:52.27,text-jp,,0,0,0,,くっ… クソ…
Dialogue: 0,0:21:55.73,0:21:58.48,text-jp,,0,0,0,,この３連休 どこ行こっか？
Dialogue: 0,0:21:59.07,0:22:01.32,text-jp,,0,0,0,,しかし その３日後
Dialogue: 0,0:22:02.82,0:22:04.61,text-jp,,0,0,0,,登校日の火曜になっても
Dialogue: 0,0:22:05.28,0:22:07.58,text-jp,,0,0,0,,謳華が帰ってくることはなかった
Comment: 0,0:00:00.00,0:00:00.00,text-cn,,0,0,0,,//------------------TEXTCN-------------------
Dialogue: 0,0:01:45.86,0:01:47.94,text-cn,,0,0,0,,我尊敬着这样的你
Dialogue: 0,0:01:48.27,0:01:50.74,text-cn,,0,0,0,,希望你做的所有一切都能得到回报
Dialogue: 0,0:01:51.44,0:01:54.20,text-cn,,0,0,0,,对我妹妹来说 这次的比赛
Dialogue: 0,0:01:54.91,0:01:56.70,text-cn,,0,0,0,,就跟自己的将来一样重要
Dialogue: 0,0:01:57.45,0:01:58.41,text-cn,,0,0,0,,求求你们
Dialogue: 0,0:01:59.16,0:02:00.08,text-cn,,0,0,0,,我不是说过了吗
Dialogue: 0,0:02:00.91,0:02:02.33,text-cn,,0,0,0,,别再说谎了
Dialogue: 0,0:02:04.17,0:02:05.42,text-cn,,0,0,0,,难过的时候
Dialogue: 0,0:02:06.33,0:02:06.96,text-cn,,0,0,0,,就哭吧
Dialogue: 0,0:02:11.01,0:02:13.63,text-cn,,0,0,0,,我想变得更厉害啊…
Dialogue: 0,0:02:14.38,0:02:16.76,text-cn,,0,0,0,,我想变得更强啊…
Dialogue: 0,0:02:33.28,0:02:34.61,text-cn,,0,0,0,,嗯…
Dialogue: 0,0:02:34.99,0:02:37.37,text-cn,,0,0,0,,不 那颗球绝对是界内
Dialogue: 0,0:02:37.70,0:02:40.66,text-cn,,0,0,0,,都几天前的事了 你居然还在气啊
Dialogue: 0,0:02:40.66,0:02:42.75,text-cn,,0,0,0,,因为我看到了啊
Dialogue: 0,0:02:42.75,0:02:44.37,text-cn,,0,0,0,,那颗肯定是界内球
Dialogue: 0,0:02:44.37,0:02:48.84,text-cn,,0,0,0,,南的杀球可是正好且清楚地打在白线里呢
Dialogue: 0,0:02:49.42,0:02:51.38,text-cn,,0,0,0,,别想给我糊弄过去
Dialogue: 0,0:02:51.38,0:02:53.67,text-cn,,0,0,0,,自从那个误判出现后情势就开始不对劲了
Dialogue: 0,0:02:54.09,0:02:56.13,text-cn,,0,0,0,,也就是说 南其实是赢了啦
Dialogue: 0,0:02:56.43,0:02:58.09,text-cn,,0,0,0,,南确实是力压对手
Dialogue: 0,0:02:58.09,0:02:59.68,text-cn,,0,0,0,,最后确是输了呢
Dialogue: 0,0:02:59.68,0:03:00.60,text-cn,,0,0,0,,真令人想不到
Dialogue: 0,0:03:00.85,0:03:03.02,text-cn,,0,0,0,,新 你也是这样想吧
Dialogue: 0,0:03:03.60,0:03:05.44,text-cn,,0,0,0,,重点不在于比赛结果吧
Dialogue: 0,0:03:05.77,0:03:07.73,text-cn,,0,0,0,,对我们而言 最重要的
Dialogue: 0,0:03:07.73,0:03:09.86,text-cn,,0,0,0,,是「南有没有留下悔恨」
Dialogue: 0,0:03:10.06,0:03:11.02,text-cn,,0,0,0,,如此而已
Dialogue: 0,0:03:11.32,0:03:12.65,text-cn,,0,0,0,,真不愧是新
Dialogue: 0,0:03:12.65,0:03:13.82,text-cn,,0,0,0,,说得真好
Dialogue: 0,0:03:13.82,0:03:15.78,text-cn,,0,0,0,,讲这种像臭老爷的话
Dialogue: 0,0:03:15.78,0:03:16.82,text-cn,,0,0,0,,达观个屁啊
Dialogue: 0,0:03:16.82,0:03:17.49,text-cn,,0,0,0,,什么
Dialogue: 0,0:03:17.82,0:03:19.95,text-cn,,0,0,0,,「像臭老爷」是什么意思
Dialogue: 0,0:03:19.95,0:03:22.49,text-cn,,0,0,0,,就是字面上的意思啊
Dialogue: 0,0:03:23.79,0:03:25.12,text-cn,,0,0,0,,啊 南
Dialogue: 0,0:03:25.12,0:03:26.50,text-cn,,0,0,0,,你也是这么想的对不对
Dialogue: 0,0:03:26.50,0:03:28.54,text-cn,,0,0,0,,那记杀球是界内没错吧
Dialogue: 0,0:03:29.33,0:03:31.54,text-cn,,0,0,0,,其实我是觉得没差啦
Dialogue: 0,0:03:32.80,0:03:35.59,text-cn,,0,0,0,,为什么啦 那不是你的比赛吗
Dialogue: 0,0:03:35.59,0:03:38.43,text-cn,,0,0,0,,全中运有人为疏失是常有的事
Dialogue: 0,0:03:38.93,0:03:41.30,text-cn,,0,0,0,,情势在那之后会崩盘是因为我自己太过天真
Dialogue: 0,0:03:42.10,0:03:44.10,text-cn,,0,0,0,,脚伤也没有恶化
Dialogue: 0,0:03:44.52,0:03:48.31,text-cn,,0,0,0,,而且说起来在这种重要时刻还受伤本来就是我的不对
Dialogue: 0,0:03:48.81,0:03:51.36,text-cn,,0,0,0,,我个人已经觉得相当满足了
Dialogue: 0,0:03:51.86,0:03:53.27,text-cn,,0,0,0,,真的是多亏有大家帮忙呢
Dialogue: 0,0:03:53.27,0:03:54.15,text-cn,,0,0,0,,谢谢你们
Dialogue: 0,0:03:54.44,0:03:56.53,text-cn,,0,0,0,,这样还要继续生气的话就是小混混了呢
Dialogue: 0,0:03:56.78,0:03:59.03,text-cn,,0,0,0,,变成单纯的抱怨了呢
Dialogue: 0,0:04:00.32,0:04:01.49,text-cn,,0,0,0,,什么啦
Dialogue: 0,0:04:01.49,0:04:05.12,text-cn,,0,0,0,,我就只是希望妹妹能获胜这有什么不对吗
Dialogue: 0,0:04:05.12,0:04:07.21,text-cn,,0,0,0,,没人说这样不对
Dialogue: 0,0:04:08.67,0:04:10.33,text-cn,,0,0,0,,有好好泡暖吗
Dialogue: 0,0:04:11.08,0:04:12.42,text-cn,,0,0,0,,别让身体着凉哦
Dialogue: 0,0:04:13.13,0:04:14.38,text-cn,,0,0,0,,不然会恢复得很慢的
Dialogue: 0,0:04:14.92,0:04:16.46,text-cn,,0,0,0,,嗯…
Dialogue: 0,0:04:18.13,0:04:18.84,text-cn,,0,0,0,,嗯…
Dialogue: 0,0:04:20.05,0:04:21.97,text-cn,,0,0,0,,不行 我无法接受
Dialogue: 0,0:04:22.51,0:04:24.72,text-cn,,0,0,0,,我现在就要在这里重播
Dialogue: 0,0:04:24.72,0:04:26.22,text-cn,,0,0,0,,自暴自弃了呢
Dialogue: 0,0:04:26.22,0:04:28.18,text-cn,,0,0,0,,变成恐龙家长了呢
Dialogue: 0,0:04:28.81,0:04:30.90,text-cn,,0,0,0,,这里就是那条白线
Dialogue: 0,0:04:31.23,0:04:32.15,text-cn,,0,0,0,,当时就是这样
Dialogue: 0,0:04:32.15,0:04:33.48,text-cn,,0,0,0,,打在这边 你们看
Dialogue: 0,0:04:33.48,0:04:35.23,text-cn,,0,0,0,,还差1毫米不是吗
Dialogue: 0,0:04:36.15,0:04:37.03,text-cn,,0,0,0,,是说你是不是捏太大力了
Dialogue: 0,0:04:37.03,0:04:38.19,text-cn,,0,0,0,,是说你是不是捏太大力了
Dialogue: 0,0:04:38.19,0:04:39.90,text-cn,,0,0,0,,很猛的杀球呢
Dialogue: 0,0:04:41.32,0:04:44.24,text-cn,,0,0,0,,吼唷 我不能接受
Dialogue: 0,0:04:44.24,0:04:45.74,text-cn,,0,0,0,,好啦 好啦
Dialogue: 0,0:04:45.74,0:04:47.62,text-cn,,0,0,0,,然后志苑是跑哪里去了啦
Dialogue: 0,0:04:47.62,0:04:48.41,text-cn,,0,0,0,,好像是跟小裕约会去了
Dialogue: 0,0:04:48.41,0:04:49.54,text-cn,,0,0,0,,好像是跟小裕约会去了
Dialogue: 0,0:04:49.54,0:04:52.33,text-cn,,0,0,0,,那个该死的现充仔
Dialogue: 0,0:04:52.58,0:04:55.88,text-cn,,0,0,0,,是说今天的讴华到底是怎么了
Dialogue: 0,0:04:55.88,0:04:57.21,text-cn,,0,0,0,,很心浮气躁呢
Dialogue: 0,0:04:57.59,0:04:59.72,text-cn,,0,0,0,,她偶尔也会有这样的日子啦
Dialogue: 0,0:05:00.26,0:05:02.34,text-cn,,0,0,0,,我才没有…
Dialogue: 0,0:05:04.30,0:05:05.51,text-cn,,0,0,0,,啊 南…
Dialogue: 0,0:05:06.06,0:05:06.76,text-cn,,0,0,0,,危险…
Dialogue: 0,0:05:08.47,0:05:09.31,text-cn,,0,0,0,,咦
Dialogue: 0,0:05:13.40,0:05:14.73,text-cn,,0,0,0,,接得漂亮
Dialogue: 0,0:05:14.73,0:05:15.90,text-cn,,0,0,0,,真不愧是新
Dialogue: 0,0:05:15.90,0:05:17.61,text-cn,,0,0,0,,哇 对不起 南
Dialogue: 0,0:05:17.61,0:05:18.99,text-cn,,0,0,0,,小心点啊
Dialogue: 0,0:05:19.40,0:05:21.82,text-cn,,0,0,0,,毕竟是我们强行要她去参赛的
Dialogue: 0,0:05:22.24,0:05:24.74,text-cn,,0,0,0,,哼 早知道就打在新的身上
Dialogue: 0,0:05:24.74,0:05:26.70,text-cn,,0,0,0,,什么 为什么啦
Dialogue: 0,0:05:27.74,0:05:29.16,text-cn,,0,0,0,,没事吧 南
Dialogue: 0,0:05:30.37,0:05:31.16,text-cn,,0,0,0,,嗯
Dialogue: 0,0:05:39.30,0:05:40.17,text-cn,,0,0,0,,喜欢…
Dialogue: 0,0:05:40.47,0:05:43.63,text-cn,,0,0,0,,我是把哥哥当作「男人」在喜欢
Dialogue: 0,0:05:51.52,0:05:54.65,text-cn,,0,0,0,,真会有那种事吗…
Dialogue: 0,0:05:55.81,0:05:58.86,text-cn,,0,0,0,,有意见就反驳我啊
Dialogue: 0,0:05:58.86,0:06:00.11,text-cn,,0,0,0,,怎样怎样
Dialogue: 0,0:06:09.12,0:06:12.16,text-cn,,0,0,0,,我想要跟新哥「结婚」
Dialogue: 0,0:06:12.75,0:06:15.08,text-cn,,0,0,0,,反倒是我要问你有发生什么奇怪的事吗
Dialogue: 0,0:06:18.50,0:06:19.05,text-cn,,0,0,0,,来了
Dialogue: 0,0:06:21.21,0:06:22.09,text-cn,,0,0,0,,咦
Dialogue: 0,0:06:28.10,0:06:30.18,text-cn,,0,0,0,,我有话想跟你谈谈
Dialogue: 0,0:06:38.15,0:06:39.77,text-cn,,0,0,0,,好 完成了
Dialogue: 0,0:06:40.07,0:06:41.57,text-cn,,0,0,0,,接着是下一个
Dialogue: 0,0:06:45.78,0:06:47.62,text-cn,,0,0,0,,欸 贝尔泽古鲁
Dialogue: 0,0:06:49.66,0:06:52.29,text-cn,,0,0,0,,那种事是真的可以的吗…
Dialogue: 0,0:06:52.79,0:06:54.33,text-cn,,0,0,0,,是要可以什么
Dialogue: 0,0:06:55.04,0:06:56.50,text-cn,,0,0,0,,没…没什么
Dialogue: 0,0:06:56.50,0:06:57.54,text-cn,,0,0,0,,晚安
Dialogue: 0,0:06:58.50,0:06:59.75,text-cn,,0,0,0,,说什么「晚安」
Dialogue: 0,0:07:00.17,0:07:01.46,text-cn,,0,0,0,,现在才9点欸…
Dialogue: 0,0:07:02.88,0:07:05.47,text-cn,,0,0,0,,这房间还是一样可爱呢
Dialogue: 0,0:07:06.26,0:07:08.59,text-cn,,0,0,0,,放了超多东西
Dialogue: 0,0:07:08.93,0:07:11.72,text-cn,,0,0,0,,琴乃从以前就很有挑家具的品味
Dialogue: 0,0:07:12.43,0:07:14.73,text-cn,,0,0,0,,啊 是偶像杂志
Dialogue: 0,0:07:14.98,0:07:17.19,text-cn,,0,0,0,,从到韩流到宝冢都有
Dialogue: 0,0:07:17.19,0:07:19.44,text-cn,,0,0,0,,琴乃你从以前就很喜欢这个呢
Dialogue: 0,0:07:19.44,0:07:20.65,text-cn,,0,0,0,,嗯…
Dialogue: 0,0:07:20.98,0:07:24.53,text-cn,,0,0,0,,啊 这个歌唱团体最近很红呢
Dialogue: 0,0:07:25.28,0:07:26.45,text-cn,,0,0,0,,那…那个…
Dialogue: 0,0:07:27.49,0:07:28.74,text-cn,,0,0,0,,你是想谈什么…
Dialogue: 0,0:07:30.83,0:07:32.29,text-cn,,0,0,0,,那件事啊
Dialogue: 0,0:07:32.29,0:07:34.50,text-cn,,0,0,0,,就是你上次说的
Dialogue: 0,0:07:34.50,0:07:36.50,text-cn,,0,0,0,,「你对新怎样」的那件事
Dialogue: 0,0:07:38.08,0:07:40.38,text-cn,,0,0,0,,我一直在想你为何会突然说出那种话
Dialogue: 0,0:07:40.92,0:07:43.59,text-cn,,0,0,0,,感觉像是被什么逼急了一样
Dialogue: 0,0:07:45.38,0:07:48.51,text-cn,,0,0,0,,也不是要来跟你说你那只是一时鬼迷心窍
Dialogue: 0,0:07:48.93,0:07:50.39,text-cn,,0,0,0,,但如果你是认真的…
Dialogue: 0,0:07:50.80,0:07:53.26,text-cn,,0,0,0,,我觉得至少要来了解一下你认真到什么程度
Dialogue: 0,0:07:54.14,0:07:56.23,text-cn,,0,0,0,,我在家里的排行是在中间
Dialogue: 0,0:07:56.56,0:07:58.81,text-cn,,0,0,0,,而且还是你的姐姐
Dialogue: 0,0:07:59.31,0:08:01.31,text-cn,,0,0,0,,算是中阶主管那样吧
Dialogue: 0,0:08:02.32,0:08:04.82,text-cn,,0,0,0,,你如果有什么烦恼的话都能跟我说…
Dialogue: 0,0:08:04.82,0:08:05.99,text-cn,,0,0,0,,我知道的…
Dialogue: 0,0:08:05.99,0:08:06.69,text-cn,,0,0,0,,咦
Dialogue: 0,0:08:07.49,0:08:08.86,text-cn,,0,0,0,,我是知道的
Dialogue: 0,0:08:09.41,0:08:11.49,text-cn,,0,0,0,,讴华你有对新哥
Dialogue: 0,0:08:12.07,0:08:13.66,text-cn,,0,0,0,,说过「喜欢」
Dialogue: 0,0:08:13.91,0:08:14.87,text-cn,,0,0,0,,咦
Dialogue: 0,0:08:15.41,0:08:17.12,text-cn,,0,0,0,,我看到了
Dialogue: 0,0:08:17.12,0:08:19.96,text-cn,,0,0,0,,万里和小南在群组里的对话
Dialogue: 0,0:08:20.37,0:08:23.71,text-cn,,0,0,0,,她们说有在With me看到你对新哥说「喜欢」
Dialogue: 0,0:08:23.71,0:08:25.17,text-cn,,0,0,0,,小南说她看到了
Dialogue: 0,0:08:25.30,0:08:25.92,text-cn,,0,0,0,,什…
Dialogue: 0,0:08:26.55,0:08:30.38,text-cn,,0,0,0,,而且我上次还在游戏室里看到…
Dialogue: 0,0:08:30.76,0:08:33.60,text-cn,,0,0,0,,你们两人的手像是情侣般牵在一起…
Dialogue: 0,0:08:36.68,0:08:38.14,text-cn,,0,0,0,,怎…怎么会
Dialogue: 0,0:08:38.14,0:08:39.64,text-cn,,0,0,0,,当时应该没人才对啊…
Dialogue: 0,0:08:39.64,0:08:41.48,text-cn,,0,0,0,,那…那是因为…
Dialogue: 0,0:08:41.48,0:08:44.52,text-cn,,0,0,0,,呃…那天我在想事情…
Dialogue: 0,0:08:44.94,0:08:46.57,text-cn,,0,0,0,,待在衣柜里…
Dialogue: 0,0:08:47.28,0:08:48.78,text-cn,,0,0,0,,是衣柜妖精
Dialogue: 0,0:08:49.61,0:08:51.99,text-cn,,0,0,0,,所以 那个…我…
Dialogue: 0,0:08:52.95,0:08:54.20,text-cn,,0,0,0,,原来如此…
Dialogue: 0,0:08:54.20,0:08:56.62,text-cn,,0,0,0,,所以才会在情急之下做出那种事吗…
Dialogue: 0,0:08:56.99,0:08:58.66,text-cn,,0,0,0,,你…你先等一下
Dialogue: 0,0:08:58.66,0:09:00.00,text-cn,,0,0,0,,那是你误会了
Dialogue: 0,0:09:00.37,0:09:03.46,text-cn,,0,0,0,,With me的那件事我说的是双胞胎之间的喜欢
Dialogue: 0,0:09:05.09,0:09:07.13,text-cn,,0,0,0,,我想新应该也是这样想的
Dialogue: 0,0:09:08.01,0:09:09.59,text-cn,,0,0,0,,误…误会…?
Dialogue: 0,0:09:10.05,0:09:12.93,text-cn,,0,0,0,,游戏室里的事情也是意外
Dialogue: 0,0:09:12.93,0:09:14.72,text-cn,,0,0,0,,你既然有在看 应该也知道吧
Dialogue: 0,0:09:15.43,0:09:19.18,text-cn,,0,0,0,,我当时也不记得有说过类似告白的话吧
Dialogue: 0,0:09:19.73,0:09:21.52,text-cn,,0,0,0,,真…真的吗
Dialogue: 0,0:09:21.52,0:09:23.23,text-cn,,0,0,0,,全部真的都只是误会吗
Dialogue: 0,0:09:23.23,0:09:25.23,text-cn,,0,0,0,,所以你们真的就只是兄妹
Dialogue: 0,0:09:25.23,0:09:28.57,text-cn,,0,0,0,,讴华你完全没有「喜欢」新哥的意思吗
Dialogue: 0,0:09:28.57,0:09:29.15,text-cn,,0,0,0,,等等…
Dialogue: 0,0:09:35.66,0:09:36.58,text-cn,,0,0,0,,没错
Dialogue: 0,0:09:39.91,0:09:41.12,text-cn,,0,0,0,,太好了…
Dialogue: 0,0:09:41.96,0:09:43.42,text-cn,,0,0,0,,抱歉是我误会你了
Dialogue: 0,0:09:43.42,0:09:44.58,text-cn,,0,0,0,,讴华
Dialogue: 0,0:09:46.67,0:09:47.71,text-cn,,0,0,0,,没关系啦…
Dialogue: 0,0:10:07.15,0:10:08.77,text-cn,,0,0,0,,去洗澡吧
Dialogue: 0,0:10:14.57,0:10:16.12,text-cn,,0,0,0,,拜托 求求你们
Dialogue: 0,0:10:16.53,0:10:18.03,text-cn,,0,0,0,,就算你这样拜托
Dialogue: 0,0:10:18.03,0:10:21.04,text-cn,,0,0,0,,但我等等就要来念书了
Dialogue: 0,0:10:21.37,0:10:23.62,text-cn,,0,0,0,,我也是 模拟考就要到了
Dialogue: 0,0:10:23.62,0:10:24.54,text-cn,,0,0,0,,抱歉啦
Dialogue: 0,0:10:26.63,0:10:29.17,text-cn,,0,0,0,,志苑跟南都还没回来
Dialogue: 0,0:10:29.59,0:10:32.26,text-cn,,0,0,0,,琴乃也说要绕去图书馆才回家…
Dialogue: 0,0:10:32.80,0:10:33.92,text-cn,,0,0,0,,我回来了
Dialogue: 0,0:10:34.88,0:10:36.55,text-cn,,0,0,0,,呼…好热
Dialogue: 0,0:10:37.22,0:10:38.76,text-cn,,0,0,0,,赶快来冲个澡吧…
Dialogue: 0,0:10:39.60,0:10:41.52,text-cn,,0,0,0,,新 你回来得正好
Dialogue: 0,0:10:44.06,0:10:45.60,text-cn,,0,0,0,,咦…怎么了…
Dialogue: 0,0:10:48.31,0:10:51.03,text-cn,,0,0,0,,这里就是万里就读的护理大学啊
Dialogue: 0,0:10:51.40,0:10:52.44,text-cn,,0,0,0,,还是第一次来呢
Dialogue: 0,0:10:56.99,0:10:58.20,text-cn,,0,0,0,,应该是说
Dialogue: 0,0:10:58.20,0:11:02.12,text-cn,,0,0,0,,我没想到竟然是要避开警卫的耳目溜进来…
Dialogue: 0,0:11:02.83,0:11:04.79,text-cn,,0,0,0,,我有什么办法
Dialogue: 0,0:11:04.79,0:11:08.75,text-cn,,0,0,0,,这时间又无法办理让校外人士进来的手续
Dialogue: 0,0:11:09.00,0:11:10.67,text-cn,,0,0,0,,你可以一个人来啊
Dialogue: 0,0:11:11.05,0:11:12.71,text-cn,,0,0,0,,要是可以 我早就来了
Dialogue: 0,0:11:13.30,0:11:15.47,text-cn,,0,0,0,,没办法请你大学朋友帮忙吗
Dialogue: 0,0:11:15.47,0:11:17.39,text-cn,,0,0,0,,大家都有自己的事啦
Dialogue: 0,0:11:17.39,0:11:20.39,text-cn,,0,0,0,,齁 你就这么讨厌姐姐吗
Dialogue: 0,0:11:20.39,0:11:22.81,text-cn,,0,0,0,,好啦 是我不对
Dialogue: 0,0:11:27.19,0:11:28.44,text-cn,,0,0,0,,东西忘了拿啊
Dialogue: 0,0:11:28.69,0:11:30.52,text-cn,,0,0,0,,是啊 不小心忘记带回家了
Dialogue: 0,0:11:31.15,0:11:33.11,text-cn,,0,0,0,,我也不是不懂你的心情
Dialogue: 0,0:11:33.48,0:11:35.24,text-cn,,0,0,0,,晚上的校园很恐怖呢
Dialogue: 0,0:11:36.24,0:11:37.78,text-cn,,0,0,0,,感觉会冒出什么东西
Dialogue: 0,0:11:38.16,0:11:40.45,text-cn,,0,0,0,,特别还是在医疗相关的学校
Dialogue: 0,0:11:40.45,0:11:42.12,text-cn,,0,0,0,,等…别说了啦
Dialogue: 0,0:11:42.12,0:11:44.79,text-cn,,0,0,0,,自从大家知道我怕鬼后
Dialogue: 0,0:11:44.79,0:11:48.00,text-cn,,0,0,0,,就会跟我说会在实习室看到一些东西
Dialogue: 0,0:11:48.00,0:11:50.96,text-cn,,0,0,0,,或是哪里的医院有什么传说
Dialogue: 0,0:11:50.96,0:11:53.05,text-cn,,0,0,0,,还有就是学校的七大不可思议…
Dialogue: 0,0:11:53.05,0:11:55.13,text-cn,,0,0,0,,真的是不要再这样了…
Dialogue: 0,0:11:55.13,0:11:57.55,text-cn,,0,0,0,,我会不敢去实习的啦…
Dialogue: 0,0:11:57.55,0:12:00.97,text-cn,,0,0,0,,医院里多得是这种传闻呢
Dialogue: 0,0:12:02.35,0:12:04.06,text-cn,,0,0,0,,不过 既然你怕成这样
Dialogue: 0,0:12:04.06,0:12:04.39,text-cn,,0,0,0,,不过 既然你怕成这样
Dialogue: 0,0:12:04.39,0:12:06.77,text-cn,,0,0,0,,为何还要念护理大学
Dialogue: 0,0:12:06.77,0:12:07.06,text-cn,,0,0,0,,你应该很明白会很多这种东西才对
Dialogue: 0,0:12:07.06,0:12:09.73,text-cn,,0,0,0,,你应该明白会有很多这种东西啊
Dialogue: 0,0:12:10.35,0:12:12.65,text-cn,,0,0,0,,话是这么说没错啦…
Dialogue: 0,0:12:14.15,0:12:15.15,text-cn,,0,0,0,,是有难言之隐吗
Dialogue: 0,0:12:16.32,0:12:17.11,text-cn,,0,0,0,,算了
Dialogue: 0,0:12:17.61,0:12:19.57,text-cn,,0,0,0,,所以你是忘了什么东西
Dialogue: 0,0:12:19.95,0:12:21.78,text-cn,,0,0,0,,赶快拿一拿回家去吧
Dialogue: 0,0:12:21.78,0:12:23.87,text-cn,,0,0,0,,等…等等我啦
Dialogue: 0,0:12:23.87,0:12:25.58,text-cn,,0,0,0,,不要丢下我一个人
Dialogue: 0,0:12:32.33,0:12:34.55,text-cn,,0,0,0,,不行 念不进去
Dialogue: 0,0:12:35.21,0:12:37.26,text-cn,,0,0,0,,这种时候就要休息
Dialogue: 0,0:12:37.72,0:12:39.51,text-cn,,0,0,0,,转换一下心情
Dialogue: 0,0:12:40.51,0:12:43.39,text-cn,,0,0,0,,有没有什么有趣的视频呢
Dialogue: 0,0:12:58.24,0:13:00.03,text-cn,,0,0,0,,是…是风啦
Dialogue: 0,0:13:00.03,0:13:01.78,text-cn,,0,0,0,,只是风吹动窗户而已
Dialogue: 0,0:13:01.78,0:13:03.87,text-cn,,0,0,0,,我…我当然知道啊…
Dialogue: 0,0:13:05.03,0:13:06.08,text-cn,,0,0,0,,是说…
Dialogue: 0,0:13:06.66,0:13:08.70,text-cn,,0,0,0,,这个触感非常不妙…
Dialogue: 0,0:13:09.62,0:13:12.79,text-cn,,0,0,0,,这…这样会不太好走 先放开我吧
Dialogue: 0,0:13:13.13,0:13:14.42,text-cn,,0,0,0,,不要 我不要
Dialogue: 0,0:13:14.42,0:13:16.46,text-cn,,0,0,0,,为什么要讲这种欺负人的话
Dialogue: 0,0:13:18.26,0:13:20.80,text-cn,,0,0,0,,不行 说再多也只是出现反效果…
Dialogue: 0,0:13:21.18,0:13:23.51,text-cn,,0,0,0,,我…我明白了 快走吧
Dialogue: 0,0:13:23.51,0:13:24.93,text-cn,,0,0,0,,不要…
Dialogue: 0,0:13:31.02,0:13:32.52,text-cn,,0,0,0,,欸 新…
Dialogue: 0,0:13:32.52,0:13:33.31,text-cn,,0,0,0,,嗯?
Dialogue: 0,0:13:33.31,0:13:35.56,text-cn,,0,0,0,,我好怕…来聊点什么吧…
Dialogue: 0,0:13:35.90,0:13:37.32,text-cn,,0,0,0,,是要聊什么
Dialogue: 0,0:13:37.32,0:13:39.03,text-cn,,0,0,0,,什么都行
Dialogue: 0,0:13:39.03,0:13:40.57,text-cn,,0,0,0,,就算你这么说…
Dialogue: 0,0:13:41.11,0:13:42.61,text-cn,,0,0,0,,不然唱首歌吧
Dialogue: 0,0:13:42.61,0:13:44.41,text-cn,,0,0,0,,唱很欢乐的那种
Dialogue: 0,0:13:44.66,0:13:47.16,text-cn,,0,0,0,,我说啊 你记得我们是溜进来的吗
Dialogue: 0,0:13:47.49,0:13:48.49,text-cn,,0,0,0,,可是…
Dialogue: 0,0:13:49.41,0:13:50.79,text-cn,,0,0,0,,我决定了…
Dialogue: 0,0:13:50.79,0:13:53.37,text-cn,,0,0,0,,我再也不要把东西忘在学校里…
Dialogue: 0,0:14:01.47,0:14:02.72,text-cn,,0,0,0,,安静
Dialogue: 0,0:14:03.09,0:14:03.97,text-cn,,0,0,0,,不要出声
Dialogue: 0,0:14:04.55,0:14:05.55,text-cn,,0,0,0,,有人过来了
Dialogue: 0,0:14:34.71,0:14:35.75,text-cn,,0,0,0,,吓死我了…
Dialogue: 0,0:14:36.17,0:14:37.46,text-cn,,0,0,0,,咦 不过等等
Dialogue: 0,0:14:37.79,0:14:39.38,text-cn,,0,0,0,,万里是在校生
Dialogue: 0,0:14:39.38,0:14:42.80,text-cn,,0,0,0,,只要说自己是来拿忘记拿的东西应该也不会被骂吧
Dialogue: 0,0:14:43.30,0:14:45.18,text-cn,,0,0,0,,那干嘛还要躲起来
Dialogue: 0,0:14:45.55,0:14:46.39,text-cn,,0,0,0,,那个…
Dialogue: 0,0:14:48.51,0:14:50.81,text-cn,,0,0,0,,差不多可以放开我了吧…
Dialogue: 0,0:14:50.81,0:14:51.68,text-cn,,0,0,0,,啊
Dialogue: 0,0:14:53.43,0:14:54.85,text-cn,,0,0,0,,抱…抱歉
Dialogue: 0,0:14:59.82,0:15:02.69,text-cn,,0,0,0,,明明小时候理所当然般地打闹在一起
Dialogue: 0,0:15:03.24,0:15:04.61,text-cn,,0,0,0,,在几年之后…
Dialogue: 0,0:15:05.61,0:15:07.45,text-cn,,0,0,0,,变得出乎意料的纤细…
Dialogue: 0,0:15:08.28,0:15:10.37,text-cn,,0,0,0,,而且…还那么柔软…
Dialogue: 0,0:15:11.58,0:15:12.83,text-cn,,0,0,0,,欸 新
Dialogue: 0,0:15:13.54,0:15:14.50,text-cn,,0,0,0,,怎么啦
Dialogue: 0,0:15:15.41,0:15:16.33,text-cn,,0,0,0,,我们走吧
Dialogue: 0,0:15:16.75,0:15:18.38,text-cn,,0,0,0,,哦…
Dialogue: 0,0:15:22.38,0:15:23.21,text-cn,,0,0,0,,这里是…?
Dialogue: 0,0:15:23.55,0:15:26.72,text-cn,,0,0,0,,算是我加入的社团教室
Dialogue: 0,0:15:27.22,0:15:28.84,text-cn,,0,0,0,,你有加入社团啊
Dialogue: 0,0:15:29.30,0:15:31.01,text-cn,,0,0,0,,我没跟你说过吗
Dialogue: 0,0:15:31.35,0:15:32.31,text-cn,,0,0,0,,喂
Dialogue: 0,0:15:32.60,0:15:33.93,text-cn,,0,0,0,,没事的
Dialogue: 0,0:15:33.93,0:15:36.60,text-cn,,0,0,0,,这里是校舍的边缘
Dialogue: 0,0:15:36.98,0:15:39.81,text-cn,,0,0,0,,警卫伯伯刚刚也巡完回去了
Dialogue: 0,0:15:40.73,0:15:42.65,text-cn,,0,0,0,,那为何还要偷偷摸摸地…
Dialogue: 0,0:15:44.15,0:15:45.82,text-cn,,0,0,0,,说到社团教室
Dialogue: 0,0:15:45.82,0:15:48.20,text-cn,,0,0,0,,我印象中都是乱七八糟的
Dialogue: 0,0:15:48.70,0:15:50.28,text-cn,,0,0,0,,但这里没那种感觉
Dialogue: 0,0:15:50.95,0:15:52.62,text-cn,,0,0,0,,还整理得很整齐…
Dialogue: 0,0:15:53.41,0:15:54.95,text-cn,,0,0,0,,啊…太好了
Dialogue: 0,0:15:54.95,0:15:55.75,text-cn,,0,0,0,,找到了
Dialogue: 0,0:15:58.54,0:15:59.58,text-cn,,0,0,0,,娃娃…?
Dialogue: 0,0:16:00.50,0:16:02.59,text-cn,,0,0,0,,就只剩下它还没完成
Dialogue: 0,0:16:02.59,0:16:05.01,text-cn,,0,0,0,,我想要在今晚把它做好
Dialogue: 0,0:16:05.51,0:16:08.34,text-cn,,0,0,0,,但因为忙作业把它忘在这里
Dialogue: 0,0:16:08.72,0:16:09.93,text-cn,,0,0,0,,太好了
Dialogue: 0,0:16:10.55,0:16:12.18,text-cn,,0,0,0,,不过为什么是娃娃
Dialogue: 0,0:16:12.64,0:16:13.85,text-cn,,0,0,0,,原来你有这种兴趣啊
Dialogue: 0,0:16:14.35,0:16:17.35,text-cn,,0,0,0,,我在刚进这所大学不久
Dialogue: 0,0:16:17.94,0:16:22.82,text-cn,,0,0,0,,作为课程的一环 曾经去过将成为我实习地点的大型医院观摩
Dialogue: 0,0:16:24.53,0:16:26.24,text-cn,,0,0,0,,在那边的小儿科
Dialogue: 0,0:16:26.24,0:16:29.45,text-cn,,0,0,0,,有很多长期在医院住院的小朋友
Dialogue: 0,0:16:30.41,0:16:32.57,text-cn,,0,0,0,,有些小孩过得很开心
Dialogue: 0,0:16:32.57,0:16:34.70,text-cn,,0,0,0,,也有看起来很寂寞的孩子
Dialogue: 0,0:16:35.79,0:16:40.46,text-cn,,0,0,0,,但也有明明不是护理师也不是亲属
Dialogue: 0,0:16:40.46,0:16:42.75,text-cn,,0,0,0,,却一视同仁去陪伴他们的人
Dialogue: 0,0:16:43.79,0:16:47.55,text-cn,,0,0,0,,那就是这间大学志工社团的人们
Dialogue: 0,0:16:52.18,0:16:53.64,text-cn,,0,0,0,,咦 所以…
Dialogue: 0,0:16:54.64,0:16:55.47,text-cn,,0,0,0,,没错
Dialogue: 0,0:16:56.35,0:16:59.44,text-cn,,0,0,0,,就是我所加入的使用这间教室的社团
Dialogue: 0,0:17:00.69,0:17:04.90,text-cn,,0,0,0,,看到他们在医院的表现后我就马上来这里询问
Dialogue: 0,0:17:05.61,0:17:06.98,text-cn,,0,0,0,,听到他们说会去到
Dialogue: 0,0:17:06.98,0:17:07.23,text-cn,,0,0,0,,听到他们说会去到
Dialogue: 0,0:17:07.23,0:17:09.24,text-cn,,0,0,0,,各间医院的小儿科进行慰问
Dialogue: 0,0:17:09.24,0:17:11.20,text-cn,,0,0,0,,我马上就决定加入了
Dialogue: 0,0:17:11.95,0:17:16.20,text-cn,,0,0,0,,而这个娃娃 是我要拿去给明天慰问小朋友的礼物
Dialogue: 0,0:17:17.41,0:17:19.16,text-cn,,0,0,0,,一想到要是少一个的话
Dialogue: 0,0:17:19.50,0:17:23.17,text-cn,,0,0,0,,可能就会有一个孩子伤心难过
Dialogue: 0,0:17:23.63,0:17:24.71,text-cn,,0,0,0,,就不由得紧张了起来
Dialogue: 0,0:17:25.21,0:17:26.75,text-cn,,0,0,0,,原来是这样…
Dialogue: 0,0:17:27.46,0:17:28.38,text-cn,,0,0,0,,新
Dialogue: 0,0:17:28.67,0:17:31.93,text-cn,,0,0,0,,你问过我为何要念护理大学对吧
Dialogue: 0,0:17:31.93,0:17:33.01,text-cn,,0,0,0,,是…是啊
Dialogue: 0,0:17:33.89,0:17:36.51,text-cn,,0,0,0,,因为我比大家年长一些
Dialogue: 0,0:17:36.81,0:17:42.19,text-cn,,0,0,0,,所以常常会跟爸爸一起到妈妈住院的医院去探望她
Dialogue: 0,0:17:43.69,0:17:44.73,text-cn,,0,0,0,,然而
Dialogue: 0,0:17:44.73,0:17:47.61,text-cn,,0,0,0,,我一直都很难过必须把妈妈留在医院自己回家
Dialogue: 0,0:17:48.40,0:17:51.11,text-cn,,0,0,0,,无法一直跟妈妈在一起觉得很寂寞…
Dialogue: 0,0:17:52.70,0:17:55.62,text-cn,,0,0,0,,常常躲在医院的角度独自哭泣
Dialogue: 0,0:17:57.58,0:17:59.12,text-cn,,0,0,0,,不过那个时候
Dialogue: 0,0:17:59.12,0:18:02.50,text-cn,,0,0,0,,那间医院的护理师小姐陪我说话
Dialogue: 0,0:18:02.50,0:18:04.00,text-cn,,0,0,0,,对我非常好
Dialogue: 0,0:18:11.42,0:18:14.13,text-cn,,0,0,0,,我很憧憬成为这样的护理师
Dialogue: 0,0:18:14.13,0:18:16.43,text-cn,,0,0,0,,所以才会选择就读护理大学
Dialogue: 0,0:18:17.30,0:18:18.43,text-cn,,0,0,0,,所以这个
Dialogue: 0,0:18:18.89,0:18:20.89,text-cn,,0,0,0,,是我梦想的第一步
Dialogue: 0,0:18:26.86,0:18:29.48,text-cn,,0,0,0,,那你应该要早点说啊
Dialogue: 0,0:18:29.78,0:18:33.03,text-cn,,0,0,0,,说你忘了什么 为何要做还有你的将来志愿
Dialogue: 0,0:18:34.49,0:18:38.37,text-cn,,0,0,0,,因为太急着找它 一时慌了手脚
Dialogue: 0,0:18:38.66,0:18:39.54,text-cn,,0,0,0,,抱歉
Dialogue: 0,0:18:40.54,0:18:42.08,text-cn,,0,0,0,,至于将来的志愿…
Dialogue: 0,0:18:42.45,0:18:44.41,text-cn,,0,0,0,,这算是我梦想的根源吧
Dialogue: 0,0:18:44.96,0:18:46.92,text-cn,,0,0,0,,所以可能不太好意思说出来
Dialogue: 0,0:18:47.46,0:18:48.96,text-cn,,0,0,0,,尤其是对兄弟姐妹
Dialogue: 0,0:18:49.46,0:18:51.55,text-cn,,0,0,0,,也不是不懂你的心情啦
Dialogue: 0,0:18:52.01,0:18:53.80,text-cn,,0,0,0,,不过 也有好事发生不是吗
Dialogue: 0,0:18:54.68,0:18:57.89,text-cn,,0,0,0,,那种紧贴手臂的柔软触感☆
Dialogue: 0,0:18:59.35,0:19:01.85,text-cn,,0,0,0,,老实说你在走廊把我推倒的时候
Dialogue: 0,0:19:01.85,0:19:04.56,text-cn,,0,0,0,,我还想说是不是玩太过火了
Dialogue: 0,0:19:04.81,0:19:07.27,text-cn,,0,0,0,,对你来说是不是太过刺激了
Dialogue: 0,0:19:09.15,0:19:09.98,text-cn,,0,0,0,,咦
Dialogue: 0,0:19:12.90,0:19:13.90,text-cn,,0,0,0,,等一下
Dialogue: 0,0:19:13.90,0:19:14.78,text-cn,,0,0,0,,我开玩笑的
Dialogue: 0,0:19:14.78,0:19:16.99,text-cn,,0,0,0,,不要真的丢下我啦
Dialogue: 0,0:19:40.89,0:19:43.85,text-cn,,0,0,0,,那么 现在来发之前的模拟考成绩
Dialogue: 0,0:19:44.35,0:19:46.81,text-cn,,0,0,0,,请各位按照编号来拿
Dialogue: 0,0:19:46.81,0:19:47.39,text-cn,,0,0,0,,咦
Dialogue: 0,0:19:47.39,0:19:48.31,text-cn,,0,0,0,,好懒
Dialogue: 0,0:19:48.31,0:19:49.69,text-cn,,0,0,0,,不想面对
Dialogue: 0,0:19:50.23,0:19:51.57,text-cn,,0,0,0,,呜哇 真的假的
Dialogue: 0,0:19:51.57,0:19:52.77,text-cn,,0,0,0,,哦 太好了♪
Dialogue: 0,0:19:52.77,0:19:53.53,text-cn,,0,0,0,,有进步吗
Dialogue: 0,0:19:53.53,0:19:54.69,text-cn,,0,0,0,,是B等♪
Dialogue: 0,0:19:55.19,0:19:56.15,text-cn,,0,0,0,,讴华
Dialogue: 0,0:19:56.57,0:19:57.24,text-cn,,0,0,0,,嗯?
Dialogue: 0,0:19:57.53,0:19:59.11,text-cn,,0,0,0,,你的成绩如何啊
Dialogue: 0,0:19:59.53,0:20:00.57,text-cn,,0,0,0,,啊…
Dialogue: 0,0:20:01.12,0:20:02.83,text-cn,,0,0,0,,还过得去啦
Dialogue: 0,0:20:02.83,0:20:05.29,text-cn,,0,0,0,,咦 那就还是A等了吧
Dialogue: 0,0:20:05.29,0:20:08.08,text-cn,,0,0,0,,好好哦 真羡慕你这么会念书
Dialogue: 0,0:20:10.17,0:20:13.38,text-cn,,0,0,0,,成绩优秀 运动神经出众
Dialogue: 0,0:20:13.38,0:20:15.88,text-cn,,0,0,0,,而且还是紫云寺家的三女
Dialogue: 0,0:20:15.88,0:20:18.63,text-cn,,0,0,0,,再加上是明年学生会长头号候补
Dialogue: 0,0:20:18.63,0:20:21.39,text-cn,,0,0,0,,真希望能把其中一个优点分给我呢
Dialogue: 0,0:20:41.78,0:20:42.53,text-cn,,0,0,0,,嗯?
Dialogue: 0,0:20:46.16,0:20:47.04,text-cn,,0,0,0,,讴华
Dialogue: 0,0:20:47.91,0:20:49.54,text-cn,,0,0,0,,怎么背那么一大包行李
Dialogue: 0,0:20:49.87,0:20:50.92,text-cn,,0,0,0,,是要去哪里吗
Dialogue: 0,0:20:52.63,0:20:53.38,text-cn,,0,0,0,,山梨
Dialogue: 0,0:20:54.00,0:20:54.59,text-cn,,0,0,0,,咦
Dialogue: 0,0:20:55.34,0:20:55.92,text-cn,,0,0,0,,什么
Dialogue: 0,0:20:56.30,0:20:57.42,text-cn,,0,0,0,,山梨?
Dialogue: 0,0:20:57.42,0:20:58.63,text-cn,,0,0,0,,你要去山梨吗
Dialogue: 0,0:20:58.63,0:20:59.38,text-cn,,0,0,0,,为什么
Dialogue: 0,0:20:59.76,0:21:01.22,text-cn,,0,0,0,,又没什么关系
Dialogue: 0,0:21:03.01,0:21:03.64,text-cn,,0,0,0,,好了
Dialogue: 0,0:21:04.01,0:21:04.97,text-cn,,0,0,0,,那我出门了
Dialogue: 0,0:21:11.27,0:21:12.90,text-cn,,0,0,0,,突然要去山梨
Dialogue: 0,0:21:13.27,0:21:15.02,text-cn,,0,0,0,,到底是哪根筋不对
Dialogue: 0,0:21:15.65,0:21:17.73,text-cn,,0,0,0,,我们没亲戚住在那边吧…
Dialogue: 0,0:21:18.90,0:21:22.61,text-cn,,0,0,0,,不过今天是周六还是碰上周一放假的三天连假
Dialogue: 0,0:21:23.03,0:21:25.24,text-cn,,0,0,0,,也没什么不好啦…
Dialogue: 0,0:21:26.99,0:21:28.75,text-cn,,0,0,0,,这段时间也发生了不少事
Dialogue: 0,0:21:28.75,0:21:31.96,text-cn,,0,0,0,,也可能是想要有个能独自一人思考的时间吧…
Dialogue: 0,0:21:34.79,0:21:36.00,text-cn,,0,0,0,,也罢
Dialogue: 0,0:21:51.02,0:21:52.27,text-cn,,0,0,0,,可恶…
Dialogue: 0,0:21:55.73,0:21:58.48,text-cn,,0,0,0,,这三天连假要去哪里好呢
Dialogue: 0,0:21:59.07,0:22:01.32,text-cn,,0,0,0,,但就在三天后
Dialogue: 0,0:22:02.82,0:22:04.61,text-cn,,0,0,0,,到了周二的上学日
Dialogue: 0,0:22:05.28,0:22:07.58,text-cn,,0,0,0,,讴华还是没有回到家里来
Dialogue: 0,0:00:14.81,0:00:20.06,text-cn-up,,0,0,0,,《紫云寺家的兄弟姐妹》
Dialogue: 0,0:04:36.15,0:04:37.03,text-cn-up,,0,0,0,,球球
Dialogue: 0,0:04:39.90,0:04:40.91,text-cn-up,,0,0,0,,我要玩
Dialogue: 0,0:04:48.41,0:04:49.54,text-cn-up,,0,0,0,,约会中
Dialogue: 0,0:10:11.07,0:10:12.95,text-cn-up,,0,0,0,,几天后
Dialogue: 0,0:12:02.35,0:12:04.06,text-cn-up,,0,0,0,,护理学科 教务处
Dialogue: 0,0:12:04.06,0:12:04.39,text-cn-up,,0,0,0,,实习室A 701室
Dialogue: 0,0:12:04.39,0:12:06.77,text-cn-up,,0,0,0,,实习室A 701室
Dialogue: 0,0:12:06.77,0:12:07.06,text-cn-up,,0,0,0,,实习室A 701室
Dialogue: 0,0:14:01.47,0:14:02.72,text-cn-up,,0,0,0,,新…
Dialogue: 0,0:15:18.38,0:15:19.84,text-cn-up,,0,0,0,,空之羽
Dialogue: 0,0:15:29.30,0:15:31.01,text-cn-up,,0,0,0,,一人一作 有志者事竟成 加油
Dialogue: 0,0:17:06.98,0:17:07.23,text-cn-up,,0,0,0,,胡子男千钧一发
Dialogue: 0,0:17:07.23,0:17:09.24,text-cn-up,,0,0,0,,胡子男千钧一发
Dialogue: 0,0:17:09.24,0:17:11.20,text-cn-up,,0,0,0,,胡子男千钧一发
Dialogue: 0,0:19:32.13,0:19:34.63,text-cn-up,,0,0,0,,他们都收到了 谢谢你
Dialogue: 0,0:19:37.38,0:19:39.22,text-cn-up,,0,0,0,,数天后
Dialogue: 0,0:20:25.43,0:20:27.56,text-cn-up,,0,0,0,,D等
Dialogue: 0,0:20:36.99,0:20:38.57,text-cn-up,,0,0,0,,周六

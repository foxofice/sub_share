Dialogue: 0,0:16:05.27,0:16:07.40,Default CN,,0,0,0,,迸发的柠檬芬芳
Dialogue: 0,0:16:09.07,0:16:11.40,Bank,,0,0,0,,{\fad(200,400)\blur8\bord4\3c&H51E2F4&}Cure Lemonade
Dialogue: 0,0:16:12.74,0:16:14.90,Default JP,,0,0,0,,安らぎの緑の大地
Dialogue: 0,0:16:12.74,0:16:14.90,Default CN,,0,0,0,,静谧的绿色大地
Dialogue: 0,0:16:16.07,0:16:18.33,Bank,,0,0,0,,{\fad(200,400)\blur8\bord4\3c&H99D83A&}Cure Mint
Dialogue: 0,0:16:19.95,0:16:21.79,Default JP,,0,0,0,,知性の青き泉
Dialogue: 0,0:16:19.95,0:16:21.79,Default CN,,0,0,0,,知性的蓝色清泉
Dialogue: 0,0:16:22.58,0:16:24.92,Bank,,0,0,0,,{\fad(200,400)\blur8\bord4\3c&HEF8B36&}Cure Aqua
Dialogue: 0,0:16:26.84,0:16:29.00,Default JP,,0,0,0,,青いバラは秘密の印
Dialogue: 0,0:16:26.84,0:16:29.00,Default CN,,0,0,0,,蓝色的玫瑰是秘密的象征
Dialogue: 0,0:16:30.05,0:16:32.51,Bank,,0,0,0,,{\fad(200,300)\bord4\blur8\3c&HF84378&}Milky Rose

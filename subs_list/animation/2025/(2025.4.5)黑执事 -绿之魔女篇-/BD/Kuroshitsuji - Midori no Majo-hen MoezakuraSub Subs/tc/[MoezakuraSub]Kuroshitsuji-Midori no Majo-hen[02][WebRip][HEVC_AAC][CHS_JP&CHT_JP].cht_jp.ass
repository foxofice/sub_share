Dialogue: 0,0:00:04.36,0:00:06.36,STAFF,,0,0,0,,{\bord4\3c&H000000&\blur5\3a85\fad(200,200)}萌櫻字幕組正在招募校對、時軸、後期等\N招新QQ群：979092314
Dialogue: 0,0:04:55.25,0:04:55.87,屏幕字 - 外语,,0,0,0,,\N喂
Dialogue: 0,0:04:57.08,0:04:59.21,屏幕字 - 外语,,0,0,0,,Was ist der Schwarz Haare Manns Name\N…黑髮…男…名字?
Dialogue: 0,0:05:11.60,0:05:16.06,屏幕字 - 外语,,0,0,0,,Sebastian, ich…der Bulter, verstehst du?\N賽巴斯、我、執事、能明白嗎?
Dialogue: 0,0:05:20.15,0:05:21.61,屏幕字 - 外语,,0,0,0,,Wo sind deine Eltern?\N你…父母…哪裡？
Dialogue: 0,0:05:24.03,0:05:27.70,屏幕字 - 外语,,0,0,0,,Eltern…weg Gestorben.\N父母 在...不在 死了
Dialogue: 0,0:05:31.03,0:05:31.66,屏幕字 - 外语,,0,0,0,,這樣呀
Dialogue: 0,0:18:08.64,0:18:14.07,屏幕字 - 外语,,0,0,0,,Früher, sorry. Lass uns versöhnen.\N剛才很抱歉，我們和好吧
Dialogue: 0,0:23:35.94,0:23:40.92,屏幕字,,0,0,0,,{\shad0.8\an5\fn华文中宋\b1\fs68\pos(960,440)\c&HFFFFFF&}那位執事，出動
Dialogue: 0,0:00:03.48,0:00:04.46,Moe - Default - JP,,0,0,0,,着いたぞ
Dialogue: 0,0:00:03.48,0:00:04.46,Moe - Default - CN,,0,0,0,,我們到了
Dialogue: 0,0:00:05.77,0:00:07.45,Moe - Default - JP,,0,0,0,,緑の館だ
Dialogue: 0,0:00:05.77,0:00:07.45,Moe - Default - CN,,0,0,0,,這裡就是綠館
Dialogue: 0,0:02:14.51,0:02:18.35,Moe - Default - JP,,0,0,0,,はぁー! 不思議なお花! 初めて見る!
Dialogue: 0,0:02:14.51,0:02:18.35,Moe - Default - CN,,0,0,0,,哇! 好特別的花! 我還是第一次見到!
Dialogue: 0,0:02:18.35,0:02:19.20,Moe - Default - JP,,0,0,0,,気をつけろ
Dialogue: 0,0:02:18.35,0:02:19.20,Moe - Default - CN,,0,0,0,,小心點
Dialogue: 0,0:02:19.20,0:02:22.91,Moe - Default - JP,,0,0,0,,それは毒草だ　触れると指が張り上がるぞ
Dialogue: 0,0:02:19.20,0:02:22.91,Moe - Default - CN,,0,0,0,,那是毒草 若是碰到 手指可是會腫起來的
Dialogue: 0,0:02:23.61,0:02:25.24,Moe - Default - JP,,0,0,0,,はい
Dialogue: 0,0:02:23.61,0:02:25.24,Moe - Default - CN,,0,0,0,,好吧
Dialogue: 0,0:02:40.91,0:02:41.84,Moe - Default - JP,,0,0,0,,こっちだ
Dialogue: 0,0:02:40.91,0:02:41.84,Moe - Default - CN,,0,0,0,,這邊
Dialogue: 0,0:02:46.20,0:02:48.35,Moe - Default - JP,,0,0,0,,あなたたちはそこで待っていなさい
Dialogue: 0,0:02:46.20,0:02:48.35,Moe - Default - CN,,0,0,0,,你們先在這裡等一下
Dialogue: 0,0:02:48.35,0:02:50.02,Moe - Default - JP,,0,0,0,,はい
Dialogue: 0,0:02:48.35,0:02:50.02,Moe - Default - CN,,0,0,0,,好的
Dialogue: 0,0:02:48.37,0:02:50.02,Moe - Default - JP,,0,0,0,,はい
Dialogue: 0,0:02:48.37,0:02:50.02,Moe - Default - CN,,0,0,0,,好
Dialogue: 0,0:02:56.59,0:03:00.53,Moe - Default - JP,,0,0,0,,久々の客だ　特別に夕食を振る舞おう
Dialogue: 0,0:02:56.59,0:03:00.53,Moe - Default - CN,,0,0,0,,你們是久違的客人 今晚就破例設宴招待你們吧
Dialogue: 0,0:03:00.53,0:03:01.88,Moe - Default - JP,,0,0,0,,恐れ入ります
Dialogue: 0,0:03:00.53,0:03:01.88,Moe - Default - CN,,0,0,0,,承蒙您的好意
Dialogue: 0,0:03:04.61,0:03:08.43,Moe - Default - JP,,0,0,0,,ヴォルフラム　用意を　使用人も部屋へ案内してやれ
Dialogue: 0,0:03:04.61,0:03:08.43,Moe - Default - CN,,0,0,0,,渥魯夫拉姆 去準備一下 再帶他們的傭人去房間
Dialogue: 0,0:03:08.87,0:03:09.72,Moe - Default - JP,,0,0,0,,いや
Dialogue: 0,0:03:08.87,0:03:09.72,Moe - Default - CN,,0,0,0,,是
Dialogue: 0,0:03:18.94,0:03:21.30,Moe - Default - JP,,0,0,0,,さっきから思っていたが
Dialogue: 0,0:03:18.94,0:03:21.30,Moe - Default - CN,,0,0,0,,我從剛才開始就在想
Dialogue: 0,0:03:21.85,0:03:25.17,Moe - Default - JP,,0,0,0,,あの小さい足　纏足じゃないか
Dialogue: 0,0:03:21.85,0:03:25.17,Moe - Default - CN,,0,0,0,,那雙小腳 是裹足吧
Dialogue: 0,0:03:25.65,0:03:27.26,Moe - Default - JP,,0,0,0,,以前ラウに聞いたことがある
Dialogue: 0,0:03:25.65,0:03:27.26,Moe - Default - CN,,0,0,0,,以前聽劉說起過
Dialogue: 0,0:03:27.97,0:03:28.69,Moe - Default - JP,,0,0,0,,確か
Dialogue: 0,0:03:27.97,0:03:28.69,Moe - Default - CN,,0,0,0,,我記得
Dialogue: 0,0:03:29.12,0:03:32.98,Moe - Default - JP,,0,0,0,,幼い頃から足を締め付けて小さく矯正するという
Dialogue: 0,0:03:29.12,0:03:32.98,Moe - Default - CN,,0,0,0,,應該是從小開始纏住腳 使其變得小巧的
Dialogue: 0,0:03:32.98,0:03:35.61,Moe - Default - JP,,0,0,0,,中国特有の風習のはず
Dialogue: 0,0:03:32.98,0:03:35.61,Moe - Default - CN,,0,0,0,,中國特有的習俗
Dialogue: 0,0:03:36.05,0:03:38.07,Moe - Default - JP,,0,0,0,,それをなぜドイツで
Dialogue: 0,0:03:36.05,0:03:38.07,Moe - Default - CN,,0,0,0,,為什麼會出現在德國
Dialogue: 0,0:03:38.35,0:03:41.58,Moe - Default - JP,,0,0,0,,しかも　領主に施しているなんて
Dialogue: 0,0:03:38.35,0:03:41.58,Moe - Default - CN,,0,0,0,,而且還是用在領主身上
Dialogue: 0,0:03:42.92,0:03:44.28,Moe - Default - JP,,0,0,0,,おい　お前
Dialogue: 0,0:03:42.92,0:03:44.28,Moe - Default - CN,,0,0,0,,喂 你
Dialogue: 0,0:03:45.30,0:03:46.59,Moe - Default - JP,,0,0,0,,僕か
Dialogue: 0,0:03:45.30,0:03:46.59,Moe - Default - CN,,0,0,0,,是在叫我嗎
Dialogue: 0,0:03:46.59,0:03:48.00,Moe - Default - JP,,0,0,0,,申し訳ありません
Dialogue: 0,0:03:46.59,0:03:48.00,Moe - Default - CN,,0,0,0,,實在抱歉
Dialogue: 0,0:03:48.46,0:03:51.86,Moe - Default - JP,,0,0,0,,坊ちゃんはまだドイツ語を習得しきれておりませんで
Dialogue: 0,0:03:48.46,0:03:51.86,Moe - Default - CN,,0,0,0,,少爺他還沒有完全掌握德語
Dialogue: 0,0:03:53.57,0:03:54.60,Moe - Default - JP,,0,0,0,,そうか
Dialogue: 0,0:03:53.57,0:03:54.60,Moe - Default - CN,,0,0,0,,這樣啊
Dialogue: 0,0:04:13.26,0:04:13.93,Moe - Default - JP,,0,0,0,,おい
Dialogue: 0,0:04:13.26,0:04:13.93,Moe - Default - CN,,0,0,0,,喂
Dialogue: 0,0:04:14.07,0:04:15.34,Moe - Default - JP,,0,0,0,,お前なんか喋れ
Dialogue: 0,0:04:14.07,0:04:15.34,Moe - Default - CN,,0,0,0,,你多少說點什麼啊
Dialogue: 0,0:04:15.54,0:04:17.26,Moe - Default - JP,,0,0,0,,女と喋るの得意だろ?
Dialogue: 0,0:04:15.54,0:04:17.26,Moe - Default - CN,,0,0,0,,你不是很擅長和女人聊天嗎？
Dialogue: 0,0:04:17.26,0:04:19.40,Moe - Default - JP,,0,0,0,,と申されましても
Dialogue: 0,0:04:17.26,0:04:19.40,Moe - Default - CN,,0,0,0,,雖是這麼說
Dialogue: 0,0:04:24.19,0:04:27.38,Moe - Default - JP,,0,0,0,,体が食物の摂取を促す合図だ
Dialogue: 0,0:04:24.19,0:04:27.38,Moe - Default - CN,,0,0,0,,這是身體催促攝取食物的信號
Dialogue: 0,0:04:28.33,0:04:31.25,Moe - Default - JP,,0,0,0,,盛大な音への恥じらいはないのか
Dialogue: 0,0:04:28.33,0:04:31.25,Moe - Default - CN,,0,0,0,,發出這麼大的聲音 她不會感到害羞的嗎
Dialogue: 0,0:04:31.25,0:04:33.89,Moe - Default - JP,,0,0,0,,ヴォルフラムさん　遅くていらっしゃいますね
Dialogue: 0,0:04:31.25,0:04:33.89,Moe - Default - CN,,0,0,0,,渥魯夫拉姆先生有點慢呢
Dialogue: 0,0:04:34.19,0:04:35.75,Moe - Default - JP,,0,0,0,,何かあったのでしょうか
Dialogue: 0,0:04:34.19,0:04:35.75,Moe - Default - CN,,0,0,0,,是發生什麼事了嗎
Dialogue: 0,0:04:35.75,0:04:38.21,Moe - Default - JP,,0,0,0,,確かにいつもより遅いな
Dialogue: 0,0:04:35.75,0:04:38.21,Moe - Default - CN,,0,0,0,,確實是比平常晚了一些
Dialogue: 0,0:04:38.54,0:04:40.85,Moe - Default - JP,,0,0,0,,キッチンの様子を拝見してきても
Dialogue: 0,0:04:38.54,0:04:40.85,Moe - Default - CN,,0,0,0,,我可以去看下廚房的情況嗎
Dialogue: 0,0:04:41.18,0:04:42.17,Moe - Default - JP,,0,0,0,,許す
Dialogue: 0,0:04:41.18,0:04:42.17,Moe - Default - CN,,0,0,0,,可以
Dialogue: 0,0:04:42.38,0:04:44.97,Moe - Default - JP,,0,0,0,,では私は少々失礼します
Dialogue: 0,0:04:42.38,0:04:44.97,Moe - Default - CN,,0,0,0,,那麼我先失陪片刻
Dialogue: 0,0:04:44.97,0:04:45.84,Moe - Default - JP,,0,0,0,,えっ　ちょ
Dialogue: 0,0:04:44.97,0:04:45.84,Moe - Default - CN,,0,0,0,,欸 等…
Dialogue: 0,0:04:46.14,0:04:50.31,Moe - Default - JP,,0,0,0,,ええ僕一人でどう相手しろと
Dialogue: 0,0:04:46.14,0:04:50.31,Moe - Default - CN,,0,0,0,,欸 我一個人要怎麼應對她啊
Dialogue: 0,0:04:53.57,0:04:54.84,Moe - Default - JP,,0,0,0,,気まずい
Dialogue: 0,0:04:53.57,0:04:54.84,Moe - Default - CN,,0,0,0,,好尷尬
Dialogue: 0,0:05:00.44,0:05:01.92,Moe - Default - JP,,0,0,0,,えっと
Dialogue: 0,0:05:00.44,0:05:01.92,Moe - Default - CN,,0,0,0,,那個
Dialogue: 0,0:05:02.69,0:05:03.69,Moe - Default - JP,,0,0,0,,なんだ
Dialogue: 0,0:05:02.69,0:05:03.69,Moe - Default - CN,,0,0,0,,什麼呀
Dialogue: 0,0:05:03.83,0:05:05.01,Moe - Default - JP,,0,0,0,,落ち着いてみれば
Dialogue: 0,0:05:03.83,0:05:05.01,Moe - Default - CN,,0,0,0,,冷靜下來聽的話
Dialogue: 0,0:05:05.01,0:05:07.33,Moe - Default - JP,,0,0,0,,単語は多少聞き取れるじゃないか
Dialogue: 0,0:05:05.01,0:05:07.33,Moe - Default - CN,,0,0,0,,我還是多少能聽懂一些單詞的啊
Dialogue: 0,0:05:07.33,0:05:11.21,Moe - Default - JP,,0,0,0,,黒髪? 男? セバスチャンのことか?
Dialogue: 0,0:05:07.33,0:05:11.21,Moe - Default - CN,,0,0,0,,黑髮? 男人? 是在說塞巴斯蒂安嗎?
Dialogue: 0,0:05:18.34,0:05:19.88,Moe - Default - JP,,0,0,0,,通じた
Dialogue: 0,0:05:18.34,0:05:19.88,Moe - Default - CN,,0,0,0,,行得通
Dialogue: 0,0:05:21.61,0:05:23.59,Moe - Default - JP,,0,0,0,,あ　おや?
Dialogue: 0,0:05:21.61,0:05:23.59,Moe - Default - CN,,0,0,0,,啊 父母?
Dialogue: 0,0:05:33.05,0:05:36.73,Moe - Default - JP,,0,0,0,,ああ　セバスチャン　早く帰ってこい
Dialogue: 0,0:05:33.05,0:05:36.73,Moe - Default - CN,,0,0,0,,啊 塞巴斯蒂安 你快給我回來啊
Dialogue: 0,0:05:44.14,0:05:45.65,Moe - Default - JP,,0,0,0,,失礼します
Dialogue: 0,0:05:44.14,0:05:45.65,Moe - Default - CN,,0,0,0,,打擾了
Dialogue: 0,0:05:46.98,0:05:48.36,Moe - Default - JP,,0,0,0,,何の用だ
Dialogue: 0,0:05:46.98,0:05:48.36,Moe - Default - CN,,0,0,0,,你有何事
Dialogue: 0,0:05:48.86,0:05:51.74,Moe - Default - JP,,0,0,0,,少々お時間がかかっていらっしゃるようですので
Dialogue: 0,0:05:48.86,0:05:51.74,Moe - Default - CN,,0,0,0,,因為看您這邊好像花了不久時間
Dialogue: 0,0:05:52.12,0:05:54.04,Moe - Default - JP,,0,0,0,,何かお手伝いすることがあればと
Dialogue: 0,0:05:52.12,0:05:54.04,Moe - Default - CN,,0,0,0,,所以我想來看看能否幫上些忙
Dialogue: 0,0:05:54.04,0:05:55.58,Moe - Default - JP,,0,0,0,,いや　いい　必要ない
Dialogue: 0,0:05:54.04,0:05:55.58,Moe - Default - CN,,0,0,0,,不 不用 不需要
Dialogue: 0,0:05:55.58,0:05:58.75,Moe - Default - JP,,0,0,0,,具材もマニュアル通り測り終えたところだ
Dialogue: 0,0:05:55.58,0:05:58.75,Moe - Default - CN,,0,0,0,,我剛按說明書量完食材的重量
Dialogue: 0,0:05:58.75,0:06:00.29,Moe - Default - JP,,0,0,0,,は　はあ
Dialogue: 0,0:05:58.75,0:06:00.29,Moe - Default - CN,,0,0,0,,啊…嗯
Dialogue: 0,0:06:00.69,0:06:01.65,Moe - Default - JP,,0,0,0,,ですが
Dialogue: 0,0:06:00.69,0:06:01.65,Moe - Default - CN,,0,0,0,,但是
Dialogue: 0,0:06:02.01,0:06:05.08,Moe - Default - JP,,0,0,0,,サリヴァン様が非常に空腹を訴えておいでです
Dialogue: 0,0:06:02.01,0:06:05.08,Moe - Default - CN,,0,0,0,,沙利文大人現在非常餓
Dialogue: 0,0:06:05.08,0:06:06.76,Moe - Default - JP,,0,0,0,,急いだ方がよろしいかと
Dialogue: 0,0:06:05.08,0:06:06.76,Moe - Default - CN,,0,0,0,,我想還是盡快一些比較好
Dialogue: 0,0:06:08.19,0:06:09.51,Moe - Default - JP,,0,0,0,,お嬢が?
Dialogue: 0,0:06:08.19,0:06:09.51,Moe - Default - CN,,0,0,0,,小姐餓了?
Dialogue: 0,0:06:10.49,0:06:11.81,Moe - Default - JP,,0,0,0,,なら仕方ねえ
Dialogue: 0,0:06:10.49,0:06:11.81,Moe - Default - CN,,0,0,0,,那就沒辦法了
Dialogue: 0,0:06:12.14,0:06:13.64,Moe - Default - JP,,0,0,0,,あんたは少し手伝ってくれ
Dialogue: 0,0:06:12.14,0:06:13.64,Moe - Default - CN,,0,0,0,,你來幫我一下吧
Dialogue: 0,0:06:13.64,0:06:14.95,Moe - Default - JP,,0,0,0,,もちろんです
Dialogue: 0,0:06:13.64,0:06:14.95,Moe - Default - CN,,0,0,0,,沒問題
Dialogue: 0,0:06:15.80,0:06:18.21,Moe - Default - JP,,0,0,0,,俺はマウルタッシェンを作るから
Dialogue: 0,0:06:15.80,0:06:18.21,Moe - Default - CN,,0,0,0,,我準備做些德國餃子
Dialogue: 0,0:06:18.55,0:06:20.01,Moe - Default - JP,,0,0,0,,あんたはパン生地をこねてくれ
Dialogue: 0,0:06:18.55,0:06:20.01,Moe - Default - CN,,0,0,0,,你來揉下面團吧
Dialogue: 0,0:06:20.01,0:06:20.68,Moe - Default - JP,,0,0,0,,え？
Dialogue: 0,0:06:20.01,0:06:20.68,Moe - Default - CN,,0,0,0,,欸？
Dialogue: 0,0:06:21.85,0:06:22.92,Moe - Default - JP,,0,0,0,,なんだ
Dialogue: 0,0:06:21.85,0:06:22.92,Moe - Default - CN,,0,0,0,,怎麼了
Dialogue: 0,0:06:22.92,0:06:25.32,Moe - Default - JP,,0,0,0,,いえ　お任せください
Dialogue: 0,0:06:22.92,0:06:25.32,Moe - Default - CN,,0,0,0,,沒什麼 交給我吧
Dialogue: 0,0:06:27.04,0:06:28.23,Moe - Default - JP,,0,0,0,,パンとは普通
Dialogue: 0,0:06:27.04,0:06:28.23,Moe - Default - CN,,0,0,0,,一般來說
Dialogue: 0,0:06:28.49,0:06:30.94,Moe - Default - JP,,0,0,0,,最初に生地をこねて　オーブンに入れ
Dialogue: 0,0:06:28.49,0:06:30.94,Moe - Default - CN,,0,0,0,,不是應該先揉麵團 放進烤箱
Dialogue: 0,0:06:30.94,0:06:34.34,Moe - Default - JP,,0,0,0,,焼き上がるまでの間に　他のメニューを仕上げるのでは
Dialogue: 0,0:06:30.94,0:06:34.34,Moe - Default - CN,,0,0,0,,在麵包烤好前 將其他菜品準備好的嗎
Dialogue: 0,0:06:35.12,0:06:38.04,Moe - Default - JP,,0,0,0,,失礼ですがスープの準備はお済みで
Dialogue: 0,0:06:35.12,0:06:38.04,Moe - Default - CN,,0,0,0,,請問 湯已經做好了嗎
Dialogue: 0,0:06:38.04,0:06:40.87,Moe - Default - JP,,0,0,0,,いや　これが終わったら作る予定だ
Dialogue: 0,0:06:38.04,0:06:40.87,Moe - Default - CN,,0,0,0,,還沒有 我準備做完這個再開始
Dialogue: 0,0:06:41.28,0:06:42.81,Moe - Default - JP,,0,0,0,,一度にやると混乱するだろう
Dialogue: 0,0:06:41.28,0:06:42.81,Moe - Default - CN,,0,0,0,,全部一起做的話 會手忙腳亂的吧
Dialogue: 0,0:06:44.28,0:06:46.09,Moe - Default - JP,,0,0,0,,差し出がましいようですが
Dialogue: 0,0:06:44.28,0:06:46.09,Moe - Default - CN,,0,0,0,,雖然您可能會嫌我多管閒事
Dialogue: 0,0:06:46.29,0:06:48.69,Moe - Default - JP,,0,0,0,,よろしければ　そちらもお手伝いしても
Dialogue: 0,0:06:46.29,0:06:48.69,Moe - Default - CN,,0,0,0,,但如果可以的話 那邊我也幫一下忙吧
Dialogue: 0,0:06:48.69,0:06:50.09,Moe - Default - JP,,0,0,0,,お
Dialogue: 0,0:06:48.69,0:06:50.09,Moe - Default - CN,,0,0,0,,好的
Dialogue: 0,0:06:50.38,0:06:51.75,Moe - Default - JP,,0,0,0,,この手の人間には
Dialogue: 0,0:06:50.38,0:06:51.75,Moe - Default - CN,,0,0,0,,對於這樣的人
Dialogue: 0,0:06:51.75,0:06:54.42,Moe - Default - JP,,0,0,0,,あの三人で慣れているつもりでしたが
Dialogue: 0,0:06:51.75,0:06:54.42,Moe - Default - CN,,0,0,0,,我原以為自己早已因那三人而習慣了
Dialogue: 0,0:06:54.89,0:06:57.81,Moe - Default - JP,,0,0,0,,これはまた新しいタイプですね
Dialogue: 0,0:06:54.89,0:06:57.81,Moe - Default - CN,,0,0,0,,但沒想到他是新的類型呢
Dialogue: 0,0:06:57.81,0:07:00.30,Moe - Default - JP,,0,0,0,,余計なことは一切していない
Dialogue: 0,0:06:57.81,0:07:00.30,Moe - Default - CN,,0,0,0,,他完全沒有做任何多餘的事情
Dialogue: 0,0:07:00.57,0:07:03.27,Moe - Default - JP,,0,0,0,,しかし最高に効率が悪い
Dialogue: 0,0:07:00.57,0:07:03.27,Moe - Default - CN,,0,0,0,,但是效率卻極其低下
Dialogue: 0,0:07:03.27,0:07:08.34,Moe - Default - JP,,0,0,0,,まさか料理を一品ずつ完成させる人間がいたとは予想外でした
Dialogue: 0,0:07:03.27,0:07:08.34,Moe - Default - CN,,0,0,0,,沒想到會存在把菜一道一道做的人
Dialogue: 0,0:07:08.34,0:07:11.06,Moe - Default - JP,,0,0,0,,これでは晩餐が深夜になってしまう
Dialogue: 0,0:07:08.34,0:07:11.06,Moe - Default - CN,,0,0,0,,這樣下去深夜才能吃到晚飯了
Dialogue: 0,0:07:11.49,0:07:13.83,Moe - Default - JP,,0,0,0,,お——セバスチャン　俺たちもなにか手伝
Dialogue: 0,0:07:11.49,0:07:13.83,Moe - Default - CN,,0,0,0,,喂 賽巴斯蒂安 我們也來幫忙
Dialogue: 0,0:07:13.83,0:07:14.95,Moe - Default - JP,,0,0,0,,いいえ　結構
Dialogue: 0,0:07:13.83,0:07:14.95,Moe - Default - CN,,0,0,0,,不 不用了
Dialogue: 0,0:07:15.55,0:07:17.48,Moe - Default - JP,,0,0,0,,長旅でお疲れでしょう
Dialogue: 0,0:07:15.55,0:07:17.48,Moe - Default - CN,,0,0,0,,你們長途跋涉想必都累了吧
Dialogue: 0,0:07:17.86,0:07:19.89,Moe - Default - JP,,0,0,0,,余計なことはせず
Dialogue: 0,0:07:17.86,0:07:19.89,Moe - Default - CN,,0,0,0,,請不要做多餘的事情
Dialogue: 0,0:07:20.09,0:07:22.17,Moe - Default - JP,,0,0,0,,ゆっくりしていてください
Dialogue: 0,0:07:20.09,0:07:22.17,Moe - Default - CN,,0,0,0,,好好去休息吧
Dialogue: 0,0:07:22.17,0:07:25.63,Moe - Default - JP,,0,0,0,,セバスチャンさん優しいですだ
Dialogue: 0,0:07:22.17,0:07:25.63,Moe - Default - CN,,0,0,0,,賽巴斯蒂安先生好體貼哦
Dialogue: 0,0:07:26.63,0:07:27.55,Moe - Default - JP,,0,0,0,,さて
Dialogue: 0,0:07:26.63,0:07:27.55,Moe - Default - CN,,0,0,0,,那麼
Dialogue: 0,0:07:28.37,0:07:29.72,Moe - Default - JP,,0,0,0,,やりますか
Dialogue: 0,0:07:28.37,0:07:29.72,Moe - Default - CN,,0,0,0,,開始吧
Dialogue: 0,0:07:31.52,0:07:33.71,Moe - Default - JP,,0,0,0,,マウルタッシェンとブルストのスープ
Dialogue: 0,0:07:31.52,0:07:33.71,Moe - Default - CN,,0,0,0,,德國餃子和香腸湯
Dialogue: 0,0:07:34.01,0:07:36.22,Moe - Default - JP,,0,0,0,,豚すね肉のアイスバイン
Dialogue: 0,0:07:34.01,0:07:36.22,Moe - Default - CN,,0,0,0,,用豬蹄做的德式燉豬腳
Dialogue: 0,0:07:36.22,0:07:39.18,Moe - Default - JP,,0,0,0,,デザートはローテグリュッツでございます
Dialogue: 0,0:07:36.22,0:07:39.18,Moe - Default - CN,,0,0,0,,甜品是紅果甜羹
Dialogue: 0,0:07:40.10,0:07:42.85,Moe - Default - JP,,0,0,0,,これはなかなか
Dialogue: 0,0:07:40.10,0:07:42.85,Moe - Default - CN,,0,0,0,,這個看起來
Dialogue: 0,0:07:43.64,0:07:47.23,Moe - Default - JP,,0,0,0,,すごいご馳走ではないか　やるなボルフ
Dialogue: 0,0:07:43.64,0:07:47.23,Moe - Default - CN,,0,0,0,,真是相當的豐盛啊 做得好 渥魯夫
Dialogue: 0,0:07:47.23,0:07:51.36,Moe - Default - JP,,0,0,0,,いやその　あっちの執事が手伝ってくれて
Dialogue: 0,0:07:47.23,0:07:51.36,Moe - Default - CN,,0,0,0,,不...這個 是那位執事幫了我忙
Dialogue: 0,0:07:52.09,0:07:55.21,Moe - Default - JP,,0,0,0,,一晩お世話になるのですから当然です
Dialogue: 0,0:07:52.09,0:07:55.21,Moe - Default - CN,,0,0,0,,承蒙你們照顧一晚 這是應該做的
Dialogue: 0,0:07:56.00,0:07:58.27,Moe - Default - JP,,0,0,0,,ファントムハイブ家の執事たる者
Dialogue: 0,0:07:56.00,0:07:58.27,Moe - Default - CN,,0,0,0,,身為凡多姆海伍家的執事
Dialogue: 0,0:07:58.58,0:08:01.70,Moe - Default - JP,,0,0,0,,この程度のお手伝いができずにどうします?
Dialogue: 0,0:07:58.58,0:08:01.70,Moe - Default - CN,,0,0,0,,連這點忙都幫不上可怎麼行?
Dialogue: 0,0:08:02.33,0:08:03.29,Moe - Default - JP,,0,0,0,,どれ?
Dialogue: 0,0:08:02.33,0:08:03.29,Moe - Default - CN,,0,0,0,,讓我嚐嚐
Dialogue: 0,0:08:06.35,0:08:07.36,Moe - Default - JP,,0,0,0,,うまい
Dialogue: 0,0:08:06.35,0:08:07.36,Moe - Default - CN,,0,0,0,,真好吃
Dialogue: 0,0:08:08.62,0:08:11.61,Moe - Default - JP,,0,0,0,,こんな柔らかいパンは初めてだ
Dialogue: 0,0:08:08.62,0:08:11.61,Moe - Default - CN,,0,0,0,,我還是第一次吃到這麼鬆軟的麵包
Dialogue: 0,0:08:13.51,0:08:15.68,Moe - Default - JP,,0,0,0,,な　なんて食べ方だ
Dialogue: 0,0:08:13.51,0:08:15.68,Moe - Default - CN,,0,0,0,,這 這吃相可真是
Dialogue: 0,0:08:15.68,0:08:18.55,Moe - Default - JP,,0,0,0,,気取らない主義でいらっしゃるのですね
Dialogue: 0,0:08:15.68,0:08:18.55,Moe - Default - CN,,0,0,0,,真是位不裝腔作勢的人呢
Dialogue: 0,0:08:20.77,0:08:22.31,Moe - Default - JP,,0,0,0,,ヴォルフラム様　大変です
Dialogue: 0,0:08:20.77,0:08:22.31,Moe - Default - CN,,0,0,0,,渥魯夫拉姆大人 不好了
Dialogue: 0,0:08:22.89,0:08:24.35,Moe - Default - JP,,0,0,0,,どうした　ヒルデ
Dialogue: 0,0:08:22.89,0:08:24.35,Moe - Default - CN,,0,0,0,,怎麼了　希爾德
Dialogue: 0,0:08:27.89,0:08:28.79,Moe - Default - JP,,0,0,0,,人
Dialogue: 0,0:08:27.89,0:08:28.79,Moe - Default - CN,,0,0,0,,狼…
Dialogue: 0,0:08:29.27,0:08:31.01,Moe - Default - JP,,0,0,0,,人狼が出ました
Dialogue: 0,0:08:29.27,0:08:31.01,Moe - Default - CN,,0,0,0,,狼人出現了
Dialogue: 0,0:08:37.09,0:08:38.41,Moe - Default - JP,,0,0,0,,人狼?
Dialogue: 0,0:08:37.09,0:08:38.41,Moe - Default - CN,,0,0,0,,狼人?
Dialogue: 0,0:08:38.68,0:08:40.06,Moe - Default - JP,,0,0,0,,ひどくやられて
Dialogue: 0,0:08:38.68,0:08:40.06,Moe - Default - CN,,0,0,0,,有人受了重傷
Dialogue: 0,0:08:40.46,0:08:42.64,Moe - Default - JP,,0,0,0,,サリヴァン様　お助けください
Dialogue: 0,0:08:40.46,0:08:42.64,Moe - Default - CN,,0,0,0,,沙利文大人 請救救她
Dialogue: 0,0:08:42.64,0:08:43.71,Moe - Default - JP,,0,0,0,,すぐ行く
Dialogue: 0,0:08:42.64,0:08:43.71,Moe - Default - CN,,0,0,0,,我馬上就去
Dialogue: 0,0:08:43.71,0:08:44.29,Moe - Default - JP,,0,0,0,,ヴォルフ
Dialogue: 0,0:08:43.71,0:08:44.29,Moe - Default - CN,,0,0,0,,渥魯夫
Dialogue: 0,0:08:44.29,0:08:44.83,Moe - Default - JP,,0,0,0,,や
Dialogue: 0,0:08:44.29,0:08:44.83,Moe - Default - CN,,0,0,0,,是
Dialogue: 0,0:08:47.93,0:08:49.39,Moe - Default - JP,,0,0,0,,お前らはここで待ってろ
Dialogue: 0,0:08:47.93,0:08:49.39,Moe - Default - CN,,0,0,0,,你們在這裡等著
Dialogue: 0,0:08:49.39,0:08:51.50,Moe - Default - JP,,0,0,0,,いいえ　ご一緒させてください
Dialogue: 0,0:08:49.39,0:08:51.50,Moe - Default - CN,,0,0,0,,不 請允許我們同行
Dialogue: 0,0:08:51.89,0:08:53.84,Moe - Default - JP,,0,0,0,,この森にどんな脅威があるのか
Dialogue: 0,0:08:51.89,0:08:53.84,Moe - Default - CN,,0,0,0,,這座森林中究竟存在怎樣的威脅
Dialogue: 0,0:08:54.96,0:08:56.45,Moe - Default - JP,,0,0,0,,知っておきたいのです
Dialogue: 0,0:08:54.96,0:08:56.45,Moe - Default - CN,,0,0,0,,我們想事先了解
Dialogue: 0,0:09:04.85,0:09:05.77,Moe - Default - JP,,0,0,0,,どいてくれ!
Dialogue: 0,0:09:04.85,0:09:05.77,Moe - Default - CN,,0,0,0,,讓開！
Dialogue: 0,0:09:06.56,0:09:08.05,Moe - Default - JP,,0,0,0,,サリヴァン様
Dialogue: 0,0:09:06.56,0:09:08.05,Moe - Default - CN,,0,0,0,,沙利文大人
Dialogue: 0,0:09:08.05,0:09:10.02,Moe - Default - JP,,0,0,0,,お助けください　サリヴァン様
Dialogue: 0,0:09:08.05,0:09:10.02,Moe - Default - CN,,0,0,0,,請救救她 沙利文大人
Dialogue: 0,0:09:14.92,0:09:17.41,Moe - Default - JP,,0,0,0,,この傷は…
Dialogue: 0,0:09:14.92,0:09:17.41,Moe - Default - CN,,0,0,0,,這些傷口是…
Dialogue: 0,0:09:18.31,0:09:20.33,Moe - Default - JP,,0,0,0,,こんなことは初めてだ
Dialogue: 0,0:09:18.31,0:09:20.33,Moe - Default - CN,,0,0,0,,還是第一次發生這種事
Dialogue: 0,0:09:20.62,0:09:22.98,Moe - Default - JP,,0,0,0,,我が村人を牙にかけるなど
Dialogue: 0,0:09:20.62,0:09:22.98,Moe - Default - CN,,0,0,0,,竟敢傷害我們村裡的人
Dialogue: 0,0:09:23.60,0:09:25.33,Moe - Default - JP,,0,0,0,,お嬢　止血を!
Dialogue: 0,0:09:23.60,0:09:25.33,Moe - Default - CN,,0,0,0,,小姐 先止血
Dialogue: 0,0:09:26.54,0:09:28.25,Moe - Default - JP,,0,0,0,,少し痛むぞ
Dialogue: 0,0:09:26.54,0:09:28.25,Moe - Default - CN,,0,0,0,,會有些痛哦
Dialogue: 0,0:09:38.07,0:09:39.34,Moe - Default - JP,,0,0,0,,お前　護符は
Dialogue: 0,0:09:38.07,0:09:39.34,Moe - Default - CN,,0,0,0,,你的護身符呢
Dialogue: 0,0:09:40.64,0:09:43.71,Moe - Default - JP,,0,0,0,,近くに薬草を取りに行くだけだからと置いたまま
Dialogue: 0,0:09:40.64,0:09:43.71,Moe - Default - CN,,0,0,0,,說只是去很近的地方採草藥 所以就放在那沒帶
Dialogue: 0,0:09:43.71,0:09:44.81,Moe - Default - JP,,0,0,0,,バカ者
Dialogue: 0,0:09:43.71,0:09:44.81,Moe - Default - CN,,0,0,0,,愚蠢之人
Dialogue: 0,0:09:44.81,0:09:48.02,Moe - Default - JP,,0,0,0,,護符は肌見放さずもってとなるほど
Dialogue: 0,0:09:44.81,0:09:48.02,Moe - Default - CN,,0,0,0,,我說過那護身符非常重要 要一直貼身帶著
Dialogue: 0,0:09:48.42,0:09:50.15,Moe - Default - JP,,0,0,0,,まだ近くにいるかもしれない
Dialogue: 0,0:09:48.42,0:09:50.15,Moe - Default - CN,,0,0,0,,狼人可能還在附近
Dialogue: 0,0:09:50.62,0:09:51.47,Moe - Default - JP,,0,0,0,,明かりを増やせ
Dialogue: 0,0:09:50.62,0:09:51.47,Moe - Default - CN,,0,0,0,,多拿點火把
Dialogue: 0,0:09:51.47,0:09:52.56,Moe - Default - JP,,0,0,0,,はい
Dialogue: 0,0:09:51.47,0:09:52.56,Moe - Default - CN,,0,0,0,,是
Dialogue: 0,0:09:52.56,0:09:53.69,Moe - Default - JP,,0,0,0,,はい
Dialogue: 0,0:09:52.56,0:09:53.69,Moe - Default - CN,,0,0,0,,是
Dialogue: 0,0:09:58.36,0:10:00.97,Moe - Default - JP,,0,0,0,,これは一体どういうことだ
Dialogue: 0,0:09:58.36,0:10:00.97,Moe - Default - CN,,0,0,0,,這到底是怎麼一回事
Dialogue: 0,0:10:00.97,0:10:03.74,Moe - Default - JP,,0,0,0,,まさか本当に森には人狼が
Dialogue: 0,0:10:00.97,0:10:03.74,Moe - Default - CN,,0,0,0,,難道森林中真的有狼人
Dialogue: 0,0:10:03.74,0:10:05.33,Moe - Default - JP,,0,0,0,,そんな馬鹿な
Dialogue: 0,0:10:03.74,0:10:05.33,Moe - Default - CN,,0,0,0,,怎麼可能
Dialogue: 0,0:10:06.23,0:10:07.41,Moe - Default - JP,,0,0,0,,どう思う?
Dialogue: 0,0:10:06.23,0:10:07.41,Moe - Default - CN,,0,0,0,,你怎麼想？
Dialogue: 0,0:10:07.78,0:10:10.29,Moe - Default - JP,,0,0,0,,あの傷だけでは何とも言えませんね
Dialogue: 0,0:10:07.78,0:10:10.29,Moe - Default - CN,,0,0,0,,光憑那個傷口不能說明任何事情呢
Dialogue: 0,0:10:10.69,0:10:13.10,Moe - Default - JP,,0,0,0,,今すぐ森を探索してみますか
Dialogue: 0,0:10:10.69,0:10:13.10,Moe - Default - CN,,0,0,0,,要現在去森林裡搜尋一下嗎
Dialogue: 0,0:10:13.54,0:10:14.45,Moe - Default - JP,,0,0,0,,いや待て
Dialogue: 0,0:10:13.54,0:10:14.45,Moe - Default - CN,,0,0,0,,不 等會
Dialogue: 0,0:10:14.83,0:10:17.21,Moe - Default - JP,,0,0,0,,今はまだ不審な動きを見せるな
Dialogue: 0,0:10:14.83,0:10:17.21,Moe - Default - CN,,0,0,0,,現在還不能輕舉妄動
Dialogue: 0,0:10:17.92,0:10:20.80,Moe - Default - JP,,0,0,0,,人狼様のお怒りじゃ!
Dialogue: 0,0:10:17.92,0:10:20.80,Moe - Default - CN,,0,0,0,,這可是狼人大人的憤怒啊！
Dialogue: 0,0:10:20.80,0:10:21.81,Moe - Default - JP,,0,0,0,,よそ者に
Dialogue: 0,0:10:20.80,0:10:21.81,Moe - Default - CN,,0,0,0,,是狼人大人在憤怒
Dialogue: 0,0:10:21.81,0:10:25.43,Moe - Default - JP,,0,0,0,,森を荒らされた人狼様がお怒りなのじゃ!
Dialogue: 0,0:10:21.81,0:10:25.43,Moe - Default - CN,,0,0,0,,因為外來者破壞了森林
Dialogue: 0,0:10:25.43,0:10:27.89,Moe - Default - JP,,0,0,0,,よそ者は早く行ね
Dialogue: 0,0:10:25.43,0:10:27.89,Moe - Default - CN,,0,0,0,,外來者快滾
Dialogue: 0,0:10:27.89,0:10:30.22,Moe - Default - JP,,0,0,0,,護符を持ってなかったせいだ!
Dialogue: 0,0:10:27.89,0:10:30.22,Moe - Default - CN,,0,0,0,,她是因為沒有帶護身符！
Dialogue: 0,0:10:30.37,0:10:32.36,Moe - Default - JP,,0,0,0,,護符さえしていれば襲ってこない!
Dialogue: 0,0:10:30.37,0:10:32.36,Moe - Default - CN,,0,0,0,,只要帶著護身符 狼人就不會襲擊我們！
Dialogue: 0,0:10:32.83,0:10:34.81,Moe - Default - JP,,0,0,0,,今まで
Dialogue: 0,0:10:32.83,0:10:34.81,Moe - Default - CN,,0,0,0,,迄今為止
Dialogue: 0,0:10:34.81,0:10:38.12,Moe - Default - JP,,0,0,0,,人狼様が自らの手で　我らを傷つけたことがあったか!
Dialogue: 0,0:10:34.81,0:10:38.12,Moe - Default - CN,,0,0,0,,狼人大人可有親手傷害過我們嗎！
Dialogue: 0,0:10:38.12,0:10:41.03,Moe - Default - JP,,0,0,0,,よそ者をかばうか! 緑の魔女よ!
Dialogue: 0,0:10:38.12,0:10:41.03,Moe - Default - CN,,0,0,0,,你是在包庇外來者嗎! 綠之魔女!
Dialogue: 0,0:10:43.24,0:10:45.50,Moe - Default - JP,,0,0,0,,忘れるな　緑の魔女よ
Dialogue: 0,0:10:43.24,0:10:45.50,Moe - Default - CN,,0,0,0,,別忘了 綠之魔女
Dialogue: 0,0:10:45.50,0:10:49.46,Moe - Default - JP,,0,0,0,,先祖が外の人間に受けた非道の数々を
Dialogue: 0,0:10:45.50,0:10:49.46,Moe - Default - CN,,0,0,0,,我們祖先所受的外來者的諸多殘忍對待
Dialogue: 0,0:10:49.46,0:10:52.79,Moe - Default - JP,,0,0,0,,決して外の人間を信用してはならぬ
Dialogue: 0,0:10:49.46,0:10:52.79,Moe - Default - CN,,0,0,0,,絕不可以相信外面的人
Dialogue: 0,0:10:52.79,0:10:55.46,Moe - Default - JP,,0,0,0,,先祖の恨みを忘れてはならぬ
Dialogue: 0,0:10:52.79,0:10:55.46,Moe - Default - CN,,0,0,0,,絕不能忘記祖先的仇恨
Dialogue: 0,0:10:55.46,0:10:58.80,Moe - Default - JP,,0,0,0,,人狼様への感謝と畏怖を忘れてはならぬ
Dialogue: 0,0:10:55.46,0:10:58.80,Moe - Default - CN,,0,0,0,,絕不能忘記要對狼人大人懷有感恩和敬畏
Dialogue: 0,0:10:58.80,0:11:00.23,Moe - Default - JP,,0,0,0,,でも僕は
Dialogue: 0,0:10:58.80,0:11:00.23,Moe - Default - CN,,0,0,0,,但是我…
Dialogue: 0,0:11:00.23,0:11:02.25,Moe - Default - JP,,0,0,0,,愚かなよそ者どもめ!
Dialogue: 0,0:11:00.23,0:11:02.25,Moe - Default - CN,,0,0,0,,愚蠢的外來者們！
Dialogue: 0,0:11:02.25,0:11:05.64,Moe - Default - JP,,0,0,0,,お前らのせいで人狼様がお怒りになったのだ!
Dialogue: 0,0:11:02.25,0:11:05.64,Moe - Default - CN,,0,0,0,,都是你們造成了狼人大人的憤怒！
Dialogue: 0,0:11:05.64,0:11:08.30,Moe - Default - JP,,0,0,0,,すべて! 貴様らのせいだ!
Dialogue: 0,0:11:05.64,0:11:08.30,Moe - Default - CN,,0,0,0,,全部都是! 你們的錯!
Dialogue: 0,0:11:08.30,0:11:11.87,Moe - Default - JP,,0,0,0,,貴様らの貴様らの
Dialogue: 0,0:11:08.30,0:11:11.87,Moe - Default - CN,,0,0,0,,你們的錯 你們的錯
Dialogue: 0,0:11:13.34,0:11:14.62,Moe - Default - JP,,0,0,0,,そうそう行ね
Dialogue: 0,0:11:13.34,0:11:14.62,Moe - Default - CN,,0,0,0,,快點滾
Dialogue: 0,0:11:14.89,0:11:18.82,Moe - Default - JP,,0,0,0,,人狼様に八つ裂きにされたくなくばなぁ!
Dialogue: 0,0:11:14.89,0:11:18.82,Moe - Default - CN,,0,0,0,,要是不想被狼人大人撕碎的話就快滾!
Dialogue: 0,0:11:27.22,0:11:29.13,Moe - Default - JP,,0,0,0,,とにかく朝まで家から出るな
Dialogue: 0,0:11:27.22,0:11:29.13,Moe - Default - CN,,0,0,0,,總之 在天亮之前不許出門
Dialogue: 0,0:11:30.58,0:11:32.33,Moe - Default - JP,,0,0,0,,お前らもこれで分かっただろ
Dialogue: 0,0:11:30.58,0:11:32.33,Moe - Default - CN,,0,0,0,,你們這下明白了吧
Dialogue: 0,0:11:33.10,0:11:35.71,Moe - Default - JP,,0,0,0,,命が惜しければ勝手に森に入るな
Dialogue: 0,0:11:33.10,0:11:35.71,Moe - Default - CN,,0,0,0,,要是惜命 就別擅自進入森林
Dialogue: 0,0:11:36.38,0:11:37.58,Moe - Default - JP,,0,0,0,,絶対に
Dialogue: 0,0:11:36.38,0:11:37.58,Moe - Default - CN,,0,0,0,,絕對不可以
Dialogue: 0,0:11:48.22,0:11:49.46,Moe - Default - JP,,0,0,0,,濃いめに入れろ
Dialogue: 0,0:11:48.22,0:11:49.46,Moe - Default - CN,,0,0,0,,泡濃一些吧
Dialogue: 0,0:11:49.91,0:11:51.52,Moe - Default - JP,,0,0,0,,徹夜になるかもしれん
Dialogue: 0,0:11:49.91,0:11:51.52,Moe - Default - CN,,0,0,0,,可能要熬夜了
Dialogue: 0,0:11:51.52,0:11:53.19,Moe - Default - JP,,0,0,0,,かしこまりました
Dialogue: 0,0:11:51.52,0:11:53.19,Moe - Default - CN,,0,0,0,,遵命
Dialogue: 0,0:12:05.18,0:12:08.06,Moe - Default - JP,,0,0,0,,では　ストレートで　お召し上がりください
Dialogue: 0,0:12:05.18,0:12:08.06,Moe - Default - CN,,0,0,0,,那麼 請您直接享用吧
Dialogue: 0,0:12:13.16,0:12:16.64,Moe - Default - JP,,0,0,0,,まさか本当に　人狼の被害者が出るとは
Dialogue: 0,0:12:13.16,0:12:16.64,Moe - Default - CN,,0,0,0,,沒想到真有人被狼人襲擊
Dialogue: 0,0:12:17.64,0:12:20.55,Moe - Default - JP,,0,0,0,,だが　クラウスの情報と違って
Dialogue: 0,0:12:17.64,0:12:20.55,Moe - Default - CN,,0,0,0,,但這和克勞斯提供的情報有出…
Dialogue: 0,0:12:32.10,0:12:33.14,Moe - Default - JP,,0,0,0,,お前は
Dialogue: 0,0:12:32.10,0:12:33.14,Moe - Default - CN,,0,0,0,,你是…
Dialogue: 0,0:12:36.20,0:12:38.26,Moe - Default - JP,,0,0,0,,これはこれは　サリヴァン様
Dialogue: 0,0:12:36.20,0:12:38.26,Moe - Default - CN,,0,0,0,,哎呀呀 這不是沙利文大人嗎
Dialogue: 0,0:12:38.88,0:12:41.65,Moe - Default - JP,,0,0,0,,従者も連れず　お一人でいらしたのですか?
Dialogue: 0,0:12:38.88,0:12:41.65,Moe - Default - CN,,0,0,0,,連隨從都沒帶 就這麼一個人來的嗎？
Dialogue: 0,0:12:42.46,0:12:44.91,Moe - Default - JP,,0,0,0,,このヘックスバローンがあれば
Dialogue: 0,0:12:42.46,0:12:44.91,Moe - Default - CN,,0,0,0,,只要有這個魔女氣球在
Dialogue: 0,0:12:44.91,0:12:47.50,Moe - Default - JP,,0,0,0,,城の中ぐらい一人で歩ける
Dialogue: 0,0:12:44.91,0:12:47.50,Moe - Default - CN,,0,0,0,,不出府的話我還是能夠一個人行動的
Dialogue: 0,0:12:48.27,0:12:49.83,Moe - Default - JP,,0,0,0,,なるほど
Dialogue: 0,0:12:48.27,0:12:49.83,Moe - Default - CN,,0,0,0,,原來如此
Dialogue: 0,0:12:52.61,0:12:53.75,Moe - Default - JP,,0,0,0,,ですが
Dialogue: 0,0:12:52.61,0:12:53.75,Moe - Default - CN,,0,0,0,,不過…
Dialogue: 0,0:12:54.96,0:12:57.59,Moe - Default - JP,,0,0,0,,レディが男性の部屋の前で立ち聞きとは
Dialogue: 0,0:12:54.96,0:12:57.59,Moe - Default - CN,,0,0,0,,淑女竟躲在男士的房門外偷聽
Dialogue: 0,0:12:57.59,0:12:59.23,Moe - Default - JP,,0,0,0,,関心いたしませんね
Dialogue: 0,0:12:57.59,0:12:59.23,Moe - Default - CN,,0,0,0,,這還真是讓人不敢恭維啊
Dialogue: 0,0:13:00.23,0:13:02.36,Moe - Default - JP,,0,0,0,,ご用向きを伺いましょうか
Dialogue: 0,0:13:00.23,0:13:02.36,Moe - Default - CN,,0,0,0,,說說您的來意吧
Dialogue: 0,0:13:03.93,0:13:05.58,Moe - Default - JP,,0,0,0,,ご用…だと?
Dialogue: 0,0:13:03.93,0:13:05.58,Moe - Default - CN,,0,0,0,,我的…來意？
Dialogue: 0,0:13:06.90,0:13:09.64,Moe - Default - JP,,0,0,0,,ふん　僕に用があるのはお前たちの方だろ
Dialogue: 0,0:13:06.90,0:13:09.64,Moe - Default - CN,,0,0,0,,有求於我的是你們才對吧！
Dialogue: 0,0:13:09.64,0:13:10.60,Moe - Default - JP,,0,0,0,,なに?
Dialogue: 0,0:13:09.64,0:13:10.60,Moe - Default - CN,,0,0,0,,你說什麼？
Dialogue: 0,0:13:11.02,0:13:12.53,Moe - Default - JP,,0,0,0,,僕は魔女だぞ
Dialogue: 0,0:13:11.02,0:13:12.53,Moe - Default - CN,,0,0,0,,我可是魔女
Dialogue: 0,0:13:13.16,0:13:16.06,Moe - Default - JP,,0,0,0,,お前らの考えなどすべてを見通しだ
Dialogue: 0,0:13:13.16,0:13:16.06,Moe - Default - CN,,0,0,0,,已經看穿了你們所有的想法
Dialogue: 0,0:13:16.92,0:13:17.78,Moe - Default - JP,,0,0,0,,ほう
Dialogue: 0,0:13:16.92,0:13:17.78,Moe - Default - CN,,0,0,0,,這樣啊
Dialogue: 0,0:13:18.78,0:13:21.26,Moe - Default - JP,,0,0,0,,ならば何をすべきかお分かりですね
Dialogue: 0,0:13:18.78,0:13:21.26,Moe - Default - CN,,0,0,0,,那您應當也知道該怎麼做吧？
Dialogue: 0,0:13:22.60,0:13:24.82,Moe - Default - JP,,0,0,0,,手荒な真似はしたくありません
Dialogue: 0,0:13:22.60,0:13:24.82,Moe - Default - CN,,0,0,0,,如果可以的話 我也不想動粗
Dialogue: 0,0:13:28.54,0:13:31.81,Moe - Default - JP,,0,0,0,,お前たちの村に来た時から予感していた
Dialogue: 0,0:13:28.54,0:13:31.81,Moe - Default - CN,,0,0,0,,當你們來到這個村子時 我便早有預感
Dialogue: 0,0:13:32.60,0:13:33.73,Moe - Default - JP,,0,0,0,,今夜僕は
Dialogue: 0,0:13:32.60,0:13:33.73,Moe - Default - CN,,0,0,0,,我將在今晚
Dialogue: 0,0:13:34.21,0:13:38.92,Moe - Default - JP,,0,0,0,,11年守り続けた秘密の小部屋の鍵を壊すことになると
Dialogue: 0,0:13:34.21,0:13:38.92,Moe - Default - CN,,0,0,0,,打破堅守了11年的秘密的小房間的門鎖
Dialogue: 0,0:13:42.41,0:13:46.19,Moe - Default - JP,,0,0,0,,覚悟はしていたが　心拍数の上昇が止まらん
Dialogue: 0,0:13:42.41,0:13:46.19,Moe - Default - CN,,0,0,0,,雖然已經做好了心理準備 但心跳還是抑制不住地加快
Dialogue: 0,0:13:46.82,0:13:47.55,Moe - Default - JP,,0,0,0,,いざーー
Dialogue: 0,0:13:46.82,0:13:47.55,Moe - Default - CN,,0,0,0,,來吧！
Dialogue: 0,0:13:50.40,0:13:53.54,Moe - Default - JP,,0,0,0,,初めてが三人でになるとは思わなかったが
Dialogue: 0,0:13:50.40,0:13:53.54,Moe - Default - CN,,0,0,0,,雖然沒料到第一次會是三人行
Dialogue: 0,0:13:54.06,0:13:55.47,Moe - Default - JP,,0,0,0,,これも経験だ
Dialogue: 0,0:13:54.06,0:13:55.47,Moe - Default - CN,,0,0,0,,但這也算是一種經驗
Dialogue: 0,0:13:55.47,0:13:57.74,Moe - Default - JP,,0,0,0,,なるだけお手柔らかに頼む
Dialogue: 0,0:13:55.47,0:13:57.74,Moe - Default - CN,,0,0,0,,還請你們手下留情！
Dialogue: 0,0:13:57.74,0:13:59.66,Moe - Default - JP,,0,0,0,,え　えーーーーー! ?
Dialogue: 0,0:13:57.74,0:13:59.66,Moe - Default - CN,,0,0,0,,啊？？？
Dialogue: 0,0:14:00.83,0:14:04.26,Moe - Default - JP,,0,0,0,,ん? 　さては服の構造に戸惑っているな
Dialogue: 0,0:14:00.83,0:14:04.26,Moe - Default - CN,,0,0,0,,嗯？ 難道是不知道我這身衣服從何下手嗎？
Dialogue: 0,0:14:04.44,0:14:05.53,Moe - Default - JP,,0,0,0,,まずはこのボタンを
Dialogue: 0,0:14:04.44,0:14:05.53,Moe - Default - CN,,0,0,0,,首先解開這枚扣子…
Dialogue: 0,0:14:05.54,0:14:07.22,Moe - Default - JP,,0,0,0,,いやいやいや　ちょっと待て
Dialogue: 0,0:14:05.54,0:14:07.22,Moe - Default - CN,,0,0,0,,不不不 你先停下
Dialogue: 0,0:14:07.22,0:14:08.73,Moe - Default - JP,,0,0,0,,何をしようとしている
Dialogue: 0,0:14:07.22,0:14:08.73,Moe - Default - CN,,0,0,0,,你要做什麼啊！
Dialogue: 0,0:14:09.24,0:14:12.53,Moe - Default - JP,,0,0,0,,牙城を自ら崩してこそ…か？
Dialogue: 0,0:14:09.24,0:14:12.53,Moe - Default - CN,,0,0,0,,要我主動獻身才覺得有趣嗎？
Dialogue: 0,0:14:13.38,0:14:14.98,Moe - Default - JP,,0,0,0,,ふう　顔に似合わず男だな
Dialogue: 0,0:14:13.38,0:14:14.98,Moe - Default - CN,,0,0,0,,看不出來 你還挺狂野的嘛
Dialogue: 0,0:14:14.98,0:14:16.08,Moe - Default - JP,,0,0,0,,何を言ってる
Dialogue: 0,0:14:14.98,0:14:16.08,Moe - Default - CN,,0,0,0,,你在說什麼啊
Dialogue: 0,0:14:16.88,0:14:20.16,Moe - Default - JP,,0,0,0,,坊ちゃんはドレスはご自分で脱がせる派と
Dialogue: 0,0:14:16.88,0:14:20.16,Moe - Default - CN,,0,0,0,,少爺原來是讓女方自己寬衣的那類人
Dialogue: 0,0:14:20.17,0:14:21.97,Moe - Default - JP,,0,0,0,,お前も何を言ってるんだ!
Dialogue: 0,0:14:20.17,0:14:21.97,Moe - Default - CN,,0,0,0,,你也是 到底在說什麼虎狼之詞啊！
Dialogue: 0,0:14:21.97,0:14:24.37,Moe - Default - JP,,0,0,0,,さてはお前服は着せたまま派か
Dialogue: 0,0:14:21.97,0:14:24.37,Moe - Default - CN,,0,0,0,,難不成你更好穿著衣服那口？
Dialogue: 0,0:14:24.37,0:14:27.87,Moe - Default - JP,,0,0,0,,あは　坊ちゃんそのご年齢でなかなか
Dialogue: 0,0:14:24.37,0:14:27.87,Moe - Default - CN,,0,0,0,,啊哈 少爺您小小年紀就有不得了的品味啊
Dialogue: 0,0:14:27.87,0:14:29.31,Moe - Default - JP,,0,0,0,,言葉はわからんが
Dialogue: 0,0:14:27.87,0:14:29.31,Moe - Default - CN,,0,0,0,,雖然我聽不懂你們在說什麼
Dialogue: 0,0:14:29.31,0:14:31.76,Moe - Default - JP,,0,0,0,,何か勘違いしていることだけはわかるぞ
Dialogue: 0,0:14:29.31,0:14:31.76,Moe - Default - CN,,0,0,0,,但可以肯定的是 你們是誤會什麼了吧
Dialogue: 0,0:14:32.93,0:14:33.96,Moe - Default - JP,,0,0,0,,まさかお前
Dialogue: 0,0:14:32.93,0:14:33.96,Moe - Default - CN,,0,0,0,,難不成你…
Dialogue: 0,0:14:39.10,0:14:41.28,Moe - Default - JP,,0,0,0,,なんだ　一応ちゃんと男
Dialogue: 0,0:14:39.10,0:14:41.28,Moe - Default - CN,,0,0,0,,什麼呀 姑且還算是個男的嘛
Dialogue: 0,0:14:42.44,0:14:45.24,Moe - Default - JP,,0,0,0,,ふざけるなー!
Dialogue: 0,0:14:42.44,0:14:45.24,Moe - Default - CN,,0,0,0,,別開玩笑了啊！
Dialogue: 0,0:14:50.78,0:14:53.66,Moe - Default - JP,,0,0,0,,さ…サリヴァンさん\n大丈夫ですか?
Dialogue: 0,0:14:50.78,0:14:53.66,Moe - Default - CN,,0,0,0,,沙…沙利文大人 您還好嗎？
Dialogue: 0,0:14:57.54,0:15:00.69,Moe - Default - JP,,0,0,0,,うら若き乙女に恥をかかせるとは　なんと不粋な奴！
Dialogue: 0,0:14:57.54,0:15:00.69,Moe - Default - CN,,0,0,0,,竟讓年輕女孩如此蒙羞 你這個粗魯的傢伙！
Dialogue: 0,0:15:00.69,0:15:01.40,Moe - Default - JP,,0,0,0,,はあ?
Dialogue: 0,0:15:00.69,0:15:01.40,Moe - Default - CN,,0,0,0,,哈？
Dialogue: 0,0:15:01.40,0:15:03.78,Moe - Default - JP,,0,0,0,,だから何言ってるか分からん　この痴女!
Dialogue: 0,0:15:01.40,0:15:03.78,Moe - Default - CN,,0,0,0,,所以我根本聽不明白你在說什麼啊 你這個好色女！
Dialogue: 0,0:15:04.84,0:15:06.54,Moe - Default - JP,,0,0,0,,まあまあ　お二人かも
Dialogue: 0,0:15:04.84,0:15:06.54,Moe - Default - CN,,0,0,0,,好了好了 兩位都…
Dialogue: 0,0:15:08.96,0:15:12.16,Moe - Default - JP,,0,0,0,,ベッドでの甘いひとときも　悪くありませんが
Dialogue: 0,0:15:08.96,0:15:12.16,Moe - Default - CN,,0,0,0,,雖然在床上度過一段甜蜜時光也是個不錯的選擇
Dialogue: 0,0:15:12.85,0:15:16.20,Moe - Default - JP,,0,0,0,,まずは　こちらの甘いひとときはいかがです
Dialogue: 0,0:15:12.85,0:15:16.20,Moe - Default - CN,,0,0,0,,但先享用一下這邊的甜蜜時光如何？ （0：15：14屏幕字 – 今晚的點心 焦糖馬卡龍 咖啡奶油閃電泡芙 佛羅倫薩黑巧餅乾
Dialogue: 0,0:15:21.20,0:15:24.26,Moe - Default - JP,,0,0,0,,男は常に肉欲を持ち余している…と
Dialogue: 0,0:15:21.20,0:15:24.26,Moe - Default - CN,,0,0,0,,男性總是有著過剩的性慾
Dialogue: 0,0:15:25.15,0:15:27.64,Moe - Default - JP,,0,0,0,,文献には書いてあったのだが
Dialogue: 0,0:15:25.15,0:15:27.64,Moe - Default - CN,,0,0,0,,文獻上是這麼寫的啊
Dialogue: 0,0:15:28.70,0:15:29.57,Moe - Default - JP,,0,0,0,,ま…まあ
Dialogue: 0,0:15:28.70,0:15:29.57,Moe - Default - CN,,0,0,0,,這…這個嘛
Dialogue: 0,0:15:29.91,0:15:32.38,Moe - Default - JP,,0,0,0,,中にはそういう方もいらっしゃいますが
Dialogue: 0,0:15:29.91,0:15:32.38,Moe - Default - CN,,0,0,0,,雖然也確實存在這樣的男性
Dialogue: 0,0:15:32.38,0:15:35.16,Moe - Default - JP,,0,0,0,,ボォルフスシュルトには女しかいない
Dialogue: 0,0:15:32.38,0:15:35.16,Moe - Default - CN,,0,0,0,,畢竟狼谷裡只有女人
Dialogue: 0,0:15:35.16,0:15:37.46,Moe - Default - JP,,0,0,0,,実物を見るのは初めてでな
Dialogue: 0,0:15:35.16,0:15:37.46,Moe - Default - CN,,0,0,0,,我還是第一次看到真的男人
Dialogue: 0,0:15:37.92,0:15:39.86,Moe - Default - JP,,0,0,0,,ヴォルフラムさんが男性では?
Dialogue: 0,0:15:37.92,0:15:39.86,Moe - Default - CN,,0,0,0,,渥魯夫拉姆先生不也是男性嗎？
Dialogue: 0,0:15:41.52,0:15:43.92,Moe - Default - JP,,0,0,0,,あれは番犬みたいなものだ
Dialogue: 0,0:15:41.52,0:15:43.92,Moe - Default - CN,,0,0,0,,那傢伙更接近於看門犬吧
Dialogue: 0,0:15:43.92,0:15:44.68,Moe - Default - JP,,0,0,0,,はあ
Dialogue: 0,0:15:43.92,0:15:44.68,Moe - Default - CN,,0,0,0,,是這樣嗎
Dialogue: 0,0:15:45.88,0:15:47.21,Moe - Default - JP,,0,0,0,,番犬といえば
Dialogue: 0,0:15:45.88,0:15:47.21,Moe - Default - CN,,0,0,0,,說到看門犬
Dialogue: 0,0:15:47.51,0:15:50.49,Moe - Default - JP,,0,0,0,,この村の皆さんは　人狼様という存在に
Dialogue: 0,0:15:47.51,0:15:50.49,Moe - Default - CN,,0,0,0,,這個村子裡的人
Dialogue: 0,0:15:50.49,0:15:52.32,Moe - Default - JP,,0,0,0,,とても怯えておいでだ
Dialogue: 0,0:15:50.49,0:15:52.32,Moe - Default - CN,,0,0,0,,似乎都十分懼怕著這位狼人大人的存在
Dialogue: 0,0:15:52.86,0:15:55.72,Moe - Default - JP,,0,0,0,,人狼様とは一体　何なのですか?
Dialogue: 0,0:15:52.86,0:15:55.72,Moe - Default - CN,,0,0,0,,所謂的狼人大人 究竟為何物？
Dialogue: 0,0:15:58.64,0:16:00.69,Moe - Default - JP,,0,0,0,,魔女狩りを知っているか?
Dialogue: 0,0:15:58.64,0:16:00.69,Moe - Default - CN,,0,0,0,,你們聽過狩獵魔女嗎？
Dialogue: 0,0:16:00.69,0:16:01.65,Moe - Default - JP,,0,0,0,,はい
Dialogue: 0,0:16:00.69,0:16:01.65,Moe - Default - CN,,0,0,0,,當然
Dialogue: 0,0:16:02.62,0:16:06.76,Moe - Default - JP,,0,0,0,,昔　魔女は様々な厄災の原因とされ
Dialogue: 0,0:16:02.62,0:16:06.76,Moe - Default - CN,,0,0,0,,過去 魔女被視作是種種災厄的根源
Dialogue: 0,0:16:06.76,0:16:10.79,Moe - Default - JP,,0,0,0,,魔女裁判という名の拷問にかけられ殺された
Dialogue: 0,0:16:06.76,0:16:10.79,Moe - Default - CN,,0,0,0,,以“魔女審判”之名被拷問 並慘遭殺害
Dialogue: 0,0:16:10.79,0:16:14.29,Moe - Default - JP,,0,0,0,,広場にあった拷問具はその当時のものだ
Dialogue: 0,0:16:10.79,0:16:14.29,Moe - Default - CN,,0,0,0,,廣場上的刑具就是那個時期的東西
Dialogue: 0,0:16:15.64,0:16:17.72,Moe - Default - JP,,0,0,0,,魔術で厄災を退け
Dialogue: 0,0:16:15.64,0:16:17.72,Moe - Default - CN,,0,0,0,,用魔法驅除災厄
Dialogue: 0,0:16:18.02,0:16:20.04,Moe - Default - JP,,0,0,0,,薬草で人を助ける
Dialogue: 0,0:16:18.02,0:16:20.04,Moe - Default - CN,,0,0,0,,用草藥救死扶傷
Dialogue: 0,0:16:20.04,0:16:22.21,Moe - Default - JP,,0,0,0,,それが本来の魔女
Dialogue: 0,0:16:20.04,0:16:22.21,Moe - Default - CN,,0,0,0,,這才是魔女原本的面貌
Dialogue: 0,0:16:22.78,0:16:23.52,Moe - Default - JP,,0,0,0,,だが
Dialogue: 0,0:16:22.78,0:16:23.52,Moe - Default - CN,,0,0,0,,然而
Dialogue: 0,0:16:23.81,0:16:28.30,Moe - Default - JP,,0,0,0,,時代と共に異端とされた魔女たちは人間に追われ…
Dialogue: 0,0:16:23.81,0:16:28.30,Moe - Default - CN,,0,0,0,,隨著時代的更替 被當作異端的魔女們受到人類的驅趕
Dialogue: 0,0:16:28.30,0:16:31.50,Moe - Default - JP,,0,0,0,,命辛々この森に逃げ込んだ
Dialogue: 0,0:16:28.30,0:16:31.50,Moe - Default - CN,,0,0,0,,九死一生才逃進了這片森林
Dialogue: 0,0:16:32.94,0:16:33.99,Moe - Default - JP,,0,0,0,,その時
Dialogue: 0,0:16:32.94,0:16:33.99,Moe - Default - CN,,0,0,0,,那時
Dialogue: 0,0:16:34.21,0:16:37.36,Moe - Default - JP,,0,0,0,,一人の魔女が仲間を守るため
Dialogue: 0,0:16:34.21,0:16:37.36,Moe - Default - CN,,0,0,0,,傳聞曾有一位魔女為了保護同伴
Dialogue: 0,0:16:37.36,0:16:39.54,Moe - Default - JP,,0,0,0,,自分の足を供物に捧げ
Dialogue: 0,0:16:37.36,0:16:39.54,Moe - Default - CN,,0,0,0,,將自己的雙腿作為供品奉上
Dialogue: 0,0:16:39.78,0:16:42.90,Moe - Default - JP,,0,0,0,,人狼と契約を交わしたという
Dialogue: 0,0:16:39.78,0:16:42.90,Moe - Default - CN,,0,0,0,,與狼人締下了契約
Dialogue: 0,0:16:45.38,0:16:49.76,Moe - Default - JP,,0,0,0,,それが　緑の魔女と呼ばれる僕の祖先
Dialogue: 0,0:16:45.38,0:16:49.76,Moe - Default - CN,,0,0,0,,那就是被稱為綠之魔女的 我的祖先
Dialogue: 0,0:16:53.14,0:16:54.35,Moe - Default - JP,,0,0,0,,だから領主は
Dialogue: 0,0:16:53.14,0:16:54.35,Moe - Default - CN,,0,0,0,,也正因如此
Dialogue: 0,0:16:54.58,0:16:57.49,Moe - Default - JP,,0,0,0,,代々こうして歩けないようにする決まりなのだ
Dialogue: 0,0:16:54.58,0:16:57.49,Moe - Default - CN,,0,0,0,,這裡的每一代領主都要遵循代代相傳的規矩 變得不能行走
Dialogue: 0,0:16:58.55,0:17:01.43,Moe - Default - JP,,0,0,0,,ならば　なぜ人狼は村人を襲った
Dialogue: 0,0:16:58.55,0:17:01.43,Moe - Default - CN,,0,0,0,,如果是這樣的話 狼人為何會襲擊村民
Dialogue: 0,0:17:01.78,0:17:03.36,Moe - Default - JP,,0,0,0,,契約違反じゃないか
Dialogue: 0,0:17:01.78,0:17:03.36,Moe - Default - CN,,0,0,0,,這不是違背了契約嗎
Dialogue: 0,0:17:04.30,0:17:08.59,Moe - Default - JP,,0,0,0,,人狼と緑の魔女が契約を交わしたのは何百年も前
Dialogue: 0,0:17:04.30,0:17:08.59,Moe - Default - CN,,0,0,0,,狼人和綠之魔女締下契約 早已是數百年前的事了
Dialogue: 0,0:17:09.68,0:17:12.58,Moe - Default - JP,,0,0,0,,とっくに初代の緑の魔女は死んだ
Dialogue: 0,0:17:09.68,0:17:12.58,Moe - Default - CN,,0,0,0,,而且最初的那位綠之魔女早已辭世
Dialogue: 0,0:17:13.02,0:17:16.18,Moe - Default - JP,,0,0,0,,魔女の血が薄れたことが原因だろう
Dialogue: 0,0:17:13.02,0:17:16.18,Moe - Default - CN,,0,0,0,,或許是因為魔女的血脈變得稀薄 才導致的這一切吧
Dialogue: 0,0:17:17.84,0:17:19.06,Moe - Default - JP,,0,0,0,,つまり
Dialogue: 0,0:17:17.84,0:17:19.06,Moe - Default - CN,,0,0,0,,也就是說
Dialogue: 0,0:17:19.48,0:17:23.10,Moe - Default - JP,,0,0,0,,この村はもはや人狼に守られているのではなく
Dialogue: 0,0:17:19.48,0:17:23.10,Moe - Default - CN,,0,0,0,,這個村子已不再受狼人保護
Dialogue: 0,0:17:23.10,0:17:25.18,Moe - Default - JP,,0,0,0,,囚われている…と
Dialogue: 0,0:17:23.10,0:17:25.18,Moe - Default - CN,,0,0,0,,而是被其囚禁著
Dialogue: 0,0:17:27.60,0:17:29.50,Moe - Default - JP,,0,0,0,,そうかもしれないな
Dialogue: 0,0:17:27.60,0:17:29.50,Moe - Default - CN,,0,0,0,,或許是吧
Dialogue: 0,0:17:30.60,0:17:31.53,Moe - Default - JP,,0,0,0,,それ故
Dialogue: 0,0:17:30.60,0:17:31.53,Moe - Default - CN,,0,0,0,,因為這個原因
Dialogue: 0,0:17:31.73,0:17:35.22,Moe - Default - JP,,0,0,0,,僕は生まれた時から　この村を出たことがないし
Dialogue: 0,0:17:31.73,0:17:35.22,Moe - Default - CN,,0,0,0,,我自出生起就沒有離開過這個村子
Dialogue: 0,0:17:35.22,0:17:37.67,Moe - Default - JP,,0,0,0,,これから先も出ることはないと思う
Dialogue: 0,0:17:35.22,0:17:37.67,Moe - Default - CN,,0,0,0,,大概今後也不會離開吧
Dialogue: 0,0:17:38.70,0:17:41.66,Moe - Default - JP,,0,0,0,,お前たちは　明日　帰ってしまうのだろ?
Dialogue: 0,0:17:38.70,0:17:41.66,Moe - Default - CN,,0,0,0,,你們明天就要走了吧？
Dialogue: 0,0:17:42.16,0:17:42.86,Moe - Default - JP,,0,0,0,,だから
Dialogue: 0,0:17:42.16,0:17:42.86,Moe - Default - CN,,0,0,0,,所以
Dialogue: 0,0:17:43.44,0:17:44.63,Moe - Default - JP,,0,0,0,,僕の知らない
Dialogue: 0,0:17:43.44,0:17:44.63,Moe - Default - CN,,0,0,0,,我想聽你們說說
Dialogue: 0,0:17:44.84,0:17:47.88,Moe - Default - JP,,0,0,0,,外の世界の話を　聞かせてほしいのだ
Dialogue: 0,0:17:44.84,0:17:47.88,Moe - Default - CN,,0,0,0,,我所不知道的 外面世界的故事
Dialogue: 0,0:17:48.80,0:17:50.34,Moe - Default - JP,,0,0,0,,先ほどの行動は
Dialogue: 0,0:17:48.80,0:17:50.34,Moe - Default - CN,,0,0,0,,那麼方才的行為
Dialogue: 0,0:17:50.55,0:17:54.02,Moe - Default - JP,,0,0,0,,我々と親しくなりたい一心でのことだったのですね
Dialogue: 0,0:17:50.55,0:17:54.02,Moe - Default - CN,,0,0,0,,是因為一心想和我們套近乎啊
Dialogue: 0,0:17:55.72,0:17:58.36,Moe - Default - JP,,0,0,0,,彼女はこの村の絶対的存在
Dialogue: 0,0:17:55.72,0:17:58.36,Moe - Default - CN,,0,0,0,,她是這個村子裡至高無上的存在
Dialogue: 0,0:17:58.68,0:18:02.05,Moe - Default - JP,,0,0,0,,調査のためにも　仲良くされるのが得策では
Dialogue: 0,0:17:58.68,0:18:02.05,Moe - Default - CN,,0,0,0,,就算是為了調查 此時與她搞好關係才是上策吧
Dialogue: 0,0:18:03.90,0:18:06.10,Moe - Default - JP,,0,0,0,,ああもう　わかった
Dialogue: 0,0:18:03.90,0:18:06.10,Moe - Default - CN,,0,0,0,,啊啊真是的 我做就行了
Dialogue: 0,0:18:17.68,0:18:22.08,Moe - Default - JP,,0,0,0,,坊ちゃんの国では親しくしたい相手と手を握り合うのです
Dialogue: 0,0:18:17.68,0:18:22.08,Moe - Default - CN,,0,0,0,,少爺的國家裡有這樣的習俗——會與想變親近的人握手
Dialogue: 0,0:18:22.08,0:18:23.18,Moe - Default - JP,,0,0,0,,こうやって
Dialogue: 0,0:18:22.08,0:18:23.18,Moe - Default - CN,,0,0,0,,就像這樣
Dialogue: 0,0:18:26.44,0:18:29.72,Moe - Default - JP,,0,0,0,,あ　そうだ　お前らにこれをやろう
Dialogue: 0,0:18:26.44,0:18:29.72,Moe - Default - CN,,0,0,0,,啊 對了 這個給你們
Dialogue: 0,0:18:31.12,0:18:32.86,Moe - Default - JP,,0,0,0,,人狼除けのゴフだ
Dialogue: 0,0:18:31.12,0:18:32.86,Moe - Default - CN,,0,0,0,,這是用來驅逐狼人的護身符
Dialogue: 0,0:18:32.86,0:18:35.94,Moe - Default - JP,,0,0,0,,帰り道につけていけ　特別だぞ
Dialogue: 0,0:18:32.86,0:18:35.94,Moe - Default - CN,,0,0,0,,回去的路上帶著它吧 這可是我的特別關照
Dialogue: 0,0:18:35.94,0:18:36.89,Moe - Default - JP,,0,0,0,,ありがとう
Dialogue: 0,0:18:35.94,0:18:36.89,Moe - Default - CN,,0,0,0,,謝謝
Dialogue: 0,0:18:37.54,0:18:38.72,Moe - Default - JP,,0,0,0,,さ　さあ!
Dialogue: 0,0:18:37.54,0:18:38.72,Moe - Default - CN,,0,0,0,,好 好了
Dialogue: 0,0:18:39.16,0:18:40.10,Moe - Default - JP,,0,0,0,,では早速
Dialogue: 0,0:18:39.16,0:18:40.10,Moe - Default - CN,,0,0,0,,那麼就快點
Dialogue: 0,0:18:40.22,0:18:43.80,Moe - Default - JP,,0,0,0,,お前の言うベッドでの甘い時間とやらを教えてもらおうか
Dialogue: 0,0:18:40.22,0:18:43.80,Moe - Default - CN,,0,0,0,,告訴我你剛才說的床上的甜蜜時光是什麼吧
Dialogue: 0,0:18:45.20,0:18:47.77,Moe - Default - JP,,0,0,0,,ああ　そんなことも申しましたね
Dialogue: 0,0:18:45.20,0:18:47.77,Moe - Default - CN,,0,0,0,,哎呀 鄙人似乎是說過那樣的話呢
Dialogue: 0,0:18:48.20,0:18:50.44,Moe - Default - JP,,0,0,0,,どういたしましょう　坊ちゃん?
Dialogue: 0,0:18:48.20,0:18:50.44,Moe - Default - CN,,0,0,0,,該如何是好呢 少爺？
Dialogue: 0,0:18:51.01,0:18:53.74,Moe - Default - JP,,0,0,0,,子供相手にどうもこうもあるか
Dialogue: 0,0:18:51.01,0:18:53.74,Moe - Default - CN,,0,0,0,,對著小孩子 隨便應付下得了
Dialogue: 0,0:18:54.03,0:18:55.98,Moe - Default - JP,,0,0,0,,玩具でも遊んでやれ
Dialogue: 0,0:18:54.03,0:18:55.98,Moe - Default - CN,,0,0,0,,拿點玩具陪她玩就行了
Dialogue: 0,0:18:56.36,0:18:58.70,Moe - Default - JP,,0,0,0,,坊ちゃんは玩具で遊びたいそうです
Dialogue: 0,0:18:56.36,0:18:58.70,Moe - Default - CN,,0,0,0,,我家少爺似乎是想用一些玩具
Dialogue: 0,0:18:58.70,0:18:59.59,Moe - Default - JP,,0,0,0,,なにっ!
Dialogue: 0,0:18:58.70,0:18:59.59,Moe - Default - CN,,0,0,0,,什麼！
Dialogue: 0,0:18:59.87,0:19:01.57,Moe - Default - JP,,0,0,0,,最初からハードだな
Dialogue: 0,0:18:59.87,0:19:01.57,Moe - Default - CN,,0,0,0,,一開始就上困難模式啊
Dialogue: 0,0:19:01.60,0:19:02.91,Moe - Default - JP,,0,0,0,,なんだ　その反応
Dialogue: 0,0:19:01.60,0:19:02.91,Moe - Default - CN,,0,0,0,,那是什麼反應啊
Dialogue: 0,0:19:03.16,0:19:05.67,Moe - Default - JP,,0,0,0,,絶対なんか勘違いしてるだろ
Dialogue: 0,0:19:03.16,0:19:05.67,Moe - Default - CN,,0,0,0,,她絕對搞錯什麼了吧
Dialogue: 0,0:19:15.13,0:19:17.66,Moe - Default - JP,,0,0,0,,や…やっと寝た
Dialogue: 0,0:19:15.13,0:19:17.66,Moe - Default - CN,,0,0,0,,總…總算是睡了
Dialogue: 0,0:19:17.66,0:19:19.16,Moe - Default - JP,,0,0,0,,お疲れさまです
Dialogue: 0,0:19:17.66,0:19:19.16,Moe - Default - CN,,0,0,0,,您辛苦了
Dialogue: 0,0:19:19.65,0:19:23.32,Moe - Default - JP,,0,0,0,,結構単語だけでも会話できるものだな
Dialogue: 0,0:19:19.65,0:19:23.32,Moe - Default - CN,,0,0,0,,雖然只能蹦單詞 但交流還挺順暢
Dialogue: 0,0:19:23.32,0:19:25.33,Moe - Default - JP,,0,0,0,,馬車を買ったやつに比べると
Dialogue: 0,0:19:23.32,0:19:25.33,Moe - Default - CN,,0,0,0,,和那個賣我們馬車的傢伙比起來
Dialogue: 0,0:19:25.41,0:19:26.94,Moe - Default - JP,,0,0,0,,なぜか聞き取りやすいし
Dialogue: 0,0:19:25.41,0:19:26.94,Moe - Default - CN,,0,0,0,,感覺她說的話更容易聽懂
Dialogue: 0,0:19:27.68,0:19:28.98,Moe - Default - JP,,0,0,0,,でしょうね
Dialogue: 0,0:19:27.68,0:19:28.98,Moe - Default - CN,,0,0,0,,的確如此
Dialogue: 0,0:19:33.54,0:19:35.58,Moe - Default - JP,,0,0,0,,お嬢が邪魔したみてえだな
Dialogue: 0,0:19:33.54,0:19:35.58,Moe - Default - CN,,0,0,0,,我家小姐好像打擾二位了
Dialogue: 0,0:19:36.68,0:19:38.86,Moe - Default - JP,,0,0,0,,ちょうど　お休みになったところです
Dialogue: 0,0:19:36.68,0:19:38.86,Moe - Default - CN,,0,0,0,,你來得正好 她剛剛歇下
Dialogue: 0,0:19:50.74,0:19:52.84,Moe - Default - JP,,0,0,0,,お嬢から聞いた話は忘れろ
Dialogue: 0,0:19:50.74,0:19:52.84,Moe - Default - CN,,0,0,0,,請忘了從小姐這裡聽到的話
Dialogue: 0,0:19:53.70,0:19:55.40,Moe - Default - JP,,0,0,0,,夜が明けたらすぐ出立する
Dialogue: 0,0:19:53.70,0:19:55.40,Moe - Default - CN,,0,0,0,,請你們天一亮就立刻離開
Dialogue: 0,0:19:56.80,0:19:57.56,Moe - Default - JP,,0,0,0,,いいな
Dialogue: 0,0:19:56.80,0:19:57.56,Moe - Default - CN,,0,0,0,,好嗎
Dialogue: 0,0:20:13.10,0:20:14.66,Moe - Default - JP,,0,0,0,,すごい霧だ
Dialogue: 0,0:20:13.10,0:20:14.66,Moe - Default - CN,,0,0,0,,好濃的霧
Dialogue: 0,0:20:14.66,0:20:16.44,Moe - Default - JP,,0,0,0,,足元にお気をつけて
Dialogue: 0,0:20:14.66,0:20:16.44,Moe - Default - CN,,0,0,0,,請小心腳下
Dialogue: 0,0:20:19.59,0:20:20.83,Moe - Default - JP,,0,0,0,,静かすぎる
Dialogue: 0,0:20:19.59,0:20:20.83,Moe - Default - CN,,0,0,0,,有些太安靜了
Dialogue: 0,0:20:21.26,0:20:23.12,Moe - Default - JP,,0,0,0,,生物の気配が全くない
Dialogue: 0,0:20:21.26,0:20:23.12,Moe - Default - CN,,0,0,0,,完全感受不到活物的氣息
Dialogue: 0,0:20:23.66,0:20:27.08,Moe - Default - JP,,0,0,0,,それに　感じたことのない重い空気
Dialogue: 0,0:20:23.66,0:20:27.08,Moe - Default - CN,,0,0,0,,而且 還有種未曾感受過的沉重氛圍
Dialogue: 0,0:20:27.90,0:20:29.60,Moe - Default - JP,,0,0,0,,坊ちゃん　私のそばを
Dialogue: 0,0:20:27.90,0:20:29.60,Moe - Default - CN,,0,0,0,,少爺 請不要從我身旁…
Dialogue: 0,0:20:31.07,0:20:32.00,Moe - Default - JP,,0,0,0,,坊ちゃん！？
Dialogue: 0,0:20:31.07,0:20:32.00,Moe - Default - CN,,0,0,0,,少爺！？
Dialogue: 0,0:20:34.88,0:20:36.07,Moe - Default - JP,,0,0,0,,なんだ　これは
Dialogue: 0,0:20:34.88,0:20:36.07,Moe - Default - CN,,0,0,0,,這是怎麼回事
Dialogue: 0,0:20:36.07,0:20:37.84,Moe - Default - JP,,0,0,0,,一体　どうなさったのです?
Dialogue: 0,0:20:36.07,0:20:37.84,Moe - Default - CN,,0,0,0,,究竟是怎麼了？
Dialogue: 0,0:20:37.84,0:20:39.84,Moe - Default - JP,,0,0,0,,ああ　そんなに擦っては
Dialogue: 0,0:20:37.84,0:20:39.84,Moe - Default - CN,,0,0,0,,啊 您不要這麼用力揉
Dialogue: 0,0:20:40.72,0:20:43.52,Moe - Default - JP,,0,0,0,,分からん　勝手に出てくるんだ
Dialogue: 0,0:20:40.72,0:20:43.52,Moe - Default - CN,,0,0,0,,鬼知道 這眼淚根本不受我控制
Dialogue: 0,0:20:43.52,0:20:44.34,Moe - Default - JP,,0,0,0,,くそっ
Dialogue: 0,0:20:43.52,0:20:44.34,Moe - Default - CN,,0,0,0,,可惡
Dialogue: 0,0:20:48.14,0:20:49.48,Moe - Default - JP,,0,0,0,,じ…人狼？
Dialogue: 0,0:20:48.14,0:20:49.48,Moe - Default - CN,,0,0,0,,狼…狼人？
Dialogue: 0,0:20:51.37,0:20:52.60,Moe - Default - JP,,0,0,0,,追うぞ　セバスチャン！
Dialogue: 0,0:20:51.37,0:20:52.60,Moe - Default - CN,,0,0,0,,我們追上去 塞巴斯蒂安！
Dialogue: 0,0:20:52.60,0:20:53.73,Moe - Default - JP,,0,0,0,,お待ちください
Dialogue: 0,0:20:52.60,0:20:53.73,Moe - Default - CN,,0,0,0,,請等一下
Dialogue: 0,0:20:54.27,0:20:56.32,Moe - Default - JP,,0,0,0,,この森は何かがおかしい
Dialogue: 0,0:20:54.27,0:20:56.32,Moe - Default - CN,,0,0,0,,這片森林有什麼不對勁
Dialogue: 0,0:20:56.32,0:20:58.38,Moe - Default - JP,,0,0,0,,嫌な予感がするのです
Dialogue: 0,0:20:56.32,0:20:58.38,Moe - Default - CN,,0,0,0,,我有種不好的預感
Dialogue: 0,0:20:58.72,0:21:00.48,Moe - Default - JP,,0,0,0,,人狼は私が追います
Dialogue: 0,0:20:58.72,0:21:00.48,Moe - Default - CN,,0,0,0,,狼人那邊由我來負責
Dialogue: 0,0:21:00.48,0:21:02.74,Moe - Default - JP,,0,0,0,,坊ちゃんは　お部屋でお待ちください
Dialogue: 0,0:21:00.48,0:21:02.74,Moe - Default - CN,,0,0,0,,少爺您還是先回房間等待
Dialogue: 0,0:21:06.39,0:21:07.24,Moe - Default - JP,,0,0,0,,わかった
Dialogue: 0,0:21:06.39,0:21:07.24,Moe - Default - CN,,0,0,0,,我知道了
Dialogue: 0,0:21:15.50,0:21:18.42,Moe - Default - JP,,0,0,0,,私も長いこと人間界にいますが
Dialogue: 0,0:21:15.50,0:21:18.42,Moe - Default - CN,,0,0,0,,雖然我已在人類社會逗留頗久
Dialogue: 0,0:21:18.42,0:21:20.78,Moe - Default - JP,,0,0,0,,こんな瘴気は感じたことがない
Dialogue: 0,0:21:18.42,0:21:20.78,Moe - Default - CN,,0,0,0,,但還從沒感受過這樣的氣息
Dialogue: 0,0:21:22.26,0:21:23.34,Moe - Default - JP,,0,0,0,,これは一体
Dialogue: 0,0:21:22.26,0:21:23.34,Moe - Default - CN,,0,0,0,,這究竟是…
Dialogue: 0,0:21:29.75,0:21:30.52,Moe - Default - JP,,0,0,0,,え？
Dialogue: 0,0:21:29.75,0:21:30.52,Moe - Default - CN,,0,0,0,,什麼？

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:01.88,0:01:05.78,Layzner,,0,0,0,,如果这样下去说不定能知道雷兹纳的秘密
Dialogue: 0,0:01:05.78,0:01:08.56,Layzner,,0,0,0,,无法战斗 请逃离
Dialogue: 0,0:01:09.19,0:01:10.19,Layzner,,0,0,0,,让我看看吧
Dialogue: 0,0:01:48.20,0:01:48.74,Layzner,,0,0,0,,来吧
Dialogue: 0,0:01:51.07,0:01:51.74,Layzner,,0,0,0,,我想起来了
Dialogue: 0,0:01:51.99,0:01:52.36,Layzner,,0,0,0,,不
Dialogue: 0,0:01:53.51,0:01:56.41,Layzner,,0,0,0,,我是说那时候的事
Dialogue: 0,0:01:56.95,0:01:59.23,Layzner,,0,0,0,,这时候不要说以前的事
Dialogue: 0,0:02:11.54,0:02:13.09,Layzner,,0,0,0,,大家快逃
Dialogue: 0,0:02:24.01,0:02:27.31,Layzner,,0,0,0,,来吧 大家坐那航天飞机回地球吧
Dialogue: 0,0:02:31.77,0:02:36.74,Layzner,,0,0,0,,第十八话 接下来去地球
Dialogue: 0,0:02:45.14,0:02:47.84,Layzner,,0,0,0,,在被摧毁的一点都不剩的联合国基地里
Dialogue: 0,0:02:48.51,0:02:55.67,Layzner,,0,0,0,,和好像是伊丽莎白博士的朋友的美军飞行员存活着
Dialogue: 0,0:02:48.51,0:02:55.67,Layzner,,0,0,0,,有八个小孩
Dialogue: 0,0:02:56.99,0:03:01.19,Layzner,,0,0,0,,之前令大家都害怕的无人战斗机器人
Dialogue: 0,0:03:01.19,0:03:03.19,Layzner,,0,0,0,,现在终于不在了
Dialogue: 0,0:03:04.10,0:03:09.48,Layzner,,0,0,0,,可是还要这样战斗到什么时候呢 真令人不安
Dialogue: 0,0:03:20.74,0:03:23.35,Layzner,,0,0,0,,伊丽莎白 你会在这里吗
Dialogue: 0,0:03:23.35,0:03:27.92,Layzner,,0,0,0,,别说了 你快睡吧 现在的你最需要的是睡眠
Dialogue: 0,0:03:35.92,0:03:38.06,Layzner,,0,0,0,,怎么办 要马上出发吗
Dialogue: 0,0:03:38.08,0:03:41.29,Layzner,,0,0,0,,等一下要直接去联合国的宇宙基地
Dialogue: 0,0:03:38.08,0:03:41.29,Layzner,,0,0,0,,不 现在还不能出去
Dialogue: 0,0:03:41.29,0:03:42.94,Layzner,,0,0,0,,联合国的宇宙基地
Dialogue: 0,0:03:42.94,0:03:44.40,Layzner,,0,0,0,,对 巴西的那一个
Dialogue: 0,0:03:44.42,0:03:46.88,Layzner,,0,0,0,,话虽这么说 那为什么不能马上出发呢
Dialogue: 0,0:03:46.88,0:03:48.03,Layzner,,0,0,0,,要计算轨道啊
Dialogue: 0,0:03:48.03,0:03:51.55,Layzner,,0,0,0,,算好出发时间 并以最短的距离到基地
Dialogue: 0,0:03:52.06,0:03:55.68,Layzner,,0,0,0,,可是再这样拖下来 一会那些杀人机器又会回来了
Dialogue: 0,0:03:56.03,0:03:58.10,Layzner,,0,0,0,,还是快逃比较好吧
Dialogue: 0,0:03:58.10,0:04:00.53,Layzner,,0,0,0,,亚瑟 你还想重蹈覆辙是吗
Dialogue: 0,0:04:00.98,0:04:05.05,Layzner,,0,0,0,,如果胡乱出发的话 别人又会不相信我们了
Dialogue: 0,0:04:05.05,0:04:08.07,Layzner,,0,0,0,,而且地球周边还有很多军事卫星
Dialogue: 0,0:04:08.36,0:04:10.32,Layzner,,0,0,0,,我们坐这太空船会被集火攻击的
Dialogue: 0,0:04:10.77,0:04:12.85,Layzner,,0,0,0,,会相信我们的
Dialogue: 0,0:04:12.85,0:04:16.01,Layzner,,0,0,0,,只有博士所在的联合国总部
Dialogue: 0,0:04:17.04,0:04:20.40,Layzner,,0,0,0,,是哦 仔细想想也没错
Dialogue: 0,0:04:20.40,0:04:24.79,Layzner,,0,0,0,,其他军队的家伙都是些死脑筋的人
Dialogue: 0,0:04:24.79,0:04:26.36,Layzner,,0,0,0,,正如西蒙尼所说
Dialogue: 0,0:04:26.36,0:04:29.16,Layzner,,0,0,0,,我叫安娜 你呢
Dialogue: 0,0:04:26.59,0:04:29.16,Layzner,,0,0,0,,对 这样最安全
Dialogue: 0,0:04:30.77,0:04:33.40,Layzner,,0,0,0,,哈迪 你会说自己的名字吧
Dialogue: 0,0:04:33.40,0:04:35.76,Layzner,,0,0,0,,抱歉 我叫兰蒂 他是哈迪
Dialogue: 0,0:04:35.76,0:04:39.58,Layzner,,0,0,0,,他有点害羞
Dialogue: 0,0:04:39.58,0:04:40.74,Layzner,,0,0,0,,我是乔伊
Dialogue: 0,0:04:41.69,0:04:43.59,Layzner,,0,0,0,,这孩子叫梅丽莎
Dialogue: 0,0:04:43.59,0:04:46.79,Layzner,,0,0,0,,还有罗拉和弗洛华 我是芙蕾蒂
Dialogue: 0,0:04:49.04,0:04:50.89,Layzner,,0,0,0,,我是马卡斯
Dialogue: 0,0:04:50.89,0:04:53.73,Layzner,,0,0,0,,我是亚瑟 她是西蒙尼
Dialogue: 0,0:04:54.46,0:04:56.04,Layzner,,0,0,0,,请多指教哦
Dialogue: 0,0:05:06.96,0:05:08.46,Layzner,,0,0,0,,好沉闷的小家伙们
Dialogue: 0,0:05:08.46,0:05:09.45,Layzner,,0,0,0,,算出来了
Dialogue: 0,0:05:10.22,0:05:14.01,Layzner,,0,0,0,,在1小时12分5秒后出发的话
Dialogue: 0,0:05:10.22,0:05:14.01,Layzner,,0,0,0,,以地球时间来算的话
Dialogue: 0,0:05:14.01,0:05:17.19,Layzner,,0,0,0,,可以刚好到该国首都的上空
Dialogue: 0,0:05:17.19,0:05:19.19,Layzner,,0,0,0,,约一小时是吗
Dialogue: 0,0:05:19.19,0:05:22.81,Layzner,,0,0,0,,为了不要搞错出发时间 已把资料输入电脑了
Dialogue: 0,0:05:23.59,0:05:24.45,Layzner,,0,0,0,,请问
Dialogue: 0,0:05:24.45,0:05:25.69,Layzner,,0,0,0,,嗯
Dialogue: 0,0:05:25.69,0:05:27.69,Layzner,,0,0,0,,我们能回地球吗
Dialogue: 0,0:05:27.69,0:05:30.68,Layzner,,0,0,0,,对 再过一小时出发的话就能回地球了
Dialogue: 0,0:05:38.42,0:05:39.99,Layzner,,0,0,0,,什么嘛 大家都会笑嘛
Dialogue: 0,0:05:41.31,0:05:42.60,Layzner,,0,0,0,,目标的坐标位置
Dialogue: 0,0:05:42.60,0:05:44.06,Layzner,,0,0,0,,X-1
Dialogue: 0,0:05:44.06,0:05:47.05,Layzner,,0,0,0,,Y-21, Z-35
Dialogue: 0,0:05:47.05,0:05:48.65,Layzner,,0,0,0,,准备回收监督的船
Dialogue: 0,0:05:49.32,0:05:49.75,Layzner,,0,0,0,,5
Dialogue: 0,0:05:50.18,0:05:50.77,Layzner,,0,0,0,,4
Dialogue: 0,0:05:51.13,0:05:51.67,Layzner,,0,0,0,,3
Dialogue: 0,0:05:52.00,0:05:52.73,Layzner,,0,0,0,,2
Dialogue: 0,0:05:53.03,0:05:53.58,Layzner,,0,0,0,,1
Dialogue: 0,0:05:53.97,0:05:54.50,Layzner,,0,0,0,,0
Dialogue: 0,0:06:11.31,0:06:12.80,Layzner,,0,0,0,,原来如此
Dialogue: 0,0:06:12.80,0:06:15.66,Layzner,,0,0,0,,你就是阿尔巴特洛·玖丽亚·飞鸟吗
Dialogue: 0,0:06:15.66,0:06:16.07,Layzner,,0,0,0,,是
Dialogue: 0,0:06:16.58,0:06:19.06,Layzner,,0,0,0,,你就是那背叛者的姐姐是吗
Dialogue: 0,0:06:19.51,0:06:22.82,Layzner,,0,0,0,,我是被派去说服我弟弟的
Dialogue: 0,0:06:23.42,0:06:24.82,Layzner,,0,0,0,,说服是吗
Dialogue: 0,0:06:25.75,0:06:28.29,Layzner,,0,0,0,,已经不需要说服他了
Dialogue: 0,0:06:28.29,0:06:29.12,Layzner,,0,0,0,,为什么
Dialogue: 0,0:06:29.12,0:06:32.72,Layzner,,0,0,0,,我们的计划有点变化
Dialogue: 0,0:06:32.72,0:06:36.88,Layzner,,0,0,0,,只要能打倒在月球上地球两大强国的基地的话
Dialogue: 0,0:06:32.72,0:06:36.88,Layzner,,0,0,0,,根据我们的新计划
Dialogue: 0,0:06:37.08,0:06:41.67,Layzner,,0,0,0,,就能到达地球并且展开大规模的战争
Dialogue: 0,0:06:41.97,0:06:45.24,Layzner,,0,0,0,,但目前的地球什么事都还没发生
Dialogue: 0,0:06:45.91,0:06:50.10,Layzner,,0,0,0,,我们决定要直接进入地球
Dialogue: 0,0:06:50.10,0:06:51.64,Layzner,,0,0,0,,那英二他
Dialogue: 0,0:06:51.84,0:06:54.03,Layzner,,0,0,0,,你说古拉特斯人呢
Dialogue: 0,0:06:54.13,0:06:55.99,Layzner,,0,0,0,,还是地球人呢
Dialogue: 0,0:06:55.99,0:06:57.92,Layzner,,0,0,0,,我是古拉特斯人
Dialogue: 0,0:07:01.52,0:07:04.90,Layzner,,0,0,0,,跟你的弟弟不同 你能为古拉特斯而死吗
Dialogue: 0,0:07:05.18,0:07:05.86,Layzner,,0,0,0,,是
Dialogue: 0,0:07:05.86,0:07:09.07,Layzner,,0,0,0,,有这种觉悟啊 是因为知道那件事吗
Dialogue: 0,0:07:09.07,0:07:09.96,Layzner,,0,0,0,,那件事
Dialogue: 0,0:07:09.96,0:07:11.49,Layzner,,0,0,0,,就是中尉死掉的事
Dialogue: 0,0:07:11.49,0:07:13.58,Layzner,,0,0,0,,难道是凯利中尉
Dialogue: 0,0:07:13.58,0:07:14.98,Layzner,,0,0,0,,什么 你不知道吗
Dialogue: 0,0:07:15.79,0:07:16.61,Layzner,,0,0,0,,是
Dialogue: 0,0:07:16.95,0:07:19.89,Layzner,,0,0,0,,接下来由我告诉你
Dialogue: 0,0:07:20.11,0:07:21.89,Layzner,,0,0,0,,杀了凯利中尉的
Dialogue: 0,0:07:21.89,0:07:23.64,Layzner,,0,0,0,,是你弟弟
Dialogue: 0,0:07:29.84,0:07:31.08,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:07:31.08,0:07:32.59,Layzner,,0,0,0,,再过一小时出发对吧
Dialogue: 0,0:07:32.59,0:07:33.03,Layzner,,0,0,0,,嗯
Dialogue: 0,0:07:40.30,0:07:41.58,Layzner,,0,0,0,,请问
Dialogue: 0,0:07:42.28,0:07:43.12,Layzner,,0,0,0,,唉
Dialogue: 0,0:07:43.12,0:07:45.27,Layzner,,0,0,0,,你想问这个人的事是吗
Dialogue: 0,0:07:45.27,0:07:49.27,Layzner,,0,0,0,,没错 我们以前有交往过 只是这样的关系而已
Dialogue: 0,0:07:49.57,0:07:50.79,Layzner,,0,0,0,,是你的恋人吗
Dialogue: 0,0:07:51.67,0:07:54.68,Layzner,,0,0,0,,看不出来你还挺精的嘛
Dialogue: 0,0:07:55.01,0:07:57.31,Layzner,,0,0,0,,对不起 我太多事了
Dialogue: 0,0:07:57.31,0:08:00.64,Layzner,,0,0,0,,没关系 如你所说他曾是我的恋人
Dialogue: 0,0:08:01.43,0:08:03.55,Layzner,,0,0,0,,但那已是以前的事了
Dialogue: 0,0:08:21.31,0:08:23.40,Layzner,,0,0,0,,再做一下鬼脸嘛
Dialogue: 0,0:08:23.44,0:08:28.18,Layzner,,0,0,0,,那么那叫古雷特的 就是博士以前的男友咯
Dialogue: 0,0:08:28.18,0:08:30.18,Layzner,,0,0,0,,好像是这样
Dialogue: 0,0:08:30.18,0:08:33.38,Layzner,,0,0,0,,在战场上和受伤的旧情人再见面
Dialogue: 0,0:08:33.38,0:08:35.56,Layzner,,0,0,0,,真浪漫
Dialogue: 0,0:08:35.56,0:08:38.69,Layzner,,0,0,0,,如果我受伤的话 你会照顾我吗
Dialogue: 0,0:08:38.69,0:08:39.64,Layzner,,0,0,0,,好啊
Dialogue: 0,0:08:39.64,0:08:40.67,Layzner,,0,0,0,,真的吗
Dialogue: 0,0:08:40.67,0:08:42.49,Layzner,,0,0,0,,真 的 呦
Dialogue: 0,0:08:48.55,0:08:50.85,Layzner,,0,0,0,,不行 不行 不可以摸那里
Dialogue: 0,0:08:51.69,0:08:53.64,Layzner,,0,0,0,,都说不行了
Dialogue: 0,0:08:55.96,0:08:57.16,Layzner,,0,0,0,,你们
Dialogue: 0,0:08:58.24,0:08:59.76,Layzner,,0,0,0,,好热闹啊
Dialogue: 0,0:08:59.76,0:09:01.57,Layzner,,0,0,0,,他很受小孩子欢迎啊
Dialogue: 0,0:09:06.69,0:09:08.74,Layzner,,0,0,0,,明明这么吵的
Dialogue: 0,0:09:08.74,0:09:10.94,Layzner,,0,0,0,,他太累了 让他睡一下吧
Dialogue: 0,0:09:10.94,0:09:12.65,Layzner,,0,0,0,,接下来 我也
Dialogue: 0,0:09:12.65,0:09:13.49,Layzner,,0,0,0,,要去哪里
Dialogue: 0,0:09:13.49,0:09:15.80,Layzner,,0,0,0,,不受欢迎的男人不要待在这较好
Dialogue: 0,0:09:17.18,0:09:18.65,Layzner,,0,0,0,,发生什么了
Dialogue: 0,0:09:18.65,0:09:19.35,Layzner,,0,0,0,,天知道
Dialogue: 0,0:09:27.90,0:09:28.56,Layzner,,0,0,0,,罗安
Dialogue: 0,0:09:28.56,0:09:30.03,Layzner,,0,0,0,,我来跟你换班了
Dialogue: 0,0:09:30.03,0:09:31.45,Layzner,,0,0,0,,太好了
Dialogue: 0,0:09:31.45,0:09:34.00,Layzner,,0,0,0,,我的生理状态已经到达极限了
Dialogue: 0,0:09:36.21,0:09:37.33,Layzner,,0,0,0,,敌人来了
Dialogue: 0,0:09:37.33,0:09:38.66,Layzner,,0,0,0,,快开枪
Dialogue: 0,0:09:39.40,0:09:39.86,Layzner,,0,0,0,,约翰
Dialogue: 0,0:09:40.04,0:09:41.27,Layzner,,0,0,0,,杰克
Dialogue: 0,0:09:41.27,0:09:43.27,Layzner,,0,0,0,,快逃 大家快逃
Dialogue: 0,0:09:43.27,0:09:45.36,Layzner,,0,0,0,,我的眼睛
Dialogue: 0,0:09:45.36,0:09:46.46,Layzner,,0,0,0,,约翰怎么了
Dialogue: 0,0:09:46.66,0:09:47.51,Layzner,,0,0,0,,你没事吧
Dialogue: 0,0:09:49.79,0:09:51.02,Layzner,,0,0,0,,这是梦吗
Dialogue: 0,0:09:51.56,0:09:53.02,Layzner,,0,0,0,,你发烧烧的好热
Dialogue: 0,0:09:53.02,0:09:55.61,Layzner,,0,0,0,,好奇怪啊
Dialogue: 0,0:09:55.61,0:09:57.61,Layzner,,0,0,0,,醒来反而一片黑暗
Dialogue: 0,0:09:57.90,0:10:00.83,Layzner,,0,0,0,,就算是噩梦 至少在梦中我还看得到
Dialogue: 0,0:10:00.83,0:10:02.12,Layzner,,0,0,0,,伤口不痛吗
Dialogue: 0,0:10:02.12,0:10:03.70,Layzner,,0,0,0,,这是哪里
Dialogue: 0,0:10:03.70,0:10:05.24,Layzner,,0,0,0,,是外星人的航天飞机吗
Dialogue: 0,0:10:05.24,0:10:05.94,Layzner,,0,0,0,,是
Dialogue: 0,0:10:06.11,0:10:07.68,Layzner,,0,0,0,,什么时候能到地球
Dialogue: 0,0:10:07.68,0:10:09.18,Layzner,,0,0,0,,我们现在还在月球
Dialogue: 0,0:10:09.18,0:10:11.27,Layzner,,0,0,0,,还要四十分钟出发
Dialogue: 0,0:10:11.88,0:10:13.04,Layzner,,0,0,0,,让我看一下伤口
Dialogue: 0,0:10:13.04,0:10:14.14,Layzner,,0,0,0,,不用担心
Dialogue: 0,0:10:14.14,0:10:14.82,Layzner,,0,0,0,,我没事
Dialogue: 0,0:10:15.06,0:10:16.16,Layzner,,0,0,0,,不要逞强
Dialogue: 0,0:10:16.16,0:10:19.50,Layzner,,0,0,0,,现在的你需要身为医生的我
Dialogue: 0,0:10:19.50,0:10:20.95,Layzner,,0,0,0,,你好像
Dialogue: 0,0:10:20.95,0:10:24.24,Layzner,,0,0,0,,认为那时候的我不需要你是吗
Dialogue: 0,0:10:25.43,0:10:26.94,Layzner,,0,0,0,,如果你这么想就错了
Dialogue: 0,0:10:26.94,0:10:30.43,Layzner,,0,0,0,,我现在一样需要你
Dialogue: 0,0:10:30.43,0:10:31.70,Layzner,,0,0,0,,但是你
Dialogue: 0,0:10:31.70,0:10:33.70,Layzner,,0,0,0,,却一直躲着我
Dialogue: 0,0:10:33.70,0:10:35.61,Layzner,,0,0,0,,说到这个我也有话要说
Dialogue: 0,0:10:35.61,0:10:36.65,Layzner,,0,0,0,,那时候
Dialogue: 0,0:10:36.65,0:10:38.65,Layzner,,0,0,0,,在我最需要你的时候
Dialogue: 0,0:10:38.65,0:10:40.65,Layzner,,0,0,0,,你也没回来
Dialogue: 0,0:10:40.65,0:10:42.65,Layzner,,0,0,0,,无论你做什么
Dialogue: 0,0:10:42.65,0:10:44.65,Layzner,,0,0,0,,我都希望你回来
Dialogue: 0,0:10:44.65,0:10:46.85,Layzner,,0,0,0,,就算 是电话的声音也好
Dialogue: 0,0:10:46.85,0:10:49.08,Layzner,,0,0,0,,不是才一星期而已吗
Dialogue: 0,0:10:49.08,0:10:51.08,Layzner,,0,0,0,,对那时的我来说太长了
Dialogue: 0,0:10:52.94,0:10:55.99,Layzner,,0,0,0,,别再说了 都结束了
Dialogue: 0,0:10:57.13,0:10:58.69,Layzner,,0,0,0,,有点化脓
Dialogue: 0,0:10:58.69,0:11:02.37,Layzner,,0,0,0,,对啊 刚才有点刺痛
Dialogue: 0,0:11:02.37,0:11:04.00,Layzner,,0,0,0,,你也这能忍
Dialogue: 0,0:11:04.00,0:11:06.08,Layzner,,0,0,0,,我是男子汉啊
Dialogue: 0,0:11:06.08,0:11:09.23,Layzner,,0,0,0,,而且我也有活在黑暗中的觉悟了
Dialogue: 0,0:11:10.47,0:11:14.44,Layzner,,0,0,0,,这样下去会失明的 他需要药
Dialogue: 0,0:11:15.62,0:11:17.49,Layzner,,0,0,0,,资料信息
Dialogue: 0,0:11:17.49,0:11:20.46,Layzner,,0,0,0,,外面有侦测到红外线生命体移动
Dialogue: 0,0:11:20.46,0:11:23.08,Layzner,,0,0,0,,方位 右前方5单位处
Dialogue: 0,0:11:23.08,0:11:25.83,Layzner,,0,0,0,,无带有敌意的行为
Dialogue: 0,0:11:25.83,0:11:27.56,Layzner,,0,0,0,,雷达关闭
Dialogue: 0,0:11:34.78,0:11:37.02,Layzner,,0,0,0,,一起下去嘛
Dialogue: 0,0:11:37.02,0:11:39.02,Layzner,,0,0,0,,下去嘛
Dialogue: 0,0:11:39.02,0:11:40.37,Layzner,,0,0,0,,不行啦
Dialogue: 0,0:11:40.37,0:11:43.45,Layzner,,0,0,0,,男孩子虽然很单纯 但却又很害羞
Dialogue: 0,0:11:43.45,0:11:45.45,Layzner,,0,0,0,,很难说出 喜欢 这个词
Dialogue: 0,0:11:45.45,0:11:50.14,Layzner,,0,0,0,,还会故意恶作剧 故意做出令人讨厌的事
Dialogue: 0,0:11:45.45,0:11:50.14,Layzner,,0,0,0,,所以明明喜欢却装得很讨厌
Dialogue: 0,0:11:50.14,0:11:52.24,Layzner,,0,0,0,,真拿你们没办法
Dialogue: 0,0:11:54.38,0:11:57.44,Layzner,,0,0,0,,都叫你们住手了
Dialogue: 0,0:12:05.93,0:12:07.06,Layzner,,0,0,0,,你醒了么
Dialogue: 0,0:12:07.06,0:12:09.06,Layzner,,0,0,0,,我睡多久了
Dialogue: 0,0:12:09.06,0:12:11.84,Layzner,,0,0,0,,我也睡着了
Dialogue: 0,0:12:11.84,0:12:12.92,Layzner,,0,0,0,,离出发还有多久
Dialogue: 0,0:12:12.92,0:12:14.92,Layzner,,0,0,0,,还有十分钟
Dialogue: 0,0:12:16.98,0:12:19.08,Layzner,,0,0,0,,不好了 博士不见了
Dialogue: 0,0:12:33.33,0:12:36.13,Layzner,,0,0,0,,那么 博士什么都没说就出去了
Dialogue: 0,0:12:36.13,0:12:39.34,Layzner,,0,0,0,,可没想到伊丽莎白她
Dialogue: 0,0:12:39.34,0:12:40.69,Layzner,,0,0,0,,你没事吧
Dialogue: 0,0:12:47.06,0:12:48.10,Layzner,,0,0,0,,博士
Dialogue: 0,0:12:48.10,0:12:49.45,Layzner,,0,0,0,,你在哪里
Dialogue: 0,0:12:49.45,0:12:51.07,Layzner,,0,0,0,,请回答
Dialogue: 0,0:12:51.45,0:12:52.37,Layzner,,0,0,0,,博士
Dialogue: 0,0:12:52.37,0:12:54.69,Layzner,,0,0,0,,罗安 是我 不用担心
Dialogue: 0,0:12:54.69,0:12:56.86,Layzner,,0,0,0,,博士 你在哪里
Dialogue: 0,0:12:56.86,0:12:59.71,Layzner,,0,0,0,,我现在在地下的医疗中心的前面
Dialogue: 0,0:12:59.71,0:13:01.71,Layzner,,0,0,0,,在医疗中心
Dialogue: 0,0:13:01.71,0:13:03.86,Layzner,,0,0,0,,对
Dialogue: 0,0:13:03.86,0:13:06.27,Layzner,,0,0,0,,我拿了药就回去 别担心
Dialogue: 0,0:13:06.27,0:13:08.27,Layzner,,0,0,0,,叫我们别担心
Dialogue: 0,0:13:08.27,0:13:10.13,Layzner,,0,0,0,,可是十分钟后就要出发了
Dialogue: 0,0:13:10.93,0:13:13.46,Layzner,,0,0,0,,这附近好像没有那无人杀人机器
Dialogue: 0,0:13:13.46,0:13:15.10,Layzner,,0,0,0,,所以拿到东西后只要五分钟就能回去了
Dialogue: 0,0:13:15.10,0:13:16.45,Layzner,,0,0,0,,不用担心
Dialogue: 0,0:13:16.45,0:13:18.41,Layzner,,0,0,0,,可恶 都是我的责任
Dialogue: 0,0:13:18.41,0:13:18.98,Layzner,,0,0,0,,博士
Dialogue: 0,0:13:18.98,0:13:20.00,Layzner,,0,0,0,,你在那不要动
Dialogue: 0,0:13:20.00,0:13:22.00,Layzner,,0,0,0,,我马上过去
Dialogue: 0,0:13:25.72,0:13:28.78,Layzner,,0,0,0,,警告TS Skull Gunner 50C骷髅炮手
Dialogue: 0,0:13:28.78,0:13:31.05,Layzner,,0,0,0,,13架入侵
Dialogue: 0,0:13:29.93,0:13:31.05,Layzner,,0,0,0,,敌人来了
Dialogue: 0,0:13:31.05,0:13:33.43,Layzner,,0,0,0,,亚瑟 剩下的拜托你了
Dialogue: 0,0:13:32.53,0:13:33.43,Layzner,,0,0,0,,好
Dialogue: 0,0:15:13.03,0:15:13.95,Layzner,,0,0,0,,大卫
Dialogue: 0,0:15:18.58,0:15:20.08,Layzner,,0,0,0,,博士 请上来
Dialogue: 0,0:15:28.38,0:15:29.54,Layzner,,0,0,0,,可恶
Dialogue: 0,0:15:29.54,0:15:34.31,Layzner,,0,0,0,,第二镜头跟第一镜头处有四架骷髅炮手快速接近中
Dialogue: 0,0:15:47.97,0:15:48.84,Layzner,,0,0,0,,罗安
Dialogue: 0,0:15:48.84,0:15:50.84,Layzner,,0,0,0,,把他们引离航天飞机
Dialogue: 0,0:15:50.84,0:15:52.09,Layzner,,0,0,0,,怎么引开
Dialogue: 0,0:15:52.09,0:15:54.09,Layzner,,0,0,0,,直接攻过去 不要怕
Dialogue: 0,0:16:01.21,0:16:02.28,Layzner,,0,0,0,,可恶
Dialogue: 0,0:16:19.02,0:16:20.01,Layzner,,0,0,0,,大卫
Dialogue: 0,0:16:20.01,0:16:21.65,Layzner,,0,0,0,,把他们引离航天飞机
Dialogue: 0,0:16:21.65,0:16:23.65,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:16:25.17,0:16:27.46,Layzner,,0,0,0,,快走开
Dialogue: 0,0:16:39.77,0:16:40.62,Layzner,,0,0,0,,可恶
Dialogue: 0,0:16:40.62,0:16:41.23,Layzner,,0,0,0,,可恶
Dialogue: 0,0:17:33.64,0:17:35.86,Layzner,,0,0,0,,谢谢
Dialogue: 0,0:17:36.43,0:17:39.80,Layzner,,0,0,0,,离设定的出发时间2.00分
Dialogue: 0,0:17:39.80,0:17:43.32,Layzner,,0,0,0,,请雷兹纳 巴鲁迪 贝布鲁尽快回航天飞机
Dialogue: 0,0:17:43.32,0:17:46.68,Layzner,,0,0,0,,剩下的我来想办法
Dialogue: 0,0:17:43.32,0:17:46.68,Layzner,,0,0,0,,罗安 大卫 你们快回航天飞机
Dialogue: 0,0:17:46.68,0:17:47.90,Layzner,,0,0,0,,英二 你
Dialogue: 0,0:17:49.71,0:17:51.11,Layzner,,0,0,0,,别说了 快回去
Dialogue: 0,0:17:51.11,0:17:52.49,Layzner,,0,0,0,,知道了
Dialogue: 0,0:18:14.52,0:18:15.89,Layzner,,0,0,0,,大卫 回去
Dialogue: 0,0:18:20.60,0:18:22.84,Layzner,,0,0,0,,你想让博士去送死吗
Dialogue: 0,0:18:22.84,0:18:26.07,Layzner,,0,0,0,,我知道了 我回去就是了
Dialogue: 0,0:18:26.07,0:18:28.10,Layzner,,0,0,0,,对不起 都是因为我
Dialogue: 0,0:18:50.08,0:18:53.22,Layzner,,0,0,0,,离设定出发时间还有01:00分
Dialogue: 0,0:18:53.22,0:18:55.07,Layzner,,0,0,0,,开始倒数
Dialogue: 0,0:18:55.07,0:18:55.99,Layzner,,0,0,0,,59...
Dialogue: 0,0:18:55.99,0:18:57.08,Layzner,,0,0,0,,58...
Dialogue: 0,0:18:57.08,0:18:58.11,Layzner,,0,0,0,,57...
Dialogue: 0,0:18:58.11,0:18:59.80,Layzner,,0,0,0,,56... 55...
Dialogue: 0,0:18:58.28,0:18:59.03,Layzner,,0,0,0,,英二
Dialogue: 0,0:18:59.80,0:19:00.66,Layzner,,0,0,0,,54...
Dialogue: 0,0:19:10.30,0:19:11.67,Layzner,,0,0,0,,警告信息 
Dialogue: 0,0:19:11.67,0:19:12.95,Layzner,,0,0,0,,现状对我方不利 
Dialogue: 0,0:19:12.95,0:19:14.95,Layzner,,0,0,0,,请快脱离
Dialogue: 0,0:19:14.95,0:19:16.40,Layzner,,0,0,0,,无法战斗
Dialogue: 0,0:19:16.40,0:19:17.85,Layzner,,0,0,0,,请脱离
Dialogue: 0,0:19:17.85,0:19:20.66,Layzner,,0,0,0,,无法战斗 请脱离
Dialogue: 0,0:19:21.23,0:19:24.29,Layzner,,0,0,0,,无法战斗 请脱离
Dialogue: 0,0:19:24.29,0:19:26.29,Layzner,,0,0,0,,搭乘者 
Dialogue: 0,0:19:26.29,0:19:28.61,Layzner,,0,0,0,,请脱离
Dialogue: 0,0:19:30.11,0:19:34.38,Layzner,,0,0,0,,如果这样下去说不定能知道雷兹纳的秘密
Dialogue: 0,0:19:40.96,0:19:42.05,Layzner,,0,0,0,,38...
Dialogue: 0,0:19:42.05,0:19:44.05,Layzner,,0,0,0,,37... 36...
Dialogue: 0,0:19:44.05,0:19:46.05,Layzner,,0,0,0,,35... 34...
Dialogue: 0,0:19:46.05,0:19:46.99,Layzner,,0,0,0,,33...
Dialogue: 0,0:19:49.14,0:19:50.73,Layzner,,0,0,0,,右腕部受伤 
Dialogue: 0,0:19:50.73,0:19:52.73,Layzner,,0,0,0,,无法战斗 
Dialogue: 0,0:19:52.73,0:19:56.02,Layzner,,0,0,0,,搭乘者请脱离 让我看看吧
Dialogue: 0,0:20:18.55,0:20:19.83,Layzner,,0,0,0,,让我看看
Dialogue: 0,0:20:38.65,0:20:40.53,Layzner,,0,0,0,,我 什么都没做
Dialogue: 0,0:21:43.02,0:21:45.02,Layzner,,0,0,0,,你是 雷 吗
Dialogue: 0,0:21:45.02,0:21:46.83,Layzner,,0,0,0,,不是
Dialogue: 0,0:21:46.83,0:21:48.83,Layzner,,0,0,0,,不是雷 那你到底是
Dialogue: 0,0:21:57.55,0:21:59.07,Layzner,,0,0,0,,你到底是谁
Dialogue: 0,0:22:11.13,0:22:12.60,Layzner,,0,0,0,,10... 09...
Dialogue: 0,0:22:12.60,0:22:14.60,Layzner,,0,0,0,,08... 07...
Dialogue: 0,0:22:14.60,0:22:16.60,Layzner,,0,0,0,,06... 05...
Dialogue: 0,0:22:16.60,0:22:18.60,Layzner,,0,0,0,,04... 03...
Dialogue: 0,0:22:18.60,0:22:20.60,Layzner,,0,0,0,,02... 01...
Dialogue: 0,0:22:20.60,0:22:21.91,Layzner,,0,0,0,,00...
Dialogue: 0,0:22:25.75,0:22:28.86,Layzner,,0,0,0,,我们离开月球了
Dialogue: 0,0:22:28.86,0:22:30.86,Layzner,,0,0,0,,马上就到地球
Dialogue: 0,0:22:30.86,0:22:34.70,Layzner,,0,0,0,,但是 看到那一幕
Dialogue: 0,0:22:34.70,0:22:36.70,Layzner,,0,0,0,,我却高兴不起来
Dialogue: 0,0:22:37.38,0:22:38.70,Layzner,,0,0,0,,感觉
Dialogue: 0,0:22:38.70,0:22:41.67,Layzner,,0,0,0,,雷兹纳好像被魔物附身一般
Dialogue: 0,0:22:41.67,0:22:43.86,Layzner,,0,0,0,,令人毛骨悚然
Dialogue: 0,0:23:54.77,0:23:55.68,Layzner,,0,0,0,,飞鸟
Dialogue: 0,0:23:57.09,0:23:58.23,Layzner,,0,0,0,,你知道我父亲
Dialogue: 0,0:23:58.89,0:24:00.23,Layzner,,0,0,0,,这里是欧洲大陆
Dialogue: 0,0:24:00.62,0:24:02.23,Layzner,,0,0,0,,怎么能在这里被干掉
Dialogue: 0,0:24:02.89,0:24:04.49,Layzner,,0,0,0,,你还活着吗 凯利前辈
Dialogue: 0,0:24:04.49,0:24:08.99,Layzner,,0,0,0,,下一集 无法传达的思念

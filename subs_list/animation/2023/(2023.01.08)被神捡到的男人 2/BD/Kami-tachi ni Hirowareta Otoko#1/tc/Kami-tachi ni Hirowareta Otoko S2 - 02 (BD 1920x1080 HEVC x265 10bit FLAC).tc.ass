Dialogue: 0,0:00:01.88,0:00:04.92,Default,,0,0,0,,給艾莉亞莉亞·賈米爾小姐
Dialogue: 0,0:00:05.92,0:00:07.17,Default,,0,0,0,,這種破店
Dialogue: 0,0:00:07.17,0:00:09.21,Default,,0,0,0,,我要把它砸爛
Dialogue: 0,0:00:09.54,0:00:10.50,Default,,0,0,0,,我丟
Dialogue: 0,0:00:11.25,0:00:12.21,Default,,0,0,0,,我丟
Dialogue: 0,0:00:12.21,0:00:13.25,Default,,0,0,0,,我丟…
Dialogue: 0,0:00:14.04,0:00:17.17,Default,,0,0,0,,等等 套好的不是這樣啦
Dialogue: 0,0:00:17.96,0:00:21.21,Default,,0,0,0,,我們之所以會做這種事
Dialogue: 0,0:00:21.21,0:00:23.54,Default,,0,0,0,,要從稍早的時候開始說起
Dialogue: 0,0:00:24.63,0:00:27.38,Default,,0,0,0,,沒想到史萊姆還有這種用途
Dialogue: 0,0:00:34.58,0:00:37.00,Default,,0,0,0,,這次的視察非常有意義
Dialogue: 0,0:00:37.00,0:00:38.17,Default,,0,0,0,,謝謝你
Dialogue: 0,0:00:38.17,0:00:39.17,Default,,0,0,0,,哪裡
Dialogue: 0,0:00:39.17,0:00:42.88,Default,,0,0,0,,馴獸師公會的分部長親自大駕光臨
Dialogue: 0,0:00:42.88,0:00:45.13,Default,,0,0,0,,我才要謝謝您
Dialogue: 0,0:00:45.13,0:00:47.71,Default,,0,0,0,,我想向世人證明從魔魔法師的價值
Dialogue: 0,0:00:47.71,0:00:50.75,Default,,0,0,0,,不是單純由從魔魔獸的強度來決定
Dialogue: 0,0:00:50.75,0:00:53.79,Default,,0,0,0,,我很期待你繼續活用史萊姆
Dialogue: 0,0:00:53.79,0:00:55.08,Default,,0,0,0,,是
Dialogue: 0,0:00:56.50,0:00:58.17,Default,,0,0,0,,為了回應他的期待
Dialogue: 0,0:00:58.17,0:01:00.50,Default,,0,0,0,,果然需要二號店
Dialogue: 0,0:01:00.50,0:01:02.83,Default,,0,0,0,,這家店是怎麼搞的
Dialogue: 0,0:01:10.37,0:01:13.02,OPJP,,0,0,0,,Let's walk! Let's walk!
Dialogue: 0,0:01:13.58,0:01:14.97,OPJP,,0,0,0,,Let's walk the road
Dialogue: 0,0:01:14.97,0:01:16.57,OPJP,,0,0,0,,立ち止まらず
Dialogue: 0,0:01:16.74,0:01:19.31,OPJP,,0,0,0,,Let's walk! Let's walk!
Dialogue: 0,0:01:19.83,0:01:21.28,OPJP,,0,0,0,,Let's walk the road
Dialogue: 0,0:01:21.28,0:01:23.09,OPJP,,0,0,0,,歩きだすよ
Dialogue: 0,0:01:36.67,0:01:42.41,OPJP,,0,0,0,,今はもう前に進んでゆくだけさ
Dialogue: 0,0:01:42.41,0:01:46.66,OPJP,,0,0,0,,絶対振り向いたりしないんだから
Dialogue: 0,0:01:49.25,0:01:52.14,OPJP,,0,0,0,,離れていてもずっと
Dialogue: 0,0:01:52.42,0:01:56.25,OPJP,,0,0,0,,いつだって浮かぶ君のスマイル
Dialogue: 0,0:01:56.52,0:02:00.44,OPJP,,0,0,0,,すぐそばにいる様
Dialogue: 0,0:02:01.36,0:02:04.22,OPJP,,0,0,0,,Everyone has a mission
Dialogue: 0,0:02:04.27,0:02:06.91,OPJP,,0,0,0,,この命を
Dialogue: 0,0:02:07.07,0:02:10.44,OPJP,,0,0,0,,全うするために
Dialogue: 0,0:02:10.54,0:02:13.69,OPJP,,0,0,0,,生まれてきたんだ
Dialogue: 0,0:02:13.99,0:02:16.84,OPJP,,0,0,0,,Everyone has a mission
Dialogue: 0,0:02:16.99,0:02:23.42,OPJP,,0,0,0,,この命が続いてゆく限り
Dialogue: 0,0:02:23.42,0:02:24.60,OPJP,,0,0,0,,Time to go!
Dialogue: 0,0:02:24.81,0:02:27.26,OPJP,,0,0,0,,I got to go, way to go!
Dialogue: 0,0:02:29.17,0:02:31.13,OPJP,,0,0,0,,Way to go!
Dialogue: 0,0:01:10.37,0:01:13.02,OPCN,,0,0,0,,走吧！走吧！
Dialogue: 0,0:01:13.58,0:01:14.97,OPCN,,0,0,0,,順著這條路走下去
Dialogue: 0,0:01:14.97,0:01:16.57,OPCN,,0,0,0,,不要停下
Dialogue: 0,0:01:16.74,0:01:19.31,OPCN,,0,0,0,,走吧！走吧！
Dialogue: 0,0:01:19.83,0:01:21.28,OPCN,,0,0,0,,順著這條路走下去
Dialogue: 0,0:01:21.28,0:01:23.09,OPCN,,0,0,0,,出發吧
Dialogue: 0,0:01:36.67,0:01:42.41,OPCN,,0,0,0,,現在除了前進沒有別的選擇
Dialogue: 0,0:01:42.41,0:01:46.66,OPCN,,0,0,0,,絕對不會再掉頭返回了
Dialogue: 0,0:01:49.25,0:01:52.14,OPCN,,0,0,0,,即使彼此相隔得再遙遠
Dialogue: 0,0:01:52.42,0:01:56.25,OPCN,,0,0,0,,也永遠能回想起你的微笑
Dialogue: 0,0:01:56.52,0:02:00.44,OPCN,,0,0,0,,就好像你未曾離開一樣
Dialogue: 0,0:02:01.36,0:02:04.22,OPCN,,0,0,0,,人人都有使命
Dialogue: 0,0:02:04.27,0:02:06.91,OPCN,,0,0,0,,為了讓人生
Dialogue: 0,0:02:07.07,0:02:10.44,OPCN,,0,0,0,,變得充實起來
Dialogue: 0,0:02:10.54,0:02:13.69,OPCN,,0,0,0,,一路走到這裡
Dialogue: 0,0:02:13.99,0:02:16.84,OPCN,,0,0,0,,人人都有使命
Dialogue: 0,0:02:16.99,0:02:23.42,OPCN,,0,0,0,,只要人生還沒結束
Dialogue: 0,0:02:23.42,0:02:24.60,OPCN,,0,0,0,,該走了！
Dialogue: 0,0:02:24.81,0:02:27.26,OPCN,,0,0,0,,我該走了 上路吧！
Dialogue: 0,0:02:29.17,0:02:31.13,OPCN,,0,0,0,,上路吧！
Dialogue: 0,0:02:34.01,0:02:39.01,Default,,0,0,0,,第2集 龍馬和防盜訓練
Dialogue: 0,0:02:39.25,0:02:42.08,Default,,0,0,0,,你們打算怎麼解決這件事
Dialogue: 0,0:02:42.08,0:02:43.54,Default,,0,0,0,,說啊
Dialogue: 0,0:02:47.42,0:02:49.50,Default,,0,0,0,,請問您有什麼事 客人
Dialogue: 0,0:02:49.50,0:02:51.00,Default,,0,0,0,,你這小鬼想幹嘛
Dialogue: 0,0:02:51.00,0:02:52.54,Default,,0,0,0,,滾開
Dialogue: 0,0:02:52.54,0:02:54.00,Default,,0,0,0,,那可不行
Dialogue: 0,0:02:54.00,0:02:56.00,Default,,0,0,0,,因為我是這家店的店長
Dialogue: 0,0:02:57.46,0:02:59.13,Default,,0,0,0,,你是店長
Dialogue: 0,0:03:00.54,0:03:02.13,Default,,0,0,0,,那你說說
Dialogue: 0,0:03:02.13,0:03:05.17,Default,,0,0,0,,你們店裡是怎麼洗衣的
Dialogue: 0,0:03:05.17,0:03:08.13,Default,,0,0,0,,給我賠償 臭小子
Dialogue: 0,0:03:09.50,0:03:11.79,Default,,0,0,0,,請讓我看一下
Dialogue: 0,0:03:12.38,0:03:14.42,Default,,0,0,0,,這是用刀子割開
Dialogue: 0,0:03:14.42,0:03:17.42,Default,,0,0,0,,再用力扯裂的吧
Dialogue: 0,0:03:17.42,0:03:19.33,Default,,0,0,0,,您用這種藉口找麻煩
Dialogue: 0,0:03:19.33,0:03:21.38,Default,,0,0,0,,我會很困擾的 客人
Dialogue: 0,0:03:21.67,0:03:23.58,Default,,0,0,0,,你說這是藉口
Dialogue: 0,0:03:23.58,0:03:26.88,Default,,0,0,0,,不只不道歉 還把客人當作壞蛋
Dialogue: 0,0:03:26.88,0:03:29.13,Default,,0,0,0,,你這缺德的業者
Dialogue: 0,0:03:29.13,0:03:31.42,Default,,0,0,0,,那我就證明給您看吧
Dialogue: 0,0:03:31.42,0:03:32.33,Default,,0,0,0,,過來
Dialogue: 0,0:03:32.33,0:03:33.17,Default,,0,0,0,,什麼
Dialogue: 0,0:03:34.38,0:03:37.46,Default,,0,0,0,,誰能把要洗的衣服借我呢
Dialogue: 0,0:03:41.75,0:03:44.13,Default,,0,0,0,,如您所見 本店的史萊姆
Dialogue: 0,0:03:44.13,0:03:46.38,Default,,0,0,0,,正在吃掉衣服上的污漬
Dialogue: 0,0:03:46.38,0:03:48.29,Default,,0,0,0,,牠們沒有爪子也沒有利齒
Dialogue: 0,0:03:48.29,0:03:49.58,Default,,0,0,0,,別說把衣服弄破了
Dialogue: 0,0:03:49.58,0:03:51.92,Default,,0,0,0,,也很少會把布料弄壞
Dialogue: 0,0:03:51.92,0:03:53.50,Default,,0,0,0,,也就是說那件衣服的裂口
Dialogue: 0,0:03:53.50,0:03:56.42,Default,,0,0,0,,並不是本店弄出來的
Dialogue: 0,0:03:56.42,0:03:58.25,Default,,0,0,0,,您這是在妨礙營業
Dialogue: 0,0:03:58.25,0:04:00.88,Default,,0,0,0,,所以我要將您交給警備隊
Dialogue: 0,0:04:03.13,0:04:05.17,Default,,0,0,0,,開什麼玩笑
Dialogue: 0,0:04:17.67,0:04:19.21,Default,,0,0,0,,真是令人擔心
Dialogue: 0,0:04:20.38,0:04:24.33,Default,,0,0,0,,這是連續第二次\N有人來找店裡的麻煩
Dialogue: 0,0:04:24.33,0:04:26.58,Default,,0,0,0,,他們的目的究竟是什麼呢
Dialogue: 0,0:04:26.58,0:04:29.75,Default,,0,0,0,,應該是想毀掉我們店的名聲吧
Dialogue: 0,0:04:29.75,0:04:32.38,Default,,0,0,0,,但我不懂這麼做有什麼好處
Dialogue: 0,0:04:32.38,0:04:33.83,Default,,0,0,0,,因為Bamboo Forest
Dialogue: 0,0:04:33.83,0:04:37.83,Default,,0,0,0,,在同業並沒有其他的競爭對手
Dialogue: 0,0:04:38.83,0:04:40.75,Default,,0,0,0,,其中一定有什麼隱情
Dialogue: 0,0:04:40.75,0:04:42.08,Default,,0,0,0,,我會派卡爾姆去調查
Dialogue: 0,0:04:42.08,0:04:43.71,Default,,0,0,0,,改天再向您報告
Dialogue: 0,0:04:43.71,0:04:45.38,Default,,0,0,0,,麻煩妳了
Dialogue: 0,0:04:51.00,0:04:52.58,Default,,0,0,0,,這不是龍馬嗎
Dialogue: 0,0:04:53.67,0:04:55.29,Default,,0,0,0,,你好 朝霧先生
Dialogue: 0,0:04:55.29,0:04:56.96,Default,,0,0,0,,你今天休假嗎
Dialogue: 0,0:04:56.96,0:04:59.25,Default,,0,0,0,,嗯 你呢
Dialogue: 0,0:04:59.25,0:05:01.75,Default,,0,0,0,,我剛結束工作 正要回家
Dialogue: 0,0:05:02.54,0:05:06.88,Default,,0,0,0,,我們兩個在能休息的時候\N都應該要多休息
Dialogue: 0,0:05:07.46,0:05:09.29,Default,,0,0,0,,那是新品吧
Dialogue: 0,0:05:11.04,0:05:11.92,Default,,0,0,0,,是啊
Dialogue: 0,0:05:13.13,0:05:16.54,Default,,0,0,0,,刀用久了總是會壞
Dialogue: 0,0:05:16.54,0:05:19.88,Default,,0,0,0,,每年大概都得換新一次
Dialogue: 0,0:05:21.38,0:05:23.83,Default,,0,0,0,,你都是在哪裡得到刀的
Dialogue: 0,0:05:25.04,0:05:28.67,Default,,0,0,0,,你是想要當美術品收藏的刀
Dialogue: 0,0:05:28.67,0:05:31.38,Default,,0,0,0,,還是想要當武器使用的刀
Dialogue: 0,0:05:31.38,0:05:33.42,Default,,0,0,0,,我是要拿來用的
Dialogue: 0,0:05:33.42,0:05:36.25,Default,,0,0,0,,只要去王都就能找到販賣店
Dialogue: 0,0:05:36.25,0:05:38.42,Default,,0,0,0,,但每次壞了都要買替換品
Dialogue: 0,0:05:38.42,0:05:41.46,Default,,0,0,0,,以生活開銷來說實在太大了
Dialogue: 0,0:05:41.46,0:05:43.92,Default,,0,0,0,,那你的刀呢
Dialogue: 0,0:05:43.92,0:05:46.04,Default,,0,0,0,,只要跟他們說刀的壽命已盡
Dialogue: 0,0:05:46.04,0:05:48.38,Default,,0,0,0,,在下的故鄉就會送刀來
Dialogue: 0,0:05:48.38,0:05:49.75,Default,,0,0,0,,因為在下是修行之人
Dialogue: 0,0:05:49.75,0:05:53.79,Default,,0,0,0,,所以才能破例以這樣的形式持有刀
Dialogue: 0,0:05:53.79,0:05:55.58,Default,,0,0,0,,原來如此
Dialogue: 0,0:05:55.58,0:05:57.50,Default,,0,0,0,,你會想要刀
Dialogue: 0,0:05:57.50,0:06:00.92,Default,,0,0,0,,就代表你曾經在哪裡學過劍術吧
Dialogue: 0,0:06:00.92,0:06:02.50,Default,,0,0,0,,既然如此 從那個管道弄到
Dialogue: 0,0:06:02.50,0:06:04.50,Default,,0,0,0,,我想是最快的方法
Dialogue: 0,0:06:07.79,0:06:10.54,Default,,0,0,0,,我過世的祖父是一名刀匠
Dialogue: 0,0:06:10.54,0:06:12.42,Default,,0,0,0,,使用方法也是他教我的
Dialogue: 0,0:06:12.42,0:06:14.25,Default,,0,0,0,,就當作是這樣吧
Dialogue: 0,0:06:14.25,0:06:15.50,Default,,0,0,0,,原來如此
Dialogue: 0,0:06:15.50,0:06:18.21,Default,,0,0,0,,這樣的話就只能買昂貴的刀
Dialogue: 0,0:06:18.21,0:06:20.25,Default,,0,0,0,,或使用其他的武器了
Dialogue: 0,0:06:20.25,0:06:22.00,Default,,0,0,0,,抱歉沒能幫上你的忙
Dialogue: 0,0:06:22.96,0:06:25.33,Default,,0,0,0,,沒關係 謝謝你
Dialogue: 0,0:06:26.58,0:06:29.75,Default,,0,0,0,,不知道能不能乾脆自己製刀呢
Dialogue: 0,0:06:30.50,0:06:33.92,Default,,0,0,0,,現代的製刀材料是玉鋼
Dialogue: 0,0:06:33.92,0:06:36.29,Default,,0,0,0,,用來製作玉鋼的材料木炭
Dialogue: 0,0:06:36.29,0:06:37.88,Default,,0,0,0,,我有辦法弄到
Dialogue: 0,0:06:38.33,0:06:41.17,Default,,0,0,0,,另一個材料 鐵砂也可以
Dialogue: 0,0:06:42.04,0:06:43.71,Default,,0,0,0,,只要使用鍊金術
Dialogue: 0,0:06:43.71,0:06:46.25,Default,,0,0,0,,在這個廢棄坑道裡想做多少都行
Dialogue: 0,0:06:49.04,0:06:52.67,Default,,0,0,0,,我也有製刀的知識
Dialogue: 0,0:06:52.67,0:06:54.83,Default,,0,0,0,,但是沒有技術
Dialogue: 0,0:06:57.58,0:07:00.92,Default,,0,0,0,,我本來想說\N要是有擅長運用的武器就好了
Dialogue: 0,0:07:03.42,0:07:04.79,Default,,0,0,0,,道具箱
Dialogue: 0,0:07:04.79,0:07:06.42,Default,,0,0,0,,我記得是在這裡面
Dialogue: 0,0:07:07.38,0:07:08.54,Default,,0,0,0,,找到了
Dialogue: 0,0:07:09.83,0:07:11.21,Default,,0,0,0,,我還住在森林裡時
Dialogue: 0,0:07:11.21,0:07:13.75,Default,,0,0,0,,從打倒的盜賊那裡得到的矛
Dialogue: 0,0:07:17.63,0:07:19.92,Default,,0,0,0,,使用上沒有問題
Dialogue: 0,0:07:19.92,0:07:21.54,Default,,0,0,0,,雖然還是刀最好
Dialogue: 0,0:07:21.54,0:07:23.42,Default,,0,0,0,,但矛也能派上用場
Dialogue: 0,0:07:27.17,0:07:30.38,Default,,0,0,0,,在上一個世界裡\N我的父親是刀匠
Dialogue: 0,0:07:30.38,0:07:32.63,Default,,0,0,0,,他教過我打造刀的方法
Dialogue: 0,0:07:32.63,0:07:34.92,Default,,0,0,0,,所以我知道相關的知識
Dialogue: 0,0:07:34.92,0:07:38.17,Default,,0,0,0,,但他很快就認為我沒有天分
Dialogue: 0,0:07:38.17,0:07:39.58,Default,,0,0,0,,放棄栽培我
Dialogue: 0,0:07:40.25,0:07:41.17,Default,,0,0,0,,也因為這樣
Dialogue: 0,0:07:41.17,0:07:43.75,Default,,0,0,0,,他全心全力訓練我的武藝
Dialogue: 0,0:07:44.54,0:07:46.96,Default,,0,0,0,,雖然主要是赤手空拳的武術
Dialogue: 0,0:07:49.96,0:07:52.67,Default,,0,0,0,,但我也一併學會了武器的用法
Dialogue: 0,0:07:54.67,0:07:56.46,Default,,0,0,0,,當然也包含了矛
Dialogue: 0,0:07:57.21,0:08:00.63,Default,,0,0,0,,我記得這支矛好像是魔法武器
Dialogue: 0,0:08:06.75,0:08:08.17,Default,,0,0,0,,還滿有趣的
Dialogue: 0,0:08:08.17,0:08:09.13,Default,,0,0,0,,但這種程度的話
Dialogue: 0,0:08:09.13,0:08:11.92,Default,,0,0,0,,還不如我自己使用火魔法
Dialogue: 0,0:08:12.29,0:08:13.96,Default,,0,0,0,,不小心搞太晚了
Dialogue: 0,0:08:13.96,0:08:15.79,Default,,0,0,0,,吃完晚餐就睡吧
Dialogue: 0,0:08:16.58,0:08:18.33,Default,,0,0,0,,調查結果出來了
Dialogue: 0,0:08:19.33,0:08:20.83,Default,,0,0,0,,派系鬥爭
Dialogue: 0,0:08:21.96,0:08:24.50,Default,,0,0,0,,提拉分部長在馴獸師公會裡
Dialogue: 0,0:08:24.50,0:08:27.17,Default,,0,0,0,,立場好像不是很穩固
Dialogue: 0,0:08:27.17,0:08:29.75,Default,,0,0,0,,重視強大魔獸的主流派
Dialogue: 0,0:08:29.75,0:08:32.25,Default,,0,0,0,,想拉下提拉先生的地位
Dialogue: 0,0:08:32.88,0:08:35.79,Default,,0,0,0,,因為提拉先生是重視如何對待魔獸
Dialogue: 0,0:08:35.79,0:08:40.21,Default,,0,0,0,,以及如何與魔獸共存的反主流派
Dialogue: 0,0:08:40.21,0:08:43.46,Default,,0,0,0,,有人刻意在散播提拉先生的惡評嗎
Dialogue: 0,0:08:43.92,0:08:44.67,Default,,0,0,0,,沒錯
Dialogue: 0,0:08:44.67,0:08:47.75,Default,,0,0,0,,&quot;他在包庇只會操控史萊姆的廢物&quot;
Dialogue: 0,0:08:47.75,0:08:49.54,Default,,0,0,0,,也有這樣的流言蜚語
Dialogue: 0,0:08:49.54,0:08:52.29,Default,,0,0,0,,那是在說我吧
Dialogue: 0,0:08:52.29,0:08:53.79,Default,,0,0,0,,最近兩次的鬧事
Dialogue: 0,0:08:53.79,0:08:58.46,Default,,0,0,0,,應該也是為了讓分部長\N寄予厚望的店舖評價變差
Dialogue: 0,0:09:00.92,0:09:03.21,Default,,0,0,0,,不如我們來散播新的謠言吧
Dialogue: 0,0:09:03.21,0:09:06.17,Default,,0,0,0,,不是騙人而是讓事實廣為流傳
Dialogue: 0,0:09:06.17,0:09:09.96,Default,,0,0,0,,商業公會裡有很多消息靈通的商人
Dialogue: 0,0:09:09.96,0:09:12.21,Default,,0,0,0,,只要利用他們就能輕易辦到
Dialogue: 0,0:09:12.21,0:09:16.79,Default,,0,0,0,,其實我最近\N成功跟利穆爾鳥締結契約
Dialogue: 0,0:09:16.79,0:09:18.25,Default,,0,0,0,,而且還是六隻
Dialogue: 0,0:09:18.25,0:09:19.83,Default,,0,0,0,,只要把這件事傳出去
Dialogue: 0,0:09:19.83,0:09:21.71,Default,,0,0,0,,大家就會覺得&quot;分部長真有眼光&quot;
Dialogue: 0,0:09:21.71,0:09:23.58,Default,,0,0,0,,妳不這麼認為嗎
Dialogue: 0,0:09:23.58,0:09:25.08,Default,,0,0,0,,很有可能
Dialogue: 0,0:09:25.08,0:09:28.29,Default,,0,0,0,,因為利穆爾鳥\N是很難締結契約的魔獸
Dialogue: 0,0:09:28.29,0:09:32.04,Default,,0,0,0,,大家一定會懷疑\N那些散播惡評的人是否有眼光
Dialogue: 0,0:09:32.04,0:09:33.83,Default,,0,0,0,,那就麻煩妳了
Dialogue: 0,0:09:34.67,0:09:36.54,Default,,0,0,0,,辛苦了
Dialogue: 0,0:09:45.63,0:09:48.17,Default,,0,0,0,,就是這樣 妳的資質不錯
Dialogue: 0,0:09:49.17,0:09:50.96,Default,,0,0,0,,辛苦了
Dialogue: 0,0:09:50.96,0:09:53.29,Default,,0,0,0,,大家也快點收工吧
Dialogue: 0,0:09:53.29,0:09:54.42,Default,,0,0,0,,是
Dialogue: 0,0:09:56.38,0:09:58.04,Default,,0,0,0,,我要再留下一會兒
Dialogue: 0,0:09:56.58,0:09:59.83,UP,,0,0,0,,（史萊姆研究者 柯金）
Dialogue: 0,0:09:58.04,0:10:01.00,Default,,0,0,0,,記住史萊姆們的個體差異
Dialogue: 0,0:10:02.08,0:10:05.33,UP,,0,0,0,,（史萊姆研究者 東尼）
Dialogue: 0,0:10:02.08,0:10:03.12,Default,,0,0,0,,我也是
Dialogue: 0,0:10:03.33,0:10:05.80,Default,,0,0,0,,請你們不要研究過頭喔
Dialogue: 0,0:10:06.21,0:10:08.96,Default,,0,0,0,,畢竟我們是被聘來當候補店長
Dialogue: 0,0:10:06.46,0:10:09.51,UP,,0,0,0,,（史萊姆研究者 蘿貝莉亞）
Dialogue: 0,0:10:08.96,0:10:10.29,Default,,0,0,0,,這種程度是應該的
Dialogue: 0,0:10:10.29,0:10:11.79,Default,,0,0,0,,一點也不辛苦
Dialogue: 0,0:10:11.79,0:10:14.29,Default,,0,0,0,,因為靠史萊姆就能創造利益
Dialogue: 0,0:10:14.29,0:10:15.79,Default,,0,0,0,,實在是太了不起了
Dialogue: 0,0:10:17.92,0:10:18.92,Default,,0,0,0,,柯金先生
Dialogue: 0,0:10:18.92,0:10:19.83,Default,,0,0,0,,東尼先生
Dialogue: 0,0:10:19.83,0:10:21.13,Default,,0,0,0,,蘿貝莉亞小姐
Dialogue: 0,0:10:21.13,0:10:24.88,Default,,0,0,0,,是冒險者傑夫先生\N介紹來的從魔魔法師
Dialogue: 0,0:10:24.88,0:10:27.88,Default,,0,0,0,,將來我想把店長的職位交給他們
Dialogue: 0,0:10:28.25,0:10:29.21,Default,,0,0,0,,各位
Dialogue: 0,0:10:29.21,0:10:31.71,Default,,0,0,0,,你們在這裡工作遇到任何問題
Dialogue: 0,0:10:31.71,0:10:33.63,Default,,0,0,0,,請儘管跟我說
Dialogue: 0,0:10:33.63,0:10:35.29,Default,,0,0,0,,什麼問題都沒有
Dialogue: 0,0:10:35.29,0:10:38.17,Default,,0,0,0,,跟待在只有絕望的研究所時期相比
Dialogue: 0,0:10:38.17,0:10:39.96,Default,,0,0,0,,這裡根本是天堂
Dialogue: 0,0:10:40.63,0:10:43.38,Default,,0,0,0,,你們之前很絕望嗎
Dialogue: 0,0:10:43.38,0:10:47.21,Default,,0,0,0,,店長不知道史萊姆研究所有多悲慘
Dialogue: 0,0:10:47.21,0:10:51.21,Default,,0,0,0,,那裡變成上司看不順眼的部下\N被流放的地方
Dialogue: 0,0:10:51.21,0:10:53.38,Default,,0,0,0,,待遇超糟糕的
Dialogue: 0,0:10:53.38,0:10:55.63,Default,,0,0,0,,常常因為小事就扣薪
Dialogue: 0,0:10:55.63,0:10:57.79,Default,,0,0,0,,要是有怨言就叫人辭職
Dialogue: 0,0:10:58.38,0:11:01.58,Default,,0,0,0,,原來這裡也有黑心企業啊
Dialogue: 0,0:11:01.58,0:11:04.17,Default,,0,0,0,,你說的小事是指什麼
Dialogue: 0,0:11:04.17,0:11:08.25,Default,,0,0,0,,最常遇到的是研究沒有成果
Dialogue: 0,0:11:08.25,0:11:10.75,Default,,0,0,0,,上頭的那些人什麼都不懂
Dialogue: 0,0:11:10.75,0:11:12.38,Default,,0,0,0,,要解開史萊姆的生態
Dialogue: 0,0:11:12.38,0:11:14.71,Default,,0,0,0,,不是一朝一夕就能辦到
Dialogue: 0,0:11:14.71,0:11:17.17,Default,,0,0,0,,因為種類太多了
Dialogue: 0,0:11:17.17,0:11:19.71,Default,,0,0,0,,相對地 資訊卻很少
Dialogue: 0,0:11:20.13,0:11:22.71,Default,,0,0,0,,更別說進化的條件了
Dialogue: 0,0:11:22.71,0:11:24.33,Default,,0,0,0,,什麼
Dialogue: 0,0:11:24.33,0:11:27.71,Default,,0,0,0,,幾乎每次都會進化成不同的高階種
Dialogue: 0,0:11:27.71,0:11:29.88,Default,,0,0,0,,根本無法做實驗
Dialogue: 0,0:11:29.88,0:11:32.71,Default,,0,0,0,,最後就以拿不出成果為理由
Dialogue: 0,0:11:32.71,0:11:34.58,Default,,0,0,0,,把我們裁員了
Dialogue: 0,0:11:34.58,0:11:38.79,Default,,0,0,0,,我們三個人會淪落到貧民窟\N也是必然的結果
Dialogue: 0,0:11:40.92,0:11:41.83,Default,,0,0,0,,請問…
Dialogue: 0,0:11:42.83,0:11:45.67,Default,,0,0,0,,你們都餵牠們吃什麼
Dialogue: 0,0:11:45.67,0:11:48.79,Default,,0,0,0,,其他的魔獸吃剩的飼料之類的
Dialogue: 0,0:11:48.79,0:11:51.38,Default,,0,0,0,,因為史萊姆什麼都吃
Dialogue: 0,0:11:52.75,0:11:55.38,Default,,0,0,0,,店長 你為什麼突然問這個
Dialogue: 0,0:11:55.38,0:11:59.75,Default,,0,0,0,,那個啊 史萊姆的進化條件
Dialogue: 0,0:12:01.75,0:12:03.25,Default,,0,0,0,,就是進食
Dialogue: 0,0:12:03.25,0:12:04.54,Default,,0,0,0,,什麼
Dialogue: 0,0:12:04.54,0:12:06.54,Default,,0,0,0,,史萊姆會依據吃的東西
Dialogue: 0,0:12:06.54,0:12:08.75,Default,,0,0,0,,進化成不同的種類
Dialogue: 0,0:12:08.75,0:12:10.29,Default,,0,0,0,,怎…怎麼會
Dialogue: 0,0:12:10.29,0:12:13.83,Default,,0,0,0,,食物跟進化無關這件事\N早已是定論了
Dialogue: 0,0:12:13.83,0:12:16.63,Default,,0,0,0,,這是我三年來研究的成果
Dialogue: 0,0:12:16.63,0:12:18.33,Default,,0,0,0,,幾乎可以說是確定了
Dialogue: 0,0:12:19.58,0:12:20.75,Default,,0,0,0,,要是知道這一點
Dialogue: 0,0:12:20.75,0:12:22.83,Default,,0,0,0,,就能繼續做研究了
Dialogue: 0,0:12:22.83,0:12:25.04,Default,,0,0,0,,我好不甘心
Dialogue: 0,0:12:25.04,0:12:26.29,Default,,0,0,0,,柯金先生
Dialogue: 0,0:12:26.29,0:12:29.00,Default,,0,0,0,,我們以後可以在這家店研究啊
Dialogue: 0,0:12:29.00,0:12:32.42,Default,,0,0,0,,我們要在這裡不斷證明\N史萊姆有多好用
Dialogue: 0,0:12:34.46,0:12:37.04,Default,,0,0,0,,是啊 我們可沒時間悔恨
Dialogue: 0,0:12:37.58,0:12:39.00,Default,,0,0,0,,店長
Dialogue: 0,0:12:39.00,0:12:41.67,Default,,0,0,0,,如果您還有我們不知道的\N史萊姆的知識見解
Dialogue: 0,0:12:41.67,0:12:43.42,Default,,0,0,0,,請告訴我們
Dialogue: 0,0:12:43.42,0:12:46.75,Default,,0,0,0,,請告訴我們\N與大史萊姆締結契約的方法
Dialogue: 0,0:12:46.75,0:12:49.83,Default,,0,0,0,,您應該不可能連那種事都知道吧
Dialogue: 0,0:12:49.83,0:12:51.00,Default,,0,0,0,,我是知道
Dialogue: 0,0:12:51.00,0:12:53.42,Default,,0,0,0,,但說了感覺他們又會變沮喪
Dialogue: 0,0:12:53.42,0:12:55.83,Default,,0,0,0,,我告訴你們其他史萊姆的事
Dialogue: 0,0:12:55.83,0:12:58.21,Default,,0,0,0,,什麼都行 請告訴我們吧
Dialogue: 0,0:12:58.21,0:13:00.38,Default,,0,0,0,,感覺要講很久
Dialogue: 0,0:13:00.38,0:13:03.71,Default,,0,0,0,,但是能感覺到他們充滿熱誠
Dialogue: 0,0:13:03.71,0:13:06.00,Default,,0,0,0,,真想讓他們大顯身手
Dialogue: 0,0:13:07.27,0:13:08.96,Default,,0,0,0,,要餵牠們吃什麼好呢
Dialogue: 0,0:13:08.96,0:13:10.50,Default,,0,0,0,,燒肉之類的怎麼樣
Dialogue: 0,0:13:10.50,0:13:11.88,Default,,0,0,0,,不 炸雞比較好
Dialogue: 0,0:13:12.67,0:13:13.69,Default,,0,0,0,,要拍囉
Dialogue: 0,0:13:13.75,0:13:15.32,Default,,0,0,0,,大家為什麼都站在後面
Dialogue: 0,0:13:15.83,0:13:16.92,Default,,0,0,0,,是小臉效果嗎
Dialogue: 0,0:13:20.42,0:13:22.63,Default,,0,0,0,,結果搞到這麼晚
Dialogue: 0,0:13:23.29,0:13:25.83,Default,,0,0,0,,兩個人…不對 是三個人
Dialogue: 0,0:13:34.83,0:13:35.88,Default,,0,0,0,,他在這裡
Dialogue: 0,0:13:44.88,0:13:46.71,Default,,0,0,0,,他們完全搶在我前頭
Dialogue: 0,0:13:47.08,0:13:47.92,Default,,0,0,0,,瞬間移動
Dialogue: 0,0:13:49.17,0:13:50.17,Default,,0,0,0,,什麼
Dialogue: 0,0:13:54.83,0:13:56.25,Default,,0,0,0,,跟丟了嗎
Dialogue: 0,0:13:57.33,0:13:58.79,Default,,0,0,0,,等等
Dialogue: 0,0:13:59.38,0:14:00.75,Default,,0,0,0,,他在那裡
Dialogue: 0,0:14:04.79,0:14:06.00,Default,,0,0,0,,可惡
Dialogue: 0,0:14:06.46,0:14:07.42,Default,,0,0,0,,瞬間移動
Dialogue: 0,0:14:09.79,0:14:12.46,Default,,0,0,0,,你們應該暫時不能動了
Dialogue: 0,0:14:12.46,0:14:14.63,Default,,0,0,0,,你在上面塗了毒嗎
Dialogue: 0,0:14:14.63,0:14:16.83,Default,,0,0,0,,你們到底想對我做什麼
Dialogue: 0,0:14:18.08,0:14:21.13,Default,,0,0,0,,你別以為做了這種事\N我們會輕易放過你
Dialogue: 0,0:14:21.13,0:14:24.38,Default,,0,0,0,,不過只要你把和利穆爾鳥\N一起賺來的錢交出來
Dialogue: 0,0:14:24.38,0:14:25.13,Default,,0,0,0,,我就原諒…
Dialogue: 0,0:14:25.13,0:14:26.17,Default,,0,0,0,,好燙
Dialogue: 0,0:14:26.17,0:14:27.33,Default,,0,0,0,,住手
Dialogue: 0,0:14:27.33,0:14:30.67,Default,,0,0,0,,在這種情況下還這麼囂張\N實在有點…
Dialogue: 0,0:14:42.29,0:14:46.29,Default,,0,0,0,,我知道\N你利用與從魔魔獸的感覺共享
Dialogue: 0,0:14:46.29,0:14:47.83,Default,,0,0,0,,來掌握我的位置
Dialogue: 0,0:14:47.83,0:14:50.58,Default,,0,0,0,,因此我也用了同一招
Dialogue: 0,0:14:54.58,0:14:55.63,Default,,0,0,0,,在這邊
Dialogue: 0,0:14:55.96,0:14:57.25,Default,,0,0,0,,公會負責人
Dialogue: 0,0:14:57.75,0:14:59.33,Default,,0,0,0,,你怎麼會來這裡
Dialogue: 0,0:14:59.83,0:15:01.21,Default,,0,0,0,,我在回去的路上
Dialogue: 0,0:15:01.21,0:15:04.79,Default,,0,0,0,,碰巧看見這些人在追利穆爾鳥
Dialogue: 0,0:15:04.79,0:15:08.33,Default,,0,0,0,,以防萬一\N我有派牠們去呼叫警備隊
Dialogue: 0,0:15:08.33,0:15:10.46,Default,,0,0,0,,讓你擔心了
Dialogue: 0,0:15:10.46,0:15:13.21,Default,,0,0,0,,你明天抽空來見我吧
Dialogue: 0,0:15:15.79,0:15:18.96,Default,,0,0,0,,以上就是昨晚發生的事情經過
Dialogue: 0,0:15:18.96,0:15:21.00,Default,,0,0,0,,雖然不希望你們遇到
Dialogue: 0,0:15:21.00,0:15:24.75,Default,,0,0,0,,但我無法保證大家不會遭到攻擊
Dialogue: 0,0:15:24.75,0:15:27.67,Default,,0,0,0,,請大家在天黑之前回家
Dialogue: 0,0:15:27.67,0:15:29.42,Default,,0,0,0,,費伊先生和黎琳小姐
Dialogue: 0,0:15:29.42,0:15:32.50,Default,,0,0,0,,你們兩位可能得加強護衛
Dialogue: 0,0:15:33.63,0:15:37.04,Default,,0,0,0,,今天有公會負責人們的定期會議
Dialogue: 0,0:15:37.04,0:15:40.17,Default,,0,0,0,,他們給我時間在會議上討論這件事
Dialogue: 0,0:15:40.17,0:15:43.00,Default,,0,0,0,,我會陪他一起去
Dialogue: 0,0:15:43.00,0:15:44.58,Default,,0,0,0,,我要說的就這些
Dialogue: 0,0:15:44.58,0:15:46.21,Default,,0,0,0,,麻煩大家了
Dialogue: 0,0:15:46.21,0:15:47.46,Default,,0,0,0,,是
Dialogue: 0,0:15:48.17,0:15:50.50,Default,,0,0,0,,我就開門見山直說了
Dialogue: 0,0:15:50.50,0:15:51.38,Default,,0,0,0,,龍馬
Dialogue: 0,0:15:51.38,0:15:53.13,Default,,0,0,0,,你先暫時加強身邊的保全
Dialogue: 0,0:15:53.13,0:15:54.42,Default,,0,0,0,,忍耐一下
Dialogue: 0,0:15:54.42,0:15:57.13,Default,,0,0,0,,請問這是什麼意思
Dialogue: 0,0:15:57.13,0:15:59.50,Default,,0,0,0,,自從傳出我們的惡評之後
Dialogue: 0,0:15:59.50,0:16:01.88,Default,,0,0,0,,我們也做了很多的調查
Dialogue: 0,0:16:01.88,0:16:06.00,Default,,0,0,0,,有一個傢伙會像昨晚那樣攻擊你
Dialogue: 0,0:16:06.00,0:16:09.50,Default,,0,0,0,,你只要盡全力保護店和自己就好
Dialogue: 0,0:16:09.50,0:16:11.67,Default,,0,0,0,,我們會負責抓犯人
Dialogue: 0,0:16:11.67,0:16:13.08,Default,,0,0,0,,我知道了
Dialogue: 0,0:16:13.08,0:16:14.29,Default,,0,0,0,,不過
Dialogue: 0,0:16:14.29,0:16:16.71,Default,,0,0,0,,我希望店裡的保全能做到萬無一失
Dialogue: 0,0:16:16.71,0:16:18.46,Default,,0,0,0,,我當然會幫你
Dialogue: 0,0:16:18.46,0:16:22.38,Default,,0,0,0,,傑夫也向我推薦了\N一位值得信賴的男人
Dialogue: 0,0:16:22.38,0:16:24.71,Default,,0,0,0,,店長的護衛該怎麼辦
Dialogue: 0,0:16:25.29,0:16:27.42,Default,,0,0,0,,我一個人也不要緊
Dialogue: 0,0:16:27.42,0:16:29.08,Default,,0,0,0,,我說你
Dialogue: 0,0:16:29.08,0:16:30.83,Default,,0,0,0,,如果你對自己的能力有自信
Dialogue: 0,0:16:30.83,0:16:34.25,Default,,0,0,0,,我有一個\N能不讓你被攻擊的好辦法喔
Dialogue: 0,0:16:34.25,0:16:35.46,Default,,0,0,0,,什麼
Dialogue: 0,0:16:36.17,0:16:37.04,Default,,0,0,0,,快逃
Dialogue: 0,0:16:37.04,0:16:38.42,Default,,0,0,0,,憑我們是贏不了的
Dialogue: 0,0:16:44.67,0:16:47.21,Default,,0,0,0,,等…等一下 我投降
Dialogue: 0,0:16:47.21,0:16:49.29,Default,,0,0,0,,非常抱歉
Dialogue: 0,0:16:49.29,0:16:50.79,Default,,0,0,0,,還請你見諒
Dialogue: 0,0:16:55.17,0:16:57.92,Default,,0,0,0,,今天久違地解決了好多人
Dialogue: 0,0:16:58.92,0:17:00.33,Default,,0,0,0,,辛苦你們了
Dialogue: 0,0:17:01.54,0:17:03.33,Default,,0,0,0,,今天是這些傢伙嗎
Dialogue: 0,0:17:03.33,0:17:05.21,Default,,0,0,0,,勞煩你們了
Dialogue: 0,0:17:06.17,0:17:07.79,Default,,0,0,0,,中級空間魔法
Dialogue: 0,0:17:12.79,0:17:15.33,Default,,0,0,0,,中級回復魔法一次是一千斯特
Dialogue: 0,0:17:15.33,0:17:17.50,Default,,0,0,0,,所有人加起來是72次
Dialogue: 0,0:17:17.50,0:17:19.63,Default,,0,0,0,,總共是七萬兩千斯特
Dialogue: 0,0:17:20.42,0:17:21.88,Default,,0,0,0,,我稍微算你們便宜一點
Dialogue: 0,0:17:21.88,0:17:23.71,Default,,0,0,0,,付我七萬就行了
Dialogue: 0,0:17:27.96,0:17:29.83,Default,,0,0,0,,代價真高呢
Dialogue: 0,0:17:29.83,0:17:31.75,Default,,0,0,0,,因為他是正當防衛
Dialogue: 0,0:17:31.92,0:17:35.71,Default,,0,0,0,,他們不只吃了悶虧\N還被索討治療費的傳聞
Dialogue: 0,0:17:35.71,0:17:37.67,Default,,0,0,0,,好像已經傳得滿廣的
Dialogue: 0,0:17:38.21,0:17:41.58,Default,,0,0,0,,這是古麗希艾拉女士的主意
Dialogue: 0,0:17:41.58,0:17:43.21,Default,,0,0,0,,因為做法有點強硬
Dialogue: 0,0:17:43.21,0:17:45.38,Default,,0,0,0,,一開始我還有點抗拒
Dialogue: 0,0:17:46.33,0:17:48.21,Default,,0,0,0,,這是今天的份 總共七萬斯特
Dialogue: 0,0:17:48.21,0:17:50.38,Default,,0,0,0,,好 謝謝你
Dialogue: 0,0:17:50.38,0:17:51.63,Default,,0,0,0,,別在意
Dialogue: 0,0:17:51.63,0:17:53.42,Default,,0,0,0,,我們只是暫時代墊費用
Dialogue: 0,0:17:53.42,0:17:55.04,Default,,0,0,0,,並不是自掏腰包
Dialogue: 0,0:17:55.04,0:17:56.79,Default,,0,0,0,,為了支付費用的強制勞動
Dialogue: 0,0:17:56.79,0:17:58.79,Default,,0,0,0,,也能讓人改過自新
Dialogue: 0,0:17:58.79,0:18:01.46,Default,,0,0,0,,對他們來說並非全是壞事
Dialogue: 0,0:18:01.92,0:18:04.29,Default,,0,0,0,,聽到你這麼說 我就放心了
Dialogue: 0,0:18:06.79,0:18:09.58,Default,,0,0,0,,那麼 開始進行今天的訓練
Dialogue: 0,0:18:09.58,0:18:12.25,Default,,0,0,0,,來吧 我是流氓冒險者
Dialogue: 0,0:18:12.25,0:18:13.58,Default,,0,0,0,,我要開始鬧事了
Dialogue: 0,0:18:14.67,0:18:16.42,Default,,0,0,0,,多爾切先生
Dialogue: 0,0:18:20.54,0:18:23.21,Default,,0,0,0,,哎呀 這下糟了
Dialogue: 0,0:18:23.88,0:18:25.13,Default,,0,0,0,,接招
Dialogue: 0,0:18:25.13,0:18:27.33,Default,,0,0,0,,看我的
Dialogue: 0,0:18:27.33,0:18:27.83,Default,,0,0,0,,可惡
Dialogue: 0,0:18:27.83,0:18:29.33,Default,,0,0,0,,好了 結束
Dialogue: 0,0:18:29.33,0:18:31.08,Default,,0,0,0,,結束了
Dialogue: 0,0:18:31.08,0:18:33.21,Default,,0,0,0,,多爾切先生 你覺得怎麼樣
Dialogue: 0,0:18:33.21,0:18:35.67,Default,,0,0,0,,我認為行動很流暢
Dialogue: 0,0:18:35.67,0:18:36.92,Default,,0,0,0,,還不錯
Dialogue: 0,0:18:36.92,0:18:38.50,Default,,0,0,0,,看來是沒問題了
Dialogue: 0,0:18:38.50,0:18:40.21,Default,,0,0,0,,大家別忘了這種感覺
Dialogue: 0,0:18:40.21,0:18:41.58,Default,,0,0,0,,好耶
Dialogue: 0,0:18:41.58,0:18:42.92,Default,,0,0,0,,多爾切先生
Dialogue: 0,0:18:42.92,0:18:45.83,Default,,0,0,0,,是傑夫先生介紹來的保鑣
Dialogue: 0,0:18:46.67,0:18:49.04,Default,,0,0,0,,是個有點冷漠但認真的人
Dialogue: 0,0:18:49.04,0:18:50.50,Default,,0,0,0,,很可靠
Dialogue: 0,0:18:50.71,0:18:53.04,Default,,0,0,0,,我們端午餐過來了
Dialogue: 0,0:18:56.83,0:18:57.71,Default,,0,0,0,,奇怪
Dialogue: 0,0:18:57.71,0:19:00.29,Default,,0,0,0,,這個麵包 比平常還要鬆軟
Dialogue: 0,0:19:01.50,0:19:03.96,Default,,0,0,0,,店長之前說的天然酵母
Dialogue: 0,0:19:03.96,0:19:06.17,Default,,0,0,0,,我請菲娜她們做出來了
Dialogue: 0,0:19:07.71,0:19:09.88,Default,,0,0,0,,維也納香腸也超好吃的
Dialogue: 0,0:19:09.88,0:19:12.50,Default,,0,0,0,,那個啊 是附近的肉店
Dialogue: 0,0:19:12.50,0:19:16.17,Default,,0,0,0,,送來祝賀店長\N和利穆爾鳥締結契約的禮物
Dialogue: 0,0:19:16.17,0:19:19.00,Default,,0,0,0,,新的謠言正在傳開
Dialogue: 0,0:19:19.00,0:19:20.75,Default,,0,0,0,,謝謝你 卡爾姆先生
Dialogue: 0,0:19:21.67,0:19:23.75,Default,,0,0,0,,吃得到食材的鮮美滋味
Dialogue: 0,0:19:23.75,0:19:25.67,Default,,0,0,0,,真不愧是謝爾瑪小姐
Dialogue: 0,0:19:25.67,0:19:28.13,Default,,0,0,0,,是因為我用店長給的炭烤的吧
Dialogue: 0,0:19:29.13,0:19:31.17,Default,,0,0,0,,我也這麼認為
Dialogue: 0,0:19:31.17,0:19:32.50,Default,,0,0,0,,每樣都很好吃
Dialogue: 0,0:19:32.50,0:19:33.58,Default,,0,0,0,,天啊
Dialogue: 0,0:19:33.58,0:19:36.71,Default,,0,0,0,,我好像第一次聽到\N多爾切先生對料理發表了感想
Dialogue: 0,0:19:37.63,0:19:38.38,Default,,0,0,0,,艾莉亞
Dialogue: 0,0:19:38.38,0:19:42.08,Default,,0,0,0,,這次的防盜訓練\N有了意想不到的收穫
Dialogue: 0,0:19:42.83,0:19:45.79,Default,,0,0,0,,那就是店員們的互動變得更多
Dialogue: 0,0:19:46.67,0:19:48.75,Default,,0,0,0,,只要延續這種風氣
Dialogue: 0,0:19:48.75,0:19:50.29,Default,,0,0,0,,二號店也能…
Dialogue: 0,0:19:50.92,0:19:52.21,Default,,0,0,0,,店長
Dialogue: 0,0:19:52.21,0:19:53.29,Default,,0,0,0,,什麼事
Dialogue: 0,0:19:53.29,0:19:56.21,Default,,0,0,0,,我想請您看看這個
Dialogue: 0,0:19:57.29,0:19:59.21,Default,,0,0,0,,收支報告書
Dialogue: 0,0:19:59.21,0:20:02.29,Default,,0,0,0,,營收正在順利成長
Dialogue: 0,0:20:02.29,0:20:03.79,Default,,0,0,0,,居然這麼多
Dialogue: 0,0:20:03.79,0:20:06.13,Default,,0,0,0,,新來的三位候補店長
Dialogue: 0,0:20:06.13,0:20:08.00,Default,,0,0,0,,該學的記帳方法
Dialogue: 0,0:20:08.00,0:20:10.33,Default,,0,0,0,,也已經學習完畢
Dialogue: 0,0:20:10.33,0:20:13.25,Default,,0,0,0,,聽說瑪利亞小姐\N透過蘿貝莉亞小姐的講解
Dialogue: 0,0:20:13.25,0:20:16.13,Default,,0,0,0,,學會了從魔魔法的基礎
Dialogue: 0,0:20:16.13,0:20:20.50,Default,,0,0,0,,店裡的大家\N都比我期望的還要努力
Dialogue: 0,0:20:20.50,0:20:24.50,Default,,0,0,0,,我的身邊\N也有很多人對我寄予厚望
Dialogue: 0,0:20:24.50,0:20:27.17,Default,,0,0,0,,這些都反饋在營收數字上
Dialogue: 0,0:20:27.17,0:20:30.17,Default,,0,0,0,,開始推動二號店的開店計劃吧
Dialogue: 0,0:20:31.13,0:20:32.71,Default,,0,0,0,,我知道了
Dialogue: 0,0:20:34.00,0:20:35.13,Default,,0,0,0,,打擾了
Dialogue: 0,0:20:37.50,0:20:41.54,Default,,0,0,0,,你已經不用再擔心會遭到攻擊
Dialogue: 0,0:20:41.54,0:20:44.42,Default,,0,0,0,,所以我猜你也差不多該來了
Dialogue: 0,0:20:49.83,0:20:51.83,Default,,0,0,0,,你要找二號店的店面吧
Dialogue: 0,0:20:51.83,0:20:53.63,Default,,0,0,0,,這些隨你挑
Dialogue: 0,0:20:53.63,0:20:55.21,Default,,0,0,0,,謝謝
Dialogue: 0,0:20:58.25,0:20:59.67,Default,,0,0,0,,是艾莉亞寄來的
Dialogue: 0,0:21:03.58,0:21:05.54,Default,,0,0,0,,龍馬先生
Dialogue: 0,0:21:05.54,0:21:07.63,Default,,0,0,0,,你現在是不是正在努力經營店鋪
Dialogue: 0,0:21:07.63,0:21:10.92,Default,,0,0,0,,以及研究史萊姆呢
Dialogue: 0,0:21:11.83,0:21:15.54,Default,,0,0,0,,我為了到王都的學園上課
Dialogue: 0,0:21:15.54,0:21:17.67,Default,,0,0,0,,正在努力預習
Dialogue: 0,0:21:19.54,0:21:23.25,Default,,0,0,0,,不只聽課 我也有在做魔法訓練喔
Dialogue: 0,0:21:26.63,0:21:28.54,Default,,0,0,0,,疲勞時候的休息時間
Dialogue: 0,0:21:28.54,0:21:32.33,Default,,0,0,0,,我會用你教我的肥皂水吹泡泡玩
Dialogue: 0,0:21:33.71,0:21:37.21,Default,,0,0,0,,龍馬先生也別忘了休息喔
Dialogue: 0,0:21:39.83,0:21:40.88,Default,,0,0,0,,艾莉亞
Dialogue: 0,0:21:40.88,0:21:44.13,Default,,0,0,0,,我可能還要過些時候才能休息了
Dialogue: 0,0:21:53.46,0:21:55.17,Default,,0,0,0,,那我走了
Dialogue: 0,0:21:55.17,0:21:57.13,Default,,0,0,0,,祝您一路順風
Dialogue: 0,0:22:03.71,0:22:05.04,Default,,0,0,0,,走吧
Dialogue: 0,0:22:05.04,0:22:07.21,Default,,0,0,0,,為了開設二號店
Dialogue: 0,0:22:07.21,0:22:08.88,Default,,0,0,0,,前往新的城鎮
Dialogue: 0,0:22:21.20,0:22:24.49,EDJP,,0,0,0,,センサーライト音沙汰なくて
Dialogue: 0,0:22:24.72,0:22:30.72,EDJP,,0,0,0,,この部屋にわたしがいないみたいだ
Dialogue: 0,0:22:31.21,0:22:33.75,EDJP,,0,0,0,,＃にフィグジャムをつけたら
Dialogue: 0,0:22:33.75,0:22:35.90,EDJP,,0,0,0,,バスタブに泡をたてて
Dialogue: 0,0:22:35.90,0:22:42.96,EDJP,,0,0,0,,よみがえるの 明日のため…Undead!!
Dialogue: 0,0:22:50.87,0:22:53.35,EDJP,,0,0,0,,なくはないの あなたとなら
Dialogue: 0,0:22:53.35,0:22:56.04,EDJP,,0,0,0,,巡り巡る 機械と水
Dialogue: 0,0:22:56.04,0:22:59.72,EDJP,,0,0,0,,ドラム式の宇宙をそっと 見つめて
Dialogue: 0,0:23:00.20,0:23:05.03,EDJP,,0,0,0,,口説きたいな Ah死ぬまで
Dialogue: 0,0:23:05.03,0:23:10.12,EDJP,,0,0,0,,弧を描いた solarの果て
Dialogue: 0,0:23:10.12,0:23:12.91,EDJP,,0,0,0,,愛は少しくたびれて
Dialogue: 0,0:23:12.91,0:23:15.42,EDJP,,0,0,0,,遠ざかりつつあるわ
Dialogue: 0,0:23:15.42,0:23:18.19,EDJP,,0,0,0,,n時発の小惑星で行くの
Dialogue: 0,0:23:18.19,0:23:22.19,EDJP,,0,0,0,,あなた 夢抱いて
Dialogue: 0,0:23:22.35,0:23:29.92,EDJP,,0,0,0,,抱いて 抱いて 抱いて
Dialogue: 0,0:23:29.92,0:23:34.75,EDJP,,0,0,0,,抱いて 抱いて
Dialogue: 0,0:22:21.20,0:22:24.49,EDCN,,0,0,0,,探測光線 未發出聲音
Dialogue: 0,0:22:24.72,0:22:30.72,EDCN,,0,0,0,,似乎我並不在這間房內
Dialogue: 0,0:22:31.21,0:22:33.75,EDCN,,0,0,0,,在#後面輸入FigJam
Dialogue: 0,0:22:33.75,0:22:35.90,EDCN,,0,0,0,,浴缸裡充滿了泡沫
Dialogue: 0,0:22:35.90,0:22:42.96,EDCN,,0,0,0,,為了明天再一次醒來……Undead!!
Dialogue: 0,0:22:50.87,0:22:53.35,EDCN,,0,0,0,,若與你同在 便完美無缺
Dialogue: 0,0:22:53.35,0:22:56.04,EDCN,,0,0,0,,循環著循環著 機器和水
Dialogue: 0,0:22:56.04,0:22:59.72,EDCN,,0,0,0,,悄悄地凝望 滾筒式的宇宙
Dialogue: 0,0:23:00.20,0:23:05.03,EDCN,,0,0,0,,我想要述懷 Ah 到死之前
Dialogue: 0,0:23:05.03,0:23:10.12,EDCN,,0,0,0,,劃一道弧線 至太陽系盡頭
Dialogue: 0,0:23:10.12,0:23:12.91,EDCN,,0,0,0,,愛也是略顯疲態
Dialogue: 0,0:23:12.91,0:23:15.42,EDCN,,0,0,0,,越來越遠了啊
Dialogue: 0,0:23:15.42,0:23:18.19,EDCN,,0,0,0,,坐上n時發的小行星出發了
Dialogue: 0,0:23:18.19,0:23:22.19,EDCN,,0,0,0,,而你 懷著夢
Dialogue: 0,0:23:22.35,0:23:29.92,EDCN,,0,0,0,,懷著夢 懷著夢 懷著夢
Dialogue: 0,0:23:29.92,0:23:34.75,EDCN,,0,0,0,,懷著夢 懷著夢

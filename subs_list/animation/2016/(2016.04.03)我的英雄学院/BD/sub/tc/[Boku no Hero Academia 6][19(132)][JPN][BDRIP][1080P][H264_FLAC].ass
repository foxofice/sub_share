Dialogue: 1,0:00:02.75,0:00:07.20,Default2,,0,0,0,,我想了想 覺得應該把自己的秘密
Dialogue: 0,0:00:02.75,0:00:07.20,Default,,0,0,0,,告訴A班的大家
Dialogue: 0,0:00:07.20,0:00:10.41,Default,,0,0,0,,才會寫這封信給妳
Dialogue: 1,0:00:10.41,0:00:15.00,Default2,,0,0,0,,我的力量是歐爾麥特傳給我的
Dialogue: 0,0:00:10.41,0:00:15.00,Default,,0,0,0,,性質很特殊
Dialogue: 1,0:00:15.00,0:00:19.83,Default2,,0,0,0,,死柄木跟All for one
Dialogue: 0,0:00:15.00,0:00:19.83,Default,,0,0,0,,更以我為目標展開行動…
Dialogue: 0,0:00:19.83,0:00:24.16,Default,,0,0,0,,再這樣下去 肯定會把大家也捲進來
Dialogue: 0,0:00:24.16,0:00:27.58,Default,,0,0,0,,所以 我決定離開雄英高中
Dialogue: 0,0:00:28.54,0:00:30.70,Default,,0,0,0,,能進英雄科就讀…
Dialogue: 0,0:00:30.70,0:00:33.41,Default,,0,0,0,,能認識A班的大家…
Dialogue: 0,0:00:33.41,0:00:36.12,Default,,0,0,0,,真的讓我很開心…
Dialogue: 0,0:00:36.12,0:00:39.87,Default,,0,0,0,,謝謝妳 再見了
Dialogue: 0,0:00:42.20,0:00:44.04,Default,,0,0,0,,你這混蛋
Dialogue: 0,0:00:45.58,0:00:49.91,Default,,0,0,0,,四月 笨久同學…離開了英雄學院
Dialogue: 1,0:00:50.87,0:00:55.00,Default2,,0,0,0,,跟敵人組織
Dialogue: 0,0:00:50.87,0:00:55.00,Default,,0,0,0,,以及超常解放戰線的那一戰
Dialogue: 0,0:00:55.00,0:00:58.08,Default,,0,0,0,,給日本帶來了相當大規模的災害
Dialogue: 1,0:00:58.08,0:01:04.45,Default2,,0,0,0,,另外 各地的監獄遭到襲擊
Dialogue: 0,0:00:58.08,0:01:04.45,Default,,0,0,0,,許多被關押的敵人逃獄…
Dialogue: 0,0:01:04.45,0:01:08.50,Default,,0,0,0,,備受眾人景仰的英雄聲勢大墜…
Dialogue: 0,0:01:08.50,0:01:12.16,Default,,0,0,0,,日本成為了一個化外之地
Dialogue: 0,0:01:16.53,0:01:18.58,Default,,0,0,0,,巨大的敵人…
Dialogue: 0,0:02:55.45,0:02:58.45,Default,,0,0,0,,各位英雄請注意 這裡是大奈警署
Dialogue: 0,0:02:58.45,0:03:01.79,Default,,0,0,0,,那個逃獄犯昨天出現在南區了
Dialogue: 0,0:03:01.79,0:03:05.04,Default,,0,0,0,,請盡快到各自負責的區域…
Dialogue: 0,0:03:06.33,0:03:09.33,Default,,0,0,0,,我們快點去疏散留下來的居民吧
Dialogue: 1,0:03:10.12,0:03:15.83,Default2,,0,0,0,,傑物學園高中英雄科3年級
Dialogue: 0,0:03:10.12,0:03:15.83,Default,,0,0,0,,真堂搖 英雄名GRAND
Dialogue: 0,0:03:15.83,0:03:19.12,Default,,0,0,0,,現在留下來的人都頑固的不得了
Dialogue: 1,0:03:19.82,0:03:25.70,Default2,,0,0,0,,傑物學園高中英雄科3年級
Dialogue: 0,0:03:19.82,0:03:25.70,Default,,0,0,0,,中瓶疊 英雄名龜頸俠
Dialogue: 1,0:03:25.70,0:03:31.12,Default2,,0,0,0,,也對啦 現在還留在這裡的人
Dialogue: 0,0:03:25.70,0:03:31.12,Default,,0,0,0,,肯定都很頑固吧 所以呢…
Dialogue: 0,0:03:31.82,0:03:35.54,Default,,0,0,0,,要使出笑話老師流 爽朗微笑談判術
Dialogue: 0,0:03:35.54,0:03:37.25,Default,,0,0,0,,感覺沒什麼用
Dialogue: 0,0:03:37.25,0:03:38.79,Default,,0,0,0,,總之要趕快搞定
Dialogue: 0,0:03:38.79,0:03:41.32,Default,,0,0,0,,聽說他們固守在田口大樓 走吧
Dialogue: 0,0:03:41.32,0:03:43.32,Default,,0,0,0,,等等我啦 阿搖
Dialogue: 0,0:03:46.75,0:03:48.75,Default,,0,0,0,,繼警察跟英雄之後…
Dialogue: 0,0:03:48.75,0:03:52.57,Default,,0,0,0,,結果這次換成小孩子過來啊…
Dialogue: 0,0:03:52.57,0:03:54.66,Default,,0,0,0,,沒用的 回去吧
Dialogue: 0,0:03:54.66,0:03:56.20,Default,,0,0,0,,這個地方很危險
Dialogue: 1,0:03:56.20,0:04:00.37,Default2,,0,0,0,,以你們現有的食物跟生活用品
Dialogue: 0,0:03:56.20,0:04:00.37,Default,,0,0,0,,也撐不了多久吧
Dialogue: 0,0:04:00.37,0:04:03.29,Default,,0,0,0,,傑物學園那邊的物資很豐富
Dialogue: 0,0:04:03.29,0:04:06.25,Default,,0,0,0,,所以請快點到那裡避難吧
Dialogue: 1,0:04:07.45,0:04:13.70,Default2,,0,0,0,,要是敵人跑去襲擊人群聚集的地方了
Dialogue: 0,0:04:07.45,0:04:13.70,Default,,0,0,0,,真的有辦法應對嗎
Dialogue: 1,0:04:13.70,0:04:17.79,Default2,,0,0,0,,幾個襲擊我店面的垃圾
Dialogue: 0,0:04:13.70,0:04:17.79,Default,,0,0,0,,全都被我打跑了
Dialogue: 0,0:04:17.79,0:04:20.54,Default,,0,0,0,,總之我們認清現實了
Dialogue: 1,0:04:20.54,0:04:25.95,Default2,,0,0,0,,自己成長的城鎮就由自己保護
Dialogue: 0,0:04:20.54,0:04:25.95,Default,,0,0,0,,不能把性命託給別人
Dialogue: 1,0:04:26.87,0:04:31.70,Default2,,0,0,0,,單純對付想搶錢或物資的人
Dialogue: 0,0:04:26.87,0:04:31.70,Default,,0,0,0,,倒是還有機會可以打贏
Dialogue: 0,0:04:31.70,0:04:35.20,Default,,0,0,0,,但是逃獄犯跟腦無可就不一樣了
Dialogue: 0,0:04:35.20,0:04:38.79,Default,,0,0,0,,昨天這附近傳來一則目擊情報
Dialogue: 1,0:04:38.79,0:04:44.54,Default2,,0,0,0,,有一群人把暴力奉為行動準則
Dialogue: 0,0:04:38.79,0:04:44.54,Default,,0,0,0,,他們根本不是人
Dialogue: 1,0:04:44.54,0:04:48.08,Default2,,0,0,0,,要是有個差錯
Dialogue: 0,0:04:44.54,0:04:48.08,Default,,0,0,0,,就連職業英雄也會死的
Dialogue: 1,0:04:48.08,0:04:51.54,Default2,,0,0,0,,我說過了 比起英雄
Dialogue: 0,0:04:48.08,0:04:51.54,Default,,0,0,0,,我們更相信自己
Dialogue: 1,0:04:51.54,0:04:55.87,Default2,,0,0,0,,所謂的英雄 真的有偉大到能
Dialogue: 0,0:04:51.54,0:04:55.87,Default,,0,0,0,,管別人要怎麼過生活嗎
Dialogue: 1,0:04:55.87,0:05:01.04,Default2,,0,0,0,,我們比你們更擅長戰鬥
Dialogue: 0,0:04:55.87,0:05:01.04,Default,,0,0,0,,請讓我們保護你們吧
Dialogue: 0,0:05:01.04,0:05:04.83,Default,,0,0,0,,我們一直相信這種說辭 但結果呢
Dialogue: 1,0:05:04.83,0:05:10.91,Default2,,0,0,0,,這個轄區的英雄們在那起事件發生後
Dialogue: 0,0:05:04.83,0:05:10.91,Default,,0,0,0,,就一個個夾著尾巴、一溜煙地跑了
Dialogue: 1,0:05:10.91,0:05:14.95,Default2,,0,0,0,,不只是我們這裡
Dialogue: 0,0:05:10.91,0:05:14.95,Default,,0,0,0,,西區跟東區那邊也跑了
Dialogue: 0,0:05:14.95,0:05:18.41,Default,,0,0,0,,虧我們以前一直還把他們捧上天呢
Dialogue: 0,0:05:18.41,0:05:22.29,Default,,0,0,0,,我們的想法沒有交集 回去吧 小鬼
Dialogue: 0,0:05:22.29,0:05:25.20,Default,,0,0,0,,我們不會再依靠英雄了
Dialogue: 1,0:05:26.62,0:05:31.70,Default2,,0,0,0,,根本不行啊 阿搖
Dialogue: 0,0:05:26.62,0:05:31.70,Default,,0,0,0,,根本不行嘛 根本不行嘛
Dialogue: 1,0:05:31.70,0:05:37.15,Default2,,0,0,0,,只要我稍微搖撼一下
Dialogue: 0,0:05:31.70,0:05:37.15,Default,,0,0,0,,那種大樓就會在瞬間崩塌了喔
Dialogue: 1,0:05:37.15,0:05:40.70,Default2,,0,0,0,,要是能強行帶走
Dialogue: 0,0:05:37.15,0:05:40.70,Default,,0,0,0,,我就能硬把他們拖走了
Dialogue: 0,0:05:40.70,0:05:42.12,Default,,0,0,0,,根本不行嘛
Dialogue: 0,0:05:43.54,0:05:46.45,Default,,0,0,0,,不知道通訊基地局還能夠撐多久
Dialogue: 0,0:05:46.45,0:05:48.75,Default,,0,0,0,,是真壁打來的
Dialogue: 0,0:05:48.75,0:05:51.04,Default,,0,0,0,,你們兩個快逃 出現了
Dialogue: 1,0:05:51.04,0:05:54.87,Default2,,0,0,0,,射手次郎剛才用肉眼確認過了
Dialogue: 0,0:05:51.04,0:05:54.87,Default,,0,0,0,,對方正朝著你們過去
Dialogue: 0,0:05:54.87,0:05:57.50,Default,,0,0,0,,我們這邊絕對來不及趕到 快逃啊
Dialogue: 0,0:06:06.16,0:06:07.54,Default,,0,0,0,,要來了
Dialogue: 0,0:06:10.75,0:06:12.20,Default,,0,0,0,,逃獄犯
Dialogue: 0,0:06:13.08,0:06:16.50,Default,,0,0,0,,嗨 我們來玩吧
Dialogue: 1,0:06:17.91,0:06:24.25,Default2,,0,0,0,,就兩個人啊 不太夠耶
Dialogue: 0,0:06:17.91,0:06:24.25,Default,,0,0,0,,你們還有同伴嗎
Dialogue: 1,0:06:24.25,0:06:28.66,Default2,,0,0,0,,疊 馬上請笑話老師來支援
Dialogue: 0,0:06:24.25,0:06:28.66,Default,,0,0,0,,同時幫忙疏散民眾
Dialogue: 0,0:06:28.66,0:06:30.25,Default,,0,0,0,,阿搖你呢
Dialogue: 0,0:06:30.25,0:06:32.15,Default,,0,0,0,,我來解決他
Dialogue: 0,0:06:32.15,0:06:35.29,Default,,0,0,0,,外面的空氣真不錯啊
Dialogue: 0,0:06:35.83,0:06:39.87,Default,,0,0,0,,(全力！！)
Dialogue: 0,0:06:43.90,0:06:46.58,Default,,0,0,0,,我才不會讓你們繼續破壞這個城市…
Dialogue: 0,0:06:46.58,0:06:50.04,Default,,0,0,0,,等一下 他是嗜血狂 非常兇惡
Dialogue: 0,0:06:50.04,0:06:52.37,Default,,0,0,0,,不能跟他戰鬥 快逃啊
Dialogue: 0,0:06:52.37,0:06:55.50,Default,,0,0,0,,誰理妳 我才不聽妳們的指揮
Dialogue: 0,0:06:55.50,0:06:57.58,Default,,0,0,0,,我只是不想看你們死
Dialogue: 0,0:06:59.37,0:07:00.87,Default,,0,0,0,,阿搖
Dialogue: 0,0:07:04.66,0:07:08.29,Default,,0,0,0,,喂…這太不像話了
Dialogue: 0,0:07:11.37,0:07:15.45,Default,,0,0,0,,看到英雄 就要認定旁邊有10個人…
Dialogue: 0,0:07:16.50,0:07:19.29,Default,,0,0,0,,不錯啊 真的有呢
Dialogue: 0,0:07:25.00,0:07:26.58,Default,,0,0,0,,沒用的
Dialogue: 1,0:07:26.58,0:07:34.25,Default2,,0,0,0,,這身肌肉纖維裝甲有1萬2千層
Dialogue: 0,0:07:26.58,0:07:34.25,Default,,0,0,0,,任何力量都打不到我的本體
Dialogue: 0,0:07:34.25,0:07:35.90,Default,,0,0,0,,是嗎
Dialogue: 1,0:07:35.90,0:07:40.12,Default2,,0,0,0,,用了最大輸出之後
Dialogue: 0,0:07:35.90,0:07:40.12,Default,,0,0,0,,我會有一段時間不能動彈…
Dialogue: 0,0:07:40.12,0:07:41.37,Default,,0,0,0,,但是
Dialogue: 0,0:07:42.25,0:07:45.62,Default,,0,0,0,,人有的時候就是必須拚上性命才行
Dialogue: 1,0:07:45.62,0:07:51.12,Default2,,0,0,0,,不屈不撓的心
Dialogue: 0,0:07:45.62,0:07:51.12,Default,,0,0,0,,正是今後的英雄應該具備的素養
Dialogue: 1,0:07:51.90,0:07:54.62,Default2,,0,0,0,,(震傳動地)
Dialogue: 0,0:07:51.90,0:07:54.62,Default,,0,0,0,,腦子準備變成奶昔吧
Dialogue: 0,0:07:58.37,0:08:03.37,Default,,0,0,0,,那麼…我只要增加裝甲就可以了啊
Dialogue: 0,0:08:03.37,0:08:04.70,Default,,0,0,0,,阿搖
Dialogue: 0,0:08:04.70,0:08:06.25,Default,,0,0,0,,我們去救那個小鬼
Dialogue: 0,0:08:07.04,0:08:09.50,Default,,0,0,0,,我想想喔…
Dialogue: 0,0:08:09.50,0:08:12.04,Default,,0,0,0,,準備血祭了
Dialogue: 0,0:08:23.25,0:08:24.79,Default,,0,0,0,,爆肌…
Dialogue: 0,0:08:25.75,0:08:29.91,Default,,0,0,0,,難怪4th 危機感知會響個不停
Dialogue: 0,0:08:33.00,0:08:36.03,Default,,0,0,0,,這個聲音是…
Dialogue: 1,0:08:36.03,0:08:40.58,Default2,,0,0,0,,我怎麼可能忘得了
Dialogue: 0,0:08:36.03,0:08:40.58,Default,,0,0,0,,就是你吧 對不對
Dialogue: 0,0:08:40.58,0:08:43.95,Default,,0,0,0,,你是綠谷 我很想見你呢
Dialogue: 1,0:08:43.95,0:08:49.00,Default2,,0,0,0,,老是面對一些雜碎
Dialogue: 0,0:08:43.95,0:08:49.00,Default,,0,0,0,,我一直覺得不夠啊 很不夠
Dialogue: 0,0:08:50.62,0:08:53.45,Default,,0,0,0,,等等…你可別想逃喔
Dialogue: 0,0:08:53.45,0:08:54.54,Default,,0,0,0,,不是的 你不要搞錯喔
Dialogue: 0,0:08:54.54,0:09:00.20,Default,,0,0,0,,這可不是什麼復仇那種了不起的行動
Dialogue: 0,0:09:00.20,0:09:04.12,Default,,0,0,0,,畢竟我也是人類嘛
Dialogue: 0,0:09:04.12,0:09:07.95,Default,,0,0,0,,既然嚐到了那個時候的快感…
Dialogue: 0,0:09:08.58,0:09:11.54,Default,,0,0,0,,就沒辦法回頭了
Dialogue: 0,0:09:13.41,0:09:15.33,Default,,0,0,0,,他的跳躍力不夠嗎
Dialogue: 0,0:09:18.79,0:09:22.79,Default,,0,0,0,,全力打一場吧 綠谷
Dialogue: 0,0:09:25.70,0:09:28.50,Default,,0,0,0,,發生什麼事 到處都是煙 看不到啊
Dialogue: 0,0:09:32.75,0:09:34.37,Default,,0,0,0,,太好了
Dialogue: 0,0:09:34.37,0:09:35.66,Default,,0,0,0,,就麻煩妳照顧他了
Dialogue: 0,0:09:35.66,0:09:36.91,Default,,0,0,0,,阿搖
Dialogue: 0,0:09:36.91,0:09:39.79,Default,,0,0,0,,阿搖 你這個笨蛋
Dialogue: 0,0:09:39.79,0:09:41.70,Default,,0,0,0,,不好意思我沒及時趕到
Dialogue: 0,0:09:42.54,0:09:44.08,Default,,0,0,0,,請馬上幫他治療
Dialogue: 1,0:09:44.08,0:09:49.62,Default2,,0,0,0,,建築物的受損程度也很嚴重…
Dialogue: 0,0:09:44.08,0:09:49.62,Default,,0,0,0,,之後我會控制在零損害的
Dialogue: 0,0:09:49.62,0:09:51.16,Default,,0,0,0,,好
Dialogue: 0,0:09:51.16,0:09:53.91,Default,,0,0,0,,煙讓我看不到對方的樣子
Dialogue: 0,0:09:53.91,0:09:57.62,Default,,0,0,0,,但是 這個聲音我好像在哪裡聽過…
Dialogue: 0,0:09:57.62,0:09:59.20,Default,,0,0,0,,是誰
Dialogue: 0,0:09:59.83,0:10:01.45,Default,,0,0,0,,可能有點太多了…
Dialogue: 1,0:10:01.45,0:10:06.20,Default2,,0,0,0,,是啊 已經超過控制範圍了
Dialogue: 0,0:10:01.45,0:10:06.20,Default,,0,0,0,,放出太多煙幕
Dialogue: 0,0:10:06.20,0:10:06.95,Default,,0,0,0,,是
Dialogue: 1,0:10:06.95,0:10:10.54,Default2,,0,0,0,,我說過要是被反過來利用
Dialogue: 0,0:10:06.95,0:10:10.54,Default,,0,0,0,,就會得不償失了吧
Dialogue: 0,0:10:10.54,0:10:11.95,Default,,0,0,0,,是…
Dialogue: 1,0:10:11.95,0:10:19.04,Default2,,0,0,0,,因為受到OFA影響 才不好調節拿捏
Dialogue: 0,0:10:11.95,0:10:19.04,Default,,0,0,0,,畢竟這是傳承8代培養至今的能力
Dialogue: 1,0:10:19.04,0:10:25.45,Default2,,0,0,0,,能力的強大程度與控制的困難度
Dialogue: 0,0:10:19.04,0:10:25.45,Default,,0,0,0,,到了第9代…肯定是最高的
Dialogue: 0,0:10:25.45,0:10:28.16,Default,,0,0,0,,所以這時你要反過來放輕鬆
Dialogue: 1,0:10:28.16,0:10:32.91,Default2,,0,0,0,,我們的個性幾乎都是單獨使用
Dialogue: 0,0:10:28.16,0:10:32.91,Default,,0,0,0,,沒有辦法成為必殺技
Dialogue: 0,0:10:32.91,0:10:36.04,Default,,0,0,0,,你實在太過尊重個性了
Dialogue: 0,0:10:36.04,0:10:38.25,Default,,0,0,0,,把個性當成是一種工具
Dialogue: 0,0:10:39.75,0:10:43.20,Default,,0,0,0,,利用這些工具 組成攻略的手段吧
Dialogue: 0,0:10:44.08,0:10:48.58,Default,,0,0,0,,爆肌 是能承受百分百爆碎風的男人
Dialogue: 0,0:10:49.66,0:10:51.62,Default,,0,0,0,,我也忘不了這個人
Dialogue: 0,0:10:55.41,0:10:56.91,Default,,0,0,0,,7th…
Dialogue: 0,0:10:57.83,0:10:59.33,Default,,0,0,0,,浮游
Dialogue: 0,0:10:59.33,0:11:03.70,Default,,0,0,0,,6th…用煙幕縮小視野 加以誘導
Dialogue: 0,0:11:03.70,0:11:07.41,Default,,0,0,0,,好了出久 喚醒那天的記憶吧
Dialogue: 0,0:11:09.29,0:11:11.58,Default,,0,0,0,,綠谷
Dialogue: 0,0:11:11.58,0:11:14.70,Default,,0,0,0,,4th 用危機感知補強預測
Dialogue: 0,0:11:14.70,0:11:16.79,Default,,0,0,0,,5th 黑鞭
Dialogue: 0,0:11:24.54,0:11:26.29,Default,,0,0,0,,耍什麼小花招…
Dialogue: 1,0:11:26.95,0:11:32.00,Default2,,0,0,0,,放你出來的死柄木與AFO
Dialogue: 0,0:11:26.95,0:11:32.00,Default,,0,0,0,,現在在哪裡
Dialogue: 1,0:11:32.00,0:11:37.33,Default2,,0,0,0,,不知道 他們只跟我說了一句
Dialogue: 0,0:11:32.00,0:11:37.33,Default,,0,0,0,,"隨便你去玩吧"
Dialogue: 0,0:11:37.33,0:11:40.75,Default,,0,0,0,,不要轉移焦點喔 這樣太掃興了…
Dialogue: 0,0:11:40.75,0:11:44.75,Default,,0,0,0,,還有這種小花招…真的很無聊
Dialogue: 1,0:11:44.75,0:11:49.16,Default2,,0,0,0,,就讓我們像那天一樣用盡全力
Dialogue: 0,0:11:44.75,0:11:49.16,Default,,0,0,0,,正面碰撞吧
Dialogue: 0,0:11:52.29,0:11:55.00,Default,,0,0,0,,為什麼你就這麼想做亂呢
Dialogue: 0,0:11:55.00,0:11:58.41,Default,,0,0,0,,因為不想讓人生留下悔恨啊
Dialogue: 0,0:11:58.41,0:12:01.00,Default,,0,0,0,,悔恨…是什麼呢
Dialogue: 0,0:12:01.00,0:12:05.08,Default,,0,0,0,,就是沒辦法盡情體驗這種快感啊
Dialogue: 1,0:12:05.08,0:12:09.04,Default2,,0,0,0,,難道就沒有別的路可走了嗎
Dialogue: 0,0:12:05.08,0:12:09.04,Default,,0,0,0,,今筋強斗
Dialogue: 0,0:12:10.08,0:12:11.95,Default,,0,0,0,,完全沒有
Dialogue: 1,0:12:13.29,0:12:18.62,Default2,,0,0,0,,難道你是在同情我嗎
Dialogue: 0,0:12:13.29,0:12:18.62,Default,,0,0,0,,還是把同情心留給別人吧
Dialogue: 0,0:12:18.62,0:12:23.87,Default,,0,0,0,,因為我心中就只有 血還有鬥爭而已
Dialogue: 1,0:12:24.41,0:12:29.70,Default2,,0,0,0,,我並不知道他們到底為什麼
Dialogue: 0,0:12:24.41,0:12:29.70,Default,,0,0,0,,會變成那個樣子
Dialogue: 1,0:12:31.00,0:12:35.41,Default2,,0,0,0,,如果我早一點知道
Dialogue: 0,0:12:31.00,0:12:35.41,Default,,0,0,0,,或許就有所不同了
Dialogue: 0,0:12:36.83,0:12:40.79,Default,,0,0,0,,傷害許多人 殺人如麻的人
Dialogue: 1,0:12:42.83,0:12:47.16,Default2,,0,0,0,,不管是以什麼形式
Dialogue: 0,0:12:42.83,0:12:47.16,Default,,0,0,0,,或是還是免不了要一戰
Dialogue: 0,0:12:47.16,0:12:50.66,Default,,0,0,0,,使出全力啊 綠谷
Dialogue: 1,0:12:50.66,0:12:54.91,Default2,,0,0,0,,但是 至少我…
Dialogue: 0,0:12:50.66,0:12:54.91,Default,,0,0,0,,能知道他內心深處…
Dialogue: 0,0:12:54.91,0:12:58.33,Default,,0,0,0,,你變成一個無聊的男人了
Dialogue: 0,0:13:01.16,0:13:03.33,Default,,0,0,0,,肌肉補足產生的間隔…
Dialogue: 1,0:13:04.41,0:13:08.79,Default2,,0,0,0,,消耗掉力量的肌肉…
Dialogue: 0,0:13:04.41,0:13:08.79,Default,,0,0,0,,會自然剝落 又或是被扯落
Dialogue: 0,0:13:09.70,0:13:12.91,Default,,0,0,0,,討厭策略的傢伙居然特地跳到樓下…
Dialogue: 0,0:13:13.95,0:13:16.95,Default,,0,0,0,,該不會是沒掌握好肌肉補足的感覺
Dialogue: 1,0:13:19.00,0:13:22.75,Default2,,0,0,0,,還是在不知不覺間受過
Dialogue: 0,0:13:19.00,0:13:22.75,Default,,0,0,0,,振動的訓練
Dialogue: 0,0:13:22.75,0:13:25.20,Default,,0,0,0,,別耍小聰明
Dialogue: 0,0:13:26.37,0:13:29.20,Default,,0,0,0,,One for all 全覆式
Dialogue: 0,0:13:29.20,0:13:31.95,Default,,0,0,0,,衝擊45%
Dialogue: 0,0:13:34.75,0:13:36.91,Default,,0,0,0,,底特律爆碎風
Dialogue: 0,0:13:41.12,0:13:44.58,Default,,0,0,0,,這也是…我的全力
Dialogue: 0,0:13:53.79,0:13:56.12,Default,,0,0,0,,真堂跟中瓶在哪裡…
Dialogue: 1,0:13:56.91,0:14:02.33,Default2,,0,0,0,,傑物學園高中三年級
Dialogue: 0,0:13:56.91,0:14:02.33,Default,,0,0,0,,投擲射手次郎 英雄名迴旋鏢俠
Dialogue: 1,0:14:03.08,0:14:08.70,Default2,,0,0,0,,傑物學園高中三年級
Dialogue: 0,0:14:03.08,0:14:08.70,Default,,0,0,0,,真壁漆喰 英雄名Mr.史密斯
Dialogue: 0,0:14:08.70,0:14:10.16,Default,,0,0,0,,喂 看那邊
Dialogue: 0,0:14:13.25,0:14:15.12,Default,,0,0,0,,是逃獄犯…
Dialogue: 0,0:14:18.20,0:14:20.75,Default,,0,0,0,,我還沒跟他道謝呢
Dialogue: 0,0:14:22.37,0:14:24.50,Default,,0,0,0,,小姐 這個借妳
Dialogue: 0,0:14:26.12,0:14:28.16,Default,,0,0,0,,妳一個人搬很吃力吧
Dialogue: 0,0:14:28.16,0:14:29.75,Default,,0,0,0,,去開車過來
Dialogue: 0,0:14:29.75,0:14:31.41,Default,,0,0,0,,預備
Dialogue: 0,0:14:32.45,0:14:34.08,Default,,0,0,0,,為什麼…
Dialogue: 0,0:14:34.08,0:14:37.20,Default,,0,0,0,,我們也不想讓他死掉
Dialogue: 0,0:14:37.20,0:14:40.75,Default,,0,0,0,,不好好聽他說話 會遭天譴的
Dialogue: 0,0:14:43.91,0:14:47.87,Default,,0,0,0,,他是…臨時證照時的那位…
Dialogue: 1,0:14:48.83,0:14:55.54,Default2,,0,0,0,,可是…他給人的感覺實在差太多了…
Dialogue: 0,0:14:48.83,0:14:55.54,Default,,0,0,0,,真的是那個男生嗎
Dialogue: 0,0:14:56.50,0:15:00.16,Default,,0,0,0,,(大奈警察署)
Dialogue: 0,0:15:00.16,0:15:02.45,Default,,0,0,0,,站住 你要做什麼
Dialogue: 0,0:15:03.37,0:15:05.70,Default,,0,0,0,,這裡有移動式牢房吧
Dialogue: 0,0:15:05.70,0:15:07.16,Default,,0,0,0,,移動式牢房
Dialogue: 0,0:15:08.25,0:15:11.33,Default,,0,0,0,,他不是…是逃獄犯
Dialogue: 0,0:15:11.33,0:15:13.16,Default,,0,0,0,,麻煩您把他關起來
Dialogue: 0,0:15:14.54,0:15:15.66,Default,,0,0,0,,等等
Dialogue: 0,0:15:19.62,0:15:22.83,Default,,0,0,0,,4th 目前危機感知相當穩定
Dialogue: 0,0:15:23.62,0:15:26.20,Default,,0,0,0,,歐爾麥特 我要回去了
Dialogue: 0,0:15:38.08,0:15:39.20,Default,,0,0,0,,有受傷嗎
Dialogue: 0,0:15:39.20,0:15:41.37,Default,,0,0,0,,我…我沒事
Dialogue: 0,0:15:41.37,0:15:42.37,Default,,0,0,0,,手腳呢
Dialogue: 0,0:15:43.08,0:15:45.20,Default,,0,0,0,,多虧有歐爾麥特幫忙
Dialogue: 1,0:15:45.20,0:15:49.41,Default2,,0,0,0,,在航運管制開始前
Dialogue: 0,0:15:45.20,0:15:49.41,Default,,0,0,0,,幫我從美國調到貨
Dialogue: 1,0:15:49.41,0:15:55.00,Default2,,0,0,0,,壓縮後勤道具 中央護手
Dialogue: 0,0:15:49.41,0:15:55.00,Default,,0,0,0,,性能很驚人
Dialogue: 0,0:15:55.00,0:15:57.75,Default,,0,0,0,,這是特別強化持久性的測試樣本
Dialogue: 1,0:15:57.75,0:16:03.08,Default2,,0,0,0,,雖然可以多方面補強身體
Dialogue: 0,0:15:57.75,0:16:03.08,Default,,0,0,0,,但沒辦法承受百分百輸出的力量
Dialogue: 0,0:16:04.12,0:16:06.70,Default,,0,0,0,,在再戰之前 你可別太勉強
Dialogue: 0,0:16:08.54,0:16:11.45,Default,,0,0,0,,不管我會變怎樣都無所謂
Dialogue: 0,0:16:12.08,0:16:13.29,Default,,0,0,0,,是…
Dialogue: 0,0:16:13.29,0:16:16.75,Default,,0,0,0,,我…來惹…
Dialogue: 1,0:16:16.75,0:16:19.83,Default2,,0,0,0,,-是白銀時代的特別版本
Dialogue: 0,0:16:16.75,0:16:19.83,Default,,0,0,0,,-我…來惹…
Dialogue: 0,0:16:19.83,0:16:20.79,Default,,0,0,0,,是我
Dialogue: 0,0:16:20.79,0:16:23.04,Default,,0,0,0,,喂喂 歐爾麥特先生
Dialogue: 0,0:16:23.04,0:16:26.16,Default,,0,0,0,,請問 綠谷同學…他還好嗎
Dialogue: 0,0:16:26.16,0:16:28.62,Default,,0,0,0,,還好 看起來沒什麼狀況
Dialogue: 0,0:16:29.41,0:16:31.37,Default,,0,0,0,,不好意思 我先走一步
Dialogue: 0,0:16:31.37,0:16:33.87,Default,,0,0,0,,他剛剛離開了…
Dialogue: 1,0:16:33.87,0:16:40.45,Default2,,0,0,0,,他怕連累你…應該說
Dialogue: 0,0:16:33.87,0:16:40.45,Default,,0,0,0,,他怕會波及到周圍的人吧 肯定沒錯
Dialogue: 1,0:16:40.45,0:16:45.58,Default2,,0,0,0,,其實也可以考慮
Dialogue: 0,0:16:40.45,0:16:45.58,Default,,0,0,0,,做好所有迎擊準備後再進行隔離…
Dialogue: 0,0:16:45.58,0:16:46.00,Default,,0,0,0,,但相反地
Dialogue: 1,0:16:46.00,0:16:51.00,Default2,,0,0,0,,要是那個能輕易突破塔爾塔羅斯的
Dialogue: 0,0:16:46.00,0:16:51.00,Default,,0,0,0,,作弊者做好準備攻過來 我們就完蛋了
Dialogue: 1,0:16:51.00,0:16:55.50,Default2,,0,0,0,,所以他說的沒錯
Dialogue: 0,0:16:51.00,0:16:55.50,Default,,0,0,0,,先發制人找到對方 勝算會比較高
Dialogue: 1,0:16:55.50,0:16:59.66,Default2,,0,0,0,,我知道你現在的立場很為難
Dialogue: 0,0:16:55.50,0:16:59.66,Default,,0,0,0,,但還是請你多多協助他了
Dialogue: 0,0:17:01.91,0:17:03.75,Default,,0,0,0,,(幾天前)
Dialogue: 1,0:17:03.75,0:17:09.36,Default2,,0,0,0,,聽說 以前曾有醫師警告過你
Dialogue: 0,0:17:03.75,0:17:09.36,Default,,0,0,0,,有可能會受重傷 再也無法行動自如
Dialogue: 0,0:17:09.36,0:17:12.57,Default,,0,0,0,,不過幸好這次不是受同樣的傷
Dialogue: 1,0:17:12.57,0:17:18.91,Default2,,0,0,0,,跟以前那種彷彿在內側爆發的損傷不同
Dialogue: 0,0:17:12.57,0:17:18.91,Default,,0,0,0,,這次爆炸是釋放到外側了
Dialogue: 0,0:17:18.91,0:17:22.07,Default,,0,0,0,,再加上…是個性吧
Dialogue: 1,0:17:22.07,0:17:27.57,Default2,,0,0,0,,由內到外都有補強
Dialogue: 0,0:17:22.07,0:17:27.57,Default,,0,0,0,,所以才能順利免於粉碎
Dialogue: 1,0:17:27.57,0:17:32.91,Default2,,0,0,0,,就算受了同樣的傷
Dialogue: 0,0:17:27.57,0:17:32.91,Default,,0,0,0,,但你的身體也已經跟當初不一樣了
Dialogue: 1,0:17:32.91,0:17:37.79,Default2,,0,0,0,,話雖如此 舊傷也還是在惡化
Dialogue: 0,0:17:32.91,0:17:37.79,Default,,0,0,0,,請務必多加注意…
Dialogue: 0,0:17:41.37,0:17:44.95,Default,,0,0,0,,可以…請您解釋一下嗎
Dialogue: 0,0:17:49.79,0:17:52.12,Default,,0,0,0,,我可以說吧少年…
Dialogue: 1,0:18:01.66,0:18:07.29,Default2,,0,0,0,,那股力量…
Dialogue: 0,0:18:01.66,0:18:07.29,Default,,0,0,0,,是因為無個性才能持有…
Dialogue: 0,0:18:07.29,0:18:11.54,Default,,0,0,0,,可是 出久也才會被那些壞人盯上…
Dialogue: 0,0:18:14.12,0:18:16.04,Default,,0,0,0,,那以後會怎麼樣…
Dialogue: 1,0:18:17.12,0:18:21.20,Default2,,0,0,0,,我們正在推動保護方案
Dialogue: 0,0:18:17.12,0:18:21.20,Default,,0,0,0,,只要待在雄英…
Dialogue: 0,0:18:21.20,0:18:22.95,Default,,0,0,0,,我不會回雄英了
Dialogue: 0,0:18:24.62,0:18:26.58,Default,,0,0,0,,出久…
Dialogue: 0,0:18:26.58,0:18:28.54,Default,,0,0,0,,少年…
Dialogue: 0,0:18:28.54,0:18:31.00,Default,,0,0,0,,你果然是這麼打算的…
Dialogue: 0,0:18:32.20,0:18:35.20,Default,,0,0,0,,死柄木能夠鎖定我的所在位置
Dialogue: 0,0:18:36.33,0:18:39.87,Default,,0,0,0,,即使他在這個瞬間發動襲擊也不奇怪
Dialogue: 0,0:18:40.91,0:18:44.79,Default,,0,0,0,,我真的 不希望再有任何人受傷了
Dialogue: 1,0:18:44.79,0:18:49.83,Default2,,0,0,0,,要是他們做好了萬全的準備
Dialogue: 0,0:18:44.79,0:18:49.83,Default,,0,0,0,,情況會比現在更糟糕
Dialogue: 0,0:18:50.87,0:18:55.45,Default,,0,0,0,,必須在那之前 阻止死柄木跟AFO
Dialogue: 1,0:18:55.45,0:19:00.00,Default2,,0,0,0,,但你就是打不贏他們…
Dialogue: 0,0:18:55.45,0:19:00.00,Default,,0,0,0,,才會受重傷啊
Dialogue: 0,0:19:00.00,0:19:01.75,Default,,0,0,0,,我會變強的
Dialogue: 0,0:19:04.58,0:19:08.50,Default,,0,0,0,,雖然我說過我放心了 但我不要…
Dialogue: 0,0:19:08.50,0:19:11.50,Default,,0,0,0,,我不想要聽到…這種話…
Dialogue: 1,0:19:14.62,0:19:19.37,Default2,,0,0,0,,聽到媽媽…
Dialogue: 0,0:19:14.62,0:19:19.37,Default,,0,0,0,,對我說了謝謝 還對我笑了…
Dialogue: 0,0:19:21.54,0:19:23.95,Default,,0,0,0,,那真的讓我很開心…
Dialogue: 0,0:19:23.95,0:19:25.58,Default,,0,0,0,,救命啊
Dialogue: 0,0:19:25.58,0:19:27.45,Default,,0,0,0,,我來了
Dialogue: 1,0:19:28.58,0:19:34.37,Default2,,0,0,0,,哇啊 謝謝你
Dialogue: 0,0:19:28.58,0:19:34.37,Default,,0,0,0,,原來歐爾麥特就是出久啊
Dialogue: 0,0:19:35.12,0:19:36.58,Default,,0,0,0,,所以…
Dialogue: 0,0:19:38.75,0:19:40.62,Default,,0,0,0,,所以我要走了
Dialogue: 0,0:19:40.62,0:19:44.12,Default,,0,0,0,,放心 我一定會回來的
Dialogue: 1,0:19:47.37,0:19:52.54,Default2,,0,0,0,,您能不能允許我將我的一切
Dialogue: 0,0:19:47.37,0:19:52.54,Default,,0,0,0,,全都灌注在出久少年身上呢
Dialogue: 1,0:19:52.54,0:19:56.45,Default2,,0,0,0,,我會賭上我這條性命
Dialogue: 0,0:19:52.54,0:19:56.45,Default,,0,0,0,,努力保護他、栽培他的
Dialogue: 0,0:20:01.00,0:20:04.87,Default,,0,0,0,,反正就算我阻止…你也會去吧…
Dialogue: 1,0:20:06.12,0:20:11.16,Default2,,0,0,0,,那我也要一起去…
Dialogue: 0,0:20:06.12,0:20:11.16,Default,,0,0,0,,就算你說不要也沒用
Dialogue: 0,0:20:13.37,0:20:15.83,Default,,0,0,0,,他要離開雄英
Dialogue: 1,0:20:15.83,0:20:21.25,Default2,,0,0,0,,不 原來如此…
Dialogue: 0,0:20:15.83,0:20:21.25,Default,,0,0,0,,是 那確實對我們比較有利
Dialogue: 1,0:20:21.25,0:20:25.70,Default2,,0,0,0,,現階段 他是唯一能找到
Dialogue: 0,0:20:21.25,0:20:25.70,Default,,0,0,0,,死柄木他們所在處的人
Dialogue: 1,0:20:25.70,0:20:30.08,Default2,,0,0,0,,我本來就在思考
Dialogue: 0,0:20:25.70,0:20:30.08,Default,,0,0,0,,能不能請他擔任行動主軸…
Dialogue: 1,0:20:30.08,0:20:33.50,Default2,,0,0,0,,是 我們會保持
Dialogue: 0,0:20:30.08,0:20:33.50,Default,,0,0,0,,能夠隨時趕到他身邊的適當距離
Dialogue: 0,0:20:33.50,0:20:35.95,Default,,0,0,0,,他拿手機的姿勢也太帥了
Dialogue: 0,0:20:35.95,0:20:37.75,Default,,0,0,0,,是 好的
Dialogue: 0,0:20:39.50,0:20:44.16,Default,,0,0,0,,這樣啊…志村她…
Dialogue: 0,0:20:44.16,0:20:48.20,Default,,0,0,0,,死了以後也還是一樣在哭啊
Dialogue: 1,0:20:52.08,0:20:58.54,Default2,,0,0,0,,其實應該要
Dialogue: 0,0:20:52.08,0:20:58.54,Default,,0,0,0,,由我來殺死他的…真抱歉…
Dialogue: 1,0:20:58.54,0:21:04.54,Default2,,0,0,0,,你也不要太固執…
Dialogue: 0,0:20:58.54,0:21:04.54,Default,,0,0,0,,有時殺人反而是種救贖
Dialogue: 0,0:21:04.54,0:21:06.91,Default,,0,0,0,,不要忘了這點
Dialogue: 0,0:21:08.12,0:21:11.25,Default,,0,0,0,,不管你決定怎麼做
Dialogue: 0,0:21:11.25,0:21:15.83,Default,,0,0,0,,都要去找敵人聯軍做一個了斷
Dialogue: 1,0:21:22.16,0:21:26.83,Default2,,0,0,0,,我跟安德瓦 霍克斯
Dialogue: 0,0:21:22.16,0:21:26.83,Default,,0,0,0,,最佳牛仔褲時尚名人獎…
Dialogue: 0,0:21:26.83,0:21:30.66,Default,,0,0,0,,以及歐爾麥特組成了一支隊伍
Dialogue: 0,0:21:33.04,0:21:36.08,Default,,0,0,0,,為了不要再有任何犧牲者
Dialogue: 0,0:21:41.41,0:21:44.12,Default,,0,0,0,,為了阻止All for one…
Dialogue: 0,0:21:46.87,0:21:48.08,Default,,0,0,0,,我…
Dialogue: 0,0:23:20.75,0:23:22.50,Default,,0,0,0,,下集預告
Dialogue: 0,0:23:22.50,0:23:25.12,Default,,0,0,0,,我一邊打倒逃獄的敵人們
Dialogue: 0,0:23:25.12,0:23:29.16,Default,,0,0,0,,一邊尋找著銷聲匿跡的死柄木
Dialogue: 1,0:23:29.16,0:23:34.50,Default2,,0,0,0,,這個時候
Dialogue: 0,0:23:29.16,0:23:34.50,Default,,0,0,0,,All for one派出的刺客來到我面前
Dialogue: 0,0:23:34.50,0:23:38.58,Default,,0,0,0,,她的名字是 女神納甘
Dialogue: 0,0:23:38.58,0:23:40.91,Default,,0,0,0,,下一集 刺客
Dialogue: 1,0:23:40.91,0:23:46.62,Default2,,0,0,0,,曾經是英雄的她
Dialogue: 0,0:23:40.91,0:23:46.62,Default,,0,0,0,,將她的子彈…鎖定在我身上
Dialogue: 0,0:23:46.62,0:23:50.14,Default,,0,0,0,,更向前邁進吧 Plus Ultra

Dialogue: 0,0:13:38.25,0:13:41.17,text,,0,0,0,,{\an8\1c&H000000&\3c&HFFFFFF&}畢拉利學員畢業證書頒發儀式會場
Dialogue: 0,0:13:41.17,0:13:45.67,text,,0,0,0,,{\an8\1c&H000000&\3c&HFFFFFF&}畢拉利學園高中部畢業典禮
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------PREV-------------------
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------TXTA-------------------
Dialogue: 0,0:00:06.45,0:00:09.73,text,,0,0,0,,同學們 訓練場已經修理完畢了
Dialogue: 0,0:00:10.21,0:00:12.61,text,,0,0,0,,從明天起又可以自由使用了
Dialogue: 0,0:00:12.93,0:00:15.73,text,,0,0,0,,這麼說又可以進行實用技術考試了
Dialogue: 0,0:00:16.05,0:00:19.01,text,,0,0,0,,雖說彌生同學的積極性值得表揚
Dialogue: 0,0:00:19.21,0:00:22.97,text,,0,0,0,,但很遺憾 下週就要進行結業典禮了
Dialogue: 0,0:00:23.61,0:00:25.25,text,,0,0,0,,太可惜了
Dialogue: 0,0:00:25.37,0:00:27.73,text,,0,0,0,,巴不得沒考試輕鬆點欸
Dialogue: 0,0:00:28.73,0:00:32.85,text,,0,0,0,,萬博同學 實用技術考試一年只有兩次而已
Dialogue: 0,0:00:32.17,0:00:32.73,text,,0,0,0,,{\an3}彌生
Dialogue: 0,0:00:32.85,0:00:33.57,text,,0,0,0,,所以…
Dialogue: 0,0:00:33.97,0:00:35.65,text,,0,0,0,,班會還沒結束喔
Dialogue: 0,0:00:36.25,0:00:37.97,text,,0,0,0,,是我失禮了
Dialogue: 0,0:00:40.13,0:00:42.29,text,,0,0,0,,關於年末發生的意外 有通知要公布
Dialogue: 0,0:00:43.29,0:00:45.69,text,,0,0,0,,畢竟與大家有關 就在這裡一併說了
Dialogue: 0,0:00:46.13,0:00:46.69,text,,0,0,0,,莉昂
Dialogue: 0,0:00:47.41,0:00:47.93,text,,0,0,0,,到
Dialogue: 0,0:00:48.97,0:00:49.57,text,,0,0,0,,妮娜
Dialogue: 0,0:00:50.17,0:00:50.57,text,,0,0,0,,到
Dialogue: 0,0:00:51.77,0:00:53.33,text,,0,0,0,,上級決定對你們二人不予處罰
Dialogue: 0,0:00:56.65,0:00:59.89,text,,0,0,0,,但是 莉昂要接受一段時期的補習
Dialogue: 0,0:01:00.69,0:01:01.89,text,,0,0,0,,你應該明白為什麼吧
Dialogue: 0,0:01:02.45,0:01:03.05,text,,0,0,0,,是
Dialogue: 0,0:01:03.85,0:01:06.37,text,,0,0,0,,另外 妮娜放學後到辦公室來一趟
Dialogue: 0,0:01:07.25,0:01:07.97,text,,0,0,0,,就這些
Dialogue: 0,0:01:13.85,0:01:14.45,text,,0,0,0,,給你的
Dialogue: 0,0:01:15.77,0:01:17.25,text,,0,0,0,,維洛妮卡局長要我們轉交的
Dialogue: 0,0:01:17.65,0:01:20.09,text,,0,0,0,,畢業典禮結束後 要與你直接面談
Dialogue: 0,0:01:22.73,0:01:26.77,text,,0,0,0,,妮娜同學的作為已經令ALCA為你記下一功了
Dialogue: 0,0:01:27.01,0:01:27.93,text,,0,0,0,,我…
Dialogue: 0,0:01:33.01,0:01:35.49,text,,0,0,0,,妮娜果然還是要回ALCA嗎
Dialogue: 0,0:01:35.49,0:01:36.25,text,,0,0,0,,藤崎
Dialogue: 0,0:01:37.97,0:01:39.05,text,,0,0,0,,很抱歉
Dialogue: 0,0:01:39.25,0:01:40.61,text,,0,0,0,,是我太心急了
Dialogue: 0,0:01:41.05,0:01:43.57,text,,0,0,0,,事關前程 還是三思而後行吧
Dialogue: 0,0:01:50.93,0:01:52.69,text,,0,0,0,,緊急情況
Dialogue: 0,0:01:54.09,0:01:56.45,text,,0,0,0,,主人 太大聲了
Dialogue: 0,0:01:56.65,0:01:57.61,text,,0,0,0,,可是
Dialogue: 0,0:01:57.97,0:02:01.09,text,,0,0,0,,妮娜同學要回ALCA了喔
Dialogue: 0,0:02:01.17,0:02:05.10,text,,0,0,0,,主人 確切來說是有可能回去
Dialogue: 0,0:02:05.45,0:02:06.69,text,,0,0,0,,畢竟她是現役定理者
Dialogue: 0,0:02:06.97,0:02:08.69,text,,0,0,0,,可是為什麼勒
Dialogue: 0,0:02:08.89,0:02:11.05,text,,0,0,0,,聽老師說的意思
Dialogue: 0,0:02:11.29,0:02:13.56,text,,0,0,0,,好像是妮娜同學救助莉昂同學的行為
Dialogue: 0,0:02:13.69,0:02:15.69,text,,0,0,0,,讓ALCA對她刮目相看了
Dialogue: 0,0:02:16.21,0:02:19.05,text,,0,0,0,,雖然不清楚妮娜來學校的原委
Dialogue: 0,0:02:19.29,0:02:21.81,text,,0,0,0,,不過一般來講這倒是好事一樁
Dialogue: 0,0:02:23.65,0:02:24.96,text,,0,0,0,,嗯
Dialogue: 0,0:02:25.29,0:02:28.25,text,,0,0,0,,的確是件喜事
Dialogue: 0,0:02:28.69,0:02:29.69,text,,0,0,0,,只是
Dialogue: 0,0:02:29.69,0:02:31.69,text,,0,0,0,,這也太突然了
Dialogue: 0,0:02:32.04,0:02:35.15,text,,0,0,0,,嗯 若是妮娜同學答應了
Dialogue: 0,0:02:35.25,0:02:37.41,text,,0,0,0,,那就只能和她一起待到結業典禮了
Dialogue: 0,0:02:37.54,0:02:40.41,text,,0,0,0,,窩好捨不得喔
Dialogue: 0,0:02:40.48,0:02:41.45,text,,0,0,0,,我也是
Dialogue: 0,0:02:41.49,0:02:42.65,text,,0,0,0,,我也…
Dialogue: 0,0:02:42.76,0:02:44.07,text,,0,0,0,,同感
Dialogue: 0,0:02:49.09,0:02:50.33,text,,0,0,0,,這是好事喔
Dialogue: 0,0:02:50.81,0:02:51.89,text,,0,0,0,,莉昂同學
Dialogue: 0,0:02:52.89,0:02:56.69,text,,0,0,0,,太好了 妮娜一定會很開心
Dialogue: 0,0:02:59.17,0:03:01.41,text,,0,0,0,,可喜可賀 可喜可賀
Dialogue: 0,0:03:04.25,0:03:05.81,text,,0,0,0,,你沒事吧
Dialogue: 0,0:03:06.84,0:03:07.86,text,,0,0,0,,沒事喔
Dialogue: 0,0:03:11.93,0:03:14.01,text,,0,0,0,,我倒是更擔心莉昂
Dialogue: 0,0:03:14.49,0:03:16.73,text,,0,0,0,,畢竟她那麼喜歡妮娜嘛
Dialogue: 0,0:03:16.97,0:03:20.25,text,,0,0,0,,就是不知道妮娜同學還想不想留在學校了
Dialogue: 0,0:03:20.65,0:03:22.05,text,,0,0,0,,很難說欸
Dialogue: 0,0:03:22.57,0:03:27.21,text,,0,0,0,,當然 如果她自己要回ALCA的話我也無話可說
Dialogue: 0,0:03:27.37,0:03:32.37,text,,0,0,0,,但若能讓她願意留校 覺得這樣更好的話…
Dialogue: 0,0:03:32.77,0:03:36.57,text,,0,0,0,,要是妮娜肯留下來 我當然也很開心
Dialogue: 0,0:03:36.97,0:03:37.93,text,,0,0,0,,對吧
Dialogue: 0,0:03:37.93,0:03:39.41,text,,0,0,0,,主人 行動吧
Dialogue: 0,0:03:39.41,0:03:40.49,text,,0,0,0,,行動吧
Dialogue: 0,0:03:41.17,0:03:44.25,text,,0,0,0,,但是太難了
Dialogue: 0,0:03:58.81,0:03:59.61,text,,0,0,0,,哎啦啦
Dialogue: 0,0:03:59.93,0:04:01.57,text,,0,0,0,,有事嗎 莉昂
Dialogue: 0,0:04:03.61,0:04:05.85,text,,0,0,0,,夕子學姐在為離校做準備嗎
Dialogue: 0,0:04:06.35,0:04:10.13,text,,0,0,0,,嗯 等到畢業典禮結束我也該離開這裡了
Dialogue: 0,0:04:10.41,0:04:11.53,text,,0,0,0,,自然要趁現在收拾一下
Dialogue: 0,0:04:12.29,0:04:13.25,text,,0,0,0,,這樣喔
Dialogue: 0,0:04:13.77,0:04:16.48,text,,0,0,0,,真捨不得莉昂你們欸
Dialogue: 0,0:04:17.53,0:04:18.89,text,,0,0,0,,夕子學姐也會捨不得嗎
Dialogue: 0,0:04:19.49,0:04:20.45,text,,0,0,0,,當然啦
Dialogue: 0,0:04:21.13,0:04:25.05,text,,0,0,0,,不過莉昂身邊還有妮娜 彌生她們吧
Dialogue: 0,0:04:27.13,0:04:28.05,text,,0,0,0,,當然還有貝魯
Dialogue: 0,0:04:33.89,0:04:35.05,text,,0,0,0,,所以沒關係的
Dialogue: 0,0:04:35.41,0:04:36.93,text,,0,0,0,,謝謝你 夕子學姐
Dialogue: 0,0:04:38.73,0:04:39.77,text,,0,0,0,,哎啦啦
Dialogue: 0,0:04:45.76,0:04:48.88,text,,0,0,0,,這裡的伙食真的很好吃喔
Dialogue: 0,0:04:48.97,0:04:50.01,text,,0,0,0,,對對對
Dialogue: 0,0:04:50.24,0:04:52.78,text,,0,0,0,,食材也是最新鮮的
Dialogue: 0,0:04:53.07,0:04:56.77,text,,0,0,0,,能每天吃到這麼美味的飯 真是人生一大幸事
Dialogue: 0,0:04:56.89,0:04:57.93,text,,0,0,0,,妮娜你說對吧
Dialogue: 0,0:04:59.12,0:05:00.64,text,,0,0,0,,嗯
Dialogue: 0,0:05:01.01,0:05:03.25,text,,0,0,0,,如此美味
Dialogue: 0,0:05:03.25,0:05:07.05,text,,0,0,0,,像是ALCA的食堂裡應該沒有的吧
Dialogue: 0,0:05:12.05,0:05:14.29,text,,0,0,0,,學姐做的點心也很好吃
Dialogue: 0,0:05:14.29,0:05:16.89,text,,0,0,0,,白樺寮真是人間天堂
Dialogue: 0,0:05:17.45,0:05:19.57,text,,0,0,0,,能聽到你這麼說 我真的很開心
Dialogue: 0,0:05:19.86,0:05:20.41,text,,0,0,0,,華戀
Dialogue: 0,0:05:21.44,0:05:23.27,text,,0,0,0,,夕子學姐的點心已經…
Dialogue: 0,0:05:23.47,0:05:26.20,text,,0,0,0,,學姐要畢業了
Dialogue: 0,0:05:26.64,0:05:27.40,text,,0,0,0,,對
Dialogue: 0,0:05:27.69,0:05:30.69,text,,0,0,0,,不過在我離開前會多做些點心的
Dialogue: 0,0:05:30.69,0:05:32.09,text,,0,0,0,,太好啦
Dialogue: 0,0:05:32.09,0:05:33.25,text,,0,0,0,,謝謝學姐
Dialogue: 0,0:05:34.09,0:05:38.53,text,,0,0,0,,成為宿舍長 要看顧一年級學生的時候
Dialogue: 0,0:05:38.85,0:05:41.49,text,,0,0,0,,我本來還很擔心自己能不能勝任的說
Dialogue: 0,0:05:42.37,0:05:45.21,text,,0,0,0,,不過大家都是好孩子 讓我度過了一段快樂的時光
Dialogue: 0,0:05:46.29,0:05:47.09,text,,0,0,0,,謝謝你們
Dialogue: 0,0:05:47.37,0:05:48.85,text,,0,0,0,,夕子學姐
Dialogue: 0,0:05:49.65,0:05:51.89,text,,0,0,0,,後天就是畢業典禮了嗎
Dialogue: 0,0:05:52.73,0:05:54.01,text,,0,0,0,,真快
Dialogue: 0,0:05:54.85,0:05:56.05,text,,0,0,0,,後天
Dialogue: 0,0:05:57.09,0:06:00.05,text,,0,0,0,,儘管捨不得說再見 但這也是無可奈何
Dialogue: 0,0:06:01.63,0:06:02.54,text,,0,0,0,,嗯
Dialogue: 0,0:06:05.29,0:06:08.09,text,,0,0,0,,「套牢胃口」大作戰失敗了
Dialogue: 0,0:06:08.09,0:06:12.85,text,,0,0,0,,捨不得說再見什麼的 完全就是在影射自己吧
Dialogue: 0,0:06:13.09,0:06:14.81,text,,0,0,0,,這也能聽出來喔
Dialogue: 0,0:06:14.89,0:06:17.81,text,,0,0,0,,察言觀色可是我的拿手好戲
Dialogue: 0,0:06:18.01,0:06:19.37,text,,0,0,0,,姐姐棒棒的
Dialogue: 0,0:06:19.37,0:06:21.77,text,,0,0,0,,那就開始下一項作戰計劃吧
Dialogue: 0,0:06:22.53,0:06:23.65,text,,0,0,0,,這都是什麼
Dialogue: 0,0:06:24.13,0:06:28.13,text,,0,0,0,,大家共同經歷的美好回憶一定能打動妮娜同學的心
Dialogue: 0,0:06:37.49,0:06:39.69,text,,0,0,0,,得去告訴夕子學姐
Dialogue: 0,0:06:41.73,0:06:43.21,text,,0,0,0,,妮娜的照片
Dialogue: 0,0:06:44.61,0:06:46.29,text,,0,0,0,,這也是妮娜
Dialogue: 0,0:06:46.77,0:06:47.89,text,,0,0,0,,這也是
Dialogue: 0,0:06:49.77,0:06:51.81,text,,0,0,0,,妮娜 妮娜
Dialogue: 0,0:06:53.33,0:06:55.17,text,,0,0,0,,有好多妮娜
Dialogue: 0,0:06:55.35,0:06:58.36,text,,0,0,0,,「回憶永存」大作戰也失敗了
Dialogue: 0,0:06:59.38,0:07:01.26,text,,0,0,0,,萬博同學你沒什麼好主意嗎
Dialogue: 0,0:07:01.84,0:07:02.88,text,,0,0,0,,倒也不是沒有
Dialogue: 0,0:07:05.25,0:07:07.21,text,,0,0,0,,一竿釣君 Go
Dialogue: 0,0:07:12.53,0:07:14.01,text,,0,0,0,,什麼鬼啦
Dialogue: 0,0:07:15.21,0:07:16.73,text,,0,0,0,,這是怎麼回事
Dialogue: 0,0:07:16.73,0:07:18.17,text,,0,0,0,,哎啦啦
Dialogue: 0,0:07:20.81,0:07:22.53,text,,0,0,0,,真可惜 失敗了
Dialogue: 0,0:07:34.13,0:07:35.13,text,,0,0,0,,真舒服
Dialogue: 0,0:07:37.61,0:07:39.97,text,,0,0,0,,萬博和彌生怎麼還沒來勒
Dialogue: 0,0:07:40.41,0:07:41.25,text,,0,0,0,,是蠻奇怪
Dialogue: 0,0:07:41.69,0:07:44.33,text,,0,0,0,,哎啦啦 出什麼事了
Dialogue: 0,0:07:46.25,0:07:47.01,text,,0,0,0,,真是夠了
Dialogue: 0,0:07:47.01,0:07:50.25,text,,0,0,0,,整天整天整天搞這種奇奇怪怪的東西
Dialogue: 0,0:07:51.89,0:07:54.09,text,,0,0,0,,別以為傻笑就能矇混過關
Dialogue: 0,0:07:54.41,0:07:57.17,text,,0,0,0,,我看你是故意不好好做吧
Dialogue: 0,0:07:57.25,0:07:58.53,text,,0,0,0,,你看出來啦
Dialogue: 0,0:07:59.01,0:08:00.29,text,,0,0,0,,為什麼
Dialogue: 0,0:08:02.93,0:08:06.21,text,,0,0,0,,如果回到ALCA能讓妮娜實現願望的話
Dialogue: 0,0:08:06.69,0:08:07.93,text,,0,0,0,,怎麼可以給她添亂
Dialogue: 0,0:08:08.73,0:08:11.01,text,,0,0,0,,我又怎麼會不懂
Dialogue: 0,0:08:13.13,0:08:16.08,text,,0,0,0,,所以才會用迂迴的方法嘛
Dialogue: 0,0:08:19.01,0:08:23.00,text,,0,0,0,,如果真的可以的話　我當然會不惜一切代價挽留她
Dialogue: 0,0:08:24.28,0:08:27.89,text,,0,0,0,,再說了 我還從沒贏過她欸
Dialogue: 0,0:08:28.49,0:08:31.69,text,,0,0,0,,本想在冬季實用技術考試的時候一決高下的說
Dialogue: 0,0:08:32.57,0:08:34.21,text,,0,0,0,,如果是這個的話
Dialogue: 0,0:08:41.05,0:08:41.77,text,,0,0,0,,請進
Dialogue: 0,0:08:44.85,0:08:46.45,text,,0,0,0,,我們一起看吧
Dialogue: 0,0:08:46.77,0:08:48.45,text,,0,0,0,,有好多妮娜的照片哦
Dialogue: 0,0:08:49.13,0:08:51.21,text,,0,0,0,,這是莉昂你的嗎
Dialogue: 0,0:08:51.63,0:08:53.32,text,,0,0,0,,不是啦 是掉在地上的
Dialogue: 0,0:08:53.77,0:08:55.09,text,,0,0,0,,會是誰的勒
Dialogue: 0,0:08:55.41,0:08:58.41,text,,0,0,0,,我問過了 大家都說不知道
Dialogue: 0,0:08:58.69,0:09:00.05,text,,0,0,0,,不可以留下嗎
Dialogue: 0,0:09:00.33,0:09:02.17,text,,0,0,0,,既然大家都不知道失主是誰
Dialogue: 0,0:09:02.17,0:09:03.89,text,,0,0,0,,那就先保管著吧
Dialogue: 0,0:09:04.05,0:09:05.01,text,,0,0,0,,好主意
Dialogue: 0,0:09:10.25,0:09:12.21,text,,0,0,0,,畢拉利祭真的很好玩
Dialogue: 0,0:09:13.49,0:09:16.49,text,,0,0,0,,真該推薦妮娜參加選美比賽的
Dialogue: 0,0:09:16.85,0:09:18.69,text,,0,0,0,,還是饒了我吧
Dialogue: 0,0:09:18.85,0:09:19.61,text,,0,0,0,,為什麼
Dialogue: 0,0:09:20.09,0:09:21.17,text,,0,0,0,,因為不可以
Dialogue: 0,0:09:21.25,0:09:22.89,text,,0,0,0,,為什麼
Dialogue: 0,0:09:22.89,0:09:24.73,text,,0,0,0,,不行就是不行
Dialogue: 0,0:09:29.57,0:09:32.09,text,,0,0,0,,櫻花 真美
Dialogue: 0,0:09:32.97,0:09:34.45,text,,0,0,0,,妮娜喜歡櫻花嗎
Dialogue: 0,0:09:35.01,0:09:35.69,text,,0,0,0,,喜歡
Dialogue: 0,0:09:36.33,0:09:38.89,text,,0,0,0,,賞花時看見的櫻花也很美
Dialogue: 0,0:09:39.45,0:09:41.65,text,,0,0,0,,學校不是有行道櫻花樹嗎
Dialogue: 0,0:09:41.94,0:09:45.40,text,,0,0,0,,那裡花開的時候才更美喔
Dialogue: 0,0:09:45.78,0:09:46.97,text,,0,0,0,,是這樣喔
Dialogue: 0,0:09:49.69,0:09:51.81,text,,0,0,0,,莉昂還沒見過吧
Dialogue: 0,0:09:53.45,0:09:57.01,text,,0,0,0,,看見你倒在路邊的時候真是嚇到我了
Dialogue: 0,0:09:58.69,0:10:00.37,text,,0,0,0,,我也大吃了一驚欸
Dialogue: 0,0:10:00.73,0:10:03.09,text,,0,0,0,,想不到能見到妮娜真人
Dialogue: 0,0:10:09.73,0:10:10.89,text,,0,0,0,,早
Dialogue: 0,0:10:11.05,0:10:12.97,text,,0,0,0,,早安
Dialogue: 0,0:10:16.09,0:10:18.01,text,,0,0,0,,真稀奇
Dialogue: 0,0:10:18.33,0:10:20.05,text,,0,0,0,,你居然自己起床了
Dialogue: 0,0:10:20.65,0:10:22.97,text,,0,0,0,,我今天可要全力以赴的
Dialogue: 0,0:10:37.93,0:10:40.09,text,,0,0,0,,輸給主人也就罷了
Dialogue: 0,0:10:40.09,0:10:42.77,text,,0,0,0,,居然連小萬都沒打贏
Dialogue: 0,0:10:43.57,0:10:44.81,text,,0,0,0,,總算來了
Dialogue: 0,0:10:45.29,0:10:46.65,text,,0,0,0,,現在正在預選喔
Dialogue: 0,0:10:47.65,0:10:48.69,text,,0,0,0,,你們是認真的？
Dialogue: 0,0:10:49.33,0:10:50.65,text,,0,0,0,,這是當然
Dialogue: 0,0:10:51.05,0:10:54.77,text,,0,0,0,,我和小彌之中贏的人會向妮娜發起挑戰
Dialogue: 0,0:10:55.13,0:10:56.57,text,,0,0,0,,兩個人一起上吧
Dialogue: 0,0:10:59.01,0:11:00.17,text,,0,0,0,,連接門開啟
Dialogue: 0,0:11:00.89,0:11:02.05,text,,0,0,0,,第四天堂
Dialogue: 0,0:11:06.21,0:11:07.81,text,,0,0,0,,遇上強敵了 米迦勒
Dialogue: 0,0:11:09.53,0:11:10.85,text,,0,0,0,,必將全力以赴
Dialogue: 0,0:11:11.09,0:11:12.09,text,,0,0,0,,絕不墮騎士之名
Dialogue: 0,0:11:25.25,0:11:27.81,text,,0,0,0,,別以為二對一就能贏我
Dialogue: 0,0:11:28.25,0:11:29.41,text,,0,0,0,,好吧
Dialogue: 0,0:11:29.93,0:11:31.13,text,,0,0,0,,OK
Dialogue: 0,0:11:38.49,0:11:40.37,text,,0,0,0,,怎麼突然要挑戰我
Dialogue: 0,0:11:41.21,0:11:45.13,text,,0,0,0,,因為我不服夏季實用技術考試時的結果
Dialogue: 0,0:11:46.57,0:11:49.33,text,,0,0,0,,因為妮娜你是最強的
Dialogue: 0,0:11:49.85,0:11:51.69,text,,0,0,0,,接招吧 妮娜
Dialogue: 0,0:12:08.73,0:12:10.93,text,,0,0,0,,我才不是最強的勒
Dialogue: 0,0:12:11.21,0:12:13.49,text,,0,0,0,,當時我不是輸給莉昂了嗎
Dialogue: 0,0:12:14.17,0:12:16.85,text,,0,0,0,,莉昂同學的話 想什麼時候和她比都行
Dialogue: 0,0:12:24.13,0:12:27.45,text,,0,0,0,,可是現在不和你比 以後就再沒機會了
Dialogue: 0,0:12:31.61,0:12:35.29,text,,0,0,0,,我絕不允許你一聲不吭就得勝而逃
Dialogue: 0,0:12:40.61,0:12:42.17,text,,0,0,0,,你們在說什麼啦
Dialogue: 0,0:12:43.89,0:12:45.53,text,,0,0,0,,妮娜 拿出真本事來吧
Dialogue: 0,0:12:48.05,0:12:49.57,text,,0,0,0,,邏輯驅動
Dialogue: 0,0:13:05.33,0:13:06.17,text,,0,0,0,,妮娜
Dialogue: 0,0:13:07.01,0:13:08.89,text,,0,0,0,,你果然在這裡
Dialogue: 0,0:13:12.04,0:13:12.96,text,,0,0,0,,好美喔
Dialogue: 0,0:13:13.72,0:13:16.40,text,,0,0,0,,獵戶座就快要看不到了
Dialogue: 0,0:13:18.49,0:13:19.29,text,,0,0,0,,畢業典禮
Dialogue: 0,0:13:20.89,0:13:21.89,text,,0,0,0,,就在明天了
Dialogue: 0,0:13:22.84,0:13:24.95,text,,0,0,0,,嗯　對
Dialogue: 0,0:13:29.89,0:13:31.01,text,,0,0,0,,妮娜
Dialogue: 0,0:13:32.61,0:13:34.17,text,,0,0,0,,沒什麼
Dialogue: 0,0:14:22.37,0:14:25.33,text,,0,0,0,,夕子學姐 恭喜你順利畢業
Dialogue: 0,0:14:25.41,0:14:26.65,text,,0,0,0,,恭喜
Dialogue: 0,0:14:27.17,0:14:28.85,text,,0,0,0,,謝謝大家
Dialogue: 0,0:14:32.41,0:14:34.21,text,,0,0,0,,恭喜順利畢業
Dialogue: 0,0:14:34.73,0:14:36.03,text,,0,0,0,,謝謝 艾希莉
Dialogue: 0,0:14:36.45,0:14:38.17,text,,0,0,0,,當初咱們相識的時候
Dialogue: 0,0:14:38.50,0:14:41.85,text,,0,0,0,,都沒想到會變成現在這樣
Dialogue: 0,0:14:42.17,0:14:46.13,text,,0,0,0,,對啊 還總是被某人帶得團團轉
Dialogue: 0,0:14:46.25,0:14:48.01,text,,0,0,0,,學姐
Dialogue: 0,0:14:51.13,0:14:54.29,text,,0,0,0,,這般惹人憐愛的臉蛋不該是哭泣落淚的樣子
Dialogue: 0,0:14:55.49,0:14:58.21,text,,0,0,0,,瑞希學姐還是這麼風趣
Dialogue: 0,0:14:59.89,0:15:02.17,text,,0,0,0,,不過真的過得很開心
Dialogue: 0,0:15:02.39,0:15:02.89,text,,0,0,0,,嗯
Dialogue: 0,0:15:12.09,0:15:13.53,text,,0,0,0,,好了 我們走吧
Dialogue: 0,0:15:14.17,0:15:14.57,text,,0,0,0,,嗯
Dialogue: 0,0:15:15.73,0:15:17.89,text,,0,0,0,,請問兩位是…
Dialogue: 0,0:15:19.95,0:15:23.93,text,,0,0,0,,我和瑞希被分到ALCA裡同一部門了
Dialogue: 0,0:15:24.08,0:15:25.26,text,,0,0,0,,真傷腦筋
Dialogue: 0,0:15:26.89,0:15:28.69,text,,0,0,0,,大家要保重喔
Dialogue: 0,0:15:29.09,0:15:31.13,text,,0,0,0,,等等 你很傷腦筋嗎
Dialogue: 0,0:15:31.53,0:15:32.93,text,,0,0,0,,難道你不願意
Dialogue: 0,0:15:33.21,0:15:36.73,text,,0,0,0,,{\an1}夕子 夕子
Dialogue: 0,0:15:33.49,0:15:35.37,text,,0,0,0,,話說回來莉昂人勒
Dialogue: 0,0:16:02.21,0:16:03.33,text,,0,0,0,,妮娜同學
Dialogue: 0,0:16:21.97,0:16:23.45,text,,0,0,0,,亞歷山德羅芙那同學
Dialogue: 0,0:16:39.45,0:16:40.09,text,,0,0,0,,莉昂
Dialogue: 0,0:16:46.41,0:16:47.29,text,,0,0,0,,莉昂
Dialogue: 0,0:16:47.57,0:16:48.81,text,,0,0,0,,妮娜
Dialogue: 0,0:16:52.26,0:16:54.15,text,,0,0,0,,這些櫻花…為什麼
Dialogue: 0,0:16:55.97,0:16:57.25,text,,0,0,0,,想讓你再看一次
Dialogue: 0,0:16:57.73,0:16:59.85,text,,0,0,0,,因為你說喜歡櫻花
Dialogue: 0,0:17:00.97,0:17:03.49,text,,0,0,0,,所以想讓你再看一次
Dialogue: 0,0:17:04.85,0:17:06.85,text,,0,0,0,,因為要說再見了？
Dialogue: 0,0:17:10.09,0:17:12.25,text,,0,0,0,,因為我要回ALCA了？
Dialogue: 0,0:17:16.93,0:17:21.73,text,,0,0,0,,莉昂從一開始就明白我的想法了
Dialogue: 0,0:17:23.81,0:17:24.93,text,,0,0,0,,對不起
Dialogue: 0,0:17:25.57,0:17:27.41,text,,0,0,0,,沒關係的
Dialogue: 0,0:17:27.77,0:17:31.56,text,,0,0,0,,我答應了要做妮娜最忠實的擁護者嘛
Dialogue: 0,0:17:32.73,0:17:35.17,text,,0,0,0,,而且我很快就會追上你的
Dialogue: 0,0:17:35.93,0:17:38.01,text,,0,0,0,,雖說不可能馬上追上
Dialogue: 0,0:17:38.01,0:17:39.33,text,,0,0,0,,再有5年
Dialogue: 0,0:17:39.45,0:17:42.17,text,,0,0,0,,不 或許要花很多年
Dialogue: 0,0:17:42.17,0:17:43.89,text,,0,0,0,,但我一定會追上的
Dialogue: 0,0:17:47.41,0:17:49.53,text,,0,0,0,,你還真是…
Dialogue: 0,0:17:52.81,0:17:56.21,text,,0,0,0,,不 應該說是你們
Dialogue: 0,0:17:59.09,0:18:00.81,text,,0,0,0,,我怎麼可能離開啦
Dialogue: 0,0:18:01.29,0:18:03.57,text,,0,0,0,,這裡還有這麼多我珍視的朋友
Dialogue: 0,0:18:26.01,0:18:27.49,text,,0,0,0,,又搞事
Dialogue: 0,0:18:28.85,0:18:29.65,text,,0,0,0,,貝魯
Dialogue: 0,0:18:30.09,0:18:32.05,text,,0,0,0,,怎麼 不在莉昂身邊守著了？
Dialogue: 0,0:18:36.21,0:18:38.57,text,,0,0,0,,明年還要當她們的班導師嗎
Dialogue: 0,0:18:39.61,0:18:40.57,text,,0,0,0,,真讓人期待
Dialogue: 0,0:18:41.37,0:18:42.49,text,,0,0,0,,真是…
Dialogue: 0,0:18:49.38,0:18:51.88,text,,0,0,0,,還是這裡的世界更為歡樂嘛
Dialogue: 0,0:18:55.81,0:19:00.69,text,,0,0,0,,世界萬物變化無常 永不停息
Dialogue: 0,0:19:02.73,0:19:05.45,text,,0,0,0,,對 就像歌曲的音調
Dialogue: 0,0:19:06.05,0:19:07.09,text,,0,0,0,,跳脫歡快
Dialogue: 0,0:19:15.34,0:19:18.29,text,,0,0,0,,這還是第一次櫻花飛舞的畢業典禮欸
Dialogue: 0,0:19:20.20,0:19:22.17,text,,0,0,0,,不知道開學典禮又是什麼樣的
Dialogue: 0,0:19:22.89,0:19:26.61,text,,0,0,0,,又會有新的花兒迎接這些小新人的
Dialogue: 0,0:19:29.41,0:19:31.41,text,,0,0,0,,夕子學姐 要保重喔
Dialogue: 0,0:19:32.35,0:19:34.43,text,,0,0,0,,莉昂已經沒事了嗎
Dialogue: 0,0:19:56.31,0:19:57.71,text,,0,0,0,,珍視的朋友
Dialogue: 0,0:19:58.67,0:20:01.75,text,,0,0,0,,先聲明 我指的是所有人喔
Dialogue: 0,0:20:01.99,0:20:03.71,text,,0,0,0,,我知道啦
Dialogue: 0,0:20:04.91,0:20:06.83,text,,0,0,0,,我有個問題
Dialogue: 0,0:20:07.39,0:20:08.23,text,,0,0,0,,什麼
Dialogue: 0,0:20:08.99,0:20:12.07,text,,0,0,0,,莉昂想成為什麼樣的定理者
Dialogue: 0,0:20:12.75,0:20:14.47,text,,0,0,0,,像妮娜你這樣的
Dialogue: 0,0:20:14.87,0:20:16.79,text,,0,0,0,,說具體點
Dialogue: 0,0:20:17.15,0:20:18.27,text,,0,0,0,,就是…
Dialogue: 0,0:20:18.67,0:20:20.55,text,,0,0,0,,幫助有困難的人
Dialogue: 0,0:20:20.79,0:20:23.43,text,,0,0,0,,為努力奮鬥的人助一臂之力
Dialogue: 0,0:20:23.67,0:20:26.35,text,,0,0,0,,就像妮娜為我做的這些
Dialogue: 0,0:20:28.95,0:20:29.91,text,,0,0,0,,妮娜你勒
Dialogue: 0,0:20:30.79,0:20:32.55,text,,0,0,0,,我的想法從未改變
Dialogue: 0,0:20:33.03,0:20:37.23,text,,0,0,0,,我要借助上天賦予我的力量守護世界和平
Dialogue: 0,0:20:37.47,0:20:40.63,text,,0,0,0,,所以我要在學校裡學習各種知識技術
Dialogue: 0,0:20:40.95,0:20:41.95,text,,0,0,0,,變得更強
Dialogue: 0,0:20:43.07,0:20:44.39,text,,0,0,0,,就像你一樣
Dialogue: 0,0:20:45.07,0:20:46.75,text,,0,0,0,,你剛剛說什麼
Dialogue: 0,0:20:47.11,0:20:48.03,text,,0,0,0,,沒什麼
Dialogue: 0,0:20:49.19,0:20:51.75,text,,0,0,0,,妮娜 跟我說嘛
Dialogue: 0,0:20:58.55,0:21:00.27,text,,0,0,0,,大家怎麼都在
Dialogue: 0,0:21:02.63,0:21:03.79,text,,0,0,0,,在等你喔
Dialogue: 0,0:21:04.31,0:21:07.39,text,,0,0,0,,萬一妮娜同學改變主意的話…
Dialogue: 0,0:21:09.19,0:21:12.39,text,,0,0,0,,昨天不是就說我會留在學校了嗎
Dialogue: 0,0:21:14.51,0:21:16.39,text,,0,0,0,,你真的不後悔嗎
Dialogue: 0,0:21:17.63,0:21:18.15,text,,0,0,0,,不後悔
Dialogue: 0,0:21:18.63,0:21:21.99,text,,0,0,0,,這裡還有我需要學習的東西
Dialogue: 0,0:21:24.19,0:21:25.61,text,,0,0,0,,還有我們在嘛
Dialogue: 0,0:21:28.27,0:21:29.67,text,,0,0,0,,什麼意思
Dialogue: 0,0:21:30.56,0:21:31.35,text,,0,0,0,,妮娜他說
Dialogue: 0,0:21:33.47,0:21:35.83,text,,0,0,0,,我們都是她珍視的朋友喔
Dialogue: 0,0:21:37.35,0:21:38.27,text,,0,0,0,,妮娜同學
Dialogue: 0,0:21:38.27,0:21:38.95,text,,0,0,0,,妮娜
Dialogue: 0,0:21:38.95,0:21:39.87,text,,0,0,0,,妮娜同學
Dialogue: 0,0:21:41.27,0:21:42.55,text,,0,0,0,,你們…
Dialogue: 0,0:21:42.55,0:21:44.11,text,,0,0,0,,我太感動了
Dialogue: 0,0:21:44.11,0:21:45.59,text,,0,0,0,,這就是友情
Dialogue: 0,0:21:45.59,0:21:47.03,text,,0,0,0,,{\an1}妮娜同學愛死你啦
Dialogue: 0,0:21:45.67,0:21:48.11,text,,0,0,0,,我 我…
Dialogue: 0,0:21:47.03,0:21:48.91,text,,0,0,0,,{\an3}加窩一個
Dialogue: 0,0:21:49.49,0:21:52.45,text,,0,0,0,,最喜歡妮娜啦
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,//------------------NEXT-------------------
Dialogue: 0,0:23:29.99,0:23:32.57,text,,0,0,0,,莉昂同學
Dialogue: 0,0:23:32.77,0:23:33.55,text,,0,0,0,,你喔


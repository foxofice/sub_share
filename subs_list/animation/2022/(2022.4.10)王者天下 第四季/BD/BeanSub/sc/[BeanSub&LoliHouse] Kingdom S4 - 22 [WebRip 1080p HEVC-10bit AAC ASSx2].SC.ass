Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕组制作 仅供学习交流 禁止用于商业用途
Comment: 0,0:03:18.96,0:03:19.01,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:03:19.78,0:03:24.95,op-jp,,0,0,0,,希望に溢れた　お前の目に浮かぶのは
Dialogue: 0,0:03:24.95,0:03:26.71,op-jp,,0,0,0,,誰の幻想？
Dialogue: 0,0:03:26.71,0:03:30.06,op-jp,,0,0,0,,何もかも失いそうになって
Dialogue: 0,0:03:30.06,0:03:35.24,op-jp,,0,0,0,,巡り会うんだ　再会の誓いを
Dialogue: 0,0:03:48.19,0:03:51.19,op-jp,,0,0,0,,段々と熱くなる
Dialogue: 0,0:03:51.19,0:03:55.44,op-jp,,0,0,0,,心　燃やす　咆哮に変えてけ
Dialogue: 0,0:03:55.44,0:03:58.27,op-jp,,0,0,0,,飄々と歩くのさ
Dialogue: 0,0:03:58.27,0:04:03.17,op-jp,,0,0,0,,先の見えぬ夢を掴むまで
Dialogue: 0,0:04:03.34,0:04:08.67,op-jp,,0,0,0,,時には涙を流す夜もある
Dialogue: 0,0:04:08.67,0:04:13.30,op-jp,,0,0,0,,誓ったあの日を共に笑った事
Dialogue: 0,0:04:13.30,0:04:15.80,op-jp,,0,0,0,,胸に刻み込んで
Dialogue: 0,0:04:15.80,0:04:22.85,op-jp,,0,0,0,,嗚呼　息もできないこの世界であなたにあった夜
Dialogue: 0,0:04:22.85,0:04:29.61,op-jp,,0,0,0,,消えかけた心の灯火　輝いた
Dialogue: 0,0:04:29.98,0:04:34.36,op-jp,,0,0,0,,どんな未来だって　受け容れる
Dialogue: 0,0:04:34.36,0:04:37.12,op-jp,,0,0,0,,生きる理由なんだ
Dialogue: 0,0:04:37.12,0:04:42.37,op-jp,,0,0,0,,燃やせ　今この声が響く限り
Dialogue: 0,0:04:42.37,0:04:48.28,op-jp,,0,0,0,,果てなき明日へ
Dialogue: 0,0:04:48.28,0:04:48.28,op-jp,,0,0,0,,
Dialogue: 0,0:03:19.78,0:03:24.95,op-cn,,0,0,0,,你那充满希望的双眸中
Dialogue: 0,0:03:24.95,0:03:26.71,op-cn,,0,0,0,,映出谁的幻想？
Dialogue: 0,0:03:26.71,0:03:30.06,op-cn,,0,0,0,,在即将失去一切之时
Dialogue: 0,0:03:30.06,0:03:35.24,op-cn,,0,0,0,,邂逅重逢的誓言
Dialogue: 0,0:03:48.19,0:03:51.19,op-cn,,0,0,0,,身体愈发火热
Dialogue: 0,0:03:51.19,0:03:55.44,op-cn,,0,0,0,,燃烧内心 化为咆哮
Dialogue: 0,0:03:55.44,0:03:58.27,op-cn,,0,0,0,,步伐愈显轻盈
Dialogue: 0,0:03:58.27,0:04:03.17,op-cn,,0,0,0,,直至抓住 未知之梦
Dialogue: 0,0:04:03.34,0:04:08.67,op-cn,,0,0,0,,时而于夜晚落泪
Dialogue: 0,0:04:08.67,0:04:13.30,op-cn,,0,0,0,,一同欢笑 共度立誓之日
Dialogue: 0,0:04:13.30,0:04:15.80,op-cn,,0,0,0,,将其铭记于心
Dialogue: 0,0:04:15.80,0:04:22.85,op-cn,,0,0,0,,在这窒息的世界 邂逅你的夜晚
Dialogue: 0,0:04:22.85,0:04:29.61,op-cn,,0,0,0,,即将熄灭的心中灯火 光芒四射
Dialogue: 0,0:04:29.98,0:04:34.36,op-cn,,0,0,0,,不论怎样的未来 都甘愿接受
Dialogue: 0,0:04:34.36,0:04:37.12,op-cn,,0,0,0,,这就是活着的理由
Dialogue: 0,0:04:37.12,0:04:42.37,op-cn,,0,0,0,,燃烧吧 只要这声音回响不止
Dialogue: 0,0:04:42.37,0:04:48.28,op-cn,,0,0,8,,前往永无止境的明天
Dialogue: 0,0:02:09.30,0:02:11.30,op-cn,,0,0,0,,
Comment: 0,0:23:15.95,0:23:16.04,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:29.89,0:23:40.15,ed-jp,,0,0,0,,真っ暗闇の中、光の希望が消え去ることない
Dialogue: 0,0:23:40.15,0:23:43.59,ed-jp,,0,0,0,,ただひとつの誓い
Dialogue: 0,0:23:43.59,0:23:49.82,ed-jp,,0,0,0,,傷だらけでも傷んだ分だけ
Dialogue: 0,0:23:49.82,0:23:56.98,ed-jp,,0,0,0,,繋いだ心　そばにあるさ
Dialogue: 0,0:23:57.17,0:24:03.79,ed-jp,,0,0,0,,大切なもの守り抜けと　その血、汗、涙が導く
Dialogue: 0,0:24:03.79,0:24:10.82,ed-jp,,0,0,0,,己の心に従え、振り向くな、さぁ立ち上がれ
Dialogue: 0,0:24:10.82,0:24:16.53,ed-jp,,0,0,0,,俺が俺である限り　己信じ、明日を思い描け
Dialogue: 0,0:24:16.53,0:24:19.78,ed-jp,,0,0,0,,恐れるな、さぁ高く翔べ
Dialogue: 0,0:24:19.78,0:24:25.73,ed-jp,,0,0,0,,俺たちが輝く日まで
Dialogue: 0,0:24:25.73,0:24:27.73,ed-jp,,0,0,0,,
Dialogue: 0,0:23:29.89,0:23:40.15,ed-cn,,0,0,0,,即便陷入黑暗 希望之光也不会消失
Dialogue: 0,0:23:40.15,0:23:43.59,ed-cn,,0,0,0,,这唯一的誓言
Dialogue: 0,0:23:43.59,0:23:49.82,ed-cn,,0,0,0,,受伤几次 就强大几分
Dialogue: 0,0:23:49.82,0:23:56.98,ed-cn,,0,0,0,,我们心心相连 不离不弃
Dialogue: 0,0:23:57.17,0:24:03.79,ed-cn,,0,0,0,,守护珍视之物 以鲜血 汗水 泪水为指引
Dialogue: 0,0:24:03.79,0:24:10.82,ed-cn,,0,0,0,,遵循内心 不要回头 奋起战斗
Dialogue: 0,0:24:10.82,0:24:16.53,ed-cn,,0,0,0,,只要我还是我 就相信自己 描绘明天
Dialogue: 0,0:24:16.53,0:24:19.78,ed-cn,,0,0,0,,不要畏惧 展翅高飞
Dialogue: 0,0:24:19.78,0:24:25.73,ed-cn,,0,0,0,,飞向我们大放异彩之日
Dialogue: 0,0:24:25.73,0:24:25.73,ed-cn,,0,0,0,,
Dialogue: 0,0:00:02.72,0:00:04.60,Default,,0,0,0,,逝去的人们
Dialogue: 0,0:00:05.83,0:00:06.53,Default,,0,0,0,,王骑
Dialogue: 0,0:00:07.40,0:00:08.45,Default,,0,0,0,,麃公
Dialogue: 0,0:00:09.47,0:00:10.51,Default,,0,0,0,,成蟜
Dialogue: 0,0:00:11.22,0:00:14.15,Default,,0,0,0,,以及众多无名之人
Dialogue: 0,0:00:17.37,0:00:19.08,Default,,0,0,0,,虽然身份地位各不相同
Dialogue: 0,0:00:19.40,0:00:20.72,Default,,0,0,0,,但他们所有人
Dialogue: 0,0:00:21.26,0:00:23.30,Default,,0,0,0,,生前都拼命地
Dialogue: 0,0:00:24.33,0:00:26.63,Default,,0,0,0,,想让体内那簇光更加明亮
Dialogue: 0,0:00:27.86,0:00:30.00,Default,,0,0,0,,而那簇光
Dialogue: 0,0:00:30.40,0:00:32.03,Default,,0,0,0,,又由后继者继承
Dialogue: 0,0:00:33.16,0:00:34.82,Default,,0,0,0,,变得更加有力
Dialogue: 0,0:00:37.41,0:00:39.10,Default,,0,0,0,,更加明亮
Dialogue: 0,0:00:39.64,0:00:41.64,Default,,0,0,0,,人就是如此联系
Dialogue: 0,0:00:43.43,0:00:45.65,Default,,0,0,0,,朝着更好的方向前进
Dialogue: 0,0:00:47.47,0:00:49.02,Default,,0,0,0,,人之所以会堕入黑暗
Dialogue: 0,0:00:50.07,0:00:52.50,Default,,0,0,0,,是因为迷失了自己的光
Dialogue: 0,0:00:53.24,0:00:56.53,Default,,0,0,0,,那些人寻不见光 苦苦挣扎 饱受折磨
Dialogue: 0,0:00:57.02,0:00:58.24,Default,,0,0,0,,悲剧由此而生
Dialogue: 0,0:01:00.21,0:01:06.25,Default,,0,0,0,,增幅悲剧 使人堕入黑暗的罪魁祸首便是战争
Dialogue: 0,0:01:07.12,0:01:09.50,Default,,0,0,0,,因此 寡人要消除战争
Dialogue: 0,0:01:10.21,0:01:11.50,Default,,0,0,0,,使用武力消除吗
Dialogue: 0,0:01:11.94,0:01:12.99,Default,,0,0,0,,正是
Dialogue: 0,0:01:13.84,0:01:16.00,Default,,0,0,0,,寡人是战国之君王
Dialogue: 0,0:01:16.87,0:01:19.51,Default,,0,0,0,,注定无法摆脱战争
Dialogue: 0,0:01:20.87,0:01:22.76,Default,,0,0,0,,既然如此 就在寡人这一代消除战争
Dialogue: 0,0:01:23.28,0:01:26.77,Default,,0,0,0,,即便被指为暴君 也要用武力去实现
Dialogue: 0,0:01:27.51,0:01:31.00,Default,,0,0,0,,让中华没有隔阂 不分上下
Dialogue: 0,0:01:31.48,0:01:32.55,Default,,0,0,0,,合而为一
Dialogue: 0,0:01:33.01,0:01:34.28,Default,,0,0,0,,如此一来
Dialogue: 0,0:01:35.02,0:01:36.47,Default,,0,0,0,,寡人的下一代人
Dialogue: 0,0:01:38.39,0:01:41.30,Default,,0,0,0,,就一定不再需要自相残杀
Dialogue: 0,0:02:02.96,0:02:03.78,Default,,0,0,0,,吕不韦
Dialogue: 0,0:02:04.79,0:02:08.03,Default,,0,0,0,,究竟怎样的世界才更加…
Dialogue: 0,0:02:08.03,0:02:10.02,Default,,0,0,0,,不必再说了
Dialogue: 0,0:02:17.98,0:02:23.41,Default,,0,0,0,,您所构思的世界和我所构思的世界
Dialogue: 0,0:02:24.49,0:02:27.54,Default,,0,0,0,,其出发点 前提大不相同
Dialogue: 0,0:02:28.62,0:02:32.87,Default,,0,0,0,,即便继续讨论下去 也无法得出结论
Dialogue: 0,0:02:34.45,0:02:37.84,Default,,0,0,0,,不过 话说回来
Dialogue: 0,0:02:39.38,0:02:43.14,Default,,0,0,0,,您真是长大了啊 大王
Dialogue: 0,0:02:56.44,0:02:57.70,Default,,0,0,0,,我已经知道
Dialogue: 0,0:02:58.31,0:03:03.48,Default,,0,0,0,,我们二人所构思的为政之道都绝非寻常
Dialogue: 0,0:03:04.09,0:03:06.23,Default,,0,0,0,,我们之间的胜负
Dialogue: 0,0:03:06.96,0:03:12.19,Default,,0,0,0,,将决定秦国明天将走上怎样的道路
Dialogue: 0,0:03:13.20,0:03:17.78,Default,,0,0,0,,而答案即将在咸阳得出
Dialogue: 0,0:04:49.47,0:04:52.64,biaoti,,0,0,0,,{\pos(1811,810)\fad(480,470)}命悬一线的奔逃
Dialogue: 0,0:04:50.25,0:04:55.69,Default,,0,0,0,,每一座建筑都散发着强烈的女人味
Dialogue: 0,0:04:56.04,0:04:58.80,Default,,0,0,0,,后宫真叫人把持不住啊
Dialogue: 0,0:05:01.97,0:05:05.61,Default,,0,0,0,,宫女的肉比普通女人的更柔软
Dialogue: 0,0:05:06.46,0:05:09.37,Default,,0,0,0,,大王居然能独占她们
Dialogue: 0,0:05:10.22,0:05:11.11,Default,,0,0,0,,琉期大人
Dialogue: 0,0:05:11.42,0:05:14.69,Default,,0,0,0,,樊於期大人前去斩杀太子了
Dialogue: 0,0:05:15.25,0:05:17.17,Default,,0,0,0,,我们也快拿下公主吧
Dialogue: 0,0:05:17.47,0:05:18.88,Default,,0,0,0,,我知道
Dialogue: 0,0:05:19.64,0:05:21.46,Default,,0,0,0,,不过也不要心急
Dialogue: 0,0:05:22.24,0:05:26.01,Default,,0,0,0,,反正大王的子女无处可逃
Dialogue: 0,0:05:32.08,0:05:34.34,Default,,0,0,0,,外面的呼喊声已经很近了
Dialogue: 0,0:05:35.21,0:05:37.30,Default,,0,0,0,,微久阁下 快开门
Dialogue: 0,0:05:39.17,0:05:40.44,Default,,0,0,0,,为什么
Dialogue: 0,0:05:41.49,0:05:44.24,Default,,0,0,0,,黑石移动了
Dialogue: 0,0:05:45.48,0:05:49.68,Default,,0,0,0,,今天早上 我来检查这扇门是否锁好
Dialogue: 0,0:05:50.10,0:05:54.90,Default,,0,0,0,,然后以防万一 贴着门放了一块黑石
Dialogue: 0,0:05:56.39,0:05:59.21,Default,,0,0,0,,而现在 黑石居然移动了
Dialogue: 0,0:05:59.54,0:06:02.31,Default,,0,0,0,,有人进入了门内
Dialogue: 0,0:06:03.88,0:06:05.00,Default,,0,0,0,,微久阁下
Dialogue: 0,0:06:05.22,0:06:06.63,Default,,0,0,0,,不能走这里
Dialogue: 0,0:06:08.00,0:06:09.94,Default,,0,0,0,,为什么这里会被发现
Dialogue: 0,0:06:10.36,0:06:13.86,Default,,0,0,0,,这可是连太后都不知道的地道入口啊
Dialogue: 0,0:06:14.68,0:06:19.35,Default,,0,0,0,,难道说 我这几天被人监视了？
Dialogue: 0,0:06:19.78,0:06:21.85,Default,,0,0,0,,微久阁下 为什么不行啊
Dialogue: 0,0:06:22.24,0:06:23.41,Default,,0,0,0,,那要去哪里
Dialogue: 0,0:06:25.32,0:06:26.78,Default,,0,0,0,,哎呀
Dialogue: 0,0:06:27.27,0:06:31.18,Default,,0,0,0,,向大人和丽殿下 很高兴看到二位平安无事
Dialogue: 0,0:06:31.76,0:06:34.67,Default,,0,0,0,,请快些进入地道
Dialogue: 0,0:06:35.43,0:06:36.42,Default,,0,0,0,,微久阁下
Dialogue: 0,0:06:36.55,0:06:38.82,Default,,0,0,0,,不要靠近 你是何人
Dialogue: 0,0:06:39.31,0:06:44.34,Default,,0,0,0,,我是大王钦点的内务官 微久
Dialogue: 0,0:06:44.88,0:06:48.54,Default,,0,0,0,,我是大殿侍者 名叫亚民
Dialogue: 0,0:06:48.95,0:06:51.63,Default,,0,0,0,,内务官大人 请快进入地道
Dialogue: 0,0:06:51.63,0:06:53.93,Default,,0,0,0,,我来带路
Dialogue: 0,0:06:54.29,0:06:55.11,Default,,0,0,0,,不必
Dialogue: 0,0:06:55.32,0:06:57.68,Default,,0,0,0,,由我带她们三位逃离便可
Dialogue: 0,0:07:01.43,0:07:02.31,Default,,0,0,0,,小向
Dialogue: 0,0:07:07.16,0:07:08.23,Default,,0,0,0,,微久阁下
Dialogue: 0,0:07:09.83,0:07:10.94,Default,,0,0,0,,快逃
Dialogue: 0,0:07:11.24,0:07:13.45,Default,,0,0,0,,趁现在 快逃
Dialogue: 0,0:07:13.51,0:07:14.03,Default,,0,0,0,,微…
Dialogue: 0,0:07:15.45,0:07:16.87,Default,,0,0,0,,我们走 小向
Dialogue: 0,0:07:23.68,0:07:24.71,Default,,0,0,0,,小阳
Dialogue: 0,0:07:26.44,0:07:27.91,Default,,0,0,0,,你的脚都肿成这样了
Dialogue: 0,0:07:28.20,0:07:30.36,Default,,0,0,0,,小阳 说不定伤到了骨头
Dialogue: 0,0:07:32.82,0:07:34.68,Default,,0,0,0,,我没事 快走吧
Dialogue: 0,0:07:35.24,0:07:37.59,Default,,0,0,0,,都有宦官和敌人勾结了
Dialogue: 0,0:07:38.16,0:07:39.64,Default,,0,0,0,,说不定宫女中也有人通敌
Dialogue: 0,0:07:40.15,0:07:42.98,Default,,0,0,0,,这里很危险 必须快点离开
Dialogue: 0,0:07:43.76,0:07:44.92,Default,,0,0,0,,小阳…
Dialogue: 0,0:07:45.78,0:07:46.74,Default,,0,0,0,,丽…
Dialogue: 0,0:07:47.67,0:07:48.64,Default,,0,0,0,,没事的
Dialogue: 0,0:07:49.08,0:07:53.45,Default,,0,0,0,,我和小向的运气和骨气可不输其他宫女
Dialogue: 0,0:07:54.31,0:07:57.39,Default,,0,0,0,,你也要尽全力往前跑
Dialogue: 0,0:07:58.30,0:07:58.88,Default,,0,0,0,,嗯
Dialogue: 0,0:08:00.79,0:08:02.28,Default,,0,0,0,,小阳 我来扶你
Dialogue: 0,0:08:02.28,0:08:03.13,Default,,0,0,0,,不用
Dialogue: 0,0:08:04.12,0:08:06.23,Default,,0,0,0,,小向 你看
Dialogue: 0,0:08:08.02,0:08:11.78,Default,,0,0,0,,这里是我们第一次相遇的地方 黄大庭
Dialogue: 0,0:08:12.95,0:08:13.66,Default,,0,0,0,,丽
Dialogue: 0,0:08:14.13,0:08:19.31,Default,,0,0,0,,我和小向就是在这里打扫的时候认识的
Dialogue: 0,0:08:20.45,0:08:24.02,Default,,0,0,0,,那时我们光顾着聊天 每天都被骂
Dialogue: 0,0:08:27.83,0:08:31.91,Default,,0,0,0,,废物 你没能把她们关到地道里？
Dialogue: 0,0:08:31.91,0:08:34.77,Default,,0,0,0,,是 是的 非常抱歉
Dialogue: 0,0:08:35.21,0:08:38.95,Default,,0,0,0,,不知为何 微久在开门前察觉到了异样
Dialogue: 0,0:08:39.58,0:08:40.85,Default,,0,0,0,,让他们逃了吗
Dialogue: 0,0:08:41.25,0:08:43.49,Default,,0,0,0,,请 请不必担心
Dialogue: 0,0:08:43.64,0:08:45.46,Default,,0,0,0,,这里是我们的庭院
Dialogue: 0,0:08:46.00,0:08:47.71,Default,,0,0,0,,很快就能找到她们
Dialogue: 0,0:08:48.29,0:08:49.78,Default,,0,0,0,,去通知琉期大人
Dialogue: 0,0:08:50.15,0:08:50.69,Default,,0,0,0,,是
Dialogue: 0,0:08:51.30,0:08:53.79,Default,,0,0,0,,对宫女们来说也是庭院啊
Dialogue: 0,0:08:54.28,0:08:56.22,Default,,0,0,0,,琉期大人不允许失败
Dialogue: 0,0:08:56.95,0:09:00.68,Default,,0,0,0,,你们会不得好死的 洗干净脖子等着吧
Dialogue: 0,0:09:01.40,0:09:02.58,Default,,0,0,0,,不要啊
Dialogue: 0,0:09:02.58,0:09:04.23,Default,,0,0,0,,请慢着 马上就能找到
Dialogue: 0,0:09:04.99,0:09:07.06,Default,,0,0,0,,我知道向她们逃跑的方向
Dialogue: 0,0:09:07.92,0:09:09.00,Default,,0,0,0,,为什么知道
Dialogue: 0,0:09:10.12,0:09:13.94,Default,,0,0,0,,这一带是她们两人从小就负责打理的区域
Dialogue: 0,0:09:14.74,0:09:19.27,Default,,0,0,0,,她们对这里过于了解 所以能预测到她们的逃跑路线
Dialogue: 0,0:09:20.87,0:09:24.24,Default,,0,0,0,,那小丫头竟不知好歹地获得了这样的幸福
Dialogue: 0,0:09:24.44,0:09:26.70,Default,,0,0,0,,请一定要让她凄惨地死去
Dialogue: 0,0:09:34.40,0:09:36.21,Default,,0,0,0,,前面右拐没错吧 小阳
Dialogue: 0,0:09:36.76,0:09:38.05,Default,,0,0,0,,对 右拐
Dialogue: 0,0:09:38.48,0:09:39.81,Default,,0,0,0,,然后再经过两片房屋
Dialogue: 0,0:09:40.54,0:09:41.92,Default,,0,0,0,,只要走出小路…
Dialogue: 0,0:09:42.83,0:09:43.89,Default,,0,0,0,,就能最快…
Dialogue: 0,0:09:46.76,0:09:48.25,Default,,0,0,0,,来到三低道
Dialogue: 0,0:09:48.88,0:09:49.48,Default,,0,0,0,,小阳
Dialogue: 0,0:09:50.02,0:09:50.85,Default,,0,0,0,,好
Dialogue: 0,0:09:51.76,0:09:54.85,Default,,0,0,0,,从这里进入流淌在后宫的可晶水道
Dialogue: 0,0:09:55.18,0:09:57.00,Default,,0,0,0,,就能乘船去到最北端
Dialogue: 0,0:09:58.28,0:10:02.77,Default,,0,0,0,,这种时候 最优先的是远离敌人
Dialogue: 0,0:10:03.51,0:10:04.80,Default,,0,0,0,,是父亲教我的
Dialogue: 0,0:10:15.99,0:10:17.86,Default,,0,0,0,,快进入刚才的小路
Dialogue: 0,0:10:19.51,0:10:20.43,Default,,0,0,0,,小阳
Dialogue: 0,0:10:22.33,0:10:24.21,Default,,0,0,0,,往水道跑 小向
Dialogue: 0,0:10:24.97,0:10:26.47,Default,,0,0,0,,我来争取时间
Dialogue: 0,0:10:27.08,0:10:29.36,Default,,0,0,0,,你 你说什么呢
Dialogue: 0,0:10:29.36,0:10:31.25,Default,,0,0,0,,我不要 小阳 我们一起…
Dialogue: 0,0:10:31.25,0:10:31.96,Default,,0,0,0,,向
Dialogue: 0,0:10:32.51,0:10:35.27,Default,,0,0,0,,你不是说无论如何也要保护丽吗
Dialogue: 0,0:10:35.97,0:10:40.20,Default,,0,0,0,,去履行你作为妃子 作为母亲的使命吧
Dialogue: 0,0:10:45.11,0:10:46.95,Default,,0,0,0,,快走吧 小向
Dialogue: 0,0:10:47.50,0:10:48.13,Default,,0,0,0,,嗯…
Dialogue: 0,0:11:00.32,0:11:02.34,Default,,0,0,0,,小阳 小阳
Dialogue: 0,0:11:02.80,0:11:04.14,Default,,0,0,0,,小阳
Dialogue: 0,0:11:07.03,0:11:09.97,Default,,0,0,0,,扑到领头的马身上 让它摔倒
Dialogue: 0,0:11:10.16,0:11:12.92,Default,,0,0,0,,把后面的马一起绊倒
Dialogue: 0,0:11:14.53,0:11:17.27,Default,,0,0,0,,怎么可能这么顺利
Dialogue: 0,0:11:18.80,0:11:20.77,Default,,0,0,0,,总之要把领头的那匹马…
Dialogue: 0,0:11:22.12,0:11:25.20,Default,,0,0,0,,会痛吗 肯定会很痛吧
Dialogue: 0,0:11:26.37,0:11:28.61,Default,,0,0,0,,这种事不重要
Dialogue: 0,0:11:30.06,0:11:32.08,Default,,0,0,0,,小向 我啊
Dialogue: 0,0:11:33.52,0:11:37.72,Default,,0,0,0,,虽然你是我的好朋友 但我却有点把你当妹妹
Dialogue: 0,0:11:39.42,0:11:43.70,Default,,0,0,0,,我五岁的时候 唯一的妹妹病死了
Dialogue: 0,0:11:44.84,0:11:49.21,Default,,0,0,0,,或许是我在你的身上 看到了妹妹的影子
Dialogue: 0,0:11:53.16,0:11:55.38,Default,,0,0,0,,跑到最后一刻吧 小向
Dialogue: 0,0:12:01.87,0:12:06.18,Default,,0,0,0,,老天啊 请一定要保佑她们二人平安无事
Dialogue: 0,0:12:06.76,0:12:08.05,Default,,0,0,0,,小阳
Dialogue: 0,0:12:17.35,0:12:20.63,Default,,0,0,0,,真是的 你这宫女真是够猛啊
Dialogue: 0,0:12:21.88,0:12:24.16,Default,,0,0,0,,退后点 骨气宫女
Dialogue: 0,0:12:25.11,0:12:26.59,Default,,0,0,0,,已经没事了
Dialogue: 0,0:12:27.89,0:12:29.34,Default,,0,0,0,,对方是骑马的啊
Dialogue: 0,0:12:36.52,0:12:37.40,Default,,0,0,0,,把马给…
Dialogue: 0,0:12:41.09,0:12:43.63,Default,,0,0,0,,彭英 夏布 高陆
Dialogue: 0,0:12:55.99,0:12:57.08,Default,,0,0,0,,等等
Dialogue: 0,0:13:04.16,0:13:08.00,Default,,0,0,0,,我的手 我的手啊
Dialogue: 0,0:13:09.00,0:13:10.65,Default,,0,0,0,,琉 琉期大人
Dialogue: 0,0:13:10.81,0:13:11.83,Default,,0,0,0,,该死的
Dialogue: 0,0:13:13.88,0:13:15.25,Default,,0,0,0,,又有骑兵来了
Dialogue: 0,0:13:16.52,0:13:17.68,Default,,0,0,0,,别担心
Dialogue: 0,0:13:19.28,0:13:20.88,Default,,0,0,0,,那是我的人
Dialogue: 0,0:13:21.04,0:13:21.89,Default,,0,0,0,,信
Dialogue: 0,0:13:21.89,0:13:23.33,Default,,0,0,0,,我们这就来
Dialogue: 0,0:13:26.32,0:13:27.76,Default,,0,0,0,,你 你们几个
Dialogue: 0,0:13:30.20,0:13:32.82,Default,,0,0,0,,居然丢下队长自己跑了
Dialogue: 0,0:13:33.36,0:13:35.50,Default,,0,0,0,,你真没人望啊
Dialogue: 0,0:13:35.95,0:13:38.51,Default,,0,0,0,,和我们的队长差远了
Dialogue: 0,0:13:38.96,0:13:41.08,Default,,0,0,0,,你的伤没事吧 信
Dialogue: 0,0:13:41.63,0:13:42.40,Default,,0,0,0,,没事
Dialogue: 0,0:13:46.81,0:13:47.78,Default,,0,0,0,,田有怎么样
Dialogue: 0,0:13:48.28,0:13:50.74,Default,,0,0,0,,躲起来的王宫侍者们出来了
Dialogue: 0,0:13:50.84,0:13:52.87,Default,,0,0,0,,要他们帮忙给他包扎了
Dialogue: 0,0:13:54.23,0:13:57.54,Default,,0,0,0,,别担心 几支箭可杀不死他
Dialogue: 0,0:14:03.93,0:14:05.60,Default,,0,0,0,,喂 混账东西
Dialogue: 0,0:14:06.40,0:14:09.53,Default,,0,0,0,,你知道我们为什么能追到这里来吗
Dialogue: 0,0:14:11.88,0:14:15.75,Default,,0,0,0,,只有你的队冲得太前 这是原因之一
Dialogue: 0,0:14:16.42,0:14:17.52,Default,,0,0,0,,但更重要的是…
Dialogue: 0,0:14:19.04,0:14:20.72,Default,,0,0,0,,你们杀太多了
Dialogue: 0,0:14:21.32,0:14:25.26,Default,,0,0,0,,我们是循着你们杀人留下的血迹追来的
Dialogue: 0,0:14:27.26,0:14:30.07,Default,,0,0,0,,你在生什么气啊
Dialogue: 0,0:14:30.96,0:14:33.51,Default,,0,0,0,,杀 要杀
Dialogue: 0,0:14:33.88,0:14:35.28,Default,,0,0,0,,当然要杀
Dialogue: 0,0:14:35.58,0:14:38.90,Default,,0,0,0,,这就是率军之人的特权啊
Dialogue: 0,0:14:39.13,0:14:40.27,Default,,0,0,0,,杀太多？
Dialogue: 0,0:14:41.22,0:14:42.88,Default,,0,0,0,,你是哪来的圣人
Dialogue: 0,0:14:43.41,0:14:46.16,Default,,0,0,0,,你也是武将 那应该也清楚吧
Dialogue: 0,0:14:46.66,0:14:51.41,Default,,0,0,0,,把大群大群的人像碾死虫子一样杀死的快感
Dialogue: 0,0:14:55.72,0:14:59.08,Default,,0,0,0,,别把我和你相提并论 变态
Dialogue: 0,0:14:59.56,0:15:02.87,Default,,0,0,0,,你怎么不直接砍了他啊 信
Dialogue: 0,0:15:03.36,0:15:05.83,Default,,0,0,0,,这家伙就是个人渣
Dialogue: 0,0:15:06.78,0:15:07.56,Default,,0,0,0,,不行
Dialogue: 0,0:15:08.59,0:15:11.05,Default,,0,0,0,,指挥官级别的要尽可能活捉
Dialogue: 0,0:15:11.36,0:15:14.35,Default,,0,0,0,,让他们招供吕不韦的罪行
Dialogue: 0,0:15:14.95,0:15:16.15,Default,,0,0,0,,所以说 去亥
Dialogue: 0,0:15:16.74,0:15:18.75,Default,,0,0,0,,去给他止血吧
Dialogue: 0,0:15:20.01,0:15:20.69,Default,,0,0,0,,该死的
Dialogue: 0,0:15:21.73,0:15:24.20,Default,,0,0,0,,话说 刚才那一拳该不会已经给打死了吧
Dialogue: 0,0:15:27.31,0:15:28.23,Default,,0,0,0,,小向
Dialogue: 0,0:15:30.58,0:15:32.63,Default,,0,0,0,,小阳 小阳
Dialogue: 0,0:15:32.91,0:15:33.81,Default,,0,0,0,,太好了
Dialogue: 0,0:15:34.31,0:15:37.36,Default,,0,0,0,,我真的以为你要死了
Dialogue: 0,0:15:37.84,0:15:38.95,Default,,0,0,0,,真的…
Dialogue: 0,0:15:43.16,0:15:45.68,Default,,0,0,0,,好久不见了啊 土气宫女
Dialogue: 0,0:15:47.08,0:15:49.35,Default,,0,0,0,,这就是政的女儿吗
Dialogue: 0,0:15:50.77,0:15:52.88,Default,,0,0,0,,公 公主殿下？
Dialogue: 0,0:15:53.56,0:15:56.07,Default,,0,0,0,,你 你该不会是…
Dialogue: 0,0:16:04.91,0:16:05.89,Default,,0,0,0,,你怕不怕
Dialogue: 0,0:16:13.36,0:16:16.87,Default,,0,0,0,,看来不光是长相 连强势的性格都和他一样
Dialogue: 0,0:16:17.68,0:16:18.94,Default,,0,0,0,,你认识我吗
Dialogue: 0,0:16:24.02,0:16:27.75,Default,,0,0,0,,我是你老爸最好的朋友 信
Dialogue: 0,0:16:30.53,0:16:33.41,Default,,0,0,0,,总之 还好及时救下了你
Dialogue: 0,0:16:43.49,0:16:47.77,Default,,0,0,0,,其他部队来了消息 说太子也没事
Dialogue: 0,0:16:48.18,0:16:52.20,Default,,0,0,0,,这里视野很好 我们就在这里保护你们
Dialogue: 0,0:16:52.68,0:16:55.53,Default,,0,0,0,,以防万一 你们先想好逃离路线
Dialogue: 0,0:16:56.02,0:16:57.24,Default,,0,0,0,,我去城外
Dialogue: 0,0:16:57.84,0:17:00.28,Default,,0,0,0,,她们三个就拜托你们了 沛浪 去亥
Dialogue: 0,0:17:00.48,0:17:01.94,Default,,0,0,0,,好 没问题
Dialogue: 0,0:17:02.12,0:17:05.29,Default,,0,0,0,,地道里的敌人也扫清了 逃跑路线很多
Dialogue: 0,0:17:05.68,0:17:08.75,Default,,0,0,0,,你 你都受伤了还要战斗吗
Dialogue: 0,0:17:10.69,0:17:13.83,Default,,0,0,0,,我本以为貂已经进来 城门已经关上了
Dialogue: 0,0:17:13.83,0:17:14.79,Default,,0,0,0,,但并没有
Dialogue: 0,0:17:16.11,0:17:20.31,Default,,0,0,0,,要是外面的敌军全部涌进来
Dialogue: 0,0:17:21.19,0:17:23.03,Default,,0,0,0,,咸阳就会陷落
Dialogue: 0,0:17:24.52,0:17:27.59,Default,,0,0,0,,外面的战斗才决定着我们的命运
Dialogue: 0,0:17:28.63,0:17:31.37,Default,,0,0,0,,左边的部队阵型快散了
Dialogue: 0,0:17:31.83,0:17:34.03,Default,,0,0,0,,快去支援 否则他们会被敌人干掉
Dialogue: 0,0:17:34.27,0:17:37.49,Default,,0,0,0,,做不到 大家都在全力防守自己的阵地
Dialogue: 0,0:17:37.85,0:17:39.07,Default,,0,0,0,,尚鹿将军
Dialogue: 0,0:17:39.76,0:17:41.49,Default,,0,0,0,,有寿阁下战死
Dialogue: 0,0:17:45.69,0:17:48.05,Default,,0,0,0,,秦国的混蛋还挺能挣扎啊
Dialogue: 0,0:17:48.54,0:17:50.32,Default,,0,0,0,,命大队前压
Dialogue: 0,0:17:50.32,0:17:51.00,Default,,0,0,0,,是
Dialogue: 0,0:17:55.30,0:17:56.58,Default,,0,0,0,,尚鹿将军
Dialogue: 0,0:17:57.16,0:17:59.80,Default,,0,0,0,,加毛大人 加燕大人 战死
Dialogue: 0,0:18:00.88,0:18:03.10,Default,,0,0,0,,周虎队也几乎全军覆没
Dialogue: 0,0:18:04.93,0:18:07.35,Default,,0,0,0,,中央的队形已经溃散
Dialogue: 0,0:18:07.86,0:18:10.13,Default,,0,0,0,,必须暂时撤退 重整阵型
Dialogue: 0,0:18:10.40,0:18:12.68,Default,,0,0,0,,否则我军会全军覆没
Dialogue: 0,0:18:14.36,0:18:15.65,Default,,0,0,0,,不能撤退
Dialogue: 0,0:18:16.40,0:18:20.00,Default,,0,0,0,,正因为有我们这支部队 敌人才会留在城外
Dialogue: 0,0:18:20.36,0:18:21.40,Default,,0,0,0,,要是我们撤退
Dialogue: 0,0:18:21.40,0:18:23.89,Default,,0,0,0,,敌人就会进入城内 关上城门
Dialogue: 0,0:18:23.98,0:18:26.87,Default,,0,0,0,,那样一来 城内的人就都死定了
Dialogue: 0,0:18:27.27,0:18:29.08,Default,,0,0,0,,无论如何都要守住这里
Dialogue: 0,0:18:29.80,0:18:31.29,Default,,0,0,0,,敌人来袭
Dialogue: 0,0:18:31.52,0:18:33.57,Default,,0,0,0,,保护将军
Dialogue: 0,0:18:33.66,0:18:35.60,Default,,0,0,0,,别想接近将军
Dialogue: 0,0:18:37.79,0:18:39.50,Default,,0,0,0,,河了貂 退后
Dialogue: 0,0:18:42.32,0:18:44.43,Default,,0,0,0,,要想拯救咸阳
Dialogue: 0,0:18:45.33,0:18:47.90,Default,,0,0,0,,就只有我军进入城内关闭城门
Dialogue: 0,0:18:48.28,0:18:51.49,Default,,0,0,0,,或击杀敌将 逆转取胜
Dialogue: 0,0:18:51.60,0:18:53.16,Default,,0,0,0,,此外没有别的方法
Dialogue: 0,0:18:53.84,0:18:55.79,Default,,0,0,0,,敌军也意识到了这一点
Dialogue: 0,0:18:56.02,0:18:57.30,Default,,0,0,0,,因此敌将退得很远
Dialogue: 0,0:18:57.91,0:19:01.17,Default,,0,0,0,,城门附近也防守严密
Dialogue: 0,0:19:03.02,0:19:03.82,Default,,0,0,0,,可恶
Dialogue: 0,0:19:04.05,0:19:05.44,Default,,0,0,0,,去死
Dialogue: 0,0:19:07.13,0:19:09.50,Default,,0,0,0,,田贝 去帮将军
Dialogue: 0,0:19:12.42,0:19:14.49,Default,,0,0,0,,可恶 有没有办法
Dialogue: 0,0:19:14.63,0:19:17.02,Default,,0,0,0,,我必须找到取胜的办法
Dialogue: 0,0:19:18.08,0:19:22.44,Default,,0,0,0,,政好不容易加冠 秦国就要重生
Dialogue: 0,0:19:23.20,0:19:25.48,Default,,0,0,0,,要是输了 一切就将化为泡影
Dialogue: 0,0:19:29.26,0:19:30.39,Default,,0,0,0,,又有一支部队冲过来了
Dialogue: 0,0:19:30.74,0:19:32.12,Default,,0,0,0,,那是什么
Dialogue: 0,0:19:32.27,0:19:34.15,Default,,0,0,0,,快 快逃 河了貂
Dialogue: 0,0:19:35.89,0:19:36.65,Default,,0,0,0,,快点
Dialogue: 0,0:19:38.47,0:19:40.40,Default,,0,0,0,,我的巨钺攻进去了啊
Dialogue: 0,0:19:41.25,0:19:44.34,Default,,0,0,0,,像蝼蚁一样 被碾死吧
Dialogue: 0,0:19:52.47,0:19:54.05,Default,,0,0,0,,河了貂 快逃
Dialogue: 0,0:19:54.69,0:19:55.74,Default,,0,0,0,,河了貂
Dialogue: 0,0:20:00.05,0:20:00.74,Default,,0,0,0,,什么声音
Dialogue: 0,0:20:01.36,0:20:07.22,Default,,0,0,0,,这声音 在咸阳的所有人头顶回响
Dialogue: 0,0:20:10.64,0:20:14.19,Default,,0,0,0,,这是昌平君一行人抵达的信号
Dialogue: 0,0:20:23.69,0:20:25.38,Default,,0,0,0,,是 是援军吗
Dialogue: 0,0:20:25.69,0:20:26.83,Default,,0,0,0,,从西边来的？
Dialogue: 0,0:20:27.18,0:20:29.41,Default,,0,0,0,,戎翟公 背后出现敌人
Dialogue: 0,0:20:30.17,0:20:31.14,Default,,0,0,0,,什么
Dialogue: 0,0:20:35.04,0:20:36.32,Default,,0,0,0,,咸阳居然…
Dialogue: 0,0:20:37.16,0:20:38.41,Default,,0,0,0,,烧起来了
Dialogue: 0,0:20:41.83,0:20:46.09,Default,,0,0,0,,虽然还算及时赶到 但局势不容乐观
Dialogue: 0,0:20:46.51,0:20:49.68,Default,,0,0,0,,敌军有三万 而我们只有约千骑
Dialogue: 0,0:20:50.32,0:20:52.12,Default,,0,0,0,,速度就是生命
Dialogue: 0,0:20:52.74,0:20:53.84,Default,,0,0,0,,没错
Dialogue: 0,0:20:54.35,0:20:55.06,Default,,0,0,0,,我们走
Dialogue: 0,0:20:57.38,0:20:59.07,Default,,0,0,0,,来 来了
Dialogue: 0,0:20:59.36,0:21:01.24,Default,,0,0,0,,快向后列队
Dialogue: 0,0:21:01.60,0:21:04.36,Default,,0,0,0,,六百 七百…也就一千左右
Dialogue: 0,0:21:04.85,0:21:07.16,Default,,0,0,0,,不要慌 靠后方部队挡住
Dialogue: 0,0:21:07.50,0:21:09.36,Default,,0,0,0,,仅靠后方部队挡不住
Dialogue: 0,0:21:09.99,0:21:12.04,Default,,0,0,0,,把哈穆伊和诺克叫回来
Dialogue: 0,0:21:12.40,0:21:13.57,Default,,0,0,0,,戎翟公
Dialogue: 0,0:21:14.71,0:21:18.21,Default,,0,0,0,,如果那支部队是从雍城而来
Dialogue: 0,0:21:18.63,0:21:20.28,Default,,0,0,0,,那必定非同小可
Dialogue: 0,0:21:21.35,0:21:23.70,Default,,0,0,0,,假设他们仅半日就抵达了这里
Dialogue: 0,0:21:24.34,0:21:27.48,Default,,0,0,0,,那说明他们还事先做好了更换马匹的准备
Dialogue: 0,0:21:28.44,0:21:30.51,Default,,0,0,0,,冲锋已经开始了
Dialogue: 0,0:21:31.18,0:21:32.01,Default,,0,0,0,,这么快？
Dialogue: 0,0:21:32.31,0:21:35.87,Default,,0,0,0,,是想抢在敌人整好队形之前 先下手为强
Dialogue: 0,0:21:35.87,0:21:36.96,Default,,0,0,0,,河了貂
Dialogue: 0,0:21:37.73,0:21:41.19,Default,,0,0,0,,听说秦军总司令的援军到了 是真的吗
Dialogue: 0,0:21:41.56,0:21:42.71,Default,,0,0,0,,不会错的
Dialogue: 0,0:21:43.25,0:21:44.17,Default,,0,0,0,,刚才的声音
Dialogue: 0,0:21:44.17,0:21:46.45,Default,,0,0,0,,是总司令的亲信·介亿老师的号角声
Dialogue: 0,0:21:48.67,0:21:52.20,Default,,0,0,0,,他真的脱离了吕氏四柱吗
Dialogue: 0,0:21:52.80,0:21:54.76,Default,,0,0,0,,但只有约一千人
Dialogue: 0,0:21:55.36,0:21:57.52,Default,,0,0,0,,敌军的数量优势并没有改变
Dialogue: 0,0:21:57.81,0:21:59.18,Default,,0,0,0,,什 什么
Dialogue: 0,0:21:59.54,0:22:03.46,Default,,0,0,0,,但是 老师一定能用那一千人扭转战局
Dialogue: 0,0:22:06.62,0:22:08.22,Default,,0,0,0,,黄龙 向右脱离
Dialogue: 0,0:22:08.60,0:22:09.16,Default,,0,0,0,,是
Dialogue: 0,0:22:09.48,0:22:10.55,Default,,0,0,0,,跟我来
Dialogue: 0,0:22:13.75,0:22:15.97,Default,,0,0,0,,在右边分出了别动队
Dialogue: 0,0:22:17.06,0:22:19.03,Default,,0,0,0,,秦军总司令 昌平君
Dialogue: 0,0:22:19.84,0:22:23.41,Default,,0,0,0,,他是军略天才 这一点毋庸置疑
Dialogue: 0,0:22:24.25,0:22:27.95,Default,,0,0,0,,但我从未听说过他以武将身份上阵杀过敌
Dialogue: 0,0:22:29.94,0:22:33.49,Default,,0,0,0,,如今他亲身立于战场 又会怎样作战呢
Dialogue: 0,0:22:34.32,0:22:38.45,Default,,0,0,0,,他亲自打头阵鼓舞士气 确实十分英勇
Dialogue: 0,0:22:39.62,0:22:42.50,Default,,0,0,0,,足够了 快后撤吧 昌平君
Dialogue: 0,0:22:45.35,0:22:47.01,Default,,0,0,0,,等 等等 昌平君
Dialogue: 0,0:22:47.17,0:22:49.37,Default,,0,0,0,,快退后 你在想什么啊
Dialogue: 0,0:22:49.59,0:22:50.63,Default,,0,0,0,,来了
Dialogue: 0,0:22:50.63,0:22:52.51,Default,,0,0,0,,干掉最前面那匹花哨的马
Dialogue: 0,0:22:52.97,0:22:54.52,Default,,0,0,0,,不必担心
Dialogue: 0,0:22:55.64,0:22:57.02,Default,,0,0,0,,您不知道吗
Dialogue: 0,0:22:57.46,0:22:59.73,Default,,0,0,0,,我的主公在儿时
Dialogue: 0,0:23:00.00,0:23:01.06,Default,,0,0,0,,去死吧
Dialogue: 0,0:23:02.42,0:23:05.32,Default,,0,0,0,,可是比蒙武都强
Dialogue: 0,0:23:07.42,0:23:10.24,Default,,0,0,0,,介亿 我们要把戎翟公干掉
Dialogue: 0,0:23:10.61,0:23:11.70,Default,,0,0,0,,遵命
Dialogue: 0,0:24:48.26,0:24:49.96,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:50.71,0:24:52.32,Default,,0,0,0,,「强势反攻」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

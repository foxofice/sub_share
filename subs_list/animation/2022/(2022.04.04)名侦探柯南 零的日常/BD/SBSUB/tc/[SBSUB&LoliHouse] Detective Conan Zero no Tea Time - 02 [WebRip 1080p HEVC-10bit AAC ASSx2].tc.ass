Comment: 0,0:02:47.98,0:02:47.98,TEATIME-OP-BOTTOM,,0,0,0,,
Dialogue: 0,0:02:46.98,0:02:49.02,TEATIME-OP-BOTTOM,,0,0,0,,Get the Volume up
Dialogue: 0,0:02:49.02,0:02:50.90,TEATIME-OP-BOTTOM,,0,0,0,,飛馳於失去色彩的Highway
Dialogue: 0,0:02:50.90,0:02:54.95,TEATIME-OP-BOTTOM,,0,0,0,,在停滯的時間中 turn me on
Dialogue: 0,0:02:54.95,0:02:57.16,TEATIME-OP-BOTTOM,,0,0,0,,the truth is always blind
Dialogue: 0,0:02:57.16,0:02:59.08,TEATIME-OP-BOTTOM,,0,0,0,,虛假的話語
Dialogue: 0,0:02:59.08,0:03:03.16,TEATIME-OP-BOTTOM,,0,0,0,,也重疊於今日 聲音消散
Dialogue: 0,0:03:03.91,0:03:05.62,TEATIME-OP-BOTTOM,,0,0,0,,急切渴求的理由
Dialogue: 0,0:03:05.92,0:03:08.38,TEATIME-OP-BOTTOM,,0,0,0,,也在城市天空的盡頭
Dialogue: 0,0:03:08.38,0:03:12.67,TEATIME-OP-BOTTOM,,0,0,0,,清晰可見
Dialogue: 0,0:03:12.67,0:03:15.22,TEATIME-OP-BOTTOM,,0,0,0,,世界Like a Shooting Star
Dialogue: 0,0:03:15.22,0:03:17.26,TEATIME-OP-BOTTOM,,0,0,0,,若知曉心願
Dialogue: 0,0:03:17.26,0:03:19.05,TEATIME-OP-BOTTOM,,0,0,0,,不論何人
Dialogue: 0,0:03:19.05,0:03:21.51,TEATIME-OP-BOTTOM,,0,0,0,,都會深陷瞬間而永恆的夢
Dialogue: 0,0:03:21.51,0:03:23.10,TEATIME-OP-BOTTOM,,0,0,0,,若知曉「哀傷」
Dialogue: 0,0:03:23.10,0:03:25.39,TEATIME-OP-BOTTOM,,0,0,0,,便能回歸零點Tears in Lies
Dialogue: 0,0:03:25.39,0:03:29.11,TEATIME-OP-BOTTOM,,0,0,0,,即便知曉善惡之罪
Dialogue: 0,0:03:29.11,0:03:35.90,TEATIME-OP-BOTTOM,,0,0,0,,也要抬頭鎖定目標
Comment: 0,0:12:12.71,0:12:15.71,TEATIME-ED-BOTTOM,,0,0,0,,
Dialogue: 0,0:12:16.84,0:12:21.80,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	無色透明的我
Dialogue: 0,0:12:22.22,0:12:26.77,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	駐足於緋紅的天空下
Dialogue: 0,0:12:27.77,0:12:34.61,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便憎惡這不近人情的世界
Dialogue: 0,0:12:35.03,0:12:38.70,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也無法逃離 Decided
Dialogue: 0,0:12:39.53,0:12:43.95,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	將手伸向光芒
Dialogue: 0,0:12:39.53,0:12:43.95,TEATIME-ED-BOTTOM,ED,0,0,0,,{\pos(1034,1032)}	{\blur3\fs34}	明天
Dialogue: 0,0:12:43.95,0:12:49.04,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday
Dialogue: 0,0:12:49.04,0:12:54.34,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	不懈追逐 仍遙不可及
Dialogue: 0,0:12:54.34,0:12:59.97,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	即便想要守護之物不復存在
Dialogue: 0,0:13:00.13,0:13:04.60,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	也只能繼續掙扎
Dialogue: 0,0:13:04.60,0:13:06.10,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	你聽
Dialogue: 0,0:13:06.10,0:13:10.85,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	Find the truth, promise to yourself
Dialogue: 0,0:13:10.85,0:13:16.32,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3}	用無數張面孔塗改未來
Dialogue: 0,0:13:16.32,0:13:23.95,TEATIME-ED-BOTTOM,ED,0,0,0,,	{\blur3\fad(0,200}	將一去不返的時光深藏於心
Comment: 0,0:03:06.96,0:03:06.96,Title,,0,0,0,,
Dialogue: 0,0:02:46.98,0:02:49.02,TEATIME-OP-TOP,,0,0,0,,Get the Volume up
Dialogue: 0,0:02:49.02,0:02:50.90,TEATIME-OP-TOP,,0,0,0,,色を無くしたHighway
Dialogue: 0,0:02:50.90,0:02:54.95,TEATIME-OP-TOP,,0,0,0,,止まってしまった時間に turn me on
Dialogue: 0,0:02:54.95,0:02:57.16,TEATIME-OP-TOP,,0,0,0,,the truth is always blind
Dialogue: 0,0:02:57.16,0:02:59.08,TEATIME-OP-TOP,,0,0,0,,偽りの声も
Dialogue: 0,0:02:59.08,0:03:03.16,TEATIME-OP-TOP,,0,0,0,,重なる今日に音が消える
Dialogue: 0,0:03:03.91,0:03:05.62,TEATIME-OP-TOP,,0,0,0,,焦がれ求む理由も
Dialogue: 0,0:03:05.92,0:03:08.38,TEATIME-OP-TOP,,0,0,0,,街の空の果てに
Dialogue: 0,0:03:08.38,0:03:12.67,TEATIME-OP-TOP,,0,0,0,,見える
Dialogue: 0,0:03:12.67,0:03:15.22,TEATIME-OP-TOP,,0,0,0,,世界はLike a Shooting Star
Dialogue: 0,0:03:15.22,0:03:17.26,TEATIME-OP-TOP,,0,0,0,,願いを知れば
Dialogue: 0,0:03:17.26,0:03:19.05,TEATIME-OP-TOP,,0,0,0,,一瞬が永遠の
Dialogue: 0,0:03:19.05,0:03:21.51,TEATIME-OP-TOP,,0,0,0,,夢に誰も捉われる
Dialogue: 0,0:03:21.51,0:03:23.10,TEATIME-OP-TOP,,0,0,0,,「哀」を知れば
Dialogue: 0,0:03:23.10,0:03:25.39,TEATIME-OP-TOP,,0,0,0,,ゼロに戻るTears in Lies
Dialogue: 0,0:03:25.39,0:03:29.11,TEATIME-OP-TOP,,0,0,0,,善悪の罪を知る
Dialogue: 0,0:03:29.11,0:03:35.90,TEATIME-OP-TOP,,0,0,0,,それでも顔上げ狙い定める
Dialogue: 0,0:03:08.04,0:03:08.04,Title,,0,0,0,,
Comment: 0,0:03:06.96,0:03:06.96,Title,,0,0,0,,
Dialogue: 0,0:12:16.84,0:12:21.80,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	透明な僕をみていた
Dialogue: 0,0:12:22.22,0:12:26.77,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	空があかく染まって
Dialogue: 0,0:12:27.77,0:12:34.61,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	不条理を憎んでもここからは
Dialogue: 0,0:12:35.03,0:12:38.70,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	逃げ出せないから Decided
Dialogue: 0,0:12:39.53,0:12:43.95,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	光へ手をのばして
Dialogue: 0,0:12:39.53,0:12:43.95,TEATIME-ED-TOP,ED,0,0,0,,{\pos(842,3)}	{\blur3\fs28}	あした
Dialogue: 0,0:12:43.95,0:12:49.04,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	Find the truth, will arrive someday
Dialogue: 0,0:12:49.04,0:12:54.34,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	追いかけても追いかけても　未だ
Dialogue: 0,0:12:54.34,0:12:59.97,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	守りたいものさえ消えていくけど
Dialogue: 0,0:13:00.13,0:13:04.60,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	足掻き続けるしかないの
Dialogue: 0,0:13:04.60,0:13:06.10,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	ねぇ、聞いて
Dialogue: 0,0:13:06.10,0:13:10.85,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	Find the truth, promise to yourself
Dialogue: 0,0:13:10.85,0:13:16.32,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3}	いくつもの顔で塗り変えて行く未来
Dialogue: 0,0:13:16.32,0:13:23.95,TEATIME-ED-TOP,ED,0,0,0,,	{\blur3\fad(0,200)}	戻らない時間を胸にそっとしまって

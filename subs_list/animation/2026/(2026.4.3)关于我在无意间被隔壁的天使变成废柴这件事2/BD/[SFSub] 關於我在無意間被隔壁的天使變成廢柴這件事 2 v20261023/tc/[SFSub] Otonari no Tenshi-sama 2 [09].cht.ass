Dialogue: 0,0:22:11.23,0:22:13.90,09EDJP,ED,0,0,0,,{\an8\fad(200,200)\blur4}I want you! (I want you!)
Dialogue: 0,0:22:13.90,0:22:16.57,09EDJP,ED,0,0,0,,{\an8\fad(200,200)\blur4}I need you! (I need you!)
Dialogue: 0,0:22:16.57,0:22:19.23,09EDJP,ED,0,0,0,,{\an8\fad(200,200)\blur4}I love you! (I love you!)

Dialogue: 0,0:01:32.00,0:01:40.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕組製作 僅供學習交流 禁止用於商業用途
Comment: 0,0:00:01.00,0:00:01.05,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:00:02.29,0:00:07.46,op-jp,,0,0,0,,希望に溢れた　お前の目に浮かぶのは
Dialogue: 0,0:00:07.46,0:00:09.22,op-jp,,0,0,0,,誰の幻想？
Dialogue: 0,0:00:09.22,0:00:12.57,op-jp,,0,0,0,,何もかも失いそうになって
Dialogue: 0,0:00:12.57,0:00:17.75,op-jp,,0,0,0,,巡り会うんだ　再会の誓いを
Dialogue: 0,0:00:30.70,0:00:33.70,op-jp,,0,0,0,,段々と熱くなる
Dialogue: 0,0:00:33.70,0:00:37.95,op-jp,,0,0,0,,心　燃やす　咆哮に変えてけ
Dialogue: 0,0:00:37.95,0:00:40.78,op-jp,,0,0,0,,飄々と歩くのさ
Dialogue: 0,0:00:40.78,0:00:45.68,op-jp,,0,0,0,,先の見えぬ夢を掴むまで
Dialogue: 0,0:00:45.85,0:00:51.18,op-jp,,0,0,0,,時には涙を流す夜もある
Dialogue: 0,0:00:51.18,0:00:55.81,op-jp,,0,0,0,,誓ったあの日を共に笑った事
Dialogue: 0,0:00:55.81,0:00:58.31,op-jp,,0,0,0,,胸に刻み込んで
Dialogue: 0,0:00:58.31,0:01:05.36,op-jp,,0,0,0,,嗚呼　息もできないこの世界であなたにあった夜
Dialogue: 0,0:01:05.36,0:01:12.12,op-jp,,0,0,0,,消えかけた心の灯火　輝いた
Dialogue: 0,0:01:12.49,0:01:16.87,op-jp,,0,0,0,,どんな未来だって　受け容れる
Dialogue: 0,0:01:16.87,0:01:19.63,op-jp,,0,0,0,,生きる理由なんだ
Dialogue: 0,0:01:19.63,0:01:24.88,op-jp,,0,0,0,,燃やせ　今この声が響く限り
Dialogue: 0,0:01:24.88,0:01:30.79,op-jp,,0,0,0,,果てなき明日へ
Dialogue: 0,0:01:30.79,0:01:30.79,op-jp,,0,0,0,,
Dialogue: 0,0:00:02.29,0:00:07.46,op-cn,,0,0,0,,你那充滿希望的雙眸中
Dialogue: 0,0:00:07.46,0:00:09.22,op-cn,,0,0,0,,映出誰的幻想？
Dialogue: 0,0:00:09.22,0:00:12.57,op-cn,,0,0,0,,在即將失去一切之時
Dialogue: 0,0:00:12.57,0:00:17.75,op-cn,,0,0,0,,邂逅重逢的誓言
Dialogue: 0,0:00:30.70,0:00:33.70,op-cn,,0,0,0,,身體愈發火熱
Dialogue: 0,0:00:33.70,0:00:37.95,op-cn,,0,0,0,,燃燒內心 化為咆哮
Dialogue: 0,0:00:37.95,0:00:40.78,op-cn,,0,0,0,,步伐愈顯輕盈
Dialogue: 0,0:00:40.78,0:00:45.68,op-cn,,0,0,0,,直至抓住 未知之夢
Dialogue: 0,0:00:45.85,0:00:51.18,op-cn,,0,0,0,,時而於夜晚落淚
Dialogue: 0,0:00:51.18,0:00:55.81,op-cn,,0,0,0,,一同歡笑 共度立誓之日
Dialogue: 0,0:00:55.81,0:00:58.31,op-cn,,0,0,0,,將其銘記於心
Dialogue: 0,0:00:58.31,0:01:05.36,op-cn,,0,0,0,,在這窒息的世界 邂逅你的夜晚
Dialogue: 0,0:01:05.36,0:01:12.12,op-cn,,0,0,0,,即將熄滅的心中燈火 光芒四射
Dialogue: 0,0:01:12.49,0:01:16.87,op-cn,,0,0,0,,不論怎樣的未來 都甘願接受
Dialogue: 0,0:01:16.87,0:01:19.63,op-cn,,0,0,0,,這就是活著的理由
Dialogue: 0,0:01:19.63,0:01:24.88,op-cn,,0,0,0,,燃燒吧 只要這聲音迴響不止
Dialogue: 0,0:01:24.88,0:01:30.79,op-cn,,0,0,8,,前往永無止境的明天
Dialogue: 0,0:00:30.33,0:00:32.33,op-cn,,0,0,0,,
Comment: 0,0:23:15.95,0:23:16.04,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:29.89,0:23:40.15,ed-jp,,0,0,0,,真っ暗闇の中、光の希望が消え去ることない
Dialogue: 0,0:23:40.15,0:23:43.59,ed-jp,,0,0,0,,ただひとつの誓い
Dialogue: 0,0:23:43.59,0:23:49.82,ed-jp,,0,0,0,,傷だらけでも傷んだ分だけ
Dialogue: 0,0:23:49.82,0:23:56.98,ed-jp,,0,0,0,,繋いだ心　そばにあるさ
Dialogue: 0,0:23:57.17,0:24:03.79,ed-jp,,0,0,0,,大切なもの守り抜けと　その血、汗、涙が導く
Dialogue: 0,0:24:03.79,0:24:10.82,ed-jp,,0,0,0,,己の心に従え、振り向くな、さぁ立ち上がれ
Dialogue: 0,0:24:10.82,0:24:16.53,ed-jp,,0,0,0,,俺が俺である限り　己信じ、明日を思い描け
Dialogue: 0,0:24:16.53,0:24:19.78,ed-jp,,0,0,0,,恐れるな、さぁ高く翔べ
Dialogue: 0,0:24:19.78,0:24:25.73,ed-jp,,0,0,0,,俺たちが輝く日まで
Dialogue: 0,0:24:25.73,0:24:27.73,ed-jp,,0,0,0,,
Dialogue: 0,0:23:29.89,0:23:40.15,ed-cn,,0,0,0,,即便陷入黑暗 希望之光也不會消失
Dialogue: 0,0:23:40.15,0:23:43.59,ed-cn,,0,0,0,,這唯一的誓言
Dialogue: 0,0:23:43.59,0:23:49.82,ed-cn,,0,0,0,,受傷幾次 就強大幾分
Dialogue: 0,0:23:49.82,0:23:56.98,ed-cn,,0,0,0,,我們心心相連 不離不棄
Dialogue: 0,0:23:57.17,0:24:03.79,ed-cn,,0,0,0,,守護珍視之物 以鮮血 汗水 淚水為指引
Dialogue: 0,0:24:03.79,0:24:10.82,ed-cn,,0,0,0,,遵循內心 不要回頭 奮起戰鬥
Dialogue: 0,0:24:10.82,0:24:16.53,ed-cn,,0,0,0,,只要我還是我 就相信自己 描繪明天
Dialogue: 0,0:24:16.53,0:24:19.78,ed-cn,,0,0,0,,不要畏懼 展翅高飛
Dialogue: 0,0:24:19.78,0:24:25.73,ed-cn,,0,0,0,,飛向我們大放異彩之日
Dialogue: 0,0:24:25.73,0:24:25.73,ed-cn,,0,0,0,,
Dialogue: 0,0:01:43.16,0:01:46.33,biaoti,,0,0,0,,{\fad(480,470)}未來的六將
Dialogue: 0,0:01:49.09,0:01:53.13,Default,,0,0,0,,該死的飛信隊 比傳聞中還要強
Dialogue: 0,0:01:53.51,0:01:57.42,Default,,0,0,0,,豪紀大人 還是暫且撤退吧
Dialogue: 0,0:01:57.65,0:01:59.10,Default,,0,0,0,,荒唐
Dialogue: 0,0:01:59.10,0:02:01.95,Default,,0,0,0,,我豪紀大人才剛要開始發威
Dialogue: 0,0:02:01.95,0:02:03.04,Default,,0,0,0,,急報
Dialogue: 0,0:02:03.13,0:02:06.16,Default,,0,0,0,,收到報告 樂華隊逼近我軍左側
Dialogue: 0,0:02:07.00,0:02:07.98,Default,,0,0,0,,什麼
Dialogue: 0,0:02:07.98,0:02:09.14,Default,,0,0,0,,急報
Dialogue: 0,0:02:10.15,0:02:14.40,Default,,0,0,0,,疑似秦軍玉鳳隊的部隊正從右側逼近
Dialogue: 0,0:02:18.07,0:02:19.83,Default,,0,0,0,,撤退
Dialogue: 0,0:02:21.49,0:02:24.29,Default,,0,0,0,,秦·趙國境地帶 曹州
Dialogue: 0,0:02:24.84,0:02:27.13,Default,,0,0,0,,遵照總司令昌平君的指示
Dialogue: 0,0:02:27.25,0:02:30.98,Default,,0,0,0,,飛信隊 玉鳳隊 樂華隊於此處會合
Dialogue: 0,0:02:31.61,0:02:33.96,Default,,0,0,0,,趙軍也由腹地派出兵力
Dialogue: 0,0:02:34.18,0:02:37.22,Default,,0,0,0,,兩軍暫時處於膠著狀態
Dialogue: 0,0:02:40.53,0:02:42.08,Default,,0,0,0,,給 給我啊
Dialogue: 0,0:02:43.53,0:02:45.59,Default,,0,0,0,,攻打曹州是佯攻？
Dialogue: 0,0:02:47.02,0:02:50.56,Default,,0,0,0,,昌平君的真正目標是魏國的衍氏
Dialogue: 0,0:02:51.08,0:02:53.27,Default,,0,0,0,,這是機密事項
Dialogue: 0,0:02:55.04,0:02:55.99,Default,,0,0,0,,衍氏…
Dialogue: 0,0:02:57.69,0:03:02.47,Default,,0,0,0,,衍氏是魏國的一處要地 位於曹州以南
Dialogue: 0,0:03:03.33,0:03:07.20,Default,,0,0,0,,由於秦軍和趙軍集結在曹州
Dialogue: 0,0:03:07.46,0:03:10.48,Default,,0,0,0,,魏軍確實也在國境處佈置了大軍
Dialogue: 0,0:03:11.53,0:03:14.33,Default,,0,0,0,,這一帶的焦點正集中於曹州
Dialogue: 0,0:03:14.87,0:03:17.92,Default,,0,0,0,,衍氏確實出現了破綻
Dialogue: 0,0:03:19.86,0:03:20.63,Default,,0,0,0,,但是
Dialogue: 0,0:03:21.32,0:03:26.70,Default,,0,0,0,,衍氏以城牆高企聞名 周圍沒有軍隊能前往攻打
Dialogue: 0,0:03:29.67,0:03:33.06,Default,,0,0,0,,攻略的前置準備確實已經完成
Dialogue: 0,0:03:33.57,0:03:36.88,Default,,0,0,0,,卻沒有能攻打衍氏的軍隊
Dialogue: 0,0:03:38.38,0:03:42.34,Default,,0,0,0,,我本以為王翦將軍會南下
Dialogue: 0,0:03:43.01,0:03:45.02,Default,,0,0,0,,他絲毫沒有要南下的跡象
Dialogue: 0,0:03:45.66,0:03:47.12,Default,,0,0,0,,真奇怪
Dialogue: 0,0:03:47.64,0:03:49.37,Default,,0,0,0,,到底怎麼回事
Dialogue: 0,0:03:50.14,0:03:52.87,Default,,0,0,0,,如果衍氏才是真正目標
Dialogue: 0,0:03:53.64,0:03:55.18,Default,,0,0,0,,那究竟會由誰來攻打
Dialogue: 0,0:03:58.64,0:04:04.06,Default,,0,0,0,,昌平君居然會請出那支部隊來攻打衍氏
Dialogue: 0,0:04:04.06,0:04:05.62,Default,,0,0,0,,實在出人意料
Dialogue: 0,0:04:06.31,0:04:06.93,Default,,0,0,0,,是啊
Dialogue: 0,0:04:07.82,0:04:10.32,Default,,0,0,0,,那支部隊就連我們都未能預料到
Dialogue: 0,0:04:11.39,0:04:13.40,Default,,0,0,0,,敵國就更加無從察覺
Dialogue: 0,0:04:14.11,0:04:19.44,Default,,0,0,0,,秦國的軍隊陣容 就快要發生變化了
Dialogue: 0,0:04:19.65,0:04:20.10,Default,,0,0,0,,對
Dialogue: 0,0:04:21.14,0:04:26.11,Default,,0,0,0,,雖然覺得這一招亮得有些早
Dialogue: 0,0:04:26.78,0:04:29.28,Default,,0,0,0,,但這應該也在昌平君的計劃之內
Dialogue: 0,0:04:32.76,0:04:34.25,Default,,0,0,0,,什麼
Dialogue: 0,0:04:34.67,0:04:37.00,Default,,0,0,0,,衍氏陷落了？
Dialogue: 0,0:04:37.78,0:04:40.05,Default,,0,0,0,,我軍的奇襲成功了
Dialogue: 0,0:04:40.77,0:04:46.23,Default,,0,0,0,,魏國失去了要地 正在匆忙派兵前往奪回
Dialogue: 0,0:04:47.08,0:04:52.01,Default,,0,0,0,,所以我們也要立刻進入衍氏城 協助防守
Dialogue: 0,0:04:52.58,0:04:55.48,Default,,0,0,0,,玉鳳和樂華也已經出發了
Dialogue: 0,0:04:56.94,0:04:58.82,Default,,0,0,0,,我們也趕緊出發吧
Dialogue: 0,0:04:59.22,0:05:00.88,Default,,0,0,0,,等 等一下 貂
Dialogue: 0,0:05:01.13,0:05:03.01,Default,,0,0,0,,衍氏可是號稱不落的巨城
Dialogue: 0,0:05:03.01,0:05:05.68,Default,,0,0,0,,到底是什麼人攻下的啊
Dialogue: 0,0:05:08.74,0:05:11.69,Default,,0,0,0,,信 你知道了可別被嚇到
Dialogue: 0,0:05:35.31,0:05:37.60,Default,,0,0,0,,好 好大
Dialogue: 0,0:05:37.95,0:05:39.57,Default,,0,0,0,,這是什麼聲音啊
Dialogue: 0,0:05:39.80,0:05:42.15,Default,,0,0,0,,快看 城樓都被粉碎了
Dialogue: 0,0:05:43.85,0:05:46.61,Default,,0,0,0,,還有沒見過的旗幟
Dialogue: 0,0:05:47.40,0:05:48.28,Default,,0,0,0,,我們進去
Dialogue: 0,0:06:05.85,0:06:07.08,Default,,0,0,0,,楊端和
Dialogue: 0,0:06:07.68,0:06:11.01,Default,,0,0,0,,辛苦前來支援 信五千人將
Dialogue: 0,0:06:11.35,0:06:13.26,Default,,0,0,0,,山 山民
Dialogue: 0,0:06:13.26,0:06:15.93,Default,,0,0,0,,山民攻下了衍氏嗎
Dialogue: 0,0:06:16.32,0:06:18.73,Default,,0,0,0,,太 太美了
Dialogue: 0,0:06:19.48,0:06:22.67,Default,,0,0,0,,山民作為秦軍戰鬥並不奇怪
Dialogue: 0,0:06:24.95,0:06:27.44,Default,,0,0,0,,三年前 他們拯救蕞城有功
Dialogue: 0,0:06:28.05,0:06:31.52,Default,,0,0,0,,楊端和獲得了秦國的大上造爵位
Dialogue: 0,0:06:32.73,0:06:35.77,Default,,0,0,0,,和大將軍平級
Dialogue: 0,0:06:37.11,0:06:38.84,Default,,0,0,0,,沒錯
Dialogue: 0,0:06:45.51,0:06:49.63,Default,,0,0,0,,山之王·楊端和奇襲並攻陷衍氏
Dialogue: 0,0:06:50.05,0:06:52.70,Default,,0,0,0,,給予了列國以巨大衝擊
Dialogue: 0,0:06:53.86,0:06:55.43,Default,,0,0,0,,然而在此之後
Dialogue: 0,0:06:56.45,0:06:59.32,Default,,0,0,0,,南方大國·楚
Dialogue: 0,0:06:59.84,0:07:03.40,Default,,0,0,0,,卻發生了衝擊更大 令全中華都為之驚愕的變故
Dialogue: 0,0:07:04.38,0:07:09.88,Default,,0,0,0,,以硬派作風統治著楚國的考烈王突然駕崩
Dialogue: 0,0:07:12.85,0:07:13.78,Default,,0,0,0,,更有甚之…
Dialogue: 0,0:07:17.22,0:07:18.04,Default,,0,0,0,,大王…
Dialogue: 0,0:07:20.36,0:07:22.75,Default,,0,0,0,,宰相 我這就去備馬車
Dialogue: 0,0:07:40.15,0:07:41.64,Default,,0,0,0,,李園…
Dialogue: 0,0:07:43.85,0:07:47.41,Default,,0,0,0,,春申君遭到暗殺
Dialogue: 0,0:07:57.25,0:08:00.29,Default,,0,0,0,,你看 那麼多人出席葬禮
Dialogue: 0,0:08:00.60,0:08:03.72,Default,,0,0,0,,比前陣子出席考烈王葬禮的人還多
Dialogue: 0,0:08:03.96,0:08:05.43,Default,,0,0,0,,比國王還多…
Dialogue: 0,0:08:05.43,0:08:07.29,Default,,0,0,0,,別擋路 閃開
Dialogue: 0,0:08:07.29,0:08:08.17,Default,,0,0,0,,站住
Dialogue: 0,0:08:08.37,0:08:10.85,Default,,0,0,0,,前方只有出席葬禮的人能進入
Dialogue: 0,0:08:10.85,0:08:13.22,Default,,0,0,0,,到底是怎麼回事啊
Dialogue: 0,0:08:13.22,0:08:13.88,Default,,0,0,0,,站住
Dialogue: 0,0:08:14.64,0:08:18.01,Default,,0,0,0,,項翼和白麗也從前線回來了
Dialogue: 0,0:08:18.34,0:08:20.02,Default,,0,0,0,,來個人給我解釋一下啊
Dialogue: 0,0:08:20.35,0:08:21.97,zhu,,0,0,0,,退後 快退後
Dialogue: 0,0:08:21.97,0:08:22.77,zhu,,0,0,0,,閃開
Dialogue: 0,0:08:20.48,0:08:22.77,Default,,0,0,0,,確實會是這個反應
Dialogue: 0,0:08:23.40,0:08:25.98,Default,,0,0,0,,你怎麼就被殺了啊
Dialogue: 0,0:08:26.34,0:08:28.23,Default,,0,0,0,,春申君
Dialogue: 0,0:08:28.98,0:08:29.95,Default,,0,0,0,,真是的
Dialogue: 0,0:08:30.35,0:08:34.18,Default,,0,0,0,,這個國家也出大事了啊
Dialogue: 0,0:08:37.16,0:08:41.62,Default,,0,0,0,,考烈王的嫡子其實是春申君的孩子？
Dialogue: 0,0:08:42.02,0:08:44.37,Default,,0,0,0,,聲音小點 猴子
Dialogue: 0,0:08:46.75,0:08:50.50,Default,,0,0,0,,你 你在說什麼莫名其妙的啊 將軍
Dialogue: 0,0:08:50.61,0:08:51.38,Default,,0,0,0,,說話啊
Dialogue: 0,0:08:51.94,0:08:56.66,Default,,0,0,0,,國王久久沒有子嗣 大家都很擔心
Dialogue: 0,0:08:57.49,0:08:58.45,Default,,0,0,0,,是啊
Dialogue: 0,0:08:58.62,0:09:04.27,Default,,0,0,0,,兩年前終於生下了一個王子 還舉國慶祝了啊
Dialogue: 0,0:09:04.96,0:09:10.02,Default,,0,0,0,,但是 生下那個王子的原本是春申君的女人
Dialogue: 0,0:09:10.65,0:09:15.43,Default,,0,0,0,,她隱瞞懷有身孕之事 成了國王的妾室
Dialogue: 0,0:09:15.86,0:09:18.28,Default,,0,0,0,,然後她生下了孩子
Dialogue: 0,0:09:18.90,0:09:24.87,Default,,0,0,0,,現在 那個兩歲的小孩 即將成為下一任楚王
Dialogue: 0,0:09:25.80,0:09:27.67,Default,,0,0,0,,怎 怎麼會這樣
Dialogue: 0,0:09:27.74,0:09:29.04,Default,,0,0,0,,這麼說
Dialogue: 0,0:09:29.74,0:09:33.30,Default,,0,0,0,,下一任國王開始 楚國王室的血脈就…
Dialogue: 0,0:09:33.57,0:09:35.30,Default,,0,0,0,,對 會斷絕
Dialogue: 0,0:09:35.80,0:09:37.80,Default,,0,0,0,,怎 怎麼會這樣
Dialogue: 0,0:09:38.29,0:09:40.34,Default,,0,0,0,,也就是說 今後的楚國王室
Dialogue: 0,0:09:40.40,0:09:46.06,Default,,0,0,0,,本該變成春申君的家族 和生下王子的女人的家族
Dialogue: 0,0:09:47.75,0:09:49.81,Default,,0,0,0,,生下王子的女人的家族…
Dialogue: 0,0:09:50.37,0:09:54.32,Default,,0,0,0,,那女人有個叫李園的親哥哥
Dialogue: 0,0:09:55.32,0:09:58.92,Default,,0,0,0,,就是他暗殺了春申君
Dialogue: 0,0:09:59.62,0:10:01.59,Default,,0,0,0,,所以 簡單來說
Dialogue: 0,0:10:02.08,0:10:05.58,Default,,0,0,0,,楚國被李園獨佔了
Dialogue: 0,0:10:06.81,0:10:08.10,Default,,0,0,0,,開什麼玩笑
Dialogue: 0,0:10:08.27,0:10:11.02,Default,,0,0,0,,這種事怎麼可能被人承認
Dialogue: 0,0:10:11.42,0:10:13.65,Default,,0,0,0,,對 不可能被承認
Dialogue: 0,0:10:14.24,0:10:18.13,Default,,0,0,0,,所以 有個稀罕的男人來邀請我
Dialogue: 0,0:10:18.37,0:10:21.30,Default,,0,0,0,,想和我商量楚國今後的事
Dialogue: 0,0:10:22.87,0:10:25.06,Default,,0,0,0,,我特批你們隨行
Dialogue: 0,0:10:25.91,0:10:29.62,Default,,0,0,0,,視情況 或許還需要你們…
Dialogue: 0,0:10:30.29,0:10:31.33,Default,,0,0,0,,殺了那男人
Dialogue: 0,0:10:38.57,0:10:42.32,Default,,0,0,0,,真是抱歉 要你親自前來
Dialogue: 0,0:10:42.86,0:10:44.93,Default,,0,0,0,,媧燐大將軍
Dialogue: 0,0:10:45.65,0:10:47.58,Default,,0,0,0,,廉 廉頗
Dialogue: 0,0:10:48.50,0:10:51.76,Default,,0,0,0,,如果話題不夠有價值
Dialogue: 0,0:10:52.31,0:10:54.67,Default,,0,0,0,,我可不會放過你
Dialogue: 0,0:11:09.40,0:11:13.40,Default,,0,0,0,,這個國家也真是出大事了啊
Dialogue: 0,0:11:15.17,0:11:18.49,Default,,0,0,0,,你笑什麼 區區吃白飯的
Dialogue: 0,0:11:19.53,0:11:21.99,Default,,0,0,0,,考烈王和春申君
Dialogue: 0,0:11:22.57,0:11:26.80,Default,,0,0,0,,兩名執掌這個大國的人居然同時殞命
Dialogue: 0,0:11:27.32,0:11:30.86,Default,,0,0,0,,楚國正如失去了船長的大船
Dialogue: 0,0:11:31.13,0:11:33.40,Default,,0,0,0,,一不小心就會翻覆
Dialogue: 0,0:11:34.08,0:11:36.00,Default,,0,0,0,,尤其是春申君
Dialogue: 0,0:11:36.54,0:11:41.87,Default,,0,0,0,,據說朝中那群低賤的蠢豬沒了領導者
Dialogue: 0,0:11:41.87,0:11:44.82,Default,,0,0,0,,正打作一團呢
Dialogue: 0,0:11:45.43,0:11:51.16,Default,,0,0,0,,還牽涉到王位繼承的問題 事情就更複雜了
Dialogue: 0,0:11:51.35,0:11:53.27,Default,,0,0,0,,對啊 簡直糟透了
Dialogue: 0,0:11:54.02,0:11:56.74,Default,,0,0,0,,連廉頗都知道了嗎
Dialogue: 0,0:11:59.11,0:12:02.50,Default,,0,0,0,,對於列國來說 這是最好的進攻時機
Dialogue: 0,0:12:02.81,0:12:05.34,Default,,0,0,0,,如果我還在趙國
Dialogue: 0,0:12:05.56,0:12:07.83,Default,,0,0,0,,就一定會暫時和魏國和談
Dialogue: 0,0:12:07.94,0:12:10.39,Default,,0,0,0,,一口氣舉大軍南下
Dialogue: 0,0:12:10.63,0:12:14.04,Default,,0,0,0,,奪取大片領土
Dialogue: 0,0:12:17.19,0:12:19.88,Default,,0,0,0,,第一個來的應該是秦國
Dialogue: 0,0:12:20.31,0:12:23.34,Default,,0,0,0,,他們現在勢頭最猛
Dialogue: 0,0:12:23.94,0:12:25.38,Default,,0,0,0,,必須在那之前
Dialogue: 0,0:12:27.06,0:12:30.06,Default,,0,0,0,,重新構築楚國的朝廷
Dialogue: 0,0:12:31.00,0:12:33.43,Default,,0,0,0,,而且不是單純的重築
Dialogue: 0,0:12:34.08,0:12:40.07,Default,,0,0,0,,必須能讓楚國更加強盛 超越考烈王·春申君的治世
Dialogue: 0,0:12:43.32,0:12:44.87,Default,,0,0,0,,更加強盛？
Dialogue: 0,0:12:46.30,0:12:48.66,Default,,0,0,0,,話說你是誰
Dialogue: 0,0:12:49.20,0:12:53.41,Default,,0,0,0,,居然跟我和廉頗同桌而坐 膽子真不小啊
Dialogue: 0,0:12:53.72,0:12:55.67,Default,,0,0,0,,你明白嗎
Dialogue: 0,0:12:56.43,0:12:57.63,Default,,0,0,0,,確實
Dialogue: 0,0:12:58.79,0:13:03.24,Default,,0,0,0,,你可別說你是廉頗的親信啊 混蛋
Dialogue: 0,0:13:03.43,0:13:05.13,Default,,0,0,0,,開始震懾起對方了
Dialogue: 0,0:13:06.81,0:13:11.89,Default,,0,0,0,,此人是局勢緊張的宮廷派來的密使
Dialogue: 0,0:13:14.77,0:13:20.15,Default,,0,0,0,,其實 這次找你的人就是他
Dialogue: 0,0:13:26.99,0:13:31.12,Default,,0,0,0,,宮廷的小跑腿居然敢直視我的眼睛
Dialogue: 0,0:13:31.76,0:13:32.67,Default,,0,0,0,,給我滾
Dialogue: 0,0:13:33.04,0:13:38.17,Default,,0,0,0,,我非常討厭在宮廷裡獻媚的蠢豬了
Dialogue: 0,0:13:38.98,0:13:43.64,Default,,0,0,0,,我也一樣 打心底裡討厭武將之流
Dialogue: 0,0:13:53.64,0:13:54.63,Default,,0,0,0,,等等
Dialogue: 0,0:13:54.99,0:13:58.44,Default,,0,0,0,,廉頗居然特地從中牽線 也就是說…
Dialogue: 0,0:13:58.76,0:14:00.07,Default,,0,0,0,,這個人…
Dialogue: 0,0:14:02.71,0:14:03.37,Default,,0,0,0,,但是
Dialogue: 0,0:14:04.22,0:14:06.80,Default,,0,0,0,,在這個國家面臨瓦解之時
Dialogue: 0,0:14:07.27,0:14:10.31,Default,,0,0,0,,我必須向你低頭
Dialogue: 0,0:14:11.96,0:14:13.66,Default,,0,0,0,,低頭？
Dialogue: 0,0:14:14.20,0:14:17.16,Default,,0,0,0,,你是楚國第二將 掌兵數量為國內最多
Dialogue: 0,0:14:17.67,0:14:21.96,Default,,0,0,0,,加上南部各城池 你手握三十萬大軍
Dialogue: 0,0:14:22.04,0:14:24.17,Default,,0,0,0,,我需要你的力量
Dialogue: 0,0:14:24.39,0:14:25.18,Default,,0,0,0,,三…
Dialogue: 0,0:14:25.66,0:14:27.17,Default,,0,0,0,,三十萬？
Dialogue: 0,0:14:27.70,0:14:29.93,Default,,0,0,0,,他怎麼知道的
Dialogue: 0,0:14:31.73,0:14:34.26,Default,,0,0,0,,請和我一同坐上宰相之位
Dialogue: 0,0:14:34.42,0:14:38.04,Default,,0,0,0,,為楚國打下成為嶄新大國的基礎吧
Dialogue: 0,0:14:38.40,0:14:39.17,Default,,0,0,0,,媧燐
Dialogue: 0,0:14:41.86,0:14:43.36,Default,,0,0,0,,媧… 宰…
Dialogue: 0,0:14:43.80,0:14:46.07,Default,,0,0,0,,要媧燐當宰相？
Dialogue: 0,0:14:47.39,0:14:50.07,Default,,0,0,0,,等一下 你剛才說「一同」？
Dialogue: 0,0:14:52.07,0:14:53.36,Default,,0,0,0,,就是你啊
Dialogue: 0,0:14:53.96,0:14:54.64,Default,,0,0,0,,對
Dialogue: 0,0:14:55.31,0:14:59.39,Default,,0,0,0,,我就是暗殺了春申君的人 李園
Dialogue: 0,0:15:11.67,0:15:14.76,Default,,0,0,0,,你為什麼殺了春申君
Dialogue: 0,0:15:21.27,0:15:24.66,Default,,0,0,0,,之後我們自己來 你退下吧
Dialogue: 0,0:15:24.85,0:15:26.16,Default,,0,0,0,,是
Dialogue: 0,0:15:26.61,0:15:30.28,Default,,0,0,0,,可惡 從這裡根本聽不到
Dialogue: 0,0:15:31.01,0:15:33.79,Default,,0,0,0,,考烈王未能生下子嗣
Dialogue: 0,0:15:35.07,0:15:38.79,Default,,0,0,0,,正常來說 應由王弟成為下一任國王
Dialogue: 0,0:15:40.24,0:15:44.64,Default,,0,0,0,,但王弟性格異常 是王宮內的一大禍患
Dialogue: 0,0:15:47.94,0:15:51.89,Default,,0,0,0,,如此下去 楚國這艘大船將會迷失方向
Dialogue: 0,0:15:53.45,0:15:57.91,Default,,0,0,0,,就在此時 我的妹妹懷上了春申君的孩子
Dialogue: 0,0:16:00.10,0:16:02.23,Default,,0,0,0,,讓那個孩子成為國王的子嗣
Dialogue: 0,0:16:02.84,0:16:04.62,Default,,0,0,0,,是考烈王 春申君和我
Dialogue: 0,0:16:04.62,0:16:09.11,Default,,0,0,0,,因擔憂國家的未來 而不得已為之
Dialogue: 0,0:16:14.13,0:16:17.33,Default,,0,0,0,,連王族血脈都不惜改變嗎
Dialogue: 0,0:16:17.89,0:16:19.40,Default,,0,0,0,,正是
Dialogue: 0,0:16:22.07,0:16:26.00,Default,,0,0,0,,所以呢 你為什麼殺了春申君
Dialogue: 0,0:16:26.55,0:16:29.71,Default,,0,0,0,,是你想獨佔一切了嗎
Dialogue: 0,0:16:30.45,0:16:32.68,Default,,0,0,0,,國王駕崩後
Dialogue: 0,0:16:33.30,0:16:36.91,Default,,0,0,0,,春申君改變主意 說要讓王弟繼承王位
Dialogue: 0,0:16:37.79,0:16:39.81,Default,,0,0,0,,他說 比起讓昏君即位
Dialogue: 0,0:16:40.26,0:16:44.05,Default,,0,0,0,,暗中斷絕王族血脈的罪孽更深重
Dialogue: 0,0:16:45.45,0:16:47.33,Default,,0,0,0,,他為什麼突然這麼說
Dialogue: 0,0:16:48.25,0:16:52.69,Default,,0,0,0,,他那般大人物 不可能會事到臨頭才開始害怕
Dialogue: 0,0:16:55.83,0:16:58.83,Default,,0,0,0,,但是 我沒有同意他的提議
Dialogue: 0,0:16:59.51,0:17:02.00,Default,,0,0,0,,船已經起航
Dialogue: 0,0:17:02.78,0:17:05.48,Default,,0,0,0,,此時下船即意味著死亡
Dialogue: 0,0:17:06.63,0:17:08.71,Default,,0,0,0,,不論是策劃此事的我
Dialogue: 0,0:17:09.72,0:17:12.54,Default,,0,0,0,,還是生下假王子的妹妹
Dialogue: 0,0:17:16.16,0:17:17.65,Default,,0,0,0,,搞什麼
Dialogue: 0,0:17:17.81,0:17:21.20,Default,,0,0,0,,原來你是為了保護親人才殺了春申君嗎
Dialogue: 0,0:17:21.95,0:17:23.10,Default,,0,0,0,,有一半是的
Dialogue: 0,0:17:23.76,0:17:25.62,Default,,0,0,0,,那是我唯一的妹妹
Dialogue: 0,0:17:27.28,0:17:28.23,Default,,0,0,0,,笑死
Dialogue: 0,0:17:29.00,0:17:30.11,Default,,0,0,0,,為何要笑
Dialogue: 0,0:17:30.38,0:17:31.14,Default,,0,0,0,,你不也是…
Dialogue: 0,0:17:32.48,0:17:33.82,Default,,0,0,0,,在小時候
Dialogue: 0,0:17:34.03,0:17:39.65,Default,,0,0,0,,為尋找唯一的弟弟 徘徊於荒野嗎
Dialogue: 0,0:17:45.37,0:17:46.07,Default,,0,0,0,,喂
Dialogue: 0,0:17:46.84,0:17:48.97,Default,,0,0,0,,你想死嗎
Dialogue: 0,0:17:50.27,0:17:52.24,Default,,0,0,0,,原諒我 我沒有惡意
Dialogue: 0,0:17:53.04,0:17:57.64,Default,,0,0,0,,我只是希望你明白 我也是拼上了全力
Dialogue: 0,0:18:00.97,0:18:01.85,Default,,0,0,0,,所以呢
Dialogue: 0,0:18:02.04,0:18:05.38,Default,,0,0,0,,過於拚命所以派出了刺客嗎
Dialogue: 0,0:18:05.73,0:18:07.94,Default,,0,0,0,,對 我和他都是
Dialogue: 0,0:18:09.87,0:18:12.08,Default,,0,0,0,,而我活了下來
Dialogue: 0,0:18:14.92,0:18:18.94,Default,,0,0,0,,我自認比誰都理解此事的重大之處
Dialogue: 0,0:18:20.04,0:18:22.48,Default,,0,0,0,,必須在列國的爪牙伸來之前
Dialogue: 0,0:18:22.95,0:18:26.64,Default,,0,0,0,,重振這個失去了頂梁柱的國家
Dialogue: 0,0:18:27.21,0:18:30.27,Default,,0,0,0,,那你一個人當宰相去啊
Dialogue: 0,0:18:30.61,0:18:32.50,Default,,0,0,0,,本來就只有一個席位
Dialogue: 0,0:18:33.21,0:18:36.63,Default,,0,0,0,,那樣只能讓這個國家回歸普通
Dialogue: 0,0:18:37.60,0:18:40.41,Default,,0,0,0,,東之大將軍曾說過
Dialogue: 0,0:18:40.80,0:18:47.39,Default,,0,0,0,,中華規模最大的楚軍 並未將其力量全數發揮
Dialogue: 0,0:18:48.62,0:18:49.79,Default,,0,0,0,,項燕嗎
Dialogue: 0,0:18:50.80,0:18:55.25,Default,,0,0,0,,他是這樣想 你一定也有所感受
Dialogue: 0,0:18:58.31,0:19:01.44,Default,,0,0,0,,我知道你對政治沒有興趣
Dialogue: 0,0:19:02.31,0:19:02.94,Default,,0,0,0,,但是
Dialogue: 0,0:19:04.14,0:19:09.53,Default,,0,0,0,,在這激戰的時期 要如何重建楚國
Dialogue: 0,0:19:09.99,0:19:12.93,Default,,0,0,0,,我希望你這個戰鬥天才來指引我
Dialogue: 0,0:19:13.90,0:19:16.60,Default,,0,0,0,,助我一臂之力吧 媧燐
Dialogue: 0,0:19:23.85,0:19:25.85,Default,,0,0,0,,大王真的是這麼說的嗎
Dialogue: 0,0:19:26.87,0:19:30.71,Default,,0,0,0,,為了統一中華 要復活六大將軍
Dialogue: 0,0:19:31.58,0:19:32.21,Default,,0,0,0,,是啊
Dialogue: 0,0:19:34.96,0:19:39.86,Default,,0,0,0,,征服六國的新六大將軍啊
Dialogue: 0,0:19:40.72,0:19:41.49,Default,,0,0,0,,蒙恬
Dialogue: 0,0:19:42.26,0:19:44.25,Default,,0,0,0,,現階段你怎麼看
Dialogue: 0,0:19:46.32,0:19:49.99,Default,,0,0,0,,能成為六大將軍的人 都有誰
Dialogue: 0,0:19:55.48,0:19:56.83,Default,,0,0,0,,首先
Dialogue: 0,0:19:58.75,0:20:00.64,Default,,0,0,0,,有兩個人已經可以確定
Dialogue: 0,0:20:01.75,0:20:04.22,Default,,0,0,0,,已經是秦國大將軍的
Dialogue: 0,0:20:05.47,0:20:07.11,Default,,0,0,0,,吾父 蒙武
Dialogue: 0,0:20:08.25,0:20:09.08,Default,,0,0,0,,以及 騰
Dialogue: 0,0:20:10.45,0:20:15.88,Default,,0,0,0,,只看進攻的話 蒙武可以說是秦軍史上最強
Dialogue: 0,0:20:16.78,0:20:17.84,Default,,0,0,0,,而騰
Dialogue: 0,0:20:18.06,0:20:21.41,Default,,0,0,0,,說白了 他還沒有展現出全部實力
Dialogue: 0,0:20:22.43,0:20:23.61,Default,,0,0,0,,以他們的實力
Dialogue: 0,0:20:24.29,0:20:28.45,Default,,0,0,0,,只要不出太大岔子 幾乎是可以確定的
Dialogue: 0,0:20:29.03,0:20:31.41,Default,,0,0,0,,那還剩下四個
Dialogue: 0,0:20:32.03,0:20:35.63,Default,,0,0,0,,離六將最近的 又是兩個人
Dialogue: 0,0:20:36.45,0:20:40.44,Default,,0,0,0,,之前就有傳聞說其實力不遜於舊六將
Dialogue: 0,0:20:41.44,0:20:43.66,Default,,0,0,0,,那就是王翦和桓騎
Dialogue: 0,0:20:46.71,0:20:48.90,Default,,0,0,0,,從戰績來看
Dialogue: 0,0:20:49.46,0:20:52.06,Default,,0,0,0,,只要進展順利 他們應該能拿到席位
Dialogue: 0,0:20:53.28,0:20:54.82,Default,,0,0,0,,但那樣一來
Dialogue: 0,0:20:56.09,0:20:57.71,Default,,0,0,0,,就只剩下兩個席位了
Dialogue: 0,0:21:02.54,0:21:05.49,Default,,0,0,0,,而有一個人很可能取得一個席位
Dialogue: 0,0:21:06.25,0:21:07.64,Default,,0,0,0,,楊端和嗎
Dialogue: 0,0:21:08.33,0:21:09.39,Default,,0,0,0,,正是
Dialogue: 0,0:21:10.39,0:21:12.18,Default,,0,0,0,,她不僅拯救了蕞城
Dialogue: 0,0:21:12.40,0:21:15.35,Default,,0,0,0,,還攻陷了衍氏 功勞巨大
Dialogue: 0,0:21:17.19,0:21:18.94,Default,,0,0,0,,取得席位也很正常
Dialogue: 0,0:21:20.00,0:21:21.67,Default,,0,0,0,,還剩一個
Dialogue: 0,0:21:26.71,0:21:27.43,Default,,0,0,0,,是我
Dialogue: 0,0:21:27.57,0:21:28.32,Default,,0,0,0,,是我吧
Dialogue: 0,0:21:28.53,0:21:29.16,Default,,0,0,0,,是我
Dialogue: 0,0:21:29.56,0:21:30.40,Default,,0,0,0,,是我好吧
Dialogue: 0,0:21:30.48,0:21:31.39,Default,,0,0,0,,說了是我
Dialogue: 0,0:21:31.44,0:21:32.14,Default,,0,0,0,,是我
Dialogue: 0,0:21:32.37,0:21:32.99,Default,,0,0,0,,是我
Dialogue: 0,0:21:33.09,0:21:33.59,Default,,0,0,0,,是我
Dialogue: 0,0:21:33.70,0:21:34.26,Default,,0,0,0,,是我
Dialogue: 0,0:21:34.53,0:21:35.56,Default,,0,0,0,,要來殺一場嗎
Dialogue: 0,0:21:35.65,0:21:36.37,Default,,0,0,0,,蠢貨
Dialogue: 0,0:21:37.17,0:21:40.64,Default,,0,0,0,,想成為六將的又不光是我們三個
Dialogue: 0,0:21:41.07,0:21:43.57,Default,,0,0,0,,上面還有錄嗚未和隆國他們
Dialogue: 0,0:21:43.89,0:21:47.19,Default,,0,0,0,,其他部隊裡也有不少知名的將軍
Dialogue: 0,0:21:48.10,0:21:52.85,Default,,0,0,0,,我是不知道六將復活會在明年還是五年後
Dialogue: 0,0:21:53.22,0:21:57.27,Default,,0,0,0,,總之 要是不在那之前成為大將軍級的武將
Dialogue: 0,0:21:57.51,0:21:59.12,Default,,0,0,0,,就連候選人都算不上
Dialogue: 0,0:22:02.75,0:22:03.88,Default,,0,0,0,,所以說
Dialogue: 0,0:22:04.10,0:22:08.47,Default,,0,0,0,,我們飛信隊在今後會勢頭更猛
Dialogue: 0,0:22:08.94,0:22:11.88,Default,,0,0,0,,真單蠢 還是老樣子
Dialogue: 0,0:22:12.53,0:22:15.65,Default,,0,0,0,,那你別告訴我們 自己偷偷努力不就行了
Dialogue: 0,0:22:16.09,0:22:19.56,Default,,0,0,0,,幹出這種小心眼的事還算什麼名震天下的大將軍
Dialogue: 0,0:22:21.15,0:22:22.19,Default,,0,0,0,,好好好
Dialogue: 0,0:22:24.47,0:22:25.76,Default,,0,0,0,,這樣啊
Dialogue: 0,0:22:26.58,0:22:27.95,Default,,0,0,0,,還有一個席位啊
Dialogue: 0,0:22:28.79,0:22:30.70,Default,,0,0,0,,正常來說應該是我
Dialogue: 0,0:22:31.03,0:22:32.99,Default,,0,0,0,,你說什麼 王賁
Dialogue: 0,0:22:35.08,0:22:37.00,Default,,0,0,0,,你笑什麼笑 蒙恬
Dialogue: 0,0:22:37.43,0:22:39.37,Default,,0,0,0,,咸陽大本營發來命令
Dialogue: 0,0:22:39.97,0:22:41.40,Default,,0,0,0,,玉鳳隊前往飯關
Dialogue: 0,0:22:41.58,0:22:43.11,Default,,0,0,0,,樂華隊前往東禮
Dialogue: 0,0:22:43.33,0:22:46.01,Default,,0,0,0,,飛信隊前往黑羊
Dialogue: 0,0:22:46.37,0:22:49.26,Default,,0,0,0,,起飛的機會這麼快就來了
Dialogue: 0,0:22:50.08,0:22:51.41,Default,,0,0,0,,可黑羊…
Dialogue: 0,0:22:52.13,0:22:55.27,Default,,0,0,0,,對 沒有比那裡更難攻打的地方了
Dialogue: 0,0:22:55.81,0:22:57.27,Default,,0,0,0,,那又怎樣
Dialogue: 0,0:22:57.76,0:23:00.24,Default,,0,0,0,,越難越能讓我熱血沸騰
Dialogue: 0,0:23:03.60,0:23:06.84,Default,,0,0,0,,看我大幹一場
Dialogue: 0,0:23:09.36,0:23:11.62,Default,,0,0,0,,等著我 黑羊
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

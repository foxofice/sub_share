Dialogue: 0,0:00:04.18,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕制作：你在那里吗 时间轴、字体调整：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中苍蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,仿佛在夜之运河上滑行
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人通过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找着远方的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用你悲伤的眼瞳
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,来责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么也别说就这样让我离开
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的肩膀
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱着
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,泪水用亲吻拭干
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 按着自己的想法
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 朝着自己的目标前进
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 去探寻遥远彼方的梦
Dialogue: 0,0:01:01.74,0:01:05.63,Layzner,Eiji,0,0,0,,就算这样我身体里也有一半地球人的血统 爸爸是地球人
Dialogue: 0,0:01:05.63,0:01:06.95,Layzner,Gail,0,0,0,,醒醒吧 英二
Dialogue: 0,0:01:06.95,0:01:10.14,Layzner,Eiji,0,0,0,,基地里面有和我一样的地球人
Dialogue: 0,0:01:45.66,0:01:48.45,Layzner,Anna,0,0,0,,1996年10月
Dialogue: 0,0:01:49.53,0:01:55.48,Layzner,Anna,0,0,0,,来到火星的我们 被卷入了未知战斗兵器的战斗中
Dialogue: 0,0:01:56.79,0:01:58.07,Layzner,Anna,0,0,0,,基地被破坏
Dialogue: 0,0:01:59.09,0:02:03.95,Layzner,Anna,0,0,0,,活下来的只剩下我们这些人了
Dialogue: 0,0:02:05.21,0:02:06.06,Layzner,,0,0,0,,接着
Dialogue: 0,0:02:08.03,0:02:08.82,Layzner,Eiji,0,0,0,,不要开枪
Dialogue: 0,0:02:15.00,0:02:16.28,Layzner,Eiji,0,0,0,,我的名字叫英二
Dialogue: 0,0:02:17.08,0:02:18.44,Layzner,Eiji,0,0,0,,地球被盯上了
Dialogue: 0,0:02:18.44,0:02:23.74,Layzner,,0,0,0,,他的名字叫英二
Dialogue: 0,0:02:24.14,0:02:25.94,Layzner,Eiji,0,0,0,,.我的名字叫英二
Dialogue: 0,0:02:25.94,0:02:28.00,Layzner,Eiji,0,0,0,,地球被盯上了
Dialogue: 0,0:02:28.00,0:02:29.60,Layzner,Eiji,0,0,0,,我是来告诉你们这个情报的
Dialogue: 0,0:02:29.60,0:02:30.58,Layzner,Man 1,0,0,0,,不要动
Dialogue: 0,0:02:33.69,0:02:35.23,Layzner,Man 1,0,0,0,,你是苏联军
Dialogue: 0,0:02:35.23,0:02:36.52,Layzner,Man 1,0,0,0,,还是美军
Dialogue: 0,0:02:37.33,0:02:41.23,Layzner,Man 1,0,0,0,,刚才是怎么回事 为什么把我们卷入战斗中
Dialogue: 0,0:02:41.23,0:02:43.23,Layzner,Eiji,0,0,0,,我是从古拉多斯来的
Dialogue: 0,0:02:43.23,0:02:45.28,Layzner,Eiji,0,0,0,,是位于于乌多利亚太阳系的行星
Dialogue: 0,0:02:45.28,0:02:48.94,Layzner,Man 1,0,0,0,,别开玩笑了 你是想愚弄我们吗
Dialogue: 0,0:02:48.94,0:02:53.30,Layzner,Man 1,0,0,0,,你驾驶的那架机体是什么 看起来像是秘密开发的战斗兵器
Dialogue: 0,0:02:53.30,0:02:55.57,Layzner,Eiji,0,0,0,,我是从古拉多斯来的
Dialogue: 0,0:02:55.57,0:03:00.68,Layzner,Man 1,0,0,0,,你以为我们会相信你的鬼话吗 你的上级是谁 我们要监禁你
Dialogue: 0,0:03:01.28,0:03:06.51,Layzner,Anna,0,0,0,,这时候 我们还没搞清楚到底发生了什么事
Dialogue: 0,0:03:06.51,0:03:12.55,Layzner,Anna,0,0,0,,眼前发生的事太过突然 我们完全来不及思考
Dialogue: 0,0:03:31.48,0:03:32.38,Layzner,Man 1,0,0,0,,不要动
Dialogue: 0,0:03:55.61,0:03:56.73,Layzner,Man 1,0,0,0,,站住
Dialogue: 0,0:03:56.73,0:03:57.81,Layzner,David,0,0,0,,你这家伙
Dialogue: 0,0:03:58.25,0:03:59.82,Layzner,David,0,0,0,,可恶
Dialogue: 0,0:04:17.36,0:04:19.59,Layzner,Eiji,0,0,0,,雷 报告目前的状况
Dialogue: 0,0:04:19.59,0:04:22.04,LayznerComputer,Rey,0,0,0,,有三艘太空船侵入
Dialogue: 0,0:04:22.04,0:04:22.95,Layzner,Eiji,0,0,0,,预计接触时间是多少
Dialogue: 0,0:04:22.95,0:04:24.87,LayznerComputer,Rey,0,0,0,,5 +/- 1.
Dialogue: 0,0:04:24.87,0:04:26.29,Layzner,Eiji,0,0,0,,剩余能量还有多少
Dialogue: 0,0:04:26.29,0:04:29.48,LayznerComputer,Rey,0,0,0,,预计可行动时间:46 +/- 5.
Dialogue: 0,0:04:30.23,0:04:31.25,Layzner,Eiji,0,0,0,,全速回避
Dialogue: 0,0:04:31.25,0:04:35.26,LayznerComputer,Rey,0,0,0,,被敌人探测器侦测到的概率在90%以上
Dialogue: 0,0:04:35.26,0:04:37.14,Layzner,Eiji,0,0,0,,这就够了 要的就是这个效果
Dialogue: 0,0:04:37.14,0:04:41.49,LayznerComputer,Rey,0,0,0,,重复 探测到敌人的反应
Dialogue: 0,0:04:41.49,0:04:44.80,Layzner,Eiji,0,0,0,,我不想把地球人卷入到战斗中 我要马上离开这里
Dialogue: 0,0:04:44.80,0:04:45.81,Layzner,Eiji,0,0,0,,进行地形分析
Dialogue: 0,0:04:45.81,0:04:46.41,LayznerComputer,Rey,0,0,0,,Ready.
Dialogue: 0,0:05:20.76,0:05:23.26,Layzner,Man 1,0,0,0,,看 和之前一样的战斗兵器
Dialogue: 0,0:05:31.16,0:05:32.33,Layzner,Man 2,0,0,0,,战斗机
Dialogue: 0,0:05:33.20,0:05:36.08,Layzner,Roanne,0,0,0,,果然是苏联和美国在交战吧
Dialogue: 0,0:05:36.08,0:05:39.55,Layzner,Arthur,0,0,0,,别开玩笑了 怎么会在这种时候开战
Dialogue: 0,0:05:39.55,0:05:41.20,Layzner,Elizabeth,0,0,0,,不要做毫无根据的推论
Dialogue: 0,0:05:41.20,0:05:45.38,Layzner,Man 1,0,0,0,,我也觉得不太可能 但确实已经露出了战争的獠牙
Dialogue: 0,0:05:48.45,0:05:51.88,Layzner,Man 2,0,0,0,,总之 肯定发生了什么严重的事
Dialogue: 0,0:05:56.66,0:06:01.15,Layzner,Elizabeth,0,0,0,,听好了 你们马上回房间去 一步也不要迈出
Dialogue: 0,0:06:01.81,0:06:04.46,Layzner,Arthur,0,0,0,,我们都能回家吧
Dialogue: 0,0:06:04.46,0:06:05.90,Layzner,Elizabeth,0,0,0,,放心吧
Dialogue: 0,0:06:05.90,0:06:07.90,Layzner,Elizabeth,0,0,0,,好了 快点 小心点
Dialogue: 0,0:06:08.99,0:06:10.73,Layzner,Arthur,0,0,0,,不用担心 跟着我就好了
Dialogue: 0,0:06:10.73,0:06:13.76,Layzner,Simone,0,0,0,,是啊 还真像个大人呢
Dialogue: 0,0:06:24.31,0:06:27.06,Layzner,Gail,0,0,0,,英二 能听到吗
Dialogue: 0,0:06:27.06,0:06:28.74,Layzner,Gail,0,0,0,,回答我
Dialogue: 0,0:06:29.66,0:06:32.89,Layzner,Gail,0,0,0,,英二 乖乖投降吧
Dialogue: 0,0:06:32.89,0:06:35.86,Layzner,Gail,0,0,0,,先不说古雷斯克舰队的名誉
Dialogue: 0,0:06:35.86,0:06:40.39,Layzner,Gail,0,0,0,,光是你窃夺SPT就已经是重罪了 而且你居然还向追踪部队开火
Dialogue: 0,0:06:40.39,0:06:42.76,Layzner,Gail,0,0,0,,英二 能听到吗
Dialogue: 0,0:06:42.76,0:06:47.78,Layzner,Gail,0,0,0,,我是你的伙伴 我希望你能尽可能受到较轻的处罚
Dialogue: 0,0:06:47.78,0:06:49.42,Layzner,Gail,0,0,0,,回答我 英二
Dialogue: 0,0:06:50.88,0:06:52.41,Layzner,Eiji,0,0,0,,抱歉 盖尔前辈
Dialogue: 0,0:06:53.05,0:06:54.63,Layzner,Eiji,0,0,0,,请原谅我
Dialogue: 0,0:06:54.63,0:06:57.56,Layzner,Gail,0,0,0,,和你说了这么多 还是不打算投降吗
Dialogue: 0,0:06:57.56,0:06:58.68,Layzner,Eiji,0,0,0,,我办不到
Dialogue: 0,0:06:58.68,0:06:59.48,Layzner,Gail,0,0,0,,为什么
Dialogue: 0,0:07:00.05,0:07:01.27,Layzner,Gail,0,0,0,,理由是什么
Dialogue: 0,0:07:03.89,0:07:05.51,Layzner,Gail,0,0,0,,说不出来吗
Dialogue: 0,0:07:05.51,0:07:08.19,Layzner,Gail,0,0,0,,成为古拉多斯的叛徒也没关系吗
Dialogue: 0,0:07:08.19,0:07:10.78,Layzner,Gail,0,0,0,,英二 这是最后的警告
Dialogue: 0,0:07:10.78,0:07:15.37,Layzner,Gail,0,0,0,,马上投降 否则我们就攻击了 给你十秒钟 英二
Dialogue: 0,0:07:16.05,0:07:21.16,Layzner,Eiji,0,0,0,,不能杀驾驶员 雷 调查下那种机甲类型的结构
Dialogue: 0,0:07:21.92,0:07:24.03,Layzner,EijI,0,0,0,,攻击那里的话就能令其停止行动
Dialogue: 0,0:07:24.03,0:07:25.81,Layzner,EijI,0,0,0,,进入战斗模式 准备反击
Dialogue: 0,0:07:25.81,0:07:26.41,LayznerComputer,Rey,0,0,0,,Ready.
Dialogue: 0,0:07:26.41,0:07:28.00,Layzner,Gail,0,0,0,,十秒到了 英二
Dialogue: 0,0:07:40.72,0:07:43.64,Layzner,Eiji,0,0,0,,雷 分析地形 要准备战斗了
Dialogue: 0,0:07:43.64,0:07:44.28,LayznerComputer,Rey,0,0,0,,Ready.
Dialogue: 0,0:08:11.58,0:08:15.50,Layzner,Man 1,0,0,0,,USSR USSR 请回答 这里是联合国基地
Dialogue: 0,0:08:15.50,0:08:19.73,Layzner,Man 1,0,0,0,,USA USA 这里是联合国基地 联合国基地
Dialogue: 0,0:08:20.83,0:08:25.86,Layzner,Man 1,0,0,0,,可恶 不行 无论是美国基地还是苏联基地都完全无法联络
Dialogue: 0,0:08:25.86,0:08:27.94,Layzner,Man 2,0,0,0,,迄今为止没发现有生还者
Dialogue: 0,0:08:27.94,0:08:29.41,Layzner,Man 1,0,0,0,,是吗
Dialogue: 0,0:08:29.41,0:08:31.65,Layzner,Man 3,0,0,0,,你们那里有什么进展
Dialogue: 0,0:08:31.65,0:08:37.41,Layzner,Man 1,0,0,0,,不行 噪音太大 我们可能遇到了干扰电波 我会再尝试联络的
Dialogue: 0,0:08:37.89,0:08:42.53,Layzner,Girl 1,0,0,0,,食物和水源没有问题 但是急需生命维持装置
Dialogue: 0,0:08:42.53,0:08:47.20,Layzner,Girl 1,0,0,0,,虽然做了紧急维修 但是用于补充的零件全被吹走 没有剩余了
Dialogue: 0,0:08:47.20,0:08:48.64,Layzner,Man 1,0,0,0,,还剩多少
Dialogue: 0,0:08:48.64,0:08:52.19,Layzner,Girl 1,0,0,0,,氧气的话还能维持四五天
Dialogue: 0,0:08:52.19,0:08:54.19,Layzner,Girl 2,0,0,0,,只能请求救援了
Dialogue: 0,0:09:11.08,0:09:12.44,Layzner,Simone,0,0,0,,不要走来走去的
Dialogue: 0,0:09:14.52,0:09:16.13,Layzner,Simone,0,0,0,,你这样让我更烦
Dialogue: 0,0:09:16.13,0:09:21.65,Layzner,Arthur,0,0,0,,西蒙尼 不是只有你一人担心今后的情况 冷静一点
Dialogue: 0,0:09:21.65,0:09:25.93,Layzner,Simone,0,0,0,,越这样想就越冷静不下来 而且需要冷静的事亚瑟你吧
Dialogue: 0,0:09:25.93,0:09:27.09,Layzner,Arthur,0,0,0,,西蒙尼
Dialogue: 0,0:09:27.09,0:09:30.68,Layzner,Roanne,0,0,0,,真的爆发战争了吗
Dialogue: 0,0:09:30.68,0:09:33.28,Layzner,Arthur,0,0,0,,刚才不是你说的吗
Dialogue: 0,0:09:33.28,0:09:36.51,Layzner,Roanne,0,0,0,,我只是说美苏是不是在交战
Dialogue: 0,0:09:36.51,0:09:40.98,Layzner,Arthur,0,0,0,,都一样 我们不是看到三架美国战机被击落了吗
Dialogue: 0,0:09:40.98,0:09:42.66,Layzner,Simone,0,0,0,,你的意思是敌人是苏联吗
Dialogue: 0,0:09:42.66,0:09:44.87,Layzner,Arthur,0,0,0,,还有别的可能吗
Dialogue: 0,0:09:44.87,0:09:50.35,Layzner,Simone,0,0,0,,那不还是说明两国在交战吗 这不就是一直在原地转圈
Dialogue: 0,0:09:50.35,0:09:51.01,Layzner,Anna,0,0,0,,那么
Dialogue: 0,0:09:52.80,0:09:56.89,Layzner,Anna,0,0,0,,那个人果然就是地球的士兵
Dialogue: 0,0:09:56.89,0:09:59.23,Layzner,Simone,0,0,0,,安娜你该不会相信他编的那些话吧
Dialogue: 0,0:09:59.23,0:10:04.82,Layzner,Arthur,0,0,0,,总之我们需要更多的情报 为了更清楚事情的真相
Dialogue: 0,0:10:04.82,0:10:06.61,Layzner,Roanne,0,0,0,,去问问吗
Dialogue: 0,0:10:06.61,0:10:07.65,Layzner,Arthur,0,0,0,,走吧
Dialogue: 0,0:10:08.96,0:10:12.67,Layzner,Simone,0,0,0,,顺便找一下大卫吧 他不知道去哪了
Dialogue: 0,0:10:12.67,0:10:15.22,Layzner,Arthur,0,0,0,,你很在意那家伙吗
Dialogue: 0,0:10:15.22,0:10:17.22,Layzner,Simone,0,0,0,,他的脸色不太好
Dialogue: 0,0:10:21.03,0:10:23.66,Layzner,Man 1,0,0,0,,USSR!  USSR!
Dialogue: 0,0:10:24.08,0:10:25.14,Layzner,Man 1,0,0,0,,还是不行
Dialogue: 0,0:10:25.83,0:10:30.39,Layzner,Elizabeth,0,0,0,,有干扰电波 也就是说还在战斗中吗
Dialogue: 0,0:10:30.39,0:10:35.57,Layzner,Woman 1,0,0,0,,也可能是两边的基地都被歼灭了
Dialogue: 0,0:10:37.52,0:10:40.12,Layzner,Elizabeth,0,0,0,,我不是告诉你们不要离开房间吗
Dialogue: 0,0:10:40.12,0:10:42.85,Layzner,Arthur,0,0,0,,我是亚瑟 我代表大家来的
Dialogue: 0,0:10:42.85,0:10:46.82,Layzner,Arthur,0,0,0,,我们有权知道到底发生了什么事
Dialogue: 0,0:10:46.82,0:10:51.85,Layzner,Arthur,0,0,0,,还有...那个... 你也有告诉我们的义务
Dialogue: 0,0:10:52.61,0:10:55.60,Layzner,Man 2,0,0,0,,博士 能来一下8号门吗
Dialogue: 0,0:10:57.25,0:11:00.32,Layzner,Man 2,0,0,0,,您的学生 该怎么说呢
Dialogue: 0,0:11:13.73,0:11:14.33,Layzner,Elizabeth,0,0,0,,大卫
Dialogue: 0,0:11:21.08,0:11:21.96,Layzner,Elizabeth,0,0,0,,大卫
Dialogue: 0,0:11:21.96,0:11:22.92,Layzner,David,0,0,0,,朱诺
Dialogue: 0,0:11:24.08,0:11:26.23,Layzner,David,0,0,0,,就在门的另一边
Dialogue: 0,0:11:27.53,0:11:30.02,Layzner,David,0,0,0,,他一定在等我
Dialogue: 0,0:11:30.76,0:11:32.50,Layzner,Elizabeth,0,0,0,,朱诺他
Dialogue: 0,0:11:32.50,0:11:35.21,Layzner,Elizabeth,0,0,0,,朱诺他一直和你在一起
Dialogue: 0,0:11:35.21,0:11:37.88,Layzner,Elizabeth,0,0,0,,站起来到大家那里去吧
Dialogue: 0,0:11:38.32,0:11:39.12,Layzner,,0,0,0,,来
Dialogue: 0,0:11:43.59,0:11:46.75,Layzner,Anna,0,0,0,,如果这是梦的话 请快点醒来吧
Dialogue: 0,0:11:47.71,0:11:52.56,Layzner,Anna,0,0,0,,在这段如同静止的痛苦时间里 我一直这样祈祷着
Dialogue: 0,0:11:52.56,0:11:59.61,Layzner,Anna,0,0,0,,如果这是梦的话 请快点醒来吧
Dialogue: 0,0:11:59.61,0:12:02.88,Layzner,Anna,0,0,0,,我想大家一定也在这样祈祷
Comment: 0,0:12:02.88,0:12:11.67,Layzner,,0,0,0,,-Eye Catch-
Dialogue: 0,0:12:35.26,0:12:37.11,LayznerComputer,Rey,0,0,0,,后方2-0位置请注意
Dialogue: 0,0:12:41.72,0:12:42.94,Layzner,Eiji,0,0,0,,那里被击中了
Dialogue: 0,0:12:42.94,0:12:46.49,LayznerComputer,Rey,0,0,0,,左腕关节系统受损 二次回路开始运作
Dialogue: 0,0:13:29.54,0:13:35.61,Layzner,Gail,0,0,0,,英二 不要让我为难啊 你姐姐就要和我结婚了
Dialogue: 0,0:13:35.61,0:13:37.53,Layzner,Gail,0,0,0,,你这个笨蛋
Dialogue: 0,0:13:37.53,0:13:40.33,Layzner,Eiji,0,0,0,,丢掉30%的推进燃料
Dialogue: 0,0:13:40.33,0:13:42.95,LayznerComputer,Rey,0,0,0,,警报 可视范围减小
Dialogue: 0,0:13:42.95,0:13:44.45,Layzner,Eiji,0,0,0,,全部丢掉
Dialogue: 0,0:13:44.45,0:13:44.93,LayznerComputer,Rey,0,0,0,,Ready.
Dialogue: 0,0:13:49.70,0:13:51.57,Layzner,Gail,0,0,0,,启动雷达战斗系统
Dialogue: 0,0:13:51.57,0:13:52.29,LayznerComputer,Com,0,0,0,,Ready.
Dialogue: 0,0:14:00.67,0:14:03.02,LayznerComputer,Rey,0,0,0,,警报 后方有敌人追击
Dialogue: 0,0:14:03.02,0:14:04.15,Layzner,Eiji,0,0,0,,启动ECM
Dialogue: 0,0:14:04.15,0:14:04.58,LayznerComputer,Rey,0,0,0,,Ready.
Dialogue: 0,0:14:10.64,0:14:11.51,Layzner,Gail,0,0,0,,糟了
Dialogue: 0,0:14:11.83,0:14:13.58,LayznerComputer,Com,0,0,0,,侦察系统失灵
Dialogue: 0,0:14:13.58,0:14:17.96,Layzner,Eiji,0,0,0,,利用这个机会 记忆系统启动 切换到自动操纵系统
Dialogue: 0,0:14:17.96,0:14:18.50,LayznerComputer,Rey,0,0,0,,Ready.
Dialogue: 0,0:14:29.31,0:14:31.81,LayznerComputer,Com,0,0,0,,警报 前方有障碍物
Dialogue: 0,0:14:53.41,0:14:59.43,Layzner,Man 1,0,0,0,,{\fs20}根据我们掌握的事实情况分析 美苏两国应该处于交战状态
Dialogue: 0,0:14:59.43,0:15:02.79,Layzner,Man 1,0,0,0,,但是 我们还不能妄下定论
Dialogue: 0,0:15:02.79,0:15:05.54,Layzner,Man 1,0,0,0,,现在需要精准无误的情报
Dialogue: 0,0:15:06.19,0:15:11.17,Layzner,Man 1,0,0,0,,我们现在就去美军基地 去取得完整的情报
Dialogue: 0,0:15:11.17,0:15:16.23,Layzner,Man 1,0,0,0,,我们也会尽力让大家快点回去 请大家放心
Dialogue: 0,0:15:25.59,0:15:28.14,LayznerComputer,Com,0,0,0,,系统失灵 系统失灵
Dialogue: 0,0:15:46.06,0:15:48.90,Layzner,Gail,0,0,0,,英二 躲起来也没用
Dialogue: 0,0:15:48.90,0:15:51.55,Layzner,Gail,0,0,0,,与我们为敌是没有胜算的
Dialogue: 0,0:15:52.27,0:15:56.12,Layzner,Gail,0,0,0,,你有没有想过你姐姐如果知道她弟弟是叛徒会是什么感受
Dialogue: 0,0:15:56.12,0:15:59.60,Layzner,Gail,0,0,0,,英二 现在还来得及
Dialogue: 0,0:15:59.60,0:16:01.74,Layzner,Gail,0,0,0,,快点投降吧
Dialogue: 0,0:16:14.99,0:16:18.80,LayznerComputer,Com,0,0,0,,Information Message 热能探测器有反应
Dialogue: 0,0:16:20.15,0:16:24.72,Layzner,Pilot A,0,0,0,,盖尔队长 地球人的基地探测到反应 好像还有生还者
Dialogue: 0,0:16:24.72,0:16:26.80,Layzner,Gail,0,0,0,,没有把他们全消灭吗
Dialogue: 0,0:16:26.80,0:16:27.64,Layzner,Pilot A,0,0,0,,属下愿意效劳
Dialogue: 0,0:16:27.64,0:16:28.60,Layzner,Gail,0,0,0,,全部消灭（缺一句 士兵：是）
Dialogue: 0,0:16:36.76,0:16:38.44,Layzner,Elizabeth,0,0,0,,大家快回地下室去
Dialogue: 0,0:16:43.24,0:16:45.52,Layzner,Pilot A,0,0,0,,看啊 惊慌的猴子们束手无策了
Dialogue: 0,0:16:45.52,0:16:48.18,Layzner,Pilot B,0,0,0,,一个也不要留 全部消灭
Dialogue: 0,0:16:54.08,0:16:55.33,Layzner,Roanne?,0,0,0,,可恶
Dialogue: 0,0:17:05.97,0:17:09.62,Layzner,Man 1,0,0,0,,快到里面去
Dialogue: 0,0:17:11.03,0:17:11.56,Layzner,Man 1,0,0,0,,快点
Dialogue: 0,0:17:11.56,0:17:11.90,Layzner,Roanne,0,0,0,,是
Dialogue: 0,0:17:11.90,0:17:12.42,Layzner,Arthur,0,0,0,,是
Dialogue: 0,0:17:42.91,0:17:44.01,Layzner,Gail,0,0,0,,英二
Dialogue: 0,0:17:45.24,0:17:49.79,Layzner,Gail,0,0,0,,你在干什么 你为什么要保护地球人的基地
Dialogue: 0,0:17:54.70,0:18:01.25,Layzner,Gail,0,0,0,,是吗 原来是这样 所以你才与我们为敌
Dialogue: 0,0:18:01.25,0:18:02.40,LayznerComputer,Rey,0,0,0,,警报
Dialogue: 0,0:18:02.40,0:18:03.51,Layzner,Gail,0,0,0,,英二
Dialogue: 0,0:18:03.51,0:18:05.68,LayznerComputer,Rey,0,0,0,,正在被敌人瞄准
Dialogue: 0,0:18:05.68,0:18:10.73,Layzner,Gail,0,0,0,,我忘了你体内有一半地球人的血统
Dialogue: 0,0:18:11.46,0:18:12.51,Layzner,Gail,0,0,0,,完全忘了
Dialogue: 0,0:18:12.51,0:18:14.48,LayznerComputer,Rey,0,0,0,,必须马上转移目标
Dialogue: 0,0:18:14.48,0:18:19.40,Layzner,Gail,0,0,0,,所以才会背叛古雷克斯舰队 窃夺SPT
Dialogue: 0,0:18:20.09,0:18:22.49,Layzner,Eiji,0,0,0,,请原谅我 盖尔前辈
Dialogue: 0,0:18:22.49,0:18:28.99,Layzner,Gail,0,0,0,,听清楚 英二 你的归属是古拉多斯 你是古拉多斯人
Dialogue: 0,0:18:28.99,0:18:32.32,Layzner,Gail,0,0,0,,我也一直把你当做古拉多斯人
Dialogue: 0,0:18:32.32,0:18:35.00,Layzner,Gail,0,0,0,,你为什么要站在地球人那边
Dialogue: 0,0:18:35.97,0:18:39.15,Layzner,Gail,0,0,0,,你是在古拉多斯长大的
Dialogue: 0,0:18:39.15,0:18:44.34,Layzner,Gail,0,0,0,,是古拉多斯的阳光 土地 还有空气把你养大的
Dialogue: 0,0:18:44.34,0:18:49.25,Layzner,Eiji,0,0,0,,就算这样我身体里也有一半地球人的血统 爸爸是地球人
Dialogue: 0,0:18:49.25,0:18:52.70,LayznerComputer,Rey,0,0,0,,警报 被敌人瞄准已处于危险状态
Dialogue: 0,0:18:52.70,0:18:56.07,Layzner,Gail,0,0,0,,醒醒吧 英二
Dialogue: 0,0:18:56.07,0:18:58.48,LayznerComputer,Rey,0,0,0,,必须马上转移目标
Dialogue: 0,0:18:58.48,0:19:02.52,Layzner,,0,0,0,,睁大你的眼睛看清楚
Dialogue: 0,0:19:02.86,0:19:07.43,Layzner,,0,0,0,,地球人的宇宙开拓计划只会成为动乱的根源 现在他们不正是这样在火星上建造基地吗
Dialogue: 0,0:19:07.43,0:19:11.70,Layzner,Eiji,0,0,0,,就算这样 为什么要消灭地球人
Dialogue: 0,0:19:11.70,0:19:15.02,Layzner,Gail,0,0,0,,现在没时间和你争论 让开
Dialogue: 0,0:19:15.02,0:19:17.02,LayznerComputer,Rey,0,0,0,,Alarm Message.警报
Dialogue: 0,0:19:17.04,0:19:19.69,Layzner,Gail,0,0,0,,把地球人的生还者全部消灭
Dialogue: 0,0:19:19.69,0:19:24.21,Layzner,Eiji,0,0,0,,不要 基地里面有和我一样的地球人
Dialogue: 0,0:19:24.21,0:19:28.74,LayznerComputer,Rey,0,0,0,,被敌人瞄准已处于危险状态 必须马上转移目标
Dialogue: 0,0:19:28.74,0:19:32.50,Layzner,Gail,0,0,0,,就算你说不要 我们也要执行任务
Dialogue: 0,0:19:34.33,0:19:35.55,LayznerComputer,Rey,0,0,0,,警报
Dialogue: 0,0:19:35.55,0:19:36.55,Layzner,Eiji,0,0,0,,我知道了
Dialogue: 0,0:19:54.97,0:19:58.00,Layzner,Gail,0,0,0,,把基地和地球人一起消灭
Dialogue: 0,0:19:58.88,0:20:00.17,Layzner,Eiji,0,0,0,,不要开枪
Dialogue: 0,0:20:01.51,0:20:03.06,Layzner,Eiji,0,0,0,,请不要开枪
Dialogue: 0,0:20:17.43,0:20:21.04,LayznerComputer,Rey,0,0,0,,警报 请马上离开瞄准区域
Dialogue: 0,0:20:21.04,0:20:22.34,Layzner,Eiji,0,0,0,,我不会离开的
Dialogue: 0,0:20:25.66,0:20:30.14,Layzner,Gail,0,0,0,,凭你的技术根本打不到我 你应该明白的
Dialogue: 0,0:20:32.21,0:20:33.99,LayznerComputer,Rey,0,0,0,,手腕部受损
Dialogue: 0,0:20:33.99,0:20:36.25,LayznerComputer,Rey,0,0,0,,左脚能源回路受损
Dialogue: 0,0:20:36.25,0:20:38.18,LayznerComputer,Rey,0,0,0,,胸部通讯系统受损
Dialogue: 0,0:20:38.18,0:20:42.04,LayznerComputer,Rey,0,0,0,,损伤严重 请马上脱离战斗区域
Dialogue: 0,0:20:42.04,0:20:44.45,Layzner,Eiji,0,0,0,,不行 基地里还有地球人
Dialogue: 0,0:20:45.30,0:20:49.28,LayznerComputer,Rey,0,0,0,,敌方瞄准目标变更为SPT中枢
Dialogue: 0,0:20:49.28,0:20:53.33,LayznerComputer,Rey,0,0,0,,目标击破率在95%以上
Dialogue: 0,0:20:57.85,0:21:04.74,Layzner,Julia,0,0,0,,英二 说不定我们会结婚 当然还早得很呢
Dialogue: 0,0:21:04.74,0:21:06.33,LayznerComputer,Rey,0,0,0,,请马上进行攻击
Dialogue: 0,0:21:08.05,0:21:10.42,LayznerComputer,Rey,0,0,0,,剩余时间15秒
Dialogue: 0,0:21:10.75,0:21:12.01,Layzner,Eiji,0,0,0,,还有15秒
Dialogue: 0,0:21:12.01,0:21:12.69,LayznerComputer,Rey,0,0,0,,14...
Dialogue: 0,0:21:12.69,0:21:13.70,LayznerComputer,Rey,0,0,0,,13...
Dialogue: 0,0:21:13.70,0:21:14.61,LayznerComputer,Rey,0,0,0,,12...
Dialogue: 0,0:21:14.61,0:21:15.47,LayznerComputer,Rey,0,0,0,,11...
Dialogue: 0,0:21:15.47,0:21:16.47,LayznerComputer,Rey,0,0,0,,10...
Dialogue: 0,0:21:16.47,0:21:17.52,LayznerComputer,Rey,0,0,0,,9...
Dialogue: 0,0:21:17.52,0:21:18.49,LayznerComputer,Rey,0,0,0,,8...
Dialogue: 0,0:21:17.92,0:21:18.79,Layzner,Eiji,0,0,0,,不行 我下不了手
Dialogue: 0,0:21:18.49,0:21:19.40,LayznerComputer,Rey,0,0,0,,7...
Dialogue: 0,0:21:19.40,0:21:20.51,LayznerComputer,Rey,0,0,0,,6...
Dialogue: 0,0:21:20.51,0:21:21.13,LayznerComputer,Rey,0,0,0,,5...
Dialogue: 0,0:21:26.10,0:21:28.80,Layzner,Anna,0,0,0,,妈妈 救救我
Dialogue: 0,0:21:36.74,0:21:37.64,Layzner,Gail,0,0,0,,英二
Dialogue: 0,0:21:39.24,0:21:42.85,Layzner,Eiji,0,0,0,,盖尔前辈 要杀他们的话就请先杀了我吧
Dialogue: 0,0:21:42.85,0:21:46.70,Layzner,Eiji,0,0,0,,拜托了 要杀他们的话就先杀了我
Dialogue: 0,0:21:46.70,0:21:52.34,Layzner,Eiji,0,0,0,,我的体内和他们一样流着红色的血 请你看看 拜托了
Dialogue: 0,0:21:52.34,0:21:54.34,Layzner,Eiji,0,0,0,,请先杀了我
Dialogue: 0,0:22:00.99,0:22:03.59,Layzner,Gail,0,0,0,,停止攻击
Dialogue: 0,0:22:07.54,0:22:10.75,Layzner,Eiji,0,0,0,,非常感谢
Dialogue: 0,0:22:10.75,0:22:16.61,Layzner,Gail,0,0,0,,英二 这下我们已经走上了不同的道路
Dialogue: 0,0:22:16.61,0:22:19.64,Layzner,Gail,0,0,0,,下次再碰面我不会手下留情了
Dialogue: 0,0:22:19.64,0:22:21.52,Layzner,Gail,0,0,0,,撤退 (缺两句  士兵：什么  盖尔：回去吧)
Dialogue: 0,0:22:30.40,0:22:37.34,Layzner,Anna,0,0,0,,我 对于自己能够的事 简直像是梦一样难以置信
Dialogue: 0,0:22:38.71,0:22:48.17,Layzner,Anna,0,0,0,,更令人难以置信的是 这位来自古拉多斯的少年 用自己的身体救了我们
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻

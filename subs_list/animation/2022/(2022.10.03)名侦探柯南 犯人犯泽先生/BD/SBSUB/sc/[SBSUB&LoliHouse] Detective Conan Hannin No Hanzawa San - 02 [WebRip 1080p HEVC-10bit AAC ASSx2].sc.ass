Dialogue: 0,0:06:51.85,0:06:57.86,DefaultSingle-S,,0,0,0,,{\an8\fs60\c&H0AFEFF&\bord6}犯泽今后的活跃 敬请期待。
Dialogue: 0,0:06:57.86,0:07:01.03,DefaultSingle-S,,0,0,0,,{\c&H050407&\3c&HFFFEFF&\fn方正兰亭圆_GBK_特\pos(920,954)\bord10\shad0}博美太郎
Dialogue: 0,0:01:32.98,0:01:35.16,DefaultSingle-S,,0,0,0,,		他的名字叫犯泽
Dialogue: 0,0:01:43.32,0:01:45.93,DefaultSingle-S,,0,0,0,,		之前发生了很多事  总之他现在…
Dialogue: 0,0:01:46.39,0:01:47.35,DefaultSingle-S,,0,0,0,,		没地方住
Dialogue: 0,0:02:00.81,0:02:02.00,DefaultSingle-S,,0,0,0,,		播报一则新闻
Dialogue: 0,0:02:02.42,0:02:04.10,DefaultSingle-S,,0,0,0,,		虽然已屡见不鲜
Dialogue: 0,0:02:04.10,0:02:07.42,DefaultSingle-S,,0,0,0,,		警方抓获了在米花町的公寓犯下凶杀案的犯人
Dialogue: 0,0:02:07.50,0:02:10.56,DefaultSingle-S,,0,0,0,,	{\an8\fs55}	本案为有预谋的犯罪  警方认为是仇杀…
Dialogue: 0,0:02:08.62,0:02:10.56,DefaultSingle-S,,0,0,0,,		凶宅又增加了
Dialogue: 0,0:02:11.25,0:02:14.72,DefaultSingle-S,,0,0,0,,		此时此刻  凶宅的势力也在不断壮大
Dialogue: 0,0:02:14.81,0:02:18.82,DefaultSingle-S,,0,0,0,,		而凶宅越多  非凶宅的价格就越高
Dialogue: 0,0:02:17.42,0:02:20.25,DefaultSingle-S,,0,0,0,,	{\an8\fs55}	我都笑得合不拢嘴了
Dialogue: 0,0:02:20.25,0:02:23.12,DefaultSingle-S,,0,0,0,,		老师  这个案子使用的手法十分精妙
Dialogue: 0,0:02:23.89,0:02:27.23,DefaultSingle-S,,0,0,0,,		想出这个手法的人堪称天才
Dialogue: 0,0:02:27.23,0:02:28.09,DefaultSingle-S,,0,0,0,,		天才？
Dialogue: 0,0:02:28.78,0:02:32.17,DefaultSingle-S,,0,0,0,,		既然要想手法  那就也想想怎么善后啊
Dialogue: 0,0:02:32.17,0:02:34.42,DefaultSingle-S,,0,0,0,,		好歹也铺张塑料布垫一垫啊
Dialogue: 0,0:02:34.42,0:02:36.76,DefaultSingle-S,,0,0,0,,		再说了  别在出租屋里杀人啊
Dialogue: 0,0:02:37.02,0:02:39.97,DefaultSingle-S,,0,0,0,,		你们也想象一下房东困扰的表情啊
Dialogue: 0,0:02:40.23,0:02:43.47,DefaultSingle-S,,0,0,0,,		可恶的犯人
Dialogue: 0,0:02:43.47,0:02:44.68,DefaultSingle-S,,0,0,0,,		那人好可疑
Dialogue: 0,0:02:45.07,0:02:49.52,DefaultSingle-S,,0,0,0,,		据点定不下来  就没法好好制定杀死那个人的计划
Dialogue: 0,0:02:49.97,0:02:54.05,DefaultSingle-S,,0,0,0,,		姑且从房产中介那里拿了备选房屋的资料
Dialogue: 0,0:02:54.17,0:02:57.88,DefaultSingle-S,,0,0,0,,		便宜的凶宅和昂贵的非凶宅
Dialogue: 0,0:02:58.24,0:02:59.65,DefaultSingle-S,,0,0,0,,		太纠结了
Dialogue: 0,0:03:00.04,0:03:01.08,DefaultSingle-S,,0,0,0,,		该怎么办
Dialogue: 0,0:03:01.08,0:03:02.61,DefaultSingle-S,,0,0,0,,		元太  现在是红灯
Dialogue: 0,0:03:02.61,0:03:03.67,DefaultSingle-S,,0,0,0,,		没事啦
Dialogue: 0,0:03:03.79,0:03:06.77,DefaultSingle-S,,0,0,0,,		红灯  大家一起闯就不怕了
Dialogue: 0,0:03:06.77,0:03:08.10,DefaultSingle-S,,0,0,0,,		不是经常这么说吗
Dialogue: 0,0:03:08.51,0:03:09.64,DefaultSingle-S,,0,0,0,,		好危险
Dialogue: 0,0:03:09.64,0:03:11.29,DefaultSingle-S,,0,0,0,,		我都说危险了
Dialogue: 0,0:03:11.89,0:03:12.64,DefaultSingle-S,,0,0,0,,		就是这个
Dialogue: 0,0:03:12.79,0:03:16.68,DefaultSingle-S,,0,0,0,,		凶宅  大家一起住就不怕了
Dialogue: 0,0:03:16.89,0:03:19.70,DefaultSingle-S,,0,0,0,,		你还挺会说话嘛  饭团小鬼
Dialogue: 0,0:03:19.70,0:03:20.54,DefaultSingle-S,,0,0,0,,		饭团？
Dialogue: 0,0:03:21.47,0:03:23.03,DefaultSingle-S,,0,0,0,,		就选合租房了
Dialogue: 0,0:03:23.86,0:03:27.87,DefaultSingle-S,,0,0,0,,		你运气真好  刚好有空房间了
Dialogue: 0,0:03:28.00,0:03:30.37,DefaultSingle-S,,0,0,0,,		毕竟合租房很受欢迎
Dialogue: 0,0:03:30.57,0:03:31.78,DefaultSingle-S,,0,0,0,,		就是这间
Dialogue: 0,0:03:33.44,0:03:34.61,DefaultSingle-S,,0,0,0,,		带家具
Dialogue: 0,0:03:34.87,0:03:39.16,DefaultSingle-S,,0,0,0,,		电视  冰箱  微波炉  电饭煲  餐具  等等
Dialogue: 0,0:03:39.16,0:03:40.96,DefaultSingle-S,,0,0,0,,		大部分生活用品都有
Dialogue: 0,0:03:40.96,0:03:44.16,DefaultSingle-S,,0,0,0,,		只需要自带衣服和被子就够了
Dialogue: 0,0:03:44.26,0:03:46.65,DefaultSingle-S,,0,0,0,,		好棒啊  可不光是时尚
Dialogue: 0,0:03:47.05,0:03:47.95,DefaultSingle-S,,0,0,0,,		你好
Dialogue: 0,0:03:48.31,0:03:49.54,DefaultSingle-S,,0,0,0,,		你  你好
Dialogue: 0,0:03:50.90,0:03:52.35,DefaultSingle-S,,0,0,0,,		合租房…
Dialogue: 0,0:03:52.55,0:03:53.46,DefaultSingle-S,,0,0,0,,		就是这个了
Dialogue: 0,0:03:53.64,0:03:55.72,DefaultSingle-S,,0,0,0,,		和别人一起就放心了
Dialogue: 0,0:03:55.85,0:03:58.31,DefaultSingle-S,,0,0,0,,		作为凶宅  租金极低
Dialogue: 0,0:03:58.40,0:04:02.02,DefaultSingle-S,,0,0,0,,		又有人的气息  能缓和恐怖感
Dialogue: 0,0:04:02.20,0:04:04.62,DefaultSingle-S,,0,0,0,,		合租房  简直完美
Dialogue: 0,0:04:04.98,0:04:06.80,DefaultSingle-S,,0,0,0,,		这里是公共空间
Dialogue: 0,0:04:07.27,0:04:10.46,DefaultSingle-S,,0,0,0,,		可以看电视  休闲  聚会
Dialogue: 0,0:04:10.46,0:04:12.14,DefaultSingle-S,,0,0,0,,		想怎么用都可以
Dialogue: 0,0:04:12.46,0:04:14.98,DefaultSingle-S,,0,0,0,,		他们好像经常办派对
Dialogue: 0,0:04:16.03,0:04:18.25,DefaultSingle-S,,0,0,0,,		你看  还贴了照片
Dialogue: 0,0:04:18.25,0:04:19.19,DefaultSingle-S,,0,0,0,,		派对爱好者
Dialogue: 0,0:04:19.78,0:04:23.61,DefaultSingle-S,,0,0,0,,		住合租房的话  处理人际关系就会很麻烦啊
Dialogue: 0,0:04:23.99,0:04:26.11,DefaultSingle-S,,0,0,0,,		毕竟是和陌生人一起住
Dialogue: 0,0:04:26.11,0:04:28.80,DefaultSingle-S,,0,0,0,,		需要顾虑他人  感觉会积攒压力啊
Dialogue: 0,0:04:28.95,0:04:33.93,DefaultSingle-S,,0,0,0,,		会不会住得不舒服  最后还是搬到普通公寓啊
Dialogue: 0,0:04:34.33,0:04:37.15,DefaultSingle-S,,0,0,0,,		要是能交个朋友应该会好一点
Dialogue: 0,0:04:37.26,0:04:38.72,DefaultSingle-S,,0,0,0,,		可哪有这么简单啊
Dialogue: 0,0:04:38.88,0:04:40.76,DefaultSingle-S,,0,0,0,,		咦  你是新住户吗
Dialogue: 0,0:04:47.60,0:04:50.60,DefaultSingle-S,,0,0,0,,		你好  我是101室的犯林
Dialogue: 0,0:04:50.60,0:04:51.77,DefaultSingle-S,,0,0,0,,		多指教
Dialogue: 0,0:04:52.00,0:04:53.18,DefaultSingle-S,,0,0,0,,		这  这个人…
Dialogue: 0,0:04:53.56,0:04:56.48,DefaultSingle-S,,0,0,0,,		他乍看和我完全不同…
Dialogue: 0,0:04:56.57,0:04:58.16,DefaultSingle-S,,0,0,0,,		我叫犯泽  请多指教
Dialogue: 0,0:04:59.18,0:05:00.78,DefaultSingle-S,,0,0,0,,		但又感觉和我很相似
Dialogue: 0,0:05:01.01,0:05:01.91,DefaultSingle-S,,0,0,0,,		我就租这里了
Dialogue: 0,0:05:01.91,0:05:03.85,DefaultSingle-S,,0,0,0,,		要签约是吧
Dialogue: 0,0:05:03.85,0:05:04.44,DefaultSingle-S,,0,0,0,,		是的
Dialogue: 0,0:05:04.44,0:05:05.59,DefaultSingle-S,,0,0,0,,		对了
Dialogue: 0,0:05:05.95,0:05:09.08,DefaultSingle-S,,0,0,0,,		这栋房子的房东在这个公共区域的中央
Dialogue: 0,0:05:09.08,0:05:11.53,DefaultSingle-S,,0,0,0,,		被人用狸摆件压死了
Dialogue: 0,0:05:11.53,0:05:13.33,DefaultSingle-S,,0,0,0,,		不用说明了
Dialogue: 0,0:05:13.52,0:05:16.42,DefaultSingle-S,,0,0,0,,		喂  给我闭嘴  老头子  多坏心情
Dialogue: 0,0:05:16.42,0:05:17.08,DefaultSingle-S,,0,0,0,,		犯林
Dialogue: 0,0:05:17.08,0:05:19.56,DefaultSingle-S,,0,0,0,,		我  我有义务说明的
Dialogue: 0,0:05:19.56,0:05:22.13,DefaultSingle-S,,0,0,0,,		少啰嗦  信不信杀了你
Dialogue: 0,0:05:22.37,0:05:24.72,DefaultSingle-S,,0,0,0,,		总  总之我去准备合同
Dialogue: 0,0:05:24.72,0:05:26.32,DefaultSingle-S,,0,0,0,,		你等会来一趟店里
Dialogue: 0,0:05:27.57,0:05:29.79,DefaultSingle-S,,0,0,0,,		好想杀了那老头子
Dialogue: 0,0:05:29.79,0:05:32.06,DefaultSingle-S,,0,0,0,,		我  我也想过要杀了他
Dialogue: 0,0:05:32.29,0:05:33.81,DefaultSingle-S,,0,0,0,,		你也是啊  我们真投缘
Dialogue: 0,0:05:33.81,0:05:34.29,DefaultSingle-S,,0,0,0,,		是啊
Dialogue: 0,0:05:34.38,0:05:36.46,DefaultSingle-S,,0,0,0,,		今晚睡我房间吧  我们好好相处
Dialogue: 0,0:05:36.46,0:05:37.02,DefaultSingle-S,,0,0,0,,		好
Dialogue: 0,0:05:37.47,0:05:40.04,DefaultSingle-S,,0,0,0,,		第一个能交心的朋友
Dialogue: 0,0:05:40.21,0:05:42.09,DefaultSingle-S,,0,0,0,,		我能在这座城市生活下去
Dialogue: 0,0:05:42.37,0:05:44.64,DefaultSingle-S,,0,0,0,,		直到杀死那个人
Dialogue: 0,0:05:51.02,0:05:57.03,DefaultSingle-S,,0,0,0,,		最近的小鬼太不尊敬年长者了
Dialogue: 0,0:05:58.36,0:06:02.07,DefaultSingle-S,,0,0,0,,		看我偷偷给他的中介费翻个倍
Dialogue: 0,0:06:02.34,0:06:04.55,DefaultSingle-S,,0,0,0,,		那乡巴佬发现不了的
Dialogue: 0,0:06:05.00,0:06:08.80,DefaultSingle-S,,0,0,0,,		那个派对RAP狂就给他来个五倍续约费
Dialogue: 0,0:06:09.16,0:06:10.76,DefaultSingle-S,,0,0,0,,		烦死了
Dialogue: 0,0:06:11.25,0:06:12.22,DefaultSingle-S,,0,0,0,,		你在做什么
Dialogue: 0,0:06:12.46,0:06:13.26,DefaultSingle-S,,0,0,0,,		别想逃
Dialogue: 0,0:06:13.39,0:06:15.17,DefaultSingle-S,,0,0,0,,		就用这个脚力增强鞋
Dialogue: 0,0:06:15.17,0:06:16.66,DefaultSingle-S,,0,0,0,,		和便当型传真机
Dialogue: 0,0:06:21.80,0:06:23.90,DefaultSingle-S,,0,0,0,,		做了个好梦
Dialogue: 0,0:06:24.24,0:06:28.20,DefaultSingle-S,,0,0,0,,		梦到把那个气人的中介老头捅成了马蜂窝
Dialogue: 0,0:06:29.02,0:06:31.02,DefaultSingle-S,,0,0,0,,		犯林是不是在公共区啊
Dialogue: 0,0:06:31.02,0:06:31.99,DefaultSingle-S,,0,0,0,,		播报一则新闻
Dialogue: 0,0:06:32.27,0:06:32.99,DefaultSingle-S,,0,0,0,,		昨天晚间
Dialogue: 0,0:06:33.11,0:06:37.86,DefaultSingle-S,,0,0,0,,		在米花町做房屋中介的男性  林和夫  64岁
Dialogue: 0,0:06:37.86,0:06:39.50,DefaultSingle-S,,0,0,0,,		惨遭杀害
Dialogue: 0,0:06:40.52,0:06:44.39,DefaultSingle-S,,0,0,0,,		犯人名叫犯林务  22岁  被当场抓获
Dialogue: 0,0:06:44.56,0:06:47.56,DefaultSingle-S,,0,0,0,,		据碰巧在场的小学生目击证人所说
Dialogue: 0,0:06:47.56,0:06:48.29,DefaultSingle-S,,0,0,0,,		能迅速破案…
Dialogue: 0,0:06:49.60,0:06:51.58,DefaultSingle-S,,0,0,0,,		住处定下来了
Dialogue: 0,0:08:32.13,0:08:33.70,DefaultSingle-S,,0,0,0,,		昨日友人就是今日犯人
Dialogue: 0,0:08:33.80,0:08:35.64,DefaultSingle-S,,0,0,0,,		去者不追  来者必杀
Dialogue: 0,0:08:35.64,0:08:36.82,DefaultSingle-S,,0,0,0,,		这就是米花町的规矩
Dialogue: 0,0:08:36.82,0:08:39.25,DefaultSingle-S,,0,0,0,,		我也不能输给犯林
Dialogue: 0,0:08:39.25,0:08:41.91,DefaultSingle-S,,0,0,0,,		我要让米花町的居民  让观众们
Dialogue: 0,0:08:41.91,0:08:43.77,DefaultSingle-S,,0,0,0,,		知道我是个能成事的人
Dialogue: 0,0:08:43.77,0:08:47.31,DefaultSingle-S,,0,0,0,,		为了成为能独当一面的犯人  前往市政府
Dialogue: 0,0:08:47.44,0:08:50.34,DefaultSingle-S,,0,0,0,,		犯人之道的第一步从变更住址开始
Dialogue: 0,0:08:50.34,0:08:52.28,DefaultSingle-S,,0,0,0,,		下集的标题是「蚂蚁地狱」
Dialogue: 0,0:08:52.28,0:08:53.36,DefaultSingle-S,,0,0,0,,		你问是什么意思？
Dialogue: 0,0:08:53.36,0:08:54.36,DefaultSingle-S,,0,0,0,,		不要多想
Dialogue: 0,0:08:54.36,0:08:56.02,DefaultSingle-S,,0,0,0,,		不要用看的  要去感受
Dialogue: 0,0:08:56.02,0:08:57.61,DefaultSingle-S,,0,0,0,,		不过下集也一定要看
Dialogue: 0,0:08:57.61,0:08:59.54,DefaultSingle-S,,0,0,0,,		请多支持  请多支持
Dialogue: 0,0:02:43.47,0:02:44.68,Note,,0,0,0,,		注：这两个路人是TWO MIX组合，高山南本音出演
Dialogue: 0,0:01:30.37,0:01:33.37,DefaultSingle-S,,0,0,0,,

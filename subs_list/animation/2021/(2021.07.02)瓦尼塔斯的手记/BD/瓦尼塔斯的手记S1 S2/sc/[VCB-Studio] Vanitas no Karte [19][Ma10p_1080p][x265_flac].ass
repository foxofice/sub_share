Dialogue: 0,0:00:02.02,0:00:05.65,Default,,0,0,0,,别以为没有你 我会幸福
Dialogue: 0,0:00:05.65,0:00:07.78,Default,,0,0,0,,不要逃离我身边
Dialogue: 0,0:00:08.48,0:00:09.78,Default,,0,0,0,,拜托你
Dialogue: 0,0:00:11.10,0:00:14.33,Default,,0,0,0,,拜托你 克萝伊
Dialogue: 0,0:00:18.03,0:00:20.87,Default,,0,0,0,,不要让我孤单一人
Dialogue: 0,0:00:47.07,0:00:51.57,Default,,0,0,0,,祸名「冰雪剧场(Millie)」
Dialogue: 0,0:00:58.45,0:01:00.83,Default,,0,0,0,,被这个祸名侵害的人
Dialogue: 0,0:01:00.83,0:01:03.93,Default,,0,0,0,,会被关在根据自己的记忆
Dialogue: 0,0:01:03.95,0:01:07.05,Default,,0,0,0,,所创造出的白银封闭空间中
Dialogue: 0,0:01:07.50,0:01:10.24,Default,,0,0,0,,并且会因为永无止境
Dialogue: 0,0:01:10.26,0:01:11.55,Default,,0,0,0,,不断重复上演的剧目
Dialogue: 0,0:01:11.55,0:01:14.85,Default,,0,0,0,,而使内心一点一点慢慢崩坏
Dialogue: 0,0:01:15.89,0:01:18.68,Default,,0,0,0,,这个祸名最棘手的地方在于
Dialogue: 0,0:01:19.48,0:01:24.61,Default,,0,0,0,,只是透过逆演算引导 也无法治癒
Dialogue: 0,0:01:25.11,0:01:29.03,Default,,0,0,0,,若不是持咒者自己否定闭锁空间
Dialogue: 0,0:01:29.03,0:01:31.49,Default,,0,0,0,,就无法彻底断开连结
Dialogue: 0,0:01:31.49,0:01:35.12,Default,,0,0,0,,整个空间会连同持咒者一起消逝
Dialogue: 0,0:01:36.43,0:01:37.99,Default,,0,0,0,,克萝伊·达普谢
Dialogue: 0,0:01:38.00,0:01:40.50,Default,,0,0,0,,你是要就这样和这个世界一起消失
Dialogue: 0,0:01:40.50,0:01:42.33,Default,,0,0,0,,还是要苟延残喘地活下去
Dialogue: 0,0:01:42.33,0:01:43.87,Default,,0,0,0,,随你自己选
Dialogue: 0,0:01:45.00,0:01:49.09,Default,,0,0,0,,就算活下来  你的名誉也不会恢复
Dialogue: 0,0:01:49.09,0:01:51.93,Default,,0,0,0,,教会绝对不会承认过去的事实
Dialogue: 0,0:01:51.93,0:01:54.59,Default,,0,0,0,,你还是会被当成野兽 持续遭到追杀
Dialogue: 0,0:01:54.60,0:01:55.43,Default,,0,0,0,,等等
Dialogue: 0,0:01:55.43,0:01:57.22,Default,,0,0,0,,无论哪一边都是地狱
Dialogue: 0,0:01:57.22,0:01:59.60,Default,,0,0,0,,就算这样 你还是要选
Dialogue: 0,0:02:04.00,0:02:05.94,Default,,0,0,0,,强=杰克…
Dialogue: 0,0:02:10.82,0:02:14.82,Default,,0,0,0,,我…我…
Dialogue: 0,0:02:24.46,0:02:26.33,Default,,0,0,0,,贞德 去吧
Dialogue: 0,0:02:28.00,0:02:30.67,Default,,0,0,0,,要是当时能够重新来过
Dialogue: 0,0:02:33.26,0:02:35.30,Default,,0,0,0,,为了拯救你
Dialogue: 0,0:02:35.33,0:02:37.84,Default,,0,0,0,,我能毫不犹豫伸出手的话
Dialogue: 0,0:02:48.20,0:02:50.88,Default,,0,0,0,,♪说着不要松懈♪
Dialogue: 0,0:02:50.89,0:02:54.88,Default,,0,0,0,,♪或者不要溶解♪
Dialogue: 0,0:02:54.89,0:02:59.14,Default,,0,0,0,,♪从身处的世界向抵抗的未来♪
Dialogue: 0,0:02:59.14,0:03:03.81,Default,,0,0,0,,♪在迎面而来的风中绽放 Bloom♪
Dialogue: 0,0:03:03.81,0:03:08.36,Default,,0,0,0,,♪那瞳孔声音震颤♪
Dialogue: 0,0:03:08.36,0:03:10.05,Default,,0,0,0,,♪What's the right?♪
Dialogue: 0,0:03:10.05,0:03:13.13,Default,,0,0,0,,♪呼喊的日子 Blurry♪
Dialogue: 0,0:03:13.13,0:03:18.03,Default,,0,0,0,,♪即使如此仍想堆叠想像♪
Dialogue: 0,0:03:18.04,0:03:23.48,Default,,0,0,0,,♪向希望侧耳倾听♪
Dialogue: 0,0:03:25.51,0:03:33.92,Default,,0,0,0,,♪比起祈求 比起发誓♪
Dialogue: 0,0:03:33.92,0:03:41.86,Default,,0,0,0,,♪究竟有什么是更珍爱的呢♪
Dialogue: 0,0:03:41.86,0:03:51.60,Default,,0,0,0,,♪一定会多呼喊那名字一次♪
Dialogue: 0,0:03:51.60,0:04:01.95,Default,,0,0,0,,♪或许就只是这样的事♪
Dialogue: 0,0:04:01.95,0:04:04.91,Default,,0,0,0,,♪My story♪
Dialogue: 0,0:04:18.21,0:04:18.99,Default,,0,0,0,,罗兰
Dialogue: 0,0:04:19.55,0:04:24.41,Default,,0,0,0,,我接下来可能会让你的同伴受伤
Dialogue: 0,0:04:24.94,0:04:28.03,Default,,0,0,0,,你指的是阿斯托福吗
Dialogue: 0,0:04:30.77,0:04:32.38,Default,,0,0,0,,这样啊
Dialogue: 0,0:04:32.38,0:04:34.25,Default,,0,0,0,,那孩子在那个地方
Dialogue: 0,0:04:36.01,0:04:39.76,Default,,0,0,0,,阿斯托福的家人被吸血鬼杀害了
Dialogue: 0,0:04:41.72,0:04:42.93,Default,,0,0,0,,抱歉
Dialogue: 0,0:04:42.93,0:04:46.06,Default,,0,0,0,,我并不是要你别去和他战斗
Dialogue: 0,0:04:46.56,0:04:49.39,Default,,0,0,0,,只不过…是为什么呢
Dialogue: 0,0:04:49.40,0:04:52.69,Default,,0,0,0,,我希望你能知道这件事  诺亚
Dialogue: 0,0:04:54.27,0:04:57.82,Default,,0,0,0,,那孩子实在太过温柔了
Dialogue: 0,0:05:00.33,0:05:02.07,Default,,0,0,0,,给我消失
Dialogue: 0,0:05:02.07,0:05:04.83,Default,,0,0,0,,给我消失  吸血鬼
Dialogue: 0,0:05:08.35,0:05:10.50,Default,,0,0,0,,过度注射药物造成反作用了
Dialogue: 0,0:05:11.25,0:05:13.29,Default,,0,0,0,,请你停手吧  队长
Dialogue: 0,0:05:13.29,0:05:16.25,Default,,0,0,0,,再打下去 你的身体会撑不住的
Dialogue: 0,0:05:16.25,0:05:18.51,Default,,0,0,0,,完了 没办法完全躲开
Dialogue: 0,0:05:25.80,0:05:26.85,Default,,0,0,0,,怎么办
Dialogue: 0,0:05:26.85,0:05:27.81,Default,,0,0,0,,先暂时撤退…
Dialogue: 0,0:05:27.81,0:05:29.43,Default,,0,0,0,,别迷惘  诺亚
Dialogue: 0,0:05:29.44,0:05:32.12,Default,,0,0,0,,别去思考阿斯托福的憎恨
Dialogue: 0,0:05:32.15,0:05:33.86,Default,,0,0,0,,是否有其正当性
Dialogue: 0,0:05:33.86,0:05:35.40,Default,,0,0,0,,不管是人类还是吸血鬼
Dialogue: 0,0:05:35.40,0:05:38.02,Default,,0,0,0,,都是基于自己的正义在行动
Dialogue: 0,0:05:38.94,0:05:41.78,Default,,0,0,0,,某个人的正义 对另一个人来说是邪恶
Dialogue: 0,0:05:42.57,0:05:45.41,Default,,0,0,0,,所谓的「正确」就是「力量」
Dialogue: 0,0:05:45.41,0:05:47.39,Default,,0,0,0,,而它很容易转变成暴力
Dialogue: 0,0:05:47.42,0:05:50.00,Default,,0,0,0,,变成一种比恶意还棘手的武器
Dialogue: 0,0:05:51.50,0:05:54.54,Default,,0,0,0,,不要向外宣泄 把它留在心里
Dialogue: 0,0:05:54.54,0:05:56.21,Default,,0,0,0,,正义这种东西
Dialogue: 0,0:05:56.21,0:05:57.32,Default,,0,0,0,,只要当成是
Dialogue: 0,0:05:57.34,0:06:00.46,Default,,0,0,0,,照亮自己前进方向的灯火 就可以了
Dialogue: 0,0:06:07.34,0:06:09.97,Default,,0,0,0,,我是叫你不要想得太复杂
Dialogue: 0,0:06:10.39,0:06:12.23,Default,,0,0,0,,不是根据「正确与否」
Dialogue: 0,0:06:12.23,0:06:14.39,Default,,0,0,0,,而是根据「什么不能退让」来行动
Dialogue: 0,0:06:17.73,0:06:20.90,Default,,0,0,0,,至少你只要这么做 就可以了
Dialogue: 0,0:06:22.90,0:06:24.24,Default,,0,0,0,,我不退
Dialogue: 0,0:06:24.74,0:06:25.89,Default,,0,0,0,,绝对不退
Dialogue: 0,0:06:25.90,0:06:27.68,Default,,0,0,0,,爆炸吧
Dialogue: 0,0:06:41.13,0:06:43.42,Default,,0,0,0,,我想救克萝伊小姐和强=杰克
Dialogue: 0,0:06:43.92,0:06:46.47,Default,,0,0,0,,不管对手是谁 只有这点…
Dialogue: 0,0:06:47.30,0:06:48.30,Default,,0,0,0,,我绝不退让
Dialogue: 0,0:06:57.77,0:06:59.86,Default,,0,0,0,,太好了
Dialogue: 0,0:07:04.49,0:07:07.36,Default,,0,0,0,,少爷 阿斯托福少爷
Dialogue: 0,0:07:11.57,0:07:15.75,Default,,0,0,0,,我曾经想成为人类
Dialogue: 0,0:07:16.75,0:07:19.92,Default,,0,0,0,,因为爸爸是这么期望的
Dialogue: 0,0:07:21.38,0:07:24.97,Default,,0,0,0,,爸爸终其一生
Dialogue: 0,0:07:24.97,0:07:28.68,Default,,0,0,0,,都在研究让我变回人类的方法
Dialogue: 0,0:07:29.93,0:07:32.89,Default,,0,0,0,,这让我感到非常幸福
Dialogue: 0,0:07:32.89,0:07:36.64,Default,,0,0,0,,一切都是源于爸爸的爱
Dialogue: 0,0:07:38.31,0:07:41.11,Default,,0,0,0,,骗人 那不是真的
Dialogue: 0,0:07:41.11,0:07:43.78,Default,,0,0,0,,其实我一直都很寂寞
Dialogue: 0,0:07:44.65,0:07:47.03,Default,,0,0,0,,因为那也就代表
Dialogue: 0,0:07:47.03,0:07:51.78,Default,,0,0,0,,不是人类的我 并不是真正的我 对吧
Dialogue: 0,0:07:52.60,0:07:54.83,Default,,0,0,0,,装置已经到极限了
Dialogue: 0,0:07:54.83,0:07:56.71,Default,,0,0,0,,固定存在要解除了
Dialogue: 0,0:07:59.75,0:08:02.29,Default,,0,0,0,,演算来不及赶上
Dialogue: 0,0:08:02.71,0:08:05.09,Default,,0,0,0,,我好希望被认同
Dialogue: 0,0:08:05.09,0:08:07.43,Default,,0,0,0,,想作为爸爸的女儿被认同
Dialogue: 0,0:08:07.43,0:08:10.26,Default,,0,0,0,,想作为达普谢侯爵家的一员被认同
Dialogue: 0,0:08:10.26,0:08:12.10,Default,,0,0,0,,我希望真正的我能被认同
Dialogue: 0,0:08:17.61,0:08:19.06,Default,,0,0,0,,克萝伊
Dialogue: 0,0:08:19.44,0:08:24.44,Default,,0,0,0,,我希望能有人爱真正的我
Dialogue: 0,0:08:25.03,0:08:26.36,Default,,0,0,0,,你自己选
Dialogue: 0,0:08:38.14,0:08:39.25,Default,,0,0,0,,可恶
Dialogue: 0,0:08:39.25,0:08:42.21,Default,,0,0,0,,把力量借给我 苍月
Dialogue: 0,0:09:13.67,0:09:17.04,Default,,0,0,0,,就好像湛蓝的星空一样
Dialogue: 0,0:09:20.54,0:09:24.21,Default,,0,0,0,,原来如此 那就是你的真名吗
Dialogue: 0,0:09:25.71,0:09:30.01,Default,,0,0,0,,「雪花奏响者(Canorus)」
Dialogue: 0,0:09:50.47,0:09:51.43,Default,,0,0,0,,奇怪
Dialogue: 0,0:09:52.20,0:09:53.49,Default,,0,0,0,,不冷啊
Dialogue: 0,0:09:53.91,0:09:55.32,Default,,0,0,0,,是雪吗
Dialogue: 0,0:09:55.33,0:09:56.99,Default,,0,0,0,,不  不对
Dialogue: 0,0:09:56.99,0:09:58.24,Default,,0,0,0,,是花瓣
Dialogue: 0,0:10:02.04,0:10:05.17,Default,,0,0,0,,这样是结束了吗
Dialogue: 0,0:10:05.63,0:10:08.59,Default,,0,0,0,,你们两个都很努力呢
Dialogue: 0,0:10:36.99,0:10:38.78,Default,,0,0,0,,好痛 痛死了
Dialogue: 0,0:10:38.79,0:10:40.29,Default,,0,0,0,,比想像中还要痛3倍…
Dialogue: 0,0:10:40.29,0:10:42.20,Default,,0,0,0,,不  是痛15倍
Dialogue: 0,0:10:42.21,0:10:44.04,Default,,0,0,0,,老爷  手
Dialogue: 0,0:10:44.04,0:10:45.79,Default,,0,0,0,,找到你的手了
Dialogue: 0,0:10:46.08,0:10:47.79,Default,,0,0,0,,是说 你还好吗
Dialogue: 0,0:10:47.79,0:10:50.55,Default,,0,0,0,,忍不住了  我快哭出来了
Dialogue: 0,0:10:50.55,0:10:53.88,Default,,0,0,0,,这个 有办法能接回去吗
Dialogue: 0,0:10:54.88,0:10:59.39,Default,,0,0,0,,又不是烧成灰 应该没问题吧
Dialogue: 0,0:10:59.39,0:11:00.68,Default,,0,0,0,,我是不知道啦
Dialogue: 0,0:11:02.47,0:11:06.02,Default,,0,0,0,,竟然开了这么多星芒花
Dialogue: 0,0:11:06.02,0:11:07.15,Default,,0,0,0,,为什么
Dialogue: 0,0:11:07.15,0:11:08.69,Default,,0,0,0,,你不知道吗
Dialogue: 0,0:11:08.69,0:11:11.02,Default,,0,0,0,,常有人说 只要对世界式进行干涉
Dialogue: 0,0:11:11.02,0:11:13.99,Default,,0,0,0,,那附近就会开这种花
Dialogue: 0,0:11:13.99,0:11:15.82,Default,,0,0,0,,虽然不知道是不是真的
Dialogue: 0,0:11:17.98,0:11:20.40,Default,,0,0,0,,喂喂  不会吧
Dialogue: 0,0:11:24.58,0:11:27.00,Default,,0,0,0,,杀…杀掉…
Dialogue: 0,0:11:27.57,0:11:30.67,Default,,0,0,0,,我要杀掉吸血鬼…
Dialogue: 0,0:11:31.13,0:11:35.09,Default,,0,0,0,,我要杀掉…
Dialogue: 0,0:11:35.09,0:11:36.22,Default,,0,0,0,,阿斯托福
Dialogue: 0,0:12:15.29,0:12:19.13,Default,,0,0,0,,救命…救救我们
Dialogue: 0,0:12:19.14,0:12:20.59,Default,,0,0,0,,骑士大人
Dialogue: 0,0:12:22.54,0:12:27.60,Default,,0,0,0,,拜托你 请你救我妹妹
Dialogue: 0,0:12:28.99,0:12:32.36,Default,,0,0,0,,我会变成什么样子 都无所谓
Dialogue: 0,0:12:35.07,0:12:37.48,Default,,0,0,0,,都是我不好
Dialogue: 0,0:12:37.49,0:12:41.20,Default,,0,0,0,,全部都是我的错
Dialogue: 0,0:12:45.37,0:12:48.58,Default,,0,0,0,,已经结束了  阿斯托福
Dialogue: 0,0:12:49.95,0:12:51.37,Default,,0,0,0,,一起回去吧
Dialogue: 0,0:12:53.71,0:12:55.59,Default,,0,0,0,,队长
Dialogue: 0,0:12:55.59,0:12:57.88,Default,,0,0,0,,阿斯托福少爷
Dialogue: 0,0:13:09.85,0:13:11.15,Default,,0,0,0,,克萝伊
Dialogue: 0,0:13:11.15,0:13:12.61,Default,,0,0,0,,你还好吗
Dialogue: 0,0:13:12.61,0:13:13.77,Default,,0,0,0,,克萝伊
Dialogue: 0,0:13:13.77,0:13:16.15,Default,,0,0,0,,身体有没有哪里不舒服
Dialogue: 0,0:13:17.82,0:13:19.03,Default,,0,0,0,,克萝伊
Dialogue: 0,0:13:23.16,0:13:24.84,Default,,0,0,0,,你…你这个笨蛋
Dialogue: 0,0:13:24.84,0:13:27.70,Default,,0,0,0,,没经过我的同意 就搞得自己伤痕累累
Dialogue: 0,0:13:28.24,0:13:30.83,Default,,0,0,0,,要是死掉了怎么办
Dialogue: 0,0:13:31.66,0:13:33.67,Default,,0,0,0,,那是我要说的话
Dialogue: 0,0:13:33.67,0:13:36.67,Default,,0,0,0,,你竟然瞒着我 擅自决定一个人赴死
Dialogue: 0,0:13:36.67,0:13:39.57,Default,,0,0,0,,有没有想过 被抛下的我是什么心情
Dialogue: 0,0:13:39.57,0:13:41.09,Default,,0,0,0,,吵死了吵死了
Dialogue: 0,0:13:41.09,0:13:43.47,Default,,0,0,0,,不准你跟我顶嘴
Dialogue: 0,0:13:43.47,0:13:45.22,Default,,0,0,0,,我最讨厌强=杰克了
Dialogue: 0,0:13:46.30,0:13:47.76,Default,,0,0,0,,笨蛋 笨蛋
Dialogue: 0,0:13:47.76,0:13:49.06,Default,,0,0,0,,你这笨蛋
Dialogue: 0,0:14:37.66,0:14:38.77,Default,,0,0,0,,克萝伊
Dialogue: 0,0:14:39.02,0:14:40.90,Default,,0,0,0,,我说过不哭的
Dialogue: 0,0:14:40.90,0:14:43.45,Default,,0,0,0,,在我决定要向恶梦报仇的时候
Dialogue: 0,0:14:44.14,0:14:46.41,Default,,0,0,0,,我就下定决心 不再哭泣了
Dialogue: 0,0:14:46.41,0:14:47.62,Default,,0,0,0,,可是…
Dialogue: 0,0:14:47.95,0:14:49.91,Default,,0,0,0,,我就像个笨蛋一样 对吧
Dialogue: 0,0:14:49.91,0:14:53.29,Default,,0,0,0,,和贞德一起仰望天空的那一天
Dialogue: 0,0:14:53.29,0:14:54.79,Default,,0,0,0,,我是真心觉得
Dialogue: 0,0:14:54.79,0:14:57.75,Default,,0,0,0,,如果要死的话 那个当下是最好的时机
Dialogue: 0,0:14:58.71,0:15:00.21,Default,,0,0,0,,然而现在
Dialogue: 0,0:15:02.92,0:15:08.56,Default,,0,0,0,,我却希望可以继续活下去
Dialogue: 0,0:15:11.31,0:15:13.30,Default,,0,0,0,,很狡猾 对吧
Dialogue: 0,0:15:13.30,0:15:14.85,Default,,0,0,0,,很过份 对吧
Dialogue: 0,0:15:14.85,0:15:16.48,Default,,0,0,0,,我这个人…
Dialogue: 0,0:15:19.61,0:15:20.98,Default,,0,0,0,,没关系
Dialogue: 0,0:15:20.98,0:15:23.69,Default,,0,0,0,,狡猾一点有什么不好
Dialogue: 0,0:15:24.91,0:15:28.11,Default,,0,0,0,,我们一起活下去吧 克萝伊
Dialogue: 0,0:15:29.32,0:15:35.46,Default,,0,0,0,,只要有你在  我就别无所求
Dialogue: 0,0:15:44.05,0:15:45.47,Default,,0,0,0,,瓦尼塔斯
Dialogue: 0,0:15:45.47,0:15:46.63,Default,,0,0,0,,瓦尼塔斯呢
Dialogue: 0,0:15:59.45,0:16:01.73,Default,,0,0,0,,扩散了不少啊
Dialogue: 0,0:16:11.60,0:16:13.26,Default,,0,0,0,,好冷
Dialogue: 0,0:16:15.33,0:16:16.58,Default,,0,0,0,,瓦尼塔斯
Dialogue: 0,0:16:16.58,0:16:17.62,Default,,0,0,0,,贞德
Dialogue: 0,0:16:18.00,0:16:19.12,Default,,0,0,0,,你没事啊…
Dialogue: 0,0:16:20.76,0:16:22.38,Default,,0,0,0,,谢谢你  瓦尼塔斯
Dialogue: 0,0:16:22.38,0:16:23.67,Default,,0,0,0,,谢谢你
Dialogue: 0,0:16:24.00,0:16:25.34,Default,,0,0,0,,克萝伊还活着
Dialogue: 0,0:16:25.34,0:16:27.05,Default,,0,0,0,,她真的得救了
Dialogue: 0,0:16:27.05,0:16:28.42,Default,,0,0,0,,谢谢你
Dialogue: 0,0:16:28.43,0:16:29.55,Default,,0,0,0,,好痛痛痛…
Dialogue: 0,0:16:29.55,0:16:31.64,Default,,0,0,0,,你这么开心 没关系吗
Dialogue: 0,0:16:32.04,0:16:34.43,Default,,0,0,0,,虽然我不知道鲁思文大臣在打什么算盘
Dialogue: 0,0:16:34.43,0:16:35.98,Default,,0,0,0,,但我不认为元老院
Dialogue: 0,0:16:36.00,0:16:38.52,Default,,0,0,0,,会就这样放过克萝伊·达普谢
Dialogue: 0,0:16:38.52,0:16:41.48,Default,,0,0,0,,说不定连你都免不了受罚
Dialogue: 0,0:16:42.18,0:16:44.23,Default,,0,0,0,,那种事我当然知道
Dialogue: 0,0:16:44.23,0:16:45.73,Default,,0,0,0,,但我就是觉得开心
Dialogue: 0,0:16:45.74,0:16:47.19,Default,,0,0,0,,开心得不得了
Dialogue: 0,0:16:47.19,0:16:47.90,Default,,0,0,0,,是
Dialogue: 0,0:16:47.90,0:16:49.36,Default,,0,0,0,,有什么办法
Dialogue: 0,0:16:49.36,0:16:50.82,Default,,0,0,0,,不好意思
Dialogue: 0,0:16:50.82,0:16:54.03,Default,,0,0,0,,瓦尼塔斯  幸好有你
Dialogue: 0,0:16:54.58,0:16:58.58,Default,,0,0,0,,因为有你在 我才…
Dialogue: 0,0:17:16.01,0:17:18.81,Default,,0,0,0,,贞德 怎么这么突然…
Dialogue: 0,0:17:39.26,0:17:43.21,Default,,0,0,0,,我…我是说过要把我的血给你
Dialogue: 0,0:17:43.67,0:17:47.71,Default,,0,0,0,,但你好歹也考虑一下时间和场合吧
Dialogue: 0,0:18:07.27,0:18:09.78,Default,,0,0,0,,答应我  瓦尼塔斯
Dialogue: 0,0:18:11.11,0:18:16.57,Default,,0,0,0,,要是我不再是我的那天真的来临
Dialogue: 0,0:18:23.71,0:18:28.46,Default,,0,0,0,,到了那时 你一定要杀了我
Dialogue: 0,0:18:39.22,0:18:40.56,Default,,0,0,0,,贞德
Dialogue: 0,0:19:04.62,0:19:06.00,Default,,0,0,0,,听好了
Dialogue: 0,0:19:07.16,0:19:09.88,Default,,0,0,0,,人都是孤独的
Dialogue: 0,0:19:09.88,0:19:14.55,Default,,0,0,0,,无论是人类 还是吸血鬼都一样
Dialogue: 0,0:19:14.93,0:19:18.93,Default,,0,0,0,,要完全理解另一个人 是不可能的
Dialogue: 0,0:19:18.93,0:19:22.51,Default,,0,0,0,,大部份的人 甚至终其一生
Dialogue: 0,0:19:22.53,0:19:24.48,Default,,0,0,0,,都不了解自己
Dialogue: 0,0:19:25.55,0:19:28.94,Default,,0,0,0,,但正因如此
Dialogue: 0,0:19:28.94,0:19:33.03,Default,,0,0,0,,人会互相倚靠 分享温暖
Dialogue: 0,0:19:36.90,0:19:41.70,Default,,0,0,0,,要是有一天 在我不在之后
Dialogue: 0,0:19:42.37,0:19:46.87,Default,,0,0,0,,能有个人像这样倚靠你就好了
Dialogue: 0,0:19:48.01,0:19:51.92,Default,,0,0,0,,不   一定会出现的
Dialogue: 0,0:19:53.17,0:19:57.55,Default,,0,0,0,,只要你不封闭自己的内心
Dialogue: 0,0:20:02.76,0:20:05.53,Default,,0,0,0,,这么一来 即使只有自己一个人
Dialogue: 0,0:20:05.56,0:20:07.69,Default,,0,0,0,,你也一定不会感到孤独
Dialogue: 0,0:20:08.20,0:20:13.11,Default,,0,0,0,,就像我有你们在身边一样
Dialogue: 0,0:20:13.90,0:20:15.11,Default,,0,0,0,,瓦尼塔斯
Dialogue: 0,0:20:16.88,0:20:19.70,Default,,0,0,0,,那个  你没事吧
Dialogue: 0,0:20:23.40,0:20:30.96,Default,,0,0,0,,怕冷的你 会遇见某个带给你温暖的人
Dialogue: 0,0:20:36.84,0:20:38.67,Default,,0,0,0,,你确定吗
Dialogue: 0,0:20:38.68,0:20:39.97,Default,,0,0,0,,确定
Dialogue: 0,0:20:39.97,0:20:41.88,Default,,0,0,0,,我一直希望拥有
Dialogue: 0,0:20:41.90,0:20:44.64,Default,,0,0,0,,可以保护克萝伊的力量
Dialogue: 0,0:20:45.26,0:20:46.60,Default,,0,0,0,,但是
Dialogue: 0,0:20:46.60,0:20:50.19,Default,,0,0,0,,如果就结果来说 那会伤害克萝伊的话
Dialogue: 0,0:20:50.19,0:20:51.98,Default,,0,0,0,,那我就不再需要它了
Dialogue: 0,0:20:52.94,0:20:56.23,Default,,0,0,0,,我要靠真正的自己
Dialogue: 0,0:20:56.24,0:20:58.45,Default,,0,0,0,,靠真正的强＝杰克·夏斯泰
Dialogue: 0,0:20:58.45,0:21:00.53,Default,,0,0,0,,来保护克萝伊
Dialogue: 0,0:21:09.71,0:21:11.04,Default,,0,0,0,,我明白了
Dialogue: 0,0:21:20.57,0:21:24.35,Default,,0,0,0,,原来如此  这个真名很适合你
Dialogue: 0,0:21:27.87,0:21:32.90,Default,,0,0,0,,「终雪相倚者(Aprix)」
Dialogue: 0,0:21:38.70,0:21:43.86,Default,,0,0,0,,就这样  热沃当野兽消失了
Dialogue: 0,0:21:45.62,0:21:47.62,Default,,0,0,0,,被拯救的人
Dialogue: 0,0:21:47.62,0:21:49.45,Default,,0,0,0,,以及没能获得救赎的人
Dialogue: 0,0:21:49.98,0:21:51.37,Default,,0,0,0,,就是那个
Dialogue: 0,0:21:52.03,0:21:55.46,Default,,0,0,0,,都各自留下了伤痕
Dialogue: 0,0:22:06.24,0:22:10.86,Default,,0,0,0,,♪在无意中察觉♪
Dialogue: 0,0:22:10.86,0:22:15.69,Default,,0,0,0,,♪彷佛自己的意思 实际却是既有的事物♪
Dialogue: 0,0:22:15.69,0:22:20.43,Default,,0,0,0,,♪不知道目的地在哪里 就这么继续前行♪
Dialogue: 0,0:22:20.43,0:22:25.14,Default,,0,0,0,,♪走在这铺垫好的无意识之上♪
Dialogue: 0,0:22:25.80,0:22:29.92,Default,,0,0,0,,♪第六感封闭中♪
Dialogue: 0,0:22:29.92,0:22:35.19,Default,,0,0,0,,♪任谁都会想说谎♪
Dialogue: 0,0:22:35.19,0:22:38.70,Default,,0,0,0,,♪误解的交叉点♪
Dialogue: 0,0:22:38.70,0:22:43.04,Default,,0,0,0,,♪什么时候开始变成这样的呢♪
Dialogue: 0,0:22:43.42,0:22:45.78,Default,,0,0,0,,♪生锈的我们交错重叠♪
Dialogue: 0,0:22:45.78,0:22:52.87,Default,,0,0,0,,♪纠缠的丝线前方究竟有着什么？♪
Dialogue: 0,0:22:52.87,0:22:55.21,Default,,0,0,0,,♪颤动污浊的空气♪
Dialogue: 0,0:22:55.21,0:22:59.25,Default,,0,0,0,,♪开始呼吸的我们不明白规则♪
Dialogue: 0,0:22:59.25,0:23:02.26,Default,,0,0,0,,♪就这么持续扣下板机♪
Dialogue: 0,0:23:02.26,0:23:04.67,Default,,0,0,0,,♪两个烟火交错重叠♪
Dialogue: 0,0:23:04.68,0:23:07.38,Default,,0,0,0,,♪连系着迸散的我们的丝线♪
Dialogue: 0,0:23:07.39,0:23:11.60,Default,,0,0,0,,♪究竟在什么地方？♪ 
Dialogue: 0,0:23:11.60,0:23:14.06,Default,,0,0,0,,♪颤动污浊的空气♪ 
Dialogue: 0,0:23:14.06,0:23:18.23,Default,,0,0,0,,♪开始呼吸的我们不明白规则♪
Dialogue: 0,0:23:18.23,0:23:23.61,Default,,0,0,0,,♪就这么持续扣下板机♪
Dialogue: 0,0:23:27.49,0:23:32.95,Default,,0,0,0,,♪相信着救赎的日子♪
Dialogue: 0,0:21:59.79,0:22:05.01,Default,,0,0,0,,(雪花)
Dialogue: 0,0:23:35.43,0:23:40.07,Default,,0,0,0,,(不治之症)

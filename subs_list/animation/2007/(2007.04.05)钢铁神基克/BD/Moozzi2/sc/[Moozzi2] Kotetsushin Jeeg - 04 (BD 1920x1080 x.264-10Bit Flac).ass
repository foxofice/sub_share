Dialogue: 0,0:00:08.48,0:00:10.22,*Default,NTP,0,0,0,,喂 到底怎么回事啊
Dialogue: 0,0:00:10.22,0:00:13.00,*Default,NTP,0,0,0,,机体被非常强劲的力量冲击着
Dialogue: 0,0:00:13.00,0:00:14.66,*Default,NTP,0,0,0,,无法控制
Dialogue: 0,0:00:17.94,0:00:19.61,*Default,NTP,0,0,0,,可恶 这究竟是
Dialogue: 0,0:00:19.74,0:00:22.18,*Default,NTP,0,0,0,,不行
Dialogue: 0,0:00:23.19,0:00:25.08,*Default,NTP,0,0,0,,靠太近了 快分开
Dialogue: 0,0:00:28.97,0:00:30.77,*Default,NTP,0,0,0,,笨蛋啊
Dialogue: 0,0:00:36.97,0:00:38.24,*Default,NTP,0,0,0,,可恶
Dialogue: 0,0:00:38.24,0:00:39.98,*Default,NTP,0,0,0,,那是什么啊
Dialogue: 0,0:00:39.98,0:00:43.56,*Default,NTP,0,0,0,,天空 天空正在闭合呢
Dialogue: 0,0:00:45.15,0:00:46.78,*Default,NTP,0,0,0,,看下面 是自卫队的基地
Dialogue: 0,0:00:46.78,0:00:49.64,*Default,NTP,0,0,0,,可恶 这里也被攻击得很惨啊
Dialogue: 0,0:00:49.64,0:00:52.17,*Default,NTP,0,0,0,,这样就算想降落都做不到啊
Dialogue: 0,0:00:52.17,0:00:53.89,*Default,NTP,0,0,0,,继续被冲击下去的话
Dialogue: 0,0:00:53.89,0:00:56.56,*Default,NTP,0,0,0,,迟早会被劈到的
Dialogue: 0,0:00:59.60,0:01:01.25,*Default,NTP,0,0,0,,那么事情就简单了
Dialogue: 0,0:01:01.25,0:01:03.61,*Default,NTP,0,0,0,,碰碰运气 赌上一回吧
Dialogue: 0,0:01:03.61,0:01:05.19,*Default,NTP,0,0,0,,看来也只能这样了
Dialogue: 0,0:01:05.19,0:01:06.78,*Default,NTP,0,0,0,,好吧 走了
Dialogue: 0,0:01:06.78,0:01:08.32,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:01:34.53,0:01:42.32,*Default,NTP,0,0,0,,OP:STORMBRINGER\NBy:JAM Project
Dialogue: 0,0:01:44.82,0:01:47.63,*Default,NTP,0,0,0,,変幻自在 天魔外道
Dialogue: 0,0:01:47.63,0:01:50.10,*Default,NTP,0,0,0,,闇の気配が迫る
Dialogue: 0,0:01:50.10,0:01:52.92,*Default,NTP,0,0,0,,問答無用 情け無用
Dialogue: 0,0:01:52.92,0:01:55.72,*Default,NTP,0,0,0,,一気にけりを着けろ
Dialogue: 0,0:01:55.72,0:01:58.40,*Default,NTP,0,0,0,,奇跡のPower
Dialogue: 0,0:01:58.40,0:02:00.60,*Default,NTP,0,0,0,,怒りのSoul
Dialogue: 0,0:02:00.60,0:02:06.06,*Default,NTP,0,0,0,,WOWOW WOWOW
Dialogue: 0,0:02:06.38,0:02:09.00,*Default,NTP,0,0,0,,嵐とともに
Dialogue: 0,0:02:09.00,0:02:11.36,*Default,NTP,0,0,0,,雷鳴の中
Dialogue: 0,0:02:11.36,0:02:12.66,*Default,NTP,0,0,0,,変われ!
Dialogue: 0,0:02:12.66,0:02:16.08,*Default,NTP,0,0,0,,神になれ!
Dialogue: 0,0:02:16.08,0:02:17.61,*Default,NTP,0,0,0,,叩きつけろ!
Dialogue: 0,0:02:17.61,0:02:18.96,*Default,NTP,0,0,0,,その拳を
Dialogue: 0,0:02:18.96,0:02:20.31,*Default,NTP,0,0,0,,打つ砕け!
Dialogue: 0,0:02:20.31,0:02:22.29,*Default,NTP,0,0,0,,悪の野望
Dialogue: 0,0:02:22.29,0:02:27.23,*Default,NTP,0,0,0,,暗黒の雲を吹き祓え!!
Dialogue: 0,0:02:27.23,0:02:28.25,*Default,NTP,0,0,0,,吠えろ!
Dialogue: 0,0:02:28.25,0:02:29.60,*Default,NTP,0,0,0,,未来の空へ
Dialogue: 0,0:02:29.60,0:02:30.87,*Default,NTP,0,0,0,,限りない
Dialogue: 0,0:02:30.87,0:02:32.90,*Default,NTP,0,0,0,,夢をのせて
Dialogue: 0,0:02:32.90,0:02:37.52,*Default,NTP,0,0,0,,荒れ果てた世界に希望を
Dialogue: 0,0:02:37.52,0:02:40.52,*Default,NTP,0,0,0,,古の神の技に
Dialogue: 0,0:02:40.52,0:02:42.99,*Default,NTP,0,0,0,,熱い勇気を込めて!
Dialogue: 0,0:02:42.99,0:02:48.37,*Default,NTP,0,0,0,,最強の化身は 立つ!
Dialogue: 0,0:02:49.36,0:02:52.44,*Default,NTP,0,0,0,,字幕制作：(V2,林原萌,Hikaru,Wesley)@X2字幕组\N抄写重调：cavalier@u2.dmhy.org
Dialogue: 0,0:02:54.43,0:03:00.12,*Default,NTP,0,0,0,,水中决战!\N列车炮 准备完毕!!
Dialogue: 0,0:03:00.12,0:03:02.71,*Default,NTP,0,0,0,,雷达与传感器的修复是首要任务
Dialogue: 0,0:03:02.71,0:03:04.85,*Default,NTP,0,0,0,,还有多久才能使用
Dialogue: 0,0:03:04.85,0:03:07.15,*Default,NTP,0,0,0,,非常抱歉 现在还不好说
Dialogue: 0,0:03:07.15,0:03:08.96,*Default,NTP,0,0,0,,尽全力把
Dialogue: 0,0:03:08.96,0:03:10.38,*Default,NTP,0,0,0,,啊 是
Dialogue: 0,0:03:11.78,0:03:13.78,*Default,NTP,0,0,0,,来啊 上啊
Dialogue: 0,0:03:14.78,0:03:15.73,*Default,NTP,0,0,0,,怎么了啊
Dialogue: 0,0:03:17.65,0:03:18.73,*Default,NTP,0,0,0,,打啊打啊 臭小子
Dialogue: 0,0:03:20.15,0:03:21.26,*Default,NTP,0,0,0,,怎么了啊
Dialogue: 0,0:03:21.26,0:03:22.72,*Default,NTP,0,0,0,,来得正好呢
Dialogue: 0,0:03:23.48,0:03:24.65,*Default,NTP,0,0,0,,我上咯
Dialogue: 0,0:03:25.90,0:03:26.56,*Default,NTP,0,0,0,,什么
Dialogue: 0,0:03:30.10,0:03:31.90,*Default,NTP,0,0,0,,怎么回事 在干嘛啊
Dialogue: 0,0:03:31.90,0:03:33.74,*Default,NTP,0,0,0,,想要战胜队长
Dialogue: 0,0:03:33.74,0:03:35.86,*Default,NTP,0,0,0,,还早一百年呢
Dialogue: 0,0:03:41.70,0:03:42.56,*Default,NTP,0,0,0,,给我停下来
Dialogue: 0,0:03:42.56,0:03:43.17,*Default,NTP,0,0,0,,嚯
Dialogue: 0,0:03:43.17,0:03:45.31,*Default,NTP,0,0,0,,真是的 什么"嚯"啊
Dialogue: 0,0:03:45.31,0:03:48.68,*Default,NTP,0,0,0,,那家伙 真打算打倒队长呢
Dialogue: 0,0:03:48.68,0:03:50.90,*Default,NTP,0,0,0,,哼 马上就会让他明白的
Dialogue: 0,0:03:52.14,0:03:52.87,*Default,NTP,0,0,0,,得手咯
Dialogue: 0,0:03:53.84,0:03:55.25,*Default,NTP,0,0,0,,可恶 混蛋
Dialogue: 0,0:04:00.31,0:04:01.09,*Default,NTP,0,0,0,,队长
Dialogue: 0,0:04:01.09,0:04:04.55,*Default,NTP,0,0,0,,好哎 我赢咯
Dialogue: 0,0:04:09.64,0:04:10.65,*Default,NTP,0,0,0,,剑儿
Dialogue: 0,0:04:10.65,0:04:11.61,*Default,NTP,0,0,0,,这是当然的了
Dialogue: 0,0:04:11.61,0:04:12.59,*Default,NTP,0,0,0,,嗯
Dialogue: 0,0:04:12.59,0:04:13.83,*Default,NTP,0,0,0,,可恶
Dialogue: 0,0:04:13.83,0:04:15.33,*Default,NTP,0,0,0,,剑儿 你没事吧
Dialogue: 0,0:04:15.33,0:04:20.76,*Default,NTP,0,0,0,,嗯
Dialogue: 0,0:04:20.76,0:04:23.11,*Default,NTP,0,0,0,,对不起 一不小心顺势就
Dialogue: 0,0:04:23.11,0:04:27.49,*Default,NTP,0,0,0,,哎呀 这个 这实在是
Dialogue: 0,0:04:28.38,0:04:32.02,*Default,NTP,0,0,0,,我说 你在看哪里啊
Dialogue: 0,0:04:32.02,0:04:33.48,*Default,NTP,0,0,0,,喂喂 是我
Dialogue: 0,0:04:33.48,0:04:35.48,*Default,NTP,0,0,0,,Build Angel以及空间人员
Dialogue: 0,0:04:35.48,0:04:38.64,*Default,NTP,0,0,0,,赶快到司令室协助进行修复作业
Dialogue: 0,0:04:38.64,0:04:40.33,*Default,NTP,0,0,0,,我们也去吧 镜
Dialogue: 0,0:04:40.33,0:04:41.16,*Default,NTP,0,0,0,,啊 哦
Dialogue: 0,0:04:41.16,0:04:42.39,*Default,NTP,0,0,0,,啊 那我呢
Dialogue: 0,0:04:42.39,0:04:43.31,*Default,NTP,0,0,0,,少烦
Dialogue: 0,0:04:43.31,0:04:45.69,*Default,NTP,0,0,0,,你生什么气啊
Dialogue: 0,0:04:48.63,0:04:50.46,*Default,NTP,0,0,0,,真不错呢 胸部
Dialogue: 0,0:04:56.96,0:04:58.67,*Default,NTP,0,0,0,,啊 正在干着呢
Dialogue: 0,0:04:58.67,0:05:01.18,*Default,NTP,0,0,0,,阿婆 要我帮忙吗
Dialogue: 0,0:05:01.18,0:05:02.94,*Default,NTP,0,0,0,,你就回去待机吧
Dialogue: 0,0:05:02.94,0:05:04.10,*Default,NTP,0,0,0,,可是啊
Dialogue: 0,0:05:04.10,0:05:06.13,*Default,NTP,0,0,0,,哎呀\N喂 你在那里很碍事啊
Dialogue: 0,0:05:06.13,0:05:07.40,*Default,NTP,0,0,0,,碍事?
Dialogue: 0,0:05:08.17,0:05:12.80,*Default,NTP,0,0,0,,什么叫碍事啊 那是该对被选中的人所说的话吗 真是的
Dialogue: 0,0:05:14.37,0:05:15.61,*Default,NTP,0,0,0,,现在嘛
Dialogue: 0,0:05:16.11,0:05:18.10,*Default,NTP,0,0,0,,还是去侦查一圈吧
Dialogue: 0,0:05:46.03,0:05:49.02,*Default,NTP,0,0,0,,邪魔 邪魔 若已邪魔
Dialogue: 0,0:05:49.02,0:05:52.50,*Default,NTP,0,0,0,,邪魔 邪魔 若已邪魔
Dialogue: 0,0:05:52.50,0:05:55.78,*Default,NTP,0,0,0,,与汝黄泉之御魂
Dialogue: 0,0:05:55.78,0:05:59.61,*Default,NTP,0,0,0,,邪魔 邪魔 邪魔所存
Dialogue: 0,0:05:59.61,0:06:03.30,*Default,NTP,0,0,0,,乜鬼 乜鬼 若已乜鬼
Dialogue: 0,0:06:03.30,0:06:06.78,*Default,NTP,0,0,0,,乜鬼 乜鬼 若已乜鬼
Dialogue: 0,0:06:08.39,0:06:13.27,*Default,NTP,0,0,0,,降临吧 听命于本尊的可爱的战士们
Dialogue: 0,0:06:13.44,0:06:20.10,*Default,NTP,0,0,0,,来自黄泉之国 现身于本尊座下
Dialogue: 0,0:06:29.96,0:06:33.68,*Default,NTP,0,0,0,,去吧 本尊的黄泉军兵们
Dialogue: 0,0:06:33.68,0:06:39.97,*Default,NTP,0,0,0,,去将可恶的人类赶尽杀绝吧
Dialogue: 0,0:06:51.81,0:06:55.45,*Default,NTP,0,0,0,,除了一部分广域雷达之外 其余的机能几乎已恢复
Dialogue: 0,0:06:55.45,0:06:56.93,*Default,NTP,0,0,0,,事不宜迟
Dialogue: 0,0:06:56.93,0:07:00.49,*Default,NTP,0,0,0,,我希望派人去一次旧Build Base 以便进行数据回收
Dialogue: 0,0:07:00.49,0:07:02.39,*Default,NTP,0,0,0,,明白了 那就由我们...
Dialogue: 0,0:07:02.39,0:07:03.53,*Default,NTP,0,0,0,,不
Dialogue: 0,0:07:03.53,0:07:07.32,*Default,NTP,0,0,0,,Build Angel负责对Zone内部进行情况调查
Dialogue: 0,0:07:07.32,0:07:08.38,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:07:08.38,0:07:09.78,*Default,NTP,0,0,0,,那我们呢?
Dialogue: 0,0:07:09.78,0:07:12.33,*Default,NTP,0,0,0,,数据回收将由研究所人员进行
Dialogue: 0,0:07:12.33,0:07:14.98,*Default,NTP,0,0,0,,椿和镜 负责进行接送
Dialogue: 0,0:07:14.98,0:07:16.49,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:07:16.49,0:07:17.74,*Default,NTP,0,0,0,,Build Angel
Dialogue: 0,0:07:17.74,0:07:18.72,*Default,NTP,0,0,0,,出发!
Dialogue: 0,0:07:21.19,0:07:22.91,*Default,NTP,0,0,0,,Build Angel 出发完毕
Dialogue: 0,0:07:22.91,0:07:25.38,*Default,NTP,0,0,0,,接下去是Big Shooter 即将出发
Dialogue: 0,0:07:28.77,0:07:31.43,*Default,NTP,0,0,0,,Big Shooter 出发完毕
Dialogue: 0,0:07:31.43,0:07:34.33,*Default,NTP,0,0,0,,搭乘的3名所员也没有出现异常
Dialogue: 0,0:07:34.53,0:07:36.04,*Default,NTP,0,0,0,,没问题吗?\N什么?
Dialogue: 0,0:07:36.04,0:07:38.73,*Default,NTP,0,0,0,,把剑儿那家伙 抛下不管
Dialogue: 0,0:07:40.84,0:07:42.73,*Default,NTP,0,0,0,,谁管他 那种家伙
Dialogue: 0,0:07:48.10,0:07:49.32,*Default,NTP,0,0,0,,难道说
Dialogue: 0,0:07:50.68,0:07:52.41,*Default,NTP,0,0,0,,喂 怎么了 有敌情吗
Dialogue: 0,0:07:52.41,0:07:55.88,*Default,NTP,0,0,0,,剑儿 你在那里做什么啊
Dialogue: 0,0:07:55.88,0:07:57.65,*Default,NTP,0,0,0,,侦查啊 侦查
Dialogue: 0,0:07:57.65,0:07:59.28,*Default,NTP,0,0,0,,先不管这个 敌人在哪里啊
Dialogue: 0,0:07:59.28,0:08:01.36,*Default,NTP,0,0,0,,放心吧 不是敌人
Dialogue: 0,0:08:01.36,0:08:04.53,*Default,NTP,0,0,0,,我们只是要去旧Build Base进行数据回收
Dialogue: 0,0:08:04.53,0:08:06.11,*Default,NTP,0,0,0,,切 吓我一跳
Dialogue: 0,0:08:06.11,0:08:09.25,*Default,NTP,0,0,0,,真是的 到底谁吓谁啊
Dialogue: 0,0:08:09.25,0:08:11.11,*Default,NTP,0,0,0,,呵 侦查啊
Dialogue: 0,0:08:11.11,0:08:13.04,*Default,NTP,0,0,0,,他也稍微有点干劲了吧
Dialogue: 0,0:08:13.04,0:08:14.38,*Default,NTP,0,0,0,,有吗?
Dialogue: 0,0:08:16.85,0:08:18.03,*Default,NTP,0,0,0,,没有错吗
Dialogue: 0,0:08:18.68,0:08:20.17,*Default,NTP,0,0,0,,没有错
Dialogue: 0,0:08:20.17,0:08:22.13,*Default,NTP,0,0,0,,那是 那是...
Dialogue: 0,0:08:23.02,0:08:24.93,*Default,NTP,0,0,0,,和当时完全一样啊
Dialogue: 0,0:08:25.34,0:08:28.22,*Default,NTP,0,0,0,,建筑物以及跑道的破坏情况
Dialogue: 0,0:08:28.22,0:08:29.54,*Default,NTP,0,0,0,,也和当时完全相同
Dialogue: 0,0:08:29.54,0:08:32.86,*Default,NTP,0,0,0,,当时 也就是说 这里和50年前一模一样吗
Dialogue: 0,0:08:32.86,0:08:37.03,*Default,NTP,0,0,0,,是的 我们就是从这里向着Zone外壁行驶的
Dialogue: 0,0:08:40.24,0:08:44.71,*Default,NTP,0,0,0,,然而 Zone的外面却已经是47年之后的世界了
Dialogue: 0,0:08:44.71,0:08:47.16,*Default,NTP,0,0,0,,是的 即使想要回到所属部队
Dialogue: 0,0:08:47.16,0:08:51.00,*Default,NTP,0,0,0,,但自卫队也早已不存在 而是重组成为了防卫队
Dialogue: 0,0:08:54.24,0:08:56.43,*Default,NTP,0,0,0,,和你们这些小喽啰讲也没有用
Dialogue: 0,0:08:56.43,0:08:59.56,*Default,NTP,0,0,0,,把最高负责人给我叫过来
Dialogue: 0,0:08:59.56,0:09:02.31,*Default,NTP,0,0,0,,难 难道说
Dialogue: 0,0:09:02.31,0:09:03.88,*Default,NTP,0,0,0,,大 大姐头
Dialogue: 0,0:09:03.88,0:09:04.64,*Default,NTP,0,0,0,,参谋
Dialogue: 0,0:09:04.64,0:09:06.12,*Default,NTP,0,0,0,,你是谁啊
Dialogue: 0,0:09:06.12,0:09:08.25,*Default,NTP,0,0,0,,啊 你是
Dialogue: 0,0:09:09.51,0:09:11.75,*Default,NTP,0,0,0,,恶马尻直次郎嘛
Dialogue: 0,0:09:11.75,0:09:13.40,*Default,NTP,0,0,0,,大姐头
Dialogue: 0,0:09:14.41,0:09:17.07,*Default,NTP,0,0,0,,真的 没错 你是直次郎嘛
Dialogue: 0,0:09:17.07,0:09:20.67,*Default,NTP,0,0,0,,你都老成这样了啊
Dialogue: 0,0:09:21.03,0:09:24.66,*Default,NTP,0,0,0,,都成为参谋了啊 混得很不错了嘛
Dialogue: 0,0:09:24.96,0:09:29.14,*Default,NTP,0,0,0,,老姐们 还和以前一样 一点儿都没变呢
Dialogue: 0,0:09:33.93,0:09:37.49,*Default,NTP,0,0,0,,之后 和我一起组成了Build Angel
Dialogue: 0,0:09:37.49,0:09:41.12,*Default,NTP,0,0,0,,如果没和队长相遇的话 估计我们早就...
Dialogue: 0,0:09:41.88,0:09:44.43,*Default,NTP,0,0,0,,看来 我还是有点作用的嘛
Dialogue: 0,0:09:44.43,0:09:46.97,*Default,NTP,0,0,0,,那是当然的\N那还用说吗
Dialogue: 0,0:09:47.50,0:09:49.15,*Default,NTP,0,0,0,,一起去吧
Dialogue: 0,0:09:49.52,0:09:51.35,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:09:59.49,0:10:01.54,*Default,NTP,0,0,0,,请把现场画面传过来
Dialogue: 0,0:10:01.54,0:10:02.68,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:10:04.45,0:10:06.80,*Default,NTP,0,0,0,,怎么回事
Dialogue: 0,0:10:09.16,0:10:11.47,*Default,NTP,0,0,0,,一点都没有锈蚀
Dialogue: 0,0:10:11.47,0:10:14.34,*Default,NTP,0,0,0,,博士 还是和50年前一模一样啊
Dialogue: 0,0:10:14.34,0:10:18.18,*Default,NTP,0,0,0,,简直就像是刚受到攻击之后的景象啊
Dialogue: 0,0:10:18.18,0:10:20.62,*Default,NTP,0,0,0,,到底是怎么回事啊
Dialogue: 0,0:10:31.43,0:10:34.45,*Default,NTP,0,0,0,,现在准备进入 开始进行探查
Dialogue: 0,0:10:34.45,0:10:38.89,*Default,NTP,0,0,0,,好 从那里向前大约15米的地方 应该有条通往地下的阶梯的
Dialogue: 0,0:10:38.89,0:10:39.94,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:10:39.94,0:10:42.14,*Default,NTP,0,0,0,,监视器交给你了 椿
Dialogue: 0,0:10:42.14,0:10:44.63,*Default,NTP,0,0,0,,好的 当心点哦
Dialogue: 0,0:10:48.39,0:10:49.65,*Default,NTP,0,0,0,,就是那里
Dialogue: 0,0:10:49.65,0:10:51.67,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:11:07.02,0:11:09.79,*Default,NTP,0,0,0,,把镜头转向右边给我看
Dialogue: 0,0:11:10.76,0:11:12.13,*Default,NTP,0,0,0,,啊 就是那里
Dialogue: 0,0:11:12.13,0:11:14.61,*Default,NTP,0,0,0,,那里就是记录数据库室
Dialogue: 0,0:11:14.61,0:11:16.08,*Default,NTP,0,0,0,,开个洞吧
Dialogue: 0,0:11:16.08,0:11:18.19,*Default,NTP,0,0,0,,给我电磁钻头
Dialogue: 0,0:11:26.62,0:11:29.10,*Default,NTP,0,0,0,,系统还运转着?
Dialogue: 0,0:11:35.03,0:11:38.34,*Default,NTP,0,0,0,,所长 快看这个
Dialogue: 0,0:11:38.34,0:11:40.99,*Default,NTP,0,0,0,,在长崎地区探测到敌方部队的动向
Dialogue: 0,0:11:40.99,0:11:43.46,*Default,NTP,0,0,0,,敌方 敌方似乎正在交战中
Dialogue: 0,0:11:43.46,0:11:45.76,*Default,NTP,0,0,0,,交战中 和谁啊
Dialogue: 0,0:11:45.76,0:11:47.90,*Default,NTP,0,0,0,,那里是 佐世保 佐世保基地!
Dialogue: 0,0:11:47.90,0:11:51.90,*Default,NTP,0,0,0,,什么 自卫队还健在着吗?!
Dialogue: 0,0:11:52.80,0:11:54.81,*Default,NTP,0,0,0,,自卫队仍然健在?
Dialogue: 0,0:11:54.81,0:11:57.29,*Default,NTP,0,0,0,,根据监视器的情报来看...
Dialogue: 0,0:11:57.29,0:12:01.15,*Default,NTP,0,0,0,,其他基地的队员们 仍然生还着的可能性很高
Dialogue: 0,0:12:01.15,0:12:03.01,*Default,NTP,0,0,0,,这可是大好消息
Dialogue: 0,0:12:03.01,0:12:06.43,*Default,NTP,0,0,0,, 可以把自卫队作为我们的后方支援了
Dialogue: 0,0:12:06.43,0:12:09.57,*Default,NTP,0,0,0,,总之 现在请立即赶往佐世保基地
Dialogue: 0,0:12:09.57,0:12:10.55,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:12:10.55,0:12:12.14,*Default,NTP,0,0,0,,听到了吗 你们两个?
Dialogue: 0,0:12:12.14,0:12:13.27,*Default,NTP,0,0,0,,清清楚楚
Dialogue: 0,0:12:13.27,0:12:14.43,*Default,NTP,0,0,0,,去吧
Dialogue: 0,0:12:14.43,0:12:16.03,*Default,NTP,0,0,0,,GO!
Dialogue: 0,0:12:18.93,0:12:20.41,*Default,NTP,0,0,0,,这里是Big Shooter
Dialogue: 0,0:12:20.41,0:12:23.66,*Default,NTP,0,0,0,,数据回收完毕 现在开始返航
Dialogue: 0,0:12:25.60,0:12:27.26,*Default,NTP,0,0,0,,Big Shooter返航中
Dialogue: 0,0:12:27.26,0:12:29.91,*Default,NTP,0,0,0,,Build Angel正向佐世保基地航行中
Dialogue: 0,0:12:29.91,0:12:32.16,*Default,NTP,0,0,0,,佐世保 不就在这附近吗
Dialogue: 0,0:12:32.16,0:12:35.02,*Default,NTP,0,0,0,,哦 搞不好我第一个到哦
Dialogue: 0,0:12:38.16,0:12:40.36,*Default,NTP,0,0,0,,嗯 怎么回事啊
Dialogue: 0,0:12:43.22,0:12:44.64,*Default,NTP,0,0,0,,那是
Dialogue: 0,0:12:48.84,0:12:50.23,*Default,NTP,0,0,0,,不好
Dialogue: 0,0:12:52.93,0:12:55.01,*Default,NTP,0,0,0,,拜托咯 搭档
Dialogue: 0,0:13:11.24,0:13:14.30,*Default,NTP,0,0,0,,Big Shooter已返航
Dialogue: 0,0:13:14.30,0:13:15.43,*Default,NTP,0,0,0,,椿 听得见吗
Dialogue: 0,0:13:15.43,0:13:17.72,*Default,NTP,0,0,0,,嗯 剑儿 你现在在哪里啊
Dialogue: 0,0:13:17.72,0:13:18.81,*Default,NTP,0,0,0,,佐世保啊
Dialogue: 0,0:13:18.81,0:13:21.25,*Default,NTP,0,0,0,,佐世保基地现在正遭受敌人的袭击啊
Dialogue: 0,0:13:21.25,0:13:22.88,*Default,NTP,0,0,0,,你没事吧 剑儿
Dialogue: 0,0:13:22.88,0:13:25.07,*Default,NTP,0,0,0,,啊 暂时没事吧
Dialogue: 0,0:13:25.07,0:13:29.12,*Default,NTP,0,0,0,,不过 你们也快点赶过来吧 这里形势不妙啊
Dialogue: 0,0:13:29.12,0:13:30.31,*Default,NTP,0,0,0,,明白了
Dialogue: 0,0:13:30.31,0:13:32.60,*Default,NTP,0,0,0,,我们到来之前 你就在那儿待机吧
Dialogue: 0,0:13:32.60,0:13:33.95,*Default,NTP,0,0,0,,好了 怎么办呢
Dialogue: 0,0:13:33.95,0:13:37.25,*Default,NTP,0,0,0,,小哥 我的伙伴们正在那里战斗着呢
Dialogue: 0,0:13:37.25,0:13:40.30,*Default,NTP,0,0,0,,要我干巴巴看着 我可做不到啊
Dialogue: 0,0:13:40.30,0:13:42.57,*Default,NTP,0,0,0,,就是啊 那么...
Dialogue: 0,0:13:43.19,0:13:45.44,*Default,NTP,0,0,0,,就去救你的同伴吧
Dialogue: 0,0:13:47.92,0:13:48.79,*Default,NTP,0,0,0,,司令
Dialogue: 0,0:13:48.79,0:13:51.98,*Default,NTP,0,0,0,,数据回收人员已经从Big Shooter上回来了
Dialogue: 0,0:13:51.98,0:13:55.40,*Default,NTP,0,0,0,,数据马上移送至司令员 进行分析
Dialogue: 0,0:13:55.40,0:13:59.33,*Default,NTP,0,0,0,,Big Shooter准备好基克部件 立即重新出发
Dialogue: 0,0:14:01.81,0:14:02.81,*Default,NTP,0,0,0,,出发
Dialogue: 0,0:14:18.97,0:14:20.02,*Default,NTP,0,0,0,,可恶
Dialogue: 0,0:14:20.02,0:14:22.38,*Default,NTP,0,0,0,,又要来阻碍本尊了吗
Dialogue: 0,0:14:22.38,0:14:24.63,*Default,NTP,0,0,0,,妃魅祸陛下 请交给我吧
Dialogue: 0,0:14:24.63,0:14:27.18,*Default,NTP,0,0,0,,不 就由我去灭了他吧
Dialogue: 0,0:14:27.18,0:14:28.43,*Default,NTP,0,0,0,,等下 壬魔使
Dialogue: 0,0:14:28.43,0:14:30.42,*Default,NTP,0,0,0,,随他去吧\N妃魅祸陛下
Dialogue: 0,0:14:30.42,0:14:32.58,*Default,NTP,0,0,0,,那份气魄值得赞赏
Dialogue: 0,0:14:32.58,0:14:36.46,*Default,NTP,0,0,0,,这次就交给他看看吧
Dialogue: 0,0:14:59.66,0:15:01.75,*Default,NTP,0,0,0,,射击 射击
Dialogue: 0,0:15:12.78,0:15:14.58,*Default,NTP,0,0,0,,子弹没有用啊
Dialogue: 0,0:15:14.58,0:15:15.58,*Default,NTP,0,0,0,,滚开
Dialogue: 0,0:15:15.58,0:15:17.58,*Default,NTP,0,0,0,,来啊来啊来啊
Dialogue: 0,0:15:19.59,0:15:22.41,*Default,NTP,0,0,0,,吃招吧 你们这群丧尸啊 我投投投
Dialogue: 0,0:15:27.09,0:15:28.58,*Default,NTP,0,0,0,,成功了啊 小哥
Dialogue: 0,0:15:28.58,0:15:30.52,*Default,NTP,0,0,0,,好 去干下一批
Dialogue: 0,0:15:30.52,0:15:32.60,*Default,NTP,0,0,0,,收到
Dialogue: 0,0:15:33.78,0:15:35.30,*Default,NTP,0,0,0,,司马博士 快看这个
Dialogue: 0,0:15:35.30,0:15:36.88,*Default,NTP,0,0,0,,我马上传送到你那边的监视器上
Dialogue: 0,0:15:36.88,0:15:39.13,*Default,NTP,0,0,0,,哦 还在啊
Dialogue: 0,0:15:42.19,0:15:44.41,*Default,NTP,0,0,0,,哦 那是我方同伴啊
Dialogue: 0,0:15:46.97,0:15:48.36,*Default,NTP,0,0,0,,怎么了
Dialogue: 0,0:15:48.36,0:15:50.24,*Default,NTP,0,0,0,,手榴弹扔光了呢
Dialogue: 0,0:16:05.12,0:16:06.76,*Default,NTP,0,0,0,,快逃
Dialogue: 0,0:16:08.16,0:16:08.76,*Default,NTP,0,0,0,,我挡
Dialogue: 0,0:16:14.70,0:16:17.19,*Default,NTP,0,0,0,,听好了 站在那儿不要动哦
Dialogue: 0,0:16:25.52,0:16:28.96,*Default,NTP,0,0,0,,剑儿 记得谢我哦
Dialogue: 0,0:16:28.96,0:16:30.98,*Default,NTP,0,0,0,,白 白痴啊
Dialogue: 0,0:16:30.98,0:16:32.65,*Default,NTP,0,0,0,,你想谋杀我啊
Dialogue: 0,0:16:39.01,0:16:40.80,*Default,NTP,0,0,0,,我负责地面
Dialogue: 0,0:16:40.80,0:16:42.07,*Default,NTP,0,0,0,,剑儿 听得见吗
Dialogue: 0,0:16:42.07,0:16:43.30,*Default,NTP,0,0,0,,终于来了啊
Dialogue: 0,0:16:43.30,0:16:44.59,*Default,NTP,0,0,0,,我等到花儿也谢了呢
Dialogue: 0,0:16:44.59,0:16:46.34,*Default,NTP,0,0,0,,听好了 剑儿 马上进行Build Up
Dialogue: 0,0:16:46.34,0:16:48.76,*Default,NTP,0,0,0,,Ok啊 久等了
Dialogue: 0,0:16:51.41,0:16:53.02,*Default,NTP,0,0,0,,那机体是什么啊
Dialogue: 0,0:16:53.02,0:16:54.16,*Default,NTP,0,0,0,,是援军啊
Dialogue: 0,0:16:56.45,0:16:58.03,*Default,NTP,0,0,0,,剑儿 上咯
Dialogue: 0,0:16:58.03,0:16:59.41,*Default,NTP,0,0,0,,OK~!!!
Dialogue: 0,0:17:00.32,0:17:02.37,*Default,NTP,0,0,0,,来吧 Build Up!
Dialogue: 0,0:17:15.71,0:17:18.49,*Default,NTP,0,0,0,,基克部件 Shoot!
Dialogue: 0,0:17:46.09,0:17:50.80,*Default,NTP,0,0,0,,钢铁基克!
Dialogue: 0,0:17:56.59,0:17:59.75,*Default,NTP,0,0,0,,那小哥变成基克了?!
Dialogue: 0,0:18:02.97,0:18:03.69,*Default,NTP,0,0,0,,什么啊
Dialogue: 0,0:18:07.53,0:18:10.50,*Default,NTP,0,0,0,,埴轮幻神 加治罗
Dialogue: 0,0:18:10.50,0:18:11.78,*Default,NTP,0,0,0,,埴轮幻神?!
Dialogue: 0,0:18:15.21,0:18:17.09,*Default,NTP,0,0,0,,基克 你就好好尝尝
Dialogue: 0,0:18:17.09,0:18:20.84,*Default,NTP,0,0,0,,妃魅祸陛下托付给我的埴轮幻神 加治罗的威力吧
Dialogue: 0,0:18:20.84,0:18:22.55,*Default,NTP,0,0,0,,不好 不知不觉被他
Dialogue: 0,0:18:22.55,0:18:24.23,*Default,NTP,0,0,0,,剑儿 其他的交给我们
Dialogue: 0,0:18:24.23,0:18:25.74,*Default,NTP,0,0,0,,你负责埴轮幻神
Dialogue: 0,0:18:25.74,0:18:27.55,*Default,NTP,0,0,0,,就这样吧
Dialogue: 0,0:18:27.55,0:18:30.79,*Default,NTP,0,0,0,,上咯 埴轮幻神
Dialogue: 0,0:18:39.47,0:18:41.33,*Default,NTP,0,0,0,,可恶
Dialogue: 0,0:18:45.22,0:18:47.23,*Default,NTP,0,0,0,,混蛋
Dialogue: 0,0:18:53.67,0:18:56.15,*Default,NTP,0,0,0,,可恶 跟不上它的动作
Dialogue: 0,0:18:58.06,0:19:01.08,*Default,NTP,0,0,0,,基克啊 你就化为海藻碎屑吧
Dialogue: 0,0:19:01.08,0:19:03.97,*Default,NTP,0,0,0,,剑儿 快上岸来 水中战斗只会处于劣势啊
Dialogue: 0,0:19:03.97,0:19:05.39,*Default,NTP,0,0,0,,你说的轻巧
Dialogue: 0,0:19:05.83,0:19:06.55,*Default,NTP,0,0,0,,剑儿
Dialogue: 0,0:19:06.55,0:19:08.13,*Default,NTP,0,0,0,,用列车炮
Dialogue: 0,0:19:08.13,0:19:10.28,*Default,NTP,0,0,0,,我马上就把数据传给你
Dialogue: 0,0:19:10.28,0:19:11.34,*Default,NTP,0,0,0,,这是...?
Dialogue: 0,0:19:11.34,0:19:12.48,*Default,NTP,0,0,0,,列车炮...
Dialogue: 0,0:19:12.48,0:19:13.85,*Default,NTP,0,0,0,,50年前的?!
Dialogue: 0,0:19:13.85,0:19:17.55,*Default,NTP,0,0,0,,啊 从你们回收的数据中查到的
Dialogue: 0,0:19:17.55,0:19:20.45,*Default,NTP,0,0,0,,没想到就像新的一样 好留存着呢
Dialogue: 0,0:19:20.45,0:19:22.89,*Default,NTP,0,0,0,,已经进入发射状态了
Dialogue: 0,0:19:22.89,0:19:25.42,*Default,NTP,0,0,0,,还能使用吗 这是旧基克部件吧
Dialogue: 0,0:19:25.42,0:19:28.20,*Default,NTP,0,0,0,,没问题 电磁关节部分是一样的
Dialogue: 0,0:19:28.20,0:19:29.30,*Default,NTP,0,0,0,,厉害
Dialogue: 0,0:19:29.30,0:19:31.50,*Default,NTP,0,0,0,,剑儿 我要发射水中部件了
Dialogue: 0,0:19:31.50,0:19:34.22,*Default,NTP,0,0,0,,啊 什么都好 快给我吧
Dialogue: 0,0:19:42.59,0:19:43.43,*Default,NTP,0,0,0,,还能用
Dialogue: 0,0:19:43.43,0:19:45.41,*Default,NTP,0,0,0,,水中部件 Shoot!
Dialogue: 0,0:19:49.54,0:19:50.93,*Default,NTP,0,0,0,,水中部件 确认发
Dialogue: 0,0:19:50.93,0:19:53.26,*Default,NTP,0,0,0,,距离到达基克还剩53秒
Dialogue: 0,0:19:53.26,0:19:55.21,*Default,NTP,0,0,0,,52....51.....
Dialogue: 0,0:19:55.21,0:19:57.91,*Default,NTP,0,0,0,,剑儿 部件就要到达了 快升上海面
Dialogue: 0,0:19:57.91,0:20:00.31,*Default,NTP,0,0,0,,你说得倒简单嘛
Dialogue: 0,0:20:04.58,0:20:06.70,*Default,NTP,0,0,0,,呵 这可多谢咯
Dialogue: 0,0:20:07.43,0:20:08.89,*Default,NTP,0,0,0,,就是那个
Dialogue: 0,0:20:10.36,0:20:12.76,*Default,NTP,0,0,0,,上了 Build Off!
Dialogue: 0,0:20:12.76,0:20:15.83,*Default,NTP,0,0,0,,水中部件 Set!
Dialogue: 0,0:20:19.61,0:20:22.12,*Default,NTP,0,0,0,,Build Up!
Dialogue: 0,0:20:38.56,0:20:40.41,*Default,NTP,0,0,0,,太爽了
Dialogue: 0,0:20:40.41,0:20:43.47,*Default,NTP,0,0,0,,混蛋 我会好好回敬你的
Dialogue: 0,0:20:44.50,0:20:46.20,*Default,NTP,0,0,0,,混蛋 看招
Dialogue: 0,0:20:46.20,0:20:49.61,*Default,NTP,0,0,0,,Magnet Storm!
Dialogue: 0,0:20:54.59,0:20:56.57,*Default,NTP,0,0,0,,Marine Missile!
Dialogue: 0,0:21:01.70,0:21:02.60,*Default,NTP,0,0,0,,成功了
Dialogue: 0,0:21:04.55,0:21:06.56,*Default,NTP,0,0,0,,没事吧 剑儿\N成功了啊
Dialogue: 0,0:21:06.56,0:21:08.73,*Default,NTP,0,0,0,,这个嘛 实力啊
Dialogue: 0,0:21:09.91,0:21:11.73,*Default,NTP,0,0,0,,够了 撤退吧
Dialogue: 0,0:21:11.73,0:21:12.83,*Default,NTP,0,0,0,,是
Dialogue: 0,0:21:21.61,0:21:23.32,*Default,NTP,0,0,0,,哇 好可怕
Dialogue: 0,0:21:23.32,0:21:25.91,*Default,NTP,0,0,0,,来啊来啊 蛋蛋还在的吧
Dialogue: 0,0:21:25.91,0:21:28.21,*Default,NTP,0,0,0,,给我大声的回答啊
Dialogue: 0,0:21:28.21,0:21:29.23,*Default,NTP,0,0,0,,啊 是
Dialogue: 0,0:21:29.23,0:21:32.95,*Default,NTP,0,0,0,,今年是1975年 兔年
Dialogue: 0,0:21:32.95,0:21:36.74,*Default,NTP,0,0,0,,果然我们是回到了50年前吗
Dialogue: 0,0:21:36.74,0:21:38.49,*Default,NTP,0,0,0,,不 不是这样
Dialogue: 0,0:21:38.49,0:21:39.85,*Default,NTP,0,0,0,,这并不是时间跳跃
Dialogue: 0,0:21:39.85,0:21:43.29,*Default,NTP,0,0,0,,而是Zone内部的时间停滞了啊
Dialogue: 0,0:21:43.29,0:21:44.53,*Default,NTP,0,0,0,,时间...?
Dialogue: 0,0:21:44.62,0:21:48.01,*Default,NTP,0,0,0,,回收来的数据证明了这一切啊
Dialogue: 0,0:21:48.01,0:21:49.50,*Default,NTP,0,0,0,,那就是说...?!
Dialogue: 0,0:21:49.50,0:21:52.23,*Default,NTP,0,0,0,,就是这么一回事啦
Dialogue: 0,0:22:05.63,0:22:07.98,*Default,NTP,0,0,0,,啊 肚子好饿 回去吃饭回去吃饭
Dialogue: 0,0:22:07.98,0:22:10.62,*Default,NTP,0,0,0,,剑儿你真是的
Dialogue: 0,0:22:15.82,0:22:24.52,*Default,NTP,0,0,0,,Ending Theme [HEAVEN]\Nby GRANRODEO
Dialogue: 0,0:22:36.30,0:22:41.73,*Default,NTP,0,0,0,,Don't let me down Don't leave me now
Dialogue: 0,0:22:41.92,0:22:45.24,*Default,NTP,0,0,0,,手探りの　in the dark
Dialogue: 0,0:22:45.31,0:22:50.66,*Default,NTP,0,0,0,,Right on my way, Light out the stars
Dialogue: 0,0:22:50.78,0:22:54.02,*Default,NTP,0,0,0,,见失わないように
Dialogue: 0,0:22:54.17,0:23:03.06,*Default,NTP,0,0,0,,キラメキを背にして　立ち上がる君はconfuse
Dialogue: 0,0:23:03.17,0:23:11.09,*Default,NTP,0,0,0,,歩き始めるとまどいも 腕に抱えて

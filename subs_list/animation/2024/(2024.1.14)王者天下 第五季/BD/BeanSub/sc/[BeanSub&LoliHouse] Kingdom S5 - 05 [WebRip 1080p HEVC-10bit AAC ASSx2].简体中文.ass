Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕组制作 仅供学习交流 禁止用于商业用途
Comment: 0,0:01:36.99,0:01:37.04,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:01:58.22,0:02:04.65,op-jp,,0,0,0,,滴る汗と日差しで閉じた目
Dialogue: 0,0:02:04.65,0:02:10.90,op-jp,,0,0,0,,映し出したのはあなたとの約束
Dialogue: 0,0:02:10.90,0:02:17.54,op-jp,,0,0,0,,意志を紡いだ導火線に火をつけたら
Dialogue: 0,0:02:17.54,0:02:23.29,op-jp,,0,0,0,,今より強く高く翔べる
Dialogue: 0,0:02:23.29,0:02:30.02,op-jp,,0,0,0,,恐れを知って哀を知って進むなら
Dialogue: 0,0:02:30.02,0:02:37.49,op-jp,,0,0,0,,己の全て捧げ旗を上げろ
Dialogue: 0,0:02:37.49,0:02:43.06,op-jp,,0,0,0,,掠れた声を何度も張りあげてよ
Dialogue: 0,0:02:43.06,0:02:47.94,op-jp,,0,0,0,,希望を決意を抱いて
Dialogue: 0,0:01:58.22,0:02:04.65,op-cn,,0,0,0,,汗水滚落 烈日当头 我闭上双眼
Dialogue: 0,0:02:04.65,0:02:10.90,op-cn,,0,0,0,,眼中映出 与你的约定
Dialogue: 0,0:02:10.90,0:02:17.54,op-cn,,0,0,0,,点燃以意志织成的导火线
Dialogue: 0,0:02:17.54,0:02:23.29,op-cn,,0,0,0,,向着更高更强 振翅高飞
Dialogue: 0,0:02:23.29,0:02:30.02,op-cn,,0,0,0,,知晓恐惧 知晓哀伤 前进不息
Dialogue: 0,0:02:30.02,0:02:37.49,op-cn,,0,0,0,,献出一切 高举旗帜
Dialogue: 0,0:02:37.49,0:02:43.06,op-cn,,0,0,0,,无数次发出嘶吼
Dialogue: 0,0:02:43.06,0:02:47.94,op-cn,,0,0,0,,心怀希望 坚定决心
Comment: 0,0:23:15.96,0:23:15.96,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:27.05,0:23:30.00,ed-jp,,0,0,1,,なぁ坊やどうした？ここは戦場だぜ
Dialogue: 0,0:23:30.00,0:23:32.83,ed-jp,,0,0,1,,たぎる憎悪のラリー　背馳の成長過程
Dialogue: 0,0:23:32.83,0:23:35.64,ed-jp,,0,0,1,,加減も知らず殺気立ったままの剣に
Dialogue: 0,0:23:35.64,0:23:38.81,ed-jp,,0,0,1,,発汗する体　カルマか咎　如何に？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-jp,,0,0,1,,恒　現実は不調和な旋律さ
Dialogue: 0,0:23:41.28,0:23:44.29,ed-jp,,0,0,1,,冷血なステンレス製の心臓持つ演説者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-jp,,0,0,1,,何回目の明滅　また凱旋するテンペスタ
Dialogue: 0,0:23:46.94,0:23:50.04,ed-jp,,0,0,1,,アーチかける善悪　もう応答しない生存者
Dialogue: 0,0:23:51.14,0:23:53.78,ed-jp,,0,0,0,,花のよう　咲うＭｙ　Ｒｅｄ
Dialogue: 0,0:23:53.95,0:24:02.32,ed-jp,,0,0,0,,守りたいものだって　この掌離れれば
Dialogue: 0,0:24:02.48,0:24:09.95,ed-jp,,0,0,0,,壊したいものなんて　壊せないものだけ
Dialogue: 0,0:24:11.85,0:24:17.59,ed-jp,,0,0,0,,唸る　その狂気が　花咲かすダリア
Dialogue: 0,0:24:17.59,0:24:20.31,ed-jp,,0,0,0,,振りかざす度　歪んだ定規
Dialogue: 0,0:24:20.31,0:24:23.15,ed-jp,,0,0,0,,反射する対照的な正義
Dialogue: 0,0:24:23.15,0:24:28.82,ed-jp,,0,0,0,,裏切りのゲリラ　散らす羽たちが
Dialogue: 0,0:24:28.82,0:24:31.80,ed-jp,,0,0,0,,飛ぶ鳥の蹴った地面のようさ
Dialogue: 0,0:24:31.80,0:24:36.87,ed-jp,,0,0,0,,君にもあるんでしょう？キズツケタクナイモノ
Dialogue: 0,0:23:27.05,0:23:30.00,ed-cn,,0,0,0,,怎么了小弟弟？这里可是战场
Dialogue: 0,0:23:30.00,0:23:32.83,ed-cn,,0,0,0,,是憎恶翻腾的拉力赛 与成长背道而驰
Dialogue: 0,0:23:32.83,0:23:35.64,ed-cn,,0,0,0,,不知轻重 利剑杀气腾腾
Dialogue: 0,0:23:35.64,0:23:38.81,ed-cn,,0,0,0,,汗流浃背 是业是罪 如何判定？
Dialogue: 0,0:23:38.81,0:23:41.28,ed-cn,,0,0,0,,现实永远是不和谐旋律
Dialogue: 0,0:23:41.28,0:23:44.29,ed-cn,,0,0,0,,拥有钢铁心脏的冷血演讲者
Dialogue: 0,0:23:44.29,0:23:46.94,ed-cn,,0,0,0,,第几次电闪雷鸣 暴风雨再次凯旋
Dialogue: 0,0:23:46.94,0:23:50.04,ed-cn,,0,0,0,,善恶架上彩虹 生还者已无应答
Dialogue: 0,0:23:51.14,0:23:53.78,ed-cn,,0,0,0,,如花般绽放笑容 My Red
Dialogue: 0,0:23:53.95,0:24:02.32,ed-cn,,0,0,0,,想要守护之物 离开掌中便无从守护
Dialogue: 0,0:24:02.48,0:24:09.95,ed-cn,,0,0,0,,想要毁灭之物 全都是无法毁灭之物
Dialogue: 0,0:24:11.85,0:24:17.59,ed-cn,,0,0,0,,呻吟不止 疯狂如盛开的大丽花
Dialogue: 0,0:24:17.59,0:24:20.31,ed-cn,,0,0,0,,标尺一经举起 立刻扭曲
Dialogue: 0,0:24:20.31,0:24:23.15,ed-cn,,0,0,0,,反射出对立的正义
Dialogue: 0,0:24:23.15,0:24:28.82,ed-cn,,0,0,0,,叛逆的游击 散落的羽翼
Dialogue: 0,0:24:28.82,0:24:31.80,ed-cn,,0,0,0,,如飞鸟蹬踏的地面一般
Dialogue: 0,0:24:31.80,0:24:36.87,ed-cn,,0,0,0,,你一定也有不愿伤害之物
Dialogue: 0,0:00:03.95,0:00:08.99,Default,,0,0,0,,渕副长比任何人都强的素质是什么啊
Dialogue: 0,0:00:11.21,0:00:12.62,Default,,0,0,0,,责任感
Dialogue: 0,0:00:15.71,0:00:18.53,Default,,0,0,0,,这支部队起初只有区区一百人
Dialogue: 0,0:00:18.80,0:00:22.50,Default,,0,0,0,,他从创队到现在 当了七年副长
Dialogue: 0,0:00:23.04,0:00:27.51,Default,,0,0,0,,并不是必须有勇武或智谋才值得信赖 我吕
Dialogue: 0,0:00:28.89,0:00:30.15,Default,,0,0,0,,就交给你了 渕叔
Dialogue: 0,0:00:31.76,0:00:34.60,Default,,0,0,0,,这个任务的最合适人选
Dialogue: 0,0:00:34.99,0:00:36.08,Default,,0,0,0,,就是渕叔
Dialogue: 0,0:00:36.35,0:00:38.60,Default,,0,0,0,,信大人
Dialogue: 0,0:00:40.31,0:00:41.80,Default,,0,0,0,,河水越来越红了
Dialogue: 0,0:00:47.75,0:00:48.53,Default,,0,0,0,,副长
Dialogue: 0,0:00:49.89,0:00:53.41,Default,,0,0,0,,加 加把劲 跟我上
Dialogue: 0,0:00:53.62,0:00:55.40,Default,,0,0,0,,是
Dialogue: 0,0:00:58.08,0:00:59.12,Default,,0,0,0,,信大人
Dialogue: 0,0:00:59.99,0:01:04.00,Default,,0,0,0,,你看起来傻乎乎的 但其实还挺有头脑
Dialogue: 0,0:01:05.18,0:01:08.68,Default,,0,0,0,,你用那种眼神 对我说出那种话…
Dialogue: 0,0:01:10.69,0:01:12.76,Default,,0,0,0,,别退缩 前进
Dialogue: 0,0:01:14.63,0:01:17.76,Default,,0,0,0,,那我怎么能失败呢
Dialogue: 0,0:01:18.44,0:01:22.90,Default,,0,0,0,,我起初也疑惑过 为什么是渕副长
Dialogue: 0,0:01:23.60,0:01:24.34,Default,,0,0,0,,但是
Dialogue: 0,0:01:24.48,0:01:30.49,Default,,0,0,0,,正因为渕副长不像信队长和羌瘣副长那样强如怪物
Dialogue: 0,0:01:30.64,0:01:32.60,Default,,0,0,0,,才能在某些方面引领众人
Dialogue: 0,0:01:33.62,0:01:36.76,Default,,0,0,0,,奇迹…或许真的会发生
Dialogue: 0,0:03:07.96,0:03:11.17,biaoti,,0,0,0,,{\fad(480,480)}拼上意志的渡河
Dialogue: 0,0:03:20.60,0:03:21.72,Default,,0,0,0,,不错的靶子
Dialogue: 0,0:03:21.94,0:03:24.98,Default,,0,0,0,,箭有得是 给我使劲射
Dialogue: 0,0:03:27.11,0:03:29.44,Default,,0,0,0,,不行了 先撤退吧 信
Dialogue: 0,0:03:29.67,0:03:31.91,Default,,0,0,0,,这样纯属白白送死
Dialogue: 0,0:03:31.91,0:03:33.05,Default,,0,0,0,,没有白费
Dialogue: 0,0:03:33.49,0:03:36.58,Default,,0,0,0,,我们发挥着吸引敌人的重要作用
Dialogue: 0,0:03:37.11,0:03:40.02,Default,,0,0,0,,要吸引到什么时候啊 该死的
Dialogue: 0,0:03:41.37,0:03:44.04,Default,,0,0,0,,射
Dialogue: 0,0:03:53.08,0:03:54.24,Default,,0,0,0,,渕叔
Dialogue: 0,0:03:54.73,0:03:56.39,Default,,0,0,0,,信 信大人
Dialogue: 0,0:03:56.39,0:03:59.30,Default,,0,0,0,,快来这边 快从这边上岸
Dialogue: 0,0:03:59.30,0:04:01.47,Default,,0,0,0,,干得好 这就过去
Dialogue: 0,0:04:01.97,0:04:03.50,Default,,0,0,0,,什 什么？
Dialogue: 0,0:04:03.50,0:04:05.53,Default,,0,0,0,,左岸出现了敌军？
Dialogue: 0,0:04:05.53,0:04:09.10,Default,,0,0,0,,不好 他们想从左岸登陆
Dialogue: 0,0:04:09.40,0:04:13.61,Default,,0,0,0,,没 没问题 他们不可能抵达那里
Dialogue: 0,0:04:14.25,0:04:18.29,Default,,0,0,0,,河底的道路只能通向凹地中央
Dialogue: 0,0:04:21.41,0:04:22.87,Default,,0,0,0,,脚碰不到地面
Dialogue: 0,0:04:22.99,0:04:24.37,Default,,0,0,0,,没有浅滩了
Dialogue: 0,0:04:26.14,0:04:28.12,Default,,0,0,0,,快看 他们溺水了
Dialogue: 0,0:04:28.27,0:04:30.25,Default,,0,0,0,,信大人 抓住绳子
Dialogue: 0,0:04:33.30,0:04:33.94,Default,,0,0,0,,什么
Dialogue: 0,0:04:34.11,0:04:35.20,Default,,0,0,0,,来吧 队长
Dialogue: 0,0:04:36.02,0:04:37.58,Default,,0,0,0,,我们上
Dialogue: 0,0:04:38.92,0:04:40.84,Default,,0,0,0,,不好 不能让他们上岸
Dialogue: 0,0:04:40.84,0:04:42.76,Default,,0,0,0,,枪兵跟我来 去左端
Dialogue: 0,0:04:43.28,0:04:45.51,Default,,0,0,0,,快去摧毁他们的据点
Dialogue: 0,0:04:46.15,0:04:46.77,Default,,0,0,0,,不好
Dialogue: 0,0:04:47.09,0:04:49.27,Default,,0,0,0,,他们要去攻击登陆点了
Dialogue: 0,0:04:49.67,0:04:51.30,Default,,0,0,0,,可恶 动作快
Dialogue: 0,0:04:51.38,0:04:53.57,Default,,0,0,0,,后半部分笔直前进
Dialogue: 0,0:04:53.79,0:04:55.77,Default,,0,0,0,,吸引住岸边的一半敌人
Dialogue: 0,0:04:58.17,0:04:59.78,Default,,0,0,0,,副长 敌人来得更快
Dialogue: 0,0:05:01.44,0:05:04.43,Default,,0,0,0,,只留下拉绳子的人 剩下的去阻挡敌人
Dialogue: 0,0:05:04.58,0:05:07.49,Default,,0,0,0,,为信大人他们上岸争取时间
Dialogue: 0,0:05:07.72,0:05:08.74,Default,,0,0,0,,是
Dialogue: 0,0:05:09.81,0:05:10.71,Default,,0,0,0,,渕叔
Dialogue: 0,0:05:17.08,0:05:18.49,Default,,0,0,0,,他们怎么回事
Dialogue: 0,0:05:19.06,0:05:20.82,Default,,0,0,0,,已经站不稳了
Dialogue: 0,0:05:20.82,0:05:22.89,Default,,0,0,0,,该不会是游过来的吧
Dialogue: 0,0:05:24.66,0:05:26.71,Default,,0,0,0,,这都成落汤鸡了啊
Dialogue: 0,0:05:26.71,0:05:28.89,Default,,0,0,0,,这副样子也想跟我们打？
Dialogue: 0,0:05:30.92,0:05:33.17,Default,,0,0,0,,给我躺着吧 蠢货
Dialogue: 0,0:05:36.13,0:05:40.30,Default,,0,0,0,,我们渡过激流 还爬上断崖 总算来到这里
Dialogue: 0,0:05:41.11,0:05:44.17,Default,,0,0,0,,大家都已经没有余力了
Dialogue: 0,0:05:45.06,0:05:45.73,Default,,0,0,0,,但是
Dialogue: 0,0:05:46.66,0:05:48.49,Default,,0,0,0,,我们的任务
Dialogue: 0,0:05:48.93,0:05:50.77,Default,,0,0,0,,还没有完成
Dialogue: 0,0:05:51.69,0:05:52.76,Default,,0,0,0,,副长…
Dialogue: 0,0:05:52.86,0:05:53.88,Default,,0,0,0,,渕副长
Dialogue: 0,0:05:54.76,0:05:57.95,Default,,0,0,0,,一个也别想过去
Dialogue: 0,0:06:00.77,0:06:01.36,Default,,0,0,0,,副长
Dialogue: 0,0:06:01.36,0:06:04.06,Default,,0,0,0,,被碾死吧 蠢货
Dialogue: 0,0:06:21.25,0:06:23.42,Default,,0,0,0,,滚开
Dialogue: 0,0:06:23.53,0:06:25.00,Default,,0,0,0,,给我上
Dialogue: 0,0:06:25.00,0:06:29.74,Default,,0,0,0,,他们一半是弓箭手 冲过去一口气扫平河岸
Dialogue: 0,0:06:39.47,0:06:40.58,Default,,0,0,0,,对你刮目相看了
Dialogue: 0,0:06:41.97,0:06:44.97,Default,,0,0,0,,你不愧是这支部队的副长
Dialogue: 0,0:06:46.06,0:06:48.22,Default,,0,0,0,,虽然之前说了那种话
Dialogue: 0,0:06:48.49,0:06:51.01,Default,,0,0,0,,但你这样的男人 我还挺喜欢
Dialogue: 0,0:06:51.54,0:06:54.40,Default,,0,0,0,,之后就交给我们吧
Dialogue: 0,0:07:01.17,0:07:03.57,Default,,0,0,0,,急报 急报
Dialogue: 0,0:07:03.85,0:07:07.28,Default,,0,0,0,,敌人从中央凹地上岸了
Dialogue: 0,0:07:08.93,0:07:12.08,Default,,0,0,0,,你在说什么 他们怎么上岸的
Dialogue: 0,0:07:12.63,0:07:14.35,Default,,0,0,0,,具体的还不清楚
Dialogue: 0,0:07:14.70,0:07:17.93,Default,,0,0,0,,听说有别动队从后方袭击了岸边的部队
Dialogue: 0,0:07:18.08,0:07:19.04,Default,,0,0,0,,别动队？
Dialogue: 0,0:07:20.36,0:07:22.80,Default,,0,0,0,,凹地的战况呢
Dialogue: 0,0:07:23.30,0:07:28.08,Default,,0,0,0,,已经被敌军占据 不下五百敌军已经上岸
Dialogue: 0,0:07:28.80,0:07:32.60,Default,,0,0,0,,后续部队还在不断上岸
Dialogue: 0,0:07:33.35,0:07:35.06,Default,,0,0,0,,什 什么？
Dialogue: 0,0:07:35.84,0:07:38.41,Default,,0,0,0,,河了貂 他们好像有些慌张
Dialogue: 0,0:07:38.61,0:07:41.06,Default,,0,0,0,,右边的呼声应该就是信他们了
Dialogue: 0,0:07:41.32,0:07:44.08,Default,,0,0,0,,嗯 不会错的 他们上岸了
Dialogue: 0,0:07:47.02,0:07:47.70,Default,,0,0,0,,渕叔…
Dialogue: 0,0:07:48.72,0:07:50.09,Default,,0,0,0,,报
Dialogue: 0,0:07:51.49,0:07:55.25,Default,,0,0,0,,凹地一带溃败 上岸敌军已过千人
Dialogue: 0,0:07:55.25,0:08:00.08,Default,,0,0,0,,敌人还进入树林 似乎想袭击我军背后
Dialogue: 0,0:08:00.28,0:08:01.47,Default,,0,0,0,,这样下去…
Dialogue: 0,0:08:01.47,0:08:03.21,Default,,0,0,0,,马 马呈大人…
Dialogue: 0,0:08:04.36,0:08:06.06,Default,,0,0,0,,怎么回事
Dialogue: 0,0:08:06.72,0:08:10.42,Default,,0,0,0,,攻击凸地的这支敌军 原来不是主攻？
Dialogue: 0,0:08:10.80,0:08:15.20,Default,,0,0,0,,真正的主攻还是大张旗鼓进攻凹地的信
Dialogue: 0,0:08:15.85,0:08:18.59,Default,,0,0,0,,这边是…诱饵？
Dialogue: 0,0:08:19.78,0:08:21.02,Default,,0,0,0,,不对
Dialogue: 0,0:08:21.20,0:08:25.23,Default,,0,0,0,,上岸的决定因素是我们没察觉到的第三力量
Dialogue: 0,0:08:25.80,0:08:29.19,Default,,0,0,0,,是偷偷渡河的别动队
Dialogue: 0,0:08:29.45,0:08:35.20,Default,,0,0,0,,凹地凸地的两支部队 都是为掩盖此事的诱饵
Dialogue: 0,0:08:35.81,0:08:39.37,Default,,0,0,0,,是为创造隐藏助攻的两支助攻部队
Dialogue: 0,0:08:39.90,0:08:45.30,Default,,0,0,0,,而信那队攻击凹地的助攻部队成功上岸后
Dialogue: 0,0:08:45.80,0:08:47.88,Default,,0,0,0,,便进化成了主攻
Dialogue: 0,0:08:48.24,0:08:51.56,Default,,0,0,0,,好 好高明的战术
Dialogue: 0,0:08:52.56,0:08:55.61,Default,,0,0,0,,刘冬都说是无策之境了
Dialogue: 0,0:08:56.37,0:08:58.39,Default,,0,0,0,,他们难道真能渡过来？
Dialogue: 0,0:08:59.90,0:09:01.40,Default,,0,0,0,,飞信队
Dialogue: 0,0:09:02.32,0:09:04.78,Default,,0,0,0,,飞信队在凹地开辟出道路后
Dialogue: 0,0:09:04.78,0:09:07.75,Default,,0,0,0,,后续士兵不断渡河 往左右推进
Dialogue: 0,0:09:08.29,0:09:12.16,Default,,0,0,0,,在岸边布下横阵的赵军无从应对
Dialogue: 0,0:09:12.62,0:09:14.49,Default,,0,0,0,,往森林里四散而退
Dialogue: 0,0:09:15.64,0:09:20.03,Default,,0,0,0,,在凸地吸引马呈的河了貂等人也上岸
Dialogue: 0,0:09:21.05,0:09:24.81,Default,,0,0,0,,在信和貂的两面夹击之下
Dialogue: 0,0:09:25.37,0:09:27.42,Default,,0,0,0,,马呈也只得撤退
Dialogue: 0,0:09:31.54,0:09:32.41,Default,,0,0,0,,是船
Dialogue: 0,0:09:32.52,0:09:34.11,Default,,0,0,0,,找到他们的船了
Dialogue: 0,0:09:34.40,0:09:35.76,Default,,0,0,0,,去报告给河了貂
Dialogue: 0,0:09:36.04,0:09:36.74,Default,,0,0,0,,船？
Dialogue: 0,0:09:37.40,0:09:40.15,Default,,0,0,0,,好 之后就用敌人的船渡河
Dialogue: 0,0:09:40.51,0:09:42.48,Default,,0,0,0,,不要白白消耗体力
Dialogue: 0,0:09:42.56,0:09:43.10,Default,,0,0,0,,是
Dialogue: 0,0:09:44.80,0:09:46.39,Default,,0,0,0,,他们也太慌张了
Dialogue: 0,0:09:46.39,0:09:48.13,Default,,0,0,0,,留下了这么好的礼物
Dialogue: 0,0:09:48.53,0:09:51.85,Default,,0,0,0,,此时的飞信队背对河流
Dialogue: 0,0:09:51.96,0:09:55.67,Default,,0,0,0,,因此 河了貂十分警惕赵军的突然反击
Dialogue: 0,0:09:55.99,0:09:59.97,Default,,0,0,0,,但是 撤退至森林中的赵军并无反击迹象
Dialogue: 0,0:10:01.04,0:10:03.54,Default,,0,0,0,,由于军师刘冬缺阵
Dialogue: 0,0:10:03.54,0:10:07.24,Default,,0,0,0,,赵军失去了逆转局势的机会
Dialogue: 0,0:10:11.50,0:10:12.28,Default,,0,0,0,,渕叔
Dialogue: 0,0:10:12.38,0:10:13.09,Default,,0,0,0,,河了貂
Dialogue: 0,0:10:13.55,0:10:15.52,Default,,0,0,0,,你成功了啊 渕叔
Dialogue: 0,0:10:15.64,0:10:17.98,Default,,0,0,0,,都是多亏了大家
Dialogue: 0,0:10:18.68,0:10:21.10,Default,,0,0,0,,貂 你该不会超过了吧
Dialogue: 0,0:10:22.09,0:10:22.85,Default,,0,0,0,,超过什么
Dialogue: 0,0:10:23.75,0:10:25.36,Default,,0,0,0,,超过昌平君
Dialogue: 0,0:10:26.17,0:10:28.42,Default,,0,0,0,,你 你别瞎说
Dialogue: 0,0:10:28.92,0:10:31.65,Default,,0,0,0,,老师可是比我厉害十倍
Dialogue: 0,0:10:31.65,0:10:33.64,Default,,0,0,0,,哦 是吗
Dialogue: 0,0:10:36.75,0:10:37.48,Default,,0,0,0,,不过
Dialogue: 0,0:10:38.17,0:10:41.11,Default,,0,0,0,,今天的我可能赶上了他的九成
Dialogue: 0,0:10:43.26,0:10:45.02,Default,,0,0,0,,居然自己说出来了
Dialogue: 0,0:10:45.80,0:10:48.66,Default,,0,0,0,,说 说说又没事
Dialogue: 0,0:10:57.04,0:11:00.41,Default,,0,0,0,,就在飞信队击溃赵军前线的同时
Dialogue: 0,0:11:00.65,0:11:03.69,Default,,0,0,0,,第一天发生激战的左侧战场…
Dialogue: 0,0:11:04.62,0:11:06.31,Default,,0,0,0,,雷土率领的桓骑军
Dialogue: 0,0:11:06.90,0:11:08.81,Default,,0,0,0,,岳婴率领的赵军
Dialogue: 0,0:11:09.45,0:11:12.64,Default,,0,0,0,,都一反昨日之态 按兵不动
Dialogue: 0,0:11:12.91,0:11:16.10,Default,,0,0,0,,隔着密林对峙
Dialogue: 0,0:11:17.44,0:11:22.08,Default,,0,0,0,,左侧前线正好处于中央丘正侧面 双方势均力敌
Dialogue: 0,0:11:23.24,0:11:25.44,Default,,0,0,0,,为什么不动 雷土
Dialogue: 0,0:11:25.44,0:11:29.24,Default,,0,0,0,,头儿命令我们不要主动出击
Dialogue: 0,0:11:29.67,0:11:31.04,Default,,0,0,0,,开什么玩笑
Dialogue: 0,0:11:31.04,0:11:33.77,Default,,0,0,0,,桓骑那混蛋 该不是怕了吧
Dialogue: 0,0:11:33.77,0:11:36.01,Default,,0,0,0,,赶紧下令啊 雷土
Dialogue: 0,0:11:37.34,0:11:38.76,Default,,0,0,0,,听到没啊 蠢货
Dialogue: 0,0:11:39.32,0:11:41.27,Default,,0,0,0,,对面也没有动静
Dialogue: 0,0:11:41.88,0:11:43.90,Default,,0,0,0,,应该也是主将有令吧
Dialogue: 0,0:11:44.54,0:11:46.58,Default,,0,0,0,,让我们开杀
Dialogue: 0,0:11:47.01,0:11:50.05,Default,,0,0,0,,泽诺 你的队退到后方去
Dialogue: 0,0:11:50.43,0:11:52.50,Default,,0,0,0,,你们不适合对峙
Dialogue: 0,0:11:53.37,0:11:55.37,Default,,0,0,0,,前方就由我们防守
Dialogue: 0,0:11:56.01,0:11:57.99,Default,,0,0,0,,你瞧不起我们是吧
Dialogue: 0,0:11:57.99,0:12:00.49,Default,,0,0,0,,信不信从你杀起 雷土
Dialogue: 0,0:12:00.86,0:12:01.87,Default,,0,0,0,,雷土
Dialogue: 0,0:12:02.82,0:12:06.17,Default,,0,0,0,,桓骑在想些什么
Dialogue: 0,0:12:08.31,0:12:12.11,Default,,0,0,0,,倒也不是在想什么 应该是在观察
Dialogue: 0,0:12:13.75,0:12:18.34,Default,,0,0,0,,观察要从哪里下手 才能让对手最痛苦
Dialogue: 0,0:12:21.18,0:12:22.92,Default,,0,0,0,,放心等着吧
Dialogue: 0,0:12:23.68,0:12:27.02,Default,,0,0,0,,需要你们发力的时候 一定会到来
Dialogue: 0,0:12:27.96,0:12:31.64,Default,,0,0,0,,那就是我们桓骑军取胜之时
Dialogue: 0,0:12:32.68,0:12:38.20,Default,,0,0,0,,另外 直接关乎黑羊之战胜负的中央丘
Dialogue: 0,0:12:38.91,0:12:44.29,Default,,0,0,0,,第二天 山丘坡面就开始了夺地大战
Dialogue: 0,0:12:45.44,0:12:47.85,Default,,0,0,0,,第三波 出击
Dialogue: 0,0:12:48.70,0:12:50.61,Default,,0,0,0,,给我杀
Dialogue: 0,0:12:50.61,0:12:54.84,Default,,0,0,0,,挥舞你们的正义 去制裁那群人渣强盗
Dialogue: 0,0:12:55.37,0:12:58.67,Default,,0,0,0,,左半边 摩论对阵金毛
Dialogue: 0,0:12:59.12,0:13:03.10,Default,,0,0,0,,刚开战便战况激烈 但势均力敌
Dialogue: 0,0:13:03.53,0:13:05.89,Default,,0,0,0,,前线纹丝不动
Dialogue: 0,0:13:06.39,0:13:11.10,Default,,0,0,0,,而右半边的战斗 则是桓骑军占优势
Dialogue: 0,0:13:11.37,0:13:13.94,Default,,0,0,0,,将前线大幅向前推进
Dialogue: 0,0:13:14.24,0:13:15.86,Default,,0,0,0,,此处的指挥官是…
Dialogue: 0,0:13:21.17,0:13:22.14,Default,,0,0,0,,报
Dialogue: 0,0:13:22.14,0:13:25.72,Default,,0,0,0,,永鬼队 田鬼队 击破敌军 正在前进
Dialogue: 0,0:13:26.50,0:13:29.29,Default,,0,0,0,,上方的太树队也在疯狂推进
Dialogue: 0,0:13:29.60,0:13:33.25,Default,,0,0,0,,下方 中慈队轻松取胜 同样向前推进
Dialogue: 0,0:13:33.56,0:13:35.83,Default,,0,0,0,,把主阵也往前移动
Dialogue: 0,0:13:37.10,0:13:39.51,Default,,0,0,0,,大姐头就是厉害 赢麻了
Dialogue: 0,0:13:39.76,0:13:42.89,Default,,0,0,0,,搞不好我们能直接转一圈打到摩论那里去
Dialogue: 0,0:13:43.00,0:13:44.20,Default,,0,0,0,,开玩笑
Dialogue: 0,0:13:44.48,0:13:45.97,Default,,0,0,0,,别喷口水
Dialogue: 0,0:13:46.21,0:13:47.22,Default,,0,0,0,,急报
Dialogue: 0,0:13:47.76,0:13:50.12,Default,,0,0,0,,外摩老大请求支援
Dialogue: 0,0:13:50.79,0:13:53.35,Default,,0,0,0,,他说不派支援就撤退
Dialogue: 0,0:13:54.28,0:13:55.86,Default,,0,0,0,,那大叔又来啊
Dialogue: 0,0:13:57.56,0:13:58.49,Default,,0,0,0,,累了
Dialogue: 0,0:13:58.49,0:13:59.80,Default,,0,0,0,,援军还没来吗
Dialogue: 0,0:14:01.18,0:14:03.03,Default,,0,0,0,,朝外摩背后放箭
Dialogue: 0,0:14:04.41,0:14:06.49,Default,,0,0,0,,去告诉他 要是他还耍性子
Dialogue: 0,0:14:06.49,0:14:10.18,Default,,0,0,0,,我就直接去砍了他脑袋 那死猪
Dialogue: 0,0:14:11.21,0:14:12.48,Default,,0,0,0,,是
Dialogue: 0,0:14:12.96,0:14:15.04,Default,,0,0,0,,大姐头 又有急报
Dialogue: 0,0:14:15.36,0:14:19.08,Default,,0,0,0,,智春那小子居然摆架子求支援
Dialogue: 0,0:14:19.37,0:14:21.82,Default,,0,0,0,,要对他们背后也射箭吗
Dialogue: 0,0:14:22.65,0:14:25.44,Default,,0,0,0,,加把劲 大家加把劲
Dialogue: 0,0:14:26.61,0:14:28.41,Default,,0,0,0,,派一百人去支援
Dialogue: 0,0:14:29.04,0:14:31.24,Default,,0,0,0,,看脸吗 是看脸的吗
Dialogue: 0,0:14:31.34,0:14:34.52,Default,,0,0,0,,准没错 大姐头每次都这样
Dialogue: 0,0:14:35.16,0:14:38.02,Default,,0,0,0,,报 孙洪连队战败
Dialogue: 0,0:14:38.41,0:14:40.68,Default,,0,0,0,,上方的关陆大人战死
Dialogue: 0,0:14:40.81,0:14:43.58,Default,,0,0,0,,什么？关陆竟被打败了
Dialogue: 0,0:14:43.82,0:14:45.60,Default,,0,0,0,,下方也陷入苦战
Dialogue: 0,0:14:45.60,0:14:47.53,Default,,0,0,0,,不断有人来请求支援
Dialogue: 0,0:14:48.81,0:14:50.05,Default,,0,0,0,,海刚将军
Dialogue: 0,0:14:51.70,0:14:53.27,Default,,0,0,0,,好可怕的敌人
Dialogue: 0,0:14:53.70,0:14:56.27,Default,,0,0,0,,就像看透了我的所有战术一般
Dialogue: 0,0:14:56.27,0:14:58.29,Default,,0,0,0,,让我处处打空 节节败退
Dialogue: 0,0:14:59.12,0:15:02.60,Default,,0,0,0,,战术也不参照兵书 丝毫看不透
Dialogue: 0,0:15:03.05,0:15:07.40,Default,,0,0,0,,区区强盗 为何会如此善战
Dialogue: 0,0:15:08.68,0:15:12.06,Default,,0,0,0,,将军 继续折损兵员会很危险
Dialogue: 0,0:15:13.19,0:15:17.52,Default,,0,0,0,,要不要趁早去向纪彗大人的大部队请求支援
Dialogue: 0,0:15:19.38,0:15:20.77,Default,,0,0,0,,别瞎说
Dialogue: 0,0:15:20.87,0:15:24.15,Default,,0,0,0,,怎能在此处给纪彗大人增添负担
Dialogue: 0,0:15:24.34,0:15:27.66,Default,,0,0,0,,命预备队上前 战斗才刚刚开始
Dialogue: 0,0:15:27.84,0:15:29.49,Default,,0,0,0,,是
Dialogue: 0,0:15:29.82,0:15:32.12,Default,,0,0,0,,大姐头 树海来报
Dialogue: 0,0:15:32.56,0:15:33.94,Default,,0,0,0,,树海？
Dialogue: 0,0:15:34.29,0:15:36.62,Default,,0,0,0,,探子观察发现
Dialogue: 0,0:15:37.01,0:15:41.38,Default,,0,0,0,,右翼的飞信队突破敌军前线 应该能大幅前推
Dialogue: 0,0:15:43.07,0:15:44.32,Default,,0,0,0,,飞信队
Dialogue: 0,0:15:44.55,0:15:45.88,Default,,0,0,0,,那小鬼居然？
Dialogue: 0,0:15:48.60,0:15:50.68,Default,,0,0,0,,我本来没怎么指望他
Dialogue: 0,0:15:51.04,0:15:55.89,Default,,0,0,0,,但他竟然无需我们帮助 就击败了敌军主力级部队
Dialogue: 0,0:15:57.58,0:15:59.92,Default,,0,0,0,,山丘下的隐患也消除了
Dialogue: 0,0:16:00.80,0:16:02.03,Default,,0,0,0,,那就一鼓作气
Dialogue: 0,0:16:02.86,0:16:05.64,Default,,0,0,0,,把对方敌将也杀掉
Dialogue: 0,0:16:06.66,0:16:09.84,Default,,0,0,0,,改变阵型 命蛇暗家上前
Dialogue: 0,0:16:10.50,0:16:13.58,Default,,0,0,0,,我也出战 发起总攻
Dialogue: 0,0:16:16.21,0:16:17.76,Default,,0,0,0,,这 这么快
Dialogue: 0,0:16:17.76,0:16:20.27,Default,,0,0,0,,好嘞 最爱大姐头了
Dialogue: 0,0:16:20.72,0:16:23.05,Default,,0,0,0,,不要给敌人喘息的机会
Dialogue: 0,0:16:37.53,0:16:38.64,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:16:39.27,0:16:40.56,Default,,0,0,0,,是纪彗大人
Dialogue: 0,0:16:41.08,0:16:42.32,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:16:42.47,0:16:43.57,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:16:46.07,0:16:48.32,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:16:52.55,0:16:53.95,Default,,0,0,0,,怎 怎么回事
Dialogue: 0,0:16:55.88,0:16:57.27,Default,,0,0,0,,什 什么？
Dialogue: 0,0:16:57.27,0:16:58.73,Default,,0,0,0,,到底怎么回事
Dialogue: 0,0:16:59.01,0:17:00.47,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:17:00.67,0:17:02.12,Default,,0,0,0,,纪彗大人
Dialogue: 0,0:17:05.61,0:17:07.57,Default,,0,0,0,,只是因为那个人的出现？
Dialogue: 0,0:17:08.64,0:17:12.00,Default,,0,0,0,,总攻取消 叫角云上前
Dialogue: 0,0:17:12.96,0:17:14.37,Default,,0,0,0,,换成防守阵型？
Dialogue: 0,0:17:14.37,0:17:15.26,Default,,0,0,0,,大姐头？
Dialogue: 0,0:17:15.31,0:17:17.26,Default,,0,0,0,,风向要变了
Dialogue: 0,0:17:18.82,0:17:19.77,Default,,0,0,0,,动作快
Dialogue: 0,0:17:26.72,0:17:27.68,Default,,0,0,0,,赵兵
Dialogue: 0,0:17:29.89,0:17:30.53,Default,,0,0,0,,不
Dialogue: 0,0:17:31.36,0:17:33.03,Default,,0,0,0,,离眼的将士们
Dialogue: 0,0:17:36.35,0:17:38.39,Default,,0,0,0,,战斗吧
Dialogue: 0,0:17:47.11,0:17:51.34,Default,,0,0,0,,给我消失吧 侵略者
Dialogue: 0,0:17:54.56,0:17:56.71,Default,,0,0,0,,这 这是怎么回事
Dialogue: 0,0:17:56.91,0:17:59.52,Default,,0,0,0,,只是因为悬崖上来了个人
Dialogue: 0,0:18:00.41,0:18:01.11,Default,,0,0,0,,离眼？
Dialogue: 0,0:18:01.84,0:18:04.53,Default,,0,0,0,,纪 纪彗大人出现了？
Dialogue: 0,0:18:04.53,0:18:05.27,Default,,0,0,0,,是的
Dialogue: 0,0:18:05.48,0:18:06.91,Default,,0,0,0,,纪彗大人居然…
Dialogue: 0,0:18:07.40,0:18:09.74,Default,,0,0,0,,前线的欢呼原来是这个原因
Dialogue: 0,0:18:10.94,0:18:14.53,Default,,0,0,0,,纪彗大人命我们转守为攻
Dialogue: 0,0:18:15.01,0:18:17.08,Default,,0,0,0,,遵命 遵命
Dialogue: 0,0:18:17.33,0:18:20.95,Default,,0,0,0,,解除防守阵型 全军发起总攻
Dialogue: 0,0:18:21.56,0:18:23.46,Default,,0,0,0,,冲啊
Dialogue: 0,0:18:23.46,0:18:24.82,Default,,0,0,0,,杀了侵略者
Dialogue: 0,0:18:24.82,0:18:25.96,Default,,0,0,0,,前进
Dialogue: 0,0:18:26.12,0:18:28.07,Default,,0,0,0,,继续冲
Dialogue: 0,0:18:33.23,0:18:36.09,Default,,0,0,0,,到此为止了 赵国的黄毛小儿
Dialogue: 0,0:18:36.40,0:18:37.34,Default,,0,0,0,,角云
Dialogue: 0,0:18:37.34,0:18:40.15,Default,,0,0,0,,精于防守的「不动」之角云队来了
Dialogue: 0,0:18:40.15,0:18:41.06,Default,,0,0,0,,好
Dialogue: 0,0:18:42.76,0:18:44.87,Default,,0,0,0,,刚才我们一直在赢
Dialogue: 0,0:18:44.87,0:18:48.38,Default,,0,0,0,,我还以为轮不到我们出场了呢 混蛋
Dialogue: 0,0:18:49.27,0:18:50.15,Default,,0,0,0,,靠拢
Dialogue: 0,0:18:50.47,0:18:53.52,Default,,0,0,0,,靠拢 靠拢 靠拢…
Dialogue: 0,0:18:53.86,0:18:57.99,Default,,0,0,0,,就让我用这铜墙铁壁成为扭转劣势的英雄
Dialogue: 0,0:18:58.20,0:19:02.38,Default,,0,0,0,,今晚一定要让美丽的黑樱来我帐中
Dialogue: 0,0:19:07.28,0:19:07.96,Default,,0,0,0,,骑兵？
Dialogue: 0,0:19:08.71,0:19:10.80,Default,,0,0,0,,左边 支援左边
Dialogue: 0,0:19:12.56,0:19:13.76,Default,,0,0,0,,混蛋
Dialogue: 0,0:19:16.53,0:19:19.28,Default,,0,0,0,,骑兵居然能冲下那种陡崖？
Dialogue: 0,0:19:19.28,0:19:20.10,Default,,0,0,0,,这不可能
Dialogue: 0,0:19:20.10,0:19:23.08,Default,,0,0,0,,角 角云队居然被击溃了
Dialogue: 0,0:19:23.24,0:19:25.73,Default,,0,0,0,,话说角云是不是被杀了？
Dialogue: 0,0:19:26.59,0:19:27.83,Default,,0,0,0,,误判了
Dialogue: 0,0:19:28.33,0:19:30.84,Default,,0,0,0,,居然有骑兵能冲下那种陡崖
Dialogue: 0,0:19:31.92,0:19:35.73,Default,,0,0,0,,要对付这个对手 需要重新认识地形才行
Dialogue: 0,0:19:38.19,0:19:39.77,Default,,0,0,0,,这 这边也来了
Dialogue: 0,0:19:40.34,0:19:41.80,Default,,0,0,0,,保护大姐头
Dialogue: 0,0:19:47.62,0:19:49.46,Default,,0,0,0,,好 好强
Dialogue: 0,0:19:53.18,0:19:55.20,Default,,0,0,0,,该死 居然还有
Dialogue: 0,0:19:56.69,0:19:57.50,Default,,0,0,0,,大姐头
Dialogue: 0,0:20:00.58,0:20:02.12,Default,,0,0,0,,大姐头 快点
Dialogue: 0,0:20:05.16,0:20:06.33,Default,,0,0,0,,大姐头
Dialogue: 0,0:20:08.93,0:20:10.36,Default,,0,0,0,,全军撤退
Dialogue: 0,0:20:10.51,0:20:11.46,Default,,0,0,0,,撤退？
Dialogue: 0,0:20:11.46,0:20:12.12,Default,,0,0,0,,全军？
Dialogue: 0,0:20:12.12,0:20:12.90,Default,,0,0,0,,重整旗鼓
Dialogue: 0,0:20:13.40,0:20:15.25,Default,,0,0,0,,鸣退兵锣
Dialogue: 0,0:20:15.25,0:20:17.23,Default,,0,0,0,,去通知上方和下方
Dialogue: 0,0:20:17.52,0:20:20.12,Default,,0,0,0,,头儿 不光是庆舍
Dialogue: 0,0:20:21.04,0:20:24.71,Default,,0,0,0,,敌军中还有一个棘手的家伙
Dialogue: 0,0:20:33.53,0:20:37.82,Default,,0,0,0,,正可谓是一出快如闪电的逆转剧
Dialogue: 0,0:20:38.58,0:20:41.27,Default,,0,0,0,,纪彗出现后 黑樱军后退
Dialogue: 0,0:20:41.55,0:20:46.16,Default,,0,0,0,,反而让纪彗军大幅推进了前线
Dialogue: 0,0:20:48.16,0:20:50.56,Default,,0,0,0,,要说有什么收获 那就是…
Dialogue: 0,0:20:51.27,0:20:56.62,Default,,0,0,0,,多亏黑樱的当机立断 兵员损失并不多
Dialogue: 0,0:20:57.46,0:21:01.51,Default,,0,0,0,,以及 发现了纪彗这个第二大棘手之敌
Dialogue: 0,0:21:09.23,0:21:14.12,Default,,0,0,0,,以中央丘为中心 将战场划分为左右两侧来看
Dialogue: 0,0:21:14.46,0:21:16.78,Default,,0,0,0,,右侧平地的飞信队占据优势
Dialogue: 0,0:21:17.04,0:21:19.19,Default,,0,0,0,,山丘上则是纪彗占据优势
Dialogue: 0,0:21:20.17,0:21:22.36,Default,,0,0,0,,左侧不论平地还是山丘都势均力敌
Dialogue: 0,0:21:22.36,0:21:24.56,Default,,0,0,0,,前线未发生较大变动
Dialogue: 0,0:21:25.69,0:21:27.89,Default,,0,0,0,,黑羊第二天的战斗
Dialogue: 0,0:21:30.61,0:21:34.20,Default,,0,0,0,,以几乎旗鼓相当的形式 落下了帷幕
Dialogue: 0,0:21:39.75,0:21:40.53,Default,,0,0,0,,城主
Dialogue: 0,0:21:50.93,0:21:52.48,Default,,0,0,0,,渕副长
Dialogue: 0,0:21:52.61,0:21:59.42,Default,,0,0,0,,渕副长 渕副长 渕副长
Dialogue: 0,0:21:59.42,0:22:01.87,Default,,0,0,0,,闹过头了吧
Dialogue: 0,0:22:01.87,0:22:04.37,Default,,0,0,0,,这才第二天结束呢
Dialogue: 0,0:22:04.64,0:22:05.76,Default,,0,0,0,,随他们去吧
Dialogue: 0,0:22:06.27,0:22:09.00,Default,,0,0,0,,毕竟是渕叔第一次立头功
Dialogue: 0,0:22:09.72,0:22:12.99,Default,,0,0,0,,而且 也好好报了第一天的仇
Dialogue: 0,0:22:13.22,0:22:16.80,Default,,0,0,0,,还轻松兑现了打到中央丘侧面的承诺
Dialogue: 0,0:22:17.13,0:22:18.10,Default,,0,0,0,,是啊
Dialogue: 0,0:22:18.98,0:22:20.23,Default,,0,0,0,,明天怎么办
Dialogue: 0,0:22:20.83,0:22:23.80,Default,,0,0,0,,桓骑将军没有来命令
Dialogue: 0,0:22:23.80,0:22:25.80,Default,,0,0,0,,明天主要就是继续推进前线
Dialogue: 0,0:22:26.00,0:22:28.91,Default,,0,0,0,,巩固右侧战场的优势
Dialogue: 0,0:22:29.46,0:22:31.90,Default,,0,0,0,,河了貂 帐篷扎好了
Dialogue: 0,0:22:32.33,0:22:33.26,Default,,0,0,0,,谢了
Dialogue: 0,0:22:33.26,0:22:34.17,Default,,0,0,0,,不谢
Dialogue: 0,0:22:37.31,0:22:37.90,Default,,0,0,0,,貂
Dialogue: 0,0:22:39.60,0:22:41.68,Default,,0,0,0,,羌瘣还没有回来
Dialogue: 0,0:22:42.67,0:22:44.68,Default,,0,0,0,,问了俘虏的敌兵
Dialogue: 0,0:22:45.42,0:22:48.25,Default,,0,0,0,,也没人听说她被俘了
Dialogue: 0,0:22:50.08,0:22:50.68,Default,,0,0,0,,嗯
Dialogue: 0,0:22:51.18,0:22:54.29,Default,,0,0,0,,明天要是继续推进了战线 就派出搜索队吧
Dialogue: 0,0:22:54.65,0:22:55.23,Default,,0,0,0,,好
Dialogue: 0,0:23:03.35,0:23:03.98,Default,,0,0,0,,村长
Dialogue: 0,0:23:04.71,0:23:07.31,Default,,0,0,0,,混阿婆 她是不是死了
Dialogue: 0,0:23:08.24,0:23:08.95,Default,,0,0,0,,没有
Dialogue: 0,0:23:12.49,0:23:14.49,Default,,0,0,0,,还有呼吸
Dialogue: 0,0:24:49.89,0:24:51.70,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:52.12,0:24:53.96,Default,,0,0,0,,「黑羊关键之战」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

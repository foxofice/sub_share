Dialogue: 0,0:00:04.02,0:00:06.94,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#11 第二次选拔猜拳
Dialogue: 1,0:00:00.76,0:00:03.97,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:00:04.68,0:00:06.64,CN,,0,0,0,,洁第一个走了
Dialogue: 1,0:00:06.64,0:00:08.23,CN,,0,0,0,,下一个猜拳决定？
Dialogue: 1,0:00:08.23,0:00:10.90,CN,,0,0,0,,我我 下一个到我
Dialogue: 1,0:00:10.90,0:00:12.57,CN,,0,0,0,,啊？到我啊
Dialogue: 1,0:00:12.57,0:00:13.53,CN,,0,0,0,,我
Dialogue: 1,0:00:13.53,0:00:14.53,CN,,0,0,0,,我
Dialogue: 1,0:00:14.53,0:00:15.57,CN,,0,0,0,,到我
Dialogue: 1,0:00:15.57,0:00:17.03,CN,,0,0,0,,千切呢？
Dialogue: 1,0:00:17.03,0:00:19.61,CN,,0,0,0,,谁先去都没差吧
Dialogue: 1,0:00:20.45,0:00:23.54,CN,,0,0,0,,这种时候的自我主义也有可能被看在眼里的啊
Dialogue: 1,0:00:23.54,0:00:24.66,Ruby,,0,0,0,,{\pos(960,975)}Lock off
Dialogue: 1,0:00:23.54,0:00:24.66,CN,,0,0,0,,滚啦
Dialogue: 1,0:00:24.66,0:00:27.50,CN,,0,0,0,,足球和猜拳都要当个利己主义者
Dialogue: 1,0:00:27.50,0:00:28.42,Ruby,,0,0,0,,{\pos(960,975)}Lock off
Dialogue: 1,0:00:27.50,0:00:28.42,CN,,0,0,0,,滚
Dialogue: 1,0:00:28.42,0:00:31.00,CN,,0,0,0,,一点都不像绘心
Dialogue: 1,0:00:31.00,0:00:33.00,CN,,0,0,0,,那一起来猜拳吧
Dialogue: 1,0:00:33.00,0:00:35.80,CN,,0,0,0,,石头剪刀布
Dialogue: 1,0:00:35.80,0:00:37.88,CN,,0,0,0,,啊 我赢了
Dialogue: 1,0:00:38.22,0:00:39.51,CN,,0,0,0,,那我第一个
Dialogue: 1,0:00:39.51,0:00:40.89,CN,,0,0,0,,为什么啊
Dialogue: 1,0:00:40.89,0:00:42.22,Ruby,,0,0,0,,{\pos(960,975)}Lock off
Dialogue: 1,0:00:40.89,0:00:42.22,CN,,0,0,0,,滚
Dialogue: 1,0:00:42.22,0:00:44.51,CN,,0,0,0,,好啦 来决定下一个
Dialogue: 1,0:00:44.51,0:00:45.60,CN,,0,0,0,,耶
Dialogue: 1,0:00:45.60,0:00:46.68,CN,,0,0,0,,好
Dialogue: 1,0:00:46.68,0:00:47.89,CN,,0,0,0,,先走一步
Dialogue: 1,0:00:47.89,0:00:49.14,CN,,0,0,0,,哦 赢了
Dialogue: 1,0:00:52.77,0:00:55.78,CN,,0,0,0,,为毛啊
Dialogue: 0,0:00:00.76,0:00:03.97,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:00:04.68,0:00:06.64,JP,,0,0,0,,潔が一番に行っちゃったけど
Dialogue: 0,0:00:06.64,0:00:08.23,JP,,0,0,0,,次はじゃんけんで決める？
Dialogue: 0,0:00:08.23,0:00:10.90,JP,,0,0,0,,はいはい　次　俺が行く
Dialogue: 0,0:00:10.90,0:00:12.57,JP,,0,0,0,,はあ？俺だろ
Dialogue: 0,0:00:12.57,0:00:13.53,JP,,0,0,0,,俺
Dialogue: 0,0:00:13.53,0:00:14.53,JP,,0,0,0,,俺
Dialogue: 0,0:00:14.53,0:00:15.57,JP,,0,0,0,,俺だ
Dialogue: 0,0:00:15.57,0:00:17.03,JP,,0,0,0,,千切は？
Dialogue: 0,0:00:17.03,0:00:19.61,JP,,0,0,0,,入る順が何か変わるわけじゃないだろ
Dialogue: 0,0:00:20.45,0:00:23.54,JP,,0,0,0,,こういうところのエゴさも評価されるかもしれないのに
Dialogue: 0,0:00:23.54,0:00:24.66,JP,,0,0,0,,ロック・オフだ
Dialogue: 0,0:00:24.66,0:00:27.50,JP,,0,0,0,,じゃんけんもサッカーもエゴイストであれ
Dialogue: 0,0:00:27.50,0:00:28.42,JP,,0,0,0,,ロック・オフ
Dialogue: 0,0:00:28.42,0:00:31.00,JP,,0,0,0,,絵心のモノマネ似てねえ
Dialogue: 0,0:00:31.00,0:00:33.00,JP,,0,0,0,,じゃあ　もう全員でやるよ
Dialogue: 0,0:00:33.00,0:00:35.80,JP,,0,0,0,,じゃん　けん　ぽん
Dialogue: 0,0:00:35.80,0:00:37.88,JP,,0,0,0,,あっ　勝った
Dialogue: 0,0:00:38.22,0:00:39.51,JP,,0,0,0,,じゃあ　一番で
Dialogue: 0,0:00:39.51,0:00:40.89,JP,,0,0,0,,なんでだよ
Dialogue: 0,0:00:40.89,0:00:42.22,JP,,0,0,0,,ロック・オフ
Dialogue: 0,0:00:42.22,0:00:44.51,JP,,0,0,0,,はい　次の人決めるよ
Dialogue: 0,0:00:44.51,0:00:45.60,JP,,0,0,0,,イェイ
Dialogue: 0,0:00:45.60,0:00:46.68,JP,,0,0,0,,うっし
Dialogue: 0,0:00:46.68,0:00:47.89,JP,,0,0,0,,お先
Dialogue: 0,0:00:47.89,0:00:49.14,JP,,0,0,0,,おっ　勝った
Dialogue: 0,0:00:52.77,0:00:55.78,JP,,0,0,0,,なんでだよ

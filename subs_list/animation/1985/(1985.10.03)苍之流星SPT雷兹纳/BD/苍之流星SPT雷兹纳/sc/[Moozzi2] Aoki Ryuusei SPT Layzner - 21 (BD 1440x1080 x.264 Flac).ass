Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:03.20,0:01:08.35,Layzner,,0,0,0,,可是你却存于我的意料之外
Dialogue: 0,0:01:03.20,0:01:08.35,Layzner,,0,0,0,,这个驾驶舱就是我的世界
Dialogue: 0,0:01:08.85,0:01:10.39,Layzner,,0,0,0,,每次叫你也不回答我
Dialogue: 0,0:01:47.15,0:01:48.95,Layzner,,0,0,0,,怎么回事
Dialogue: 0,0:01:53.98,0:01:56.95,Layzner,,0,0,0,,所以我早就说不要乱碰他
Dialogue: 0,0:01:57.07,0:01:59.30,Layzner,,0,0,0,,发生了意想不到的事
Dialogue: 0,0:01:59.30,0:02:03.61,Layzner,,0,0,0,,雷兹纳上明明没有搭乘者却开始失控了
Dialogue: 0,0:02:03.61,0:02:07.89,Layzner,,0,0,0,,简直就像是它自己有意识
Dialogue: 0,0:02:07.89,0:02:10.23,Layzner,,0,0,0,,雷 这次你不能再说不知道了
Dialogue: 0,0:02:10.23,0:02:15.23,Layzner,,0,0,0,,第二十一集 我的名字叫弗隆
Dialogue: 0,0:02:37.00,0:02:41.75,Layzner,,0,0,0,,我跟以前一样
Dialogue: 0,0:02:41.75,0:02:44.45,Layzner,,0,0,0,,一看到英二的背影心就会一阵悸动
Dialogue: 0,0:02:45.20,0:02:48.18,Layzner,,0,0,0,,我也知道西蒙尼也喜欢英二
Dialogue: 0,0:02:48.18,0:02:50.83,Layzner,,0,0,0,,可是我却对持有 不想输给她 这种想法
Dialogue: 0,0:02:50.83,0:02:54.17,Layzner,,0,0,0,,的我感到惊讶
Dialogue: 0,0:02:54.17,0:03:00.30,Layzner,,0,0,0,,英二在我心中占据的位置与以前大不相同
Dialogue: 0,0:02:54.17,0:03:00.30,Layzner,,0,0,0,,才几个小时没见
Dialogue: 0,0:03:00.30,0:03:02.30,Layzner,,0,0,0,,他对我来说变得很重要
Dialogue: 0,0:03:07.66,0:03:12.17,Layzner,,0,0,0,,我还有事要问你们 不好意思请跟我回调查室
Dialogue: 0,0:03:33.31,0:03:35.77,Layzner,,0,0,0,,雷 叫另一台电脑出来
Dialogue: 0,0:03:35.77,0:03:38.03,Layzner,,0,0,0,,提问意义不明
Dialogue: 0,0:03:38.44,0:03:43.47,Layzner,,0,0,0,,雷 我知道有另一部电脑也搭在雷兹纳上
Dialogue: 0,0:03:43.63,0:03:48.45,Layzner,,0,0,0,,搭载在雷兹纳的电脑名称 SAI200
Dialogue: 0,0:03:48.45,0:03:51.96,Layzner,,0,0,0,,我不是在问你 叫另一部电脑出来
Dialogue: 0,0:03:51.96,0:03:53.93,Layzner,,0,0,0,,没有记载 没有记录
Dialogue: 0,0:03:54.15,0:03:57.48,Layzner,,0,0,0,,即使没有记录但还是存在 卸下你的隐藏身份吧
Dialogue: 0,0:03:57.74,0:03:58.78,Layzner,,0,0,0,,不可能
Dialogue: 0,0:03:58.78,0:04:03.92,Layzner,,0,0,0,,给我走开 我知道还有另一台电脑 不会有错 这是命令
Dialogue: 0,0:04:04.06,0:04:09.31,Layzner,,0,0,0,,请看 这是国防部公开发表的外星战斗用机器人的模样
Dialogue: 0,0:04:09.31,0:04:15.35,Layzner,,0,0,0,,这次经历的是世界最大的危机
Dialogue: 0,0:04:09.31,0:04:15.35,Layzner,,0,0,0,,我们自美国建国以来 不 是自人类诞生以来
Dialogue: 0,0:04:15.35,0:04:20.26,Layzner,,0,0,0,,我们的敌人是来自离太阳系很远的智慧生命体
Dialogue: 0,0:04:20.75,0:04:25.63,Layzner,,0,0,0,,插播一则临时新闻 荷兰的总统在13时20分
Dialogue: 0,0:04:25.63,0:04:28.48,Layzner,,0,0,0,,对荷兰全国下了戒严令
Dialogue: 0,0:04:28.48,0:04:31.67,Layzner,,0,0,0,,政府也可能很快就会下令
Dialogue: 0,0:04:31.67,0:04:36.43,Layzner,,0,0,0,,请各位国民提高警惕 并随时注意新闻
Dialogue: 0,0:04:36.43,0:04:40.30,Layzner,,0,0,0,,对突然出现的外星人
Dialogue: 0,0:04:40.30,0:04:42.97,Layzner,,0,0,0,,伊丽莎白 你还好吗 不回基地也没关系
Dialogue: 0,0:04:44.00,0:04:46.18,Layzner,,0,0,0,,我的任务已经完成了
Dialogue: 0,0:04:47.04,0:04:49.25,Layzner,,0,0,0,,战事是否会一触即发呢
Dialogue: 0,0:04:49.87,0:04:53.88,Layzner,,0,0,0,,接下来把镜头带到白宫
Dialogue: 0,0:04:55.06,0:04:55.78,Layzner,,0,0,0,,来了
Dialogue: 0,0:04:58.80,0:04:59.97,Layzner,,0,0,0,,是伊丽莎白博士吗
Dialogue: 0,0:04:59.97,0:05:00.89,Layzner,,0,0,0,,是
Dialogue: 0,0:05:00.89,0:05:02.89,Layzner,,0,0,0,,有事情想问你
Dialogue: 0,0:05:02.89,0:05:06.07,Layzner,,0,0,0,,请到艾德华空军基地
Dialogue: 0,0:05:06.87,0:05:09.67,Layzner,,0,0,0,,亲爱的合众国人民们
Dialogue: 0,0:05:09.67,0:05:13.98,Layzner,,0,0,0,,我们现在正面临意料外的危机
Dialogue: 0,0:05:14.69,0:05:16.40,Layzner,,0,0,0,,我们这数十年来
Dialogue: 0,0:05:16.40,0:05:18.40,Layzner,,0,0,0,,从现在起 会变成什么样呢
Dialogue: 0,0:05:18.40,0:05:22.14,Layzner,,0,0,0,,没问题的亚瑟 妈妈在你身边
Dialogue: 0,0:05:22.56,0:05:26.50,Layzner,,0,0,0,,回国后就让你跟格兰多男爵的女儿见面
Dialogue: 0,0:05:27.22,0:05:30.23,Layzner,,0,0,0,,她好像很喜欢去火星的你
Dialogue: 0,0:05:30.53,0:05:32.65,Layzner,,0,0,0,,妈妈 我在那里还有作战呢
Dialogue: 0,0:05:32.65,0:05:35.44,Layzner,,0,0,0,,真的吗 亚瑟你好棒哦
Dialogue: 0,0:05:41.50,0:05:43.00,Layzner,,0,0,0,,你说亚瑟·卡明斯对吧
Dialogue: 0,0:05:43.00,0:05:45.00,Layzner,,0,0,0,,对 请问您是哪一位
Dialogue: 0,0:05:45.71,0:05:47.71,Layzner,,0,0,0,,我是艾德华空军基地的人
Dialogue: 0,0:05:47.71,0:05:50.82,Layzner,,0,0,0,,想请你再回去一趟
Dialogue: 0,0:05:50.93,0:05:53.84,Layzner,,0,0,0,,你在说什么啊
Dialogue: 0,0:05:53.84,0:05:57.03,Layzner,,0,0,0,,再过一小时我们就要出发了
Dialogue: 0,0:05:57.03,0:05:58.85,Layzner,,0,0,0,,走吧 车在外面等你了
Dialogue: 0,0:05:59.24,0:06:05.23,Layzner,,0,0,0,,你怎么这么无礼 亚瑟 不要 不要去 亚瑟
Dialogue: 0,0:06:42.36,0:06:44.11,Layzner,,0,0,0,,他们是哪里的大官
Dialogue: 0,0:06:44.11,0:06:47.67,Layzner,,0,0,0,,里面是加拿大国防部技术处少校 另一位是情报处少校
Dialogue: 0,0:06:48.05,0:06:50.73,Layzner,,0,0,0,,最后那一位好像也是情报处少校
Dialogue: 0,0:07:00.08,0:07:01.61,Layzner,,0,0,0,,好棒
Dialogue: 0,0:07:03.67,0:07:05.21,Layzner,,0,0,0,,这次是谁
Dialogue: 0,0:07:05.21,0:07:08.20,Layzner,,0,0,0,,是我的客人 好像也是从哪里来的大官
Dialogue: 0,0:07:36.14,0:07:39.11,Layzner,,0,0,0,,雷兹纳搭载的电脑确实只有我
Dialogue: 0,0:07:39.11,0:07:41.11,Layzner,,0,0,0,,我没问你这个
Dialogue: 0,0:07:41.11,0:07:44.06,Layzner,,0,0,0,,快跟另一部电脑联络
Dialogue: 0,0:07:44.06,0:07:45.92,Layzner,,0,0,0,,无法理解你的问题的意思
Dialogue: 0,0:07:46.06,0:07:47.38,Layzner,,0,0,0,,可恶
Dialogue: 0,0:07:51.45,0:07:53.58,Layzner,,0,0,0,,我就直说了
Dialogue: 0,0:07:53.58,0:07:55.65,Layzner,,0,0,0,,我们能不能拥有
Dialogue: 0,0:07:55.65,0:07:58.10,Layzner,,0,0,0,,藏在三架机器人里的秘密
Dialogue: 0,0:07:59.17,0:08:02.39,Layzner,,0,0,0,,总统也很关心这问题
Dialogue: 0,0:08:03.45,0:08:08.29,Layzner,,0,0,0,,不管怎么说他们的战斗力真的很可怕
Dialogue: 0,0:08:08.86,0:08:10.94,Layzner,,0,0,0,,先不管那机器人失控的原因
Dialogue: 0,0:08:10.94,0:08:13.70,Layzner,,0,0,0,,要先知道那东西是不是我们可以操纵的
Dialogue: 0,0:08:13.89,0:08:15.76,Layzner,,0,0,0,,还是能不能设法去了解的
Dialogue: 0,0:08:17.17,0:08:22.30,Layzner,,0,0,0,,你知道就算没有地域的交流但还是可以产生相似的文明吗
Dialogue: 0,0:08:22.95,0:08:24.89,Layzner,,0,0,0,,你说的是文明电波对吧
Dialogue: 0,0:08:25.39,0:08:27.62,Layzner,,0,0,0,,这次不就是这样吗
Dialogue: 0,0:08:28.23,0:08:30.51,Layzner,,0,0,0,,这次的东西
Dialogue: 0,0:08:30.51,0:08:33.23,Layzner,,0,0,0,,在技术上虽然跟我们不同
Dialogue: 0,0:08:33.64,0:08:36.54,Layzner,,0,0,0,,可是设计思路却跟我们一样
Dialogue: 0,0:08:36.54,0:08:40.64,Layzner,,0,0,0,,也对 要不然也生不出那混血儿
Dialogue: 0,0:08:42.76,0:08:46.48,Layzner,,0,0,0,,那么要想的是
Dialogue: 0,0:08:46.63,0:08:48.51,Layzner,,0,0,0,,我们能模仿他们的技术到什么程度
Dialogue: 0,0:08:48.82,0:08:50.09,Layzner,,0,0,0,,可以这么想
Dialogue: 0,0:08:50.82,0:08:54.63,Layzner,,0,0,0,,这里有X射线检查跟金属探测器做成的幻灯片
Dialogue: 0,0:08:54.88,0:08:57.13,Layzner,,0,0,0,,请先看这东西后再判断
Dialogue: 0,0:09:05.04,0:09:09.78,Layzner,,0,0,0,,机体中枢的这里 不管怎么都照不出来
Dialogue: 0,0:09:09.78,0:09:13.21,Layzner,,0,0,0,,然后刚一想解开这个谜
Dialogue: 0,0:09:13.24,0:09:17.13,Layzner,,0,0,0,,他就暴走失控了 另外两架呢
Dialogue: 0,0:09:17.69,0:09:19.07,Layzner,,0,0,0,,没有不明处
Dialogue: 0,0:09:24.66,0:09:29.74,Layzner,,0,0,0,,好 我知道了 既然你这样的话 我也有觉悟
Dialogue: 0,0:09:42.60,0:09:44.26,Layzner,,0,0,0,,把枪借我
Dialogue: 0,0:09:44.26,0:09:47.57,Layzner,,0,0,0,,什么 不行 不说明原因不能借
Dialogue: 0,0:09:48.19,0:09:50.25,Layzner,,0,0,0,,我要解开他失控的原因
Dialogue: 0,0:09:51.00,0:09:53.25,Layzner,,0,0,0,,为什么这样就要用到枪
Dialogue: 0,0:09:53.78,0:09:57.69,Layzner,,0,0,0,,现在没时间说明 总之把枪借我
Dialogue: 0,0:09:57.85,0:09:58.55,Layzner,,0,0,0,,不行
Dialogue: 0,0:09:59.10,0:10:02.02,Layzner,,0,0,0,,指挥官 不如把枪借给他如何
Dialogue: 0,0:10:02.47,0:10:05.00,Layzner,,0,0,0,,只有一支枪他也不能干什么
Dialogue: 0,0:10:05.38,0:10:07.28,Layzner,,0,0,0,,有事我负责
Dialogue: 0,0:10:07.53,0:10:08.38,Layzner,,0,0,0,,你是谁
Dialogue: 0,0:10:09.06,0:10:11.22,Layzner,,0,0,0,,我是联合国宇宙局的约翰·基鲁巴特
Dialogue: 0,0:10:11.81,0:10:14.31,Layzner,,0,0,0,,约翰·基鲁巴特 那你是
Dialogue: 0,0:10:14.31,0:10:16.98,Layzner,,0,0,0,,那等会再说吧 通信器借我
Dialogue: 0,0:10:17.25,0:10:18.98,Layzner,,0,0,0,,我直接和你们的司令官说
Dialogue: 0,0:10:19.72,0:10:24.68,Layzner,,0,0,0,,不 不用了 因为接下来就不是我的责任了
Dialogue: 0,0:10:26.28,0:10:27.50,Layzner,,0,0,0,,没错
Dialogue: 0,0:10:31.53,0:10:35.50,Layzner,,0,0,0,,在这样的情况下见面虽然有些不好意思 但请尽快解决
Dialogue: 0,0:10:37.37,0:10:38.58,Layzner,,0,0,0,,不好意思
Dialogue: 0,0:10:48.15,0:10:51.93,Layzner,,0,0,0,,明白了吗 雷 现在我正拿枪对着你
Dialogue: 0,0:10:51.93,0:10:53.88,Layzner,,0,0,0,,无法理解你的行动
Dialogue: 0,0:10:53.95,0:10:57.22,Layzner,,0,0,0,,雷 跟你讲也不明白
Dialogue: 0,0:10:57.62,0:11:01.63,Layzner,,0,0,0,,快 给我出来吧 不要一直躲在雷的后面
Dialogue: 0,0:11:01.63,0:11:04.30,Layzner,,0,0,0,,无法理解问题的意思
Dialogue: 0,0:11:04.58,0:11:10.62,Layzner,,0,0,0,,我说不定会因你的态度连雷一起毁掉
Dialogue: 0,0:11:04.58,0:11:10.62,Layzner,,0,0,0,,我不是拿这枪吓你的
Dialogue: 0,0:11:10.78,0:11:12.75,Layzner,,0,0,0,,无法理解你的行动
Dialogue: 0,0:11:11.72,0:11:12.75,Layzner,,0,0,0,,雷 啰嗦
Dialogue: 0,0:11:15.34,0:11:19.34,Layzner,,0,0,0,,经历艰辛好不容易才到地球的我们
Dialogue: 0,0:11:19.34,0:11:23.68,Layzner,,0,0,0,,无法容忍你的态度 这个驾驶舱就是我的世界
Dialogue: 0,0:11:24.00,0:11:28.98,Layzner,,0,0,0,,可是你却存在于我的意料之外 每次叫你都不回答我
Dialogue: 0,0:11:31.15,0:11:32.23,Layzner,,0,0,0,,回答我
Dialogue: 0,0:11:34.49,0:11:35.81,Layzner,,0,0,0,,不回答我就开枪了
Dialogue: 0,0:11:37.09,0:11:38.03,Layzner,,0,0,0,,要开枪了
Dialogue: 0,0:11:40.71,0:11:41.46,Layzner,,0,0,0,,第二枪
Dialogue: 0,0:11:41.82,0:11:43.62,Layzner,,0,0,0,,无法理解你的行动
Dialogue: 0,0:11:43.62,0:11:44.75,Layzner,,0,0,0,,第三枪
Dialogue: 0,0:11:44.11,0:11:46.92,Layzner,,0,0,0,,无法理解你的行动
Dialogue: 0,0:11:46.92,0:11:51.65,Layzner,,0,0,0,,等一下 英二 不要对我发怒
Dialogue: 0,0:11:52.27,0:11:55.18,Layzner,,0,0,0,,我会被搭载在这雷兹纳上
Dialogue: 0,0:11:55.18,0:11:58.96,Layzner,,0,0,0,,还有你会搭乘雷兹纳
Dialogue: 0,0:11:58.96,0:12:02.56,Layzner,,0,0,0,,都是你爸爸的意思
Dialogue: 0,0:12:02.87,0:12:04.42,Layzner,,0,0,0,,我的爸爸
Dialogue: 0,0:12:04.68,0:12:07.13,Layzner,,0,0,0,,对 我的名字是弗隆
Dialogue: 0,0:12:07.49,0:12:08.63,Layzner,,0,0,0,,弗隆
Dialogue: 0,0:12:19.93,0:12:20.47,Layzner,,0,0,0,,弗隆
Dialogue: 0,0:12:20.77,0:12:21.66,Layzner,,0,0,0,,没错
Dialogue: 0,0:12:22.30,0:12:26.57,Layzner,,0,0,0,,为什么 为什么爸爸要我坐上这架雷兹纳
Dialogue: 0,0:12:26.72,0:12:28.57,Layzner,,0,0,0,,为了和平
Dialogue: 0,0:12:28.57,0:12:33.77,Layzner,,0,0,0,,把古拉特斯重大的秘密寄托在被送到地球的你身上
Dialogue: 0,0:12:33.93,0:12:36.90,Layzner,,0,0,0,,那是什么 重大的秘密是什么
Dialogue: 0,0:12:37.18,0:12:40.77,Layzner,,0,0,0,,是在古拉特斯里只有少数高层人士才知道的
Dialogue: 0,0:12:40.77,0:12:42.83,Layzner,,0,0,0,,古拉特斯诞生的秘密
Dialogue: 0,0:12:43.08,0:12:44.27,Layzner,,0,0,0,,古拉特斯诞生的秘密
Dialogue: 0,0:13:11.48,0:13:13.06,Layzner,,0,0,0,,博士 请回来
Dialogue: 0,0:13:13.95,0:13:15.78,Layzner,,0,0,0,,不用担心 我马上回来
Dialogue: 0,0:13:16.88,0:13:17.78,Layzner,,0,0,0,,博士
Dialogue: 0,0:13:25.87,0:13:26.52,Layzner,,0,0,0,,英二
Dialogue: 0,0:13:28.66,0:13:32.61,Layzner,,0,0,0,,怎么了 飞鸟英二 英二
Dialogue: 0,0:13:35.40,0:13:37.08,Layzner,,0,0,0,,你怎么了 英二
Dialogue: 0,0:13:42.26,0:13:44.85,Layzner,,0,0,0,,基鲁巴特博士 我知道了一件重要的事
Dialogue: 0,0:13:45.31,0:13:48.33,Layzner,,0,0,0,,请让我把父亲的口讯传给地球人
Dialogue: 0,0:13:49.17,0:13:50.97,Layzner,,0,0,0,,飞鸟健的口讯是吗
Dialogue: 0,0:13:51.42,0:13:53.15,Layzner,,0,0,0,,是的 现在马上
Dialogue: 0,0:13:57.25,0:14:00.77,Layzner,,0,0,0,,他说要传达重大情报 怎么样
Dialogue: 0,0:14:01.33,0:14:02.41,Layzner,,0,0,0,,重大情报
Dialogue: 0,0:14:05.41,0:14:08.88,Layzner,,0,0,0,,就听听那少年怎么说吧
Dialogue: 0,0:14:09.44,0:14:12.90,Layzner,,0,0,0,,说不定是对我们在作战方面有利的情报
Dialogue: 0,0:14:13.14,0:14:16.77,Layzner,,0,0,0,,希望如此 总之有听一下的价值吧
Dialogue: 0,0:14:17.50,0:14:19.78,Layzner,,0,0,0,,怎么说 他都是从宇宙来通报我们的呢
Dialogue: 0,0:14:20.86,0:14:22.25,Layzner,,0,0,0,,好 帮他准备一下
Dialogue: 0,0:14:28.99,0:14:31.86,Layzner,,0,0,0,,基地里又产生重大骚动了
Dialogue: 0,0:14:32.69,0:14:36.68,Layzner,,0,0,0,,英二说的重要的事到底是什么
Dialogue: 0,0:14:37.80,0:14:39.98,Layzner,,0,0,0,,怎么样 可以收到声音吗
Dialogue: 0,0:14:39.98,0:14:42.14,Layzner,,0,0,0,,是 应该没问题
Dialogue: 0,0:14:42.81,0:14:46.39,Layzner,,0,0,0,,藏在雷兹纳里的秘密是什么
Dialogue: 0,0:14:53.03,0:14:54.64,Layzner,,0,0,0,,英二出现了
Dialogue: 0,0:14:56.10,0:14:57.84,Layzner,,0,0,0,,今天以特别节目的方式
Dialogue: 0,0:14:57.84,0:15:02.70,Layzner,,0,0,0,,播放目前在艾德华基地从宇宙来的少年所带来的信息
Dialogue: 0,0:15:04.86,0:15:10.69,Layzner,,0,0,0,,只有内心的不安一直在增加
Dialogue: 0,0:15:04.86,0:15:10.69,Layzner,,0,0,0,,什么都不知道 什么都不能做的我
Dialogue: 0,0:15:12.61,0:15:14.19,Layzner,,0,0,0,,伊丽莎白博士
Dialogue: 0,0:15:14.19,0:15:16.94,Layzner,,0,0,0,,还有亚瑟 这是怎么回事
Dialogue: 0,0:15:17.17,0:15:20.42,Layzner,,0,0,0,,真令人生气 又被这基地的人叫回来了
Dialogue: 0,0:15:21.15,0:15:23.98,Layzner,,0,0,0,,原因是雷兹纳自己动起来了
Dialogue: 0,0:15:24.49,0:15:27.48,Layzner,,0,0,0,,大家 英二要说话了
Dialogue: 0,0:15:28.25,0:15:29.60,Layzner,,0,0,0,,全世界的各位
Dialogue: 0,0:15:29.60,0:15:35.98,Layzner,,0,0,0,,而把我送到地球
Dialogue: 0,0:15:29.60,0:15:35.98,Layzner,,0,0,0,,我的父亲飞鸟健为了要避免地球人跟古拉特斯人的战争
Dialogue: 0,0:15:36.97,0:15:41.02,Layzner,,0,0,0,,以现在地球的实力是赢不了古拉特斯的
Dialogue: 0,0:15:42.36,0:15:45.98,Layzner,,0,0,0,,如果硬要打的话 只会一直产生牺牲者而已
Dialogue: 0,0:15:46.46,0:15:49.80,Layzner,,0,0,0,,所以与其无谓战斗
Dialogue: 0,0:15:49.80,0:15:51.36,Layzner,,0,0,0,,不如向古拉特斯投降比较好
Dialogue: 0,0:15:54.14,0:15:56.91,Layzner,,0,0,0,,笨蛋 说什么呢
Dialogue: 0,0:16:00.57,0:16:03.52,Layzner,,0,0,0,,可是各位 请听我说
Dialogue: 0,0:16:03.76,0:16:05.73,Layzner,,0,0,0,,就算是投降
Dialogue: 0,0:16:05.73,0:16:07.21,Layzner,,0,0,0,,古拉特斯人和地球人
Dialogue: 0,0:16:07.21,0:16:08.38,Layzner,,0,0,0,,去死
Dialogue: 0,0:16:18.42,0:16:20.44,Layzner,,0,0,0,,去死 可恶的古拉特斯人
Dialogue: 0,0:16:20.44,0:16:22.86,Layzner,,0,0,0,,可恶 不要看不起我们地球人
Dialogue: 0,0:16:22.86,0:16:23.98,Layzner,,0,0,0,,干掉他
Dialogue: 0,0:16:25.69,0:16:26.69,Layzner,,0,0,0,,等一下
Dialogue: 0,0:16:26.98,0:16:28.86,Layzner,,0,0,0,,我是古拉特斯人跟地球人的
Dialogue: 0,0:16:30.43,0:16:31.65,Layzner,,0,0,0,,杀死他
Dialogue: 0,0:16:36.89,0:16:39.98,Layzner,,0,0,0,,请下达命令
Dialogue: 0,0:16:39.98,0:16:43.76,Layzner,,0,0,0,,不下达命令的话我就得为了保护自己不得不战斗
Dialogue: 0,0:16:44.02,0:16:45.67,Layzner,,0,0,0,,脱离 快脱离
Dialogue: 0,0:16:45.67,0:16:46.30,Layzner,,0,0,0,,了解
Dialogue: 0,0:16:55.17,0:16:58.21,Layzner,,0,0,0,,不用说了 你就再耍你的猴戏吧
Dialogue: 0,0:17:05.25,0:17:07.85,Layzner,,0,0,0,,他太不了解地球人了
Dialogue: 0,0:17:08.44,0:17:12.47,Layzner,,0,0,0,,有时会为了荣誉而死是人类的优点
Dialogue: 0,0:17:13.31,0:17:17.29,Layzner,,0,0,0,,可是他的言语 在维持和平的前提下
Dialogue: 0,0:17:17.29,0:17:20.00,Layzner,,0,0,0,,却伤了人类 地球人的自尊
Dialogue: 0,0:17:25.18,0:17:28.40,Layzner,,0,0,0,,要逃到哪里 请下令
Dialogue: 0,0:17:31.28,0:17:35.97,Layzner,,0,0,0,,就这样去见古雷斯库
Dialogue: 0,0:17:31.28,0:17:35.97,Layzner,,0,0,0,,去航天飞机那 先逃脱到宇宙空间
Dialogue: 0,0:17:35.99,0:17:36.58,Layzner,,0,0,0,,了解
Dialogue: 0,0:17:38.55,0:17:40.39,Layzner,,0,0,0,,不好了 他要去抢那航天飞机
Dialogue: 0,0:17:45.96,0:17:51.73,Layzner,,0,0,0,,还有数名工作人员都在里面 无法镇压
Dialogue: 0,0:17:45.96,0:17:51.73,Layzner,,0,0,0,,航天飞机被占领了  机器人和飞行员
Dialogue: 0,0:17:59.00,0:18:01.84,Layzner,,0,0,0,,我设为自动操纵了 这样就行了吗
Dialogue: 0,0:18:02.25,0:18:06.21,Layzner,,0,0,0,,我的雷兹纳会透过这头盔来操纵 所以请你们不要动它
Dialogue: 0,0:18:07.02,0:18:08.32,Layzner,,0,0,0,,把舱门关起来
Dialogue: 0,0:18:25.81,0:18:28.68,Layzner,,0,0,0,,英二的话因为转播中断
Dialogue: 0,0:18:29.60,0:18:36.13,Layzner,,0,0,0,,使得他真正想讲的话就这样被隐藏 我是这样想的
Dialogue: 0,0:18:57.38,0:19:01.56,Layzner,,0,0,0,,捕捉到古雷斯库舰队的影像 请下令
Dialogue: 0,0:19:02.83,0:19:03.80,Layzner,,0,0,0,,帮我与他们通信
Dialogue: 0,0:19:03.80,0:19:04.49,Layzner,,0,0,0,,了解
Dialogue: 0,0:19:14.62,0:19:20.28,Layzner,,0,0,0,,陛下 阿尔巴特洛·英二·飞鸟想跟陛下您通话
Dialogue: 0,0:19:20.72,0:19:22.72,Layzner,,0,0,0,,你说阿尔巴特洛·英二·飞鸟
Dialogue: 0,0:19:23.58,0:19:26.21,Layzner,,0,0,0,,就是那背叛者吗
Dialogue: 0,0:19:26.39,0:19:29.70,Layzner,,0,0,0,,是的 他说有一定要跟陛下您说的话
Dialogue: 0,0:19:31.02,0:19:33.09,Layzner,,0,0,0,,真是不知天高地厚的小子
Dialogue: 0,0:19:33.78,0:19:38.50,Layzner,,0,0,0,,现在要说什么 要我们原谅他吗
Dialogue: 0,0:19:39.65,0:19:41.30,Layzner,,0,0,0,,陛下 您的意思呢
Dialogue: 0,0:19:41.30,0:19:43.53,Layzner,,0,0,0,,不用回他 直接切掉
Dialogue: 0,0:19:43.53,0:19:48.20,Layzner,,0,0,0,,可是他说要跟陛下谈一下古拉特斯诞生的秘密
Dialogue: 0,0:19:48.81,0:19:51.26,Layzner,,0,0,0,,古拉特斯的诞生
Dialogue: 0,0:19:52.75,0:19:57.48,Layzner,,0,0,0,,他说要切掉所有通信回路只跟陛下谈
Dialogue: 0,0:19:59.78,0:20:00.55,Layzner,,0,0,0,,基乌拉
Dialogue: 0,0:20:00.55,0:20:01.23,Layzner,,0,0,0,,是
Dialogue: 0,0:20:02.11,0:20:03.91,Layzner,,0,0,0,,派血色凯撒尔出击
Dialogue: 0,0:20:04.22,0:20:05.04,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:20:07.77,0:20:12.38,Layzner,,0,0,0,,作战会议到此结束 其他人回自己岗位
Dialogue: 0,0:20:18.76,0:20:20.95,Layzner,,0,0,0,,把其他的通信回路切掉
Dialogue: 0,0:20:21.25,0:20:22.00,Layzner,,0,0,0,,我知道了
Dialogue: 0,0:20:40.95,0:20:43.87,Layzner,,0,0,0,,我是古雷斯库 这里只有我一个人
Dialogue: 0,0:20:44.32,0:20:49.82,Layzner,,0,0,0,,我只说我的请求 停止攻击地球 撤回你的舰队
Dialogue: 0,0:20:50.22,0:20:53.74,Layzner,,0,0,0,,嚯 如果我拒绝的话呢
Dialogue: 0,0:20:54.19,0:20:56.85,Layzner,,0,0,0,,那我就公开古拉特斯诞生的秘密
Dialogue: 0,0:20:57.49,0:21:00.31,Layzner,,0,0,0,,这事你从谁那听到的
Dialogue: 0,0:21:00.75,0:21:02.32,Layzner,,0,0,0,,没有告诉你的必要
Dialogue: 0,0:21:02.32,0:21:07.01,Layzner,,0,0,0,,你知道多少 还有让我听听那秘密是不是真的
Dialogue: 0,0:21:07.37,0:21:08.37,Layzner,,0,0,0,,你说说看
Dialogue: 0,0:21:13.34,0:21:16.73,Layzner,,0,0,0,,这就是古拉特斯的诞生
Dialogue: 0,0:21:16.73,0:21:20.31,Layzner,,0,0,0,,我听到的就这些 怎么样提督 我说的没错吧
Dialogue: 0,0:21:23.62,0:21:25.27,Layzner,,0,0,0,,古雷斯库提督 你有在听吗

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:01:02.08,0:01:03.60,Layzner,,0,0,0,,别出手 给我退下
Dialogue: 0,0:01:03.71,0:01:04.54,Layzner,,0,0,0,,鲁·凯恩阁下
Dialogue: 0,0:01:04.96,0:01:06.96,Layzner,,0,0,0,,主动力源达到极限
Dialogue: 0,0:01:06.12,0:01:06.87,Layzner,,0,0,0,,阁下
Dialogue: 0,0:01:07.24,0:01:08.89,Layzner,,0,0,0,,出手的话
Dialogue: 0,0:01:09.14,0:01:10.16,Layzner,,0,0,0,,就得死
Dialogue: 0,0:01:53.68,0:01:56.98,Layzner,,0,0,0,,我的机体也内藏了V-MAX吗
Dialogue: 0,0:01:57.45,0:02:03.01,Layzner,,0,0,0,,是 因为V-MAX机能是次代战略机动兵器的主核
Dialogue: 0,0:02:03.47,0:02:08.76,Layzner,,0,0,0,,这三年来所制造的发展型上试验性地搭载了
Dialogue: 0,0:02:10.16,0:02:12.55,Layzner,,0,0,0,,雷兹纳就是第一台 
Dialogue: 0,0:02:13.50,0:02:15.96,Layzner,,0,0,0,,大人您的扎卡尔上当然也搭载了
Dialogue: 0,0:02:17.61,0:02:21.11,Layzner,,0,0,0,,为什么 为什么保密到现在
Dialogue: 0,0:02:22.67,0:02:24.60,Layzner,,0,0,0,,居然连我也不知道
Dialogue: 0,0:02:25.82,0:02:27.95,Layzner,,0,0,0,,不过话说回来 真是操纵得很出色啊
Dialogue: 0,0:02:28.98,0:02:30.39,Layzner,,0,0,0,,回答我的问题
Dialogue: 0,0:02:31.39,0:02:34.92,Layzner,,0,0,0,,一句话 第一级军事机密
Dialogue: 0,0:02:36.56,0:02:41.56,Layzner,,0,0,0,,英二对鲁·凯恩
Dialogue: 0,0:02:43.12,0:02:49.69,Layzner,,0,0,0,,两三年前V-MAX就搭载在了次代发展型的话 为什么不加以活用
Dialogue: 0,0:02:50.24,0:02:52.52,Layzner,,0,0,0,,因为还没有达到实用阶段
Dialogue: 0,0:02:53.44,0:02:58.19,Layzner,,0,0,0,,至今为止都在试行能够操纵V-MAX的强化士兵的培养工作
Dialogue: 0,0:02:58.19,0:03:05.33,Layzner,,0,0,0,,但是 这三年来有五名测试机师死亡 四人在搭乘训练中死亡
Dialogue: 0,0:03:06.06,0:03:09.42,Layzner,,0,0,0,,如您所见 因为是超越常识的机能啊
Dialogue: 0,0:03:10.02,0:03:13.56,Layzner,,0,0,0,,就是说V-MAX的操纵风险很大吗
Dialogue: 0,0:03:14.22,0:03:19.04,Layzner,,0,0,0,,而且 也暂时还没有需要使用V-MAX的事态
Dialogue: 0,0:03:25.10,0:03:28.49,Layzner,,0,0,0,,那个闭锁回路任何人都能解除吗
Dialogue: 0,0:03:29.20,0:03:31.49,Layzner,,0,0,0,,不是专家是不可能的
Dialogue: 0,0:03:32.58,0:03:35.00,Layzner,,0,0,0,,那雷兹纳为什么解除了
Dialogue: 0,0:03:35.92,0:03:38.53,Layzner,,0,0,0,,关于这个问题我也很想知道
Dialogue: 0,0:03:42.48,0:03:46.66,Layzner,,0,0,0,,话说回来 您真的想解除扎卡尔的V-MAX机能锁吗
Dialogue: 0,0:03:47.13,0:03:52.93,Layzner,,0,0,0,,当然 难道你以为英二那小子都能做到的事 我会做不到吗
Dialogue: 0,0:03:53.11,0:03:59.20,Layzner,,0,0,0,,不敢 有了如鲁·凯恩阁下般的智力与体力 像是足够了吧
Dialogue: 0,0:04:00.60,0:04:06.62,Layzner,,0,0,0,,我想说的是 还有比V-MAX更上一层楼的RED POWER
Dialogue: 0,0:04:07.31,0:04:08.56,Layzner,,0,0,0,,Red power?
Dialogue: 0,0:04:08.57,0:04:14.72,Layzner,,0,0,0,,仅通过在能源中添加强化剂 就可以使性能增幅15%
Dialogue: 0,0:04:14.88,0:04:17.90,Layzner,,0,0,0,,相应地风险也会增大吗
Dialogue: 0,0:04:19.14,0:04:19.86,Layzner,,0,0,0,,是啊
Dialogue: 0,0:04:21.36,0:04:22.41,Layzner,,0,0,0,,有意思
Dialogue: 0,0:04:22.92,0:04:23.87,Layzner,,0,0,0,,我就试试
Dialogue: 0,0:04:24.68,0:04:25.84,Layzner,,0,0,0,,这风险
Dialogue: 0,0:04:30.67,0:04:32.74,Layzner,,0,0,0,,库斯科的圣女被抓到了是真的吗
Dialogue: 0,0:04:33.05,0:04:35.68,Layzner,,0,0,0,,是啊 似乎被治安队抓走了
Dialogue: 0,0:04:35.77,0:04:40.69,Layzner,,0,0,0,,可恶 不能袖手旁观了 去向古雷斯库抗议
Dialogue: 0,0:04:45.23,0:04:46.85,Layzner,,0,0,0,,跟圣女队走
Dialogue: 0,0:04:46.85,0:04:47.99,Layzner,,0,0,0,,还我圣女
Dialogue: 0,0:04:47.99,0:04:50.04,Layzner,,0,0,0,,反对暴政 还我圣女
Dialogue: 0,0:04:53.09,0:04:54.07,Layzner,,0,0,0,,把圣女还回来
Dialogue: 0,0:04:54.07,0:04:56.97,Layzner,,0,0,0,,我们不知道圣女在哪里 快滚
Dialogue: 0,0:04:57.01,0:04:59.30,Layzner,,0,0,0,,还我圣女
Dialogue: 0,0:04:58.83,0:05:01.22,Layzner,,0,0,0,,不知道就是不知道 快滚
Dialogue: 0,0:05:02.00,0:05:05.95,Layzner,,0,0,0,,可是 没听说圣女被抓来古拉特斯塔啊
Dialogue: 0,0:05:06.33,0:05:08.48,Layzner,,0,0,0,,也许是保密了
Dialogue: 0,0:05:08.76,0:05:14.84,Layzner,,0,0,0,,可是 矫正队和保安部队听说这事也很慌张啊 
Dialogue: 0,0:05:15.60,0:05:16.40,Layzner,,0,0,0,,借我耍耍
Dialogue: 0,0:05:16.80,0:05:19.31,Layzner,,0,0,0,,那是圣女自己藏起来了吗
Dialogue: 0,0:05:19.40,0:05:21.68,Layzner,,0,0,0,,问我也没用啊
Dialogue: 0,0:05:21.68,0:05:25.55,Layzner,,0,0,0,,不过问鲁·凯恩阁下大概能知道吧
Dialogue: 0,0:05:26.57,0:05:28.50,Layzner,,0,0,0,,英二 你几时学的这功夫
Dialogue: 0,0:05:29.13,0:05:29.80,Layzner,,0,0,0,,亚瑟
Dialogue: 0,0:05:31.30,0:05:33.24,Layzner,,0,0,0,,我想直接去问鲁·凯恩
Dialogue: 0,0:05:33.48,0:05:34.10,Layzner,,0,0,0,,哎？
Dialogue: 0,0:05:34.12,0:05:35.24,Layzner,,0,0,0,,好痛
Dialogue: 0,0:05:35.37,0:05:38.46,Layzner,,0,0,0,,你 你不会想溜进古拉特斯塔吧
Dialogue: 0,0:05:38.70,0:05:39.20,Layzner,,0,0,0,,哎
Dialogue: 0,0:05:40.02,0:05:40.28,Layzner,,0,0,0,,啊
Dialogue: 0,0:05:41.01,0:05:42.70,Layzner,,0,0,0,,这太乱来了
Dialogue: 0,0:05:43.24,0:05:45.02,Layzner,,0,0,0,,有你帮忙的话 有希望的
Dialogue: 0,0:05:45.84,0:05:50.04,Layzner,,0,0,0,,不行啊 不行不行 绝对不行
Dialogue: 0,0:05:50.17,0:05:51.47,Layzner,,0,0,0,,好痛
Dialogue: 0,0:05:59.11,0:06:00.16,Layzner,,0,0,0,,久候阁下  
Dialogue: 0,0:06:00.44,0:06:01.92,Layzner,,0,0,0,,已经准备完成
Dialogue: 0,0:06:14.42,0:06:15.33,Layzner,,0,0,0,,赶快开始吧
Dialogue: 0,0:06:16.30,0:06:17.10,Layzner,,0,0,0,,从LV10开始
Dialogue: 0,0:06:17.38,0:06:18.57,Layzner,,0,0,0,,啊 这个
Dialogue: 0,0:06:19.28,0:06:20.75,Layzner,,0,0,0,,刚才尼松博士说
Dialogue: 0,0:06:21.00,0:06:24.70,Layzner,,0,0,0,,要从LV5开始 先热热身
Dialogue: 0,0:06:25.20,0:06:27.62,Layzner,,0,0,0,,否则会有粉身碎骨的危险
Dialogue: 0,0:06:28.20,0:06:30.60,Layzner,,0,0,0,,我的身体可没这么脆弱
Dialogue: 0,0:06:30.84,0:06:35.04,Layzner,,0,0,0,,从LV10开始一直撑到RED POWER的LV20
Dialogue: 0,0:06:36.20,0:06:37.00,Layzner,,0,0,0,,明白了
Dialogue: 0,0:06:37.33,0:06:37.77,Layzner,,0,0,0,,打开
Dialogue: 0,0:06:38.07,0:06:38.42,Layzner,,0,0,0,,是
Dialogue: 0,0:07:15.70,0:07:18.65,Layzner,,0,0,0,,血压正常 心率脑波皆无异常
Dialogue: 0,0:07:18.72,0:07:20.80,Layzner,,0,0,0,,反应速度 8.002 
Dialogue: 0,0:07:21.04,0:07:23.16,Layzner,,0,0,0,,光束枪命中率70.3%
Dialogue: 0,0:07:32.00,0:07:33.21,Layzner,,0,0,0,,Level 11, clear.
Dialogue: 0,0:07:33.84,0:07:35.01,Layzner,,0,0,0,,开始LV12
Dialogue: 0,0:08:31.90,0:08:32.41,Layzner,,0,0,0,,英二
Dialogue: 0,0:08:33.16,0:08:34.19,Layzner,,0,0,0,,你等下
Dialogue: 0,0:08:37.96,0:08:38.57,Layzner,,0,0,0,,可以了
Dialogue: 0,0:08:41.46,0:08:43.88,Layzner,,0,0,0,,圣女似乎真的不在这里
Dialogue: 0,0:08:58.96,0:09:00.36,Layzner,,0,0,0,,Level 15, clear.
Dialogue: 0,0:09:01.00,0:09:02.35,Layzner,,0,0,0,,开始LV16
Dialogue: 0,0:09:02.70,0:09:05.10,Layzner,,0,0,0,,浪费时间 直接跳关到LV20
Dialogue: 0,0:09:05.48,0:09:07.12,Layzner,,0,0,0,,可是这
Dialogue: 0,0:09:07.74,0:09:08.55,Layzner,,0,0,0,,没问题
Dialogue: 0,0:09:08.90,0:09:10.25,Layzner,,0,0,0,,赶快选到LV20
Dialogue: 0,0:09:11.62,0:09:12.24,Layzner,,0,0,0,,明白了
Dialogue: 0,0:09:21.62,0:09:24.20,Layzner,,0,0,0,,不 不过这种程度
Dialogue: 0,0:09:28.75,0:09:29.56,Layzner,,0,0,0,,可恶
Dialogue: 0,0:09:31.52,0:09:34.52,Layzner,,0,0,0,,真合身啊 不枉我辛苦找来啊
Dialogue: 0,0:09:36.14,0:09:37.60,Layzner,,0,0,0,,那么 鲁·凯恩在哪
Dialogue: 0,0:09:38.30,0:09:41.08,Layzner,,0,0,0,,听说在10楼A3区域的训练室
Dialogue: 0,0:09:42.70,0:09:43.64,Layzner,,0,0,0,,在这里做什么
Dialogue: 0,0:09:44.07,0:09:45.61,Layzner,,0,0,0,,不是 那个
Dialogue: 0,0:09:46.70,0:09:50.40,Layzner,,0,0,0,,笨蛋 看着军曹大人的眼睛立正了答话
Dialogue: 0,0:09:51.52,0:09:55.03,Layzner,,0,0,0,,抱歉 这小子是新人还不懂规矩
Dialogue: 0,0:09:55.11,0:09:58.92,Layzner,,0,0,0,,我是在教他清点货物
Dialogue: 0,0:10:00.36,0:10:01.32,Layzner,,0,0,0,,下次别忘开灯
Dialogue: 0,0:10:01.98,0:10:02.62,Layzner,,0,0,0,,会被当可疑人物的
Dialogue: 0,0:10:02.85,0:10:04.16,Layzner,,0,0,0,,您说的是
Dialogue: 0,0:10:04.65,0:10:05.56,Layzner,,0,0,0,,好好干
Dialogue: 0,0:10:05.71,0:10:06.93,Layzner,,0,0,0,,谢谢您指示
Dialogue: 0,0:10:07.32,0:10:08.25,Layzner,,0,0,0,,您辛苦了
Dialogue: 0,0:10:14.94,0:10:16.57,Layzner,,0,0,0,,似乎暂时是没问题
Dialogue: 0,0:10:17.20,0:10:18.19,Layzner,,0,0,0,,之后你要怎么办
Dialogue: 0,0:10:19.30,0:10:20.33,Layzner,,0,0,0,,我一个人去
Dialogue: 0,0:10:21.22,0:10:23.63,Layzner,,0,0,0,,不能再给你继续添麻烦了
Dialogue: 0,0:10:41.10,0:10:42.49,Layzner,,0,0,0,,不愧是鲁·凯恩大人
Dialogue: 0,0:10:42.49,0:10:44.49,Layzner,,0,0,0,,LV20都不当回事
Dialogue: 0,0:10:52.02,0:10:53.00,Layzner,,0,0,0,,你这混蛋
Dialogue: 0,0:10:59.84,0:11:01.14,Layzner,,0,0,0,,你小子 怎么会在这里
Dialogue: 0,0:11:01.82,0:11:03.83,Layzner,,0,0,0,,鲁·凯恩 我姐姐人呢
Dialogue: 0,0:11:04.50,0:11:05.01,Layzner,,0,0,0,,不知道
Dialogue: 0,0:11:05.52,0:11:06.72,Layzner,,0,0,0,,别胡说 
Dialogue: 0,0:11:07.38,0:11:08.89,Layzner,,0,0,0,,会绑架姐姐的只有你
Dialogue: 0,0:11:09.36,0:11:10.31,Layzner,,0,0,0,,绑架
Dialogue: 0,0:11:11.01,0:11:11.65,Layzner,,0,0,0,,回答我
Dialogue: 0,0:11:12.04,0:11:13.11,Layzner,,0,0,0,,我姐姐在哪里
Dialogue: 0,0:11:13.35,0:11:14.44,Layzner,,0,0,0,,蠢货
Dialogue: 0,0:11:14.64,0:11:17.19,Layzner,,0,0,0,,就为了问这个自投罗网吗
Dialogue: 0,0:11:23.96,0:11:24.57,Layzner,,0,0,0,,你 你小子
Dialogue: 0,0:11:25.34,0:11:26.40,Layzner,,0,0,0,,不想回答吗
Dialogue: 0,0:11:37.14,0:11:39.25,Layzner,,0,0,0,,为了地球与古拉特斯 
Dialogue: 0,0:11:39.59,0:11:41.09,Layzner,,0,0,0,,姐姐是不可或缺的啊
Dialogue: 0,0:11:41.39,0:11:43.97,Layzner,,0,0,0,,我不会让你碰姐姐一根寒毛的
Dialogue: 0,0:11:45.00,0:11:53.02,Layzner,,0,0,0,,无 无聊 不过是个被地球的贱民们捧上了天 目中无人的女人吗
Dialogue: 0,0:11:53.50,0:11:55.40,Layzner,,0,0,0,,地球人不是什么贱民
Dialogue: 0,0:11:55.53,0:11:57.86,Layzner,,0,0,0,,你应该知道的
Dialogue: 0,0:11:58.07,0:12:02.57,Layzner,,0,0,0,,你是知道了地球和古拉特斯的关系 才想灭姐姐的口吧
Dialogue: 0,0:12:04.55,0:12:07.12,Layzner,,0,0,0,,你要么现在就就杀了我 
Dialogue: 0,0:12:07.40,0:12:10.30,Layzner,,0,0,0,,否则将来一定会后悔的
Dialogue: 0,0:12:10.47,0:12:14.75,Layzner,,0,0,0,,快发警报 识别不明的SPT正在接近
Dialogue: 0,0:12:23.73,0:12:25.87,Layzner,,0,0,0,,快联络鲁·凯恩大人 有不明机
Dialogue: 0,0:12:26.07,0:12:27.39,Layzner,,0,0,0,,啊 你是
Dialogue: 0,0:12:28.67,0:12:29.49,Layzner,,0,0,0,,鲁·凯恩 
Dialogue: 0,0:12:29.93,0:12:31.64,Layzner,,0,0,0,,要是姐姐有个三长两短
Dialogue: 0,0:12:31.87,0:12:33.60,Layzner,,0,0,0,,我绝不放过你
Dialogue: 0,0:12:36.72,0:12:37.69,Layzner,,0,0,0,,饶不了你
Dialogue: 0,0:12:38.37,0:12:39.67,Layzner,,0,0,0,,死也
Dialogue: 0,0:12:39.79,0:12:40.67,Layzner,,0,0,0,,饶不了你
Dialogue: 0,0:12:58.41,0:12:59.77,Layzner,,0,0,0,,找到了 在那里
Dialogue: 0,0:13:10.21,0:13:11.57,Layzner,,0,0,0,,在这里 快追
Dialogue: 0,0:13:28.14,0:13:29.21,Layzner,,0,0,0,,他人呢
Dialogue: 0,0:13:29.40,0:13:30.08,Layzner,,0,0,0,,那个嘛
Dialogue: 0,0:13:30.84,0:13:32.77,Layzner,,0,0,0,,属下该死 被他出其不意
Dialogue: 0,0:13:32.77,0:13:33.43,Layzner,,0,0,0,,滚
Dialogue: 0,0:13:33.59,0:13:35.76,Layzner,,0,0,0,,我现在不想见到地球人
Dialogue: 0,0:13:41.50,0:13:42.08,Layzner,,0,0,0,,阁下 
Dialogue: 0,0:13:42.48,0:13:43.63,Layzner,,0,0,0,,您听说了吗
Dialogue: 0,0:13:44.79,0:13:47.40,Layzner,,0,0,0,,似乎是英二出现了吧
Dialogue: 0,0:13:48.51,0:13:49.25,Layzner,,0,0,0,,玖丽亚呢
Dialogue: 0,0:13:49.66,0:13:53.40,Layzner,,0,0,0,,是 现在正关押在那个地方
Dialogue: 0,0:14:00.96,0:14:01.77,Layzner,,0,0,0,,父亲大人
Dialogue: 0,0:14:02.86,0:14:04.93,Layzner,,0,0,0,,父亲大人  您为何瞒着我
Dialogue: 0,0:14:05.35,0:14:07.73,Layzner,,0,0,0,,抓了库斯科的圣女
Dialogue: 0,0:14:10.36,0:14:11.69,Layzner,,0,0,0,,你在说些什么
Dialogue: 0,0:14:12.07,0:14:13.04,Layzner,,0,0,0,,请别想蒙混
Dialogue: 0,0:14:15.83,0:14:18.01,Layzner,,0,0,0,,你也有份吧
Dialogue: 0,0:14:20.21,0:14:22.05,Layzner,,0,0,0,,为什么要隐瞒
Dialogue: 0,0:14:22.69,0:14:24.57,Layzner,,0,0,0,,那女人究竟有什么秘密
Dialogue: 0,0:14:25.03,0:14:28.53,Layzner,,0,0,0,,英二说是什么地球与古拉特斯的关系那是什么意思
Dialogue: 0,0:14:29.09,0:14:31.64,Layzner,,0,0,0,,我听不懂你在说什么
Dialogue: 0,0:14:32.03,0:14:34.55,Layzner,,0,0,0,,父亲您肯定隐瞒了什么 
Dialogue: 0,0:14:37.62,0:14:38.57,Layzner,,0,0,0,,算了
Dialogue: 0,0:14:39.68,0:14:43.08,Layzner,,0,0,0,,我父亲您要把那女人藏起来也没关系
Dialogue: 0,0:14:44.10,0:14:46.44,Layzner,,0,0,0,,我只要利用这一点就行了
Dialogue: 0,0:14:48.12,0:14:49.45,Layzner,,0,0,0,,你想做什么
Dialogue: 0,0:14:50.55,0:14:51.65,Layzner,,0,0,0,,猜谜啊
Dialogue: 0,0:14:53.20,0:14:58.29,Layzner,,0,0,0,,这次的事  仔细想来一切都归结到雷兹纳上
Dialogue: 0,0:15:00.04,0:15:02.71,Layzner,,0,0,0,,雷兹纳中一定有什么秘密
Dialogue: 0,0:15:03.64,0:15:05.91,Layzner,,0,0,0,,我是这么认为的
Dialogue: 0,0:15:07.33,0:15:09.27,Layzner,,0,0,0,,哎 库斯科的圣女被
Dialogue: 0,0:15:09.44,0:15:10.03,Layzner,,0,0,0,,啊
Dialogue: 0,0:15:11.12,0:15:12.67,Layzner,,0,0,0,,要被秘密护送走了
Dialogue: 0,0:15:14.43,0:15:17.05,Layzner,,0,0,0,,果然 鲁·凯恩抓了圣女啊
Dialogue: 0,0:15:18.45,0:15:19.59,Layzner,,0,0,0,,能给我杯水吗
Dialogue: 0,0:15:20.15,0:15:20.65,Layzner,,0,0,0,,哎
Dialogue: 0,0:15:21.40,0:15:22.67,Layzner,,0,0,0,,那么日期呢
Dialogue: 0,0:15:22.77,0:15:23.73,Layzner,,0,0,0,,今天啊 今天
Dialogue: 0,0:15:23.73,0:15:25.16,Layzner,,0,0,0,,喂 不好了
Dialogue: 0,0:15:25.32,0:15:27.61,Layzner,,0,0,0,,听说库斯科的圣女要被秘密护送走了
Dialogue: 0,0:15:27.97,0:15:30.04,Layzner,,0,0,0,,亚瑟你来了啊
Dialogue: 0,0:15:30.31,0:15:32.48,Layzner,,0,0,0,,你那消息已经火星了
Dialogue: 0,0:15:32.80,0:15:34.65,Layzner,,0,0,0,,我就是来说这个的
Dialogue: 0,0:15:34.92,0:15:36.56,Layzner,,0,0,0,,你也是啊
Dialogue: 0,0:15:36.92,0:15:40.79,Layzner,,0,0,0,,真是的 我可是费了好大劲才知道的情报啊
Dialogue: 0,0:15:43.91,0:15:44.88,Layzner,,0,0,0,,靠 有啤酒的啊
Dialogue: 0,0:15:47.40,0:15:49.60,Layzner,,0,0,0,,没你的份 你酒品差啊
Dialogue: 0,0:15:50.64,0:15:52.75,Layzner,,0,0,0,,英二 有情报说
Dialogue: 0,0:15:52.93,0:15:54.93,Layzner,,0,0,0,,圣女要从纽约被送走
Dialogue: 0,0:16:01.54,0:16:03.05,Layzner,,0,0,0,,怎么啦 大家都这表情
Dialogue: 0,0:16:03.33,0:16:05.32,Layzner,,0,0,0,,亏我带了重大情报来
Dialogue: 0,0:16:06.57,0:16:07.20,Layzner,,0,0,0,,西蒙妮
Dialogue: 0,0:16:08.43,0:16:11.12,Layzner,,0,0,0,,亚瑟和大卫都带了同样的情报来啊
Dialogue: 0,0:16:14.07,0:16:14.77,Layzner,,0,0,0,,英二
Dialogue: 0,0:16:15.07,0:16:16.04,Layzner,,0,0,0,,这可不寻常啊
Dialogue: 0,0:16:16.29,0:16:19.84,Layzner,,0,0,0,,就是啊 古拉特斯的秘密都众人皆知了
Dialogue: 0,0:16:20.16,0:16:21.08,Layzner,,0,0,0,,是陷阱吗
Dialogue: 0,0:16:21.32,0:16:22.32,Layzner,,0,0,0,,啊
Dialogue: 0,0:16:22.61,0:16:25.79,Layzner,,0,0,0,,仔细想来 英二把鲁·凯恩那丫整了个半死
Dialogue: 0,0:16:26.58,0:16:28.29,Layzner,,0,0,0,,估计就是这么回事啊
Dialogue: 0,0:16:29.16,0:16:30.67,Layzner,,0,0,0,,没错 肯定是这样
Dialogue: 0,0:16:31.13,0:16:34.33,Layzner,,0,0,0,,那这事就当没听过比较好吧
Dialogue: 0,0:16:34.84,0:16:36.48,Layzner,,0,0,0,,先观察一下情况
Dialogue: 0,0:16:37.03,0:16:38.48,Layzner,,0,0,0,,不 我去
Dialogue: 0,0:16:40.77,0:16:41.68,Layzner,,0,0,0,,英二
Dialogue: 0,0:17:12.60,0:17:16.51,Layzner,,0,0,0,,警告信息 SPT侵入RANGE 3
Dialogue: 0,0:17:17.58,0:17:18.37,Layzner,,0,0,0,,哼 来了吗
Dialogue: 0,0:17:29.94,0:17:30.80,Layzner,,0,0,0,,陷阱也好
Dialogue: 0,0:17:31.32,0:17:33.37,Layzner,,0,0,0,,鲁·凯恩他想单挑也行
Dialogue: 0,0:17:33.91,0:17:35.77,Layzner,,0,0,0,,只要能知道姐姐在哪
Dialogue: 0,0:18:16.10,0:18:19.92,Layzner,,0,0,0,,SPT 1机 从POINT 00侵入RANGE 1
Dialogue: 0,0:18:20.13,0:18:20.62,Layzner,,0,0,0,,出现了
Dialogue: 0,0:18:23.02,0:18:23.59,Layzner,,0,0,0,,英二
Dialogue: 0,0:18:24.05,0:18:25.96,Layzner,,0,0,0,,这是我们第一次也是最后一次对决
Dialogue: 0,0:18:26.72,0:18:27.32,Layzner,,0,0,0,,受死吧
Dialogue: 0,0:18:32.52,0:18:32.93,Layzner,,0,0,0,,鲁·凯恩
Dialogue: 0,0:18:33.26,0:18:33.84,Layzner,,0,0,0,,我姐姐人呢
Dialogue: 0,0:18:34.28,0:18:36.40,Layzner,,0,0,0,,还念叨这事吗
Dialogue: 0,0:18:36.76,0:18:38.33,Layzner,,0,0,0,,你今天就要葬身于此了
Dialogue: 0,0:18:47.06,0:18:48.65,Layzner,,0,0,0,,回答我 我姐姐在哪里
Dialogue: 0,0:18:48.97,0:18:50.03,Layzner,,0,0,0,,问答无用
Dialogue: 0,0:18:51.45,0:18:53.13,Layzner,,0,0,0,,腿部导弹 发射
Dialogue: 0,0:19:00.14,0:19:02.25,Layzner,,0,0,0,,雷 V-MAX 发动
Dialogue: 0,0:19:12.92,0:19:14.22,Layzner,,0,0,0,,V-MAX
Dialogue: 0,0:19:16.99,0:19:20.93,Layzner,,0,0,0,,竟敢让我丢脸 我要好好还你的情啊
Dialogue: 0,0:20:00.10,0:20:02.47,Layzner,,0,0,0,,V-MAX 超级模式 ON!
Dialogue: 0,0:20:09.56,0:20:10.02,Layzner,,0,0,0,,那是
Dialogue: 0,0:20:18.33,0:20:19.45,Layzner,,0,0,0,,怎 怎么可能
Dialogue: 0,0:20:29.55,0:20:31.44,Layzner,,0,0,0,,不愧是鲁·凯恩大人
Dialogue: 0,0:20:31.52,0:20:33.42,Layzner,,0,0,0,,根本看不出是初次操纵
Dialogue: 0,0:20:35.24,0:20:39.95,Layzner,,0,0,0,,Red Power 在所有方面都超越V-MAX
Dialogue: 0,0:20:40.39,0:20:41.97,Layzner,,0,0,0,,会赢是当然的
Dialogue: 0,0:21:10.04,0:21:12.08,Layzner,,0,0,0,,左上腕部驱动回路切断 
Dialogue: 0,0:21:12.41,0:21:16.42,Layzner,,0,0,0,,观测器破裂 第三燃料箱龟裂 警告
Dialogue: 0,0:21:24.97,0:21:30.01,Layzner,,0,0,0,,警告 敌方机动力为现在我方最大值的125%
Dialogue: 0,0:21:30.01,0:21:32.69,Layzner,,0,0,0,,脱离不可能 预计没有任何逆转的可能
Dialogue: 0,0:21:36.72,0:21:39.23,Layzner,,0,0,0,,杀你之前我想确认一件事
Dialogue: 0,0:21:40.80,0:21:43.13,Layzner,,0,0,0,,雷兹纳隐藏了什么秘密
Dialogue: 0,0:21:44.04,0:21:46.28,Layzner,,0,0,0,,古拉特斯与地球的关系是什么
Dialogue: 0,0:21:46.60,0:21:47.80,Layzner,,0,0,0,,什么
Dialogue: 0,0:21:48.15,0:21:49.40,Layzner,,0,0,0,,你不知道吗
Dialogue: 0,0:21:49.80,0:21:50.63,Layzner,,0,0,0,,回答我
Dialogue: 0,0:21:51.98,0:21:53.20,Layzner,,0,0,0,,那我告诉你
Dialogue: 0,0:21:53.65,0:21:54.99,Layzner,,0,0,0,,地球和古拉特斯是
Dialogue: 0,0:22:01.91,0:22:03.51,Layzner,,0,0,0,,你们别出手
Dialogue: 0,0:22:03.91,0:22:04.92,Layzner,,0,0,0,,鲁·凯恩大人
Dialogue: 0,0:22:05.29,0:22:07.75,Layzner,,0,0,0,,我们是来抹杀雷兹纳的
Dialogue: 0,0:22:08.23,0:22:09.47,Layzner,,0,0,0,,请您让开
Dialogue: 0,0:22:09.73,0:22:10.83,Layzner,,0,0,0,,别出手 
Dialogue: 0,0:22:11.04,0:22:11.68,Layzner,,0,0,0,,给我退下
Dialogue: 0,0:22:12.69,0:22:14.44,Layzner,,0,0,0,,这是古雷斯库大人的命令
Dialogue: 0,0:22:15.35,0:22:16.40,Layzner,,0,0,0,,果然
Dialogue: 0,0:22:22.20,0:22:23.21,Layzner,,0,0,0,,鲁·凯恩阁下
Dialogue: 0,0:22:24.15,0:22:27.23,Layzner,,0,0,0,,连自己的儿子都想隐瞒的秘密
Dialogue: 0,0:22:27.84,0:22:29.36,Layzner,,0,0,0,,更让我觉得好奇
Dialogue: 0,0:22:29.85,0:22:30.56,Layzner,,0,0,0,,阁下
Dialogue: 0,0:22:33.62,0:22:35.29,Layzner,,0,0,0,,主动力源达到极限
Dialogue: 0,0:22:35.35,0:22:37.58,Layzner,,0,0,0,,第一第三燃料箱破损
Dialogue: 0,0:22:36.62,0:22:37.29,Layzner,,0,0,0,,阁下
Dialogue: 0,0:22:37.83,0:22:38.65,Layzner,,0,0,0,,卡露拉

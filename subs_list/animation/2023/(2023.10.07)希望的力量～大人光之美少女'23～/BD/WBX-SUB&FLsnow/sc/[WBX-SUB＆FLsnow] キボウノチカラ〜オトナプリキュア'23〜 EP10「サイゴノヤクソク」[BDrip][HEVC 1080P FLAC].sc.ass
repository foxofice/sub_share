Dialogue: 0,0:16:42.89,0:16:44.35,Default JP,,0,0,0,,輝く金の花
Dialogue: 0,0:16:42.89,0:16:44.35,Default CN,,0,0,0,,灿烂的黄金之华
Dialogue: 0,0:16:44.81,0:16:46.02,Bank SS,,0,0,0,,{\fad(200,200)\blur5\3c&H981AFB&\c&H59DCFD&}Cure Bloom
Dialogue: 0,0:16:46.31,0:16:47.94,Default JP,,0,0,0,,きらめく銀の翼
Dialogue: 0,0:16:46.31,0:16:47.94,Default CN,,0,0,0,,闪耀的白银之翼
Dialogue: 0,0:16:49.36,0:16:50.62,Bank SS,,0,0,0,,{\fad(200,200)\blur5\c&HE8FAFF&\3c&HFE5797&}Cure Egret
Dialogue: 0,0:17:04.62,0:17:08.00,Default JP,,0,0,0,,精霊の光よ！命の輝きよ！
Dialogue: 0,0:17:04.62,0:17:08.00,Default CN,,0,0,0,,精灵之光 生命之辉啊！
Dialogue: 0,0:17:08.54,0:17:11.44,Default JP,,0,0,0,,希望へ導け！2つの心！
Dialogue: 0,0:17:08.54,0:17:11.44,Default CN,,0,0,0,,为我们指引希望吧！
Dialogue: 1,0:17:13.05,0:17:17.93,Bank SS,,0,0,0,,{\fad(200,200)\blur5\iclip(m 1392 1011 l 532 1011 530 1052 1393 1052)\3c&H981AFB&\c&H39D4FB&}Precure Spiral Heart

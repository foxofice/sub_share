Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,STAFF,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:03.92,0:01:06.49,Layzner,Anna,0,0,0,,他应该一起来的
Dialogue: 0,0:01:06.49,0:01:08.44,Layzner,Simone,0,0,0,,你讲的好像这事情跟你无关似的
Dialogue: 0,0:01:08.44,0:01:10.24,Layzner,David,0,0,0,,那种人能相信吗
Dialogue: 0,0:01:49.21,0:01:55.24,Layzner,Anna,0,0,0,,从格拉特斯来的那个人告诉我们地球正被觊觎着
Dialogue: 0,0:01:55.24,0:01:58.98,Layzner,Anna,0,0,0,,我相信他所说的
Dialogue: 0,0:01:59.82,0:02:07.04,Layzner,Anna,0,0,0,,当我看到他的眼睛时我就要相信他 不相信他不行
Dialogue: 0,0:02:07.04,0:02:08.44,Layzner,Eiji,0,0,0,,给我回去
Dialogue: 0,0:02:14.60,0:02:19.87,Layzner,Anna,0,0,0,,那个人又救了我们
Dialogue: 0,0:02:19.87,0:02:21.88,Layzner,Anna,0,0,0,,如同我所相信的那样
Dialogue: 0,0:02:34.58,0:02:36.58,Layzner,,0,0,0,,GTC-DN-03  Grados Tripod Carrier
Dialogue: 0,0:02:22.44,0:02:28.48,Layzner,,0,0,0,,第四话 逃出心中的留恋
Dialogue: 0,0:02:49.87,0:02:55.90,Layzner,Gosterro,0,0,0,,那小鬼 不可以小看他 下次一定加倍还给他
Dialogue: 0,0:02:59.41,0:03:02.52,Layzner,Pilot,0,0,0,,不好意思 请向总部报告
Dialogue: 0,0:03:02.52,0:03:03.58,Layzner,Gosterro,0,0,0,,什么
Dialogue: 0,0:03:03.58,0:03:07.77,Layzner,Pilot,0,0,0,,是 司令说 必须向总部报告作战计划
Dialogue: 0,0:03:07.77,0:03:09.33,Layzner,Gosterro,0,0,0,,不要多管闲事
Dialogue: 0,0:03:09.33,0:03:11.80,Layzner,Pilot,0,0,0,,可是必须要汇报
Dialogue: 0,0:03:11.80,0:03:13.53,Layzner,Gosterro,0,0,0,,这里的指挥官是谁
Dialogue: 0,0:03:13.53,0:03:15.16,Layzner,Pilot,0,0,0,,那当然是
Dialogue: 0,0:03:17.46,0:03:21.02,Layzner,Gosterro,0,0,0,,指挥官说不用报告了
Dialogue: 0,0:03:21.02,0:03:25.33,Layzner,Pilot B,0,0,0,,机器人的紧急修理已完成了
Dialogue: 0,0:03:25.33,0:03:26.39,Layzner,Gosterro,0,0,0,,好 出发
Dialogue: 0,0:03:26.39,0:03:27.24,Layzner,PIlot,0,0,0,,是
Dialogue: 0,0:03:27.24,0:03:31.24,Layzner,,0,0,0,,SPT-LZ-00X Layzner
Dialogue: 0,0:04:20.94,0:04:23.39,Layzner,Man,0,0,0,,在这里一直想也没用
Dialogue: 0,0:04:23.39,0:04:27.33,Layzner,Man,0,0,0,,要到最近的美军基地才行
Dialogue: 0,0:04:27.33,0:04:28.58,Layzner,Man2,0,0,0,,我知道了
Dialogue: 0,0:04:28.58,0:04:31.92,Layzner,Woman,0,0,0,,他会一直犹豫也是当然的 我们一点防备也没有
Dialogue: 0,0:04:31.92,0:04:33.92,Layzner,Woman,0,0,0,,如果又被敌人夜途中埋伏的话
Dialogue: 0,0:04:33.92,0:04:37.18,Layzner,Man,0,0,0,,所以你想我们还能待在这多久
Dialogue: 0,0:04:37.18,0:04:40.75,Layzner,Man2,0,0,0,,外面是地狱 这里也是地狱
Dialogue: 0,0:04:40.75,0:04:45.77,Layzner,Arthur,0,0,0,,我能说句话吗 去美国基地那没问题吗
Dialogue: 0,0:04:45.77,0:04:47.01,Layzner,Elizabeth,0,0,0,,什么意思
Dialogue: 0,0:04:47.01,0:04:51.18,Layzner,Arthur,0,0,0,,发生了这么大的事 可是有出现战机
Dialogue: 0,0:04:51.18,0:04:52.85,Layzner,Arthur,0,0,0,,只有敌人刚出现时
Dialogue: 0,0:04:52.85,0:04:53.70,Layzner,Arthur,0,0,0,,可是后来
Dialogue: 0,0:04:53.70,0:04:57.54,Layzner,Simone,0,0,0,,现在是在讨论要不要去 不要把话题拉大
Dialogue: 0,0:04:57.54,0:05:00.15,Layzner,Arthur,0,0,0,,是没错 但你没注意到吗
Dialogue: 0,0:05:00.15,0:05:04.46,Layzner,Woman,0,0,0,,与其随便乱动说不定在那少年身边较安全
Dialogue: 0,0:05:04.46,0:05:07.29,Layzner,Man,0,0,0,,你知道他的真面目吗
Dialogue: 0,0:05:17.00,0:05:18.83,Layzner,David,0,0,0,,看着真是碍眼
Dialogue: 0,0:05:26.70,0:05:29.94,Layzner,Eiji,0,0,0,,我留在这引敌人过来
Dialogue: 0,0:05:30.98,0:05:33.88,Layzner,Eiji,0,0,0,,趁这时请快逃
Dialogue: 0,0:05:37.61,0:05:39.41,Layzner,Man,0,0,0,,真是假惺惺的小鬼
Dialogue: 0,0:05:39.41,0:05:42.98,Layzner,ManB,0,0,0,,与其被他保护 还不如被干掉
Dialogue: 0,0:05:42.98,0:05:44.03,Layzner,Roanne,0,0,0,,请等一下
Dialogue: 0,0:05:45.23,0:05:47.02,Layzner,Roanne,0,0,0,,我不想被杀
Dialogue: 0,0:05:47.02,0:05:48.92,Layzner,MabB,0,0,0,,你怎么这么说 小朋友
Dialogue: 0,0:05:48.92,0:05:50.74,Layzner,Eiji,0,0,0,,请快一点
Dialogue: 0,0:05:50.74,0:05:53.14,Layzner,Eiji,0,0,0,,他们一定还会回来的
Dialogue: 0,0:05:57.02,0:05:59.02,Layzner,Eiji,0,0,0,,快听我的话
Dialogue: 0,0:05:59.02,0:06:01.10,Layzner,Man,0,0,0,,现在马上离开这里 趁着这暴风离开
Dialogue: 0,0:06:01.10,0:06:06.37,Layzner,Man,0,0,0,,如果再拖时间的话 暴风会走的
Dialogue: 0,0:06:09.28,0:06:10.98,Layzner,Man,0,0,0,,有人反对吗
Dialogue: 0,0:06:12.70,0:06:13.84,Layzner,Man,0,0,0,,走吧
Dialogue: 0,0:06:45.57,0:06:47.85,Layzner,Elizabeth,0,0,0,,你在做什么 快一点
Dialogue: 0,0:07:22.37,0:07:24.57,Layzner,Eiji,0,0,0,,雷 还要多久才能动
Dialogue: 0,0:07:24.57,0:07:26.29,Layzner,Rey,0,0,0,,根据模式时间有所不同
Dialogue: 0,0:07:26.96,0:07:28.19,Layzner,Eiji,0,0,0,,如果是战斗模式呢
Dialogue: 0,0:07:28.19,0:07:35.59,Layzner,Rey,0,0,0,,如果是战斗模式的话推测的可动时间8秒27误差20
Dialogue: 0,0:07:35.59,0:07:38.53,Layzner,Rey,0,0,0,,武器的使用方面 要用激光的话
Dialogue: 0,0:07:50.25,0:07:54.06,Layzner,Eiji,0,0,0,,总之要让他们以为里面还有人
Dialogue: 0,0:08:03.89,0:08:06.54,Layzner,Eiji,0,0,0,,辅助动力源应该还能用
Dialogue: 0,0:08:16.98,0:08:17.85,Layzner,Eiji,0,0,0,,好
Dialogue: 0,0:08:34.28,0:08:36.29,Layzner,Arthur,0,0,0,,我们如果被发现就死定了
Dialogue: 0,0:08:39.17,0:08:42.15,Layzner,Simone,0,0,0,,你还真冷血
Dialogue: 0,0:08:42.15,0:08:45.87,Layzner,Arthur,0,0,0,,如果他是以别的方式出现在我们面前就好了
Dialogue: 0,0:08:45.87,0:08:48.47,Layzner,Roanne,0,0,0,,可是总觉得哪里怪怪的
Dialogue: 0,0:08:50.33,0:08:52.58,Layzner,Arthur,0,0,0,,他应该一起来的
Dialogue: 0,0:08:52.58,0:08:54.31,Layzner,Simone,0,0,0,,你讲的好像这事跟你无关似的
Dialogue: 0,0:08:54.31,0:08:56.14,Layzner,David,0,0,0,,那种人能相信吗
Dialogue: 0,0:08:56.14,0:09:01.31,Layzner,Simone,0,0,0,,那是事实 不管大家对他的感觉如何他说的事都实现了
Dialogue: 0,0:09:01.31,0:09:04.47,Layzner,Simone,0,0,0,,他会出现是因为敌人出现了
Dialogue: 0,0:09:43.24,0:09:47.55,Layzner,Rey,0,0,0,,危险信息 三架SPT 侦测范围侵入
Dialogue: 0,0:09:47.55,0:09:48.60,Layzner,Eiji,0,0,0,,来了
Dialogue: 0,0:10:11.02,0:10:12.93,Layzner,Gosterro,0,0,0,,那些猴崽子还在里面
Dialogue: 0,0:10:12.93,0:10:14.37,Layzner,PilotA,0,0,0,,赏他们导弹吃吃吧
Dialogue: 0,0:10:14.37,0:10:16.38,Layzner,Gosterro,0,0,0,,笨蛋 怎么能用导弹这种东西
Dialogue: 0,0:10:16.38,0:10:18.29,Layzner,PilotA,0,0,0,,为什么 这样不是最有破坏力吗
Dialogue: 0,0:10:18.29,0:10:23.10,Layzner,Gosterro,0,0,0,,吵死了 料理要慢慢的品尝
Dialogue: 0,0:10:23.82,0:10:25.82,Layzner,,0,0,0,,SPT-BG-91U\n Bullgrenn
Dialogue: 0,0:10:25.82,0:10:27.82,Layzner,,0,0,0,,SPT-BV-15C\n Braver
Dialogue: 0,0:11:03.71,0:11:05.05,Layzner,Gosterro,0,0,0,,住手
Dialogue: 0,0:11:20.64,0:11:22.17,Layzner,Pilot,0,0,0,,他们好像没有要出来的迹象
Dialogue: 0,0:11:22.17,0:11:23.98,Layzner,PilotB,0,0,0,,我们要潜进去看看吗
Dialogue: 0,0:11:23.98,0:11:27.06,Layzner,Gosterro,0,0,0,,听好了了 没有我的命令不要随便乱动
Dialogue: 0,0:11:55.00,0:11:56.81,Layzner,Gosterro,0,0,0,,多米利亚 你去另一边
Dialogue: 0,0:11:56.81,0:11:59.69,Layzner,Gosterro,0,0,0,,嘉斯坦 你从中间突入 连地球人一起杀
Dialogue: 0,0:11:59.69,0:12:00.56,Layzner,Roberia/Kassen,0,0,0,,明白了
Dialogue: 0,0:12:20.48,0:12:22.41,Layzner,Eiji,0,0,0,,无论如何都要设法争取更过时间
Dialogue: 0,0:12:26.82,0:12:30.25,Layzner,Rey,0,0,0,,备用战斗燃料箱还有98单位
Dialogue: 0,0:12:30.25,0:12:33.40,Layzner,Rey,0,0,0,,离战斗还有10秒
Dialogue: 0,0:12:33.40,0:12:34.76,Layzner,Eiji,0,0,0,,10秒
Dialogue: 0,0:13:20.96,0:13:22.19,Layzner,Gosterro,0,0,0,,怎么样
Dialogue: 0,0:13:22.19,0:13:23.93,Layzner,Kaseen,0,0,0,,没有半个人
Dialogue: 0,0:13:23.93,0:13:26.13,Layzner,Kaseen,0,0,0,,地球人会不会跑了
Dialogue: 0,0:13:26.13,0:13:27.77,Layzner,Gosterro,0,0,0,,有可能
Dialogue: 0,0:13:27.77,0:13:29.29,Layzner,Kassen,0,0,0,,怎么办
Dialogue: 0,0:13:29.29,0:13:33.41,Layzner,Gosterro,0,0,0,,先别管那个 我们还有一小时时间
Dialogue: 0,0:13:33.41,0:13:35.42,Layzner,Gosterro,0,0,0,,那家伙还在这里
Dialogue: 0,0:14:08.40,0:14:12.02,Layzner,Com,0,0,0,,受到严重撞击 逃生装置无法启动
Dialogue: 0,0:14:12.02,0:14:14.52,Layzner,Gosterro,0,0,0,,嘉斯坦 你怎么了
Dialogue: 0,0:14:22.15,0:14:23.40,Layzner,Kassen,0,0,0,,我的手
Dialogue: 0,0:14:29.06,0:14:30.77,Layzner,Eiji,0,0,0,,你没事吧
Dialogue: 0,0:14:33.63,0:14:37.19,Layzner,Eiji,0,0,0,,你是我的人质了 你们通讯的频率数呢
Dialogue: 0,0:14:39.58,0:14:44.21,Layzner,Kaseen,0,0,0,,MS132-5200.
Dialogue: 0,0:14:44.21,0:14:48.58,Layzner,Eiji,0,0,0,,把通化频段定在 MS132 - 5200Mhz.
Dialogue: 0,0:14:48.58,0:14:51.47,Layzner,Gosterro,0,0,0,,怎么了嘉斯坦 回答我 嘉斯坦
Dialogue: 0,0:14:51.47,0:14:52.62,Layzner,Eiji,0,0,0,,他是我的人质
Dialogue: 0,0:14:52.62,0:14:53.47,Layzner,Gosterro,0,0,0,,什么
Dialogue: 0,0:14:53.47,0:14:58.08,Layzner,Eiji,0,0,0,,想要他无事的话就离开SPT到这来 听到了没
Dialogue: 0,0:15:00.76,0:15:02.15,Layzner,Eiji,0,0,0,,有什么好笑的
Dialogue: 0,0:15:02.15,0:15:05.88,Layzner,Gosterro,0,0,0,,好像留在这基地的只有你一个人嘛
Dialogue: 0,0:15:05.88,0:15:09.87,Layzner,Eiji,0,0,0,,不照我说的做的话你部下就没命了 我等你五分钟
Dialogue: 0,0:15:12.17,0:15:15.04,Layzner,Gosterro,0,0,0,,那才是我要跟你说的 白痴
Dialogue: 0,0:15:15.04,0:15:16.09,Layzner,Eiji,0,0,0,,什么意思
Dialogue: 0,0:15:16.09,0:15:18.75,Layzner,Gosterro,0,0,0,,要杀要剐随便你
Dialogue: 0,0:15:18.75,0:15:20.32,Layzner,Eiji,0,0,0,,我是说真的
Dialogue: 0,0:15:20.32,0:15:26.83,Layzner,Gosterro,0,0,0,,我也等你五分钟 只要你把雷兹纳交出来我可以饶你不死
Dialogue: 0,0:15:26.83,0:15:29.02,Layzner,Eiji,0,0,0,,真的让我杀了他也没关系吗
Dialogue: 0,0:15:29.02,0:15:31.04,Layzner,Eiji,0,0,0,,他是你的同伴啊
Dialogue: 0,0:15:31.04,0:15:35.16,Layzner,Gosterro,0,0,0,,我才不管 要怎么样随便你
Dialogue: 0,0:15:35.16,0:15:37.46,Layzner,Gosterro,0,0,0,,听好了我只等你五分钟哦
Dialogue: 0,0:15:38.60,0:15:40.25,Layzner,Eiji,0,0,0,,你给我待在这里
Dialogue: 0,0:15:55.96,0:15:57.59,Layzner,Gosterro,0,0,0,,过了三十秒了哦
Dialogue: 0,0:16:10.96,0:16:15.84,Layzner,Rey,0,0,0,,能源补充中  存量增加2单位
Dialogue: 0,0:16:16.71,0:16:19.29,Layzner,Gosterro,0,0,0,,还有三分钟
Dialogue: 0,0:16:20.35,0:16:23.99,Layzner,Roberia,0,0,0,,队长 他如果被逼急了很有可能杀了嘉斯坦的
Dialogue: 0,0:16:23.99,0:16:26.37,Layzner,Gosterro,0,0,0,,吵死了 不要顶嘴
Dialogue: 0,0:16:26.37,0:16:27.23,Layzner,Roberia,0,0,0,,但是
Dialogue: 0,0:16:27.23,0:16:29.56,Layzner,Gosterro,0,0,0,,不要再说些有的没的 快去追地球人
Dialogue: 0,0:16:29.56,0:16:32.32,Layzner,Gosterro,0,0,0,,他们还没走远 发现他们的话马上就杀了他们
Dialogue: 0,0:16:32.32,0:16:34.53,Layzner,Roberia,0,0,0,,是 我知道了
Dialogue: 0,0:16:35.39,0:16:36.83,Layzner,Eiji,0,0,0,,住手
Dialogue: 0,0:16:37.75,0:16:39.35,Layzner,Eiji,0,0,0,,不要让他去
Dialogue: 0,0:16:46.50,0:16:47.37,Layzner,Gosterro,0,0,0,,胆小鬼
Dialogue: 0,0:16:47.37,0:16:48.80,Layzner,Eiji,0,0,0,,部下出事也没关系吗
Dialogue: 0,0:16:48.80,0:16:50.63,Layzner,Gosterro,0,0,0,,还有两分钟
Dialogue: 0,0:16:59.22,0:17:00.74,Layzner,Elizabeth,0,0,0,,风越来越大了
Dialogue: 0,0:17:00.74,0:17:03.70,Layzner,Man,0,0,0,,这种风力刚好可以隐藏我们车子的行踪
Dialogue: 0,0:17:03.70,0:17:06.39,Layzner,Man,0,0,0,,不过再大下去就不行了
Dialogue: 0,0:17:06.39,0:17:08.30,Layzner,Elizabeth,0,0,0,,到这里才走了一半是吗
Dialogue: 0,0:17:08.30,0:17:09.46,Layzner,Man,0,0,0,,啊
Dialogue: 0,0:17:09.46,0:17:12.91,Layzner,Elizabeth,0,0,0,,拜托 希望可以平安到达
Dialogue: 0,0:17:14.49,0:17:17.02,Layzner,Arthur,0,0,0,,那家伙现在还在战斗吗
Dialogue: 0,0:17:17.02,0:17:20.29,Layzner,Simone,0,0,0,,敌人没追来的话就应该没错吧
Dialogue: 0,0:17:20.29,0:17:22.12,Layzner,David,0,0,0,,这怎么知道
Dialogue: 0,0:17:22.12,0:17:24.42,Layzner,Roanne,0,0,0,,我觉得他应该是在战斗
Dialogue: 0,0:17:26.13,0:17:29.30,Layzner,Roanne,0,0,0,,至少我是这么觉得的
Dialogue: 0,0:17:29.30,0:17:34.76,Layzner,Man,0,0,0,,如果我们能平安到达的话 应该好好感谢他
Dialogue: 0,0:17:36.58,0:17:40.80,Layzner,Anna,0,0,0,,他现在为了救我们
Dialogue: 0,0:17:42.53,0:17:46.15,Layzner,Gosterro,0,0,0,,还有三十秒 小鬼 快放弃 给我乖乖出来
Dialogue: 0,0:17:46.15,0:17:49.09,Layzner,Eiji,0,0,0,,快来把你的部下带回去 我是认真的
Dialogue: 0,0:17:49.09,0:17:52.34,Layzner,Gosterro,0,0,0,,小鬼你还想逃到哪去
Dialogue: 0,0:17:52.34,0:17:53.78,Layzner,Kassen,0,0,0,,队长请救救我啊
Dialogue: 0,0:17:53.78,0:17:57.61,Layzner,Rey,0,0,0,,能源存量只剩一单位
Dialogue: 0,0:17:57.61,0:18:00.49,Layzner,Rey,0,0,0,,资讯信息系统无法使用
Dialogue: 0,0:18:00.49,0:18:01.92,Layzner,Gosterro,0,0,0,,还剩15秒
Dialogue: 0,0:18:01.92,0:18:03.28,Layzner,Kassen,0,0,0,,队长
Dialogue: 0,0:18:03.28,0:18:04.41,Layzner,Eiji,0,0,0,,不要吵
Dialogue: 0,0:18:04.41,0:18:05.48,Layzner,Gosterro,0,0,0,,11...
Dialogue: 0,0:18:05.48,0:18:06.32,Layzner,Gosterro,0,0,0,,10...
Dialogue: 0,0:18:06.32,0:18:07.29,Layzner,Gosterro,0,0,0,,9...
Dialogue: 0,0:18:07.29,0:18:08.36,Layzner,Gosterro,0,0,0,,8...
Dialogue: 0,0:18:08.36,0:18:09.32,Layzner,Gosterro,0,0,0,,7...
Dialogue: 0,0:18:09.32,0:18:10.27,Layzner,Gosterro,0,0,0,,6...
Dialogue: 0,0:18:10.27,0:18:11.22,Layzner,Gosterro,0,0,0,,5...
Dialogue: 0,0:18:10.93,0:18:13.24,Layzner,Rey,0,0,0,,能源存量用尽
Dialogue: 0,0:18:11.22,0:18:12.28,Layzner,Gosterro,0,0,0,,4...
Dialogue: 0,0:18:12.28,0:18:13.24,Layzner,Gosterro,0,0,0,,3...
Dialogue: 0,0:18:13.24,0:18:14.39,Layzner,Gosterro,0,0,0,,2...
Dialogue: 0,0:18:14.39,0:18:15.79,Layzner,Gosterro,0,0,0,,1...
Dialogue: 0,0:18:14.72,0:18:15.80,Layzner,Kassen,0,0,0,,队长
Dialogue: 0,0:18:15.80,0:18:17.45,Layzner,Gosterro,0,0,0,,时间到
Dialogue: 0,0:18:35.03,0:18:36.00,Layzner,Eiji,0,0,0,,可恶
Dialogue: 0,0:18:44.43,0:18:48.74,Layzner,Rey,0,0,0,,能源存量剩0单位
Dialogue: 0,0:18:49.42,0:18:50.79,Layzner,Kassen,0,0,0,,等一下
Dialogue: 0,0:18:50.79,0:18:54.81,Layzner,Kassen,0,0,0,,为什么不开枪 地球人的话应该做得到的 为什么
Dialogue: 0,0:18:54.81,0:18:57.89,Layzner,Eiji,0,0,0,,我身体里的血有一半是古拉特斯人的
Dialogue: 0,0:18:59.74,0:19:01.06,Layzner,Kaseen,0,0,0,,一半
Dialogue: 0,0:19:01.06,0:19:04.89,Layzner,Eiji,0,0,0,,我的妈妈跟你一样也是古拉特斯人
Dialogue: 0,0:19:21.29,0:19:24.16,Layzner,Kassen,0,0,0,,可恶 连我都要杀
Dialogue: 0,0:19:24.16,0:19:25.76,Layzner,Eiji,0,0,0,,准备出发吧
Dialogue: 0,0:19:25.76,0:19:26.45,Layzner,Rey,0,0,0,,Ready.
Dialogue: 0,0:19:39.02,0:19:42.84,Layzner,Gosterro,0,0,0,,明明就不会杀人的 小鬼给我下来
Dialogue: 0,0:19:47.63,0:19:50.60,Layzner,Gosterro,0,0,0,,你这小鬼 让你看看我的厉害
Dialogue: 0,0:19:56.37,0:20:00.09,Layzner,Rey,0,0,0,,战斗信息 目标转变
Dialogue: 0,0:20:00.94,0:20:01.81,Layzner,Eiji,0,0,0,,不行
Dialogue: 0,0:20:07.89,0:20:10.45,Layzner,Gosterro,0,0,0,,要战斗就要像这样
Dialogue: 0,0:20:12.84,0:20:16.10,Layzner,Rey,0,0,0,,遭到攻击 损伤轻微
Dialogue: 0,0:20:16.10,0:20:18.77,Layzner,Rey,0,0,0,,瞄准敌人SPT中枢
Dialogue: 0,0:20:18.77,0:20:23.09,Layzner,Rey,0,0,0,,重复 瞄准敌人SPT中枢
Dialogue: 0,0:20:28.94,0:20:30.28,Layzner,Gosterro,0,0,0,,笨蛋
Dialogue: 0,0:20:42.93,0:20:45.90,Layzner,Gosterro,0,0,0,,这下你终于束手无策 到地面上来跟我打了吧
Dialogue: 0,0:20:45.90,0:20:50.40,Layzner,Gosterro,0,0,0,,小鬼 你就听着自己的心跳死去吧
Dialogue: 0,0:20:56.65,0:20:57.95,Layzner,Gosterro,0,0,0,,你这家伙
Dialogue: 0,0:21:04.50,0:21:07.18,Layzner,Com,0,0,0,,更换能源 能源透支
Dialogue: 0,0:21:07.18,0:21:08.88,Layzner,Kassen,0,0,0,,我要杀了你
Dialogue: 0,0:21:08.88,0:21:11.00,Layzner,Gosterro,0,0,0,,你这家伙 竟把枪对准我
Dialogue: 0,0:21:11.00,0:21:13.68,Layzner,Kassen,0,0,0,,你能说的只有这句话吗
Dialogue: 0,0:21:16.22,0:21:18.86,Layzner,Kassen,0,0,0,,小子 快逃吧
Dialogue: 0,0:21:20.51,0:21:22.31,Layzner,Kassen,0,0,0,,你还在等什么 快走
Dialogue: 0,0:21:29.49,0:21:31.01,Layzner,Gosterro,0,0,0,,可恶
Dialogue: 0,0:21:31.01,0:21:35.22,Layzner,Com,0,0,0,,更换能源 能源透支 激光无法充电
Dialogue: 0,0:22:10.82,0:22:13.20,Layzner,Gosterro,0,0,0,,混蛋 竟敢跟我作对
Dialogue: 0,0:22:41.52,0:22:43.82,Layzner,Anna,0,0,0,,那少年被杀了
Dialogue: 0,0:22:45.05,0:22:50.71,Layzner,Anna,0,0,0,,当新的敌人出现在我们面前时 大家是这样想的
Dialogue: 0,0:23:54.66,0:23:56.58,Layzner,,0,0,0,,我们才不要你来保护我们呢
Dialogue: 0,0:23:57.83,0:23:59.58,Layzner,,0,0,0,,在你们的星球都不会打架吗
Dialogue: 0,0:24:00.21,0:24:02.50,Layzner,,0,0,0,,他想把我们都杀了
Dialogue: 0,0:24:04.50,0:24:09.38,Layzner,,0,0,0,,下一话 即使被保护 但又

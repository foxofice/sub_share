Dialogue: 0,0:00:02.00,0:00:10.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕組製作 僅供學習交流 禁止用於商業用途
Comment: 0,0:03:18.96,0:03:19.01,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:03:19.78,0:03:24.95,op-jp,,0,0,0,,希望に溢れた　お前の目に浮かぶのは
Dialogue: 0,0:03:24.95,0:03:26.71,op-jp,,0,0,0,,誰の幻想？
Dialogue: 0,0:03:26.71,0:03:30.06,op-jp,,0,0,0,,何もかも失いそうになって
Dialogue: 0,0:03:30.06,0:03:35.24,op-jp,,0,0,0,,巡り会うんだ　再会の誓いを
Dialogue: 0,0:03:48.19,0:03:51.19,op-jp,,0,0,0,,段々と熱くなる
Dialogue: 0,0:03:51.19,0:03:55.44,op-jp,,0,0,0,,心　燃やす　咆哮に変えてけ
Dialogue: 0,0:03:55.44,0:03:58.27,op-jp,,0,0,0,,飄々と歩くのさ
Dialogue: 0,0:03:58.27,0:04:03.17,op-jp,,0,0,0,,先の見えぬ夢を掴むまで
Dialogue: 0,0:04:03.34,0:04:08.67,op-jp,,0,0,0,,時には涙を流す夜もある
Dialogue: 0,0:04:08.67,0:04:13.30,op-jp,,0,0,0,,誓ったあの日を共に笑った事
Dialogue: 0,0:04:13.30,0:04:15.80,op-jp,,0,0,0,,胸に刻み込んで
Dialogue: 0,0:04:15.80,0:04:22.85,op-jp,,0,0,0,,嗚呼　息もできないこの世界であなたにあった夜
Dialogue: 0,0:04:22.85,0:04:29.61,op-jp,,0,0,0,,消えかけた心の灯火　輝いた
Dialogue: 0,0:04:29.98,0:04:34.36,op-jp,,0,0,0,,どんな未来だって　受け容れる
Dialogue: 0,0:04:34.36,0:04:37.12,op-jp,,0,0,0,,生きる理由なんだ
Dialogue: 0,0:04:37.12,0:04:42.37,op-jp,,0,0,0,,燃やせ　今この声が響く限り
Dialogue: 0,0:04:42.37,0:04:48.28,op-jp,,0,0,0,,果てなき明日へ
Dialogue: 0,0:04:48.28,0:04:48.28,op-jp,,0,0,0,,
Dialogue: 0,0:03:19.78,0:03:24.95,op-cn,,0,0,0,,你那充滿希望的雙眸中
Dialogue: 0,0:03:24.95,0:03:26.71,op-cn,,0,0,0,,映出誰的幻想？
Dialogue: 0,0:03:26.71,0:03:30.06,op-cn,,0,0,0,,在即將失去一切之時
Dialogue: 0,0:03:30.06,0:03:35.24,op-cn,,0,0,0,,邂逅重逢的誓言
Dialogue: 0,0:03:48.19,0:03:51.19,op-cn,,0,0,0,,身體愈發火熱
Dialogue: 0,0:03:51.19,0:03:55.44,op-cn,,0,0,0,,燃燒內心 化為咆哮
Dialogue: 0,0:03:55.44,0:03:58.27,op-cn,,0,0,0,,步伐愈顯輕盈
Dialogue: 0,0:03:58.27,0:04:03.17,op-cn,,0,0,0,,直至抓住 未知之夢
Dialogue: 0,0:04:03.34,0:04:08.67,op-cn,,0,0,0,,時而於夜晚落淚
Dialogue: 0,0:04:08.67,0:04:13.30,op-cn,,0,0,0,,一同歡笑 共度立誓之日
Dialogue: 0,0:04:13.30,0:04:15.80,op-cn,,0,0,0,,將其銘記於心
Dialogue: 0,0:04:15.80,0:04:22.85,op-cn,,0,0,0,,在這窒息的世界 邂逅你的夜晚
Dialogue: 0,0:04:22.85,0:04:29.61,op-cn,,0,0,0,,即將熄滅的心中燈火 光芒四射
Dialogue: 0,0:04:29.98,0:04:34.36,op-cn,,0,0,0,,不論怎樣的未來 都甘願接受
Dialogue: 0,0:04:34.36,0:04:37.12,op-cn,,0,0,0,,這就是活著的理由
Dialogue: 0,0:04:37.12,0:04:42.37,op-cn,,0,0,0,,燃燒吧 只要這聲音迴響不止
Dialogue: 0,0:04:42.37,0:04:48.28,op-cn,,0,0,8,,前往永無止境的明天
Dialogue: 0,0:02:09.30,0:02:11.30,op-cn,,0,0,0,,
Comment: 0,0:23:15.95,0:23:16.04,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:23:29.89,0:23:40.15,ed-jp,,0,0,0,,真っ暗闇の中、光の希望が消え去ることない
Dialogue: 0,0:23:40.15,0:23:43.59,ed-jp,,0,0,0,,ただひとつの誓い
Dialogue: 0,0:23:43.59,0:23:49.82,ed-jp,,0,0,0,,傷だらけでも傷んだ分だけ
Dialogue: 0,0:23:49.82,0:23:56.98,ed-jp,,0,0,0,,繋いだ心　そばにあるさ
Dialogue: 0,0:23:57.17,0:24:03.79,ed-jp,,0,0,0,,大切なもの守り抜けと　その血、汗、涙が導く
Dialogue: 0,0:24:03.79,0:24:10.82,ed-jp,,0,0,0,,己の心に従え、振り向くな、さぁ立ち上がれ
Dialogue: 0,0:24:10.82,0:24:16.53,ed-jp,,0,0,0,,俺が俺である限り　己信じ、明日を思い描け
Dialogue: 0,0:24:16.53,0:24:19.78,ed-jp,,0,0,0,,恐れるな、さぁ高く翔べ
Dialogue: 0,0:24:19.78,0:24:25.73,ed-jp,,0,0,0,,俺たちが輝く日まで
Dialogue: 0,0:24:25.73,0:24:27.73,ed-jp,,0,0,0,,
Dialogue: 0,0:23:29.89,0:23:40.15,ed-cn,,0,0,0,,即便陷入黑暗 希望之光也不會消失
Dialogue: 0,0:23:40.15,0:23:43.59,ed-cn,,0,0,0,,這唯一的誓言
Dialogue: 0,0:23:43.59,0:23:49.82,ed-cn,,0,0,0,,受傷幾次 就強大幾分
Dialogue: 0,0:23:49.82,0:23:56.98,ed-cn,,0,0,0,,我們心心相連 不離不棄
Dialogue: 0,0:23:57.17,0:24:03.79,ed-cn,,0,0,0,,守護珍視之物 以鮮血 汗水 淚水為指引
Dialogue: 0,0:24:03.79,0:24:10.82,ed-cn,,0,0,0,,遵循內心 不要回頭 奮起戰鬥
Dialogue: 0,0:24:10.82,0:24:16.53,ed-cn,,0,0,0,,只要我還是我 就相信自己 描繪明天
Dialogue: 0,0:24:16.53,0:24:19.78,ed-cn,,0,0,0,,不要畏懼 展翅高飛
Dialogue: 0,0:24:19.78,0:24:25.73,ed-cn,,0,0,0,,飛向我們大放異彩之日
Dialogue: 0,0:24:25.73,0:24:25.73,ed-cn,,0,0,0,,
Dialogue: 0,0:00:02.72,0:00:04.60,Default,,0,0,0,,逝去的人們
Dialogue: 0,0:00:05.83,0:00:06.53,Default,,0,0,0,,王騎
Dialogue: 0,0:00:07.40,0:00:08.45,Default,,0,0,0,,麃公
Dialogue: 0,0:00:09.47,0:00:10.51,Default,,0,0,0,,成蟜
Dialogue: 0,0:00:11.22,0:00:14.15,Default,,0,0,0,,以及眾多無名之人
Dialogue: 0,0:00:17.37,0:00:19.08,Default,,0,0,0,,雖然身份地位各不相同
Dialogue: 0,0:00:19.40,0:00:20.72,Default,,0,0,0,,但他們所有人
Dialogue: 0,0:00:21.26,0:00:23.30,Default,,0,0,0,,生前都拚命地
Dialogue: 0,0:00:24.33,0:00:26.63,Default,,0,0,0,,想讓體內那簇光更加明亮
Dialogue: 0,0:00:27.86,0:00:30.00,Default,,0,0,0,,而那簇光
Dialogue: 0,0:00:30.40,0:00:32.03,Default,,0,0,0,,又由後繼者繼承
Dialogue: 0,0:00:33.16,0:00:34.82,Default,,0,0,0,,變得更加有力
Dialogue: 0,0:00:37.41,0:00:39.10,Default,,0,0,0,,更加明亮
Dialogue: 0,0:00:39.64,0:00:41.64,Default,,0,0,0,,人就是如此聯繫
Dialogue: 0,0:00:43.43,0:00:45.65,Default,,0,0,0,,朝著更好的方向前進
Dialogue: 0,0:00:47.47,0:00:49.02,Default,,0,0,0,,人之所以會墮入黑暗
Dialogue: 0,0:00:50.07,0:00:52.50,Default,,0,0,0,,是因為迷失了自己的光
Dialogue: 0,0:00:53.24,0:00:56.53,Default,,0,0,0,,那些人尋不見光 苦苦掙扎 飽受折磨
Dialogue: 0,0:00:57.02,0:00:58.24,Default,,0,0,0,,悲劇由此而生
Dialogue: 0,0:01:00.21,0:01:06.25,Default,,0,0,0,,增幅悲劇 使人墮入黑暗的罪魁禍首便是戰爭
Dialogue: 0,0:01:07.12,0:01:09.50,Default,,0,0,0,,因此 寡人要消除戰爭
Dialogue: 0,0:01:10.21,0:01:11.50,Default,,0,0,0,,使用武力消除嗎
Dialogue: 0,0:01:11.94,0:01:12.99,Default,,0,0,0,,正是
Dialogue: 0,0:01:13.84,0:01:16.00,Default,,0,0,0,,寡人是戰國之君王
Dialogue: 0,0:01:16.87,0:01:19.51,Default,,0,0,0,,注定無法擺脫戰爭
Dialogue: 0,0:01:20.87,0:01:22.76,Default,,0,0,0,,既然如此 就在寡人這一代消除戰爭
Dialogue: 0,0:01:23.28,0:01:26.77,Default,,0,0,0,,即便被指為暴君 也要用武力去實現
Dialogue: 0,0:01:27.51,0:01:31.00,Default,,0,0,0,,讓中華沒有隔閡 不分上下
Dialogue: 0,0:01:31.48,0:01:32.55,Default,,0,0,0,,合而為一
Dialogue: 0,0:01:33.01,0:01:34.28,Default,,0,0,0,,如此一來
Dialogue: 0,0:01:35.02,0:01:36.47,Default,,0,0,0,,寡人的下一代人
Dialogue: 0,0:01:38.39,0:01:41.30,Default,,0,0,0,,就一定不再需要自相殘殺
Dialogue: 0,0:02:02.96,0:02:03.78,Default,,0,0,0,,呂不韋
Dialogue: 0,0:02:04.79,0:02:08.03,Default,,0,0,0,,究竟怎樣的世界才更加…
Dialogue: 0,0:02:08.03,0:02:10.02,Default,,0,0,0,,不必再說了
Dialogue: 0,0:02:17.98,0:02:23.41,Default,,0,0,0,,您所構思的世界和我所構思的世界
Dialogue: 0,0:02:24.49,0:02:27.54,Default,,0,0,0,,其出發點 前提大不相同
Dialogue: 0,0:02:28.62,0:02:32.87,Default,,0,0,0,,即便繼續討論下去 也無法得出結論
Dialogue: 0,0:02:34.45,0:02:37.84,Default,,0,0,0,,不過 話說回來
Dialogue: 0,0:02:39.38,0:02:43.14,Default,,0,0,0,,您真是長大了啊 大王
Dialogue: 0,0:02:56.44,0:02:57.70,Default,,0,0,0,,我已經知道
Dialogue: 0,0:02:58.31,0:03:03.48,Default,,0,0,0,,我們二人所構思的為政之道都絕非尋常
Dialogue: 0,0:03:04.09,0:03:06.23,Default,,0,0,0,,我們之間的勝負
Dialogue: 0,0:03:06.96,0:03:12.19,Default,,0,0,0,,將決定秦國明天將走上怎樣的道路
Dialogue: 0,0:03:13.20,0:03:17.78,Default,,0,0,0,,而答案即將在咸陽得出
Dialogue: 0,0:04:49.47,0:04:52.64,biaoti,,0,0,0,,{\pos(1811,810)\fad(480,470)}命懸一線的奔逃
Dialogue: 0,0:04:50.25,0:04:55.69,Default,,0,0,0,,每一座建築都散發著強烈的女人味
Dialogue: 0,0:04:56.04,0:04:58.80,Default,,0,0,0,,後宮真叫人把持不住啊
Dialogue: 0,0:05:01.97,0:05:05.61,Default,,0,0,0,,宮女的肉比普通女人的更柔軟
Dialogue: 0,0:05:06.46,0:05:09.37,Default,,0,0,0,,大王居然能獨佔她們
Dialogue: 0,0:05:10.22,0:05:11.11,Default,,0,0,0,,琉期大人
Dialogue: 0,0:05:11.42,0:05:14.69,Default,,0,0,0,,樊於期大人前去斬殺太子了
Dialogue: 0,0:05:15.25,0:05:17.17,Default,,0,0,0,,我們也快拿下公主吧
Dialogue: 0,0:05:17.47,0:05:18.88,Default,,0,0,0,,我知道
Dialogue: 0,0:05:19.64,0:05:21.46,Default,,0,0,0,,不過也不要心急
Dialogue: 0,0:05:22.24,0:05:26.01,Default,,0,0,0,,反正大王的子女無處可逃
Dialogue: 0,0:05:32.08,0:05:34.34,Default,,0,0,0,,外面的呼喊聲已經很近了
Dialogue: 0,0:05:35.21,0:05:37.30,Default,,0,0,0,,微久閣下 快開門
Dialogue: 0,0:05:39.17,0:05:40.44,Default,,0,0,0,,為什麼
Dialogue: 0,0:05:41.49,0:05:44.24,Default,,0,0,0,,黑石移動了
Dialogue: 0,0:05:45.48,0:05:49.68,Default,,0,0,0,,今天早上 我來檢查這扇門是否鎖好
Dialogue: 0,0:05:50.10,0:05:54.90,Default,,0,0,0,,然後以防萬一 貼著門放了一塊黑石
Dialogue: 0,0:05:56.39,0:05:59.21,Default,,0,0,0,,而現在 黑石居然移動了
Dialogue: 0,0:05:59.54,0:06:02.31,Default,,0,0,0,,有人進入了門內
Dialogue: 0,0:06:03.88,0:06:05.00,Default,,0,0,0,,微久閣下
Dialogue: 0,0:06:05.22,0:06:06.63,Default,,0,0,0,,不能走這裡
Dialogue: 0,0:06:08.00,0:06:09.94,Default,,0,0,0,,為什麼這裡會被發現
Dialogue: 0,0:06:10.36,0:06:13.86,Default,,0,0,0,,這可是連太后都不知道的地道入口啊
Dialogue: 0,0:06:14.68,0:06:19.35,Default,,0,0,0,,難道說 我這幾天被人監視了？
Dialogue: 0,0:06:19.78,0:06:21.85,Default,,0,0,0,,微久閣下 為什麼不行啊
Dialogue: 0,0:06:22.24,0:06:23.41,Default,,0,0,0,,那要去哪裡
Dialogue: 0,0:06:25.32,0:06:26.78,Default,,0,0,0,,哎呀
Dialogue: 0,0:06:27.27,0:06:31.18,Default,,0,0,0,,向大人和麗殿下 很高興看到二位平安無事
Dialogue: 0,0:06:31.76,0:06:34.67,Default,,0,0,0,,請快些進入地道
Dialogue: 0,0:06:35.43,0:06:36.42,Default,,0,0,0,,微久閣下
Dialogue: 0,0:06:36.55,0:06:38.82,Default,,0,0,0,,不要靠近 你是何人
Dialogue: 0,0:06:39.31,0:06:44.34,Default,,0,0,0,,我是大王欽點的內務官 微久
Dialogue: 0,0:06:44.88,0:06:48.54,Default,,0,0,0,,我是大殿侍者 名叫亞民
Dialogue: 0,0:06:48.95,0:06:51.63,Default,,0,0,0,,內務官大人 請快進入地道
Dialogue: 0,0:06:51.63,0:06:53.93,Default,,0,0,0,,我來帶路
Dialogue: 0,0:06:54.29,0:06:55.11,Default,,0,0,0,,不必
Dialogue: 0,0:06:55.32,0:06:57.68,Default,,0,0,0,,由我帶她們三位逃離便可
Dialogue: 0,0:07:01.43,0:07:02.31,Default,,0,0,0,,小向
Dialogue: 0,0:07:07.16,0:07:08.23,Default,,0,0,0,,微久閣下
Dialogue: 0,0:07:09.83,0:07:10.94,Default,,0,0,0,,快逃
Dialogue: 0,0:07:11.24,0:07:13.45,Default,,0,0,0,,趁現在 快逃
Dialogue: 0,0:07:13.51,0:07:14.03,Default,,0,0,0,,微…
Dialogue: 0,0:07:15.45,0:07:16.87,Default,,0,0,0,,我們走 小向
Dialogue: 0,0:07:23.68,0:07:24.71,Default,,0,0,0,,小陽
Dialogue: 0,0:07:26.44,0:07:27.91,Default,,0,0,0,,你的腳都腫成這樣了
Dialogue: 0,0:07:28.20,0:07:30.36,Default,,0,0,0,,小陽 說不定傷到了骨頭
Dialogue: 0,0:07:32.82,0:07:34.68,Default,,0,0,0,,我沒事 快走吧
Dialogue: 0,0:07:35.24,0:07:37.59,Default,,0,0,0,,都有宦官和敵人勾結了
Dialogue: 0,0:07:38.16,0:07:39.64,Default,,0,0,0,,說不定宮女中也有人通敵
Dialogue: 0,0:07:40.15,0:07:42.98,Default,,0,0,0,,這裡很危險 必須快點離開
Dialogue: 0,0:07:43.76,0:07:44.92,Default,,0,0,0,,小陽…
Dialogue: 0,0:07:45.78,0:07:46.74,Default,,0,0,0,,麗…
Dialogue: 0,0:07:47.67,0:07:48.64,Default,,0,0,0,,沒事的
Dialogue: 0,0:07:49.08,0:07:53.45,Default,,0,0,0,,我和小向的運氣和骨氣可不輸其他宮女
Dialogue: 0,0:07:54.31,0:07:57.39,Default,,0,0,0,,你也要盡全力往前跑
Dialogue: 0,0:07:58.30,0:07:58.88,Default,,0,0,0,,嗯
Dialogue: 0,0:08:00.79,0:08:02.28,Default,,0,0,0,,小陽 我來扶你
Dialogue: 0,0:08:02.28,0:08:03.13,Default,,0,0,0,,不用
Dialogue: 0,0:08:04.12,0:08:06.23,Default,,0,0,0,,小向 你看
Dialogue: 0,0:08:08.02,0:08:11.78,Default,,0,0,0,,這裡是我們第一次相遇的地方 黃大庭
Dialogue: 0,0:08:12.95,0:08:13.66,Default,,0,0,0,,麗
Dialogue: 0,0:08:14.13,0:08:19.31,Default,,0,0,0,,我和小向就是在這裡打掃的時候認識的
Dialogue: 0,0:08:20.45,0:08:24.02,Default,,0,0,0,,那時我們光顧著聊天 每天都被罵
Dialogue: 0,0:08:27.83,0:08:31.91,Default,,0,0,0,,廢物 你沒能把她們關到地道裡？
Dialogue: 0,0:08:31.91,0:08:34.77,Default,,0,0,0,,是 是的 非常抱歉
Dialogue: 0,0:08:35.21,0:08:38.95,Default,,0,0,0,,不知為何 微久在開門前察覺到了異樣
Dialogue: 0,0:08:39.58,0:08:40.85,Default,,0,0,0,,讓他們逃了嗎
Dialogue: 0,0:08:41.25,0:08:43.49,Default,,0,0,0,,請 請不必擔心
Dialogue: 0,0:08:43.64,0:08:45.46,Default,,0,0,0,,這裡是我們的庭院
Dialogue: 0,0:08:46.00,0:08:47.71,Default,,0,0,0,,很快就能找到她們
Dialogue: 0,0:08:48.29,0:08:49.78,Default,,0,0,0,,去通知琉期大人
Dialogue: 0,0:08:50.15,0:08:50.69,Default,,0,0,0,,是
Dialogue: 0,0:08:51.30,0:08:53.79,Default,,0,0,0,,對宮女們來說也是庭院啊
Dialogue: 0,0:08:54.28,0:08:56.22,Default,,0,0,0,,琉期大人不允許失敗
Dialogue: 0,0:08:56.95,0:09:00.68,Default,,0,0,0,,你們會不得好死的 洗乾淨脖子等著吧
Dialogue: 0,0:09:01.40,0:09:02.58,Default,,0,0,0,,不要啊
Dialogue: 0,0:09:02.58,0:09:04.23,Default,,0,0,0,,請慢著 馬上就能找到
Dialogue: 0,0:09:04.99,0:09:07.06,Default,,0,0,0,,我知道向她們逃跑的方向
Dialogue: 0,0:09:07.92,0:09:09.00,Default,,0,0,0,,為什麼知道
Dialogue: 0,0:09:10.12,0:09:13.94,Default,,0,0,0,,這一帶是她們兩人從小就負責打理的區域
Dialogue: 0,0:09:14.74,0:09:19.27,Default,,0,0,0,,她們對這裡過於了解 所以能預測到她們的逃跑路線
Dialogue: 0,0:09:20.87,0:09:24.24,Default,,0,0,0,,那小丫頭竟不知好歹地獲得了這樣的幸福
Dialogue: 0,0:09:24.44,0:09:26.70,Default,,0,0,0,,請一定要讓她悽慘地死去
Dialogue: 0,0:09:34.40,0:09:36.21,Default,,0,0,0,,前面右轉沒錯吧 小陽
Dialogue: 0,0:09:36.76,0:09:38.05,Default,,0,0,0,,對 右轉
Dialogue: 0,0:09:38.48,0:09:39.81,Default,,0,0,0,,然後再經過兩片房屋
Dialogue: 0,0:09:40.54,0:09:41.92,Default,,0,0,0,,只要走出小路…
Dialogue: 0,0:09:42.83,0:09:43.89,Default,,0,0,0,,就能最快…
Dialogue: 0,0:09:46.76,0:09:48.25,Default,,0,0,0,,來到三低道
Dialogue: 0,0:09:48.88,0:09:49.48,Default,,0,0,0,,小陽
Dialogue: 0,0:09:50.02,0:09:50.85,Default,,0,0,0,,好
Dialogue: 0,0:09:51.76,0:09:54.85,Default,,0,0,0,,從這裡進入流淌在後宮的可晶水道
Dialogue: 0,0:09:55.18,0:09:57.00,Default,,0,0,0,,就能乘船去到最北端
Dialogue: 0,0:09:58.28,0:10:02.77,Default,,0,0,0,,這種時候 最優先的是遠離敵人
Dialogue: 0,0:10:03.51,0:10:04.80,Default,,0,0,0,,是父親教我的
Dialogue: 0,0:10:15.99,0:10:17.86,Default,,0,0,0,,快進入剛才的小路
Dialogue: 0,0:10:19.51,0:10:20.43,Default,,0,0,0,,小陽
Dialogue: 0,0:10:22.33,0:10:24.21,Default,,0,0,0,,往水道跑 小向
Dialogue: 0,0:10:24.97,0:10:26.47,Default,,0,0,0,,我來爭取時間
Dialogue: 0,0:10:27.08,0:10:29.36,Default,,0,0,0,,你 你說什麼呢
Dialogue: 0,0:10:29.36,0:10:31.25,Default,,0,0,0,,我不要 小陽 我們一起…
Dialogue: 0,0:10:31.25,0:10:31.96,Default,,0,0,0,,向
Dialogue: 0,0:10:32.51,0:10:35.27,Default,,0,0,0,,你不是說無論如何也要保護麗嗎
Dialogue: 0,0:10:35.97,0:10:40.20,Default,,0,0,0,,去履行你作為妃子 作為母親的使命吧
Dialogue: 0,0:10:45.11,0:10:46.95,Default,,0,0,0,,快走吧 小向
Dialogue: 0,0:10:47.50,0:10:48.13,Default,,0,0,0,,嗯…
Dialogue: 0,0:11:00.32,0:11:02.34,Default,,0,0,0,,小陽 小陽
Dialogue: 0,0:11:02.80,0:11:04.14,Default,,0,0,0,,小陽
Dialogue: 0,0:11:07.03,0:11:09.97,Default,,0,0,0,,撲到領頭的馬身上 讓它摔倒
Dialogue: 0,0:11:10.16,0:11:12.92,Default,,0,0,0,,把後面的馬一起絆倒
Dialogue: 0,0:11:14.53,0:11:17.27,Default,,0,0,0,,怎麼可能這麼順利
Dialogue: 0,0:11:18.80,0:11:20.77,Default,,0,0,0,,總之要把領頭的那匹馬…
Dialogue: 0,0:11:22.12,0:11:25.20,Default,,0,0,0,,會痛嗎 肯定會很痛吧
Dialogue: 0,0:11:26.37,0:11:28.61,Default,,0,0,0,,這種事不重要
Dialogue: 0,0:11:30.06,0:11:32.08,Default,,0,0,0,,小向 我啊
Dialogue: 0,0:11:33.52,0:11:37.72,Default,,0,0,0,,雖然你是我的好朋友 但我卻有點把你當妹妹
Dialogue: 0,0:11:39.42,0:11:43.70,Default,,0,0,0,,我五歲的時候 唯一的妹妹病死了
Dialogue: 0,0:11:44.84,0:11:49.21,Default,,0,0,0,,或許是我在你的身上 看到了妹妹的影子
Dialogue: 0,0:11:53.16,0:11:55.38,Default,,0,0,0,,跑到最後一刻吧 小向
Dialogue: 0,0:12:01.87,0:12:06.18,Default,,0,0,0,,老天啊 請一定要保佑她們二人平安無事
Dialogue: 0,0:12:06.76,0:12:08.05,Default,,0,0,0,,小陽
Dialogue: 0,0:12:17.35,0:12:20.63,Default,,0,0,0,,真是的 你這宮女真是夠猛啊
Dialogue: 0,0:12:21.88,0:12:24.16,Default,,0,0,0,,退後點 骨氣宮女
Dialogue: 0,0:12:25.11,0:12:26.59,Default,,0,0,0,,已經沒事了
Dialogue: 0,0:12:27.89,0:12:29.34,Default,,0,0,0,,對方是騎馬的啊
Dialogue: 0,0:12:36.52,0:12:37.40,Default,,0,0,0,,把馬給…
Dialogue: 0,0:12:41.09,0:12:43.63,Default,,0,0,0,,彭英 夏布 高陸
Dialogue: 0,0:12:55.99,0:12:57.08,Default,,0,0,0,,等等
Dialogue: 0,0:13:04.16,0:13:08.00,Default,,0,0,0,,我的手 我的手啊
Dialogue: 0,0:13:09.00,0:13:10.65,Default,,0,0,0,,琉 琉期大人
Dialogue: 0,0:13:10.81,0:13:11.83,Default,,0,0,0,,該死的
Dialogue: 0,0:13:13.88,0:13:15.25,Default,,0,0,0,,又有騎兵來了
Dialogue: 0,0:13:16.52,0:13:17.68,Default,,0,0,0,,別擔心
Dialogue: 0,0:13:19.28,0:13:20.88,Default,,0,0,0,,那是我的人
Dialogue: 0,0:13:21.04,0:13:21.89,Default,,0,0,0,,信
Dialogue: 0,0:13:21.89,0:13:23.33,Default,,0,0,0,,我們這就來
Dialogue: 0,0:13:26.32,0:13:27.76,Default,,0,0,0,,你 你們幾個
Dialogue: 0,0:13:30.20,0:13:32.82,Default,,0,0,0,,居然丟下隊長自己跑了
Dialogue: 0,0:13:33.36,0:13:35.50,Default,,0,0,0,,你真沒人望啊
Dialogue: 0,0:13:35.95,0:13:38.51,Default,,0,0,0,,和我們的隊長差遠了
Dialogue: 0,0:13:38.96,0:13:41.08,Default,,0,0,0,,你的傷沒事吧 信
Dialogue: 0,0:13:41.63,0:13:42.40,Default,,0,0,0,,沒事
Dialogue: 0,0:13:46.81,0:13:47.78,Default,,0,0,0,,田有怎麼樣
Dialogue: 0,0:13:48.28,0:13:50.74,Default,,0,0,0,,躲起來的王宮侍者們出來了
Dialogue: 0,0:13:50.84,0:13:52.87,Default,,0,0,0,,要他們幫忙給他包紮了
Dialogue: 0,0:13:54.23,0:13:57.54,Default,,0,0,0,,別擔心 幾枝箭可殺不死他
Dialogue: 0,0:14:03.93,0:14:05.60,Default,,0,0,0,,喂 混帳東西
Dialogue: 0,0:14:06.40,0:14:09.53,Default,,0,0,0,,你知道我們為什麼能追到這裡來嗎
Dialogue: 0,0:14:11.88,0:14:15.75,Default,,0,0,0,,只有你的隊衝得太前 這是原因之一
Dialogue: 0,0:14:16.42,0:14:17.52,Default,,0,0,0,,但更重要的是…
Dialogue: 0,0:14:19.04,0:14:20.72,Default,,0,0,0,,你們殺太多了
Dialogue: 0,0:14:21.32,0:14:25.26,Default,,0,0,0,,我們是循著你們殺人留下的血跡追來的
Dialogue: 0,0:14:27.26,0:14:30.07,Default,,0,0,0,,你在生什麼氣啊
Dialogue: 0,0:14:30.96,0:14:33.51,Default,,0,0,0,,殺 要殺
Dialogue: 0,0:14:33.88,0:14:35.28,Default,,0,0,0,,當然要殺
Dialogue: 0,0:14:35.58,0:14:38.90,Default,,0,0,0,,這就是率軍之人的特權啊
Dialogue: 0,0:14:39.13,0:14:40.27,Default,,0,0,0,,殺太多？
Dialogue: 0,0:14:41.22,0:14:42.88,Default,,0,0,0,,你是哪來的聖人
Dialogue: 0,0:14:43.41,0:14:46.16,Default,,0,0,0,,你也是武將 那應該也清楚吧
Dialogue: 0,0:14:46.66,0:14:51.41,Default,,0,0,0,,把大群大群的人像碾死蟲子一樣殺死的快感
Dialogue: 0,0:14:55.72,0:14:59.08,Default,,0,0,0,,別把我和你相提並論 變態
Dialogue: 0,0:14:59.56,0:15:02.87,Default,,0,0,0,,你怎麼不直接砍了他啊 信
Dialogue: 0,0:15:03.36,0:15:05.83,Default,,0,0,0,,這傢伙就是個人渣
Dialogue: 0,0:15:06.78,0:15:07.56,Default,,0,0,0,,不行
Dialogue: 0,0:15:08.59,0:15:11.05,Default,,0,0,0,,指揮官級別的要盡可能活捉
Dialogue: 0,0:15:11.36,0:15:14.35,Default,,0,0,0,,讓他們招供呂不韋的罪行
Dialogue: 0,0:15:14.95,0:15:16.15,Default,,0,0,0,,所以說 去亥
Dialogue: 0,0:15:16.74,0:15:18.75,Default,,0,0,0,,去給他止血吧
Dialogue: 0,0:15:20.01,0:15:20.69,Default,,0,0,0,,該死的
Dialogue: 0,0:15:21.73,0:15:24.20,Default,,0,0,0,,話說 剛才那一拳該不會已經給打死了吧
Dialogue: 0,0:15:27.31,0:15:28.23,Default,,0,0,0,,小向
Dialogue: 0,0:15:30.58,0:15:32.63,Default,,0,0,0,,小陽 小陽
Dialogue: 0,0:15:32.91,0:15:33.81,Default,,0,0,0,,太好了
Dialogue: 0,0:15:34.31,0:15:37.36,Default,,0,0,0,,我真的以為你要死了
Dialogue: 0,0:15:37.84,0:15:38.95,Default,,0,0,0,,真的…
Dialogue: 0,0:15:43.16,0:15:45.68,Default,,0,0,0,,好久不見了啊 土氣宮女
Dialogue: 0,0:15:47.08,0:15:49.35,Default,,0,0,0,,這就是政的女兒嗎
Dialogue: 0,0:15:50.77,0:15:52.88,Default,,0,0,0,,公 公主殿下？
Dialogue: 0,0:15:53.56,0:15:56.07,Default,,0,0,0,,你 你該不會是…
Dialogue: 0,0:16:04.91,0:16:05.89,Default,,0,0,0,,你怕不怕
Dialogue: 0,0:16:13.36,0:16:16.87,Default,,0,0,0,,看來不光是長相 連強勢的性格都和他一樣
Dialogue: 0,0:16:17.68,0:16:18.94,Default,,0,0,0,,你認識我嗎
Dialogue: 0,0:16:24.02,0:16:27.75,Default,,0,0,0,,我是你老爸最好的朋友 信
Dialogue: 0,0:16:30.53,0:16:33.41,Default,,0,0,0,,總之 還好及時救下了你
Dialogue: 0,0:16:43.49,0:16:47.77,Default,,0,0,0,,其他部隊來了消息 說太子也沒事
Dialogue: 0,0:16:48.18,0:16:52.20,Default,,0,0,0,,這裡視野很好 我們就在這裡保護你們
Dialogue: 0,0:16:52.68,0:16:55.53,Default,,0,0,0,,以防萬一 你們先想好逃離路線
Dialogue: 0,0:16:56.02,0:16:57.24,Default,,0,0,0,,我去城外
Dialogue: 0,0:16:57.84,0:17:00.28,Default,,0,0,0,,她們三個就拜託你們了 沛浪 去亥
Dialogue: 0,0:17:00.48,0:17:01.94,Default,,0,0,0,,好 沒問題
Dialogue: 0,0:17:02.12,0:17:05.29,Default,,0,0,0,,地道裡的敵人也掃清了 逃跑路線很多
Dialogue: 0,0:17:05.68,0:17:08.75,Default,,0,0,0,,你 你都受傷了還要戰鬥嗎
Dialogue: 0,0:17:10.69,0:17:13.83,Default,,0,0,0,,我本以為貂已經進來 城門已經關上了
Dialogue: 0,0:17:13.83,0:17:14.79,Default,,0,0,0,,但並沒有
Dialogue: 0,0:17:16.11,0:17:20.31,Default,,0,0,0,,要是外面的敵軍全部湧進來
Dialogue: 0,0:17:21.19,0:17:23.03,Default,,0,0,0,,咸陽就會陷落
Dialogue: 0,0:17:24.52,0:17:27.59,Default,,0,0,0,,外面的戰鬥才決定著我們的命運
Dialogue: 0,0:17:28.63,0:17:31.37,Default,,0,0,0,,左邊的部隊陣型快散了
Dialogue: 0,0:17:31.83,0:17:34.03,Default,,0,0,0,,快去支援 否則他們會被敵人幹掉
Dialogue: 0,0:17:34.27,0:17:37.49,Default,,0,0,0,,做不到 大家都在全力防守自己的陣地
Dialogue: 0,0:17:37.85,0:17:39.07,Default,,0,0,0,,尚鹿將軍
Dialogue: 0,0:17:39.76,0:17:41.49,Default,,0,0,0,,有壽閣下戰死
Dialogue: 0,0:17:45.69,0:17:48.05,Default,,0,0,0,,秦國的混蛋還挺能掙扎啊
Dialogue: 0,0:17:48.54,0:17:50.32,Default,,0,0,0,,命大隊前壓
Dialogue: 0,0:17:50.32,0:17:51.00,Default,,0,0,0,,是
Dialogue: 0,0:17:55.30,0:17:56.58,Default,,0,0,0,,尚鹿將軍
Dialogue: 0,0:17:57.16,0:17:59.80,Default,,0,0,0,,加毛大人 加燕大人 戰死
Dialogue: 0,0:18:00.88,0:18:03.10,Default,,0,0,0,,周虎隊也幾乎全軍覆沒
Dialogue: 0,0:18:04.93,0:18:07.35,Default,,0,0,0,,中央的隊形已經潰散
Dialogue: 0,0:18:07.86,0:18:10.13,Default,,0,0,0,,必須暫時撤退 重整陣型
Dialogue: 0,0:18:10.40,0:18:12.68,Default,,0,0,0,,否則我軍會全軍覆沒
Dialogue: 0,0:18:14.36,0:18:15.65,Default,,0,0,0,,不能撤退
Dialogue: 0,0:18:16.40,0:18:20.00,Default,,0,0,0,,正因為有我們這支部隊 敵人才會留在城外
Dialogue: 0,0:18:20.36,0:18:21.40,Default,,0,0,0,,要是我們撤退
Dialogue: 0,0:18:21.40,0:18:23.89,Default,,0,0,0,,敵人就會進入城內 關上城門
Dialogue: 0,0:18:23.98,0:18:26.87,Default,,0,0,0,,那樣一來 城內的人就都死定了
Dialogue: 0,0:18:27.27,0:18:29.08,Default,,0,0,0,,無論如何都要守住這裡
Dialogue: 0,0:18:29.80,0:18:31.29,Default,,0,0,0,,敵人來襲
Dialogue: 0,0:18:31.52,0:18:33.57,Default,,0,0,0,,保護將軍
Dialogue: 0,0:18:33.66,0:18:35.60,Default,,0,0,0,,別想接近將軍
Dialogue: 0,0:18:37.79,0:18:39.50,Default,,0,0,0,,河了貂 退後
Dialogue: 0,0:18:42.32,0:18:44.43,Default,,0,0,0,,要想拯救咸陽
Dialogue: 0,0:18:45.33,0:18:47.90,Default,,0,0,0,,就只有我軍進入城內關閉城門
Dialogue: 0,0:18:48.28,0:18:51.49,Default,,0,0,0,,或擊殺敵將 逆轉取勝
Dialogue: 0,0:18:51.60,0:18:53.16,Default,,0,0,0,,此外沒有別的方法
Dialogue: 0,0:18:53.84,0:18:55.79,Default,,0,0,0,,敵軍也意識到了這一點
Dialogue: 0,0:18:56.02,0:18:57.30,Default,,0,0,0,,因此敵將退得很遠
Dialogue: 0,0:18:57.91,0:19:01.17,Default,,0,0,0,,城門附近也防守嚴密
Dialogue: 0,0:19:03.02,0:19:03.82,Default,,0,0,0,,可惡
Dialogue: 0,0:19:04.05,0:19:05.44,Default,,0,0,0,,去死
Dialogue: 0,0:19:07.13,0:19:09.50,Default,,0,0,0,,田貝 去幫將軍
Dialogue: 0,0:19:12.42,0:19:14.49,Default,,0,0,0,,可惡 有沒有辦法
Dialogue: 0,0:19:14.63,0:19:17.02,Default,,0,0,0,,我必須找到取勝的辦法
Dialogue: 0,0:19:18.08,0:19:22.44,Default,,0,0,0,,政好不容易加冠 秦國就要重生
Dialogue: 0,0:19:23.20,0:19:25.48,Default,,0,0,0,,要是輸了 一切就將化為泡影
Dialogue: 0,0:19:29.26,0:19:30.39,Default,,0,0,0,,又有一支部隊衝過來了
Dialogue: 0,0:19:30.74,0:19:32.12,Default,,0,0,0,,那是什麼
Dialogue: 0,0:19:32.27,0:19:34.15,Default,,0,0,0,,快 快逃 河了貂
Dialogue: 0,0:19:35.89,0:19:36.65,Default,,0,0,0,,快點
Dialogue: 0,0:19:38.47,0:19:40.40,Default,,0,0,0,,我的巨鉞攻進去了啊
Dialogue: 0,0:19:41.25,0:19:44.34,Default,,0,0,0,,像螻蟻一樣 被碾死吧
Dialogue: 0,0:19:52.47,0:19:54.05,Default,,0,0,0,,河了貂 快逃
Dialogue: 0,0:19:54.69,0:19:55.74,Default,,0,0,0,,河了貂
Dialogue: 0,0:20:00.05,0:20:00.74,Default,,0,0,0,,什麼聲音
Dialogue: 0,0:20:01.36,0:20:07.22,Default,,0,0,0,,這聲音 在咸陽的所有人頭頂迴響
Dialogue: 0,0:20:10.64,0:20:14.19,Default,,0,0,0,,這是昌平君一行人抵達的信號
Dialogue: 0,0:20:23.69,0:20:25.38,Default,,0,0,0,,是 是援軍嗎
Dialogue: 0,0:20:25.69,0:20:26.83,Default,,0,0,0,,從西邊來的？
Dialogue: 0,0:20:27.18,0:20:29.41,Default,,0,0,0,,戎翟公 背後出現敵人
Dialogue: 0,0:20:30.17,0:20:31.14,Default,,0,0,0,,什麼
Dialogue: 0,0:20:35.04,0:20:36.32,Default,,0,0,0,,咸陽居然…
Dialogue: 0,0:20:37.16,0:20:38.41,Default,,0,0,0,,燒起來了
Dialogue: 0,0:20:41.83,0:20:46.09,Default,,0,0,0,,雖然還算及時趕到 但局勢不容樂觀
Dialogue: 0,0:20:46.51,0:20:49.68,Default,,0,0,0,,敵軍有三萬 而我們只有約千騎
Dialogue: 0,0:20:50.32,0:20:52.12,Default,,0,0,0,,速度就是生命
Dialogue: 0,0:20:52.74,0:20:53.84,Default,,0,0,0,,沒錯
Dialogue: 0,0:20:54.35,0:20:55.06,Default,,0,0,0,,我們走
Dialogue: 0,0:20:57.38,0:20:59.07,Default,,0,0,0,,來 來了
Dialogue: 0,0:20:59.36,0:21:01.24,Default,,0,0,0,,快向後列隊
Dialogue: 0,0:21:01.60,0:21:04.36,Default,,0,0,0,,六百 七百…也就一千左右
Dialogue: 0,0:21:04.85,0:21:07.16,Default,,0,0,0,,不要慌 靠後方部隊擋住
Dialogue: 0,0:21:07.50,0:21:09.36,Default,,0,0,0,,僅靠後方部隊擋不住
Dialogue: 0,0:21:09.99,0:21:12.04,Default,,0,0,0,,把哈穆伊和諾克叫回來
Dialogue: 0,0:21:12.40,0:21:13.57,Default,,0,0,0,,戎翟公
Dialogue: 0,0:21:14.71,0:21:18.21,Default,,0,0,0,,如果那支部隊是從雍城而來
Dialogue: 0,0:21:18.63,0:21:20.28,Default,,0,0,0,,那必定非同小可
Dialogue: 0,0:21:21.35,0:21:23.70,Default,,0,0,0,,假設他們僅半日就抵達了這裡
Dialogue: 0,0:21:24.34,0:21:27.48,Default,,0,0,0,,那說明他們還事先做好了更換馬匹的準備
Dialogue: 0,0:21:28.44,0:21:30.51,Default,,0,0,0,,衝鋒已經開始了
Dialogue: 0,0:21:31.18,0:21:32.01,Default,,0,0,0,,這麼快？
Dialogue: 0,0:21:32.31,0:21:35.87,Default,,0,0,0,,是想搶在敵人整好隊形之前 先下手為強
Dialogue: 0,0:21:35.87,0:21:36.96,Default,,0,0,0,,河了貂
Dialogue: 0,0:21:37.73,0:21:41.19,Default,,0,0,0,,聽說秦軍總司令的援軍到了 是真的嗎
Dialogue: 0,0:21:41.56,0:21:42.71,Default,,0,0,0,,不會錯的
Dialogue: 0,0:21:43.25,0:21:44.17,Default,,0,0,0,,剛才的聲音
Dialogue: 0,0:21:44.17,0:21:46.45,Default,,0,0,0,,是總司令的親信·介億老師的號角聲
Dialogue: 0,0:21:48.67,0:21:52.20,Default,,0,0,0,,他真的脫離了呂氏四柱嗎
Dialogue: 0,0:21:52.80,0:21:54.76,Default,,0,0,0,,但只有約一千人
Dialogue: 0,0:21:55.36,0:21:57.52,Default,,0,0,0,,敵軍的數量優勢並沒有改變
Dialogue: 0,0:21:57.81,0:21:59.18,Default,,0,0,0,,什 什麼
Dialogue: 0,0:21:59.54,0:22:03.46,Default,,0,0,0,,但是 老師一定能用那一千人扭轉戰局
Dialogue: 0,0:22:06.62,0:22:08.22,Default,,0,0,0,,黃龍 向右脫離
Dialogue: 0,0:22:08.60,0:22:09.16,Default,,0,0,0,,是
Dialogue: 0,0:22:09.48,0:22:10.55,Default,,0,0,0,,跟我來
Dialogue: 0,0:22:13.75,0:22:15.97,Default,,0,0,0,,在右邊分出了別動隊
Dialogue: 0,0:22:17.06,0:22:19.03,Default,,0,0,0,,秦軍總司令 昌平君
Dialogue: 0,0:22:19.84,0:22:23.41,Default,,0,0,0,,他是軍略天才 這一點毋庸置疑
Dialogue: 0,0:22:24.25,0:22:27.95,Default,,0,0,0,,但我從未聽說過他以武將身份上陣殺過敵
Dialogue: 0,0:22:29.94,0:22:33.49,Default,,0,0,0,,如今他親身立於戰場 又會怎樣作戰呢
Dialogue: 0,0:22:34.32,0:22:38.45,Default,,0,0,0,,他親自打頭陣鼓舞士氣 確實十分英勇
Dialogue: 0,0:22:39.62,0:22:42.50,Default,,0,0,0,,足夠了 快後撤吧 昌平君
Dialogue: 0,0:22:45.35,0:22:47.01,Default,,0,0,0,,等 等等 昌平君
Dialogue: 0,0:22:47.17,0:22:49.37,Default,,0,0,0,,快退後 你在想什麼啊
Dialogue: 0,0:22:49.59,0:22:50.63,Default,,0,0,0,,來了
Dialogue: 0,0:22:50.63,0:22:52.51,Default,,0,0,0,,幹掉最前面那匹花俏的馬
Dialogue: 0,0:22:52.97,0:22:54.52,Default,,0,0,0,,不必擔心
Dialogue: 0,0:22:55.64,0:22:57.02,Default,,0,0,0,,您不知道嗎
Dialogue: 0,0:22:57.46,0:22:59.73,Default,,0,0,0,,我的主公在兒時
Dialogue: 0,0:23:00.00,0:23:01.06,Default,,0,0,0,,去死吧
Dialogue: 0,0:23:02.42,0:23:05.32,Default,,0,0,0,,可是比蒙武都強
Dialogue: 0,0:23:07.42,0:23:10.24,Default,,0,0,0,,介億 我們要把戎翟公幹掉
Dialogue: 0,0:23:10.61,0:23:11.70,Default,,0,0,0,,遵命
Dialogue: 0,0:24:48.26,0:24:49.96,Default,,0,0,0,,下集《王者天下》
Dialogue: 0,0:24:50.71,0:24:52.32,Default,,0,0,0,,「強勢反攻」
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,

Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:01:02.03,0:01:04.01,Layzner,David,0,0,0,,要活下去的话不战斗不行吧
Dialogue: 0,0:01:04.30,0:01:07.16,Layzner,Egyle,0,0,0,,明明就是背叛者 还说什么不要杀人
Dialogue: 0,0:01:08.23,0:01:10.46,Layzner,Eiji,0,0,0,,不要 我不想杀人
Dialogue: 0,0:01:55.20,0:01:57.64,Layzner,Anna,0,0,0,,为了保护前辈
Dialogue: 0,0:01:57.64,0:01:59.89,Layzner,Anna,0,0,0,,为了保护我们
Dialogue: 0,0:01:59.90,0:02:01.07,Layzner,Anna,0,0,0,,还是
Dialogue: 0,0:02:02.06,0:02:08.85,Layzner,Anna,0,0,0,,从被他打倒的敌人那里他看到的到底是什么呢
Dialogue: 0,0:02:09.46,0:02:11.79,Layzner,Eiji,0,0,0,,我真的开枪了吗
Dialogue: 0,0:02:12.11,0:02:15.00,Layzner,Rey,0,0,0,,摧毁敌人 生命反应停止
Dialogue: 0,0:02:15.78,0:02:16.78,Layzner,Eiji,0,0,0,,我真的
Dialogue: 0,0:02:17.36,0:02:22.73,Layzner,Title,0,0,0,,第九话 寻求生存之道
Dialogue: 0,0:02:34.82,0:02:37.93,Layzner,Egyle,0,0,0,,我是伊基露·卡露拉少尉 我可以进去吗
Dialogue: 0,0:02:38.48,0:02:39.05,Layzner,Gail,0,0,0,,进来吧
Dialogue: 0,0:02:42.19,0:02:43.47,Layzner,Egyle,0,0,0,,打扰了
Dialogue: 0,0:02:43.73,0:02:45.33,Layzner,Gail,0,0,0,,我不会介意的
Dialogue: 0,0:02:49.39,0:02:50.22,Layzner,Gail,0,0,0,,不好意思
Dialogue: 0,0:02:50.23,0:02:51.62,Layzner,Egyle,0,0,0,,请让我一起去
Dialogue: 0,0:02:53.26,0:02:55.84,Layzner,Egyle,0,0,0,,那家伙竟让中尉受那么重的伤
Dialogue: 0,0:02:55.84,0:02:58.44,Layzner,Gail,0,0,0,,少尉 你的意思是要我的指挥权是吗
Dialogue: 0,0:02:58.99,0:03:00.94,Layzner,Egyle,0,0,0,,我想我也有资格
Dialogue: 0,0:03:00.94,0:03:01.76,Layzner,Gail,0,0,0,,你说的没错
Dialogue: 0,0:03:03.11,0:03:06.89,Layzner,Egyle,0,0,0,,我也想出了自己的独特的战法 请准许我出战
Dialogue: 0,0:03:08.17,0:03:11.07,Layzner,Gail,0,0,0,,那先让我听你的战法
Dialogue: 0,0:03:11.07,0:03:16.65,Layzner,Egyle,0,0,0,,面对一架SPT我们会一直输就是因为我们的进攻火力不够
Dialogue: 0,0:03:17.25,0:03:18.29,Layzner,Gail,0,0,0,,好严格的批评
Dialogue: 0,0:03:19.26,0:03:22.23,Layzner,Egyle,0,0,0,,中尉 我是说在古斯特罗上尉的事
Dialogue: 0,0:03:22.61,0:03:23.93,Layzner,Egyle,0,0,0,,请让我帮忙
Dialogue: 0,0:03:25.61,0:03:26.43,Layzner,Gail,0,0,0,,继续
Dialogue: 0,0:03:27.36,0:03:32.45,Layzner,Egyle,0,0,0,,用我的座机再加上地面用机器人两架从空中和地面夹攻
Dialogue: 0,0:03:33.07,0:03:34.73,Layzner,Gail,0,0,0,,还要用到地面用机器人哦
Dialogue: 0,0:03:34.73,0:03:38.05,Layzner,Egyle,0,0,0,,好处是可以分散敌人的注意力
Dialogue: 0,0:03:38.05,0:03:42.53,Layzner,Egyle,0,0,0,,SPT的雷达感应能力是无法同时顾及地面跟高空的
Dialogue: 0,0:03:43.90,0:03:48.02,Layzner,Eglye,0,0,0,,我的座机从上空攻击地面则由地面用机器人负责
Dialogue: 0,0:03:48.84,0:03:51.06,Layzner,Eglye,0,0,0,,由空中和地面两面同时进攻
Dialogue: 0,0:03:51.52,0:03:53.75,Layzner,Eglye,0,0,0,,是不是有试试看的价值呢
Dialogue: 0,0:03:55.89,0:03:57.06,Layzner,Eglye,0,0,0,,你是否有什么不满
Dialogue: 0,0:03:57.06,0:03:57.95,Layzner,Gail,0,0,0,,不
Dialogue: 0,0:03:58.75,0:04:00.48,Layzner,Gail,0,0,0,,我答应你就是
Dialogue: 0,0:04:00.93,0:04:01.73,Layzner,Egyle,0,0,0,,谢谢你
Dialogue: 0,0:04:07.77,0:04:10.57,Layzner,Gail,0,0,0,,那女人不简单
Dialogue: 0,0:04:11.60,0:04:14.85,Layzner,Gail,0,0,0,,英二 别想我会一直包庇你
Dialogue: 0,0:04:24.26,0:04:28.37,Layzner,Egyle,0,0,0,,通知整备机准备地面用机器人 快进行检查
Dialogue: 0,0:04:46.28,0:04:49.53,Layzner,Eiji,0,0,0,,我 杀人了
Dialogue: 0,0:04:51.97,0:04:55.36,Layzner,Eiji,0,0,0,,我的体内流着地球人的血
Dialogue: 0,0:04:56.51,0:05:00.43,Layzner,Eiji,0,0,0,,所以才会杀人是吗
Dialogue: 0,0:05:06.69,0:05:08.83,Layzner,Elizabeth,0,0,0,,他已到达了极限
Dialogue: 0,0:05:08.83,0:05:11.39,Layzner,Elizabeth,0,0,0,,交给他一个人已经让他到了极限
Dialogue: 0,0:05:13.22,0:05:15.62,Layzner,Elizabeth,0,0,0,,我还有要照顾小孩的责任
Dialogue: 0,0:05:17.54,0:05:18.99,Layzner,Elizabeth,0,0,0,,得想想办法
Dialogue: 0,0:05:21.02,0:05:25.31,Layzner,Arthur,0,0,0,,他为了保护学长和自己杀了人
Dialogue: 0,0:05:25.31,0:05:28.58,Layzner,Arthur,0,0,0,,这是理所当然的吧 有什么好烦恼的呢
Dialogue: 0,0:05:28.59,0:05:29.96,Layzner,Anna,0,0,0,,等一下
Dialogue: 0,0:05:29.96,0:05:35.28,Layzner,Anna,0,0,0,,我认为你这么说也太说不过去了吧 你觉得呢
Dialogue: 0,0:05:36.00,0:05:36.92,Layzner,Roanne,0,0,0,,你觉得呢
Dialogue: 0,0:05:38.54,0:05:41.68,Layzner,David,0,0,0,,我不知道 不知道他在想什么
Dialogue: 0,0:05:44.58,0:05:46.29,Layzner,Roanne,0,0,0,,伊丽莎白博士
Dialogue: 0,0:05:46.29,0:05:47.45,Layzner,Arthur,0,0,0,,怎么了
Dialogue: 0,0:05:48.34,0:05:50.90,Layzner,Elizabeth,0,0,0,,现在大家好好听我说
Dialogue: 0,0:05:53.33,0:05:58.55,Layzner,Elizabeth,0,0,0,,大家都知道他的航天飞机中还有两架机器人
Dialogue: 0,0:05:59.86,0:06:03.49,Layzner,Arthur,0,0,0,,你该不会叫我们也跟他一起去作战吧
Dialogue: 0,0:06:03.86,0:06:05.69,Layzner,Roanne,0,0,0,,我们不是军人啊
Dialogue: 0,0:06:05.69,0:06:08.61,Layzner,Elizabeth,0,0,0,,等一下 听我把话说完
Dialogue: 0,0:06:10.04,0:06:12.10,Layzner,Elizabeth,0,0,0,,这是跟我们有密切关系的问题
Dialogue: 0,0:06:13.29,0:06:17.10,Layzner,Elizabeth,0,0,0,,如果只有生与死 两条路选择的话
Dialogue: 0,0:06:17.95,0:06:21.09,Layzner,Elizabeth,0,0,0,,我们要自己找活下去的路
Dialogue: 0,0:06:22.75,0:06:27.21,Layzner,Elizabeth,0,0,0,,老实说 我看一直让他保护我们 已经让他到了极限了
Dialogue: 0,0:06:28.97,0:06:30.64,Layzner,Elizabeth,0,0,0,,不要搞错
Dialogue: 0,0:06:30.64,0:06:33.47,Layzner,Elizabeth,0,0,0,,不是让你们用机器人去作战
Dialogue: 0,0:06:33.47,0:06:37.89,Layzner,Elizabeth,0,0,0,,如果操纵得当的话或许有一天说不定我们能得救的
Dialogue: 0,0:06:38.42,0:06:41.56,Layzner,Arthur,0,0,0,,要学机器人的操纵法 就是要我们去乘坐机器人吧
Dialogue: 0,0:06:41.56,0:06:43.71,Layzner,Arthur,0,0,0,,那样的话很危险的
Dialogue: 0,0:06:43.96,0:06:47.53,Layzner,Elizabeth,0,0,0,,我是不想说这种话 也不想去想
Dialogue: 0,0:06:48.50,0:06:49.57,Layzner,Elizabeth,0,0,0,,但这样下去
Dialogue: 0,0:06:50.73,0:06:52.82,Layzner,Elizabeth,0,0,0,,如果他有个万一的话
Dialogue: 0,0:06:54.35,0:06:57.06,Layzner,Elizabeth,0,0,0,,我再说一次
Dialogue: 0,0:06:57.06,0:07:00.88,Layzner,Elizabeth,0,0,0,,我来这是要告诉大家 我们要找自己活下去的路
Dialogue: 0,0:07:01.87,0:07:02.83,Layzner,Elizabeth,0,0,0,,希望你们能理解
Dialogue: 0,0:07:03.40,0:07:07.87,Layzner,David,0,0,0,,你现在说的是博士你的个人想法对吧
Dialogue: 0,0:07:08.23,0:07:10.04,Layzner,Elizabeth,0,0,0,,是的 为什么这么问
Dialogue: 0,0:07:10.09,0:07:11.45,Layzner,David,0,0,0,,没什么
Dialogue: 0,0:07:11.45,0:07:13.36,Layzner,David,0,0,0,,不是那家伙说的就好
Dialogue: 0,0:07:13.36,0:07:15.47,Layzner,Arthur,0,0,0,,大卫 你该不会想去操纵机器人吧
Dialogue: 0,0:07:16.20,0:07:18.42,Layzner,David,0,0,0,,坐在这等人保护也不是办法
Dialogue: 0,0:07:18.97,0:07:20.58,Layzner,Elizabeth,0,0,0,,谢谢你 大卫
Dialogue: 0,0:07:21.26,0:07:23.27,Layzner,Roanne,0,0,0,,要我们记住也是命令吗
Dialogue: 0,0:07:24.35,0:07:26.16,Layzner,Elizabeth,0,0,0,,是的 是命令
Dialogue: 0,0:07:29.89,0:07:31.14,Layzner,Elizabeth,0,0,0,,把他叫来这里
Dialogue: 0,0:07:43.87,0:07:45.92,Layzner,Anna,0,0,0,,伊丽莎白博士有事找你
Dialogue: 0,0:07:55.13,0:08:01.16,Layzner,Anna,0,0,0,,他果然还是在烦恼杀了他自己星球的人的事
Dialogue: 0,0:08:01.60,0:08:06.52,Layzner,Anna,0,0,0,,然后 我们也准备自动加入了战局
Dialogue: 0,0:08:07.36,0:08:08.81,Layzner,Eiji,0,0,0,,SPT的操纵方法
Dialogue: 0,0:08:09.54,0:08:11.87,Layzner,Elizabeth,0,0,0,,我有保护这些小孩的义务
Dialogue: 0,0:08:13.63,0:08:18.83,Layzner,Elizabeth,0,0,0,,只要有一点机会的话我就都会去找那条出路
Dialogue: 0,0:08:19.44,0:08:21.02,Layzner,David,0,0,0,,我们跟你不一样
Dialogue: 0,0:08:21.74,0:08:23.85,Layzner,David,0,0,0,,那些追兵对我们来说也是敌人
Dialogue: 0,0:08:24.42,0:08:26.67,Layzner,David,0,0,0,,要活下去的话不战斗不行
Dialogue: 0,0:08:27.18,0:08:30.79,Layzner,Arthur,0,0,0,,还有如果你有个万一的话
Dialogue: 0,0:08:30.79,0:08:34.46,Layzner,Arthur,0,0,0,,谁能去通知即将被侵略的地球呢
Dialogue: 0,0:08:36.50,0:08:39.05,Layzner,Elizabeth,0,0,0,,能教我们操纵方法吧
Dialogue: 0,0:08:44.62,0:08:45.43,Layzner,Elizabeth,0,0,0,,可以吧
Dialogue: 0,0:08:49.28,0:08:53.20,Layzner,Eiji,0,0,0,,这个头盔里面有微芯片可以跟SPT相通
Dialogue: 0,0:08:53.23,0:08:54.70,Layzner,David,0,0,0,,好酷哦
Dialogue: 0,0:08:55.32,0:08:57.98,Layzner,Arthur,0,0,0,,要把我们的头盔改造成这样吗
Dialogue: 0,0:08:58.56,0:09:02.75,Layzner,Roanne,0,0,0,,只要改造PCM系统的话 应该也能连结上SPT的
Dialogue: 0,0:09:02.84,0:09:07.39,Layzner,Arthur,0,0,0,,说的简单 要改造大家的帽子的话要花一整晚的
Dialogue: 0,0:09:07.97,0:09:10.51,Layzner,David,0,0,0,,那麻烦你明天早上给我咯
Dialogue: 0,0:09:12.34,0:09:14.10,Layzner,Arthur,0,0,0,,早知道就不说了
Dialogue: 0,0:09:14.52,0:09:16.37,Layzner,Eiji,0,0,0,,这是通讯回路
Dialogue: 0,0:09:16.37,0:09:20.72,Layzner,Eiji,0,0,0,,跟刚才的三回路不同系统 是连接在ND CONNECTOR上
Dialogue: 0,0:09:21.13,0:09:23.39,Layzner,David,0,0,0,,亚瑟在干嘛
Dialogue: 0,0:09:24.67,0:09:25.28,Layzner,Roanne,0,0,0,,他来了
Dialogue: 0,0:09:26.80,0:09:29.64,Layzner,David,0,0,0,,你好慢啊亚瑟 你在干嘛啊
Dialogue: 0,0:09:29.92,0:09:30.95,Layzner,Arthur,0,0,0,,抱歉 抱歉
Dialogue: 0,0:09:33.14,0:09:36.26,Layzner,Arthur,0,0,0,,今天又要熬夜了对吧 真让人受不了
Dialogue: 0,0:09:36.26,0:09:39.44,Layzner,David,0,0,0,,你在说什么 又不是只有你一个人熬夜
Dialogue: 0,0:09:39.44,0:09:42.15,Layzner,Arthur,0,0,0,,我有低血压 早上会起不来
Dialogue: 0,0:09:42.15,0:09:43.76,Layzner,David,0,0,0,,不要说傻话了
Dialogue: 0,0:09:44.86,0:09:46.59,Layzner,Eiji,0,0,0,,可以了吗 要开始了
Dialogue: 0,0:09:46.59,0:09:46.98,Layzner,Roanne,0,0,0,,好
Dialogue: 0,0:09:48.34,0:09:52.58,Layzner,Eiji,0,0,0,,我带来的三架SPT有这个布鲁迪还有对面的贝布鲁
Dialogue: 0,0:09:52.58,0:09:56.07,Layzner,Eiji,0,0,0,,还有雷兹纳 侦察方法大体都一样
Dialogue: 0,0:09:58.46,0:10:00.79,Layzner,Eiji,0,0,0,,SPT可以做声呐搜查
Dialogue: 0,0:10:00.79,0:10:04.79,Layzner,Eiji,0,0,0,,也就是比如说有敌人的线索 要进行搜索时
Dialogue: 0,0:10:04.79,0:10:07.07,Layzner,Eiji,0,0,0,,电脑会分析并去寻找
Dialogue: 0,0:10:07.41,0:10:09.02,Layzner,Arthur,0,0,0,,超简单的嘛
Dialogue: 0,0:10:09.32,0:10:11.80,Layzner,Eiji,0,0,0,,可是 实战中光靠那个是不够的
Dialogue: 0,0:10:12.44,0:10:13.92,Layzner,Eiji,0,0,0,,那样还是太慢
Dialogue: 0,0:10:13.93,0:10:15.66,Layzner,Eiji,0,0,0,,有谁要试试吗
Dialogue: 0,0:10:15.67,0:10:16.80,Layzner,Elizabeth,0,0,0,,我来试试
Dialogue: 0,0:10:16.81,0:10:20.20,Layzner,Arthur,0,0,0,,不 先让我试试 因为我最年长
Dialogue: 0,0:10:22.84,0:10:25.22,Layzner,Eiji,0,0,0,,坐好的话 先绑好你的安全带
Dialogue: 0,0:10:28.40,0:10:29.81,Layzner,Arthur,0,0,0,,好了 接下来呢
Dialogue: 0,0:10:30.02,0:10:32.52,Layzner,Eiji,0,0,0,,再按下上面的圆形按键
Dialogue: 0,0:10:33.81,0:10:34.37,Layzner,Arthur,0,0,0,,这个吗
Dialogue: 0,0:10:38.68,0:10:40.18,Layzner,Arthur,0,0,0,,不要紧张
Dialogue: 0,0:10:40.19,0:10:42.82,Layzner,Eiji,0,0,0,,接下来要做的是按下左边四方形的按键
Dialogue: 0,0:10:43.17,0:10:44.91,Layzner,Eiji,0,0,0,,有两个 要按左边那一个
Dialogue: 0,0:10:45.40,0:10:46.97,Layzner,Eiji,0,0,0,,不过现在不要按
Dialogue: 0,0:10:47.82,0:10:54.09,Layzner,Eiji,0,0,0,,机器人就会动起来
Dialogue: 0,0:10:47.82,0:10:54.09,Layzner,Eiji,0,0,0,,现在按的话 你的声纹就会被输入到电脑里
Dialogue: 0,0:10:55.85,0:10:59.28,Layzner,Elizabeth,0,0,0,,一开始是右边的按键 接下来是左边的对吧
Dialogue: 0,0:10:59.96,0:11:02.51,Layzner,Eiji,0,0,0,,只要这两个步骤SPT就会启动了
Dialogue: 0,0:11:03.34,0:11:07.73,Layzner,Eiji,0,0,0,,谁去试试贝布鲁 我用雷兹纳来示范
Dialogue: 0,0:11:08.30,0:11:10.89,Layzner,Eiji,0,0,0,,一开始要碰右边的绿色按键
Dialogue: 0,0:11:11.95,0:11:14.34,Layzner,Arthur,0,0,0,,一开始右边 再来是左边
Dialogue: 0,0:11:14.89,0:11:16.45,Layzner,Arthur,0,0,0,,这样我也会嘛
Dialogue: 0,0:11:16.46,0:11:19.35,Layzner,Sign,0,0,0,,SPT-BD-03U\nBuldy
Dialogue: 0,0:11:20.45,0:11:23.73,Layzner,Sign,0,0,0,,SPT-BB-02U\nBaybull
Dialogue: 0,0:11:27.25,0:11:27.94,Layzner,David,0,0,0,,这个是吗
Dialogue: 0,0:11:33.61,0:11:34.97,Layzner,Arthur,0,0,0,,里面的屏幕是干嘛的
Dialogue: 0,0:11:35.33,0:11:37.45,Layzner,Eiji,0,0,0,,正面的是雷达的屏幕
Dialogue: 0,0:11:37.46,0:11:40.11,Layzner,Eiji,0,0,0,,上面的是会显示外面情况的荧幕
Dialogue: 0,0:11:41.14,0:11:44.68,Layzner,Eiji,0,0,0,,椅子上的把手可以操纵左右
Dialogue: 0,0:11:45.75,0:11:50.03,Layzner,Eiji,0,0,0,,食指上的按键是激光炮 拇指上的是导弹
Dialogue: 0,0:11:50.96,0:11:53.84,Layzner,Eiji,0,0,0,,基本的设定电脑会全部帮你做
Dialogue: 0,0:11:54.05,0:11:55.81,Layzner,Roanne,0,0,0,,不行 不能乱来
Dialogue: 0,0:11:56.22,0:11:57.81,Layzner,Roanne,0,0,0,,快按那个解除键
Dialogue: 0,0:11:58.34,0:11:58.98,Layzner,David,0,0,0,,这个吗
Dialogue: 0,0:11:59.53,0:12:01.91,Layzner,Eiji,0,0,0,,左右脚踏板可以控制动力
Dialogue: 0,0:12:02.30,0:12:05.51,Layzner,Eiji,0,0,0,,左右两边的脚踏板踩到底会全速上升
Dialogue: 0,0:12:05.95,0:12:07.83,Layzner,David,0,0,0,,换一下
Dialogue: 0,0:12:07.84,0:12:09.37,Layzner,Roanne,0,0,0,,先让我摸熟
Dialogue: 0,0:12:10.47,0:12:12.06,Layzner,Eiji,0,0,0,,接下来要显示出影像
Dialogue: 0,0:12:12.68,0:12:16.16,Layzner,Eiji,0,0,0,,这是记在电脑里几小时前的战斗记忆影像
Dialogue: 0,0:12:16.17,0:12:17.35,Layzner,Arthur,0,0,0,,战斗记忆影像
Dialogue: 0,0:12:17.36,0:12:18.38,Layzner,Eiji,0,0,0,,请看
Dialogue: 0,0:12:22.77,0:12:25.86,Layzner,Roanne,0,0,0,,有什么好怕的
Dialogue: 0,0:12:25.86,0:12:27.12,Layzner,Roanne,0,0,0,,只是之前的战斗影像而已
Dialogue: 0,0:12:27.46,0:12:29.56,Layzner,Arthur,0,0,0,,不 只是有点
Dialogue: 0,0:12:34.31,0:12:38.07,Layzner,Arthur,0,0,0,,雷达旁的红色灯在闪了那是什么意思
Dialogue: 0,0:12:38.69,0:12:39.39,Layzner,Eiji,0,0,0,,是敌人
Dialogue: 0,0:12:40.09,0:12:44.06,Layzner,Arthur,0,0,0,,我知道拍到的是敌人的影像 我要问的是
Dialogue: 0,0:12:44.37,0:12:45.36,Layzner,Eiji,0,0,0,,那不是记忆影像
Dialogue: 0,0:12:45.82,0:12:47.22,Layzner,Eiji,0,0,0,,现在敌人正接近中
Dialogue: 0,0:12:47.63,0:12:49.86,Layzner,Arthur,0,0,0,,现在 不要开玩笑了
Dialogue: 0,0:13:02.30,0:13:03.37,Layzner,Egyle,0,0,0,,雷达反应呢
Dialogue: 0,0:13:03.38,0:13:04.25,Layzner,Pilot,0,0,0,,没有
Dialogue: 0,0:13:04.25,0:13:06.48,Layzner,Pilot B,0,0,0,,敌人好像在雷达范围之外
Dialogue: 0,0:13:06.49,0:13:07.40,Layzner,Egyle,0,0,0,,好
Dialogue: 0,0:13:07.41,0:13:09.48,Layzner,Egyle,0,0,0,,达拉 阿修 通信状况如何
Dialogue: 0,0:13:09.49,0:13:10.54,Layzner,Ash,0,0,0,,我都听得到
Dialogue: 0,0:13:10.55,0:13:11.22,Layzner,Dal,0,0,0,,听得到
Dialogue: 0,0:13:11.53,0:13:13.28,Layzner,Egyle,0,0,0,,好 作战开始
Dialogue: 0,0:13:13.83,0:13:15.50,Layzner,Egyle,0,0,0,,打开第二第三栅门
Dialogue: 0,0:13:28.20,0:13:31.73,Layzner,Sign,0,0,0,,SPT-DT-25C Dtol
Dialogue: 0,0:13:33.42,0:13:36.25,Layzner,Egyle,0,0,0,,接下来要通信时用激光雷达
Dialogue: 0,0:13:36.26,0:13:36.96,Layzner,Ash,0,0,0,,了解
Dialogue: 0,0:13:46.34,0:13:48.38,Layzner,David,0,0,0,,喂 亚瑟 快一点
Dialogue: 0,0:13:50.12,0:13:51.65,Layzner,David,0,0,0,,真是的 我们不管你了哦
Dialogue: 0,0:13:51.66,0:13:52.41,Layzner,Arthur,0,0,0,,等一下
Dialogue: 0,0:13:57.93,0:13:59.79,Layzner,Rey,0,0,0,,敌人航天飞机接近中
Dialogue: 0,0:13:59.79,0:14:03.51,Layzner,Rey,0,0,0,,SPT一架从航天飞机极速接近中
Dialogue: 0,0:14:03.80,0:14:06.46,Layzner,Eiji,0,0,0,,一架 怎么可能
Dialogue: 0,0:14:06.47,0:14:09.20,Layzner,Eiji,0,0,0,,总之要设法不要让它靠近这里
Dialogue: 0,0:14:20.29,0:14:24.44,Layzner,Sign,0,0,0,,SPT-DM-20C Dimage
Dialogue: 0,0:14:25.22,0:14:29.54,Layzner,Rey,0,0,0,,危险信息 还有18秒跟敌人接触
Dialogue: 0,0:14:29.55,0:14:30.66,Layzner,Rey,0,0,0,,进行戒备
Dialogue: 0,0:14:33.14,0:14:35.47,Layzner,Rey,0,0,0,,敌人进入目测范围
Dialogue: 0,0:14:36.47,0:14:37.64,Layzner,Rey,0,0,0,,有热源反应
Dialogue: 0,0:14:52.28,0:14:52.82,Layzner,Eiji,0,0,0,,好快
Dialogue: 0,0:14:53.84,0:14:54.84,Layzner,Eiji,0,0,0,,告诉我它的机种
Dialogue: 0,0:14:55.56,0:15:00.09,Layzner,Rey,0,0,0,,SPT-DM-20C 迪马修 宇宙用开发机种
Dialogue: 0,0:15:00.10,0:15:03.30,Layzner,Rey,0,0,0,,飞行机能是现在SPT中最快的
Dialogue: 0,0:15:03.68,0:15:04.72,Layzner,Rey,0,0,0,,有热源反应
Dialogue: 0,0:15:12.29,0:15:15.03,Layzner,Egyle,0,0,0,,空中战你想赢得了我吗
Dialogue: 0,0:15:18.24,0:15:20.09,Layzner,Eiji,0,0,0,,现在才要开始 那么就打地面战
Dialogue: 0,0:15:20.10,0:15:20.65,Layzner,Rey,0,0,0,,Ready.
Dialogue: 0,0:15:28.05,0:15:29.46,Layzner,Eiji,0,0,0,,给我下来吧
Dialogue: 0,0:15:35.18,0:15:35.87,Layzner,Eiji,0,0,0,,还有啊
Dialogue: 0,0:15:49.53,0:15:52.80,Layzner,Rey,0,0,0,,SPT-DT-25C 地面用多特尔
Dialogue: 0,0:15:53.05,0:15:55.96,Layzner,Eiji,0,0,0,,地面用 雷达刚才怎么没发现
Dialogue: 0,0:15:56.36,0:16:00.72,Layzner,Rey,0,0,0,,为了维持本机安全性 所以侦测地面的速度变慢
Dialogue: 0,0:16:03.05,0:16:04.36,Layzner,Eiji,0,0,0,,上面的敌人怎么办
Dialogue: 0,0:16:04.77,0:16:05.82,Layzner,Eiji,0,0,0,,它又不见了 把它找出来
Dialogue: 0,0:16:05.95,0:16:07.90,Layzner,Rey,0,0,0,,12号位置有热源反应
Dialogue: 0,0:16:12.69,0:16:17.95,Layzner,Rey,0,0,0,,上方的敌人用感知系统监控 用热导弹探测器来回避敌人攻击
Dialogue: 0,0:16:18.15,0:16:20.86,Layzner,Eiji,0,0,0,,这样来不及 把雷达移回上方
Dialogue: 0,0:16:20.87,0:16:22.22,Layzner,Eiji,0,0,0,,地面上我自己用眼睛找
Dialogue: 0,0:16:25.35,0:16:28.25,Layzner,Egyle,0,0,0,,达拉 你要吸引雷兹纳的注意力
Dialogue: 0,0:16:28.25,0:16:28.87,Layzner,Dal,0,0,0,,我知道了
Dialogue: 0,0:16:29.60,0:16:33.05,Layzner,Egyle,0,0,0,,阿修 你去背叛者抢走的航天飞机那里
Dialogue: 0,0:16:33.06,0:16:33.50,Layzner,Ash,0,0,0,,了解
Dialogue: 0,0:16:43.74,0:16:45.32,Layzner,Eiji,0,0,0,,不好 他去基地了
Dialogue: 0,0:16:50.31,0:16:52.14,Layzner,Simone,0,0,0,,虽然是一对三 不过一定要平安的回来啊
Dialogue: 0,0:16:52.92,0:16:54.71,Layzner,Roanne,0,0,0,,对空雷达也显示只有一架
Dialogue: 0,0:16:55.58,0:16:57.85,Layzner,Arthur,0,0,0,,那就是从空中和地面夹击
Dialogue: 0,0:16:59.48,0:17:00.75,Layzner,Eiji,0,0,0,,有一架敌人往你们那去了
Dialogue: 0,0:17:01.05,0:17:02.75,Layzner,Eiji,0,0,0,,不要离开基地
Dialogue: 0,0:17:15.23,0:17:16.61,Layzner,Eiji,0,0,0,,不会让你去大家那里的
Dialogue: 0,0:17:29.56,0:17:31.82,Layzner,Rey,0,0,0,,请更改主要攻击目标
Dialogue: 0,0:17:31.82,0:17:33.40,Layzner,Eiji,0,0,0,,不行 不可以瞄准致命部位
Dialogue: 0,0:17:36.88,0:17:38.14,Layzner,David,0,0,0,,快靠过来了
Dialogue: 0,0:17:38.84,0:17:40.94,Layzner,Arthur,0,0,0,,被他攻击的话我们就完了
Dialogue: 0,0:17:41.38,0:17:42.64,Layzner,Roanne,0,0,0,,不要说那种话
Dialogue: 0,0:17:43.09,0:17:44.46,Layzner,Simone,0,0,0,,可是敌人有三架啊
Dialogue: 0,0:17:45.06,0:17:46.86,Layzner,David,0,0,0,,敌人 还找不到是吗
Dialogue: 0,0:17:47.18,0:17:48.40,Layzner,Elizabeth,0,0,0,,一直找不到
Dialogue: 0,0:17:58.46,0:17:59.24,Layzner,Roanne,0,0,0,,你要去哪
Dialogue: 0,0:18:14.32,0:18:16.52,Layzner,Rey,0,0,0,,请更改主要攻击目标
Dialogue: 0,0:18:16.89,0:18:19.01,Layzner,Eiji,0,0,0,,不行 不要瞄准致命部位
Dialogue: 0,0:18:19.01,0:18:20.20,Layzner,Eiji,0,0,0,,要让驾驶员能活命
Dialogue: 0,0:18:20.67,0:18:22.44,Layzner,Rey,0,0,0,,寻找攻击部位
Dialogue: 0,0:18:22.45,0:18:23.80,Layzner,Rey,0,0,0,,锁定攻击目标
Dialogue: 0,0:18:24.03,0:18:26.52,Layzner,Eiji,0,0,0,,不行 不能杀了驾驶员
Dialogue: 0,0:18:46.62,0:18:47.71,Layzner,Roanne,0,0,0,,看得到他吗
Comment: 0,0:18:47.88,0:18:48.30,Layzner,David,0,0,0,,对
Dialogue: 0,0:19:08.19,0:19:11.39,Layzner,Rey,0,0,0,,敌人反应停止 可以击破SPT
Dialogue: 0,0:19:15.59,0:19:17.37,Layzner,Rey,0,0,0,,可以击破SPT
Dialogue: 0,0:19:17.93,0:19:20.58,Layzner,Rey,0,0,0,,SPT重新启动中 请快击破
Dialogue: 0,0:19:22.64,0:19:25.11,Layzner,Rey,0,0,0,,攻击目标锁定 请快击破
Dialogue: 0,0:19:27.60,0:19:29.78,Layzner,Rey,0,0,0,,剩余时间08秒
Dialogue: 0,0:19:29.79,0:19:31.10,Layzner,Rey,0,0,0,,请快击破
Dialogue: 0,0:19:31.10,0:19:32.32,Layzner,Eiji,0,0,0,,不
Dialogue: 0,0:19:32.33,0:19:34.39,Layzner,Eiji,0,0,0,,我不要 我不要杀人
Dialogue: 0,0:19:41.53,0:19:44.32,Layzner,Egyle,0,0,0,,明明就是背叛者 还说什么不要杀人
Dialogue: 0,0:19:44.98,0:19:47.72,Layzner,Eiji,0,0,0,,我不要了 我受够了 不要再杀人了
Dialogue: 0,0:19:50.27,0:19:51.20,Layzner,Egyle,0,0,0,,他想干什么
Dialogue: 0,0:19:55.43,0:19:56.93,Layzner,David,0,0,0,,他在干什么
Dialogue: 0,0:19:56.93,0:19:58.40,Layzner,David,0,0,0,,快把武器捡起来 会被干掉的
Dialogue: 0,0:20:05.49,0:20:06.73,Layzner,Egyle,0,0,0,,他想空手拆机吗
Dialogue: 0,0:20:11.14,0:20:12.66,Layzner,David,0,0,0,,笨蛋 想送死吗
Dialogue: 0,0:20:12.67,0:20:13.44,Layzner,Roanne,0,0,0,,让我看一下
Dialogue: 0,0:20:26.15,0:20:27.07,Layzner,Arthur,0,0,0,,照到了
Dialogue: 0,0:20:27.07,0:20:27.69,Layzner,Arthur,0,0,0,,奇怪
Dialogue: 0,0:20:27.88,0:20:29.28,Layzner,Elizabeth,0,0,0,,他没有武器
Dialogue: 0,0:20:29.42,0:20:31.08,Layzner,Simone,0,0,0,,没有武器作战
Dialogue: 0,0:20:31.09,0:20:33.12,Layzner,Arthur,0,0,0,,别开玩笑了 没人会去救他的
Dialogue: 0,0:20:40.24,0:20:42.21,Layzner,David,0,0,0,,快动 快给我动起来
Dialogue: 0,0:20:50.06,0:20:52.10,Layzner,David,0,0,0,,怎么连动都动不了
Dialogue: 0,0:20:52.33,0:20:54.01,Layzner,Com,0,0,0,,解除手动操纵
Dialogue: 0,0:20:54.46,0:20:55.51,Layzner,David,0,0,0,,你说啥呐
Dialogue: 0,0:20:55.87,0:20:57.80,Layzner,David,0,0,0,,这种事你自己做就好了
Dialogue: 0,0:20:57.81,0:20:58.15,Layzner,Com,0,0,0,,Ready.
Dialogue: 0,0:21:09.02,0:21:13.66,Layzner,Rey,0,0,0,,被击中的概率在百分之九十八以上
Dialogue: 0,0:21:13.66,0:21:16.64,Layzner,Rey,0,0,0,,飞行员生存率不到0.01% 准备逃脱
Dialogue: 0,0:21:19.51,0:21:22.33,Layzner,Egyle,0,0,0,,这是最适合你这背叛者死的地方
Dialogue: 0,0:21:22.87,0:21:24.60,Layzner,Egyle,0,0,0,,你这叛徒去死吧
Dialogue: 0,0:21:29.00,0:21:29.50,Layzner,Egyle,0,0,0,,什么
Dialogue: 0,0:21:42.83,0:21:43.90,Layzner,Roanne,0,0,0,,给我打中 给我打中
Dialogue: 0,0:21:46.55,0:21:47.41,Layzner,Roanne,0,0,0,,打中啦
Dialogue: 0,0:21:47.91,0:21:48.59,Layzner,David,0,0,0,,罗安
Dialogue: 0,0:21:50.87,0:21:52.07,Layzner,Egyle,0,0,0,,有三架
Dialogue: 0,0:21:52.07,0:21:54.64,Layzner,Dal/Ash,0,0,0,,一号机 右边受损 无法操纵
Dialogue: 0,0:21:56.34,0:21:57.37,Layzner,Egyle,0,0,0,,先回到舰上
Dialogue: 0,0:22:13.08,0:22:14.33,Layzner,David,0,0,0,,成功了
Dialogue: 0,0:22:20.84,0:22:21.76,Layzner,Roanne,0,0,0,,我们成功了
Dialogue: 0,0:22:26.12,0:22:29.76,Layzner,Anna,0,0,0,,大卫跟罗安救了那个人
Dialogue: 0,0:22:30.68,0:22:33.48,Layzner,Anna,0,0,0,,这真是不可否认的事实
Dialogue: 0,0:22:34.57,0:22:38.95,Layzner,Anna,0,0,0,,虽然大卫一定是为了自己才战斗的
Dialogue: 0,0:22:39.98,0:22:49.66,Layzner,Anna,0,0,0,,可是在大卫心中对那个人的恨正在慢慢的消失 我知道
Dialogue: 0,0:23:54.85,0:23:55.76,Layzner,Trailer,0,0,0,,那个人呢
Dialogue: 0,0:23:57.90,0:23:59.01,Layzner,Trailer,0,0,0,,他
Dialogue: 0,0:23:59.02,0:24:00.48,Layzner,Trailer,0,0,0,,对
Dialogue: 0,0:24:00.48,0:24:03.54,Layzner,Trailer,0,0,0,,安娜喜欢他是吗
Dialogue: 0,0:24:04.88,0:24:09.88,Layzner,,0,0,0,,下一集 叫他！？英二
Dialogue: 0,0:24:09.88,0:24:11.88,Layzner,,0,0,0,,

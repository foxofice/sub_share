Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroTitle,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:01:01.33,0:01:06.15,Layzner,,0,0,0,,军人就算了 竟会把地球的命运交给那些小鬼
Dialogue: 0,0:01:06.15,0:01:10.49,Layzner,,0,0,0,,拼命一搏吧
Dialogue: 0,0:01:06.15,0:01:10.49,Layzner,,0,0,0,,那些孩子是为了要解决你们这些权利者愚蠢的行为
Dialogue: 0,0:01:44.08,0:01:49.36,Layzner,,0,0,0,,古拉特斯为了要征服地球而开始破坏臭氧层
Dialogue: 0,0:01:51.20,0:01:54.46,Layzner,,0,0,0,,让人们暴露在强烈的宇宙射线之下
Dialogue: 0,0:01:54.46,0:01:58.27,Layzner,,0,0,0,,不只是街道会化为乌有连美丽的大自然都被破坏了
Dialogue: 0,0:01:58.42,0:01:59.61,Layzner,,0,0,0,,那个是
Dialogue: 0,0:02:00.33,0:02:06.20,Layzner,,0,0,0,,我们为了保护地球的一切向着古拉特斯的攻击卫星出发了
Dialogue: 0,0:02:07.64,0:02:15.48,Layzner,,0,0,0,,再次和雷兹纳一起出现
Dialogue: 0,0:02:07.64,0:02:15.48,Layzner,,0,0,0,,就在那时 曾一度消失在我们面前的英二
Dialogue: 0,0:02:16.23,0:02:23.36,Layzner,,0,0,0,,大卫 罗安 听得到吗 西蒙尼 亚瑟 安娜 大家都在航天飞机上吗
Dialogue: 0,0:02:24.20,0:02:26.23,Layzner,,0,0,0,,博士也在吗 我现在就去跟大家会和
Dialogue: 0,0:02:39.04,0:02:44.01,Layzner,,0,0,0,,第二十四话 化为光影的英二
Dialogue: 0,0:03:05.32,0:03:09.57,Layzner,,0,0,0,,他们怎么样了 飞鸟英二跟那些小孩回合了
Dialogue: 0,0:03:29.38,0:03:30.13,Layzner,,0,0,0,,英二
Dialogue: 0,0:03:34.35,0:03:35.54,Layzner,,0,0,0,,英二
Dialogue: 0,0:03:44.85,0:03:46.60,Layzner,,0,0,0,,我就想你一定会来
Dialogue: 0,0:03:47.88,0:03:50.44,Layzner,,0,0,0,,这下一定会有奇迹的
Dialogue: 0,0:03:53.01,0:03:53.79,Layzner,,0,0,0,,安娜
Dialogue: 0,0:03:55.13,0:03:56.44,Layzner,,0,0,0,,连你也在
Dialogue: 0,0:03:58.41,0:04:04.07,Layzner,,0,0,0,,从火星事件后我们就开始决定自己的事了 这次也一样
Dialogue: 0,0:04:04.44,0:04:09.79,Layzner,,0,0,0,,我们也相信奇迹会发生才坐上这太空船的
Dialogue: 0,0:04:04.44,0:04:09.79,Layzner,,0,0,0,,我们虽然都已经堵上生死 但即使是万分之一的机会
Dialogue: 0,0:04:10.03,0:04:10.85,Layzner,,0,0,0,,奇迹
Dialogue: 0,0:04:11.66,0:04:16.66,Layzner,,0,0,0,,对 在火星时的我们也是被英二你救的
Dialogue: 0,0:04:16.66,0:04:19.38,Layzner,,0,0,0,,能活着回地球也是奇迹
Dialogue: 0,0:04:19.50,0:04:22.22,Layzner,,0,0,0,,但其实那是我们
Dialogue: 0,0:04:22.31,0:04:24.64,Layzner,,0,0,0,,彼此理解信任和帮助才会产生奇迹的
Dialogue: 0,0:04:31.94,0:04:35.50,Layzner,,0,0,0,,这次为了守护地球我们要再创造一次奇迹
Dialogue: 0,0:04:35.81,0:04:42.00,Layzner,,0,0,0,,英二 你知道吗 你可是幸运之神啊 说点什么嘛
Dialogue: 0,0:04:43.78,0:04:51.81,Layzner,,0,0,0,,我并没有那能耐 不过我会尽全力战斗 和大家一起
Dialogue: 0,0:05:01.37,0:05:03.84,Layzner,,0,0,0,,我是山姆 你们准备好了吗
Dialogue: 0,0:05:03.84,0:05:04.19,Layzner,,0,0,0,,是
Dialogue: 0,0:05:05.15,0:05:11.06,Layzner,,0,0,0,,我们会尽量掩护你们 然后尽可能让你们接近敌人
Dialogue: 0,0:05:11.06,0:05:13.56,Layzner,,0,0,0,,我知道了 非常感谢你们
Dialogue: 0,0:05:13.56,0:05:18.92,Layzner,,0,0,0,,我才是 我很荣幸能担任保护地球的小英雄的任务
Dialogue: 0,0:05:19.09,0:05:21.28,Layzner,,0,0,0,,谢谢你 山姆 还有大家
Dialogue: 0,0:05:21.47,0:05:26.22,Layzner,,0,0,0,,你是大卫吧 跟大家说这次任务完了后我再好好招待各位
Dialogue: 0,0:05:26.87,0:05:28.12,Layzner,,0,0,0,,我一定会好好考虑的
Dialogue: 0,0:05:28.12,0:05:31.46,Layzner,,0,0,0,,史巴希莫 听听我的提议如何
Dialogue: 0,0:05:31.56,0:05:34.87,Layzner,,0,0,0,,我会叫索尼娅做好吃的俄罗斯菜给你们吃
Dialogue: 0,0:05:34.87,0:05:36.31,Layzner,,0,0,0,,喂 谁是索尼娅
Dialogue: 0,0:05:36.31,0:05:41.09,Layzner,,0,0,0,,山姆 你也要来
Dialogue: 0,0:05:36.31,0:05:41.09,Layzner,,0,0,0,,我的未婚妻 我结婚典礼时大家一定要来
Dialogue: 0,0:05:41.09,0:05:42.68,Layzner,,0,0,0,,OK 你的名字是
Dialogue: 0,0:05:42.68,0:05:44.15,Layzner,,0,0,0,,我是摩洛托艾夫大尉
Dialogue: 0,0:05:44.15,0:05:46.93,Layzner,,0,0,0,,好 我答应你 摩洛托艾夫大尉
Dialogue: 0,0:05:47.12,0:05:52.56,Layzner,,0,0,0,,怎么啦 大家怎么突然变这么好 说道军人本来不就是
Dialogue: 0,0:05:52.56,0:05:57.03,Layzner,,0,0,0,,可是大家都是人啊 就算国家人种不同 还是能相互理解的
Dialogue: 0,0:05:57.03,0:06:00.21,Layzner,,0,0,0,,一想到那都是托古拉特斯的福就觉得好讽刺
Dialogue: 0,0:06:16.80,0:06:19.21,Layzner,,0,0,0,,古拉特斯人和地球人也能相互理解
Dialogue: 0,0:06:20.02,0:06:25.59,Layzner,,0,0,0,,只要公开古拉特斯诞生的秘密就可以
Dialogue: 0,0:06:25.80,0:06:28.30,Layzner,,0,0,0,,可是现在却只能这么拯救地球
Dialogue: 0,0:06:28.44,0:06:33.74,Layzner,,0,0,0,,资讯信息 离离开大气层时间0.10 +- 0.01
Dialogue: 0,0:06:36.68,0:06:38.68,Layzner,,0,0,0,,地球的战斗机群接近
Dialogue: 0,0:06:38.99,0:06:41.55,Layzner,,0,0,0,,准备出动所有的SPT 准备迎击
Dialogue: 0,0:06:42.65,0:06:47.02,Layzner,,0,0,0,,地球的战斗机没什么 要征服他们只是时间的问题
Dialogue: 0,0:06:47.02,0:06:48.65,Layzner,,0,0,0,,雷兹纳怎么了
Dialogue: 0,0:06:48.86,0:06:53.93,Layzner,,0,0,0,,而且到现在还没出现 说不定
Dialogue: 0,0:06:48.86,0:06:53.93,Layzner,,0,0,0,,听说已经跟玖丽亚一起坠落了
Dialogue: 0,0:06:54.27,0:06:58.99,Layzner,,0,0,0,,加强戒备 一定要彻底的摧毁雷兹纳
Dialogue: 0,0:06:58.99,0:07:05.19,Layzner,,0,0,0,,是 可是陛下 现在的情况就算有一架雷兹纳 你还有什么不放心呢
Dialogue: 0,0:07:05.61,0:07:10.11,Layzner,,0,0,0,,祖鲁副官也是因为好奇所以才丧命的
Dialogue: 0,0:07:12.55,0:07:17.83,Layzner,,0,0,0,,不想死的话就闭嘴乖乖听我的命令
Dialogue: 0,0:07:18.17,0:07:20.86,Layzner,,0,0,0,,是 尽全力消灭雷兹纳
Dialogue: 0,0:07:22.92,0:07:26.70,Layzner,,0,0,0,,第三队 雷兹纳出现的话 基乌拉小队全机出击
Dialogue: 0,0:07:26.95,0:07:31.89,Layzner,,0,0,0,,卡布斯小队和兹雷克小队到中继点17位置待机 卡克小队前进
Dialogue: 0,0:07:40.73,0:07:43.77,Layzner,,0,0,0,,小心 敌人的机器人要来了
Dialogue: 0,0:07:53.17,0:07:54.48,Layzner,,0,0,0,,来了
Dialogue: 0,0:08:29.11,0:08:31.35,Layzner,,0,0,0,,孩子们 祝你们好运了
Dialogue: 0,0:08:33.32,0:08:34.85,Layzner,,0,0,0,,山姆少佐
Dialogue: 0,0:08:34.85,0:08:38.58,Layzner,,0,0,0,,别在意 我们会尽可能进行防御
Dialogue: 0,0:08:38.58,0:08:41.57,Layzner,,0,0,0,,地球就拜托你们了 孩子们
Dialogue: 0,0:08:41.89,0:08:45.60,Layzner,,0,0,0,,可恶 走吧 英二 罗安
Dialogue: 0,0:08:45.60,0:08:46.57,Layzner,,0,0,0,,好
Dialogue: 0,0:08:47.04,0:08:48.57,Layzner,,0,0,0,,英二
Dialogue: 0,0:09:06.35,0:09:09.79,Layzner,,0,0,0,,不行 不能去
Dialogue: 0,0:09:18.23,0:09:23.04,Layzner,,0,0,0,,你们只有三机而已 就算是英二你也不可能创造奇迹
Dialogue: 0,0:09:23.16,0:09:25.19,Layzner,,0,0,0,,不要去送死
Dialogue: 0,0:09:27.26,0:09:33.69,Layzner,,0,0,0,,总统算什么 国防部长算什么 那些世界上的大人物们
Dialogue: 0,0:09:35.47,0:09:38.19,Layzner,,0,0,0,,不就是他们把地球搞成这样的吗
Dialogue: 0,0:09:38.57,0:09:39.60,Layzner,,0,0,0,,西蒙尼
Dialogue: 0,0:09:40.16,0:09:43.88,Layzner,,0,0,0,,都是因为听那些掌权者的话地球才会被毁灭的
Dialogue: 0,0:09:44.07,0:09:50.00,Layzner,,0,0,0,,不是吗 为什么为了那些笨蛋大家都得死
Dialogue: 0,0:09:52.29,0:09:54.22,Layzner,,0,0,0,,别再说了 西蒙尼
Dialogue: 0,0:09:54.63,0:09:59.00,Layzner,,0,0,0,,我不认同 这样的星球 没有守护的价值
Dialogue: 0,0:10:27.38,0:10:28.47,Layzner,,0,0,0,,对不起
Dialogue: 0,0:10:31.88,0:10:33.28,Layzner,,0,0,0,,我爱你
Dialogue: 0,0:10:33.50,0:10:38.84,Layzner,,0,0,0,,就算奇迹没有出现 能跟你葬身在同一片天空下我就满足了
Dialogue: 0,0:11:03.90,0:11:09.00,Layzner,,0,0,0,,可恶的地球人 最后还在做困兽之斗是吗 哼 白费力气
Dialogue: 0,0:11:16.21,0:11:21.68,Layzner,,0,0,0,,各机听命 注意地球军阵中的航天飞机里面可能躲着雷兹纳
Dialogue: 0,0:11:21.68,0:11:23.21,Layzner,,0,0,0,,了解
Dialogue: 0,0:11:28.25,0:11:29.90,Layzner,,0,0,0,,我现在就把你揪出来
Dialogue: 0,0:11:32.37,0:11:35.68,Layzner,,0,0,0,,英二 从火星一路过来我一直都在跟你吵架
Dialogue: 0,0:11:37.84,0:11:38.62,Layzner,,0,0,0,,大卫
Dialogue: 0,0:11:48.18,0:11:49.31,Layzner,,0,0,0,,来 走吧
Dialogue: 0,0:11:53.18,0:11:54.06,Layzner,,0,0,0,,英二
Dialogue: 0,0:11:55.62,0:11:56.93,Layzner,,0,0,0,,有缘再见吧
Dialogue: 0,0:11:57.68,0:11:59.40,Layzner,,0,0,0,,那大家 我走了
Dialogue: 0,0:12:00.15,0:12:04.02,Layzner,,0,0,0,,罗安 不要死 要活着大家再聚在一起
Dialogue: 0,0:12:05.52,0:12:07.24,Layzner,,0,0,0,,我们都不能死
Dialogue: 0,0:12:08.99,0:12:12.99,Layzner,,0,0,0,,听好了 英二 我们七个人一定要再见面
Dialogue: 0,0:12:20.49,0:12:21.80,Layzner,,0,0,0,,嗯 我们七个人
Dialogue: 0,0:12:23.68,0:12:24.68,Layzner,,0,0,0,,英二
Dialogue: 0,0:12:37.74,0:12:38.52,Layzner,,0,0,0,,这是
Dialogue: 0,0:12:39.05,0:12:40.83,Layzner,,0,0,0,,这是地球的花
Dialogue: 0,0:12:41.05,0:12:47.08,Layzner,,0,0,0,,你虽然来过地球可是你都没摸过地球上美丽的东西
Dialogue: 0,0:12:47.80,0:12:48.58,Layzner,,0,0,0,,所以我
Dialogue: 0,0:12:50.55,0:12:51.34,Layzner,,0,0,0,,谢谢你
Dialogue: 0,0:12:51.39,0:12:55.96,Layzner,,0,0,0,,你一定要回来 地球上有很多这种漂亮的花
Dialogue: 0,0:12:58.83,0:13:00.30,Layzner,,0,0,0,,英二 拜托了
Dialogue: 0,0:13:40.48,0:13:41.11,Layzner,,0,0,0,,亚瑟
Dialogue: 0,0:13:41.20,0:13:42.89,Layzner,,0,0,0,,我能行 可是角度
Dialogue: 0,0:13:46.86,0:13:49.32,Layzner,,0,0,0,,伊丽莎白博士 请打开舱门
Dialogue: 0,0:13:49.76,0:13:52.54,Layzner,,0,0,0,,再一下就好了 我想尽可能的的接近卫星
Dialogue: 0,0:13:52.54,0:13:53.98,Layzner,,0,0,0,,博士 看后面
Dialogue: 0,0:14:06.73,0:14:08.70,Layzner,,0,0,0,,够了 请打开舱门
Dialogue: 0,0:14:15.39,0:14:17.54,Layzner,,0,0,0,,你想躲在里面到何时
Dialogue: 0,0:14:20.26,0:14:23.60,Layzner,,0,0,0,,已经到极限了 博士 请打开舱门
Dialogue: 0,0:14:24.73,0:14:25.42,Layzner,,0,0,0,,请小心
Dialogue: 0,0:14:36.42,0:14:40.42,Layzner,,0,0,0,,果然没错 全机注意 最优先是雷兹纳
Dialogue: 0,0:14:40.42,0:14:41.29,Layzner,,0,0,0,,了解
Dialogue: 0,0:14:45.35,0:14:47.98,Layzner,,0,0,0,,大卫 罗安 跟在我后面
Dialogue: 0,0:14:47.98,0:14:49.07,Layzner,,0,0,0,,OK 跟上了
Dialogue: 0,0:14:59.51,0:15:00.38,Layzner,,0,0,0,,大卫
Dialogue: 0,0:15:04.41,0:15:05.85,Layzner,,0,0,0,,不要离我太远
Dialogue: 0,0:15:05.85,0:15:07.91,Layzner,,0,0,0,,我知道 打倒他我就回去
Dialogue: 0,0:15:22.82,0:15:23.91,Layzner,,0,0,0,,可恶
Dialogue: 0,0:15:42.13,0:15:43.13,Layzner,,0,0,0,,可恶
Dialogue: 0,0:15:49.41,0:15:50.32,Layzner,,0,0,0,,罗安
Dialogue: 0,0:15:56.10,0:15:56.66,Layzner,,0,0,0,,罗安
Dialogue: 0,0:16:05.47,0:16:06.28,Layzner,,0,0,0,,罗安
Dialogue: 0,0:16:06.69,0:16:07.59,Layzner,,0,0,0,,我没事
Dialogue: 0,0:16:14.91,0:16:15.53,Layzner,,0,0,0,,罗安
Dialogue: 0,0:16:15.66,0:16:16.69,Layzner,,0,0,0,,我的手被打掉了
Dialogue: 0,0:16:16.69,0:16:17.31,Layzner,,0,0,0,,大卫
Dialogue: 0,0:16:17.41,0:16:18.22,Layzner,,0,0,0,,交给我
Dialogue: 0,0:16:21.69,0:16:22.66,Layzner,,0,0,0,,混蛋
Dialogue: 0,0:16:43.15,0:16:46.97,Layzner,,0,0,0,,大卫和罗安 你们都是我最重要的伙伴 不要死啊
Dialogue: 0,0:17:02.40,0:17:03.65,Layzner,,0,0,0,,那家伙是最后一架了吗
Dialogue: 0,0:17:05.25,0:17:06.00,Layzner,,0,0,0,,敌人来了
Dialogue: 0,0:17:13.78,0:17:14.65,Layzner,,0,0,0,,怎么了
Dialogue: 0,0:17:14.74,0:17:16.40,Layzner,,0,0,0,,第三格纳库中弹
Dialogue: 0,0:17:19.99,0:17:21.62,Layzner,,0,0,0,,应该还有一架的
Dialogue: 0,0:17:25.99,0:17:26.99,Layzner,,0,0,0,,罗安 你的伤怎么样
Dialogue: 0,0:17:27.21,0:17:27.95,Layzner,,0,0,0,,我没事
Dialogue: 0,0:17:39.65,0:17:40.93,Layzner,,0,0,0,,英二 快逃
Dialogue: 0,0:17:54.46,0:17:55.71,Layzner,,0,0,0,,怎 怎么可能
Dialogue: 0,0:17:59.40,0:18:00.62,Layzner,,0,0,0,,英二
Dialogue: 0,0:18:00.93,0:18:02.24,Layzner,,0,0,0,,谢谢你 罗安
Dialogue: 0,0:18:02.56,0:18:05.12,Layzner,,0,0,0,,三号区域处有SPT队急速接近中
Dialogue: 0,0:18:07.30,0:18:10.86,Layzner,,0,0,0,,面对接下来的攻击我已没有信心再保护他们俩
Dialogue: 0,0:18:11.02,0:18:12.74,Layzner,,0,0,0,,英二 走吧
Dialogue: 0,0:18:12.74,0:18:14.71,Layzner,,0,0,0,,大卫 把罗安带回航天飞机
Dialogue: 0,0:18:14.71,0:18:16.77,Layzner,,0,0,0,,我没事 还能打
Dialogue: 0,0:18:16.86,0:18:18.96,Layzner,,0,0,0,,罗安 交给我和英二吧
Dialogue: 0,0:18:20.02,0:18:21.36,Layzner,,0,0,0,,等一下 英二
Dialogue: 0,0:18:25.05,0:18:27.11,Layzner,,0,0,0,,有SPT队极速接近中
Dialogue: 0,0:18:27.80,0:18:30.43,Layzner,,0,0,0,,雷 马上去古雷斯库的母舰
Dialogue: 0,0:18:30.49,0:18:30.90,Layzner,,0,0,0,,Ready.
Dialogue: 0,0:18:32.36,0:18:34.77,Layzner,,0,0,0,,英二 你要去哪 等我一下
Dialogue: 0,0:18:34.77,0:18:37.17,Layzner,,0,0,0,,大卫 你不要过来 快回航天飞机
Dialogue: 0,0:18:37.17,0:18:38.11,Layzner,,0,0,0,,你说什么
Dialogue: 0,0:18:40.30,0:18:44.11,Layzner,,0,0,0,,雷 突破敌人SPT队的中央朝母舰冲过去
Dialogue: 0,0:18:44.14,0:18:45.08,Layzner,,0,0,0,,Ready.
Dialogue: 0,0:18:45.08,0:18:46.08,Layzner,,0,0,0,,英二 不要去
Dialogue: 0,0:18:46.08,0:18:46.99,Layzner,,0,0,0,,太乱来了
Dialogue: 0,0:18:46.99,0:18:48.58,Layzner,,0,0,0,,雷 发动V-MAX
Dialogue: 0,0:18:48.58,0:18:49.24,Layzner,,0,0,0,,Ready.
Dialogue: 0,0:18:53.08,0:18:54.92,Layzner,,0,0,0,,英二
Dialogue: 0,0:19:08.08,0:19:11.98,Layzner,,0,0,0,,我有保护美丽的地球 让她保持美丽原貌的义务
Dialogue: 0,0:19:12.48,0:19:15.67,Layzner,,0,0,0,,这是与凯利前辈的约定 也是为了玖丽亚姐姐
Dialogue: 0,0:19:24.01,0:19:27.70,Layzner,,0,0,0,,我们马上就要被那光给吞没了吧
Dialogue: 0,0:19:28.39,0:19:30.64,Layzner,,0,0,0,,他们能创造奇迹吗
Dialogue: 0,0:19:31.98,0:19:33.20,Layzner,,0,0,0,,只能祈祷了
Dialogue: 0,0:19:34.95,0:19:36.39,Layzner,,0,0,0,,还是没什么改变
Dialogue: 0,0:19:38.61,0:19:43.54,Layzner,,0,0,0,,军人就算了 竟把地球的命运交给那些小鬼
Dialogue: 0,0:19:43.54,0:19:44.98,Layzner,,0,0,0,,你到底想说什么
Dialogue: 0,0:19:44.98,0:19:48.29,Layzner,,0,0,0,,这行为太愚蠢了 基鲁巴特博士 你也一样
Dialogue: 0,0:19:49.20,0:19:54.70,Layzner,,0,0,0,,赌上自己性命的
Dialogue: 0,0:19:49.20,0:19:54.70,Layzner,,0,0,0,,那些孩子是为了要解决你们这些权利者愚蠢的行为
Dialogue: 0,0:19:57.14,0:19:58.82,Layzner,,0,0,0,,不 我没有资格说别人
Dialogue: 0,0:19:59.14,0:20:03.42,Layzner,,0,0,0,,在说别人之前我该为世界和平多尽一份力的
Dialogue: 0,0:20:04.35,0:20:05.51,Layzner,,0,0,0,,希望他们能原谅我
Dialogue: 0,0:20:09.92,0:20:15.17,Layzner,,0,0,0,,就算失去性命 我也不会后悔
Dialogue: 0,0:20:09.92,0:20:15.17,Layzner,,0,0,0,,只要是为了地球和住在上面的同伴们
Dialogue: 0,0:20:15.17,0:20:17.67,Layzner,,0,0,0,,笨蛋 这时候就不要再耍帅了
Dialogue: 0,0:20:17.95,0:20:19.35,Layzner,,0,0,0,,英二
Dialogue: 0,0:20:19.70,0:20:20.54,Layzner,,0,0,0,,英二
Dialogue: 0,0:20:20.63,0:20:21.63,Layzner,,0,0,0,,英二
Dialogue: 0,0:20:21.76,0:20:22.51,Layzner,,0,0,0,,英二
Dialogue: 0,0:20:22.60,0:20:23.54,Layzner,,0,0,0,,英二
Dialogue: 0,0:20:26.57,0:20:31.04,Layzner,,0,0,0,,我能认识你们 真的很开心
Dialogue: 0,0:20:31.10,0:20:32.41,Layzner,,0,0,0,,英二
Dialogue: 0,0:20:32.54,0:20:33.35,Layzner,,0,0,0,,安娜
Dialogue: 0,0:20:35.85,0:20:38.90,Layzner,,0,0,0,,我忘了问你这可爱的花叫什么名字
Dialogue: 0,0:20:49.26,0:20:55.63,Layzner,,0,0,0,,在很久很久前有一对非常相爱的男女
Dialogue: 0,0:20:55.73,0:20:59.07,Layzner,,0,0,0,,不只是追击队 前方也充满SPT
Dialogue: 0,0:20:59.07,0:21:05.44,Layzner,,0,0,0,,可是那男人为了要得到更过的幸福而远走他乡
Dialogue: 0,0:21:06.69,0:21:08.94,Layzner,,0,0,0,,那女人也相信那男人而一直在等他
Dialogue: 0,0:21:09.66,0:21:17.97,Layzner,,0,0,0,,天天等 月月等 年年等 终于她变成了白色的雏菊
Dialogue: 0,0:21:26.07,0:21:28.19,Layzner,,0,0,0,,雏菊是吗 谢谢你
Dialogue: 0,0:21:45.66,0:21:50.59,Layzner,,0,0,0,,警告信息 右前方0.05处有大批敌人SPT包围
Dialogue: 0,0:22:02.06,0:22:07.37,Layzner,,0,0,0,,消灭雷兹纳 不能再让这个秘密被人所知
Dialogue: 0,0:22:07.66,0:22:08.72,Layzner,,0,0,0,,走吧 雷
Dialogue: 0,0:22:09.53,0:22:12.37,Layzner,,0,0,0,,为了地球的战斗现在才开始
Dialogue: 0,0:22:12.37,0:22:13.09,Layzner,,0,0,0,,Ready.
Dialogue: 0,0:22:30.65,0:22:35.25,Layzner,,0,0,0,,我不会死 我怎么能这样死呢
Dialogue: 0,0:23:54.49,0:23:55.18,Layzner,,0,0,0,,不要开枪
Dialogue: 0,0:23:56.43,0:23:58.40,Layzner,,0,0,0,,你的所属是 名字呢
Dialogue: 0,0:23:58.86,0:24:05.11,Layzner,,0,0,0,,我来自古拉特斯 我的名字是英二 地球被盯上了
Dialogue: 0,0:24:05.11,0:24:09.27,Layzner,,0,0,0,,下一集 穿越宇宙
Dialogue: 0,0:22:56.81,0:23:02.10,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:02.45,0:23:06.86,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.78,0:23:14.24,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:14.42,0:23:20.20,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:20.46,0:23:26.21,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:26.47,0:23:33.42,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:34.27,0:23:40.10,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.73,0:23:45.77,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:57.20,0:23:03.00,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:03.00,0:23:07.42,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:09.30,0:23:14.63,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.63,0:23:20.85,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.85,0:23:27.06,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:27.06,0:23:34.03,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.86,0:23:40.70,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:41.33,0:23:46.12,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.62,0:23:51.55,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...

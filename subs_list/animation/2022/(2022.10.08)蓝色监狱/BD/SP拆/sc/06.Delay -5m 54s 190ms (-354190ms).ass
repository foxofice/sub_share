Dialogue: 0,0:00:04.02,0:00:06.94,Sign,,0,0,0,,{\fad(450,450)\pos(108,930)\an1\fs70\c&HAC4501&\3c&HFFFFFF&\blur1.5\bord5\fax-0.1\fn汉仪旗黑 95S}#6 叛徒
Dialogue: 1,0:00:00.94,0:00:03.98,CN,,0,0,0,,蓝色监狱 补时
Dialogue: 1,0:00:04.44,0:00:09.15,CN,,0,0,0,,看吧 这就是最好的早餐
Dialogue: 1,0:00:09.15,0:00:11.45,CN,,0,0,0,,早餐还是得吃面包啊
Dialogue: 1,0:00:11.45,0:00:14.16,CN,,0,0,0,,不 不吃饭怎么赢
Dialogue: 1,0:00:14.16,0:00:17.24,CN,,0,0,0,,米饭乃是日本人的灵魂
Dialogue: 1,0:00:17.24,0:00:18.62,CN,,0,0,0,,不对
Dialogue: 1,0:00:18.62,0:00:21.46,CN,,0,0,0,,吃面包搭配多啊
Dialogue: 1,0:00:21.46,0:00:23.83,CN,,0,0,0,,中午和晚上都吃饭
Dialogue: 1,0:00:23.83,0:00:26.67,CN,,0,0,0,,那早上只能吃面包了啊 笨蛋
Dialogue: 1,0:00:26.67,0:00:28.67,CN,,0,0,0,,早上才该要吃饭啊
Dialogue: 1,0:00:28.67,0:00:31.17,CN,,0,0,0,,吃面包很快就饿了
Dialogue: 1,0:00:31.17,0:00:32.97,CN,,0,0,0,,味噌汁和米板
Dialogue: 1,0:00:32.97,0:00:36.68,CN,,0,0,0,,现在正是夺回传统早餐之时
Dialogue: 1,0:00:38.60,0:00:40.27,CN,,0,0,0,,洗得真爽
Dialogue: 1,0:00:41.18,0:00:42.14,CN,,0,0,0,,喂 久远
Dialogue: 1,0:00:42.14,0:00:43.48,CN,,0,0,0,,早餐吃面包对吧
Dialogue: 1,0:00:43.85,0:00:45.65,CN,,0,0,0,,作为日本人 吃饭才对
Dialogue: 1,0:00:46.19,0:00:47.90,CN,,0,0,0,,选哪个 回答我
Dialogue: 1,0:00:48.15,0:00:49.90,CN,,0,0,0,,请投出你神圣的一票
Dialogue: 1,0:00:49.90,0:00:51.95,CN,,0,0,0,,呃 这…
Dialogue: 1,0:00:52.32,0:00:57.03,CN,,0,0,0,,我觉得牛奶泡玉米片最好
Dialogue: 1,0:00:57.13,0:00:59.18,CN,,0,0,0,,你这混蛋 叛徒
Dialogue: 1,0:00:59.18,0:01:01.39,CN,,0,0,0,,这有隐藏的玉米片派
Dialogue: 1,0:01:01.39,0:01:03.77,CN,,0,0,0,,加入米饭教吧
Dialogue: 1,0:01:03.77,0:01:06.10,CN,,0,0,0,,诅咒你长酵母菌
Dialogue: 0,0:00:00.94,0:00:03.98,JP,,0,0,0,,ブルーロック　アディショナルタイム
Dialogue: 0,0:00:04.44,0:00:09.15,JP,,0,0,0,,見よ　ベスト　オブ　ブレックファースト
Dialogue: 0,0:00:09.15,0:00:11.45,JP,,0,0,0,,朝はやっぱパンでしょ
Dialogue: 0,0:00:11.45,0:00:14.16,JP,,0,0,0,,いいや　ご飯しか勝たん
Dialogue: 0,0:00:14.16,0:00:17.24,JP,,0,0,0,,お米は日本人の心なりよ
Dialogue: 0,0:00:17.24,0:00:18.62,JP,,0,0,0,,いいや　いいや
Dialogue: 0,0:00:18.62,0:00:21.46,JP,,0,0,0,,パンのほうがバリエーション豊富だし
Dialogue: 0,0:00:21.46,0:00:23.83,JP,,0,0,0,,昼も夜も白飯食うんだから
Dialogue: 0,0:00:23.83,0:00:26.67,JP,,0,0,0,,朝はパンしかねえだろ　バーカ
Dialogue: 0,0:00:26.67,0:00:28.67,JP,,0,0,0,,朝こそ　ご飯でしょ
Dialogue: 0,0:00:28.67,0:00:31.17,JP,,0,0,0,,パンなんて腹持ち悪いし～
Dialogue: 0,0:00:31.17,0:00:32.97,JP,,0,0,0,,みそ汁とご飯
Dialogue: 0,0:00:32.97,0:00:36.68,JP,,0,0,0,,今こそ　日本人の朝食を　取り戻すなりよ
Dialogue: 0,0:00:38.60,0:00:40.27,JP,,0,0,0,,いいお風呂だった
Dialogue: 0,0:00:41.18,0:00:42.14,JP,,0,0,0,,おい　久遠
Dialogue: 0,0:00:42.14,0:00:43.48,JP,,0,0,0,,朝　パンだよな
Dialogue: 0,0:00:43.85,0:00:45.65,JP,,0,0,0,,ご飯っしょ　日本人なら
Dialogue: 0,0:00:46.19,0:00:47.90,JP,,0,0,0,,どっち　答えろ
Dialogue: 0,0:00:48.15,0:00:49.90,JP,,0,0,0,,清き一票を
Dialogue: 0,0:00:49.90,0:00:51.95,JP,,0,0,0,,えっ…やぁ
Dialogue: 0,0:00:52.32,0:00:57.03,JP,,0,0,0,,お…俺は　コーンフレークに牛乳がベストかな
Dialogue: 0,0:00:57.13,0:00:59.18,JP,,0,0,0,,てめえ　コラ　裏切り者
Dialogue: 0,0:00:59.18,0:01:01.39,JP,,0,0,0,,隠れコーンフレーク派がいるぞ
Dialogue: 0,0:01:01.39,0:01:03.77,JP,,0,0,0,,ご飯教へ入信せよ
Dialogue: 0,0:01:03.77,0:01:06.10,JP,,0,0,0,,久遠にイースト菌の呪いを

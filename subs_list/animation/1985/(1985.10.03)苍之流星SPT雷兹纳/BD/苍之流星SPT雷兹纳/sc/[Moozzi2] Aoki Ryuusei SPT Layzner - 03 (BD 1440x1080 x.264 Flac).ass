Dialogue: 0,0:00:02.07,0:00:08.52,LayznerIntroBeat,,0,0,0,,Blue Comet SPT Layzner
Dialogue: 0,0:00:02.07,0:00:08.52,STAFF,,0,0,0,,字幕：AYN字幕组 抄写：你说啥呐
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerTopMusic,,0,0,0,,Sora ni aoi ryusei
Dialogue: 0,0:00:10.41,0:00:15.97,LayznerMusic,,0,0,0,,天空中那湛蓝的流星
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerTopMusic,,0,0,0,,Yoru no unga o suberu you dane
Dialogue: 0,0:00:15.97,0:00:23.23,LayznerMusic,,0,0,0,,划过夜之运河
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerTopMusic,,0,0,0,,Futari biru no mado kara
Dialogue: 0,0:00:23.23,0:00:28.76,LayznerMusic,,0,0,0,,两个人 透过大楼的窗口
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerTopMusic,,0,0,0,,Touku no machi o sagashite ita yo
Dialogue: 0,0:00:28.76,0:00:35.84,LayznerMusic,,0,0,0,,寻找那遥远的都市
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerTopMusic,,0,0,0,,Kanashii hotomi de
Dialogue: 0,0:00:35.84,0:00:38.97,LayznerMusic,,0,0,0,,不要用那悲伤的眼眸
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerTopMusic,,0,0,0,,Ai o semenaide
Dialogue: 0,0:00:38.97,0:00:42.09,LayznerMusic,,0,0,0,,责备我的爱
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerTopMusic,,0,0,0,,Nani mo iwazuni ikasete hoshii
Dialogue: 0,0:00:42.09,0:00:48.57,LayznerMusic,,0,0,0,,希望你什么都别说让我离去
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerTopMusic,,0,0,0,,Hosoi sono kata o
Dialogue: 0,0:00:48.57,0:00:51.77,LayznerMusic,,0,0,0,,纤细的双肩
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerTopMusic,,0,0,0,,Sotto dakishimete
Dialogue: 0,0:00:51.77,0:00:54.69,LayznerMusic,,0,0,0,,紧紧地拥抱
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerTopMusic,,0,0,0,,Namida kisu de nugutta
Dialogue: 0,0:00:54.69,0:01:00.92,LayznerMusic,,0,0,0,,眼泪 用吻来拭去
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerTopMusic,,0,0,0,,Lonely Way - kono boku no
Dialogue: 0,0:01:10.59,0:01:13.77,LayznerMusic,,0,0,0,,Lonely Way- 这样的我
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerTopMusic,,0,0,0,,Lonely Way - omou mama
Dialogue: 0,0:01:13.77,0:01:17.54,LayznerMusic,,0,0,0,,Lonely Way - 扔抱着这种思绪
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerTopMusic,,0,0,0,,Hashire merosu no you ni
Dialogue: 0,0:01:17.54,0:01:23.34,LayznerMusic,,0,0,0,,就像奔跑的梅洛斯一样
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerTopMusic,,0,0,0,,Lonely Way - iki saki wa
Dialogue: 0,0:01:23.34,0:01:26.59,LayznerMusic,,0,0,0,,Lonely Way - 我的目标
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerTopMusic,,0,0,0,,Lonely Way - haruka kanata\n no yume o sagashite
Dialogue: 0,0:01:26.59,0:01:36.72,LayznerMusic,,0,0,0,,Lonely Way - 就是寻觅那遥远彼岸的梦
Dialogue: 0,0:01:40.85,0:01:43.68,Layzner,Eiji,0,0,0,,不要开枪！请不要开枪！
Dialogue: 0,0:01:43.68,0:01:50.63,Layzner,Anna,0,0,0,,我好像做噩梦一般 无法相信眼前发生的事
Dialogue: 0,0:01:51.62,0:02:01.26,Layzner,Anna,0,0,0,,更令人难以置信的是 \n这来自古拉特斯的少年竟用他的身体救了我们
Dialogue: 0,0:02:01.40,0:02:06.40,Layzner,,0,0,0,,相信他的眼睛
Dialogue: 0,0:02:08.62,0:02:12.40,Layzner,Man 1,0,0,0,,不好意思，有再进一步调查你的必要
Dialogue: 0,0:02:18.64,0:02:21.67,Layzner,Man 1,0,0,0,,再重新问一遍，你叫什么名字
Dialogue: 0,0:02:28.58,0:02:31.02,Layzner,Elizabeth,0,0,0,,对那少年的调查开始了
Dialogue: 0,0:02:31.02,0:02:33.26,Layzner,Arthur,0,0,0,,他真的是外星人吗
Dialogue: 0,0:02:33.26,0:02:34.37,Layzner,Elizabeth,0,0,0,,现在还不清楚
Dialogue: 0,0:02:34.37,0:02:37.24,Layzner,Simone,0,0,0,,当然是骗人的 你真笨
Dialogue: 0,0:02:37.24,0:02:39.11,Layzner,Arthur,0,0,0,,是...是这样啊
Dialogue: 0,0:02:39.11,0:02:42.37,Layzner,Roanne,0,0,0,,可是那种战斗武器 在地球上没看过啊
Dialogue: 0,0:02:43.75,0:02:45.43,Layzner,David,0,0,0,,什么古拉特斯啊
Dialogue: 0,0:02:45.43,0:02:46.54,Layzner,Arthur,0,0,0,,大卫
Dialogue: 0,0:02:51.14,0:02:54.59,Layzner,David,0,0,0,,他不来的话就不会发生这种事了
Dialogue: 0,0:02:55.45,0:02:56.60,Layzner,David,0,0,0,,可恶
Dialogue: 0,0:03:09.90,0:03:10.62,Layzner,Grescco,0,0,0,,凯利
Dialogue: 0,0:03:11.27,0:03:15.79,Layzner,Grescco,0,0,0,,你好像没正确理解我的命令
Dialogue: 0,0:03:17.02,0:03:20.80,Layzner,Grescco,0,0,0,,我应该有叫你处理掉那反叛者吧
Dialogue: 0,0:03:20.80,0:03:24.96,Layzner,Gail,0,0,0,,是 但我认为说服他也是一种处理方式
Dialogue: 0,0:03:24.96,0:03:28.85,Layzner,Man 1,0,0,0,,说服他？那家伙还是以前的友人吗
Dialogue: 0,0:03:28.85,0:03:34.43,Layzner,Man 1,0,0,0,,你好像忘了，的的血已被地球人的血弄脏
Dialogue: 0,0:03:34.43,0:03:38.68,Layzner,Gail,0,0,0,,我无法赞同你的话 阿尔巴特洛·纳尔·英二·飞鸟是古拉特斯人
Dialogue: 0,0:03:38.68,0:03:41.29,Layzner,Gail,0,0,0,,就算他流着地球人的血也一样
Dialogue: 0,0:03:41.29,0:03:47.34,Layzner,Man 1,0,0,0,,太天真了，他做的一切都跟我们古拉特斯追求的利益相反
Dialogue: 0,0:03:47.34,0:03:49.46,Layzner,Grescco,0,0,0,,这是一早就应该明白的问题
Dialogue: 0,0:03:52.50,0:03:59.42,Layzner,Grescco,0,0,0,,他有这种背叛行为就算因为地球人他拥有的好战血统
Dialogue: 0,0:03:59.42,0:04:06.46,Layzner,Grescco,0,0,0,,地球的历史全都是暴力，而造出这些历史的就算地球人自己
Dialogue: 0,0:04:07.67,0:04:08.77,Layzner,Grescco,0,0,0,,不是吗？
Dialogue: 0,0:04:09.74,0:04:17.25,Layzner,Gail,0,0,0,,确实 地球人就是这样 就连现在两大军事强国也还在武力竞争
Dialogue: 0,0:04:17.25,0:04:20.52,Layzner,Man 1,0,0,0,,既然你知道的话 为什么还要包庇他
Dialogue: 0,0:04:20.52,0:04:23.28,Layzner,Man 1,0,0,0,,作战计划才刚开始
Dialogue: 0,0:04:23.28,0:04:29.94,Layzner,Man 1,0,0,0,,如果他把手上的情报告诉地球人的话会对我们造成巨大的损失
Dialogue: 0,0:04:29.94,0:04:35.60,Layzner,Gail,0,0,0,,我从孩童时期就认识英二了 请再给我一次机会
Dialogue: 0,0:04:35.60,0:04:36.89,Layzner,Man,0,0,0,,你这家伙
Dialogue: 0,0:04:36.89,0:04:38.09,Layzner,Grescco,0,0,0,,够了
Dialogue: 0,0:04:38.63,0:04:39.90,Layzner,Grescco,0,0,0,,把他带下去
Dialogue: 0,0:04:39.90,0:04:40.83,Layzner,Gail,0,0,0,,阁下
Dialogue: 0,0:04:57.85,0:05:01.59,Layzner,Gosterro,0,0,0,,看样子你好像搞砸了嘛 真感谢你 凯利
Dialogue: 0,0:05:02.45,0:05:06.76,Layzner,Gosterro,0,0,0,,托你的福 我终于有事可以打发时间了
Dialogue: 0,0:05:09.60,0:05:10.84,Layzner,Gail,0,0,0,,你
Dialogue: 0,0:05:11.56,0:05:13.81,Layzner,Gosterro,0,0,0,,我是你的继任者
Dialogue: 0,0:05:18.05,0:05:20.85,Layzner,Gosterro,0,0,0,,好期待哦
Dialogue: 0,0:05:21.43,0:05:26.45,Layzner,Gosterro,0,0,0,,对了 我借用的SPT里的资料箱
Dialogue: 0,0:05:26.45,0:05:32.93,Layzner,Gosterro,0,0,0,,看了那家伙的战斗方式好像都故意避开要害攻击
Dialogue: 0,0:05:32.93,0:05:39.54,Layzner,Gosterro,0,0,0,,不只是英二没用 被他打败的你也更是没用
Dialogue: 0,0:05:39.99,0:05:43.35,Layzner,Gosterro,0,0,0,,你只有对女人下手才快
Dialogue: 0,0:05:44.06,0:05:47.08,Layzner,Gosterro,0,0,0,,别忘了那件事呦
Dialogue: 0,0:05:52.98,0:05:56.62,Layzner,Gail,0,0,0,,英二 那家伙对你姐姐玖丽亚的事还耿耿于怀
Dialogue: 0,0:05:56.62,0:05:57.58,Layzner,Gail,0,0,0,,小心一点
Dialogue: 0,0:06:14.43,0:06:16.95,Layzner,Man 1,0,0,0,,这怎么看都不像地球的东西
Dialogue: 0,0:06:16.95,0:06:21.33,Layzner,Man 2,0,0,0,,啊 材质好像也是特殊金属
Dialogue: 0,0:06:23.31,0:06:24.08,Layzner,Man 2,0,0,0,,你在干什么
Dialogue: 0,0:06:24.82,0:06:29.52,Layzner,Man 1,0,0,0,,啊 我在看上面有没有写MADE IN JAPAN
Dialogue: 0,0:06:29.52,0:06:30.75,Layzner,Man 1,0,0,0,,哈 原来如此
Dialogue: 0,0:06:47.74,0:06:48.89,Layzner,Man 1,0,0,0,,真的吗
Dialogue: 0,0:06:49.26,0:06:52.68,Layzner,Woman 1,0,0,0,,难以置信 他是飞鸟健的儿子
Dialogue: 0,0:06:52.68,0:06:57.02,Layzner,Man 1,0,0,0,,而且还说他是外星人 怎么叫人相信
Dialogue: 0,0:07:00.21,0:07:02.34,Layzner,Man 2,0,0,0,,小朋友 你在那里干嘛
Dialogue: 0,0:07:02.34,0:07:04.02,Layzner,Arthur,0,0,0,,那个...
Dialogue: 0,0:07:05.32,0:07:08.41,Layzner,Arthur,0,0,0,,我想我们也有了解情报的权利
Dialogue: 0,0:07:08.41,0:07:13.73,Layzner,Arthur,0,0,0,,请让我们参加调查 也就是说
Dialogue: 0,0:07:15.03,0:07:18.29,Layzner,Arthur,0,0,0,,大家 我听到了很了不得的事
Dialogue: 0,0:07:18.29,0:07:20.18,Layzner,Arthur,0,0,0,,刚才调查的时候
Dialogue: 0,0:07:20.18,0:07:23.93,Layzner,Arthur,0,0,0,,他说他是地球人跟古拉特斯人的混血
Dialogue: 0,0:07:23.93,0:07:25.51,Layzner,Simone,0,0,0,,他是混血
Dialogue: 0,0:07:25.51,0:07:31.70,Layzner,Arthur,0,0,0,,对 好像是因为某计划 他是最先抵达月球的宇航员的儿子
Dialogue: 0,0:07:31.70,0:07:36.51,Layzner,Simone,0,0,0,,最先到月球的是阿波罗计划的阿姆斯特朗吧
Dialogue: 0,0:07:37.09,0:07:39.77,Layzner,Roanne,0,0,0,,他果然脑子有问题
Dialogue: 0,0:07:39.77,0:07:41.66,Layzner,Elizabeth,0,0,0,,不 等一下
Dialogue: 0,0:07:41.66,0:07:46.79,Layzner,Elizabeth,0,0,0,,对了 在那之前有X计划的传闻你们听说过吗
Dialogue: 0,0:07:46.79,0:07:48.23,Layzner,Arthur,0,0,0,,X计划
Dialogue: 0,0:07:48.23,0:07:53.33,Layzner,Elizabeth,0,0,0,,对 因为宇航员下落不明导致计划失败的传闻
Dialogue: 0,0:07:53.33,0:07:57.08,Layzner,Arthur,0,0,0,,那失踪的宇航员就是他爸爸
Dialogue: 0,0:07:57.08,0:08:00.42,Layzner,Arthur,0,0,0,,我记得那宇航员是日本人飞鸟健
Dialogue: 0,0:08:00.42,0:08:03.71,Layzner,Elizabeth,0,0,0,,对 我也记得是日本人
Dialogue: 0,0:08:03.71,0:08:07.52,Layzner,Simone,0,0,0,,可是 历史课本里没有记载啊
Dialogue: 0,0:08:08.55,0:08:11.27,Layzner,Elizabeth,0,0,0,,大概是为了顾及大国的面子吧
Dialogue: 0,0:08:11.27,0:08:15.86,Layzner,Elizabeth,0,0,0,,也常有因为大谋划失败让国家政权倒台的事
Dialogue: 0,0:08:17.54,0:08:21.87,Layzner,Roanne,0,0,0,,那么就是为了不让大家知道而把历史抹消是吗
Dialogue: 0,0:08:21.87,0:08:25.25,Layzner,Simone,0,0,0,,原来如此 这也是有可能的
Dialogue: 0,0:08:25.25,0:08:30.17,Layzner,Arthur,0,0,0,,那么他坐的战斗兵器就真不是地球的了
Dialogue: 0,0:08:30.17,0:08:34.58,Layzner,Roanne,0,0,0,,那么就是真的有古拉特斯星
Dialogue: 0,0:08:34.58,0:08:40.35,Layzner,Arthur,0,0,0,,虽然还不敢相信可他说的话某种程度上是真的
Dialogue: 0,0:08:40.35,0:08:43.10,Layzner,David,0,0,0,,这样的家伙说的话可信吗
Dialogue: 0,0:08:47.34,0:08:48.83,Layzner,Man,0,0,0,,你说什么
Dialogue: 0,0:08:48.83,0:08:51.37,Layzner,Man,0,0,0,,你们的目的是要制造基地间的冲突
Dialogue: 0,0:08:55.46,0:08:57.58,Layzner,Eiji,0,0,0,,我就是为了告诉你们这个才来的
Dialogue: 0,0:08:58.99,0:09:03.81,Layzner,Man2,0,0,0,,就是说他们要引起第三次世界大战然后把地球当他们的殖民地吗
Dialogue: 0,0:09:03.81,0:09:07.89,Layzner,Man3,0,0,0,,这么说来他出现时苏联战机也被干掉了
Dialogue: 0,0:09:08.29,0:09:12.03,Layzner,Woman,0,0,0,,之后美国的战机也被卷入了
Dialogue: 0,0:09:12.03,0:09:14.58,Layzner,Woman,0,0,0,,我们那时还以为是哪国的误会
Dialogue: 0,0:09:14.58,0:09:19.32,Layzner,Woman2,0,0,0,,怎么可能 基地间应该会彼此联络的
Dialogue: 0,0:09:19.32,0:09:21.81,Layzner,Man,0,0,0,,不 这就不知道了
Dialogue: 0,0:09:21.81,0:09:24.57,Layzner,Man,0,0,0,,这下情况可危险了
Dialogue: 0,0:09:25.09,0:09:26.51,Layzner,Man2,0,0,0,,不会吧
Dialogue: 0,0:09:26.51,0:09:28.03,Layzner,Man2,0,0,0,,喂 比尔
Dialogue: 0,0:09:31.04,0:09:31.89,Layzner,Man3,0,0,0,,真是的
Dialogue: 0,0:09:33.22,0:09:34.54,Layzner,Man3,0,0,0,,不要动
Dialogue: 0,0:09:34.54,0:09:35.79,Layzner,Eiji,0,0,0,,Wait!请等一下
Dialogue: 0,0:09:39.63,0:09:42.57,Layzner,,0,0,0,,没时间了请让我去地球
Dialogue: 0,0:09:43.47,0:09:45.81,Layzner,,0,0,0,,放我出去 没时间了
Dialogue: 0,0:10:00.65,0:10:04.53,Layzner,Gosterro,0,0,0,,那么 去捉那家伙吧
Dialogue: 0,0:10:19.67,0:10:24.08,Layzner,Eiji,0,0,0,,你们把我关在这里时古拉特斯已经展开进攻了
Dialogue: 0,0:10:24.08,0:10:28.04,Layzner,Eiji,0,0,0,,不快一点就来不及了 拜托了
Dialogue: 0,0:10:51.83,0:10:53.05,Layzner,Eiji,0,0,0,,你
Dialogue: 0,0:10:57.18,0:10:58.33,Layzner,Eiji,0,0,0,,等一下
Dialogue: 0,0:11:01.85,0:11:02.86,Layzner,Eiji,0,0,0,,别跑
Dialogue: 0,0:11:20.04,0:11:22.66,Layzner,Eiji,0,0,0,,听我说
Dialogue: 0,0:11:46.06,0:11:48.97,Layzner,Woman,0,0,0,,这里是联合国基地 USA USA
Dialogue: 0,0:11:50.66,0:11:53.62,Layzner,Man,0,0,0,,看来天亮时 还是要去美国的基地看一下
Dialogue: 0,0:11:53.62,0:11:59.78,Layzner,Man2,0,0,0,,为了确认他说的话我们一直在这也不是办法
Dialogue: 0,0:12:03.98,0:12:05.78,Layzner,Elizabeth,0,0,0,,安娜 怎么了
Dialogue: 0,0:12:08.23,0:12:11.81,Layzner,Anna,0,0,0,,这个 他说的一定是真的
Dialogue: 0,0:12:11.81,0:12:14.52,Layzner,Elizabeth,0,0,0,,你怎么知道
Dialogue: 0,0:12:14.52,0:12:19.11,Layzner,Elizabeth,0,0,0,,因为他来了 让基地变成怎样你也看到了
Dialogue: 0,0:12:19.11,0:12:22.85,Layzner,Anna,0,0,0,,一定是真的 让他去地球吧
Dialogue: 0,0:12:22.85,0:12:25.98,Layzner,Woman,0,0,0,,想回地球的不只是他
Dialogue: 0,0:12:25.98,0:12:27.61,Layzner,Woman,0,0,0,,在场每个人都一样
Dialogue: 0,0:12:27.61,0:12:31.01,Layzner,Man,0,0,0,,没错 小姑娘 你不也是吗
Dialogue: 0,0:12:33.06,0:12:37.39,Layzner,Man2,0,0,0,,总之 明早全员去美国基地
Dialogue: 0,0:12:37.39,0:12:42.44,Layzner,Man2,0,0,0,,用那边的通信系统把那少年的话通知地球
Dialogue: 0,0:12:42.44,0:12:45.17,Layzner,Anna,0,0,0,,现在不能吗
Dialogue: 0,0:12:45.17,0:12:48.62,Layzner,Man,0,0,0,,现在不能哦 小姑娘
Dialogue: 0,0:12:48.62,0:12:51.28,Layzner,Anna,0,0,0,,我不是小姑娘
Dialogue: 0,0:12:53.00,0:12:58.97,Layzner,Man2,0,0,0,,总有一天 你会让我的欧金金变得很硬的
Dialogue: 0,0:12:58.97,0:13:01.95,Layzner,Elizabeth,0,0,0,,不要在我的学生面前说这么下流的话
Dialogue: 0,0:13:01.95,0:13:03.60,Layzner,Man2,0,0,0,,真是失礼了
Dialogue: 0,0:13:39.07,0:13:43.05,Layzner,David,0,0,0,,都是你 都是因为你的出现 害朱诺死了
Dialogue: 0,0:13:43.05,0:13:46.90,Layzner,David,0,0,0,,他是我的好朋友 如果你没出现的话
Dialogue: 0,0:14:05.74,0:14:06.96,Layzner,Man,0,0,0,,喂 你
Dialogue: 0,0:14:06.96,0:14:07.78,Layzner,Elizabeth,0,0,0,,安娜
Dialogue: 0,0:14:09.25,0:14:10.23,Layzner,Man,0,0,0,,等一下 安娜
Dialogue: 0,0:14:11.04,0:14:12.07,Layzner,Elizabeth,0,0,0,,等一下 安娜
Dialogue: 0,0:14:13.33,0:14:17.10,Layzner,David,0,0,0,,你给我说话 至少说句对不起 或者不好意思
Dialogue: 0,0:14:17.10,0:14:19.36,Layzner,David,0,0,0,,给我跪下来道歉
Dialogue: 0,0:14:19.36,0:14:20.94,Layzner,David,0,0,0,,你找死吗
Dialogue: 0,0:14:23.99,0:14:25.43,Layzner,Anna,0,0,0,,大卫
Dialogue: 0,0:14:26.46,0:14:28.64,Layzner,Elizabeth,0,0,0,,大卫 你想做什么
Dialogue: 0,0:14:28.64,0:14:31.69,Layzner,David,0,0,0,,大家都给我出去 不要阻止我
Dialogue: 0,0:14:34.98,0:14:35.94,Layzner,Man,0,0,0,,住手
Dialogue: 0,0:14:35.94,0:14:37.75,Layzner,David,0,0,0,,别过来 再过来我就开枪了
Dialogue: 0,0:14:37.75,0:14:39.03,Layzner,Man,0,0,0,,闹够了 把枪给我
Dialogue: 0,0:14:39.03,0:14:41.53,Layzner,David,0,0,0,,不要碰我 可恶 这家伙
Dialogue: 0,0:14:43.04,0:14:43.83,Layzner,David,0,0,0,,放开我
Dialogue: 0,0:14:45.26,0:14:46.05,Layzner,David,0,0,0,,住手
Dialogue: 0,0:14:52.68,0:14:53.72,Layzner,Anna,0,0,0,,好过分
Dialogue: 0,0:14:56.95,0:14:58.18,Layzner,Eiji,0,0,0,,追来了
Dialogue: 0,0:14:58.18,0:14:59.85,Layzner,Eiji,0,0,0,,追兵接近了
Dialogue: 0,0:15:02.16,0:15:03.31,Layzner,Eiji,0,0,0,,请把那东西给我
Dialogue: 0,0:15:10.94,0:15:11.67,Layzner,Eiji,0,0,0,,谢谢
Dialogue: 0,0:15:21.67,0:15:27.45,Layzner,Anna,0,0,0,,我一直相信能保护我们的只有他
Dialogue: 0,0:15:38.71,0:15:41.22,Layzner,Eiji,0,0,0,,雷 改成一般模式
Dialogue: 0,0:15:41.22,0:15:42.08,Layzner,Rey,0,0,0,,Ready
Dialogue: 0,0:15:56.76,0:15:58.08,Layzner,Eiji,0,0,0,,启动检查
Dialogue: 0,0:15:58.08,0:16:01.34,Layzner,Rey,0,0,0,,各部分的二氧化碳解冻并结合中
Dialogue: 0,0:16:01.34,0:16:04.86,Layzner,Rey,0,0,0,,还需相对时间25秒
Dialogue: 0,0:16:04.86,0:16:05.73,Layzner,Eiji,0,0,0,,快一点
Dialogue: 0,0:16:16.85,0:16:19.13,Layzner,Com,0,0,0,,目标各部分结合中
Dialogue: 0,0:16:19.13,0:16:22.08,Layzner,Com,0,0,0,,修复完成率百分之五十
Dialogue: 0,0:16:22.08,0:16:25.53,Layzner,Com,0,0,0,,可以马上击毁
Dialogue: 0,0:16:25.89,0:16:31.61,Layzner,Gosterro,0,0,0,,不 我不要这么快就打倒他 等我干掉地球人后再慢慢折磨他
Dialogue: 0,0:16:38.25,0:16:39.58,Layzner,Eiji,0,0,0,,提升雷达的能力
Dialogue: 0,0:16:39.58,0:16:42.64,Layzner,Rey,0,0,0,,该部分修理完成
Dialogue: 0,0:16:42.64,0:16:45.73,Layzner,Rey,0,0,0,,预定遭遇时间15秒
Dialogue: 0,0:16:45.73,0:16:47.34,Layzner,Eiji,0,0,0,,什么 只剩15秒
Dialogue: 0,0:16:47.34,0:16:48.30,Layzner,Rey,0,0,0,,11...
Dialogue: 0,0:16:48.30,0:16:49.36,Layzner,Rey,0,0,0,,10...
Dialogue: 0,0:16:49.36,0:16:50.38,Layzner,Rey,0,0,0,,09...
Dialogue: 0,0:16:50.38,0:16:51.44,Layzner,Rey,0,0,0,,08...
Dialogue: 0,0:16:51.44,0:16:52.59,Layzner,Rey,0,0,0,,07...
Dialogue: 0,0:16:52.59,0:16:53.84,Layzner,Rey,0,0,0,,06...
Dialogue: 0,0:16:53.84,0:16:54.96,Layzner,Rey,0,0,0,,05...
Dialogue: 0,0:16:54.96,0:16:56.09,Layzner,Rey,0,0,0,,04...
Dialogue: 0,0:16:56.09,0:16:57.69,Layzner,Rey,0,0,0,,03...
Dialogue: 0,0:16:57.69,0:17:00.57,Layzner,Rey,0,0,0,,机体各关节的可动部分解冻完成
Dialogue: 0,0:17:11.70,0:17:14.05,Layzner,Man,0,0,0,,这样下去不行 叫大家去避难
Dialogue: 0,0:17:21.45,0:17:22.38,Layzner,Eiji,0,0,0,,快住手
Dialogue: 0,0:17:22.73,0:17:26.66,Layzner,Gosterro,0,0,0,,你们就继续无用的挣扎吧
Dialogue: 0,0:17:26.66,0:17:32.97,Layzner,Gosterro,0,0,0,,怎么了 还不能动是吗 不过就算你能动也打不倒我的
Dialogue: 0,0:17:32.97,0:17:35.36,Layzner,Eiji,0,0,0,,我只是要平息无意义的纷争
Dialogue: 0,0:17:35.36,0:17:36.66,Layzner,Gosterro,0,0,0,,吵死人了
Dialogue: 0,0:17:36.66,0:17:39.56,Layzner,Gosterro,0,0,0,,我跟凯利可不一样 不会听你说的
Dialogue: 0,0:17:44.50,0:17:49.19,Layzner,Gosterro,0,0,0,,用这种家伙就想打倒我 别小看我
Dialogue: 0,0:17:52.12,0:17:53.04,Layzner,Eiji,0,0,0,,状况汇报
Dialogue: 0,0:17:53.04,0:17:55.55,Layzner,Rey,0,0,0,,机体恢复率:  95%.
Dialogue: 0,0:18:08.14,0:18:09.79,Layzner,Man,0,0,0,,快去避难 不要过来
Dialogue: 0,0:18:12.08,0:18:13.69,Layzner,Man2,0,0,0,,敌人又接近了 快一点
Dialogue: 0,0:18:21.63,0:18:22.75,Layzner,Man,0,0,0,,快住手 没用的
Dialogue: 0,0:18:25.19,0:18:26.92,Layzner,PilotA,0,0,0,,好简单的任务
Dialogue: 0,0:18:31.40,0:18:34.24,Layzner,Rey,0,0,0,,机体回复率:  95%.
Dialogue: 0,0:18:34.26,0:18:35.69,Layzner,Eiji,0,0,0,,够了 出发
Dialogue: 0,0:18:41.84,0:18:43.20,Layzner,Gosterro,0,0,0,,终于动了啊
Dialogue: 0,0:18:58.76,0:19:02.14,Layzner,Gosterro,0,0,0,,和资料记载的一样他不会杀人
Dialogue: 0,0:19:03.33,0:19:05.52,Layzner,Gosterro,0,0,0,,我来跟你慢慢玩好了
Dialogue: 0,0:19:08.54,0:19:12.06,Layzner,Eiji,0,0,0,,不救那些地球人的话他们会被杀光的
Dialogue: 0,0:19:15.88,0:19:19.33,Layzner,Rey,0,0,0,,脚步装甲板中弹 损伤轻微
Dialogue: 0,0:19:19.33,0:19:20.43,Layzner,Eiji,0,0,0,,无论怎样
Dialogue: 0,0:19:20.43,0:19:21.72,Layzner,GOsterro,0,0,0,,成功了吗
Dialogue: 0,0:19:33.55,0:19:35.06,Layzner,Simone,0,0,0,,不行了
Dialogue: 0,0:19:35.06,0:19:38.72,Layzner,Simone,0,0,0,,我们要死在这里了 大家都要死在这里了
Dialogue: 0,0:19:41.02,0:19:42.82,Layzner,Woman,0,0,0,,这里没事的
Dialogue: 0,0:19:42.82,0:19:45.84,Layzner,Woman,0,0,0,,因为有核设施所以比其他地方都要坚固
Dialogue: 0,0:19:49.87,0:19:52.67,Layzner,Man,0,0,0,,这里好像也很危险的样子
Dialogue: 0,0:19:58.80,0:20:01.32,Layzner,Man,0,0,0,,波布 带大家先走
Dialogue: 0,0:20:01.32,0:20:04.57,Layzner,Man,0,0,0,,上面的仓库有车子 大家快离开
Dialogue: 0,0:20:04.57,0:20:07.11,Layzner,Woman,0,0,0,,你在想什么
Dialogue: 0,0:20:07.11,0:20:09.73,Layzner,Man2,0,0,0,,该不会你想引爆这里吧
Dialogue: 0,0:20:09.73,0:20:10.93,Layzner,Woman2,0,0,0,,不行 这样太乱来了
Dialogue: 0,0:20:13.42,0:20:15.38,Layzner,Man,0,0,0,,这样下去也不安全
Dialogue: 0,0:20:15.38,0:20:17.56,Layzner,Man,0,0,0,,但就这样被干掉大家甘心吗
Dialogue: 0,0:20:17.56,0:20:20.48,Layzner,Man,0,0,0,,只有把他们干掉 我们才有救
Dialogue: 0,0:20:20.48,0:20:22.89,Layzner,Woman,0,0,0,,可是我们也会被卷入的
Dialogue: 0,0:20:22.89,0:20:25.69,Layzner,Man,0,0,0,,只要离这里五百米外就没问题了
Dialogue: 0,0:20:26.44,0:20:28.79,Layzner,Anna,0,0,0,,那么那个人怎么办
Dialogue: 0,0:20:28.79,0:20:31.65,Layzner,Man,0,0,0,,如果把他卷入了那也没办法
Dialogue: 0,0:20:31.65,0:20:32.34,Layzner,Anna,0,0,0,,唉？
Dialogue: 0,0:20:45.93,0:20:51.64,Layzner,Rey,0,0,0,,右脚过热反应 压力部损伤 请更换403B回路
Dialogue: 0,0:20:59.85,0:21:00.98,Layzner,Man,0,0,0,,快一点 比尔
Dialogue: 0,0:21:21.04,0:21:22.70,Layzner,Gosterro,0,0,0,,游戏到此结束了
Dialogue: 0,0:21:22.70,0:21:25.02,Layzner,Com,0,0,0,,前方显示有高能源反应
Dialogue: 0,0:21:25.02,0:21:25.84,Layzner,Gosterro,0,0,0,,什么
Dialogue: 0,0:21:25.84,0:21:26.53,Layzner,Eiji,0,0,0,,什么
Dialogue: 0,0:22:03.32,0:22:05.33,Layzner,Eiji,0,0,0,,回去 不然就
Dialogue: 0,0:22:11.81,0:22:18.32,Layzner,Gosterro,0,0,0,,不能干掉你是因为我太大意 这笔账下次一定跟你要回来
Dialogue: 0,0:22:28.76,0:22:33.05,Layzner,Anna,0,0,0,,联合国的基地渐渐地看不见了
Dialogue: 0,0:22:34.09,0:22:37.65,Layzner,Anna,0,0,0,,我们现在没有容身之所了
Dialogue: 0,0:22:38.74,0:22:44.07,Layzner,Anna,0,0,0,,如果他不保护我们的话我们就我法活下去
Dialogue: 0,0:22:44.07,0:22:46.42,Layzner,Anna,0,0,0,,我们一定要相信他
Dialogue: 0,0:22:47.18,0:22:50.23,Layzner,Anna,0,0,0,,我是这样想的
Dialogue: 0,0:22:56.21,0:23:01.50,LayznerTopMusic,,0,0,0,,Ano hito no yokogao wo
Dialogue: 0,0:23:01.85,0:23:06.26,LayznerTopMusic,,0,0,0,,Damatte mitsumeteireba
Dialogue: 0,0:23:08.18,0:23:13.64,LayznerTopMusic,,0,0,0,,Soba ni iru sore dake de
Dialogue: 0,0:23:13.82,0:23:19.60,LayznerTopMusic,,0,0,0,,nanto nashi ni ochitsukeru no yo
Dialogue: 0,0:23:19.86,0:23:25.61,LayznerTopMusic,,0,0,0,,Donna suteki na kotoba yori
Dialogue: 0,0:23:25.87,0:23:32.82,LayznerTopMusic,,0,0,0,,kono toki tidak totemo suki na no
Dialogue: 0,0:23:33.67,0:23:39.50,LayznerTopMusic,,0,0,0,,go fun dake wagamama o sotto iwasete
Dialogue: 0,0:23:40.13,0:23:45.17,LayznerTopMusic,,0,0,0,,hoka no koto nado kangaenaide
Dialogue: 0,0:22:56.60,0:23:02.40,LayznerMusic,,0,0,0,,那个人的侧脸
Dialogue: 0,0:23:02.40,0:23:06.82,LayznerMusic,,0,0,0,,如果静静地凝视
Dialogue: 0,0:23:08.70,0:23:14.03,LayznerMusic,,0,0,0,,只要他在身旁
Dialogue: 0,0:23:14.03,0:23:20.25,LayznerMusic,,0,0,0,,就会觉得安心
Dialogue: 0,0:23:20.25,0:23:26.46,LayznerMusic,,0,0,0,,比起任何的甜言蜜语
Dialogue: 0,0:23:26.46,0:23:33.43,LayznerMusic,,0,0,0,,我最喜欢的还是此刻
Dialogue: 0,0:23:34.26,0:23:40.10,LayznerMusic,,0,0,0,,只要五分钟就好 让我尽情地说出一切
Dialogue: 0,0:23:40.73,0:23:45.52,LayznerMusic,,0,0,0,,不要再想别的了
Dialogue: 0,0:23:46.02,0:23:50.95,LayznerMusic,,0,0,0,,Don`t say...Don`t say...anymore...
Dialogue: 0,0:23:58.12,0:23:59.30,Layzner,,0,0,0,,他应该一起来的
Dialogue: 0,0:23:59.91,0:24:01.46,Layzner,,0,0,0,,你讲的好像这事跟你无关似的
Dialogue: 0,0:24:02.12,0:24:03.67,Layzner,,0,0,0,,那种人能相信吗
Dialogue: 0,0:24:04.67,0:24:07.80,Layzner,,0,0,0,,下一集 逃出心中的留恋
Dialogue: 0,0:24:07.80,0:24:09.80,LayznerMusic,,0,0,0,,

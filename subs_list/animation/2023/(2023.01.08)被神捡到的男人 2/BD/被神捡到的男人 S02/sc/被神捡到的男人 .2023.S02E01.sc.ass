Dialogue: 0,0:00:10.03,0:00:12.57,UP,,0,0,0,,（龙马·竹林）
Dialogue: 0,0:00:10.76,0:00:12.19,Default,,0,0,0,,我迟到了啊
Dialogue: 0,0:00:13.53,0:00:16.45,Default,,0,0,0,,给艾莉亚莉亚·贾米尔小姐
Dialogue: 0,0:00:14.59,0:00:16.45,UP,,0,0,0,,大排长龙
Dialogue: 0,0:00:17.53,0:00:19.20,Default,,0,0,0,,你过得好吗
Dialogue: 0,0:00:17.95,0:00:19.20,UP,,0,0,0,,欢迎光临
Dialogue: 0,0:00:19.20,0:00:20.80,UP,,0,0,0,,哎呀 店长
Dialogue: 0,0:00:20.07,0:00:22.88,Default,,0,0,0,,我离开贾米尔的各位 自立门户
Dialogue: 0,0:00:21.05,0:00:23.14,UP,,0,0,0,,不好意思让你们久等了
Dialogue: 0,0:00:23.11,0:00:25.53,Default,,0,0,0,,开始在这座基姆尔镇生活
Dialogue: 0,0:00:23.14,0:00:24.61,UP,,0,0,0,,没关系
Dialogue: 0,0:00:25.71,0:00:27.16,Default,,0,0,0,,已经过了一段时间
Dialogue: 0,0:00:25.71,0:00:27.68,UP,,0,0,0,,（Bamboo Forest店员兼保镳 黎琳）
Dialogue: 0,0:00:25.84,0:00:27.17,UP,,0,0,0,,老板 早安
Dialogue: 0,0:00:28.13,0:00:30.64,UP,,0,0,0,,（Bamboo Forest店员兼保镳 费伊）
Dialogue: 0,0:00:28.36,0:00:30.64,Default,,0,0,0,,我在这里的生活很顺遂
Dialogue: 0,0:00:28.38,0:00:30.48,UP,,0,0,0,,老板 早安
Dialogue: 0,0:00:31.07,0:00:32.74,Default,,0,0,0,,大家早
Dialogue: 0,0:00:32.74,0:00:34.70,Default,,0,0,0,,我迟到了
Dialogue: 0,0:00:34.70,0:00:36.11,Default,,0,0,0,,真少见呢
Dialogue: 0,0:00:36.11,0:00:38.99,Default,,0,0,0,,我一直埋头研究史莱姆
Dialogue: 0,0:00:38.99,0:00:42.20,Default,,0,0,0,,不知不觉就搞到这么晚
Dialogue: 0,0:00:46.32,0:00:50.49,UP,,0,0,0,,（Bamboo Forest店员 珍）
Dialogue: 0,0:00:46.57,0:00:47.34,Default,,0,0,0,,好的
Dialogue: 0,0:00:47.45,0:00:50.49,Default,,0,0,0,,您要洗的衣物 我收下了
Dialogue: 0,0:00:50.49,0:00:53.70,UP,,0,0,0,,（Bamboo Forest店员 菲娜）
Dialogue: 0,0:00:51.06,0:00:53.42,Default,,0,0,0,,下一位客人 请过来
Dialogue: 0,0:00:54.99,0:00:56.41,Default,,0,0,0,,变得好干净
Dialogue: 0,0:00:56.41,0:00:57.12,Default,,0,0,0,,是啊
Dialogue: 0,0:00:57.12,0:01:00.67,UP,,0,0,0,,（Bamboo Forest店员 玛利亚）
Dialogue: 0,0:00:57.41,0:01:00.31,Default,,0,0,0,,没有Bamboo Forest洗不掉的污渍
Dialogue: 0,0:01:00.91,0:01:03.11,Default,,0,0,0,,店长 早安
Dialogue: 0,0:01:03.11,0:01:04.70,Default,,0,0,0,,大家早
Dialogue: 0,0:01:04.70,0:01:05.95,Default,,0,0,0,,还忙得过来吗
Dialogue: 0,0:01:05.95,0:01:06.86,Default,,0,0,0,,可以
Dialogue: 0,0:01:06.86,0:01:08.41,Default,,0,0,0,,交给我们吧
Dialogue: 0,0:01:08.41,0:01:09.99,Default,,0,0,0,,谢谢你们
Dialogue: 0,0:01:13.07,0:01:14.41,Default,,0,0,0,,早安
Dialogue: 0,0:01:15.32,0:01:17.93,Default,,0,0,0,,店长 早安
Dialogue: 0,0:01:17.93,0:01:21.85,UP,,0,0,0,,（Bamboo Forest厨师 谢尔玛）
Dialogue: 0,0:01:18.29,0:01:21.55,Default,,0,0,0,,今天也请多多指教
Dialogue: 0,0:01:26.36,0:01:29.20,Default,,0,0,0,,大家都很努力在工作
Dialogue: 0,0:01:27.01,0:01:28.91,UP,,0,0,0,,卡尔菈小姐 卡尔姆先生
Dialogue: 0,0:01:29.20,0:01:30.11,UP,,0,0,0,,早安
Dialogue: 0,0:01:30.11,0:01:31.74,Default,,0,0,0,,为了报答他们的努力
Dialogue: 0,0:01:30.36,0:01:33.20,UP,,0,0,0,,（Bamboo Forest营运助理 卡尔菈）
Dialogue: 0,0:01:30.53,0:01:31.49,UP,,0,0,0,,店长
Dialogue: 0,0:01:31.74,0:01:33.03,Default,,0,0,0,,我想以店长的身分
Dialogue: 0,0:01:31.74,0:01:33.03,UP,,0,0,0,,早安
Dialogue: 0,0:01:33.03,0:01:36.29,Default,,0,0,0,,打造能让员工舒适工作的环境
Dialogue: 0,0:01:33.70,0:01:36.29,UP,,0,0,0,,（Bamboo Forest营运助理 卡尔姆）
Dialogue: 0,0:01:33.87,0:01:36.29,UP,,0,0,0,,今天也请多多指教
Dialogue: 0,0:01:36.99,0:01:38.49,Default,,0,0,0,,大家早啊
Dialogue: 0,0:01:39.53,0:01:41.74,Default,,0,0,0,,今天也好好努力工作吧
Dialogue: 0,0:01:41.74,0:01:42.74,Default,,0,0,0,,是
Dialogue: 0,0:01:49.35,0:01:52.00,OPJP,,0,0,0,,Let's walk! Let's walk!
Dialogue: 0,0:01:52.56,0:01:53.95,OPJP,,0,0,0,,Let's walk the road
Dialogue: 0,0:01:53.95,0:01:55.55,OPJP,,0,0,0,,立ち止まらず
Dialogue: 0,0:01:55.72,0:01:58.29,OPJP,,0,0,0,,Let's walk! Let's walk!
Dialogue: 0,0:01:58.81,0:02:00.26,OPJP,,0,0,0,,Let's walk the road
Dialogue: 0,0:02:00.26,0:02:02.07,OPJP,,0,0,0,,歩きだすよ
Dialogue: 0,0:02:15.65,0:02:21.39,OPJP,,0,0,0,,今はもう前に進んでゆくだけさ
Dialogue: 0,0:02:21.39,0:02:25.64,OPJP,,0,0,0,,絶対振り向いたりしないんだから
Dialogue: 0,0:02:28.23,0:02:31.12,OPJP,,0,0,0,,離れていてもずっと
Dialogue: 0,0:02:31.40,0:02:35.23,OPJP,,0,0,0,,いつだって浮かぶ君のスマイル
Dialogue: 0,0:02:35.50,0:02:39.42,OPJP,,0,0,0,,すぐそばにいる様
Dialogue: 0,0:02:40.34,0:02:43.20,OPJP,,0,0,0,,Everyone has a mission
Dialogue: 0,0:02:43.25,0:02:45.89,OPJP,,0,0,0,,この命を
Dialogue: 0,0:02:46.05,0:02:49.42,OPJP,,0,0,0,,全うするために
Dialogue: 0,0:02:49.52,0:02:52.67,OPJP,,0,0,0,,生まれてきたんだ
Dialogue: 0,0:02:52.97,0:02:55.82,OPJP,,0,0,0,,Everyone has a mission
Dialogue: 0,0:02:55.97,0:03:02.40,OPJP,,0,0,0,,この命が続いてゆく限り
Dialogue: 0,0:03:02.40,0:03:03.58,OPJP,,0,0,0,,Time to go!
Dialogue: 0,0:03:03.79,0:03:06.24,OPJP,,0,0,0,,I got to go, way to go!
Dialogue: 0,0:03:08.15,0:03:10.11,OPJP,,0,0,0,,Way to go!
Dialogue: 0,0:01:49.35,0:01:52.00,OPCN,,0,0,0,,走吧！走吧！
Dialogue: 0,0:01:52.56,0:01:53.95,OPCN,,0,0,0,,顺着这条路走下去
Dialogue: 0,0:01:53.95,0:01:55.55,OPCN,,0,0,0,,不要停下
Dialogue: 0,0:01:55.72,0:01:58.29,OPCN,,0,0,0,,走吧！走吧！
Dialogue: 0,0:01:58.81,0:02:00.26,OPCN,,0,0,0,,顺着这条路走下去
Dialogue: 0,0:02:00.26,0:02:02.07,OPCN,,0,0,0,,出发吧
Dialogue: 0,0:02:15.65,0:02:21.39,OPCN,,0,0,0,,现在除了前进没有别的选择
Dialogue: 0,0:02:21.39,0:02:25.64,OPCN,,0,0,0,,绝对不会再掉头返回了
Dialogue: 0,0:02:28.23,0:02:31.12,OPCN,,0,0,0,,即使彼此相隔得再遥远
Dialogue: 0,0:02:31.40,0:02:35.23,OPCN,,0,0,0,,也永远能回想起你的微笑
Dialogue: 0,0:02:35.50,0:02:39.42,OPCN,,0,0,0,,就好像你未曾离开一样
Dialogue: 0,0:02:40.34,0:02:43.20,OPCN,,0,0,0,,人人都有使命
Dialogue: 0,0:02:43.25,0:02:45.89,OPCN,,0,0,0,,为了让人生
Dialogue: 0,0:02:46.05,0:02:49.42,OPCN,,0,0,0,,变得充实起来
Dialogue: 0,0:02:49.52,0:02:52.67,OPCN,,0,0,0,,一路走到这里
Dialogue: 0,0:02:52.97,0:02:55.82,OPCN,,0,0,0,,人人都有使命
Dialogue: 0,0:02:55.97,0:03:02.40,OPCN,,0,0,0,,只要人生还没结束
Dialogue: 0,0:03:02.40,0:03:03.58,OPCN,,0,0,0,,该走了！
Dialogue: 0,0:03:03.79,0:03:06.24,OPCN,,0,0,0,,我该走了 上路吧！
Dialogue: 0,0:03:08.15,0:03:10.11,OPCN,,0,0,0,,上路吧！
Dialogue: 0,0:03:12.97,0:03:17.97,Default,,0,0,0,,第1集 龙马和新计划
Dialogue: 0,0:03:21.57,0:03:23.57,Default,,0,0,0,,所以说 我希望店长
Dialogue: 0,0:03:24.16,0:03:28.20,Default,,0,0,0,,以后就跟今天差不多的时间\N来上班就行了
Dialogue: 0,0:03:28.74,0:03:30.24,Default,,0,0,0,,为什么啊
Dialogue: 0,0:03:30.24,0:03:33.32,Default,,0,0,0,,你们总是从一大早就很忙
Dialogue: 0,0:03:33.32,0:03:35.95,Default,,0,0,0,,如果店长在开店前来
Dialogue: 0,0:03:35.95,0:03:40.24,Default,,0,0,0,,一定会自己做好开店准备
Dialogue: 0,0:03:40.24,0:03:43.11,Default,,0,0,0,,这样下面的人就没事做了
Dialogue: 0,0:03:43.57,0:03:45.78,Default,,0,0,0,,我们还有新人要培训
Dialogue: 0,0:03:46.49,0:03:47.61,Default,,0,0,0,,店长也趁这个机会
Dialogue: 0,0:03:47.61,0:03:49.78,Default,,0,0,0,,习惯使唤下面的人
Dialogue: 0,0:03:49.78,0:03:53.03,Default,,0,0,0,,把工作交给部下处理吧
Dialogue: 0,0:03:53.03,0:03:56.20,Default,,0,0,0,,原来我抢了大家的工作啊
Dialogue: 0,0:03:56.20,0:03:57.74,Default,,0,0,0,,知道了
Dialogue: 0,0:03:57.74,0:03:59.95,Default,,0,0,0,,就这么办吧
Dialogue: 0,0:04:00.41,0:04:03.61,Default,,0,0,0,,然后我还有一个建议
Dialogue: 0,0:04:03.61,0:04:04.70,Default,,0,0,0,,请说
Dialogue: 0,0:04:04.70,0:04:06.66,Default,,0,0,0,,关于二号店的事…
Dialogue: 0,0:04:12.99,0:04:14.61,Default,,0,0,0,,发生了什么事
Dialogue: 0,0:04:14.61,0:04:16.57,Default,,0,0,0,,稍等一下喔
Dialogue: 0,0:04:16.57,0:04:18.24,Default,,0,0,0,,我马上就绑好
Dialogue: 0,0:04:19.45,0:04:21.86,Default,,0,0,0,,他们做了什么
Dialogue: 0,0:04:21.86,0:04:25.41,Default,,0,0,0,,是跑来抱怨污渍没洗干净的流氓
Dialogue: 0,0:04:26.36,0:04:29.45,Default,,0,0,0,,可是我刚刚听到爆笑声
Dialogue: 0,0:04:29.45,0:04:30.61,Default,,0,0,0,,那是因为…
Dialogue: 0,0:04:31.45,0:04:35.07,Default,,0,0,0,,混帐 根本完全没洗干净嘛
Dialogue: 0,0:04:35.07,0:04:36.53,Default,,0,0,0,,你们看
Dialogue: 0,0:04:36.53,0:04:38.32,Default,,0,0,0,,这些污渍…
Dialogue: 0,0:04:39.16,0:04:40.78,Default,,0,0,0,,好干净
Dialogue: 0,0:04:40.78,0:04:41.86,Default,,0,0,0,,你这家伙
Dialogue: 0,0:04:41.86,0:04:44.82,Default,,0,0,0,,我不是叫你要弄上\N绝对洗不掉的污渍吗
Dialogue: 0,0:04:44.82,0:04:46.61,Default,,0,0,0,,我有弄啊
Dialogue: 0,0:04:48.24,0:04:49.53,Default,,0,0,0,,真蠢
Dialogue: 0,0:04:49.53,0:04:50.61,Default,,0,0,0,,什么
Dialogue: 0,0:04:50.61,0:04:52.16,Default,,0,0,0,,你骂谁蠢啊
Dialogue: 0,0:04:55.82,0:04:57.74,Default,,0,0,0,,我把他们送去交给警备队
Dialogue: 0,0:04:57.74,0:04:58.70,UP,,0,0,0,,可恶
Dialogue: 0,0:04:57.74,0:05:00.32,Default,,0,0,0,,事情就是这样
Dialogue: 0,0:04:58.70,0:05:00.32,UP,,0,0,0,,给我记住
Dialogue: 0,0:05:00.32,0:05:01.41,Default,,0,0,0,,这样啊
Dialogue: 0,0:05:01.41,0:05:03.20,Default,,0,0,0,,真是伤脑筋
Dialogue: 0,0:05:03.20,0:05:07.20,Default,,0,0,0,,所以我才会说\N没有Bamboo Forest洗不掉的污渍
Dialogue: 0,0:05:08.32,0:05:12.41,Default,,0,0,0,,店里的防盗措施\N也必须重新思考才行
Dialogue: 0,0:05:13.07,0:05:14.70,Default,,0,0,0,,玻璃…
Dialogue: 0,0:05:16.57,0:05:17.70,Default,,0,0,0,,卡尔菈小姐
Dialogue: 0,0:05:17.70,0:05:19.03,Default,,0,0,0,,什么事
Dialogue: 0,0:05:19.03,0:05:21.95,Default,,0,0,0,,我有一件想尝试的事情
Dialogue: 0,0:05:21.95,0:05:23.49,Default,,0,0,0,,所以要回去废弃坑道
Dialogue: 0,0:05:30.78,0:05:31.78,Default,,0,0,0,,首先
Dialogue: 0,0:05:31.78,0:05:35.07,Default,,0,0,0,,让粘液史莱姆吐出硬化粘液
Dialogue: 0,0:05:40.70,0:05:43.11,Default,,0,0,0,,用分离魔法阵去除水分
Dialogue: 0,0:05:47.28,0:05:49.61,Default,,0,0,0,,然后再加入硬化粘液
Dialogue: 0,0:05:52.03,0:05:54.95,Default,,0,0,0,,用混合魔法阵混合后
Dialogue: 0,0:06:00.41,0:06:02.45,Default,,0,0,0,,再用分离魔法阵去除水分
Dialogue: 0,0:06:05.66,0:06:07.82,Default,,0,0,0,,只要这样反复做好几遍
Dialogue: 0,0:06:07.82,0:06:10.99,Default,,0,0,0,,就能让粘液史莱姆的\N硬化粘液逐渐浓缩
Dialogue: 0,0:06:16.95,0:06:18.99,Default,,0,0,0,,把它变成板状
Dialogue: 0,0:06:28.61,0:06:31.16,Default,,0,0,0,,用强化魔法敲击也不会碎裂
Dialogue: 0,0:06:31.16,0:06:32.49,Default,,0,0,0,,也没有模糊之处
Dialogue: 0,0:06:32.49,0:06:34.99,Default,,0,0,0,,当成窗户玻璃来用完全没问题
Dialogue: 0,0:06:35.57,0:06:38.61,Default,,0,0,0,,如此坚固也很适合防盗
Dialogue: 0,0:06:38.61,0:06:41.53,Default,,0,0,0,,这样就能保护员工和客人了
Dialogue: 0,0:06:42.41,0:06:46.20,Default,,0,0,0,,各位 我想多做一些这个
Dialogue: 0,0:06:46.20,0:06:47.70,Default,,0,0,0,,能麻烦你们吗
Dialogue: 0,0:06:54.45,0:06:56.74,Default,,0,0,0,,这样子应该就够了吧
Dialogue: 0,0:07:03.16,0:07:05.28,Default,,0,0,0,,今天就这样先去睡吧
Dialogue: 0,0:07:07.82,0:07:10.20,Default,,0,0,0,,我没看过这个史莱姆
Dialogue: 0,0:07:11.95,0:07:13.20,Default,,0,0,0,,鉴定
Dialogue: 0,0:07:16.11,0:07:18.61,Default,,0,0,0,,药物史莱姆
Dialogue: 0,0:07:18.61,0:07:21.41,Default,,0,0,0,,我不记得有跟它订下契约
Dialogue: 0,0:07:21.41,0:07:23.32,Default,,0,0,0,,难道是进化变成的吗
Dialogue: 0,0:07:24.20,0:07:26.16,Default,,0,0,0,,技能里有枪术
Dialogue: 0,0:07:26.78,0:07:27.70,Default,,0,0,0,,也就是说
Dialogue: 0,0:07:27.70,0:07:29.82,Default,,0,0,0,,它原本是毒物史莱姆吗
Dialogue: 0,0:07:30.61,0:07:34.24,Default,,0,0,0,,可是为什么毒物史莱姆\N会变成药物史莱姆
Dialogue: 0,0:07:38.49,0:07:42.11,Default,,0,0,0,,昨天我不小心弄掉了解毒剂的瓶子
Dialogue: 0,0:07:46.11,0:07:47.07,Default,,0,0,0,,糟了
Dialogue: 0,0:07:47.07,0:07:48.49,Default,,0,0,0,,抹布…
Dialogue: 0,0:07:56.49,0:07:57.36,Default,,0,0,0,,奇怪
Dialogue: 0,0:07:59.41,0:08:03.41,Default,,0,0,0,,我一直以为是清洁史莱姆\N帮忙打扫干净的
Dialogue: 0,0:08:04.20,0:08:05.91,Default,,0,0,0,,难道是…
Dialogue: 0,0:08:08.70,0:08:10.78,Default,,0,0,0,,它们在喝解毒剂
Dialogue: 0,0:08:10.78,0:08:13.32,Default,,0,0,0,,毒物史莱姆进化之后
Dialogue: 0,0:08:13.32,0:08:15.41,Default,,0,0,0,,果然会变成药物史莱姆啊
Dialogue: 0,0:08:18.16,0:08:19.45,Default,,0,0,0,,趁这段时间…
Dialogue: 0,0:08:22.70,0:08:25.36,Default,,0,0,0,,让我看看你会做哪些药物吧
Dialogue: 0,0:08:32.82,0:08:34.32,Default,,0,0,0,,种类真多呢
Dialogue: 0,0:08:34.86,0:08:36.24,Default,,0,0,0,,鉴定
Dialogue: 0,0:08:37.95,0:08:39.66,Default,,0,0,0,,伤药
Dialogue: 0,0:08:39.66,0:08:41.16,Default,,0,0,0,,止血剂
Dialogue: 0,0:08:41.16,0:08:42.45,Default,,0,0,0,,解毒剂
Dialogue: 0,0:08:42.45,0:08:44.49,Default,,0,0,0,,速效性毒药
Dialogue: 0,0:08:44.49,0:08:46.49,Default,,0,0,0,,迟效性毒药
Dialogue: 0,0:08:46.49,0:08:48.78,Default,,0,0,0,,速效性麻醉毒药
Dialogue: 0,0:08:48.78,0:08:51.16,Default,,0,0,0,,迟效性麻醉毒药
Dialogue: 0,0:08:51.16,0:08:52.95,Default,,0,0,0,,抗菌药
Dialogue: 0,0:08:54.49,0:08:55.99,Default,,0,0,0,,种类好广泛
Dialogue: 0,0:08:56.36,0:08:57.70,Default,,0,0,0,,果然不论是毒药或药物
Dialogue: 0,0:08:57.70,0:08:59.86,Default,,0,0,0,,都可以变成液体药物吗
Dialogue: 0,0:09:00.49,0:09:02.78,Default,,0,0,0,,这个抗菌药是什么
Dialogue: 0,0:09:06.70,0:09:09.49,Default,,0,0,0,,具有强烈抗菌效果的液体
Dialogue: 0,0:09:09.49,0:09:12.24,Default,,0,0,0,,可以消灭细菌和病毒
Dialogue: 0,0:09:12.24,0:09:14.49,Default,,0,0,0,,对人体无害
Dialogue: 0,0:09:14.49,0:09:16.41,Default,,0,0,0,,是消毒药啊
Dialogue: 0,0:09:16.41,0:09:18.66,Default,,0,0,0,,这个也许能派上用场
Dialogue: 0,0:09:19.20,0:09:20.57,Default,,0,0,0,,我想…
Dialogue: 0,0:09:20.57,0:09:21.78,Default,,0,0,0,,把自己能做的事情
Dialogue: 0,0:09:21.78,0:09:23.61,Default,,0,0,0,,一件一件慢慢完成
Dialogue: 0,0:09:24.53,0:09:26.74,Default,,0,0,0,,别让邀请我一起同行的
Dialogue: 0,0:09:26.74,0:09:30.74,Default,,0,0,0,,贾米尔公爵家的人们替我操心
Dialogue: 0,0:09:32.11,0:09:33.70,Default,,0,0,0,,对了
Dialogue: 0,0:09:33.70,0:09:35.74,Default,,0,0,0,,最近因为太仓促了
Dialogue: 0,0:09:35.74,0:09:38.74,Default,,0,0,0,,都没跟众神们打招呼
Dialogue: 0,0:09:38.74,0:09:40.82,Default,,0,0,0,,明天去一趟教会吧
Dialogue: 0,0:09:42.86,0:09:47.11,Default,,0,0,0,,他又在做有趣的事了
Dialogue: 0,0:09:49.32,0:09:52.10,Default,,0,0,0,,接下来也请多多指教
Dialogue: 0,0:09:54.24,0:09:57.74,Default,,0,0,0,,我每天都在想龙马先生喔
Dialogue: 0,0:10:01.24,0:10:02.53,Default,,0,0,0,,欢迎光临
Dialogue: 0,0:10:02.53,0:10:04.82,Default,,0,0,0,,你今天来这里有什么事
Dialogue: 0,0:10:04.82,0:10:06.07,Default,,0,0,0,,我是来祈祷的
Dialogue: 0,0:10:06.07,0:10:07.61,Default,,0,0,0,,原来如此
Dialogue: 0,0:10:07.61,0:10:09.74,Default,,0,0,0,,那么请进吧
Dialogue: 0,0:10:09.74,0:10:11.49,Default,,0,0,0,,谢谢你
Dialogue: 0,0:10:21.49,0:10:22.78,Default,,0,0,0,,奇怪
Dialogue: 0,0:10:22.78,0:10:25.86,Default,,0,0,0,,我还以为会像平常那样\N前往神的世界
Dialogue: 0,0:10:25.86,0:10:27.28,Default,,0,0,0,,结果什么都没发生
Dialogue: 0,0:10:27.28,0:10:28.24,Default,,0,0,0,,也是啦
Dialogue: 0,0:10:28.24,0:10:30.82,Default,,0,0,0,,每次都去得成才奇怪吧
Dialogue: 0,0:10:37.41,0:10:38.82,Default,,0,0,0,,这里是…
Dialogue: 0,0:10:38.82,0:10:40.57,Default,,0,0,0,,跟往常一样啊
Dialogue: 0,0:10:40.57,0:10:42.99,Default,,0,0,0,,不过比往常延迟了一些
Dialogue: 0,0:10:42.99,0:10:44.32,Default,,0,0,0,,抱歉啦
Dialogue: 0,0:10:44.32,0:10:46.70,Default,,0,0,0,,因为我很少使用这股力量
Dialogue: 0,0:10:46.70,0:10:48.28,Default,,0,0,0,,所以花了一点时间
Dialogue: 0,0:10:50.41,0:10:52.78,Default,,0,0,0,,是第一次见到的对象
Dialogue: 0,0:10:52.78,0:10:55.07,Default,,0,0,0,,既然他在这个空间就代表…
Dialogue: 0,0:10:55.78,0:10:58.11,Default,,0,0,0,,初次见面您好
Dialogue: 0,0:10:58.11,0:11:01.36,Default,,0,0,0,,因为我开始独自在这个城镇生活
Dialogue: 0,0:11:01.36,0:11:03.45,Default,,0,0,0,,所以前来打声招呼
Dialogue: 0,0:11:03.45,0:11:04.16,Default,,0,0,0,,你好
Dialogue: 0,0:11:04.16,0:11:07.32,Default,,0,0,0,,我是技术与职人之神 铁昆
Dialogue: 0,0:11:07.32,0:11:08.82,Default,,0,0,0,,你就这么叫我吧
Dialogue: 0,0:11:08.82,0:11:11.70,Default,,0,0,0,,另外 跟我讲话用不着客气
Dialogue: 0,0:11:11.70,0:11:15.32,Default,,0,0,0,,只要我想 也能窥看你的内心
Dialogue: 0,0:11:15.32,0:11:17.41,Default,,0,0,0,,在我面前掩饰根本没有意义
Dialogue: 0,0:11:17.41,0:11:19.82,Default,,0,0,0,,我也不喜欢拘泥形式
Dialogue: 0,0:11:19.82,0:11:21.36,Default,,0,0,0,,你坐吧
Dialogue: 0,0:11:22.36,0:11:23.49,Default,,0,0,0,,那我就随意一点
Dialogue: 0,0:11:24.03,0:11:25.32,Default,,0,0,0,,初次见面你好
Dialogue: 0,0:11:25.32,0:11:27.45,Default,,0,0,0,,我是竹林龙马
Dialogue: 0,0:11:28.36,0:11:29.66,Default,,0,0,0,,那些…
Dialogue: 0,0:11:31.07,0:11:32.78,Default,,0,0,0,,是我做的
Dialogue: 0,0:11:32.78,0:11:33.78,Default,,0,0,0,,对
Dialogue: 0,0:11:33.78,0:11:36.16,Default,,0,0,0,,因为我想仔细地看看
Dialogue: 0,0:11:36.16,0:11:38.99,Default,,0,0,0,,所以就自己仿造了
Dialogue: 0,0:11:38.99,0:11:40.95,Default,,0,0,0,,是类似复制品的东西啊
Dialogue: 0,0:11:40.95,0:11:43.86,Default,,0,0,0,,你是从地球来的人类吧
Dialogue: 0,0:11:43.86,0:11:44.95,Default,,0,0,0,,对
Dialogue: 0,0:11:46.20,0:11:49.95,Default,,0,0,0,,我原本在俗称的黑心企业上班
Dialogue: 0,0:11:49.95,0:11:52.32,Default,,0,0,0,,因为在睡觉时打喷嚏的关系
Dialogue: 0,0:11:52.32,0:11:54.99,Default,,0,0,0,,转眼间就死了
Dialogue: 0,0:11:54.99,0:11:57.07,Default,,0,0,0,,之后被众神们带走
Dialogue: 0,0:11:57.07,0:11:58.66,Default,,0,0,0,,变成少年的模样
Dialogue: 0,0:11:58.66,0:12:01.03,Default,,0,0,0,,转生到这个世界
Dialogue: 0,0:12:01.82,0:12:04.20,Default,,0,0,0,,听说是这样
Dialogue: 0,0:12:04.20,0:12:07.78,Default,,0,0,0,,不过 我只听过你的事迹
Dialogue: 0,0:12:07.78,0:12:10.82,Default,,0,0,0,,对异世界的技术深感兴趣
Dialogue: 0,0:12:10.82,0:12:13.20,Default,,0,0,0,,你说的技术是指做人偶吗
Dialogue: 0,0:12:13.20,0:12:14.74,Default,,0,0,0,,以不同的文化
Dialogue: 0,0:12:14.74,0:12:17.16,Default,,0,0,0,,未知的技术手法做出的东西
Dialogue: 0,0:12:17.16,0:12:20.61,Default,,0,0,0,,让我这个技术与职人之神\N产生了兴趣
Dialogue: 0,0:12:20.61,0:12:23.32,Default,,0,0,0,,但是因为我是技术之神
Dialogue: 0,0:12:23.32,0:12:27.53,Default,,0,0,0,,对这个世界的技术无所不知
Dialogue: 0,0:12:27.95,0:12:31.91,Default,,0,0,0,,也就是说你对异世界的技术\N还有不了解的地方
Dialogue: 0,0:12:31.91,0:12:32.99,Default,,0,0,0,,所以觉得很稀奇
Dialogue: 0,0:12:32.99,0:12:34.49,Default,,0,0,0,,就是这样
Dialogue: 0,0:12:34.49,0:12:36.20,Default,,0,0,0,,而且这个人偶
Dialogue: 0,0:12:36.20,0:12:40.49,Default,,0,0,0,,以作品而言\N一看就知道作工很精细
Dialogue: 0,0:12:40.49,0:12:42.53,Default,,0,0,0,,这好像不是你的本行
Dialogue: 0,0:12:42.53,0:12:45.95,Default,,0,0,0,,但你应该长时间都在做这件事吧
Dialogue: 0,0:12:46.66,0:12:49.41,Default,,0,0,0,,因为我的兴趣是做手工艺
Dialogue: 0,0:12:49.41,0:12:51.24,Default,,0,0,0,,以现实层面来说
Dialogue: 0,0:12:51.24,0:12:52.70,Default,,0,0,0,,也有很多价格不错
Dialogue: 0,0:12:52.70,0:12:55.57,Default,,0,0,0,,以及提出高额报酬的委托
Dialogue: 0,0:12:55.57,0:12:56.95,Default,,0,0,0,,既然收了人家的钱
Dialogue: 0,0:12:56.95,0:12:58.20,Default,,0,0,0,,自然不能偷工减料
Dialogue: 0,0:12:58.20,0:13:00.99,Default,,0,0,0,,没错 这是当然的
Dialogue: 0,0:13:00.99,0:13:04.49,Default,,0,0,0,,但世界上有很多人不是这样
Dialogue: 0,0:13:04.49,0:13:05.99,Default,,0,0,0,,作为职人之神
Dialogue: 0,0:13:05.99,0:13:09.20,Default,,0,0,0,,我不讨厌做事细心的人
Dialogue: 0,0:13:09.20,0:13:10.74,Default,,0,0,0,,原来如此
Dialogue: 0,0:13:10.74,0:13:13.78,Default,,0,0,0,,对了 今天只有你在这里吗
Dialogue: 0,0:13:13.78,0:13:14.66,Default,,0,0,0,,对
Dialogue: 0,0:13:14.66,0:13:18.24,Default,,0,0,0,,因为其他人都各自跑去偷闲了
Dialogue: 0,0:13:18.86,0:13:22.99,Default,,0,0,0,,战争之神 魔法之神 大地之神
Dialogue: 0,0:13:22.99,0:13:25.61,Default,,0,0,0,,在你眼中 他们也许都是洁白的神
Dialogue: 0,0:13:25.61,0:13:28.61,Default,,0,0,0,,但他们各自都有喜欢的去处
Dialogue: 0,0:13:28.61,0:13:30.16,Default,,0,0,0,,他们会在那里
Dialogue: 0,0:13:30.16,0:13:32.78,Default,,0,0,0,,建造你们人类所说的家居住
Dialogue: 0,0:13:33.32,0:13:35.78,Default,,0,0,0,,原来如此 我都不知道
Dialogue: 0,0:13:36.41,0:13:40.11,Default,,0,0,0,,也就是说 这里是你家啰
Dialogue: 0,0:13:40.11,0:13:43.03,Default,,0,0,0,,不是 我没有家
Dialogue: 0,0:13:43.03,0:13:46.03,Default,,0,0,0,,因为我是技术与职人之神
Dialogue: 0,0:13:46.03,0:13:48.91,Default,,0,0,0,,世界各地都有技术与职人
Dialogue: 0,0:13:48.91,0:13:51.07,Default,,0,0,0,,他们存在于各个地方
Dialogue: 0,0:13:51.07,0:13:53.61,Default,,0,0,0,,我会不时到各地去看看
Dialogue: 0,0:13:53.61,0:13:57.07,Default,,0,0,0,,这里也跟你们生活的世界相连
Dialogue: 0,0:13:57.95,0:14:01.74,Default,,0,0,0,,详细的解说 你就去问别人吧
Dialogue: 0,0:14:01.74,0:14:04.16,Default,,0,0,0,,因为我没办法好好解说
Dialogue: 0,0:14:04.16,0:14:06.41,Default,,0,0,0,,换作是费诺贝利亚
Dialogue: 0,0:14:06.41,0:14:08.57,Default,,0,0,0,,也许就能够好好解说了
Dialogue: 0,0:14:09.11,0:14:10.86,Default,,0,0,0,,费诺贝利亚
Dialogue: 0,0:14:10.86,0:14:12.70,Default,,0,0,0,,我没听过这个名字
Dialogue: 0,0:14:12.70,0:14:15.32,Default,,0,0,0,,是喔 你不认识他吗
Dialogue: 0,0:14:15.32,0:14:16.74,Default,,0,0,0,,他是魔法之神
Dialogue: 0,0:14:17.61,0:14:21.03,Default,,0,0,0,,魔法与学问之神 费诺贝利亚
Dialogue: 0,0:14:21.03,0:14:22.86,Default,,0,0,0,,虽然他整天关在自己的领域
Dialogue: 0,0:14:22.86,0:14:26.11,Default,,0,0,0,,不知道在做些什么
Dialogue: 0,0:14:26.11,0:14:30.49,Default,,0,0,0,,但他的知识最渊博 也很会解说
Dialogue: 0,0:14:30.49,0:14:32.99,Default,,0,0,0,,不过他是连同样是神的我
Dialogue: 0,0:14:32.99,0:14:35.99,Default,,0,0,0,,都很难见到的家伙
Dialogue: 0,0:14:36.45,0:14:37.95,Default,,0,0,0,,我也不知道你有生之年
Dialogue: 0,0:14:37.95,0:14:40.95,Default,,0,0,0,,有没有机会见到他
Dialogue: 0,0:14:40.95,0:14:43.61,Default,,0,0,0,,有好多各式各样的神呢
Dialogue: 0,0:14:43.61,0:14:44.82,Default,,0,0,0,,是啊
Dialogue: 0,0:14:45.57,0:14:47.70,Default,,0,0,0,,时间好像到了
Dialogue: 0,0:14:47.70,0:14:50.28,Default,,0,0,0,,我还想再跟你聊一下呢
Dialogue: 0,0:14:50.28,0:14:51.53,Default,,0,0,0,,我会再来的
Dialogue: 0,0:14:51.53,0:14:54.49,Default,,0,0,0,,好 我会等你来的
Dialogue: 0,0:15:02.99,0:15:04.41,Default,,0,0,0,,谢谢你
Dialogue: 0,0:15:04.41,0:15:05.82,Default,,0,0,0,,这是我该说的
Dialogue: 0,0:15:05.82,0:15:08.61,Default,,0,0,0,,谢谢你捐款给我们
Dialogue: 0,0:15:08.61,0:15:10.36,Default,,0,0,0,,哪里 我会再来的
Dialogue: 0,0:15:10.95,0:15:13.70,Default,,0,0,0,,差不多可以去店里了吧
Dialogue: 0,0:15:17.66,0:15:20.28,Default,,0,0,0,,我今天稍微晚点来上班
Dialogue: 0,0:15:20.28,0:15:22.28,Default,,0,0,0,,没有出什么问题吧
Dialogue: 0,0:15:22.28,0:15:24.16,Default,,0,0,0,,完全没有喔
Dialogue: 0,0:15:24.16,0:15:28.20,Default,,0,0,0,,新人们工作也上手了许多
Dialogue: 0,0:15:28.20,0:15:29.66,Default,,0,0,0,,这样啊
Dialogue: 0,0:15:29.66,0:15:30.82,Default,,0,0,0,,真是太好了
Dialogue: 0,0:15:30.82,0:15:32.20,Default,,0,0,0,,然后呢 老板
Dialogue: 0,0:15:32.20,0:15:35.16,Default,,0,0,0,,听说你有事找我们
Dialogue: 0,0:15:36.53,0:15:40.41,Default,,0,0,0,,对 其实是关于这家店的窗户
Dialogue: 0,0:15:40.41,0:15:43.66,Default,,0,0,0,,那个 只要把它打破闯入
Dialogue: 0,0:15:43.66,0:15:45.91,Default,,0,0,0,,轻轻松松就能进来了吧
Dialogue: 0,0:15:45.91,0:15:46.91,Default,,0,0,0,,是啊
Dialogue: 0,0:15:46.91,0:15:48.82,Default,,0,0,0,,只要准备一把槌子或斧头
Dialogue: 0,0:15:48.82,0:15:50.28,Default,,0,0,0,,轻松就能闯入
Dialogue: 0,0:15:50.28,0:15:52.91,Default,,0,0,0,,我们有严加戒备这个部分
Dialogue: 0,0:15:52.91,0:15:55.20,Default,,0,0,0,,一直以来谢谢你们了
Dialogue: 0,0:15:55.20,0:15:57.78,Default,,0,0,0,,因此我想了一个办法
Dialogue: 0,0:15:57.78,0:16:00.03,Default,,0,0,0,,只要让窗户不会被破坏
Dialogue: 0,0:16:00.03,0:16:02.20,Default,,0,0,0,,也许就能减轻劳力负担
Dialogue: 0,0:16:04.74,0:16:08.61,Default,,0,0,0,,这是我想用来代替窗户玻璃的东西
Dialogue: 0,0:16:08.61,0:16:10.57,Default,,0,0,0,,相当坚固喔
Dialogue: 0,0:16:15.28,0:16:16.16,Default,,0,0,0,,老板
Dialogue: 0,0:16:16.16,0:16:19.16,Default,,0,0,0,,我也可以试着敲击它吗
Dialogue: 0,0:16:19.82,0:16:21.82,Default,,0,0,0,,当然可以 请吧
Dialogue: 0,0:16:21.82,0:16:23.24,Default,,0,0,0,,我还有其他备品
Dialogue: 0,0:16:23.24,0:16:24.74,Default,,0,0,0,,就算弄坏了也没关系
Dialogue: 0,0:16:24.74,0:16:26.45,Default,,0,0,0,,我帮你拿着吧
Dialogue: 0,0:16:32.86,0:16:33.82,Default,,0,0,0,,我要上啰
Dialogue: 0,0:16:36.49,0:16:37.66,Default,,0,0,0,,好厉害
Dialogue: 0,0:16:37.66,0:16:39.41,Default,,0,0,0,,完全不会坏呢
Dialogue: 0,0:16:39.41,0:16:41.74,Default,,0,0,0,,那是店长做的吗
Dialogue: 0,0:16:42.07,0:16:42.91,Default,,0,0,0,,对
Dialogue: 0,0:16:42.91,0:16:45.99,Default,,0,0,0,,这也许能成为热卖的商品
Dialogue: 0,0:16:47.41,0:16:52.11,Default,,0,0,0,,很抱歉 我不打算贩卖这个
Dialogue: 0,0:16:52.11,0:16:54.20,Default,,0,0,0,,因为生产量很少
Dialogue: 0,0:16:54.41,0:16:55.99,Default,,0,0,0,,这样啊
Dialogue: 0,0:16:55.99,0:16:57.86,Default,,0,0,0,,恕我多嘴了
Dialogue: 0,0:16:57.86,0:16:58.74,Default,,0,0,0,,黎琳
Dialogue: 0,0:16:58.74,0:17:01.36,Default,,0,0,0,,你用强化魔法试着攻击看看
Dialogue: 0,0:17:01.36,0:17:02.95,Default,,0,0,0,,对喔
Dialogue: 0,0:17:11.41,0:17:13.57,Default,,0,0,0,,的确很坚固
Dialogue: 0,0:17:13.57,0:17:15.49,Default,,0,0,0,,只要把它装在一楼的窗户
Dialogue: 0,0:17:15.49,0:17:18.95,Default,,0,0,0,,入侵者一定很难闯进来
Dialogue: 0,0:17:19.53,0:17:23.07,Default,,0,0,0,,但是 如果我们被逼入绝境
Dialogue: 0,0:17:23.07,0:17:26.61,Default,,0,0,0,,也没办法迅速打破窗户逃走耶
Dialogue: 0,0:17:26.61,0:17:30.16,Default,,0,0,0,,对喔 的确有这项缺点
Dialogue: 0,0:17:30.16,0:17:31.74,Default,,0,0,0,,我都没注意到
Dialogue: 0,0:17:31.74,0:17:34.03,Default,,0,0,0,,不过用来防止敌人闯入
Dialogue: 0,0:17:34.03,0:17:35.70,Default,,0,0,0,,这是很棒的东西
Dialogue: 0,0:17:35.70,0:17:37.16,Default,,0,0,0,,我们就换掉几扇窗户
Dialogue: 0,0:17:37.16,0:17:39.41,Default,,0,0,0,,减少能让人偷偷潜入的地方
Dialogue: 0,0:17:39.41,0:17:41.20,Default,,0,0,0,,这也是一个办法
Dialogue: 0,0:17:41.20,0:17:42.82,Default,,0,0,0,,只要一开始就知道缺点
Dialogue: 0,0:17:42.82,0:17:44.45,Default,,0,0,0,,总会有办法应付
Dialogue: 0,0:17:44.45,0:17:45.78,Default,,0,0,0,,我懂了
Dialogue: 0,0:17:45.78,0:17:48.82,Default,,0,0,0,,那么店里的窗户就换成它
Dialogue: 0,0:17:48.82,0:17:49.86,Default,,0,0,0,,这样可以吗
Dialogue: 0,0:17:49.86,0:17:51.32,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:17:52.16,0:17:54.66,Default,,0,0,0,,那我马上来换
Dialogue: 0,0:17:54.66,0:17:55.61,Default,,0,0,0,,店长
Dialogue: 0,0:17:55.61,0:18:00.16,Default,,0,0,0,,你等一下不是与摩根商会的\N赛尔吉先生有约吗
Dialogue: 0,0:18:00.74,0:18:02.11,Default,,0,0,0,,我都忘了
Dialogue: 0,0:18:02.11,0:18:04.24,Default,,0,0,0,,这件事就交给我们做吧
Dialogue: 0,0:18:05.28,0:18:07.20,Default,,0,0,0,,不好意思 麻烦你们了
Dialogue: 0,0:18:07.86,0:18:11.32,Default,,0,0,0,,店长 我昨天本来想跟你说件事
Dialogue: 0,0:18:11.32,0:18:12.36,Default,,0,0,0,,什么事
Dialogue: 0,0:18:12.36,0:18:15.45,Default,,0,0,0,,在别的城镇成立二号店的建议
Dialogue: 0,0:18:15.99,0:18:17.11,Default,,0,0,0,,这件事啊
Dialogue: 0,0:18:17.11,0:18:19.99,Default,,0,0,0,,我觉得有点太快了
Dialogue: 0,0:18:19.99,0:18:21.74,Default,,0,0,0,,会吗
Dialogue: 0,0:18:21.74,0:18:23.78,Default,,0,0,0,,反正店里的人手变多了
Dialogue: 0,0:18:23.78,0:18:27.07,Default,,0,0,0,,能否请你重新考虑看看呢
Dialogue: 0,0:18:27.07,0:18:28.49,Default,,0,0,0,,知道了
Dialogue: 0,0:18:28.49,0:18:29.91,Default,,0,0,0,,我会考虑看看
Dialogue: 0,0:18:32.32,0:18:36.53,Default,,0,0,0,,我才刚在这座基姆尔镇\N成立自己的店
Dialogue: 0,0:18:36.53,0:18:38.95,Default,,0,0,0,,现在就要去别的城镇开另一家店
Dialogue: 0,0:18:38.95,0:18:41.28,Default,,0,0,0,,我觉得有点太快了
Dialogue: 0,0:18:42.41,0:18:44.24,Default,,0,0,0,,我想好好重视
Dialogue: 0,0:18:44.24,0:18:47.61,Default,,0,0,0,,在这座城镇建立的人脉
Dialogue: 0,0:18:47.99,0:18:51.57,Default,,0,0,0,,欢迎光临 龙马先生
Dialogue: 0,0:18:51.57,0:18:53.07,Default,,0,0,0,,你好 赛尔吉先生
Dialogue: 0,0:18:53.78,0:18:56.20,Default,,0,0,0,,我今天是来买私人用的物品
Dialogue: 0,0:18:56.20,0:18:57.86,Default,,0,0,0,,这样啊
Dialogue: 0,0:18:57.86,0:18:59.66,Default,,0,0,0,,你想买什么
Dialogue: 0,0:18:59.66,0:19:03.49,Default,,0,0,0,,我想大量采购用来装药的药瓶
Dialogue: 0,0:19:03.49,0:19:05.82,Default,,0,0,0,,大量采购吗
Dialogue: 0,0:19:05.82,0:19:07.11,Default,,0,0,0,,对
Dialogue: 0,0:19:07.11,0:19:08.66,Default,,0,0,0,,因为我多了空闲时间
Dialogue: 0,0:19:08.66,0:19:10.82,Default,,0,0,0,,所以想来做些药物
Dialogue: 0,0:19:10.82,0:19:12.49,Default,,0,0,0,,因为从事冒险者这一行
Dialogue: 0,0:19:12.49,0:19:14.32,Default,,0,0,0,,时常有受伤的危险
Dialogue: 0,0:19:14.32,0:19:15.82,Default,,0,0,0,,所以我想防范未然
Dialogue: 0,0:19:16.74,0:19:18.36,Default,,0,0,0,,原来如此
Dialogue: 0,0:19:18.36,0:19:21.95,Default,,0,0,0,,不过要是你想大量采购药瓶
Dialogue: 0,0:19:21.95,0:19:25.20,Default,,0,0,0,,可以到商业公会登记为药商
Dialogue: 0,0:19:25.20,0:19:28.61,Default,,0,0,0,,透过商业公会向中盘商购买
Dialogue: 0,0:19:28.61,0:19:30.66,Default,,0,0,0,,价格会便宜很多喔
Dialogue: 0,0:19:32.24,0:19:34.11,Default,,0,0,0,,原来如此
Dialogue: 0,0:19:34.11,0:19:37.61,Default,,0,0,0,,你是为了买药瓶才来这里的吗
Dialogue: 0,0:19:38.16,0:19:39.28,Default,,0,0,0,,对
Dialogue: 0,0:19:39.28,0:19:42.78,Default,,0,0,0,,赛尔吉先生建议我来这里会比较好
Dialogue: 0,0:19:42.78,0:19:46.32,Default,,0,0,0,,那么你的技术怎么样呢
Dialogue: 0,0:19:46.32,0:19:48.41,Default,,0,0,0,,对喔
Dialogue: 0,0:19:50.24,0:19:52.03,Default,,0,0,0,,这是解毒药
Dialogue: 0,0:19:52.03,0:19:53.95,Default,,0,0,0,,这是消毒药
Dialogue: 0,0:19:53.95,0:19:55.24,Default,,0,0,0,,这样啊
Dialogue: 0,0:19:57.99,0:20:00.70,Default,,0,0,0,,你还满厉害的嘛
Dialogue: 0,0:20:00.70,0:20:03.03,Default,,0,0,0,,既然能做出这样的药物
Dialogue: 0,0:20:03.03,0:20:06.03,Default,,0,0,0,,应该也有能力当药商吧
Dialogue: 0,0:20:06.03,0:20:08.66,Default,,0,0,0,,我目前没有这个打算
Dialogue: 0,0:20:08.66,0:20:10.91,Default,,0,0,0,,也对 以你的立场来看
Dialogue: 0,0:20:10.91,0:20:14.11,Default,,0,0,0,,成立二号店才是当务之急吧
Dialogue: 0,0:20:14.82,0:20:15.95,Default,,0,0,0,,怎么了
Dialogue: 0,0:20:15.95,0:20:17.28,Default,,0,0,0,,没什么
Dialogue: 0,0:20:17.28,0:20:19.24,Default,,0,0,0,,在店里工作的卡尔菈小姐
Dialogue: 0,0:20:19.24,0:20:21.32,Default,,0,0,0,,也跟我说了这件事
Dialogue: 0,0:20:21.32,0:20:23.74,Default,,0,0,0,,但我觉得还太早了
Dialogue: 0,0:20:23.74,0:20:26.20,Default,,0,0,0,,如果是你 我想就算开了二号店
Dialogue: 0,0:20:26.20,0:20:28.57,Default,,0,0,0,,也会经营得很顺利
Dialogue: 0,0:20:28.57,0:20:30.03,Default,,0,0,0,,真的吗
Dialogue: 0,0:20:31.07,0:20:34.95,Default,,0,0,0,,如果是因为开二号店的钱不够
Dialogue: 0,0:20:34.95,0:20:38.74,Default,,0,0,0,,把卖药当作副业也不错吧
Dialogue: 0,0:20:38.74,0:20:41.99,Default,,0,0,0,,不然就由我全部买下来
Dialogue: 0,0:20:42.66,0:20:43.41,Default,,0,0,0,,全部
Dialogue: 0,0:20:43.41,0:20:46.66,Default,,0,0,0,,因为我对你有很多期待
Dialogue: 0,0:20:54.03,0:20:57.66,Default,,0,0,0,,开二号店果然还是太早了
Dialogue: 0,0:21:00.03,0:21:01.49,Default,,0,0,0,,利穆尔鸟
Dialogue: 0,0:21:01.49,0:21:03.07,Default,,0,0,0,,是艾莉亚寄来的信
Dialogue: 0,0:21:07.53,0:21:08.57,Default,,0,0,0,,龙马先生
Dialogue: 0,0:21:08.57,0:21:10.70,Default,,0,0,0,,谢谢你写信给我
Dialogue: 0,0:21:12.11,0:21:14.66,Default,,0,0,0,,我刚结束漫长的旅程
Dialogue: 0,0:21:14.66,0:21:17.41,Default,,0,0,0,,回到家里 暂时告一个段落
Dialogue: 0,0:21:18.28,0:21:20.78,Default,,0,0,0,,我的家人也都过得很好
Dialogue: 0,0:21:21.36,0:21:24.11,Default,,0,0,0,,你交给我的史莱姆们
Dialogue: 0,0:21:24.11,0:21:25.95,Default,,0,0,0,,也过得很好喔
Dialogue: 0,0:21:30.78,0:21:33.57,Default,,0,0,0,,听到你努力工作的消息
Dialogue: 0,0:21:33.57,0:21:36.99,Default,,0,0,0,,我也觉得自己必须努力
Dialogue: 0,0:21:40.32,0:21:43.49,Default,,0,0,0,,我接下来该怎么努力呢
Dialogue: 0,0:21:44.45,0:21:47.70,Default,,0,0,0,,在别的城镇成立二号店的建议
Dialogue: 0,0:21:48.24,0:21:50.99,Default,,0,0,0,,如果是你 我想就算开了二号店
Dialogue: 0,0:21:50.99,0:21:53.20,Default,,0,0,0,,也会经营得很顺利
Dialogue: 0,0:21:56.36,0:21:57.70,Default,,0,0,0,,二号店啊
Dialogue: 0,0:22:01.86,0:22:04.07,Default,,0,0,0,,艾莉亚
Dialogue: 0,0:22:04.07,0:22:06.86,Default,,0,0,0,,看来我也要忙起来了
Dialogue: 0,0:22:20.20,0:22:23.49,EDJP,,0,0,0,,センサーライト音沙汰なくて
Dialogue: 0,0:22:23.72,0:22:29.72,EDJP,,0,0,0,,この部屋にわたしがいないみたいだ
Dialogue: 0,0:22:30.21,0:22:32.75,EDJP,,0,0,0,,＃にフィグジャムをつけたら
Dialogue: 0,0:22:32.75,0:22:34.90,EDJP,,0,0,0,,バスタブに泡をたてて
Dialogue: 0,0:22:34.90,0:22:41.96,EDJP,,0,0,0,,よみがえるの 明日のため…Undead!!
Dialogue: 0,0:22:49.87,0:22:52.35,EDJP,,0,0,0,,なくはないの あなたとなら
Dialogue: 0,0:22:52.35,0:22:55.04,EDJP,,0,0,0,,巡り巡る 機械と水
Dialogue: 0,0:22:55.04,0:22:58.72,EDJP,,0,0,0,,ドラム式の宇宙をそっと 見つめて
Dialogue: 0,0:22:59.20,0:23:04.03,EDJP,,0,0,0,,口説きたいな Ah死ぬまで
Dialogue: 0,0:23:04.03,0:23:09.12,EDJP,,0,0,0,,弧を描いた solarの果て
Dialogue: 0,0:23:09.12,0:23:11.91,EDJP,,0,0,0,,愛は少しくたびれて
Dialogue: 0,0:23:11.91,0:23:14.42,EDJP,,0,0,0,,遠ざかりつつあるわ
Dialogue: 0,0:23:14.42,0:23:17.19,EDJP,,0,0,0,,n時発の小惑星で行くの
Dialogue: 0,0:23:17.19,0:23:21.19,EDJP,,0,0,0,,あなた 夢抱いて
Dialogue: 0,0:23:21.35,0:23:28.92,EDJP,,0,0,0,,抱いて 抱いて 抱いて
Dialogue: 0,0:23:28.92,0:23:33.75,EDJP,,0,0,0,,抱いて 抱いて
Dialogue: 0,0:22:20.20,0:22:23.49,EDCN,,0,0,0,,探测光线 未发出声音
Dialogue: 0,0:22:23.72,0:22:29.72,EDCN,,0,0,0,,似乎我并不在这间房内
Dialogue: 0,0:22:30.21,0:22:32.75,EDCN,,0,0,0,,在#后面输入FigJam
Dialogue: 0,0:22:32.75,0:22:34.90,EDCN,,0,0,0,,浴缸里充满了泡沫
Dialogue: 0,0:22:34.90,0:22:41.96,EDCN,,0,0,0,,为了明天再一次醒来……Undead!!
Dialogue: 0,0:22:49.87,0:22:52.35,EDCN,,0,0,0,,若与你同在 便完美无缺
Dialogue: 0,0:22:52.35,0:22:55.04,EDCN,,0,0,0,,循环着循环着 机器和水
Dialogue: 0,0:22:55.04,0:22:58.72,EDCN,,0,0,0,,悄悄地凝望 滚筒式的宇宙
Dialogue: 0,0:22:59.20,0:23:04.03,EDCN,,0,0,0,,我想要述怀 Ah 到死之前
Dialogue: 0,0:23:04.03,0:23:09.12,EDCN,,0,0,0,,划一道弧线 至太阳系尽头
Dialogue: 0,0:23:09.12,0:23:11.91,EDCN,,0,0,0,,爱也是略显疲态
Dialogue: 0,0:23:11.91,0:23:14.42,EDCN,,0,0,0,,越来越远了啊
Dialogue: 0,0:23:14.42,0:23:17.19,EDCN,,0,0,0,,坐上n时发的小行星出发了
Dialogue: 0,0:23:17.19,0:23:21.19,EDCN,,0,0,0,,而你 怀着梦
Dialogue: 0,0:23:21.35,0:23:28.92,EDCN,,0,0,0,,怀着梦 怀着梦 怀着梦
Dialogue: 0,0:23:28.92,0:23:33.75,EDCN,,0,0,0,,怀着梦 怀着梦

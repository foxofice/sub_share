Dialogue: 0,0:01:36.46,0:01:38.69,DefaultSingle-T,,0,0,0,,		早上沖澡超爽
Dialogue: 0,0:01:41.71,0:01:42.16,DefaultSingle-T,,0,0,0,,		咦
Dialogue: 0,0:01:42.52,0:01:43.41,DefaultSingle-T,,0,0,0,,		咦  咦  咦
Dialogue: 0,0:01:43.51,0:01:44.70,DefaultSingle-T,,0,0,0,,		沒有洗髮精
Dialogue: 0,0:01:45.02,0:01:45.73,DefaultSingle-T,,0,0,0,,		怎麼會
Dialogue: 0,0:01:45.91,0:01:47.07,DefaultSingle-T,,0,0,0,,		什  什麼
Dialogue: 0,0:01:48.12,0:01:49.46,DefaultSingle-T,,0,0,0,,		居然要自帶？
Dialogue: 0,0:01:49.64,0:01:51.84,DefaultSingle-T,,0,0,0,,		不好  失算了
Dialogue: 0,0:01:51.84,0:01:53.96,DefaultSingle-T,,0,0,0,,		我本以為合租房什麼都有
Dialogue: 0,0:01:53.96,0:01:57.22,DefaultSingle-T,,0,0,0,,		原來消耗品都要自己準備嗎
Dialogue: 0,0:01:58.29,0:02:00.22,DefaultSingle-T,,0,0,0,,		總之  只能先用水衝一衝了
Dialogue: 0,0:02:02.96,0:02:04.93,DefaultSingle-T,,0,0,0,,		可惡  根本梳不順
Dialogue: 0,0:02:05.02,0:02:06.30,DefaultSingle-T,,0,0,0,,		幹得跟稻草似的
Dialogue: 0,0:02:06.30,0:02:07.85,DefaultSingle-T,,0,0,0,,		痛痛痛  梳不動
Dialogue: 0,0:02:07.85,0:02:09.89,DefaultSingle-T,,0,0,0,,		連瓶洗髮精都不放
Dialogue: 0,0:02:09.89,0:02:12.69,DefaultSingle-T,,0,0,0,,		該死的管理員  饒不了他
Dialogue: 0,0:02:13.17,0:02:14.53,DefaultSingle-T,,0,0,0,,		一大早的  好睏啊
Dialogue: 0,0:02:14.53,0:02:15.36,DefaultSingle-T,,0,0,0,,		是啊
Dialogue: 0,0:02:17.03,0:02:18.98,DefaultSingle-T,,0,0,0,,		沒法用這樣的髮型面對那群派對狂
Dialogue: 0,0:02:18.98,0:02:19.65,DefaultSingle-T,,0,0,0,,		如果…
Dialogue: 0,0:02:19.65,0:02:20.99,DefaultSingle-T,,0,0,0,,		你頭髮怎麼了啊
Dialogue: 0,0:02:20.99,0:02:23.43,DefaultSingle-T,,0,0,0,,		反倒有點搞笑  反倒有點
Dialogue: 0,0:02:23.43,0:02:24.95,DefaultSingle-T,,0,0,0,,		他們這麼說
Dialogue: 0,0:02:25.97,0:02:27.54,DefaultSingle-T,,0,0,0,,		我就會殺了他們
Dialogue: 0,0:02:28.07,0:02:29.88,DefaultSingle-T,,0,0,0,,		我的目標只有那個男人
Dialogue: 0,0:02:29.88,0:02:33.29,DefaultSingle-T,,0,0,0,,		要是殺了別人被警察盯上會很麻煩
Dialogue: 0,0:02:33.50,0:02:36.28,DefaultSingle-T,,0,0,0,,		必須趕緊去買洗髮精
Dialogue: 0,0:02:36.58,0:02:40.05,DefaultSingle-T,,0,0,0,,		在殺掉別人之前
Dialogue: 0,0:02:42.53,0:02:43.97,DefaultSingle-T,,0,0,0,,		好多人啊
Dialogue: 0,0:02:44.73,0:02:46.53,DefaultSingle-T,,0,0,0,,		也有好多打扮時髦的年輕人
Dialogue: 0,0:02:46.53,0:02:48.69,DefaultSingle-T,,0,0,0,,		今天是休息日嗎  真討厭
Dialogue: 0,0:02:50.32,0:02:52.28,DefaultSingle-T,,0,0,0,,		那  那是什麼髮型啊
Dialogue: 0,0:02:52.28,0:02:53.23,DefaultSingle-T,,0,0,0,,		好  好強
Dialogue: 0,0:02:53.65,0:02:57.02,DefaultSingle-T,,0,0,0,,		給他的髮型比起來  我這個簡直太普通
Dialogue: 0,0:02:57.20,0:02:58.93,DefaultSingle-T,,0,0,0,,		表現得大大方方就行了
Dialogue: 0,0:02:58.93,0:03:00.59,DefaultSingle-T,,0,0,0,,		我剛才自我意識太強了
Dialogue: 0,0:03:00.59,0:03:02.51,DefaultSingle-T,,0,0,0,,		根本就沒有人看我
Dialogue: 0,0:03:05.18,0:03:07.28,DefaultSingle-T,,0,0,0,,		怎  怎麼感覺他們在看我
Dialogue: 0,0:03:08.06,0:03:10.60,DefaultSingle-T,,0,0,0,,		別看  為什麼要直勾勾盯著我
Dialogue: 0,0:03:10.71,0:03:12.33,DefaultSingle-T,,0,0,0,,		這髮型就這麼奇怪嗎
Dialogue: 0,0:03:12.47,0:03:13.58,DefaultSingle-T,,0,0,0,,		殺了你們
Dialogue: 0,0:03:13.94,0:03:15.32,DefaultSingle-T,,0,0,0,,		別走大馬路了
Dialogue: 0,0:03:15.48,0:03:17.42,DefaultSingle-T,,0,0,0,,		走人少的小路吧
Dialogue: 0,0:03:20.47,0:03:21.39,DefaultSingle-T,,0,0,0,,		我想想
Dialogue: 0,0:03:21.58,0:03:23.78,DefaultSingle-T,,0,0,0,,		哪裡有賣洗髮精啊
Dialogue: 0,0:03:23.98,0:03:27.18,DefaultSingle-T,,0,0,0,,		我一直住在老家  從沒自己買過洗髮精
Dialogue: 0,0:03:27.50,0:03:28.95,DefaultSingle-T,,0,0,0,,		便利超商裡應該有吧
Dialogue: 0,0:03:28.95,0:03:31.03,DefaultSingle-T,,0,0,0,,		應該有的吧  便利超商裡什麼都有
Dialogue: 0,0:03:32.85,0:03:34.11,DefaultSingle-T,,0,0,0,,		種類太少
Dialogue: 0,0:03:34.46,0:03:37.19,DefaultSingle-T,,0,0,0,,		我平時用的應該不是這種
Dialogue: 0,0:03:38.54,0:03:39.86,DefaultSingle-T,,0,0,0,,		不是便利超商啊
Dialogue: 0,0:03:39.86,0:03:40.52,DefaultSingle-T,,0,0,0,,		那就是…
Dialogue: 0,0:03:42.08,0:03:43.36,DefaultSingle-T,,0,0,0,,		藥妝店…
Dialogue: 0,0:03:50.55,0:03:51.65,DefaultSingle-T,,0,0,0,,		藥…
Dialogue: 0,0:03:52.35,0:03:53.04,DefaultSingle-T,,0,0,0,,		好可怕
Dialogue: 0,0:03:53.24,0:03:55.76,DefaultSingle-T,,0,0,0,,		哪裡有賣啊  超市嗎
Dialogue: 0,0:03:55.76,0:03:59.40,DefaultSingle-T,,0,0,0,,		超市裡一定有  老媽經常去超市
Dialogue: 0,0:03:59.40,0:04:01.49,DefaultSingle-T,,0,0,0,,		老媽
Dialogue: 0,0:04:05.29,0:04:07.05,DefaultSingle-T,,0,0,0,,		沒有超市…
Dialogue: 0,0:04:07.86,0:04:09.73,DefaultSingle-T,,0,0,0,,		為什麼超市這麼難找啊
Dialogue: 0,0:04:09.73,0:04:11.35,DefaultSingle-T,,0,0,0,,		明明便利超商到處都是
Dialogue: 0,0:04:11.35,0:04:13.37,DefaultSingle-T,,0,0,0,,		便利超商對面也是便利超商  有病吧
Dialogue: 0,0:04:13.70,0:04:16.03,DefaultSingle-T,,0,0,0,,		該死的便利超商
Dialogue: 0,0:04:19.82,0:04:20.74,DefaultSingle-T,,0,0,0,,		唐木
Dialogue: 0,0:04:21.13,0:04:22.57,DefaultSingle-T,,0,0,0,,		我聽說過
Dialogue: 0,0:04:22.70,0:04:25.16,DefaultSingle-T,,0,0,0,,		這家店像施了魔法  世上所有東西都能買到
Dialogue: 0,0:04:25.37,0:04:26.23,DefaultSingle-T,,0,0,0,,		唐木
Dialogue: 0,0:04:26.23,0:04:27.16,DefaultSingle-T,,0,0,0,,		這裡應該會有…
Dialogue: 0,0:04:27.49,0:04:29.26,DefaultSingle-T,,0,0,0,,		我說  今天開啥趴呀
Dialogue: 0,0:04:29.26,0:04:30.01,DefaultSingle-T,,0,0,0,,		章魚趴
Dialogue: 0,0:04:30.01,0:04:30.78,DefaultSingle-T,,0,0,0,,		明天呢
Dialogue: 0,0:04:30.78,0:04:31.46,DefaultSingle-T,,0,0,0,,		咖哩趴
Dialogue: 0,0:04:31.46,0:04:33.35,DefaultSingle-T,,0,0,0,,		啥都能開趴是吧
Dialogue: 0,0:04:34.04,0:04:36.42,DefaultSingle-T,,0,0,0,,		他們是…合租的派對狂房客
Dialogue: 0,0:04:36.75,0:04:39.30,DefaultSingle-T,,0,0,0,,		對了  我們還沒辦歡迎會來著
Dialogue: 0,0:04:39.30,0:04:41.03,DefaultSingle-T,,0,0,0,,		不是新來了個人嗎
Dialogue: 0,0:04:41.03,0:04:41.81,DefaultSingle-T,,0,0,0,,		犯澤先生嗎
Dialogue: 0,0:04:41.81,0:04:42.76,DefaultSingle-T,,0,0,0,,		不是每次都會辦嗎
Dialogue: 0,0:04:42.95,0:04:46.15,DefaultSingle-T,,0,0,0,,		不過那人總感覺有點難搭話
Dialogue: 0,0:04:46.36,0:04:48.25,DefaultSingle-T,,0,0,0,,		偶爾還會露出可怕的眼神
Dialogue: 0,0:04:48.25,0:04:50.34,DefaultSingle-T,,0,0,0,,		嗯  像是殺人犯的眼神
Dialogue: 0,0:04:50.34,0:04:50.85,DefaultSingle-T,,0,0,0,,		驚
Dialogue: 0,0:04:50.85,0:04:53.16,DefaultSingle-T,,0,0,0,,		也不知道他為何要來住合租房
Dialogue: 0,0:04:53.16,0:04:53.99,DefaultSingle-T,,0,0,0,,		是啊
Dialogue: 0,0:04:56.86,0:04:57.73,DefaultSingle-T,,0,0,0,,		殺了他們
Dialogue: 0,0:04:58.06,0:05:01.22,DefaultSingle-T,,0,0,0,,		居然敢說我的壞話  你們活膩了是吧
Dialogue: 0,0:05:01.93,0:05:05.90,DefaultSingle-T,,0,0,0,,		就用你們最愛的烤串的鋼釺
Dialogue: 0,0:05:07.02,0:05:10.20,DefaultSingle-T,,0,0,0,,		把你們戳成串
Dialogue: 0,0:05:10.95,0:05:12.07,DefaultSingle-T,,0,0,0,,		所以說
Dialogue: 0,0:05:12.39,0:05:14.17,DefaultSingle-T,,0,0,0,,		今後慢慢了解不就行了
Dialogue: 0,0:05:14.34,0:05:17.03,DefaultSingle-T,,0,0,0,,		畢竟住在同一個屋簷下  不就和家人一樣嗎
Dialogue: 0,0:05:17.13,0:05:19.77,DefaultSingle-T,,0,0,0,,		不過實在相處不來也不用勉強啦
Dialogue: 0,0:05:19.77,0:05:22.03,DefaultSingle-T,,0,0,0,,		他也一樣  要是不願意只要拒絕就行了
Dialogue: 0,0:05:22.18,0:05:24.32,DefaultSingle-T,,0,0,0,,		我會經常請他參加派對的
Dialogue: 0,0:05:24.50,0:05:25.22,DefaultSingle-T,,0,0,0,,		因為
Dialogue: 0,0:05:25.40,0:05:27.43,DefaultSingle-T,,0,0,0,,		這樣會更好玩
Dialogue: 0,0:05:29.22,0:05:29.80,DefaultSingle-T,,0,0,0,,		咦
Dialogue: 0,0:05:29.80,0:05:31.18,DefaultSingle-T,,0,0,0,,		那人不是犯澤先生嗎
Dialogue: 0,0:05:33.50,0:05:35.81,DefaultSingle-T,,0,0,0,,		今天給你開歡迎派對  你要來哦
Dialogue: 0,0:05:35.94,0:05:39.65,DefaultSingle-T,,0,0,0,,		不要啊  別邀請我參加派對啊
Dialogue: 0,0:05:40.31,0:05:44.19,DefaultSingle-T,,0,0,0,,		我剛才可是想殺了你們啊
Dialogue: 0,0:05:49.13,0:05:51.18,DefaultSingle-T,,0,0,0,,		找不到洗髮精
Dialogue: 0,0:05:51.59,0:05:53.94,DefaultSingle-T,,0,0,0,,		就這髮型肯定會被嘲笑
Dialogue: 0,0:06:00.06,0:06:02.81,DefaultSingle-T,,0,0,0,,		早知道還是一個人住了
Dialogue: 0,0:06:03.31,0:06:06.56,DefaultSingle-T,,0,0,0,,		那樣就不用這麼在意他人的目光
Dialogue: 0,0:06:06.99,0:06:10.20,DefaultSingle-T,,0,0,0,,		也不會被邀請參加煩人的派對
Dialogue: 0,0:06:31.55,0:06:32.24,DefaultSingle-T,,0,0,0,,		好
Dialogue: 0,0:06:34.91,0:06:36.72,DefaultSingle-T,,0,0,0,,		犯澤先生  歡迎回來
Dialogue: 0,0:06:37.04,0:06:38.61,DefaultSingle-T,,0,0,0,,		派對都開始啦
Dialogue: 0,0:06:39.29,0:06:40.29,DefaultSingle-T,,0,0,0,,		好
Dialogue: 0,0:06:41.46,0:06:43.00,DefaultSingle-T,,0,0,0,,		你的髮型是怎麼回事啊
Dialogue: 0,0:06:43.22,0:06:46.11,DefaultSingle-T,,0,0,0,,		澡堂的洗髮精有點用不習慣
Dialogue: 0,0:06:46.34,0:06:47.96,DefaultSingle-T,,0,0,0,,		好搞笑
Dialogue: 0,0:08:32.22,0:08:34.50,DefaultSingle-T,,0,0,0,,		如果想體驗米花町的美妙夜晚
Dialogue: 0,0:08:34.50,0:08:36.63,DefaultSingle-T,,0,0,0,,		那可不能錯過下集「米花町狂想曲」
Dialogue: 0,0:08:36.63,0:08:37.75,DefaultSingle-T,,0,0,0,,		身上的錢被偷走
Dialogue: 0,0:08:37.75,0:08:39.55,DefaultSingle-T,,0,0,0,,		在宰客酒吧被逼高額消費
Dialogue: 0,0:08:39.55,0:08:42.82,DefaultSingle-T,,0,0,0,,		最後還被頭上長角的超強神祕女高中生判定了一番
Dialogue: 0,0:08:42.82,0:08:44.74,DefaultSingle-T,,0,0,0,,		別說這麼難聽嘛  犯澤先生
Dialogue: 0,0:08:44.74,0:08:47.91,DefaultSingle-T,,0,0,0,,		我們只是想讓這個城市更美好而已
Dialogue: 0,0:08:47.91,0:08:49.22,DefaultSingle-T,,0,0,0,,		你有意見？
Dialogue: 0,0:08:49.22,0:08:50.99,DefaultSingle-T,,0,0,0,,		不不不  對不起對不起
Dialogue: 0,0:08:50.99,0:08:53.44,DefaultSingle-T,,0,0,0,,		您這麼強大  統一米花町也不是夢
Dialogue: 0,0:08:53.44,0:08:55.05,DefaultSingle-T,,0,0,0,,		你懂就好
Dialogue: 0,0:08:55.05,0:08:57.07,DefaultSingle-T,,0,0,0,,		敬啟  母親大人
Dialogue: 0,0:08:57.37,0:09:00.32,DefaultSingle-T,,0,0,0,,		我正堅強地活著
Dialogue: 0,0:03:53.24,0:03:56.16,Note-T,,0,0,0,,		注：日本的藥妝店除藥品外還售賣洗護用品，所以犯澤完美避開了正確答案
Dialogue: 0,0:04:19.82,0:04:22.79,Note-T,,0,0,0,,		注：原型是日本著名連鎖折扣店「唐吉訶德」
Dialogue: 0,0:01:36.37,0:01:39.37,DefaultSingle-T,,0,0,0,,

Dialogue: 0,0:00:00.00,0:00:04.62,Default,,0,0,0,,（三月份總開銷）
Dialogue: 0,0:00:07.75,0:00:09.50,Default,,0,0,0,,好窮啊
Dialogue: 0,0:00:10.08,0:00:12.95,Default,,0,0,0,,準備上托兒所和設置小孩房時
Dialogue: 0,0:00:12.95,0:00:15.34,Default,,0,0,0,,不小心花得太爽了
Dialogue: 0,0:00:15.25,0:00:17.08,UP,,0,0,0,,看我的
Dialogue: 0,0:00:16.20,0:00:17.41,Default,,0,0,0,,為什麼會窮?
Dialogue: 0,0:00:17.08,0:00:18.34,UP,,0,0,0,,上啊
Dialogue: 0,0:00:17.64,0:00:19.35,Default,,0,0,0,,因為都沒在工作啊
Dialogue: 0,0:00:20.91,0:00:23.37,Default,,0,0,0,,再不節省一點就糟糕了
Dialogue: 0,0:00:23.58,0:00:25.16,Default,,0,0,0,,改喝發泡酒呢?
Dialogue: 0,0:00:25.16,0:00:26.70,Default,,0,0,0,,早就改了啦
Dialogue: 0,0:00:27.37,0:00:30.29,Default,,0,0,0,,這樣下去會連新遊戲都買不起喔
Dialogue: 0,0:00:30.29,0:00:31.45,Default,,0,0,0,,什麼?
Dialogue: 0,0:00:31.45,0:00:32.32,Default,,0,0,0,,太棒了
Dialogue: 0,0:00:32.32,0:00:34.29,Default,,0,0,0,,飯後也別想吃布丁囉
Dialogue: 0,0:00:34.29,0:00:35.37,Default,,0,0,0,,什麼?
Dialogue: 0,0:00:35.37,0:00:37.58,Default,,0,0,0,,手頭就是這麼緊啦
Dialogue: 0,0:00:37.58,0:00:39.91,Default,,0,0,0,,再這樣下去會破產的
Dialogue: 0,0:00:39.91,0:00:41.37,Default,,0,0,0,,什麼?
Dialogue: 0,0:00:42.62,0:00:44.87,Default,,0,0,0,,既然如此只能這麼做了
Dialogue: 0,0:00:45.29,0:00:48.12,Default,,0,0,0,,使出"最後的手段"
Dialogue: 0,0:00:49.20,0:00:51.00,Default,,0,0,0,,所以說 阿久
Dialogue: 0,0:00:51.66,0:00:54.20,Default,,0,0,0,,求求你 派工作給我們吧
Dialogue: 0,0:00:54.20,0:00:55.75,Default,,0,0,0,,我們什麼都願意做
Dialogue: 0,0:00:56.37,0:00:57.58,Default,,0,0,0,,喂 你也要低頭啊
Dialogue: 0,0:00:57.58,0:00:58.83,Default,,0,0,0,,好痛
Dialogue: 0,0:00:58.83,0:01:01.66,Default,,0,0,0,,總算有心要重操舊業啦
Dialogue: 0,0:01:03.25,0:01:05.29,Default,,0,0,0,,調查目標對象的背景
Dialogue: 0,0:01:05.54,0:01:07.58,Default,,0,0,0,,以及場地勘查的委託
Dialogue: 0,0:01:07.95,0:01:11.83,Default,,0,0,0,,建議你們先接小案子找回敏感度吧
Dialogue: 0,0:01:12.37,0:01:13.66,Default,,0,0,0,,這麼多?
Dialogue: 0,0:01:13.66,0:01:15.62,Default,,0,0,0,,好 我們全部都接
Dialogue: 0,0:01:15.62,0:01:17.20,Default,,0,0,0,,畢竟休息了一陣子
Dialogue: 0,0:01:17.20,0:01:19.12,Default,,0,0,0,,現在什麼都得做 對吧?
Dialogue: 0,0:01:19.12,0:01:20.41,Default,,0,0,0,,啊?
Dialogue: 0,0:01:20.66,0:01:22.25,Default,,0,0,0,,一星期內要交件
Dialogue: 0,0:01:22.25,0:01:24.00,Default,,0,0,0,,交給我們吧 阿久
Dialogue: 0,0:01:25.00,0:01:27.25,Default,,0,0,0,,好了 快走吧 零
Dialogue: 0,0:01:31.45,0:01:34.87,OPEDJP,,0,0,0,,ねえ愛したいこれは真実？
Dialogue: 0,0:01:34.87,0:01:38.37,OPEDJP,,0,0,0,,ただ愛されたいのは不誠実？
Dialogue: 0,0:01:38.37,0:01:40.58,OPEDJP,,0,0,0,,もうどうすればいい
Dialogue: 0,0:01:40.58,0:01:43.25,OPEDJP,,0,0,0,,どうすればいいのか
Dialogue: 0,0:01:46.58,0:01:49.37,OPEDJP,,0,0,0,,街はいつも通り今日も
Dialogue: 0,0:01:49.37,0:01:53.03,OPEDJP,,0,0,0,,惚れた腫れたで色めきたつ
Dialogue: 0,0:01:53.03,0:01:56.53,OPEDJP,,0,0,0,,エキストラは家に帰るだけ
Dialogue: 0,0:01:56.53,0:02:00.04,OPEDJP,,0,0,0,,不貞腐れてやしないさ
Dialogue: 0,0:02:00.04,0:02:03.79,OPEDJP,,0,0,0,,そんな日々を切り裂くように
Dialogue: 0,0:02:03.79,0:02:07.29,OPEDJP,,0,0,0,,突然現れた君は
Dialogue: 0,0:02:07.29,0:02:10.78,OPEDJP,,0,0,0,,痺れるような笑顔で僕の
Dialogue: 0,0:02:10.78,0:02:15.62,OPEDJP,,0,0,0,,心を砕いて見せた
Dialogue: 0,0:02:16.57,0:02:19.82,OPEDJP,,0,0,0,,ねえ愛したいこれは真実？
Dialogue: 0,0:02:19.82,0:02:23.45,OPEDJP,,0,0,0,,ただ愛されたいのは不誠実？
Dialogue: 0,0:02:23.45,0:02:25.75,OPEDJP,,0,0,0,,もうどうすればいい
Dialogue: 0,0:02:25.75,0:02:28.50,OPEDJP,,0,0,0,,どうすればいいのか
Dialogue: 0,0:02:28.50,0:02:30.62,OPEDJP,,0,0,0,,って分からないよ
Dialogue: 0,0:02:30.62,0:02:34.32,OPEDJP,,0,0,0,,その頭の中が分かんない
Dialogue: 0,0:02:34.32,0:02:37.87,OPEDJP,,0,0,0,,でも愛想は良いとかずるいよ
Dialogue: 0,0:02:37.87,0:02:43.00,OPEDJP,,0,0,0,,こうやってまた君のペースに飲まれてく
Dialogue: 0,0:02:45.12,0:02:50.20,OPEDJP,,0,0,0,,そうやってまたほら振り回されてる
Dialogue: 0,0:02:56.00,0:03:00.75,OPEDJP,,0,0,0,,そうやってまたほら振り回されてる
Dialogue: 0,0:01:31.45,0:01:34.87,OPEDCN,,0,0,0,,吶 我想愛你 這是真的嗎?
Dialogue: 0,0:01:34.87,0:01:38.37,OPEDCN,,0,0,0,,只想被愛就不算誠實嗎?
Dialogue: 0,0:01:38.37,0:01:40.58,OPEDCN,,0,0,0,,到底該怎麼辦?
Dialogue: 0,0:01:40.58,0:01:43.25,OPEDCN,,0,0,0,,怎麼辦才好呢?
Dialogue: 0,0:01:46.58,0:01:49.37,OPEDCN,,0,0,0,,今天的城市依舊
Dialogue: 0,0:01:49.37,0:01:53.03,OPEDCN,,0,0,0,,令人神魂顛倒 興奮不已
Dialogue: 0,0:01:53.03,0:01:56.53,OPEDCN,,0,0,0,,臨時演員只是回家了
Dialogue: 0,0:01:56.53,0:02:00.04,OPEDCN,,0,0,0,,絕對不是在彆扭啦
Dialogue: 0,0:02:00.04,0:02:03.79,OPEDCN,,0,0,0,,彷彿劃破這樣的日子一般
Dialogue: 0,0:02:03.79,0:02:07.29,OPEDCN,,0,0,0,,突然出現的你
Dialogue: 0,0:02:07.29,0:02:10.78,OPEDCN,,0,0,0,,帶著令人陶醉的笑容
Dialogue: 0,0:02:10.78,0:02:15.62,OPEDCN,,0,0,0,,讓我明白了心碎的滋味
Dialogue: 0,0:02:16.57,0:02:19.82,OPEDCN,,0,0,0,,吶 我想愛你 這是真的嗎?
Dialogue: 0,0:02:19.82,0:02:23.45,OPEDCN,,0,0,0,,只想被愛就不算誠實嗎?
Dialogue: 0,0:02:23.45,0:02:25.75,OPEDCN,,0,0,0,,到底該怎麼辦?
Dialogue: 0,0:02:25.75,0:02:28.50,OPEDCN,,0,0,0,,怎麼辦才好呢?
Dialogue: 0,0:02:28.50,0:02:30.62,OPEDCN,,0,0,0,,不知道了啦
Dialogue: 0,0:02:30.62,0:02:34.32,OPEDCN,,0,0,0,,我不知道你在想什麼
Dialogue: 0,0:02:34.32,0:02:37.87,OPEDCN,,0,0,0,,你卻如此惹人憐愛 真不公平
Dialogue: 0,0:02:37.87,0:02:43.00,OPEDCN,,0,0,0,,就這樣 我又被你拉走節奏了
Dialogue: 0,0:02:45.12,0:02:50.20,OPEDCN,,0,0,0,,於是你看 我又被任意擺布
Dialogue: 0,0:02:56.00,0:03:00.75,OPEDCN,,0,0,0,,於是你看 我又被任意擺布
Dialogue: 0,0:03:03.91,0:03:06.16,Default,,0,0,0,,這些背景調查我來處理
Dialogue: 0,0:03:06.16,0:03:08.45,Default,,0,0,0,,就麻煩你去這裡場勘了
Dialogue: 0,0:03:08.66,0:03:10.87,Default,,0,0,0,,這種事不是你負責的嗎?
Dialogue: 0,0:03:10.87,0:03:13.20,Default,,0,0,0,,少囉唆 現在哪能挑工作
Dialogue: 0,0:03:13.20,0:03:14.50,Default,,0,0,0,,快點解決掉…
Dialogue: 0,0:03:13.76,0:03:16.26,UP,,0,0,0,,（藍天托兒所 杏奈老師來電）
Dialogue: 0,0:03:18.16,0:03:19.62,Default,,0,0,0,,托兒所打來?
Dialogue: 0,0:03:19.62,0:03:20.57,Default,,0,0,0,,怎麼了?
Dialogue: 0,0:03:20.82,0:03:21.82,Default,,0,0,0,,有事嗎?
Dialogue: 0,0:03:24.25,0:03:25.37,Default,,0,0,0,,喂?
Dialogue: 0,0:03:25.37,0:03:29.04,Default,,0,0,0,,喂?我是藍天托兒所的羽生
Dialogue: 0,0:03:29.04,0:03:30.32,Default,,0,0,0,,是
Dialogue: 0,0:03:30.32,0:03:35.00,Default,,0,0,0,,其實長頸鹿班從今天開始要停課了
Dialogue: 0,0:03:35.00,0:03:36.29,Default,,0,0,0,,咦?啊?
Dialogue: 0,0:03:36.29,0:03:37.32,Default,,0,0,0,,為…為什麼?
Dialogue: 0,0:03:37.32,0:03:38.57,Default,,0,0,0,,這是怎麼回事?
Dialogue: 0,0:03:38.91,0:03:41.66,UP,,0,0,0,,（通知：為防止病毒感染擴大…）
Dialogue: 0,0:03:44.41,0:03:49.45,Default,,0,0,0,,#05 關鍵時刻
Dialogue: 0,0:03:50.07,0:03:52.82,Default,,0,0,0,,美俐 爸爸來接你了喔
Dialogue: 0,0:03:52.82,0:03:54.29,Default,,0,0,0,,爸爸
Dialogue: 0,0:04:00.87,0:04:02.50,Default,,0,0,0,,工作該怎麼辦?
Dialogue: 0,0:04:02.83,0:04:04.20,Default,,0,0,0,,還問怎麼辦
Dialogue: 0,0:04:04.20,0:04:07.41,Default,,0,0,0,,我們要有人照顧美俐才行吧?
Dialogue: 0,0:04:07.66,0:04:09.12,Default,,0,0,0,,這下慘了
Dialogue: 0,0:04:10.08,0:04:12.25,Default,,0,0,0,,爸爸 我想去公園
Dialogue: 0,0:04:12.25,0:04:15.54,Default,,0,0,0,,不行 我們必須要工作
Dialogue: 0,0:04:15.54,0:04:16.95,Default,,0,0,0,,工作?
Dialogue: 0,0:04:17.32,0:04:19.07,Default,,0,0,0,,什麼樣的工作?
Dialogue: 0,0:04:19.82,0:04:20.57,Default,,0,0,0,,沒啦
Dialogue: 0,0:04:20.57,0:04:23.20,Default,,0,0,0,,這…小孩子不用知道啦
Dialogue: 0,0:04:23.20,0:04:25.08,Default,,0,0,0,,可是 這是功課啊
Dialogue: 0,0:04:25.08,0:04:25.91,Default,,0,0,0,,什麼?
Dialogue: 0,0:04:25.91,0:04:27.25,Default,,0,0,0,,功課
Dialogue: 0,0:04:27.25,0:04:28.29,Default,,0,0,0,,功課?
Dialogue: 0,0:04:28.45,0:04:29.83,Default,,0,0,0,,老師說停課期間
Dialogue: 0,0:04:29.83,0:04:33.83,Default,,0,0,0,,要回家問爸爸工作的事
Dialogue: 0,0:04:33.83,0:04:37.08,Default,,0,0,0,,然後再向大家發表
Dialogue: 0,0:04:37.08,0:04:38.95,Default,,0,0,0,,把我們的工作…
Dialogue: 0,0:04:38.95,0:04:40.37,Default,,0,0,0,,向大家發表?
Dialogue: 0,0:04:40.37,0:04:42.04,Default,,0,0,0,,爸爸們是上班族?
Dialogue: 0,0:04:42.04,0:04:43.08,Default,,0,0,0,,不是
Dialogue: 0,0:04:43.08,0:04:44.62,Default,,0,0,0,,那麼是店員?
Dialogue: 0,0:04:44.62,0:04:45.54,Default,,0,0,0,,也不是
Dialogue: 0,0:04:45.54,0:04:47.33,Default,,0,0,0,,是什麼樣的工作?
Dialogue: 0,0:04:47.33,0:04:49.00,Default,,0,0,0,,這個嘛…
Dialogue: 0,0:04:49.20,0:04:50.62,Default,,0,0,0,,我去場勘了
Dialogue: 0,0:04:51.75,0:04:54.12,Default,,0,0,0,,零爸爸 你要去哪裡?
Dialogue: 0,0:04:54.12,0:04:55.58,Default,,0,0,0,,你要去做什麼?
Dialogue: 0,0:04:55.58,0:04:57.20,Default,,0,0,0,,是工作嗎?
Dialogue: 0,0:04:59.29,0:05:01.50,Default,,0,0,0,,不行
Dialogue: 0,0:05:01.50,0:05:03.12,Default,,0,0,0,,美俐也要去啦
Dialogue: 0,0:05:03.12,0:05:04.25,Default,,0,0,0,,放開我
Dialogue: 0,0:05:04.25,0:05:06.91,Default,,0,0,0,,人家想看你工作
Dialogue: 0,0:05:06.91,0:05:09.45,Default,,0,0,0,,這下到底該怎麼辦?
Dialogue: 0,0:05:22.08,0:05:23.83,Default,,0,0,0,,到今天兩晚沒睡
Dialogue: 0,0:05:23.83,0:05:26.37,Default,,0,0,0,,不對 是三晚了吧?
Dialogue: 0,0:05:27.45,0:05:28.79,Default,,0,0,0,,我回來了
Dialogue: 0,0:05:29.00,0:05:30.41,Default,,0,0,0,,辛苦了
Dialogue: 0,0:05:30.91,0:05:32.45,Default,,0,0,0,,照片拍攝完畢
Dialogue: 0,0:05:33.37,0:05:35.25,Default,,0,0,0,,都這麼晚了嗎?
Dialogue: 0,0:05:36.70,0:05:41.29,Default,,0,0,0,,白天要顧小孩 果然就無法工作啊
Dialogue: 0,0:05:41.54,0:05:42.58,Default,,0,0,0,,好想睡
Dialogue: 0,0:05:42.58,0:05:44.50,Default,,0,0,0,,喂 不可以睡
Dialogue: 0,0:05:44.50,0:05:47.25,Default,,0,0,0,,你還得整理照片呢
Dialogue: 0,0:05:47.25,0:05:48.29,Default,,0,0,0,,快起來
Dialogue: 0,0:05:48.29,0:05:50.00,Default,,0,0,0,,我已經不行了
Dialogue: 0,0:05:50.29,0:05:51.40,Default,,0,0,0,,你這傢伙
Dialogue: 0,0:05:51.65,0:05:55.15,Default,,0,0,0,,平常熬夜玩遊戲不都好好的嗎?
Dialogue: 0,0:05:59.08,0:06:01.91,Default,,0,0,0,,這樣下去會趕不上交件時間
Dialogue: 0,0:06:03.00,0:06:04.33,Default,,0,0,0,,就算不可能
Dialogue: 0,0:06:04.54,0:06:07.50,Default,,0,0,0,,也只能跟阿久求情了
Dialogue: 0,0:06:11.04,0:06:13.12,Default,,0,0,0,,大家好
Dialogue: 0,0:06:13.12,0:06:16.75,Default,,0,0,0,,要開始跳"蔬菜舞"囉
Dialogue: 0,0:06:23.87,0:06:25.37,Default,,0,0,0,,喂 零
Dialogue: 0,0:06:25.87,0:06:27.41,Default,,0,0,0,,我差不多要出門囉
Dialogue: 0,0:06:28.00,0:06:29.04,Default,,0,0,0,,啊?
Dialogue: 0,0:06:29.20,0:06:31.50,Default,,0,0,0,,不好意思 要麻煩你顧一下美俐
Dialogue: 0,0:06:31.83,0:06:33.25,Default,,0,0,0,,就交給你看家囉
Dialogue: 0,0:06:41.29,0:06:42.90,Default,,0,0,0,,爸爸你要去哪裡?
Dialogue: 0,0:06:42.90,0:06:44.04,Default,,0,0,0,,美俐也要去
Dialogue: 0,0:06:44.04,0:06:46.08,Default,,0,0,0,,我要去工作 所以不行
Dialogue: 0,0:06:46.29,0:06:49.15,Default,,0,0,0,,零爸爸說會陪你玩唷
Dialogue: 0,0:06:49.40,0:06:51.65,Default,,0,0,0,,再見啦 要乖乖的喔
Dialogue: 0,0:06:57.20,0:06:58.87,Default,,0,0,0,,零爸爸
Dialogue: 0,0:06:59.87,0:07:02.20,Default,,0,0,0,,陪我玩
Dialogue: 0,0:07:03.54,0:07:06.08,Default,,0,0,0,,零爸爸
Dialogue: 0,0:07:27.95,0:07:30.16,Default,,0,0,0,,我要去看爸爸工作
Dialogue: 0,0:07:47.45,0:07:48.95,Default,,0,0,0,,噓…
Dialogue: 0,0:08:16.58,0:08:18.79,Default,,0,0,0,,再見
Dialogue: 0,0:08:22.70,0:08:23.87,Default,,0,0,0,,奇怪?
Dialogue: 0,0:08:35.03,0:08:36.40,Default,,0,0,0,,奇怪了?
Dialogue: 0,0:08:54.20,0:08:55.20,Default,,0,0,0,,美俐?
Dialogue: 0,0:09:01.66,0:09:03.50,Default,,0,0,0,,所以 要談什麼?
Dialogue: 0,0:09:03.50,0:09:06.29,Default,,0,0,0,,關於…工作上的事…
Dialogue: 0,0:09:06.29,0:09:08.50,Default,,0,0,0,,應該很順利吧?
Dialogue: 0,0:09:09.41,0:09:12.58,Default,,0,0,0,,這方面…我想商量一下…
Dialogue: 0,0:09:14.25,0:09:15.37,Default,,0,0,0,,（零 手機來電）
Dialogue: 0,0:09:16.08,0:09:17.08,Default,,0,0,0,,幹嘛啦?
Dialogue: 0,0:09:17.08,0:09:19.95,Default,,0,0,0,,阿久現在心情超差的說
Dialogue: 0,0:09:19.95,0:09:20.62,Default,,0,0,0,,美俐
Dialogue: 0,0:09:20.62,0:09:21.54,Default,,0,0,0,,啊?
Dialogue: 0,0:09:21.70,0:09:23.08,Default,,0,0,0,,在你那邊嗎?
Dialogue: 0,0:09:24.08,0:09:25.58,Default,,0,0,0,,怎麼可能在我這邊
Dialogue: 0,0:09:26.66,0:09:28.41,Default,,0,0,0,,你…該不會?
Dialogue: 0,0:09:28.41,0:09:29.16,Default,,0,0,0,,她不見了
Dialogue: 0,0:09:29.16,0:09:29.83,Default,,0,0,0,,啊?
Dialogue: 0,0:09:29.83,0:09:31.37,Default,,0,0,0,,怎麼會這樣?
Dialogue: 0,0:09:45.37,0:09:47.20,Default,,0,0,0,,什麼時候不見的?
Dialogue: 0,0:09:47.45,0:09:48.50,Default,,0,0,0,,不知道
Dialogue: 0,0:09:50.83,0:09:52.91,Default,,0,0,0,,是她自己跑出去的嗎?
Dialogue: 0,0:09:52.91,0:09:54.20,Default,,0,0,0,,不知道
Dialogue: 0,0:09:58.70,0:10:00.62,Default,,0,0,0,,真是的 你在搞什麼?
Dialogue: 0,0:10:00.83,0:10:02.33,Default,,0,0,0,,我去附近找找
Dialogue: 0,0:10:03.00,0:10:03.95,Default,,0,0,0,,我也去
Dialogue: 0,0:10:24.95,0:10:26.04,Default,,0,0,0,,不是她
Dialogue: 0,0:10:34.20,0:10:35.16,Default,,0,0,0,,我下次再來
Dialogue: 0,0:10:53.95,0:10:56.41,Default,,0,0,0,,對不起 撞到你了
Dialogue: 0,0:11:11.00,0:11:13.25,Default,,0,0,0,,（槲寄生 咖啡·輕食）
Dialogue: 0,0:11:14.54,0:11:15.58,Default,,0,0,0,,怎麼樣?
Dialogue: 0,0:11:15.79,0:11:16.79,Default,,0,0,0,,找不到
Dialogue: 0,0:11:16.79,0:11:18.08,Default,,0,0,0,,我這邊也是
Dialogue: 0,0:11:20.45,0:11:21.41,Default,,0,0,0,,沒辦法
Dialogue: 0,0:11:21.41,0:11:22.66,Default,,0,0,0,,只好去報警了
Dialogue: 0,0:11:22.66,0:11:24.62,Default,,0,0,0,,什麼?我們去嗎?
Dialogue: 0,0:11:24.62,0:11:26.33,Default,,0,0,0,,還能怎麼辦?
Dialogue: 0,0:11:26.33,0:11:30.50,Default,,0,0,0,,說不定是跟我們\N有冤仇的人誘拐了她
Dialogue: 0,0:11:30.79,0:11:32.12,Default,,0,0,0,,不過她很可愛
Dialogue: 0,0:11:32.12,0:11:34.54,Default,,0,0,0,,搞不好是被變態拐走
Dialogue: 0,0:11:34.95,0:11:36.16,Default,,0,0,0,,可惡
Dialogue: 0,0:11:36.16,0:11:39.70,Default,,0,0,0,,要是抓到誘拐犯 我要大卸八塊
Dialogue: 0,0:11:39.70,0:11:41.29,Default,,0,0,0,,將他倒吊 矇眼
Dialogue: 0,0:11:41.29,0:11:43.04,Default,,0,0,0,,刀割 水淹 火烤
Dialogue: 0,0:11:43.04,0:11:45.16,Default,,0,0,0,,用鉗子拔指甲…
Dialogue: 0,0:11:45.41,0:11:46.29,Default,,0,0,0,,找到人了嗎?
Dialogue: 0,0:11:46.29,0:11:47.45,Default,,0,0,0,,我渴了
Dialogue: 0,0:11:48.04,0:11:49.33,Default,,0,0,0,,小心我宰了你
Dialogue: 0,0:11:53.50,0:11:54.75,Default,,0,0,0,,美俐?
Dialogue: 0,0:11:54.75,0:11:55.91,Default,,0,0,0,,爸爸
Dialogue: 0,0:11:55.91,0:11:57.08,Default,,0,0,0,,居然在這裡
Dialogue: 0,0:11:57.08,0:11:58.62,Default,,0,0,0,,我找了你好久呢
Dialogue: 0,0:11:58.62,0:12:01.08,Default,,0,0,0,,對不起 爸爸
Dialogue: 0,0:12:01.08,0:12:02.37,Default,,0,0,0,,真是的
Dialogue: 0,0:12:03.54,0:12:04.70,Default,,0,0,0,,爸爸?
Dialogue: 0,0:12:05.70,0:12:08.41,Default,,0,0,0,,爸…你父母也很擔心呢
Dialogue: 0,0:12:08.41,0:12:11.33,Default,,0,0,0,,已經沒事囉 美俐小妹妹
Dialogue: 0,0:12:12.33,0:12:14.91,Default,,0,0,0,,哎呀 我一直在找這孩子
Dialogue: 0,0:12:14.91,0:12:17.37,Default,,0,0,0,,沒想到居然在這裡
Dialogue: 0,0:12:17.79,0:12:19.79,Default,,0,0,0,,阿久 你真是幫了大忙
Dialogue: 0,0:12:21.16,0:12:22.83,Default,,0,0,0,,她說自己迷路了
Dialogue: 0,0:12:22.83,0:12:25.00,Default,,0,0,0,,所以暫時讓她待著
Dialogue: 0,0:12:25.70,0:12:27.91,Default,,0,0,0,,老闆 請給我水
Dialogue: 0,0:12:27.91,0:12:29.04,Default,,0,0,0,,來了
Dialogue: 0,0:12:32.04,0:12:34.50,Default,,0,0,0,,美俐 你有跟那個叔叔說過嗎?
Dialogue: 0,0:12:34.50,0:12:36.54,Default,,0,0,0,,我和零的事
Dialogue: 0,0:12:36.54,0:12:37.50,Default,,0,0,0,,沒有
Dialogue: 0,0:12:37.50,0:12:38.50,Default,,0,0,0,,很好
Dialogue: 0,0:12:38.50,0:12:39.79,Default,,0,0,0,,聽好了 美俐
Dialogue: 0,0:12:39.79,0:12:42.00,Default,,0,0,0,,在那個人面前
Dialogue: 0,0:12:42.00,0:12:44.54,Default,,0,0,0,,絕對不能叫我們爸爸喔
Dialogue: 0,0:12:45.50,0:12:46.83,Default,,0,0,0,,我知道了
Dialogue: 0,0:12:47.08,0:12:48.83,Default,,0,0,0,,知道什麼?
Dialogue: 0,0:12:48.83,0:12:50.50,Default,,0,0,0,,沒啦 其實啊
Dialogue: 0,0:12:50.50,0:12:54.66,Default,,0,0,0,,最近臨時接了顧小孩的打工呢
Dialogue: 0,0:12:55.41,0:12:57.00,Default,,0,0,0,,你們兩個嗎?
Dialogue: 0,0:12:57.83,0:12:59.66,Default,,0,0,0,,結…結果這傢伙
Dialogue: 0,0:12:59.66,0:13:01.45,Default,,0,0,0,,居然自己跑不見了
Dialogue: 0,0:13:01.45,0:13:03.91,Default,,0,0,0,,哎呀 真是捏了一把冷汗
Dialogue: 0,0:13:03.91,0:13:05.00,Default,,0,0,0,,是喔
Dialogue: 0,0:13:05.50,0:13:07.83,Default,,0,0,0,,那麼 我交代的工作呢?
Dialogue: 0,0:13:08.58,0:13:11.16,Default,,0,0,0,,有啊 當然有認真在做
Dialogue: 0,0:13:11.16,0:13:12.45,Default,,0,0,0,,我跟零分工合作
Dialogue: 0,0:13:12.45,0:13:13.95,Default,,0,0,0,,正順利進行中
Dialogue: 0,0:13:13.95,0:13:15.20,Default,,0,0,0,,全都會辦妥
Dialogue: 0,0:13:15.20,0:13:16.29,Default,,0,0,0,,什麼?
Dialogue: 0,0:13:16.29,0:13:18.62,Default,,0,0,0,,拖到工作的話 我會很困擾
Dialogue: 0,0:13:19.70,0:13:21.95,Default,,0,0,0,,你們應該沒問題吧?
Dialogue: 0,0:13:24.62,0:13:26.54,Default,,0,0,0,,其實…老實說
Dialogue: 0,0:13:26.54,0:13:28.66,Default,,0,0,0,,工作進度有點落後
Dialogue: 0,0:13:28.87,0:13:30.95,Default,,0,0,0,,我們連睡覺的時間都沒有…
Dialogue: 0,0:13:30.95,0:13:33.04,Default,,0,0,0,,已經三天沒睡了
Dialogue: 0,0:13:36.54,0:13:40.12,Default,,0,0,0,,少了孩子 就能完成工作嗎?
Dialogue: 0,0:13:41.45,0:13:42.91,Default,,0,0,0,,"少了"孩子?
Dialogue: 0,0:13:42.91,0:13:44.37,Default,,0,0,0,,什麼意思?
Dialogue: 0,0:13:47.12,0:13:48.58,Default,,0,0,0,,暫時由我照顧
Dialogue: 0,0:13:48.58,0:13:49.54,Default,,0,0,0,,不行啦
Dialogue: 0,0:13:49.54,0:13:50.95,Default,,0,0,0,,不管阿久再怎麼說
Dialogue: 0,0:13:50.95,0:13:52.75,Default,,0,0,0,,把這麼小的孩子…
Dialogue: 0,0:13:53.45,0:13:55.83,Default,,0,0,0,,什麼?你剛剛說什麼?
Dialogue: 0,0:13:56.04,0:13:59.29,Default,,0,0,0,,由我照顧她 優先完成我的工作
Dialogue: 0,0:14:03.58,0:14:05.83,Default,,0,0,0,,謝謝招待
Dialogue: 0,0:14:08.58,0:14:11.58,Default,,0,0,0,,（畫畫本、蠟筆）
Dialogue: 0,0:14:18.75,0:14:22.16,Default,,0,0,0,,剩下的案子都必須出遠門
Dialogue: 0,0:14:22.16,0:14:26.12,Default,,0,0,0,,總之今天只能請阿久顧\N度過難關了
Dialogue: 0,0:14:26.45,0:14:28.58,Default,,0,0,0,,萬一美俐的身分被發現…
Dialogue: 0,0:14:29.00,0:14:31.45,Default,,0,0,0,,說不定…會被殺掉
Dialogue: 0,0:14:35.54,0:14:37.50,Default,,0,0,0,,快點出發吧 爸爸
Dialogue: 0,0:14:38.45,0:14:39.58,Default,,0,0,0,,聽好了 美俐
Dialogue: 0,0:14:39.58,0:14:41.62,Default,,0,0,0,,我們是你爸爸的這件事
Dialogue: 0,0:14:41.62,0:14:44.45,Default,,0,0,0,,絕～對不可以說溜嘴喔
Dialogue: 0,0:14:45.37,0:14:46.41,Default,,0,0,0,,我知道了
Dialogue: 0,0:14:46.41,0:14:50.04,Default,,0,0,0,,我不會說爸爸們是我爸爸
Dialogue: 0,0:14:50.04,0:14:51.87,Default,,0,0,0,,真的沒問題嗎?
Dialogue: 0,0:14:51.87,0:14:53.45,Default,,0,0,0,,應該不行吧
Dialogue: 0,0:14:54.87,0:14:56.62,Default,,0,0,0,,那就麻煩你了 阿久
Dialogue: 0,0:14:57.12,0:14:58.79,Default,,0,0,0,,要準時完成工作喔
Dialogue: 0,0:14:58.79,0:15:00.54,Default,,0,0,0,,知…知道啦
Dialogue: 0,0:15:00.79,0:15:03.20,Default,,0,0,0,,你要乖乖的喔 美俐小妹妹
Dialogue: 0,0:15:03.20,0:15:04.11,Default,,0,0,0,,好的 爸…
Dialogue: 0,0:15:04.11,0:15:04.91,Default,,0,0,0,,噓
Dialogue: 0,0:15:07.62,0:15:09.87,Default,,0,0,0,,路上小心
Dialogue: 0,0:15:12.83,0:15:15.04,Default,,0,0,0,,小妹妹 你叫什麼名字?
Dialogue: 0,0:15:15.04,0:15:18.12,Default,,0,0,0,,我叫海坂美俐 今年四歲
Dialogue: 0,0:15:18.12,0:15:19.16,Default,,0,0,0,,你叫美俐啊?
Dialogue: 0,0:15:19.16,0:15:20.08,Default,,0,0,0,,對
Dialogue: 0,0:15:20.50,0:15:22.00,Default,,0,0,0,,要喝果汁嗎?
Dialogue: 0,0:15:23.08,0:15:24.08,Default,,0,0,0,,要
Dialogue: 0,0:15:39.62,0:15:41.37,Default,,0,0,0,,好 完成了
Dialogue: 0,0:15:42.79,0:15:43.41,Default,,0,0,0,,來吧
Dialogue: 0,0:15:43.41,0:15:45.62,Default,,0,0,0,,請享用 小公主
Dialogue: 0,0:15:45.62,0:15:47.58,Default,,0,0,0,,開動
Dialogue: 0,0:15:52.00,0:15:53.00,Default,,0,0,0,,怎麼樣?
Dialogue: 0,0:15:53.00,0:15:55.20,Default,,0,0,0,,像是天堂的味道
Dialogue: 0,0:15:55.20,0:15:56.37,Default,,0,0,0,,天堂?
Dialogue: 0,0:15:56.37,0:15:57.95,Default,,0,0,0,,超級好喝的
Dialogue: 0,0:15:57.95,0:16:00.16,Default,,0,0,0,,謝謝你 大哥哥
Dialogue: 0,0:16:00.66,0:16:02.29,Default,,0,0,0,,不客氣
Dialogue: 0,0:16:05.20,0:16:07.00,Default,,0,0,0,,別看阿久那張臉
Dialogue: 0,0:16:07.00,0:16:09.16,Default,,0,0,0,,其實他很不留情
Dialogue: 0,0:16:09.16,0:16:11.58,Default,,0,0,0,,也很會對女生花言巧語
Dialogue: 0,0:16:13.37,0:16:17.45,Default,,0,0,0,,美俐要當久太郎的新娘
Dialogue: 0,0:16:17.45,0:16:18.37,Default,,0,0,0,,親親
Dialogue: 0,0:16:18.66,0:16:20.87,Default,,0,0,0,,親…親…
Dialogue: 0,0:16:20.87,0:16:23.33,Default,,0,0,0,,總之 只能卯起來完成工作
Dialogue: 0,0:16:23.33,0:16:26.12,Default,,0,0,0,,速速趕回去了
Dialogue: 0,0:16:28.33,0:16:30.41,Default,,0,0,0,,聽我說 大哥哥
Dialogue: 0,0:16:30.41,0:16:32.25,Default,,0,0,0,,叫我阿久就可以了
Dialogue: 0,0:16:32.25,0:16:33.62,Default,,0,0,0,,阿久?
Dialogue: 0,0:16:33.62,0:16:35.00,Default,,0,0,0,,阿久
Dialogue: 0,0:16:35.00,0:16:36.04,Default,,0,0,0,,什麼事?
Dialogue: 0,0:16:36.04,0:16:37.12,Default,,0,0,0,,爸爸…
Dialogue: 0,0:16:37.91,0:16:41.08,Default,,0,0,0,,你是阿一和零的朋友嗎?
Dialogue: 0,0:16:41.08,0:16:42.20,Default,,0,0,0,,是啊
Dialogue: 0,0:16:42.20,0:16:44.25,Default,,0,0,0,,你也知道他們的工作嗎?
Dialogue: 0,0:16:44.25,0:16:46.04,Default,,0,0,0,,當然知道啊
Dialogue: 0,0:16:47.04,0:16:49.54,Default,,0,0,0,,我想問他們工作的事
Dialogue: 0,0:16:49.70,0:16:52.54,Default,,0,0,0,,他們兩個都完全不肯告訴我
Dialogue: 0,0:16:54.16,0:16:57.87,Default,,0,0,0,,也不能怪他們兩個想隱瞞啦
Dialogue: 0,0:16:58.37,0:16:59.66,Default,,0,0,0,,他們啊
Dialogue: 0,0:16:59.87,0:17:02.37,Default,,0,0,0,,做的是很特別的工作喔
Dialogue: 0,0:17:02.37,0:17:03.75,Default,,0,0,0,,特別?
Dialogue: 0,0:17:03.75,0:17:04.57,Default,,0,0,0,,對啊
Dialogue: 0,0:17:04.57,0:17:07.75,Default,,0,0,0,,告訴我 是什麼特別的工作?
Dialogue: 0,0:17:07.95,0:17:09.86,Default,,0,0,0,,一騎的工作是…
Dialogue: 0,0:17:11.86,0:17:13.79,Default,,0,0,0,,搞笑藝人
Dialogue: 0,0:17:14.04,0:17:15.95,Default,,0,0,0,,搞笑藝人?
Dialogue: 0,0:17:16.29,0:17:18.57,Default,,0,0,0,,是一種把人逗笑的工作
Dialogue: 0,0:17:18.57,0:17:21.32,Default,,0,0,0,,不過 因為他總是表演到冷場
Dialogue: 0,0:17:21.32,0:17:24.16,Default,,0,0,0,,才會太害羞而不敢告訴別人
Dialogue: 0,0:17:24.57,0:17:26.41,Default,,0,0,0,,現在他在某個舞台上
Dialogue: 0,0:17:26.41,0:17:28.54,Default,,0,0,0,,做些很冷的演出吧
Dialogue: 0,0:17:28.54,0:17:31.79,Default,,0,0,0,,是喔?那零呢?
Dialogue: 0,0:17:32.37,0:17:33.83,Default,,0,0,0,,那傢伙啊
Dialogue: 0,0:17:34.20,0:17:36.37,Default,,0,0,0,,他是阿拉伯的石油大亨喔
Dialogue: 0,0:17:36.37,0:17:37.41,Default,,0,0,0,,啊?
Dialogue: 0,0:17:44.16,0:17:46.79,Default,,0,0,0,,那傢伙一定會說溜嘴的
Dialogue: 0,0:17:46.95,0:17:48.87,Default,,0,0,0,,她怎麼可能守住口風
Dialogue: 0,0:17:48.87,0:17:51.75,Default,,0,0,0,,我看一定全都被拆穿了
Dialogue: 0,0:17:51.75,0:17:53.04,Default,,0,0,0,,天曉得
Dialogue: 0,0:17:53.45,0:17:55.58,Default,,0,0,0,,果然不該這麼做的
Dialogue: 0,0:17:55.58,0:17:57.08,Default,,0,0,0,,太亂來了
Dialogue: 0,0:17:57.08,0:17:59.75,Default,,0,0,0,,我們已經完蛋了
Dialogue: 0,0:17:59.75,0:18:00.75,Default,,0,0,0,,吵死了
Dialogue: 0,0:18:01.83,0:18:03.66,Default,,0,0,0,,這是臉嗎?
Dialogue: 0,0:18:04.00,0:18:05.45,Default,,0,0,0,,這個嘛…
Dialogue: 0,0:18:05.45,0:18:07.58,Default,,0,0,0,,這個是阿一
Dialogue: 0,0:18:07.58,0:18:09.45,Default,,0,0,0,,這一個是零
Dialogue: 0,0:18:09.45,0:18:11.45,Default,,0,0,0,,這是托兒所的功課
Dialogue: 0,0:18:11.45,0:18:12.79,Default,,0,0,0,,要畫爸爸…
Dialogue: 0,0:18:13.00,0:18:14.45,Default,,0,0,0,,不對
Dialogue: 0,0:18:14.45,0:18:16.91,Default,,0,0,0,,是要畫工作的圖
Dialogue: 0,0:18:16.91,0:18:18.45,Default,,0,0,0,,你畫得很好呢
Dialogue: 0,0:18:21.66,0:18:23.16,Default,,0,0,0,,美俐 我問你
Dialogue: 0,0:18:23.16,0:18:24.87,Default,,0,0,0,,你會不會想回家?
Dialogue: 0,0:18:24.87,0:18:26.79,Default,,0,0,0,,不會啊 沒關係
Dialogue: 0,0:18:27.16,0:18:29.83,Default,,0,0,0,,跟不認識的人待在一起
Dialogue: 0,0:18:29.83,0:18:32.12,Default,,0,0,0,,家裡的人不會擔心嗎?
Dialogue: 0,0:18:32.70,0:18:34.41,Default,,0,0,0,,美俐好好的唷
Dialogue: 0,0:18:34.41,0:18:36.20,Default,,0,0,0,,因為有阿一和零
Dialogue: 0,0:18:36.20,0:18:38.58,Default,,0,0,0,,一直陪在我的身邊啊
Dialogue: 0,0:18:38.58,0:18:39.70,Default,,0,0,0,,一直?
Dialogue: 0,0:18:39.70,0:18:40.50,Default,,0,0,0,,對啊
Dialogue: 0,0:18:40.50,0:18:44.04,Default,,0,0,0,,阿一煮的飯超級好吃
Dialogue: 0,0:18:44.04,0:18:47.79,Default,,0,0,0,,零玩遊戲好厲害
Dialogue: 0,0:18:47.79,0:18:51.29,Default,,0,0,0,,大家一起睡覺好溫暖呢
Dialogue: 0,0:18:52.33,0:18:54.75,Default,,0,0,0,,你喜歡他們兩個嗎?
Dialogue: 0,0:18:54.75,0:18:58.41,Default,,0,0,0,,嗯 最喜歡了
Dialogue: 0,0:19:01.37,0:19:02.70,Default,,0,0,0,,我想也是
Dialogue: 0,0:19:06.87,0:19:08.83,Default,,0,0,0,,抱歉 我們晚回來了
Dialogue: 0,0:19:08.83,0:19:09.52,Default,,0,0,0,,辛苦了
Dialogue: 0,0:19:09.52,0:19:10.50,Default,,0,0,0,,孩子呢?
Dialogue: 0,0:19:13.54,0:19:15.37,Default,,0,0,0,,剛剛才睡著而已
Dialogue: 0,0:19:16.41,0:19:17.41,Default,,0,0,0,,謝謝
Dialogue: 0,0:19:20.00,0:19:21.04,Default,,0,0,0,,那個…
Dialogue: 0,0:19:21.04,0:19:24.50,Default,,0,0,0,,那孩子有沒有說什麼奇怪的話?
Dialogue: 0,0:19:24.50,0:19:25.75,Default,,0,0,0,,奇怪的話?
Dialogue: 0,0:19:25.75,0:19:27.29,Default,,0,0,0,,不 沒什麼
Dialogue: 0,0:19:27.29,0:19:29.45,Default,,0,0,0,,沒事的話就好
Dialogue: 0,0:19:31.33,0:19:33.12,Default,,0,0,0,,那麼 回家吧
Dialogue: 0,0:19:34.20,0:19:36.33,Default,,0,0,0,,零爸爸
Dialogue: 0,0:19:46.33,0:19:47.79,Default,,0,0,0,,這傢伙是怎樣?
Dialogue: 0,0:19:47.79,0:19:49.91,Default,,0,0,0,,應該是睡昏頭了吧
Dialogue: 0,0:19:49.91,0:19:53.12,Default,,0,0,0,,一騎爸爸冷場了
Dialogue: 0,0:19:58.00,0:20:00.29,Default,,0,0,0,,那我們等等送她回爸媽…
Dialogue: 0,0:20:00.29,0:20:01.12,Default,,0,0,0,,夠了
Dialogue: 0,0:20:01.12,0:20:02.08,Default,,0,0,0,,什麼?
Dialogue: 0,0:20:02.50,0:20:04.41,Default,,0,0,0,,我全都知道了
Dialogue: 0,0:20:11.32,0:20:13.82,UP,,0,0,0,,（托兒所參觀 親子發表會）
Dialogue: 0,0:20:12.57,0:20:13.82,Default,,0,0,0,,一騎爸爸
Dialogue: 0,0:20:13.95,0:20:17.04,Default,,0,0,0,,謝謝你總是做好吃的飯
Dialogue: 0,0:20:17.04,0:20:18.12,Default,,0,0,0,,零爸爸
Dialogue: 0,0:20:18.12,0:20:21.33,Default,,0,0,0,,下次還要一起玩遊戲喔
Dialogue: 0,0:20:21.75,0:20:24.70,Default,,0,0,0,,當搞笑藝人的一騎爸爸
Dialogue: 0,0:20:24.70,0:20:26.79,Default,,0,0,0,,和石油大亨的零爸爸
Dialogue: 0,0:20:26.79,0:20:28.08,Default,,0,0,0,,我超喜歡的
Dialogue: 0,0:20:29.08,0:20:30.96,Default,,0,0,0,,{\bord0\1c&H000000&\pos(300,650)}似乎年薪很高
Dialogue: 0,0:20:29.33,0:20:30.96,Default,,0,0,0,,{\bord0\1c&H000000&\pos(1425,620)}他們不是搭擋嗎?
Dialogue: 0,0:20:29.58,0:20:30.96,Default,,0,0,0,,{\bord0\1c&H000000&\pos(750,630)}真的嗎?
Dialogue: 0,0:20:29.83,0:20:30.96,Default,,0,0,0,,{\bord0\1c&H000000&\pos(1410,455)}根本是有錢人嘛
Dialogue: 0,0:20:30.08,0:20:30.96,Default,,0,0,0,,{\bord0\1c&H000000&\pos(450,465)}還以為是牛郎
Dialogue: 0,0:20:30.34,0:20:30.96,Default,,0,0,0,,{\bord0\1c&H000000&\pos(1445,255)}藝人也太搞笑
Dialogue: 0,0:20:30.59,0:20:30.96,Default,,0,0,0,,{\bord0\1c&H000000&\pos(440,285)}石油大亨!?
Dialogue: 0,0:20:32.08,0:20:35.12,Default,,0,0,0,,兩位爸爸要保重身體
Dialogue: 0,0:20:35.12,0:20:37.66,Default,,0,0,0,,工作加油喔
Dialogue: 0,0:20:37.66,0:20:39.79,Default,,0,0,0,,- 石油大亨好厲害\N- 哇 是有錢人呢
Dialogue: 0,0:20:39.79,0:20:41.04,Default,,0,0,0,,爸爸
Dialogue: 0,0:20:43.16,0:20:45.54,Default,,0,0,0,,謝謝你的畫 美俐
Dialogue: 0,0:20:45.91,0:20:47.16,Default,,0,0,0,,辛苦了
Dialogue: 0,0:20:50.04,0:20:51.83,Default,,0,0,0,,這是工作的酬勞
Dialogue: 0,0:20:53.04,0:20:55.95,Default,,0,0,0,,這樣就不用再省吃儉用了
Dialogue: 0,0:20:56.20,0:20:58.54,Default,,0,0,0,,不過 阿久你也真壞
Dialogue: 0,0:20:58.54,0:21:01.08,Default,,0,0,0,,全都知道了 還故意不說
Dialogue: 0,0:21:01.08,0:21:04.79,Default,,0,0,0,,任何事都不可能瞞得過我的啊
Dialogue: 0,0:21:04.79,0:21:08.54,Default,,0,0,0,,不過 真的很謝謝你放過我們
Dialogue: 0,0:21:08.54,0:21:12.70,Default,,0,0,0,,要是那孩子會妨礙你們工作
Dialogue: 0,0:21:12.70,0:21:15.50,Default,,0,0,0,,我原本是打算做出處置的
Dialogue: 0,0:21:15.75,0:21:17.16,Default,,0,0,0,,你們應該很清楚
Dialogue: 0,0:21:17.16,0:21:21.66,Default,,0,0,0,,我們從事的是收錢殺人的骯髒交易
Dialogue: 0,0:21:21.95,0:21:24.87,Default,,0,0,0,,收養小孩扮家家酒這種事
Dialogue: 0,0:21:24.87,0:21:27.29,Default,,0,0,0,,世人是不會認可的
Dialogue: 0,0:21:27.91,0:21:32.00,Default,,0,0,0,,做出背叛組織的行為會是什麼下場
Dialogue: 0,0:21:32.16,0:21:33.20,Default,,0,0,0,,零
Dialogue: 0,0:21:33.20,0:21:36.16,Default,,0,0,0,,你最清楚有多可怕吧
Dialogue: 0,0:21:36.87,0:21:41.75,Default,,0,0,0,,更何況 是我們殺了那孩子的父親
Dialogue: 0,0:21:43.58,0:21:44.54,Default,,0,0,0,,然而
Dialogue: 0,0:21:45.58,0:21:47.95,Default,,0,0,0,,上次跟那孩子相處過之後
Dialogue: 0,0:21:48.37,0:21:52.04,Default,,0,0,0,,我好像隱約能理解你們的心情
Dialogue: 0,0:21:52.29,0:21:53.70,Default,,0,0,0,,阿久…
Dialogue: 0,0:21:54.20,0:21:55.66,Default,,0,0,0,,她是個好孩子呢
Dialogue: 0,0:21:55.83,0:21:59.91,Default,,0,0,0,,說不定能為你們帶來某種轉變
Dialogue: 0,0:22:00.08,0:22:02.75,Default,,0,0,0,,不過是好是壞就不知道了
Dialogue: 0,0:22:02.75,0:22:05.50,Default,,0,0,0,,我們…沒有那個意思
Dialogue: 0,0:22:06.08,0:22:08.45,Default,,0,0,0,,我們就算明天喪命也不奇怪
Dialogue: 0,0:22:09.00,0:22:11.79,Default,,0,0,0,,可能遭人憎恨 含怨復仇
Dialogue: 0,0:22:11.79,0:22:15.54,Default,,0,0,0,,甚至有可能危及身邊的人
Dialogue: 0,0:22:17.45,0:22:20.04,Default,,0,0,0,,做好這種心理準備了吧?
Dialogue: 0,0:22:25.58,0:22:27.29,Default,,0,0,0,,千萬別後悔喔
Dialogue: 0,0:22:30.37,0:22:37.75,OPEDJP,,0,0,0,,変わらない光景予想外の 毎日だけど
Dialogue: 0,0:22:37.75,0:22:39.87,OPEDJP,,0,0,0,,それがいいって
Dialogue: 0,0:22:39.87,0:22:44.91,OPEDJP,,0,0,0,,振り回されたり空回って
Dialogue: 0,0:22:44.91,0:22:49.83,OPEDJP,,0,0,0,,目まぐるしく愛おしい日を
Dialogue: 0,0:22:49.83,0:22:52.12,OPEDJP,,0,0,0,,眠れない夜にそっと
Dialogue: 0,0:22:52.12,0:22:54.12,OPEDJP,,0,0,0,,口ずさむ
Dialogue: 0,0:22:54.12,0:22:59.29,OPEDJP,,0,0,0,,子守唄や呼吸に合わせた手
Dialogue: 0,0:22:59.29,0:23:01.79,OPEDJP,,0,0,0,,ただただ一日でも
Dialogue: 0,0:23:01.79,0:23:03.62,OPEDJP,,0,0,0,,この日々が
Dialogue: 0,0:23:03.62,0:23:09.12,OPEDJP,,0,0,0,,長く長く長く長く続くように
Dialogue: 0,0:23:09.12,0:23:14.00,OPEDJP,,0,0,0,,裸足で駆ける君を追った
Dialogue: 0,0:23:14.00,0:23:18.37,OPEDJP,,0,0,0,,いつか僕を超えて Ah
Dialogue: 0,0:23:18.37,0:23:23.08,OPEDJP,,0,0,0,,明日はどんな一日だろうな
Dialogue: 0,0:23:23.08,0:23:27.83,OPEDJP,,0,0,0,,僕ら一緒に歩いてこうか
Dialogue: 0,0:23:27.83,0:23:33.12,OPEDJP,,0,0,0,,いつもここに帰る場所があって
Dialogue: 0,0:23:33.12,0:23:37.41,OPEDJP,,0,0,0,,悲しみも照らすように
Dialogue: 0,0:23:37.41,0:23:39.79,OPEDJP,,0,0,0,,それでもいいか
Dialogue: 0,0:23:39.79,0:23:42.20,OPEDJP,,0,0,0,,それもありかな
Dialogue: 0,0:23:42.20,0:23:47.20,OPEDJP,,0,0,0,,僕らの愛を分かち合おうか
Dialogue: 0,0:23:47.20,0:23:52.45,OPEDJP,,0,0,0,,予想出来ない未来には希望を
Dialogue: 0,0:23:52.45,0:23:57.29,OPEDJP,,0,0,0,,いつまでも照らして
Dialogue: 0,0:22:30.37,0:22:37.75,OPEDCN,,0,0,0,,不變的風景 每天都出乎意料
Dialogue: 0,0:22:37.75,0:22:39.87,OPEDCN,,0,0,0,,但這樣也不錯
Dialogue: 0,0:22:39.87,0:22:44.91,OPEDCN,,0,0,0,,被折騰一番 白忙一場
Dialogue: 0,0:22:44.91,0:22:49.83,OPEDCN,,0,0,0,,過著眼花撩亂 令人疼惜的一天
Dialogue: 0,0:22:49.83,0:22:52.12,OPEDCN,,0,0,0,,在睡不著的夜裡
Dialogue: 0,0:22:52.12,0:22:54.12,OPEDCN,,0,0,0,,輕輕哼唱著
Dialogue: 0,0:22:54.12,0:22:59.29,OPEDCN,,0,0,0,,手配合著搖籃曲和呼吸拍著
Dialogue: 0,0:22:59.29,0:23:01.79,OPEDCN,,0,0,0,,就算只有一天也好
Dialogue: 0,0:23:01.79,0:23:03.62,OPEDCN,,0,0,0,,希望這樣的日子
Dialogue: 0,0:23:03.62,0:23:09.12,OPEDCN,,0,0,0,,能夠持續長長久久
Dialogue: 0,0:23:09.12,0:23:14.00,OPEDCN,,0,0,0,,追逐著赤腳奔跑的你
Dialogue: 0,0:23:14.00,0:23:18.37,OPEDCN,,0,0,0,,總有一天會超越我 Ah
Dialogue: 0,0:23:18.37,0:23:23.08,OPEDCN,,0,0,0,,明天會是怎樣的一天呢?
Dialogue: 0,0:23:23.08,0:23:27.83,OPEDCN,,0,0,0,,我們會一起走下去嗎?
Dialogue: 0,0:23:27.83,0:23:33.12,OPEDCN,,0,0,0,,在這裡永遠有我的歸處
Dialogue: 0,0:23:33.12,0:23:37.41,OPEDCN,,0,0,0,,希望連同悲傷都照亮
Dialogue: 0,0:23:37.41,0:23:39.79,OPEDCN,,0,0,0,,即便如此也可以嗎?
Dialogue: 0,0:23:39.79,0:23:42.20,OPEDCN,,0,0,0,,這樣可能嗎?
Dialogue: 0,0:23:42.20,0:23:47.20,OPEDCN,,0,0,0,,應該分享我們的愛嗎?
Dialogue: 0,0:23:47.20,0:23:52.45,OPEDCN,,0,0,0,,願在不可預知的未來裡
Dialogue: 0,0:23:52.45,0:23:57.29,OPEDCN,,0,0,0,,永遠閃耀著希望

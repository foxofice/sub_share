Dialogue: 0,0:18:10.50,0:18:16.95,Default,,0,0,0,,{\fs50}夢を懸命に追いかける姿
Dialogue: 0,0:18:17.19,0:18:22.61,Default,,0,0,0,,{\fs50}誰も彼も魅了して
Dialogue: 0,0:18:22.78,0:18:28.06,Default,,0,0,0,,{\fs50}心躍るハーモニー
Dialogue: 0,0:18:28.56,0:18:34.20,Default,,0,0,0,,{\fs50}共に歌おう
Dialogue: 0,0:18:46.11,0:18:51.12,Default,,0,0,0,,{\fs50}Amazing！僅かでも煌めく眼差し
Dialogue: 0,0:18:51.29,0:18:53.69,Default,,0,0,0,,{\fs50}その心意気
Dialogue: 0,0:18:53.85,0:18:57.41,Default,,0,0,0,,{\fs50}Amazing！嫌いじゃないさ
Dialogue: 0,0:18:57.57,0:19:01.26,Default,,0,0,0,,{\fs50}もっと教えてくれ
Dialogue: 0,0:19:01.44,0:19:08.48,Default,,0,0,0,,{\fs50}相容れずとも 楽しむのは自由だろう？
Dialogue: 0,0:19:08.65,0:19:13.49,Default,,0,0,0,,{\fs50}純粋な想いほど 眩しくてたまらない
Dialogue: 0,0:19:14.02,0:19:15.30,Default,,0,0,0,,{\fs50}Glowing up！
Dialogue: 0,0:19:15.47,0:19:17.29,Default,,0,0,0,,{\fs50}Let's singing！Show me now！
Dialogue: 0,0:19:17.44,0:19:23.15,Default,,0,0,0,,{\fs50}この熱いひとときが 運命という名のステージなら
Dialogue: 0,0:19:23.33,0:19:30.74,Default,,0,0,0,,{\fs50}誰も咎めやしない 素晴らしいShow time！
Dialogue: 0,0:19:32.15,0:19:34.50,Default,,0,0,0,,{\fs50}存分に輝け
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,
Dialogue: 0,0:18:10.50,0:18:16.95,Default,,0,0,0,,竭尽全力追逐梦想的姿态
Dialogue: 0,0:18:17.19,0:18:22.61,Default,,0,0,0,,魅惑了众人众生
Dialogue: 0,0:18:22.78,0:18:28.06,Default,,0,0,0,,心灵雀跃的和声
Dialogue: 0,0:18:28.56,0:18:34.20,Default,,0,0,0,,一同歌唱吧
Dialogue: 0,0:18:46.11,0:18:51.12,Default,,0,0,0,,惊奇！仅一瞬眼神
Dialogue: 0,0:18:51.29,0:18:53.69,Default,,0,0,0,,你那性情
Dialogue: 0,0:18:53.85,0:18:57.41,Default,,0,0,0,,惊奇！我并不讨厌
Dialogue: 0,0:18:57.57,0:19:01.26,Default,,0,0,0,,让我更了解你
Dialogue: 0,0:19:01.44,0:19:08.48,Default,,0,0,0,,尽管水火不容 但快乐是自由的吧？
Dialogue: 0,0:19:08.65,0:19:13.49,Default,,0,0,0,,你那纯粹的心 太耀眼了无法忍耐
Dialogue: 0,0:19:14.02,0:19:15.30,Default,,0,0,0,,蜕变吧！
Dialogue: 0,0:19:15.47,0:19:17.29,Default,,0,0,0,,让我们闪耀！展现给我看！
Dialogue: 0,0:19:17.44,0:19:23.15,Default,,0,0,0,,这激情一刻 如若在命运舞台上
Dialogue: 0,0:19:23.33,0:19:30.74,Default,,0,0,0,,无人能指责 这精彩的魅力展现！
Dialogue: 0,0:19:32.15,0:19:34.50,Default,,0,0,0,,尽情闪耀吧
Dialogue: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,

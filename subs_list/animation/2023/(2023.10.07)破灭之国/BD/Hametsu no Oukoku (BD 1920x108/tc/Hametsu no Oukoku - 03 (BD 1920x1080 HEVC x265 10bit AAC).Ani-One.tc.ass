Dialogue: 0,0:00:41.29,0:00:42.70,Default,,0,0,0,,多羅卡
Dialogue: 0,0:00:44.08,0:00:45.46,Default,,0,0,0,,米婭姐姐
Dialogue: 0,0:00:45.46,0:00:47.42,Default,,0,0,0,,幸好妳沒事
Dialogue: 0,0:00:47.42,0:00:49.21,Default,,0,0,0,,米婭姐姐
Dialogue: 0,0:00:49.21,0:00:50.55,Default,,0,0,0,,到底發生什麼事了
Dialogue: 0,0:00:51.59,0:00:52.76,Default,,0,0,0,,我也不知道
Dialogue: 0,0:00:53.67,0:00:56.47,Default,,0,0,0,,人類突然對我們發動了攻擊
Dialogue: 0,0:00:56.89,0:00:58.14,Default,,0,0,0,,怎麼會…
Dialogue: 0,0:00:58.14,0:01:01.18,Default,,0,0,0,,一直以來\N我們不是都相處得很融洽嗎
Dialogue: 0,0:01:01.18,0:01:02.81,Default,,0,0,0,,大家還一起去到城市裡
Dialogue: 0,0:01:02.81,0:01:05.35,Default,,0,0,0,,將湯姆先生的病給治好了…
Dialogue: 0,0:01:05.77,0:01:07.52,Default,,0,0,0,,為什麼要做這種事
Dialogue: 0,0:01:07.52,0:01:09.48,Default,,0,0,0,,對了 用魔法…
Dialogue: 0,0:01:09.48,0:01:10.77,Default,,0,0,0,,用不了
Dialogue: 0,0:01:12.90,0:01:15.28,Default,,0,0,0,,那個機械將魔法封住了
Dialogue: 0,0:01:16.28,0:01:18.11,Default,,0,0,0,,那是…什麼
Dialogue: 0,0:01:18.11,0:01:21.49,Default,,0,0,0,,奧菲莉亞大人可能會知道些什麼
Dialogue: 0,0:01:22.24,0:01:23.58,Default,,0,0,0,,多羅卡 妳快逃
Dialogue: 0,0:01:24.45,0:01:27.42,Default,,0,0,0,,妳去通知她 跟奧菲莉亞大人說
Dialogue: 0,0:01:28.08,0:01:29.71,Default,,0,0,0,,讓她知道發生了什麼事
Dialogue: 0,0:01:30.46,0:01:32.30,Default,,0,0,0,,只有我一個人去嗎
Dialogue: 0,0:01:32.30,0:01:33.55,Default,,0,0,0,,我不要
Dialogue: 0,0:01:33.55,0:01:35.38,Default,,0,0,0,,我們一起去吧
Dialogue: 0,0:01:35.38,0:01:37.09,Default,,0,0,0,,照我說的去做
Dialogue: 0,0:01:37.80,0:01:39.97,Default,,0,0,0,,乖…聽話…
Dialogue: 0,0:01:42.97,0:01:44.27,Default,,0,0,0,,米婭姐姐…
Dialogue: 0,0:01:44.85,0:01:46.73,Default,,0,0,0,,妳被他們怎麼了
Dialogue: 0,0:01:46.73,0:01:52.40,Default,,0,0,0,,只要朝著天啟星的方向走\N就能抵達奧菲莉亞的宅邸
Dialogue: 0,0:01:52.40,0:01:54.94,Default,,0,0,0,,我在豐收祭的時候有帶妳去過
Dialogue: 0,0:01:54.94,0:01:56.61,Default,,0,0,0,,妳還記得路吧
Dialogue: 0,0:01:56.61,0:01:57.90,Default,,0,0,0,,多羅卡
Dialogue: 0,0:01:58.49,0:02:00.57,Default,,0,0,0,,妳是個堅強的孩子
Dialogue: 0,0:02:00.57,0:02:03.62,Default,,0,0,0,,全力奔跑的話沒人能追得上妳的
Dialogue: 0,0:02:03.62,0:02:07.58,Default,,0,0,0,,轉眼間就能翻山越嶺的
Dialogue: 0,0:02:07.58,0:02:09.67,Default,,0,0,0,,好了 快去吧
Dialogue: 0,0:02:13.13,0:02:14.05,Default,,0,0,0,,好
Dialogue: 0,0:02:14.50,0:02:17.30,Default,,0,0,0,,不要回頭 向前跑吧
Dialogue: 0,0:02:17.30,0:02:19.80,Default,,0,0,0,,妳真的很堅強
Dialogue: 0,0:02:20.55,0:02:23.47,Default,,0,0,0,,居然逃到這裡來了啊 賤貨
Dialogue: 0,0:02:24.85,0:02:26.85,Default,,0,0,0,,繼續來享樂吧
Dialogue: 0,0:02:52.49,0:02:56.56,OPEDJP,,0,0,0,,記憶たどり歩く
Dialogue: 0,0:02:57.89,0:03:01.94,OPEDJP,,0,0,0,,両手で傷を隠し
Dialogue: 0,0:03:03.10,0:03:05.62,OPEDJP,,0,0,0,,絆されたまま
Dialogue: 0,0:03:05.62,0:03:08.39,OPEDJP,,0,0,0,,沈みゆく世界
Dialogue: 0,0:03:08.84,0:03:13.87,OPEDJP,,0,0,0,,ただ纏う悲しみ
Dialogue: 0,0:03:14.34,0:03:19.60,OPEDJP,,0,0,0,,鍵をかけた心の扉
Dialogue: 0,0:03:19.60,0:03:23.34,OPEDJP,,0,0,0,,浚うなら
Dialogue: 0,0:03:23.68,0:03:29.39,OPEDJP,,0,0,0,,闇を消す正義は
Dialogue: 0,0:03:29.67,0:03:34.71,OPEDJP,,0,0,0,,赤く燃える定めのように
Dialogue: 0,0:03:35.03,0:03:40.12,OPEDJP,,0,0,0,,影を写し　堕ちてゆく
Dialogue: 0,0:03:40.12,0:03:44.68,OPEDJP,,0,0,0,,夜さえ越えて
Dialogue: 0,0:03:44.87,0:03:50.58,OPEDJP,,0,0,0,,追いかけた幻影
Dialogue: 0,0:03:50.84,0:03:55.97,OPEDJP,,0,0,0,,掴んでは消える　一縷の希望
Dialogue: 0,0:03:56.10,0:04:01.19,OPEDJP,,0,0,0,,混ざり燃えて　この業火と
Dialogue: 0,0:04:01.42,0:04:06.09,OPEDJP,,0,0,0,,つれ合い奈落へ
Dialogue: 0,0:04:06.35,0:04:07.92,OPEDJP,,0,0,0,,消えるまで
Dialogue: 0,0:02:52.49,0:02:56.56,OPEDCN,,0,0,0,,追溯記憶而行
Dialogue: 0,0:02:57.89,0:03:01.94,OPEDCN,,0,0,0,,以雙手掩蓋傷口
Dialogue: 0,0:03:03.10,0:03:05.62,OPEDCN,,0,0,0,,依然被牽絆束縛
Dialogue: 0,0:03:05.62,0:03:08.39,OPEDCN,,0,0,0,,逐漸沉淪的世界
Dialogue: 0,0:03:08.84,0:03:13.87,OPEDCN,,0,0,0,,只是沉浸在悲傷中
Dialogue: 0,0:03:14.34,0:03:19.60,OPEDCN,,0,0,0,,上了鎖的心扉
Dialogue: 0,0:03:19.60,0:03:23.34,OPEDCN,,0,0,0,,若要使之敞開
Dialogue: 0,0:03:23.68,0:03:29.39,OPEDCN,,0,0,0,,驅散黑暗的正義
Dialogue: 0,0:03:29.67,0:03:34.71,OPEDCN,,0,0,0,,宛若熾烈燃燒的宿命
Dialogue: 0,0:03:35.03,0:03:40.12,OPEDCN,,0,0,0,,捕捉記憶中的身影　逐漸深陷其中
Dialogue: 0,0:03:40.12,0:03:44.68,OPEDCN,,0,0,0,,比黑夜更為深邃
Dialogue: 0,0:03:44.87,0:03:50.58,OPEDCN,,0,0,0,,追逐著往昔幻影
Dialogue: 0,0:03:50.84,0:03:55.97,OPEDCN,,0,0,0,,每當抓住卻又轉瞬即逝的　一線希望
Dialogue: 0,0:03:56.10,0:04:01.19,OPEDCN,,0,0,0,,與這猛烈燃燒的業火融為一體
Dialogue: 0,0:04:01.42,0:04:06.09,OPEDCN,,0,0,0,,一同墜入地獄深淵
Dialogue: 0,0:04:06.35,0:04:07.92,OPEDCN,,0,0,0,,直到化為烏有
Dialogue: 0,0:04:19.38,0:04:21.84,Default,,0,0,0,,抱歉…
Dialogue: 0,0:04:23.55,0:04:25.80,Default,,0,0,0,,等一下 別就這樣死了
Dialogue: 0,0:04:25.80,0:04:27.26,Default,,0,0,0,,我該怎麼做
Dialogue: 0,0:04:27.26,0:04:29.60,Default,,0,0,0,,要怎麼做才能讓克羅耶復活
Dialogue: 0,0:04:33.69,0:04:35.14,Default,,0,0,0,,聽我說…
Dialogue: 0,0:04:35.77,0:04:36.94,Default,,0,0,0,,魔女是…
Dialogue: 0,0:05:01.09,0:05:03.92,Default,,0,0,0,,妳這個魔女是在開什麼玩笑
Dialogue: 0,0:05:03.92,0:05:06.26,Default,,0,0,0,,說什麼能讓克羅耶復活
Dialogue: 0,0:05:06.26,0:05:07.84,Default,,0,0,0,,妳只說這些…
Dialogue: 0,0:05:07.84,0:05:10.68,Default,,0,0,0,,我怎麼會知道該怎麼做
Dialogue: 0,0:05:14.77,0:05:16.98,Default,,0,0,0,,你死定了 這個惡魔
Dialogue: 0,0:05:20.23,0:05:22.82,Default,,0,0,0,,結束了呢 大和局長
Dialogue: 0,0:05:24.15,0:05:26.70,Default,,0,0,0,,別得意忘形了 人類
Dialogue: 0,0:05:37.58,0:05:39.46,Default,,0,0,0,,開槍 快開槍
Dialogue: 0,0:06:10.20,0:06:11.41,Default,,0,0,0,,反轉
Dialogue: 0,0:06:40.40,0:06:41.65,Default,,0,0,0,,去死吧
Dialogue: 0,0:07:00.62,0:07:02.79,Default,,0,0,0,,書寫式召喚魔法
Dialogue: 0,0:07:13.64,0:07:14.80,Default,,0,0,0,,極大反轉
Dialogue: 0,0:07:15.68,0:07:17.06,Default,,0,0,0,,消失吧
Dialogue: 0,0:07:25.77,0:07:27.48,Default,,0,0,0,,真的死定了
Dialogue: 0,0:07:39.33,0:07:41.41,Default,,0,0,0,,這群無力的蟲子
Dialogue: 0,0:07:42.54,0:07:45.63,Default,,0,0,0,,還真以為打得贏我嗎
Dialogue: 0,0:07:46.29,0:07:48.75,Default,,0,0,0,,以為贏得過魔法嗎
Dialogue: 0,0:07:49.76,0:07:51.84,Default,,0,0,0,,殺死了克羅耶
Dialogue: 0,0:07:51.84,0:07:55.72,Default,,0,0,0,,還以為能夠\N就這樣安穩地活下去嗎
Dialogue: 0,0:07:55.72,0:07:57.18,Default,,0,0,0,,開什麼玩笑
Dialogue: 0,0:07:58.85,0:08:02.10,Default,,0,0,0,,我要一個不剩地\N將你們從地上消滅
Dialogue: 0,0:08:04.65,0:08:06.98,Default,,0,0,0,,體會克羅耶的絕望吧
Dialogue: 0,0:08:07.86,0:08:09.23,Default,,0,0,0,,動作快啊…
Dialogue: 0,0:08:09.90,0:08:10.94,Default,,0,0,0,,雪兒
Dialogue: 0,0:08:14.95,0:08:17.16,Default,,0,0,0,,這就是DAM…
Dialogue: 0,0:08:17.58,0:08:20.83,Default,,0,0,0,,過去打敗魔女的科學結晶
Dialogue: 0,0:08:21.50,0:08:25.42,Default,,0,0,0,,只要啟動它\N就能封住那個傢伙的魔法
Dialogue: 0,0:08:26.42,0:08:28.00,Default,,0,0,0,,我終於…
Dialogue: 0,0:08:29.42,0:08:32.55,Default,,0,0,0,,能夠幫上哥哥的忙了
Dialogue: 0,0:08:37.85,0:08:39.60,Default,,0,0,0,,動作還不快點 你們幾個
Dialogue: 0,0:08:39.60,0:08:41.52,Default,,0,0,0,,抱…抱歉…
Dialogue: 0,0:08:42.68,0:08:47.06,Default,,0,0,0,,我就知道血氣方剛的保安局\N一定會到這裡來
Dialogue: 0,0:08:47.06,0:08:48.48,Default,,0,0,0,,妳是…
Dialogue: 0,0:08:48.97,0:08:52.22,Screen,,0,0,0,,{\blur3\fad(450,0)\pos(960,870)}利迪亞帝國 國家四局之一 國家科學局
Dialogue: 0,0:08:52.51,0:08:56.47,Screen,,0,0,0,,{\blur3\fad(450,450)\pos(960,1060)}西塔·薩曼斯塔
Dialogue: 0,0:08:52.78,0:08:57.08,UP,,0,0,0,,小雪 一陣子沒見 妳長大了不少呢
Dialogue: 0,0:08:58.07,0:09:01.89,Default,,0,0,0,,很遺憾 我不能讓你們啟動這個裝置
Dialogue: 0,0:09:04.00,0:09:06.08,Default,,0,0,0,,這是怎麼回事
Dialogue: 0,0:09:07.17,0:09:08.96,Default,,0,0,0,,請妳解釋一下
Dialogue: 0,0:09:12.74,0:09:14.99,Default,,0,0,0,,（雪兒來電）
Dialogue: 0,0:09:17.05,0:09:18.34,Default,,0,0,0,,怎麼了 雪兒
Dialogue: 0,0:09:18.34,0:09:20.10,Default,,0,0,0,,還沒啟動裝置嗎
Dialogue: 0,0:09:20.81,0:09:24.81,Default,,0,0,0,,你們現在就是熱鍋上的螞蟻吧
Dialogue: 0,0:09:24.81,0:09:27.27,Default,,0,0,0,,這個聲音 妳是西塔局長
Dialogue: 0,0:09:27.27,0:09:29.19,Default,,0,0,0,,可以聊聊嗎
Dialogue: 0,0:09:30.48,0:09:32.23,Default,,0,0,0,,沒那個時間
Dialogue: 0,0:09:33.40,0:09:35.86,Default,,0,0,0,,現在狀況刻不容緩
Dialogue: 0,0:09:35.86,0:09:40.07,Default,,0,0,0,,- 我的手機\N- 別那麼著急 大和局長
Dialogue: 0,0:09:41.58,0:09:44.79,Default,,0,0,0,,不能啟動魔法光子抑制裝置
Dialogue: 0,0:09:46.37,0:09:47.75,Default,,0,0,0,,為什麼
Dialogue: 0,0:09:48.29,0:09:52.46,Default,,0,0,0,,科學是人類為世界帶來光明之物
Dialogue: 0,0:09:56.35,0:10:00.26,Default,,0,0,0,,然而掌握了科學 這個世界對我們來說
Dialogue: 0,0:09:57.79,0:10:03.79,UP,,0,0,0,,（哥哥 通話中）
Dialogue: 0,0:10:00.26,0:10:03.30,Default,,0,0,0,,尚有許多未知領域也是不爭的事實
Dialogue: 0,0:10:07.60,0:10:11.77,Default,,0,0,0,,而魔法光子抑制裝置所散發出來的\N"科學粒子"就是其中之一
Dialogue: 0,0:10:12.52,0:10:14.32,Default,,0,0,0,,那是什麼
Dialogue: 0,0:10:14.82,0:10:17.36,Default,,0,0,0,,"人體細胞機能喪失症"
Dialogue: 0,0:10:17.95,0:10:19.11,Default,,0,0,0,,你有聽說過嗎
Dialogue: 0,0:10:20.20,0:10:25.16,Default,,0,0,0,,是10年前參加過魔女狩獵的士兵\N罹患的病症
Dialogue: 0,0:10:25.66,0:10:27.37,Default,,0,0,0,,那到底是什麼
Dialogue: 0,0:10:27.37,0:10:31.33,Default,,0,0,0,,雖然影響的要素很多\N所以還無法斷定
Dialogue: 0,0:10:31.33,0:10:36.09,Default,,0,0,0,,但我們認為是這個"科學粒子"\N對人體所造成的影響
Dialogue: 0,0:10:43.72,0:10:46.27,Default,,0,0,0,,這個裝置會殺死細胞
Dialogue: 0,0:10:47.06,0:10:48.77,Default,,0,0,0,,這我還是第一次聽說
Dialogue: 0,0:10:50.35,0:10:52.44,Default,,0,0,0,,因為消息被壓了下來
Dialogue: 0,0:10:56.11,0:10:57.53,Default,,0,0,0,,很不巧的
Dialogue: 0,0:10:57.94,0:11:02.03,Default,,0,0,0,,這個世界\N已經沒有能修復大自然的魔女了
Dialogue: 0,0:11:02.70,0:11:06.08,Default,,0,0,0,,能淨化這有害光線的大氣\N已經不存在了
Dialogue: 0,0:11:08.00,0:11:10.87,Default,,0,0,0,,我們失去了大自然的恩寵
Dialogue: 0,0:11:10.87,0:11:14.42,Default,,0,0,0,,如果人體在這種環境下\N暴露在大量這種光線裡的話…
Dialogue: 0,0:11:15.09,0:11:16.92,Default,,0,0,0,,肉體將會崩潰
Dialogue: 0,0:11:17.59,0:11:19.30,Default,,0,0,0,,居然有這種事…
Dialogue: 0,0:11:20.76,0:11:23.30,Default,,0,0,0,,過去為了人類而戰
Dialogue: 0,0:11:23.30,0:11:26.85,Default,,0,0,0,,持續站在這個裝置前的那位大人\N他的現況如何
Dialogue: 0,0:11:27.64,0:11:29.56,Default,,0,0,0,,你不會不知道吧
Dialogue: 0,0:11:30.98,0:11:34.27,Default,,0,0,0,,那麼…陛下的病是因為…
Dialogue: 0,0:11:57.38,0:12:00.51,Default,,0,0,0,,好了 明白的話就回去吧
Dialogue: 0,0:12:02.43,0:12:03.51,Default,,0,0,0,,小雪
Dialogue: 0,0:12:09.43,0:12:10.47,Default,,0,0,0,,小雪
Dialogue: 0,0:12:10.89,0:12:12.18,Default,,0,0,0,,站住
Dialogue: 0,0:12:12.69,0:12:15.44,Default,,0,0,0,,現在哪有時間去管會不會生病
Dialogue: 0,0:12:16.90,0:12:19.69,Default,,0,0,0,,魔法的威脅就在眼前啊
Dialogue: 0,0:12:20.36,0:12:24.11,Default,,0,0,0,,雪兒 那邊就交給妳了\N這是國家的要務
Dialogue: 0,0:12:24.11,0:12:25.20,Default,,0,0,0,,是
Dialogue: 0,0:12:29.20,0:12:30.66,Default,,0,0,0,,全體撤離
Dialogue: 0,0:12:30.66,0:12:31.87,Default,,0,0,0,,動作快
Dialogue: 0,0:12:33.33,0:12:35.42,Default,,0,0,0,,小雪 等等
Dialogue: 0,0:12:35.42,0:12:37.25,Default,,0,0,0,,妳也聽到我們的對話了吧
Dialogue: 0,0:12:38.17,0:12:39.80,Default,,0,0,0,,不能啟動它
Dialogue: 0,0:12:39.80,0:12:41.67,Default,,0,0,0,,那怕是只有短暫照射也會出事的
Dialogue: 0,0:12:42.47,0:12:43.72,Default,,0,0,0,,小雪
Dialogue: 0,0:12:44.30,0:12:46.05,Default,,0,0,0,,這是國家要務
Dialogue: 0,0:12:46.62,0:12:49.08,UP,,0,0,0,,（魔法無效化啟動）
Dialogue: 0,0:12:48.05,0:12:48.92,Default,,0,0,0,,哥哥
Dialogue: 0,0:13:11.95,0:13:14.00,Default,,0,0,0,,目標的羽毛筆掉了
Dialogue: 0,0:13:14.00,0:13:15.16,Default,,0,0,0,,局長
Dialogue: 0,0:13:16.46,0:13:19.04,Default,,0,0,0,,發生什麼事了 西塔局長
Dialogue: 0,0:13:19.04,0:13:20.29,Default,,0,0,0,,雪兒呢
Dialogue: 0,0:13:22.55,0:13:24.76,Default,,0,0,0,,什麼事…也沒有
Dialogue: 0,0:13:25.88,0:13:27.68,Default,,0,0,0,,不用擔心這裡…
Dialogue: 0,0:13:28.84,0:13:30.64,Default,,0,0,0,,雪兒她做了什麼嗎
Dialogue: 0,0:13:31.14,0:13:32.26,Default,,0,0,0,,難道說…
Dialogue: 0,0:13:32.26,0:13:34.64,Default,,0,0,0,,看著前方 大和弟弟
Dialogue: 0,0:13:37.65,0:13:40.77,Default,,0,0,0,,要是沒有魔法抑制裝置\N你就打不贏他嗎
Dialogue: 0,0:13:40.77,0:13:43.19,Default,,0,0,0,,那種小鬼會讓我們感到棘手嗎
Dialogue: 0,0:13:44.28,0:13:46.53,Default,,0,0,0,,什麼是你該做的事
Dialogue: 0,0:13:47.45,0:13:51.16,Default,,0,0,0,,排除一切欲加害帝國之人
Dialogue: 0,0:13:51.62,0:13:52.58,Default,,0,0,0,,沒錯
Dialogue: 0,0:13:53.37,0:13:55.04,Default,,0,0,0,,我們是利迪亞
Dialogue: 0,0:13:55.54,0:13:57.25,Default,,0,0,0,,是不滅的王國
Dialogue: 0,0:14:00.96,0:14:03.25,Default,,0,0,0,,全體突擊
Dialogue: 0,0:14:13.31,0:14:14.64,Default,,0,0,0,,舉槍
Dialogue: 0,0:14:16.48,0:14:18.19,Default,,0,0,0,,不要闖進彈道啊
Dialogue: 0,0:14:20.86,0:14:23.15,Default,,0,0,0,,竟敢將我們的國家…
Dialogue: 0,0:14:23.15,0:14:24.98,Default,,0,0,0,,不要隨便靠近他…
Dialogue: 0,0:14:39.08,0:14:41.00,Default,,0,0,0,,熱化學刺刀啟動
Dialogue: 0,0:14:42.79,0:14:45.46,Default,,0,0,0,,什麼魔女弟子
Dialogue: 0,0:14:47.97,0:14:49.13,Default,,0,0,0,,我要死了嗎…
Dialogue: 0,0:14:50.59,0:14:52.01,Default,,0,0,0,,我能死了嗎…
Dialogue: 0,0:14:52.68,0:14:53.72,Default,,0,0,0,,這樣一來…
Dialogue: 0,0:14:54.89,0:14:56.39,Default,,0,0,0,,我終於能夠…
Dialogue: 0,0:14:57.10,0:14:58.43,Default,,0,0,0,,去到妳的身邊了…
Dialogue: 0,0:15:13.03,0:15:14.91,Default,,0,0,0,,那名士兵沒事吧
Dialogue: 0,0:15:14.91,0:15:16.99,Default,,0,0,0,,煙霧太大 看不清楚
Dialogue: 0,0:15:17.54,0:15:19.33,Default,,0,0,0,,喂 你看
Dialogue: 0,0:15:28.96,0:15:31.84,Default,,0,0,0,,我成功了…
Dialogue: 0,0:15:33.97,0:15:35.80,Default,,0,0,0,,我把魔女弟子給…
Dialogue: 0,0:15:46.27,0:15:47.61,Default,,0,0,0,,好啊
Dialogue: 0,0:15:47.61,0:15:49.78,Default,,0,0,0,,他死了
Dialogue: 0,0:15:49.78,0:15:51.65,Default,,0,0,0,,妳是哪個單位的
Dialogue: 0,0:15:51.65,0:15:53.49,Default,,0,0,0,,妳立了大功呢
Dialogue: 0,0:15:53.49,0:15:56.45,Default,,0,0,0,,打倒魔女弟子了嗎
Dialogue: 0,0:15:56.45,0:15:58.37,Default,,0,0,0,,這就是利迪亞的力量
Dialogue: 0,0:15:58.37,0:16:00.04,Default,,0,0,0,,你活該啦
Dialogue: 0,0:16:06.13,0:16:07.96,Default,,0,0,0,,我是保安局的大和
Dialogue: 0,0:16:07.96,0:16:09.84,Default,,0,0,0,,各部隊辛苦了
Dialogue: 0,0:16:10.42,0:16:12.59,Default,,0,0,0,,我們終於將魔女弟子給擊斃
Dialogue: 0,0:16:13.51,0:16:15.76,Default,,0,0,0,,但現在要歡呼還言之過早
Dialogue: 0,0:16:16.39,0:16:21.60,Default,,0,0,0,,馬上回收他的屍體\N以及確認首都各區的災情
Dialogue: 0,0:16:22.27,0:16:26.86,Default,,0,0,0,,還有跟救護部隊會合\N支援他們進行救災
Dialogue: 0,0:16:28.61,0:16:30.65,Default,,0,0,0,,打倒他的就是這名士兵嗎
Dialogue: 0,0:16:31.57,0:16:33.15,Default,,0,0,0,,真是年輕
Dialogue: 0,0:16:33.15,0:16:35.49,Default,,0,0,0,,應該是機甲部隊的新兵
Dialogue: 0,0:16:36.12,0:16:37.91,Default,,0,0,0,,- 我查一下\N- 不用了
Dialogue: 0,0:16:38.74,0:16:42.79,Default,,0,0,0,,去確認西塔局長\N和雪兒副局長的狀況
Dialogue: 0,0:16:42.79,0:16:43.71,Default,,0,0,0,,馬上去
Dialogue: 0,0:16:43.71,0:16:44.67,Default,,0,0,0,,是
Dialogue: 0,0:16:45.87,0:16:47.84,Default,,0,0,0,,妳說得沒錯
Dialogue: 0,0:16:47.84,0:16:49.29,Default,,0,0,0,,西塔局長
Dialogue: 0,0:16:50.34,0:16:54.09,Default,,0,0,0,,我們這個國家依然穩如泰山
Dialogue: 0,0:17:03.98,0:17:06.35,Default,,0,0,0,,魔法仍然殘存於世
Dialogue: 0,0:17:07.23,0:17:11.28,Default,,0,0,0,,這個世界還存在那種禁忌之術
Dialogue: 0,0:17:12.23,0:17:17.95,Default,,0,0,0,,把10年前從魔女手中抓來的少年\N放了出來
Dialogue: 0,0:17:17.95,0:17:20.53,Default,,0,0,0,,導致了這場慘絕人寰的慘劇
Dialogue: 0,0:17:21.58,0:17:23.12,Default,,0,0,0,,是一種"災厄"
Dialogue: 0,0:17:23.75,0:17:26.25,Default,,0,0,0,,永久禁閉人犯
Dialogue: 0,0:17:26.25,0:17:28.79,Default,,0,0,0,,魔女弟子 阿德尼斯
Dialogue: 0,0:17:29.63,0:17:32.38,Default,,0,0,0,,是雖然與我們同為人類
Dialogue: 0,0:17:32.38,0:17:35.59,Default,,0,0,0,,卻被魔法所蠱惑的惡魔
Dialogue: 0,0:17:35.59,0:17:38.89,Default,,0,0,0,,是邪惡的舊世界餘孽
Dialogue: 0,0:17:38.89,0:17:43.64,Default,,0,0,0,,他是如何以人類之軀操縱魔法
Dialogue: 0,0:17:43.64,0:17:48.06,Default,,0,0,0,,我們花了10年歲月\N也未能找到答案
Dialogue: 0,0:17:48.77,0:17:51.40,Default,,0,0,0,,但現在回想起來
Dialogue: 0,0:17:51.40,0:17:53.15,Default,,0,0,0,,就是當初留他一命
Dialogue: 0,0:17:53.15,0:17:56.86,Default,,0,0,0,,才導致了今天這種令人扼腕的結果
Dialogue: 0,0:17:56.86,0:17:59.36,Default,,0,0,0,,不過帝國的子民們
Dialogue: 0,0:17:59.36,0:18:01.66,Default,,0,0,0,,不用過分憂慮
Dialogue: 0,0:18:01.66,0:18:05.70,Default,,0,0,0,,這裡是利迪亞 是世界的頂點
Dialogue: 0,0:18:05.70,0:18:08.42,Default,,0,0,0,,我們掌握了科學之力
Dialogue: 0,0:18:08.42,0:18:11.38,Default,,0,0,0,,以及擁有心懷鋼鐵精神的軍隊
Dialogue: 0,0:18:11.38,0:18:14.51,Default,,0,0,0,,絕不會屈服於任何邪惡
Dialogue: 0,0:18:14.51,0:18:18.05,Default,,0,0,0,,將生為利迪亞人視為榮耀
Dialogue: 0,0:18:18.38,0:18:23.56,Default,,0,0,0,,讓這榮耀之火點亮我們的內心吧
Dialogue: 0,0:18:23.56,0:18:26.06,Default,,0,0,0,,舊世界已經謝幕
Dialogue: 0,0:18:26.06,0:18:27.98,Default,,0,0,0,,神也已死
Dialogue: 0,0:18:27.98,0:18:31.06,Default,,0,0,0,,現在這個國家才是神
Dialogue: 0,0:18:32.51,0:18:34.05,Default,,0,0,0,,（災厄慰靈演講 利迪亞帝國 凱特皇帝陛下）
Dialogue: 0,0:18:43.28,0:18:46.79,Default,,0,0,0,,本校也有幾名學生罹難
Dialogue: 0,0:18:46.79,0:18:48.66,Default,,0,0,0,,我明白這很令人難過
Dialogue: 0,0:18:49.12,0:18:51.00,Default,,0,0,0,,但明天開始就是全國模擬考了
Dialogue: 0,0:18:51.00,0:18:52.46,Default,,0,0,0,,大家要打起精神來
Dialogue: 0,0:18:52.46,0:18:54.13,Default,,0,0,0,,明白嗎
Dialogue: 0,0:18:54.13,0:18:56.26,Default,,0,0,0,,那班會就此結束
Dialogue: 0,0:18:56.26,0:18:57.80,Default,,0,0,0,,老師
Dialogue: 0,0:18:57.80,0:19:01.47,Default,,0,0,0,,他明明是人類\N為什麼要站在魔女那一邊呢
Dialogue: 0,0:19:01.47,0:19:03.18,Default,,0,0,0,,就是那個"魔女弟子"
Dialogue: 0,0:19:03.18,0:19:04.51,Default,,0,0,0,,不知道
Dialogue: 0,0:19:04.51,0:19:06.35,Default,,0,0,0,,可能是被洗腦了吧
Dialogue: 0,0:19:07.98,0:19:10.77,Default,,0,0,0,,第一節是體育課 快去把衣服換好吧
Dialogue: 0,0:19:17.86,0:19:19.78,Default,,0,0,0,,我都看到了
Dialogue: 0,0:19:21.41,0:19:22.82,Default,,0,0,0,,我看到了
Dialogue: 0,0:19:23.57,0:19:24.74,Default,,0,0,0,,什麼
Dialogue: 0,0:19:24.74,0:19:27.29,Default,,0,0,0,,妳是怎樣 關妳什麼事
Dialogue: 0,0:19:27.29,0:19:29.25,Default,,0,0,0,,那種情況下 那麼做很正常吧
Dialogue: 0,0:19:30.04,0:19:32.12,Default,,0,0,0,,惠理 我們快走吧
Dialogue: 0,0:19:32.12,0:19:34.75,Default,,0,0,0,,體育課要是遲到了\N山根可是很囉嗦的
Dialogue: 0,0:19:41.97,0:19:43.54,Default,,0,0,0,,去死啦 醜女
Dialogue: 0,0:19:43.95,0:19:46.71,Default,,0,0,0,,（禁止進入）
Dialogue: 0,0:19:56.11,0:19:57.65,Default,,0,0,0,,說什麼"災厄"
Dialogue: 0,0:19:58.36,0:20:00.40,Default,,0,0,0,,就不能把國民好好保護好嗎
Dialogue: 0,0:20:02.53,0:20:04.45,Default,,0,0,0,,抱歉 拓真
Dialogue: 0,0:20:05.74,0:20:08.08,Default,,0,0,0,,你一定很恨我吧
Dialogue: 0,0:20:08.08,0:20:10.45,Default,,0,0,0,,惠理…
Dialogue: 0,0:20:10.45,0:20:13.42,Default,,0,0,0,,惠理 糟了 快拉我出去
Dialogue: 0,0:20:13.42,0:20:15.96,Default,,0,0,0,,等等… 你在做什麼 拓真
Dialogue: 0,0:20:19.92,0:20:21.05,Default,,0,0,0,,惠理
Dialogue: 0,0:20:21.92,0:20:23.47,Default,,0,0,0,,真的很抱歉
Dialogue: 0,0:20:25.34,0:20:26.85,Default,,0,0,0,,等一下 惠理
Dialogue: 0,0:20:26.85,0:20:28.39,Default,,0,0,0,,妳要見死不救嗎
Dialogue: 0,0:20:28.39,0:20:32.60,Default,,0,0,0,,那時可是妳先對我告白的啊
Dialogue: 0,0:20:40.78,0:20:42.78,Default,,0,0,0,,我真是爛透了
Dialogue: 0,0:20:44.82,0:20:46.95,Default,,0,0,0,,明明對自己的男朋友見死不救
Dialogue: 0,0:20:47.95,0:20:50.62,Default,,0,0,0,,現在卻覺得這個操縱魔法的人
Dialogue: 0,0:20:53.87,0:20:55.04,Default,,0,0,0,,好像有點帥…
Dialogue: 0,0:20:55.04,0:20:56.21,Default,,0,0,0,,真是罪過
Dialogue: 0,0:20:59.92,0:21:02.46,Default,,0,0,0,,抱歉…嚇到妳了
Dialogue: 0,0:21:04.05,0:21:05.59,Default,,0,0,0,,是政府的人…
Dialogue: 0,0:21:08.43,0:21:11.18,Default,,0,0,0,,沒事的 妳可以不用刪掉
Dialogue: 0,0:21:11.18,0:21:13.27,Default,,0,0,0,,妳不是很喜歡那張照片嗎
Dialogue: 0,0:21:13.89,0:21:16.56,Default,,0,0,0,,但是不能跟任何人說喔
Dialogue: 0,0:21:16.56,0:21:20.02,Default,,0,0,0,,畢竟魔女弟子\N可是那場災厄的大罪人呢
Dialogue: 0,0:21:21.57,0:21:23.44,Default,,0,0,0,,不用這麼害怕啦
Dialogue: 0,0:21:23.44,0:21:25.24,Default,,0,0,0,,我不會去告狀的
Dialogue: 0,0:21:25.24,0:21:27.61,Default,,0,0,0,,是…很抱歉
Dialogue: 0,0:21:27.61,0:21:29.87,Default,,0,0,0,,我…我先走了
Dialogue: 0,0:21:29.87,0:21:30.95,Default,,0,0,0,,好
Dialogue: 0,0:21:34.16,0:21:36.25,Default,,0,0,0,,是我 奧茨
Dialogue: 0,0:21:37.12,0:21:40.29,Default,,0,0,0,,現在從6之2區\N往格蘭街跑去的女高中生
Dialogue: 0,0:21:40.71,0:21:43.30,Default,,0,0,0,,似乎被恐怖分子所感化了
Dialogue: 0,0:21:44.05,0:21:45.47,Default,,0,0,0,,把她抓起來吧
Dialogue: 0,0:21:46.97,0:21:48.34,Default,,0,0,0,,不知道
Dialogue: 0,0:21:48.34,0:21:51.10,Default,,0,0,0,,之後交給保安局處理就行了
Dialogue: 0,0:21:51.10,0:21:55.43,Default,,0,0,0,,以叛國罪處刑或是送往收容所吧
Dialogue: 0,0:21:55.43,0:21:56.64,Default,,0,0,0,,奧茨主幹
Dialogue: 0,0:21:56.64,0:21:58.35,Default,,0,0,0,,原來您在這裡
Dialogue: 0,0:21:59.60,0:22:01.94,Default,,0,0,0,,最終檢查完成了
Dialogue: 0,0:22:02.73,0:22:05.11,Default,,0,0,0,,那我現在要回去了
Dialogue: 0,0:22:06.90,0:22:09.45,UP,,0,0,0,,災區視察還挺累人的
Dialogue: 0,0:22:07.31,0:22:10.02,Screen,,0,0,0,,{\blur3\fad(450,0)\pos(960,1060)}奧茨·葛賈斯主幹
Dialogue: 0,0:22:10.12,0:22:12.78,Default,,0,0,0,,回去後能給我個抱抱親親嗎
Dialogue: 0,0:22:13.99,0:22:15.37,Default,,0,0,0,,嘉米女士
Dialogue: 0,0:22:16.54,0:22:17.66,Default,,0,0,0,,奧茨主幹
Dialogue: 0,0:22:18.62,0:22:22.79,Default,,0,0,0,,你也差不多\N該受理我的調職申請了吧
Dialogue: 0,0:22:22.79,0:22:26.09,Default,,0,0,0,,不然我真的會向勞基署發告你喔
Dialogue: 0,0:22:26.80,0:22:29.80,Default,,0,0,0,,揭露你是個每天要求超時工作\N還會對人職權騷擾的上司
Dialogue: 0,0:22:29.80,0:22:33.15,Default,,0,0,0,,為什麼就只有我們這個單位的\N工作環境特別惡劣
Dialogue: 0,0:22:34.26,0:22:35.47,UP,,0,0,0,,對了 還有一點
Dialogue: 0,0:22:33.83,0:22:38.55,Screen,,0,0,0,,{\blur3\fad(450,0)\pos(960,1060)}嘉米主查
Dialogue: 0,0:22:35.47,0:22:38.06,UP,,0,0,0,,剛剛有個很糟的分析結果出來了
Dialogue: 0,0:22:38.55,0:22:40.69,UP,,0,0,0,,請趕緊回來吧
Dialogue: 0,0:22:40.69,0:22:42.06,UP,,0,0,0,,麻煩你了
Dialogue: 0,0:22:42.06,0:22:44.94,Default,,0,0,0,,好 能先把結論告訴我嗎
Dialogue: 0,0:22:44.94,0:22:46.28,Default,,0,0,0,,瞭解
Dialogue: 0,0:22:48.74,0:22:50.78,Default,,0,0,0,,關於那個魔女弟子的屍體
Dialogue: 0,0:22:51.70,0:22:53.08,Default,,0,0,0,,是個仿造品
Dialogue: 0,0:23:12.62,0:23:16.51,OPEDJP,,0,0,0,,小さな幸せ胸に隠して
Dialogue: 0,0:23:16.51,0:23:20.44,OPEDJP,,0,0,0,,壊れないようにそっと温めた
Dialogue: 0,0:23:20.44,0:23:24.20,OPEDJP,,0,0,0,,戻らない日々が瞬くたびに
Dialogue: 0,0:23:24.33,0:23:29.62,OPEDJP,,0,0,0,,痛みが波打つように覆いかかる
Dialogue: 0,0:23:29.62,0:23:37.15,OPEDJP,,0,0,0,,奪った分だけ　奪い返されるなら
Dialogue: 0,0:23:37.48,0:23:44.51,OPEDJP,,0,0,0,,託した願いが　願いを繋ぐように
Dialogue: 0,0:23:44.51,0:23:53.06,OPEDJP,,0,0,0,,どうか怒りも涙も　叫んで
Dialogue: 0,0:23:53.06,0:23:59.08,OPEDJP,,0,0,0,,ひとり絡まって　二度と戻れなくなる前に
Dialogue: 0,0:23:59.08,0:24:08.54,OPEDJP,,0,0,0,,どんな痛みも　消し去ることのできない思い出も
Dialogue: 0,0:24:08.68,0:24:18.50,OPEDJP,,0,0,0,,もう譲ることなく　ただ振り上げたその手に触れて
Dialogue: 0,0:24:19.89,0:24:24.25,OPEDJP,,0,0,0,,結ぶ指で祈りをそっと
Dialogue: 0,0:23:12.62,0:23:16.51,OPEDCN,,0,0,0,,將微小的幸福珍藏於心
Dialogue: 0,0:23:16.51,0:23:20.44,OPEDCN,,0,0,0,,害怕會破碎而小心呵護著
Dialogue: 0,0:23:20.44,0:23:24.20,OPEDCN,,0,0,0,,每當不願回想的往昔湧上心頭
Dialogue: 0,0:23:24.33,0:23:29.62,OPEDCN,,0,0,0,,痛楚就如浪潮般一波一波地襲來
Dialogue: 0,0:23:29.62,0:23:37.15,OPEDCN,,0,0,0,,若是能奪回　那些被奪走的一切
Dialogue: 0,0:23:37.48,0:23:44.51,OPEDCN,,0,0,0,,願你託付給我的心願　仍連繫著我的願望
Dialogue: 0,0:23:44.51,0:23:53.06,OPEDCN,,0,0,0,,請將怒火和淚水　都發泄出來吧
Dialogue: 0,0:23:53.06,0:23:59.08,OPEDCN,,0,0,0,,在一個人心亂如麻　變得無法再回頭之前
Dialogue: 0,0:23:59.08,0:24:08.54,OPEDCN,,0,0,0,,無論是痛苦　抑或那些無法盡數抹去的記憶
Dialogue: 0,0:24:08.68,0:24:18.50,OPEDCN,,0,0,0,,並非是已經妥協　只不過是要去觸碰那雙高舉的手
Dialogue: 0,0:24:19.89,0:24:24.25,OPEDCN,,0,0,0,,用十指緊扣的手指靜靜地祈禱
Dialogue: 0,0:22:53.08,0:22:56.08,Default,,0,0,0,,

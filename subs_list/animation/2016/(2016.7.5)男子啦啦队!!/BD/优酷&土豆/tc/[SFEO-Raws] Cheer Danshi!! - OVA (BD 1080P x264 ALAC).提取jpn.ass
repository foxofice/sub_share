Dialogue: 0,0:01:37.40,0:01:38.56,Default,,0,0,0,,今日の説明会
Dialogue: 0,0:01:38.86,0:01:39.33,Default,,0,0,0,,入部
Dialogue: 0,0:01:39.33,0:01:40.96,Default,,0,0,0,,希望者は何人来るかな
Dialogue: 0,0:01:41.40,0:01:43.10,Default,,0,0,0,,結構手応えあったじゃん
Dialogue: 0,0:01:43.70,0:01:44.73,Default,,0,0,0,,期待できるかも
Dialogue: 0,0:01:45.33,0:01:46.40,Default,,0,0,0,,たくさんチラシ
Dialogue: 0,0:01:46.53,0:01:47.36,Default,,0,0,0,,負けたもんね
Dialogue: 0,0:01:47.60,0:01:48.40,Default,,0,0,0,,金さんと
Dialogue: 0,0:01:48.53,0:01:50.50,Default,,0,0,0,,鍋島の兄ちゃんさんが抜けた分
Dialogue: 0,0:01:50.66,0:01:52.33,Default,,0,0,0,,せめて二人は入ってほしい
Dialogue: 0,0:01:52.66,0:01:53.50,Default,,0,0,0,,せやけど
Dialogue: 0,0:01:53.70,0:01:55.86,Default,,0,0,0,,入ってくる年も男ばっかやろ
Dialogue: 0,0:01:56.26,0:01:58.20,Default,,0,0,0,,可愛い女子マネージャーも募集
Dialogue: 0,0:01:58.46,0:02:00.33,Default,,0,0,0,,って書いとったらよかったなあ
Dialogue: 0,0:02:06.06,0:02:06.73,Default,,0,0,0,,なんだよ
Dialogue: 0,0:02:06.73,0:02:07.46,Default,,0,0,0,,溝口
Dialogue: 0,0:02:07.46,0:02:08.50,Default,,0,0,0,,暗い顔して
Dialogue: 0,0:02:10.00,0:02:10.80,Default,,0,0,0,,俺は
Dialogue: 0,0:02:11.20,0:02:12.20,Default,,0,0,0,,男子チア部
Dialogue: 0,0:02:12.33,0:02:13.56,Default,,0,0,0,,をやめるえ
Dialogue: 0,0:02:14.26,0:02:15.06,Default,,0,0,0,,何
Dialogue: 0,0:02:15.20,0:02:17.10,Default,,0,0,0,,今聞こえなかったんだけど
Dialogue: 0,0:02:17.53,0:02:18.33,Default,,0,0,0,,溝口
Dialogue: 0,0:02:18.53,0:02:19.93,Default,,0,0,0,,チア部やめるってよ
Dialogue: 0,0:02:20.00,0:02:20.80,Default,,0,0,0,,マジか
Dialogue: 0,0:02:21.53,0:02:22.76,Default,,0,0,0,,どうしたんだ一体
Dialogue: 0,0:02:24.36,0:02:25.66,Default,,0,0,0,,聞いてしまったんだ
Dialogue: 0,0:02:26.56,0:02:27.20,Default,,0,0,0,,俺たちの
Dialogue: 0,0:02:27.20,0:02:29.00,Default,,0,0,0,,デモンストレーションを見た
Dialogue: 0,0:02:29.26,0:02:31.56,Default,,0,0,0,,ナイスなうなじとふくらはぎを持つ
Dialogue: 0,0:02:31.70,0:02:32.30,Default,,0,0,0,,新入生
Dialogue: 0,0:02:32.30,0:02:33.53,Default,,0,0,0,,の女子が言ったの
Dialogue: 0,0:02:35.66,0:02:37.06,Default,,0,0,0,,なんて言ったんだ
Dialogue: 0,0:02:38.33,0:02:39.33,Default,,0,0,0,,笑顔が
Dialogue: 0,0:02:40.56,0:02:41.36,Default,,0,0,0,,キモい
Dialogue: 0,0:02:43.36,0:02:44.80,Default,,0,0,0,,それって俺たちチ
Dialogue: 0,0:02:44.93,0:02:45.96,Default,,0,0,0,,ヤブを根底
Dialogue: 0,0:02:46.10,0:02:47.30,Default,,0,0,0,,から否定してないか
Dialogue: 0,0:02:48.00,0:02:48.93,Default,,0,0,0,,そうだよな
Dialogue: 0,0:02:49.66,0:02:51.20,Default,,0,0,0,,自分たちも笑顔で
Dialogue: 0,0:02:51.20,0:02:52.50,Default,,0,0,0,,しかもみんなのことも
Dialogue: 0,0:02:52.53,0:02:54.50,Default,,0,0,0,,笑顔にするっていうのが俺たちの
Dialogue: 0,0:02:54.56,0:02:55.70,Default,,0,0,0,,モットーなのに
Dialogue: 0,0:02:56.10,0:02:57.10,Default,,0,0,0,,キモいって
Dialogue: 0,0:02:57.36,0:02:59.00,Default,,0,0,0,,そんなん言われたら確かに
Dialogue: 0,0:02:59.13,0:02:59.53,Default,,0,0,0,,チア
Dialogue: 0,0:02:59.53,0:03:00.93,Default,,0,0,0,,やめとうなるわせ
Dialogue: 0,0:03:01.10,0:03:02.46,Default,,0,0,0,,やなでも
Dialogue: 0,0:03:03.30,0:03:04.36,Default,,0,0,0,,やめたら俺たち
Dialogue: 0,0:03:04.56,0:03:05.70,Default,,0,0,0,,どうしたらいいんだ
Dialogue: 0,0:03:07.20,0:03:09.13,Default,,0,0,0,,違う男子になるんだ
Dialogue: 0,0:03:12.20,0:03:13.00,Default,,0,0,0,,違う
Dialogue: 0,0:03:13.46,0:03:14.26,Default,,0,0,0,,男子
Dialogue: 0,0:03:15.00,0:03:16.46,Default,,0,0,0,,例えばどんな
Dialogue: 0,0:03:18.16,0:03:19.13,Default,,0,0,0,,そうだな
Dialogue: 0,0:03:20.96,0:03:22.40,Default,,0,0,0,,息でいなせな
Dialogue: 0,0:03:26.96,0:03:27.76,Default,,0,0,0,,ふん
Dialogue: 0,0:03:28.50,0:03:29.13,Default,,0,0,0,,和服
Dialogue: 0,0:03:29.13,0:03:29.93,Default,,0,0,0,,男子
Dialogue: 0,0:03:30.30,0:03:31.10,Default,,0,0,0,,はんなり
Dialogue: 0,0:03:32.26,0:03:33.56,Default,,0,0,0,,おおええな
Dialogue: 0,0:03:33.73,0:03:35.13,Default,,0,0,0,,めっちゃモテそうやん
Dialogue: 0,0:03:35.20,0:03:36.00,Default,,0,0,0,,うちの両
Dialogue: 0,0:03:36.00,0:03:37.46,Default,,0,0,0,,手で働いてもらえる
Dialogue: 0,0:03:37.66,0:03:38.73,Default,,0,0,0,,バイトかよ
Dialogue: 0,0:03:39.60,0:03:41.93,Default,,0,0,0,,でもちょっと大学の中で和服
Dialogue: 0,0:03:42.10,0:03:43.30,Default,,0,0,0,,はなあじゃあ
Dialogue: 0,0:03:43.46,0:03:45.30,Default,,0,0,0,,数はどんな男子がいいんだ
Dialogue: 0,0:03:47.40,0:03:48.33,Default,,0,0,0,,そうだな
Dialogue: 0,0:03:49.73,0:03:51.40,Default,,0,0,0,,就活に備えて
Dialogue: 0,0:03:52.70,0:03:53.66,Default,,0,0,0,,スーツ男子
Dialogue: 0,0:03:54.36,0:03:55.66,Default,,0,0,0,,アフターファイブは
Dialogue: 0,0:03:56.06,0:03:57.06,Default,,0,0,0,,ボルダリング
Dialogue: 0,0:03:57.60,0:03:58.56,Default,,0,0,0,,エリート集団
Dialogue: 0,0:03:58.70,0:03:59.50,Default,,0,0,0,,みたいやん
Dialogue: 0,0:03:59.56,0:04:01.30,Default,,0,0,0,,有名企業に受かりそうや
Dialogue: 0,0:04:01.70,0:04:02.16,Default,,0,0,0,,就職
Dialogue: 0,0:04:02.16,0:04:03.76,Default,,0,0,0,,したらずっとスーツなんだから
Dialogue: 0,0:04:04.36,0:04:06.30,Default,,0,0,0,,学生時代にしかできない男子がい
Dialogue: 0,0:04:06.36,0:04:08.06,Default,,0,0,0,,いんじゃないかな例えば
Dialogue: 0,0:04:09.93,0:04:11.06,Default,,0,0,0,,リス次郎男子
Dialogue: 0,0:04:13.90,0:04:15.16,Default,,0,0,0,,可愛くないんだが
Dialogue: 0,0:04:15.76,0:04:16.56,Default,,0,0,0,,暑いし
Dialogue: 0,0:04:16.73,0:04:19.00,Default,,0,0,0,,じゃあトンは何がいいんだえ
Dialogue: 0,0:04:19.36,0:04:20.16,Default,,0,0,0,,僕は
Dialogue: 0,0:04:20.90,0:04:22.06,Default,,0,0,0,,実は子供の頃
Dialogue: 0,0:04:22.26,0:04:25.50,Default,,0,0,0,,憧れてた職業があってええ何
Dialogue: 0,0:04:26.56,0:04:27.13,Default,,0,0,0,,相撲
Dialogue: 0,0:04:27.13,0:04:27.93,Default,,0,0,0,,男子
Dialogue: 0,0:04:28.26,0:04:29.16,Default,,0,0,0,,どすこい
Dialogue: 0,0:04:30.13,0:04:31.13,Default,,0,0,0,,確かにトンは二
Dialogue: 0,0:04:31.30,0:04:32.10,Default,,0,0,0,,を取るけど
Dialogue: 0,0:04:32.33,0:04:33.50,Default,,0,0,0,,まさに小学生
Dialogue: 0,0:04:33.66,0:04:34.50,Default,,0,0,0,,力士って
Dialogue: 0,0:04:34.60,0:04:35.80,Default,,0,0,0,,回しはどうよ
Dialogue: 0,0:04:35.96,0:04:36.76,Default,,0,0,0,,ええ
Dialogue: 0,0:04:37.00,0:04:37.80,Default,,0,0,0,,じゃあ弦
Dialogue: 0,0:04:37.86,0:04:38.96,Default,,0,0,0,,は何がいいの
Dialogue: 0,0:04:39.26,0:04:40.06,Default,,0,0,0,,せやな
Dialogue: 0,0:04:40.66,0:04:42.06,Default,,0,0,0,,女の子に人気があるっち
Dialogue: 0,0:04:42.16,0:04:43.33,Default,,0,0,0,,言うたらなんやろう
Dialogue: 0,0:04:43.60,0:04:44.40,Default,,0,0,0,,そりゃ爽
Dialogue: 0,0:04:44.46,0:04:45.73,Default,,0,0,0,,やかなスポーツマンや
Dialogue: 0,0:04:48.80,0:04:49.70,Default,,0,0,0,,諦めんな
Dialogue: 0,0:04:50.26,0:04:50.56,Default,,0,0,0,,い
Dialogue: 0,0:04:50.56,0:04:52.86,Default,,0,0,0,,や俺らテニスサークルやめたやろう
Dialogue: 0,0:04:53.06,0:04:53.86,Default,,0,0,0,,せやった
Dialogue: 0,0:04:54.53,0:04:55.53,Default,,0,0,0,,おでは
Dialogue: 0,0:04:55.56,0:04:57.56,Default,,0,0,0,,女子に人気があると言ったら
Dialogue: 0,0:04:57.56,0:04:58.70,Default,,0,0,0,,なんやろなあ
Dialogue: 0,0:04:59.73,0:05:00.46,Default,,0,0,0,,な
Dialogue: 0,0:05:00.46,0:05:01.30,Default,,0,0,0,,これか
Dialogue: 0,0:05:01.96,0:05:02.56,Default,,0,0,0,,女装
Dialogue: 0,0:05:02.56,0:05:03.36,Default,,0,0,0,,男子
Dialogue: 0,0:05:03.56,0:05:04.36,Default,,0,0,0,,こんだけ
Dialogue: 0,0:05:06.66,0:05:08.50,Default,,0,0,0,,誰一人似合ってない
Dialogue: 0,0:05:08.76,0:05:10.20,Default,,0,0,0,,むしろ気持ち悪いわ
Dialogue: 0,0:05:10.53,0:05:11.86,Default,,0,0,0,,静止できへんな
Dialogue: 0,0:05:12.46,0:05:13.16,Default,,0,0,0,,やっぱり
Dialogue: 0,0:05:13.16,0:05:13.93,Default,,0,0,0,,俺たちには
Dialogue: 0,0:05:13.93,0:05:14.33,Default,,0,0,0,,チア
Dialogue: 0,0:05:14.33,0:05:15.13,Default,,0,0,0,,しかない
Dialogue: 0,0:05:15.33,0:05:17.46,Default,,0,0,0,,キモい笑顔はどうしたらいいんだ
Dialogue: 0,0:05:17.86,0:05:18.26,Default,,0,0,0,,キモ
Dialogue: 0,0:05:18.26,0:05:19.80,Default,,0,0,0,,可愛い笑顔を目指すんや
Dialogue: 0,0:05:20.46,0:05:22.20,Default,,0,0,0,,うんわかったわ
Dialogue: 0,0:05:25.93,0:05:27.46,Default,,0,0,0,,ととにかく
Dialogue: 0,0:05:27.93,0:05:29.40,Default,,0,0,0,,練習しよう練習
Dialogue: 0,0:05:30.16,0:05:30.96,Default,,0,0,0,,ああ
Dialogue: 0,0:05:45.30,0:05:46.06,Default,,0,0,0,,はい
Dialogue: 0,0:05:46.06,0:05:48.53,Default,,0,0,0,,この映像を見てくれているそこの
Dialogue: 0,0:05:48.60,0:05:49.40,Default,,0,0,0,,あなた
Dialogue: 0,0:05:50.53,0:05:51.33,Default,,0,0,0,,こ
Dialogue: 0,0:05:51.33,0:05:52.13,Default,,0,0,0,,こんにちは
Dialogue: 0,0:05:52.70,0:05:53.76,Default,,0,0,0,,運動は苦手
Dialogue: 0,0:05:54.13,0:05:55.30,Default,,0,0,0,,忙しくてジムに
Dialogue: 0,0:05:55.40,0:05:56.40,Default,,0,0,0,,通うなんて無理
Dialogue: 0,0:05:56.86,0:05:58.53,Default,,0,0,0,,そんなあなたにぴったりの
Dialogue: 0,0:05:58.66,0:05:59.46,Default,,0,0,0,,超簡単
Dialogue: 0,0:05:59.86,0:06:00.66,Default,,0,0,0,,お手軽
Dialogue: 0,0:06:00.70,0:06:01.66,Default,,0,0,0,,アップダンスを
Dialogue: 0,0:06:01.66,0:06:03.20,Default,,0,0,0,,スプレーカーズが紹介
Dialogue: 0,0:06:03.26,0:06:04.33,Default,,0,0,0,,しています
Dialogue: 0,0:06:05.20,0:06:06.56,Default,,0,0,0,,数乗りすぎ
Dialogue: 0,0:06:06.96,0:06:08.10,Default,,0,0,0,,んだよハル
Dialogue: 0,0:06:08.36,0:06:09.36,Default,,0,0,0,,開けてこうぜ
Dialogue: 0,0:06:09.86,0:06:11.50,Default,,0,0,0,,アップダンスなんだからさ
Dialogue: 0,0:06:12.76,0:06:14.13,Default,,0,0,0,,アップダンスっていうのは
Dialogue: 0,0:06:14.20,0:06:15.00,Default,,0,0,0,,文字通り
Dialogue: 0,0:06:15.16,0:06:15.73,Default,,0,0,0,,ウォーミン
Dialogue: 0,0:06:15.73,0:06:17.30,Default,,0,0,0,,グアップのためのダンスで
Dialogue: 0,0:06:18.90,0:06:21.53,Default,,0,0,0,,俺たちはいつも練習の前にやってる
Dialogue: 0,0:06:22.30,0:06:22.76,Default,,0,0,0,,柔軟
Dialogue: 0,0:06:22.76,0:06:24.50,Default,,0,0,0,,とか筋トレよりも先に
Dialogue: 0,0:06:25.00,0:06:26.93,Default,,0,0,0,,いきなり体動かすと痛
Dialogue: 0,0:06:27.10,0:06:27.90,Default,,0,0,0,,めるもんな
Dialogue: 0,0:06:29.26,0:06:30.66,Default,,0,0,0,,ダイエットにもいいと思う
Dialogue: 0,0:06:30.70,0:06:31.50,Default,,0,0,0,,うんうん
Dialogue: 0,0:06:31.60,0:06:33.10,Default,,0,0,0,,ダンスって言っても見て
Dialogue: 0,0:06:33.13,0:06:34.46,Default,,0,0,0,,真似したらできるし
Dialogue: 0,0:06:34.86,0:06:37.06,Default,,0,0,0,,今すぐ始められる楽しいダンスで
Dialogue: 0,0:06:37.46,0:06:40.26,Default,,0,0,0,,君も運動不足の日常を壊そう
Dialogue: 0,0:06:40.70,0:06:42.96,Default,,0,0,0,,ほんの少し体を動かすことが
Dialogue: 0,0:06:43.13,0:06:44.16,Default,,0,0,0,,主役になる
Dialogue: 0,0:06:44.53,0:06:46.53,Default,,0,0,0,,なんとなくでも続けることが
Dialogue: 0,0:06:47.00,0:06:48.20,Default,,0,0,0,,自分の力になる
Dialogue: 0,0:06:50.73,0:06:52.16,Default,,0,0,0,,さあ俺たちチ
Dialogue: 0,0:06:52.30,0:06:53.50,Default,,0,0,0,,ア男子と一緒に
Dialogue: 0,0:06:53.56,0:06:54.73,Default,,0,0,0,,心も体も
Dialogue: 0,0:06:54.86,0:06:56.53,Default,,0,0,0,,レッツチアアップ
Dialogue: 0,0:07:14.00,0:07:15.40,Default,,0,0,0,,基本のサイドステップ
Dialogue: 0,0:07:16.13,0:07:16.33,Default,,0,0,0,,左
Dialogue: 0,0:07:16.33,0:07:18.36,Default,,0,0,0,,右にステップを踏みながら手を叩
Dialogue: 0,0:07:18.56,0:07:19.36,Default,,0,0,0,,く
Dialogue: 0,0:07:20.33,0:07:22.13,Default,,0,0,0,,いろいろバリエーションがあるから
Dialogue: 0,0:07:22.20,0:07:24.06,Default,,0,0,0,,後でみんなとやってみよう
Dialogue: 0,0:07:25.00,0:07:26.73,Default,,0,0,0,,ここでワンアップポイント
Dialogue: 0,0:07:27.46,0:07:28.66,Default,,0,0,0,,手を広げるとき
Dialogue: 0,0:07:28.96,0:07:29.56,Default,,0,0,0,,肘を
Dialogue: 0,0:07:29.56,0:07:31.33,Default,,0,0,0,,肩の高さに合わせてやれば
Dialogue: 0,0:07:31.56,0:07:32.36,Default,,0,0,0,,肩甲骨
Dialogue: 0,0:07:32.36,0:07:33.00,Default,,0,0,0,,周りの広
Dialogue: 0,0:07:33.00,0:07:33.66,Default,,0,0,0,,背筋に
Dialogue: 0,0:07:33.66,0:07:34.46,Default,,0,0,0,,効く
Dialogue: 0,0:07:34.46,0:07:36.80,Default,,0,0,0,,肘を引けばさらに効果アップ
Dialogue: 0,0:07:47.30,0:07:49.73,Default,,0,0,0,,銀もどうもそんな緊張すなや
Dialogue: 0,0:07:50.10,0:07:50.53,Default,,0,0,0,,日本
Dialogue: 0,0:07:50.53,0:07:52.53,Default,,0,0,0,,言うてもただのサイドステップやろ
Dialogue: 0,0:07:52.70,0:07:53.90,Default,,0,0,0,,リラックスやで
Dialogue: 0,0:07:54.20,0:07:55.06,Default,,0,0,0,,リラックス
Dialogue: 0,0:07:56.96,0:07:57.76,Default,,0,0,0,,でも一
Dialogue: 0,0:07:57.93,0:07:58.73,Default,,0,0,0,,さん
Dialogue: 0,0:07:58.73,0:07:59.53,Default,,0,0,0,,俺らみたいな
Dialogue: 0,0:07:59.56,0:08:00.70,Default,,0,0,0,,引き掛けもんが
Dialogue: 0,0:08:00.76,0:08:02.13,Default,,0,0,0,,トップバッターなんて
Dialogue: 0,0:08:02.60,0:08:03.66,Default,,0,0,0,,しゃあないな
Dialogue: 0,0:08:03.96,0:08:04.60,Default,,0,0,0,,ほんなら
Dialogue: 0,0:08:04.60,0:08:06.20,Default,,0,0,0,,俺のとっておきの持ちネタで
Dialogue: 0,0:08:06.26,0:08:07.30,Default,,0,0,0,,笑かしたるわ
Dialogue: 0,0:08:07.50,0:08:08.33,Default,,0,0,0,,マジっすか
Dialogue: 0,0:08:08.46,0:08:10.10,Default,,0,0,0,,お願いしやすうん
Dialogue: 0,0:08:16.46,0:08:17.66,Default,,0,0,0,,ガキンチョが緊
Dialogue: 0,0:08:17.76,0:08:18.56,Default,,0,0,0,,張しとる
Dialogue: 0,0:08:21.73,0:08:22.40,Default,,0,0,0,,寒い寒
Dialogue: 0,0:08:22.40,0:08:24.00,Default,,0,0,0,,いこういう時こそアップダンス
Dialogue: 0,0:08:24.26,0:08:25.20,Default,,0,0,0,,早く体を温
Dialogue: 0,0:08:25.33,0:08:26.16,Default,,0,0,0,,めやしょう
Dialogue: 0,0:08:27.56,0:08:28.36,Default,,0,0,0,,へ
Dialogue: 0,0:08:28.36,0:08:29.56,Default,,0,0,0,,狙い通りやな
Dialogue: 0,0:08:29.73,0:08:30.76,Default,,0,0,0,,嘘つけ滑
Dialogue: 0,0:08:30.93,0:08:31.90,Default,,0,0,0,,っただけやろ
Dialogue: 0,0:08:39.60,0:08:40.60,Default,,0,0,0,,右へ三つ
Dialogue: 0,0:08:40.90,0:08:41.86,Default,,0,0,0,,腿を上げて
Dialogue: 0,0:08:42.80,0:08:43.73,Default,,0,0,0,,腿を上げて
Dialogue: 0,0:08:44.16,0:08:46.13,Default,,0,0,0,,リズムに乗って手を叩こう
Dialogue: 0,0:08:47.50,0:08:47.90,Default,,0,0,0,,膝
Dialogue: 0,0:08:47.90,0:08:50.06,Default,,0,0,0,,をしっかりお腹の水まで上げよう
Dialogue: 0,0:08:50.06,0:08:50.86,Default,,0,0,0,,そうすれば
Dialogue: 0,0:08:51.00,0:08:51.60,Default,,0,0,0,,腹筋
Dialogue: 0,0:08:51.60,0:08:52.56,Default,,0,0,0,,足に効く
Dialogue: 0,0:08:56.00,0:08:57.06,Default,,0,0,0,,軽くジャンプ
Dialogue: 0,0:08:57.50,0:08:57.73,Default,,0,0,0,,両
Dialogue: 0,0:08:57.73,0:08:59.86,Default,,0,0,0,,手を上下させながらやってもいいよ
Dialogue: 0,0:09:00.56,0:09:02.13,Default,,0,0,0,,この時背中を海老
Dialogue: 0,0:09:02.33,0:09:03.66,Default,,0,0,0,,反りにしないように注意
Dialogue: 0,0:09:09.90,0:09:11.36,Default,,0,0,0,,せーの弟
Dialogue: 0,0:09:11.50,0:09:12.30,Default,,0,0,0,,あるある
Dialogue: 0,0:09:13.80,0:09:14.90,Default,,0,0,0,,勝手に俺の
Dialogue: 0,0:09:15.06,0:09:15.86,Default,,0,0,0,,家畜
Dialogue: 0,0:09:16.93,0:09:17.76,Default,,0,0,0,,あるある
Dialogue: 0,0:09:17.93,0:09:19.60,Default,,0,0,0,,勝手に俺の部屋入る
Dialogue: 0,0:09:20.93,0:09:21.73,Default,,0,0,0,,あるある
Dialogue: 0,0:09:21.90,0:09:23.76,Default,,0,0,0,,勝手に俺の服着てる
Dialogue: 0,0:09:24.93,0:09:25.73,Default,,0,0,0,,あるある
Dialogue: 0,0:09:31.53,0:09:32.40,Default,,0,0,0,,春のとこ
Dialogue: 0,0:09:32.56,0:09:34.40,Default,,0,0,0,,姉ちゃんだよなうん
Dialogue: 0,0:09:34.73,0:09:36.33,Default,,0,0,0,,なのに勝手に春の服
Dialogue: 0,0:09:36.50,0:09:37.53,Default,,0,0,0,,着んのえ
Dialogue: 0,0:09:37.86,0:09:38.66,Default,,0,0,0,,うん
Dialogue: 0,0:09:38.86,0:09:39.46,Default,,0,0,0,,パジャマ
Dialogue: 0,0:09:39.46,0:09:40.56,Default,,0,0,0,,代わりに俺のティーシャツ
Dialogue: 0,0:09:40.73,0:09:41.40,Default,,0,0,0,,着てたり
Dialogue: 0,0:09:41.40,0:09:42.06,Default,,0,0,0,,短パン
Dialogue: 0,0:09:42.06,0:09:42.86,Default,,0,0,0,,履いてたり
Dialogue: 0,0:09:43.56,0:09:44.66,Default,,0,0,0,,よくあるけど
Dialogue: 0,0:09:45.73,0:09:46.70,Default,,0,0,0,,マジでか
Dialogue: 0,0:09:48.80,0:09:49.73,Default,,0,0,0,,羨ましい
Dialogue: 0,0:09:56.93,0:09:58.73,Default,,0,0,0,,左右にステップを踏みながら
Dialogue: 0,0:09:58.96,0:10:00.93,Default,,0,0,0,,両手を組んで前に伸ばそう
Dialogue: 0,0:10:04.53,0:10:06.13,Default,,0,0,0,,クロスさせるようにもう
Dialogue: 0,0:10:06.40,0:10:06.60,Default,,0,0,0,,片
Dialogue: 0,0:10:06.60,0:10:08.70,Default,,0,0,0,,方の足の後ろでステップを踏んで
Dialogue: 0,0:10:12.53,0:10:13.56,Default,,0,0,0,,それができたら
Dialogue: 0,0:10:13.86,0:10:15.76,Default,,0,0,0,,後ろにも手を伸ばしてみよう
Dialogue: 0,0:10:16.30,0:10:18.30,Default,,0,0,0,,肩の周りや背中が伸びているか
Dialogue: 0,0:10:18.36,0:10:19.16,Default,,0,0,0,,意識して
Dialogue: 0,0:10:23.16,0:10:26.00,Default,,0,0,0,,勉強や仕事で一日中座りっぱなし
Dialogue: 0,0:10:26.13,0:10:27.10,Default,,0,0,0,,なんて人は
Dialogue: 0,0:10:27.36,0:10:27.76,Default,,0,0,0,,休憩
Dialogue: 0,0:10:27.76,0:10:29.96,Default,,0,0,0,,にこの動きだけやってもいいかもね
Dialogue: 0,0:10:35.96,0:10:37.46,Default,,0,0,0,,ああ暑い
Dialogue: 0,0:10:39.46,0:10:40.53,Default,,0,0,0,,今日暑い
Dialogue: 0,0:10:42.06,0:10:44.46,Default,,0,0,0,,ただでさえそのもっさり頭のせいで
Dialogue: 0,0:10:44.53,0:10:45.90,Default,,0,0,0,,暑苦しいんですから
Dialogue: 0,0:10:46.16,0:10:48.00,Default,,0,0,0,,せめて黙ってください
Dialogue: 0,0:10:48.76,0:10:49.56,Default,,0,0,0,,せーの
Dialogue: 0,0:10:54.16,0:10:55.56,Default,,0,0,0,,濡れたブロッコリー
Dialogue: 0,0:10:56.00,0:10:56.36,Default,,0,0,0,,茹で
Dialogue: 0,0:10:56.36,0:10:57.40,Default,,0,0,0,,すぎてふにゃふにゃ
Dialogue: 0,0:10:57.46,0:10:58.40,Default,,0,0,0,,になったブロッコリーの
Dialogue: 0,0:10:58.40,0:10:59.46,Default,,0,0,0,,間違いじゃないですか
Dialogue: 0,0:11:00.50,0:11:01.10,Default,,0,0,0,,ムスタ
Dialogue: 0,0:11:01.10,0:11:01.93,Default,,0,0,0,,ブラッカリー
Dialogue: 0,0:11:02.13,0:11:02.93,Default,,0,0,0,,人の
Dialogue: 0,0:11:03.40,0:11:04.06,Default,,0,0,0,,ふざけないで
Dialogue: 0,0:11:04.06,0:11:04.93,Default,,0,0,0,,ちゃんとやってください
Dialogue: 0,0:11:05.46,0:11:07.26,Default,,0,0,0,,お前こそちゃんとやれよ
Dialogue: 0,0:11:07.40,0:11:08.20,Default,,0,0,0,,俺はマジ
Dialogue: 0,0:11:08.26,0:11:08.80,Default,,0,0,0,,超絶
Dialogue: 0,0:11:08.80,0:11:09.30,Default,,0,0,0,,真剣
Dialogue: 0,0:11:09.30,0:11:10.56,Default,,0,0,0,,にやってる
Dialogue: 0,0:11:11.60,0:11:12.40,Default,,0,0,0,,キモ
Dialogue: 0,0:11:13.30,0:11:14.20,Default,,0,0,0,,ほら行くぞ
Dialogue: 0,0:11:14.50,0:11:15.40,Default,,0,0,0,,レンチンした
Dialogue: 0,0:11:15.53,0:11:16.56,Default,,0,0,0,,ブロッコリー
Dialogue: 0,0:11:17.06,0:11:17.86,Default,,0,0,0,,言わない
Dialogue: 0,0:11:18.30,0:11:19.36,Default,,0,0,0,,濡らしてレンチン絶対はない
Dialogue: 0,0:11:19.80,0:11:21.66,Default,,0,0,0,,簡単言ってたまるかブロッコリー
Dialogue: 0,0:11:27.96,0:11:29.80,Default,,0,0,0,,腕を引き上げながらかか
Dialogue: 0,0:11:30.00,0:11:30.90,Default,,0,0,0,,とでお尻を蹴
Dialogue: 0,0:11:31.00,0:11:31.80,Default,,0,0,0,,るようなイメージで
Dialogue: 0,0:11:31.80,0:11:33.20,Default,,0,0,0,,足を後ろに上げる
Dialogue: 0,0:11:33.73,0:11:34.93,Default,,0,0,0,,お尻の引き締め
Dialogue: 0,0:11:35.00,0:11:36.73,Default,,0,0,0,,ヒップアップに効果的だ
Dialogue: 0,0:11:39.90,0:11:42.46,Default,,0,0,0,,同じように前に腿を上げる
Dialogue: 0,0:11:42.86,0:11:45.00,Default,,0,0,0,,どちらもリズムに乗ってステップを
Dialogue: 0,0:11:45.10,0:11:46.40,Default,,0,0,0,,踏みながらやってみて
Dialogue: 0,0:11:47.56,0:11:48.66,Default,,0,0,0,,それができたら
Dialogue: 0,0:11:50.20,0:11:51.50,Default,,0,0,0,,ワンアップポイント
Dialogue: 0,0:11:52.26,0:11:54.00,Default,,0,0,0,,後ろに上げた足を反対
Dialogue: 0,0:11:54.10,0:11:55.80,Default,,0,0,0,,側の手でタッチしてみよう
Dialogue: 0,0:11:55.90,0:11:56.93,Default,,0,0,0,,この動きがお腹
Dialogue: 0,0:11:57.06,0:11:57.86,Default,,0,0,0,,周りの副車
Dialogue: 0,0:11:57.93,0:11:58.86,Default,,0,0,0,,気に効くんだ
Dialogue: 0,0:11:58.96,0:12:00.16,Default,,0,0,0,,横腹の引き締め
Dialogue: 0,0:12:00.30,0:12:00.70,Default,,0,0,0,,くびれ
Dialogue: 0,0:12:00.70,0:12:02.90,Default,,0,0,0,,を手に入れたい人には特におすすめ
Dialogue: 0,0:12:10.90,0:12:12.53,Default,,0,0,0,,じゃあ日本行くよ
Dialogue: 0,0:12:13.46,0:12:13.96,Default,,0,0,0,,やっぱり
Dialogue: 0,0:12:13.96,0:12:14.73,Default,,0,0,0,,わけわかん
Dialogue: 0,0:12:14.73,0:12:15.76,Default,,0,0,0,,恥ずかしすぎるわ
Dialogue: 0,0:12:16.96,0:12:18.13,Default,,0,0,0,,アップダンスなんて
Dialogue: 0,0:12:18.13,0:12:19.36,Default,,0,0,0,,いつもやってるだろう
Dialogue: 0,0:12:19.93,0:12:20.66,Default,,0,0,0,,今更
Dialogue: 0,0:12:20.66,0:12:22.73,Default,,0,0,0,,恥ずかしがることないと思うけど
Dialogue: 0,0:12:23.16,0:12:24.10,Default,,0,0,0,,ダンスちゃんは
Dialogue: 0,0:12:24.33,0:12:25.30,Default,,0,0,0,,これやこれ
Dialogue: 0,0:12:26.06,0:12:26.86,Default,,0,0,0,,うん
Dialogue: 0,0:12:28.93,0:12:29.73,Default,,0,0,0,,ああ
Dialogue: 0,0:12:30.50,0:12:32.00,Default,,0,0,0,,まあ確かに
Dialogue: 0,0:12:32.93,0:12:34.10,Default,,0,0,0,,男同士でお揃
Dialogue: 0,0:12:34.13,0:12:35.40,Default,,0,0,0,,いっていうのはちょっとね
Dialogue: 0,0:12:35.50,0:12:36.20,Default,,0,0,0,,そうそう
Dialogue: 0,0:12:36.20,0:12:37.76,Default,,0,0,0,,俺とお前ができてるみたいで
Dialogue: 0,0:12:37.76,0:12:38.60,Default,,0,0,0,,気持ち悪いやろ
Dialogue: 0,0:12:38.73,0:12:39.96,Default,,0,0,0,,ってちゃうそれもそう
Dialogue: 0,0:12:40.00,0:12:41.20,Default,,0,0,0,,やけどそこちゃうから
Dialogue: 0,0:12:41.60,0:12:42.30,Default,,0,0,0,,ていうか
Dialogue: 0,0:12:42.30,0:12:43.06,Default,,0,0,0,,残念すぎる
Dialogue: 0,0:12:43.06,0:12:44.56,Default,,0,0,0,,何が残念ってティーシャツと
Dialogue: 0,0:12:44.66,0:12:45.53,Default,,0,0,0,,ズボンの組み合わせも
Dialogue: 0,0:12:45.60,0:12:47.40,Default,,0,0,0,,せえけどその発想も残念
Dialogue: 0,0:12:47.70,0:12:48.76,Default,,0,0,0,,ないわない
Dialogue: 0,0:12:54.10,0:12:55.13,Default,,0,0,0,,ブレイクタイム
Dialogue: 0,0:12:55.80,0:12:57.96,Default,,0,0,0,,基本のストレッチをやっておこうか
Dialogue: 0,0:12:58.60,0:12:59.13,Default,,0,0,0,,かかと
Dialogue: 0,0:12:59.13,0:13:00.36,Default,,0,0,0,,をしっかりつけると
Dialogue: 0,0:13:00.53,0:13:02.46,Default,,0,0,0,,足の筋肉がよく伸びる
Dialogue: 0,0:13:12.10,0:13:13.30,Default,,0,0,0,,この時膝
Dialogue: 0,0:13:13.46,0:13:14.26,Default,,0,0,0,,がつま先
Dialogue: 0,0:13:14.26,0:13:15.50,Default,,0,0,0,,より前に出ないように重
Dialogue: 0,0:13:15.56,0:13:16.66,Default,,0,0,0,,心をかけよう
Dialogue: 0,0:13:27.53,0:13:28.70,Default,,0,0,0,,右へ左へ
Dialogue: 0,0:13:29.00,0:13:30.96,Default,,0,0,0,,手足をまっすぐ伸ばして
Dialogue: 0,0:13:31.06,0:13:32.30,Default,,0,0,0,,お腹をしっかりね
Dialogue: 0,0:13:32.40,0:13:33.96,Default,,0,0,0,,じりながら真横を向く
Dialogue: 0,0:13:34.46,0:13:35.33,Default,,0,0,0,,でもね
Dialogue: 0,0:13:35.46,0:13:36.66,Default,,0,0,0,,じる時は腰を痛
Dialogue: 0,0:13:36.73,0:13:37.46,Default,,0,0,0,,めないように
Dialogue: 0,0:13:37.46,0:13:39.30,Default,,0,0,0,,無理のない程度にしておこう
Dialogue: 0,0:13:39.60,0:13:40.13,Default,,0,0,0,,体調
Dialogue: 0,0:13:40.13,0:13:41.36,Default,,0,0,0,,管理も大事だよ
Dialogue: 0,0:13:47.66,0:13:48.56,Default,,0,0,0,,鍋島君
Dialogue: 0,0:13:48.76,0:13:49.66,Default,,0,0,0,,最近どう
Dialogue: 0,0:13:49.96,0:13:50.76,Default,,0,0,0,,うん
Dialogue: 0,0:13:51.36,0:13:51.93,Default,,0,0,0,,就職
Dialogue: 0,0:13:51.93,0:13:53.10,Default,,0,0,0,,は決まったんだけど
Dialogue: 0,0:13:53.53,0:13:54.30,Default,,0,0,0,,引っ越さなき
Dialogue: 0,0:13:54.30,0:13:56.40,Default,,0,0,0,,ゃいけないかもしれなくてねえ
Dialogue: 0,0:13:56.66,0:13:57.80,Default,,0,0,0,,どこになったの
Dialogue: 0,0:13:58.00,0:13:58.50,Default,,0,0,0,,関西
Dialogue: 0,0:13:58.50,0:13:59.30,Default,,0,0,0,,死者
Dialogue: 0,0:13:59.50,0:14:01.00,Default,,0,0,0,,言葉とかどうしよう
Dialogue: 0,0:14:01.70,0:14:02.50,Default,,0,0,0,,関西弁
Dialogue: 0,0:14:02.66,0:14:04.40,Default,,0,0,0,,喋った方がいいかな
Dialogue: 0,0:14:04.93,0:14:05.73,Default,,0,0,0,,確かに
Dialogue: 0,0:14:06.13,0:14:07.53,Default,,0,0,0,,豪にいれば豪に従
Dialogue: 0,0:14:07.70,0:14:09.13,Default,,0,0,0,,えって言葉もあるしね
Dialogue: 0,0:14:09.76,0:14:11.86,Default,,0,0,0,,俺も言葉は不安でえ
Dialogue: 0,0:14:12.40,0:14:13.20,Default,,0,0,0,,金さん
Dialogue: 0,0:14:13.56,0:14:14.93,Default,,0,0,0,,実はまだ正
Dialogue: 0,0:14:15.06,0:14:16.40,Default,,0,0,0,,式に決まってないんだけど
Dialogue: 0,0:14:16.96,0:14:17.66,Default,,0,0,0,,海外赴
Dialogue: 0,0:14:17.66,0:14:18.90,Default,,0,0,0,,任って話があって
Dialogue: 0,0:14:19.13,0:14:20.20,Default,,0,0,0,,マジすご
Dialogue: 0,0:14:20.33,0:14:21.13,Default,,0,0,0,,どこどこ
Dialogue: 0,0:14:21.20,0:14:22.76,Default,,0,0,0,,ええとほらあれ
Dialogue: 0,0:14:23.33,0:14:24.93,Default,,0,0,0,,世界一幸せな国
Dialogue: 0,0:14:25.56,0:14:26.36,Default,,0,0,0,,ペータン
Dialogue: 0,0:14:26.53,0:14:27.33,Default,,0,0,0,,惜しい
Dialogue: 0,0:14:27.66,0:14:28.46,Default,,0,0,0,,ブータン
Dialogue: 0,0:14:29.76,0:14:30.73,Default,,0,0,0,,鍋島君
Dialogue: 0,0:14:31.26,0:14:32.06,Default,,0,0,0,,金さん
Dialogue: 0,0:14:32.76,0:14:34.33,Default,,0,0,0,,お互い頑張ろう
Dialogue: 0,0:14:43.13,0:14:44.80,Default,,0,0,0,,膝を伸ばして足を交
Dialogue: 0,0:14:45.06,0:14:46.16,Default,,0,0,0,,互に前に振る
Dialogue: 0,0:14:46.70,0:14:49.26,Default,,0,0,0,,足を四十五度開いた状態で行えば
Dialogue: 0,0:14:49.56,0:14:50.06,Default,,0,0,0,,股関
Dialogue: 0,0:14:50.06,0:14:50.93,Default,,0,0,0,,節のストレッチ
Dialogue: 0,0:14:51.26,0:14:52.06,Default,,0,0,0,,太もも
Dialogue: 0,0:14:52.10,0:14:53.06,Default,,0,0,0,,ふくらはぎの引き
Dialogue: 0,0:14:53.16,0:14:54.40,Default,,0,0,0,,締めに効果的だ
Dialogue: 0,0:14:54.90,0:14:56.73,Default,,0,0,0,,ただし膝を伸ばし切って
Dialogue: 0,0:14:56.76,0:14:58.40,Default,,0,0,0,,痛めないようにほどほどに
Dialogue: 0,0:15:07.00,0:15:08.60,Default,,0,0,0,,ジャンプして足を開く
Dialogue: 0,0:15:09.10,0:15:09.90,Default,,0,0,0,,同時に両
Dialogue: 0,0:15:09.93,0:15:11.50,Default,,0,0,0,,手を上げてポーズを取ろう
Dialogue: 0,0:15:12.40,0:15:13.93,Default,,0,0,0,,ジャンプしながら戻す
Dialogue: 0,0:15:14.30,0:15:16.10,Default,,0,0,0,,リズムに乗って繰り返そう
Dialogue: 0,0:15:19.16,0:15:19.93,Default,,0,0,0,,肘を
Dialogue: 0,0:15:19.93,0:15:22.00,Default,,0,0,0,,肩の高さに合わせてあげることで
Dialogue: 0,0:15:22.26,0:15:23.40,Default,,0,0,0,,腕の引き締め
Dialogue: 0,0:15:23.73,0:15:25.16,Default,,0,0,0,,肩の筋肉に効く
Dialogue: 0,0:15:25.40,0:15:26.20,Default,,0,0,0,,ただし
Dialogue: 0,0:15:26.26,0:15:28.16,Default,,0,0,0,,痛いなと思ったら無理せず低
Dialogue: 0,0:15:28.33,0:15:29.13,Default,,0,0,0,,めにしよう
Dialogue: 0,0:15:36.30,0:15:37.10,Default,,0,0,0,,お
Dialogue: 0,0:15:37.30,0:15:39.76,Default,,0,0,0,,何俺どうかしたうん
Dialogue: 0,0:15:40.66,0:15:42.93,Default,,0,0,0,,うんなんでもないうん
Dialogue: 0,0:15:44.30,0:15:45.10,Default,,0,0,0,,うん
Dialogue: 0,0:15:51.73,0:15:52.76,Default,,0,0,0,,負けないもん
Dialogue: 0,0:16:02.93,0:16:04.33,Default,,0,0,0,,足を広げて
Dialogue: 0,0:16:04.46,0:16:05.26,Default,,0,0,0,,右
Dialogue: 0,0:16:05.53,0:16:06.33,Default,,0,0,0,,左
Dialogue: 0,0:16:08.96,0:16:11.66,Default,,0,0,0,,交互に膝を曲げながら肩を回そう
Dialogue: 0,0:16:12.66,0:16:13.33,Default,,0,0,0,,つま先
Dialogue: 0,0:16:13.33,0:16:15.26,Default,,0,0,0,,は四十五度外に開いて
Dialogue: 0,0:16:15.40,0:16:16.10,Default,,0,0,0,,股関節
Dialogue: 0,0:16:16.10,0:16:17.93,Default,,0,0,0,,と足全体のストレッチになる
Dialogue: 0,0:16:18.36,0:16:20.10,Default,,0,0,0,,この時膝がつま先
Dialogue: 0,0:16:20.20,0:16:21.53,Default,,0,0,0,,より前に出ないように
Dialogue: 0,0:16:28.46,0:16:29.70,Default,,0,0,0,,両足を広げて
Dialogue: 0,0:16:29.76,0:16:30.90,Default,,0,0,0,,腰を落とそう
Dialogue: 0,0:16:31.50,0:16:33.53,Default,,0,0,0,,状態をひねって肩を入れる
Dialogue: 0,0:16:34.13,0:16:34.46,Default,,0,0,0,,膝
Dialogue: 0,0:16:34.46,0:16:36.86,Default,,0,0,0,,を九十度に曲げて腰を落とすことで
Dialogue: 0,0:16:37.06,0:16:37.86,Default,,0,0,0,,股関節と
Dialogue: 0,0:16:37.96,0:16:38.73,Default,,0,0,0,,肩にしっかり
Dialogue: 0,0:16:38.73,0:16:39.53,Default,,0,0,0,,効く
Dialogue: 0,0:16:39.80,0:16:41.40,Default,,0,0,0,,もし痛いようだったら
Dialogue: 0,0:16:41.53,0:16:42.13,Default,,0,0,0,,膝を曲
Dialogue: 0,0:16:42.13,0:16:42.90,Default,,0,0,0,,げる角度を
Dialogue: 0,0:16:42.90,0:16:44.56,Default,,0,0,0,,四十五度くらいにしてみて
Dialogue: 0,0:16:45.26,0:16:47.20,Default,,0,0,0,,とにかく無理は禁物だ
Dialogue: 0,0:16:49.60,0:16:50.26,Default,,0,0,0,,オッケー
Dialogue: 0,0:16:50.26,0:16:51.56,Default,,0,0,0,,よいえ
Dialogue: 0,0:16:52.13,0:16:53.50,Default,,0,0,0,,残った残った
Dialogue: 0,0:16:53.60,0:16:54.70,Default,,0,0,0,,残った残った
Dialogue: 0,0:16:54.96,0:16:56.06,Default,,0,0,0,,残ったはは
Dialogue: 0,0:16:56.40,0:16:57.56,Default,,0,0,0,,残った残った
Dialogue: 0,0:16:57.80,0:16:58.60,Default,,0,0,0,,残ったはは
Dialogue: 0,0:16:58.76,0:16:59.56,Default,,0,0,0,,残った残った
Dialogue: 0,0:16:59.76,0:17:00.90,Default,,0,0,0,,残った残った
Dialogue: 0,0:17:01.46,0:17:02.20,Default,,0,0,0,,残った残った
Dialogue: 0,0:17:02.20,0:17:03.36,Default,,0,0,0,,どっちかい
Dialogue: 0,0:17:04.56,0:17:05.56,Default,,0,0,0,,好きだし
Dialogue: 0,0:17:06.13,0:17:07.96,Default,,0,0,0,,どうも山の勝ち
Dialogue: 0,0:17:09.20,0:17:10.36,Default,,0,0,0,,こっちゃんです
Dialogue: 0,0:17:16.66,0:17:18.76,Default,,0,0,0,,両手を上げて軽くジャンプ
Dialogue: 0,0:17:19.20,0:17:20.06,Default,,0,0,0,,それと同時に
Dialogue: 0,0:17:20.16,0:17:21.53,Default,,0,0,0,,片足を振り上げる
Dialogue: 0,0:17:22.06,0:17:22.93,Default,,0,0,0,,最初はなかなか
Dialogue: 0,0:17:23.00,0:17:24.60,Default,,0,0,0,,足が上がらないと思うけど
Dialogue: 0,0:17:24.80,0:17:26.26,Default,,0,0,0,,慣れてくると少しずつ
Dialogue: 0,0:17:26.30,0:17:27.86,Default,,0,0,0,,高く上がるようになるよ
Dialogue: 0,0:17:28.26,0:17:29.80,Default,,0,0,0,,でも頑張りすぎて転
Dialogue: 0,0:17:30.00,0:17:31.26,Default,,0,0,0,,ばないように気をつけて
Dialogue: 0,0:17:33.26,0:17:34.93,Default,,0,0,0,,じゃあワンアップポイント
Dialogue: 0,0:17:35.36,0:17:36.73,Default,,0,0,0,,手の先でつま
Dialogue: 0,0:17:36.86,0:17:38.16,Default,,0,0,0,,先をタッチしてみよう
Dialogue: 0,0:17:38.36,0:17:40.53,Default,,0,0,0,,足の引き締めに効果的だ
Dialogue: 0,0:17:43.10,0:17:44.16,Default,,0,0,0,,見本どす
Dialogue: 0,0:17:45.06,0:17:46.46,Default,,0,0,0,,簡単でしたろう
Dialogue: 0,0:17:50.96,0:17:51.93,Default,,0,0,0,,ふんふんふん
Dialogue: 0,0:17:52.16,0:17:52.56,Default,,0,0,0,,みぞ
Dialogue: 0,0:17:52.56,0:17:53.90,Default,,0,0,0,,ぐちはん呼んだろ
Dialogue: 0,0:17:54.16,0:17:55.36,Default,,0,0,0,,あの人エーロー
Dialogue: 0,0:17:55.53,0:17:57.26,Default,,0,0,0,,体かとうますからな
Dialogue: 0,0:17:57.53,0:17:58.33,Default,,0,0,0,,ふふん
Dialogue: 0,0:17:58.86,0:17:59.66,Default,,0,0,0,,日本
Dialogue: 0,0:17:59.76,0:18:01.30,Default,,0,0,0,,俺がへえ
Dialogue: 0,0:18:01.50,0:18:03.10,Default,,0,0,0,,ああまあエンドス
Dialogue: 0,0:18:03.60,0:18:05.10,Default,,0,0,0,,先輩だからって無理
Dialogue: 0,0:18:05.20,0:18:06.00,Default,,0,0,0,,せんでも
Dialogue: 0,0:18:07.80,0:18:09.93,Default,,0,0,0,,進まざる者は必ず引き
Dialogue: 0,0:18:10.36,0:18:12.36,Default,,0,0,0,,引かざる者は必ず進む
Dialogue: 0,0:18:13.13,0:18:13.70,Default,,0,0,0,,福沢
Dialogue: 0,0:18:13.70,0:18:14.20,Default,,0,0,0,,諭吉
Dialogue: 0,0:18:14.20,0:18:15.00,Default,,0,0,0,,の言葉だ
Dialogue: 0,0:18:33.10,0:18:36.16,Default,,0,0,0,,行ってしまったかもしれないんだが
Dialogue: 0,0:18:38.46,0:18:39.46,Default,,0,0,0,,すまへん
Dialogue: 0,0:18:40.40,0:18:41.20,Default,,0,0,0,,あ
Dialogue: 0,0:18:41.50,0:18:42.46,Default,,0,0,0,,あああ
Dialogue: 0,0:18:42.96,0:18:43.70,Default,,0,0,0,,あ
Dialogue: 0,0:18:43.70,0:18:44.30,Default,,0,0,0,,あ
Dialogue: 0,0:18:44.30,0:18:46.10,Default,,0,0,0,,なんか余計なことが色
Dialogue: 0,0:18:46.13,0:18:47.70,Default,,0,0,0,,入ってた気もするけど
Dialogue: 0,0:18:48.40,0:18:50.00,Default,,0,0,0,,大体こんな感じかな
Dialogue: 0,0:18:50.20,0:18:51.00,Default,,0,0,0,,だな
Dialogue: 0,0:18:51.33,0:18:52.93,Default,,0,0,0,,あとは俺たちを見ながら
Dialogue: 0,0:18:52.96,0:18:53.86,Default,,0,0,0,,真似してみて
Dialogue: 0,0:18:54.13,0:18:56.10,Default,,0,0,0,,できなくても気にしない気にしない
Dialogue: 0,0:18:56.96,0:18:58.40,Default,,0,0,0,,じゃあやるか春
Dialogue: 0,0:18:59.76,0:19:00.56,Default,,0,0,0,,うん
Dialogue: 0,0:19:01.40,0:19:03.40,Default,,0,0,0,,アップダンススタート
Dialogue: 0,0:19:06.66,0:19:07.96,Default,,0,0,0,,よっしゃ始めんで
Dialogue: 0,0:19:08.10,0:19:10.36,Default,,0,0,0,,ブレイカーズによるアップダンス
Dialogue: 0,0:19:10.86,0:19:12.26,Default,,0,0,0,,リズムに合わせて三
Dialogue: 0,0:19:12.40,0:19:13.66,Default,,0,0,0,,はいひひ
Dialogue: 0,0:19:14.00,0:19:14.80,Default,,0,0,0,,ほお
Dialogue: 0,0:19:15.13,0:19:15.93,Default,,0,0,0,,ひひ
Dialogue: 0,0:19:15.96,0:19:16.76,Default,,0,0,0,,ほお
Dialogue: 0,0:19:16.93,0:19:18.56,Default,,0,0,0,,お父ちゃん生まれる
Dialogue: 0,0:19:18.76,0:19:20.40,Default,,0,0,0,,って何やらせんねん
Dialogue: 0,0:19:23.06,0:19:23.86,Default,,0,0,0,,원 투
Dialogue: 0,0:19:23.90,0:19:24.70,Default,,0,0,0,,쓰리 포
Dialogue: 0,0:19:24.96,0:19:25.86,Default,,0,0,0,,파이브 식스
Dialogue: 0,0:19:25.96,0:19:28.60,Default,,0,0,0,,세븐 에잇 이 아르 센스
Dialogue: 0,0:19:29.10,0:19:30.50,Default,,0,0,0,,안 투 트라
Dialogue: 0,0:19:31.96,0:19:33.26,Default,,0,0,0,,男は黙って
Dialogue: 0,0:19:34.60,0:19:35.56,Default,,0,0,0,,ひふみ
Dialogue: 0,0:19:35.80,0:19:36.56,Default,,0,0,0,,よ
Dialogue: 0,0:19:36.56,0:19:37.36,Default,,0,0,0,,いつむ
Dialogue: 0,0:19:37.46,0:19:38.53,Default,,0,0,0,,んだないや
Dialogue: 0,0:19:39.30,0:19:41.00,Default,,0,0,0,,おい全然合ってねえぞ
Dialogue: 0,0:19:41.93,0:19:43.93,Default,,0,0,0,,帰って邪魔じゃないかなこれ
Dialogue: 0,0:20:24.70,0:20:25.90,Default,,0,0,0,,キーオン
Dialogue: 0,0:20:26.26,0:20:27.73,Default,,0,0,0,,シールリーダー
Dialogue: 0,0:20:28.00,0:20:29.06,Default,,0,0,0,,ウィーウィー
Dialogue: 0,0:20:29.66,0:20:30.70,Default,,0,0,0,,ラックオン
Dialogue: 0,0:20:31.16,0:20:32.53,Default,,0,0,0,,ブラックエンド
Dialogue: 0,0:20:32.70,0:20:33.50,Default,,0,0,0,,イエロー
Dialogue: 0,0:20:34.30,0:20:36.33,Default,,0,0,0,,ゴーファイブ
Dialogue: 0,0:20:37.70,0:20:39.90,Default,,0,0,0,,ビーアールイーエーケーイー
Dialogue: 0,0:20:40.00,0:20:40.80,Default,,0,0,0,,アイエス
Dialogue: 0,0:20:41.96,0:20:43.13,Default,,0,0,0,,ゴーブレイカー
Dialogue: 0,0:20:47.50,0:20:48.86,Default,,0,0,0,,そうそうそこの君
Dialogue: 0,0:20:49.16,0:20:49.96,Default,,0,0,0,,その調子
Dialogue: 0,0:20:50.30,0:20:52.50,Default,,0,0,0,,頑張れさあもう一丁
Dialogue: 0,0:20:53.70,0:20:55.26,Default,,0,0,0,,焦らず行きやしょう
Dialogue: 0,0:20:55.46,0:20:56.13,Default,,0,0,0,,根性
Dialogue: 0,0:20:56.13,0:20:56.56,Default,,0,0,0,,根性
Dialogue: 0,0:20:56.56,0:20:57.36,Default,,0,0,0,,ど根性
Dialogue: 0,0:20:58.30,0:20:59.86,Default,,0,0,0,,フレーフレー
Dialogue: 0,0:21:00.40,0:21:01.20,Default,,0,0,0,,頑張れ
Dialogue: 0,0:21:02.06,0:21:03.20,Default,,0,0,0,,やるやんか
Dialogue: 0,0:21:03.60,0:21:05.93,Default,,0,0,0,,いいね悪くないですね
Dialogue: 0,0:21:07.36,0:21:08.16,Default,,0,0,0,,最高
Dialogue: 0,0:21:08.90,0:21:10.30,Default,,0,0,0,,無理はするなよ
Dialogue: 0,0:21:10.86,0:21:11.66,Default,,0,0,0,,ファイト
Dialogue: 0,0:21:12.50,0:21:13.30,Default,,0,0,0,,一発
Dialogue: 0,0:21:14.36,0:21:15.60,Default,,0,0,0,,エンジョイドス
Dialogue: 0,0:21:16.20,0:21:17.53,Default,,0,0,0,,いい感じだよ
Dialogue: 0,0:21:18.30,0:21:18.73,Default,,0,0,0,,継続
Dialogue: 0,0:21:18.73,0:21:20.10,Default,,0,0,0,,は力なりなんだが
Dialogue: 0,0:21:38.20,0:21:39.13,Default,,0,0,0,,あそういや
Dialogue: 0,0:21:39.70,0:21:41.56,Default,,0,0,0,,大学の銅像に登ると
Dialogue: 0,0:21:41.76,0:21:42.26,Default,,0,0,0,,退学
Dialogue: 0,0:21:42.26,0:21:43.56,Default,,0,0,0,,になるんだってマジかな
Dialogue: 0,0:21:44.10,0:21:44.90,Default,,0,0,0,,嘘だろう
Dialogue: 0,0:21:45.13,0:21:45.73,Default,,0,0,0,,ああ
Dialogue: 0,0:21:45.73,0:21:46.80,Default,,0,0,0,,俺も知ってる
Dialogue: 0,0:21:47.20,0:21:48.73,Default,,0,0,0,,オリンピックに出れば百
Dialogue: 0,0:21:48.86,0:21:50.13,Default,,0,0,0,,単位もらえるって
Dialogue: 0,0:21:50.36,0:21:51.16,Default,,0,0,0,,嘘でしょ
Dialogue: 0,0:21:51.33,0:21:52.20,Default,,0,0,0,,学生結婚
Dialogue: 0,0:21:52.33,0:21:53.90,Default,,0,0,0,,すると学費が半額
Dialogue: 0,0:21:54.06,0:21:55.30,Default,,0,0,0,,になるらしいえ
Dialogue: 0,0:21:55.53,0:21:56.53,Default,,0,0,0,,そうなんですか
Dialogue: 0,0:21:56.73,0:21:58.50,Default,,0,0,0,,おいなんで信じんだよ
Dialogue: 0,0:21:59.26,0:22:00.30,Default,,0,0,0,,学生結婚
Dialogue: 0,0:22:00.90,0:22:03.16,Default,,0,0,0,,なんでキーさんが反応してるの
Dialogue: 0,0:22:14.26,0:22:15.70,Default,,0,0,0,,なあ誰か
Dialogue: 0,0:22:15.80,0:22:16.36,Default,,0,0,0,,ノート
Dialogue: 0,0:22:16.36,0:22:17.20,Default,,0,0,0,,映させて
Dialogue: 0,0:22:17.70,0:22:19.60,Default,,0,0,0,,今そんな話する時ですか
Dialogue: 0,0:22:19.70,0:22:20.80,Default,,0,0,0,,ティーピーオーをわき
Dialogue: 0,0:22:20.90,0:22:21.70,Default,,0,0,0,,まえてください
Dialogue: 0,0:22:22.26,0:22:24.20,Default,,0,0,0,,そもそも大学生にもなってノート
Dialogue: 0,0:22:24.33,0:22:25.30,Default,,0,0,0,,映させてくれって
Dialogue: 0,0:22:25.86,0:22:26.76,Default,,0,0,0,,高校生ですか
Dialogue: 0,0:22:27.53,0:22:28.06,Default,,0,0,0,,かず
Dialogue: 0,0:22:28.06,0:22:29.10,Default,,0,0,0,,かずまの兄貴
Dialogue: 0,0:22:29.93,0:22:30.50,Default,,0,0,0,,頼み
Dialogue: 0,0:22:30.50,0:22:31.70,Default,,0,0,0,,しやすああ
Dialogue: 0,0:22:31.90,0:22:33.90,Default,,0,0,0,,金さん兄ちゃんさんごめん
Dialogue: 0,0:22:34.53,0:22:36.73,Default,,0,0,0,,俺一年だから三年の講義
Dialogue: 0,0:22:36.86,0:22:37.76,Default,,0,0,0,,はさすがに
Dialogue: 0,0:22:38.76,0:22:39.56,Default,,0,0,0,,ああ
Dialogue: 0,0:22:59.80,0:23:00.60,Default,,0,0,0,,ああ
Dialogue: 0,0:23:01.00,0:23:02.10,Default,,0,0,0,,どっか遊び
Dialogue: 0,0:23:02.20,0:23:03.26,Default,,0,0,0,,来てええ
Dialogue: 0,0:23:03.50,0:23:04.30,Default,,0,0,0,,海とか
Dialogue: 0,0:23:04.40,0:23:05.20,Default,,0,0,0,,海とか
Dialogue: 0,0:23:05.30,0:23:06.26,Default,,0,0,0,,海とかさあ
Dialogue: 0,0:23:06.93,0:23:08.13,Default,,0,0,0,,ピッチピチの水着
Dialogue: 0,0:23:08.26,0:23:09.00,Default,,0,0,0,,があると一
Dialogue: 0,0:23:09.00,0:23:09.16,Default,,0,0,0,,夏
Dialogue: 0,0:23:09.16,0:23:11.70,Default,,0,0,0,,のアバチュール言うやつやなああ
Dialogue: 0,0:23:12.33,0:23:12.80,Default,,0,0,0,,降り注
Dialogue: 0,0:23:12.80,0:23:14.70,Default,,0,0,0,,ぐ太陽の熱で頭のブロッコリーが塩
Dialogue: 0,0:23:14.96,0:23:15.76,Default,,0,0,0,,まみれになって
Dialogue: 0,0:23:15.80,0:23:16.26,Default,,0,0,0,,水着
Dialogue: 0,0:23:16.26,0:23:17.53,Default,,0,0,0,,ギャルに振られまくるんですね
Dialogue: 0,0:23:17.60,0:23:18.40,Default,,0,0,0,,ナンパやったらゲ
Dialogue: 0,0:23:18.53,0:23:19.56,Default,,0,0,0,,レンでもおすすめやで
Dialogue: 0,0:23:19.60,0:23:20.36,Default,,0,0,0,,かっこよく滑
Dialogue: 0,0:23:20.36,0:23:21.53,Default,,0,0,0,,れたらの話でしょう
Dialogue: 0,0:23:21.73,0:23:23.26,Default,,0,0,0,,滑るのには自信がある
Dialogue: 0,0:23:23.46,0:23:24.30,Default,,0,0,0,,ああよく
Dialogue: 0,0:23:24.40,0:23:25.20,Default,,0,0,0,,滑ってますもんね
Dialogue: 0,0:23:25.50,0:23:26.33,Default,,0,0,0,,笑えないギャグで
Dialogue: 0,0:23:26.40,0:23:27.20,Default,,0,0,0,,うんだと
Dialogue: 0,0:23:27.33,0:23:27.90,Default,,0,0,0,,冬山
Dialogue: 0,0:23:27.90,0:23:29.66,Default,,0,0,0,,で白くなったら頭はカリフラワー
Dialogue: 0,0:23:29.80,0:23:31.30,Default,,0,0,0,,滑ったギャグでも寒くて冷凍
Dialogue: 0,0:23:31.40,0:23:32.30,Default,,0,0,0,,カリフラワーじゃないですか
Dialogue: 0,0:23:32.50,0:23:33.90,Default,,0,0,0,,てめえのせいで大体
Dialogue: 0,0:23:34.06,0:23:35.06,Default,,0,0,0,,滑ってるんだよ
Dialogue: 0,0:23:35.33,0:23:35.90,Default,,0,0,0,,俺の滑
Dialogue: 0,0:23:35.90,0:23:37.73,Default,,0,0,0,,りの半分はお前の責任だこの
Dialogue: 0,0:23:37.80,0:23:38.76,Default,,0,0,0,,モリカリフラは
Dialogue: 0,0:23:38.86,0:23:40.20,Default,,0,0,0,,久しぶりモリカリフラ
Dialogue: 0,0:23:40.36,0:23:41.36,Default,,0,0,0,,はほんまお前ら
Dialogue: 0,0:23:41.90,0:23:42.76,Default,,0,0,0,,仲ええな
Dialogue: 0,0:23:58.20,0:23:59.06,Default,,0,0,0,,みんなは服
Dialogue: 0,0:23:59.16,0:24:00.06,Default,,0,0,0,,どこで買ってる
Dialogue: 0,0:24:00.20,0:24:01.00,Default,,0,0,0,,渋谷
Dialogue: 0,0:24:01.13,0:24:01.86,Default,,0,0,0,,原宿
Dialogue: 0,0:24:01.86,0:24:03.06,Default,,0,0,0,,かななんやそれしゃ
Dialogue: 0,0:24:03.26,0:24:04.06,Default,,0,0,0,,れおつか
Dialogue: 0,0:24:05.10,0:24:05.53,Default,,0,0,0,,彼女
Dialogue: 0,0:24:05.53,0:24:07.70,Default,,0,0,0,,と一緒にいて選んでもらったりとか
Dialogue: 0,0:24:13.50,0:24:13.76,Default,,0,0,0,,服
Dialogue: 0,0:24:13.76,0:24:15.73,Default,,0,0,0,,を自分で買ったことがないんだが
Dialogue: 0,0:24:16.10,0:24:17.30,Default,,0,0,0,,えどういうこと
Dialogue: 0,0:24:17.60,0:24:19.36,Default,,0,0,0,,母親が買ってくるんだよな
Dialogue: 0,0:24:19.53,0:24:20.93,Default,,0,0,0,,勝手にどうしよう
Dialogue: 0,0:24:21.30,0:24:22.10,Default,,0,0,0,,だって
